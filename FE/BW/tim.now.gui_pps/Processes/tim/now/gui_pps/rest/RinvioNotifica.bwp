                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+508283cb-5005-4ec6-8143-b4f6fa40909f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1472654722734&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentIdRichi&quot;/>&lt;xsl:template name=&quot;input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RICHIESTA_OLO>&lt;xsl:value-of select=&quot;$currentIdRichi&quot;/>&lt;/ID_RICHIESTA_OLO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>

                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT A.ID_RICH_OLO AS RICHIESTA_OLO, B.DESCR AS TIPOLOGIA_NOTIFICA,&#xa;  C.DESCR_CAUS_INTERNO AS CAUS_INTERNO, C.DESCR_CAUS_NOW_DG AS CAUS_NOW_DG,&#xa;  C.DESCR_CAUS_OLO AS DESCR_CAUS_OLO, A.TIMSTP_CREAZIONE AS DATA_CREAZIONE,&#xa;  A.ID_NOTF AS IDENTIFICATIVO_NOTIFICA, (SELECT ST.STNTF&#xa;                                           FROM APPUSER.TIPOLG_STNTF ST&#xa;                                           WHERE ST.IDTPLG_STNTF = A.IDTPLG_STNTF_FLGIORN) AS TIPOLG_NTF_GIORNALIERO,&#xa;  (SELECT ST.STNTF&#xa;     FROM APPUSER.TIPOLG_STNTF ST&#xa;     WHERE ST.IDTPLG_STNTF = A.IDTPLG_STNTF_FLMENS) AS TIPOLG_NTF_MENSILE,&#xa;  (SELECT ST.STNTF&#xa;     FROM APPUSER.TIPOLG_STNTF ST&#xa;     WHERE ST.IDTPLG_STNTF = A.IDTPLG_STNTF_FILE_ORARIO) AS TIPOLG_NTF_ORARIO,&#xa;  A.ORIGINE_NOTF AS ORIGINE_NOTIFICA, A.STRUTTURA_RICH AS STRUTTURA_RICHIESTA,&#xa;  A.TRACCIATO_FILE, A.TRACCIATO_MAIL, (SELECT COUNT(*)&#xa;                                         FROM APPUSER.FILE_NOTF_STANDARD NOTSTA&#xa;                                         WHERE NOTSTA.ID_NOTF = A.ID_NOTF) AS FLG_NOTF_STANDARDD,&#xa;  (SELECT COUNT(*)&#xa;     FROM APPUSER.FILE_NOTF_STRAO NOTSTR&#xa;     WHERE NOTSTR.ID_NOTF = A.ID_NOTF) AS FLG_NOTF_STRAORDINARIO,&#xa;  (SELECT COUNT(*)&#xa;     FROM APPUSER.EMAIL_NOTF NOTFM&#xa;     WHERE NOTFM.ID_NOTF = A.ID_NOTF) AS FLG_NOTF_MAIL&#xa;  FROM&#xa;       APPUSER.RICH_ORDN_COMUNIC_NOTF A LEFT OUTER JOIN APPUSER.TIPOLG_NOTF B ON (A.COD_TIPOLG_NOTF = B.COD_TIPOLG_NOTF AND A.STRUTTURA_RICH = B.STRUTTURA_RICH) LEFT OUTER JOIN APPUSER.ANAG_CAUS C ON (A.ID_ANAG_CAUS = C.ID_ANAG_CAUS) LEFT OUTER JOIN APPUSER.TIPOLG_STNTF D ON (D.IDTPLG_STNTF = A.IDTPLG_STNTF_FILE_ORARIO)&#xa;  WHERE A.ID_RICH_OLO = ? AND D.STNTF IN ('ERRORE', 'INVIATA')&#xa;    AND A.ORIGINE_NOTF IN ('ORDINE NOW WHOLESALE', 'RICHIESTA OLO')&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICHIESTA_OLO"/>

                                    <columnMetadata
                                    columnName="RICHIESTA_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="TIPOLOGIA_NOTIFICA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="CAUS_INTERNO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="CAUS_NOW_DG"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DATA_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>

                                    <columnMetadata
                                    columnName="IDENTIFICATIVO_NOTIFICA"
                                    dataType="2" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="TIPOLG_NTF_GIORNALIERO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="TIPOLG_NTF_MENSILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="TIPOLG_NTF_ORARIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="ORIGINE_NOTIFICA"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="STRUTTURA_RICHIESTA"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="TRACCIATO_FILE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>

                                    <columnMetadata
                                    columnName="TRACCIATO_MAIL"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>

                                    <columnMetadata
                                    columnName="FLG_NOTF_STANDARDD"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="FLG_NOTF_STRAORDINARIO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="FLG_NOTF_MAIL"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:forEach>
                                </bpws:sequence>
                            </bpws:scope>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ListaRichNotifiche"
                                    name="ListaNotifich"
                                    outputVariable="ListaRichNotifiche"
                                    tibex:xpdlId="2445e399-f663-4472-88ae-9501e4e3b6d2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="IterateToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+508283cb-5005-4ec6-8143-b4f6fa40909f+output&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1472654991460&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;listNotifiche&quot;/>&lt;xsl:template name=&quot;ListaRichNotifiche&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($listNotifiche/tns:resultSet/Record)&quot;>&lt;tns1:ListaNotificheElement>&lt;xsl:for-each select=&quot;$listNotifiche/tns:resultSet/Record&quot;>&lt;tns1:outpuListaNotificheElement>&lt;xsl:if test=&quot;TIPOLOGIA_NOTIFICA&quot;>&lt;tns1:TIPOLOGIA_NOTIFICA>&lt;xsl:value-of select=&quot;TIPOLOGIA_NOTIFICA&quot;/>&lt;/tns1:TIPOLOGIA_NOTIFICA>&lt;/xsl:if>&lt;xsl:if test=&quot;CAUS_INTERNO&quot;>&lt;tns1:CAUS_INTERNO>&lt;xsl:value-of select=&quot;CAUS_INTERNO&quot;/>&lt;/tns1:CAUS_INTERNO>&lt;/xsl:if>&lt;xsl:if test=&quot;CAUS_NOW_DG&quot;>&lt;tns1:CAUS_NOW_DG>&lt;xsl:value-of select=&quot;CAUS_NOW_DG&quot;/>&lt;/tns1:CAUS_NOW_DG>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns1:DESCR_CAUS_OLO>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns1:DESCR_CAUS_OLO>&lt;/xsl:if>&lt;tns1:DATA_CREAZIONE>&lt;xsl:value-of select=&quot;substring-before(string(DATA_CREAZIONE),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns1:DATA_CREAZIONE>&lt;tns1:IDENTIFICATIVO_NOTIFICA>&lt;xsl:value-of select=&quot;xsd:int(IDENTIFICATIVO_NOTIFICA)&quot;/>&lt;/tns1:IDENTIFICATIVO_NOTIFICA>&lt;xsl:if test=&quot;TIPOLG_NTF_GIORNALIERO&quot;>&lt;tns1:TIPOLG_NTF_GIORNALIERO>&lt;xsl:value-of select=&quot;TIPOLG_NTF_GIORNALIERO&quot;/>&lt;/tns1:TIPOLG_NTF_GIORNALIERO>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOLG_NTF_MENSILE&quot;>&lt;tns1:TIPOLG_NTF_MENSILE>&lt;xsl:value-of select=&quot;TIPOLG_NTF_MENSILE&quot;/>&lt;/tns1:TIPOLG_NTF_MENSILE>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOLG_NTF_ORARIO&quot;>&lt;tns1:TIPOLG_NTF_ORARIO>&lt;xsl:value-of select=&quot;TIPOLG_NTF_ORARIO&quot;/>&lt;/tns1:TIPOLG_NTF_ORARIO>&lt;/xsl:if>&lt;tns1:ORIGINE_NOTIFICA>&lt;xsl:value-of select=&quot;string(ORIGINE_NOTIFICA)&quot;/>&lt;/tns1:ORIGINE_NOTIFICA>&lt;tns1:STRUTTURA_RICHIESTA>&lt;xsl:value-of select=&quot;string(STRUTTURA_RICHIESTA)&quot;/>&lt;/tns1:STRUTTURA_RICHIESTA>&lt;xsl:if test=&quot;TRACCIATO_FILE&quot;>&lt;tns1:TRACCIATO_FILE>&lt;xsl:value-of select=&quot;TRACCIATO_FILE&quot;/>&lt;/tns1:TRACCIATO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;TRACCIATO_MAIL&quot;>&lt;tns1:TRACCIATO_MAIL>&lt;xsl:value-of select=&quot;TRACCIATO_MAIL&quot;/>&lt;/tns1:TRACCIATO_MAIL>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;FLG_NOTF_STANDARDD>0&quot;>&lt;tns1:FLAG_NOTIFICA_STANDARD>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:FLAG_NOTIFICA_STANDARD>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;FLG_NOTF_STRAORDINARIO>0&quot;>&lt;tns1:FLAG_NOTIFICA_STRAORDINARIA>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:FLAG_NOTIFICA_STRAORDINARIA>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;FLG_NOTF_MAIL>0&quot;>&lt;tns1:FLAG_NOTIFICA_MAIL>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:FLAG_NOTIFICA_MAIL>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;RICHIESTA_OLO&quot;>&lt;tns1:ID_RICHIESTA>&lt;xsl:value-of select=&quot;RICHIESTA_OLO&quot;/>&lt;/tns1:ID_RICHIESTA>&lt;/xsl:if>&lt;/tns1:outpuListaNotificheElement>&lt;/xsl:for-each>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:code>&lt;/tns1:result>&lt;/tns1:ListaNotificheElement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:ListaNotificheElement>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:code>&lt;tns1:details>&lt;xsl:value-of select=&quot;'NESSUN DATO TROVATO'&quot;/>&lt;/tns1:details>&lt;/tns1:result>&lt;/tns1:ListaNotificheElement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ListaRichNotifiche" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:reply name="Reply3" operation="post"
                                partnerLink="rinvionotificanotifiche"
                                portType="ns:rinvionotificanotifiche"
                                tibex:xpdlId="e4f3c322-77f1-4c54-bd09-b600ffbb47b1" variable="Reply3-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://xmlns.example.com/20160830134936PLT" xmlns:tns="http://www.example.com/namespaces/tns/1472654991460" version="2.0"&gt;&lt;xsl:param name="ListaRichNotifiche"/&gt;&lt;xsl:template name="Reply3-input" match="/"&gt;&lt;tns1:postResponse1&gt;&lt;output&gt;&lt;tns:ListaNotificheElement&gt;&lt;xsl:copy-of select="$ListaRichNotifiche/tns:outpuListaNotificheElement"/&gt;&lt;xsl:copy-of select="$ListaRichNotifiche/tns:result"/&gt;&lt;/tns:ListaNotificheElement&gt;&lt;/output&gt;&lt;/tns1:postResponse1&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160830134936PLT&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1472654991460&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaRichNotifiche&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ListaNotificheElement>&#xa;            &lt;xsl:copy-of select=&quot;$ListaRichNotifiche/tns:outpuListaNotificheElement&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$ListaRichNotifiche/tns:result&quot;/>&#xa;        &lt;/tns:ListaNotificheElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToReply3"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerInfo&quot;/>&lt;xsl:param name=&quot;post1&quot;/>&lt;xsl:param name=&quot;ListaRichNotifiche&quot;/>&lt;xsl:template name=&quot;post_RinvioNotifica_OutLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;'RinvioNotifica'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'tim.now.gui_pps.RinvioNotifica'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'select'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$post1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$post1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;RinvioNotificaInfo:&amp;quot;,string(($ListaRichNotifiche)))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.gui_pps.RinvioNotifica_OUT'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'select'&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;'GUI'&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$post1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$post1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventID>&lt;xsl:value-of select=&quot;concat($post1/httpHeaders/tns1:httpHeaders/GUI-SID,$post1/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&lt;/tns:EventID>&lt;xsl:if test=&quot;$post1/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$post1/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;RinvioNotifica_&amp;quot;,$post1/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;RinvioNotifica_&amp;quot;,$post1/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'OUT'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;tns:ErrorLog/>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="post_RinvioNotifica_OutLog-input"
                                    name="post_RinvioNotifica_OutLog"
                                    tibex:xpdlId="19ce7fe9-d7ad-4609-9ef7-e9df1c698d0c"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToReply3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
