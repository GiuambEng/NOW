                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RecuperoCausaliEsitoDTU-input"
                                    name="RecuperoCausaliEsitoDTU"
                                    outputVariable="RecuperoCausaliEsitoDTU"
                                    tibex:xpdlId="7d34264d-e004-496c-8fa2-bc8ebd578274" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InfoLogConfigDeliveryListaGetToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7d34264d-e004-496c-8fa2-bc8ebd578274+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT distinct   a.id_anag_caus ,a.descr &#xa;  FROM tipolg_esito_dtu a where  EVENTO_NATIVO_DTU = 'NI_RIMODULAZIONE_DAC'&#xa;  order by id_anag_caus asc&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/ConfigurazioneCausaliRimodulazioneDaDelivery&quot; xmlns:tns1=&quot;http://xmlns.example.com/ConfigCausaliRimDelivery/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoCausali&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;RecuperoCausaliEsitoDTU&quot;/>&lt;xsl:template name=&quot;listaCausali&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns1:configcausalirimdelivery-listaGetParameters/tns1:flagEsplicita='S'&quot;>&lt;tns:OutputListaConfigCausaliRimDelivery>&lt;xsl:for-each select=&quot;$RecuperoCausaliEsitoDTU/Record&quot;>&lt;xsl:if test=&quot;not(contains(tib:concat-sequence($RecuperoCausali/Record/COD_CAUS),ID_ANAG_CAUS))&quot;>&lt;tns:outputListaConfigCausaliRimDelivery>&lt;tns:codiceCausale>&lt;xsl:value-of select=&quot;ID_ANAG_CAUS&quot;/>&lt;/tns:codiceCausale>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:descrizioneCausale>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:descrizioneCausale>&lt;/xsl:if>&lt;/tns:outputListaConfigCausaliRimDelivery>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:OutputListaConfigCausaliRimDelivery>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputListaConfigCausaliRimDelivery>&lt;xsl:for-each select=&quot;$RecuperoCausali/Record&quot;>&lt;tns:outputListaConfigCausaliRimDelivery>&lt;tns:codiceCausale>&lt;xsl:value-of select=&quot;COD_CAUS&quot;/>&lt;/tns:codiceCausale>&lt;tns:descrizioneCausale>&lt;xsl:value-of select=&quot;DESCR_CAUS&quot;/>&lt;/tns:descrizioneCausale>&lt;/tns:outputListaConfigCausaliRimDelivery>&lt;/xsl:for-each>&lt;/tns:OutputListaConfigCausaliRimDelivery>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="listaCausali"
                                    name="Assign"
                                    outputVariable="listaCausali"
                                    tibex:xpdlId="fd77f3aa-8ea2-4c7f-a92d-37153b590c9a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToAssign"/>
                                    <bpws:target linkName="RecuperoCausaliToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToOutputLogConfigDeliveryListaGet"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/ConfigurazioneCausaliRimodulazioneDaDelivery&quot; xmlns:tns1=&quot;http://xmlns.example.com/ConfigCausaliRimDelivery/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoCausali&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoCausaliEsitoDTU&quot;/>&#xa;    &lt;xsl:template name=&quot;listaCausali&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$get.parameters/tns1:flagEsplicita='S'&quot;>&#xa;                &lt;tns:OutputListaConfigCausaliRimDelivery>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoCausaliEsitoDTU/Record&quot;>&#xa;                        &lt;xsl:if test=&quot;not(contains(tib:concat-sequence($RecuperoCausali/Record/COD_CAUS),ID_ANAG_CAUS))&quot;>&#xa;                            &lt;tns:outputListaConfigCausaliRimDelivery>&#xa;                                &lt;tns:codiceCausale>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ANAG_CAUS&quot;/>&#xa;                                &lt;/tns:codiceCausale>&#xa;                                &lt;xsl:if test=&quot;DESCR&quot;>&#xa;                                    &lt;tns:descrizioneCausale>&#xa;                                        &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                                    &lt;/tns:descrizioneCausale>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:outputListaConfigCausaliRimDelivery>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:OutputListaConfigCausaliRimDelivery>&#xa;       