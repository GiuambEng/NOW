                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+39e11065-2e99-4f6a-8d5b-b780299c7802+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioKOCautelare/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_ERRORE>&lt;xsl:value-of select=&quot;$get1/parameters/tns1:monitoraggiokocautelare1GetParameters/tns1:codiceErrore&quot;/>&lt;/COD_ERRORE>&lt;OFFERTA>&lt;xsl:value-of select=&quot;$get1/parameters/tns1:monitoraggiokocautelare1GetParameters/tns1:offerta&quot;/>&lt;/OFFERTA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="cautelareQuery-input"
                                    name="cautelareQuery"
                                    outputVariable="cautelareQuery"
                                    tibex:xpdlId="39e11065-2e99-4f6a-8d5b-b780299c7802" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToMapper1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+39e11065-2e99-4f6a-8d5b-b780299c7802+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioKOCautelare/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;COD_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns1:codiceErrore&quot;/>&#xa;            &lt;/COD_ERRORE>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns1:offerta&quot;/>&#xa;            &lt;/OFFERTA>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RICH.IDRICHIESTAOLO, RICH.DATAINVIORICHIESTA, RICH.CODIFICAOLOAGCOM,RICH.CODIFICAOLONOW, RICH.CODICEORDINETI,&#xa;RICH.STATORICHIESTAOLO, RICH.STATORICHIESTANOW, RICH.DRO, RICH.IDRISORSA, RICH.OFFERTA, FO.DESCR&#xa;FROM BDS_1_CASEDATA_RICHIESTA RICH&#xa;LEFT JOIN PPS_LAVRZ_HD PLH ON RICH.IDRICHIESTAOLO = PLH.ID_RICH_OLO&#xa;LEFT JOIN PPS_LAVRZ_HD_CAUT_AGGRA AGG ON RICH.OFFERTA = AGG.OFFERTA&#xa;LEFT JOIN OFFERTA O ON O.ID_OFFERTA = RICH.IDOFFERTA&#xa;LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA = O.ID_FAMIG_OFFERTA&#xa;WHERE AGG.COD_ERRORE = ? AND RICH.OFFERTA = ? AND UPPER(PLH.TIPO_ERRORE) = 'CAUTELARE'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ERRORE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLONOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINETI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DRO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="DettaglioMonitoraggioCautelare-input"
                                    name="DettaglioMonitoraggioCautelare"
                                    outputVariable="DettaglioMonitoraggioCautelare"
                                    tibex:xpdlId="a2ad5528-9184-4bcc-b4b1-f1fae425beb2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery1ToMapper1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DettaglioMonitoraggioCautelareToOutputLogDettaglioMonitoraggioCautelare"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioKOCautelare&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;cautelareQuery&quot;/>&lt;xsl:template name=&quot;DettaglioMonitoraggioCautelare-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($cautelareQuery/Record) > 0&quot;>&lt;tns:OutputDettaglioMonitoraggioKOCautelare>&lt;xsl:for-each select=&quot;$cautelareQuery/Record&quot;>&lt;tns:outputDettaglioMonitoraggioCautelare>&lt;tns:DataInvioRichiesta>&lt;xsl:value-of select=&quot;substring-before(string(DATAINVIORICHIESTA),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DataInvioRichiesta>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:CodificaOloAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:CodificaOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&lt;tns:CodificaOloNow>&lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&lt;/tns:CodificaOloNow>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINETI&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:statoNOW>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:statoNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:statoOLO>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:statoOLO>&lt;/xsl:if>&lt;tns:DRO>&lt;xsl:value-of select=&quot;substring-before( string (DRO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DRO>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:Ambito>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:Ambito>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;tns:idRichiesta>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiesta>&lt;/tns:outputDettaglioMonitoraggioCautelare>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:OutputDettaglioMonitoraggioKOCautelare>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputDettaglioMonitoraggioKOCautelare>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'NESSUN RECORD TROVATO'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutputDettaglioMonitoraggioKOCautelare>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:MonitoraggioKOCautelare="http://www.example.org/MonitoraggioKOCautelare"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="MonitoraggioKOCautelare:OutputDettaglioMonitoraggioKOCautelare" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
