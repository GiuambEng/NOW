                                    <bpws:target linkName="RenderXmlToexportDati"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="exportDatiToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/cmf.exportDati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160831181031PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;idFile&quot;/>&#xa;    &lt;xsl:template name=&quot;exportDati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:inputExportDati>&#xa;            &lt;tns:xmlParameter>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns:xmlParameter>&#xa;            &lt;tns:listOfElements>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ambito,causaleOlo,media30ggLav,media5ggLav,totaleOdierno,soglia&amp;quot;&quot;/>&#xa;            &lt;/tns:listOfElements>&#xa;            &lt;tns:rootElementParameter>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;outputAllarmiKOGiornalieri&amp;quot;&quot;/>&#xa;            &lt;/tns:rootElementParameter>&#xa;            &lt;tns:nameOfFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;AllarmiKOGiornalieri&amp;quot;&quot;/>&#xa;            &lt;/tns:nameOfFile>&#xa;            &lt;tns:childRootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OutputAllarmiKOGiornalieri&amp;quot;&quot;/>&#xa;            &lt;/tns:childRootElement>&#xa;            &lt;tns:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($idFile/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns:idFile>&#xa;            &lt;xsl:if test=&quot;$get.parameters/tns1:tipoProfilo&quot;>&#xa;                &lt;tns:tipoProfilo>&#xa;                    &lt;xsl:value-of select=&quot;$get.parameters/tns1:tipoProfilo&quot;/>&#xa;           