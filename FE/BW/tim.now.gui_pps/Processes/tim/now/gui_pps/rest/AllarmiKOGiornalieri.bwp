                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="queryListaContatori-input"
                                    name="queryListaContatori"
                                    outputVariable="queryListaContatori"
                                    tibex:xpdlId="9175187a-7b12-4fe0-8428-ddf51f4072de" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_allarmiKOGiornalieri_InputLog_INFOToCopy_1_queryListaContatori"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Copy_1_queryListaContatoriToallarmiAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9175187a-7b12-4fe0-8428-ddf51f4072de+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AGG.AMBITO, AGG.COD_CAUS_OLO, AGG.MEDIA_30_GG, AGG.MEDIA_5_GG, AGG.TOT_ODIERNO, SA.VALORE_SOGLIA,&#xd;&#xa;       (AGG.MEDIA_5_GG + (AGG.MEDIA_5_GG * SA.VALORE_SOGLIA / 100)) AS SOGLIA&#xd;&#xa;FROM   APPUSER.PPS_RICH_OLO_SCARTATA_KO_AGGRA AGG,&#xd;&#xa;       APPUSER.PPS_SOGLIA_ANALISI SA,&#xd;&#xa;       APPUSER.PPS_AMBITO_MONITG AM,&#xd;&#xa;       APPUSER.PPS_TIPOLG_REPORT TP&#xd;&#xa;WHERE  AM.AMBITO_MONITORAGGIO = 'Monitoraggio KO' AND&#xd;&#xa;       TP.TIPOLG_REPORT = 'Allarmi KO Giornalieri' AND&#xd;&#xa;       SA.ID_PPS_AMBITO_MONITG = AM.ID_PPS_AMBITO_MONITG AND&#xd;&#xa;       SA.ID_PPS_TIPOLG_REPORT = TP.ID_PPS_TIPOLG_REPORT AND&#xd;&#xa;       (SA.ID_FAMIG_OFFERTA IS NULL OR (SA.ID_FAMIG_OFFERTA = (SELECT ID_FAMIG_OFFERTA FROM APPUSER.FAMIG_OFFERTA WHERE DESCR = AGG.AMBITO))) AND&#xd;&#xa;       (SA.ID_ANAG_CAUS IS NULL OR (SA.ID_ANAG_CAUS = (SELECT ID_ANAG_CAUS FROM APPUSER.ANAG_CAUS WHERE COD_CAUS_OLO = AGG.COD_CAUS_OLO)))&#xd;&#xa;ORDER BY AGG.AMBITO, AGG.COD_CAUS_OLO" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="AMBITO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="MEDIA_30_GG"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="MEDIA_5_GG"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TOT_ODIERNO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="VALORE_SOGLIA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="SOGLIA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/cmf.exportDati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160831181031PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RenderXml&quot;/>&lt;xsl:param name=&quot;idFile&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;exportDati-input&quot; match=&quot;/&quot;>&lt;tns:inputExportDati>&lt;tns:xmlParameter>&lt;xsl:value-of select=&quot;$RenderXml&quot;/>&lt;/tns:xmlParameter>&lt;tns:listOfElements>&lt;xsl:value-of select=&quot;&amp;quot;ambito,causaleOlo,media30ggLav,media5ggLav,totaleOdierno,soglia&amp;quot;&quot;/>&lt;/tns:listOfElements>&lt;tns:rootElementParameter>&lt;xsl:value-of select=&quot;&amp;quot;outputAllarmiKOGiornalieri&amp;quot;&quot;/>&lt;/tns:rootElementParameter>&lt;tns:nameOfFile>&lt;xsl:value-of select=&quot;&amp;quot;AllarmiKOGiornalieri&amp;quot;&quot;/>&lt;/tns:nameOfFile>&lt;tns:childRootElement>&lt;xsl:value-of select=&quot;&amp;quot;OutputAllarmiKOGiornalieri&amp;quot;&quot;/>&lt;/tns:childRootElement>&lt;tns:idFile>&lt;xsl:value-of select=&quot;xsd:int($idFile/Record[1]/NEXTVAL)&quot;/>&lt;/tns:idFile>&lt;xsl:if test=&quot;$get/parameters/tns1:allarmikogiornalieri1GetParameters/tns1:tipoProfilo&quot;>&lt;tns:tipoProfilo>&lt;xsl:value-of select=&quot;$get/parameters/tns1:allarmikogiornalieri1GetParameters/tns1:tipoProfilo&quot;/>&lt;/tns:tipoProfilo>&lt;/xsl:if>&lt;xsl:if test=&quot;$get/parameters/tns1:allarmikogiornalieri1GetParameters/tns1:userId&quot;>&lt;tns:userId>&lt;xsl:value-of select=&quot;$get/parameters/tns1:allarmikogiornalieri1GetParameters/tns1:userId&quot;/>&lt;/tns:userId>&lt;/xsl:if>&lt;/tns:inputExportDati>&lt;/xsl:template>&lt;/xsl:stylesheet>"
