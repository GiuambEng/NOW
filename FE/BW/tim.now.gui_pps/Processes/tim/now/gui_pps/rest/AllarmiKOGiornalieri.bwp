                                    sqlStatement="SELECT VALORE_SOGLIA &#xa;FROM PPS_SOGLIA_ANALISI&#xa;WHERE ID_PPS_AMBITO_MONITG=? AND ID_PPS_TIPOLG_REPORT=? AND DATAFI_VALID > sysdate " xsi:type="jdbcPalette:JDBCQueryActivity">

