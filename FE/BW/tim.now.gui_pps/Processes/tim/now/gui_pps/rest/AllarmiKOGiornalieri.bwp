                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="dettaglioAssignToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/allarmiKOGiornalieri&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;dettaglioQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;dettaglioVariable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($dettaglioQuery/Record) > 0&quot;>&#xa;                &lt;tns:outputAllarmiKOGiornalieriLiv1>&#xa;                    &lt;xsl:for-each select=&quot;$dettaglioQuery/Record&quot;>&#xa;                        &lt;tns:OutputAllarmiKOGiornalieriLiv1>&#xa;                            &lt;tns:dataCreazioneRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DATAINVIORICHIESTA), &amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataCreazioneRichiesta>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns:codificaOAO>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns:codificaOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&#xa;                                &lt;tns:codiceOAO>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&#xa;                                &lt;/tns:codiceOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                                &lt;tns:ordineTI>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns:ordineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&#xa;                                &lt;tns:statoNOW>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&#xa;                                &lt;/tns:statoNOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&#xa;                                &lt;tns:statoOLO>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&#xa;                                &lt;/tns:statoOLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:DRO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DRO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DRO>&#xa;                            &lt;tns:ambito>&#xa;                                &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                            &lt;/tns:ambito>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns:offerta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:idRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                            &lt;/tns:idRichiesta>&#xa;                        &lt;/tns:OutputAllarmiKOGiornalieriLiv1>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputAllarmiKOGiornalieriLiv1>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputAllarmiKOGiornalieriLiv1>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun elemento&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputAllarmiKOGiornalieriLiv1>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
