nsuntivoDTUSLA&gt;&lt;ns:TotInAttesaConsuntivoDTUNoSLA&gt;&lt;xsl:value-of select="xsd:int(ORD_INATTESACONSUNTIVO_NOSLA)"/&gt;&lt;/ns:TotInAttesaConsuntivoDTUNoSLA&gt;&lt;ns:TotInAttesaEspletamentoFoniaDTUSLA&gt;&lt;xsl:value-of select="xsd:int(ORD_INATTSPFON_SLA)"/&gt;&lt;/ns:TotInAttesaEspletamentoFoniaDTUSLA&gt;&lt;ns:TotInAttesaEspletamentoFoniaDTUNoSLA&gt;&lt;xsl:value-of select="xsd:int(ORD_INATTSPFON_NOSLA)"/&gt;&lt;/ns:TotInAttesaEspletamentoFoniaDTUNoSLA&gt;&lt;ns:TotInRichiestaPreventivoDTUSLA&gt;&lt;xsl:value-of select="xsd:int(ORD_INRICHPREVENTIVO_SLA)"/&gt;&lt;/ns:TotInRichiestaPreventivoDTUSLA&gt;&lt;ns:TotInRichiestaPreventivoDTUNoSLA&gt;&lt;xsl:value-of select="xsd:int(ORD_INRICHPREVENTIVO_NOSLA)"/&gt;&lt;/ns:TotInRichiestaPreventivoDTUNoSLA&gt;&lt;ns:TotInAnnullamentoRifiutoPreventivoDTUSLA&gt;&lt;xsl:value-of select="xsd:int(ORD_INANNRIFPREV_SLA)"/&gt;&lt;/ns:TotInAnnullamentoRifiutoPreventivoDTUSLA&gt;&lt;ns:TotInAnnullamentoRifiutoPreventivoDTUNoSLA&gt;&lt;xsl:value-of select="xsd:int(ORD_INANNRIFPREV_NOSLA)"/&gt;&lt;/ns:TotInAnnullamentoRifiutoPreventivoDTUNoSLA&gt;&lt;ns:IdTempiAttraversamentoGUI&gt;&lt;xsl:value-of select="string(ID_PPS_TEMPI_ATTRV_GUI)"/&gt;&lt;/ns:IdTempiAttraversamentoGUI&gt;&lt;ns:TotEspletati&gt;&lt;xsl:value-of select="xsd:int(ORD_ESPL)"/&gt;&lt;/ns:TotEspletati&gt;&lt;ns:TotEspletatiSLA&gt;&lt;xsl:value-of select="xsd:int(ORD_ESPL_SLA)"/&gt;&lt;/ns:TotEspletatiSLA&gt;&lt;ns:TotEspletatiNoSLA&gt;&lt;xsl:value-of select="xsd:int(ORD_ESPL_NOSLA)"/&gt;&lt;/ns:TotEspletatiNoSLA&gt;&lt;/ns:Gui&gt;&lt;/xsl:for-each&gt;&lt;ns:Treshold&gt;&lt;xsl:for-each select="$Accumulate/ns:MonitoraggioTempiAttraversamentoOut/ns:Treshold/ns:items"&gt;&lt;ns:items&gt;&lt;xsl:if test="ns:nome"&gt;&lt;ns:nome&gt;&lt;xsl:value-of select="ns:nome"/&gt;&lt;/ns:nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:valore"&gt;&lt;ns:valore&gt;&lt;xsl:value-of select="ns:valore"/&gt;&lt;/ns:valore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:contatore"&gt;&lt;ns:contatore&gt;&lt;xsl:value-of select="ns:contatore"/&gt;&lt;/ns:contatore&gt;&lt;/xsl:if&gt;&lt;/ns:items&gt;&lt;/xsl:for-each&gt;&lt;/ns:Treshold&gt;&lt;ns:result&gt;&lt;ns:severity&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:severity&gt;&lt;ns:code&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/ns:code&gt;&lt;/ns:result&gt;&lt;/ns:MonitoraggioTempiAttraversamentoOut&gt;&lt;/item&gt;&lt;/tns:getResponse2&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20160905153433PLT&quot; xmlns:ns=&quot;http://www.tim.com/NOW/rest/MonitoraggioTempiAttraversamento&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;queryListaAggregato&quot;/>&#xa;    &lt;xsl:param name=&quot;queryListGui&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;getOutList-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:MonitoraggioTempiAttraversamentoOut>&#xa;            &lt;xsl:for-each select=&quot;$queryListaAggregato/Record&quot;>&#xa;                &lt;ns:Aggregato>&#xa;                    &lt;ns:DataEstrazione>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                    &lt;/ns:DataEstrazione>&#xa;                    &lt;xsl:if test=&quot;DESCR_SOTTO_FAMIG_OFFERTA&quot;>&#xa;                        &lt;ns:Ambito>&#xa;                            &lt;xsl:value-of select=&quot;DESCR_SOTTO_FAMIG_OFFERTA&quot;/>&#xa;                        &lt;/ns:Ambito>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                    &lt;/ns:Servizio>&#xa;                    &lt;ns:OrdinativiInSlaDtu>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_GCZ_DTU_SLA)&quot;/>&#xa;                    &lt;/ns:OrdinativiInSlaDtu>&#xa;                    &lt;ns:PercOrdinativiInSlaDtu>&#xa;                        &lt;xsl:value-of select=&quot;string(round-half-to-even(PERCENTUALE_ORDN_GCZ_DTU_SLA, 2))&quot;/>&#xa;                    &lt;/ns:PercOrdinativiInSlaDtu>&#xa;                    &lt;ns:OrdinativiFuoriSlaDtu>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_GCZ_DTU_FUORI_SLA)&quot;/>&#xa;                    &lt;/ns:OrdinativiFuoriSlaDtu>&#xa;                    &lt;ns:PercOrdinativiFuoriSlaDtu>&#xa;                        &lt;xsl:value-of select=&quot;string(round-half-to-even(PERC_ORDN_GCZ_DTU_FUORISLA, 2))&quot;/>&#xa;                    &lt;/ns:PercOrdinativiFuoriSlaDtu>&#xa;                    &lt;ns:OrdinativiRimodulatiDtu>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_RIMODULATI_DTU)&quot;/>&#xa;                    &lt;/ns:OrdinativiRimodulatiDtu>&#xa;                    &lt;ns:PercOrdinativiRimodulatiDtu>&#xa;                        &lt;xsl:value-of select=&quot;string(round-half-to-even(PERC_ORDN_RIMD_DTU, 2))&quot;/>&#xa;                    &lt;/ns:PercOrdinativiRimodulatiDtu>&#xa;                    &lt;ns:OrdinativiInSlaNow>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_GCZ_NOW_SLA)&quot;/>&#xa;                    &lt;/ns:OrdinativiInSlaNow>&#xa;                    &lt;ns:PercOrdinativiInSlaNow>&#xa;                        &lt;xsl:value-of select=&quot;string(round-half-to-even(PERCENTUALE_ORDN_GCZ_NOW_SLA, 2))&quot;/>&#xa;                    &lt;/ns:PercOrdinativiInSlaNow>&#xa;                    &lt;ns:OrdinativiFuoriSlaNow>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_GCZ_NOW_FUORI_SLA)&quot;/>&#xa;                    &lt;/ns:OrdinativiFuoriSlaNow>&#xa;                    &lt;ns:PercOrdinativiFuoriSlaNow>&#xa;                        &lt;xsl:value-of select=&quot;string(round-half-to-even(PERC_ORDN_GCZ_NOW_FUORISLA,2))&quot;/>&#xa;                    &lt;/ns:PercOrdinativiFuoriSlaNow>&#xa;                    &lt;ns:OrdinativiRimodulatiNow>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_RIMODULATI_NOW)&quot;/>&#xa;                    &lt;/ns:OrdinativiRimodulatiNow>&#xa;                    &lt;ns:PercOrdinativiRimodulatiNow>&#xa;                        &lt;xsl:value-of select=&quot;string(round-half-to-even(PERC_ORDN_RIMD_NOW,2))&quot;/>&#xa;                    &lt;/ns:PercOrdinativiRimodulatiNow>&#xa;                    &lt;ns:OrdinativiInSlaE2E>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_E2E_SLA)&quot;/>&#xa;                    &lt;/ns:OrdinativiInSlaE2E>&#xa;                    &lt;ns:PercOrdinativiInSlaE2E>&#xa;                        &lt;xsl:value-of select=&quot;string(round-half-to-even(PERCENTUALE_ORDN_E2E_SLA, 2))&quot;/>&#xa;                    &lt;/ns:PercOrdinativiInSlaE2E>&#xa;                    &lt;ns:OrdinativiFuoriSlaE2E>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_E2E_FUORI_SLA)&quot;/>&#xa;                    &lt;/ns:OrdinativiFuoriSlaE2E>&#xa;                    &lt;ns:PercOrdinativiFuoriSlaE2E>&#xa;                        &lt;xsl:value-of select=&quot;string(round-half-to-even(PERCENTUALE_ORDN_E2E_FUORI_SLA, 2))&quot;/>&#xa;                    &lt;/ns:PercOrdinativiFuoriSlaE2E>&#xa;                &lt;/ns:Aggregato>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$queryListGui/Record&quot;>&#xa;                &lt;ns:Gui>&#xa;                    &lt;ns:DataEstrazione>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                    &lt;/ns:DataEstrazione>&#xa;                    &lt;ns:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;TIPOLG_LAVRZ&quot;/>&#xa;                    &lt;/ns:Lavorazione>&#xa;                    &lt;ns:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                    &lt;/ns:Servizio>&#xa;                    &lt;ns:TotaleOrdini>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_TOT)&quot;/>&#xa;                    &lt;/ns:TotaleOrdini>&#xa;                    &lt;ns:NumOrdiniRimodulati>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_RIM)&quot;/>&#xa;                    &lt;/ns:NumOrdiniRimodulati>&#xa;                    &lt;ns:PercNumOrdiniRimodulati>&#xa;                        &lt;xsl:value-of select=&quot;string(round-half-to-even(PERC_ORD_RIM, 2))&quot;/>&#xa;                    &lt;/ns:PercNumOrdiniRimodulati>&#xa;                    &lt;ns:TotPervenutiInCaricoNowSla>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_PERV_SLA)&quot;/>&#xa;                    &lt;/ns:TotPervenutiInCaricoNowSla>&#xa;                    &lt;ns:TotPervenutiInCaricoNowNoSla>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_PERV_NOSLA)&quot;/>&#xa;                    &lt;/ns:TotPervenutiInCaricoNowNoSla>&#xa;                    &lt;ns:TotAcquisitiInCaricoNowSla>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_ACQ_SLA)&quot;/>&#xa;                    &lt;/ns:TotAcquisitiInCaricoNowSla>&#xa;                    &lt;ns:TotAcquisitiInCaricoNowNoSla>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_ACQ_NOSLA)&quot;/>&#xa;                    &lt;/ns:TotAcquisitiInCaricoNowNoSla>&#xa;                    &lt;ns:TotLavorazioniHDInCaricoNowSla>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_HD_SLA)&quot;/>&#xa;                    &lt;/ns:TotLavorazioniHDInCaricoNowSla>&#xa;                    &lt;ns:TotLavorazioniHDInCaricoNowNoSla>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_HD_NOSLA)&quot;/>&#xa;                    &lt;/ns:TotLavorazioniHDInCaricoNowNoSla>&#xa;                    &lt;ns:TotInVerificheDonatingNowSLA>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_INVERIFICHEDONATING_SLA)&quot;/>&#xa;                    &lt;/ns:TotInVerificheDonatingNowSLA>&#xa;                    &lt;ns:TotInVerificheDonatingNowNOSLA>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_INVERIFICHEDONATING_NOSLA)&quot;/>&#xa;                    &lt;/ns:TotInVerificheDonatingNowNOSLA>&#xa;                    &lt;ns:TotInVerificheTecnicheNowSLA>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_INVERIFICHETECNICHE_SLA)&quot;/>&#xa;                    &lt;/ns:TotInVerificheTecnicheNowSLA>&#xa;                    &lt;ns:TotInVerificheTecnicheNowNOSLA>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_INVERIFICHETECNICHE_NOSLA)&quot;/>&#xa;                    &lt;/ns:TotInVerificheTecnicheNowNOSLA>&#xa;                    &lt;ns:TotAccettatoNowSLA>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_ACCETTATO_SLA)&quot;/>&#xa;                    &lt;/ns:TotAccettatoNowSLA>&#xa;                    &lt;ns:TotAccettatoNowNOSLA>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_ACCETTATO_NOSLA)&quot;/>&#xa;                    &lt;/ns:TotAccettatoNowNOSLA>&#xa;                    &lt;ns:TotInConfermaAnnullamentoNowSLA>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_INATTCONFANN_SLA)&quot;/>&#xa;                    &lt;/ns:TotInConfermaAnnullamentoNowSLA>&#xa;                    &lt;ns:TotInConfermaAnnullamentoNowNOSLA>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_INATTCONFANN_NOSLA)&quot;/>&#xa;                    &lt;/ns:TotInConfermaAnnullamentoNowNOSLA>&#xa;                    &lt;ns:TotVerificheReteInCaricoDtuSla>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_VIR_SLA)&quot;/>&#xa;                    &lt;/ns:TotVerificheReteInCaricoDtuSla>&#xa;                    &lt;ns:TotVerificheReteInCaricoDtuNoSla>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ORD_VIR_NOSLA)&quot;/>&#xa;                    &lt;/ns:TotVerificheReteInCaricoDtuNoSla>&#xa;                    &lt;ns:TotInviatiDeliveryInCaricoDtuSla>&#xa;                        &lt;xsl:value-of s