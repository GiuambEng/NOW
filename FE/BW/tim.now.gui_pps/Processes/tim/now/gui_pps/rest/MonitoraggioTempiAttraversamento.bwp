quot;($get.parameters/tns1:flagExport='Y' and $get.parameters/tns1:tipoLista='A')&quot;>&#xa;                    &lt;tns:childRootElement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Aggregato&amp;quot;&quot;/>&#xa;                    &lt;/tns:childRootElement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;($get.parameters/tns1:flagExport='Y' and $get.parameters/tns1:tipoLista='G')&quot;>&#xa;                    &lt;tns:childRootElement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Gui&amp;quot;&quot;/>&#xa;                    &lt;/tns:childRootElement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:childRootElement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/tns:childRootElement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($getIdFile/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns:idFile>&#xa;            &lt;xsl:if test=&quot;$get.parameters/tns1:tipoProfilo&quot;>&#xa;                &lt;tns:tipoProfilo>&#xa;                    &lt;xsl:value-of select=&quot;$get.parameters/tns1:tipoProfilo&quot;/>&#xa;                &lt;/tns:tipoProfilo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$get.parameters/tns1:userId&quot;>&#xa;                &lt;tns:userId>&#xa;                    &lt;xsl:value-of select=&quot;$get.parameters/tns1:userId&quot;/>&#xa;                &lt;/tns:userId>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:inputExportDati>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
