&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20160905153433PLT" xmlns:Q1="http://www.tim.com/NOW/rest/MonitoraggioTempiAttraversamento" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.example.org/CryptoParams" version="2.0"&gt;&lt;xsl:param name="CryptoParam"/&gt;&lt;xsl:template name="getOutIdFile-input" match="/"&gt;&lt;tns:getResponse2&gt;&lt;item&gt;&lt;Q1:MonitoraggioTempiAttraversamentoOut&gt;&lt;Q1:result&gt;&lt;Q1:severity&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/Q1:severity&gt;&lt;Q1:code&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/Q1:code&gt;&lt;/Q1:result&gt;&lt;Q1:idFile&gt;&lt;xsl:value-of select="$CryptoParam/tns1:idFileCriptato"/&gt;&lt;/Q1:idFile&gt;&lt;/Q1:MonitoraggioTempiAttraversamentoOut&gt;&lt;/item&gt;&lt;/tns:getResponse2&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
