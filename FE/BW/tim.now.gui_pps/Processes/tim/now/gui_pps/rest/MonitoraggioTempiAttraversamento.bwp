                                    <bpws:flow name="flow4">
                                    <bpws:links>

                                    <bpws:link
                                    name="MapperToAccumulate1" tibex:linkType="SUCCESS"/>

                                    <bpws:link
                                    name="GroupStartTogetThreshold" tibex:linkType="SUCCESSWITHCONDITION"/>

