                                    <bpws:assign
                                    name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="af9fe4ad-8a71-4b51-807a-82daccbffca4" validate="no">
                                    <bpws:sources>

                                    <bpws:source linkName="GroupStartTogetThreshold">
                                    <tibex:DesignExpression>

                                    <tibex:expression
