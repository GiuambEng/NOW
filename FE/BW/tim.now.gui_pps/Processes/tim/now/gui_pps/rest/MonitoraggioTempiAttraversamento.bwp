                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20160905153433PLT&quot; xmlns:ns=&quot;http://www.tim.com/NOW/rest/MonitoraggioTempiAttraversamento&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyError-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:MonitoraggioTempiAttraversamentoOut>&#xa;            &lt;ns:result>&#xa;                &lt;ns:severity>&#xa;                    &lt;xsl:value-of select=&quot;'ERROR'&quot;/>&#xa;                &lt;/ns:severity>&#xa;                &lt;xsl:if test=&quot;$FaultDetails/MsgCode&quot;>&#xa;                    &lt;ns:code>&#xa;                        &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                    &lt;/ns:code>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$FaultDetails/Msg&quot;>&#xa;                    &lt;ns:details>&#xa;                        &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                    &lt;/ns:details>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:result>&#xa;        &lt;/ns:MonitoraggioTempiAttraversamentoOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
