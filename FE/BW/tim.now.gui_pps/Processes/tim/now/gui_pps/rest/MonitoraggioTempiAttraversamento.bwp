&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20160905153433PLT" xmlns:ns="http://www.tim.com/NOW/rest/MonitoraggioTempiAttraversamento" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="queryListaAggregato"/&gt;&lt;xsl:param name="queryListGui"/&gt;&lt;xsl:param name="Accumulate"/&gt;&lt;xsl:template name="getOutList-input" match="/"&gt;&lt;tns:getResponse2&gt;&lt;item&gt;&lt;ns:MonitoraggioTempiAttraversamentoOut&gt;&lt;xsl:for-each select="$queryListaAggregato/Record"&gt;&lt;ns:Aggregato&gt;&lt;ns:DataEstrazione&gt;&lt;xsl:value-of select="substring-before(string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)"/&gt;&lt;/ns:DataEstrazione&gt;&lt;xsl:if test="DESCR_SOTTO_FAMIG_OFFERTA"&gt;&lt;ns:Ambito&gt;&lt;xsl:value-of select="DESCR_SOTTO_FAMIG_OFFERTA"/&gt;&lt;/ns:Ambito&gt;&lt;/xsl:if&gt;&lt;ns:Servizio&gt;&lt;xsl:value-of select="OFFERTA"/&gt;&lt;/ns:Servizio&gt;&lt;ns:OrdinativiInSlaDtu&gt;&lt;xsl:value-of select="xsd:int(NUMERO_ORDN_GCZ_DTU_SLA)"/&gt;&lt;/ns:OrdinativiInSlaDtu&gt;&lt;ns:PercOrdinativiInSlaDtu&gt;&lt;xsl:value-of select="string(round-half-to-even(PERCENTUALE_ORDN_GCZ_DTU_SLA, 2))"/&gt;&lt;/ns:PercOrdinativiInSlaDtu&gt;&lt;ns:OrdinativiFuoriSlaDtu&gt;&lt;xsl:value-of select="xsd:int(NUMERO_ORDN_GCZ_DTU_FUORI_SLA)"/&gt;&lt;/ns:OrdinativiFuoriSlaDtu&gt;&lt;ns:PercOrdinativiFuoriSlaDtu&gt;&lt;xsl:value-of select="string(round-half-to-even(PERC_ORDN_GCZ_DTU_FUORISLA, 2))"/&gt;&lt;/ns:PercOrdinativiFuoriSlaDtu&gt;&lt;ns:OrdinativiRimodulatiDtu&gt;&lt;xsl:value-of select="xsd:int(NUMERO_ORDN_RIMODULATI_DTU)"/&gt;&lt;/ns:OrdinativiRimodulatiDtu&gt;&lt;ns:PercOrdinativiRimodulatiDtu&gt;&lt;xsl:value-of select="string(round-half-to-even(PERC_ORDN_RIMD_DTU, 2))"/&gt;&lt;/ns:PercOrdinativiRimodulatiDtu&gt;&lt;ns:OrdinativiInSlaNow&gt;&lt;xsl:value-of select="xsd:int(NUMERO_ORDN_GCZ_NOW_SLA)"/&gt;&lt;/ns:OrdinativiInSlaNow&gt;&lt;ns:PercOrdinativiInSlaNow&gt;&lt;xsl:value-