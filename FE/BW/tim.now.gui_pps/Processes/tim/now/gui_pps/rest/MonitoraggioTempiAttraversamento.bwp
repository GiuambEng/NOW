                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/cmf.exportDati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioTempiAttraversamento/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;getIdFile&quot;/>&lt;xsl:param name=&quot;RenderXml&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;exportDati-input&quot; match=&quot;/&quot;>&lt;tns:inputExportDati>&lt;tns:xmlParameter>&lt;xsl:value-of select=&quot;$RenderXml&quot;/>&lt;/tns:xmlParameter>&lt;xsl:choose>&lt;xsl:when test=&quot;($get/parameters/tns1:monitoraggiotempiattraversamento2GetParameters/tns1:flagExport='Y' and $get/parameters/tns1:monitoraggiotempiattraversamento2GetParameters/tns1:tipoLista='A')&quot;>&lt;tns:listOfElements>&lt;xsl:value-of select=&quot;&amp;quot;DataEstrazione,Ambito,Servizio,OrdinativiInSlaDtu,PercOrdinativiInSlaDtu,OrdinativiFuoriSlaDtu,PercOrdinativiFuoriSlaDtu,OrdinativiRimodulatiDtu,PercOrdinativiRimodulatiDtu,OrdinativiInSlaNow,PercOrdinativiInSlaNow,OrdinativiFuoriSlaNow,PercOrdinativiFuoriSlaNow,OrdinativiRimodulatiNow,PercOrdinativiRimodulatiNow,OrdinativiInSlaE2E,PercOrdinativiInSlaE2E,OrdinativiFuoriSlaE2E,PercOrdinativiFuoriSlaE2E&amp;quot;&quot;/>&lt;/tns:listOfElements>&lt;/xsl:when>&lt;xsl:when test=&quot;($get/parameters/tns1:monitoraggiotempiattraversamento2GetParameters/tns1:flagExport='Y' and $get/parameters/tns1:monitoraggiotempiattraversamento2GetParameters/tns1:tipoLista='G')&quot;>&lt;tns:listOfElements>&lt;xsl:value-of select=&quot;&amp;quot;DataEstrazione,Lavorazione,Servizio,TotaleOrdini,NumOrdiniRimodulati,PercNumOrdiniRimodulati,TotPervenutiInCaricoNowSla,TotPervenutiInCaricoNowNoSla,TotAcquisitiInCaricoNowSla,TotAcquisitiInCaricoNowNoSla,TotLavorazioniHDInCaricoNowSla,TotLavorazio