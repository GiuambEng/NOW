                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/rest/MonitoraggioTempiAttraversamento&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioTempiAttraversamento/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;queryListaAggregato&quot;/>&#xa;    &lt;xsl:param name=&quot;queryListGui&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q1:MonitoraggioTempiAttraversamentoOut>&#xa;            &lt;xsl:if test=&quot;($get.parameters/tns1:flagExport='Y' and $get.parameters/tns1:tipoLista='A')&quot;>&#xa;                &lt;xsl:for-each select=&quot;$queryListaAggregato/Record&quot;>&#xa;                    &lt;Q1:Aggregato>&#xa;                        &lt;Q1:DataEstrazione>&#xa;                            &lt;xsl:value-of select=&quot;substring-before(string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                        &lt;/Q1:DataEstrazione>&#xa;                        &lt;xsl:if test=&quot;DESCR_SOTTO_FAMIG_OFFERTA&quot;>&#xa;                            &lt;Q1:Ambito>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_SOTTO_FAMIG_OFFERTA&quot;/>&#xa;                            &lt;/Q1:Ambito>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;Q1:Servizio>&#xa;                            &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                        &lt;/Q1:Servizio>&#xa;                        &lt;Q1:OrdinativiInSlaDtu>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_GCZ_DTU_SLA)&quot;/>&#xa;                        &lt;/Q1:OrdinativiInSlaDtu>&#xa;                        &lt;Q1:PercOrdinativiInSlaDtu>&#xa;                            &lt;xsl:value-of select=&quot;if(not(contains(xsd:string(PERCENTUALE_ORDN_GCZ_DTU_SLA), &amp;quot;.&amp;quot;))) then xsd:int(PERCENTUALE_ORDN_GCZ_DTU_SLA) else round-half-to-even(PERCENTUALE_ORDN_GCZ_DTU_SLA, 2)&quot;/>&#xa;                        &lt;/Q1:PercOrdinativiInSlaDtu>&#xa;                        &lt;Q1:OrdinativiFuoriSlaDtu>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_GCZ_DTU_FUORI_SLA)&quot;/>&#xa;                        &lt;/Q1:OrdinativiFuoriSlaDtu>&#xa;                        &lt;Q1:PercOrdinativiFuoriSlaDtu>&#xa;                            &lt;xsl:value-of select=&quot;if(not(contains(xsd:string(PERC_ORDN_GCZ_DTU_FUORISLA), &amp;quot;.&amp;quot;))) then xsd:int(PERC_ORDN_GCZ_DTU_FUORISLA) else round-half-to-even(PERC_ORDN_GCZ_DTU_FUORISLA, 2)&quot;/>&#xa;                        &lt;/Q1:PercOrdinativiFuoriSlaDtu>&#xa;                        &lt;Q1:OrdinativiRimodulatiDtu>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_RIMODULATI_DTU)&quot;/>&#xa;                        &lt;/Q1:OrdinativiRimodulatiDtu>&#xa;                        &lt;Q1:PercOrdinativiRimodulatiDtu>&#xa;                            &lt;xsl:value-of select=&quot;if(not(contains(xsd:string(PERC_ORDN_RIMD_DTU), &amp;quot;.&amp;quot;))) then xsd:int(PERC_ORDN_RIMD_DTU) else round-half-to-even(PERC_ORDN_RIMD_DTU, 2)&quot;/>&#xa;                        &lt;/Q1:PercOrdinativiRimodulatiDtu>&#xa;                        &lt;Q1:OrdinativiInSlaNow>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_GCZ_NOW_SLA)&quot;/>&#xa;                        &lt;/Q1:OrdinativiInSlaNow>&#xa;                        &lt;Q1:PercOrdinativiInSlaNow>&#xa;                            &lt;xsl:value-of select=&quot;if(not(contains(xsd:string(PERCENTUALE_ORDN_GCZ_NOW_SLA), &amp;quot;.&amp;quot;))) then xsd:int(PERCENTUALE_ORDN_GCZ_NOW_SLA) else round-half-to-even(PERCENTUALE_ORDN_GCZ_NOW_SLA, 2)&quot;/>&#xa;                        &lt;/Q1:PercOrdinativiInSlaNow>&#xa;                        &lt;Q1:OrdinativiFuoriSlaNow>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_GCZ_NOW_FUORI_SLA)&quot;/>&#xa;                        &lt;/Q1:OrdinativiFuoriSlaNow>&#xa;                        &lt;Q1:PercOrdinativiFuoriSlaNow>&#xa;                            &lt;xsl:value-of select=&quot;if(not(contains(xsd:string(PERC_ORDN_GCZ_NOW_FUORISLA), &amp;quot;.&amp;quot;))) then xsd:int(PERC_ORDN_GCZ_NOW_FUORISLA) else round-half-to-even(PERC_ORDN_GCZ_NOW_FUORISLA, 2)&quot;/>&#xa;                        &lt;/Q1:PercOrdinativiFuoriSlaNow>&#xa;                        &lt;Q1:OrdinativiRimodulatiNow>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_RIMODULATI_NOW)&quot;/>&#xa;                        &lt;/Q1:OrdinativiRimodulatiNow>&#xa;                        &lt;Q1:PercOrdinativiRimodulatiNow>&#xa;                            &lt;xsl:value-of select=&quot;if(not(contains(xsd:string(PERC_ORDN_RIMD_NOW), &amp;quot;.&amp;quot;))) then xsd:int(PERC_ORDN_RIMD_NOW) else round-half-to-even(PERC_ORDN_RIMD_NOW, 2)&quot;/>&#xa;                        &lt;/Q1:PercOrdinativiRimodulatiNow>&#xa;                        &lt;Q1:OrdinativiInSlaE2E>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_E2E_SLA)&quot;/>&#xa;                        &lt;/Q1:OrdinativiInSlaE2E>&#xa;                        &lt;Q1:PercOrdinativiInSlaE2E>&#xa;                            &lt;xsl:value-of select=&quot;if(not(contains(xsd:string(PERCENTUALE_ORDN_E2E_FUORI_SLA), &amp;quot;.&amp;quot;))) then xsd:int(PERCENTUALE_ORDN_E2E_FUORI_SLA) else round-half-to-even(PERCENTUALE_ORDN_E2E_FUORI_SLA, 2)&quot;/>&#xa;                        &lt;/Q1:PercOrdinativiInSlaE2E>&#xa;                        &lt;Q1:OrdinativiFuoriSlaE2E>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(NUMERO_ORDN_E2E_FUORI_SLA)&quot