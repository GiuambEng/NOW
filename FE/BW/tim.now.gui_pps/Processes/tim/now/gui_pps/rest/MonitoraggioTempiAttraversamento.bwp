&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20160905153433PLT" xmlns:ns="http://www.tim.com/NOW/rest/MonitoraggioTempiAttraversamento" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="ReplyError-input" match="/"&gt;&lt;tns:getResponse2&gt;&lt;item&gt;&lt;ns:MonitoraggioTempiAttraversamentoOut&gt;&lt;ns:result&gt;&lt;ns:severity&gt;&lt;xsl:value-of select="'ERROR'"/&gt;&lt;/ns:severity&gt;&lt;xsl:if test="$FaultDetails/MsgCode"&gt;&lt;ns:code&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/ns:code&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FaultDetails/Msg"&gt;&lt;ns:details&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/ns:details&gt;&lt;/xsl:if&gt;&lt;/ns:result&gt;&lt;/ns:MonitoraggioTempiAttraversamentoOut&gt;&lt;/item&gt;&lt;/tns:getResponse2&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
