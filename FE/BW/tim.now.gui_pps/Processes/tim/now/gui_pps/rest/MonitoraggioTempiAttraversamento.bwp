nAnnullamentoDeliveryInCaricoDtuNoSla>&#xa;                        &lt;Q1:TotInAccettazionePreventivoDTUSLA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(ORD_INACCPREV_SLA)&quot;/>&#xa;                        &lt;/Q1:TotInAccettazionePreventivoDTUSLA>&#xa;                        &lt;Q1:TotInAccettazionePreventivoDTUNoSLA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(ORD_INACCPREV_NOSLA)&quot;/>&#xa;                        &lt;/Q1:TotInAccettazionePreventivoDTUNoSLA>&#xa;                        &lt;Q1:TotInAttesaConsuntivoDTUSLA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(ORD_INATTESACONSUNTIVO_SLA)&quot;/>&#xa;                        &lt;/Q1:TotInAttesaConsuntivoDTUSLA>&#xa;                        &lt;Q1:TotInAttesaConsuntivoDTUNoSLA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(ORD_INATTESACONSUNTIVO_NOSLA)&quot;/>&#xa;                        &lt;/Q1:TotInAttesaConsuntivoDTUNoSLA>&#xa;                        &lt;Q1:TotInAttesaEspletamentoFoniaDTUSLA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(ORD_INATTSPFON_SLA)&quot;/>&#xa;                        &lt;/Q1:TotInAttesaEspletamentoFoniaDTUSLA>&#xa;                        &lt;Q1:TotInAttesaEspletamentoFoniaDTUNoSLA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(ORD_INATTSPFON_NOSLA)&quot;/>&#xa;                        &lt;/Q1:TotInAttesaEspletamentoFoniaDTUNoSLA>&#xa;                        &lt;Q1:TotInRichiestaPreventivoDTUSLA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(ORD_INRICHPREVENTIVO_SLA)&quot;/>&#xa;                        &lt;/Q1:TotInRichiestaPreventivoDTUSLA>&#xa;                        &lt;Q1:TotInRichiestaPreventivoDTUNoSLA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(ORD_INRICHPREVENTIVO_NOSLA)&quot;/>&#xa;                        &lt;/Q1:TotInRichiestaPreventivoDTUNoSLA>&#xa;                        &lt