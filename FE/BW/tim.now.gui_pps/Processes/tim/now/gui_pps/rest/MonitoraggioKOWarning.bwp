                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+af8f6a18-2618-480c-b163-cc976571ba03+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioKOWarning/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;dettaglioQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;TIMSTP_AGGTO_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;format-date(xsd:date($get2.parameters/tns1:dataAggiornamento), &amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)&quot;/>&#xa;            &lt;/TIMSTP_AGGTO_RICH_OLO>&#xa;            &lt;TIPO_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns1:tipoErrore&quot;/>&#xa;            &lt;/TIPO_ERRORE>&#xa;            &lt;CAUS_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns1:codCausOLO&quot;/>&#xa;            &lt;/CAUS_ERRORE>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT R.IDRICHIESTAOLO,R.DATAINVIORICHIESTA,R.CODIFICAOLOAGCOM,R.CODIFICAOLONOW,R.CODICEORDINETI,R.STATORICHIESTANOW,R.STATORICHIESTAOLO,R.DRO,R.IDRISORSA,R.OFFERTA,F.DESCR&#xa;FROM BDS_1_CASEDATA_RICHIESTA R &#xa;LEFT JOIN PPS_LAVRZ_HD HD ON HD.ID_RICH_OLO=R.IDRICHIESTAOLO&#xa;LEFT JOIN OFFERTA O ON O.ID_OFFERTA=R.IDOFFERTA&#xa;LEFT JOIN FAMIG_OFFERTA F ON F.ID_FAMIG_OFFERTA=O.ID_FAMIG_OFFERTA&#xa;WHERE trunc(HD.TIMSTP_AGGTO_RICH_OLO) = to_Date(?,'DD/MM/YY') AND UPPER(HD.TIPO_ERRORE)=UPPER(?) AND UPPER(HD.CAUS_ESITO)=UPPER(?)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIMSTP_AGGTO_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_ERRORE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CAUS_ERRORE"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLONOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINETI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DRO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
