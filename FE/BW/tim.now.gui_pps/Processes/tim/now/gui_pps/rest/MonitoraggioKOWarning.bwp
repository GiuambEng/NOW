                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+af8f6a18-2618-480c-b163-cc976571ba03+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioKOWarning/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get2&quot;/>&lt;xsl:template name=&quot;dettaglioQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;TIMSTP_AGGTO_RICH_OLO>&lt;xsl:value-of select=&quot;format-date(xsd:date($get2/parameters/tns1:dettagliokowarningGetParameters/tns1:dataAggiornamento), &amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)&quot;/>&lt;/TIMSTP_AGGTO_RICH_OLO>&lt;TIPO_ERRORE>&lt;xsl:value-of select=&quot;$get2/parameters/tns1:dettagliokowarningGetParameters/tns1:tipoErrore&quot;/>&lt;/TIPO_ERRORE>&lt;CAUS_ERRORE>&lt;xsl:value-of select=&quot;$get2/parameters/tns1:dettagliokowarningGetParameters/tns1:codCausOLO&quot;/>&lt;/CAUS_ERRORE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
