                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/monitoraggioKOdiTipoWarning&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;queryListaContatoriAggregati&quot;/>&lt;xsl:template name=&quot;listaContatoriAggregati&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($queryListaContatoriAggregati/Record)>0&quot;>&lt;tns:outputMonitoraggioKOWarning>&lt;xsl:for-each select=&quot;$queryListaContatoriAggregati/Record&quot;>&lt;tns:OutputMonitoraggioKOWarning>&lt;tns:dataEstrazione>&lt;xsl:value-of select=&quot;substring-before(string(DATA_OPERAZIONE),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataEstrazione>&lt;tns:totale>&lt;xsl:value-of select=&quot;xsd:int(TOT)&quot;/>&lt;/tns:totale>&lt;tns:causaleErrore>&lt;xsl:value-of select=&quot;CAUS&quot;/>&lt;/tns:causaleErrore>&lt;/tns:OutputMonitoraggioKOWarning>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputMonitoraggioKOWarning>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputMonitoraggioKOWarning>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun elemento nella tabella&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputMonitoraggioKOWarning>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
