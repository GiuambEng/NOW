                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3af1541e-84a3-46d9-a36a-9762302f0e66+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioKOWarning/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:template name=&quot;contatoriQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;TIMSTP_AGGTO_RICH_OLO>&lt;xsl:value-of select=&quot;format-date(xsd:date($get1/parameters/tns1:monitoraggiokowarning1GetParameters/tns1:dataOperazione), &amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)&quot;/>&lt;/TIMSTP_AGGTO_RICH_OLO>&lt;CAUS_ERRORE>&lt;xsl:value-of select=&quot;tib:trim($get1/parameters/tns1:monitoraggiokowarning1GetParameters/tns1:causale)&quot;/>&lt;/CAUS_ERRORE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="contatoriQuery-input"
                                    name="contatoriQuery"
                                    outputVariable="contatoriQuery"
                                    tibex:xpdlId="3af1541e-84a3-46d9-a36a-9762302f0e66" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_monitoraggioKOWarningLiv1_InputLog_INFOTocontatoriQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3af1541e-84a3-46d9-a36a-9762302f0e66+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioKOWarning/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;contatoriQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;TIMSTP_AGGTO_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;format-date(xsd:date($get1.parameters/tns1:dataOperazione), &amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)&quot;/>&#xa;            &lt;/TIMSTP_AGGTO_RICH_OLO>&#xa;            &lt;CAUS_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($get1.parameters/tns1:causale)&quot;/>&#xa;            &lt;/CAUS_ERRORE>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT HD.CAUS_ESITO,R.OFFERTA,R.LAVORAZIONE,HD.DESCR_CAUS_ESITO,AGG.DATA_OPERAZIONE, count (*) as count&#xa;FROM PPS_LAVRZ_HD HD&#xa;LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON HD.ID_RICH_OLO=R.IDRICHIESTAOLO&#xa;LEFT JOIN PPS_LAVRZ_HD_WARNING_AGGRA AGG ON trunc(HD.TIMSTP_AGGTO_RICH_OLO)=to_Date(AGG.DATA_OPERAZIONE,'DD/MM/YY')&#xa;WHERE trunc(HD.TIMSTP_AGGTO_RICH_OLO) = to_Date(?,'DD/MM/YY') AND TRIM(HD.CAUS_ERRORE)=TRIM(?) AND UPPER(HD.TIPO_ERRORE)='WARNING'&#xa;GROUP BY HD.CAUS_ESITO,R.OFFERTA,R.LAVORAZIONE,HD.DESCR_CAUS_ESITO,AGG.DATA_OPERAZIONE" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIMSTP_AGGTO_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CAUS_ERRORE"/>
                                    <columnMetadata
                                    columnName="CAUS_ESITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_ESITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_OPERAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="COUNT"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
