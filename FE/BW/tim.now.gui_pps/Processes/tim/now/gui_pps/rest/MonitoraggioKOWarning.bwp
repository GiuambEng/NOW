                                    <bpws:target linkName="JDBCQuery1ToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToget_MonitoraggioKOWarningDettaglio_out_Log"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/monitoraggioKOdiTipoWarning&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;dettaglioQuery&quot;/>&lt;xsl:template name=&quot;dettaglioMapper-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($dettaglioQuery/Record)>0&quot;>&lt;tns:dettaglioMonitoraggioKOWarning>&lt;xsl:for-each select=&quot;$dettaglioQuery/Record&quot;>&lt;tns:DettaglioMonitoraggioKOWarning>&lt;tns:dataCreazioneRichiesta>&lt;xsl:value-of select=&quot;substring-before(string(DATAINVIORICHIESTA),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataCreazioneRichiesta>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&lt;tns:codiceOAO>&lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&lt;/tns:codiceOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINETI&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:statoNOW>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:statoNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:statoOLO>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:statoOLO>&lt;/xsl:if>&lt;tns:DRO>&lt;xsl:value-of select=&quot;substring-before(string(DRO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DRO>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:ambito>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:ambito>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;tns:idRichiesta>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiesta>&lt;/tns:DettaglioMonitoraggioKOWarning>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:dettaglioMonitoraggioKOWarning>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dettaglioMonitoraggioKOWarning>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:dettaglioMonitoraggioKOWarning>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:monitoraggioKOdiTipoWarning="http://www.tim.com/NOW/rest/monitoraggioKOdiTipoWarning" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="monitoraggioKOdiTipoWarning:dettaglioMonitoraggioKOWarning" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
