                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioNotifiche_OLO&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect1&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;Dettaglio&quot; match=&quot;/&quot;>&lt;tns:Output_Dettaglio_MonitoraggioNotifiche_OLO>&lt;xsl:for-each select=&quot;$SQLDirect1/unknownResultset/row&quot;>&lt;tns:Lista_Dettaglio>&lt;xsl:if test=&quot;not((string(column[name='COD_ORDN_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_ORDN_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_ORDN_OLO']/value)&quot;>&lt;tns:ordineOLO>&lt;xsl:value-of select=&quot;column[name='COD_ORDN_OLO']/value&quot;/>&lt;/tns:ordineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCR_FAMIG_OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_FAMIG_OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_FAMIG_OFFERTA']/value)&quot;>&lt;tns:ambito>&lt;xsl:value-of select=&quot;column[name='DESCR_FAMIG_OFFERTA']/value&quot;/>&lt;/tns:ambito>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_ORDN_TI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_ORDN_TI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_ORDN_TI']/value)&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;column[name='COD_ORDN_TI']/value&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='ID_RICH_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_RICH_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_RICH_OLO']/value)&quot;>&lt;tns:idRichiesta>&lt;xsl:value-of select=&quot;column[name='ID_RICH_OLO']/value&quot;/>&lt;/tns:idRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLG_LAVRZ']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLG_LAVRZ']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLG_LAVRZ']/value)&quot;>&lt;tns:lavorazione>&lt;xsl:value-of select=&quot;column[name='TIPOLG_LAVRZ']/value&quot;/>&lt;/tns:lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATO_A']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO_A']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO_A']/value)&quot;>&lt;tns:stato_A>&lt;xsl:value-of select=&quot;column[name='STATO_A']/value&quot;/>&lt;/tns:stato_A>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATO_DA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO_DA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO_DA']/value)&quot;>&lt;tns:stato_DA>&lt;xsl:value-of select=&quot;column[name='STATO_DA']/value&quot;/>&lt;/tns:stato_DA>&lt;/xsl:if>&lt;tns:dataNotifica>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_NOTF']/value),&amp;quot;T&amp;quot;)&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:dataNotifica>&lt;xsl:if test=&quot;not((string(column[name='ID_NOTF']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_NOTF']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_NOTF']/value)&quot;>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;column[name='ID_NOTF']/value&quot;/>&lt;/tns:idNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR']/value)&quot;>&lt;tns:descrizione>&lt;xsl:value-of select=&quot;column[name='DESCR']/value&quot;/>&lt;/tns:descrizione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLG_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLG_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLG_OLO']/value)&quot;>&lt;tns:tipologiaOLO>&lt;xsl:value-of select=&quot;column[name='TIPOLG_OLO']/value&quot;/>&lt;/tns:tipologiaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CANALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CANALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CANALE']/value)&quot;>&lt;tns:canale>&lt;xsl:value-of select=&quot;column[name='CANALE']/value&quot;/>&lt;/tns:canale>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCR_FAMIG_OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_FAMIG_OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_FAMIG_OFFERTA']/value)&quot;>&lt;tns:famigliaOfferta>&lt;xsl:value-of select=&quot;column[name='DESCR_FAMIG_OFFERTA']/value&quot;/>&lt;/tns:famigliaOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']/value)&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;column[name='OFFERTA']/value&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_FILE_NOTF_ORARIA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_FILE_NOTF_ORARIA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_FILE_NOTF_ORARIA']/value)&quot;>&lt;tns:nomeFILE_NotificaOraria>&lt;xsl:value-of select=&quot;column[name='NOME_FILE_NOTF_ORARIA']/value&quot;/>&lt;/tns:nomeFILE_NotificaOraria>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_FILE_NOTF_GIORNALIERA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_FILE_NOTF_GIORNALIERA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_FILE_NOTF_GIORNALIERA']/value)&quot;>&lt;tns:nomeFILE_NotificaGiornaliera>&lt;xsl:value-of select=&quot;column[name='NOME_FILE_NOTF_GIORNALIERA']/value&quot;/>&lt;/tns:nomeFILE_NotificaGiornaliera>&lt;/xsl:if>&lt;tns:dataInvio_File>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_INVIO_FILE']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInvio_File>&lt;xsl:if test=&quot;not((string(column[name='ESITO_INVIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ESITO_INVIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ESITO_INVIO']/value)&quot;>&lt;tns:esito_Invio>&lt;xsl:value-of select=&quot;column[name='ESITO_INVIO']/value&quot;/>&lt;/tns:esito_Invio>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='ATTESA_S_N']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ATTESA_S_N']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ATTESA_S_N']/value)&quot;>&lt;tns:attesa>&lt;xsl:value-of select=&quot;column[name='ATTESA_S_N']/value&quot;/>&lt;/tns:attesa>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO']/value)&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;column[name='STATO']/value&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;tns:dataPassaggio_Stato>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_PASSAGGIO_STATO']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataPassaggio_Stato>&lt;tns:dataAcquisizione_Ordine>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_ACQUISIZIONE_ORDN']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataAcquisizione_Ordine>&lt;xsl:if test=&quot;not((string(column[name='NUMERO_TELEFONICO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NUMERO_TELEFONICO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NUMERO_TELEFONICO']/value)&quot;>&lt;tns:numeroTelefono_Cliente>&lt;xsl:value-of select=&quot;column[name='NUMERO_TELEFONICO']/value&quot;/>&lt;/tns:numeroTelefono_Cliente>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='SOGLIA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='SOGLIA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='SOGLIA']/value)&quot;>&lt;tns:soglia>&lt;xsl:value-of select=&quot;column[name='SOGLIA']/value&quot;/>&lt;/tns:soglia>&lt;/xsl:if>&lt;/tns:Lista_Dettaglio>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($SQLDirect1/unknownResultset/row)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_Dettaglio_MonitoraggioNotifiche_OLO>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
