&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160829180808PLT" xmlns:tns="http://www.example.org/MonitoraggioNotifiche_OLO" version="2.0"&gt;
