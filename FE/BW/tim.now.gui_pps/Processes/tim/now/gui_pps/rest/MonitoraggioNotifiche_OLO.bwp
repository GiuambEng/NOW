                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT R.IDRICHIESTAOLO, R.DATAINVIORICHIESTA, R.CODIFICAOLOAGCOM,&#xa;R.CODIFICAOLONOW, R.CODICEORDINETI, R.STATORICHIESTANOW, R.STATORICHIESTAOLO, R.DRO, R.IDRISORSA, R.OFFERTA, FO.DESCR AS AMBITO&#xa;FROM BDS_1_CASEDATA_RICHIESTA R&#xa;LEFT JOIN OFFERTA O ON R.IDOFFERTA = O.ID_OFFERTA&#xa;LEFT JOIN FAMIG_OFFERTA FO ON O.ID_OFFERTA = FO.ID_FAMIG_OFFERTA&#xa;WHERE R.CODICEORDINETI = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICEORDINETI"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
