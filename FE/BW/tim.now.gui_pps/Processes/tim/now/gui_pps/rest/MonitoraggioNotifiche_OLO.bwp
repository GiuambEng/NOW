                            <bpws:reply name="getOut" operation="get"
                                partnerLink="monitoraggionotifiche_olo1"
                                portType="ns:monitoraggionotifiche_olo12"
                                tibex:xpdlId="6484f0a2-12fa-4d43-850b-3fdac77c2847" variable="getOut-input1">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160829180808PLT" xmlns:tns="http://www.example.org/MonitoraggioNotifiche_OLO" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="RICHIESTA_OLO"/&gt;
    &lt;xsl:param name="MaxRows"/&gt;
    &lt;xsl:template name="getOut-input1" match="/"&gt;
        &lt;tns2:getResponse6&gt;
            &lt;item&gt;
                &lt;tns:Output_RICHIESTA_OLO&gt;
                    &lt;xsl:for-each select="$RICHIESTA_OLO/Record"&gt;
                        &lt;tns:Output_RICHIESTA_OLO&gt;
                            &lt;tns:dataCreazioneRichiesta&gt;
                                &lt;xsl:value-of select="substring-before(xsd:string(DATAINVIORICHIESTA), 'T')"/&gt;
                            &lt;/tns:dataCreazioneRichiesta&gt;
                            &lt;xsl:if test="CODIFICAOLOAGCOM"&gt;
                                &lt;tns:CodificaOloAgcom&gt;
                                    &lt;xsl:value-of select="CODIFICAOLOAGCOM"/&gt;
                                &lt;/tns:CodificaOloAgcom&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="CODIFICAOLONOW"&gt;
                                &lt;tns:CodificaOloNow&gt;
                                    &lt;xsl:value-of select="CODIFICAOLONOW"/&gt;
                                &lt;/tns:CodificaOloNow&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="CODICEORDINETI"&gt;
                                &lt;tns:ordineTI&gt;
                                    &lt;xsl:value-of select="CODICEORDINETI"/&gt;
                                &lt;/tns:ordineTI&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="STATORICHIESTANOW"&gt;
                                &lt;tns:statoNOW&gt;
                                    &lt;xsl:value-of select="STATORICHIESTANOW"/&gt;
                                &lt;/tns:statoNOW&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="STATORICHIESTAOLO"&gt;
                                &lt;tns:statoOLO&gt;
                                    &lt;xsl:value-of select="STATORICHIESTAOLO"/&gt;
                                &lt;/tns:statoOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns:idRichiesta&gt;
                                &lt;xsl:value-of select="IDRICHIESTAOLO"/&gt;
                            &lt;/tns:idRichiesta&gt;
                            &lt;tns:DRO&gt;
                                &lt;xsl:value-of select="substring-before(xsd:string(DRO), 'T')"/&gt;
                            &lt;/tns:DRO&gt;
                            &lt;xsl:if test="IDRISORSA"&gt;
                                &lt;tns:idRisorsa&gt;
                                    &lt;xsl:value-of select="IDRISORSA"/&gt;
                                &lt;/tns:idRisorsa&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="AMBITO"&gt;
                                &lt;tns:ambito&gt;
                                    &lt;xsl:value-of select="AMBITO"/&gt;
                                &lt;/tns:ambito&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="OFFERTA"&gt;
                                &lt;tns:offerta&gt;
                                    &lt;xsl:value-of select="OFFERTA"/&gt;
                                &lt;/tns:offerta&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:Output_RICHIESTA_OLO&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                        &lt;/tns:severity&gt;
                        &lt;tns:code&gt;
                            &lt;xsl:value-of select="if(count($RICHIESTA_OLO/Record)&gt;$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;"/&gt;
                        &lt;/tns:code&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:Output_RICHIESTA_OLO&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse6&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160829180808PLT&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioNotifiche_OLO&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RICHIESTA_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input1&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output_RICHIESTA_OLO>&#xa;            &lt;xsl:for-each select=&quot;$RICHIESTA_OLO/Record&quot;>&#xa;                &lt;tns:Output_RICHIESTA_OLO>&#xa;                    &lt;tns:dataCreazioneRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATAINVIORICHIESTA), 'T')&quot;/>&#xa;                    &lt;/tns:dataCreazioneRichiesta>&#xa;                    &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                        &lt;tns:CodificaOloAgcom>&#xa;                            &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                        &lt;/tns:CodificaOloAgcom>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&#xa;                        &lt;tns:CodificaOloNow>&#xa;                            &lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&#xa;                        &lt;/tns:CodificaOloNow>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                        &lt;tns:ordineTI>&#xa;                            &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                        &lt;/tns:ordineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&#xa;                        &lt;tns:statoNOW>&#xa;                            &lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&#xa;                        &lt;/tns:statoNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&#xa;                        &lt;tns:statoOLO>&#xa;                            &lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&#xa;                        &lt;/tns:statoOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:idRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                    &lt;/tns:idRichiesta>&#xa;                    &lt;tns:DRO>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(DRO), 'T')&quot;/>&#xa;                    &lt;/tns:DRO>&#xa;                    &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                        &lt;tns:idRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                        &lt;/tns:idRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;AMBITO&quot;>&#xa;                        &lt;tns:ambito>&#xa;                            &lt;xsl:value-of select=&quot;AMBITO&quot;/>&#xa;                        &lt;/tns:ambito>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                        &lt;tns:offerta>&#xa;                            &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                        &lt;/tns:offerta>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:Output_RICHIESTA_OLO>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;if(count($RICHIESTA_OLO/Record)>$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/tns:code>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:Output_RICHIESTA_OLO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess12TogetOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://xmlns.example.com/MonitoraggioNotifiche_OLO/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:param name=&quot;get3&quot;/>&#xa;    &lt;xsl:template name=&quot;get2InputLogMsg-input1&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioNotifiche_OLO&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioNotifiche_OLO&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$get3/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get3/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputMonitoraggioNotifiche_OLO:&amp;quot;,tib:render-xml($get3/httpHeaders/tns1:httpHeaders, true(),true()))&quot;/>&#xa;                &lt;/tns3:Payload>&#