&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20160829180808PLT" xmlns:tns="http://www.example.org/MonitoraggioNotifiche_OLO" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.example.org/CryptoParams" version="2.0"&gt;
