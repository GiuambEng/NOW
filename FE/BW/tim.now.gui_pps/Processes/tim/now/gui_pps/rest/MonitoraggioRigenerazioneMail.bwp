                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RigenerazioneEmail&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:inputservizioricercaavanzata>&#xa;            &lt;xsl:for-each select=&quot;$post.item/tns:strutturaCondition&quot;>&#xa;                &lt;tns1:strutturaCondition>&#xa;                    &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                        &lt;tns1:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                        &lt;/tns1:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:operazione&quot;>&#xa;                        &lt;tns1:operazione>&#xa;                            &lt;xsl:value-of select=&quot;tns:operazione&quot;/>&#xa;                        &lt;/tns1:operazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:valore&quot;>&#xa;                        &lt;tns1:valore>&#xa;                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                        &lt;/tns1:valore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:tipo&quot;>&#xa;                        &lt;tns1:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns:tipo&quot;/>&#xa;                        &lt;/tns1:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:indiceriga&quot;>&#xa;                &lt;tns1:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:indiceriga&quot;/>&#xa;                &lt;/tns1:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:numerorighe&quot;>&#xa;                &lt;tns1:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:numerorighe&quot;/>&#xa;                &lt;/tns1:numerorighe>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_pps.sub.RicercaAvanzataConditions" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Richieste"
                                    name="Assign"
                                    outputVariable="Richieste"
                                    tibex:xpdlId="6daace7f-1e6e-49ef-b01d-a4d8cc2b1f28" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SQLDirectToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignTopostOutputLogInfo">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AssignToJDBCQuery_Export">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$post/item/ns5:Input_Rigenerazione_Email_RicercaAvanzata/ns5:exportRequest=&quot;Y&quot; or  $post/item/ns5:Input_Rigenerazione_Email_RicercaAvanzata/ns5:exportRequest=&quot;S&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$post.item/ns5:exportRequest="Y" or  $post.item/ns5:exportRequest="S"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RigenerazioneEmail&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;Richieste&quot; match=&quot;/&quot;>&lt;tns:Output_Rig_Email_Richieste>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&lt;tns:Lista_Richieste>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name='DATAINVIORICHIESTA']/value), &amp;quot;.&amp;quot;) and exists(column[name='DATAINVIORICHIESTA']/value) and string-length(string(column[name='DATAINVIORICHIESTA']/value))>0&quot;>&lt;tns:dataInvio>&lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='DATAINVIORICHIESTA']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='DATAINVIORICHIESTA']/value), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInvio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string(column[name='DATAINVIORICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DATAINVIORICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DATAINVIORICHIESTA']/value)&quot;>&lt;tns:dataInvio>&lt;xsl:value-of select=&quot;column[name='DATAINVIORICHIESTA']/value&quot;/>&lt;/tns:dataInvio>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLO']/value)&quot;>&lt;tns:codiceOrdineOao>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLO']/value&quot;/>&lt;/tns:codiceOrdineOao>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINETI']/value)&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;column[name='CODICEORDINETI']/value&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='LAVORAZIONE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='LAVORAZIONE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='LAVORAZIONE']/value)&quot;>&lt;tns:tipoLavorazione>&lt;xsl:value-of select=&quot;column[name='LAVORAZIONE']/value&quot;/>&lt;/tns:tipoLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']/value)&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;column[name='OFFERTA']/value&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATORICHIESTANOW']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATORICHIESTANOW']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATORICHIESTANOW']/value)&quot;>&lt;tns:statoNow>&lt;xsl:value-of select=&quot;column[name='STATORICHIESTANOW']/value&quot;/>&lt;/tns:statoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATORICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATORICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATORICHIESTAOLO']/value)&quot;>&lt;tns:statoOao>&lt;xsl:value-of select=&quot;column[name='STATORICHIESTAOLO']/value&quot;/>&lt;/tns:statoOao>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLOAGCOM']/value)&quot;>&lt;tns:codificaOao>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLOAGCOM']/value&quot;/>&lt;/tns:codificaOao>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDRICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDRICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDRICHIESTAOLO']/value)&quot;>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;column[name='IDRICHIESTAOLO']/value&quot;/>&lt;/tns:idRichiestaOlo>&lt;/xsl:if>&lt;/tns:Lista_Richieste>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($SQLDirect/unknownResultset/row)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_Rig_Email_Richieste>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Richieste" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
