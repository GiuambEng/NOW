                                    <bpws:sources>
                                    <bpws:source linkName="ExportDatiToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/cmf.exportDati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioRigenerazioneMail/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Gen_Export_ID&quot;/>&#xa;    &lt;xsl:template name=&quot;ExportDati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputExportDati>&#xa;            &lt;tns2:xmlParameter>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns2:xmlParameter>&#xa;            &lt;tns2:listOfElements>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;dataInvio,codiceOrdineOao,ordineTI,tipoLavorazione,offerta,statoNow,statoOao,codificaOao&amp;quot;&quot;/>&#xa;            &lt;/tns2:listOfElements>&#xa;            &lt;tns2:rootElementParameter>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Output_Richieste_MonitoraggioRigenerazioneEmail&amp;quot;&quot;/>&#xa;            &lt;/tns2:rootElementParameter>&#xa;            &lt;tns2:nameOfFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioRigenerazione_Email&amp;quot;&quot;/>&#xa;            &lt;/tns2:nameOfFile>&#xa;            &lt;tns2:childRootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Lista_Richieste&amp;quot;&quot;/>&#xa;            &lt;/tns2:childRootElement>&#xa;            &lt;tns2:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Gen_Export_ID/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns2:idFile>&#xa;            &lt;xsl:if test=&quot;$post.parameters/tns1:tipoProfilo&quot;>&#xa;                &lt;tns2:tipoProfilo>&#xa;                    &lt;xsl:value-of select=&quot;$post.parameters/tns1:tipoProfilo&quot;/>&#xa;                &lt;/tns2:tipoProfilo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.parameters/tns1:userId&quot;>&#xa;                &lt;tns2:userId>&#xa;                    &lt;xsl:value-of select=&quot;$post.parameters/tns1:userId&quot;/>&#xa;                &lt;/tns2:userId>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:inputExportDati>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_pps.sub.ExportDati" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
