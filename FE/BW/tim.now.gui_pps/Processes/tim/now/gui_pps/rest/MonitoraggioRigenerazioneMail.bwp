                                    inputVariable="Gen_Export_ID-input"
                                    name="Gen_Export_ID"
                                    outputVariable="Gen_Export_ID"
                                    tibex:xpdlId="dc638983-0c85-48f4-b8d6-17da8758f314" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
