                            <bpws:reply name="postOut" operation="post"
                                partnerLink="monitoraggiorigenerazionemail-richieste"
                                portType="ns:monitoraggiorigenerazionemail-richieste"
                                tibex:xpdlId="e0c1fdb9-8b88-468d-a62e-9c3f2b60b4de" variable="postOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20180111112506PLT" xmlns:tns="http://www.example.org/RigenerazioneEmail" xmlns:tns2="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="Richieste"/&gt;
    &lt;xsl:param name="CryptoParams"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns3:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="upper-case($post/item/tns:Input_Rigenerazione_Email_RicercaAvanzata/tns:exportRequest)!='Y'"&gt;
                        &lt;xsl:copy-of select="$Richieste"/&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:Output_Rig_Email_Richieste&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="$CryptoParams/tns2:idFileCriptato"/&gt;
                            &lt;/tns:idExportFile&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:Output_Rig_Email_Richieste&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns3:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://xmlns.example.com/20180111112506PLT&quot; xmlns:tns=&quot;http://www.example.org/RigenerazioneEmail&quot; xmlns:tns2=&quot;http://www.example.org/CryptoParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Richieste&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParams&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;upper-case($post.item/tns:exportRequest)!='Y'&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$Richieste&quot;/>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Output_Rig_Email_Richieste>&#xa;                    &lt;tns:idExportFile>&#xa;                        &lt;xsl:value-of select=&quot;$CryptoParams/tns2:idFileCriptato&quot;/>&#xa;                    &lt;/tns:idExportFile>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:Output_Rig_Email_Richieste>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
