                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a23c485e-13da-4546-8be0-b751d2a1b954+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT R.DATAINVIORICHIESTA, R.CODICEORDINEOLO, R.CODICEORDINETI,R.LAVORAZIONE, R.OFFERTA, R.STATORICHIESTANOW, R.STATORICHIESTAOLO, R.CODIFICAOLOAGCOM, R.IDRICHIESTAOLO FROM BDS_1_CASEDATA_RICHIESTA R WHERE R.TIPORICHIESTA = 'ORDINE' AND R.AMBITO = 'NOW' AND R.OFFERTA != 'NP' AND R.CANALERICHIESTA != 'INTERNAL' AND &amp;quot;, $RicercaAvanzata/tns1:outputcondition[1], &amp;quot;ORDER BY R.DATAINVIORICHIESTA DESC FETCH FIRST &amp;quot;, xsd:string($MaxRows), &amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
