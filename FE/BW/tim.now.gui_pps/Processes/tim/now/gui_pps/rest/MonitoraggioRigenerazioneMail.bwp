                                    <bpws:sources>
                                    <bpws:source linkName="RenderXmlToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RigenerazioneEmail&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richieste&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;tns:Output_Rig_Email_Richieste>&lt;xsl:copy-of select=&quot;$Richieste/tns:Lista_Richieste&quot;/>&lt;tns:result/>&lt;/tns:Output_Rig_Email_Richieste>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
