                                    subProcessName="tim.now.gui_pps.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9c771204-b769-4e3f-9790-4798956e4a5f+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioRigenerazioneMail/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoNotifiche-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:monitoraggiorigenerazionemail-richiesteGetParameters/tns1:idRichiestaOlo&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoNotifiche-input"
                                    name="RecuperoNotifiche"
                                    outputVariable="RecuperoNotifiche"
                                    tibex:xpdlId="9c771204-b769-4e3f-9790-4798956e4a5f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="getInputLogInfoToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoNotificheToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9c771204-b769-4e3f-9790-4798956e4a5f+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioRigenerazioneMail/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoNotifiche-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:idRichiestaOlo&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RN.TIMSTP_CREAZIONE, RN.COD_TIPOLG_NOTF, AC.COD_CAUS_NOW_DG, AC.COD_CAUS_OLO, TN.DESCR, RN.ID_NOTF, RN.STRUTTURA_RICH&#xa;FROM RICH_ORDN_COMUNIC_NOTF RN&#xa;LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = RN.ID_RICH_OLO&#xa;LEFT JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = RN.ID_ANAG_CAUS&#xa;LEFT JOIN TIPOLG_DESTNRIO_NOTF TN ON TN.IDTPLG_DESTNRIO_NOTF = RN.IDTPLG_DESTNRIO_NOTF&#xa;WHERE R.IDRICHIESTAOLO = ?&#xa;ORDER BY RN.TIMSTP_CREAZIONE DESC&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_NOW_DG"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_NOTF"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STRUTTURA_RICH"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Notifiche"
                                    name="Assign1"
                                    outputVariable="Notifiche"
                                    tibex:xpdlId="247445b8-a442-43b7-b817-3918223c1898" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RecuperoNotificheToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1TogetOutputLogInfo"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RigenerazioneEmail&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoNotifiche&quot;/>&lt;xsl:template name=&quot;Notifiche&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperoNotifiche/Record) >0 and $RecuperoNotifiche/Record[STRUTTURA_RICH = 'REGOLATORIO']/COD_TIPOLG_NOTF = 'RD'&quot;>&lt;tns:Output_Rig_Email_Notifiche>&lt;xsl:for-each select=&quot;$RecuperoNotifiche/Record[STRUTTURA_RICH = ('REGOLATORIO','NGA') and COD_TIPOLG_NOTF = 'RD']&quot;>&lt;tns:listaNotifiche>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:codiceNotifica>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF&quot;/>&lt;/tns:codiceNotifica>&lt;xsl:if test=&quot;COD_CAUS_NOW_DG&quot;>&lt;tns:codiceCausaleNow>&lt;xsl:value-of select=&quot;COD_CAUS_NOW_DG&quot;/>&lt;/tns:codiceCausaleNow>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_CAUS_OLO&quot;>&lt;tns:codiceCausaleOao>&lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&lt;/tns:codiceCausaleOao>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:destinatario>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:destinatario>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_NOTF)&quot;>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;xsd:int(ID_NOTF)&quot;/>&lt;/tns:idNotifica>&lt;/xsl:if>&lt;/tns:listaNotifiche>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_Rig_Email_Notifiche>&lt;/xsl:when>&lt;xsl:when test=&quot;count($RecuperoNotifiche/Record)>0 and $RecuperoNotifiche/Record[STRUTTURA_RICH = 'NGA']/COD_TIPOLG_NOTF = ('AC','AK','AQ','CO','FS','KA','KO','KR','NL','NP','OK','RD','SC','SP','SU')&quot;>&lt;tns:Output_Rig_Email_Notifiche>&lt;xsl:for-each select=&quot;$RecuperoNotifiche/Record[STRUTTURA_RICH = 'NGA' and COD_TIPOLG_NOTF = ('AC','AK','AQ','CO','FS','KA','KO','KR','NL','NP','OK','RD','SC','SP','SU')]&quot;>&lt;tns:listaNotifiche>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:codiceNotifica>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF&quot;/>&lt;/tns:codiceNotifica>&lt;xsl:if test=&quot;COD_CAUS_NOW_DG&quot;>&lt;tns:codiceCausaleNow>&lt;xsl:value-of select=&quot;COD_CAUS_NOW_DG&quot;/>&lt;/tns:codiceCausaleNow>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_CAUS_OLO&quot;>&lt;tns:codiceCausaleOao>&lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&lt;/tns:codiceCausaleOao>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:destinatario>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:destinatario>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_NOTF)&quot;>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;xsd:int(ID_NOTF)&quot;/>&lt;/tns:idNotifica>&lt;/xsl:if>&lt;/tns:listaNotifiche>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_Rig_Email_Notifiche>&lt;/xsl:when>&lt;xsl:when test=&quot;count($RecuperoNotifiche/Record)>0 and $RecuperoNotifiche/Record[STRUTTURA_RICH = 'XDSL']/COD_TIPOLG_NOTF = ('AK','AQ','CO','FS','KA','KO','KR','NL','NP','OK','SC','SP','SU')&quot;>&lt;tns:Output_Rig_Email_Notifiche>&lt;xsl:for-each select=&quot;$RecuperoNotifiche/Record[STRUTTURA_RICH = 'XDSL' and COD_TIPOLG_NOTF = ('AK','AQ','CO','FS','KA','KO','KR','NL','NP','OK','SC','SP','SU')]&quot;>&lt;tns:listaNotifiche>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:codiceNotifica>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF&quot;/>&lt;/tns:codiceNotifica>&lt;xsl:if test=&quot;COD_CAUS_NOW_DG&quot;>&lt;tns:codiceCausaleNow>&lt;xsl:value-of select=&quot;COD_CAUS_NOW_DG&quot;/>&lt;/tns:codiceCausaleNow>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_CAUS_OLO&quot;>&lt;tns:codiceCausaleOao>&lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&lt;/tns:codiceCausaleOao>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:destinatario>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:destinatario>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_NOTF)&quot;>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;xsd:int(ID_NOTF)&quot;/>&lt;/tns:idNotifica>&lt;/xsl:if>&lt;/tns:listaNotifiche>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_Rig_Email_Notifiche>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Output_Rig_Email_Notifiche>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessuna notifica presente&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:Output_Rig_Email_Notifiche>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
