                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;MonitoraggioKODel103get_LogOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioKODel103get&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.MonitoraggioKODel103get&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputMonitoraggioKODel103get:&amp;quot;,substring(tib:render-xml($Variable, true(),true()),1,500),&amp;quot;.....&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.MonitoraggioKODel103get&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioKODel103get_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioKODel103get_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_pps.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCQuery-input"
                                    name="JDBCQuery"
                                    outputVariable="JDBCQuery"
                                    tibex:xpdlId="cf9fc150-9fc6-4d31-8c99-afa916368a8c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess5ToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cf9fc150-9fc6-4d31-8c99-afa916368a8c+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT BD.CREATED, BD.CODIFICAOLOAGCOM, BD.LAVORAZIONE, BD.OFFERTA,&#xa;  BD.CODICEORDINEOLO, BD.CODICEORDINEOLOTARGET, BD.CODICEORDINETITARGET,&#xa;  BD.IDRISORSA, BD.IDANAGRAFICACAUSALE, AC.DESCR_CAUS_INTERNO,&#xa;  BD.STATORICHIESTANOW, BD.TMPACKNPD103, BD.DAC, AR.CONTENUTO_XML_OLO&#xa;  FROM&#xa;       APPUSER.BDS_1_CASEDATA_RICHIESTA BD INNER JOIN APPUSER.ANAG_CAUS AC ON BD.IDANAGRAFICACAUSALE = AC.ID_ANAG_CAUS INNER JOIN APPUSER.ACQUISIZIONE_RICHIESTE AR ON BD.IDRICHIESTAOLO = AR.ID_RICHIESTA_OLO&#xa;  WHERE BD.FLAGDELIBERA103 = 'Y' AND BD.STATORICHIESTANOW = 'SCARTATO'&#xa;    AND BD.LAVORAZIONE IN ('ANNULLAMENTO', 'ANNULLAMENTORECIPIENT', 'RIMODULAZIONEDAC',&#xa;  'RDACRECIPIENTDONOR', 'RDACDONORDONATING')&#xa;  ORDER BY BD.CREATED DESC&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLOTARGET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINETITARGET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDANAGRAFICACAUSALE"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TMPACKNPD103"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DAC"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CONTENUTO_XML_OLO"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="Assign"
                                    outputVariable="Variable"
                                    tibex:xpdlId="9276eec2-e058-4cc4-b21d-4d0aa4105a58" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess6"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioKODel103&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record/IDRISORSA)>0&quot;>&lt;tns:MonitoraggioKODel103Output>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns:listaMonitoraggioKO>&lt;xsl:if test=&quot;CREATED&quot;>&lt;tns:dataCreazioneRichiesta>&lt;xsl:value-of select=&quot;CREATED&quot;/>&lt;/tns:dataCreazioneRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;LAVORAZIONE&quot;>&lt;tns:lavorazione>&lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&lt;/tns:lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:codiceOrdineOlo>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOLOTARGET&quot;>&lt;tns:codiceOrdineOloTarget>&lt;xsl:value-of select=&quot;CODICEORDINEOLOTARGET&quot;/>&lt;/tns:codiceOrdineOloTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINETITARGET&quot;>&lt;tns:codiceOrdineTiTarget>&lt;xsl:value-of select=&quot;CODICEORDINETITARGET&quot;/>&lt;/tns:codiceOrdineTiTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;IDANAGRAFICACAUSALE&quot;>&lt;tns:idAnagraficaCausale>&lt;xsl:value-of select=&quot;IDANAGRAFICACAUSALE&quot;/>&lt;/tns:idAnagraficaCausale>&lt;/xsl:if>&lt;tns:descrizioneCausaleInterno>&lt;xsl:value-of select=&quot;DESCR_CAUS_INTERNO&quot;/>&lt;/tns:descrizioneCausaleInterno>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:statoRichiestaNow>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:statoRichiestaNow>&lt;/xsl:if>&lt;xsl:if test=&quot;TMPACKNPD103&quot;>&lt;tns:tmpacknpd103>&lt;xsl:value-of select=&quot;TMPACKNPD103&quot;/>&lt;/tns:tmpacknpd103>&lt;/xsl:if>&lt;xsl:if test=&quot;LAVORAZIONE=('RIMODULAZIONEDAC', 'RDACRECIPIENTDONOR', 'RDACDONORDONATING')&quot;>&lt;xsl:if test=&quot;DAC&quot;>&lt;tns:dac>&lt;xsl:value-of select=&quot;DAC&quot;/>&lt;/tns:dac>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;CONTENUTO_XML_OLO&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;CONTENUTO_XML_OLO&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:if>&lt;/tns:listaMonitoraggioKO>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:MonitoraggioKODel103Output>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MonitoraggioKODel103Output>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun Record Trovato'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:MonitoraggioKODel103Output>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
