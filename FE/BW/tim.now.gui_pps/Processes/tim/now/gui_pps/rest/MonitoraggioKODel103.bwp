                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+401d0aac-30a9-49c1-9e29-7a7341c59763+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT bd.created, bd.codificaoloagcom, bd.lavorazione, bd.offerta, bd.codiceordineolo, bd.codiceordineolotarget, bd.codiceordinetitarget, bd.idrisorsa, bd.idanagraficacausale, ac.descr_caus_interno, bd.statorichiestanow, bd.tmpacknpd103,  bd.dac, ar.contenuto_xml_olo FROM bds_1_casedata_richiesta bd  INNER JOIN anag_caus ac on bd.idanagraficacausale=ac.id_anag_caus INNER JOIN acquisizione_richieste ar on bd.idrichiestaolo=ar.id_richiesta_olo where bd.flagdelibera103='Y' and bd.statorichiestanow='SCARTATO' and bd.lavorazione in ('ANNULLAMENTO', 'ANNULLAMENTORECIPIENT','RIMODULAZIONEDAC','RDACRECIPIENTDONOR','RDACDONORDONATING') and &amp;quot;, $RicercaAvanzata/tns1:outputcondition[1], &amp;quot; order by bd.created desc&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
