                                    <bpws:source linkName="Assign1ToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioKODel103&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($SQLDirect/unknownResultset[1]/row[1]/column[name='IDRISORSA']/value))>0&quot;>&lt;tns:MonitoraggioKODel103Output>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset[1]/row&quot;>&lt;tns:listaMonitoraggioKO>&lt;xsl:if test=&quot;not((string(column[name='CREATED']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CREATED']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CREATED']/value)&quot;>&lt;tns:dataCreazioneRichiesta>&lt;xsl:value-of select=&quot;column[name='CREATED']/value&quot;/>&lt;/tns:dataCreazioneRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLOAGCOM']/value)&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLOAGCOM']/value&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='LAVORAZIONE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='LAVORAZIONE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='LAVORAZIONE']/value)&quot;>&lt;tns:lavorazione>&lt;xsl:value-of select=&quot;column[name='LAVORAZIONE']/value&quot;/>&lt;/tns:lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']/value)&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;column[name='OFFERTA']/value&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLO']/value)&quot;>&lt;tns:codiceOrdineOlo>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLO']/value&quot;/>&lt;/tns:codiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLOTARGET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLOTARGET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLOTARGET']/value)&quot;>&lt;tns:codiceOrdineOloTarget>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLOTARGET']/value&quot;/>&lt;/tns:codiceOrdineOloTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINETITARGET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINETITARGET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINETITARGET']/value)&quot;>&lt;tns:codiceOrdineTiTarget>&lt;xsl:value-of select=&quot;column[name='CODICEORDINETITARGET']/value&quot;/>&lt;/tns:codiceOrdineTiTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDRISORSA']/value)&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;column[name='IDRISORSA']/value&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDANAGRAFICACAUSALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDANAGRAFICACAUSALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDANAGRAFICACAUSALE']/value)&quot;>&lt;tns:idAnagraficaCausale>&lt;xsl:value-of select=&quot;column[name='IDANAGRAFICACAUSALE']/value&quot;/>&lt;/tns:idAnagraficaCausale>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCR_CAUS_INTERNO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_CAUS_INTERNO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_CAUS_INTERNO']/value)&quot;>&lt;tns:descrizioneCausaleInterno>&lt;xsl:value-of select=&quot;column[name='DESCR_CAUS_INTERNO']/value&quot;/>&lt;/tns:descrizioneCausaleInterno>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATORICHIESTANOW']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATORICHIESTANOW']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATORICHIESTANOW']/value)&quot;>&lt;tns:statoRichiestaNow>&lt;xsl:value-of select=&quot;column[name='STATORICHIESTANOW']/value&quot;/>&lt;/tns:statoRichiestaNow>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TMPACKNPD103']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TMPACKNPD103']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TMPACKNPD103']/value)&quot;>&lt;tns:tmpacknpd103>&lt;xsl:value-of select=&quot;column[name='TMPACKNPD103']/value&quot;/>&lt;/tns:tmpacknpd103>&lt;/xsl:if>&lt;xsl:if test=&quot;column[name='LAVORAZIONE']/value=('RIMODULAZIONEDAC', 'RDACRECIPIENTDONOR', 'RDACDONORDONATING')&quot;>&lt;xsl:if test=&quot;not((string(column[name='DAC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DAC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DAC']/value)&quot;>&lt;tns:dac>&lt;xsl:value-of select=&quot;column[name='DAC']/value&quot;/>&lt;/tns:dac>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CONTENUTO_XML_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CONTENUTO_XML_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CONTENUTO_XML_OLO']/value)&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;column[name='CONTENUTO_XML_OLO']/value&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:if>&lt;/tns:listaMonitoraggioKO>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:MonitoraggioKODel103Output>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MonitoraggioKODel103Output>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun Record Trovato'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:MonitoraggioKODel103Output>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
