                                    sqlStatement="select DISTINCT(S.ID_PPS_TIPOLG_REPORT) ,TR.TIPOLG_REPORT&#xd;&#xa;from PPS_SOGLIA_ANALISI S &#xd;&#xa;left outer join PPS_TIPOLG_REPORT TR on TR.ID_PPS_TIPOLG_REPORT=S.ID_PPS_TIPOLG_REPORT&#xd;&#xa;where S.ID_PPS_AMBITO_MONITG =?" xsi:type="jdbcPalette:JDBCQueryActivity">

