                                    sqlStatement="SELECT DISTINCT (S.ID_PPS_AMBITO_MONITG) ,A.AMBITO_MONITORAGGIO&#xa;from PPS_SOGLIA_ANALISI S &#xa;JOIN PPS_AMBITO_MONITG A ON A.ID_PPS_AMBITO_MONITG = S.ID_PPS_AMBITO_MONITG&#xa;ORDER BY A.AMBITO_MONITORAGGIO&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
