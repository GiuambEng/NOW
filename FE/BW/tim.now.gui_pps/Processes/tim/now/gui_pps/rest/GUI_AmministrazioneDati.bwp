                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT S.DATAFI_VALID, S.DATAINZ_VALID, S.DESCR_SOGLIA, S.NOME_SOGLIA,&#xa;S.VALORE_SOGLIA, T.DESCR AS DESCR_FAMIGLIA_OFFERTA, U.OFFERTA,&#xa;V.STATO_RICH_NOW, W.DESCR_STATO_FILE, Z.TIPOLG_LAVRZ, Y.DESCR AS DESCR_SOTTOLAVRZ,&#xa;R.DESCR_CAUS_NOW_DG, X.TIPOLG_PPS_SOGLIA, S.ID_PPS_SOGLIA_ANALISI&#xa;FROM PPS_SOGLIA_ANALISI S &#xa;left join ANAG_CAUS R on R.ID_ANAG_CAUS = S.ID_ANAG_CAUS&#xa;left join FAMIG_OFFERTA T on T.ID_FAMIG_OFFERTA = S.ID_FAMIG_OFFERTA&#xa;left join OFFERTA U   on U.ID_OFFERTA = S.ID_OFFERTA&#xa;left join TIPOLG_RICH_COMSTNOW V on V.IDRICH_COM_STRC = S.IDRICH_COM_STRC  &#xa;left join TIPOLG_STATO_FILE W on W.ID_STATO_FILE = S.ID_STATO_FILE&#xa;left join TIPOLG_PPS_SOGLIA X on  X.IDTPLG_PPS_SOGLIA = S.IDTPLG_PPS_SOGLIA &#xa;left join TIPOLG_SOTTO_LAVRZ Y on Y.IDTPLG_SOTTO_LAVRZ = S.IDTPLG_SOTTO_LAVRZ&#xa;left join TIPOLG_LAVRZ Z on Z.IDTPLG_LAVRZ = Y.IDTPLG_LAVRZ&#xa;WHERE S.ID_PPS_AMBITO_MONITG = ? AND S.ID_PPS_TIPOLG_REPORT = ?&#xa;AND S.DATAFI_VALID > SYSDATE" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_PPS_AMBITO_MONITG"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_PPS_TIPOLG_REPORT"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DESCR_SOGLIA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_SOGLIA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALORE_SOGLIA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_FAMIGLIA_OFFERTA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_RICH_NOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_STATO_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLG_LAVRZ"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_SOTTOLAVRZ"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_NOW_DG"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLG_PPS_SOGLIA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_PPS_SOGLIA_ANALISI"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
