                                    sqlStatement="INSERT INTO PPS_SOGLIA_ANALISI (DATAFI_VALID, DATAINZ_VALID,&#xa;  DESCR_SOGLIA, ID_ANAG_CAUS, ID_FAMIG_OFFERTA, ID_OFFERTA, ID_PPS_AMBITO_MONITG,&#xa;  ID_PPS_SOGLIA_ANALISI, ID_PPS_TIPOLG_REPORT, IDRICH_COM_STRC,&#xa;  ID_STATO_FILE, IDTPLG_LAVRZ, IDTPLG_PPS_SOGLIA, IDTPLG_SOTTO_LAVRZ,&#xa;  NOME_SOGLIA, VALORE_SOGLIA)&#xa;  SELECT ? , sysdate, DESCR_SOGLIA, ID_ANAG_CAUS, ID_FAMIG_OFFERTA,&#xa;  ID_OFFERTA, ID_PPS_AMBITO_MONITG,?, ID_PPS_TIPOLG_REPORT, IDRICH_COM_STRC,&#xa;  ID_STATO_FILE, IDTPLG_LAVRZ, IDTPLG_PPS_SOGLIA, IDTPLG_SOTTO_LAVRZ,&#xa;  NOME_SOGLIA,?&#xa;    FROM PPS_SOGLIA_ANALISI&#xa;    WHERE ID_PPS_SOGLIA_ANALISI = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_FINVALID"/>

