    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>post1</variable>
                <variable>post</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="postOut1">
            <endingVariables>
                <variable>postOut1-input</variable>
                <variable>Mapper1</variable>
            </endingVariables>
        </task>
        <task name="postInputLogMSG">
            <endingVariables>
                <variable>postInputLogMSG-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="postInputLogINFO">
            <endingVariables>
                <variable>postInputLogINFO-input</variable>
            </endingVariables>
        </task>
        <task name="postOutputLogINFO">
            <endingVariables>
                <variable>postOutputLogINFO-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="Iterate">
            <endingVariables>
                <variable>Mapper</variable>
                <variable>currentElement</variable>
            </endingVariables>
        </task>
        <task name="Mapper">
            <endingVariables>
                <variable>Mapper-input</variable>
                <variable>ReinvioScheduler</variable>
            </endingVariables>
        </task>
        <task name="ReinvioScheduler">
            <endingVariables>
                <variable>ReinvioScheduler-input</variable>
            </endingVariables>
        </task>
        <task name="Mapper1">
            <endingVariables>
                <variable>Mapper1-input</variable>
                <variable>Accumulate</variable>
            </endingVariables>
        </task>
        <task name="postLOGError">
            <endingVariables>
                <variable>postLOGError-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails2</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>CryptoParams</variable>
            </endingVariables>
        </task>
        <task name="post2InputLogMsg">
            <endingVariables>
                <variable>post2InputLogMsg-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="post2InputLogInfo">
            <endingVariables>
                <variable>post2InputLogInfo-input</variable>
            </endingVariables>
        </task>
        <task name="outputLogInfoPost2">
            <endingVariables>
                <variable>outputLogInfoPost2-input</variable>
                <variable>LoggerInfo</variable>
                <variable>select_ListaMail</variable>
            </endingVariables>
        </task>
        <task name="RicercaAvanzata">
            <endingVariables>
                <variable>RicercaAvanzata-input</variable>
            </endingVariables>
        </task>
        <task name="select_ListaMail">
            <endingVariables>
                <variable>select_ListaMail-input</variable>
                <variable>RicercaAvanzata</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>MaxRows</variable>
            </endingVariables>
        </task>
        <task name="GEN_Export_KEY">
            <endingVariables>
                <variable>GEN_Export_KEY-input</variable>
            </endingVariables>
        </task>
        <task name="RenderXml">
            <endingVariables>
                <variable>RenderXml-input</variable>
            </endingVariables>
        </task>
        <task name="exportDati">
            <endingVariables>
                <variable>exportDati-input</variable>
                <variable>RenderXml</variable>
            </endingVariables>
        </task>
        <task name="CryptoParams">
            <endingVariables>
                <variable>CryptoParams-input</variable>
                <variable>GEN_Export_KEY</variable>
            </endingVariables>
        </task>
        <task name="errorLogPost2">
            <endingVariables>
                <variable>errorLogPost2-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="errorLogPost2_Reply">
            <endingVariables>
                <variable>errorLogPost2_Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
