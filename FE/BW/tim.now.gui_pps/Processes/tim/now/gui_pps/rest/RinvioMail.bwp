                                    <tibex:expression
                                    expression="$post/item/tns:Input_RicercaAvanzata/tns:exportRequest=&quot;Y&quot; or $post/item/tns:Input_RicercaAvanzata/tns:exportRequest=&quot;S&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$post.item/tns:exportRequest="Y" or $post.item/tns:exportRequest="S"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Rinvio_Mail&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;select_ListaMail&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;outputListamail&quot; match=&quot;/&quot;>&lt;tns:Output_ListaMail>&lt;xsl:for-each select=&quot;$select_ListaMail/unknownResultset/row&quot;>&lt;tns:ListaMail>&lt;xsl:if test=&quot;not((string(column[name=&amp;quot;DESTNRIO_EMAIL_A&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;DESTNRIO_EMAIL_A&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;DESTNRIO_EMAIL_A&amp;quot;]/value)&quot;>&lt;tns:DESTINATARIO_EMAIL_A>&lt;xsl:value-of select=&quot;column[name=&amp;quot;DESTNRIO_EMAIL_A&amp;quot;]/value&quot;/>&lt;/tns:DESTINATARIO_EMAIL_A>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name=&amp;quot;DESTNRIO_EMAIL_CC&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;DESTNRIO_EMAIL_CC&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;DESTNRIO_EMAIL_CC&amp;quot;]/value)&quot;>&lt;tns:DESTINATARIO_EMAIL_CC>&lt;xsl:value-of select=&quot;column[name=&amp;quot;DESTNRIO_EMAIL_CC&amp;quot;]/value&quot;/>&lt;/tns:DESTINATARIO_EMAIL_CC>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name=&amp;quot;STNTF&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;STNTF&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;STNTF&amp;quot;]/value)&quot;>&lt;tns:TIPOLOGIA_NOTIFICA>&lt;xsl:value-of select=&quot;column[name=&amp;quot;STNTF&amp;quot;]/value&quot;/>&lt;/tns:TIPOLOGIA_NOTIFICA>&lt;/xsl:if>&lt;xsl:if test=