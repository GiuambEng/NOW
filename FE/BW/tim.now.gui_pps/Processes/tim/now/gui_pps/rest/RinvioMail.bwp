    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="outputListamail"/&gt;
    &lt;xsl:param name="CryptoParams"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns3:postResponse2&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="upper-case($post/item/tns:Input_RicercaAvanzata/tns:exportRequest)!='Y'"&gt;
                        &lt;xsl:copy-of select="$outputListamail"/&gt;
