                                    <bpws:sources>
                                    <bpws:source linkName="ListaMailToAssign_Name">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($select_ListaMail/unknownResultset)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($select_ListaMail/unknownResultset)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="select_empty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+78198632-7797-4ecd-86f0-a970aafe1ed7+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:template name=&quot;select_ListaMail-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT EN.CONTENUTO_MAIL,EN.DESTNRIO_EMAIL_A,EN.DESTNRIO_EMAIL_CC,TN.STNTF,EN.OGGETTO,EN.ID_NOTF,EN.TIMSTP_INVIO from EMAIL_NOTF EN left join TIPOLG_STNTF TN ON TN.IDTPLG_STNTF =  EN.IDTPLG_STNTF  WHERE &amp;quot;,$RicercaAvanzata/tns1:outputcondition[1])&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
