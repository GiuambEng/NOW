                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:Output_ListaMail&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns3:postResponse2&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
