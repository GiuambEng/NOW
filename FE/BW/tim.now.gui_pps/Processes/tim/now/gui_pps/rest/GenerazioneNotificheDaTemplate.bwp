                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select  idtplg_lavrz  from bds_1_casedata_ordine w &#xa;left join  tipolg_lavrz l on  l.tipolg_lavrz= w.tipologialavorazione&#xa;where w.idrichiestaolo=?" xsi:type="jdbcPalette:JDBCQueryActivity">

