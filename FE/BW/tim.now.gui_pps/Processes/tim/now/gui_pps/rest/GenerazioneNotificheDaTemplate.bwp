gerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.GenerazioneNotificheDaTemplate&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$post1.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post1.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post1.httpHeaders/GUI-SID,$post1.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$post1.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post1.httpHeaders/GUI-TID&quot;/>&#xa;      