                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="matrice_notf-input"
                                    name="matrice_notf"
                                    outputVariable="matrice_notf"
                                    tibex:xpdlId="f6b195b7-942f-461a-b31c-47d33a5555cf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="richiesta_ordineToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToMapper1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="string-length($matrice_notf/Record[1]/DA)>1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($matrice_notf/Record[1]/DA)>1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="matrice_notfToAccumulateFinale">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f6b195b7-942f-461a-b31c-47d33a5555cf+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/genarazioneNotificheDaTemplate&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;richiesta_ordine&quot;/>&lt;xsl:template name=&quot;matrice_notf-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;id_offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($currentElement/tns1:idOfferta)&quot;>&lt;xsl:value-of select=&quot;$currentElement/tns1:idOfferta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/id_offerta>&lt;idStatoNow>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($currentElement/tns1:idStatoNowDa)&quot;>&lt;xsl:value-of select=&quot;$currentElement/tns1:idStatoNowDa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idStatoNow>&lt;idTplgLvrz>&lt;xsl:value-of select=&quot;xsd:int($richiesta_ordine/Record[1]/IDTPLG_LAVRZ)&quot;/>&lt;/idTplgLvrz>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="MaxConnections"/>

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>

                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT MA.COD_TIPOLG_NOTF_DONATING,MA.COD_TIPOLG_NOTF_DONOR,&#xd;&#xa;MA.COD_TIPOLG_NOTF_RECIPIENT,TRDONAT.DESCR DESC_TIP_NOTF_DONATING,TRDONOR.DESCR DESC_TIP_NOTF_DONOR ,TRRECIP.DESCR DESC_TIP_NOTF_RECIPIENT,&#xd;&#xa;   A.STATO_RICH_NOW DA,B.STATO_RICH_NOW  A,TL.TIPOLG_LAVRZ, MA.STRUTTURA_RICH_DONATING,MA.STRUTTURA_RICH_DONOR,MA.STRUTTURA_RICH_RECIPIENT&#xd;&#xa; FROM MATRICE_NOTF_ATTES MA  LEFT JOIN  TIPOLG_LAVRZ TL ON MA.IDTPLG_LAVRZ=TL.IDTPLG_LAVRZ &#xd;&#xa; LEFT JOIN TIPOLG_RICH_COMSTNOW A  ON MA.ID_STATO_NOW_DA=A.IDRICH_COM_STRC &#xd;&#xa; LEFT JOIN TIPOLG_RICH_COMSTNOW B  ON MA.ID_STATO_NOW_A=B.IDRICH_COM_STRC &#xd;&#xa;LEFT JOIN TIPOLG_NOTF TRDONAT  ON TRDONAT.COD_TIPOLG_NOTF=MA.COD_TIPOLG_NOTF_DONATING  AND TRDONAT.STRUTTURA_RICH= MA.STRUTTURA_RICH_DONATING&#xd;&#xa;LEFT JOIN TIPOLG_NOTF TRDONOR  ON TRDONOR.COD_TIPOLG_NOTF=MA.COD_TIPOLG_NOTF_DONOR AND TRDONOR.STRUTTURA_RICH= MA.STRUTTURA_RICH_DONOR&#xd;&#xa;LEFT JOIN TIPOLG_NOTF TRRECIP  ON TRRECIP.COD_TIPOLG_NOTF=MA.COD_TIPOLG_NOTF_RECIPIENT AND TRRECIP.STRUTTURA_RICH =MA.STRUTTURA_RICH_RECIPIENT&#xd;&#xa;  WHERE MA.ID_OFFERTA =? AND MA.ID_STATO_NOW_A =? AND MA.IDTPLG_LAVRZ=?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="id_offerta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idStatoNow"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idTplgLvrz"/>

                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF_DONOR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF_RECIPIENT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DESC_TIP_NOTF_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DESC_TIP_NOTF_DONOR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DESC_TIP_NOTF_RECIPIENT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="A"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="TIPOLG_LAVRZ"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="STRUTTURA_RICH_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="STRUTTURA_RICH_DONOR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="STRUTTURA_RICH_RECIPIENT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:forEach>
                                </bpws:sequence>
                            </bpws:scope>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable2"
                                    name="externalAsign"
                                    outputVariable="Variable2"
                                    tibex:xpdlId="18c3193e-663c-4849-9d77-7e83297951b1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="IterateToAssign2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign2ToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/genarazioneNotificheDaTemplate&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AccumulateFinale&quot;/>&lt;xsl:template name=&quot;Variable2&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($AccumulateFinale/tns:outputListaTipologiaNotificheAttese[1]/tns:outputListaTipologiaNotificheAttese[1])&quot;>&lt;tns:outputListaTipologiaNotificheAttese>&lt;xsl:for-each select=&quot;$AccumulateFinale/tns:outputListaTipologiaNotificheAttese&quot;>&lt;xsl:for-each select=&quot;tns:outputListaTipologiaNotificheAttese&quot;>&lt;tns:outputListaTipologiaNotificheAttese>&lt;xsl:if test=&quot;tns:codiceTipologiaNotificaDonating&quot;>&lt;tns:codiceTipologiaNotificaDonating>&lt;xsl:value-of select=&quot;tns:codiceTipologiaNotificaDonating&quot;/>&lt;/tns:codiceTipologiaNotificaDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codiceTipologiaNotificaDonor&quot;>&lt;tns:codiceTipologiaNotificaDonor>&lt;xsl:value-of select=&quot;tns:codiceTipologiaNotificaDonor&quot;/>&lt;/tns:codiceTipologiaNotificaDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codiceTipologiaNotificaRecipient&quot;>&lt;tns:codiceTipologiaNotificaRecipient>&lt;xsl:value-of select=&quot;tns:codiceTipologiaNotificaRecipient&quot;/>&lt;/tns:codiceTipologiaNotificaRecipient>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:statoNowA&quot;>&lt;tns:statoNowA>&lt;xsl:value-of select=&quot;tns:statoNowA&quot;/>&lt;/tns:statoNowA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:statoNowDa&quot;>&lt;tns:statoNowDa>&lt;xsl:value-of select=&quot;tns:statoNowDa&quot;/>&lt;/tns:statoNowDa>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:tipologiaLavorazione&quot;>&lt;tns:tipologiaLavorazione>&lt;xsl:value-of select=&quot;tns:tipologiaLavorazione&quot;/>&lt;/tns:tipologiaLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:strutturaRichiestaDonating&quot;>&lt;tns:strutturaRichiestaDonating>&lt;xsl:value-of select=&quot;tns:strutturaRichiestaDonating&quot;/>&lt;/tns:strutturaRichiestaDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:strutturaRichiestaDonor&quot;>&lt;tns:strutturaRichiestaDonor>&lt;xsl:value-of select=&quot;tns:strutturaRichiestaDonor&quot;/>&lt;/tns:strutturaRichiestaDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:strutturaRichiestaRecipient&quot;>&lt;tns:strutturaRichiestaRecipient>&lt;xsl:value-of select=&quot;tns:strutturaRichiestaRecipient&quot;/>&lt;/tns:strutturaRichiestaRecipient>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:idrichiestaolo&quot;>&lt;tns:idrichiestaolo>&lt;xsl:value-of select=&quot;tns:idrichiestaolo&quot;/>&lt;/tns:idrichiestaolo>&lt;/xsl:if>&lt;tns:descrCodTipoDonating>&lt;xsl:value-of select=&quot;tns:descrCodTipoDonating&quot;/>&lt;/tns:descrCodTipoDonating>&lt;tns:descrCodTipoDonor>&lt;xsl:value-of select=&quot;tns:descrCodTipoDonor&quot;/>&lt;/tns:descrCodTipoDonor>&lt;tns:descrCodTipoRecipient>&lt;xsl:value-of select=&quot;tns:descrCodTipoRecipient&quot;/>&lt;/tns:descrCodTipoRecipient>&lt;/tns:outputListaTipologiaNotificheAttese>&lt;/xsl:for-each>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputListaTipologiaNotificheAttese>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputListaTipologiaNotificheAttese>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;NESSUN DATO TROVATO&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputListaTipologiaNotificheAttese>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
