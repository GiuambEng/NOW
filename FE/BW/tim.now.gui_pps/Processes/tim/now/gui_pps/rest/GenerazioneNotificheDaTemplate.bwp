                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/genarazioneNotificheDaTemplate&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;matrice_notf&quot;/>&lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&lt;tns:outputListaTipologiaNotificheAttese>&lt;xsl:for-each select=&quot;$matrice_notf/Record&quot;>&lt;tns:outputListaTipologiaNotificheAttese>&lt;xsl:if test=&quot;COD_TIPOLG_NOTF_DONATING&quot;>&lt;tns:codiceTipologiaNotificaDonating>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF_DONATING&quot;/>&lt;/tns:codiceTipologiaNotificaDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_TIPOLG_NOTF_DONOR&quot;>&lt;tns:codiceTipologiaNotificaDonor>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF_DONOR&quot;/>&lt;/tns:codiceTipologiaNotificaDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_TIPOLG_NOTF_RECIPIENT&quot;>&lt;tns:codiceTipologiaNotificaRecipient>&lt;xsl:value-of select=&quot;COD_TIPOLG_NOTF_RECIPIENT&quot;/>&lt;/tns:codiceTipologiaNotificaRecipient>&lt;/xsl:if>&lt;xsl:if test=&quot;A&quot;>&lt;tns:statoNowA>&lt;xsl:value-of select=&quot;A&quot;/>&lt;/tns:statoNowA>&lt;/xsl:if>&lt;xsl:if test=&quot;DA&quot;>&lt;tns:statoNowDa>&lt;xsl:value-of select=&quot;DA&quot;/>&lt;/tns:statoNowDa>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOLG_LAVRZ&quot;>&lt;tns:tipologiaLavorazione>&lt;xsl:value-of select=&quot;TIPOLG_LAVRZ&quot;/>&lt;/tns:tipologiaLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;STRUTTURA_RICH_DONATING&quot;>&lt;tns:strutturaRichiestaDonating>&lt;xsl:value-of select=&quot;STRUTTURA_RICH_DONATING&quot;/>&lt;/tns:strutturaRichiestaDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;STRUTTURA_RICH_DONOR&quot;>&lt;tns:strutturaRichiestaDonor>&lt;xsl:value-of select=&quot;STRUTTURA_RICH_DONOR&quot;/>&lt;/tns:strutturaRichiestaDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;STRUTTURA_RICH_RECIPIENT&quot;>&lt;tns:strutturaRichiestaRecipient>&lt;xsl:value-of select=&quot;STRUTTURA_RICH_RECIPIENT&quot;/>&lt;/tns:strutturaRichiestaRecipient>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:idrichiestaolo&quot;>&lt;tns:idrichiestaolo>&lt;xsl:value-of select=&quot;$currentElement/tns:idrichiestaolo&quot;/>&lt;/tns:idrichiestaolo>&lt;/xsl:if>&lt;tns:descrCodTipoDonating>&lt;xsl:value-of select=&quot;DESC_TIP_NOTF_DONATING&quot;/>&lt;/tns:descrCodTipoDonating>&lt;tns:descrCodTipoDonor>&lt;xsl:value-of select=&quot;DESC_TIP_NOTF_DONOR&quot;/>&lt;/tns:descrCodTipoDonor>&lt;tns:descrCodTipoRecipient>&lt;xsl:value-of select=&quot;DESC_TIP_NOTF_RECIPIENT&quot;/>&lt;/tns:descrCodTipoRecipient>&lt;/tns:outputListaTipologiaNotificheAttese>&lt;/xsl:for-each>&lt;/tns:outputListaTipologiaNotificheAttese>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
