            xmlns:Q1="http://www.tim.com/NOW/rest/MapperRinvioFile"
            xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+cbbc42c9-37d9-4080-a6b1-fe629910b9e6" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:import namespace="http://www.tim.com/NOW/rest/MapperRinvioFile"/>
            <xs:element name="AccumulatedOutput" type="tns:AccumulatedOutputType"/>
            <xs:complexType name="AccumulatedOutputType">
                <xs:sequence maxOccurs="1" minOccurs="0">
                    <xs:element maxOccurs="unbounded" minOccurs="0" ref="Q1:mapperRinvioFile"/>
                </xs:sequence>
            </xs:complexType>
        </xs:schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+4c918966-7a8f-43bf-a792-6799117dd82d+input"
