                            <bpws:reply name="postOut1" operation="post"
                                partnerLink="listafile"
                                portType="ns:listafile"
                                tibex:xpdlId="0048c279-8022-48e2-a05c-79e82ac56247" variable="postOut1-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160831114016PLT" xmlns:tns="http://www.tim.com/NOW/rest/ListaFile" xmlns:tns1="http://www.tim.com/NOW/rest/servizioricercaavanzata" version="2.0"&gt;
    &lt;xsl:param name="Variable"/&gt;
    &lt;xsl:param name="post1"/&gt;
    &lt;xsl:template name="postOut1-input" match="/"&gt;
        &lt;tns2:postResponse3&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="string-length($post1/item/tns1:inputservizioricercaavanzata/tns1:strutturaCondition[1]/tns1:nome) = 0"&gt;
                        &lt;tns:listaFile&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                                &lt;tns:details&gt;
                                    &lt;xsl:value-of select="&amp;quot;Criteri di ricerca assenti&amp;quot;"/&gt;
                                &lt;/tns:details&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:listaFile&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:listaFile&gt;
                            &lt;xsl:copy-of select="$Variable/tns:listaFileOutput"/&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                                &lt;xsl:if test="$Variable/tns:result/tns:details"&gt;
                                    &lt;tns:details&gt;
                                        &lt;xsl:value-of select="$Variable/tns:result/tns:details"/&gt;
                                    &lt;/tns:details&gt;
                                &lt;/xsl:if&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:listaFile&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns2:postResponse3&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160831114016PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/ListaFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut1-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($post1.item/tns1:strutturaCondition[1]/tns1:nome) = 0&quot;>&#xa;                &lt;tns:listaFile>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Criteri di ricerca assenti&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:listaFile>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:listaFile>&#xa;                    &lt;xsl:copy-of select=&quot;$Variable/tns:listaFileOutput&quot;/>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;xsl:if test=&quot;$Variable/tns:result/tns:details&quot;>&#xa;                            &lt;tns:details>&#xa;                                &lt;xsl:value-of select=&quot;$Variable/tns:result/tns:details&quot;/>&#xa;                            &lt;/tns:details>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:listaFile>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
