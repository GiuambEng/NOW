                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/RinvioFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/MapperRinvioFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:rinvioFileOutput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Accumulate/tns1:mapperRinvioFile/tns1:rinvioFile[tns1:codice = 'KO']/tns1:idFile)&quot;>&#xa;                    &lt;tns2:esito>&#xa;                        &lt;tns2:codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:codice>&#xa;                        &lt;tns2:descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;I file non risottomessi sono: &amp;quot;,tib:concat-sequence-format($Accumulate/tns1:mapperRinvioFile/tns1:rinvioFile/tns1:idFile, ',', true()))&quot;/>&#xa;                        &lt;/tns2:descrizione>&#xa;                    &lt;/tns2:esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:esito>&#xa;                        &lt;tns2:codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:codice>&#xa;                        &lt;tns2:descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Tutti i file sono stati risottomessi correttamente&amp;quot;&quot;/>&#xa;                        &lt;/tns2:descrizione>&#xa;                    &lt;/tns2:esito>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl: