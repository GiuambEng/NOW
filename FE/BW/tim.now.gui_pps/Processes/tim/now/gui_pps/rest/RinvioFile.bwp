ITO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'ESITO']/value)&quot;>&lt;tns:esito>&lt;xsl:value-of select=&quot;column[name = 'ESITO']/value&quot;/>&lt;/tns:esito>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name = 'ID_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'ID_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'ID_FILE']/value)&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;column[name = 'ID_FILE']/value&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name = 'DESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'DESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'DESCR']/value)&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;column[name = 'DESCR']/value&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name = 'NOME_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'NOME_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'NOME_FILE']/value)&quot;>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;column[name = 'NOME_FILE']/value&quot;/>&lt;/tns:nomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name = 'VERSO_DEL_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'VERSO_DEL_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'VERSO_DEL_FILE']/value)&quot;>&lt;tns:versoFile>&lt;xsl:value-of select=&quot;column[name = 'VERSO_DEL_FILE']/value&quot;/>&lt;/tns:versoFile>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name = 'ESITO_INVIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'ESITO_INVIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'ESITO_INVIO']/value)&quot;>&lt;tns:esitoInvio>&lt;xsl:value-of select=&quot;column[name = 'ESITO_INVIO']/value&quot;/>&lt;/tns:esitoInvio>&lt;/xsl:if>&lt;tns:timestampCreazioneFile>&lt;xsl:value-of select=&quot;substring-before( string(column[name = 'TIMSTP_CREZIONE_FILE']/value), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:timestampCreazioneFile>&lt;tns:timestampInvio>&lt;xsl:value-of select=&quot;substring-before( string(column[name = 'TIMSTP_INVIO']/value), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:timestampInvio>&lt;/tns:listaFileOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Elementi trovati&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:listaFile>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
