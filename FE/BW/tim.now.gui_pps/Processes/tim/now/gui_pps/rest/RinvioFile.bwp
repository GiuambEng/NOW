=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;            &lt;tns3:ActiveLoggerServices>&#xa;                &lt;tns3:Envelope>&#xa;                    &lt;tns3:Identifier>&#xa;                        &lt;tns3:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.RinvioFile&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ServiceName>&#xa;                        &lt;tns3:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Operation>&#xa;                        &lt;tns3:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns3:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns3:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns1:httpHeaders/GUI-SID, $post/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns3:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns3:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns3:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RinvioFile_&amp;quot;,$post/httpHeaders/tns1:httpHeaders/GUI-SID, &amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns3:EventType>&#xa;                        &lt;tns3:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RinvioFile_&amp;quot;,$post/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns3:trackID>&#xa;                    &lt;/tns3:Identifier>&#xa;                    &lt;tns3:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns3:track_position>&#xa;                    &lt;tns3:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns3:Timestamp>&#xa;                &lt;/tns3:Envelope>&#xa;                &lt;tns3:Playload>&#xa;                    &lt;tns3:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($post/item/tns2:rinvioFileInput )))&quot;/>&#xa;                    &lt;/tns3:Binary>&#xa;                    &lt;tns3:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($post/item/tns2:rinvioFileInput)&quot;/>&#xa;                    &lt;/tns3:XMLString>&#xa;                &lt;/tns3:Playload>&#xa;            &lt;/tns3:ActiveLoggerServices>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
