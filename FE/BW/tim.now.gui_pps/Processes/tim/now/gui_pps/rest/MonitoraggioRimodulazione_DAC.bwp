                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/MonitoraggioRimodulazioni_DAC&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioRimodulazione_DAC/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Monitoraggio_Rimodulazione&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirect&quot;/>&#xa;    &lt;xsl:param name=&quot;refreshStato&quot;/>&#xa;    &lt;xsl:template name=&quot;Rimodulazione_DAC&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($Monitoraggio_Rimodulazione/Record) > 0 and not(string-length($get.parameters/tns1:contatoreSingolo)>0)&quot;>&#xa;                &lt;tns:outputMonitoraggioRimodulazioni_DAC>&#xa;                    &lt;tns:OutputMonitoraggioRimodulazioni_DAC>&#xa;                        &lt;tns:dataScadenza>&#xa;                            &lt;xsl:value-of select=&quot;substring(string($Monitoraggio_Rimodulazione/Record[1]/DATA_ESTRAZIONE),1,10)&quot;/>&#xa;                        &lt;/tns:dataScadenza>&#xa;                        &lt;xsl:if test=&quot;$Monitoraggio_Rimodulazione/Record[1]/OPERATORE&quot;>&#xa;                            &lt;tns:operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Monitoraggio_Rimodulazione/Record[1]/OPERATORE&quot;/>&#xa;                            &lt;/tns:operatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_1&quot;>&#xa;                            &lt;tns:richiesteInScadenza_1>&#xa;                                &lt;xsl:value-of select=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_1&quot;/>&#xa;                            &lt;/tns:richiesteInScadenza_1>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_2&quot;>&#xa;                            &lt;tns:richiesteInScadenza_2>&#xa;                                &lt;xsl:value-of select=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_2&quot;/>&#xa;                            &lt;/tns:richiesteInScadenza_2>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_3&quot;>&#xa;                            &lt;tns:richiesteInScadenza_3>&#xa;                                &lt;xsl:value-of select=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_3&quot;/>&#xa;                            &lt;/tns:richiesteInScadenza_3>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_4&quot;>&#xa;                            &lt;tns:richiesteInScadenza_4>&#xa;                                &lt;xsl:value-of select=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_4&quot;/>&#xa;                            &lt;/tns:richiesteInScadenza_4>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_5&quot;>&#xa;                            &lt;tns:richiesteInScadenza_5>&#xa;                                &lt;xsl:value-of select=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_5&quot;/>&#xa;                            &lt;/tns:richiesteInScadenza_5>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_6&quot;>&#xa;                            &lt;tns:richiesteInScadenza_6>&#xa;                                &lt;xsl:value-of select=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_6&quot;/>&#xa;                            &lt;/tns:richiesteInScadenza_6>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_7&quot;>&#xa;                            &lt;tns:richiesteInScadenza_7>&#xa;                                &lt;xsl:value-of select=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_7&quot;/>&#xa;                            &lt;/tns:richiesteInScadenza_7>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_8&quot;>&#xa;                            &lt;tns:richiesteInScadenza_8>&#xa;                                &lt;xsl:value-of select=&quot;$Monitoraggio_Rimodulazione/Record[1]/SCADENZA_8&quot;/>&#xa;                            &lt;/tns:richiesteInScadenza_8>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:statoRefresh>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($refreshStato, '-')&amp;#xD;&amp;#xA;&quot;/>&#xa;                        &lt;/tns:statoRefresh>&#xa;                        &lt;tns:descStatoRefresh>&#xa;                            &lt;xsl:value-of select=&quot;substring-after($refreshStato, '-')&quot;/>&#xa;                        &lt;/tns:descStatoRefresh>&#xa;                    &lt;/tns:OutputMonitoraggioRimodulazioni_DAC>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputMonitoraggioRimodulazioni_DAC>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SQLDirect/unknownResultset/row) > 0 and string-length($get.parameters/tns1:contatoreSingolo)>0&quot;>&#xa;                        &lt;tns:outputMonitoraggioRimodulazioni_DAC>&#xa;                            &lt;tns:OutputMonitoraggioRimodulazioni_DAC>&#xa;                                &lt;tns:dataScadenza>&#xa;                                    &lt;xsl:value-of select=&quot;substring(string($SQLDirect/unknownResultset[1]/row[1]/column[name='DATA_ESTRAZIONE']/value),1,10)&quot;/>&#xa;                                &lt;/tns:dataScadenza>&#xa;                                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='OPERATORE']/value)&quot;>&#xa;                                    &lt;tns:operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='OPERATORE']/value&quot;/>&#xa;                                    &lt;/tns:operatore>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$get.parameters/tns1:contatoreSingolo='1'&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_1']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_1']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_1']/value)&quot;>&#xa;                                            &lt;tns:richiesteInScadenza_1>&#xa;                                                &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_1']/value&quot;/>&#xa;                                            &lt;/tns:richiesteInScadenza_1>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$get.parameters/tns1:contatoreSingolo='2'&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_2']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_2']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_2']/value)&quot;>&#xa;                                            &lt;tns:richiesteInScadenza_2>&#xa;                                                &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_2']/value&quot;/>&#xa;                                            &lt;/tns:richiesteInScadenza_2>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$get.parameters/tns1:contatoreSingolo='3'&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_3']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_3']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_3']/value)&quot;>&#xa;                                            &lt;tns:richiesteInScadenza_3>&#xa;                                                &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_3']/value&quot;/>&#xa;                                            &lt;/tns:richiesteInScadenza_3>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$get.parameters/tns1:contatoreSingolo='4'&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_4']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_4']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_4']/value)&quot;>&#xa;                                            &lt;tns:richiesteInScadenza_4>&#xa;                                                &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_4']/value&quot;/>&#xa;                                            &lt;/tns:richiesteInScadenza_4>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$get.parameters/tns1:contatoreSingolo='5'&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_5']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_5']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_5']/value)&quot;>&#xa;                                            &lt;tns:richiesteInScadenza_5>&#xa;                                                &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_5']/value&quot;/>&#xa;                                            &lt;/tns:richiesteInScadenza_5>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$get.parameters/tns1:contatoreSingolo='6'&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_6']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_6']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_6']/value)&quot;>&#xa;                                            &lt;tns:richiesteInScadenza_6>&#xa;                                                &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_6']/value&quot;/>&#xa;                                            &lt;/tns:richiesteInScadenza_6>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$get.parameters/tns1:contatoreSingolo='7'&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_7']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_7']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_7']/value)&quot;>&#xa;                                            &lt;tns:richiesteInScadenza_7>&#xa;                                                &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_7']/value&quot;/>&#xa;                                            &lt;/tns:richiesteInScadenza_7>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$get.parameters/tns1:contatoreSingolo='8'&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_8']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_8']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_8']/value)&quot;>&#xa;                                            &lt;tns:richiesteInScadenza_8>&#xa;                                                &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='SCADENZA_8']/value&quot;/>&#xa;                                            &lt;/tns:richiesteInScadenza_8>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:variable name=&quot;blobColumn&quot; select=&quot;concat('DETT_RICH_',$get.parameters/tns1:contatoreSingolo)&quot;/>&#xa;                                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name=$blobColumn]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name=$blobColumn]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name=$blobColumn]/value)&quot;>&#xa;                                    &lt;tns:exportData>&#xa;                                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name=$blobColumn]/value&quot;/>&#xa;                                    &lt;/tns:exportData>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns:sizeFile>&#xa;                                    &lt;xsl:value-of select=&quot;tib:hex-length(tib:base64-to-hex(string($SQLDirect/unknownResultset[1]/row[1]/column[name=$blobColumn]/value)))&quot;/>&#xa;                                &lt;/tns:sizeFile>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$get.parameters&amp;#xD;&amp;#xA;/tns1:contatoreSingolo='1'&quot;>&#xa;                                        &lt;tns:nomeFileToExport>&#xa;                                            &lt;xsl:value-of select=&quot;concat('DettaglioRichInScadenza_',$get.parameters&amp;#xD;&amp;#xA;/tns1:contatoreSingolo,'_',substring(string($SQLDirect/unknownResultset[1]/row[1]/column[name='DATA_ESTRAZIONE']/value),1,10),'.csv')&quot;/>&#xa;                                        &lt;/tns:nomeFileToExport>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:nomeFileToExport>&#xa;                                            &lt;xsl:value-of select=&quot;concat('DettaglioRichInScadenza_',$get.parameters&amp;#xD;&amp;#xA;/tns1:contatoreSingolo,'_',string(tib:add-to-date(xsd:date(substring(string($SQLDirect/unknownResultset[1]/row[1]/column[name='DATA_ESTRAZIONE']/value),1,10)),0,0,xsd:int($get.parameters/tns1:contatoreSingolo))),'.csv')&quot;/>&#xa;                                        &lt;/tns:nomeFileToExport>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;tns:statoRefresh>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($refreshStato, '-')&quot;/>&#xa;                                &lt;/tns:statoRefresh>&#xa;                                &lt;tns:descStatoRefresh>&#xa;                                    &lt;xsl:value-of select=&quot;substring-after($refreshStato, '-')&quot;/>&#xa;                                &lt;/tns:descStatoRefresh>&#xa;                            &lt;/tns:OutputMonitoraggioRimodulazioni_DAC>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                                &lt;tns:details>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&#xa;                                &lt;/tns:details>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputMonitoraggioRimodulazioni_DAC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($get.parameters/tns1:refresh)='Y'&quot;>&#xa;                        &lt;tns:outputMonitoraggioRimodulazioni_DAC>&#xa;                            &lt;tns:OutputMonitoraggioRimodulazioni_DAC>&#xa;                                &lt;tns:dataScadenza>&#xa;                                    &lt;xsl:value-of select=&quot;substring(string($Monitoraggio_Rimodulazione/Record[1]/DATA_ESTRAZIONE),1,10)&quot;/>&#xa;                                &lt;/tns:dataScadenza>&#xa;                                &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset[1]/row[1]/column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset[1]/row[1]/column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset[1]/row[1]/column[name='OPERATORE']/value)&quot;>&#xa;                                    &lt;tns:operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset[1]/row[1]/column[name='OPERATORE']/value&quot;/>&#xa;                                    &lt;/tns:operatore>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns:statoRefresh>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before($refreshStato, '-')&quot;/>&#xa;                                &lt;/tns:statoRefresh>&#xa;                                &lt;tns:descStatoRefresh>&#xa;                                    &lt;xsl:value-of select=&quot;substring-after($refreshStato, '-')&quot;/>&#xa;                                &lt;/tns:descStatoRefresh>&#xa;                            &lt;/tns:OutputMonitoraggioRimodulazioni_DAC>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputMonitoraggioRimodulazioni_DAC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:outputMonitoraggioRimodulazioni_DAC>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                                &lt;tns:details>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&#xa;                                &lt;/tns:details>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputMonitoraggioRimodulazioni_DAC>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Rimodulazione_DAC" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
