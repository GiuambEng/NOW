                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="refreshStato"
                                    name="refreshStatoLoad"
                                    outputVariable="refreshStato"
                                    tibex:xpdlId="bd443d6c-4884-42c9-b017-e816314e2400" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogTorefreshStatoLoad"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="refreshStatoLoadToContatoreSingoloExport"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (count($CHECK_LOADING/Record)>0) then  'N-Refresh in elaborazione' else if(count($CHECK_START_PROC/Record)>0 and upper-case($CHECK_START_PROC/Record[1]/FLAG_LETTURA)='N')then 'N-Refresh in fase di avvio da altro operatore' else 'Y-Refresh abilitato'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="refreshStato" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Log-input" name="Log"
                                    tibex:xpdlId="b6042aa0-d5f6-45ee-bf73-df3532b7fe6b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CHECK_START_PROCToLog"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogTorefreshStatoLoad"/>
                                    </bpws:sources>
