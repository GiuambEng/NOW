    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>get</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="Monitoraggio_Rimodulazione">
            <endingVariables>
                <variable>Monitoraggio_Rimodulazione-input</variable>
            </endingVariables>
        </task>
        <task name="SetOutput">
            <endingVariables>
                <variable>Monitoraggio_Rimodulazione</variable>
                <variable>SQLDirect</variable>
                <variable>CHECK_LOADING</variable>
                <variable>CHECK_START_PROC</variable>
            </endingVariables>
        </task>
        <task name="RimodulazioneOutputLog">
            <endingVariables>
                <variable>RimodulazioneOutputLog-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="RimodulazioneInputLog">
            <endingVariables>
                <variable>RimodulazioneInputLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="RimodulazioneInfoLog">
            <endingVariables>
                <variable>RimodulazioneInfoLog-input</variable>
            </endingVariables>
        </task>
        <task name="CHECK_START_PROC">
            <endingVariables>
                <variable>CHECK_START_PROC-input</variable>
            </endingVariables>
        </task>
        <task name="CHECK_LOADING">
            <endingVariables>
                <variable>CHECK_LOADING-input</variable>
            </endingVariables>
        </task>
        <task name="Log">
            <endingVariables>
                <variable>Log-input</variable>
            </endingVariables>
        </task>
        <task name="SQLDirect">
            <endingVariables>
                <variable>SQLDirect-input</variable>
            </endingVariables>
        </task>
        <task name="Log1">
            <endingVariables>
                <variable>Log1-input</variable>
            </endingVariables>
        </task>
        <task name="UpdateCFG_START_PROC_PPS">
            <endingVariables>
                <variable>UpdateCFG_START_PROC_PPS-input</variable>
                <variable>UpdateCFG_START_PROC_PPS</variable>
            </endingVariables>
        </task>
        <task name="Log2">
            <endingVariables>
                <variable>Log2-input</variable>
            </endingVariables>
        </task>
        <task name="RimodulazioneErrorLog">
            <endingVariables>
                <variable>RimodulazioneErrorLog-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
