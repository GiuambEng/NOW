                                    </bpws:source>
                                    <bpws:source linkName="ContatoreSingoloExportToScope_EXPORTContatore">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($get/parameters/tns:monitoraggiorimodulazione_dacGetParameters/tns:contatoreSingolo)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($get.parameters/tns:contatoreSingolo)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="ContatoreSingoloExportToScope2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($get/parameters/tns:monitoraggiorimodulazione_dacGetParameters/tns:refresh)='Y' " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($get.parameters/tns:refresh)='Y' ]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
