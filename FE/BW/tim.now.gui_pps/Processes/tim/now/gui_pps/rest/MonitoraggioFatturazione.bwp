                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.example.org/MonitoraggioFatturazione" xmlns:tns1="http://xmlns.example.com/20160923151046PLT" xmlns:tns2="http://xmlns.example.com/MonitoraggioFatturazione/parameters" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.example.org/CryptoParams" version="2.0"&gt;&lt;xsl:param name="WarningSoglia"/&gt;&lt;xsl:param name="AccumulateREGO"/&gt;&lt;xsl:param name="get"/&gt;&lt;xsl:param name="AccumulateXDSL"/&gt;&lt;xsl:param name="CryptoParams"/&gt;&lt;xsl:template name="getOut-input" match="/"&gt;&lt;tns1:getResponse&gt;&lt;item&gt;&lt;tns:outputMonitoraggioFatturazione&gt;&lt;tns:monitoraggioFatturazioneT0&gt;&lt;tns:famigliaOffertaFatt&gt;&lt;tns:nomeFamigliaOfferta&gt;&lt;xsl:value-of select="'REGOLATORIO'"/&gt;&lt;/tns:nomeFamigliaOfferta&gt;&lt;xsl:for-each select="$AccumulateREGO/tns:outputMonitoraggioFatturazioneT0/tns:famigliaOffertaFatt/tns:dataXFatt"&gt;&lt;tns:dataXFatt&gt;&lt;tns:dataAcquisizione&gt;&lt;xsl:value-of select="tns:dataAcquisizione"/&gt;&lt;/tns:dataAcquisizione&gt;&lt;xsl:if test="tns:InviatoAFatturazione"&gt;&lt;tns:InviatoAFatturazione&gt;&lt;xsl:value-of select="tns:InviatoAFatturazione"/&gt;&lt;/tns:InviatoAFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:EspletamentoTecnico"&gt;&lt;tns:EspletamentoTecnico&gt;&lt;xsl:value-of select="tns:EspletamentoTecnico"/&gt;&lt;/tns:EspletamentoTecnico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:FatturazioneKo"&gt;&lt;tns:FatturazioneKo&gt;&lt;xsl:value-of select="tns:FatturazioneKo"/&gt;&lt;/tns:FatturazioneKo&gt;&lt;/xsl:if&gt;&lt;/tns:dataXFatt&gt;&lt;/xsl:for-each&gt;&lt;/tns:famigliaOffertaFatt&gt;&lt;tns:famigliaOffertaFatt&gt;&lt;tns:nomeFamigliaOfferta&gt;&lt;xsl:value-of select="'XDSL'"/&gt;&lt;/tns:nomeFamigliaOfferta&gt;&lt;xsl:for-each select="$AccumulateXDSL/tns:outputMonitoraggioFatturazioneT0/tns:famigliaOffertaFatt/tns:dataXFatt"&gt;&lt;tns:dataXFatt&gt;&lt;tns:dataAcquisizione&gt;&lt;xsl:value-of select="tns:dataAcquisizione"/&gt;&lt;/tns:dataAcquisizione&gt;&lt;xsl:if test="tns:InviatoAFatturazione"&gt;&lt;tns:InviatoAFatturazione&gt;&lt;xsl:value-of select="tns:InviatoAFatturazione"/&gt;&lt;/tns:InviatoAFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:EspletamentoTecnico"&gt;&lt;tns:EspletamentoTecnico&gt;&lt;xsl:value-of select="tns:EspletamentoTecnico"/&gt;&lt;/tns:EspletamentoTecnico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:FatturazioneKo"&gt;&lt;tns:FatturazioneKo&gt;&lt;xsl:value-of select="tns:FatturazioneKo"/&gt;&lt;/tns:FatturazioneKo&gt;&lt;/xsl:if&gt;&lt;/tns:dataXFatt&gt;&lt;/xsl:for-each&gt;&lt;/tns:famigliaOffertaFatt&gt;&lt;tns:soglia&gt;&lt;xsl:value-of select="xsd:int($WarningSoglia/Record[1]/VALORE_SOGLIA)"/&gt;&lt;/tns:soglia&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($get/parameters/tns2:monitoraggiofatturazioneGetParameters/tns2:flagExport) and upper-case($get/parameters/tns2:monitoraggiofatturazioneGetParameters/tns2:flagExport)='Y'"&gt;&lt;tns:idFile&gt;&lt;xsl:value-of select="$CryptoParams/tns3:idFileCriptato"/&gt;&lt;/tns:idFile&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;/tns:monitoraggioFatturazioneT0&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($AccumulateREGO/tns:outputMonitoraggioFatturazioneT0[1]/tns:famigliaOffertaFatt[1]/tns:nomeFamigliaOfferta)&gt;0"&gt;&lt;tns:result&gt;&lt;tns:severity&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/tns:severity&gt;&lt;tns:code&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/tns:code&gt;&lt;/tns:result&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns:result&gt;&lt;tns:severity&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/tns:severity&gt;&lt;tns:code&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/tns:code&gt;&lt;tns:details&gt;&lt;xsl:value-of select="'NESSUN RISULTATO TROVATO'"/&gt;&lt;/tns:details&gt;&lt;/tns:result&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns:outputMonitoraggioFatturazione&gt;&lt;/item&gt;&lt;/tns1:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
