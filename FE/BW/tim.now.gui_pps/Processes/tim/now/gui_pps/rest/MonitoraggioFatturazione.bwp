                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT B.IDRICHIESTAOLO,B.DATAINVIORICHIESTA,B.CODIFICAOLOAGCOM,B.CODIFICAOLONOW,B.CODICEORDINETI,B.STATORICHIESTANOW,B.STATORICHIESTAOLO,B.IDRISORSA,&#xd;&#xa;B.DRO,B.OFFERTA,F.DESCR&#xd;&#xa;FROM BDS_1_CASEDATA_RICHIESTA B&#xd;&#xa;LEFT JOIN FAMIG_OFFERTA F ON B.IDOFFERTA = F.ID_FAMIG_OFFERTA&#xd;&#xa;where CODICEORDINETI=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

