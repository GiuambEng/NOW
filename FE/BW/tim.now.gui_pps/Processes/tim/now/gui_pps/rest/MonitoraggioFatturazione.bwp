                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioFatturazione&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160923151046PLT&quot; xmlns:tns2=&quot;http://xmlns.example.com/MonitoraggioFatturazione/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.example.org/CryptoParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;WarningSoglia&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateREGO&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParams&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:outputMonitoraggioFatturazione>&#xa;            &lt;tns:monitoraggioFatturazioneT0>&#xa;                &lt;tns:famigliaOffertaFatt>&#xa;                    &lt;tns:nomeFamigliaOfferta>&#xa;                        &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                    &lt;/tns:nomeFamigliaOfferta>&#xa;                    &lt;xsl:for-each select=&quot;$AccumulateREGO/tns:outputMonitoraggioFatturazioneT0/tns:famigliaOffertaFatt/tns:dataXFatt&quot;>&#xa;                        &lt;tns:dataXFatt>&#xa;                            &lt;tns:dataAcquisizione>&#xa;                                &lt;xsl:value-of select=&quot;tns:dataAcquisizione&quot;/>&#xa;                            &lt;/tns:dataAcquisizione>&#xa;                            &lt;xsl:if test=&quot;tns:InviatoAFatturazione&quot;>&#xa;                                &lt;tns:InviatoAFatturazione>&#xa;                                    &lt;xsl:value-of select=&quot;tns:InviatoAFatturazione&quot;/>&#xa;                                &lt;/tns:InviatoAFatturazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:EspletamentoTecnico&quot;>&#xa;                                &lt;tns:EspletamentoTecnico>&#xa;                                    &lt;xsl:value-of select=&quot;tns:EspletamentoTecnico&quot;/>&#xa;                                &lt;/tns:EspletamentoTecnico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:FatturazioneKo&quot;>&#xa;                                &lt;tns:FatturazioneKo>&#xa;                                    &lt;xsl:value-of select=&quot;tns:FatturazioneKo&quot;/>&#xa;                                &lt;/tns:FatturazioneKo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:dataXFatt>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:famigliaOffertaFatt>&#xa;                &lt;tns:famigliaOffertaFatt>&#xa;                    &lt;tns:nomeFamigliaOfferta>&#xa;                        &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;                    &lt;/tns:nomeFamigliaOfferta>&#xa;                    &lt;xsl:for-each select=&quot;$AccumulateXDSL/tns:outputMonitoraggioFatturazioneT0/tns:famigliaOffertaFatt/tns:dataXFatt&quot;>&#xa;                        &lt;tns:dataXFatt>&#xa;                            &lt;tns:dataAcquisizione>&#xa;                                &lt;xsl:value-of select=&quot;tns:dataAcquisizione&quot;/>&#xa;                            &lt;/tns:dataAcquisizione>&#xa;                            &lt;xsl:if test=&quot;tns:InviatoAFatturazione&quot;>&#xa;                                &lt;tns:InviatoAFatturazione>&#xa;                                    &lt;xsl:value-of select=&quot;tns:InviatoAFatturazione&quot;/>&#xa;                                &lt;/tns:InviatoAFatturazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:EspletamentoTecnico&quot;>&#xa;                                &lt;tns:EspletamentoTecnico>&#xa;                                    &lt;xsl:value-of select=&quot;tns:EspletamentoTecnico&quot;/>&#xa;                                &lt;/tns:EspletamentoTecnico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:FatturazioneKo&quot;>&#xa;                                &lt;tns:FatturazioneKo>&#xa;                                    &lt;xsl:value-of select=&quot;tns:FatturazioneKo&quot;/>&#xa;                                &lt;/tns:FatturazioneKo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:dataXFatt>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:famigliaOffertaFatt>&#xa;                &lt;tns:soglia>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($WarningSoglia/Record[1]/VALORE_SOGLIA)&quot;/>&#xa;                &lt;/tns:soglia>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns2:flagExport) and upper-case($get.parameters/tns2:flagExport)='Y'&quot;>&#xa;                        &lt;tns:idFile>&#xa;                            &lt;xsl:value-of select=&quot;$CryptoParams/tns3:idFileCriptato&quot;/>&#xa;                        &lt;/tns:idFile>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:monitoraggioFatturazioneT0>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($AccumulateREGO/tns:outputMonitoraggioFatturazioneT0[1]/tns:famigliaOffertaFatt[1]/tns:nomeFamigliaOfferta)>0&quot;>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'NESSUN RISULTATO TROVATO'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:outputMonitoraggioFatturazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
