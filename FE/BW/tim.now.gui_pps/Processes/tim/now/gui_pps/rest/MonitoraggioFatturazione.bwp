                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+edc66604-f976-4943-8f25-0a602c4252db+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioFatturazione/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;DrillDown1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;DATA_ESTRAZIONE>&#xa;                &lt;xsl:value-of select=&quot;format-date(xsd:date($get1.parameters/tns1:dataEstrazione), &amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)&quot;/>&#xa;            &lt;/DATA_ESTRAZIONE>&#xa;            &lt;DESCR_FAMIG_OFFERTA>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns1:descrizioneFamigliaOfferta&quot;/>&#xa;            &lt;/DESCR_FAMIG_OFFERTA>&#xa;            &lt;STATO_RICH_NOW>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns1:statoRichiestaNow&quot;/>&#xa;            &lt;/STATO_RICH_NOW>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="  &#xa;  &#xa;  SELECT PP.CAUS_SCARTO,PP.COD_ORDN_OLO,PP.COD_ORDN_TI,R.CODIFICAOLOAGCOM,R.CODIFICAOLONOW,R.DRO,&#xa;PP.DATA_ESTRAZIONE,PP.DESCR_FAMIG_OFFERTA,PP.DESCR_SCARTO,E.TIMSTP_INSMTO_EVENTO,PP.ID_RICH_OLO,&#xa;T.TIPOLG_LAVRZ,PP.OFFERTA,PP.STATO_RICH_NOW,PP.STATO_RICH_OLO,PP.ID_EVENTO_ORDN_NOW_WHLS&#xa;  FROM PPS_STAG_FATTURAZIONE_KO PP&#xa;  LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON PP.ID_RICH_OLO = R.IDRICHIESTAOLO&#xa;  LEFT JOIN TIPOLG_LAVRZ T ON PP.IDTPLG_LAVRZ = T.IDTPLG_LAVRZ&#xa;  LEFT JOIN EVENTO_ORDN_NOW_WHLS E ON PP.ID_EVENTO_ORDN_NOW_WHLS = E.ID_EVENTO_ORDN_NOW_WHLS&#xa;  WHERE TRUNC(PP.DATA_ESTRAZIONE) = TO_DATE(?, 'DD/MM/YY') AND PP.DESCR_FAMIG_OFFERTA=? AND upper(trim(PP.STATO_RICH_NOW))= upper(?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATA_ESTRAZIONE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_FAMIG_OFFERTA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_RICH_NOW"/>
                                    <columnMetadata
                                    columnName="CAUS_SCARTO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_ORDN_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_ORDN_TI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLONOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DRO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DATA_ESTRAZIONE"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DESCR_FAMIG_OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_SCARTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO_EVENTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLG_LAVRZ"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_RICH_NOW"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_EVENTO_ORDN_NOW_WHLS"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable1"
                                    name="Assign"
                                    outputVariable="Variable1"
                                    tibex:xpdlId="8abcbfe7-710b-4634-8e8a-174dc3e6cce1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery1ToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess_NoExport">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AssignToJDBCQuery_ExportDati">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($get1/parameters/tns:monitoraggiofatturazione11GetParameters/tns:flagExport)='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($get1.parameters/tns:flagExport)='Y']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioFatturazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DrillDown1&quot;/>&lt;xsl:template name=&quot;Variable1&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DrillDown1/Record) > 0&quot;>&lt;tns:outputMonitoraggioFatturazioneSecondario>&lt;xsl:for-each select=&quot;$DrillDown1/Record&quot;>&lt;tns:outputMonitoraggioFatturazioneSecondario>&lt;tns:dataEstrazione>&lt;xsl:value-of select=&quot;DATA_ESTRAZIONE&quot;/>&lt;/tns:dataEstrazione>&lt;xsl:if test=&quot;DRO&quot;>&lt;tns:dataRicezioneOrdine>&lt;xsl:value-of select=&quot;DRO&quot;/>&lt;/tns:dataRicezioneOrdine>&lt;/xsl:if>&lt;tns:statoOrdineNOW>&lt;xsl:value-of select=&quot;STATO_RICH_NOW&quot;/>&lt;/tns:statoOrdineNOW>&lt;tns:statoRichiestaOLO>&lt;xsl:value-of select=&quot;STATO_RICH_OLO&quot;/>&lt;/tns:statoRichiestaOLO>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&lt;tns:codificaOloNOW>&lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&lt;/tns:codificaOloNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOLG_LAVRZ&quot;>&lt;tns:tipologiaLavorazione>&lt;xsl:value-of select=&quot;TIPOLG_LAVRZ&quot;/>&lt;/tns:tipologiaLavorazione>&lt;/xsl:if>&lt;tns:servizio>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:servizio>&lt;tns:codiceOrdineOlo>&lt;xsl:value-of select=&quot;COD_ORDN_OLO&quot;/>&lt;/tns:codiceOrdineOlo>&lt;tns:idRichiesta>&lt;xsl:value-of select=&quot;ID_RICH_OLO&quot;/>&lt;/tns:idRichiesta>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;COD_ORDN_TI&quot;/>&lt;/tns:codiceOrdineTI>&lt;tns:famigliaOfferta>&lt;xsl:value-of select=&quot;DESCR_FAMIG_OFFERTA&quot;/>&lt;/tns:famigliaOfferta>&lt;tns:idEventoOrdineNOW>&lt;xsl:value-of select=&quot;xsd:int(ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&lt;/tns:idEventoOrdineNOW>&lt;xsl:if test=&quot;TIMSTP_INSMTO_EVENTO&quot;>&lt;tns:dataEvento>&lt;xsl:value-of select=&quot;TIMSTP_INSMTO_EVENTO&quot;/>&lt;/tns:dataEvento>&lt;/xsl:if>&lt;tns:causaleScarto>&lt;xsl:value-of select=&quot;xsd:int(CAUS_SCARTO)&quot;/>&lt;/tns:causaleScarto>&lt;xsl:if test=&quot;DESCR_SCARTO&quot;>&lt;tns:descCausaleScarto>&lt;xsl:value-of select=&quot;DESCR_SCARTO&quot;/>&lt;/tns:descCausaleScarto>&lt;/xsl:if>&lt;/tns:outputMonitoraggioFatturazioneSecondario>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputMonitoraggioFatturazioneSecondario>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputMonitoraggioFatturazioneSecondario>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record da visualizzare&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputMonitoraggioFatturazioneSecondario>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
