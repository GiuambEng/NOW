    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="f2c5a590-89a5-4094-ae87-28be2d68431d">
                <bpws:onMessage operation="get"
                    partnerLink="monitoraggiofatturazione"
                    portType="ns:monitoraggiofatturazione"
                    tibex:xpdlId="ca582ec9-ae92-4f26-a6b7-92cd7b767bd4" variable="get">
                    <bpws:scope name="scope1">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails"
                                tibex:faultNameVar="FaultName" tibex:xpdlId="eec8b417-70c6-46f5-ba75-2e96d143b963">
                                <bpws:scope name="scope4">
