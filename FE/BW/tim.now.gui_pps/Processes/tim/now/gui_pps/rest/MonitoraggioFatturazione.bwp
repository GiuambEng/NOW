                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioFatturazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DrillDown2&quot;/>&lt;xsl:template name=&quot;Variable2&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DrillDown2/Record) > 0&quot;>&lt;tns:outputMonitoraggioFatturazioneDettaglio>&lt;xsl:for-each select=&quot;$DrillDown2/Record&quot;>&lt;tns:outputMonitoraggioFatturazioneDettaglio>&lt;xsl:if test=&quot;DATAINVIORICHIESTA&quot;>&lt;tns:dataCreazioneRichiesta>&lt;xsl:value-of select=&quot;DATAINVIORICHIESTA&quot;/>&lt;/tns:dataCreazioneRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&lt;tns:codiceOAO>&lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&lt;/tns:codiceOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINETI&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:statoNOW>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:statoNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:statoOLO>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:statoOLO>&lt;/xsl:if>&lt;tns:idRichiesta>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiesta>&lt;xsl:if test=&quot;DRO&quot;>&lt;tns:dro>&lt;xsl:value-of select=&quot;DRO&quot;/>&lt;/tns:dro>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:ambito>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:ambito>&lt;/xsl:if>&lt;xsl:if t