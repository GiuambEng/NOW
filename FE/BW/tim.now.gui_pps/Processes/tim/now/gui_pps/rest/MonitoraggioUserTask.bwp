                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://services.brm.n2.tibco.com/WorkListService_1.7.0" xmlns:ns="http://api.brm.n2.tibco.com" xmlns:ns2="http://resourcequery.api.de.n2.tibco.com" xmlns:tns1="http://xmlns.example.com/MonitoraggioUserTask/parameters" version="2.0"&gt;&lt;xsl:param name="GetGuiFromBpm"/&gt;&lt;xsl:param name="get"/&gt;&lt;xsl:template name="getWorkItemsList-input" match="/"&gt;&lt;tns:getWorkListItemsRequest&gt;&lt;getWorkListItemsRequestDoc&gt;&lt;ns:getWorkListItems&gt;&lt;xsl:attribute name="getEnhancedAttributes"&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="getTotalCount"&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="numberOfItems"&gt;&lt;xsl:value-of select="10000"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="startPosition"&gt;&lt;xsl:value-of select="0"/&gt;&lt;/xsl:attribute&gt;&lt;entityID&gt;&lt;xsl:attribute name="entity-type"&gt;&lt;xsl:value-of select="'RESOURCE'"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="guid"&gt;&lt;xsl:value-of select="$GetGuiFromBpm/parameter/ns2:executeQueryResponse/resource[1]/@guid"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="model-version"&gt;&lt;xsl:value-of select="-1"/&gt;&lt;/xsl:attribute&gt;&lt;/entityID&gt;&lt;orderFilterCriteria&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$get/parameters/tns1:monitoraggiousertaskGetParameters/tns1:tipoUserTask='UserTaskCausaliErrate'"&gt;&lt;filter&gt;&lt;xsl:value-of select="&amp;quot;name='GestioneCausaleERRATA' or name='GestioneCausaleERRATANoTimer'&amp;quot; "/&gt;&lt;/filter&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$get/parameters/tns1:monitoraggiousertaskGetParameters/tns1:tipoUserTask='UserTaskCausaliSbagliateDTU'"&gt;&lt;filter&gt;&lt;xsl:value-of select="concat(&amp;quot;name=&amp;quot;,&amp;quot;'&amp;quot;,&amp;quot;GestioneKOFormatoRichiesteDTU&amp;quot;,&amp;quot;'&amp;quot;)"/&gt;&lt;/filter&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$get/parameters/tns1:monitoraggiousertaskGetParameters/tns1:tipoUserTask='UserTaskCausaliImproprie'"&gt;&lt;filter&gt;&lt;xsl:value-of select="&amp;quot;name='GestioneCausaliIMPROPRIE' or name='GestioneCausaliIMPROPRIENoTimer'&amp;quot;"/&gt;&lt;/filter&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;/orderFilterCriteria&gt;&lt;/ns:getWorkListItems&gt;&lt;/getWorkListItemsRequestDoc&gt;&lt;/tns:getWorkListItemsRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://services.brm.n2.tibco.com/WorkListService_1.7.0&quot; xmlns:ns=&quot;http://api.brm.n2.tibco.com&quot; xmlns:ns2=&quot;http://resourcequery.api.de.n2.tibco.com&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioUserTask/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetGuiFromBpm.parameter&quot;/>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;getWorkItemsList-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:getWorkListItems>&#xa;            &lt;xsl:attribute name=&quot;getEnhancedAttributes&quot;>&#xa;                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;            &lt;/xsl:attribute>&#xa;            &lt;xsl:attribute name=&quot;getTotalCount&quot;>&#xa;                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;            &lt;/xsl:attribute>&#xa;            &lt;xsl:attribute name=&quot;numberOfItems&quot;>&#xa;                &lt;xsl:value-of select=&quot;10000&quot;/>&#xa;            &lt;/xsl:attribute>&#xa;            &lt;xsl:attribute name=&quot;startPosition&quot;>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/xsl:attribute>&#xa;            &lt;entityID>&#xa;                &lt;xsl:attribute name=&quot;entity-type&quot;>&#xa;                    &lt;xsl:value-of select=&quot;'RESOURCE'&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:attribute name=&quot;guid&quot;>&#xa;                    &lt;xsl:value-of select=&quot;$GetGuiFromBpm.parameter/resource[1]/@guid&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:attribute name=&quot;model-version&quot;>&#xa;                    &lt;xsl:value-of select=&quot;-1&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;            &lt;/entityID>&#xa;            &lt;orderFilterCriteria>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$get.parameters/tns1:tipoUserTask='UserTaskCausaliErrate'&quot;>&#xa;                        &lt;filter>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;name='GestioneCausaleERRATA' or name='GestioneCausaleERRATANoTimer'&amp;quot; &quot;/>&#xa;                        &lt;/filter>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$get.parameters/tns1:tipoUserTask='UserTaskCausaliSbagliateDTU'&quot;>&#xa;                        &lt;filter>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;name=&amp;quot;,&amp;quot;'&amp;quot;,&amp;quot;GestioneKOFormatoRichiesteDTU&amp;quot;,&amp;quot;'&amp;quot;)&quot;/>&#xa;                        &lt;/filter>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$get.parameters/tns1:tipoUserTask='UserTaskCausaliImproprie'&quot;>&#xa;                        &lt;filter>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;name='GestioneCausaliIMPROPRIE' or name='GestioneCausaliIMPROPRIENoTimer'&amp;quot;&quot;/>&#xa;                        &lt;/filter>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/orderFilterCriteria>&#xa;        &lt;/ns:getWorkListItems>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="Log1TogetWorkItemsList"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="GetWorkListItemsToCallProcess1"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:scope name="Iterate"
                                tibex:group="iterate" tibex:xpdlId="0e8ccf9b-97c4-4048-b613-23fd1e304db6">
                                <bpws:documentation>Cicla sulla lista degli workItem associati all'utenza GUID ricavata dall'invoke GetGuiFromBpm</bpws:documentation>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToIterate"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="IterateToCallProcess2"/>
                                </bpws:sources>
                                <bpws:sequence name="sequence" tibex:group="iterate">
                                    <bpws:assign name="GroupInit"
                                    tibex:group="groupInit"
                                    tibex:xpdlId="7ae5213c-8057-4077-842e-627d104cf7af" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+5fed99b7-26fc-49fb-bd60-419fbb0c2e6d" version="2.0"> <xsl:template name="AccumulateWorkItem" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="AccumulateWorkItem"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:forEach counterName="index"
                                    name="iterate" parallel="no" tibex:group="iterate">
                                    <tibex:DesignExpression name="variableList">
                                    <tibex:expression
                                    expression="$getWorkItemsList/getWorkListItemsResponseDoc/ns4:getWorkListItemsResponse/workItems" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($getWorkItemsList.getWorkListItemsResponseDoc/workItems)]]></bpws:finalCounterValue>
                                    <bpws:scope name="innerScope">
                                    <bpws:variables>
                                    <bpws:variable
                                    element="ns4:Iterate_Current_Element_workItems"
                                    name="currentWorkItem2" sca-bpel:internal="true"/>
                                    </bpws:variables>
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MapperToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="ANAG_CAUSALEToAssign"
                                    tibex:label="Causali Improprie" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AssignToMapSingleWorkItem_altrecausali"
                                    tibex:label="altre causali" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ANAG_CAUSALEToJDBCQuery" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="JDBCQueryToMapSingleWorkItem" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="aa321717-8ee2-4428-b361-701effda6ccc" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($getWorkItemsList.getWorkListItemsResponseDoc/workItems)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentWorkItem2"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    name="AccumulateWorkItem"
                                    outputVariable="AccumulateWorkItem"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="5fed99b7-26fc-49fb-bd60-419fbb0c2e6d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

