                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess5TopostOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if(exists($post/httpHeaders/tns:httpHeaders/GUI-UID) and $post/httpHeaders/tns:httpHeaders/GUI-UID!='') then  $post/httpHeaders/tns:httpHeaders/GUI-UID else  'tibco-admin'"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
