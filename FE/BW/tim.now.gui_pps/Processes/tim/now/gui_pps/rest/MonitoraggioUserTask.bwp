                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20161012131214PLT" xmlns:tns1="http://www.example.org/MonitoraggioUserTaskSchema" xmlns:ns22="http://resourcequery.api.de.n2.tibco.com" xmlns:tns2="http://tns.tibco.com/bw/REST" xmlns:ns4="http://api.brm.n2.tibco.com" version="2.0"&gt;&lt;xsl:param name="AccumulateWorkItem"/&gt;&lt;xsl:param name="GetGuiFromBpm"/&gt;&lt;xsl:param name="get"/&gt;&lt;xsl:param name="getWorkItemsList"/&gt;&lt;xsl:template name="getOut-input" match="/"&gt;&lt;tns:getResponse&gt;&lt;monitoraggioUserTaskOutT0&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($GetGuiFromBpm/parameter/ns22:executeQueryResponse/resource[1]/@guid) and exists($getWorkItemsList/getWorkListItemsResponseDoc/ns4:getWorkListItemsResponse/workItems[1]/header/name)"&gt;&lt;tns1:MonitoraggioUserTask&gt;&lt;xsl:copy-of select="$AccumulateWorkItem/tns1:MonitoraggioUserTask/tns1:UserTaskCausaliErrate"/&gt;&lt;xsl:copy-of select="$AccumulateWorkItem/tns1:MonitoraggioUserTask/tns1:UserTaskCausaliImproprie"/&gt;&lt;xsl:copy-of select="$AccumulateWorkItem/tns1:MonitoraggioUserTask/tns1:UserTaskCausaliSbagliateDTU"/&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/tns1:code&gt;&lt;/tns1:result&gt;&lt;/tns1:MonitoraggioUserTask&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:MonitoraggioUserTask&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/tns1:code&gt;&lt;xsl:choose&gt;&lt;xsl:when test="not(exists($getWorkItemsList/getWorkListItemsResponseDoc/ns4:getWorkListItemsResponse/workItems[1]/header/name))"&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="concat('NON CI SONO USER TASKS PER LO USER-ID:',$get/httpHeaders/tns2:httpHeaders/GUI-UID)"/&gt;&lt;/tns1:details&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="concat('NESSUN UTENTE ASSOCIATO ALLO USER-ID:',$get/httpHeaders/tns2:httpHeaders/GUI-UID)"/&gt;&lt;/tns1:details&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:result&gt;&lt;/tns1:MonitoraggioUserTask&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/monitoraggioUserTaskOutT0&gt;&lt;/tns:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20161012131214PLT&quot; xmlns:tns1=&quot;http://www.example.org/MonitoraggioUserTaskSchema&quot; xmlns:ns22=&quot;http://resourcequery.api.de.n2.tibco.com&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:ns4=&quot;http://api.brm.n2.tibco.com&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetGuiFromBpm.parameter&quot;/>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;getWorkItemsList.getWorkListItemsResponseDoc&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateWorkItem&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($GetGuiFromBpm.parameter/resource[1]/@guid) and exists($getWorkItemsList.getWorkListItemsResponseDoc/workItems[1]/header/name)&quot;>&#xa;                &lt;tns1:MonitoraggioUserTask>&#xa;                    &lt;xsl:copy-of select=&quot;$AccumulateWorkItem/tns1:MonitoraggioUserTask/tns1:UserTaskCausaliErrate&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$AccumulateWorkItem/tns1:MonitoraggioUserTask/tns1:UserTaskCausaliImproprie&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$AccumulateWorkItem/tns1:MonitoraggioUserTask/tns1:UserTaskCausaliSbagliateDTU&quot;/>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:MonitoraggioUserTask>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:MonitoraggioUserTask>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;not(exists($getWorkItemsList.getWorkListItemsResponseDoc/workItems[1]/header/name))&quot;>&#xa;                                &lt;tns1:details>&#xa;                                    &lt;xsl:value-of select=&quot;concat('NON CI SONO USER TASKS PER LO USER-ID:',$get.httpHeaders/GUI-UID)&quot;/>&#xa;                                &lt;/tns1:details>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:details>&#xa;                                    &lt;xsl:value-of select=&quot;concat('NESSUN UTENTE ASSOCIATO ALLO USER-ID:',$get.httpHeaders/GUI-UID)&quot;/>&#xa;                                &lt;/tns1:details>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:MonitoraggioUserTask>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
