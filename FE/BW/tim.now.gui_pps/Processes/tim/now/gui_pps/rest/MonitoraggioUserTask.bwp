&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://services.de.n2.tibco.com/ResourceQueryService_1.8.0" xmlns:ns1="http://resourcequery.api.de.n2.tibco.com" version="2.0"&gt;&lt;xsl:param name="GUID"/&gt;&lt;xsl:template name="GetGuiFromBpm-input" match="/"&gt;&lt;tns1:executeQueryRequest&gt;&lt;parameter&gt;&lt;ns1:executeQuery&gt;&lt;query&gt;&lt;xsl:value-of select="concat(&amp;quot;resource(name='&amp;quot;,$GUID,&amp;quot;')&amp;quot;)"/&gt;&lt;/query&gt;&lt;/ns1:executeQuery&gt;&lt;/parameter&gt;&lt;/tns1:executeQueryRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://services.de.n2.tibco.com/ResourceQueryService_1.8.0&quot; xmlns:ns1=&quot;http://resourcequery.api.de.n2.tibco.com&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GUID&quot;/>&#xa;    &lt;xsl:template name=&quot;GetGuiFromBpm-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:executeQuery>&#xa;            &lt;query>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;resource(name='&amp;quot;,$GUID,&amp;quot;')&amp;quot;)&quot;/>&#xa;            &lt;/query>&#xa;        &lt;/ns1:executeQuery>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
