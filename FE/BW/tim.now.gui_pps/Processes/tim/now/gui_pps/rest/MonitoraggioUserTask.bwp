                                    <bpws:source linkName="CausaliErrateTorestErrate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioUserTaskSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentCausaleErrata&quot;/>&lt;xsl:param name=&quot;ErrorErrate&quot;/>&lt;xsl:template name=&quot;CausaliErrate-input&quot; match=&quot;/&quot;>&lt;tns:UserTaskResult>&lt;xsl:choose>&lt;xsl:when test=&quot;$ErrorErrate='ERROR COMPLETE  USER TASK'&quot;>&lt;tns:listUserTaskResultErrate>&lt;tns:resultCompleted>&lt;xsl:value-of select=&quot;concat('KO ERROR COMPLETED USER TASK-WorkItemId:',$currentCausaleErrata/tns:idWorkItem)&quot;/>&lt;/tns:resultCompleted>&lt;tns:woorkItemId>&lt;xsl:value-of select=&quot;$currentCausaleErrata/tns:idWorkItem&quot;/>&lt;/tns:woorkItemId>&lt;/tns:listUserTaskResultErrate>&lt;/xsl:when>&lt;xsl:when test=&quot;$ErrorErrate='ERROR OPEN  USER TASK'&quot;>&lt;tns:listUserTaskResultErrate>&lt;tns:resultCompleted>&lt;xsl:value-of select=&quot;concat('KO ERROR APERTURA USER TASK-WorkItemId:',$currentCausaleErrata/tns:idWorkItem)&quot;/>&lt;/tns:resultCompleted>&lt;tns:woorkItemId>&lt;xsl:value-of select=&quot;$currentCausaleErrata/tns:idWorkItem&quot;/>&lt;/tns:woorkItemId>&lt;/tns:listUserTaskResultErrate>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:UserTaskResult>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
