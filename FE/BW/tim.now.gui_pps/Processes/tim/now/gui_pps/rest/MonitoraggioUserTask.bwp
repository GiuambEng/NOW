tribute21&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;tns:idWorkItem>&lt;xsl:value-of select=&quot;$currentWorkItem2/id/@id&quot;/>&lt;/tns:idWorkItem>&lt;xsl:if test=&quot;$currentWorkItem2/id/@version&quot;>&lt;tns:version>&lt;xsl:value-of select=&quot;$currentWorkItem2/id/@version&quot;/>&lt;/tns:version>&lt;/xsl:if>&lt;/tns:UserTaskCausaliErrate>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$currentWorkItem2/header/name = (&amp;quot;GestioneCausaleIMPROPRIA&amp;quot;,&amp;quot;GestioneCausaleIMPROPRIANoTimer&amp;quot;)&quot;>&lt;tns:UserTaskCausaliImproprie>&lt;xsl:if test=&quot;$GETOFFERTA/Record[1]/OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$GETOFFERTA/Record[1]/OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;$GETOFFERTA/Record[1]/LAVORAZIONE&quot;>&lt;tns:tipoLavorazione>&lt;xsl:value-of select=&quot;$GETOFFERTA/Record[1]/LAVORAZIONE&quot;/>&lt;/tns:tipoLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute3&quot;>&lt;tns:codiceOrdineOlo>&lt;xsl:value-of select=&quot;$currentWorkItem2/attributes/@attribute3&quot;/>&lt;/tns:codiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute4&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;$currentWorkItem2/attributes/@attribute4&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute27&quot;>&lt;tns:causale>&lt;xsl:value-of select=&quot;$currentWorkItem2/attributes/@attribute27&quot;/>&lt;/tns:causale>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute28&quot;>&lt;tns:statoNOW>&lt;xsl:value-of select=&quot;$currentWorkItem2/attributes/@attribute28&quot;/>&lt;/tns:statoNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute30&quot;>&lt;tns:statoOAO>&lt;xsl:value-of select=&quot;$currentWorkItem2/attributes/@attribute30&quot;/>&lt;/tns:statoOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribu