                        &lt;xsl:value-of select=&quot;'Integer Number'&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;simpleSpec>&#xa;                                    &lt;xsl:if test=&quot;$currentImproprie/tns:causaleModificata&quot;>&#xa;                                        &lt;value>&#xa;                                            &lt;xsl:value-of select=&quot;$currentImproprie/tns:causaleModificata&quot;/>&#xa;                                        &lt;/value>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/simpleSpec>&#xa;                            &lt;/outputs>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;outputs>&#xa;                        &lt;xsl:attribute name=&quot;name&quot;>&#xa;                            &lt;xsl:value-of select=&quot;'action'&quot;/>&#xa;                        &lt;/xsl:attribute>&#xa;                        &lt;xsl:attribute name=&quot;type&quot;>&#xa;                            &lt;xsl:value-of select=&quot;'String'&quot;/>&#xa;                        &lt;/xsl:attribute>&#xa;                        &lt;simpleSpec>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$currentImproprie/tns:azione='SKIP' or $currentImproprie/tns:azione='SKIP_MOD'&quot;>&#xa;                                    &lt;value>&#xa;                                        &lt;xsl:value-of select=&quot;'SKIP'&quot;/>&#xa;                                    &lt;/value>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$currentImproprie/tns:azione='RETRY'&quot;>&#xa;                                    &lt;value>&#xa;                                        &lt;xsl:value-of select=&quot;'RETRY'&quot;/>&#xa;                                    &lt;/value>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/simpleSpec>&#xa;                    &lt;/outputs>&#xa;                    &lt;!--'Modifica Causale'-->&#xa;                &lt;/dataModel>&#xa;            &lt;/workItemPayload>&#xa;        &lt;/ns:completeWorkItem>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
