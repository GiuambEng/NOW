;tns:idWorkItem>&lt;xsl:value-of select=&quot;$currentWorkItem2/id/@id&quot;/>&lt;/tns:idWorkItem>&lt;xsl:if test=&quot;$currentWorkItem2/id/@version&quot;>&lt;tns:version>&lt;xsl:value-of select=&quot;$currentWorkItem2/id/@version&quot;/>&lt;/tns:version>&lt;/xsl:if>&lt;/tns:UserTaskCausaliSbagliateDTU>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:MonitoraggioUserTask>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
