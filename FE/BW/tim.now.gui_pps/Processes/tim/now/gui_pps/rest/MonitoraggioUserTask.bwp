                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="not(exists($GetGuiFromBpm/parameter/ns22:executeQueryResponse/resource[1]/@guid))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
