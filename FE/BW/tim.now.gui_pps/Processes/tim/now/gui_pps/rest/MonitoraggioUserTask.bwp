ue-of select=&quot;xsd:string($AllocateAndOpen.allocateAndOpenWorkItemResponseDoc/workItem[1]/id/@version)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;            &lt;/workTypeDetail>&#xa;        &lt;/ns1:baseWorkRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
