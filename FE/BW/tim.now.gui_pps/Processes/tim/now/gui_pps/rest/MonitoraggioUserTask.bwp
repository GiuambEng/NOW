                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioUserTaskSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ANAG_CAUSALE&quot;/>&lt;xsl:param name=&quot;currentWorkItem2&quot;/>&lt;xsl:param name=&quot;GETOFFERTA&quot;/>&lt;xsl:template name=&quot;MapSingleWorkItem-input&quot; match=&quot;/&quot;>&lt;tns:MonitoraggioUserTask>&lt;xsl:choose>&lt;xsl:when test=&quot;$currentWorkItem2/header/name = (&amp;quot;GestioneCausaleERRATA&amp;quot;,&amp;quot;GestioneCausaleERRATANoTimer&amp;quot;)&quot;>&lt;tns:UserTaskCausaliErrate>&lt;xsl:if test=&quot;$GETOFFERTA/Record[1]/OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$GETOFFERTA/Record[1]/OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;$GETOFFERTA/Record[1]/LAVORAZIONE&quot;>&lt;tns:tipoLavorazione>&lt;xsl:value-of select=&quot;$GETOFFERTA/Record[1]/LAVORAZIONE&quot;/>&lt;/tns:tipoLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute3&quot;>&lt;tns:codiceOrdineOlo>&lt;xsl:value-of select=&quot;$currentWorkItem2/attributes/@attribute3&quot;/>&lt;/tns:codiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute4&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;$currentWorkItem2/attributes/@attribute4&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute27&quot;>&lt;tns:causale>&lt;xsl:value-of select=&quot;$currentWorkItem2/attributes/@attribute27&quot;/>&lt;/tns:causale>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute28&quot;>&lt;tns:statoNOW>&lt;xsl:value-of select=&quot;$currentWorkItem2/attributes/@attribute28&quot;/>&lt;/tns:statoNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentWorkItem2/attributes/@attribute29&quot;>&lt;tns:statoOAO>&lt;xsl:value-of select=&