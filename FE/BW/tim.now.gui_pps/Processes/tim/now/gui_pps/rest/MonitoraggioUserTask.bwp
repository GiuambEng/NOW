                                    <bpws:sources>
                                    <bpws:source linkName="UnlocateToUNLOVK_OK"/>
                                    </bpws:sources>
                                    </bpws:invoke>
                                    <bpws:invoke
                                    inputVariable="CancelWorkItem-input"
                                    name="CancelWorkItem"
                                    operation="cancelWorkItem"
                                    outputVariable="CancelWorkItem"
                                    partnerLink="WorkPresentationService"
                                    portType="ns13:WorkPresentationService" tibex:xpdlId="b6818b40-77fa-42c0-a1b5-74b5d938e733">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://resourcequery.api.de.n2.tibco.com" xmlns:tns="http://services.wp.n2.tibco.com/WorkPresentationService_1.7.0" xmlns:ns1="http://api.wp.n2.tibco.com" xmlns:tns1="http://www.example.org/MonitoraggioUserTaskSchema" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="currentCausaleErrata"/&gt;&lt;xsl:param name="GetGuiBpm"/&gt;&lt;xsl:template name="CancelWorkItem-input" match="/"&gt;&lt;tns:cancelWorkItemRequest&gt;&lt;request&gt;&lt;ns1:baseWorkRequest&gt;&lt;resourceId&gt;&lt;xsl:value-of select="$GetGuiBpm/parameter/ns:executeQueryResponse/resource[1]/@guid"/&gt;&lt;/resourceId&gt;&lt;channelId&gt;&lt;xsl:value-of select="&amp;quot;GIGWTPull_DefaultChannel&amp;quot;"/&gt;&lt;/channelId&gt;&lt;channelType&gt;&lt;xsl:value-of select="'GIChannel'"/&gt;&lt;/channelType&gt;&lt;workItem&gt;&lt;xsl:attribute name="id"&gt;&lt;xsl:value-of select="xsd:long($currentCausaleErrata/tns1:idWorkItem)"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:value-of select="''"/&gt;&lt;/workItem&gt;&lt;workTypeDetail&gt;&lt;xsl:attribute name="uid"&gt;&lt;xsl:value-of select="$GetGuiBpm/parameter/ns:executeQueryResponse/resource[1]/@guid"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="version"&gt;&lt;xsl:value-of select="$currentCausaleErrata/tns1:version"/&gt;&lt;/xsl:attribute&gt;&lt;/workTypeDetail&gt;&lt;/ns1:baseWorkRequest&gt;&lt;/request&gt;&lt;/tns:cancelWorkItemRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://resourcequery.api.de.n2.tibco.com&quot; xmlns:tns=&quot;http://services.wp.n2.tibco.com/WorkPresentationService_1.7.0&quot; xmlns:ns1=&quot;http://api.wp.n2.tibco.com&quot; xmlns:tns1=&quot;http://www.example.org/MonitoraggioUserTaskSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetGuiBpm.parameter&quot;/>&#xa;    &lt;xsl:param name=&quot;currentCausaleErrata&quot;/>&#xa;    &lt;xsl:template name=&quot;CancelWorkItem-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:baseWorkRequest>&#xa;            &lt;resourceId>&#xa;                &lt;xsl:value-of select=&quot;$GetGuiBpm.parameter/resource[1]/@guid&quot;/>&#xa;            &lt;/resourceId>&#xa;            &lt;channelId>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GIGWTPull_DefaultChannel&amp;quot;&quot;/>&#xa;            &lt;/channelId>&#xa;            &lt;channelType>&#xa;                &lt;xsl:value-of select=&quot;'GIChannel'&quot;/>&#xa;            &lt;/channelType>&#xa;            &lt;workItem>&#xa;                &lt;xsl:attribute name=&quot;id&quot;>&#xa;                    &lt;xsl:value-of select=&quot;xsd:long($currentCausaleErrata/tns1:idWorkItem)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/workItem>&#xa;            &lt;workTypeDetail>&#xa;                &lt;xsl:attribute name=&quot;uid&quot;>&#xa;                    &lt;xsl:value-of select=&quot;$GetGuiBpm.parameter/resource[1]/@guid&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:attribute name=&quot;version&quot;>&#xa;                    &lt;xsl:value-of select=&quot;$currentCausaleErrata/tns1:version&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;            &lt;/workTypeDetail>&#xa;        &lt;/ns1:baseWorkRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
