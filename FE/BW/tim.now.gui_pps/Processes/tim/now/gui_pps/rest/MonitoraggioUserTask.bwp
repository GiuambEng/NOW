                                    <bpws:invoke
                                    inputVariable="Unlocate-input"
                                    name="Unlocate"
                                    operation="unallocateWorkItem"
                                    outputVariable="Unlocate"
                                    partnerLink="WorkItemManagementService"
                                    portType="ns12:WorkItemManagementService" tibex:xpdlId="e3aee295-9ccb-4beb-aa6e-2cac17f9fece">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://services.brm.n2.tibco.com/WorkItemManagementService_1.7.0" xmlns:ns1="http://api.brm.n2.tibco.com" xmlns:tns1="http://www.example.org/MonitoraggioUserTaskSchema" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="currentCausaleErrata"/&gt;&lt;xsl:param name="AllocateAndOpenWorkItem"/&gt;&lt;xsl:template name="Unlocate-input" match="/"&gt;&lt;tns:unallocateWorkItemRequest&gt;&lt;unallocateWorkItemDoc&gt;&lt;ns1:unallocateWorkItem&gt;&lt;workItemID&gt;&lt;xsl:attribute name="id"&gt;&lt;xsl:value-of select="xsd:long($currentCausaleErrata/tns1:idWorkItem)"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="version"&gt;&lt;xsl:value-of select="xsd:long($AllocateAndOpenWorkItem/allocateAndOpenWorkItemResponseDoc/ns1:allocateAndOpenWorkItemResponse/workItem[1]/id/@version+1)"/&gt;&lt;/xsl:attribute&gt;&lt;/workItemID&gt;&lt;/ns1:unallocateWorkItem&gt;&lt;/unallocateWorkItemDoc&gt;&lt;/tns:unallocateWorkItemRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://services.brm.n2.tibco.com/WorkItemManagementService_1.7.0&quot; xmlns:ns1=&quot;http://api.brm.n2.tibco.com&quot; xmlns:tns1=&quot;http://www.example.org/MonitoraggioUserTaskSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AllocateAndOpenWorkItem.allocateAndOpenWorkItemResponseDoc&quot;/>&#xa;    &lt;xsl:param name=&quot;currentCausaleErrata&quot;/>&#xa;    &lt;xsl:template name=&quot;Unlocate-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:unallocateWorkItem>&#xa;            &lt;workItemID>&#xa;                &lt;xsl:attribute name=&quot;id&quot;>&#xa;                    &lt;xsl:value-of select=&quot;xsd:long($currentCausaleErrata/tns1:idWorkItem)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:attribute name=&quot;version&quot;>&#xa;                    &lt;xsl:value-of select=&quot;xsd:long($AllocateAndOpenWorkItem.allocateAndOpenWorkItemResponseDoc/workItem[1]/id/@version+1)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;            &lt;/workItemID>&#xa;        &lt;/ns1:unallocateWorkItem>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="LogToUnlocate"/>
