                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RICH.IDRICHIESTAOLO, RICH.DATAINVIORICHIESTA, RICH.CODIFICAOLOAGCOM,RICH.CODIFICAOLONOW, RICH.CODICEORDINETI,&#xa;RICH.STATORICHIESTAOLO, RICH.STATORICHIESTANOW, RICH.DRO, RICH.IDRISORSA, RICH.OFFERTA, FO.DESCR&#xa;FROM BDS_1_CASEDATA_RICHIESTA RICH &#xa;LEFT JOIN OFFERTA O ON O.ID_OFFERTA = RICH.IDOFFERTA&#xa;LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA = O.ID_FAMIG_OFFERTA&#xa;WHERE RICH.IDRICHIESTAOLO in (SELECT SCA.ID_RICH_OLO&#xa;FROM PPS_RICH_OLO_SCARTATA SCA&#xa;WHERE SCA.COD_CAUS_OLO = ? AND SCA.COD_FAMIG_CAUS = ? and TRUNC(SCA.TIMSTP_AGGTO_RICH_OLO) >= (SYSDATE - 6))" xsi:type="jdbcPalette:JDBCQueryActivity">

