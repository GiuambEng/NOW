                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+19b88a11-1a42-4c2a-81ec-091857138a79+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioKOOLO/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;DettaglioGiornaliero-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;causale>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns1:causale&quot;/>&#xa;            &lt;/causale>&#xa;            &lt;famiglia>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns1:famiglia&quot;/>&#xa;            &lt;/famiglia>&#xa;            &lt;data>&#xa;                &lt;xsl:value-of select=&quot;format-date(xsd:date($get1.parameters/tns1:dataTotale), &amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)&quot;/>&#xa;            &lt;/data>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
