                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:copy-of select="$T2/tns:result"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get1/parameters/tns2:monitoraggioagcomGetParameters/tns2:flagExport)='Y'"&gt;
                            &lt;tns:esitoExport&gt;
                                &lt;xsl:value-of select="'OK'"/&gt;
                            &lt;/tns:esitoExport&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get1/parameters/tns2:monitoraggioagcomGetParameters/tns2:flagExport)='Y'"&gt;
                            &lt;tns:idFile&gt;
