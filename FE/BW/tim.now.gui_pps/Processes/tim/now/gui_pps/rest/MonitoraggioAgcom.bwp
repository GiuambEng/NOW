                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://xmlns.example.com/20161123173259PLT/ConceptSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;InputLogMon_Agcom-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioAgcom&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioAgcom&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns2:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns1:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns2:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns1:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputMonitoraggioAgcom:&amp;quot;,&amp;quot;T1&amp;quot;,tib:render-xml($get/httpHeaders/tns2:httpHeaders ))&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioAgcom&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns2:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns1:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns2:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns1:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID&amp;quot;,$get/httpHeaders/tns2:httpHeaders/GUI-SID,&amp;quot;-&amp;quot;,&amp;quot;TID&amp;quot;,$get/httpHeaders/tns2:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns1:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns2:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns1:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns2:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns1:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioAgcom_&amp;quot;,$get/httpHeaders/tns2:httpHeaders/GUI-TID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioAgcom_&amp;quot;,$get/httpHeaders/tns2:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;                &lt;tns1:Playload>&#xa;                    &lt;tns1:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get/httpHeaders/tns2:httpHeaders )))&quot;/>&#xa;                    &lt;/tns1:Binary>&#xa;                    &lt;tns1:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($get/parameters/tns3:monitoraggioagcomGetParameters,true(),true())&quot;/>&#xa;                    &lt;/tns1:XMLString>&#xa;                &lt;/tns1:Playload>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="InputLogMon_Agcom-input"
                                    name="InputLogMon_Agcom"
                                    tibex:xpdlId="44a52b92-e994-4140-8923-5d13926e53d0"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://xmlns.example.com/20161123173259PLT/ConceptSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;InputLogMon_Agcom-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioAgcom&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioAgcom&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns1:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns1:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputMonitoraggioAgcom:&amp;quot;,&amp;quot;T1&amp;quot;,tib:render-xml($get.httpHeaders ))&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioAgcom&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns1:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns1:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;-&amp;quot;,&amp;quot;TID&amp;quot;,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns1:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns1:CorrelationID>&#xa;                