                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://xmlns.example.com/20161123173259PLT&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioAgcom&quot; xmlns:tns3=&quot;http://xmlns.example.com/MonitoraggioAgcom/parameters&quot; xmlns:tns2=&quot;http://www.example.org/CryptoParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;T4&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParams4&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:MonitoraggioAgcomT4>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($get3.parameters/tns3:flagExport)!='Y'&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$T4/tns:MonitoraggioAgcomT4ListOut&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:MonitoraggioAgcomT4ListOut/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$T4/tns:result&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($get3.parameters/tns3:flagExport)='Y'&quot;>&#xa;                    &lt;tns:esitoExport>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:esitoExport>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($get3.parameters/tns3:flagExport)='Y'&quot;>&#xa;                    &lt;tns:idFile>&#xa;                        &lt;xsl:value-of select=&quot;$CryptoParams4/tns2:idFileCriptato&quot;/>&#xa;                    &lt;/tns:idFile>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:MonitoraggioAgcomT4>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
