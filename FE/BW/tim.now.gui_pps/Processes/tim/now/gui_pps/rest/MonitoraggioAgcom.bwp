                            &lt;/tns:idFile&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns:MonitoraggioAgcomT2&gt;
            &lt;/item&gt;
        &lt;/tns4:getResponse2&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
