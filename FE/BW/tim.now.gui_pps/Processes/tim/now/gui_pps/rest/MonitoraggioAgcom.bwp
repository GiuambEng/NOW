                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select   to_date(data_report_agcom) data_report_agcom, sum(num_lavorati) num_lavorati, sum(ag.num_gcz) num_gcz,&#xa; sum(num_ok)*100 percKO , &#xa; sum(num_ko)*100 percOK ,&#xa; sum( NUM_ENTRO_PRIMA_DAC_SLA)*100 NUM_ENTRO_PRIMA_DAC_SLA_PERC ,&#xa; sum( NUM_OLTRE_PRIMA_DAC_SLA)*100 NUM_OLTRE_PRIMA_DAC_SLA_PERC ,&#xa; sum(DI_CUI_GCZ_RIMODULATA)*100 DI_CUI_GCZ_RIMODULATA_PERC ,&#xa; sum(DI_CUI_GCZ_A_DAC_SCADUTA)*100 DI_CUI_GCZ_A_DAC_SCADUTA_PERC ,&#xa; sum(GCZ_SCADUTA_TOT_SU_GCZ)*100 GCZ_SCADUTA_TOT_SU_GCZ_PERC &#xa; from &#xa;pps_agcom_aggro ag&#xa;where id_agcom_aggro  in (&#xa;                         select distinct max(id_agcom_aggro)   from (&#xa;                                 select a.id_agcom_aggro,a.data_report_agcom&#xa;                                 from    pps_agcom_aggro a&#xa;                                 where &#xa;                                 to_date(data_report_agcom)  in(TO_DATE(?,'dd-mm-yyyy'),TO_DATE(?,'dd-mm-yyyy')-7, TO_DATE(?,'dd-mm-yyyy')-14,TO_DATE(?,'dd-mm-yyyy')-21,TO_DATE(?,'dd-mm-yyyy')-28,TO_DATE(?,'dd-mm-yyyy')-35)&#xa;                                 group by data_report_agcom,id_agcom_aggro)&#xa;                        group by data_report_agcom)&#xa;                     &#xa;                        group by data_report_agcom, ag.id_agcom_aggro&#xa;                      order by data_report_agcom desc"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Parameter"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Parameter1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Parameter2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Parameter3"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Parameter4"/>

                                    <PreparedParameters
