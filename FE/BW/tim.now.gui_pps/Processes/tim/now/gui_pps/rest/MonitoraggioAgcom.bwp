    &lt;xsl:param name="get"/&gt;
    &lt;xsl:param name="CryptoParam"/&gt;
    &lt;xsl:template name="getOut-input" match="/"&gt;
        &lt;tns4:getResponse&gt;
            &lt;monitoraggioAgcomT1&gt;
                &lt;tns:MonitoraggioAgcomT1&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get/parameters/tns2:monitoraggioagcomGetParameters/tns2:flagExport)!='Y'"&gt;
                            &lt;xsl:copy-of select="$T1/tns:MonitoraggioAgcomT1ListOut"/&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns:MonitoraggioAgcomT1ListOut/&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:copy-of select="$T1/tns:result"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get/parameters/tns2:monitoraggioagcomGetParameters/tns2:flagExport)='Y'"&gt;
                            &lt;tns:esitoExport&gt;
                                &lt;xsl:value-of select="'OK'"/&gt;
                            &lt;/tns:esitoExport&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get/parameters/tns2:monitoraggioagcomGetParameters/tns2:flagExport)='Y'"&gt;
                            &lt;tns:idFile&gt;
                                &lt;xsl:value-of select="$CryptoParam/tns3:idFileCriptato"/&gt;
                            &lt;/tns:idFile&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns:MonitoraggioAgcomT1&gt;
            &lt;/monitoraggioAgcomT1&gt;
        &lt;/tns4:getResponse&gt;
    &lt;/xsl:template&gt;
