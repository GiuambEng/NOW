                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioAgcom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryT3&quot;/>&lt;xsl:template name=&quot;T3&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($QueryT3/Record[1]/DATA_REPORT_AGCOM))>0&quot;>&lt;tns:MonitoraggioAgcomT3>&lt;xsl:for-each select=&quot;$QueryT3/Record&quot;>&lt;tns:MonitoraggioAgcomT3ListOut>&lt;tns:dataRif>&lt;xsl:value-of select=&quot;substring(string(DATA_REPORT_AGCOM),1,10)&quot;/>&lt;/tns:dataRif>&lt;xsl:if test=&quot;SUMGCZSCDADACLAGIAC&quot;>&lt;tns:giacenzaScadutaA_DAC_LA_GIAC>&lt;xsl:value-of select=&quot;SUMGCZSCDADACLAGIAC&quot;/>&lt;/tns:giacenzaScadutaA_DAC_LA_GIAC>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMGCZSCDADACLASCAD&quot;>&lt;tns:giacenzaScadutaA_DAC_LA_SCAD>&lt;xsl:value-of select=&quot;SUMGCZSCDADACLASCAD&quot;/>&lt;/tns:giacenzaScadutaA_DAC_LA_SCAD>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMGCZSCDADACLAPERC&quot;>&lt;tns:giacenzaScadutaA_DAC_LA_PERC>&lt;xsl:value-of select=&quot;SUMGCZSCDADACLAPERC&quot;/>&lt;/tns:giacenzaScadutaA_DAC_LA_PERC>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMGCZSCDADACLNAGIAC&quot;>&lt;tns:giacenzaScadutaA_DAC_LNA_GIAC>&lt;xsl:value-of select=&quot;SUMGCZSCDADACLNAGIAC&quot;/>&lt;/tns:giacenzaScadutaA_DAC_LNA_GIAC>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMGCZSCDADACLNASCAD&quot;>&lt;tns:giacenzaScadutaA_DAC_LNA_SCAD>&lt;xsl:value-of select=&quot;SUMGCZSCDADACLNASCAD&quot;/>&lt;/tns:giacenzaScadutaA_DAC_LNA_SCAD>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMGCZSCDADACLNAPERC&quot;>&lt;tns:giacenzaScadutaA_DAC_LNA_PERC>&lt;xsl:value-of select=&quot;SUMGCZSCDADACLNAPERC&quot;/>&lt;/tns:giacenzaScadutaA_DAC_LNA_PERC>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMGCZSCDADACTOTGIAC&quot;>&lt;tns:giacenzaScadutaA_DAC_TOT_GIAC>&lt;xsl:value-of select=&quot;SUMGCZSCD