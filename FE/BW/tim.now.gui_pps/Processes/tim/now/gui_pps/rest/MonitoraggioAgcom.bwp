                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioAgcom&quot; xmlns:tns1=&quot;http://xmlns.example.com/20161123173259PLT/ConceptSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;T2-Dettaglio&quot;/>&#xa;    &lt;xsl:param name=&quot;T2Query&quot;/>&#xa;    &lt;xsl:template name=&quot;T2&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;upper-case($get1.parameters/tns1:flagDettaglio)='Y'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(string($T2-Dettaglio/Record[1]/DATA_REPORT_AGCOM))>0&quot;>&#xa;                        &lt;tns:MonitoraggioAgcomT2>&#xa;                            &lt;xsl:for-each select=&quot;$T2-Dettaglio/Record&quot;>&#xa;                                &lt;tns:MonitoraggioAgcomT2ListOut>&#xa;                                    &lt;tns:OLO>&#xa;                                        &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                    &lt;/tns:OLO>&#xa;                                    &lt;tns:dataRif>&#xa;                                        &lt;xsl:value-of select=&quot;substring(string(DATA_REPORT_AGCOM),1,10)&quot;/>&#xa;                                    &lt;/tns:dataRif>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;xsd:int(NUM_GCZ) = 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;NUM_ENTRO_PRIMA_DAC_SLA_PERC&quot;>&#xa;                                                &lt;tns:giacenzaEntroPrimaDAC_OLO-SLAsuGiacenza>&#xa;                                                