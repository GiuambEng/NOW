                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select to_date(data_report_agcom) data_report_agcom,sum(GCZ_SCDA_DAC_LA_GIAC) AS SUMGCZSCDADACLAGIAC,sum(GCZ_SCDA_DAC_LA_PERC) AS SUMGCZSCDADACLAPERC,sum(GCZ_SCDA_DAC_LA_SCAD) AS SUMGCZSCDADACLASCAD ,sum(GCZ_SCDA_DAC_LNA_GIAC) AS SUMGCZSCDADACLNAGIAC,&#xa;sum(GCZ_SCDA_DAC_LNA_PERC) AS SUMGCZSCDADACLNAPERC,sum(GCZ_SCDA_DAC_LNA_SCAD) AS SUMGCZSCDADACLNASCAD,sum(GCZ_SCDA_DAC_TOT_GIAC) AS SUMGCZSCDADACTOTGIAC,sum(GCZ_SCDA_DAC_TOT_SCAD) AS SUMGCZSCDADACTOTSCAD,&#xa;sum(GCZ_SCDA_DAC_TOT_PERC) AS SUMGCZSCDADACTOTPERC,sum(GCZ_SCDA_SLA_LA_LNA_GIAC) AS SUMGCZSCDASLALALNAGIAC  ,sum(GCZ_SCDA_SLA_LA_LNA_PERC) AS SUMGCZSCDASLALALNAPERC  ,&#xa;sum(GCZ_SCDA_SLA_LA_LNA_SCAD)  AS SUMGCZSCDASLALALNASCAD ,sum(TOT_DAC_E_SLA_GIAC) AS SUMTOTDACESLAGIAC ,sum(TOT_DAC_E_SLA_PERC) AS SUMTOTDACESLAPERC ,sum(TOT_DAC_E_SLA_SCAD) AS SUMTOTDACESLASCAD&#xa; from pps_agcom_aggro ag&#xa; where ag.id_agcom_aggro in  (&#xa;                         select distinct max(id_agcom_aggro)   from (&#xa;                                 select a.id_agcom_aggro,a.data_report_agcom&#xa;                                 from    pps_agcom_aggro a&#xa;                                 where &#xa;                                 to_date(data_report_agcom)  in(TO_DATE(?,'dd-mm-yyyy'),TO_DATE(?,'dd-mm-yyyy')-7, TO_DATE(?,'dd-mm-yyyy')-14,TO_DATE(?,'dd-mm-yyyy')-21,TO_DATE(?,'dd-mm-yyyy')-28,TO_DATE(?,'dd-mm-yyyy')-35)&#xa;                                 group by data_report_agcom,id_agcom_aggro)&#xa;                        group by data_report_agcom)&#xa;                     &#xa;                        group by data_report_agcom, ag.id_agcom_aggro&#xa;                          order by data_report_agcom desc" xsi:type="jdbcPalette:JDBCQueryActivity">

