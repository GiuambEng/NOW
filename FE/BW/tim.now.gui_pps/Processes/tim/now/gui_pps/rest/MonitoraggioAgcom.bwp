                                &lt;xsl:value-of select="'OK'"/&gt;
                            &lt;/tns:esitoExport&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get3/parameters/tns3:monitoraggioagcomT5GetParameters/tns3:flagExport)='Y'"&gt;
