                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://xmlns.example.com/20161123173259PLT" xmlns:tns="http://www.example.org/MonitoraggioAgcom" xmlns:tns2="http://xmlns.example.com/MonitoraggioAgcom/parameters" xmlns:tns3="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="T3"/&gt;
    &lt;xsl:param name="get2"/&gt;
    &lt;xsl:param name="CryptoParams3"/&gt;
    &lt;xsl:template name="getOut2-input" match="/"&gt;
        &lt;tns4:getResponse3&gt;
            &lt;item&gt;
                &lt;tns:MonitoraggioAgcomT3&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get2/parameters/tns2:monitoraggioagcomT5GetParameters/tns2:flagExport)!='Y'"&gt;
                            &lt;xsl:copy-of select="$T3/tns:MonitoraggioAgcomT3ListOut"/&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns:MonitoraggioAgcomT3ListOut/&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:copy-of select="$T3/tns:result"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get2/parameters/tns2:monitoraggioagcomT5GetParameters/tns2:flagExport)='Y'"&gt;
                            &lt;tns:esitoExport&gt;
                                &lt;xsl:value-of select="'OK'"/&gt;
                            &lt;/tns:esitoExport&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get2/parameters/tns2:monitoraggioagcomT5GetParameters/tns2:flagExport)='Y'"&gt;
                            &lt;tns:idFile&gt;
                                &lt;xsl:value-of select="$CryptoParams3/tns3:idFileCriptato"/&gt;
                            &lt;/tns:idFile&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns:MonitoraggioAgcomT3&gt;
            &lt;/item&gt;
        &lt;/tns4:getResponse3&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
