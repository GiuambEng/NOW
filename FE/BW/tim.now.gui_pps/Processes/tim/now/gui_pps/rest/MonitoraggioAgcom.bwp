                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioAgcom&quot; xmlns:tns1=&quot;http://xmlns.example.com/20161123173259PLT/ConceptSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;T1Query&quot;/>&lt;xsl:param name=&quot;T1-Dettaglio&quot;/>&lt;xsl:template name=&quot;T1&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($get/parameters/tns1:monitoraggioagcomGetParameters/tns1:flagDettaglio)='Y'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($T1-Dettaglio/Record[1]/DATA_REPORT_AGCOM)) > 0&quot;>&lt;tns:MonitoraggioAgcomT1>&lt;xsl:for-each select=&quot;$T1-Dettaglio/Record&quot;>&lt;tns:MonitoraggioAgcomT1ListOut>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:OLO>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:OLO>&lt;/xsl:if>&lt;tns:dataRif>&lt;xsl:value-of select=&quot;substring(string(DATA_REPORT_AGCOM),1,10)&quot;/>&lt;/tns:dataRif>&lt;xsl:if test=&quot;LAVORATI&quot;>&lt;tns:lavorati>&lt;xsl:value-of select=&quot;LAVORATI&quot;/>&lt;/tns:lavorati>&lt;/xsl:if>&lt;xsl:if test=&quot;OK&quot;>&lt;tns:OK>&lt;xsl:value-of select=&quot;OK&quot;/>&lt;/tns:OK>&lt;/xsl:if>&lt;xsl:if test=&quot;KO&quot;>&lt;tns:KO>&lt;xsl:value-of select=&quot;KO&quot;/>&lt;/tns:KO>&lt;/xsl:if>&lt;xsl:if test=&quot;GIACENZA&quot;>&lt;tns:giacenza>&lt;xsl:value-of select=&quot;GIACENZA&quot;/>&lt;/tns:giacenza>&lt;/xsl:if>&lt;xsl:if test=&quot;NUM_ENTRO_PRIMA_DAC_SLA&quot;>&lt;tns:entroPrimaDAC_SLA>&lt;xsl:value-of select=&quot;NUM_ENTRO_PRIMA_DAC_SLA&quot;/>&lt;/tns:entroPrimaDAC_SLA>&lt;/xsl:if>&lt;xsl:if test=&quot;NUM_OLTRE_PRIMA_DAC_SLA&quot;>&lt;tns:oltrePrimaDAC_SLA>&lt;xsl:value-of select=&quot;NUM_OLTRE_PRIMA_DAC_SLA&quot;/>&lt;/tn