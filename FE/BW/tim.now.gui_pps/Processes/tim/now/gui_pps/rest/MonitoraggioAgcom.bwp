                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select to_date(data_report_agcom) data_report_agcom,sum( NON_REALZB_DAC_LA_LAV_NR) AS SUMNONREALZBDACLALAVNR,sum(NON_REALZB_DAC_LA_NR) AS SUMNONREALZBDACLANR,sum(NON_REALZB_DAC_LA_PERC) AS SUMNONREALZBDACLAPERC,&#xa;sum(NON_REALZB_DAC_LNA_LAV_NR) AS SUMNONREALZBDACLNALAVNR,sum(NON_REALZB_DAC_LNA_NR) AS SUMNONREALZBDACLNANR,sum(NON_REALZB_DAC_LNA_PERC) AS SUMNONREALZBDACLNAPERC&#xa;,sum(NON_REALZB_SLA_LA_E_LNA_LAV_NR) AS SUMNONREALZBSLALAELNALAVNR,sum(NON_REALZB_SLA_LA_E_LNA_NR) AS SUMNONREALZBSLALAELNANR ,sum(NON_REALZB_SLA_LA_E_LNA_PERC) AS SUMNONREALZBSLALAELNAPERC&#xa; from pps_agcom_aggro ag&#xa; where ag.id_agcom_aggro in  (&#xa;                         select distinct max(id_agcom_aggro)   from (&#xa;                                 select a.id_agcom_aggro,a.data_report_agcom&#xa;                                 from    pps_agcom_aggro a&#xa;                                 where &#xa;                                 to_date(data_report_agcom)  in(TO_DATE(?,'dd-mm-yyyy'),TO_DATE(?,'dd-mm-yyyy')-7, TO_DATE(?,'dd-mm-yyyy')-14,TO_DATE(?,'dd-mm-yyyy')-21,TO_DATE(?,'dd-mm-yyyy')-28,TO_DATE(?,'dd-mm-yyyy')-35)&#xa;                                 group by data_report_agcom,id_agcom_aggro)&#xa;                        group by data_report_agcom)&#xa;                     &#xa;                        group by data_report_agcom, ag.id_agcom_aggro&#xa;                          order by data_report_agcom desc"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

