                                    <bpws:source linkName="EmptyToT1-Dettaglio">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($get/parameters/tns:monitoraggioagcomGetParameters/tns:flagDettaglio)='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
