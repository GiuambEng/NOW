                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioAgcom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryT4&quot;/>&lt;xsl:template name=&quot;T4&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($QueryT4/Record[1]/DATA_REPORT_AGCOM))>0&quot;>&lt;tns:MonitoraggioAgcomT4>&lt;xsl:for-each select=&quot;$QueryT4/Record&quot;>&lt;tns:MonitoraggioAgcomT4ListOut>&lt;tns:dataRif>&lt;xsl:value-of select=&quot;substring(string(DATA_REPORT_AGCOM),1,10)&quot;/>&lt;/tns:dataRif>&lt;xsl:if test=&quot;SUMRIMDZCAUSATILAGIAC&quot;>&lt;tns:rimodulazioniCausaTI_LA_GIAC>&lt;xsl:value-of select=&quot;SUMRIMDZCAUSATILAGIAC&quot;/>&lt;/tns:rimodulazioniCausaTI_LA_GIAC>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMRIMDZCAUSATILARIM&quot;>&lt;tns:rimodulazioniCausaTI_LA_RIM>&lt;xsl:value-of select=&quot;SUMRIMDZCAUSATILARIM&quot;/>&lt;/tns:rimodulazioniCausaTI_LA_RIM>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMRIMDZCAUSATILAPERC&quot;>&lt;tns:rimodulazioniCausaTI_LA_PERC>&lt;xsl:value-of select=&quot;SUMRIMDZCAUSATILAPERC&quot;/>&lt;/tns:rimodulazioniCausaTI_LA_PERC>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMRIMDZCAUSATILNAGIAC&quot;>&lt;tns:rimodulazioniCausaTI_LNA_GIAC>&lt;xsl:value-of select=&quot;SUMRIMDZCAUSATILNAGIAC&quot;/>&lt;/tns:rimodulazioniCausaTI_LNA_GIAC>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMRIMDZCAUSATILNARIM&quot;>&lt;tns:rimodulazioniCausaTI_LNA_RIM>&lt;xsl:value-of select=&quot;SUMRIMDZCAUSATILNARIM&quot;/>&lt;/tns:rimodulazioniCausaTI_LNA_RIM>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMRIMDZCAUSATILNAPERC&quot;>&lt;tns:rimodulazioniCausaTI_LNA_PERC>&lt;xsl:value-of select=&quot;SUMRIMDZCAUSATILNAPERC&quot;/>&lt;/tns:rimodulazioniCausaTI_LNA_PERC>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMRIMDZCAUSATITOTGIAC&quot;>&lt;tns:rimodulazioniCausaTI_TOT_GIAC>&lt;xsl:value-of sele