ONREALZBSLALAELNALAVNR&quot;/>&lt;/tns:nonRealizzabiliSLA_LAeLNA_LAV_NR>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMNONREALZBSLALAELNANR&quot;>&lt;tns:nonRealizzabiliSLA_LAeLNA_NR>&lt;xsl:value-of select=&quot;SUMNONREALZBSLALAELNANR&quot;/>&lt;/tns:nonRealizzabiliSLA_LAeLNA_NR>&lt;/xsl:if>&lt;xsl:if test=&quot;SUMNONREALZBSLALAELNAPERC&quot;>&lt;tns:nonRealizzabiliSLA_LAeLNA_PERC>&lt;xsl:value-of select=&quot;SUMNONREALZBSLALAELNAPERC&quot;/>&lt;/tns:nonRealizzabiliSLA_LAeLNA_PERC>&lt;/xsl:if>&lt;/tns:MonitoraggioAgcomT5ListOut>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:MonitoraggioAgcomT5>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MonitoraggioAgcomT5>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'NESSUN DATO TROVATO'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:MonitoraggioAgcomT5>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
