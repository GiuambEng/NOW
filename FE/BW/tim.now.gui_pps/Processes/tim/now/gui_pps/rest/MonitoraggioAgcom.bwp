                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/MonitoraggioAgcom&quot; xmlns:tns1=&quot;http://xmlns.example.com/20161123173259PLT/ConceptSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:param name=&quot;T2-Dettaglio&quot;/>&lt;xsl:param name=&quot;T2Query&quot;/>&lt;xsl:template name=&quot;T2&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($get1/parameters/tns1:monitoraggioagcomGetParameters/tns1:flagDettaglio)='Y'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($T2-Dettaglio/Record[1]/DATA_REPORT_AGCOM))>0&quot;>&lt;tns:MonitoraggioAgcomT2>&lt;xsl:for-each select=&quot;$T2-Dettaglio/Record&quot;>&lt;tns:MonitoraggioAgcomT2ListOut>&lt;tns:OLO>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:OLO>&lt;tns:dataRif>&lt;xsl:value-of select=&quot;substring(string(DATA_REPORT_AGCOM),1,10)&quot;/>&lt;/tns:dataRif>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(NUM_GCZ) = 0&quot;>&lt;xsl:if test=&quot;NUM_ENTRO_PRIMA_DAC_SLA_PERC&quot;>&lt;tns:giacenzaEntroPrimaDAC_OLO-SLAsuGiacenza>&lt;xsl:value-of select=&quot;NUM_ENTRO_PRIMA_DAC_SLA_PERC&quot;/>&lt;/tns:giacenzaEntroPrimaDAC_OLO-SLAsuGiacenza>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:giacenzaEntroPrimaDAC_OLO-SLAsuGiacenza>&lt;xsl:value-of select=&quot;round-half-to-even((NUM_ENTRO_PRIMA_DAC_SLA_PERC div NUM_GCZ),2)&quot;/>&lt;/tns:giacenzaEntroPrimaDAC_OLO-SLAsuGiacenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(NUM_GCZ) = 0&quot;>&lt;xsl:if test=&quot;NUM_OLTRE_PRIMA_DAC_SLA_PERC&quot;>&lt;tns:giacenzaOltrePrimaDAC_OLO-SLAsuGiacenza>&lt;xsl:value-of select=&quot;NUM_OLTRE_PRIMA_DAC_SLA_PERC&quot;/>&lt;/tns:giacenzaOltrePrimaDAC_OLO-SLAsuGiacenza>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:giacenzaOltrePrimaDAC_OLO-SLAsuGiacenza>&lt;xsl:value-of select=&quot;round-half-to-even((NUM_OLTRE_PRIMA_DAC_SLA_PERC div NUM_GCZ),2)&quot;/>&lt;/tns:giacenzaOltrePrimaDAC_OLO-SLAsuGiacenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(NUM_GCZ) = 0&quot;>&lt;xsl:if test=&quot;DI_CUI_GCZ_RIMODULATA_PERC&quot;>&lt;tns:giacenzaRimodulataSuGiacenza>&lt;xsl:value-of select=&quot;DI_CUI_GCZ_RIMODULATA_PERC&quot;/>&lt;/tns:giacenzaRimodulataSuGiacenza>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:giacenzaRimodulataSuGiacenza>&lt;xsl:value-of select=&quot;round-half-to-even((DI_CUI_GCZ_RIMODULATA_PERC div NUM_GCZ),2)&quot;/>&lt;/tns:giacenzaRimodulataSuGiacenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(NUM_GCZ) = 0&quot;>&lt;xsl:if test=&quot;DI_CUI_GCZ_A_DAC_SCADUTA_PERC&quot;>&lt;tns:giacenzaA_DACScadutaSuGiacenza>&lt;xsl:value-of select=&quot;DI_CUI_GCZ_A_DAC_SCADUTA_PERC&quot;/>&lt;/tns:giacenzaA_DACScadutaSuGiacenza>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:giacenzaA_DACScadutaSuGiacenza>&lt;xsl:value-of select=&quot;round-half-to-even((DI_CUI_GCZ_A_DAC_SCADUTA_PERC div NUM_GCZ),2)&quot;/>&lt;/tns:giacenzaA_DACScadutaSuGiacenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(NUM_GCZ) = 0&quot;>&lt;xsl:if test=&quot;GCZ_SCADUTA_TOT_SU_GCZ_PERC&quot;>&lt;tns:giacenzaScadutaTotSuGiacenza>&lt;xsl:value-of select=&quot;GCZ_SCADUTA_TOT_SU_GCZ_PERC&quot;/>&lt;/tns:giacenzaScadutaTotSuGiacenza>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:giacenzaScadutaTotSuGiacenza>&lt;xsl:value-of select=&quot;round-half-to-even((GCZ_SCADUTA_TOT_SU_GCZ_PERC div NUM_GCZ),2)&quot;/>&lt;/tns:giacenzaScadutaTotSuGiacenza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(NUM_LAVORATI) = 0&quot;>&lt;xsl:if test=&quot;PERCKO&quot;>&lt;tns:koSuLavorati>&lt;xsl:value-of select=&quot;PERCK