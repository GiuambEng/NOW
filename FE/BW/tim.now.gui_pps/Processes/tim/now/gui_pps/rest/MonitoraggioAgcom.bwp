      &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:MonitoraggioAgcomT2>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:MonitoraggioAgcomT2>&#xa;                            &lt;tns:MonitoraggioAgcomT2ListOut>&#xa;                                &lt;tns:OLO>&#xa;                                    &lt;xsl:value-of select=&quot;'olo'&quot;/>&#xa;                                &lt;/tns:OLO>&#xa;                            &lt;/tns:MonitoraggioAgcomT2ListOut>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:code>&#xa;                                &lt;tns:details>&#xa;                                    &lt;xsl:value-of select=&quot;'NESSUN RISULTATO TROVATO'&quot;/>&#xa;                                &lt;/tns:details>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:MonitoraggioAgcomT2>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(string($T2Query/Record[1]/DATA_REPORT_AGCOM))>0&quot;>&#xa;                        &lt;tns:Monit