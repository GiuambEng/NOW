                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fd40531d-f721-4223-91fb-cad9415483ca+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/20161123173259PLT/ConceptSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;T1Query-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;Parameter>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:dataEstrazione&quot;/>&#xa;            &lt;/Parameter>&#xa;            &lt;Parameter1>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:dataEstrazione&quot;/>&#xa;            &lt;/Parameter1>&#xa;            &lt;Parameter2>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:dataEstrazione&quot;/>&#xa;            &lt;/Parameter2>&#xa;            &lt;Parameter3>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:dataEstrazione&quot;/>&#xa;            &lt;/Parameter3>&#xa;            &lt;Parameter4>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:dataEstrazione&quot;/>&#xa;            &lt;/Parameter4>&#xa;            &lt;Parameter5>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:dataEstrazione&quot;/>&#xa;            &lt;/Parameter5>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select   to_date(data_report_agcom) data_report_agcom, sum(num_lavorati)  lavorati, cast (sum(num_ok) as integer) OK ,sum(num_ko) KO ,sum(ag.num_gcz) giacenza,&#xd;&#xa;sum( NUM_ENTRO_PRIMA_DAC_SLA) NUM_ENTRO_PRIMA_DAC_SLA ,   sum( NUM_OLTRE_PRIMA_DAC_SLA)NUM_OLTRE_PRIMA_DAC_SLA&#xd;&#xa; ,sum(DI_CUI_GCZ_RIMODULATA) DI_CUI_GCZ_RIMODULATA,sum (DI_CUI_FUORI_SLA) DI_CUI_FUORI_SLA ,&#xd;&#xa; sum(DI_CUI_GCZ_A_DAC_SCADUTA)  DI_CUI_GCZ_A_DAC_SCADUTA, &#xd;&#xa; sum (GCZ_SCADUTA_TOT_DAC_E_SLA) GCZ_SCADUTA_TOT_DAC_E_SLA, &#xd;&#xa; sum(GCZ_SCADUTA_TOT_SU_GCZ) GCZ_SCADUTA_TOT_SU_GCZ,ag.id_agcom_aggro&#xd;&#xa;&#xd;&#xa; from &#xd;&#xa;pps_agcom_aggro ag&#xd;&#xa;where id_agcom_aggro  in (&#xd;&#xa;                         select distinct max(id_agcom_aggro)   from (&#xd;&#xa;                                 select a.id_agcom_aggro,a.data_report_agcom&#xd;&#xa;                                 from    pps_agcom_aggro a&#xd;&#xa;                                 where &#xd;&#xa;                                 trunc(to_date(data_report_agcom))  in(TO_DATE(?,'dd-mm-yyyy'),TO_DATE(?,'dd-mm-yyyy')-7, TO_DATE(?,'dd-mm-yyyy')-14,TO_DATE(?,'dd-mm-yyyy')-21,TO_DATE(?,'dd-mm-yyyy')-28,TO_DATE(?,'dd-mm-yyyy')-35)&#xd;&#xa;                                 group by data_report_agcom,id_agcom_aggro)&#xd;&#xa;                        group by data_report_agcom)&#xd;&#xa;                     &#xd;&#xa;                        group by data_report_agcom, ag.id_agcom_aggro&#xd;&#xa;                        order by data_report_agcom desc&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

