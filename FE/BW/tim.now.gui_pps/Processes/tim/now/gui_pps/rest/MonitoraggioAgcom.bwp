                                    expression="exists($get1/parameters/tns:monitoraggioagcomGetParameters/tns:flagExport) and upper-case($get1/parameters/tns:monitoraggioagcomGetParameters/tns:flagExport)='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
