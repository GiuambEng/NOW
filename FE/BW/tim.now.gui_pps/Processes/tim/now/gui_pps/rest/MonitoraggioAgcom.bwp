    &lt;xsl:template name="getOut1-input" match="/"&gt;
        &lt;tns4:getResponse2&gt;
            &lt;item&gt;
                &lt;tns:MonitoraggioAgcomT2&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get1/parameters/tns2:monitoraggioagcomGetParameters/tns2:flagExport)!='Y'"&gt;
                            &lt;xsl:copy-of select="$T2/tns:MonitoraggioAgcomT2ListOut"/&gt;
                        &lt;/xsl:when&gt;
