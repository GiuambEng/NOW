    &lt;xsl:param name="get3"/&gt;
    &lt;xsl:param name="CryptoParams4"/&gt;
    &lt;xsl:template name="getOut3-input" match="/"&gt;
        &lt;tns4:getResponse4&gt;
            &lt;item&gt;
                &lt;tns:MonitoraggioAgcomT4&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get3/parameters/tns3:monitoraggioagcomT5GetParameters/tns3:flagExport)!='Y'"&gt;
                            &lt;xsl:copy-of select="$T4/tns:MonitoraggioAgcomT4ListOut"/&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
