        &lt;xsl:value-of select=&quot;'MonitoraggioAgcomT1'&quot;/>&#xa;            &lt;/tns2:rootElementParameter>&#xa;            &lt;tns2:nameOfFile>&#xa;                &lt;xsl:value-of select=&quot;'MonitoraggioAgcomT1'&quot;/>&#xa;            &lt;/tns2:nameOfFile>&#xa;            &lt;tns2:childRootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioAgcomT1ListOut&amp;quot;&quot;/>&#xa;            &lt;/tns2:childRootElement>&#xa;            &lt;tns2:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($QueryExport/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns2:idFile>&#xa;            &lt;xsl:if test=&quot;$get/parameters/tns1:monitoraggioagcomGetParameters/tns1:tipoProfilo&quot;>&#xa;                &lt;tns2:tipoProfilo>&#xa;                    &lt;xsl:value-of select=&quot;$get/parameters/tns1:monitoraggioagcomGetParameters/tns1:tipoProfilo&quot;/>&#xa;                &lt;/tns2:tipoProfilo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$get/parameters/tns1:monitoraggioagcomGetParameters/tns1:userId&quot;>&#xa;                &lt;tns2:userId>&#xa;                    &lt;xsl:value-of select=&quot;$get/parameters/tns1:monitoraggioagcomGetParameters/tns1:userId&quot;/>&#xa;                &lt;/tns2:userId>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:inputExportDati>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
