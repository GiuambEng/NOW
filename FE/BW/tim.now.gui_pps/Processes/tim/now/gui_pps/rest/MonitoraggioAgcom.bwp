&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://xmlns.example.com/20161123173259PLT" xmlns:tns="http://www.example.org/MonitoraggioAgcom" xmlns:tns3="http://xmlns.example.com/MonitoraggioAgcom/parameters" xmlns:tns2="http://www.example.org/CryptoParams" version="2.0"&gt;
