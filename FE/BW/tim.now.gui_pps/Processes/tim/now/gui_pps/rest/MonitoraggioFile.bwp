                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1475053350991&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;famigliaOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;statoFileNow&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryMonitorAgg&quot;/>&#xa;    &lt;xsl:param name=&quot;dataAcquisizione&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElementData&quot;/>&#xa;    &lt;xsl:template name=&quot;outputCanaleAcq&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Element>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$statoFileNow='ELABORATO'&quot;>&#xa;                    &lt;tns1:tot>&#xa;                        &lt;xsl:value-of select=&quot;if(exists($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and  OWNER='NOW' ]/TOT)) then xsd:integer($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and  OWNER='NOW' ]/TOT) else 0&quot;/>&#xa;                    &lt;/tns1:tot>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$statoFileNow='SCADUTO'&quot;>&#xa;                    &lt;tns1:tot>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow]/TOT)&quot;/>&#xa;                    &lt;/tns1:tot>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:tot>&#xa;                        &lt;xsl:value-of select=&quot;if (exists($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and  OWNER='GENERICOWNER' and CANALE_ACQUISIZIONE = &amp;quot;GUI&amp;quot;]/TOT) and exists($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and OWNER='GENERICOWNER' and CANALE_ACQUISIZIONE = &amp;quot;FTP&amp;quot;]/TOT)) then xsd:int($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and OWNER='GENERICOWNER' and CANALE_ACQUISIZIONE = &amp;quot;GUI&amp;quot;]/TOT) + xsd:int($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and OWNER='GENERICOWNER' and CANALE_ACQUISIZIONE = &amp;quot;FTP&amp;quot;]/TOT) else if (exists($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and OWNER='GENERICOWNER' and CANALE_ACQUISIZIONE = &amp;quot;GUI&amp;quot;]/TOT)) then xsd:int($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and OWNER='GENERICOWNER' and CANALE_ACQUISIZIONE = &amp;quot;GUI&amp;quot;]/TOT) else if (exists($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and OWNER='GENERICOWNER' and CANALE_ACQUISIZIONE = &amp;quot;FTP&amp;quot;]/TOT)) then xsd:int($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and STATO_FILE_NOW = $statoFileNow and OWNER='GENERICOWNER' and CANALE_ACQUISIZIONE = &amp;quot;FTP&amp;quot;]/TOT) else 0&quot;/>&#xa;                    &lt;/tns1:tot>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl: