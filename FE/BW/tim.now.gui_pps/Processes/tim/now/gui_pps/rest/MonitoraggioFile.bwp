                        &lt;InElaborazione_sftp&gt;
                            &lt;xsl:value-of select="$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_FILE_IN_ELABORAZIONE_GUI']/column[name='VALORE_SOGLIA']/value"/&gt;
                        &lt;/InElaborazione_sftp&gt;
                        &lt;Scartati_tot&gt;
