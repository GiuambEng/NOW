                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/cmf.exportDati&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioFile/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdFile&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;ExportDati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputExportDati>&#xa;            &lt;tns2:xmlParameter>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns2:xmlParameter>&#xa;            &lt;tns2:listOfElements>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;data_acquisizione,data_estrazione,id_file_procsto,nome_file,ambito_file,owner,descr_stato_file,sorgente,descrizione_interfaccia,quant_ordini_file,quant_ordini_crmws,quant_errati_now,quant_ordini_corretti_now,quant_ordini_ko_cautelare_now,quant_ordini_task_utente,quant_ordini_dbcfx,quant_ordini_sdr&amp;quot;&quot;/>&#xa;            &lt;/tns2:listOfElements>&#xa;            &lt;tns2:rootElementParameter>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;monitoraggioFileDD1_output&amp;quot;&quot;/>&#xa;            &lt;/tns2:rootElementParameter>&#xa;            &lt;tns2:nameOfFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioFile&amp;quot;&quot;/>&#xa;            &lt;/tns2:nameOfFile>&#xa;            &lt;tns2:childRootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioFiledd1&amp;quot;&quot;/>&#xa;            &lt;/tns2:childRootElement>&#xa;            &lt;tns2:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($IdFile/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns2:idFile>&#xa;            &lt;xsl:if test=&quot;$post/parameters/tns1:monitoraggiofile-dd1PostParameters/tns1:tipoProfilo&quot;>&#xa;                &lt;tns2:tipoProfilo>&#xa;                    &lt;xsl:value-of select=&quot;$post/parameters/tns1:monitoraggiofile-dd1PostParameters/tns1:tipoProfilo&quot;/>&#xa;                &lt;/tns2:tipoProfilo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post/parameters/tns1:monitoraggiofile-dd1PostParameters/tns1:userId&quot;>&#xa;                &lt;tns2:userId>&#xa;                    &lt;xsl:value-of select=&quot;$post/parameters/tns1:monitoraggiofile-dd1PostParameters/tns1:userId&quot;/>&#xa;                &lt;/tns2:userId>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:inputExportDati>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
