laborati>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Elaborati/crmws&quot;>&#xa;                        &lt;CRMWS_Elaborati>&#xa;                            &lt;xsl:value-of select=&quot;Elaborati/crmws&quot;/>&#xa;                        &lt;/CRMWS_Elaborati>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Elaborati/sdr&quot;>&#xa;                        &lt;SDR_Elaborati>&#xa;                            &lt;xsl:value-of select=&quot;Elaborati/sdr&quot;/>&#xa;                        &lt;/SDR_Elaborati>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Elaborati/dbcfx&quot;>&#xa;                        &lt;DBCFX_Elaborati>&#xa;                            &lt;xsl:value-of select=&quot;Elaborati/dbcfx&quot;/>&#xa;                        &lt;/DBCFX_Elaborati>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Elaborati/now&quot;>&#xa;                        &lt;NOW_Elaborati>&#xa;                            &lt;xsl:value-of select=&quot;Elaborati/now&quot;/>&#xa;                        &lt;/NOW_Elaborati>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Acquisiti/tot&quot;>&#xa;                        &lt;TOTALE_Acquisiti>&#xa;                            &lt;xsl:value-of select=&quot;Acquisiti/tot&quot;/>&#xa;                        &lt;/TOTALE_Acquisiti>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Acquisiti/sftp&quot;>&#xa;                        &lt;FTP_Acquisiti>&#xa;                            &lt;xsl:value-of select=&quot;Acquisiti/sftp&quot;/>&#xa;                        &lt;/FTP_Acquisiti>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Acquisiti/gui&quot;>&#xa;                        &lt;GUI_Acquisiti>&#xa;                            &lt;xsl:value-of select=&quot;Acquisiti/gui&quot;/>&#xa;                        &lt;/