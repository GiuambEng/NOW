                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="QueryMonitorAgg-input"
                                    name="QueryMonitorAgg"
                                    outputVariable="QueryMonitorAgg"
                                    tibex:xpdlId="0728fb1b-0e2b-4c08-9404-bf7452455a8d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InfoMonFileLogToQueryMonitorAgg1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="QueryMonitorAggToSQLSoglia"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0728fb1b-0e2b-4c08-9404-bf7452455a8d+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement=" SELECT               &#xa;DESCR_FAMIG_OFFERTA , STATO_FILE_NOW,  CANALE_ACQUISIZIONE,  DATA_ACQUISIZIONE , 'GENERICOWNER' as OWNER, SUM(TOT) TOT&#xa;FROM PPS_MONITG_FILE_OLO_AGGRI &#xa;WHERE &#xa; DATA_ACQUISIZIONE >= (sysdate -11) and &#xa;   &#xa;      STATO_FILE_NOW IN ( 'IN ELABORAZIONE','SCARTATO')&#xa;        AND &#xa;        CANALE_ACQUISIZIONE IN ('FTP','GUI')&#xa;       &#xa;      &#xa;AND &#xa;TIMSTP = (SELECT MAX(TIMSTP) FROM PPS_MONITG_FILE_OLO_AGGRI)&#xa; GROUP BY DESCR_FAMIG_OFFERTA,STATO_FILE_NOW, CANALE_ACQUISIZIONE, DATA_ACQUISIZIONE,'GENERICOWNER' &#xa; &#xa; union&#xa;( SELECT               &#xa;DESCR_FAMIG_OFFERTA , STATO_FILE_NOW, 'ALTRO',  DATA_ACQUISIZIONE , OWNER, SUM(TOT) TOT&#xa;FROM PPS_MONITG_FILE_OLO_AGGRI &#xa;WHERE &#xa; DATA_ACQUISIZIONE >= (sysdate -11) and &#xa;STATO_FILE_NOW IN ('ELABORATO')&#xa; and owner in ('CRMWS','SDR','DBCFX','NOW')&#xa;AND &#xa;TIMSTP = (SELECT MAX(TIMSTP) FROM PPS_MONITG_FILE_OLO_AGGRI)&#xa; GROUP BY DESCR_FAMIG_OFFERTA,STATO_FILE_NOW , DATA_ACQUISIZIONE,OWNER&#xa;)&#xa;  &#xa;&#xa; union&#xa; &#xa;( SELECT               &#xa;DESCR_FAMIG_OFFERTA , STATO_FILE_NOW, 'ALTRO',  DATA_ACQUISIZIONE , 'GENERICOWNER' as OWNER, SUM(TOT) TOT&#xa;FROM PPS_MONITG_FILE_OLO_AGGRI &#xa;WHERE &#xa; DATA_ACQUISIZIONE >= (sysdate -11) and &#xa;STATO_FILE_NOW IN ('SCADUTO')&#xa;and &#xa;  CANALE_ACQUISIZIONE IN ('FTP','GUI')&#xa;  &#xa; and  &#xa;TIMSTP = (SELECT MAX(TIMSTP) FROM PPS_MONITG_FILE_OLO_AGGRI)&#xa; GROUP BY DESCR_FAMIG_OFFERTA,STATO_FILE_NOW , DATA_ACQUISIZIONE &#xa; ) &#xa;&#xa;union&#xa;&#xa; SELECT               &#xa;DESCR_FAMIG_OFFERTA , 'ACQUISITO',  CANALE_ACQUISIZIONE,  DATA_ACQUISIZIONE , 'GENERICOWNER' as OWNER, SUM(TOT) TOT&#xa;FROM PPS_MONITG_FILE_OLO_AGGRI &#xa;WHERE &#xa; DATA_ACQUISIZIONE >= (sysdate -11) and &#xa;   &#xa;        CANALE_ACQUISIZIONE IN ('FTP','GUI')&#xa;    &#xa;AND &#xa;TIMSTP = (SELECT MAX(TIMSTP) FROM PPS_MONITG_FILE_OLO_AGGRI)&#xa; GROUP BY DESCR_FAMIG_OFFERTA, CANALE_ACQUISIZIONE, DATA_ACQUISIZIONE,'GENERICOWNER' &#xa; &#xa;ORDER BY     DESCR_FAMIG_OFFERTA ,  DATA_ACQUISIZIONE DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="DESCR_FAMIG_OFFERTA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_FILE_NOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CANALE_ACQUISIZIONE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_ACQUISIZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="OWNER"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
