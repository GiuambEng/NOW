                    &lt;/soglia&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($get/parameters/tns2:monitoraggiofileGetParameters/tns2:flagExport) and upper-case($get/parameters/tns2:monitoraggiofileGetParameters/tns2:flagExport)='Y'"&gt;
