                                portType="ns:monitoraggiofiledd2"
                                tibex:xpdlId="7a7fe4c5-a889-41fd-867c-7e2d6f854a6a" variable="getOut1-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160927164418PLT" version="2.0"&gt;
    &lt;xsl:param name="MapperDD2"/&gt;
    &lt;xsl:template name="getOut1-input" match="/"&gt;
        &lt;tns2:getResponse1&gt;
            &lt;item&gt;
                &lt;xsl:copy-of select="$MapperDD2"/&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse1&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160927164418PLT&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperDD2&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut1-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$MapperDD2&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess2TogetOut1"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if(upper-case($get1/parameters/tns:monitoraggiofiledd2GetParameters/tns:tipoContatore)=upper-case('quantitaOrdiniCorrettiNow'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='NOW' and statorichiestanow not in ('ELABORATO','SCARTATO','LAVORAZIONE_HD') &quot;&#xd;&#xa;else&#xd;&#xa;if(upper-case($get1/parameters/tns:monitoraggiofiledd2GetParameters/tns:tipoContatore)=upper-case('quantitaOrdiniCrmws'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='CRMWS'&quot;&#xd;&#xa;else if(upper-case($get1/parameters/tns:monitoraggiofiledd2GetParameters/tns:tipoContatore)=upper-case('quantitaOrdiniSdr'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='SDR'&quot;  else  if(upper-case($get1/parameters/tns:monitoraggiofiledd2GetParameters/tns:tipoContatore)=upper-case('quantitaOrdiniDbcfx'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='DBCFX'&quot;  else&#xd;&#xa;if(upper-case($get1/parameters/tns:monitoraggiofiledd2GetParameters/tns:tipoContatore)=upper-case('quantitaOrdiniErratiNow'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='NOW' and statorichiestanow ='SCARTATO' &quot;&#xd;&#xa;else&#xd;&#xa;if(upper-case($get1/parameters/tns:monitoraggiofiledd2GetParameters/tns:tipoContatore)=upper-case('quantitaOrdiniFile'))&#xd;&#xa;then  &quot;&quot;&#xd;&#xa;else&#xd;&#xa;if(upper-case($get1/parameters/tns:monitoraggiofiledd2GetParameters/tns:tipoContatore)=upper-case('quantitaOrdiniKoCautelareNow'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='NOW' and statorichiestanow ='LAVORAZIONE_HD' &quot;&#xd;&#xa;else&#xd;&#xa;&quot;&quot;"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="tipoContatore"
                                    name="tipoContatore"
                                    outputVariable="tipoContatore"
                                    tibex:xpdlId="218096d0-ffc2-4ff3-a034-5d87e02af4f4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess3TotipoContatore"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="tipoContatoreToSQLDirect">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if(upper-case($get1.parameters/tns:tipoContatore)=upper-case('quantitaOrdiniCorrettiNow'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='NOW' and statorichiestanow not in ('ELABORATO','SCARTATO','LAVORAZIONE_HD') &quot;&#xd;&#xa;else&#xd;&#xa;if(upper-case($get1.parameters/tns:tipoContatore)=upper-case('quantitaOrdiniCrmws'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='CRMWS'&quot;&#xd;&#xa;else if(upper-case($get1.parameters/tns:tipoContatore)=upper-case('quantitaOrdiniSdr'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='SDR'&quot;  else  if(upper-case($get1.parameters/tns:tipoContatore)=upper-case('quantitaOrdiniDbcfx'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='DBCFX'&quot;  else&#xd;&#xa;if(upper-case($get1.parameters/tns:tipoContatore)=upper-case('quantitaOrdiniErratiNow'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='NOW' and statorichiestanow ='SCARTATO' &quot;&#xd;&#xa;else&#xd;&#xa;if(upper-case($get1.parameters/tns:tipoContatore)=upper-case('quantitaOrdiniFile'))&#xd;&#xa;then  &quot;&quot;&#xd;&#xa;else&#xd;&#xa;if(upper-case($get1.parameters/tns:tipoContatore)=upper-case('quantitaOrdiniKoCautelareNow'))&#xd;&#xa;then&#xd;&#xa;&quot;and ambito='NOW' and statorichiestanow ='LAVORAZIONE_HD' &quot;&#xd;&#xa;else&#xd;&#xa;&quot;&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="tipoContatore" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+17feb619-02e8-4473-b7a9-f412047539e5+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioFile/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;tipoContatore&quot;/>&#xa;    &lt;xsl:param name=&quot;get1&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirectDD2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($get1/parameters/tns1:monitoraggiofiledd2GetParameters/tns1:idFileProcessato)=upper-case('quantitaOrdiniTaskUtente')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT  A.IDRICHIESTAOLO,A.DATAINVIORICHIESTA,A.CODIFICAOLOAGCOM,A.CODIFICAOLONOW,A.CODICEORDINEOLO, A.STATORICHIESTANOW,A.STATORICHIESTAOLO,A.DRO,A.IDRISORSA,A.OFFERTA , FO.DESCR DESCRFAMOFFERTA   FROM BDS_1_CASEDATA_RICHIESTA A    LEFT JOIN  LAVRZ_MANUALE_STORICO L ON L.ID_RICH_OLO=A.IDRICHIESTAOLO LEFT JOIN  OFFERTA O ON A.IDOFFERTA=O.ID_OFFERTA   LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA=O.ID_FAMIG_OFFERTA   WHERE  AMBITO='NOW' AND L.TIPOLG_KO IN ('ERRATO','IMPROPRIO') AND L.AZIONE IS NULL    AND L.DATA_SBLOCCO_UTENTE IS NULL    AND  A.IDFILEINPUT=' &amp;quot;, $get1/parameters/tns1:monitoraggiofiledd2GetParameters/tns1:idFileProcessato,&amp;quot;'&amp;quot; )&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT  A.IDRICHIESTAOLO,A.DATAINVIORICHIESTA,A.CODIFICAOLOAGCOM,A.CODIFICAOLONOW,A.CODICEORDINEOLO,  A.STATORICHIESTANOW,A.STATORICHIESTAOLO,A.DRO,A.IDRISORSA,A.OFFERTA , FO.DESCR DESCRFAMOFFERTA   FROM  BDS_1_CASEDATA_RICHIESTA A    LEFT JOIN  LAVRZ_MANUALE_STORICO L ON L.ID_RICH_OLO=A.IDRICHIESTAOLO LEFT JOIN  OFFERTA O ON A.IDOFFERTA=O.ID_OFFERTA  LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA=O.ID_FAMIG_OFFERTA  WHERE  A.IDFILEINPUT='&amp;quot;,$get1/parameters/tns1:monitoraggiofiledd2GetParameters/tns1:idFileProcessato,&amp;quot;' &amp;quot;,$tipoContatore)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SQLDirectDD2-input"
                                    name="SQLDirectDD2"
                                    outputVariable="SQLDirectDD2"
                                    tibex:xpdlId="17feb619-02e8-4473-b7a9-f412047539e5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="tipoContatoreToSQLDirect"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SQLDirectDD2ToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+17feb619-02e8-4473-b7a9-f412047539e5+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/MonitoraggioFile/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;tipoContatore&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirectDD2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($get1.parameters/tns1:idFileProcessato)=upper-case('quantitaOrdiniTaskUtente')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT  A.IDRICHIESTAOLO,A.DATAINVIORICHIESTA,A.CODIFICAOLOAGCOM,A.CODIFICAOLONOW,A.CODICEORDINEOLO, A.STATORICHIESTANOW,A.STATORICHIESTAOLO,A.DRO,A.IDRISORSA,A.OFFERTA , FO.DESCR DESCRFAMOFFERTA   FROM BDS_1_CASEDATA_RICHIESTA A    LEFT JOIN  LAVRZ_MANUALE_STORICO L ON L.ID_RICH_OLO=A.IDRICHIESTAOLO LEFT JOIN  OFFERTA O ON A.IDOFFERTA=O.ID_OFFERTA   LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA=O.ID_FAMIG_OFFERTA   WHERE  AMBITO='NOW' AND L.TIPOLG_KO IN ('ERRATO','IMPROPRIO') AND L.AZIONE IS NULL    AND L.DATA_SBLOCCO_UTENTE IS NULL    AND  A.IDFILEINPUT=' &amp;quot;, $get1.parameters/tns1:idFileProcessato,&amp;quot;'&amp;quot; )&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT  A.IDRICHIESTAOLO,A.DATAINVIORICHIESTA,A.CODIFICAOLOAGCOM,A.CODIFICAOLONOW,A.CODICEORDINEOLO,  A.STATORICHIESTANOW,A.STATORICHIESTAOLO,A.DRO,A.IDRISORSA,A.OFFERTA , FO.DESCR DESCRFAMOFFERTA   FROM  BDS_1_CASEDATA_RICHIESTA A    LEFT JOIN  LAVRZ_MANUALE_STORICO L ON L.ID_RICH_OLO=A.IDRICHIESTAOLO LEFT JOIN  OFFERTA O ON A.IDOFFERTA=O.ID_OFFERTA  LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA=O.ID_FAMIG_OFFERTA  WHERE  A.IDFILEINPUT='&amp;quot;,$get1.parameters/tns1:idFileProcessato,&amp;quot;' &amp;quot;,$tipoContatore)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
