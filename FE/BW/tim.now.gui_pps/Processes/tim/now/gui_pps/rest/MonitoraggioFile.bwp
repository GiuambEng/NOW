                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1475145485547&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirectDD2&quot;/>&lt;xsl:template name=&quot;MapperDD2-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SQLDirectDD2/unknownResultset/row/column[name='CODICEORDINEOLO']/value) and $SQLDirectDD2/unknownResultset/row/column[name='CODICEORDINEOLO']/value!=''&amp;#xD;&amp;#xA;&quot;>&lt;tns:monitoraggioFileDD2_output>&lt;tns:monitoraggiodd2>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='DATAINVIORICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='DATAINVIORICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='DATAINVIORICHIESTA']/value)&quot;>&lt;tns:dataCreazioneRichiesta>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='DATAINVIORICHIESTA']/value&quot;/>&lt;/tns:dataCreazioneRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='CODIFICAOLOAGCOM']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='CODIFICAOLOAGCOM']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='CODIFICAOLOAGCOM']/value&amp;#xD;&amp;#xA;)&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='CODIFICAOLOAGCOM']/value&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='CODIFICAOLONOW']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='CODIFICAOLONOW']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='CODIFICAOLONOW']/value&amp;#xD;&amp;#xA;)&quot;>&lt;tns:codiceOAO>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='CODIFICAOLONOW']/value&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:codiceOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='CODICEORDINEOLO']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='CODICEORDINEOLO']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='CODICEORDINEOLO']/value&amp;#xD;&amp;#xA;)&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='CODICEORDINEOLO']/value&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='STATORICHIESTANOW']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='STATORICHIESTANOW']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='STATORICHIESTANOW']/value&amp;#xD;&amp;#xA;)&quot;>&lt;tns:statoNOW>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='STATORICHIESTANOW']/value&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:statoNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='STATORICHIESTAOLO']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='STATORICHIESTAOLO']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='STATORICHIESTAOLO']/value&amp;#xD;&amp;#xA;)&quot;>&lt;tns:statoOLO>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='STATORICHIESTAOLO']/value&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:statoOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='DRO']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='DRO']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='DRO']/value&amp;#xD;&amp;#xA;)&quot;>&lt;tns:DRO>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='DRO']/value&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:DRO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='IDRISORSA']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='IDRISORSA']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='IDRISORSA']/value&amp;#xD;&amp;#xA;)&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='IDRISORSA']/value&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='DESCRFAMOFFERTA']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='DESCRFAMOFFERTA']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='DESCRFAMOFFERTA']/value&amp;#xD;&amp;#xA;)&quot;>&lt;tns:ambito>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='DESCRFAMOFFERTA']/value&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:ambito>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='OFFERTA']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='OFFERTA']/value&amp;#xD;&amp;#xA;/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='OFFERTA']/value&amp;#xD;&amp;#xA;)&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='OFFERTA']/value&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($SQLDirectDD2/unknownResultset/row/column[name='IDRICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirectDD2/unknownResultset/row/column[name='IDRICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirectDD2/unknownResultset/row/column[name='IDRICHIESTAOLO']/value)&quot;>&lt;tns:idRichiesta>&lt;xsl:value-of select=&quot;$SQLDirectDD2/unknownResultset/row/column[name='IDRICHIESTAOLO']/value&quot;/>&lt;/tns:idRichiesta>&lt;/xsl:if>&lt;/tns:monitoraggiodd2>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:monitoraggioFileDD2_output>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:monitoraggioFileDD2_output>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:monitoraggioFileDD2_output>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
