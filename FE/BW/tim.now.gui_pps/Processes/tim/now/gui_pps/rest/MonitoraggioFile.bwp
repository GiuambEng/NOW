    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://xmlns.example.com/20160927164418PLT&quot; xmlns:tns1=&quot;http://www.example.org/1474990336165&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://xmlns.example.com/MonitoraggioFile/parameters&quot; xmlns:tns3=&quot;http://www.example.org/CryptoParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLSoglia&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateXdsl&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParam&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:monitoraggioFile>&#xa;            &lt;!--REGOLATORIO-->&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($get.parameters/tns2:flagExport)!='Y'&quot;>&#xa;                    &lt;famigliaOfferta>&#xa;                        &lt;nomeFamigliaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                        &lt;/nomeFamigliaOfferta>&#xa;                        &lt;xsl:for-each select=&quot;$AccumulateRegolatorio/tns1:monitoraggioFile/famigliaOfferta/dataXFile&quot;>&#xa;                            &lt;dataXFile>&#xa;                                &lt;dataAcquisizione>&#xa;                                    &lt;xsl:value-of select=&quot;dataAcquisizione&quot;/>&#xa;                                &lt;/dataAcquisizione>&#xa;                                &lt;xsl:copy-of select=&quot;Elaborati&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;Acquisiti&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;InElaborazione&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;Scartati&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;Scaduti&quot;/>&#xa;                            &lt;/dataXFile>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/famigliaOfferta>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($get.parameters/tns2:flagExport)!='Y'&quot;>&#xa;                    &lt;famigliaOfferta>&#xa;                        &lt;nomeFamigliaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;                        &lt;/nomeFamigliaOfferta>&#xa;                        &lt;xsl:for-each select=&quot;$AccumulateXdsl/tns1:monitoraggioFile/famigliaOfferta/dataXFile&quot;>&#xa;                            &lt;dataXFile>&#xa;                                &lt;dataAcquisizione>&#xa;                                    &lt;xsl:value-of select=&quot;dataAcquisizione&quot;/>&#xa;                                &lt;/dataAcquisizione>&#xa;                                &lt;xsl:copy-of select=&quot;Elaborati&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;Acquisiti&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;InElaborazione&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;Scartati&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;Scaduti&quot;/>&#xa;                            &lt;/dataXFile>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/famigliaOfferta>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Accumulate1/tns1:monitoraggioFile[1]/famigliaOfferta[1]/nomeFamigliaOfferta)>0&quot;>&#xa;                    &lt;result>&#xa;                        &lt;severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/severity>&#xa;                        &lt;code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/code>&#xa;                    &lt;/result>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;result>&#xa;                        &lt;severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/severity>&#xa;                        &lt;code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/code>&#xa;                        &lt;details>&#xa;                            &lt;xsl:value-of select=&quot;'NESSUN DATO TROVATO'&quot;/>&#xa;                        &lt;/details>&#xa;                    &lt;/result>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;soglia>&#xa;                &lt;Elaborati_tot>&#xa;                    &lt;xsl:value-of select=&quot;$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_TOT_FILE_ELABORATO']/column[name='VALORE_SOGLIA']/value&quot;/>&#xa;                &lt;/Elaborati_tot>&#xa;                &lt;InElaborazione_tot>&#xa;                    &lt;xsl:value-of select=&quot;$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_TOT_FILE_IN_ELABORAZIONE']/column[name='VALORE_SOGLIA']/value&quot;/>&#xa;                &lt;/InElaborazione_tot>&#xa;                &lt;InElaborazione_gui>&#xa;                    &lt;xsl:value-of select=&quot;$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_FILE_IN_ELABORAZIONE_FTP']/column[name='VALORE_SOGLIA']/value&quot;/>&#xa;                &lt;/InElaborazione_gui>&#xa;                &lt;InElaborazione_sftp>&#xa;                    &lt;xsl:value-of select=&quot;$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_FILE_IN_ELABORAZIONE_GUI']/column[name='VALORE_SOGLIA']/value&quot;/>&#xa;                &lt;/InElaborazione_sftp>&#xa;                &lt;Scartati_tot>&#xa;                    &lt;xsl:value-of select=&quot;$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_TOT_FILE_SCARTATO']/column[name='VALORE_SOGLIA']/value&quot;/>&#xa;                &lt;/Scartati_tot>&#xa;                &lt;Scartati_gui>&#xa;                    &lt;xsl:value-of select=&quot;$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_FILE_SCARTATO_GUI']/column[name='VALORE_SOGLIA']/value&quot;/>&#xa;                &lt;/Scartati_gui>&#xa;                &lt;Scartati_sftp>&#xa;                    &lt;xsl:value-of select=&quot;$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_FILE_SCARTATO_FTP']/column[name='VALORE_SOGLIA']/value&quot;/>&#xa;                &lt;/Scartati_sftp>&#xa;                &lt;Scaduti_tot>&#xa;                    &lt;xsl:value-of select=&quot;$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_TOT_FILE_SCADUTO']/column[name='VALORE_SOGLIA']/value&quot;/>&#xa;                &lt;/Scaduti_tot>&#xa;            &lt;/soglia>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($get.parameters/tns2:flagExport) and upper-case($get.parameters/tns2:flagExport)='Y'&quot;>&#xa;                    &lt;idFile>&#xa;                        &lt;xsl:value-of select=&quot;$CryptoParam/tns3:idFileCriptato&quot;/>&#xa;                    &lt;/idFile>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:monitoraggioFile>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
