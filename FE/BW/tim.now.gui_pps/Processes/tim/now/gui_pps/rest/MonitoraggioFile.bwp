                        &lt;/tns1:severity&gt;
                        &lt;tns1:code&gt;
                            &lt;xsl:value-of select="$FaultDetails1/MsgCode"/&gt;
                        &lt;/tns1:code&gt;
                        &lt;tns1:details&gt;
