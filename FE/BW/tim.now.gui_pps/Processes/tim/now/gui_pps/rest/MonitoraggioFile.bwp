                      &lt;crmws>&#xa;                                            &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Elaborati/crmws&quot;/>&#xa;                                        &lt;/crmws>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Elaborati/sdr&quot;>&#xa;                                        &lt;sdr>&#xa;                                            &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Elaborati/sdr&quot;/>&#xa;                                        &lt;/sdr>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Elaborati/dbcfx&quot;>&#xa;                                        &lt;dbcfx>&#xa;                                            &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Elaborati/dbcfx&quot;/>&#xa;                                        &lt;/dbcfx>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/Elaborati>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Acquisiti)&quot;>&#xa;                                &lt;Acquisiti>&#xa;                                    &lt;xsl:if test=&q