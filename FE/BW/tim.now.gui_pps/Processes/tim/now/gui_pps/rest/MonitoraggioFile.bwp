    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="466a6fa5-62ec-4197-9c59-012ea3bec5fb">
                <bpws:onMessage operation="get"
                    partnerLink="monitoraggiofile"
                    portType="ns:monitoraggiofile"
                    tibex:xpdlId="e0622638-fa15-4203-83a9-fbac8094739f" variable="get">
                    <bpws:scope name="scope1">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails"
                                tibex:faultNameVar="FaultName" tibex:xpdlId="ba0134a8-58dc-4e31-b1ac-428fcc05ddd5">
                                <bpws:scope name="scope4">
                                    <bpws:flow name="flow12">
                                    <bpws:links>
                                    <bpws:link
                                    name="CallProcessToReply" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorMonFileLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioFile&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioFile&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorMonitoraggioFile:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioFile&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioFile_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioFile_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorMonitoraggioFile&amp;quot;,'SID:',$get/httpHeaders/tns1:httpHeaders/GUI-SID,'TID:',$get/httpHeaders/tns1:httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns2:track_position>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ErrorMonFileLog-input"
                                    name="ErrorMonFileLog"
                                    tibex:xpdlId="848e7c15-9e0f-4d38-90e0-1d327ecac644"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToReply"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorMonFileLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioFile&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioFile&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorMonitoraggioFile:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioFile&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID&amp;quot;,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioFile_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioFile_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorMonitoraggioFile&amp;quot;,'SID:',$get.httpHeaders/GUI-SID,'TID:',$get.httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns2:track_position>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    spawn="true"
                                    subProcessName="tim.now.gui_pps.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:reply name="Reply"
                                    operation="get"
                                    partnerLink="monitoraggiofile"
                                    portType="ns:monitoraggiofile"
                                    tibex:xpdlId="0ded9705-aa5e-4384-ad8f-5bc77fc91eb1" variable="Reply-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160927164418PLT" xmlns:tns1="http://www.example.org/1474990336165" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;listaMonitoraggioFileOutput&gt;
                &lt;tns1:monitoraggioFile&gt;
                    &lt;result&gt;
                        &lt;severity&gt;
                            &lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;
                        &lt;/severity&gt;
                        &lt;code&gt;
                            &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                        &lt;/code&gt;
                        &lt;details&gt;
                            &lt;xsl:value-of select="$FaultDetails/Msg"/&gt;
                        &lt;/details&gt;
                    &lt;/result&gt;
                &lt;/tns1:monitoraggioFile&gt;
            &lt;/listaMonitoraggioFileOutput&gt;
        &lt;/tns2:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160927164418PLT&quot; xmlns:tns1=&quot;http://www.example.org/1474990336165&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:monitoraggioFile>&#xa;            &lt;result>&#xa;                &lt;severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                &lt;/severity>&#xa;                &lt;code>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/code>&#xa;                &lt;details>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/details>&#xa;            &lt;/result>&#xa;        &lt;/tns1:monitoraggioFile>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToReply"/>
                                    </bpws:targets>
                                    </bpws:reply>
                                    </bpws:flow>
                                </bpws:scope>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="QueryMonitorAggToSQLSoglia" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Iterate3ToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SQLSogliaToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToIterate3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToIterate6" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Iterate6ToEmpty2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty2ToEmpty3" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty2ToMapper1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Mapper1ToExtractIdFile" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ExtractIdFileToRenderXml1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ExportToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ToStringExportToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="OnMessageStartToCallProcess2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess2ToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InfoMonFileLogToQueryMonitorAgg1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty3ToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessTogetOut" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToIterate4" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Iterate4ToEmpty2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToEmpty3" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="OnMessageStart"
                                tibex:constructor="onMessageStart" tibex:xpdlId="59aef2fa-7bbf-42a3-9a28-020316afbca8">
                                <bpws:sources>
                                    <bpws:source linkName="OnMessageStartToCallProcess2"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="OnMessageEnd"
                                tibex:constructor="onMessageEnd" tibex:xpdlId="c912f9ca-4d00-4f33-80bb-19374995efb1"/>
                            <bpws:reply name="getOut" operation="get"
                                partnerLink="monitoraggiofile"
                                portType="ns:monitoraggiofile"
                                tibex:xpdlId="4f7525de-802f-4272-b693-d4dfeb13eb9e" variable="getOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://xmlns.example.com/20160927164418PLT" xmlns:tns1="http://www.example.org/1474990336165" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns2="http://xmlns.example.com/MonitoraggioFile/parameters" xmlns:tns3="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="Accumulate1"/&gt;
    &lt;xsl:param name="SQLSoglia"/&gt;
    &lt;xsl:param name="AccumulateXdsl"/&gt;
    &lt;xsl:param name="AccumulateRegolatorio"/&gt;
    &lt;xsl:param name="get"/&gt;
    &lt;xsl:param name="CryptoParam"/&gt;
    &lt;xsl:template name="getOut-input" match="/"&gt;
        &lt;tns4:getResponse&gt;
            &lt;listaMonitoraggioFileOutput&gt;
                &lt;tns1:monitoraggioFile&gt;
                    &lt;!--REGOLATORIO--&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get/parameters/tns2:monitoraggiofileGetParameters/tns2:flagExport)!='Y'"&gt;
                            &lt;famigliaOfferta&gt;
                                &lt;nomeFamigliaOfferta&gt;
                                    &lt;xsl:value-of select="'REGOLATORIO'"/&gt;
                                &lt;/nomeFamigliaOfferta&gt;
                                &lt;xsl:for-each select="$AccumulateRegolatorio/tns1:monitoraggioFile/famigliaOfferta/dataXFile"&gt;
                                    &lt;dataXFile&gt;
                                        &lt;dataAcquisizione&gt;
                                            &lt;xsl:value-of select="dataAcquisizione"/&gt;
                                        &lt;/dataAcquisizione&gt;
                                        &lt;xsl:copy-of select="Elaborati"/&gt;
                                        &lt;xsl:copy-of select="Acquisiti"/&gt;
                                        &lt;xsl:copy-of select="InElaborazione"/&gt;
                                        &lt;xsl:copy-of select="Scartati"/&gt;
                                        &lt;xsl:copy-of select="Scaduti"/&gt;
                                    &lt;/dataXFile&gt;
                                &lt;/xsl:for-each&gt;
                            &lt;/famigliaOfferta&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="upper-case($get/parameters/tns2:monitoraggiofileGetParameters/tns2:flagExport)!='Y'"&gt;
                            &lt;famigliaOfferta&gt;
                                &lt;nomeFamigliaOfferta&gt;
                                    &lt;xsl:value-of select="'XDSL'"/&gt;
                                &lt;/nomeFamigliaOfferta&gt;
                                &lt;xsl:for-each select="$AccumulateXdsl/tns1:monitoraggioFile/famigliaOfferta/dataXFile"&gt;
                                    &lt;dataXFile&gt;
                                        &lt;dataAcquisizione&gt;
                                            &lt;xsl:value-of select="dataAcquisizione"/&gt;
                                        &lt;/dataAcquisizione&gt;
                                        &lt;xsl:copy-of select="Elaborati"/&gt;
                                        &lt;xsl:copy-of select="Acquisiti"/&gt;
                                        &lt;xsl:copy-of select="InElaborazione"/&gt;
                                        &lt;xsl:copy-of select="Scartati"/&gt;
                                        &lt;xsl:copy-of select="Scaduti"/&gt;
                                    &lt;/dataXFile&gt;
                                &lt;/xsl:for-each&gt;
                            &lt;/famigliaOfferta&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($Accumulate1/tns1:monitoraggioFile[1]/famigliaOfferta[1]/nomeFamigliaOfferta)&gt;0"&gt;
                            &lt;result&gt;
                                &lt;severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/severity&gt;
                                &lt;code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/code&gt;
                            &lt;/result&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;result&gt;
                                &lt;severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/severity&gt;
                                &lt;code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/code&gt;
                                &lt;details&gt;
                                    &lt;xsl:value-of select="'NESSUN DATO TROVATO'"/&gt;
                                &lt;/details&gt;
                            &lt;/result&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;soglia&gt;
                        &lt;Elaborati_tot&gt;
                            &lt;xsl:value-of select="$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_TOT_FILE_ELABORATO']/column[name='VALORE_SOGLIA']/value"/&gt;
                        &lt;/Elaborati_tot&gt;
                        &lt;InElaborazione_tot&gt;
                            &lt;xsl:value-of select="$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_TOT_FILE_IN_ELABORAZIONE']/column[name='VALORE_SOGLIA']/value"/&gt;
                        &lt;/InElaborazione_tot&gt;
                        &lt;InElaborazione_gui&gt;
                            &lt;xsl:value-of select="$SQLSoglia/unknownResultset[1]/row[column[name='NOME_SOGLIA']/value='SOGLIA_NUMERICA_FILE_IN_ELABORAZIONE_FTP']/column[name='VALORE_SOGLIA']/value"/&gt;
