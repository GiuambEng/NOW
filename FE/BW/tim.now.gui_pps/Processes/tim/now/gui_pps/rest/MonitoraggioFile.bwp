                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/1474990336165&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1475053350991&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;famigliaOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;outputCanaleAcq&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElementData&quot;/>&#xa;    &lt;xsl:template name=&quot;MapXAccumulate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:monitoraggioFile>&#xa;            &lt;famigliaOfferta>&#xa;                &lt;nomeFamigliaOfferta>&#xa;                    &lt;xsl:value-of select=&quot;$famigliaOfferta&quot;/>&#xa;                &lt;/nomeFamigliaOfferta>&#xa;                &lt;dataXFile>&#xa;                    &lt;dataAcquisizione>&#xa;                        &lt;xsl:value-of select=&quot;$currentElementData/DATA_ACQUISIZIONE&quot;/>&#xa;                    &lt;/dataAcquisizione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$currentElementData/STATO_FILE_NOW='ELABORATO'&quot;>&#xa;                            &lt;Elaborati>&#xa;                                &lt;tot>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($outputCanaleAcq/tns1:tot) + xsd:int($outputCanaleAcq/tns1:totCrmws) + xsd:int($outputCanaleAcq/tns1:totSdr) + xsd:int($outputCanaleAcq/tns1:totDbcfx)&quot;/>&#xa;                                &lt;/tot>&#xa;                                &lt;now>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($outputCanaleAcq/tns1:tot)&quot;/>&#xa;                                &lt;/now>&#xa;                                &lt;xsl:if test=&quot;$outputCanaleAcq/tns1:totCrmws&quot;>&#xa;                                    &lt;crmws>&#xa;                                        &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:totCrmws&quot;/>&#xa;                                    &lt;/crmws>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$outputCanaleAcq/tns1:totSdr&quot;>&#xa;                                    &lt;sdr>&#xa;                                        &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:totSdr&quot;/>&#xa;                                    &lt;/sdr>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$outputCanaleAcq/tns1:totDbcfx&quot;>&#xa;                                    &lt;dbcfx>&#xa;                                        &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:totDbcfx&quot;/>&#xa;                                    &lt;/dbcfx>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/Elaborati>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;Elaborati/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$currentElementData/STATO_FILE_NOW='ACQUISITO'&quot;>&#xa;                            &lt;Acquisiti>&#xa;                                &lt;tot>&#xa;                                    &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:tot&quot;/>&#xa;                                &lt;/tot>&#xa;                                &lt;xsl:if test=&quot;$outputCanaleAcq/tns1:totGui&quot;>&#xa;                                    &lt;gui>&#xa;                                        &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:totGui&quot;/>&#xa;                                    &lt;/gui>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$outputCanaleAcq/tns1:totSftp&quot;>&#xa;                                    &lt;sftp>&#xa;                                        &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:totSftp&quot;/>&#xa;                                    &lt;/sftp>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/Acquisiti>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$currentElementData/STATO_FILE_NOW='IN ELABORAZIONE'&quot;>&#xa;                            &lt;InElaborazione>&#xa;                                &lt;tot>&#xa;                                    &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:tot&quot;/>&#xa;                                &lt;/tot>&#xa;                                &lt;xsl:if test=&quot;$outputCanaleAcq/tns1:totGui&quot;>&#xa;                                    &lt;gui>&#xa;                                        &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:totGui&quot;/>&#xa;                                    &lt;/gui>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$outputCanaleAcq/tns1:totSftp&quot;>&#xa;                                    &lt;sftp>&#xa;                                        &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:totSftp&quot;/>&#xa;                                    &lt;/sftp>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/InElaborazione>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$currentElementData/STATO_FILE_NOW='SCARTATO'&quot;>&#xa;                            &lt;Scartati>&#xa;                                &lt;tot>&#xa;                                    &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:tot&quot;/>&#xa;                                &lt;/tot>&#xa;                                &lt;xsl:if test=&quot;$outputCanaleAcq/tns1:totGui&quot;>&#xa;                                    &lt;gui>&#xa;                                        &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:totGui&quot;/>&#xa;                                    &lt;/gui>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$outputCanaleAcq/tns1:totSftp&quot;>&#xa;                                    &lt;sftp>&#xa;                                        &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:totSftp&quot;/>&#xa;                                    &lt;/sftp>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/Scartati>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$currentElementData/STATO_FILE_NOW='SCADUTO'&quot;>&#xa;                            &lt;Scaduti>&#xa;                                &lt;tot>&#xa;                                    &lt;xsl:value-of select=&quot;$outputCanaleAcq/tns1:tot&quot;/>&#xa;                                &lt;/tot>&#xa;                            &lt;/Scaduti>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/dataXFile>&#xa;            &lt;/famigliaOfferta>&#xa;        &lt;/tns2:monitoraggioFile>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:www.example.org_1474990336165="http://www.example.org/1474990336165" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>

