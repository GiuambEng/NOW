   &lt;/tns1:owner>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:totCrmws>&#xa;                &lt;xsl:value-of select=&quot;if (exists($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and   OWNER='CRMWS' and DESCR_FAMIG_OFFERTA = $famigliaOfferta and&amp;#xD;&amp;#xA; STATO_FILE_NOW = $statoFileNow ]/TOT) &amp;#xD;&amp;#xA;    and $statoFileNow='ELABORATO'  &amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA; then &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA; xsd:int($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA&amp;#xD;&amp;#xA; = $famigliaOfferta and &amp;#xD;&amp;#xA; STATO_FILE_NOW = 'ELABORATO'   and  OWNER='CRMWS' ][1]/TOT) &amp;#xD;&amp;#xA;  &amp;#xD;&amp;#xA; else 0&quot;/>&#xa;            &lt;/tns1:totCrmws>&#xa;            &lt;tns1:totSdr>&#xa;                &lt;xsl:value-of select=&quot;if (exists($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and&amp;#xD;&amp;#xA; STATO_FILE_NOW = $statoFileNow and  OWNER='SDR' ]/TOT) &amp;#xD;&amp;#xA;    and $statoFileNow='ELABORATO'  &amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA; then &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA; xsd:int($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA  = $famigliaOfferta and &amp;#xD;&amp;#xA; STATO_FILE_NOW = 'ELABORATO'   and  OWNER='SDR' ][1]/TOT) &amp;#xD;&amp;#xA;  &amp;#xD;&amp;#xA; else 0&quot;/>&#xa;            &lt;/tns1:totSdr>&#xa;            &lt;tns1:totDbcfx>&#xa;                &lt;xsl:value-of select=&quot;if (exists($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA = $famigliaOfferta and&amp;#xD;&amp;#xA; STATO_FILE_NOW = $statoFileNow and  OWNER='DBCFX' ]/TOT) &amp;#xD;&amp;#xA;    and $statoFileNow='ELABORATO'  &amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA; then &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA; xsd:int($QueryMonitorAgg/Record[DATA_ACQUISIZIONE = $dataAcquisizione and DESCR_FAMIG_OFFERTA&amp;#xD;&amp;#xA; = $famigliaOfferta and &amp;#xD;&amp;#xA; STATO_FILE_NOW = 'ELABORATO'  and   OWNER='DBCFX' ][1]/TOT) &amp;#xD;&amp;#xA;  &amp;#xD;&amp;#xA; else 0&quot;/>&#xa;            &lt;/tns1:totDbcfx>&#xa;        &lt;/tns1:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
