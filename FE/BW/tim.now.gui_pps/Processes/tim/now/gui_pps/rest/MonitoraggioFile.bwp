                    &lt;/tns1:result&gt;
                &lt;/tns1:monitoraggioFileDD1_output&gt;
            &lt;/parameters&gt;
        &lt;/tns2:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160927164418PLT&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1475072158564&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:monitoraggioFileDD1_output>&#xa;            &lt;tns1:result>&#xa;                &lt;tns1:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                &lt;/tns1:severity>&#xa;                &lt;tns1:code>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&#xa;                &lt;/tns1:code>&#xa;                &lt;tns1:details>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails1/Msg&quot;/>&#xa;                &lt;/tns1:details>&#xa;            &lt;/tns1:result>&#xa;        &lt;/tns1:monitoraggioFileDD1_output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
