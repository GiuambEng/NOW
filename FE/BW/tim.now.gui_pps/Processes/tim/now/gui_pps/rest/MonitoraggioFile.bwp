                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails2&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorLogMonFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;MonitoraggioFile&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioFile&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorMonitoraggioFile:&amp;quot;,tib:render-xml($FaultDetails2/StackTrace, true(),true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_pps.MonitoraggioFile&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID&amp;quot;,$get1.httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID&amp;quot;,$get1.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioFile_&amp;quot;,$get1.httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;MonitoraggioFile_&amp;quot;,$get1.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorMonitoraggioFileDD2&amp;quot;,'SID:',$get1.httpHeaders/GUI-SID,'TID:',$get1.httpHeaders/GUI-TID,'ST',$FaultDetails2/StackTrace)&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails2/MsgCode&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns2:track_position>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_pps.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:reply name="Reply2"
                                    operation="get"
                                    partnerLink="monitoraggiofiledd2"
                                    portType="ns:monitoraggiofiledd2"
                                    tibex:xpdlId="4598064f-2714-4eaf-8aec-81009fb4f9aa" variable="Reply2-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160927164418PLT" xmlns:tns="http://www.example.com/namespaces/tns/1475145485547" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails2"/&gt;
    &lt;xsl:template name="Reply2-input" match="/"&gt;
        &lt;tns2:getResponse1&gt;
            &lt;item&gt;
                &lt;tns:monitoraggioFileDD2_output&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;
                        &lt;/tns:severity&gt;
                        &lt;tns:code&gt;
                            &lt;xsl:value-of select="$FaultDetails2/MsgCode"/&gt;
                        &lt;/tns:code&gt;
                        &lt;tns:details&gt;
                            &lt;xsl:value-of select="$FaultDetails2/Msg"/&gt;
                        &lt;/tns:details&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:monitoraggioFileDD2_output&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse1&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160927164418PLT&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1475145485547&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails2&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:monitoraggioFileDD2_output>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails2/MsgCode&quot;/>&#xa;                &lt;/tns:code>&#xa;                &lt;tns:details>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails2/Msg&quot;/>&#xa;                &lt;/tns:details>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:monitoraggioFileDD2_output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToReply2"/>
                                    </bpws:targets>
                                    </bpws:reply>
                                    </bpws:flow>
                                </bpws:scope>
                            </bpws:catchAll>
