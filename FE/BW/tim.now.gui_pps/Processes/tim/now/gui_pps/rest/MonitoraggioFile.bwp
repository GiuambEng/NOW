xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Scartati)&quot;>&#xa;                                &lt;Scartati>&#xa;                                    &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Scartati/tot&quot;>&#xa;                                        &lt;tot>&#xa;                                            &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Scartati/tot&quot;/>&#xa;                                        &lt;/tot>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Scartati/gui&quot;>&#xa;                                        &lt;gui>&#xa;                                            &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Scartati/gui&quot;/>&#xa;                                        &lt;/gui>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Scartati/sftp&quot;>&#xa;                                        &lt;sftp>&#xa;                                            &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='XDSL']/dataXFile[dataAcquisizione=$dataX]/Scartati/sftp&quot;/>&#xa;                                        &lt;/sftp>&#xa;                                    &lt;/xsl:if>&#x