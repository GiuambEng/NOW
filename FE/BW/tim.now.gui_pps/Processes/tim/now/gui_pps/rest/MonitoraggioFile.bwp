                                    <bpws:sources>
                                    <bpws:source linkName="EmptyToCopy_1_Mapper">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToAccumulate1_RecordAnalizzato">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="((exists( $Accumulate1/ns3:monitoraggioFile       /famigliaOfferta[nomeFamigliaOfferta=$famigliaOfferta]/dataXFile[dataAcquisizione=$dataAcquisizione]/Elaborati[tot!='0'])and $statoFileNow='ELABORATO')&#xd;&#xa;or&#xd;&#xa;(exists( $Accumulate1/ns3:monitoraggioFile       /famigliaOfferta[nomeFamigliaOfferta=$famigliaOfferta]/dataXFile[dataAcquisizione=$dataAcquisizione]/Scartati[tot!='0'])and $statoFileNow='SCARTATO')&#xd;&#xa;or&#xd;&#xa;(exists( $Accumulate1/ns3:monitoraggioFile       /famigliaOfferta[nomeFamigliaOfferta=$famigliaOfferta]/dataXFile[dataAcquisizione=$dataAcquisizione]/Acquisiti[tot!='0'])and $statoFileNow='ACQUISITO')&#xd;&#xa;or&#xd;&#xa;(exists( $Accumulate1/ns3:monitoraggioFile       /famigliaOfferta[nomeFamigliaOfferta=$famigliaOfferta]/dataXFile[dataAcquisizione=$dataAcquisizione]/InElaborazione[tot!='0'])and $statoFileNow='IN ELABORAZIONE') )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[((exists( $Accumulate1/ns3:monitoraggioFile       /famigliaOfferta[nomeFamigliaOfferta=$famigliaOfferta]/dataXFile[dataAcquisizione=$dataAcquisizione]/Elaborati[tot!='0'])and $statoFileNow='ELABORATO')
or
(exists( $Accumulate1/ns3:monitoraggioFile       /famigliaOfferta[nomeFamigliaOfferta=$famigliaOfferta]/dataXFile[dataAcquisizione=$dataAcquisizione]/Scartati[tot!='0'])and $statoFileNow='SCARTATO')
or
(exists( $Accumulate1/ns3:monitoraggioFile       /famigliaOfferta[nomeFamigliaOfferta=$famigliaOfferta]/dataXFile[dataAcquisizione=$dataAcquisizione]/Acquisiti[tot!='0'])and $statoFileNow='ACQUISITO')
or
(exists( $Accumulate1/ns3:monitoraggioFile       /famigliaOfferta[nomeFamigliaOfferta=$famigliaOfferta]/dataXFile[dataAcquisizione=$dataAcquisizione]/InElaborazione[tot!='0'])and $statoFileNow='IN ELABORAZIONE') )]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    </bpws:flow>
