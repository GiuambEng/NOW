                                tibex:xpdlId="1c3a6034-04dc-466e-abbc-672e09abe8cf" variable="postOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20160927164418PLT" xmlns:tns1="http://www.example.com/namespaces/tns/1475072158564" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="OutputQueryMonitoOlo"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="CryptoParams"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns3:postResponse&gt;
            &lt;parameters&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="upper-case($post/item/tns1:monitoraggioFileDD1/tns1:flag_export)='Y' or  upper-case($post/item/tns1:monitoraggioFileDD1/tns1:flag_export)='TRUE'"&gt;
                        &lt;tns1:monitoraggioFileDD1_output&gt;
                            &lt;tns1:result&gt;
                                &lt;tns1:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns1:severity&gt;
                                &lt;tns1:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns1:code&gt;
                            &lt;/tns1:result&gt;
                            &lt;xsl:if test="exists($CryptoParams/tns2:idFileCriptato)"&gt;
                                &lt;tns1:idFile&gt;
                                    &lt;xsl:value-of select="$CryptoParams/tns2:idFileCriptato"/&gt;
                                &lt;/tns1:idFile&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns1:monitoraggioFileDD1_output&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;xsl:copy-of select="$OutputQueryMonitoOlo"/&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/parameters&gt;
        &lt;/tns3:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://xmlns.example.com/20160927164418PLT&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1475072158564&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/CryptoParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;OutputQueryMonitoOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParams&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;upper-case($post.item/tns1:flag_export)='Y' or  upper-case($post.item/tns1:flag_export)='TRUE'&quot;>&#xa;                &lt;tns1:monitoraggioFileDD1_output>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                    &lt;/tns1:result>&#xa;                    &lt;xsl:if test=&quot;exists($CryptoParams/tns2:idFileCriptato)&quot;>&#xa;                        &lt;tns1:idFile>&#xa;                            &lt;xsl:value-of select=&quot;$CryptoParams/tns2:idFileCriptato&quot;/>&#xa;                        &lt;/tns1:idFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:monitoraggioFileDD1_output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:copy-of select=&quot;$OutputQueryMonitoOlo&quot;/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess1TopostOut"/>
                                </bpws:targets>
                                <bpws:correlations/>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1475072158564&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQQueryMonitoOloTot&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryStatoAcquisito&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputQueryMonitoOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(string-length($JDBCQQueryMonitoOloTot/Record[1]/DESCR_STATO_FILE)=0 and $post/item/tns1:monitoraggioFileDD1/tns1:stato_file_now!='ACQUISITO') or ($post/item/tns1:monitoraggioFileDD1/tns1:stato_file_now='ACQUISITO' and string-length($JDBCQueryStatoAcquisito/Record[1]/DESCR_STATO_FILE)=0)&quot;>&#xa;                &lt;tns1:monitoraggioFileDD1_output>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                        &lt;tns1:details>&#xa;                            &lt;xsl:value-of select=&quot;'NESSUN RECORD TROVATO'&quot;/>&#xa;                        &lt;/tns1:details>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:monitoraggioFileDD1_output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$post/item/tns1:monitoraggioFileDD1/tns1:canale_acquisizione='TOT'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$post/item/tns1:monitoraggioFileDD1/tns1:stato_file_now='ELABORATO'&quot;>&#xa;                        &lt;tns1:monitoraggioFileDD1_output>&#xa;                            &lt;xsl:for-each select=&quot;$JDBCQQueryMonitoOloTot/Record[OWNER=('NOW','CRMWS','SDR','DBCFX') and  SORGENTE=('FTP','GUI')]&quot;>&#xa;                                &lt;tns1:MonitoraggioFiledd1>&#xa;                                    &lt;tns1:data_acquisizione>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:date(format-date(xsd:date(DATA_ACQUISIZIONE), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                                    &lt;/tns1:data_acquisizione>&#xa;                                    &lt;tns1:id_file_procsto>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(ID_FILE_PROCSTO)&quot;/>&#xa;                                    &lt;/tns1:id_file_procsto>&#xa;                                    &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                        &lt;tns1:nome_file>&#xa;                                            &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                        &lt;/tns1:nome_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;AMBITO_FILE&quot;>&#xa;                                        &lt;tns1:ambito_file>&#xa;                                            &lt;xsl:value-of select=&quot;AMBITO_FILE&quot;/>&#xa;                                        &lt;/tns1:ambito_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;OWNER&quot;>&#xa;                                        &lt;tns1:owner>&#xa;                                            &lt;xsl:value-of select=&quot;OWNER&quot;/>&#xa;                                        &lt;/tns1:owner>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:sorgente>&#xa;                                        &lt;xsl:value-of select=&quot;SORGENTE&quot;/>&#xa;                                    &lt;/tns1:sorgente>&#xa;                                    &lt;tns1:quant_ordini_file>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_FILE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_file>&#xa;                                    &lt;tns1:quant_ordini_crmws>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CRMWS)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_crmws>&#xa;                                    &lt;tns1:quant_errati_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_ERRATI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_errati_now>&#xa;                                    &lt;tns1:quant_ordini_corretti_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CORRETTI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_corretti_now>&#xa;                                    &lt;tns1:quant_ordini_ko_cautelare_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_KO_CAUTELARE_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_ko_cautelare_now>&#xa;                                    &lt;tns1:quant_ordini_task_utente>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_TASK_UTENTE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_task_utente>&#xa;                                    &lt;tns1:data_estrazione>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before( string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns1:data_estrazione>&#xa;                                    &lt;tns1:descr_stato_file>