ant_ordini_file>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_FILE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_file>&#xa;                                    &lt;tns1:quant_ordini_crmws>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CRMWS)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_crmws>&#xa;                                    &lt;tns1:quant_errati_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_ERRATI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_errati_now>&#xa;                                    &lt;tns1:quant_ordini_corretti_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CORRETTI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_corretti_now>&#xa;                                    &lt;tns1:quant_ordini_ko_cautelare_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_KO_CAUTELARE_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_ko_cautelare_now>&#xa;                                    &lt;tns1:quant_ordini_task_utente>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_TASK_UTENTE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_task_utente>&#xa;                                    &lt;tns1:data_estrazione>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before( string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns1:data_estrazione>&#xa;                                    &lt;tns1:descr_stato_file>&#xa;                                        &lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&#xa;                                    &lt;/tns1:descr_stato_file>&#xa;                                    &lt;xsl:if test=&quot;DESCR_INTRFC&quot;>&#xa;                                        &lt;tns1:descrizione_interfaccia>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&#xa;                                        &lt;/tns1:descrizione_interfaccia>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:quant_ordini_dbcfx>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_DBCFX)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_dbcfx>&#xa;                                    &lt;tns1:quant_ordini_sdr>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_SDR)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_sdr>&#xa;                                &lt;/tns1:MonitoraggioFiledd1>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns1:severity>&#xa;                                &lt;tns1:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns1:code>&#xa;                            &lt;/tns1:result>&#xa;                        &lt;/tns1:monitoraggioFileDD1_output>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:monitoraggioFileDD1_output>&#xa;                            &lt;xsl:for-each select=&quot;$JDBCQQueryMonitoOloTot/Record[ SORGENTE=('FTP','GUI') ]&quot;>&#xa;                                &lt;tns1:MonitoraggioFiledd1>&#xa;                                    &lt;tns1:data_acquisizione>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:date(format-date(xsd:date(DATA_ACQUISIZIONE), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                                    &lt;/tns1:data_acquisizione>&#xa;                                    &lt;tns1:id_file_procsto>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(ID_FILE_PROCSTO)&quot;/>&#xa;                                    &lt;/tns1:id_file_procsto>&#xa;                                    &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                        &lt;tns1:nome_file>&#xa;                                            &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                        &lt;/tns1:nome_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;AMBITO_FILE&quot;>&#xa;                                        &lt;tns1:ambito_file>&#xa;                                            &lt;xsl:value-of select=&quot;AMBITO_FILE&quot;/>&#xa;                                        &lt;/tns1:ambito_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;OWNER&quot;>&#xa;                                        &lt;tns1:owner>&#xa;                                            &lt;xsl:value-of select=&quot;OWNER&quot;/>&#xa;                                        &lt;/tns1:owner>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:sorgente>&#xa;                                        &lt;xsl:value-of select=&quot;SORGENTE&quot;/>&#xa;                                    &lt;/tns1:sorgente>&#xa;                                    &lt;tns1:quant_ordini_file>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_FILE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_file>&#xa;                                    &lt;tns1:quant_ordini_crmws>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CRMWS)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_crmws>&#xa;                                    &lt;tns1:quant_errati_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_ERRATI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_errati_now>&#xa;                                    &lt;tns1:quant_ordini_corretti_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CORRETTI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_corretti_now>&#xa;                                    &lt;tns1:quant_ordini_ko_cautelare_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_KO_CAUTELARE_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_ko_cautelare_now>&#xa;                                    &lt;tns1:quant_ordini_task_utente>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_TASK_UTENTE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_task_utente>&#xa;                                    &lt;tns1:data_estrazione>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before( string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns1:data_estrazione>&#xa;                                    &lt;tns1:descr_stato_file>&#xa;                                        &lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&#xa;                                    &lt;/tns1:descr_stato_file>&#xa;                                    &lt;xsl:if test=&quot;DESCR_INTRFC&quot;>&#xa;                                        &lt;tns1:descrizione_interfaccia>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&#xa;                                        &lt;/tns1:descrizione_interfaccia>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:quant_ordini_dbcfx>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_DBCFX)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_dbcfx>&#xa;                                    &lt;tns1:quant_ordini_sdr>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_SDR)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_sdr>&#xa;                                &lt;/tns1:MonitoraggioFiledd1>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns1:severity>&#xa;                                &lt;tns1:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns1:code>&#xa;                            &lt;/tns1:result>&#xa;                        &lt;/tns1:monitoraggioFileDD1_output>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$post/item/tns1:monitoraggioFileDD1/tns1:stato_file_now='ELABORATO' and $post/item/tns1:monitoraggioFileDD1/tns1:canale_acquisizione!='TOT'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$post/item/tns1:monitoraggioFileDD1/tns1:owner='CRMWS' or $post/item/tns1:monitoraggioFileDD1/tns1:owner='SDR' or $post/item/tns1:monitoraggioFileDD1/tns1:owner='DBCFX' or $post/item/tns1:monitoraggioFileDD1/tns1:owner='NOW'&quot;>&#xa;                        &lt;tns1:monitoraggioFileDD1_output>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;$post/item/tns1:monitoraggioFileDD1/tns1:owner&quot;/>&#xa;                            &lt;xsl:for-each select=&quot;$JDBCQQueryMonitoOloTot/Record[OWNER=$var ]&quot;>&#xa;                                &lt;tns1:MonitoraggioFiledd1>&#xa;                                    &lt;tns1:data_acquisizione>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:date(format-date(xsd:date(DATA_ACQUISIZIONE), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                                    &lt;/tns1:data_acquisizione>&#xa;                                    &lt;tns1:id_file_procsto>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(ID_FILE_PROCSTO)&quot;/>&#xa;                                    &lt;/tns1:id_file_procsto>&#xa;                                    &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                        &lt;tns1:nome_file>&#xa;                                            &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                        &lt;/tns1:nome_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;AMBITO_FILE&quot;>&#xa;                                        &lt;tns1:ambito_file>&#xa;                                            &lt;xsl:value-of select=&quot;AMBITO_FILE&quot;/>&#xa;                                        &lt;/tns1:ambito_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;OWNER&quot;>&#xa;                                        &lt;tns1:owner>&#xa;                                            &lt;xsl:value-of select=&quot;OWNER&quot;/>&#xa;                                        &lt;/tns1:owner>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:sorgente>&#xa;                                        &lt;xsl:value-of select=&quot;SORGENTE&quot;/>&#xa;                                    &lt;/tns1:sorgente>&#xa;                                    &lt;tns1:quant_ordini_file>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_FILE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_file>&#xa;                                    &lt;tns1:quant_ordini_crmws>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CRMWS)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_crmws>&#xa;                                    &lt;tns1:quant_errati_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_ERRATI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_errati_now>&#xa;                                    &lt;tns1:quant_ordini_corretti_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CORRETTI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_corretti_now>&#xa;                                    &lt;tns1:quant_ordini_ko_cautelare_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_KO_CAUTELARE_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_ko_cautelare_now>&#xa;                                    &lt;tns1:quant_ordini_task_utente>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_TASK_UTENTE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_task_utente>&#xa;                                    &lt;tns1:data_estrazione>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before( string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns1:data_estrazione>&#xa;                                    &lt;tns1:descr_stato_file>&#xa;                                        &lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&#xa;                                    &lt;/tns1:descr_stato_file>&#xa;                                    &lt;xsl:if test=&quot;DESCR_INTRFC&quot;>&#xa;                                        &lt;tns1:descrizione_interfaccia>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&#xa;                                        &lt;/tns1:descrizione_interfaccia>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:quant_ordini_dbcfx>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_DBCFX)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_dbcfx>&#xa;                                    &lt;tns1:quant_ordini_sdr>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_SDR)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_sdr>&#xa;                                &lt;/tns1:MonitoraggioFiledd1>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns1:severity>&#xa;                                &lt;tns1:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns1:code>&#xa;                                &lt;xsl:variable name=&quot;var2&quot; select=&quot;$post/item/tns1:monitoraggioFileDD1/tns1:owner&quot;/>&#xa;                                &lt;tns1:details>&#xa;                                    &lt;xsl:value-of select=&quot;if(string-length(string($JDBCQQueryMonitoOloTot/Record[1][SORGENTE=$var2 and OWNER!=('CRMWS','SDR','DBCFX')]))=0) then 'NESSUN DATO TROVATO' else ''&quot;/>&#xa;                                &lt;/tns1:details>&#xa;                            &lt;/tns1:result>&#xa;                        &lt;/tns1:monitoraggioFileDD1_output>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:monitoraggioFileDD1_output>&#xa;                            &lt;xsl:for-each select=&quot;$JDBCQQueryMonitoOloTot/Record[1=2]&quot;>&#xa;                                &lt;tns1:MonitoraggioFiledd1>&#xa;                                    &lt;tns1:data_acquisizione>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:date(format-date(xsd:date(DATA_ACQUISIZIONE), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                                    &lt;/tns1:data_acquisizione>&#xa;                                &lt;/tns1:MonitoraggioFiledd1>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns1:severity>&#xa;                            &lt;/tns1:result>&#xa;                        &lt;/tns1:monitoraggioFileDD1_output>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$post/item/tns1:monitoraggioFileDD1/tns1:stato_file_now='ACQUISITO'&quot;>&#xa;                        &lt;tns1:monitoraggioFileDD1_output>&#xa;                            &lt;xsl:variable name=&quot;canal&quot; select=&quot;if($post/item/tns1:monitoraggioFileDD1/tns1:canale_acquisizione='SFTP') then 'FTP' else  $post/item/tns1:monitoraggioFileDD1/tns1:canale_acquisizione&quot;/>&#xa;                            &lt;xsl:for-each select=&quot;$JDBCQueryStatoAcquisito/Record[SORGENTE=$canal ]&quot;>&#xa;                                &lt;tns1:MonitoraggioFiledd1>&#xa;                                    &lt;tns1:data_acquisizione>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:date(format-date(xsd:date(DATA_ACQUISIZIONE), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                                    &lt;/tns1:data_acquisizione>&#xa;                                    &lt;tns1:id_file_procsto>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(ID_FILE_PROCSTO)&quot;/>&#xa;                                    &lt;/tns1:id_file_procsto>&#xa;                                    &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                        &lt;tns1:nome_file>&#xa;                                            &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                        &lt;/tns1:nome_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;AMBITO_FILE&quot;>&#xa;                                        &lt;tns1:ambito_file>&#xa;                                            &lt;xsl:value-of select=&quot;AMBITO_FILE&quot;/>&#xa;                                        &lt;/tns1:ambito_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;OWNER&quot;>&#xa;                                        &lt;tns1:owner>&#xa;                                            &lt;xsl:value-of select=&quot;OWNER&quot;/>&#xa;                                        &lt;/tns1:owner>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:sorgente>&#xa;                                        &lt;xsl:value-of select=&quot;SORGENTE&quot;/>&#xa;                                    &lt;/tns1:sorgente>&#xa;                                    &lt;tns1:quant_ordini_file>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_FILE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_file>&#xa;                                    &lt;tns1:quant_ordini_crmws>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CRMWS)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_crmws>&#xa;                                    &lt;tns1:quant_errati_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_ERRATI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_errati_now>&#xa;                                    &lt;tns1:quant_ordini_corretti_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CORRETTI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_corretti_now>&#xa;                                    &lt;tns1:quant_ordini_ko_cautelare_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_KO_CAUTELARE_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_ko_cautelare_now>&#xa;                                    &lt;tns1:quant_ordini_task_utente>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_TASK_UTENTE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_task_utente>&#xa;                                    &lt;tns1:data_estrazione>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before( string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns1:data_estrazione>&#xa;                                    &lt;tns1:descr_stato_file>&#xa;                                        &lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&#xa;                                    &lt;/tns1:descr_stato_file>&#xa;                                    &lt;xsl:if test=&quot;DESCR_INTRFC&quot;>&#xa;                                        &lt;tns1:descrizione_interfaccia>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&#xa;                                        &lt;/tns1:descrizione_interfaccia>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:quant_ordini_dbcfx>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_DBCFX)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_dbcfx>&#xa;                                    &lt;tns1:quant_ordini_sdr>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_SDR)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_sdr>&#xa;                                &lt;/tns1:MonitoraggioFiledd1>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns1:severity>&#xa;                                &lt;tns1:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns1:code>&#xa;                                &lt;tns1:details>&#xa;                                    &lt;xsl:value-of select=&quot;if(not(exists($JDBCQQueryMonitoOloTot/Record[SORGENTE=$canal])) ) then 'NESSUN DATO TROVATO' else ''&quot;/>&#xa;                                &lt;/tns1:details>&#xa;                            &lt;/tns1:result>&#xa;                        &lt;/tns1:monitoraggioFileDD1_output>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:monitoraggioFileDD1_output>&#xa;                            &lt;xsl:variable name=&quot;canal&quot; select=&quot;if($post/item/tns1:monitoraggioFileDD1/tns1:canale_acquisizione='SFTP') then 'FTP' else  $post/item/tns1:monitoraggioFileDD1/tns1:canale_acquisizione&quot;/>&#xa;                            &lt;xsl:for-each select=&quot;$JDBCQQueryMonitoOloTot/Record[SORGENTE=$canal ]&quot;>&#xa;                                &lt;tns1:MonitoraggioFiledd1>&#xa;                                    &lt;tns1:data_acquisizione>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:date(format-date(xsd:date(DATA_ACQUISIZIONE), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                                    &lt;/tns1:data_acquisizione>&#xa;                                    &lt;tns1:id_file_procsto>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(ID_FILE_PROCSTO)&quot;/>&#xa;                                    &lt;/tns1:id_file_procsto>&#xa;                                    &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                        &lt;tns1:nome_file>&#xa;                                            &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                        &lt;/tns1:nome_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;AMBITO_FILE&quot;>&#xa;                                        &lt;tns1:ambito_file>&#xa;                                            &lt;xsl:value-of select=&quot;AMBITO_FILE&quot;/>&#xa;                                        &lt;/tns1:ambito_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;OWNER&quot;>&#xa;                                        &lt;tns1:owner>&#xa;                                            &lt;xsl:value-of select=&quot;OWNER&quot;/>&#xa;                                        &lt;/tns1:owner>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:sorgente>&#xa;                                        &lt;xsl:value-of select=&quot;SORGENTE&quot;/>&#xa;                                    &lt;/tns1:sorgente>&#xa;                                    &lt;tns1:quant_ordini_file>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_FILE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_file>&#xa;                                    &lt;tns1:quant_ordini_crmws>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CRMWS)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_crmws>&#xa;                                    &lt;tns1:quant_errati_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_ERRATI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_errati_now>&#xa;                                    &lt;tns1:quant_ordini_corretti_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CORRETTI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_corretti_now>&#xa;                                    &lt;tns1:quant_ordini_ko_cautelare_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_KO_CAUTELARE_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_ko_cautelare_now>&#xa;                                    &lt;tns1:quant_ordini_task_utente>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_TASK_UTENTE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_task_utente>&#xa;                                    &lt;tns1:data_estrazione>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before( string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns1:data_estrazione>&#xa;                                    &lt;tns1:descr_stato_file>&#xa;                                        &lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&#xa;                                    &lt;/tns1:descr_stato_file>&#xa;                                    &lt;xsl:if test=&quot;DESCR_INTRFC&quot;>&#xa;                                        &lt;tns1:descrizione_interfaccia>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&#xa;                                        &lt;/tns1:descrizione_interfaccia>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:quant_ordini_dbcfx>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_DBCFX)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_dbcfx>&#xa;                                    &lt;tns1:quant_ordini_sdr>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_SDR)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_sdr>&#xa;                                &lt;/tns1:MonitoraggioFiledd1>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns1:severity>&#xa;                                &lt;tns1:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns1:code>&#xa;                                &lt;tns1:details>&#xa;                                    &lt;xsl:value-of select=&quot;if(not(exists($JDBCQQueryMonitoOloTot/Record[SORGENTE=$canal])) ) then 'NESSUN DATO TROVATO' else ''&quot;/>&#xa;                                &lt;/tns1:details>&#xa;                            &lt;/tns1:result>&#xa;                        &lt;/tns1:monitoraggioFileDD1_output>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="OutputQueryMonitoOlo-input"
                                    name="OutputQueryMonitoOlo"
                                    outputVariable="OutputQueryMonitoOlo"
                                    tibex:xpdlId="50ae5875-5edb-4fce-897e-efce31197059" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQQueryMonitoOloTotToOutputQueryMonitoOlo"/>
                                    <bpws:target linkName="JDBCQueryStatoAcquisitoToOutputQueryMonitoOlo"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="OutputQueryMonitoOloToCallProcess1_NoExport">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="OutputQueryMonitoOloToJDBCQuery_ExportDati">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($post/item/ns10:monitoraggioFileDD1/ns10:flag_export)='Y' or  upper-case($post/item/ns10:monitoraggioFileDD1/ns10:flag_export)='TRUE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($post.item/ns10:flag_export)='Y' or  upper-case($post.item/ns10:flag_export)='TRUE']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1475072158564&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQQueryMonitoOloTot&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryStatoAcquisito&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputQueryMonitoOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(string-length($JDBCQQueryMonitoOloTot/Record[1]/DESCR_STATO_FILE)=0 and $post.item/tns1:stato_file_now!='ACQUISITO') or ($post.item/tns1:stato_file_now='ACQUISITO' and string-length($JDBCQueryStatoAcquisito/Record[1]/DESCR_STATO_FILE)=0)&quot;>&#xa;                &lt;tns1:monitoraggioFileDD1_output>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                        &lt;tns1:details>&#xa;                            &lt;xsl:value-of select=&quot;'NESSUN RECORD TROVATO'&quot;/>&#xa;                        &lt;/tns1:details>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:monitoraggioFileDD1_output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$post.item/tns1:canale_acquisizione='TOT'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$post.item/tns1:stato_file_now='ELABORATO'&quot;>&#xa;                        &lt;tns1:monitoraggioFileDD1_output>&#xa;                            &lt;xsl:for-each select=&quot;$JDBCQQueryMonitoOloTot/Record[OWNER=('NOW','CRMWS','SDR','DBCFX') and  SORGENTE=('FTP','GUI')]&quot;>&#xa;                                &lt;tns1:MonitoraggioFiledd1>&#xa;                                    &lt;tns1:data_acquisizione>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:date(format-date(xsd:date(DATA_ACQUISIZIONE), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                                    &lt;/tns1:data_acquisizione>&#xa;                                    &lt;tns1:id_file_procsto>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(ID_FILE_PROCSTO)&quot;/>&#xa;                                    &lt;/tns1:id_file_procsto>&#xa;                                    &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                        &lt;tns1:nome_file>&#xa;                                            &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                        &lt;/tns1:nome_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;AMBITO_FILE&quot;>&#xa;                                        &lt;tns1:ambito_file>&#xa;                                            &lt;xsl:value-of select=&quot;AMBITO_FILE&quot;/>&#xa;                                        &lt;/tns1:ambito_file>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;OWNER&quot;>&#xa;                                        &lt;tns1:owner>&#xa;                                            &lt;xsl:value-of select=&quot;OWNER&quot;/>&#xa;                                        &lt;/tns1:owner>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:sorgente>&#xa;                                        &lt;xsl:value-of select=&quot;SORGENTE&quot;/>&#xa;                                    &lt;/tns1:sorgente>&#xa;                                    &lt;tns1:quant_ordini_file>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_FILE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_file>&#xa;                                    &lt;tns1:quant_ordini_crmws>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CRMWS)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_crmws>&#xa;                                    &lt;tns1:quant_errati_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_ERRATI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_errati_now>&#xa;                                    &lt;tns1:quant_ordini_corretti_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_CORRETTI_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_corretti_now>&#xa;                                    &lt;tns1:quant_ordini_ko_cautelare_now>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_KO_CAUTELARE_NOW)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_ko_cautelare_now>&#xa;                                    &lt;tns1:quant_ordini_task_utente>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_TASK_UTENTE)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_task_utente>&#xa;                                    &lt;tns1:data_estrazione>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before( string(DATA_ESTRAZIONE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns1:data_estrazione>&#xa;                                    &lt;tns1:descr_stato_file>&#xa;                                        &lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&#xa;                                    &lt;/tns1:descr_stato_file>&#xa;                                    &lt;xsl:if test=&quot;DESCR_INTRFC&quot;>&#xa;                                        &lt;tns1:descrizione_interfaccia>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&#xa;                                        &lt;/tns1:descrizione_interfaccia>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:quant_ordini_dbcfx>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_DBCFX)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_dbcfx>&#xa;                                    &lt;tns1:quant_ordini_sdr>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_ORDN_SDR)&quot;/>&#xa;                                    &lt;/tns1:quant_ordini_sdr>&#xa;                                &lt;/tns1:MonitoraggioFiledd1>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns1:severity>&#xa;                                &lt;tns1:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns1:code>&#xa;                            &lt;/tns1:result>&#xa;                        &lt;/tns1:monitoraggioFileDD1_output>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$post.item/tns1:stato_file_now='ACQUISITO'&quot;>&#xa;                        &lt;tns1:monitoraggioFileDD1_output>&#xa;                            &lt;xsl:for-each select=&quot;$JDBCQueryStatoAcquisito/Record[SORGENTE=('FTP','GUI') ]&quot;>&#xa;                                &lt;tns1:MonitoraggioFile