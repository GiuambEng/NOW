                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="MapperExportTemplate-input"
                                    name="MapperExportTemplate"
                                    outputVariable="MapperExportTemplate"
                                    tibex:xpdlId="6c80bb01-e7de-470f-a3fb-f28f9769c99c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty2ToMapper1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper1ToExtractIdFile"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1475577007179&quot; xmlns:tns1=&quot;http://www.example.org/1474990336165&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AccumulateRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateXdsl&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperExportTemplate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ExportMonitorFileInput>&#xa;            &lt;xsl:for-each select=&quot;$AccumulateXdsl/tns1:monitoraggioFile/famigliaOfferta/dataXFile&quot;>&#xa;                &lt;ExpFileList>&#xa;                    &lt;famigliaOfferta>&#xa;                        &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;                    &lt;/famigliaOfferta>&#xa;                    &lt;dataEstrazione>&#xa;                        &lt;xsl:value-of select=&quot;dataAcquisizione&quot;/>&#xa;                    &lt;/dataEstrazione>&#xa;                    &lt;xsl:if test=&quot;Elaborati/tot&quot;>&#xa;                        &lt;TOTALE_Elaborati>&#xa;                            &lt;xsl:value-of select=&quot;Elaborati/tot&quot;/>&#xa;                        &lt;/TOTALE_Elaborati>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Elaborati/crmws&quot;>&#xa;                        &lt;CRMWS_Elaborati>&#xa;                            &lt;xsl:value-of select=&quot;Elaborati/crmws&quot;/>&#xa;                        &lt;/CRMWS_Elaborati>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Elaborati/dbcfx&quot;>&#xa;                        &lt;DBCFX_Elaborati>&#xa;                            &lt;xsl:value-of select=&quot;Elaborati/dbcfx&quot;/>&#xa;                        &lt;/DBCFX_Elaborati>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Elaborati/now&quot;>&#xa;                        &lt;NOW_Elaborati>&#xa;                            &lt;xsl:value-of select=&quot;Elaborati/now&quot;/>&#xa;                        &lt;/NOW_Elaborati>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Acquisiti/tot&quot;>&#xa;                        &lt;TOTALE_Acquisiti>&#xa;                            &lt;xsl:value-of select=&quot;Acquisiti/tot&quot;/>&#xa;                        &lt;/TOTALE_Acquisiti>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Acquisiti/sftp&quot;>&#xa;                        &lt;FTP_Acquisiti>&#xa;                            &lt;xsl:value-of select=&quot;Acquisiti/sftp&quot;/>&#xa;                        &lt;/FTP_Acquisiti>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;Acquisiti/gui&quot;>&#xa;                        &lt;GUI_Acquisiti>&#xa;                            &lt;xsl:value-of select=&quot;Acquisiti/gui&quot;/>&#xa;                        &lt;/GUI_Acquisiti>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;InElaborazione/tot&quot;>&#xa;                        &lt;TOTALE_InElaborazione>&#xa;                            &lt;xsl:value-of select=&quot;InElaborazione/tot&quot;/>&#xa;                        &lt;/TOTALE_InElaborazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;InElaborazione/sftp&quot;>&#xa;                        &lt;FTP_InElaborazione>&#xa;                            &lt;xsl:value-of select=&quot;InElaborazione/sftp&quot;/>&#xa;                        &lt;/FTP_InElaborazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;InElaborazione/gui&quot;>&#xa;                        &lt;GUI_InElaborazione>&#xa;                            &lt;xsl:value-of select=&quot;InElaborazione/gui&quot;/>&#xa;                        &lt;/GU