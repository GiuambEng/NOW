          &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/sftp>&#xa;                            &lt;/InElaborazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($currentElementFinalXDSL/Scartati)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$currentElementFinalXDSL/Scartati&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;Scartati>&#xa;                                &lt;tot>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tot>&#xa;                                &lt;gui>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/gui>&#xa;                                &lt;sftp>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/sftp>&#xa;                            &lt;/Scartati>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($currentElementFinalXDSL/Scaduti)&quot;>&#xa;                            &lt;xsl:copy-of select=&quot;$currentElementFinalXDSL/Scaduti&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;Scaduti>&#xa;                                &lt;tot>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tot>&#xa;                            &lt;/Scaduti>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/dataXFile>&#xa;       