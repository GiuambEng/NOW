                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/1474990336165&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:monitoraggioFile>&#xa;            &lt;famigliaOfferta>&#xa;                &lt;nomeFamigliaOfferta>&#xa;                    &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                &lt;/nomeFamigliaOfferta>&#xa;                &lt;xsl:for-each select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile/dataAcquisizione)&quot;>&#xa;                            &lt;dataXFile>&#xa;                                &lt;xsl:variable name=&quot;dataA&quot; select=&quot;dataAcquisizione&quot;/>&#xa;                                &lt;dataAcquisizione>&#xa;                                    &lt;xsl:value-of select=&quot;dataAcquisizione&quot;/>&#xa;                                &lt;/dataAcquisizione>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati)&quot;>&#xa;                                        &lt;Elaborati>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/tot&quot;>&#xa;                                                &lt;tot>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/tot&quot;/>&#xa;                                                &lt;/tot>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/now&quot;>&#xa;                                                &lt;now>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/now&quot;/>&#xa;                                                &lt;/now>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/crmws&quot;>&#xa;                                                &lt;crmws>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/crmws&quot;/>&#xa;                                                &lt;/crmws>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/sdr&quot;>&#xa;                                                &lt;sdr>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/sdr&quot;/>&#xa;                                                &lt;/sdr>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/dbcfx&quot;>&#xa;                                                &lt;dbcfx>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Elaborati/dbcfx&quot;/>&#xa;                                                &lt;/dbcfx>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/Elaborati>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Acquisiti)&quot;>&#xa;                                        &lt;Acquisiti>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Acquisiti/tot&quot;>&#xa;                                                &lt;tot>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Acquisiti/tot&quot;/>&#xa;                                                &lt;/tot>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Acquisiti/gui&quot;>&#xa;                                                &lt;gui>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Acquisiti/gui&quot;/>&#xa;                                                &lt;/gui>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Acquisiti/sftp&quot;>&#xa;                                                &lt;sftp>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/Acquisiti/sftp&quot;/>&#xa;                                                &lt;/sftp>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/Acquisiti>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/InElaborazione)&quot;>&#xa;                                        &lt;InElaborazione>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/InElaborazione/tot&quot;>&#xa;                                                &lt;tot>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/InElaborazione/tot&quot;/>&#xa;                                                &lt;/tot>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/InElaborazione/gui&quot;>&#xa;                                                &lt;gui>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/InElaborazione/gui&quot;/>&#xa;                                                &lt;/gui>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/InElaborazione/sftp&quot;>&#xa;                                                &lt;sftp>&#xa;                                                    &lt;xsl:value-of select=&quot;$Accumulate1/tns1:monitoraggioFile/famigliaOfferta[nomeFamigliaOfferta='REGOLATORIO']/dataXFile[dataAcquisizione=$dataA]/InElaborazione/sftp&quot;/>&#xa;                                                &lt;/sftp>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/InElaborazione>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Accumulate1/tns