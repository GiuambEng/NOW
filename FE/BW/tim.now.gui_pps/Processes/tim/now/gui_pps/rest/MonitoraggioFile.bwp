                            <bpws:empty name="Empty2" tibex:xpdlId="01ac7cf5-3d0e-4baf-90f9-078c29a05d99">
                                <bpws:targets>
                                    <bpws:target linkName="Iterate6ToEmpty2"/>
                                    <bpws:target linkName="Iterate4ToEmpty2"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty2ToEmpty3">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty2ToMapper1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($get/parameters/tns:monitoraggiofileGetParameters/tns:flagExport) and upper-case($get/parameters/tns:monitoraggiofileGetParameters/tns:flagExport)='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($get.parameters/tns:flagExport) and upper-case($get.parameters/tns:flagExport)='Y']]></bpws:transitionCondition>
                                    </bpws:source>
