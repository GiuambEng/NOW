            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RinvioNotificheOutput&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1473065157083&quot; xmlns:ns011=&quot;http://www.tim.com/NOW/xsd/ReinvioScheduler&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GeneraNotifiche&quot;/>&lt;xsl:param name=&quot;findCase&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:RinvioNotificheOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($findCase/findCaseByCriteriaResponse/ns:FindCaseByCriteriaResponse/caseReference[1])>0&quot;>&lt;tns:RinvioNotificheOutput>&lt;tns:idRichiesta>&lt;xsl:value-of select=&quot;$Start/tns1:Id_Richiesta&quot;/>&lt;/tns:idRichiesta>&lt;xsl:if test=&quot;$Start/tns1:Id_Notifica&quot;>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;$Start/tns1:Id_Notifica&quot;/>&lt;/tns:idNotifica>&lt;/xsl:if>&lt;tns:esito>&lt;tns:codice>&lt;xsl:value-of select=&quot;$GeneraNotifiche/ReinvioSchedulerOutput/ns011:ReinvioSchedulerResponse/ns011:Response[1]/ns011:Codice&quot;/>&lt;/tns:codice>&lt;xsl:if test=&quot;$GeneraNotifiche/ReinvioSchedulerOutput/ns011:ReinvioSchedulerResponse/ns011:Response[1]/ns011:Descrizione&quot;>&lt;tns:descrizione>&lt;xsl:value-of select=&quot;$GeneraNotifiche/ReinvioSchedulerOutput/ns011:ReinvioSchedulerResponse/ns011:Response[1]/ns011:Descrizione&quot;/>&lt;/tns:descrizione>&lt;/xsl:if>&lt;/tns:esito>&lt;/tns:RinvioNotificheOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:procCaller='RinvioNotifica'&quot;>&lt;tns:RinvioNotificheOutput>&lt;tns:idRichiesta>&lt;xsl:value-of select=&quot;$Start/tns1:Id_Richiesta&quot;/>&lt;/tns:idRichiesta>&lt;xsl:if test=&quot;$Start/tns1:Id_Notifica&quot;>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;