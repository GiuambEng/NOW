                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns4:procCaller='RinvioNotifica']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
