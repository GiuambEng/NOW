    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>JavaInvoke</variable>
            </endingVariables>
        </task>
        <task name="JavaInvoke">
            <endingVariables>
                <variable>JavaInvoke-input</variable>
                <variable>Start</variable>
                <variable>HeaderPath</variable>
            </endingVariables>
        </task>
        <task name="Log">
            <endingVariables>
                <variable>Log-input</variable>
            </endingVariables>
        </task>
        <task name="Log1">
            <endingVariables>
                <variable>Log1-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
