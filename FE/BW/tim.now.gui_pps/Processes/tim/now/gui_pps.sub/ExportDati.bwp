                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="xmlToExcelToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/cmf.exportDati&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcel&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;xmlToExcel-input&quot; match=&quot;/&quot;>&lt;tns1:Input_XmlToExcel>&lt;tns1:xmlParameter>&lt;xsl:value-of select=&quot;$Start/tns:xmlParameter&quot;/>&lt;/tns1:xmlParameter>&lt;tns1:listOfElements>&lt;xsl:value-of select=&quot;$Start/tns:listOfElements&quot;/>&lt;/tns1:listOfElements>&lt;tns1:rootElementParameter>&lt;xsl:value-of select=&quot;$Start/tns:rootElementParameter&quot;/>&lt;/tns1:rootElementParameter>&lt;tns1:NameOfFile>&lt;xsl:value-of select=&quot;$Start/tns:nameOfFile&quot;/>&lt;/tns1:NameOfFile>&lt;tns1:childrootElement>&lt;xsl:value-of select=&quot;$Start/tns:childRootElement&quot;/>&lt;/tns1:childrootElement>&lt;/tns1:Input_XmlToExcel>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.gui_pps.sub.XmlToExcel" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogOutputExportDati-input"
                    name="LogOutputExportDati"
                    tibex:xpdlId="87feefad-66fc-4384-91d4-f3dc9b434aef" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToLogOutputExportDati"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCUpdate&quot;/>&lt;xsl:template name=&quot;LogOutputExportDati-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output ExportDati : &amp;quot;,tib:render-xml($JDBCUpdate,true(),true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
