            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogInputExportDati-input"
                    name="LogInputExportDati"
                    tibex:xpdlId="fc4410d6-b0f8-46f5-8b8b-8aaeae7f8713" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLog"/>
                    </bpws:targets>
                    <bpws:sources>
