                                    name="Throw" tibex:xpdlId="7f062f1e-6e1e-4083-ad26-76c5c6354f99">
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentCondition&quot;/>&lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&lt;tns:DefaultFault>&lt;xsl:choose>&lt;xsl:when test=&quot;(&amp;#xD;&amp;#xA;(upper-case($currentCondition/tns1:tipo)='STRING') and &amp;#xD;&amp;#xA; (not($currentCondition/tns1:operazione=('>','&amp;lt;','=','!=','&amp;lt;>')) and&amp;#xD;&amp;#xA; not($currentCondition/tns1:operazione=('IN','NOTNULL','STARTWITH','ENDWITH'))&amp;#xD;&amp;#xA; ) )&amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA; or ((upper-case($currentCondition/tns1:tipo)='INT')  and &amp;#xD;&amp;#xA; (not($currentCondition/tns1:operazione=('>','&amp;lt;','=','!=','&amp;lt;>','!=')) and not($currentCondition/tns1:operazione=('IN','ISNULL'))) )&amp;#xD;&amp;#xA; or &amp;#xD;&amp;#xA; ( &amp;#xD;&amp;#xA; upper-case($currentCondition/tns1:tipo)='DATE' and (not($currentCondition/tns1:operazione=('>','&amp;lt;','=','!=','&amp;lt;>','!=')) and not($currentCondition/tns1:operazione=('ISNULL')))&amp;#xD;&amp;#xA; )&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;operazione&amp;quot;,$currentCondition/tns1:operazione,&amp;quot; errata&amp;quot;)&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;message>&lt;xsl:value-of select=&quot;'Tipologia errata'&quot;/>&lt;/message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(&amp;#xD;&amp;#xA;(upper-case($currentCondition/tns1:tipo)='STRING') and &amp;#xD;&amp;#xA; (not($currentCondition/tns1:operazione=('>','&amp;lt;','=','!=','&amp;lt;>')) and&amp;#xD;&amp;#xA; not($currentCondition/tns1:operazione=('IN','NOTNULL','STARTWITH','ENDWITH'))&amp;#xD;&amp;#xA; ) )&amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA; or ((upper-case($currentCondition/tns1:tipo)='INT')  and &amp;#xD;&amp;#xA; (not($currentCondition/tns1:operazione=('>','&amp;lt;','=','!=','&amp;lt;>','!=')) and not($currentCondition/tns1:operazione=('IN','ISNULL'))) )&amp;#xD;&amp;#xA; or &amp;#xD;&amp;#xA; ( &amp;#xD;&amp;#xA; upper-case($currentCondition/tns1:tipo)='DATE' and (not($currentCondition/tns1:operazione=('>','&amp;lt;','=','!=','&amp;lt;>','!=')) and not($currentCondition/tns1:operazione=('ISNULL')))&amp;#xD;&amp;#xA; )&quot;>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;L'operazione  &amp;quot;,$currentCondition/tns1:operazione,&amp;quot; non è contemplata&amp;quot;,&amp;quot; per il nome tabella &amp;quot;, $currentCondition/tns1:nome)&quot;/>&lt;/msgCode>&lt;/xsl:when>&lt;xsl:when test=&quot;(&amp;#xD;&amp;#xA;    matches(upper-case($currentCondition/tns1:valore),'\s*((DELETE)\s+[a-zA-Z]*\s*(WHERE))\s*')&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;matches(upper-case($currentCondition/tns1:valore),'\s*((INSERT)\s+(INTO))\s*')&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;matches(upper-case($currentCondition/tns1:valore),'\s*((UPDATE)\s+[a-zA-Z]*\s*(SET))\s*')&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;matches(upper-case($currentCondition/tns1:valore),'\s*((RENAME)\s+(TABLE))\s*')&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;matches(upper-case($currentCondition/tns1:valore),'\s*((DROP)\s+[a-zA-Z]*\s*(TABLE))\s*')&amp;#xD;&amp;#xA;&amp;#x9;or&amp;#xD;&amp;#xA;&amp;#x9;matches(upper-case($currentCondition/tns1:valore),'\s*((ALTER)\s+(TABLE))\s*')&amp;#xD;&amp;#xA;&amp;#x9;)&amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA; or ((upper-case($currentCondition/tns1:tipo)='INT')  and &amp;#xD;&amp;#xA; (not($currentCondition/tns1:operazione=('>','&amp;lt;','=','!=','&amp;lt;>','!=')) and not($currentCondition/tns1:operazione=('IN','ISNULL'))) )&amp;#xD;&amp;#xA; or &amp;#xD;&amp;#xA; ( &amp;#xD;&amp;#xA; upper-case($currentCondition/tns1:tipo)='DATE' and (not($currentCondition/tns1:operazione=('>','&amp;lt;','=','!=','&amp;lt;>','!=')) and not($currentCondition/tns1:operazione=('ISNULL')))&amp;#xD;&amp;#xA; ) or contains($currentCondition/tns1:valore, &amp;quot;'&amp;quot;) or contains($currentCondition/tns1:valore, '&amp;quot;') or contains($currentCondition/tns1:valore, &amp;quot;%&amp;quot;) or contains($currentCondition/tns1:valore, &amp;quot;*&amp;quot;) or contains($currentCondition/tns1:valore, &amp;quot;#&amp;quot;)&quot;>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Probabile tentativo di hackeraggio SWL INJECTION: &amp;quot;,$currentCondition/tns1:valore, $currentCondition/tns1:tipo)&quot;/>&lt;/msgCode>&lt;/xsl:when>&lt;xsl:otherwise>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;La tipologia &amp;quot;,$currentCondition/tns1:tipo,&amp;quot; non è contemplata&amp;quot;,&amp;quot; per il nome tabella &amp;quot;, $currentCondition/tns1:nome)&quot;/>&lt;/msgCode>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:DefaultFault>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
