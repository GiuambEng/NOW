        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="fd4f9829-5f31-4207-ab0f-f13810b87aa9">
                <bpws:scope name="scope2">
                    <bpws:flow name="flow5">
                        <bpws:links>
                            <bpws:link name="LogToRethrow" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="Log-input" name="Log"
                                tibex:xpdlId="ee913b56-0793-4acb-9553-83f55200920e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogToRethrow"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;FaultName&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;'ERROR'&quot;/>&lt;/msgCode>&lt;loggerName>&lt;xsl:value-of select=&quot;$FaultName&quot;/>&lt;/loggerName>&lt;logLevel>&lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&lt;/logLevel>&lt;message>&lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:rethrow name="Rethrow" tibex:xpdlId="5a436944-2cf4-42f7-9e69-0ecc64478620">
                            <bpws:targets>
                                <bpws:target linkName="LogToRethrow"/>
                            </bpws:targets>
                        </bpws:rethrow>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="IterateToEmpty3" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToEmpty2" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty2ToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty3ToEnd_OK" tibex:label="OK" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Empty3ToThrow1_SQLINJECTIONCONTROL"
                    tibex:label="SQL_INJECTION_CONTROL" tibex:linkType="SUCCESSWITHCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="9480148a-bd3e-4019-8a39-0807aa02462b"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEmpty2"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="d415b892-6fc8-497c-9ef4-7e2d0776daa4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty3ToEnd_OK"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1484909318161&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:outputservizioricercaavanzata>&#xa;                &lt;!--concateno le tre tipologie di filtri e alla fine viene eseguita la substring-before  per togliere l'ultimo &quot;AND&quot;-->&lt;tns:outputcondition>&lt;xsl:value-of select=&quot;tib:substring-before-last(tib:concat-sequence-format($Accumulate/tns1:RicercaCondition,&amp;quot; &amp;quot;),'AND')&quot;/>&lt;/tns:outputcondition>&lt;/tns:outputservizioricercaavanzata>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="cee3bb11-623a-4f6d-afbb-02a9be2f3224">
                <bpws:targets>
                    <bpws:target linkName="Empty2ToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToEmpty3"/>
                </bpws:sources>
                <bpws:compensationHandler>
                    <bpws:scope name="scope1">
                        <bpws:flow name="flow2">
                            <bpws:links/>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:compensationHandler>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit"
                        tibex:xpdlId="db58bafb-8768-4c3f-9b9a-78e86993e811" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+da21067c-4184-442c-a067-1793bbe83dc2" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$Start/ns0:strutturaCondition" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns0:strutturaCondition)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns0:Iterate_Current_Element_strutturaCondition"
                                    name="currentCondition" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link name="GroupStartToEmpty4"
                                    tibex:label="" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="GroupStartTonumberCondition"
                                    tibex:label="" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link name="GroupStartToEmpty1"
                                    tibex:label="" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="numberConditionToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToThrow_TipologiaERRATA"
                                    tibex:label="Tipologia ERRATA" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Iterate1ToCopy_1_COND" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="EmptyToMapper" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="EmptyTonumberCondition"
                                    tibex:label="NOT IN CONDITION" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="RESETINCONDToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="MapperToIterate1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="DEL_LAST_VIRGOLA_COND_INTonumberCondition1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Empty1ToMAP_COND_IN_INT" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Empty1TonumberCondition"
                                    tibex:label="NOT_IN_CONDITION" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Iterate2ToDELLASTVIRGOLACONDIN" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="numberConditionToRESET_COND_IN" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="GroupStartToEmpty2" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Empty2ToThrow_OperazioneErrata"
                                    tibex:label="Operazione Errata" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MAP_COND_IN_INTToIterate2" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Empty4ToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="valoreStringToEmpty" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Empty4ToJavaInvoke_StringaCono"
                                    tibex:label="StringaCon&quot;_&quot;o&quot;%&quot;" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="StartEndWithTovaloreString" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="e73a07e0-d3c0-400d-ade4-959ae93a2ca1" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToEmpty4">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($currentCondition/ns0:tipo)=('STRING')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($currentCondition/ns0:tipo)=('STRING')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartTonumberCondition">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($currentCondition/ns0:tipo)=('DATE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($currentCondition/ns0:tipo)=('DATE')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToEmpty1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($currentCondition/ns0:tipo)=('INT')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($currentCondition/ns0:tipo)=('INT')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToThrow_TipologiaERRATA">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToEmpty2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(&#xd;&#xa;(upper-case($currentCondition/ns0:tipo)='STRING') and &#xd;&#xa; (not($currentCondition/ns0:operazione=('>','&lt;','=','!=','&lt;>')) and&#xd;&#xa; not($currentCondition/ns0:operazione=('IN','NOTNULL','STARTWITH','ENDWITH','ISNULL'))&#xd;&#xa; ) )&#xd;&#xa; &#xd;&#xa; or ((upper-case($currentCondition/ns0:tipo)='INT')  and &#xd;&#xa; (not($currentCondition/ns0:operazione=('>','&lt;','=','!=','&lt;>','!=')) and not($currentCondition/ns0:operazione=('IN','ISNULL'))) )&#xd;&#xa; or &#xd;&#xa; ( &#xd;&#xa; upper-case($currentCondition/ns0:tipo)='DATE' and (not($currentCondition/ns0:operazione=('>','&lt;','=','&lt;=','>=','!=')) and not($currentCondition/ns0:operazione=('ISNULL')))&#xd;&#xa; ) &#xd;&#xa;or &#xd;&#xa; (&#xd;&#xa;    matches(upper-case($currentCondition/ns0:valore),'\s*((DELETE)\s+[a-zA-Z]*\s*(WHERE))\s*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case($currentCondition/ns0:valore),'\s*((INSERT)\s+(INTO))\s*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case($currentCondition/ns0:valore),'\s*((UPDATE)\s+[a-zA-Z]*\s*(SET))\s*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case($currentCondition/ns0:valore),'\s*((RENAME)\s+(TABLE))\s*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case($currentCondition/ns0:valore),'\s*((DROP)\s+[a-zA-Z]*\s*(TABLE))\s*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case($currentCondition/ns0:valore),'\s*((ALTER)\s+(TABLE))\s*')&#xd;&#xa;&#x9;) or contains($currentCondition/ns0:valore, &quot;'&quot;) or contains($currentCondition/ns0:valore, '&quot;') or contains($currentCondition/ns0:valore, &quot;%&quot;) or contains($currentCondition/ns0:valore, &quot;*&quot;) or contains($currentCondition/ns0:valore, &quot;#&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(
(upper-case($currentCondition/ns0:tipo)='STRING') and 
 (not($currentCondition/ns0:operazione=('>','<','=','!=','<>')) and
 not($currentCondition/ns0:operazione=('IN','NOTNULL','STARTWITH','ENDWITH','ISNULL'))
 ) )
 
 or ((upper-case($currentCondition/ns0:tipo)='INT')  and 
 (not($currentCondition/ns0:operazione=('>','<','=','!=','<>','!=')) and not($currentCondition/ns0:operazione=('IN','ISNULL'))) )
 or 
 ( 
 upper-case($currentCondition/ns0:tipo)='DATE' and (not($currentCondition/ns0:operazione=('>','<','=','<=','>=','!=')) and not($currentCondition/ns0:operazione=('ISNULL')))
 ) 
or 
 (
    matches(upper-case($currentCondition/ns0:valore),'\s*((DELETE)\s+[a-zA-Z]*\s*(WHERE))\s*')
	or
	matches(upper-case($currentCondition/ns0:valore),'\s*((INSERT)\s+(INTO))\s*')
	or
	matches(upper-case($currentCondition/ns0:valore),'\s*((UPDATE)\s+[a-zA-Z]*\s*(SET))\s*')
	or
	matches(upper-case($currentCondition/ns0:valore),'\s*((RENAME)\s+(TABLE))\s*')
	or
	matches(upper-case($currentCondition/ns0:valore),'\s*((DROP)\s+[a-zA-Z]*\s*(TABLE))\s*')
	or
	matches(upper-case($currentCondition/ns0:valore),'\s*((ALTER)\s+(TABLE))\s*')
	) or contains($currentCondition/ns0:valore, "'") or contains($currentCondition/ns0:valore, '"') or contains($currentCondition/ns0:valore, "%") or contains($currentCondition/ns0:valore, "*") or contains($currentCondition/ns0:valore, "#")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns0:strutturaCondition)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentCondition"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
