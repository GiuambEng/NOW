                                expression="(&#xd;&#xa;    matches(upper-case( tib:substring-before-last(concat($String,&quot; &quot;,$Date, &quot; &quot;,$Number),'AND')),'.*\s*((DELETE)\s+[a-zA-Z_a-zA-Z]*\s*(WHERE))\s*.*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case(&#x9; tib:substring-before-last(concat($String,&quot; &quot;,$Date, &quot; &quot;,$Number),'AND')),'.*\s*((INSERT)\s+(INTO))\s*.*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case( tib:substring-before-last(concat($String,&quot; &quot;,$Date, &quot; &quot;,$Number),'AND')),'.*\s*((UPDATE)\s+[a-zA-Z_a-zA-Z]*\s*(SET))\s*.*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case( tib:substring-before-last(concat($String,&quot; &quot;,$Date, &quot; &quot;,$Number),'AND')),'.*\s*((RENAME)\s+(TABLE))\s*.*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case( tib:substring-before-last(concat($String,&quot; &quot;,$Date, &quot; &quot;,$Number),'AND')),'.*\s*((DROP)\s+[a-zA-Z_a-zA-Z]*\s*(TABLE))\s*.*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case( tib:substring-before-last(concat($String,&quot; &quot;,$Date, &quot; &quot;,$Number),'AND')),'.*\s*((ALTER)\s+(TABLE))\s*.*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;matches(upper-case( tib:substring-before-last(concat($String,&quot; &quot;,$Date, &quot; &quot;,$Number),'AND')),'.*\s*((TRUNCATE)\s+(TABLE))\s*.*')&#xd;&#xa;&#x9;or&#xd;&#xa;&#x9;&#x9;matches(upper-case( tib:substring-before-last(concat($String,&quot; &quot;,$Date, &quot; &quot;,$Number),'AND')),'.*\s*((TRUNCATE)\s+(DATABASE))\s*.*')&#xd;&#xa;&#x9;&#x9;or&#xd;&#xa;&#x9;&#x9;matches(upper-case( tib:substring-before-last(concat($String,&quot; &quot;,$Date, &quot; &quot;,$Number),'AND')),'.*\s*((DROP)\s+(INDEX))\s*.*')&#xd;&#xa;&#xd;&#xa;&#x9;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[(
    matches(upper-case( tib:substring-before-last(concat($String," ",$Date, " ",$Number),'AND')),'.*\s*((DELETE)\s+[a-zA-Z_a-zA-Z]*\s*(WHERE))\s*.*')
	or
