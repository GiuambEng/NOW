    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>Accumulate</variable>
            </endingVariables>
        </task>
        <task name="Iterate">
            <endingVariables>
                <variable>Start</variable>
                <variable>currentCondition</variable>
                <variable>Condition</variable>
            </endingVariables>
        </task>
        <task name="Throw">
            <endingVariables>
                <variable>Throw-input</variable>
            </endingVariables>
        </task>
        <task name="Iterate1">
            <endingVariables>
                <variable>MAP_COND_IN_STRING</variable>
                <variable>currentINCond</variable>
            </endingVariables>
        </task>
        <task name="MAP_COND_IN_STRING">
            <endingVariables>
                <variable>MAP_COND_IN_STRING-input</variable>
            </endingVariables>
        </task>
        <task name="Iterate2">
            <endingVariables>
                <variable>MAP_COND_IN_INT</variable>
                <variable>currCondInInt</variable>
            </endingVariables>
        </task>
        <task name="MAP_COND_IN_INT">
            <endingVariables>
                <variable>MAP_COND_IN_INT-input</variable>
            </endingVariables>
        </task>
        <task name="Condition">
            <endingVariables>
                <variable>Condition-input</variable>
            </endingVariables>
        </task>
        <task name="valoreString">
            <endingVariables>
                <variable>StartEndWith</variable>
            </endingVariables>
        </task>
        <task name="StartEndWith">
            <endingVariables>
                <variable>StartEndWith-input</variable>
            </endingVariables>
        </task>
        <task name="Error">
            <endingVariables>
                <variable>Error-input</variable>
            </endingVariables>
        </task>
        <task name="Log">
            <endingVariables>
                <variable>Log-input</variable>
                <variable>FaultName</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
