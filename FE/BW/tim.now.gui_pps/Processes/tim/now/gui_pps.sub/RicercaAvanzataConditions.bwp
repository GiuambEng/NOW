                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1484909318161&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InCondition&quot;/>&lt;xsl:param name=&quot;currentCondition&quot;/>&lt;xsl:param name=&quot;Number&quot;/>&lt;xsl:param name=&quot;String&quot;/>&lt;xsl:param name=&quot;valoreString&quot;/>&lt;xsl:template name=&quot;Condition-input&quot; match=&quot;/&quot;>&lt;tns:RicercaCondition>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($currentCondition/tns1:tipo)=('DATE')&quot;>&lt;condizione>&lt;xsl:value-of select=&quot;if( $currentCondition/tns1:operazione=('=','>','>=','&amp;lt;=','&amp;lt;','!=') ) then concat(&amp;quot;TRUNC(&amp;quot;,$currentCondition/tns1:nome,&amp;quot; ) &amp;quot;,&amp;#xD;&amp;#xA;$currentCondition/tns1:operazione,&amp;quot; &amp;quot;,&amp;#xD;&amp;#xA;concat(&amp;quot;TO_DATE('&amp;quot;,$currentCondition/tns1:valore,&amp;quot;','yyyy-MM-dd HH24:MI:SS')&amp;quot;),&amp;quot; AND &amp;quot;)  else if (upper-case($currentCondition/tns1:operazione)='ISNULL') then &amp;#xD;&amp;#xA;concat($currentCondition/tns1:nome,&amp;quot; IS NULL AND &amp;quot;)  else ''&quot;/>&lt;/condizione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($currentCondition/tns1:tipo)=('STRING') and $currentCondition/tns1:nome='TRO.STATO_RICH_OLO_GUI'&quot;>&lt;condizione>&lt;xsl:value-of select=&quot;if($currentCondition/tns1:operazione=('=','!=') ) then concat(&amp;quot;(&amp;quot;,$String ,&amp;quot; R.STATORICHIESTAOLO in (select distinct TRO.STATO_RICH_OLO from TIPOLG_RICH_COMSTOLO TRO where upper(TRO.STATO_RICH_OLO_GUI)&amp;quot;,$currentCondition/tns1:operazione,&amp;quot; '&amp;quot;,upper-case($currentCondition/tns1:valore),&amp;quot;')) AND &amp;quot;)&amp;#xD;&amp;#xA;else if (upper-case($currentCondition/tns1:operazione)='ISNULL') then &amp;#xD;&amp;#xA;concat($String ,&amp;quot; R.STATORICHIESTAOLO IS NULL AND &amp;quot;)&amp;#xD;&amp;#xA;else if (upper-case($currentCondition/tns1:operazione)='STARTWITH') then &amp;#xD;&amp;#xA;concat($String ,&amp;quot; R.STATORICHIESTAOLO in (select distinct TRO.STATO_RICH_OLO from TIPOLG_RICH_COMSTOLO TRO where upper(TRO.STATO_RICH_OLO_GUI)  like '&amp;quot;,upper-case($valoreString),&amp;quot;) AND &amp;quot;)&amp;#xD;&amp;#xA;else if (upper-case($currentCondition/tns1:operazione)='ENDWITH') then &amp;#xD;&amp;#xA;concat($String ,&amp;quot; R.STATORICHIESTAOLO in (select distinct TRO.STATO_RICH_OLO from TIPOLG_RICH_COMSTOLO TRO where upper(TRO.STATO_RICH_OLO_GUI)  like &amp;quot;,upper-case($valoreString),&amp;quot; AND &amp;quot;) else &amp;#xD;&amp;#xA; if (upper-case($currentCondition/tns1:operazione)='IN') then&amp;#xD;&amp;#xA;concat($String ,&amp;quot; R.STATORICHIESTAOLO in (select distinct TRO.STATO_RICH_OLO from TIPOLG_RICH_COMSTOLO TRO where upper(TRO.STATO_RICH_OLO_GUI)  in (&amp;quot;,$InCondition,&amp;quot;)) AND &amp;quot;) else  ''&quot;/>&lt;/condizione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($currentCondition/tns1:tipo)=('STRING')&quot;>&lt;condizione>&lt;xsl:value-of select=&quot;if($currentCondition/tns1:operazione=('=','!=') ) then concat(&amp;quot;(&amp;quot;,$String ,'upper(',$currentCondition/tns1:nome,&amp;quot;) &amp;quot;,$currentCondition/tns1:operazione,&amp;quot; '&amp;quot;,upper-case($currentCondition/tns1:valore),&amp;quot;') AND &amp;quot;)&amp;#xD;&amp;#xA;else if (upper-case($currentCondition/tns1:operazione)='ISNULL') then &amp;#xD;&amp;#xA;concat($String ,$currentCondition/tns1:nome,&amp;quot; IS NULL AND &amp;quot;)&amp;#xD;&amp;#xA;else if (upper-case($currentCondition/tns1:operazione)='STARTWITH') then &amp;#xD;&amp;#xA;concat($String ,'upper(',$currentCondition/tns1:nome,&amp;quot;) like '&amp;quot;,upper-case($valoreString),&amp;quot; AND &amp;quot;)&amp;#xD;&amp;#xA;else if (upper-case($currentCondition/tns1:operazione)='ENDWITH') then &amp;#xD;&amp;#xA;concat($String ,'upper(',$currentCondition/tns1:nome,&amp;quot;) like &amp;quot;,upper-case($valoreString),&amp;quot; AND &amp;quot;) else &amp;#xD;&amp;#xA; if (upper-case($currentCondition/tns1:operazione)='IN') then&amp;#xD;&amp;#xA;concat(&amp;quot;(&amp;quot;,$String ,'upper(',$currentCondition/tns1:nome,&amp;quot;) in (&amp;quot;,$InCondition,&amp;quot;)) AND &amp;quot;) else  ''&quot;/>&lt;/condizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;condizione>&lt;xsl:value-of select=&quot;if( $currentCondition/tns1:operazione=('=','>','>=','&amp;lt;=','&amp;lt;>','&amp;lt;','!=') ) then concat(&amp;quot;(&amp;quot;,$Number,$currentCondition/tns1:nome,&amp;quot; &amp;quot;,$currentCondition/tns1:operazione,&amp;quot; '&amp;quot;,$currentCondition/tns1:valore,&amp;quot;') AND &amp;quot;) else if (upper-case($currentCondition/tns1:operazione)='IN') then&amp;#xD;&amp;#xA;concat($Number,$currentCondition/tns1:nome,&amp;quot; in (&amp;quot;,$InCondition,&amp;quot;) AND &amp;quot;)  else if (upper-case($currentCondition/tns1:operazione)='ISNULL') then &amp;#xD;&amp;#xA;concat($Number,$currentCondition/tns1:nome,&amp;quot; IS NULL AND &amp;quot;)  else ''&quot;/>&lt;/condizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RicercaCondition>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
