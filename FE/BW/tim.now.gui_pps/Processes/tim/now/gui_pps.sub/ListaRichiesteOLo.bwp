                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/OloSchemas&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQueryConDataRichiesta&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:ListaRichiestaOloOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:dataInvioRichiesta)&quot;>&lt;xsl:for-each select=&quot;$JDBCQueryConDataRichiesta/Record&quot;>&lt;tns:outputListaRichiestaOloOutput>&lt;xsl:if test=&quot;$Start/tns:dataInvioRichiesta&quot;>&lt;tns:dataCreazioneRichiesta>&lt;xsl:value-of select=&quot;$Start/tns:dataInvioRichiesta&quot;/>&lt;/tns:dataCreazioneRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINETI&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:statoNOW>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:statoNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:statoOLO>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:statoOLO>&lt;/xsl:if>&lt;tns:DRO>&lt;xsl:value-of select=&quot;substring-before(string(DRO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DRO>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;tns:idrichiestaolo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idrichiestaolo>&lt;xsl:if test=&quot;AMBITO&quot;>&lt;tns:ambito>&lt;xsl:value-of select=&quot;AMBITO&quot;/>&lt;/tns:ambito>&lt;/xsl:if>&lt;xsl:if test=&quot;IDOFFERTA&quot;>&lt;tns:idOfferta>&lt;xsl:value-of select=&quot;IDOFFERTA&quot;/>&lt;/tns:idOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRICH_COM_STRC&quot;>&lt;tns:idStatoNow>&lt;xsl:value-of select=&quot;IDRICH_COM_STRC&quot;/>&lt;/tns:idStatoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:codiceOrdineOLO>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceOrdineOLO>&lt;/xsl:if>&lt;/tns:outputListaRichiestaOloOutput>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns:outputListaRichiestaOloOutput>&lt;xsl:if test=&quot;CODICEORDINETI&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:statoNOW>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:statoNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:statoOLO>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:statoOLO>&lt;/xsl:if>&lt;tns:DRO>&lt;xsl:value-of select=&quot;substring-before(string(DRO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DRO>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;tns:idrichiestaolo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idrichiestaolo>&lt;xsl:if test=&quot;AMBITO&quot;>&lt;tns:ambito>&lt;xsl:value-of select=&quot;AMBITO&quot;/>&lt;/tns:ambito>&lt;/xsl:if>&lt;xsl:if test=&quot;IDOFFERTA&quot;>&lt;tns:idOfferta>&lt;xsl:value-of select=&quot;IDOFFERTA&quot;/>&lt;/tns:idOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRICH_COM_STRC&quot;>&lt;tns:idStatoNow>&lt;xsl:value-of select=&quot;IDRICH_COM_STRC&quot;/>&lt;/tns:idStatoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:codiceOrdineOLO>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceOrdineOLO>&lt;/xsl:if>&lt;/tns:outputListaRichiestaOloOutput>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:ListaRichiestaOloOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="d94c47d8-6d21-49a4-a71c-327b33be8c3a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d94c47d8-6d21-49a4-a71c-327b33be8c3a+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.example.org/OloSchemas&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODIFICAOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codificaOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codificaOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODIFICAOLOAGCOM>&lt;CODIFICAOLONOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codificaOloNow)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codificaOloNow&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODIFICAOLONOW>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT bds.CODICEORDINEOLO,bds.CODICEORDINETI,bds.STATORICHIESTANOW,bds.STATORICHIESTAOLO,bds.IDRISORSA,&#xa;  bds.DRO,bds.OFFERTA,bds.IDRICHIESTAOLO,FO.descr AMBITO, bds.IDOFFERTA,B.IDRICH_COM_STRC&#xa;FROM BDS_1_CASEDATA_RICHIESTA bds &#xa;LEFT JOIN  OFFERTA O ON bds.IDOFFERTA=O.ID_OFFERTA   LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA=O.ID_FAMIG_OFFERTA &#xa;LEFT JOIN TIPOLG_RICH_COMSTNOW B  ON bds.STATORICHIESTANOW=B.stato_rich_now &#xa;WHERE AMBITO='NOW' AND TIPORICHIESTA='ORDINE' AND CODIFICAOLOAGCOM=? AND  &#xa;  CODIFICAOLONOW=? " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLONOW"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINETI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnName="DRO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="AMBITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDOFFERTA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRICH_COM_STRC"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryConDataRichiesta-input"
                    name="JDBCQueryConDataRichiesta"
                    outputVariable="JDBCQueryConDataRichiesta"
                    tibex:xpdlId="7c60707c-054f-4742-a1b0-6d27892a1f37" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQueryConDataRichiesta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryConDataRichiestaToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7c60707c-054f-4742-a1b0-6d27892a1f37+input&quot; xmlns:tns1=&quot;http://www.example.org/OloSchemas&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQueryConDataRichiesta-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODIFICAOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codificaOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:codificaOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODIFICAOLOAGCOM>&lt;CODIFICAOLONOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codificaOloNow)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:codificaOloNow&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODIFICAOLONOW>&lt;DATARICHIESTA>&lt;xsl:value-of select=&quot;string(format-date(xsd:date($Start/tns1:dataInvioRichiesta),&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&lt;/DATARICHIESTA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT bds.CODICEORDINEOLO,bds.CODICEORDINETI,bds.STATORICHIESTANOW,bds.STATORICHIESTAOLO,bds.IDRISORSA,&#xa;  bds.DRO,bds.OFFERTA,bds.IDRICHIESTAOLO,FO.descr AMBITO, bds.IDOFFERTA,B.IDRICH_COM_STRC,bds.DATAINVIORICHIESTA&#xa;FROM BDS_1_CASEDATA_RICHIESTA bds &#xa;LEFT JOIN  OFFERTA O ON bds.IDOFFERTA=O.ID_OFFERTA   LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA=O.ID_FAMIG_OFFERTA &#xa;LEFT JOIN TIPOLG_RICH_COMSTNOW B  ON bds.STATORICHIESTANOW=B.stato_rich_now &#xa;WHERE AMBITO='NOW' AND TIPORICHIESTA='ORDINE' AND CODIFICAOLOAGCOM=? AND  &#xa;  CODIFICAOLONOW=? AND bds.DATAINVIORICHIESTA=to_Date(?,'DD/MM/YY')" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLONOW"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DATARICHIESTA"/>
