            <xs:element name="InvalidEntityTypeFault" type="comex:DetailedException"/>
            <xs:element name="InvalidLDAPContainerFault" type="comex:DetailedException"/>
            <xs:element name="InvalidLDAPFault" type="comex:DetailedException"/>
            <xs:element name="InvalidLDAPResourceFault" type="comex:DetailedException"/>
            <xs:element name="InvalidLDAPSearchFault" type="comex:DetailedException"/>
            <xs:element name="InvalidLDAPSourceFault" type="comex:DetailedException"/>
            <xs:element name="InvalidModelImportFault" type="comex:DetailedException"/>
            <xs:element name="InvalidOrgModelVersionFault" type="comex:DetailedException"/>
            <xs:element name="InvalidQueryFault" type="comex:DetailedException"/>
            <xs:element name="InvalidResourceMappingFault" type="comex:DetailedException"/>
