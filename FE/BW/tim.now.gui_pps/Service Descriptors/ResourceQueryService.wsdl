            <xs:element name="OrgModelUndeploymentFault" type="comex:DetailedException"/>
            <xs:element name="PersistenceFault" type="comex:DetailedException">
                <xs:annotation>
                    <xs:documentation>Generic fault class, used to indicate an error raised by a
        Directory Engine service. The specific error can be determined by examining the
        error code contained within.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SecurityFault" type="comex:DetailedException">
                <xs:annotation>
                    <xs:documentation>The used to report all Security related faults. Including:
 + An attempt to check authorisation for an unknown System Action.
 + An attempt to check System Action authorisation for an unauthenicated user.
 + An attempt to perform an unauthorised System Action.</xs:documentation>
                </xs:annotation>
