<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/ListaFile" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/ListaFile">

    <element name="listaFile">
    	<complexType>
    		<sequence>
    			<element ref="tns:outputListaFile" maxOccurs="unbounded"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>


    <complexType name="outputListaFileType">
    	<sequence>
    		<element name="codiceOloNumerico" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="codificaOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="dataFile" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="descrizioneStatoFile" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="idFile" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="tipologiaFile" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="nomeFile" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="versoFile" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="esitoInvio" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="timestampCreazioneFile" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="timestampInvio" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <element name="outputListaFile" type="tns:outputListaFileType"></element>

</schema>