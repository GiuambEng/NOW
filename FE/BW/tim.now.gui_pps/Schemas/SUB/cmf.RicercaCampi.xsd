<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/RicercaCampi" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/RicercaCampi">

    <element name="inputRicercaCampi">
    	<complexType>
    		<sequence>
    			<element name="tipoLista" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>

    <element name="outputRicercaCampi">
    	<complexType>
    		<sequence>
    			<element name="outputRicercaCampi" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="nomeDB" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="tipoDato" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="label" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType></element>
</schema>