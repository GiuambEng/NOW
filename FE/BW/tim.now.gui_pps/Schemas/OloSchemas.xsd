<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/OloSchemas" elementFormDefault="qualified" targetNamespace="http://www.example.org/OloSchemas">

<element name="ListaOlo">
    <complexType>
    		<sequence>
                <element maxOccurs="unbounded" minOccurs="0" name="ListaOloOutput">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="olo" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="ragioneSociale" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="codiceOlo" type="string"/>
