    						</element>
    						<element maxOccurs="1" minOccurs="0" name="ordineTI" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="statoNOW" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="statoOLO" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="idRisorsaNow" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="DRO" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="idRisorsa" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="offerta" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="idrichiestaolo" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="ambito" type="string"/>
                            <element minOccurs="0" name="idOfferta" type="string"/>
                            <element minOccurs="0" name="idStatoNow" type="string"/>
                            <element minOccurs="0" name="codiceOrdineOLO" type="string"/>
                        </sequence>
    				</complexType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="result">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="details" type="string"/>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
     <element name="inputListaRichiesteOlo">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="codificaOloAgcom" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="codificaOloNow" type="string"/>
                <element minOccurs="0" name="dataInvioRichiesta" type="string"/>
            </sequence>
    	</complexType>
    </element>

</schema>
