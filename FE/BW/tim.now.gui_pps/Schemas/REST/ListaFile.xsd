<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/ListaFile" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/ListaFile">

    <element name="listaFile">
    	<complexType>
    		<sequence>
    			<element name="listaFileOutput" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codiceOloNumerico" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codificaOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="dataFile" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="descrizioneStatoFile" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idFile" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="tipologiaFile" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="nomeFile" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="versoFile" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="esitoInvio" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="timestampCreazioneFile"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="timestampInvio"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>

    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="listaFileOutputType"></complexType>
</schema>