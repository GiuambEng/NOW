<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/RinvioFile" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/RinvioFile">

    <element name="rinvioFile">
    	<complexType>
    		<sequence>
    			<element ref="tns:rinvioFileInput"></element>
    			<element ref="tns:rinvioFileOutput" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="rinvioFileInputType">
    	<sequence>
    		<element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="idFile" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="rinvioFileOutputType">
    	<sequence>
    		<element name="esito" maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="codice" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result" maxOccurs="1" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
    <element name="rinvioFileInput" type="tns:rinvioFileInputType"></element>
    <element name="rinvioFileOutput" type="tns:rinvioFileOutputType"></element>
</schema>