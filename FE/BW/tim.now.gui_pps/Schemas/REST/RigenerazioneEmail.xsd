<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RigenerazioneEmail" xmlns:tns="http://www.example.org/RigenerazioneEmail" elementFormDefault="qualified">

    <element name="Input_Rigenerazione_Email_RicercaAvanzata"
    	type="tns:Input_Rigenerazione_Email_RicercaAvanzata">
    </element>
    
    <complexType name="Input_Rigenerazione_Email_RicercaAvanzata">
    	<sequence>
    		<element name="numerorighe" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="indiceriga" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="exportRequest" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="strutturaCondition" maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="operazione" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="valore" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="tipo" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Input_Rigenerazione_Email"
    	type="tns:Input_Rigenerazione_Email">
    </element>
    
    <complexType name="Input_Rigenerazione_Email"></complexType>

    <element name="Output_Rig_Email_Richieste"
    	type="tns:Output_Rig_Email_Richieste">
    </element>
    
    <complexType name="Output_Rig_Email_Richieste">
    	<sequence>
    		<element name="Lista_Richieste" maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="dataInvio" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="codiceOrdineOao" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="ordineTI" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="tipoLavorazione" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="offerta" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="statoNow" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="statoOao" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="codificaOao" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="idRichiestaOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="idExportFile" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="code" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="details" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Output_Rig_Email_Notifiche"
    	type="tns:Output_Rig_Email_Notifiche">
    </element>
    
    <complexType name="Output_Rig_Email_Notifiche">
    	<sequence>
    		<element name="listaNotifiche" maxOccurs="unbounded"
    			minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="dataCreazione" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="codiceNotifica" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="codiceCausaleNow" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="codiceCausaleOao" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="destinatario" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="idNotifica" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>


    <element name="Output_Rigenerazione_Email"
    	type="tns:Output_Rigenerazione_Email">
    </element>
    
    <complexType name="Output_Rigenerazione_Email">
    	<sequence>
    		<element name="esito" maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="codice" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Input_Lista_Notifiche"
    	type="tns:Input_Lista_Notifiche">
    </element>
    
    <complexType name="Input_Lista_Notifiche">
    	<sequence>
    		<element name="listaNotifiche" maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="idNotifica" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="timestampInvio" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Mapper_Output" type="tns:Mapper_Output"></element>
    
    <complexType name="Mapper_Output">
    	<sequence>
    		<element name="mapperListOutput" type="tns:NewType"
    			maxOccurs="unbounded" minOccurs="0">
    		</element>
    	</sequence>
    </complexType>

    <complexType name="NewType">
    	<sequence>
    		<element name="codice" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="idMail" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="listaNotifiche" type="tns:listaNotifiche"></element>
    
    <complexType name="listaNotifiche">
    	<sequence>
    		<element name="idNotifica" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>