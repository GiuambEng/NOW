<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/MonitoraggioKODel103" xmlns:tns="http://www.example.org/MonitoraggioKODel103" elementFormDefault="qualified">

    <element name="MonitoraggioKODel103PostInput">
    	<complexType>
    		<sequence>
    			<element name="numerorighe" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="indiceriga" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
                <element name="exportRequest" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="strutturaCondition" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="nome" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="operazione" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="valore" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="MonitoraggioKODel103Output">
    	<complexType>
    		<sequence>
                <element name="listaMonitoraggioKO" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
                            <element name="dataCreazioneRichiesta" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="codificaOloAgcom" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="lavorazione" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="offerta" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="codiceOrdineOlo" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="codiceOrdineOloTarget" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="codiceOrdineTiTarget" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="idRisorsa" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="idAnagraficaCausale" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="descrizioneCausaleInterno" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="statoRichiestaNow" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="tmpacknpd103" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="dac" type="string" maxOccurs="1" minOccurs="0">
    			</element>
                            <element name="contenutoXmlOlo" type="string" maxOccurs="1" minOccurs="0">
    			</element>
    					</sequence>
    				</complexType>
                </element>
                <element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>