<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/visualizzazioneRicerca" xmlns:tns="http://www.example.org/visualizzazioneRicerca" elementFormDefault="qualified">

    <element name="visualizzazionericerca">
    	<complexType>
    		<sequence>
    			<element name="outputvisualizzazionericerca"
    				type="tns:outputvisualizzazionericerca" minOccurs="0" maxOccurs="unbounded">
    			</element>
                <element name="result" minOccurs="0" maxOccurs="1">
                	<complexType>
                		<sequence>
                			<element name="severity" type="string" minOccurs="0" maxOccurs="1"></element>
                			<element name="code" type="string" minOccurs="0" maxOccurs="1"></element>
                			<element name="details" type="string" minOccurs="0" maxOccurs="1"></element>
                		</sequence>
                	</complexType></element>
            </sequence>
    	</complexType></element>


    <complexType name="outputvisualizzazionericerca">
    	<sequence>
    		<element name="ambitoMonitoraggio" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="tipologiaReport" type="string" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>

    <element name="visualizzazionedettaglio">
    	<complexType>
    		<sequence>
    			<element name="outputvisualizzazionedettaglio" minOccurs="0" maxOccurs="1">
                    <complexType>
                    	<sequence>
                    		<element name="datafi_valid" type="string"
                    			minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="datainz_valid" type="string"
                    			minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="descr_soglia" type="string"
                    			minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="id_anag_caus" type="string"
                    			minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="id_famig_offerta"
                    			type="string" minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="id_offerta" type="string"
                    			minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="idrich_com_strc"
                    			type="string" minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="id_stato_file" type="string"
                    			minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="idtplg_lavrz" type="string"
                    			minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="idtplg_pps_soglia"
                    			type="string" minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="idtplg_sotto_lavrz"
                    			type="string" minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="nome_soglia" type="string"
                    			minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="valore_soglia" type="string"
                    			minOccurs="0" maxOccurs="1">
                    		</element>
                    		<element name="id_pps_soglia_analisi" type="string" maxOccurs="1" minOccurs="0"></element>
                    	</sequence>
                    </complexType>
    			</element>
    			<element name="result" minOccurs="0" maxOccurs="1">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" minOccurs="0" maxOccurs="1"></element>
                			<element name="code" type="string" minOccurs="0" maxOccurs="1"></element>
                			<element name="details" type="string" minOccurs="0" maxOccurs="1"></element>
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="editing">
    	<complexType>
    		<sequence>
    			<element name="result" minOccurs="0" maxOccurs="1">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" minOccurs="0" maxOccurs="1"></element>
    						<element name="code" type="string" minOccurs="0" maxOccurs="1"></element>
    						<element name="details" type="string" minOccurs="0" maxOccurs="1"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>


    <element name="inputediting">
    	<complexType>
    		<sequence>
    			<element name="valore_soglia" type="string"></element>
    			<element name="id_pps_soglia_analisi" type="string"></element>
    		</sequence>
    	</complexType></element>
</schema>