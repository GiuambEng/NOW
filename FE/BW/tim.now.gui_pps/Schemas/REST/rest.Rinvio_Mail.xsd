<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/Rinvio_Mail" xmlns:tns="http://www.tim.com/NOW/rest/Rinvio_Mail" elementFormDefault="qualified">


    <element name="Input_ListaMail">
    	<complexType>
    		<sequence>
    			<element name="listaEmail" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="idNotifica" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="timestampInvio" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Output_ListaMail">
    	<complexType>
    		<sequence>
    			<element name="ListaMail" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="DESTINATARIO_EMAIL_A"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="DESTINATARIO_EMAIL_CC"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="TIPOLOGIA_NOTIFICA"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="OGGETTO_DELLA_MAIL"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="DATA_INVIO" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="CONTENUTO_MAIL" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_NOTIFICA" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
                <element name="ID_ExportFile" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							minOccurs="0" maxOccurs="1">
    						</element>
    						<element name="code" type="string"
    							minOccurs="0" maxOccurs="1">
    						</element>
    						<element name="details" type="string"
    							minOccurs="0" maxOccurs="1">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Fault_ListaMail">
    	<complexType>
    		<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
    	</complexType>
    </element>

    <element name="Output_Post_Result">
    	<complexType>
    		<sequence>
							<element name="severity" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
							<element name="code" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
							<element name="details" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
						</sequence>
    	</complexType>
    </element>

    <element name="Output_RinvioMail" type="tns:Output_RinvioMail"></element>
    
    <complexType name="Output_RinvioMail">
    	<sequence>
            <element name="esito" type="tns:NewType" maxOccurs="unbounded" minOccurs="0"></element>
            <element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    					<element name="code" type="string" minOccurs="0"
    						maxOccurs="1">
    					</element>
    					<element name="details" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <complexType name="NewType">
    	<sequence>
    		<element name="codice" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="descrizione" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    	</sequence>
    </complexType>

    <element name="mapper_Output" type="tns:mapper_Output"></element>
    
    <complexType name="mapper_Output">
    	<sequence>
    		<element name="mapperListOutput" type="tns:NewType1"
    			maxOccurs="unbounded" minOccurs="0">
    		</element>
    	</sequence>
    </complexType>

    <complexType name="NewType1">
    	<sequence>
    		<element name="Codice" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Descrizione" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Id_Mail" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="Input_RicercaAvanzata"
    	type="tns:Input_RicercaAvanzata">
    </element>
    
    <complexType name="Input_RicercaAvanzata">
    	<sequence>
    		<element minOccurs="0" name="numerorighe" type="string" />
    		<element minOccurs="0" name="indiceriga" type="string" />
            <element name="exportRequest" type="string" maxOccurs="1" minOccurs="0"></element>
            <element maxOccurs="unbounded" minOccurs="0"
    			name="strutturaCondition">
    			<complexType>
    				<sequence>
    					<element minOccurs="0" name="nome"
    						type="string" />
    					<element minOccurs="0" name="operazione"
    						type="string" />
    					<element minOccurs="0" name="valore"
    						type="string" />
    					<element minOccurs="0" name="tipo"
    						type="string" />
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
    
    
</schema>