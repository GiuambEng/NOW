<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/visualizzazione_ambitomonitoraggio" xmlns:tns="http://www.example.org/visualizzazione_ambitomonitoraggio" elementFormDefault="qualified">

    <element name="Output_Visualizzazione_AmbitoMonitoraggio"
    	type="tns:Output_Visualizzazione_AmbitoMonitoraggio">
    </element>
    

    <element name="Fault_Visualizzazione_AmbitoMonitoraggio"
    	type="tns:Fault_Visualizzazione_AmbitoMonitoraggio">
    </element>
    
    <complexType name="Output_Visualizzazione_AmbitoMonitoraggio">
    	<sequence>
    		<element name="output_AmbitoMonitoraggio"
    			type="tns:output_AmbitoMonitoraggio" maxOccurs="unbounded"
    			minOccurs="0">
    		</element>
    		<element name="result" type="tns:result"></element>
    	</sequence>
    </complexType>


    <complexType name="result">
    	<sequence>
    					<element name="severity" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    					<element name="code" type="string" minOccurs="0"
    						maxOccurs="1">
    					</element>
    					<element name="details" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    				</sequence>
    </complexType>
    
    <complexType name="output_AmbitoMonitoraggio">
    	<sequence>
            <element name="Ambito_Monitoraggio" type="string" maxOccurs="1" minOccurs="0">
    		</element>
            <element name="ID_PPS_Ambito_Monitoraggio" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <complexType name="Fault_Visualizzazione_AmbitoMonitoraggio">
    	<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
    </complexType>
</schema>