<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/GuiAmministrazioneDati" xmlns:tns="http://www.example.org/GuiAmministrazioneDati" elementFormDefault="qualified">

    <element name="Output_Tipologia_Report"
    	type="tns:Output_Tipologia_Report">
    </element>

    <element name="Fault_Tipolgia_Report">
    	<complexType>
    		<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
    	</complexType>
    </element>
    
    <element name="Input_Tipolgia_Report"
    	type="tns:Input_Tipolgia_Report">
    </element>
    

    <complexType name="Output_Tipologia_Report">
    	<sequence>
    		<element name="Output_TipologiaReport"
    			type="tns:Output_TipologiaReport" maxOccurs="unbounded"
    			minOccurs="0">
    		</element>
    		<element name="result">
    			<complexType>
    			<sequence>
							<element name="severity" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
							<element name="code" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
							<element name="details" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
						</sequence>
    			
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <complexType name="Output_TipologiaReport">
    	<sequence>
    		<element name="ID_PPS_TIPOLG_REPORT" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="Tipologi_Report" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <complexType name="Input_Tipolgia_Report">
    	<sequence>
    		<element name="id_pps_ambitomonitoraggio" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="Input_visualizzazioneDettaglio"
    	type="tns:Input_visualizzazioneDettaglio">
    </element>

    <element name="Output_visualizzazioneDettaglio"
    	type="tns:Output_visualizzazioneDettaglio">
    </element>
    
    <complexType name="Output_visualizzazioneDettaglio">
    	<sequence>
    		<element name="Output_Visualizzazione_Dettaglio"
    			type="tns:Output_Visualizzazione_Dettaglio" maxOccurs="unbounded"
    			minOccurs="0">
    		</element>
    		<element name="result" type="tns:NewType"></element>
    	</sequence>
    </complexType>

    <complexType name="Output_Visualizzazione_Dettaglio">
    	<sequence>
    		<element name="Famiglia_Offerta" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Offerta" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Richiesta" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="StatoFile" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Lavorazione" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Sotto_Lavorazione" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="Causale" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Soglia" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Tipo_Soglia" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Valore" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Descrizione" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Inizio_Validita" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Fine_Validita" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="Id_Pps_Soglia_Analisi" type="string" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>
    
    <complexType name="NewType">
    	<sequence>
    					<element name="severity" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    					<element name="code" type="string" minOccurs="0"
    						maxOccurs="1">
    					</element>
    					<element name="details" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    				</sequence>
    </complexType>


    <element name="Input_Editing" type="tns:Input_Editing"></element>
    
    <complexType name="Input_Editing">
    	<sequence>
    		<element name="Input_EditingLista"
    			type="tns:Input_EditingLista">
    		</element>
    	</sequence>
    </complexType>

    <complexType name="Input_EditingLista">
    	<sequence>
    		<element name="Tipo_Soglia" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="Valore" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="Output_Editing" type="tns:Output_Editing"></element>
    
    <complexType name="Output_Editing">
    	<sequence>
    		<element name="result" type="tns:NewType1"></element>
    	</sequence>
    </complexType>

    <complexType name="NewType1">
    	<sequence>
    					<element name="severity" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    					<element name="code" type="string" minOccurs="0"
    						maxOccurs="1">
    					</element>
    					<element name="details" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    				</sequence>
    </complexType>

    <complexType name="Input_visualizzazioneDettaglio">
    	<sequence>
    		<element name="id_pps_ambitomonitoraggio" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="id_pps_tipolg_report" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="Output_Visualizzazione_AmbitoMonitoraggio"
    	type="tns:Output_Visualizzazione_AmbitoMonitoraggio">
    </element>
    
    <complexType name="Output_Visualizzazione_AmbitoMonitoraggio">
    	<sequence>
    		<element name="output_AmbitoMonitoraggio"
    			type="tns:output_AmbitoMonitoraggio" maxOccurs="unbounded" minOccurs="0">
    		</element>
    		<element name="result" type="tns:NewType2"></element>
    	</sequence>
    </complexType>

    <complexType name="output_AmbitoMonitoraggio">
    	<sequence>
            <element name="Ambito_Monitoraggio" type="string" maxOccurs="1" minOccurs="0">
    		</element>
            <element name="ID_PPS_Ambito_Monitoraggio" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="NewType2">
    	<sequence>
    					<element name="severity" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    					<element name="code" type="string" minOccurs="0"
    						maxOccurs="1">
    					</element>
    					<element name="details" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    				</sequence>
    </complexType>
</schema>