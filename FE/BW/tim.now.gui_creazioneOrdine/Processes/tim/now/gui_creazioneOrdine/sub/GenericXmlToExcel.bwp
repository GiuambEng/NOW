    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="952c32f1-f1a0-40c1-8268-778f6211e061">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="CallProcessToJDBCUpdate" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="CallProcess-input"
                                name="CallProcess"
                                tibex:xpdlId="9e8cf1b1-a318-4edb-ab2f-76d3a04e709e"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToJDBCUpdate"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerError&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;GenericXmlToExcel&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.sub.GenericXmlToExcel&amp;quot;&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat('ERRORLogGenericXMLToExcel: ',tib:render-xml($FaultDetails, true(), true()))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerError&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.sub.GenericXmlToExcel&amp;quot;&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns:Source>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:ErrorLog>&lt;tns:TimeStamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TimeStamp>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&lt;/tns:Descrizione>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&lt;/tns:Codice>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;/tns:ErrorLog>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    subProcessName="tim.now.gui_creazioneOrdine.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="JDBCUpdate-input"
                                name="JDBCUpdate"
                                outputVariable="JDBCUpdate"
                                tibex:xpdlId="0add6cd7-833a-41ed-b4bf-28592dec07a4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToJDBCUpdate"/>
                                </bpws:targets>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0add6cd7-833a-41ed-b4bf-28592dec07a4+input&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1470065396641&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($Start/tns1:idFile)&quot;/>&lt;/ID_FILE>&lt;ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/ESITO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO EXPORT_LISTA (ID_FILE,ESITO) VALUES (?,?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="xmlToExcelToEXPORT_LISTA_ORDINI" tibex:linkType="SUCCESS"/>
                <bpws:link name="EXPORT_LISTA_ORDINIToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="94aafad9-1870-4d06-a4e0-cc6c79f2da25"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets/>
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="acd3e392-b996-41cf-81f9-9827cd0db1fb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EXPORT_LISTA_ORDINIToEnd"/>
                    </bpws:targets>
                    <bpws:sources/>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="xmlToExcel-input"
                    name="xmlToExcel" outputVariable="xmlToExcel"
                    tibex:xpdlId="bf9bb173-21cd-4797-bc83-9172e53e5c25"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="xmlToExcelToEXPORT_LISTA_ORDINI"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1470065396641&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcel&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;xmlToExcel-input&quot; match=&quot;/&quot;>&lt;tns1:Input_XmlToExcel>&lt;tns1:xmlParameter>&lt;xsl:value-of select=&quot;$Start/tns:xmlParam&quot;/>&lt;/tns1:xmlParameter>&lt;tns1:listOfElements>&lt;xsl:value-of select=&quot;$Start/tns:listOfColumn&quot;/>&lt;/tns1:listOfElements>&lt;tns1:rootElementParameter>&lt;xsl:value-of select=&quot;$Start/tns:rootElement&quot;/>&lt;/tns1:rootElementParameter>&lt;tns1:NameOfFile>&lt;xsl:value-of select=&quot;$Start/tns:nameOfFile&quot;/>&lt;/tns1:NameOfFile>&lt;tns1:childrootElement>&lt;xsl:value-of select=&quot;$Start/tns:childElement&quot;/>&lt;/tns1:childrootElement>&lt;/tns1:Input_XmlToExcel>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.gui_creazioneOrdine.sub.XmlToExcel" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="EXPORT_LISTA_ORDINI-input"
                    name="EXPORT_LISTA_ORDINI"
                    outputVariable="EXPORT_LISTA_ORDINI"
                    tibex:xpdlId="8cfda31e-cb53-4077-bd7e-b00216cfd551" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="xmlToExcelToEXPORT_LISTA_ORDINI"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EXPORT_LISTA_ORDINIToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8cfda31e-cb53-4077-bd7e-b00216cfd551+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1470065396641&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;xmlToExcel&quot;/>&lt;xsl:template name=&quot;EXPORT_LISTA_ORDINI-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($Start/tns2:idFile)&quot;/>&lt;/ID_FILE>&lt;NOME_FILE>&lt;xsl:value-of select=&quot;concat($Start/tns2:nameOfFile,$Start/tns2:userId, &amp;quot;_&amp;quot;,xsd:string($Start/tns2:idFile),&amp;quot;.xls&amp;quot;)&quot;/>&lt;/NOME_FILE>&lt;CONTENUTO_FILE>&lt;xsl:value-of select=&quot;xsd:base64Binary($xmlToExcel)&quot;/>&lt;/CONTENUTO_FILE>&lt;ESITO>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ESITO>&lt;USERID>&lt;xsl:value-of select=&quot;$Start/tns2:userId&quot;/>&lt;/USERID>&lt;PROFILO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:tipoProfilo)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:tipoProfilo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PROFILO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO EXPORT_LISTA (ID_FILE,NOME_FILE,CONTENUTO_FILE,ESITO,USERID,PROFILO) VALUES (?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILE"/>
                                    <PreparedParameters
                                    DataType="2004"
                                    DataTypeDisplayValue="BLOB" ParameterName="CONTENUTO_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITO"/>
                                    <PreparedParameters
                                    DataType="12"
