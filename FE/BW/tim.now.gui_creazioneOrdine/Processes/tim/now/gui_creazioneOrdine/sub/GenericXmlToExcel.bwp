    <tibex:VariableDescriptor type="MemorySaving">
        <task name="xmlToExcel">
            <endingVariables>
                <variable>xmlToExcel-input</variable>
            </endingVariables>
        </task>
        <task name="EXPORT_LISTA_ORDINI">
            <endingVariables>
                <variable>EXPORT_LISTA_ORDINI-input</variable>
                <variable>EXPORT_LISTA_ORDINI</variable>
                <variable>xmlToExcel</variable>
            </endingVariables>
        </task>
        <task name="CallProcess">
            <endingVariables>
                <variable>CallProcess-input</variable>
                <variable>FaultDetails</variable>
                <variable>LoggerName</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="JDBCUpdate">
            <endingVariables>
                <variable>JDBCUpdate-input</variable>
                <variable>JDBCUpdate</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
