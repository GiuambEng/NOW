                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICE_OUTPUT, DESCRIZIONE_OUTPUT&#xa;FROM CONFIGURAZIONE_FRONTEND&#xa;WHERE FUNZIONE = ? AND (OFFERTA = ? OR OPZIONE_VARIAZIONE = ?)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codFunzione"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="offerta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="opzioneVar"/>
                                    <columnMetadata
                                    columnName="CODICE_OUTPUT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE_OUTPUT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Variable"
                    name="Configurazione" outputVariable="Variable"
                    tibex:xpdlId="567611ac-af3c-43bc-9cda-23fd8f974883" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToEnd"/>
                        <bpws:target linkName="RecuperoCodDescrServizioOrigineToConfigurazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/ConfigurazioneFE&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoCodDescr&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoCodDescrServizioOrigine&quot;/>&#xa;    &lt;xsl:param name=&quot;AttributiWLR&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:codFunzione = 'C11M08F38'&quot;>&#xa;                &lt;tns1:OutputConfigurazioneFE>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoCodDescr/Record&quot;>&#xa;                        &lt;tns1:outputConfigurazioneFE>&#xa;                            &lt;tns1:codice>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                            &lt;/tns1:codice>&#xa;                            &lt;tns1:descrizione>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                            &lt;/tns1:descrizione>&#xa;                        &lt;/tns1:outputConfigurazioneFE>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:OutputConfigurazioneFE>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:codFunzione = 'C11M08F39'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($Start/tns1:idOfferta = ('22','25')) and ($AttributiWLR/Record[NOMEATTRIBUTO = 'TIPOLINEA']/VALOREATTRIBUTO = 'ISDN') and (tib:trim($AttributiWLR/Record[NOMEATTRIBUTO = 'STRUTTURALINEA']/VALOREATTRIBUTO) = ('BRA MONO','BRA Mono'))&quot;>&#xa;                        &lt;tns1:OutputConfigurazioneFE>&#xa;                            &lt;xsl:for-each select=&quot;$RecuperoCodDescr/Record[CODICE_OUTPUT !='Attivazione STS']&quot;>&#xa;                                &lt;tns1:outputConfigurazioneFE>&#xa;                                    &lt;tns1:codice>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                                    &lt;/tns1:codice>&#xa;                                    &lt;tns1:descrizione>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                                    &lt;/tns1:descrizione>&#xa;                                &lt;/tns1:outputConfigurazioneFE>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns1:OutputConfigurazioneFE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:OutputConfigurazioneFE>&#xa;                            &lt;xsl:for-each select=&quot;$RecuperoCodDescr/Record&quot;>&#xa;                                &lt;tns1:outputConfigurazioneFE>&#xa;                                    &lt;tns1:codice>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                                    &lt;/tns1:codice>&#xa;                                    &lt;tns1:descrizione>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                                    &lt;/tns1:descrizione>&#xa;                                &lt;/tns1:outputConfigurazioneFE>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns1:OutputConfigurazioneFE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:codFunzione = 'C11M08F43'&quot;>&#xa;                &lt;tns1:OutputConfigurazioneFE>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoCodDescr/Record&quot;>&#xa;                        &lt;tns1:outputConfigurazioneFE>&#xa;                            &lt;tns1:codice>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                            &lt;/tns1:codice>&#xa;                            &lt;tns1:descrizione>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                            &lt;/tns1:descrizione>&#xa;                        &lt;/tns1:outputConfigurazioneFE>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:OutputConfigurazioneFE>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:codFunzione = 'C11M08F46'&quot;>&#xa;                &lt;tns1:OutputConfigurazioneFE>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoCodDescrServizioOrigine/Record&quot;>&#xa;                        &lt;tns1:outputConfigurazioneFE>&#xa;                            &lt;tns1:codice>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                            &lt;/tns1:codice>&#xa;                            &lt;tns1:descrizione>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                            &lt;/tns1:descrizione>&#xa;                            &lt;xsl:if test=&quot;LNA_LA&quot;>&#xa;                                &lt;tns1:lna_la>&#xa;                                    &lt;xsl:value-of select=&quot;LNA_LA&quot;/>&#xa;                                &lt;/tns1:lna_la>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:outputConfigurazioneFE>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:OutputConfigurazioneFE>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns1:codFunzione = 'C11M08F51'&quot;>&#xa;                &lt;tns1:OutputConfigurazioneFE>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoCodDescr/Record&quot;>&#xa;                        &lt;tns1:outputConfigurazioneFE>&#xa;                            &lt;tns1:codice>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_OUTPUT&quot;/>&#xa;                            &lt;/tns1:codice>&#xa;                            &lt;xsl:if test=&quot;DESCRIZIONE_OUTPUT&quot;>&#xa;                                &lt;tns1:descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;DESCRIZIONE_OUTPUT&quot;/>&#xa;                                &lt;/tns1:descrizione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:outputConfigurazioneFE>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:OutputConfigurazioneFE>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:OutputConfigurazioneFE/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperoCodDescrServizioOrigine-input"
                    name="RecuperoCodDescrServizioOrigine"
                    outputVariable="RecuperoCodDescrServizioOrigine"
                    tibex:xpdlId="f8f5c91c-f822-484b-a9e1-354682e75b1b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery_ServizioOrigine"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperoCodDescrServizioOrigineToConfigurazione"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f8f5c91c-f822-484b-a9e1-354682e75b1b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/ConfigurazioneFE&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoCodDescrServizioOrigine-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codFunzione>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:codFunzione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:codFunzione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codFunzione>&#xa;            &lt;offerta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/offerta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns1:opzioneVariazione = 'Cambio Canali (Incremento/Decremento Canali)'&quot;>&#xa;                    &lt;opzioneVar>&#xa;                        &lt;xsl:value-of select=&quot;'Cambio Canali'&quot;/>&#xa;                    &lt;/opzioneVar>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;opzioneVar>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:opzioneVariazione)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:opzioneVariazione&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/opzioneVar>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICE_OUTPUT, DESCRIZIONE_OUTPUT, LNA_LA&#xa;FROM CONFIGURAZIONE_FRONTEND&#xa;WHERE FUNZIONE = ? AND OFFERTA = ? AND OPZIONE_VARIAZIONE = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codFunzione"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="offerta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="opzioneVar"/>
                                    <columnMetadata
                                    columnName="CODICE_OUTPUT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE_OUTPUT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="LNA_LA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AttributiWLR-input"
                    name="AttributiWLR" outputVariable="AttributiWLR"
                    tibex:xpdlId="44eed9c6-f869-4b05-9667-c3a92ddb9f1a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery"/>
