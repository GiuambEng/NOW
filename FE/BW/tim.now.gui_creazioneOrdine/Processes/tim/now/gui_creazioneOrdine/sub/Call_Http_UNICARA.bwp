    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>ValidateHTTPResponse</variable>
            </endingVariables>
        </task>
        <task name="ValidateServiceRequest">
            <endingVariables>
                <variable>ValidateServiceRequest-input</variable>
                <variable>Start</variable>
            </endingVariables>
        </task>
        <task name="ValidateHTTPResponse">
            <endingVariables>
                <variable>ValidateHTTPResponse-input</variable>
                <variable>AddNamespaces</variable>
            </endingVariables>
        </task>
        <task name="AddNamespaces">
            <endingVariables>
                <variable>AddNamespaces-input</variable>
                <variable>SendHTTPRequest</variable>
            </endingVariables>
        </task>
        <task name="RemoveNamespaces">
            <endingVariables>
                <variable>RemoveNamespaces-input</variable>
                <variable>ValidateServiceRequest</variable>
            </endingVariables>
        </task>
        <task name="SendHTTPRequest">
            <endingVariables>
                <variable>SendHTTPRequest-input</variable>
                <variable>RemoveNamespaces</variable>
                <variable>Uri</variable>
                <variable>Port</variable>
                <variable>Host</variable>
            </endingVariables>
        </task>
        <task name="InputUnicaRA">
            <endingVariables>
                <variable>InputUnicaRA-input</variable>
            </endingVariables>
        </task>
        <task name="LogOutputUnicaRA">
            <endingVariables>
                <variable>LogOutputUnicaRA-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
