    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQuery1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToEnd1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
