                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery1ToEnd"/>
                        <bpws:target linkName="JDBCQueryToEnd1"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/nuovoContratto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ContrattoGiàEsistente&quot;/>&lt;xsl:param name=&quot;FULLGPONPLUS&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:outputVerificheContrattiFULLGPONPLUS>&lt;xsl:choose>&lt;xsl:when test=&quot;$ContrattoGiàEsistente/Record[1]/CONTEGGIO>0&quot;>&lt;tns1:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$FULLGPONPLUS/Record[1]/CONTEGGIO>0&quot;>&lt;tns1:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$ContrattoGiàEsistente/Record[1]/CONTEGGIO>0&quot;>&lt;tns1:message>&lt;xsl:value-of select=&quot;'Esiste già un contratto per questa offerta per questo OLO'&quot;/>&lt;/tns1:message>&lt;/xsl:when>&lt;xsl:when test=&quot;$FULLGPONPLUS/Record[1]/CONTEGGIO>0&quot;>&lt;tns1:message>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:fullGponPlus='Y'&quot;>&lt;tns1:message>&lt;xsl:value-of select=&quot;'Contratto FULLGPONPLUS non caricabile in assenza di contratto VULA attivo'&quot;/>&lt;/tns1:message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:message>&lt;xsl:value-of select=&quot;'Contratto FULLGPONPLUSNGA non caricabile in assenza contratto Bitstream NGA attivo'&quot;/>&lt;/tns1:message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:outputVerificheContrattiFULLGPONPLUS>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ContrattoGiàEsistente-input"
                    name="ContrattoGiàEsistente"
                    outputVariable="ContrattoGiàEsistente"
                    tibex:xpdlId="cc389342-2367-4c84-9bb8-eaaba0c8a676" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToEnd1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ContrattoGiàEsistenteToFULLGPONPLUS">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$ContrattoGiàEsistente/Record[1]/CONTEGGIO = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ContrattoGiàEsistente/Record[1]/CONTEGGIO = 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cc389342-2367-4c84-9bb8-eaaba0c8a676+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/nuovoContratto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ContrattoGiàEsistente-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:fullGponPlus='Y'&quot;>&lt;idOfferta>&lt;xsl:value-of select=&quot;'77'&quot;/>&lt;/idOfferta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idOfferta>&lt;xsl:value-of select=&quot;'78'&quot;/>&lt;/idOfferta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codOloAgcom>&lt;xsl:value-of select=&quot;$Start/tns1:codOloAgcom&quot;/>&lt;/codOloAgcom>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*) AS CONTEGGIO&#xa;  FROM CONTRATTO_OFFERTA_CATLG COC INNER JOIN CONTRATTO C ON COC.ID_CONTRATTO = C.ID_CONTRATTO&#xa;  WHERE COC.ID_OFFERTA = ?&#xa;  AND C.DATAFI_VALID>=SYSDATE &#xa;  AND C.DATAINZ_VALID&lt;=SYSDATE&#xa;  AND C.CODFC_OLO_AGCOM = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idOfferta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CONTEGGIO"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="FULLGPONPLUS-input"
                    name="FULLGPONPLUS" outputVariable="FULLGPONPLUS"
                    tibex:xpdlId="2eb68013-9e2d-43ec-84e9-1e1bc016555d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ContrattoGiàEsistenteToFULLGPONPLUS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2eb68013-9e2d-43ec-84e9-1e1bc016555d+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/nuovoContratto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;FULLGPONPLUS-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:fullGponPlus='Y'&quot;>&lt;idOfferta>&lt;xsl:value-of select=&quot;18&quot;/>&lt;/idOfferta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idOfferta>&lt;xsl:value-of select=&quot;16&quot;/>&lt;/idOfferta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codOloAgcom>&lt;xsl:value-of select=&quot;$Start/tns1:codOloAgcom&quot;/>&lt;/codOloAgcom>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*) AS CONTEGGIO&#xa;  FROM CONTRATTO_OFFERTA_CATLG COC INNER JOIN CONTRATTO C ON COC.ID_CONTRATTO = C.ID_CONTRATTO&#xa;  WHERE COC.ID_OFFERTA = ? &#xa;  AND C.DATAFI_VALID>=SYSDATE &#xa;  AND C.DATAINZ_VALID&lt;=SYSDATE&#xa;  AND C.CODFC_OLO_AGCOM = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idOfferta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CONTEGGIO"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
