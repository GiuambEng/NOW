                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToEasyipQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/tns:semiEasyIp = 'Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/tns:semiEasyIp = 'Y']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToBtsQuery">
