                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/tns:semiBitstream = 'Y']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToVulaQuery">
