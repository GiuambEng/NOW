    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/cmf/nuovoContratto"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="tns:inputVerificheContrattiSemi"
            name="Start" sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="tns:outputVerificheContrattiSemi"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="esito" type="xsd:boolean">
            <bpws:from>
                <bpws:literal>true</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource"
            tibex:propertySource="/Connections/JDBC/JDBCConntection" type="xsd:string"/>
        <bpws:variable element="ns0:jdbcQueryActivityInput"
            name="VulaQuery-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:resultSet" name="VulaQuery" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:jdbcQueryActivityInput"
            name="BtsQuery-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:resultSet" name="BtsQuery" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:jdbcQueryActivityInput"
            name="EasyipQuery-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:resultSet" name="EasyipQuery" sca-bpel:internal="true"/>
        <bpws:variable name="TimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/JDBC/TimeOut" type="xsd:int"/>
        <bpws:variable name="MaxRows" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/JDBC/MaxRows" type="xsd:int"/>
        <bpws:variable name="boolVula" type="xsd:boolean">
            <bpws:from>
                <bpws:literal>true</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="boolEasyip" type="xsd:boolean">
            <bpws:from>
                <bpws:literal>true</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="boolBts" type="xsd:boolean">
            <bpws:from>
                <bpws:literal>true</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns6:jdbcQueryActivityInput"
            name="ContrattoGiaEsistente-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:resultSet"
            name="ContrattoGiaEsistente" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
