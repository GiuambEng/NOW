        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="EmptyToVulaQuery" tibex:label="vula" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToBtsQuery" tibex:label="bts" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToEasyipQuery"
                    tibex:label="easyip" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="VulaQueryToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="EasyipQueryToAssign2" tibex:linkType="SUCCESS"/>
                <bpws:link name="BtsQueryToAssign1" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign2ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToContrattoGiaEsistente" tibex:linkType="SUCCESS"/>
                <bpws:link name="ContrattoGiaEsistenteToEmpty" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ContrattoGiaEsistenteToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="ee686a92-8517-4cca-bd8d-c1b5b3590f60"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToContrattoGiaEsistente"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="ca604a84-171b-45ca-b1bd-fe8c8d116733" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToEnd"/>
                        <bpws:target linkName="AssignToEnd"/>
                        <bpws:target linkName="Assign1ToEnd"/>
                        <bpws:target linkName="Assign2ToEnd"/>
                        <bpws:target linkName="ContrattoGiaEsistenteToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/nuovoContratto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;boolVula&quot;/>&lt;xsl:param name=&quot;boolEasyip&quot;/>&lt;xsl:param name=&quot;boolBts&quot;/>&lt;xsl:param name=&quot;ContrattoGiaEsistente&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:outputVerificheContrattiSemi>&lt;xsl:choose>&lt;xsl:when test=&quot;$ContrattoGiaEsistente/Record[1]/CONTEGGIO>0&quot;>&lt;tns:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:esito>&lt;/xsl:when>&lt;xsl:when test=&quot;($boolVula=true()) and ($boolEasyip = true()) and ($boolBts=true()) &quot;>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$ContrattoGiaEsistente/Record[1]/CONTEGGIO>0&quot;>&lt;tns:message>&lt;xsl:value-of select=&quot;'Esiste già un contratto per questa offerta per questo OLO'&quot;/>&lt;/tns:message>&lt;/xsl:when>&lt;xsl:when test=&quot;($boolVula=true()) and ($boolEasyip = true()) and ($boolBts=true()) &quot;>&lt;tns:message>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:message>&lt;xsl:value-of select=&quot;'Contratto per servizio non stipulato dal Service Provider'&quot;/>&lt;/tns:message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:outputVerificheContrattiSemi>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
