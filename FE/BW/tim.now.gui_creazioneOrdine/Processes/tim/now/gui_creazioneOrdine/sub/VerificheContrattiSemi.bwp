                                expression="$Start/tns:semiVula='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/tns:semiVula='Y']]></bpws:transitionCondition>
                    </bpws:source>
