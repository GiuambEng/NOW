                                tibex:group="groupStart" tibex:xpdlId="07c3a4fa-9316-4794-9ef5-871112a40a70">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToEmpty"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="3610ccec-cbda-4581-95db-9f3bc79ad6f4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToAccumulate"/>
                                    <bpws:target linkName="Assign1ToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty" tibex:xpdlId="91b60bac-e293-450d-afc9-3735e348e825">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToJavaInvoke1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($Start/ns0:listaRichieste[$index]/ns0:xml, &quot;&lt;TelefonoFissoReferente>&quot;) and upper-case($Start/ns0:listaRichieste[$index]/ns0:lavorazione) = &quot;INTERRUZIONESOSPENSIONE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($Start/ns0:listaRichieste[$index]/ns0:xml, "<TelefonoFissoReferente>") and upper-case($Start/ns0:listaRichieste[$index]/ns0:lavorazione) = "INTERRUZIONESOSPENSIONE"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToJavaInvoke">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($Start/ns0:listaRichieste[$index]/ns0:xml, &quot;&lt;TelefonoMobileReferente>&quot;) and upper-case($Start/ns0:listaRichieste[$index]/ns0:lavorazione) = &quot;INTERRUZIONESOSPENSIONE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($Start/ns0:listaRichieste[$index]/ns0:xml, "<TelefonoMobileReferente>") and upper-case($Start/ns0:listaRichieste[$index]/ns0:lavorazione) = "INTERRUZIONESOSPENSIONE"]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="TokenMobile-input"
                                    name="TokenMobile"
                                    outputVariable="TokenMobile"
                                    tibex:xpdlId="1f845565-02c7-4c95-8b63-a2f7b2836d9f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
