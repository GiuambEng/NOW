    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>Start</variable>
                <variable>Accumulate</variable>
            </endingVariables>
        </task>
        <task name="While">
            <endingVariables>
                <variable>Mapper</variable>
            </endingVariables>
        </task>
        <task name="Accumulate">
            <endingVariables>
                <variable>Invoke</variable>
            </endingVariables>
        </task>
        <task name="TokenMobile">
            <endingVariables>
                <variable>TokenMobile-input</variable>
            </endingVariables>
        </task>
        <task name="TokenFisso">
            <endingVariables>
                <variable>TokenFisso-input</variable>
            </endingVariables>
        </task>
        <task name="Mapper">
            <endingVariables>
                <variable>Mapper-input</variable>
                <variable>TokenMobile</variable>
                <variable>TokenFisso</variable>
            </endingVariables>
        </task>
        <task name="Invoke">
            <endingVariables>
                <variable>Invoke-input</variable>
            </endingVariables>
        </task>
        <task name="ReplaceNumero">
            <endingVariables>
                <variable>ReplaceNumero-input</variable>
            </endingVariables>
        </task>
        <task name="ReplaceMobile">
            <endingVariables>
                <variable>ReplaceMobile-input</variable>
            </endingVariables>
        </task>
        <task name="ReplaceFisso">
            <endingVariables>
                <variable>ReplaceFisso-input</variable>
                <variable>ReplaceMobile</variable>
            </endingVariables>
        </task>
        <task name="Assign2">
            <endingVariables>
                <variable>ReplaceNumero</variable>
            </endingVariables>
        </task>
        <task name="Assign3">
            <endingVariables>
                <variable>ReplaceFisso</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
