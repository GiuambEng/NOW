                                <bpws:link name="InvokeToEmpty2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="InvokeToAssign1_KO"
                                    tibex:label="KO" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="ReplaceNumeroToAssign2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ReplaceFissoToAssign3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign2ToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign3ToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToAccumulate" tibex:linkType="SUCCESS"/>
                            </bpws:links>
