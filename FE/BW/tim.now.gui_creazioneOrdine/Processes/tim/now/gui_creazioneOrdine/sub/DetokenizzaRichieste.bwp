                                <bpws:link name="TokenMobileToEmpty1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="TokenFissoToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty1ToInvoke" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty2ToReplaceMobile" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty2ToReplaceNumero" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
