                    <bpws:targets>
                        <bpws:target linkName="WhileToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Tokenizzazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;esitoOk&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:outputDetokenizzaRichieste>&lt;xsl:choose>&lt;xsl:when test=&quot;$index&amp;lt;=count($Start/tns:listaRichieste/tns:xml) or $esitoOk = false()&quot;>&lt;xsl:for-each select=&quot;$Start/tns:listaRichieste&quot;>&lt;tns:listaXml>&lt;xsl:if test=&quot;tns:codRichiestaOlo&quot;>&lt;tns:codRichiestaOao>&lt;xsl:value-of select=&quot;tns:codRichiestaOlo&quot;/>&lt;/tns:codRichiestaOao>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:xml&quot;>&lt;tns:xml>&lt;xsl:value-of select=&quot;tns:xml&quot;/>&lt;/tns:xml>&lt;/xsl:if>&lt;/tns:listaXml>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Accumulate/tns:xmlDetokenizzato&quot;>&lt;tns:listaXml>&lt;xsl:if test=&quot;tns:codRichiestaOao&quot;>&lt;tns:codRichiestaOao>&lt;xsl:value-of select=&quot;tns:codRichiestaOao&quot;/>&lt;/tns:codRichiestaOao>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:xml&quot;>&lt;tns:xml>&lt;xsl:value-of select=&quot;tns:xml&quot;/>&lt;/tns:xml>&lt;/xsl:if>&lt;/tns:listaXml>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:outputDetokenizzaRichieste>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="74418632-4868-4b3e-ac50-10657732ddbe">
                <bpws:targets>
                    <bpws:target linkName="StartToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit"
                        tibex:xpdlId="3cb88f6f-a3b8-4512-8c90-5eb680d8078a" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+3610ccec-cbda-4581-95db-9f3bc79ad6f4" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Start/ns0:listaRichieste/ns0:xml) and $esitoOk = true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns0:listaRichieste/ns0:xml) and $esitoOk = true()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToEmpty" tibex:linkType="SUCCESS"/>
                                <bpws:link name="EmptyToJavaInvoke1" tibex:linkType="SUCCESSWITHCONDITION"/>
