                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Ricariche&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OLORicariche&quot;/>&lt;xsl:template name=&quot;exportListaRicariche&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OLORicariche/unknownResultset/row/column[name = &amp;quot;IDASSET&amp;quot;]/value) and string-length(string($OLORicariche/unknownResultset/row/column[name = &amp;quot;IDASSET&amp;quot;]/value)) > 0&quot;>&lt;tns:Export_ListaRicariche>&lt;xsl:for-each select=&quot;$OLORicariche/unknownResultset/row&quot;>&lt;tns:Lista_Ricariche>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLOAGCOM']/value)&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLOAGCOM']/value&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDRISORSA']/value)&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;column[name='IDRISORSA']/value&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name='DATAINIZIO']/value), &amp;quot;.&amp;quot;) and exists(column[name='DATAINIZIO']/value) and string-length(string(column[name='DATAINIZIO']/value))>0&quot;>&lt;tns:dataInizioRicarica>&lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='DATAINIZIO']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='DATAINIZIO']/value), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInizioRicarica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string(column[name='DATAINIZIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DATAINIZIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DATAINIZIO']/value)&quot;>&lt;tns:dataInizioRicarica>&lt;xsl:value-of select=&quot;column[name='DATAINIZIO']/value&quot;/>&lt;/tns:dataInizioRicarica>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name='DATAFINE']/value), &amp;quot;.&amp;quot;) and exists(column[name='DATAFINE']/value) and string-length(string(column[name='DATAFINE']/value))>0&quot;>&lt;tns:dataFineRicarica>&lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='DATAFINE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='DATAFINE']/value), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataFineRicarica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string(column[name='DATAFINE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DATAFINE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DATAFINE']/value)&quot;>&lt;tns:dataFineRicarica>&lt;xsl:value-of select=&quot;column[name='DATAFINE']/value&quot;/>&lt;/tns:dataFineRicarica>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(column[name='TIPOLOGIARICARICA']/value)&quot;>&lt;xsl:if test=&quot;not((string(column[name='TIPOLOGIARICARICA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLOGIARICARICA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLOGIARICARICA']/value)&quot;>&lt;tns:taglioRicaricaInGiorni>&lt;xsl:value-of select=&quot;column[name='TIPOLOGIARICARICA']/value&quot;/>&lt;/tns:taglioRicaricaInGiorni>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATOASSET']/value)&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;column[name='STATOASSET']/value&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FAMIGLIAASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FAMIGLIAASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FAMIGLIAASSET']/value)&quot;>&lt;tns:tipologiaAccensioneRicarica>&lt;xsl:value-of select=&quot;column[name='FAMIGLIAASSET']/value&quot;/>&lt;/tns:tipologiaAccensioneRicarica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name='LASTUPDATE']/value), &amp;quot;.&amp;quot;) and exists(column[name='LASTUPDATE']/value) and string-length(string(column[name='LASTUPDATE']/value))>0&quot;>&lt;tns:ultimoAggiornamento>&lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='LASTUPDATE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='LASTUPDATE']/value), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:ultimoAggiornamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string(column[name='LASTUPDATE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='LASTUPDATE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='LASTUPDATE']/value)&quot;>&lt;tns:ultimoAggiornamento>&lt;xsl:value-of select=&quot;column[name='LASTUPDATE']/value&quot;/>&lt;/tns:ultimoAggiornamento>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name='DATAANNULLAMENTO']/value), &amp;quot;.&amp;quot;) and exists(column[name='DATAANNULLAMENTO']/value) and string-length(string(column[name='DATAANNULLAMENTO']/value))>0&quot;>&lt;tns:dataAnnullamento>&lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='DATAANNULLAMENTO']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='DATAANNULLAMENTO']/value), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataAnnullamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string(column[name='DATAANNULLAMENTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DATAANNULLAMENTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DATAANNULLAMENTO']/value)&quot;>&lt;tns:dataAnnullamento>&lt;xsl:value-of select=&quot;column[name='DATAANNULLAMENTO']/value&quot;/>&lt;/tns:dataAnnullamento>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string(column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OPERATORE']/value)&quot;>&lt;tns:userId>&lt;xsl:value-of select=&quot;column[name='OPERATORE']/value&quot;/>&lt;/tns:userId>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name='CREATED']/value), &amp;quot;.&amp;quot;) and exists(column[name='CREATED']/value) and string-length(string(column[name='CREATED']/value))>0&quot;>&lt;tns:dataInserimentoRichiesta>&lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='CREATED']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='CREATED']/value), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInserimentoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string(column[name='CREATED']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CREATED']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CREATED']/value)&quot;>&lt;tns:dataInserimentoRichiesta>&lt;xsl:value-of select=&quot;column[name='CREATED']/value&quot;/>&lt;/tns:dataInserimentoRichiesta>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string(column[name='IDASSETRICARICA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDASSETRICARICA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDASSETRICARICA']/value)&quot;>&lt;tns:idAssetRicarica>&lt;xsl:value-of select=&quot;column[name='IDASSETRICARICA']/value&quot;/>&lt;/tns:idAssetRicarica>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATOASSETDINAMICO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATOASSETDINAMICO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATOASSETDINAMICO']/value)&quot;>&lt;tns:statoAssetDinamico>&lt;xsl:value-of select=&quot;column[name='STATOASSETDINAMICO']/value&quot;/>&lt;/tns:statoAssetDinamico>&lt;/xsl:if>&lt;/tns:Lista_Ricariche>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Export_ListaRicariche>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Export_ListaRicariche>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun elemento trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:Export_ListaRicariche>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
