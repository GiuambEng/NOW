                        subProcessName="tim.now.gui_creazioneOrdine.sub.GenericXmlToExcel" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="exportListaRicariche"
                    name="AssignNoOLORicaricheQuery"
                    outputVariable="exportListaRicariche"
                    tibex:xpdlId="177e523a-e360-46ea-b6c8-cb8e19d497af" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCNoOLORicaricheQueryToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEmpty3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Ricariche&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCNoOLORicaricheQuery&quot;/>&lt;xsl:template name=&quot;exportListaRicariche&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCNoOLORicaricheQuery/Record/IDASSET) and string-length(string($JDBCNoOLORicaricheQuery/Record[1]/IDASSET))>0&quot;>&lt;tns:Export_ListaRicariche>&lt;xsl:for-each select=&quot;$JDBCNoOLORicaricheQuery/Record&quot;>&lt;tns:Lista_Ricariche>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(DATAINIZIO), &amp;quot;.&amp;quot;) and exists(DATAINIZIO) and string-length(xsd:string(DATAINIZIO))>0&quot;>&lt;tns:dataInizioRicarica>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATAINIZIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAINIZIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInizioRicarica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DATAINIZIO&quot;>&lt;tns:dataInizioRicarica>&lt;xsl:value-of select=&quot;DATAINIZIO&quot;/>&lt;/tns:dataInizioRicarica>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(DATAFINE), &amp;quot;.&amp;quot;) and exists(DATAFINE) and string-length(xsd:string(DATAFINE))>0&quot;>&lt;tns:dataFineRicarica>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATAFINE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAFINE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataFineRicarica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DATAFINE&quot;>&lt;tns:dataFineRicarica>&lt;xsl:value-of select=&quot;DATAFINE&quot;/>&lt;/tns:dataFineRicarica>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(TIPOLOGIARICARICA)&quot;>&lt;xsl:if test=&quot;TIPOLOGIARICARICA&quot;>&lt;tns:taglioRicaricaInGiorni>&lt;xsl:value-of select=&quot;TIPOLOGIARICARICA&quot;/>&lt;/tns:taglioRicaricaInGiorni>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;STATOASSET&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;xsl:if test=&quot;FAMIGLIAASSET&quot;>&lt;tns:tipologiaAccensioneRicarica>&lt;xsl:value-of select=&quot;FAMIGLIAASSET&quot;/>&lt;/tns:tipologiaAccensioneRicarica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(LASTUPDATE), &amp;quot;.&amp;quot;) and exists(LASTUPDATE) and string-length(xsd:string(LASTUPDATE))>0&quot;>&lt;tns:ultimoAggiornamento>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(LASTUPDATE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(LASTUPDATE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:ultimoAggiornamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;LASTUPDATE&quot;>&lt;tns:ultimoAggiornamento>&lt;xsl:value-of select=&quot;LASTUPDATE&quot;/>&lt;/tns:ultimoAggiornamento>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(DATAANNULLAMENTO), &amp;quot;.&amp;quot;) and exists(DATAANNULLAMENTO) and string-length(xsd:string(DATAANNULLAMENTO))>0&quot;>&lt;tns:dataAnnullamento>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATAANNULLAMENTO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAANNULLAMENTO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataAnnullamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DATAANNULLAMENTO&quot;>&lt;tn