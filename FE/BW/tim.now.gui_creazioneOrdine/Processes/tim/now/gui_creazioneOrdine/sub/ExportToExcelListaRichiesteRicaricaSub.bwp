                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Ricariche&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;exportListaRicariche&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Profile&quot;/>&lt;xsl:param name=&quot;NonOLORicariche&quot;/>&lt;xsl:param name=&quot;JDBCNoOLORicaricheQuery&quot;/>&lt;xsl:param name=&quot;OLORicariche&quot;/>&lt;xsl:param name=&quot;JDBCOLOricaricheQuery&quot;/>&lt;xsl:template name=&quot;MapperListaRicaricheRicercaAvanzata-input&quot; match=&quot;/&quot;>&lt;tns:Output_ListaRicariche_RicercaAvanzata>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Profile,$Start/tns1:Tipo_Profilo)=false() and ((string-length($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:strutturaCondition[1]/tns1:nome)>0 and (upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='Y' or upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='S')) or (string-length($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:strutturaCondition[1]/tns1:nome)>0))&quot;>&lt;tns:dettaglioAsset>&lt;xsl:if test=&quot;not((string($NonOLORicariche/unknownResultset/row[1]/column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($NonOLORicariche/unknownResultset/row[1]/column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($NonOLORicariche/unknownResultset/row[1]/column[name='CODIFICAOLOAGCOM']/value)&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;$NonOLORicariche/unknownResultset/row[1]/column[name='CODIFICAOLOAGCOM']/value&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($NonOLORicariche/unknownResultset/row[1]/column[name='IDRISORSA'