                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:inputservizioricercaavanzata>&#xa;            &lt;xsl:for-each select=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:strutturaCondition&quot;>&#xa;                &lt;tns3:strutturaCondition>&#xa;                    &lt;xsl:if test=&quot;tns1:nome&quot;>&#xa;                        &lt;tns3:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns1:nome&quot;/>&#xa;                        &lt;/tns3:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:operazione&quot;>&#xa;                        &lt;tns3:operazione>&#xa;                            &lt;xsl:value-of select=&quot;tns1:operazione&quot;/>&#xa;                        &lt;/tns3:operazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:valore&quot;>&#xa;                        &lt;tns3:valore>&#xa;                            &lt;xsl:value-of select=&quot;tns1:valore&quot;/>&#xa;                        &lt;/tns3:valore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:tipo&quot;>&#xa;                        &lt;tns3:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns1:tipo&quot;/>&#xa;                        &lt;/tns3:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns3:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:indiceriga&quot;>&#xa