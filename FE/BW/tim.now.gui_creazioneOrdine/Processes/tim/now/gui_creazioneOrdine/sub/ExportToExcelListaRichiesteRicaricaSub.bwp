            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCOLOricaricheQuery-input"
                    name="JDBCOLOricaricheQuery"
                    outputVariable="JDBCOLOricaricheQuery"
                    tibex:xpdlId="a5ef87d2-3a50-475b-b03d-0ba9395a6612" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToJDBCQuery_exportLista"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCOLOricaricheQueryToAssign2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a5ef87d2-3a50-475b-b03d-0ba9395a6612+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCOLOricaricheQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:COD_OLO_AGCOM&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom1>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:COD_OLO_AGCOM&quot;/>&#xa;            &lt;/codOloAgcom1>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT A.IDRISORSA, A.CODIFICAOLOAGCOM, A.IDASSET, A.STATOASSET AS STATOASSETDINAMICO, AR.DATAINIZIO, AR.DATAFINE, AR.STATOASSET, AR.FAMIGLIAASSET, &#xa;AR.CREATED, AR.LASTUPDATE, AR.OPERATORE, AR.DATAANNULLAMENTO, AR.TIPOLOGIARICARICA, AR.IDASSETRICARICA, A.OFFERTA, A.OPZIONEDINAMICA, A.CODICEORDINETI, A.CODICEORDINEOLO, A.IDCONTRATTO&#xa;FROM BDS_1_CASEDATA_ASSET A&#xa;LEFT JOIN BDS_1_CASEDATA_ASSETRICARICA AR ON AR.IDASSET = A.IDASSET&#xa;WHERE A.OPZIONEDINAMICA = 'Y' AND A.OFFERTA IN ('BITSTREAMGBEASIMMETRICOFLAT','VULAFTTCAB','BITSTREAMNGAFTTCAB')&#xa;AND A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM =?)) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = ?)))&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom1"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STATOASSETDINAMICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINIZIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DATAFINE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STATOASSET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="FAMIGLIAASSET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="LASTUPDATE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAANNULLAMENTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIARICARICA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDASSETRICARICA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OPZIONEDINAMICA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINETI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDCONTRATTO"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="OLORicariche-input"
                    name="OLORicariche" outputVariable="OLORicariche"
                    tibex:xpdlId="645375a3-2b53-4782-bf8a-edf3de37c8cc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToSQLDirect_ricAvanzataexportRicAvanzata"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OLOAssetToAssign3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+645375a3-2b53-4782-bf8a-edf3de37c8cc+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:template name=&quot;OLORicariche-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDRISORSA, A.CODIFICAOLOAGCOM, A.IDASSET, A.STATOASSET AS STATOASSETDINAMICO, AR.DATAINIZIO, AR.DATAFINE, AR.STATOASSET, AR.FAMIGLIAASSET, AR.CREATED, AR.LASTUPDATE, AR.OPERATORE, AR.DATAANNULLAMENTO, AR.TIPOLOGIARICARICA, AR.IDASSETRICARICA, A.OFFERTA, A.OPZIONEDINAMICA, A.CODICEORDINETI, A.CODICEORDINEOLO, A.IDCONTRATTO FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ASSETRICARICA AR ON AR.IDASSET = A.IDASSET WHERE A.OPZIONEDINAMICA = 'Y' AND A.OFFERTA IN ('BITSTREAMGBEASIMMETRICOFLAT','VULAFTTCAB','BITSTREAMNGAFTTCAB') AND A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns1:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns1:COD_OLO_AGCOM,&amp;quot;'))) AND &amp;quot;,$RicercaAvanzata/tns3:outputcondition[1],&amp;quot; FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
