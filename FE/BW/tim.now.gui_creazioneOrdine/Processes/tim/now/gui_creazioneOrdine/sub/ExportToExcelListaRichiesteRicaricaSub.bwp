                    <bpws:sources>
                        <bpws:source linkName="xmlToExcelToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1470065396641&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:template name=&quot;xmlToExcel-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Element>&#xa;            &lt;tns2:xmlParam>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns2:xmlParam>&#xa;            &lt;tns2:listOfColumn>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;codificaOAO,idRisorsa,dataInizioRicarica,dataFineRicarica,taglioRicaricaInGiorni,stato,tipologiaAccensioneRicarica,ultimoAggiornamento,dataAnnullamento,userId&amp;quot;&quot;/>&#xa;            &lt;/tns2:listOfColumn>&#xa;            &lt;tns2:rootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Export_ListaRicariche&amp;quot;&quot;/>&#xa;            &lt;/tns2:rootElement>&#xa;            &lt;tns2:nameOfFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ListaRicariche&amp;quot;&quot;/>&#xa;            &lt;/tns2:nameOfFile>&#xa;            &lt;tns2:idFile>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:ID_File&quot;/>&#xa;            &lt;/tns2:idFile>&#xa;            &lt;tns2:userId>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:User_ID&quot;/>&#xa;            &lt;/tns2:userId>&#xa;            &lt;tns2:tipoProfilo>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:Tipo_Profilo&quot;/>&#xa;            &lt;/tns2:tipoProfilo>&#xa;            &lt;tns2:childElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Lista_Ricariche&amp;quot;&quot;/>&#xa;            &lt;/tns2:childElement>&#xa;        &lt;/tns2:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
