, &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataFineRicarica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DATAFINE&quot;>&lt;tns:dataFineRicarica>&lt;xsl:value-of select=&quot;DATAFINE&quot;/>&lt;/tns:dataFineRicarica>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(TIPOLOGIARICARICA)&quot;>&lt;xsl:if test=&quot;TIPOLOGIARICARICA&quot;>&lt;tns:taglioRicaricaInGiorni>&lt;xsl:value-of select=&quot;TIPOLOGIARICARICA&quot;/>&lt;/tns:taglioRicaricaInGiorni>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;STATOASSET&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;xsl:if test=&quot;FAMIGLIAASSET&quot;>&lt;tns:tipologiaAccensioneRicarica>&lt;xsl:value-of select=&quot;FAMIGLIAASSET&quot;/>&lt;/tns:tipologiaAccensioneRicarica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(LASTUPDATE), &amp;quot;.&amp;quot;) and exists(LASTUPDATE) and string-length(xsd:string(LASTUPDATE))>0&quot;>&lt;tns:ultimoAggiornamento>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(LASTUPDATE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(LASTUPDATE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:ultimoAggiornamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;LASTUPDATE&quot;>&lt;tns:ultimoAggiornamento>&lt;xsl:value-of select=&quot;LASTUPDATE&quot;/>&lt;/tns:ultimoAggiornamento>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(DATAANNULLAMENTO), &amp;quot;.&amp;quot;) and exists(DATAANNULLAMENTO) and string-length(xsd:string(DATAANNULLAMENTO))>0&quot;>&lt;tns:dataAnnullamento>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATAANNULLAMENTO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAANNULLAMENTO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataAnnullamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DATAANNULLAMENTO&quot;>&lt;tns:dataAnnullamento>&lt;xsl:value-of select=&quot;DATAANNULLAMENTO&quot;/>&lt;/tns:dataAnnullamento>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;OPERATORE&quot;>&lt;tns:userId>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/tns:userId>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(CREATED), &amp;quot;.&amp;quot;) and exists(CREATED) and string-length(xsd:string(CREATED))>0&quot;>&lt;tns:dataInserimentoRichiesta>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(CREATED), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(CREATED), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInserimentoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;CREATED&quot;>&lt;tns:dataInserimentoRichiesta>&lt;xsl:value-of select=&quot;CREATED&quot;/>&lt;/tns:dataInserimentoRichiesta>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(IDASSETRICARICA)&quot;>&lt;xsl:if test=&quot;IDASSETRICARICA&quot;>&lt;tns:idAssetRicarica>&lt;xsl:value-of select=&quot;IDASSETRICARICA&quot;/>&lt;/tns:idAssetRicarica>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;STATOASSETDINAMICO&quot;>&lt;tns:statoAssetDinamico>&lt;xsl:value-of select=&quot;STATOASSETDINAMICO&quot;/>&lt;/tns:statoAssetDinamico>&lt;/xsl:if>&lt;/tns:Lista_Ricariche>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Export_ListaRicariche>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Export_ListaRicariche>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun elemento trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:Export_ListaRicariche>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
