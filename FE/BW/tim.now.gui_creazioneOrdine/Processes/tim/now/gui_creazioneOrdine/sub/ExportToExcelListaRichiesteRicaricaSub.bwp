            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="286eece8-86bf-486e-a45c-e742a3a6ef7e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="xmlToExcelToEnd"/>
                        <bpws:target linkName="MapperToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Ricariche&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperListaRicaricheRicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output_ListaRicariche_RicercaAvanzata>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapperListaRicaricheRicercaAvanzata/tns:dettaglioAsset/tns:idAsset) and string-length($MapperListaRicaricheRicercaAvanzata/tns:dettaglioAsset/tns:idAsset)>0 and (($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest!=&amp;quot;Y&amp;quot; or $Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest!=&amp;quot;S&amp;quot; ))&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$MapperListaRicaricheRicercaAvanzata/tns:dettaglioAsset&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapperListaRicaricheRicercaAvanzata/tns:dettaglioAsset/tns:idAsset) and string-length($MapperListaRicaricheRicercaAvanzata/tns:dettaglioAsset/tns:idAsset)>0 and (($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest!=&amp;quot;Y&amp;quot; or $Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest!=&amp;quot;S&amp;quot; ))&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$MapperListaRicaricheRicercaAvanzata/tns:Lista_Ricariche&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$MapperListaRicaricheRicercaAvanzata/tns:result&quot;/>&#xa;        &lt;/tns:Output_ListaRicariche_RicercaAvanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
