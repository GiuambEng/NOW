            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="xmlToExcel-input"
                    name="xmlToExcel"
                    tibex:xpdlId="af4db90b-a32f-44b3-b923-05b8cc63f50a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
