;/>&lt;/tns:nome>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:nome>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:nome>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo, &amp;quot;SUPER&amp;quot;) or $ControlloOscuramento/Record[1]/FLAG_OSCURMENTO = &amp;quot;Y&amp;quot;&quot;>&lt;xsl:if test=&quot;not((string(COGNOMERAGIONESOCIALE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(COGNOMERAGIONESOCIALE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(COGNOMERAGIONESOCIALE)&quot;>&lt;tns:cognome_ragSociale>&lt;xsl:value-of select=&quot;COGNOMERAGIONESOCIALE&quot;/>&lt;/tns:cognome_ragSociale>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:cognome_ragSociale>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:cognome_ragSociale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo, &amp;quot;SUPER&amp;quot;) or $ControlloOscuramento/Record[1]/FLAG_OSCURMENTO = &amp;quot;Y&amp;quot;&quot;>&lt;xsl:if test=&quot;not((string(CODICEFISCALE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEFISCALE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEFISCALE)&quot;>&lt;tns:CF>&lt;xsl:value-of select=&quot;CODICEFISCALE&quot;/>&lt;/tns:CF>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CF>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:CF>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo, &amp;quot;SUPER&amp;quot;) or $ControlloOscuramento/Record[1]/FLAG_OSCURMENTO = &amp;quot;Y&amp;quot;&quot;>&lt;xsl:if test=&quot;not((string(PARTITAIVA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(PARTITAIVA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(PARTITAIVA)&quot;>&lt;tns:P.IVA>&lt;xsl:value-of select=&quot;PARTITAIVA&quot;/>&lt;/tns:P.IVA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:P.IVA>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:P.IVA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string(CODICEISTATCOMUNE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEISTATCOMUNE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEISTATCOMUNE)&quot;>&lt;tns:codIstatComune>&lt;xsl:value-of select=&quot;CODICEISTATCOMUNE&quot;/>&lt;/tns:codIstatComune>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(OPZIONEDINAMICA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(OPZIONEDINAMICA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(OPZIONEDINAMICA)&quot;>&lt;tns:opzioneDinamica>&lt;xsl:value-of select=&quot;OPZIONEDINAMICA&quot;/>&lt;/tns:opzioneDinamica>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDRISORSAOPERATORERETE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSAOPERATORERETE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSAOPERATORERETE)&quot;>&lt;tns:idRisorsaOperatoreRete>&lt;xsl:value-of select=&quot;IDRISORSAOPERATORERETE&quot;/>&lt;/tns:idRisorsaOperatoreRete>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(MSISDN/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(MSISDN/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(MSISDN)&quot;>&lt;tns:MSISDN>&lt;xsl:value-of select=&quot;MSISDN&quot;/>&lt;/tns:MSISDN>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IMSI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IMSI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IMSI)&quot;>&lt;tns:IMSI>&lt;xsl:value-of select=&quot;IMSI&quot;/>&lt;/tns:IMSI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IMEI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IMEI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IMEI)&quot;>&lt;tns:IMEI>&lt;xsl:value-of select=&quot;IMEI&quot;/>&lt;/tns:IMEI>&lt;/xsl:if>&lt;/tns:outputAssetDetailsExport>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if (count($ExportGUIListaAsset/outputSet/RESULTSET/APPUSER.LISTAASSET_EXPORT)&amp;lt;$MaxRows) then 'OK' else 'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:OutputAssetDetailsExport>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputAssetDetailsExport>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun elemento trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutputAssetDetailsExport>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
