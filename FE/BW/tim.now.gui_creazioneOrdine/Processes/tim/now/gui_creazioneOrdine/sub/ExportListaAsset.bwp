                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ExportReport&quot;/>&lt;xsl:template name=&quot;exportAsset&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($ExportReport/outputSet/RESULTSET/APPUSER.LISTAASSET_EXPORT)>0&quot;>&lt;tns:OutputAssetDetailsExport>&lt;xsl:for-each select=&quot;$ExportReport/outputSet/RESULTSET/APPUSER.LISTAASSET_EXPORT&quot;>&lt;tns:outputAssetDetailsExport>&lt;xsl:if test=&quot;not((string(ORDINEOLOASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(ORDINEOLOASSET/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(ORDINEOLOASSET)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;ORDINEOLOASSET&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(ORDINETI_ASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(ORDINETI_ASSET/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(ORDINETI_ASSET)&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;ORDINETI_ASSET&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(STATOASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATOASSET/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATOASSET)&quot;>&lt;tns:identificativoStatoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:identificativoStatoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(TIPOLOGIAACCESSO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(TIPOLOGIAACCESSO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(TIPOLOGIAACCESSO)&quot;>&lt;tns:identificativoTipologiaAccesso>&lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&lt;/tns:identificativoTipologiaAccesso>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot