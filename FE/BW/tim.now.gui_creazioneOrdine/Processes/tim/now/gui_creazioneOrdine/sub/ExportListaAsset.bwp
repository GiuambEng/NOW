                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="exportAsset"
                    name="NoExportNonAttributi"
                    outputVariable="exportAsset"
                    tibex:xpdlId="b449af6a-6147-4a03-aabf-4cd47031362c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GUIListaAssetToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NoExportNonAttributiToEmpty2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;GUIListaAsset&quot;/>&lt;xsl:template name=&quot;exportAsset&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GUIListaAsset/outputSet/RESULTSET/APPUSER.LISTAASSET/IDASSET) and string-length(string($GUIListaAsset/outputSet/RESULTSET/APPUSER.LISTAASSET[1]/IDASSET))>0&quot;>&lt;tns:OutputAssetDetailsExport>&lt;xsl:for-each select=&quot;$GUIListaAsset/outputSet/RESULTSET/APPUSER.LISTAASSET&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo,'OLO') and $Start/tns1:COD_OLO_AGCOM = 'ALB'&quot;>&lt;xsl:if test=&quot;empty(ASSETBTWHITELIST)  or ASSETBTWHITELIST !='TIM EX BT'&quot;>&lt;tns:outputAssetDetailsExport>&lt;xsl:if test=&quot;not((string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINEOLO)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODICEORDINETI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINETI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINETI)&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(STATOASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATOASSET/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATOASSET)&quot;>&lt;tns:identificativoStatoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:identificativoStatoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(TIPOLOGIAACCESSO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(TIPOLOGIAACCESSO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(TIPOLOGIAACCESSO)&quot;>&lt;tns:identificativoTipologiaAccesso>&lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&lt;/tns:identificativoTipologiaAccesso>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLOAGCOM)&quot;>&lt;tns:codOAOAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codOAOAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(LASTUPDATE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(LASTUPDATE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(LASTUPDATE)&quot;>&lt;tns:timeStampAggiornamentoAsset>&lt;xsl:value-of select=&quot;LASTUPDATE&quot;/>&lt;/tns:timeStampAggiornamentoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(OFFERTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(OFFERTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(OFFERTA)&quot;>&lt;tns:tipoServizio>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:tipoServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDASSETCRMWS/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDASSETCRMWS/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDASSETCRMWS)&quot;>&lt;tns:idAssetCRMWS>&lt;xsl:value-of select=&quot;IDASSETCRMWS&quot;/>&lt;/tns:idAssetCRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDRISORSA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSA)&quot;>&lt;tns:id_risorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:id_risorsa>&lt;/xsl:if>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;xsd:string(IDASSET)&quot;/>&lt;/tns:idAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo, &amp;quot;SUPER&amp;quot;) or $ControlloOscuramento/Record[1]/FLAG_OSCURMENTO = &amp;quot;Y&amp;quot;&quot;>&lt;xsl:if test=&quot;not((string(NOME/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(NOME/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(NOME)&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;NOME&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:nome>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:nome>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo, &amp;quot;SUPER&amp;quot;) or $ControlloOscuramento/Record[1]/FLAG_OSCURMENTO = &amp;quot;Y&amp;quot;&quot;>&lt;xsl:if test=&quot;not((string(COGNOMERAGIONESOCIALE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(COGNOMERAGIONESOCIALE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(COGNOMERAGIONESOCIALE)&quot;>&lt;tns:cognome_ragSociale>&lt;xsl:value-of select=&quot;COGNOMERAGIONESOCIALE&quot;/>&lt;/tns:cognome_ragSociale>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:cognome_ragSociale>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:cognome_ragSociale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo, &amp;quot;SUPER&amp;quot;) or $ControlloOscuramento/Record[1]/FLAG_OSCURMENTO = &amp;quot;Y&amp;quot;&quot;>&lt;xsl:if test=&quot;not((string(CODICEFISCALE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEFISCALE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEFISCALE)&quot;>&lt;tns:CF>&lt;xsl:value-of select=&quot;CODICEFISCALE&quot;/>&lt;/tns:CF>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CF>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:CF>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo, &amp;quot;SUPER&amp;quot;) or $ControlloOscuramento/Record[1]/FLAG_OSCURMENTO = &amp;quot;Y&amp;quot;&quot;>&lt;xsl:if test=&quot;not((string(PARTITAIVA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(PARTITAIVA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(PARTITAIVA)&quot;>&lt;tns:P.IVA>&lt;xsl:value-of select=&quot;PARTITAIVA&quot;/>&lt;/tns:P.IVA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:P.IVA>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:P.IVA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string(CODICEISTATCOMUNE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEISTATCOMUNE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEISTATCOMUNE)&quot;>&lt;tns:codIstatComune>&lt;xsl:value-of select=&quot;CODICEISTATCOMUNE&quot;/>&lt;/tns:codIstatComune>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDRISORSAOPERATORERETE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSAOPERATORERETE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSAOPERATORERETE)&quot;>&lt;tns:idRisorsaOperatoreRete>&lt;xsl:value-of select=&quot;IDRISORSAOPERATORERETE&quot;/>&lt;/tns:idRisorsaOperatoreRete>&lt;/xsl:if>&lt;/tns:outputAssetDetailsExport>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputAssetDetailsExport>&lt;xsl:if test=&quot;not((string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINEOLO)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODICEORDINETI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINETI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINETI)&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(STATOASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATOASSET/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATOASSET)&quot;>&lt;tns:identificativoStatoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:identificativoStatoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(TIPOLOGIAACCESSO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(TIPOLOGIAACCESSO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(TIPOLOGIAACCESSO)&quot;>&lt;tns:identificativoTipologiaAccesso>&lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&lt;/tns:identificativoTipologiaAccesso>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLOAGCOM)&quot;>&lt;tns:codOAOAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codOAOAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(LASTUPDATE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(LASTUPDATE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(LASTUPDATE)&quot;>&lt;tns:timeStampAggiornamentoAsset>&lt;xsl:value-of select=&quot;LASTUPDATE&quot;/>&lt;/tns:timeStampAggiornamentoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(OFFERTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(OFFERTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(OFFERTA)&quot;>&lt;tns:tipoServizio>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:tipoServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDASSETCRMWS/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDASSETCRMWS/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDASSETCRMWS)&quot;>&lt;tns:idAssetCRMWS>&lt;xsl:value-of select=&quot;IDASSETCRMWS&quot;/>&lt;/tns:idAssetCRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDRISORSA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSA)&quot;>&lt;tns:id_risorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:id_risorsa>&lt;/xsl:if>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;xsd:string(IDASSET)&quot;/>&lt;/tns:idAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo, &amp;quot