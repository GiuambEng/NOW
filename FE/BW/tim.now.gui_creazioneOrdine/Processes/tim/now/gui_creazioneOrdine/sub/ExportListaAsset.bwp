:if>&lt;xsl:if test=&quot;not((string(NUMEROFITTIZIO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(NUMEROFITTIZIO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(NUMEROFITTIZIO)&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDASSETCRMWS/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDASSETCRMWS/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDASSETCRMWS)&quot;>&lt;tns:idAssetCRMWS>&lt;xsl:value-of select=&quot;IDASSETCRMWS&quot;/>&lt;/tns:idAssetCRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDRISORSA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSA)&quot;>&lt;tns:id_risorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:id_risorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDASSET/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDASSET)&quot;>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODIFICAOLOAGCOMDONATING/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLOAGCOMDONATING/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLOAGCOMDONATING)&quot;>&lt;tns:oaoDonating>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOMDONATING&quot;/>&lt;/tns:oaoDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODIFICAOLOAGCOMDONOR/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLOAGCOMDONOR/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLOAGCOMDONOR)&quot;>&lt;tns:oaoDonor>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOMDONOR&quot;/>&lt;/tns:oaoDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODICETOPONOMASTICA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICETOPONOMASTICA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICETOPONOMASTICA)&quot;>&lt;tns:codiceToponomastica>&lt;xsl:value-of select=&quot;CODICETOPONOMAS