                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;exportAsset&quot;/>&lt;xsl:param name=&quot;IsFittizia&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;tns:OutputAssetDetailsExport>&lt;xsl:for-each select=&quot;$exportAsset/tns:outputAssetDetailsExport&quot;>&lt;tns:outputAssetDetailsExport>&lt;xsl:if test=&quot;tns:codiceOlo&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;tns:codiceOlo&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codiceOrdineTI&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;tns:codiceOrdineTI&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:identificativoStatoAsset&quot;>&lt;tns:identificativoStatoAsset>&lt;xsl:value-of select=&quot;tns:identificativoStatoAsset&quot;/>&lt;/tns:identificativoStatoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:identificativoTipologiaAccesso&quot;>&lt;tns:identificativoTipologiaAccesso>&lt;xsl:value-of select=&quot;tns:identificativoTipologiaAccesso&quot;/>&lt;/tns:identificativoTipologiaAccesso>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codOAOAgcom&quot;>&lt;tns:codOAOAgcom>&lt;xsl:value-of select=&quot;tns:codOAOAgcom&quot;/>&lt;/tns:codOAOAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codiceProgetto&quot;>&lt;tns:codiceProgetto>&lt;xsl:value-of select=&quot;tns:codiceProgetto&quot;/>&lt;/tns:codiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dec&quot;>&lt;tns:dec>&lt;xsl:value-of select=&quot;tns:dec&quot;/>&lt;/tns:dec>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:des&quot;>&lt;tns:des>&lt;xsl:value-of select=&quot;tns:des&quot;/>&lt;/tns:des>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:centrale&quot;>&lt;tns:centrale>&lt;xsl:value-of select=&quot;tns:centrale&quot;/>&lt;/tns:centrale>&lt;/xsl:if>&lt;xsl:i