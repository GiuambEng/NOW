portGUIListaAssetAttr/outputSet/RESULTSET/APPUSER.LISTAASSET_EXPORT)&amp;lt;$MaxRows) then 'OK' else 'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:OutputAssetDetailsExport>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputAssetDetailsExport>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun elemento trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutputAssetDetailsExport>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
