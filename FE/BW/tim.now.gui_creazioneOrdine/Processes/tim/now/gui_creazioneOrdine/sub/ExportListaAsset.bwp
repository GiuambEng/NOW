and 

((contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,",",true()),"ADA.NOMEATTRIBUTO='IDULLCO' AND ADA.VALOREATTRIBUTO") or 
