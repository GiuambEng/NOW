                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;ExportGUIListaAssetAttr&quot;/>&lt;xsl:template name=&quot;exportAsset&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ExportGUIListaAssetAttr/outputSet/RESULTSET/APPUSER.LISTAASSET_EXPORT/IDASSET) and string-length(string($ExportGUIListaAssetAttr/outputSet/RESULTSET/APPUSER.LISTAASSET_EXPORT[1]/IDASSET))>0&quot;>&lt;tns:OutputAssetDetailsExport>&lt;xsl:for-each select=&quot;$ExportGUIListaAssetAttr/outputSet/RESULTSET/APPUSER.LISTAASSET_EXPORT&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo,'OLO') and $Start/tns1:COD_OLO_AGCOM = 'ALB'&quot;>&lt;xsl:if test=&quot;empty(ASSETBTWHITELIST)  or ASSETBTWHITELIST !='TIM EX BT'&quot;>&lt;tns:outputAssetDetailsExport>&lt;xsl:if test=&quot;not((string(ORDINEOLOASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(ORDINEOLOASSET/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(ORDINEOLOASSET)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;ORDINEOLOASSET&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(ORDINETI_ASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(ORDINETI_ASSET/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(ORDINETI_ASSET)&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;ORDINETI_ASSET&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(STATOASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATOASSET/@xsi:nil)=(&amp;quot;1&