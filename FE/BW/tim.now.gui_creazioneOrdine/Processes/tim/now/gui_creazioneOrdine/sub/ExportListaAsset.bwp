                <bpws:sources>
                    <bpws:source linkName="Empty1ToNoOLOsubstringQueryAssign_attributiAsset">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="((string-length($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition[1]/ns0:nome)>0 and (upper-case($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:exportRequest)='Y' or upper-case($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:exportRequest)='S')) or (string-length($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition[1]/ns0:nome)>0)) &#xd;&#xa;and &#xd;&#xa;&#xd;&#xa;((contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='IDULLCO' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='IDSLUCO' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='SVLANCODE' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='CVLANID' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='CODICETD' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='IPDSLAM' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='IPKIT' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='CODICEVP' AND ADA.VALOREATTRIBUTO&quot;) or&#xd;&#xa;contains(tib:concat-sequence-format($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:strutturaCondition/ns0:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='CARATTERIZZAZIONEGEO' AND ADA.VALOREATTRIBUTO&quot;)))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
