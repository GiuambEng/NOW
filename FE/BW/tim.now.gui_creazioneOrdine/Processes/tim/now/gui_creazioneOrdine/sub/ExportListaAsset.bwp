                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;GUIListaAssetAttr&quot;/>&lt;xsl:template name=&quot;exportAsset&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GUIListaAssetAttr/outputSet/RESULTSET/APPUSER.LISTAASSET/IDASSET) and string-length(string($GUIListaAssetAttr/outputSet/RESULTSET/APPUSER.LISTAASSET[1]/IDASSET))>0&quot;>&lt;tns:OutputAssetDetailsExport>&lt;xsl:for-each select=&quot;$GUIListaAssetAttr/outputSet/RESULTSET/APPUSER.LISTAASSET&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo,'OLO') and $Start/tns1:COD_OLO_AGCOM = 'ALB'&quot;>&lt;xsl:if test=&quot;empty(ASSETBTWHITELIST)  or ASSETBTWHITELIST !='TIM EX BT'&quot;>&lt;tns:outputAssetDetailsExport>&lt;xsl:if test=&quot;not((string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINEOLO)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODICEORDINETI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINETI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINETI)&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(STATOASSET/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATOASSET/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATOASSET)&quot;