                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:exportRequest= "Y" or $Start/ns0:xmlToExcel_RicercaAvanzata/ns0:exportRequest= "S" ) or string-length($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:idReport)>0]]></bpws:transitionCondition>
