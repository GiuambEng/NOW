            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:ActiveLoggerServices"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/ActiveLoggerServices"/>
        </wsdl:definitions>
