    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="AssignToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToEnd_logging"
                    tibex:label="logging" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="a5103e50-476e-4afe-8c01-cbb996a2fb29"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToAssign"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="8ac10166-4f89-4afe-bcd2-aed5dfe3ff67" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="7742aaf1-76aa-49c4-8eda-fa9d7e147653">
                <bpws:targets>
                    <bpws:target linkName="AssignToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToEnd_logging">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="GenericLogger_result"
                    name="GenericLogger_Assign"
                    outputVariable="GenericLogger_result"
                    tibex:xpdlId="236d4cc0-5e58-475b-9437-cb027e0dbdca" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat(&quot;[Application : &quot; ,$Start/tns:GenericLogger/tns:Application,&quot;] [Process : &quot;,$Start/tns:GenericLogger/tns:Process,&quot;]&quot;,&quot; [Service: &quot;,$Start/tns:GenericLogger/tns:Service,&quot;]&quot;,&quot;[Operation: &quot;,$Start/tns:GenericLogger/tns:Operation,&quot;] &quot;,&quot; [BusinessID : &quot;,$Start/tns:GenericLogger/tns:BusinessID,&quot;]&quot;,&quot;[MsgCode : &quot;,$Start/tns:GenericLogger/tns:MsgCode,&quot;]&quot;,&quot;[Message: &quot;,$Start/tns:GenericLogger/tns:Message,&quot;]  &quot;,&quot;[Payload: &quot;,$Start/tns:GenericLogger/tns:Payload,&quot;] &quot;, &quot;[ LoggerName: &quot;,$Start/tns:GenericLogger/tns:LoggerName,&quot;] &quot;,&quot;[LogerLevel: &quot;,$Start/tns:GenericLogger/tns:LogLevel,&quot;] &quot;,&quot;[ LogJMS: &quot;,xsd:string($Start/tns:GenericLogger/tns:LogJMS),&quot;]&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="GenericLogger_result" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log-input"
                    name="Log"
                    tibex:xpdlId="35916e02-38b4-466c-af04-90e0d538bca4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToEnd_logging"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:track_position='IN' and exists($Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:ErrorLog)&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Error :&amp;quot;,$Start/tns1:GenericLogger/tns1:Service,tib:render-xml($Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:ErrorLog,true(),true()))&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:track_position='IN' and not(exists($Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:ErrorLog))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:GenericLogger/tns1:LogLevel=&amp;quot;msg&amp;quot;&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat('StartedProcess:',$Start/tns1:GenericLogger/tns1:Service,$Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:track_position,'-',$Start/tns1:ActiveLoggerServices/tns1:Playload/tns1:XMLString,'BID',$Start/tns1:GenericLogger/tns1:BusinessID,'CID',$Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:Identifier/tns1:CorrelationID)&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;message>&lt;xsl:value-of select=&quot;concat('SubPocess',$Start/tns1:GenericLogger/tns1:Service,'_',$Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:track_position,'-',$Start/tns1:GenericLogger/tns1:Payload,'BID',$Start/tns1:GenericLogger/tns1:BusinessID,'CID',$Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:Identifier/tns1:CorrelationID)&quot;/>&lt;/message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;End_Service :&amp;quot;,$Start/tns1:GenericLogger/tns1:Service,'_' ,$Start/tns1:GenericLogger/tns1:Payload,'BID',$Start/tns1:GenericLogger/tns1:BusinessID,'CID',$Start/tns1:ActiveLoggerServices/tns1:Envelope/tns1:Identifier/tns1:CorrelationID)&quot;/>&lt;/message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
