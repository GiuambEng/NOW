            <bpws:invoke inputVariable="Tokenizzazione-input"
                name="Tokenizzazione" operation="Create_token_NOWSecolo"
                outputVariable="Tokenizzazione"
                partnerLink="NOW_SECOLOPortType"
                portType="ns6:NOW_SECOLOPortType" tibex:xpdlId="2ff99e33-454e-4470-b6c5-e91cd74db9d1">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/NOW_SECOLO/" xmlns:tns1="http://www.example.org/Tokenizzazione" xmlns:tns2="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="ReferentiC2Plus"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="Tokenizzazione-input" match="/"&gt;&lt;tns:Create_token_NOWSecoloRequest&gt;&lt;Input&gt;&lt;tns2:RequestCreate_token&gt;&lt;xsl:if test="$Start/tns1:codOloAgcom"&gt;&lt;tns2:CodificaOLOAGCOM&gt;&lt;xsl:value-of select="$Start/tns1:codOloAgcom"/&gt;&lt;/tns2:CodificaOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns1:codOrdineOlo"&gt;&lt;tns2:CodiceOrdineOLO&gt;&lt;xsl:value-of select="$Start/tns1:codOrdineOlo"/&gt;&lt;/tns2:CodiceOrdineOLO&gt;&lt;/xsl:if&gt;&lt;tns2:Funzione&gt;&lt;xsl:value-of select="&amp;quot;ACQGUI&amp;quot;"/&gt;&lt;/tns2:Funzione&gt;&lt;tns2:ChiaveRiferimento&gt;&lt;xsl:value-of select="concat($Start/tns1:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))"/&gt;&lt;/tns2:ChiaveRiferimento&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Start/tns1:operatore)&gt;0"&gt;&lt;xsl:if test="$Start/tns1:operatore"&gt;&lt;tns2:Operatore&gt;&lt;xsl:value-of select="$Start/tns1:operatore"/&gt;&lt;/tns2:Operatore&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:Operatore&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns2:Operatore&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Start/tns1:IPClient)&gt;0"&gt;&lt;xsl:if test="$Start/tns1:IPClient"&gt;&lt;tns2:IPClient&gt;&lt;xsl:value-of select="$Start/tns1:IPClient"/&gt;&lt;/tns2:IPClient&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IPClient&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns2:IPClient&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/tns1:numeriReferenti[1]/tns1:numeroFisso"&gt;&lt;tns2:N_Recap_Cliente&gt;&lt;xsl:value-of select="$Start/tns1:numeriReferenti[1]/tns1:numeroFisso"/&gt;&lt;/tns2:N_Recap_Cliente&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns1:numeriReferenti[1]/tns1:numeroMobile"&gt;&lt;tns2:N_Recap_Cliente_ALT&gt;&lt;xsl:value-of select="$Start/tns1:numeriReferenti[1]/tns1:numeroMobile"/&gt;&lt;/tns2:N_Recap_Cliente_ALT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns1:numeriReferenti[1]/tns1:nome"&gt;&lt;tns2:Nome&gt;&lt;xsl:value-of select="$Start/tns1:numeriReferenti[1]/tns1:nome"/&gt;&lt;/tns2:Nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns1:numeriReferenti[1]/tns1:cognome"&gt;&lt;tns2:CognomeRagioneSociale&gt;&lt;xsl:value-of select="$Start/tns1:numeriReferenti[1]/tns1:cognome"/&gt;&lt;/tns2:CognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$ReferentiC2Plus/Record[1]/COUNT&gt;0"&gt;&lt;tns2:TOKENIZZAZIONE&gt;&lt;xsl:value-of select="&amp;quot;C2PLUS&amp;quot;"/&gt;&lt;/tns2:TOKENIZZAZIONE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:TOKENIZZAZIONE&gt;&lt;xsl:value-of select="&amp;quot;D420&amp;quot;"/&gt;&lt;/tns2:TOKENIZZAZIONE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns2:RequestCreate_token&gt;&lt;/Input&gt;&lt;/tns:Create_token_NOWSecoloRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/NOW_SECOLO/&quot; xmlns:tns1=&quot;http://www.example.org/Tokenizzazione&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReferentiC2Plus&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Tokenizzazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RequestCreate_token>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codOloAgcom&quot;>&#xa;                &lt;tns2:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codOloAgcom&quot;/>&#xa;                &lt;/tns2:CodificaOLOAGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codOrdineOlo&quot;>&#xa;                &lt;tns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codOrdineOlo&quot;/>&#xa;                &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:Funzione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ACQGUI&amp;quot;&quot;/>&#xa;            &lt;/tns2:Funzione>&#xa;            &lt;tns2:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat($Start/tns1:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns2:ChiaveRiferimento>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns1:operatore)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:operatore&quot;>&#xa;                        &lt;tns2:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;                        &lt;/tns2:Operatore>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:Operatore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns1:IPClient)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:IPClient&quot;>&#xa;                        &lt;tns2:IPClient>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:IPClient&quot;/>&#xa;                        &lt;/tns2:IPClient>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:IPClient>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:numeriReferenti[1]/tns1:numeroFisso&quot;>&#xa;                &lt;tns2:N_Recap_Cliente>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:numeriReferenti[1]/tns1:numeroFisso&quot;/>&#xa;                &lt;/tns2:N_Recap_Cliente>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:numeriReferenti[1]/tns1:numeroMobile&quot;>&#xa;                &lt;tns2:N_Recap_Cliente_ALT>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:numeriReferenti[1]/tns1:numeroMobile&quot;/>&#xa;                &lt;/tns2:N_Recap_Cliente_ALT>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:numeriReferenti[1]/tns1:nome&quot;>&#xa;                &lt;tns2:Nome>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:numeriReferenti[1]/tns1:nome&quot;/>&#xa;                &lt;/tns2:Nome>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:numeriReferenti[1]/tns1:cognome&quot;>&#xa;                &lt;tns2:CognomeRagioneSociale>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:numeriReferenti[1]/tns1:cognome&quot;/>&#xa;                &lt;/tns2:CognomeRagioneSociale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ReferentiC2Plus/Record[1]/COUNT>0&quot;>&#xa;                    &lt;tns2:TOKENIZZAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;C2PLUS&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TOKENIZZAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:TOKENIZZAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;D420&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TOKENIZZAZIONE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:RequestCreate_token>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
