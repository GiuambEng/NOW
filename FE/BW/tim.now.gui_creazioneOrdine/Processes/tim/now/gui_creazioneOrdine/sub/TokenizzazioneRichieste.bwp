            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ReferentiC2Plus-input"
                    name="ReferentiC2Plus"
                    outputVariable="ReferentiC2Plus"
                    tibex:xpdlId="3cbdc45f-bbd2-4859-82ca-a094a79d7d95" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ReferentiC2PlusToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$ReferentiC2Plus/Record[1]/COUNT=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$ReferentiC2Plus/Record[1]/COUNT=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ReferentiC2PlusToInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3cbdc45f-bbd2-4859-82ca-a094a79d7d95+input&quot; xmlns:tns1=&quot;http://www.example.org/Tokenizzazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ReferentiC2Plus-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;codOrdineOlo>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codOrdineOlo)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:codOrdineOlo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOrdineOlo>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count(*)&#xa;from bds_1_casedata_referente r inner join bds_1_casedata_ordine o on &#xa;    r.idrichiestaolo = o.idrichiestaolo&#xa;where (r.telefonofissoreferente like 'kk%' or r.telefonomobilereferente like 'kk%')&#xa;and o.codiceordineolo = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOrdineOlo"/>
                                    <columnMetadata
                                    columnName="COUNT(*)"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
