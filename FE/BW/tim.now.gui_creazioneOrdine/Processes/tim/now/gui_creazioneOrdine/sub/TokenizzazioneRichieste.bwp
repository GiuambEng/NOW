                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Tokenizzazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns:outputTokenizzazione>&lt;tns:referentiTokenizzati>&lt;tns:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:esito>&lt;xsl:for-each select=&quot;$Start/tns:numeriReferenti&quot;>&lt;tns:numeriReferenti>&lt;xsl:if test=&quot;tns:id&quot;>&lt;tns:id>&lt;xsl:value-of select=&quot;tns:id&quot;/>&lt;/tns:id>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:numeroFisso&quot;>&lt;tns:numeroFisso>&lt;xsl:value-of select=&quot;tns:numeroFisso&quot;/>&lt;/tns:numeroFisso>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:numeroMobile&quot;>&lt;tns:numeroMobile>&lt;xsl:value-of select=&quot;tns:numeroMobile&quot;/>&lt;/tns:numeroMobile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cognome&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codFiscale&quot;>&lt;tns:codFiscale>&lt;xsl:value-of select=&quot;tns:codFiscale&quot;/>&lt;/tns:codFiscale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:pIva&quot;>&lt;tns:pIva>&lt;xsl:value-of select=&quot;tns:pIva&quot;/>&lt;/tns:pIva>&lt;/xsl:if>&lt;/tns:numeriReferenti>&lt;/xsl:for-each>&lt;/tns:referentiTokenizzati>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'ERROR'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Tokenizzazione non riuscita'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputTokenizzazione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
