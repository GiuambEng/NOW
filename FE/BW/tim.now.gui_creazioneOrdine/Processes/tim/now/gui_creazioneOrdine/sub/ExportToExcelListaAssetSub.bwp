                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCNoOLOassetQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;exportAsset&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($JDBCNoOLOassetQuery/Record/IDASSET) and string-length(string($JDBCNoOLOassetQuery/Record[1]/IDASSET))>0&quot;>&#xa;                &lt;tns:OutputAssetDetailsExport>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCNoOLOassetQuery/Record&quot;>&#xa;                        &lt;tns:outputAssetDetailsExport>&#xa;                            &lt;xsl:if test=&quot;ORDINEOLO_ASSET&quot;>&#xa;                                &lt;tns:codiceOlo>&#xa;                                    &lt;xsl:value-of select=&quot;ORDINEOLO_ASSET&quot;/>&#xa;                                &lt;/tns:codiceOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ORDINETI_ASSET&quot;>&#xa;                                &lt;tns:codiceOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;ORDINETI_ASSET&quot;/>&#xa;                                &lt;/tns:codiceOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATOASSET&quot;>&#xa;                                &lt;tns:identificativoStatoAsset>&#xa;                                    &lt;xsl:value-of select=&quot;STATOASSET&quot;/>&#xa;                                &lt;/tns:identificativoStatoAsse