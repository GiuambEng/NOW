                                    sqlStatement="SELECT A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET,A.CODICEORDINETI AS ORDINETI_ASSET, A.IDRISORSANOW,A.IDRISORSA, A.IDOFFERTA, A.IDASSETCRMWS, A.NUMEROFITTIZIO,A.IDASSET, A.LINEARIFERIMENTO, A.CODICETOPONOMASTICA,A.DES, A.DEC, O.CODICEPROGETTO, A.DESPRIMOORDINE, A.IDASSETDA,A.RO, A.CREATED, A.LASTUPDATE, A.INVARIANTE,O.LNA_LA, O.MODALITAFATTURAZIONE, A.NUMEROTELEFONICO, A.OPERATORE,A.STATOASSET,A.OFFERTA, A.IDCONTRATTO, A.CLLI, C.NOME_CONTRATTO, C.COD_CONTRATTO,A.PROVINCIA, A.COMUNE, A.LOCALITA, A.DESCRPARTTOPONOMASTICA,A.DESCRIZIONEVIA, A.NUMEROCIVICO, A.CAP, A.COMPLESSO, A.INTERNO,A.SCALA, A.PIANO,A.CODIFICAOLOAGCOM,A.CODIFICAOLOAGCOMDONATING,A.CODIFICAOLOAGCOMDONOR,A.ORA_DES, R.CODICEORDINEOLO,R.CODICEORDINETI,  NC.COD_TOPON,NC.NUMERO_CIVICO,NC.CAP AS CAP_NUM_CIV,NC.COD_STRADA,V.DESCR_VIA,V.COD_COMUNE,V.COD_PARTICELLA_TOPON,P.DESCR_PARTICELLA_TOPON,CL.DESCR_COMUNE, CL.FLAG_COMUNE, PROV.DESCR_PROV,PROV.COD_PROV, A.OPZIONEDINAMICA, A.IDRISORSAOPERATORERETE &#xd;&#xa;FROM BDS_1_CASEDATA_ASSET A &#xd;&#xa;LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI  &#xd;&#xa;LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO &#xd;&#xa;LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = A.IDPRIMOORDINE &#xd;&#xa;LEFT JOIN NUMERO_CIVICO NC  ON NC.COD_TOPON= A.CODICETOPONOMASTICA &#xd;&#xa;LEFT JOIN VIA V ON V.COD_STRADA=NC.COD_STRADA &#xd;&#xa;LEFT JOIN PARTICELLA P ON P.COD_PARTICELLA_TOPON = V.COD_PARTICELLA_TOPON &#xd;&#xa;LEFT JOIN COMUNE_O_LOCALITA CL ON CL.COD_COMUNE= V.COD_COMUNE &#xd;&#xa;LEFT JOIN PROV ON PROV.COD_PROV=CL.COD_PROV&#xd;&#xa;LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET&#xd;&#xa;ORDER BY A.LASTUPDATE DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
