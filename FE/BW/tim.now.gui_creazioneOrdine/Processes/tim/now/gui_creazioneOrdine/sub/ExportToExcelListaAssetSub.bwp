                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/asset&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperListaAssetRicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:OutputAsset1>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapperListaAssetRicercaAvanzata/tns2:OutputAsset/tns2:identificativoAsset) and string-length($MapperListaAssetRicercaAvanzata/tns2:OutputAsset[1]/tns2:identificativoAsset)>0 and (($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest!=&amp;quot;Y&amp;quot; or $Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest!=&amp;quot;S&amp;quot; ))&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$MapperListaAssetRicercaAvanzata/tns2:OutputAsset&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$MapperListaAssetRicercaAvanzata/tns2:result&quot;/>&#xa;        &lt;/tns2:OutputAsset1>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
