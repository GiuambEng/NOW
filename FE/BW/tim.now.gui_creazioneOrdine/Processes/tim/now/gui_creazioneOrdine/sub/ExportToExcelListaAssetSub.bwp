                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputservizioricercaavanzata>&#xa;            &lt;xsl:for-each select=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:strutturaCondition&quot;>&#xa;                &lt;tns2:strutturaCondition>&#xa;                    &lt;xsl:if test=&quot;tns1:nome&quot;>&#xa;                        &lt;tns2:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns1:nome&quot;/>&#xa;                        &lt;/tns2:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:operazione&quot;>&#xa;                        &lt;tns2:operazione>&#xa;                            &lt;xsl:value-of select=&quot;tns1:operazione&quot;/>&#xa;                        &lt;/tns2:operazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:valore&quot;>&#xa;                        &lt;tns2:valore>&#xa;                            &lt;xsl:value-of select=&quot;tns1:valore&quot;/>&#xa;                        &lt;/tns2:valore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:tipo&quot;>&#xa;                        &lt;tns2:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns1:tipo&quot;/>&#xa;                        &lt;/tns2:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:indiceriga&quot;>&#xa;                &lt;tns2:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:indiceriga&quot;/>&#xa;                &lt;/tns2:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:numerorighe&quot;>&#xa;                &lt;tns2:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:numerorighe&quot;/>&#xa;                &lt;/tns2:numerorighe>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest&quot;>&#xa;                &lt;tns2:exportRequest>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest&quot;/>&#xa;                &lt;/tns2:exportRequest>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
