                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="exportAsset"
                    name="NonOLOAssetAttributiAssign"
                    outputVariable="exportAsset"
                    tibex:xpdlId="f1d1ca2e-d72d-441c-8f9a-6cdff9df12e6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SQLDirectToCopy_1_AssignNonOLOAsset"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_AssignNonOLOAssetToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;NonOLOAssetAttributi&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&lt;xsl:template name=&quot;exportAsset&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NonOLOAssetAttributi/unknownResultset/row/column[name='IDASSET']/value) and string-length(string($NonOLOAssetAttributi/unknownResultset/row/column[name='IDASSET']/value))>0&quot;>&lt;tns:OutputAssetDetailsExport>&lt;xsl:for-each select=&quot;$NonOLOAssetAttributi/unknownResultset/row&quot;>&lt;tns:outputAssetDetailsExport>&lt;xsl:if test=&quot;not((string(column[name='ORDINEOLO_ASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ORDINEOLO_ASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ORDINEOLO_ASSET']/value)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;column[name='ORDINEOLO_ASSET']/value&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='ORDINETI_ASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ORDINETI_ASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ORDINETI_ASSET']/value)&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;column[name='ORDINETI_ASSET']/value&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATOASSET']/value)&quot;>&lt;tns:identificativoStatoAsset>&lt;xsl:value-of select=&quot;column[name='STATOASSET']/value&quot;/>&lt;/tns:identificativoStatoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLOGIAACCESSO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLOGIAACCESSO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLOGIAACCESSO']/value)&quot;>&lt;tns:identificativoTipologiaAccesso>&lt;xsl:value-of select=&quot;column[name='TIPOLOGIAACCESSO']/value&quot;/>&lt;/tns:identificativoTipologiaAccesso>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLOAGCOM']/value)&quot;>&lt;tns:codOAOAgcom>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLOAGCOM']/value&quot;/>&lt;/tns:codOAOAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DEC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DEC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DEC']/value)&quot;>&lt;tns:dec>&lt;xsl:value-of select=&quot;column[name='DEC']/value&quot;/>&lt;/tns:dec>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DES']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DES']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DES']/value)&quot;>&lt;tns:des>&lt;xsl:value-of select=&quot;column[name='DES']/value&quot;/>&lt;/tns:des>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CLLI']/value)&quot;>&lt;tns:centrale>&lt;xsl:value-of select=&quot;column[name='CLLI']/value&quot;/>&lt;/tns:centrale>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESPRIMOORDINE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESPRIMOORDINE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESPRIMOORDINE']/value)&quot;>&lt;tns:desPrimoOrdine>&lt;xsl:value-of select=&quot;column[name='DESPRIMOORDINE']/value&quot;/>&lt;/tns:desPrimoOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDASSETDA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDASSETDA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDASSETDA']/value)&quot;>&lt;tns:identificativoAssetDa>&lt;xsl:value-of select=&quot;column[name='IDASSETDA']/value&quot;/>&lt;/tns:identificativoAssetDa>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDCONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDCONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDCONTRATTO']/value)&quot;>&lt;tns:identificativoContratto>&lt;xsl:value-of select=&quot;column[name='IDCONTRATTO']/value&quot;/>&lt;/tns:identificativoContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_CONTRATTO']/value)&quot;>&lt;tns:codcontratto>&lt;xsl:value-of select=&quot;column[name='COD_CONTRATTO']/value&quot;/>&lt;/tns:codcontratto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CONTRATTO']/value)&quot;>&lt;tns:nomecontratto>&lt;xsl:value-of select=&quot;column[name='NOME_CONTRATTO']/value&quot;/>&lt;/tns:nomecontratto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINETI']/value)&quot;>&lt;tns:primoOrdineTI>&lt;xsl:value-of select=&quot;column[name='CODICEORDINETI']/value&quot;/>&lt;/tns:primoOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLO']/value)&quot;>&lt;tns:codiceOrdineOAOPrimoOrdine>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLO']/value&quot;/>&lt;/tns:codiceOrdineOAOPrimoOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='PROVINCIA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='PROVINCIA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='PROVINCIA']/value)&quot;>&lt;tns:provincia>&lt;xsl:value-of select=&quot;column[name='PROVINCIA']/value&quot;/>&lt;/tns:provincia>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COMUNE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COMUNE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COMUNE']/value)&quot;>&lt;tns:comune>&lt;xsl:value-of select=&quot;column[name='COMUNE']/value&quot;/>&lt;/tns:comune>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='LOCALITA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='LOCALITA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='LOCALITA']/value)&quot;>&lt;tns:localita>&lt;xsl:value-of select=&quot;column[name='LOCALITA']/value&quot;/>&lt;/tns:localita>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCRPARTTOPONOMASTICA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCRPARTTOPONOMASTICA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCRPARTTOPONOMASTICA']/value)&quot;>&lt;tns:descParticellaToponomastica>&lt;xsl:value-of select=&quot;column[name='DESCRPARTTOPONOMASTICA']/value&quot;/>&lt;/tns:descParticellaToponomast