            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="exportAsset"
                    name="AssignOLOassetQuery"
                    outputVariable="exportAsset"
                    tibex:xpdlId="336e92d8-b49f-4867-becf-beb0d080f5fb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCOLOassetQueryToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEmpty11"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCOLOassetQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;exportAsset&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($JDBCOLOassetQuery/Record/IDASSET) and string-length(string($JDBCOLOassetQuery/Record[1]/IDASSET))>0&quot;>&#xa;                &lt;tns:OutputAssetDetailsExport>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCOLOassetQuery/Record&quot;>&#xa;                        &lt;tns:outputAssetDetailsExport>&#xa;                            &lt;xsl:if test=&quot;ORDINEOLO_ASSET&quot;>&#xa;                                &lt;tns:codiceOlo>&#xa;                                    &lt;xsl:value-of select=&quot;ORDINEOLO_ASSET&quot;/>&#xa;                                &lt;/tns:codiceOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ORDINETI_ASSET&quot;>&#xa;                                &lt;tns:codiceOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;ORDINETI_ASSET&quot;/>&#xa;                                &lt;/tns:codiceOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATOASSET&quot;>&#xa;                                &lt;tns:identificativoStatoAsset>&#xa;                                    &lt;xsl:value-of select=&quot;STATOASSET&quot;/>&#xa;                                &lt;/tns:identificativoStatoAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPOLOGIAACCESSO&quot;>&#xa;                                &lt;tns:identificativoTipologiaAccesso>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&#xa;                                &lt;/tns:identificativoTipologiaAccesso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns:codOAOAgcom>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns:codOAOAgcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DEC&quot;>&#xa;                                &lt;tns:dec>&#xa;                                    &lt;xsl:value-of select=&quot;DEC&quot;/>&#xa;                                &lt;/tns:dec>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DES&quot;>&#xa;                                &lt;tns:des>&#xa;                                    &lt;xsl:value-of select=&quot;DES&quot;/>&#xa;                                &lt;/tns:des>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CLLI&quot;>&#xa;                                &lt;tns:centrale>&#xa;                                    &lt;xsl:value-of select=&quot;CLLI&quot;/>&#xa;                                &lt;/tns:centrale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESPRIMOORDINE&quot;>&#xa;                                &lt;tns:desPrimoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;DESPRIMOORDINE&quot;/>&#xa;                                &lt;/tns:desPrimoOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDASSETDA&quot;>&#xa;                                &lt;tns:identificativoAssetDa>&#xa;                                    &lt;xsl:value-of select=&quot;IDASSETDA&quot;/>&#xa;                                &lt;/tns:identificativoAssetDa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDCONTRATTO&quot;>&#xa;                                &lt;tns:identificativoContratto>&#xa;                                    &lt;xsl:value-of select=&quot;IDCONTRATTO&quot;/>&#xa;                                &lt;/tns:identificativoContratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COD_CONTRATTO&quot;>&#xa;                                &lt;tns:codcontratto>&#xa;                                    &lt;xsl:value-of select=&quot;COD_CONTRATTO&quot;/>&#xa;                                &lt;/tns:codcontratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOME_CONTRATTO&quot;>&#xa;                                &lt;tns:nomecontratto>&#xa;                                    &lt;xsl:value-of select=&quot;NOME_CONTRATTO&quot;/>&#xa;                                &lt;/tns:nomecontratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                                &lt;tns:primoOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns:primoOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                &lt;tns:codiceOrdineOAOPrimoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns:codiceOrdineOAOPrimoOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;PROVINCIA&quot;>&#xa;                                &lt;tns:provincia>&#xa;                                    &lt;xsl:value-of select=&quot;PROVINCIA&quot;/>&#xa;                                &lt;/tns:provincia>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COMUNE&quot;>&#xa;                                &lt;tns:comune>&#xa;                                    &lt;xsl:value-of select=&quot;COMUNE&quot;/>&#xa;                                &lt;/tns:comune>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;LOCALITA&quot;>&#xa;                                &lt;tns:localita>&#xa;                                    &lt;xsl:value-of select=&quot;LOCALITA&quot;/>&#xa;                                &lt;/tns:localita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCRPARTTOPONOMASTICA&quot;>&#xa;                                &lt;tns:descParticellaToponomastica>&#xa;                                    &lt;xsl:value-of select=&quot;DESCRPARTTOPONOMASTICA&quot;/>&#xa;                                &lt;/tns:descParticellaToponomastica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCRIZIONEVIA&quot;>&#xa;                                &lt;tns:via>&#xa;                                    &lt;xsl:value-of select=&quot;DESCRIZIONEVIA&quot;/>&#xa;                                &lt;/tns:via>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMEROCIVICO&quot;>&#xa;                                &lt;tns:numero>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROCIVICO&quot;/>&#xa;                                &lt;/tns:numero>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CAP&qu