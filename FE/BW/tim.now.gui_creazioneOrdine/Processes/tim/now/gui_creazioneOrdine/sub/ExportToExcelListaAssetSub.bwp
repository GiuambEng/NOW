                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+19dc3a97-c087-411c-998a-3bea9a20cbc6+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;substringQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;OLOAssetAttributi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:strutturaCondition[1]/tns1:nome)>0 and (upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='Y' or upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='S')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET,A.CODICEORDINETI AS ORDINETI_ASSET,A.IDRISORSANOW,A.IDRISORSA, A.IDOFFERTA, A.IDASSETCRMWS, A.NUMEROFITTIZIO,A.IDASSET, A.LINEARIFERIMENTO, A.CODICETOPONOMASTICA,A.DES, A.DEC, O.CODICEPROGETTO, A.DESPRIMOORDINE, A.IDASSETDA,A.RO, A.CREATED, A.LASTUPDATE, A.INVARIANTE,O.LNA_LA, O.MODALITAFATTURAZIONE, A.NUMEROTELEFONICO, A.OPERATORE,A.STATOASSET,A.OFFERTA, A.IDCONTRATTO, A.CLLI, C.NOME_CONTRATTO, C.COD_CONTRATTO,A.PROVINCIA, A.COMUNE, A.LOCALITA, A.DESCRPARTTOPONOMASTICA,A.DESCRIZIONEVIA, A.NUMEROCIVICO, A.CAP, A.COMPLESSO, A.INTERNO,A.SCALA, A.PIANO,A.CODIFICAOLOAGCOM,A.CODIFICAOLOAGCOMDONATING,A.CODIFICAOLOAGCOMDONOR,A.ORA_DES, R.CODICEORDINEOLO,R.CODICEORDINETI,  NC.COD_TOPON,NC.NUMERO_CIVICO,NC.CAP AS CAP_NUM_CIV,NC.COD_STRADA,V.DESCR_VIA,V.COD_COMUNE,V.COD_PARTICELLA_TOPON,P.DESCR_PARTICELLA_TOPON,CL.DESCR_COMUNE, CL.FLAG_COMUNE, PROV.DESCR_PROV,PROV.COD_PROV, A.OPZIONEDINAMICA, A.IDRISORSAOPERATORERETE FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI  LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = A.IDPRIMOORDINE LEFT JOIN NUMERO_CIVICO NC  ON NC.COD_TOPON= A.CODICETOPONOMASTICA LEFT JOIN VIA V ON V.COD_STRADA=NC.COD_STRADA LEFT JOIN PARTICELLA P ON P.COD_PARTICELLA_TOPON = V.COD_PARTICELLA_TOPON LEFT JOIN COMUNE_O_LOCALITA CL ON CL.COD_COMUNE= V.COD_COMUNE LEFT JOIN PROV ON PROV.COD_PROV=CL.COD_PROV LEFT JOIN BDS_1_CASEDATA_DETTAGLIOASSET DA ON DA.ASSET_DETTAGLIOASSET_BDSID=A.BDS_ID LEFT JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON ADA.DTTGLSST_TTRBTIDTTGLISST_BDSID=DA.BDS_ID  LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET WHERE A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns1:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns1:COD_OLO_AGCOM,&amp;quot;'))) AND &amp;quot;,$substringQuery,&amp;quot; ORDER BY A.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot; )&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET, A.CODICEORDINETI AS ORDINETI_ASSET,A.CODIFICAOLOAGCOM, A.IDASSETCRMWS,A.IDRISORSA,A.IDASSET,A.STATOASSET,A.OFFERTA,A.IDRISORSAOPERATORERETE, A.LASTUPDATE FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI  LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO LEFT JOIN BDS_1_CASEDATA_DETTAGLIOASSET DA ON DA.ASSET_DETTAGLIOASSET_BDSID=A.BDS_ID LEFT JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON ADA.DTTGLSST_TTRBTIDTTGLISST_BDSID=DA.BDS_ID  LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET WHERE A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns1:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns1:COD_OLO_AGCOM,&amp;quot;'))) AND &amp;quot;,$substringQuery,&amp;quot; and rownum &amp;lt;= 500 UNION ALL select A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET, A.CODICEORDINETI AS ORDINETI_ASSET,A.CODIFICAOLOAGCOM, A.IDASSETCRMWS,A.IDRISORSA,A.IDASSET,A.STATOASSET,A.OFFERTA,A.IDRISORSAOPERATORERETE, A.LASTUPDATE from bds_1_casedata_asset A join bds_1_casedata_attribtdttglsst ada on ada.idasset=A.idasset LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET where A.offerta='NP' and ada.nomeattributo='OLORETAILER' and ada.valoreattributo='&amp;quot;, $Start/tns1:COD_OLO_AGCOM,&amp;quot;' AND &amp;quot;,$substringQuery,&amp;quot; ORDER BY LASTUPDATE DESC &amp;quot; )&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="exportAsset"
                    name="OLOAssetAttributiAssign"
                    outputVariable="exportAsset"
                    tibex:xpdlId="3408eb00-ee16-4b5a-bfe8-bd71d1176b74" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SQLDirectToCopy_1_AssignOLOAsset"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_AssignOLOAssetToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;OLOAssetAttributi&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&lt;xsl:template name=&quot;exportAsset&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OLOAssetAttributi/unknownResultset/row/column[name='IDASSET']/value) and string-length(string($OLOAssetAttributi/unknownResultset/row/column[name='IDASSET']/value))>0&quot;>&lt;tns:OutputAssetDetailsExport>&lt;xsl:for-each select=&quot;$OLOAssetAttributi/unknownResultset/row&quot;>&lt;tns:outputAssetDetailsExport>&lt;xsl:if test=&quot;not((string(column[name='ORDINEOLO_ASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ORDINEOLO_ASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ORDINEOLO_ASSET']/value)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;column[name='ORDINEOLO_ASSET']/value&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='ORDINETI_ASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ORDINETI_ASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ORDINETI_ASSET']/value)&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;column[name='ORDINETI_ASSET']/value&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATOASSET']/value)&quot;>&lt;tns:identificativoStatoAsset>&lt;xsl:value-of select=&quot;column[name='STATOASSET']/value&quot;/>&lt;/tns:identificativoStatoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLOGIAACCESSO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLOGIAACCESSO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLOGIAACCESSO']/value)&quot;>&lt;tns:identificativoTipologiaAccesso>&lt;xsl:value-of select=&quot;column[name='TIPOLOGIAACCESSO']/value&quot;/>&lt;/tns:identificativoTipologiaAccesso>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLOAGCOM']/value)&quot;>&lt;tns:codOAOAgcom>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLOAGCOM']/value&quot;/>&lt;/tns:codOAOAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DEC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DEC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DEC']/value)&quot;>&lt;tns:dec>&lt;xsl:value-of select=&quot;column[name='DEC']/value&quot;/>&lt;/tns:dec>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DES']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DES']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DES']/value)&quot;>&lt;tns:des>&lt;xsl:value-of select=&quot;column[name='DES']/value&quot;/>&lt;/tns:des>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CLLI']/value)&quot;>&lt;tns:centrale>&lt;xsl:value-of select=&quot;column[name='CLLI']/value&quot;/>&lt;/tns:centrale>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESPRIMOORDINE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESPRIMOORDINE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESPRIMOORDINE']/value)&quot;>&lt;tns:desPrimoOrdine>&lt;xsl:value-of select=&quot;column[name='DESPRIMOORDINE']/value&quot;/>&lt;/tns:desPrimoOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDASSETDA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDASSETDA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDASSETDA']/value)&quot;>&lt;tns:identificativoAssetDa>&lt;xsl:value-of select=&quot;column[name='IDASSETDA']/value&quot;/>&lt;/tns:identificativoAssetDa>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDCONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDCONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDCONTRATTO']/value)&quot;>&lt;tns:identificativoContratto>&lt;xsl:value-of select=&quot;column[name='IDCONTRATTO']/value&quot;/>&lt;/tns:identificativoContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_CONTRATTO']/value)&quot;>&lt;tns:codcontratto>&lt;xsl:value-of select=&quot;column[name='COD_CONTRATTO']/value&quot;/>&lt;/tns:codcontratto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CONTRATTO']/value)&quot;>&lt;tns:nomecontratto>&lt;xsl:value-of select=&quot;column[name='NOME_CONTRATTO']/value&quot;/>&lt;/tns:nomecontratto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINETI']/value)&quot;>&lt;tns:primoOrdineTI>&lt;xsl:value-of select=&quot;column[name='CODICEORDINETI']/value&quot;/>&lt;/tns:primoOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLO']/value)&quot;>&lt;tns:codiceOrdineOAOPrimoOrdine>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLO']/value&quot;/>&lt;/tns:codiceOrdineOAOPrimoOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='PROVINCIA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='PROVINCIA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='PROVINCIA']/value)&quot;>&lt;tns:provincia>&lt;xsl:value-of select=&quot;column[name='PROVINCIA']/value&quot;/>&lt;/tns:provincia>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COMUNE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COMUNE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COMUNE']/value)&quot;>&lt;tns:comune>&lt;xsl:value-of select=&quot;column[name='COMUNE']/value&quot;/>&lt;/tns:comune>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='LOCALITA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='LOCALITA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='LOCALITA']/value)&quot;>&lt;tns:localita>&lt;xsl:value-of select=&quot;column[name='LOCALITA']/value&quot;/>&lt;/tns:localita>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCRPARTTOPONOMASTICA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCRPARTTOPONOMASTICA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCRPARTTOPONOMASTICA']/value)&quot;>&lt;tns:descParticellaToponomastica>&lt;xsl:value-of select=&quot;column[name='DESCRPARTTOPONOMASTICA']/value&quot;/>&lt;/tns:descParticellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCRIZIONEVIA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCRIZIONEVIA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCRIZIONEVIA']/value)&quot;>&lt;tns:via>&lt;xsl:value-of select=&quot;column[name='DESCRIZIONEVIA']/value&quot;/>&lt;/tns:via>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NUMEROCIVICO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NUMEROCIVICO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NUMEROCIVICO']/value)&quot;>&lt;tns:numero>&lt;xsl:value-of select=&quot;column[name='NUMEROCIVICO']/value&quot;/>&lt;/tns:numero>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CAP']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CAP']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CAP']/value)&quot;>&lt;tns:cap>&lt;xsl:value-of select=&quot;column[name='CAP']/value&quot;/>&lt;/tns:cap>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COMPLESSO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COMPLESSO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COMPLESSO']/value)&quot;>&lt;tns:complesso>&lt;xsl:value-of select=&quot;column[name='COMPLESSO']/value&quot;/>&lt;/tns:complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='INTERNO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='INTERNO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='INTERNO']/value)&quot;>&lt;tns:interno>&lt;xsl:value-of select=&quot;column[name='INTERNO']/value&quot;/>&lt;/tns:interno>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='SCALA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='SCALA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='SCALA']/value)&quot;>&lt;tns:scala>&lt;xsl:value-of select=&quot;column[name='SCALA']/value&quot;/>&lt;/tns:scala>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='PIANO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='PIANO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='PIANO']/value)&quot;>&lt;tns:piano>&lt;xsl:value-of select=&quot;column[name='PIANO']/value&quot;/>&lt;/tns:piano>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='LINEARIFERIMENTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='LINEARIFERIMENTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='LINEARIFERIMENTO']/value)&quot;>&lt;tns:lineariferimento>&lt;xsl:value-of select=&quot;column[name='LINEARIFERIMENTO']/value&quot;/>&lt;/tns:lineariferimento>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='LNA_LA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='LNA_LA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='LNA_LA']/value)&quot;>&lt;tns:lna_la>&lt;xsl:value-of select=&quot;column[name='LNA_LA']/value&quot;/>&lt;/tns:lna_la>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='MODALITAFATTURAZIONE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='MODALITAFATTURAZIONE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='MODALITAFATTURAZIONE']/value)&quot;>&lt;tns:modalitaFatturazione>&lt;xsl:value-of select=&quot;column[name='MODALITAFATTURAZIONE']/value&quot;/>&lt;/tns:modalitaFatturazione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NUMEROTELEFONICO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NUMEROTELEFONICO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NUMEROTELEFONICO']/value)&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;column[name='NUMEROTELEFONICO']/value&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OP