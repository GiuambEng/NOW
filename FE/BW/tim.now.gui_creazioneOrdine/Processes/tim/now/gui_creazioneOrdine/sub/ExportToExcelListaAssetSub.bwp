                        <bpws:source linkName="SQLDirectToCopy_1_AssignNonOLOAsset"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a3fcecb7-5124-4ca8-9425-df697ee77efa+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;substringQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;NonOLOAssetAttributi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:strutturaCondition[1]/tns1:nome)>0 and (upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='Y' or upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='S')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET,A.CODICEORDINETI AS ORDINETI_ASSET,A.IDRISORSANOW,A.IDRISORSA, A.IDOFFERTA, A.IDASSETCRMWS, A.NUMEROFITTIZIO,A.IDASSET, A.LINEARIFERIMENTO, A.CODICETOPONOMASTICA,A.DES, A.DEC,O.CODICEPROGETTO, A.DESPRIMOORDINE, A.IDASSETDA,A.RO, A.CREATED, A.LASTUPDATE, A.INVARIANTE,O.LNA_LA, O.MODALITAFATTURAZIONE, A.NUMEROTELEFONICO, A.OPERATORE,A.STATOASSET,A.OFFERTA, A.IDCONTRATTO, A.CLLI, C.NOME_CONTRATTO, C.COD_CONTRATTO,A.PROVINCIA, A.COMUNE, A.LOCALITA, A.DESCRPARTTOPONOMASTICA,A.DESCRIZIONEVIA, A.NUMEROCIVICO, A.CAP, A.COMPLESSO, A.INTERNO,A.SCALA, A.PIANO,A.CODIFICAOLOAGCOM,A.CODIFICAOLOAGCOMDONATING,A.CODIFICAOLOAGCOMDONOR,A.ORA_DES, R.CODICEORDINEOLO,R.CODICEORDINETI,  NC.COD_TOPON,NC.NUMERO_CIVICO,NC.CAP AS CAP_NUM_CIV,NC.COD_STRADA,V.DESCR_VIA,V.COD_COMUNE,V.COD_PARTICELLA_TOPON,P.DESCR_PARTICELLA_TOPON,CL.DESCR_COMUNE, CL.FLAG_COMUNE, PROV.DESCR_PROV,PROV.COD_PROV, A.OPZIONEDINAMICA, A.IDRISORSAOPERATORERETE FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = A.IDPRIMOORDINE LEFT JOIN NUMERO_CIVICO NC  ON NC.COD_TOPON= A.CODICETOPONOMASTICA LEFT JOIN VIA V ON V.COD_STRADA=NC.COD_STRADA LEFT JOIN PARTICELLA P ON P.COD_PARTICELLA_TOPON = V.COD_PARTICELLA_TOPON LEFT JOIN COMUNE_O_LOCALITA CL ON CL.COD_COMUNE= V.COD_COMUNE LEFT JOIN PROV ON PROV.COD_PROV=CL.COD_PROV LEFT JOIN BDS_1_CASEDATA_DETTAGLIOASSET DA ON DA.ASSET_DETTAGLIOASSET_BDSID=A.BDS_ID LEFT JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON ADA.DTTGLSST_TTRBTIDTTGLISST_BDSID=DA.BDS_ID  LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET WHERE &amp;quot;,$substringQuery,&amp;quot; ORDER BY A.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot; )&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET, A.CODICEORDINETI AS ORDINETI_ASSET,A.CODIFICAOLOAGCOM, A.IDASSETCRMWS,A.IDRISORSA,A.IDASSET,A.STATOASSET,A.OFFERTA,A.IDRISORSAOPERATORERETE FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO LEFT JOIN BDS_1_CASEDATA_DETTAGLIOASSET DA ON DA.ASSET_DETTAGLIOASSET_BDSID=A.BDS_ID LEFT JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON ADA.DTTGLSST_TTRBTIDTTGLISST_BDSID=DA.BDS_ID  LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET WHERE &amp;quot;,$substringQuery,&amp;quot; ORDER BY A.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
