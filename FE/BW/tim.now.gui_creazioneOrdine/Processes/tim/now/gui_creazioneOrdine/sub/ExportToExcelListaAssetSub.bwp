ot;>&#xa;                                        &lt;tns:CF>&#xa;                                            &lt;xsl:value-of select=&quot;CODICEFISCALE&quot;/>&#xa;                                        &lt;/tns:CF>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:CF>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&#xa;                                    &lt;/tns:CF>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains($Start/tns1:Tipo_Profilo, &amp;quot;SUPER&amp;quot;) or $ControlloOscuramento/Record[1]/FLAG_OSCURMENTO = &amp;quot;Y&amp;quot;&quot;>&#xa;                                    &lt;xsl:if test=&quot;PARTITAIVA&quot;>&#xa;                                        &lt;tns:P.IVA>&#xa;                                            &lt;xsl:value-of select=&quot;PARTITAIVA&quot;/>&#xa;                                        &lt;/tns:P.IVA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:P.IVA>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&#xa;                                    &lt;/tns:P.IVA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;CODICEISTATCOMUNE&quot;>&#xa;                                &lt;tns:codIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEISTATCOMUNE&quot;/>&#xa;                                &lt;/tn