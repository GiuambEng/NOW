                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;NonOLOAsset&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&lt;xsl:template name=&quot;exportAsset&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NonOLOAsset/unknownResultset/row/column[name='IDASSET']/value) and string-length(string($NonOLOAsset/unknownResultset/row/column[name='IDASSET']/value))>0&quot;>&lt;tns:OutputAssetDetailsExport>&lt;xsl:for-each select=&quot;$NonOLOAsset/unknownResultset/row&quot;>&lt;tns:outputAssetDetailsExport>&lt;xsl:if test=&quot;not((string(column[name='ORDINEOLO_ASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ORDINEOLO_ASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ORDINEOLO_ASSET']/value)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;column[name='ORDINEOLO_ASSET']/value&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='ORDINETI_ASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ORDINETI_ASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ORDINETI_ASSET']/value)&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;column[name='ORDINETI_ASSET']/value&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATOASSET']/value)&quot;>&lt;tns:identifica