            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCOLOassetQuery-input"
                    name="JDBCOLOassetQuery"
                    outputVariable="JDBCOLOassetQuery"
                    tibex:xpdlId="25aefb33-6b60-4e7a-bd3f-04546e54b546" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToJDBCQuery_exportLista"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCOLOassetQueryToAssign">
                            <tibex:DesignExpression>
