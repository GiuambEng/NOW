            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="NonOLOAsset-input" name="NonOLOAsset"
                    outputVariable="NonOLOAsset"
                    tibex:xpdlId="7075a317-41e1-4ed8-850c-e2b7ae7d290f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty3ToNonOLOAsset_ricAvanzataexportRicAvanzata"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NonOLOAssetToCopy_1_AssignNoOLOassetQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7075a317-41e1-4ed8-850c-e2b7ae7d290f+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;NonOLOAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:strutturaCondition[1]/tns1:nome)>0 and (upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='Y' or upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='S')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET,A.CODICEORDINETI AS ORDINETI_ASSET,A.IDRISORSANOW,A.IDRISORSA, A.IDOFFERTA, A.IDASSETCRMWS, A.NUMEROFITTIZIO,A.IDASSET, A.LINEARIFERIMENTO, A.CODICETOPONOMASTICA,A.DES, A.DEC,O.CODICEPROGETTO, A.DESPRIMOORDINE, A.IDASSETDA,A.RO, A.CREATED, A.LASTUPDATE, A.INVARIANTE,O.LNA_LA, O.MODALITAFATTURAZIONE, A.NUMEROTELEFONICO, A.OPERATORE,A.STATOASSET,A.OFFERTA, A.IDCONTRATTO, A.CLLI, C.NOME_CONTRATTO, C.COD_CONTRATTO,A.PROVINCIA, A.COMUNE, A.LOCALITA, A.DESCRPARTTOPONOMASTICA,A.DESCRIZIONEVIA, A.NUMEROCIVICO, A.CAP, A.COMPLESSO, A.INTERNO,A.SCALA, A.PIANO,A.CODIFICAOLOAGCOM,A.CODIFICAOLOAGCOMDONATING,A.CODIFICAOLOAGCOMDONOR,A.ORA_DES, R.CODICEORDINEOLO,R.CODICEORDINETI,  NC.COD_TOPON,NC.NUMERO_CIVICO,NC.CAP AS CAP_NUM_CIV,NC.COD_STRADA,V.DESCR_VIA,V.COD_COMUNE,V.COD_PARTICELLA_TOPON,P.DESCR_PARTICELLA_TOPON,CL.DESCR_COMUNE, CL.FLAG_COMUNE, PROV.DESCR_PROV,PROV.COD_PROV, A.OPZIONEDINAMICA, A.IDRISORSAOPERATORERETE FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = A.IDPRIMOORDINE LEFT JOIN NUMERO_CIVICO NC  ON NC.COD_TOPON= A.CODICETOPONOMASTICA LEFT JOIN VIA V ON V.COD_STRADA=NC.COD_STRADA LEFT JOIN PARTICELLA P ON P.COD_PARTICELLA_TOPON = V.COD_PARTICELLA_TOPON LEFT JOIN COMUNE_O_LOCALITA CL ON CL.COD_COMUNE= V.COD_COMUNE LEFT JOIN PROV ON PROV.COD_PROV=CL.COD_PROV LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET WHERE &amp;quot;,$RicercaAvanzata/tns4:outputcondition[1],&amp;quot; ORDER BY A.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot; )&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET, A.CODICEORDINETI AS ORDINETI_ASSET,A.CODIFICAOLOAGCOM, A.IDASSETCRMWS,A.IDRISORSA,A.IDASSET,A.STATOASSET,A.OFFERTA,A.IDRISORSAOPERATORERETE FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET WHERE &amp;quot;,$RicercaAvanzata/tns4:outputcondition[1],&amp;quot; ORDER BY A.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="OLOAsset-input"
                    name="OLOAsset" outputVariable="OLOAsset"
                    tibex:xpdlId="f08679ce-23d5-4db6-b9e6-f7267811b118" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToOLOAsset_ricAvanzataexportRicAvanzata"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OLOAssetToCopy_1_AssignNonOLOAsset1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f08679ce-23d5-4db6-b9e6-f7267811b118+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;OLOAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:strutturaCondition[1]/tns1:nome)>0 and (upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='Y' or upper-case($Start/tns1:xmlToExcel_RicercaAvanzata/tns1:exportRequest)='S')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT /*+ PUSH_SUBQ (@QUERY_OLO)*/ A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET,A.CODICEORDINETI AS ORDINETI_ASSET,A.IDRISORSANOW,A.IDRISORSA, A.IDOFFERTA, A.IDASSETCRMWS, A.NUMEROFITTIZIO,A.IDASSET, A.LINEARIFERIMENTO, A.CODICETOPONOMASTICA,A.DES, A.DEC, O.CODICEPROGETTO, A.DESPRIMOORDINE, A.IDASSETDA,A.RO, A.CREATED, A.LASTUPDATE, A.INVARIANTE,O.LNA_LA, O.MODALITAFATTURAZIONE, A.NUMEROTELEFONICO, A.OPERATORE,A.STATOASSET,A.OFFERTA, A.IDCONTRATTO, A.CLLI, C.NOME_CONTRATTO, C.COD_CONTRATTO,A.PROVINCIA, A.COMUNE, A.LOCALITA, A.DESCRPARTTOPONOMASTICA,A.DESCRIZIONEVIA, A.NUMEROCIVICO, A.CAP, A.COMPLESSO, A.INTERNO,A.SCALA, A.PIANO,A.CODIFICAOLOAGCOM,A.CODIFICAOLOAGCOMDONATING,A.CODIFICAOLOAGCOMDONOR,A.ORA_DES, R.CODICEORDINEOLO,R.CODICEORDINETI,  NC.COD_TOPON,NC.NUMERO_CIVICO,NC.CAP AS CAP_NUM_CIV,NC.COD_STRADA,V.DESCR_VIA,V.COD_COMUNE,V.COD_PARTICELLA_TOPON,P.DESCR_PARTICELLA_TOPON,CL.DESCR_COMUNE, CL.FLAG_COMUNE, PROV.DESCR_PROV,PROV.COD_PROV, A.OPZIONEDINAMICA, A.IDRISORSAOPERATORERETE FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI  LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = A.IDPRIMOORDINE LEFT JOIN NUMERO_CIVICO NC  ON NC.COD_TOPON= A.CODICETOPONOMASTICA LEFT JOIN VIA V ON V.COD_STRADA=NC.COD_STRADA LEFT JOIN PARTICELLA P ON P.COD_PARTICELLA_TOPON = V.COD_PARTICELLA_TOPON LEFT JOIN COMUNE_O_LOCALITA CL ON CL.COD_COMUNE= V.COD_COMUNE LEFT JOIN PROV ON PROV.COD_PROV=CL.COD_PROV LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET WHERE A.CODIFICAOLOAGCOM IN (SELECT /*+ QB_NAME(QUERY_OLO)*/ TO_NCHAR(CODFC_OLO_AGCOM) FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns1:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns1:COD_OLO_AGCOM,&amp;quot;'))) AND &amp;quot;,$RicercaAvanzata/tns3:outputcondition[1],&amp;quot; and rownum &amp;lt;= 500 UNION ALL SELECT A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET,A.CODICEORDINETI AS ORDINETI_ASSET,A.IDRISORSANOW,A.IDRISORSA, A.IDOFFERTA, A.IDASSETCRMWS, A.NUMEROFITTIZIO,A.IDASSET, A.LINEARIFERIMENTO, A.CODICETOPONOMASTICA,A.DES, A.DEC, O.CODICEPROGETTO, A.DESPRIMOORDINE, A.IDASSETDA,A.RO, A.CREATED, A.LASTUPDATE, A.INVARIANTE,O.LNA_LA, O.MODALITAFATTURAZIONE, A.NUMEROTELEFONICO, A.OPERATORE,A.STATOASSET,A.OFFERTA, A.IDCONTRATTO, A.CLLI, C.NOME_CONTRATTO, C.COD_CONTRATTO,A.PROVINCIA, A.COMUNE, A.LOCALITA, A.DESCRPARTTOPONOMASTICA,A.DESCRIZIONEVIA, A.NUMEROCIVICO, A.CAP, A.COMPLESSO, A.INTERNO,A.SCALA, A.PIANO,A.CODIFICAOLOAGCOM,A.CODIFICAOLOAGCOMDONATING,A.CODIFICAOLOAGCOMDONOR,A.ORA_DES, R.CODICEORDINEOLO,R.CODICEORDINETI,  NC.COD_TOPON,NC.NUMERO_CIVICO,NC.CAP AS CAP_NUM_CIV,NC.COD_STRADA,V.DESCR_VIA,V.COD_COMUNE,V.COD_PARTICELLA_TOPON,P.DESCR_PARTICELLA_TOPON,CL.DESCR_COMUNE, CL.FLAG_COMUNE, PROV.DESCR_PROV,PROV.COD_PROV, A.OPZIONEDINAMICA, A.IDRISORSAOPERATORERETE FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = A.IDPRIMOORDINE LEFT JOIN NUMERO_CIVICO NC  ON NC.COD_TOPON= A.CODICETOPONOMASTICA LEFT JOIN VIA V ON V.COD_STRADA=NC.COD_STRADA LEFT JOIN PARTICELLA P ON P.COD_PARTICELLA_TOPON = V.COD_PARTICELLA_TOPON LEFT JOIN COMUNE_O_LOCALITA CL ON CL.COD_COMUNE= V.COD_COMUNE LEFT JOIN PROV ON PROV.COD_PROV=CL.COD_PROV LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET join bds_1_casedata_attribtdttglsst ada on ada.idasset=A.idasset where A.offerta='NP' and ada.nomeattributo='OLORETAILER' and ada.valoreattributo='&amp;quot;, $Start/tns1:COD_OLO_AGCOM,&amp;quot;' AND &amp;quot;,$RicercaAvanzata/tns3:outputcondition[1],&amp;quot; ORDER BY LASTUPDATE DESC &amp;quot; )&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET, A.CODICEORDINETI AS ORDINETI_ASSET,A.CODIFICAOLOAGCOM, A.IDASSETCRMWS,A.IDRISORSA,A.IDASSET,A.STATOASSET,A.OFFERTA,A.IDRISORSAOPERATORERETE, A.LASTUPDATE FROM BDS_1_CASEDATA_ASSET A LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI  LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET  WHERE A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns1:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns1:COD_OLO_AGCOM,&amp;quot;'))) AND &amp;quot;,$RicercaAvanzata/tns3:outputcondition[1],&amp;quot; and rownum &amp;lt;= 500 UNION ALL select A.CODICEISTATCOMUNE,CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.TIPOLOGIAACCESSO,A.CODICEORDINEOLO AS ORDINEOLO_ASSET, A.CODICEORDINETI AS ORDINETI_ASSET,A.CODIFICAOLOAGCOM, A.IDASSETCRMWS,A.IDRISORSA,A.IDASSET,A.STATOASSET,A.OFFERTA,A.IDRISORSAOPERATORERETE, A.LASTUPDATE from bds_1_casedata_asset A join bds_1_casedata_attribtdttglsst dett on dett.idasset=A.idasset LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET where A.offerta='NP' and dett.nomeattributo='OLORETAILER' and dett.valoreattributo='&amp;quot;, $Start/tns1:COD_OLO_AGCOM,&amp;quot;' AND &amp;quot;,$RicercaAvanzata/tns3:outputcondition[1],&amp;quot; ORDER BY LASTUPDATE DESC &amp;quot; )&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty1" tibex:xpdlId="5bfe9f16-49e3-45d2-af8e-ef268958fe47">
                <bpws:targets>
                    <bpws:target linkName="AssignToEmpty11"/>
                    <bpws:target linkName="Copy_1_AssignOLOassetQueryToEmpty1"/>
                    <bpws:target linkName="Copy_1_AssignNoOLOassetQueryToEmpty1"/>
                    <bpws:target linkName="Copy_1_AssignNonOLOAssetToEmpty11"/>
                    <bpws:target linkName="Copy_1_AssignOLOAssetToEmpty1"/>
                    <bpws:target linkName="Copy_1_AssignNonOLOAssetToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToRenderXml">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:exportRequest= &quot;Y&quot; or $Start/ns0:xmlToExcel_RicercaAvanzata/ns0:exportRequest= &quot;S&quot; )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($Start/ns0:xmlToExcel_RicercaAvanzata/ns0:exportRequest= "Y" or $Start/ns0:xmlToExcel_RicercaAvanzata/ns0:exportRequest= "S" )]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToMapperListaAssetRicercaAvanzata">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperListaAssetRicercaAvanzata-input"
                    name="MapperListaAssetRicercaAvanzata"
                    outputVariable="MapperListaAssetRicercaAvanzata"
                    tibex:xpdlId="a77cb948-cd66-4501-8086-315f9a1e5348" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToMapperListaAssetRicercaAvanzata"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperListaAssetRicercaAvanzataToEnd_NoExport">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/asset&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;exportAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperListaAssetRicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:OutputAsset1>&#xa;            &lt;xsl:for-each select=&quot;$exportAsset/tns:outputAssetDetailsExport&quot;>&#xa;                &lt;tns2:OutputAsset>&#xa;                    &lt;xsl:if test=&quot;tns:codiceOlo&quot;>&#xa;                        &lt;tns2:codiceOlo>&#xa;                            &lt;xsl:value-of select=&quot;tns:codiceOlo&quot;/>&#xa;                        &lt;/tns2:codiceOlo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:codiceOrdineTI&quot;>&#xa;                        &lt;tns2:codiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;tns:codiceOrdineTI&quot;/>&#xa;                        &lt;/tns2:codiceOrdineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:codOAOAgcom&quot;>&#xa;                        &lt;tns2:oao>&#xa;                            &lt;xsl:value-of select=&quot;tns:codOAOAgcom&quot;/>&#xa;                        &lt;/tns2:oao>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:idAssetCRMWS&quot;>&#xa;                        &lt;tns2:idAssetCrm>&#xa;                            &lt;xsl:value-of select=&quot;tns:idAssetCRMWS&quot;/>&#xa;                        &lt;/tns2:idAssetCrm>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:id_risorsa&quot;>&#xa;                        &lt;tns2:idRisorsa>&#xa;