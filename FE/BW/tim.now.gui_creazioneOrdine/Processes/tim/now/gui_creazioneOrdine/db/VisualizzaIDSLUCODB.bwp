                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f701676a-6ea7-4b25-a74a-aeefe42d5ef6+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/visualizzaIDSLUCO&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;visualizzaIDSLUCO&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoIDSLUCO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($visualizzaIDSLUCO/input/tns1:RequestVisualizzaIDSLUCO/tns1:codificaOLOAgcom)>0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_CLLI_CENTRALE,CODFC_OLO_AGCOM,COPPIA_A,COPPIA_DA,DATAFI_VALID,DATAINZ_VALID,DATA_INVIO_RICH,ID_RICH_FATTIB,IDSLUCO,PROGRS, TESTARMADIO FROM CLC_IDSLUCO WHERE (SYSDATE &amp;lt; TO_DATE(DATAFI_VALID,'DD-MM-YY'))  AND CODFC_OLO_AGCOM in ('&amp;quot;,tib:concat-sequence-format($visualizzaIDSLUCO/input/tns1:RequestVisualizzaIDSLUCO/tns1:codificaOLOAgcom, &amp;quot;','&amp;quot;, true()),&amp;quot;') AND (COD_CLLI_CENTRALE='&amp;quot;,$visualizzaIDSLUCO/input/tns1:RequestVisualizzaIDSLUCO/tns1:valoreRicerca,&amp;quot;' OR IDSLUCO='&amp;quot;,$visualizzaIDSLUCO/input/tns1:RequestVisualizzaIDSLUCO/tns1:valoreRicerca,&amp;quot;') ORDER BY IDSLUCO&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_CLLI_CENTRALE, CODFC_OLO_AGCOM,   COPPIA_A,   COPPIA_DA,   DATAFI_VALID ,DATAINZ_VALID,   DATA_INVIO_RICH,   ID_RICH_FATTIB,   IDSLUCO,   PROGRS, TESTARMADIO FROM CLC_IDSLUCO WHERE (SYSDATE &amp;lt; TO_DATE(DATAFI_VALID,'DD-MM-YY')) AND COD_CLLI_CENTRALE='&amp;quot;,$visualizzaIDSLUCO/input/tns1:RequestVisualizzaIDSLUCO/tns1:valoreRicerca,&amp;quot;' OR IDSLUCO='&amp;quot;,$visualizzaIDSLUCO/input/tns1:RequestVisualizzaIDSLUCO/tns1:valoreRicerca,&amp;quot;'ORDER BY IDSLUCO&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoIDSLUCO-input"
                                    name="RecuperoIDSLUCO"
                                    outputVariable="RecuperoIDSLUCO"
                                    tibex:xpdlId="f701676a-6ea7-4b25-a74a-aeefe42d5ef6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
