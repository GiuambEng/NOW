                                tibex:xpdlId="1470fb5b-b1cf-4e39-8b3d-f046ea29053c" variable="visualizzaIDULLCOOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/VisualizzaIDULLCO/" xmlns:ns="http://www.tim.com/NOW/cmf/visualizzaIDULLCO" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="IdullcoList"/&gt;&lt;xsl:template name="visualizzaIDULLCOOut-input" match="/"&gt;&lt;tns:visualizzaIDULLCOResponse&gt;&lt;output&gt;&lt;ns:ResponseIDULLCOolo&gt;&lt;xsl:for-each select="$IdullcoList/unknownResultset/row"&gt;&lt;ns:visulizzaIDULLCO&gt;&lt;xsl:if test="not((string(column[name=&amp;quot;IDULLCO&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;IDULLCO&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;IDULLCO&amp;quot;]/value)"&gt;&lt;ns:idullco&gt;&lt;xsl:value-of select="column[name=&amp;quot;IDULLCO&amp;quot;]/value"/&gt;&lt;/ns:idullco&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name=&amp;quot;CLLI&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;CLLI&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;CLLI&amp;quot;]/value)"&gt;&lt;ns:clli&gt;&lt;xsl:value-of select="column[name=&amp;quot;CLLI&amp;quot;]/value"/&gt;&lt;/ns:clli&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists(column[name=&amp;quot;DATA_CONSEGNA_OLO&amp;quot;]/value)"&gt;&lt;ns:dataconsegnaolo&gt;&lt;xsl:value-of select="xsd:date(xsd:dateTime(substring-before(string(column[name=&amp;quot;DATA_CONSEGNA_OLO&amp;quot;]/value),&amp;quot;+&amp;quot;)))"/&gt;&lt;/ns:dataconsegnaolo&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists(column[name=&amp;quot;DATAFI_VALID&amp;quot;]/value)"&gt;&lt;ns:dataFineValidita&gt;&lt;xsl:value-of select="xsd:date(xsd:dateTime(substring-before(string(column[name=&amp;quot;DATAFI_VALID&amp;quot;]/value),&amp;quot;+&amp;quot;)))"/&gt;&lt;/ns:dataFineValidita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists(column[name=&amp;quot;DATA_INVIO&amp;quot;]/value)"&gt;&lt;ns:dataInvio&gt;&lt;xsl:value-of select="xsd:date(xsd:dateTime(substring-before(string(column[name=&amp;quot;DATA_INVIO&amp;quot;]/value),&amp;quot;+&amp;quot;)))"/&gt;&lt;/ns:dataInvio&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name=&amp;quot;DRCP_CENTRALE&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;DRCP_CENTRALE&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;DRCP_CENTRALE&amp;quot;]/value)"&gt;&lt;ns:drcpCentrale&gt;&lt;xsl:value-of select="column[name=&amp;quot;DRCP_CENTRALE&amp;quot;]/value"/&gt;&lt;/ns:drcpCentrale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name=&amp;quot;COD_GAT&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;COD_GAT&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;COD_GAT&amp;quot;]/value)"&gt;&lt;ns:codiceGat&gt;&lt;xsl:value-of select="column[name=&amp;quot;COD_GAT&amp;quot;]/value"/&gt;&lt;/ns:codiceGat&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name=&amp;quot;NOME_CENTRALE&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;NOME_CENTRALE&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;NOME_CENTRALE&amp;quot;]/value)"&gt;&lt;ns:nomeCentrale&gt;&lt;xsl:value-of select="column[name=&amp;quot;NOME_CENTRALE&amp;quot;]/value"/&gt;&lt;/ns:nomeCentrale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name=&amp;quot;CODFC_OLO_AGCOM&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;CODFC_OLO_AGCOM&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;CODFC_OLO_AGCOM&amp;quot;]/value)"&gt;&lt;ns:codificaOloAgicom&gt;&lt;xsl:value-of select="column[name=&amp;quot;CODFC_OLO_AGCOM&amp;quot;]/value"/&gt;&lt;/ns:codificaOloAgicom&gt;&lt;/xsl:if&gt;&lt;/ns:visulizzaIDULLCO&gt;&lt;/xsl:for-each&gt;&lt;/ns:ResponseIDULLCOolo&gt;&lt;/output&gt;&lt;/tns:visualizzaIDULLCOResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/VisualizzaIDULLCO/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/cmf/visualizzaIDULLCO&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdullcoList&quot;/>&#xa;    &lt;xsl:template name=&quot;visualizzaIDULLCOOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:ResponseIDULLCOolo>&#xa;            &lt;xsl:for-each select=&quot;$IdullcoList/unknownResultset/row&quot;>&#xa;                &lt;ns:visulizzaIDULLCO>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name=&amp;quot;IDULLCO&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;IDULLCO&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;IDULLCO&amp;quot;]/value)&quot;>&#xa;                        &lt;ns:idullco>&#xa;                            &lt;xsl:value-of select=&quot;column[name=&amp;quot;IDULLCO&amp;quot;]/value&quot;/>&#xa;                        &lt;/ns:idullco>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name=&amp;quot;CLLI&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;CLLI&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;CLLI&amp;quot;]/value)&quot;>&#xa;                        &lt;ns:clli>&#xa;                            &lt;xsl:value-of select=&quot;column[name=&amp;quot;CLLI&amp;quot;]/value&quot;/>&#xa;                        &lt;/ns:clli>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists(column[name=&amp;quot;DATA_CONSEGNA_OLO&amp;quot;]/value)&quot;>&#xa;                        &lt;ns:dataconsegnaolo>&#xa;                            &lt;xsl:value-of select=&quot;xsd:date(xsd:dateTime(substring-before(string(column[name=&amp;quot;DATA_CONSEGNA_OLO&amp;quot;]/value),&amp;quot;+&amp;quot;)))&quot;/>&#xa;                        &lt;/ns:dataconsegnaolo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists(column[name=&amp;quot;DATAFI_VALID&amp;quot;]/value)&quot;>&#xa;                        &lt;ns:dataFineValidita>&#xa;                            &lt;xsl:value-of select=&quot;xsd:date(xsd:dateTime(substring-before(string(column[name=&amp;quot;DATAFI_VALID&amp;quot;]/value),&amp;quot;+&amp;quot;)))&quot;/>&#xa;                        &lt;/ns:dataFineValidita>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists(column[name=&amp;quot;DATA_INVIO&amp;quot;]/value)&quot;>&#xa;                        &lt;ns:dataInvio>&#xa;                            &lt;xsl:value-of select=&quot;xsd:date(xsd:dateTime(substring-before(string(column[name=&amp;quot;DATA_INVIO&amp;quot;]/value),&amp;quot;+&amp;quot;)))&quot;/>&#xa;                        &lt;/ns:dataInvio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name=&amp;quot;DRCP_CENTRALE&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;DRCP_CENTRALE&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;DRCP_CENTRALE&amp;quot;]/value)&quot;>&#xa;                        &lt;ns:drcpCentrale>&#xa;                            &lt;xsl:value-of select=&quot;column[name=&amp;quot;DRCP_CENTRALE&amp;quot;]/value&quot;/>&#xa;                        &lt;/ns:drcpCentrale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name=&amp;quot;COD_GAT&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;COD_GAT&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;COD_GAT&amp;quot;]/value)&quot;>&#xa;                        &lt;ns:codiceGat>&#xa;                            &lt;xsl:value-of select=&quot;column[name=&amp;quot;COD_GAT&amp;quot;]/value&quot;/>&#xa;                        &lt;/ns:codiceGat>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name=&amp;quot;NOME_CENTRALE&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;NOME_CENTRALE&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;NOME_CENTRALE&amp;quot;]/value)&quot;>&#xa;                        &lt;ns:nomeCentrale>&#xa;                            &lt;xsl:value-of select=&quot;column[name=&amp;quot;NOME_CENTRALE&amp;quot;]/value&quot;/>&#xa;                        &lt;/ns:nomeCentrale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name=&amp;quot;CODFC_OLO_AGCOM&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name=&amp;quot;CODFC_OLO_AGCOM&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name=&amp;quot;CODFC_OLO_AGCOM&amp;quot;]/value)&quot;>&#xa;                        &lt;ns:codificaOloAgicom>&#xa;                            &lt;xsl:value-of select=&quot;column[name=&amp;quot;CODFC_OLO_AGCOM&amp;quot;]/value&quot;/>&#xa;                        &lt;/ns:codificaOloAgicom>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns:visulizzaIDULLCO>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns:ResponseIDULLCOolo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
