                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ead8bb37-de7f-4cfc-90e1-b7d286f48f03+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/cmf/visualizzaIDULLCO&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;visualizzaIDULLCO.input&quot;/>&#xa;    &lt;xsl:template name=&quot;IdullcoList-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($visualizzaIDULLCO.input/ns:codificaOLOAgcom)>0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CLLI,COD_GAT,CODFC_OLO_AGCOM,DATA_CONSEGNA_OLO,DATAFI_VALID,DATA_INVIO,DRCP_CENTRALE,IDULLCO,NOME_CENTRALE FROM CLC_IDULLCO WHERE CODFC_OLO_AGCOM in ('&amp;quot;,tib:concat-sequence-format($visualizzaIDULLCO.input/ns:codificaOLOAgcom, &amp;quot;','&amp;quot;, true()),&amp;quot;') AND (CLLI='&amp;quot;,$visualizzaIDULLCO.input/ns:valoreRicerca,&amp;quot;' OR COD_GAT='&amp;quot;,$visualizzaIDULLCO.input/ns:valoreRicerca,&amp;quot;' OR IDULLCO='&amp;quot;,$visualizzaIDULLCO.input/ns:valoreRicerca,&amp;quot;') AND (DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(DATAFI_VALID,'DD-MM-YY'))) ORDER BY IDULLCO&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CLLI,COD_GAT,CODFC_OLO_AGCOM,DATA_CONSEGNA_OLO,DATAFI_VALID,DATA_INVIO,DRCP_CENTRALE,IDULLCO,NOME_CENTRALE FROM CLC_IDULLCO WHERE CLLI='&amp;quot;,$visualizzaIDULLCO.input/ns:valoreRicerca,&amp;quot;' OR COD_GAT='&amp;quot;,$visualizzaIDULLCO.input/ns:valoreRicerca,&amp;quot;' OR IDULLCO='&amp;quot;,$visualizzaIDULLCO.input/ns:valoreRicerca,&amp;quot;' AND (DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(DATAFI_VALID,'DD-MM-YY'))) ORDER BY IDULLCO&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
