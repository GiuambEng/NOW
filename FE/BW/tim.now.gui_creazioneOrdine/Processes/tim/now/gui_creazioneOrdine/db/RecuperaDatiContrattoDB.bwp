    <tibex:VariableDescriptor type="MemorySaving">
        <task name="FamigliaOfferta">
            <endingVariables>
                <variable>FamigliaOfferta-input</variable>
                <variable>RecuperoFamigliaOfferta</variable>
            </endingVariables>
        </task>
        <task name="RecuperoFamigliaOfferta">
            <endingVariables>
                <variable>RecuperoFamigliaOfferta-input</variable>
            </endingVariables>
        </task>
        <task name="RecuperoOfferte">
            <endingVariables>
                <variable>RecuperoOfferte-input</variable>
                <variable>RecuperaDatiContrattoOperation</variable>
            </endingVariables>
        </task>
        <task name="OfferteTipoProdotti">
            <endingVariables>
                <variable>OfferteTipoProdotti-input</variable>
                <variable>RecuperoOfferte</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
