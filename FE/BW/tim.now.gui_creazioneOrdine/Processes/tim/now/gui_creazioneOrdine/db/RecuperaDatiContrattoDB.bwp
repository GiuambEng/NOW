                                    sqlStatement="SELECT O.ID_SOTTOFAMIG_OFFERTA, SFO.DESCR, O.ID_OFFERTA, O.OFFERTA&#xa;FROM OFFERTA O&#xa;LEFT JOIN SOTTO_FAMIG_OFFERTA SFO ON SFO.ID_SOTTOFAMIG_OFFERTA = O.ID_SOTTOFAMIG_OFFERTA&#xa;WHERE O.ID_FAMIG_OFFERTA = ? AND O.SISTEMA_COMP = 'NOW'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

