                                    sqlStatement="SELECT O.ID_FAMIG_OFFERTA, FO.DESCR&#xd;&#xa;FROM OFFERTA O&#xd;&#xa;LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA = O.ID_FAMIG_OFFERTA&#xd;&#xa;WHERE O.SISTEMA_COMP = 'NOW'" xsi:type="jdbcPalette:JDBCQueryActivity">
