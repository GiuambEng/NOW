                                    sqlStatement="SELECT N.NUMERO_CIVICO&#xd;&#xa;FROM PROV P, COMUNE_O_LOCALITA C, PARTICELLA A, VIA V , NUMERO_CIVICO N&#xd;&#xa;WHERE P.COD_ISTAT_PROV = C.COD_ISTAT_PROV &#xd;&#xa;AND C.COD_ISTAT_COMUNE = V.COD_ISTAT_COMUNE &#xd;&#xa;AND V.COD_PARTICELLA_TOPON = A.COD_PARTICELLA_TOPON &#xd;&#xa;AND V.COD_STRADA = N.COD_STRADA &#xd;&#xa;AND upper(TRIM(P.DESCR_PROV)) = upper(?) &#xd;&#xa;AND upper(TRIM(C.DESCR_COMUNE))=upper(?) &#xd;&#xa;AND upper(TRIM(A.DESCR_PARTICELLA_TOPON))=upper(?) &#xd;&#xa;AND upper(TRIM(V.DESCR_VIA))=upper(?)&#xd;&#xa;ORDER BY N.NUMERO_CIVICO" xsi:type="jdbcPalette:JDBCQueryActivity">

