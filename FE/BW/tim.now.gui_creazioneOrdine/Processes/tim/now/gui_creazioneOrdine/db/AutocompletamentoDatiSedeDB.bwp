                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT V.DESCR_VIA&#xd;&#xa;FROM PROV P, COMUNE_O_LOCALITA C, PARTICELLA A, VIA V&#xd;&#xa;WHERE P.COD_ISTAT_PROV=C.COD_ISTAT_PROV AND C.COD_ISTAT_COMUNE=V.COD_ISTAT_COMUNE &#xd;&#xa;AND V.COD_PARTICELLA_TOPON = A.COD_PARTICELLA_TOPON &#xd;&#xa;AND upper(TRIM(P.DESCR_PROV))=upper(?) AND  upper(TRIM(C.DESCR_COMUNE))=upper(?) &#xd;&#xa;AND upper(TRIM(A.DESCR_PARTICELLA_TOPON))=upper(?) AND upper(TRIM(V.DESCR_VIA)) LIKE upper(?)&#xd;&#xa;ORDER BY V.DESCR_VIA" xsi:type="jdbcPalette:JDBCQueryActivity">

