                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/cmf/Orders" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/Orders/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;&lt;xsl:param name="VisualizzazioneServizi"/&gt;&lt;xsl:param name="Mapper3"/&gt;&lt;xsl:param name="SQLDirect2"/&gt;&lt;xsl:template name="ServiziOut-input" match="/"&gt;&lt;tns4:ServiceResponse&gt;&lt;parametersOutputService&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($VisualizzazioneServizi/Record) &gt; 0"&gt;&lt;tns:OutputOrdersService&gt;&lt;xsl:for-each select="$Mapper3/MapperServiziGerarchia"&gt;&lt;xsl:variable name="varIdDett" select="."/&gt;&lt;tns:OutputServizi&gt;&lt;tns:customizzazione&gt;&lt;xsl:for-each select="$SQLDirect2/unknownResultset/row[column[name='IDDETTAGLIOORDINE']/value=$varIdDett]"&gt;&lt;tns:OutputVisualizzaCustomizzazione&gt;&lt;xsl:if test="not((string(current()/column[name='NOMEATTRIBUTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(current()/column[name='NOMEATTRIBUTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(current()/column[name='NOMEATTRIBUTO']/value)"&gt;&lt;tns:AttributoCustomizzazione&gt;&lt;xsl:value-of select="current()/column[name='NOMEATTRIBUTO']/value"/&gt;&lt;/tns:AttributoCustomizzazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(current()/column[name='VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(current()/column[name='VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(current()/column[name='VALOREATTRIBUTO']/value)"&gt;&lt;tns:ValoreCustomizzazione&gt;&lt;xsl:value-of select="current()/column[name='VALOREATTRIBUTO']/value"/&gt;&lt;/tns:ValoreCustomizzazione&gt;&lt;/xsl:if&gt;&lt;/tns:OutputVisualizzaCustomizzazione&gt;&lt;/xsl:for-each&gt;&lt;/tns:customizzazione&gt;&lt;xsl:if test="not((string($VisualizzazioneServizi/Record[string(IDDETTAGLIOORDINE)=$varIdDett]/NOMECOMPONENTE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VisualizzazioneServizi/Record[string(IDDETTAGLIOORDINE)=$varIdDett]/NOMECOMPONENTE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VisualizzazioneServizi/Record[string(IDDETTAGLIOORDINE)=$varIdDett]/NOMECOMPONENTE)"&gt;&lt;tns:Prodotto&gt;&lt;xsl:value-of select="$VisualizzazioneServizi/Record[string(IDDETTAGLIOORDINE)=$varIdDett]/NOMECOMPONENTE"/&gt;&lt;/tns:Prodotto&gt;&lt;/xsl:if&gt;&lt;/tns:OutputServizi&gt;&lt;/xsl:for-each&gt;&lt;/tns:OutputOrdersService&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns:OutputOrdersService/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/parametersOutputService&gt;&lt;/tns4:ServiceResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/Orders/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneServizi&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper3&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirect2&quot;/>&#xa;    &lt;xsl:template name=&quot;ServiziOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($VisualizzazioneServizi/Record) > 0&quot;>&#xa;                &lt;tns:OutputOrdersService>&#xa;                    &lt;xsl:for-each select=&quot;$Mapper3/MapperServiziGerarchia&quot;>&#xa;                        &lt;xsl:variable name=&quot;varIdDett&quot; select=&quot;.&quot;/>&#xa;                        &lt;tns:OutputServizi>&#xa;                            &lt;tns:customizzazione>&#xa;                                &lt;xsl:for-each select=&quot;$SQLDirect2/unknownResultset/row[column[name='IDDETTAGLIOORDINE']/value=$varIdDett]&quot;>&#xa;                                    &lt;tns:OutputVisualizzaCustomizzazione>&#xa;                                        &lt;xsl:if test=&quot;not((string(current()/column[name='NOMEATTRIBUTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(current()/column[name='NOMEATTRIBUTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(current()/column[name='NOMEATTRIBUTO']/value)&quot;>&#xa;                                            &lt;tns:AttributoCustomizzazione>&#xa;                                                &lt;xsl:value-of select=&quot;current()/column[name='NOMEATTRIBUTO']/value&quot;/>&#xa;                                            &lt;/tns:AttributoCustomizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;not((string(current()/column[name='VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(current()/column[name='VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(current()/column[name='VALOREATTRIBUTO']/value)&quot;>&#xa;                                            &lt;tns:ValoreCustomizzazione>&#xa;                                                &lt;xsl:value-of select=&quot;current()/column[name='VALOREATTRIBUTO']/value&quot;/>&#xa;                                            &lt;/tns:ValoreCustomizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns:OutputVisualizzaCustomizzazione>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/tns:customizzazione>&#xa;                            &lt;xsl:if test=&quot;not((string($VisualizzazioneServizi/Record[string(IDDETTAGLIOORDINE)=$varIdDett]/NOMECOMPONENTE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($VisualizzazioneServizi/Record[string(IDDETTAGLIOORDINE)=$varIdDett]/NOMECOMPONENTE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($VisualizzazioneServizi/Record[string(IDDETTAGLIOORDINE)=$varIdDett]/NOMECOMPONENTE)&quot;>&#xa;                                &lt;tns:Prodotto>&#xa;                                    &lt;xsl:value-of select=&quot;$VisualizzazioneServizi/Record[string(IDDETTAGLIOORDINE)=$varIdDett]/NOMECOMPONENTE&quot;/>&#xa;                                &lt;/tns:Prodotto>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:OutputServizi>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:OutputOrdersService>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OutputOrdersService/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="Mapper3ToServiziOut"/>
                                    <bpws:target linkName="EmptyToServiziOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+50bf34af-babb-490b-a8a5-437e79dca516+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Service&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneServizi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;$Service/parametersInputService/tns:InputOrdersService/tns:idrichiestaolo&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;            &lt;IDRICHIESTAOLO1>&#xa;                &lt;xsl:value-of select=&quot;$Service/parametersInputService/tns:InputOrdersService/tns:idrichiestaolo&quot;/>&#xa;            &lt;/IDRICHIESTAOLO1>&#xa;            &lt;IDRICHIESTAOLO2>&#xa;                &lt;xsl:value-of select=&quot;$Service/parametersInputService/tns:InputOrdersService/tns:idrichiestaolo&quot;/>&#xa;            &lt;/IDRICHIESTAOLO2>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VisualizzazioneServizi-input"
                                    name="VisualizzazioneServizi"
                                    outputVariable="VisualizzazioneServizi"
                                    tibex:xpdlId="50bf34af-babb-490b-a8a5-437e79dca516" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStart2ToJDBCQuery2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VisualizzazioneServiziToIterate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($VisualizzazioneServizi/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($VisualizzazioneServizi/Record) > 0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VisualizzazioneServiziToEmpty_noRecord">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+50bf34af-babb-490b-a8a5-437e79dca516+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Service.parametersInputService&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneServizi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;$Service.parametersInputService/tns:idrichiestaolo&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;            &lt;IDRICHIESTAOLO1>&#xa;                &lt;xsl:value-of select=&quot;$Service.parametersInputService/tns:idrichiestaolo&quot;/>&#xa;            &lt;/IDRICHIESTAOLO1>&#xa;            &lt;IDRICHIESTAOLO2>&#xa;                &lt;xsl:value-of select=&quot;$Service.parametersInputService/tns:idrichiestaolo&quot;/>&#xa;            &lt;/IDRICHIESTAOLO2>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement=" select DO.IDDETTAGLIOORDINE, DO.IDDETTAGLIOORDINEPARENT, DO.IDDETTAGLIOORDINEROOT, DO.NOMECOMPONENTE&#xa;   from  BDS_1_CASEDATA_DETTAGLIOORDINE DO &#xa;  WHERE DO.IDRICHIESTAOLO = ? and DO.NOMECOMPONENTE in   ( select  distinct (ATT.NOME_COMPNTE)&#xa;   from DIZ_DATI_COMPNTE ATT&#xa;   where ATT.ID_OFFERTA in  ( select O.ID_OFFERTA    &#xa;  FROM   APPUSER.BDS_1_CASEDATA_RICHIESTA R &#xa;    LEFT OUTER JOIN APPUSER.CONTRATTO_OFFERTA_CATLG COC ON R.IDCONTRATTO = COC.ID_CONTRATTO &#xa;    LEFT OUTER JOIN APPUSER.OFFERTA O ON COC.ID_OFFERTA = O.ID_OFFERTA &#xa;   WHERE R.IDRICHIESTAOLO = ?   ) AND  ATT.FLAG_VISIBILITA_GUI='Y' and ATT.NOME_COMPNTE in (select DO.NOMECOMPONENTE&#xa;   from  BDS_1_CASEDATA_DETTAGLIOORDINE DO &#xa;  WHERE DO.IDRICHIESTAOLO = ?))"
                                    useNil="true" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO2"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOORDINE"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOORDINEPARENT"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOORDINEROOT"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:scope name="Iterate"
                                tibex:group="iterate" tibex:xpdlId="1b852244-8412-47df-8fa5-707f4cb3c055">
                                <bpws:targets>
                                    <bpws:target linkName="VisualizzazioneServiziToIterate"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="IterateToSQLDirect2"/>
                                </bpws:sources>
                                <bpws:sequence name="sequence" tibex:group="iterate">
                                    <bpws:assign name="GroupInit"
                                    tibex:group="groupInit"
                                    tibex:xpdlId="ba77337b-a9d6-45ee-873c-47e09057abb9" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+0d34cbf8-9624-4552-a5c5-163bb9ae25bc" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:forEach counterName="index"
                                    name="iterate" parallel="no" tibex:group="iterate">
                                    <tibex:DesignExpression name="variableList">
                                    <tibex:expression
                                    expression="$VisualizzazioneServizi/Record" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($VisualizzazioneServizi/Record)]]></bpws:finalCounterValue>
