                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT R.IDRICHIESTAOLO , R.CODICEORDINEOLO , R.DATAINVIORICHIESTA , R.CODICEORDINETI , R.CANALERICHIESTA , R.TIPORICHIESTA , R.STATORICHIESTANOW , &#xa;R.STATORICHIESTAOLO , R.CODIFICAOLOAGCOM , R.CODIFICAOLONOW , R.NOTE , R.IDRISORSA , R.CODICEORDINEOLOPADRE , R.CODICEORDINEOLOTARGET , &#xa;R.CODICEPROGETTO , R.FLAGNAKED , R.LAVORAZIONE , R.TESTMODE , R.LASTUPDATE , R.CREATED , R.DRO , O.DAC, O.DES , OLO.NOME AS OLONOME ,&#xa;AC.COD_CAUS_NOW_DG , AC.COD_CAUS_OLO , AC.DESCR_CAUS_OLO , AC.DESCR_CAUS_NOW_DG , RD.NOME AS RDNOME, RD.IDTPLG_DATO_RICH, RD.VALORE, RD.PROGRS_TIPOLG_DATO_RICH&#xa;FROM&#xa;BDS_1_CASEDATA_RICHIESTA R&#xa;LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.IDRICHIESTAOLO = R.IDRICHIESTAOLO&#xa;LEFT JOIN OLO ON OLO.CODFC_OLO_AGCOM = R.CODIFICAOLOAGCOM&#xa;LEFT JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = R.IDANAGRAFICACAUSALE&#xa;LEFT JOIN APPUSER.RICH_OLO_DETT RD ON RD.ID_RICH_OLO = R.IDRICHIESTAOLO&#xa;WHERE R.CODICEORDINETI = (?)&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

