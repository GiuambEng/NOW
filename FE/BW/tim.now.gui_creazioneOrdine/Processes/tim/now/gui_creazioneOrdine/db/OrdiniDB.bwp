                                    <bpws:sources>
                                    <bpws:source linkName="Mapper1ToOrdersListNoOloOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect1&quot;/>&lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SQLDirect1/unknownResultset/row)>0&quot;>&lt;tns:OutputOrdersListNoOlo>&lt;xsl:for-each select=&quot;$SQLDirect1/unknownResultset/row&quot;>&lt;tns:OutputListaOrdiniNoOLO>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLO']/value)&quot;>&lt;tns:codiceordineolo>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLO']/value&quot;/>&lt;/tns:codiceordineolo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLONOW']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLONOW']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLONOW']/value)&quot;>&lt;tns:cod_olo_now>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLONOW']/value&quot;/>&lt;/tns:cod_olo_now>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCR_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_CAUS_OLO']/value)&quot;>&lt;tns:descriz_causal_olo>&lt;xsl:value-of select=&quot;column[name='DESCR_CAUS_OLO']/value&quot;/>&lt;/tns:descriz_causal_olo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPORICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPORICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exis