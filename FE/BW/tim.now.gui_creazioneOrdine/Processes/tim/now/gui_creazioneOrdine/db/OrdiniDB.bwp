                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+47568a9f-d9ed-40d2-bf45-3ea55cb1a632+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Orders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OrdersDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneDettaglioOrdine-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;codord>&#xa;                &lt;xsl:value-of select=&quot;$OrdersDetails/parametersInputOrdersDetails/tns:InputOrdersDetailsOfTheOrder/tns:codord&quot;/>&#xa;            &lt;/codord>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
