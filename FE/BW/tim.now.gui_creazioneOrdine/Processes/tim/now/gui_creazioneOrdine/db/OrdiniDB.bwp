                            <bpws:reply
                                name="VisualizzazioneDettaglioOut"
                                operation="OrdersDetails"
                                partnerLink="OrderPort"
                                portType="ns21:OrderPort"
                                tibex:xpdlId="f1ece809-a36d-4789-a4f2-07c3395db749" variable="VisualizzazioneDettaglioOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/Orders/" xmlns:tns="http://www.tim.com/NOW/cmf/Orders" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="VisualizzazioneDettaglioOrdine"/&gt;
    &lt;xsl:template name="VisualizzazioneDettaglioOut-input" match="/"&gt;
        &lt;tns4:OrdersDetailsResponse&gt;
            &lt;parametersOutputOrdersDetails&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="count($VisualizzazioneDettaglioOrdine/Record)&gt;0"&gt;
                        &lt;tns:OutputOrdersDetailsOfTheOrder&gt;
                            &lt;xsl:for-each select="$VisualizzazioneDettaglioOrdine/Record"&gt;
                                &lt;tns:OutputVisualizzaDettaglioOrdine&gt;
                                    &lt;xsl:if test="DESCR_CAUS_NOW_DG"&gt;
                                        &lt;tns:CodiceCausaleNOW&gt;
                                            &lt;xsl:value-of select="DESCR_CAUS_NOW_DG"/&gt;
                                        &lt;/tns:CodiceCausaleNOW&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="DESCR_CAUS_OLO"&gt;
                                        &lt;tns:CodiceCausaleOLO&gt;
                                            &lt;xsl:value-of select="DESCR_CAUS_OLO"/&gt;
                                        &lt;/tns:CodiceCausaleOLO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="COD_CAUS_OLO"&gt;
                                        &lt;tns:DescrizioneCausaleOLO&gt;
                                            &lt;xsl:value-of select="COD_CAUS_OLO"/&gt;
                                        &lt;/tns:DescrizioneCausaleOLO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="COD_CAUS_NOW_DG"&gt;
                                        &lt;tns:DescrizioneCausaleNOW&gt;
                                            &lt;xsl:value-of select="COD_CAUS_NOW_DG"/&gt;
                                        &lt;/tns:DescrizioneCausaleNOW&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="DUVO"&gt;
                                        &lt;tns:DUVO&gt;
                                            &lt;xsl:value-of select="DUVO"/&gt;
                                        &lt;/tns:DUVO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="TIPOLOGIASOTTOLAV"&gt;
                                        &lt;tns:Sottolavorazione&gt;
                                            &lt;xsl:value-of select="TIPOLOGIASOTTOLAV"/&gt;
                                        &lt;/tns:Sottolavorazione&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="TIPOLOGIALAVORAZIONE"&gt;
                                        &lt;tns:TipoLavorazione&gt;
                                            &lt;xsl:value-of select="TIPOLOGIALAVORAZIONE"/&gt;
                                        &lt;/tns:TipoLavorazione&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="MODALITAFATTURAZIONE"&gt;
                                        &lt;tns:ModalitaFatturazione&gt;
                                            &lt;xsl:value-of select="MODALITAFATTURAZIONE"/&gt;
                                        &lt;/tns:ModalitaFatturazione&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="DPP"&gt;
                                        &lt;tns:DPP&gt;
