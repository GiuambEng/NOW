zzazione>&#xa;                        &lt;tns:OutputVisualizzaCustomizzazione>&#xa;                            &lt;tns:AttributoCustomizzazione>&#xa;                                &lt;xsl:value-of select=&quot;'ORDINE_DETTAGLIOORDINE_BDSID'&quot;/>&#xa;                            &lt;/tns:AttributoCustomizzazione>&#xa;                            &lt;xsl:if test=&quot;ORDINE_DETTAGLIOORDINE_BDSID&quot;>&#xa;                                &lt;tns:ValoreCustomizzazione>&#xa;                                    &lt;xsl:value-of select=&quot;ORDINE_DETTAGLIOORDINE_BDSID&quot;/>&#xa;                                &lt;/tns:ValoreCustomizzazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:OutputVisualizzaCustomizzazione>&#xa;                        &lt;tns:OutputVisualizzaCustomizzazione>&#xa;                            &lt;tns:AttributoCustomizzazione>&#xa;                                &lt;xsl:value-of select=&quot;'ORDINE_DETTAGLIOORDINE_IDX'&quot;/>&#xa;                            &lt;/tns:AttributoCustomizzazione>&#xa;                            &lt;xsl:if test=&quot;ORDINE_DETTAGLIOORDINE_IDX&quot;>&#xa;                                &lt;tns:ValoreCustomizzazione>&#xa;                                    &lt;xsl:value-of select=&quot;ORDINE_DETTAGLIOORDINE_IDX&quot;/>&#xa;                                &lt;/tns:ValoreCustomizzazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:OutputVisualizzaCustomizzazione>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:OutputOrdersCustomizzazione>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OutputOrdersCustomizzazione>&#xa;                    &lt;tns:OutputVisualizzaCustomizzazione/>&#xa;                &lt;/tns:OutputOrdersCustomizzazione>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="ur