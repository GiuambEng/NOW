                                    <bpws:sources>
                                    <bpws:source linkName="MapperToListaOrdineOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SQLDirect/unknownResultset/row)>0&quot;>&lt;tns:OutputOrdersList>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&lt;tns:ListaOrdiniOutput>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLO']/value)&quot;>&lt;tns:codiceordineolo>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLO']/value&quot;/>&lt;/tns:codiceordineolo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLONOW']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLONOW']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLONOW']/value)&quot;>&lt;tns:cod_olo_now>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLONOW']/value&quot;/>&lt;/tns:cod_olo_now>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCR_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_CAUS_OLO']/value)&quot;>&lt;tns:descriz_causal_olo>&lt;xsl:value-of select=&quot;column[name='DESCR_CAUS_OLO']/value&quot;/>&lt;/tns:descriz_causal_olo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name = 'TIPORICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'TIPORICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'TIPORICHIESTA']/value)&quot;>&lt;tns:tipoRichiesta>&lt;xsl:value-of select=&quot;column[name = 'TIPORICHIESTA']/value&quot;/>&lt;/tns:tipoRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINETI']/value)&quot;>&lt;tns:codiceordineti>&lt;xsl:value-of select=&quot;column[name='CODICEORDINETI']/value&quot;/>&lt;/tns:codiceordineti>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLOAGCOM']/value)&quot;>&lt;tns:codfc_olo_agcom>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLOAGCOM']/value&quot;/>&lt;/tns:codfc_olo_agcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CANALERICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CANALERICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CANALERICHIESTA']/value)&quot;>&lt;tns:canalerichiesta>&lt;xsl:value-of select=&quot;column[name='CANALERICHIESTA']/value&quot;/>&lt;/tns:canalerichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATORICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATORICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATORICHIESTAOLO']/value)&quot;>&lt;tns:statorichiesteolo>&lt;xsl:value-of select=&quot;column[name='STATORICHIESTAOLO']/value&quot;/>&lt;/tns:statorichiesteolo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATORICHIESTANOW']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATORICHIESTANOW']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATORICHIESTANOW']/value)&quot;>&lt;tns:statorichiestanow>&lt;xsl:value-of select=&quot;column[name='STATORICHIESTANOW']/value&quot;/>&lt;/tns:statorichiestanow>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCR_CAUS_NOW_DG']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_CAUS_NOW_DG']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_CAUS_NOW_DG']/value)&quot;>&lt;tns:descrz_caus_now_dg>&lt;xsl:value-of select=&quot;column[name='DESCR_CAUS_NOW_DG']/value&quot;/>&lt;/tns:descrz_caus_now_dg>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDRICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDRICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDRICHIESTAOLO']/value)&quot;>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;column[name='IDRICHIESTAOLO']/value&quot;/>&lt;/tns:idRichiestaOlo>&lt;/xsl:if>&lt;/tns:ListaOrdiniOutput>&lt;/xsl:for-each>&lt;/tns:OutputOrdersList>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputOrdersList>&lt;tns:ListaOrdiniOutput/>&lt;/tns:OutputOrdersList>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:Orders="http://www.tim.com/NOW/cmf/Orders"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Orders:OutputOrdersList" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
                <bpws:onMessage operation="OrdersData"
                    partnerLink="OrderPort" portType="ns21:OrderPort"
                    tibex:xpdlId="bfda77c5-736a-4f32-99db-7de0e3d1b9e3" variable="OrdersData">
                    <bpws:scope name="scope2">
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="OnMessageStart1ToJDBCQuery1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery1ToDatiOrdineOut" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="OnMessageStart1"
                                tibex:constructor="onMessageStart" tibex:xpdlId="dcb1f033-ad75-4407-b7ee-ce6c7e7c7f43">
                                <bpws:sources>
                                    <bpws:source linkName="OnMessageStart1ToJDBCQuery1"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="OnMessageEnd1"
                                tibex:constructor="onMessageEnd" tibex:xpdlId="43c5d5cb-3282-47db-8746-0d53440d19a0"/>
                            <bpws:reply name="DatiOrdineOut"
                                operation="OrdersData"
                                partnerLink="OrderPort"
                                portType="ns21:OrderPort"
                                tibex:xpdlId="80c3d26c-c310-401b-9c67-3510a82efbd2" variable="DatiOrdineOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/Orders/" xmlns:tns="http://www.tim.com/NOW/cmf/Orders" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="VisualizzazioneDati"/&gt;
    &lt;xsl:template name="DatiOrdineOut-input" match="/"&gt;
        &lt;tns4:OrdersDataResponse&gt;
            &lt;parametersOutputOrdersData&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="count($VisualizzazioneDati/Record)&gt;0"&gt;
                        &lt;tns:OutputOrdersData&gt;
                            &lt;xsl:for-each select="$VisualizzazioneDati/Record"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="string-length(CODICEORDINETI)&gt;0"&gt;
                                        &lt;tns:OutputDatiOrdine&gt;
                                            &lt;xsl:if test="CODICEORDINETI"&gt;
                                                &lt;tns:codiceOrdineTI&gt;
                                                    &lt;xsl:value-of select="CODICEORDINETI"/&gt;
                                                &lt;/tns:codiceOrdineTI&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="CODIFICAOLOAGCOM"&gt;
                                                &lt;tns:codificaOloAgcom&gt;
                                                    &lt;xsl:value-of select="CODIFICAOLOAGCOM"/&gt;
                                                &lt;/tns:codificaOloAgcom&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="CODIFICAOLONOW"&gt;
                                                &lt;tns:codiceOloNow&gt;
                                                    &lt;xsl:value-of select="CODIFICAOLONOW"/&gt;
                                                &lt;/tns:codiceOloNow&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;tns:idrichiestaolo&gt;
                                                &lt;xsl:value-of select="IDRICHIESTAOLO"/&gt;
                                            &lt;/tns:idrichiestaolo&gt;
                                            &lt;xsl:if test="CODICEORDINEOLO"&gt;
                                                &lt;tns:codiceOrdineOLO&gt;
                                                    &lt;xsl:value-of select="CODICEORDINEOLO"/&gt;
                                                &lt;/tns:codiceOrdineOLO&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="DATAINVIORICHIESTA"&gt;
                                                &lt;tns:dataInvioRichiesta&gt;
                                                    &lt;xsl:value-of select="DATAINVIORICHIESTA"/&gt;
                                                &lt;/tns:dataInvioRichiesta&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="CANALERICHIESTA"&gt;
                                                &lt;tns:canaleRichiesta&gt;
                                                    &lt;xsl:value-of select="CANALERICHIESTA"/&gt;
                                                &lt;/tns:canaleRichiesta&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="TIPORICHIESTA"&gt;
                                                &lt;tns:tipoRichiesta&gt;
                                                    &lt;xsl:value-of select="TIPORICHIESTA"/&gt;
                                                &lt;/tns:tipoRichiesta&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="STATORICHIESTANOW"&gt;
                                                &lt;tns:statoRichiestaNow&gt;
                                                    &lt;xsl:value-of select="STATORICHIESTANOW"/&gt;
                                                &lt;/tns:statoRichiestaNow&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="STATORICHIESTAOLO"&gt;
                                                &lt;tns:statoRichiestaOlo&gt;
                                                    &lt;xsl:value-of select="STATORICHIESTAOLO"/&gt;
                                                &lt;/tns:statoRichiestaOlo&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="NOTE"&gt;
                                                &lt;tns:note&gt;
                                                    &lt;xsl:value-of select="NOTE"/&gt;
                                                &lt;/tns:note&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="DRO"&gt;
                                                &lt;tns:dro&gt;
                                                    &lt;xsl:value-of select="DRO"/&gt;
                                                &lt;/tns:dro&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="OLONOME"&gt;
                                                &lt;tns:oao&gt;
                                                    &lt;xsl:value-of select="OLONOME"/&gt;
                                                &lt;/tns:oao&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="COD_CAUS_NOW_DG"&gt;
                                                &lt;tns:codiceCausaleNow&gt;
                                                    &lt;xsl:value-of select="COD_CAUS_NOW_DG"/&gt;
                                                &lt;/tns:codiceCausaleNow&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="COD_CAUS_OLO"&gt;
                                                &lt;tns:codiceCausaleOao&gt;
                                                    &lt;xsl:value-of select="COD_CAUS_OLO"/&gt;
                                                &lt;/tns:codiceCausaleOao&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="DESCR_CAUS_OLO"&gt;
                                                &lt;tns:causaleOao&gt;
                                                    &lt;xsl:value-of select="DESCR_CAUS_OLO"/&gt;
                                                &lt;/tns:causaleOao&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="DESCR_CAUS_NOW_DG"&gt;
                                                &lt;tns:descrizioneCausaleNow&gt;
                                                    &lt;xsl:value-of select="DESCR_CAUS_NOW_DG"/&gt;
                                                &lt;/tns:descrizioneCausaleNow&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="IDRISORSA"&gt;
                                                &lt;tns:idRisorsa&gt;
                                                    &lt;xsl:value-of select="IDRISORSA"/&gt;
                                                &lt;/tns:idRisorsa&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="DAC"&gt;
                                                &lt;tns:dac&gt;
                                                    &lt;xsl:value-of select="DAC"/&gt;
                                                &lt;/tns:dac&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="DES"&gt;
                                                &lt;tns:des&gt;
                                                    &lt;xsl:value-of select="DES"/&gt;
                                                &lt;/tns:des&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="CODICEORDINEOLOPADRE"&gt;
                                                &lt;tns:codiceOrdineOloPadre&gt;
                                                    &lt;xsl:value-of select="CODICEORDINEOLOPADRE"/&gt;
                                                &lt;/tns:codiceOrdineOloPadre&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="CODICEORDINEOLOTARGET"&gt;
                                                &lt;tns:codiceOrdineOloTarget&gt;
                                                    &lt;xsl:value-of select="CODICEORDINEOLOTARGET"/&gt;
                                                &lt;/tns:codiceOrdineOloTarget&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="CODICEPROGETTO"&gt;
                                                &lt;tns:codiceProgetto&gt;
                                                    &lt;xsl:value-of select="CODICEPROGETTO"/&gt;
                                                &lt;/tns:codiceProgetto&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="FLAGNAKED"&gt;
                                                &lt;tns:flagNaked&gt;
                                                    &lt;xsl:value-of select="FLAGNAKED"/&gt;
                                                &lt;/tns:flagNaked&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="LAVORAZIONE"&gt;
                                                &lt;tns:lavorazioneRichiesta&gt;
                                                    &lt;xsl:value-of select="LAVORAZIONE"/&gt;
                                                &lt;/tns:lavorazioneRichiesta&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="TESTMODE"&gt;
                                                &lt;tns:testMode&gt;
                                                    &lt;xsl:value-of select="TESTMODE"/&gt;
                                                &lt;/tns:testMode&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="LASTUPDATE"&gt;
                                                &lt;tns:timestampAggiornamento&gt;
                                                    &lt;xsl:value-of select="LASTUPDATE"/&gt;
                                                &lt;/tns:timestampAggiornamento&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="CREATED"&gt;
                                                &lt;tns:timestampInserimento&gt;
                                                    &lt;xsl:value-of select="CREATED"/&gt;
                                                &lt;/tns:timestampInserimento&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/tns:OutputDatiOrdine&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns:OutputDatiOrdine&gt;
                                            &lt;tns:codiceordineTInonvalorizzato&gt;
                                                &lt;xsl:if test="RDNOME"&gt;
                                                    &lt;tns:nome&gt;
                                                        &lt;xsl:value-of select="RDNOME"/&gt;
                                                    &lt;/tns:nome&gt;
                                                &lt;/xsl:if&gt;
                                                &lt;tns:progressivo&gt;
                                                    &lt;xsl:value-of select="xsd:int(PROGRS_TIPOLG_DATO_RICH)"/&gt;
                                                &lt;/tns:progressivo&gt;
                                                &lt;xsl:if test="IDTPLG_DATO_RICH"&gt;
                                                    &lt;tns:tipologiadatorichiesta&gt;
                                                        &lt;xsl:value-of select="IDTPLG_DATO_RICH"/&gt;
                                                    &lt;/tns:tipologiadatorichiesta&gt;
                                                &lt;/xsl:if&gt;
                                                &lt;xsl:if test="VALORE"&gt;
                                                    &lt;tns:richiestadettagliovalore&gt;
                                                        &lt;xsl:value-of select="VALORE"/&gt;
                                                    &lt;/tns:richiestadettagliovalore&gt;
                                                &lt;/xsl:if&gt;
                                            &lt;/tns:codiceordineTInonvalorizzato&gt;
                                        &lt;/tns:OutputDatiOrdine&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/tns:OutputOrdersData&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:OutputOrdersData/&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/parametersOutputOrdersData&gt;
        &lt;/tns4:OrdersDataResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/Orders/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneDati&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiOrdineOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($VisualizzazioneDati/Record)>0&quot;>&#xa;                &lt;tns:OutputOrdersData>&#xa;                    &lt;xsl:for-each select=&quot;$VisualizzazioneDati/Record&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(CODICEORDINETI)>0&quot;>&#xa;                                &lt;tns:OutputDatiOrdine>&#xa;                                    &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                                        &lt;tns:codiceOrdineTI>&#xa;                                            &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                        &lt;/tns:codiceOrdineTI>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                        &lt;tns:codificaOloAgcom>&#xa;                                            &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                        &lt;/tns:codificaOloAgcom>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&#xa;                                        &lt;tns:codiceOloNow>&#xa;                                            &lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&#xa