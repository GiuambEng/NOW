      &lt;xsl:if test=&quot;CREATED&quot;>&#xa;                                &lt;tns:dataInserimento>&#xa;                                    &lt;xsl:value-of select=&quot;CREATED&quot;/>&#xa;                                &lt;/tns:dataInserimento>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:OutputReferentiContattati>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:OutputOrdersReferents>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OutputOrdersReferents/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
