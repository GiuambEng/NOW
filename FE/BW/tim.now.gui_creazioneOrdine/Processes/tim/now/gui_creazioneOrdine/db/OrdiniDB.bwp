    &lt;xsl:template name="ReferentiOut-input" match="/"&gt;
        &lt;tns4:ReferentsResponse&gt;
            &lt;parametersOutputReferents&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="count($VisualizzazioneReferenti/Record)&gt;0"&gt;
                        &lt;tns:OutputOrdersReferents&gt;
                            &lt;xsl:for-each select="$VisualizzazioneReferenti/Record"&gt;
                                &lt;tns:OutputReferentiContattati&gt;
                                    &lt;xsl:if test="NOMEREFERENTE"&gt;
                                        &lt;tns:Nome&gt;
                                            &lt;xsl:value-of select="NOMEREFERENTE"/&gt;
                                        &lt;/tns:Nome&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="COGNOMEREFERENTE"&gt;
                                        &lt;tns:Cognome&gt;
                                            &lt;xsl:value-of select="COGNOMEREFERENTE"/&gt;
                                        &lt;/tns:Cognome&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="TELEFONOFISSOREFERENTE"&gt;
                                        &lt;tns:Telefono&gt;
                                            &lt;xsl:value-of select="TELEFONOFISSOREFERENTE"/&gt;
                                        &lt;/tns:Telefono&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="TELEFONOMOBILEREFERENTE"&gt;
                                        &lt;tns:Cellulare&gt;
                                            &lt;xsl:value-of select="TELEFONOMOBILEREFERENTE"/&gt;
                                        &lt;/tns:Cellulare&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="QUALIFICAREFERENTE"&gt;
                                        &lt;tns:Qualifica&gt;
                                            &lt;xsl:value-of select="QUALIFICAREFERENTE"/&gt;
                                        &lt;/tns:Qualifica&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="TIPOREFERENTEORDINE = 'REFERENTEONFIELD'"&gt;
                                            &lt;tns:FlagOnField&gt;
                                                &lt;xsl:value-of select="&amp;quot;Y&amp;quot;"/&gt;
