      &lt;/tns:lavorazioneRichiesta>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TESTMODE&quot;>&#xa;                                        &lt;tns:testMode>&#xa;                                            &lt;xsl:value-of select=&quot;TESTMODE&quot;/>&#xa;                                        &lt;/tns:testMode>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;LASTUPDATE&quot;>&#xa;                                        &lt;tns:timestampAggiornamento>&#xa;                                            &lt;xsl:value-of select=&quot;LASTUPDATE&quot;/>&#xa;                                        &lt;/tns:timestampAggiornamento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;CREATED&quot;>&#xa;                                        &lt;tns:timestampInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;CREATED&quot;/>&#xa;                                        &lt;/tns:timestampInserimento>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns:OutputDatiOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:OutputDatiOrdine>&#xa;                                    &lt;tns:codiceordineTInonvalorizzato>&#xa;                                        &lt;xsl:if test=&quot;RDNOME&quot;>&#xa;                                            &lt;tns:nome>&#xa;                                                &lt;xsl:value-of select=&quot;RDNOME&quot;/>&#xa;                                            &lt;/tns:nome>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns:progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(PROGRS_TIPOLG_DATO_RICH)&quot;/>&#xa;                                        &lt;/tns:progressivo>&#xa;                                        &lt;xsl:if test=&quot;IDTPLG_DATO_RICH&quot;>&#xa;                                            &lt;tns:tipologiadatorichiesta>&#xa;                                                &lt;xsl:value-of select=&quot;IDTPLG_DATO_RICH&quot;/>&#xa;                                            &lt;/tns:tipologiadatorichiesta>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;VALORE&quot;>&#xa;                                            &lt;tns:richiestadettagliovalore>&#xa;                                                &lt;xsl:value-of select=&quot;VALORE&quot;/>&#xa;                                            &lt;/tns:richiestadettagliovalore>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns:codiceordineTInonvalorizzato>&#xa;                                &lt;/tns:OutputDatiOrdine>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:OutputOrdersData>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OutputOrdersData/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
