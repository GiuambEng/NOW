                                            &lt;xsl:value-of select="LASTUPDATE"/&gt;
                                        &lt;/tns:dataUltimoAggiornamento&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="CREATED"&gt;
                                        &lt;tns:dataInserimento&gt;
                                            &lt;xsl:value-of select="CREATED"/&gt;
                                        &lt;/tns:dataInserimento&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:OutputReferentiContattati&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/tns:OutputOrdersReferents&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:OutputOrdersReferents/&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/parametersOutputReferents&gt;
        &lt;/tns4:ReferentsResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
