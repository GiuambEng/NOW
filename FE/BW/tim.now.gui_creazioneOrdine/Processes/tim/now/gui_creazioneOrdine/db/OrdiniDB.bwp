s:statoRichiestaNow>&#xa;                                            &lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&#xa;                                        &lt;/tns:statoRichiestaNow>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&#xa;                                        &lt;tns:statoRichiestaOlo>&#xa;                                            &lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&#xa;                                        &lt;/tns:statoRichiestaOlo>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;NOTE&quot;>&#xa;                                        &lt;tns:note>&#xa;                                            &lt;xsl:value-of select=&quot;NOTE&quot;/>&#xa;                                        &lt;/tns:note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DRO&quot;>&#xa;                                        &lt;tns:dro>&#xa;                                            &lt;xsl:value-of select=&quot;DRO&quot;/>&#xa;                                        &lt;/tns:dro>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;OLONOME&quot;>&#xa;                                        &lt;tns:oao>&#xa;                                            &lt;xsl:value-of select=&quot;OLONOME&quot;/>&#xa;                                        &lt;/tns:oao>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;COD_CAUS_NOW_DG&quot;>&#xa;                                        &lt;tns:codiceCausaleNow>&#xa;                                            &lt;xsl:value-of select=&quot;COD_CAUS_NOW_DG&quot;/>&#xa;                                        &lt;/tns:codiceCausaleNow>&#xa;                          