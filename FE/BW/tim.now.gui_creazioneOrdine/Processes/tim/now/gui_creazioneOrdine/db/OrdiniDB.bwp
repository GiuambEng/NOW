                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DO.IDRICHIESTAOLO, DO.IDDETTAGLIOORDINE, DO.IDDETTAGLIOORDINEPARENT,&#xa;  DO.IDDETTAGLIOORDINEROOT, DO.CREATED, DO.LASTUPDATE, DO.OPERATORE,&#xa;  DO.IDRISORSA, DO.NUMEROTELEFONICO, DO.NOMECOMPONENTE, O.IDTIPOLOGIAACCESSO,&#xa;  DO.INTEGRATIONID, DO.BDS_OWNER_ID, DO.ORDINE_DETTAGLIOORDINE_BDSID,&#xa;  DO.ORDINE_DETTAGLIOORDINE_IDX&#xa;  FROM&#xa;       APPUSER.BDS_1_CASEDATA_ORDINE O LEFT OUTER JOIN APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE DO ON DO.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;  WHERE O.CODICEORDINETI = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codordineti"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOORDINE"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOORDINEPARENT"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOORDINEROOT"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="LASTUPDATE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
