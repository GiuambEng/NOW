                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7e0121ab-7a03-4e49-8f21-f46331f8dc75+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OrdersList&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;select R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO, R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,R.STATORICHIESTAOLO ,R.STATORICHIESTANOW, AC.DESCR_CAUS_OLO, AC.DESCR_CAUS_NOW_DG , R.IDRICHIESTAOLO from BDS_1_CASEDATA_RICHIESTA R left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE WHERE R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW' AND  R.CODIFICAOLOAGCOM IN ('&amp;quot;, tib:concat-sequence-format&amp;#xD;&amp;#xA;($OrdersList/parametersInputOrdersList/tns:InputOrdersList/tns:listaOrdiniInput/tns:codOlo, &amp;quot;','&amp;quot;, true()),&amp;quot;') ORDER BY R.LASTUPDATE DESC&amp;quot; )&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SQLDirect-input"
                                    name="SQLDirect"
                                    outputVariable="SQLDirect"
                                    tibex:xpdlId="7e0121ab-7a03-4e49-8f21-f46331f8dc75" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToSQLDirect"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SQLDirectToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7e0121ab-7a03-4e49-8f21-f46331f8dc75+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OrdersList.parametersInputOrdersList&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;select R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO, R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,R.STATORICHIESTAOLO ,R.STATORICHIESTANOW, AC.DESCR_CAUS_OLO, AC.DESCR_CAUS_NOW_DG , R.IDRICHIESTAOLO from BDS_1_CASEDATA_RICHIESTA R left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE WHERE R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW' AND  R.CODIFICAOLOAGCOM IN ('&amp;quot;, tib:concat-sequence-format&amp;#xD;&amp;#xA;($OrdersList.parametersInputOrdersList/tns:listaOrdiniInput/tns:codOlo, &amp;quot;','&amp;quot;, true()),&amp;quot;') ORDER BY R.LASTUPDATE DESC&amp;quot; )&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="f6547ac2-f5ff-4014-a63e-c5c15404d56c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
