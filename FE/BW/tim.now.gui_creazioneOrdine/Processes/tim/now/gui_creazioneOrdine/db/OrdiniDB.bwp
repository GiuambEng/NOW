              &lt;tns:DNOloCollaudo>&#xa;                                    &lt;xsl:value-of select=&quot;DNOLOCOLLAUDO&quot;/>&#xa;                                &lt;/tns:DNOloCollaudo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDSLUCO&quot;>&#xa;                                &lt;tns:IDSLUCO>&#xa;                                    &lt;xsl:value-of select=&quot;IDSLUCO&quot;/>&#xa;                                &lt;/tns:IDSLUCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DADRIMODULATA&quot;>&#xa;                                &lt;tns:DADRimodulata>&#xa;                                    &lt;xsl:value-of select=&quot;DADRIMODULATA&quot;/>&#xa;                                &lt;/tns:DADRimodulata>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;RO&quot;>&#xa;                                &lt;tns:RO>&#xa;                                    &lt;xsl:value-of select=&quot;RO&quot;/>&#xa;                                &lt;/tns:RO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TOTALERICHIESTERILEVPAC&quot;>&#xa;                                &lt;tns:totaleRichiesteRilevPac>&#xa;                                    &lt;xsl:value-of select=&quot;TOTALERICHIESTERILEVPAC&quot;/>&#xa;                                &lt;/tns:totaleRichiesteRilevPac>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOME&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COGNOMERAGIONESOCIALE&quot;>&#xa;                                &lt;tns:cognomeRagioneSociale>&#xa;                                    &lt;xsl:value-of select=&quot;COGNOMERAGIONESOCIALE&quot;/>&#xa;                                &lt;/tns:cognomeRagioneSociale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CF&quot;>&#xa;                                &lt;tns:cf>&#xa;                                    &lt;xsl:value-of select=&quot;CF&quot;/>&#xa;                                &lt;/tns:cf>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;PIVA&quot;>&#xa;                                &lt;tns:piva>&#xa;                                    &lt;xsl:value-of select=&quot;PIVA&quot;/>&#xa;                                &lt;/tns:piva>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:bds_Id>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BDS_ID)&quot;/>&#xa;                            &lt;/tns:bds_Id>&#xa;                            &lt;xsl:if test=&quot;CONTENUTOXML&quot;>&#xa;                                &lt;tns:CONTENUTOXML>&#xa;                                    &lt;xsl:value-of select=&quot;CONTENUTOXML&quot;/>&#xa;                                &lt;/tns:CONTENUTOXML>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:OutputVisualizzaDettaglioOrdine>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:OutputOrdersDetailsOfTheOrder>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OutputOrdersDetailsOfTheOrder>&#xa;                    &lt;tns:OutputVisualizzaDettaglioOrdine/>&#xa;                &lt;/tns:OutputOrdersDetailsOfTheOrder>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
