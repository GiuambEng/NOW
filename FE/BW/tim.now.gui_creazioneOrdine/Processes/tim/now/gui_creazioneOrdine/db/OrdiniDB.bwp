                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT&#xa;    AC.COD_CAUS_NOW_DG, AC.COD_CAUS_OLO, AC.DESCR_CAUS_OLO, AC.DESCR_CAUS_NOW_DG, O.TIPOLOGIASOTTOLAV, &#xa;    O.TIPOLOGIALAVORAZIONE, O.MODALITAFATTURAZIONE, O.DPP, O.TIPOPACCHETTO, O.NOTECLIENTE, O.IDRISORSA,&#xa;    O.CODICEORDINEOLO, O.FLAGLAVORAZIONEMANUALE, O.CODICEORDINETI, O.NOTEDASISTEMA,&#xa;    OLO.COD_OLO, CNT.NOME_CONTRATTO, O.CODICEORDINEOLOPADRE, O.DATACHIUSURAORDINE, R.IDCORRELAZIONE,&#xa;    O.CODICEDELIVERY, O.CODICETTM, O.FLAGMONITORAGGIO, R.STATORICHIESTANOW, R.STATORICHIESTAOLO,&#xa;    O.NOME, O.COGNOMERAGIONESOCIALE, O.CF, O.PIVA, O.OFFERTACATALOGO, R.DRO, O.DAC, O.DACRIMODULATA, O.DES, &#xa;    O.DEC, O.DAD, FO.FASCIA_ORARIA, O.DATAINVIOORDINEADELIVERY, O.DATAINVIOCOMMERCIALIZZ, CI.IDULLCO,&#xa;    O.NUMEROVERDEOLOPT, O.NUMEROVERDEOLOCOLLAUDO, O.CLLI, CI.COD_GAT, O.DNOLOCOLLAUDO, CS.IDSLUCO,&#xa;    O.DADRIMODULATA, O.RO, O.LASTUPDATE, FP.NOME_FILE, O.TOTALEORDINIPACCHETTO, R.CODICEPROGETTO, R.DATAINVIORICHIESTA,&#xa;    S.INDIRIZZOESTESO, S.PIANO, S.PROVINCIA, S.SCALA, S.COMPLESSO, S.CAP, S.LOCALITA, S.CODICEISTATCOMUNE, S.COMUNE, S.CODICEISTATPROVINCIA,&#xa;    R.TOTALERICHIESTERILEVPAC, O.TIPOLOGIAQUALITA, S.TIPOLOGIASEDE, O.DUVO, DO.BDS_ID,R.CONTENUTOXML &#xa;FROM &#xa;    BDS_1_CASEDATA_ORDINE O&#xa;    LEFT OUTER JOIN OLO ON OLO.CODFC_OLO_AGCOM = O.CODIFICAOLOAGCOM&#xa;    LEFT OUTER JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;&#x9;  LEFT OUTER JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = R.IDANAGRAFICACAUSALE&#xa;&#x9;  LEFT OUTER JOIN CONTRATTO CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO&#xa;    LEFT OUTER JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA = R.IDFASCIAORARIA&#xa;    LEFT OUTER JOIN CLC_IDULLCO CI ON CI.IDULLCO = O.IDULLCO&#xa;    LEFT OUTER JOIN CLC_IDSLUCO CS ON CS.IDSLUCO = O.IDSLUCO&#xa;    LEFT OUTER JOIN FILE_PROCSTO FP ON FP.ID_FILE = R.IDFILEINPUT&#xa;    LEFT OUTER JOIN BDS_1_CASEDATA_SEDE S ON S.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;&#x9;  LEFT OUTER JOIN BDS_1_CASEDATA_DETTAGLIOORDINE DO ON DO.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;&#x9;  LEFT OUTER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLRDN ADO ON ADO.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID = DO.BDS_ID&#xa;WHERE O.CODICEORDINETI = (?)" xsi:type="jdbcPalette:JDBCQueryActivity">

