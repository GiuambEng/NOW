                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d597cb62-ce57-481b-9c9d-fb613149b113+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Servizi&quot;/>&#xa;    &lt;xsl:template name=&quot;ServiziFWA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;idAsset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Servizi/parameters/tns1:inputServiziAsset/tns1:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Servizi/parameters/tns1:inputServiziAsset/tns1:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ServiziFWA-input"
                                    name="ServiziFWA"
                                    outputVariable="ServiziFWA"
                                    tibex:xpdlId="d597cb62-ce57-481b-9c9d-fb613149b113" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStart1ToServiziFWA_FWACessato"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ServiziFWAToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d597cb62-ce57-481b-9c9d-fb613149b113+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Servizi.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ServiziFWA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;idAsset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Servizi.parameters/tns1:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Servizi.parameters/tns1:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DA.IDDETTAGLIOASSET, DA.IDDETTAGLIOASSETPARENT, DA.IDDETTAGLIOASSETROOT, DA.NOMECOMPONENTE&#xa;FROM BDS_1_CASEDATA_DETTAGLIOASSET DA &#xa;WHERE DA.IDASSET = ?&#xa;AND DA.NOMECOMPONENTE = 'ACCESSOFWA'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idAsset"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOASSET"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOASSETPARENT"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOASSETROOT"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="dettaglio"
                                    name="Assign"
                                    outputVariable="dettaglio"
                                    tibex:xpdlId="de147ab2-f1b8-4e81-8f99-3a79169da4c7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VisualizzaServiziToAssign"/>
                                    <bpws:target linkName="ServiziFWAToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToIterate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($dettaglio/tns:dettaglioAsset/tns:idDettaglioAsset)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($dettaglio/tns:dettaglioAsset/tns:idDettaglioAsset)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AssignToReply">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ServiziFWA&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzaServizi&quot;/>&#xa;    &lt;xsl:template name=&quot;dettaglio&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($VisualizzaServizi/Record/IDDETTAGLIOASSET)>0&quot;>&#xa;                &lt;tns1:dettaglioAsset>&#xa;                    &lt;xsl:for-each select=&quot;$VisualizzaServizi/Record&quot;>&#xa;                        &lt;tns1:dettaglioAsset>&#xa;                            &lt;xsl:if test=&quot;IDDETTAGLIOASSET&quot;>&#xa;                                &lt;tns1:idDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDETTAGLIOASSET&quot;/>&#xa;                                &lt;/tns1:idDettaglioAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDDETTAGLIOASSETPARENT&quot;>&#xa;                                &lt;tns1:idDettaglioAssetParent>&#xa;                                    &lt;xsl:value-of select=&quot;IDDETTAGLIOASSETPARENT&quot;/>&#xa;                                &lt;/tns1:idDettaglioAssetParent>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDDETTAGLIOASSETROOT&quot;>&#xa;                                &lt;tns1:idDettaglioAssetRoot>&#xa;                                    &lt;xsl:value-of select=&quot;IDDETTAGLIOASSETROOT&quot;/>&#xa;                                &lt;/tns1:idDettaglioAssetRoot>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;NOMECOMPONENTE = 'ACCESSOCANALE'&quot;>&#xa;                                    &lt;tns1:nomeComponente>&#xa;                                        &lt;xsl:value-of select=&quot;'CANALEMULTICAST'&quot;/>&#xa;                                    &lt;/tns1:nomeComponente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;NOMECOMPONENTE&quot;>&#xa;                                        &lt;tns1:nomeComponente>&#xa;                                            &lt;xsl:value-of select=&quot;NOMECOMPONENTE&quot;/>&#xa;                                        &lt;/tns1:nomeComponente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns1:dettaglioAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:dettaglioAsset>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:dettaglioAsset>&#xa;                    &lt;xsl:for-each select=&quot;$ServiziFWA/Record&quot;>&#xa;                        &lt;tns1:dettaglioAsset>&#xa;                            &lt;xsl:if test=&quot;IDDETTAGLIOASSET&quot;>&#xa;                                &lt;tns1:idDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDETTAGLIOASSET&quot;/>&#xa;                                &lt;/tns1:idDettaglioAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDDETTAGLIOASSETPARENT&quot;>&#xa;                                &lt;tns1:idDettaglioAssetParent>&#xa;                                    &lt;xsl:value-of select=&quot;IDDETTAGLIOASSETPARENT&quot;/>&#xa;                                &lt;/tns1:idDettaglioAssetParent>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDDETTAGLIOASSETROOT&quot;>&#xa;                                &lt;tns1:idDettaglioAssetRoot>&#xa;                                    &lt;xsl:value-of select=&quot;IDDETTAGLIOASSETROOT&quot;/>&#xa;                                &lt;/tns1:idDettaglioAssetRoot>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOMECOMPONENTE&quot;>&#xa;                                &lt;tns1:nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;NOMECOMPONENTE&quot;/>&#xa;                                &lt;/tns1:nomeComponente>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:dettaglioAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:dettaglioAsset>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="dettaglio" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
