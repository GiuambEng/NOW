                        &lt;/tns1:nomecontratto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCRIPTION&quot;>&#xa;                        &lt;tns1:statoContratto>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCRIPTION&quot;/>&#xa;                        &lt;/tns1:statoContratto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CODICEORDINETI&quot;>&#xa;                        &lt;tns1:primoOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CODICEORDINETI&quot;/>&#xa;                        &lt;/tns1:primoOrdineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CODICEORDINEOLO&quot;>&#xa;                        &lt;tns1:codiceOrdineOAOPrimoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                        &lt;/tns1:codiceOrdineOAOPrimoOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA) and string-length($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCR_PROV&quot;>&#xa;                                &lt;tns1:provincia>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCR_PROV&quot;/>&#xa;                                &lt;/tns1:provincia>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/PROVINCIA&quot;>&#xa;                                &lt;tns1:provincia>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/PROVINCIA&quot;/>&#xa;                                &lt;/tns1:provincia>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA) and string-length($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCR_COMUNE&quot;>&#xa;                                &lt;tns1:comune>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCR_COMUNE&quot;/>&#xa;                                &lt;/tns1:comune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/COMUNE&quot;>&#xa;                                &lt;tns1:comune>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/COMUNE&quot;/>&#xa;                                &lt;/tns1:comune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA) and string-length($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCR_COMUNE&quot;>&#xa;         