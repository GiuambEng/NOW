                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/Asset&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLListaAsset&quot;/>&lt;xsl:template name=&quot;ListaOutput-input&quot; match=&quot;/&quot;>&lt;tns:OutputAsset1>&lt;xsl:for-each select=&quot;$SQLListaAsset/unknownResultset/row&quot;>&lt;tns:OutputAsset>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLO']/value)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLO']/value&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINETI']/value)&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;column[name='CODICEORDINETI']/value&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLOAGCOM']/value)&quot;>&lt;tns:oao>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLOAGCOM']/value&quot;/>&lt;/tns:oao>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDASSETCRMWS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDASSETCRMWS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDASSETCRMWS']/value)&quot;>&lt;tns:idAssetCrm>&lt;xsl:value-of select=&quot;column[name='IDASSETCRMWS']/value&quot;/>&lt;/tns:idAssetCrm>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDRISORSA']/value)&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;column[name='IDRISORSA']/value&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDASSET']/value)&quot;>&lt;tns:identificativoAsset>&lt;xsl:value-of select=&quot;column[name='IDASSET']/value&quot;/>&lt;/tns:identificativoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATOASSET']/value)&quot;>&lt;tns:identificativoStatoAsset>&lt;xsl:value-of select=&quot;column[name='STATOASSET']/value&quot;/>&lt;/tns:identificativoStatoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLOGIAACCESSO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLOGIAACCESSO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLOGIAACCESSO']/value)&quot;>&lt;tns:identificativoTipologiaAccesso>&lt;xsl:value-of select=&quot;column[name='TIPOLOGIAACCESSO']/value&quot;/>&lt;/tns:identificativoTipologiaAccesso>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']/value)&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;column[name='OFFERTA']/value&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/tns:OutputAsset>&lt;/xsl:for-each>&lt;/tns:OutputAsset1>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="ur