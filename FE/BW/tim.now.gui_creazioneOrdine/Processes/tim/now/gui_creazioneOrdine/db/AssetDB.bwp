                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CL.CODICEFISCALE,CL.COGNOMERAGIONESOCIALE,CL.NOME,CL.PARTITAIVA,A.IDRISORSANOW,A.IDRISORSA, A.IDOFFERTA, A.IDASSETCRMWS, A.NUMEROFITTIZIO,&#xd;&#xa;A.IDASSET, A.LINEARIFERIMENTO, A.CODICETOPONOMASTICA, A.DES, A.DEC, O.CODICEPROGETTO, A.DESPRIMOORDINE, A.IDASSETDA, A.RO, A.CREATED,&#xd;&#xa;A.LASTUPDATE, A.INVARIANTE, O.LNA_LA, O.MODALITAFATTURAZIONE, A.NUMEROTELEFONICO, A.OPERATORE,A.STATOASSET, A.OFFERTA, &#xd;&#xa;A.IDCONTRATTO, A.CLLI, C.NOME_CONTRATTO, C.COD_CONTRATTO, TSC.DESCRIPTION, A.PROVINCIA, A.COMUNE, A.LOCALITA, A.DESCRPARTTOPONOMASTICA, A.DESCRIZIONEVIA, &#xd;&#xa;A.NUMEROCIVICO, A.CAP, A.COMPLESSO, A.INTERNO, A.SCALA, A.PIANO,A.CODIFICAOLOAGCOM, A.CODIFICAOLOAGCOMDONATING, A.CODIFICAOLOAGCOMDONOR, to_char( A.ORA_DES, 'HH24:MI' ) ORA_DES, R.CODICEORDINEOLO, R.CODICEORDINETI, NC.COD_TOPON,NC.NUMERO_CIVICO,NC.CAP AS CAP_NUM_CIV,NC.COD_STRADA,&#xd;&#xa;V.DESCR_VIA, V.COD_COMUNE, V.COD_PARTICELLA_TOPON, P.DESCR_PARTICELLA_TOPON, CL.DESCR_COMUNE, CL.FLAG_COMUNE, PROV.DESCR_PROV, &#xd;&#xa;PROV.COD_PROV, OFF.NOME_OFFERTA_CATLG, nvl(O.CODICESLAASSURANCE,A.CODICESLAASSURANCE) CODICESLAASSURANCE, A.CODICEISTATCOMUNE, A.OPZIONEDINAMICA, &#xd;&#xa;AR.STATOASSET AS STATOASSETRICARICA, a.codiceordineolo AS CODORDOLOASSET, a.codiceordineti as CODORDTIASSET, a.IDRISORSAOPERATORERETE, A.OPERATORERETE,A.STATODISASSET, A.CARATTERIZZAZIONEAREA, A.ONTOPERATORE, A.MODELSERVPERVALIDAZIONI, A.CODOPERATORESECONDARIO, A.DESCOPERATORESECONDARIO&#xd;&#xa;FROM BDS_1_CASEDATA_ASSET A &#xd;&#xa;LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI &#xd;&#xa;LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO&#xd;&#xa;LEFT JOIN TIPOLG_STATO_CONTRATTO TSC ON TSC.ID_STATO_CONTRATTO = C.ID_STATO_CONTRATTO&#xd;&#xa;LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = A.IDPRIMOORDINE&#xd;&#xa;LEFT JOIN NUMERO_CIVICO NC ON NC.COD_TOPON = A.CODICETOPONOMASTICA&#xd;&#xa;LEFT JOIN VIA V ON V.COD_STRADA = NC.COD_STRADA&#xd;&#xa;LEFT JOIN PARTICELLA P ON P.COD_PARTICELLA_TOPON = V.COD_PARTICELLA_TOPON&#xd;&#xa;LEFT JOIN COMUNE_O_LOCALITA CL ON CL.COD_COMUNE = V.COD_COMUNE&#xd;&#xa;LEFT JOIN PROV ON PROV.COD_PROV = CL.COD_PROV&#xd;&#xa;LEFT JOIN BDS_1_CASEDATA_CLIENTE CL ON CL.IDASSET = A.IDASSET&#xd;&#xa;LEFT JOIN OFFERTA OFF ON OFF.ID_OFFERTA = A.IDOFFERTA&#xd;&#xa;LEFT JOIN BDS_1_CASEDATA_ASSETRICARICA AR ON AR.IDASSET = A.IDASSET&#xd;&#xa;WHERE A.STATOASSET='ATTIVO' AND A.IDRISORSA = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

