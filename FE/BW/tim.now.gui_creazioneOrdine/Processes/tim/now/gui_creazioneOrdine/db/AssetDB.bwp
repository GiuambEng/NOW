                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AssetDetailsOperation1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryDettaglioAssetIdAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryDettaglioAssetIdRisorsa&quot;/>&#xa;    &lt;xsl:template name=&quot;dettaglioVariable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;upper-case($AssetDetailsOperation1.parameters/tns1:nomecampo)=&amp;quot;IDASSET&amp;quot;&quot;>&#xa;                &lt;tns1:OutputAssetDetails>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CODIFICAOLOAGCOM&quot;>&#xa;                        &lt;tns1:codOAOAgcom>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                        &lt;/tns1:codOAOAgcom>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DEC&quot;>&#xa;                        &lt;tns1:dec>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DEC&quot;/>&#xa;                        &lt;/tns1:dec>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DES&quot;>&#xa;                        &lt;tns1:des>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DES&quot;/>&#xa;                        &lt;/tns1:des>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CLLI&quot;>&#xa;                        &lt;