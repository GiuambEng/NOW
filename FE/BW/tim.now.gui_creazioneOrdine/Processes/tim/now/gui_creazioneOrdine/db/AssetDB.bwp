                                tibex:xpdlId="d9151d58-f23f-4796-89a8-bf2d28b47af6" variable="ListaAssetOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/Asset/" xmlns:tns="http://www.tim.com/NOW/cmf/Asset" version="2.0"&gt;
    &lt;xsl:param name="ListaOutput"/&gt;
    &lt;xsl:template name="ListaAssetOut-input" match="/"&gt;
        &lt;tns2:AssetListOperationNEWResponse&gt;
            &lt;parameters&gt;
                &lt;tns:OutputAsset1&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($ListaOutput/tns:OutputAsset) &gt; 0"&gt;
                            &lt;xsl:copy-of select="$ListaOutput/tns:OutputAsset"/&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns:OutputAsset/&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns:OutputAsset1&gt;
            &lt;/parameters&gt;
        &lt;/tns2:AssetListOperationNEWResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
