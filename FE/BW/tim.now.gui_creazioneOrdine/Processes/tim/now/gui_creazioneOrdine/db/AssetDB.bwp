   &lt;xsl:value-of select=&quot;string($QueryDettaglioAssetIdRisorsa/Record[1]/IDASSETCRMWS)&quot;/>&#xa;                            &lt;/tns1:idAssetCRMWS>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/IDRISORSA&quot;>&#xa;                                &lt;tns1:id_risorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/IDRISORSA&quot;/>&#xa;                                &lt;/tns1:id_risorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/IDRISORSANOW&quot;>&#xa;                                &lt;tns1:idRisorsaNow>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/IDRISORSANOW&quot;/>&#xa;                                &lt;/tns1:idRisorsaNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:idAsset>&#xa;                                &lt;xsl:value-of select=&quot;string($QueryDettaglioAssetIdRisorsa/Record[1]/IDASSET)&quot;/>&#xa;                            &lt;/tns1:idAsset>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODIFICAOLOAGCOMDONATING&quot;>&#xa;                                &lt;tns1:oaoDonating>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODIFICAOLOAGCOMDONATING&quot;/>&#xa;                                &lt;/tns1:oaoDonating>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODIFICAOLOAGCOMDONOR&quot;>&#xa;                                &lt;tns1:oaoDonor>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODIFICAOLOAGCOMDONOR&quot;/>&#xa;                                &lt;/tns1:oaoDonor>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/STATOASSET&quot;>&#xa;                                &lt;tns1:statoAsset>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/STATOASSET&quot;/>&#xa;                                &lt;/tns1:statoAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/NOME&quot;>&#xa;                                &lt;tns1:nome>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/NOME&quot;/>&#xa;                                &lt;/tns1:nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/COGNOMERAGIONESOCIALE&quot;>&#xa;                                &lt;tns1:cognome_ragSociale>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&#xa;                                &lt;/tns1:cognome_ragSociale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODICEFISCALE&quot;>&#xa;                                &lt;tns1:CF>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODICEFISCALE&quot;/>&#xa;                                &lt;/tns1:CF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/PARTITAIVA&quot;>&#xa;                                &lt;tns1:P.IVA>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/PARTITAIVA&quot;/>&#xa;                                &lt;/tns1:P.IVA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                                &lt;tns1:nomeOffertaCatalogo>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                                &lt;/tns1:nomeOffertaCatalogo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODICESLAASSURANCE&quot;>&#xa;                                &lt;tns1:codSlaAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODICESLAASSURANCE&quot;/>&#xa;                                &lt;/tns1:codSlaAssurance>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODICEISTATCOMUNE&quot;>&#xa;                                &lt;tns1:codIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODICEISTATCOMUNE&quot;/>&#xa;                                &lt;/tns1:codIstatComune>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/OPZIONEDINAMICA&quot;>&#xa;                                &lt;tns1:opzioneDinamica>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/OPZIONEDINAMICA&quot;/>&#xa;                                &lt;/tns1:opzioneDinamica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[OPZIONEDINAMICA = 'Y']/STATOASSETRICARICA = 'ACCESA'&quot;>&#xa;                                &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[OPZIONEDINAMICA = 'Y' and STATOASSETRICARICA = 'ACCESA']/STATOASSETRICARICA&quot;>&#xa;                                    &lt;tns1:statoServizioDinamico>&#xa;                                        &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[OPZIONEDINAMICA = 'Y' and STATOASSETRICARICA = 'ACCESA']/STATOASSETRICARICA&quot;/>&#xa;                                    &lt;/tns1:statoServizioDinamico>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODORDOLOASSET&quot;>&#xa;                                &lt;tns1:ordineOao>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODORDOLOASSET&quot;/>&#xa;                                &lt;/tns1:ordineOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODORDTIASSET&quot;>&#xa;                                &lt;tns1:ordineTI>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODORDTIASSET&quot;/>&#xa;                                &lt;/tns1:ordineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/IDRISORSAOPERATORERETE&quot;>&#xa;                                &lt;tns1:idRisorsaOperatoreRete>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/IDRISORSAOPERATORERETE&quot;/>&#xa;                                &lt;/tns1:idRisorsaOperatoreRete>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/OPERATORERETE&quot;>&#xa;                                &lt;tns1:operatoreRete>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/OPERATORERETE&quot;/>&#xa;                                &lt;/tns1:operatoreRete>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/STATODISASSET&quot;>&#xa;                                &lt;tns1:statoDisabilitazioneAsset>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/STATODISASSET&quot;/>&#xa;                                &lt;/tns1:statoDisabilitazioneAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CARATTERIZZAZIONEAREA&quot;>&#xa;                                &lt;tns1:caratterizzazioneArea>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CARATTERIZZAZIONEAREA&quot;/>&#xa;                                &lt;/tns1:caratterizzazioneArea>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/ONTOPERATORE&quot;>&#xa;                                &lt;tns1:ontOperatore>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/ONTOPERATORE&quot;/>&#xa;                                &lt;/tns1:ontOperatore>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/MODELSERVPERVALIDAZIONI&quot;>&#xa;                                &lt;tns1:modelloServizioPerValidazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/MODELSERVPERVALIDAZIONI&quot;/>&#xa;                                &lt;/tns1:modelloServizioPerValidazioni>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODOPERATORESECONDARIO&quot;>&#xa;                                &lt;tns1:codiceOperatoreSecondario>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/CODOPERATORESECONDARIO&quot;/>&#xa;                                &lt;/tns1:codiceOperatoreSecondario>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/DESCOPERATORESECONDARIO&quot;>&#xa;                                &lt;tns1:descrizioneOperatoreSecondario>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdRisorsa/Record[1]/DESCOPERATORESECONDARIO&quot;/>&#xa;                                &lt;/tns1:descrizioneOperatoreSecondario>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:OutputAssetDetails>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
