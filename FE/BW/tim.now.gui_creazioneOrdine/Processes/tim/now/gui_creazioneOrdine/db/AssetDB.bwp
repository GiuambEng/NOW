                </bpws:onMessage>
                <bpws:onMessage operation="Servizi"
                    partnerLink="AssetPort" portType="ns2:AssetPort"
                    tibex:xpdlId="eee71c01-c6f9-4265-b13c-60e7b1d022c8" variable="Servizi">
                    <bpws:scope name="scope2">
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="OnMessageStart1ToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="SQLDirectToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToReply"
                                    tibex:label="NoRecord" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="AssignToIterate" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="IterateToSQLDirect" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Servizi2ToRecuperaAggiuntiviCPS" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Servizi2ToReply" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="RecuperaAggiuntiviCPSToReply" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="VisualizzaServiziToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="OnMessageStart1ToServiziFWA_FWACessato"
                                    tibex:label="FWA Cessato" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="ServiziFWAToAssign" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="OnMessageStart1"
                                tibex:constructor="onMessageStart" tibex:xpdlId="045f236e-432b-4038-b434-5ef203ce750f">
                                <bpws:sources>
                                    <bpws:source linkName="OnMessageStart1ToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="OnMessageStart1ToServiziFWA_FWACessato">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Servizi/parameters/tns:inputServiziAsset/tns:statoAsset = 'CESSATO' and $Servizi/parameters/tns:inputServiziAsset/tns:idOfferta = '46'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Servizi.parameters/tns:statoAsset = 'CESSATO' and $Servizi.parameters/tns:idOfferta = '46']]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="OnMessageEnd1"
                                tibex:constructor="onMessageEnd" tibex:xpdlId="f436adcf-99fa-4c1f-b6e3-dc4007d880c9"/>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+54527408-b677-4c6f-8de3-3e452a405090+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Servizi&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzaServizi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;idAsset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Servizi/parameters/tns1:inputServiziAsset/tns1:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Servizi/parameters/tns1:inputServiziAsset/tns1:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset>&#xa;            &lt;idAsset2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Servizi/parameters/tns1:inputServiziAsset/tns1:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Servizi/parameters/tns1:inputServiziAsset/tns1:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset2>&#xa;            &lt;idAsset3>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Servizi/parameters/tns1:inputServiziAsset/tns1:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Servizi/parameters/tns1:inputServiziAsset/tns1:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset3>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VisualizzaServizi-input"
                                    name="VisualizzaServizi"
                                    outputVariable="VisualizzaServizi"
                                    tibex:xpdlId="54527408-b677-4c6f-8de3-3e452a405090" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStart1ToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VisualizzaServiziToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+54527408-b677-4c6f-8de3-3e452a405090+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Servizi.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzaServizi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;idAsset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Servizi.parameters/tns1:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Servizi.parameters/tns1:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset>&#xa;            &lt;idAsset2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Servizi.parameters/tns1:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Servizi.parameters/tns1:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset2>&#xa;            &lt;idAsset3>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Servizi.parameters/tns1:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Servizi.parameters/tns1:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset3>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DA.IDDETTAGLIOASSET, DA.IDDETTAGLIOASSETPARENT, DA.IDDETTAGLIOASSETROOT, DA.NOMECOMPONENTE&#xd;&#xa;FROM BDS_1_CASEDATA_DETTAGLIOASSET DA &#xd;&#xa;WHERE DA.IDASSET = ?&#xd;&#xa;AND DA.STATODETTAGLIOASSET = 'ATTIVO'&#xd;&#xa;AND DA.NOMECOMPONENTE IN (SELECT  DISTINCT (ATT.NOME_COMPNTE)&#xd;&#xa;                          FROM DIZ_DATI_COMPNTE ATT &#xd;&#xa;                          WHERE ATT.ID_OFFERTA IN (SELECT O.ID_OFFERTA &#xd;&#xa;                                                  FROM BDS_1_CASEDATA_ASSET A&#xd;&#xa;                                                  LEFT JOIN CONTRATTO_OFFERTA_CATLG COC ON A.IDCONTRATTO = COC.ID_CONTRATTO &#xd;&#xa;                                                  LEFT JOIN OFFERTA O ON COC.ID_OFFERTA = O.ID_OFFERTA&#xd;&#xa;                                                  WHERE A.IDASSET = ?)&#xd;&#xa;                          AND ATT.FLAG_VISIBILITA_GUI = 'Y'&#xd;&#xa;                          AND ATT.NOME_COMPNTE IN (SELECT DA.NOMECOMPONENTE &#xd;&#xa;                                                    FROM BDS_1_CASEDATA_DETTAGLIOASSET DA &#xd;&#xa;                                                    WHERE DA.IDASSET = ?))" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idAsset"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idAsset2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idAsset3"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOASSET"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOASSETPARENT"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOASSETROOT"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e9958ad9-4ee7-4bbc-994a-9f5e5be6b2a8+input&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1474385837633&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Servizi&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT ATRA.NOMEATTRIBUTO, ATRA.VALOREATTRIBUTO, DA.IDDETTAGLIOASSET, DA.IDDETTAGLIOASSETPARENT, DA.IDDETTAGLIOASSETROOT, DA.NOMECOMPONENTE  , (select PROFILO from PROFILO_VLAN_BMD where ID_PROFILO_BMD = ATRA.VALOREATTRIBUTO and ATRA.NOMEATTRIBUTO='PROFILOBMD' )as descr_bmd FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST ATRA LEFT JOIN BDS_1_CASEDATA_DETTAGLIOASSET DA ON DA.IDDETTAGLIOASSET = ATRA.IDDETTAGLIOASSET AND DA.IDASSET = ATRA.IDASSET WHERE ATRA.IDDETTAGLIOASSET IN ('&amp;quot;, tib:concat-sequence-format&amp;#xD;&amp;#xA;($Accumulate/tns4:MapperGerarchia/MapperServiziGerarchia, &amp;quot;','&amp;quot;, true()),&amp;quot;') AND ATRA.IDASSET = '&amp;quot;,$Servizi/parameters/tns1:inputServiziAsset/tns1:idAsset,&amp;quot;'&amp;quot; )&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns3:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SQLDirect-input"
                                    name="SQLDirect"
                                    outputVariable="SQLDirect"
                                    tibex:xpdlId="e9958ad9-4ee7-4bbc-994a-9f5e5be6b2a8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="IterateToSQLDirect"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SQLDirectToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e9958ad9-4ee7-4bbc-994a-9f5e5be6b2a8+input&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1474385837633&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Servizi.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT ATRA.NOMEATTRIBUTO, ATRA.VALOREATTRIBUTO, DA.IDDETTAGLIOASSET, DA.IDDETTAGLIOASSETPARENT, DA.IDDETTAGLIOASSETROOT, DA.NOMECOMPONENTE  , (select PROFILO from PROFILO_VLAN_BMD where ID_PROFILO_BMD = ATRA.VALOREATTRIBUTO and ATRA.NOMEATTRIBUTO='PROFILOBMD' )as descr_bmd FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST ATRA LEFT JOIN BDS_1_CASEDATA_DETTAGLIOASSET DA ON DA.IDDETTAGLIOASSET = ATRA.IDDETTAGLIOASSET AND DA.IDASSET = ATRA.IDASSET WHERE ATRA.IDDETTAGLIOASSET IN ('&amp;quot;, tib:concat-sequence-format&amp;#xD;&amp;#xA;($Accumulate/tns4:MapperGerarchia/MapperServiziGerarchia, &amp;quot;','&amp;quot;, true()),&amp;quot;') AND ATRA.IDASSET = '&amp;quot;,$Servizi.parameters/tns1:idAsset,&amp;quot;'&amp;quot; )&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns3:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Servizi2-input"
                                    name="Servizi2"
                                    outputVariable="Servizi2"
                                    tibex:xpdlId="0d363283-f7f9-474f-967a-1bf4d0246614" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SQLDirectToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Servizi2ToRecuperaAggiuntiviCPS">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Servizi/parameters/tns:inputServiziAsset/tns:idOfferta = '47' and $SQLDirect/unknownResultset[1]/row[column/value='TIPOLINEAREALE']/column[name='VALOREATTRIBUTO']/value = 'PBX'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Servizi.parameters/tns:idOfferta = '47' and $SQLDirect/unknownResultset[1]/row[column/value='TIPOLINEAREALE']/column[name='VALOREATTRIBUTO']/value = 'PBX']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Servizi2ToReply">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1474385837633&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;Servizi2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:MapperGerarchia>&#xa;            &lt;xsl:for-each select=&quot;$Accumulate/tns3:MapperGerarchia/MapperServiziGerarchia&quot;>&#xa;                &lt;MapperServiziGerarchia>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/MapperServiziGerarchia>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns3:MapperGerarchia>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:mapper_1474385837633="http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1474385837633" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="mapper_1474385837633:MapperGerarchia" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:reply name="Reply" operation="Servizi"
                                partnerLink="AssetPort"
                                portType="ns2:AssetPort"
                                tibex:xpdlId="14f45ccb-cb3b-44c5-aab6-57a5effb0fff" variable="Reply-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/Asset/" xmlns:tns1="http://www.tim.com/NOW/cmf/AssetDetails" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;&lt;xsl:param name="SQLDirect"/&gt;&lt;xsl:param name="Servizi2"/&gt;&lt;xsl:param name="RecuperaAggiuntiviCPS"/&gt;&lt;xsl:param name="Servizi"/&gt;&lt;xsl:param name="dettaglio"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns2:ServiziResponse&gt;&lt;parameters&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($dettaglio/tns1:dettaglioAsset)&gt;0"&gt;&lt;tns1:outputServiziAsset&gt;&lt;xsl:for-each select="$Servizi2/MapperServiziGerarchia"&gt;&lt;xsl:variable name="varIdAsset" select="."/&gt;&lt;tns1:outputServizi&gt;&lt;tns1:customizzazione&gt;&lt;xsl:for-each select="$SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]"&gt;&lt;tns1:outputVisualizzazioneCustomizzazione&gt;&lt;xsl:if test="not((string(current()/column[name='NOMEATTRIBUTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(current()/column[name='NOMEATTRIBUTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(current()/column[name='NOMEATTRIBUTO']/value)"&gt;&lt;tns1:attributoCustomizzazione&gt;&lt;xsl:value-of select="current()/column[name='NOMEATTRIBUTO']/value"/&gt;&lt;/tns1:attributoCustomizzazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(current()/column[name='VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(current()/column[name='VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(current()/column[name='VALOREATTRIBUTO']/value)"&gt;&lt;tns1:valoreCustomizzazione&gt;&lt;xsl:value-of select="current()/column[name='VALOREATTRIBUTO']/value"/&gt;&lt;/tns1:valoreCustomizzazione&gt;&lt;/xsl:if&gt;&lt;/tns1:outputVisualizzazioneCustomizzazione&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="exists($SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column/value='PROFILOBMD')"&gt;&lt;tns1:outputVisualizzazioneCustomizzazione&gt;&lt;tns1:attributoCustomizzazione&gt;&lt;xsl:value-of select="&amp;quot;DESCR_BMD&amp;quot;"/&gt;&lt;/tns1:attributoCustomizzazione&gt;&lt;xsl:if test="not((string($SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column[name='DESCR_BMD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column[name='DESCR_BMD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column[name='DESCR_BMD']/value)"&gt;&lt;tns1:valoreCustomizzazione&gt;&lt;xsl:value-of select="$SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column[name='DESCR_BMD']/value"/&gt;&lt;/tns1:valoreCustomizzazione&gt;&lt;/xsl:if&gt;&lt;/tns1:outputVisualizzazioneCustomizzazione&gt;&lt;/xsl:if&gt;&lt;/tns1:customizzazione&gt;&lt;xsl:choose&gt;&lt;xsl:when test="($dettaglio/tns1:dettaglioAsset[tns1:idDettaglioAsset = $varIdAsset]/tns1:nomeComponente = 'ACCESSOFEEDER') and exists($SQLDirect/unknownResultset/row[(column[name='IDDETTAGLIOASSET']/value=$varIdAsset) and (column[name='NOMEATTRIBUTO']/value='CLLIFEEDERSUCCESSIVO')])"&gt;&lt;tns1:prodotto&gt;&lt;xsl:value-of select="'FEEDERSUCCESSIVO'"/&gt;&lt;/tns1:prodotto&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$dettaglio/tns1:dettaglioAsset[tns1:idDettaglioAsset = $varIdAsset]/tns1:nomeComponente"&gt;&lt;tns1:prodotto&gt;&lt;xsl:value-of select="$dettaglio/tns1:dettaglioAsset[tns1:idDettaglioAsset = $varIdAsset]/tns1:nomeComponente"/&gt;&lt;/tns1:prodotto&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:outputServizi&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$Servizi/parameters/tns1:inputServiziAsset/tns1:idOfferta = '47' and $SQLDirect/unknownResultset[1]/row[column/value='TIPOLINEAREALE']/column[name='VALOREATTRIBUTO']/value = 'PBX'"&gt;&lt;xsl:for-each select="$RecuperaAggiuntiviCPS/Record"&gt;&lt;tns1:outputServizi&gt;&lt;tns1:customizzazione&gt;&lt;tns1:outputVisualizzazioneCustomizzazione&gt;&lt;tns1:attributoCustomizzazione&gt;&lt;xsl:value-of select="&amp;quot;TIPOLOGIAACCESSO&amp;quot;"/&gt;&lt;/tns1:attributoCustomizzazione&gt;&lt;xsl:if test="TIPOLOGIAACCESSO"&gt;&lt;tns1:valoreCustomizzazione&gt;&lt;xsl:value-of select="TIPOLOGIAACCESSO"/&gt;&lt;/tns1:valoreCustomizzazione&gt;&lt;/xsl:if&gt;&lt;/tns1:outputVisualizzazioneCustomizzazione&gt;&lt;tns1:outputVisualizzazioneCustomizzazione&gt;&lt;tns1:attributoCustomizzazione&gt;&lt;xsl:value-of select="&amp;quot;STATO&amp;quot;"/&gt;&lt;/tns1:attributoCustomizzazione&gt;&lt;xsl:if test="STATOASSET"&gt;&lt;tns1:valoreCustomizzazione&gt;&lt;xsl:value-of select="STATOASSET"/&gt;&lt;/tns1:valoreCustomizzazione&gt;&lt;/xsl:if&gt;&lt;/tns1:outputVisualizzazioneCustomizzazione&gt;&lt;tns1:outputVisualizzazioneCustomizzazione&gt;&lt;tns1:attributoCustomizzazione&gt;&lt;xsl:value-of select="&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;"/&gt;&lt;/tns1:attributoCustomizzazione&gt;&lt;xsl:if test="NUMTELPRINCIPALE"&gt;&lt;tns1:valoreCustomizzazione&gt;&lt;xsl:value-of select="NUMTELPRINCIPALE"/&gt;&lt;/tns1:valoreCustomizzazione&gt;&lt;/xsl:if&gt;&lt;/tns1:outputVisualizzazioneCustomizzazione&gt;&lt;tns1:outputVisualizzazioneCustomizzazione&gt;&lt;tns1:attributoCustomizzazione&gt;&lt;xsl:value-of select="&amp;quot;NUMEROTELEFONICO&amp;quot;"/&gt;&lt;/tns1:attributoCustomizzazione&gt;&lt;xsl:if test="NUMEROTELEFONICO"&gt;&lt;tns1:valoreCustomizzazione&gt;&lt;xsl:value-of select="NUMEROTELEFONICO"/&gt;&lt;/tns1:valoreCustomizzazione&gt;&lt;/xsl:if&gt;&lt;/tns1:outputVisualizzazioneCustomizzazione&gt;&lt;/tns1:customizzazione&gt;&lt;tns1:prodotto&gt;&lt;xsl:value-of select="&amp;quot;AGGIUNTIVO&amp;quot;"/&gt;&lt;/tns1:prodotto&gt;&lt;/tns1:outputServizi&gt;&lt;/xsl:for-each&gt;&lt;/xsl:if&gt;&lt;/tns1:outputServiziAsset&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:outputServiziAsset/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/parameters&gt;&lt;/tns2:ServiziResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/Asset/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Servizi.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirect&quot;/>&#xa;    &lt;xsl:param name=&quot;Servizi2&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaAggiuntiviCPS&quot;/>&#xa;    &lt;xsl:param name=&quot;dettaglio&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($dettaglio/tns1:dettaglioAsset)>0&quot;>&#xa;                &lt;tns1:outputServiziAsset>&#xa;                    &lt;xsl:for-each select=&quot;$Servizi2/MapperServiziGerarchia&quot;>&#xa;                        &lt;xsl:variable name=&quot;varIdAsset&quot; select=&quot;.&quot;/>&#xa;                        &lt;tns1:outputServizi>&#xa;                            &lt;tns1:customizzazione>&#xa;                                &lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]&quot;>&#xa;                                    &lt;tns1:outputVisualizzazioneCustomizzazione>&#xa;                                        &lt;xsl:if test=&quot;not((string(current()/column[name='NOMEATTRIBUTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(current()/column[name='NOMEATTRIBUTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(current()/column[name='NOMEATTRIBUTO']/value)&quot;>&#xa;                                            &lt;tns1:attributoCustomizzazione>&#xa;                                                &lt;xsl:value-of select=&quot;current()/column[name='NOMEATTRIBUTO']/value&quot;/>&#xa;                                            &lt;/tns1:attributoCustomizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;not((string(current()/column[name='VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(current()/column[name='VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(current()/column[name='VALOREATTRIBUTO']/value)&quot;>&#xa;                                            &lt;tns1:valoreCustomizzazione>&#xa;                                                &lt;xsl:value-of select=&quot;current()/column[name='VALOREATTRIBUTO']/value&quot;/>&#xa;                                            &lt;/tns1:valoreCustomizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns1:outputVisualizzazioneCustomizzazione>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:if test=&quot;exists($SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column/value='PROFILOBMD')&quot;>&#xa;                                    &lt;tns1:outputVisualizzazioneCustomizzazione>&#xa;                                        &lt;tns1:attributoCustomizzazione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;DESCR_BMD&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:attributoCustomizzazione>&#xa;                                        &lt;xsl:if test=&quot;not((string($SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column[name='DESCR_BMD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column[name='DESCR_BMD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column[name='DESCR_BMD']/value)&quot;>&#xa;                                            &lt;tns1:valoreCustomizzazione>&#xa;                                                &lt;xsl:value-of select=&quot;$SQLDirect/unknownResultset/row[column[name='IDDETTAGLIOASSET']/value=$varIdAsset]/column[name='DESCR_BMD']/value&quot;/>&#xa;                                            &lt;/tns1:valoreCustomizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns1:outputVisualizzazioneCustomizzazione>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:customizzazione>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;($dettaglio/tns1:dettaglioAsset[tns1:idDettaglioAsset = $varIdAsset]/tns1:nomeComponente = 'ACCESSOFEEDER') and exists($SQLDirect/unknownResultset/row[(column[name='IDDETTAGLIOASSET']/value=$varIdAsset) and (column[name='NOMEATTRIBUTO']/value='CLLIFEEDERSUCCESSIVO')])&quot;>&#xa;                                    &lt;tns1:prodotto>&#xa;                                        &lt;xsl:value-of select=&quot;'FEEDERSUCCESSIVO'&quot;/>&#xa;                                    &lt;/tns1:prodotto>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$dettaglio/tns1:dettaglioAsset[tns1:idDettaglioAsset = $varIdAsset]/tns1:nomeComponente&quot;>&#xa;                                        &lt;tns1:prodotto>&#xa;                                            &lt;xsl:value-of select=&quot;$dettaglio/tns1:dettaglioAsset[tns1:idDettaglioAsset = $varIdAsset]/tns1:nomeComponente&quot;/>&#xa;                                        &lt;/tns1:prodotto>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns1:outputServizi>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;$Servizi.parameters/tns1:idOfferta = '47' and $SQLDirect/unknownResultset[1]/row[column/value='TIPOLINEAREALE']/column[name='VALOREATTRIBUTO']/value = 'PBX'&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$RecuperaAggiuntiviCPS/Record&quot;>&#xa;                            &lt;tns1:outputServizi>&#xa;                                &lt;tns1:customizzazione>&#xa;                                    &lt;tns1:outputVisualizzazioneCustomizzazione>&#xa;                                        &lt;tns1:attributoCustomizzazione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIAACCESSO&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:attributoCustomizzazione>&#xa;                                        &lt;xsl:if test=&quot;TIPOLOGIAACCESSO&quot;>&#xa;                                            &lt;tns1:valoreCustomizzazione>&#xa;                                                &lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&#xa;                                            &lt;/tns1:valoreCustomizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns1:outputVisualizzazioneCustomizzazione>&#xa;                                    &lt;tns1:outputVisualizzazioneCustomizzazione>&#xa;                                        &lt;tns1:attributoCustomizzazione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;STATO&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:attributoCustomizzazione>&#xa;                                        &lt;xsl:if test=&quot;STATOASSET&quot;>&#xa;                                            &lt;tns1:valoreCustomizzazione>&#xa;                                                &lt;xsl:value-of select=&quot;STATOASSET&quot;/>&#xa;                                            &lt;/tns1:valoreCustomizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns1:outputVisualizzazioneCustomizzazione>&#xa;                                    &lt;tns1:outputVisualizzazioneCustomizzazione>&#xa;                                        &lt;tns1:attributoCustomizzazione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:attributoCustomizzazione>&#xa;                                        &lt;xsl:if test=&quot;NUMTELPRINCIPALE&quot;>&#xa;                                            &lt;tns1:valoreCustomizzazione>&#xa;                                                &lt;xsl:value-of select=&quot;NUMTELPRINCIPALE&quot;/>&#xa;                                            &lt;/tns1:valoreCustomizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns1:outputVisualizzazioneCustomizzazione>&#xa;                                    &lt;tns1:outputVisualizzazioneCustomizzazione>&#xa;                                        &lt;tns1:attributoCustomizzazione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NUMEROTELEFONICO&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:attributoCustomizzazione>&#xa;                                        &lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&#xa;                                            &lt;tns1:valoreCustomizzazione>&#xa;                                                &lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&#xa;                                            &lt;/tns1:valoreCustomizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns1:outputVisualizzazioneCustomizzazione>&#xa;                                &lt;/tns1:customizzazione>&#xa;                                &lt;tns1:prodotto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;AGGIUNTIVO&amp;quot;&quot;/>&#xa;                                &lt;/tns1:prodotto>&#xa;                            &lt;/tns1:outputServizi>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:outputServiziAsset>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:outputServiziAsset/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="AssignToReply"/>
                                    <bpws:target linkName="Servizi2ToReply"/>
                                    <bpws:target linkName="RecuperaAggiuntiviCPSToReply"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:scope name="Iterate"
                                tibex:group="iterate" tibex:xpdlId="6f0c44db-e7e2-4fc2-becb-54d58d920ae0">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToIterate"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="IterateToSQLDirect"/>
                                </bpws:sources>
                                <bpws:sequence name="sequence" tibex:group="iterate">
                                    <bpws:assign name="GroupInit"
                                    tibex:group="groupInit"
                                    tibex:xpdlId="72c3d0a5-09aa-474d-9d6a-1318385e0600" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+e7aa98f5-f4a0-471e-9b8f-2d880c024780" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:forEach counterName="index"
                                    name="iterate" parallel="no" tibex:group="iterate">
                                    <tibex:DesignExpression name="variableList">
                                    <tibex:expression
                                    expression="$dettaglio/tns:dettaglioAsset" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($dettaglio/tns:dettaglioAsset)]]></bpws:finalCounterValue>
                                    <bpws:scope name="innerScope">
                                    <bpws:variables>
                                    <bpws:variable
                                    element="tns:Iterate_Current_Element_dettaglioAsset"
                                    name="currentElement" sca-bpel:internal="true"/>
                                    </bpws:variables>
                                    <bpws:flow name="flow4">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStartToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MapperToGroupEnd" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="808cdc30-c5f6-4f19-989d-b934ccaa17db" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToMapper"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($dettaglio/tns:dettaglioAsset)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="e7aa98f5-f4a0-471e-9b8f-2d880c024780" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
