&lt;/tns1:descParticellaToponomastica>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA) and string-length($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCR_VIA&quot;>&#xa;                                &lt;tns1:via>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCR_VIA&quot;/>&#xa;                                &lt;/tns1:via>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCRIZIONEVIA&quot;>&#xa;                                &lt;tns1:via>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/DESCRIZIONEVIA&quot;/>&#xa;                                &lt;/tns1:via>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA) and string-length($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/NUMERO_CIVICO&quot;>&#xa;                                &lt;tns1:numero>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/NUMERO_CIVICO&quot;/>&#xa;                                &lt;/tns1:numero>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/NUMEROCIVICO&quot;>&#xa;                                &lt;tns1:numero>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/NUMEROCIVICO&quot;/>&#xa;                                &lt;/tns1:numero>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA) and string-length($QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CAP_NUM_CIV&quot;>&#xa;                                &lt;tns1:cap>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CAP_NUM_CIV&quot;/>&#xa;                                &lt;/tns1:cap>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CAP&quot;>&#xa;                                &lt;tns1:cap>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CAP&quot;/>&#xa;                                &lt;/tns1:cap>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/COMPLESSO&quot;>&#xa;                        &lt;tns1:complesso>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/COMPLESSO&quot;/>&#xa;                        &lt;/tns1:complesso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/INTERNO&quot;>&#xa;                        &lt;tns1:interno>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/INTERNO&quot;/>&#xa;                        &lt;/tns1:interno>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/SCALA&quot;>&#xa;                        &lt;tns1:scala>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/SCALA&quot;/>&#xa;                        &lt;/tns1:scala>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/PIANO&quot;>&#xa;                        &lt;tns1:piano>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/PIANO&quot;/>&#xa;                        &lt;/tns1:piano>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/LINEARIFERIMENTO&quot;>&#xa;                        &lt;tns1:lineariferimento>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/LINEARIFERIMENTO&quot;/>&#xa;                        &lt;/tns1:lineariferimento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/LNA_LA&quot;>&#xa;                        &lt;tns1:lna_la>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/LNA_LA&quot;/>&#xa;                        &lt;/tns1:lna_la>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/MODALITAFATTURAZIONE&quot;>&#xa;                        &lt;tns1:modalitaFatturazione>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/MODALITAFATTURAZIONE&quot;/>&#xa;                        &lt;/tns1:modalitaFatturazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/NUMEROTELEFONICO&quot;>&#xa;                        &lt;tns1:numeroTelefonica>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/NUMEROTELEFONICO&quot;/>&#xa;                        &lt;/tns1:numeroTelefonica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/OPERATORE&quot;>&#xa;                        &lt;tns1:operatore>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/OPERATORE&quot;/>&#xa;                        &lt;/tns1:operatore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/ORA_DES&quot;>&#xa;                        &lt;tns1:oraDes>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/ORA_DES&quot;/>&#xa;                        &lt;/tns1:oraDes>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/RO&quot;>&#xa;                        &lt;tns1:ro>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/RO&quot;/>&#xa;                        &lt;/tns1:ro>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/LASTUPDATE&quot;>&#xa;                        &lt;tns1:timeStampAggiornamentoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/LASTUPDATE&quot;/>&#xa;                        &lt;/tns1:timeStampAggiornamentoAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CREATED&quot;>&#xa;                        &lt;tns1:timeInserimentoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CREATED&quot;/>&#xa;                        &lt;/tns1:timeInserimentoAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($QueryDettaglioAssetIdRisorsa/Record[1]/OFFERTA!='NP')&quot;>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/OFFERTA&quot;>&#xa;                                &lt;tns1:tipoServizio>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/OFFERTA&quot;/>&#xa;                                &lt;/tns1:tipoServizio>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/OFFERTA&quot;>&#xa;                                &lt;tns1:tipoServizio>&#xa;                                    &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/OFFERTA&quot;/>&#xa;                                &lt;/tns1:tipoServizio>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA&quot;>&#xa;                        &lt;tns1:codiceToponomastica>&#xa;                            &lt;xsl:value-of select=&quot;$QueryDettaglioAssetIdAsset/Record[1]/CODICETOPONOMASTICA&quot;/>&#xa;                        &lt;/tns1:codiceToponomastica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$QueryDettaglioAsset