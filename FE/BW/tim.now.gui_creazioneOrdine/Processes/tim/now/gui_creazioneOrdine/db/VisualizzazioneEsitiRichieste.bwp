                    portType="ns4:VisualizzazioneEsitiRichieste"
                    tibex:xpdlId="3c082b34-5741-4c93-9529-cea2728bdc1b" variable="Notifiche">
                    <bpws:scope name="scope2">
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
