                                    sqlStatement="select  ID_FILE_PROCSTO_OUTPUT,TIMSTP_CREAZIONE,TRACCIATO_FILE, TIMSTP_INVIO, ID_NOTF,TIPOLG_NOTF, DESCR_CAUS_OLO,  NOME_FILE, CODFC_OLO_AGCOM&#xa;from (&#xa;SELECT FP.ID_FILE_PROCSTO_OUTPUT,   RN.TIMSTP_CREAZIONE,&#xa;RN.TRACCIATO_FILE, PO.TIMSTP_INVIO, RN.ID_NOTF,&#xa;TN.DESCR as TIPOLG_NOTF,CAU.DESCR_CAUS_OLO,P.NOME_FILE,RN.CODFC_OLO_AGCOM, dense_rank() over (partition by RN.ID_NOTF order by PO.TIMSTP_INVIO desc) as ord&#xa;FROM appuser.RICH_ORDN_COMUNIC_NOTF RN &#xa;LEFT JOIN appuser.FILE_NOTF_STANDARD FP ON  RN.ID_NOTF = FP.ID_NOTF&#xa;LEFT JOIN appuser.FILE_PROCSTO_OUTPUT PO ON FP.ID_FILE_PROCSTO_OUTPUT = PO.ID_FILE_PROCSTO_OUTPUT &#xa;LEFT JOIN appuser.TIPOLG_NOTF TN  ON  TN.COD_TIPOLG_NOTF = RN.COD_TIPOLG_NOTF AND TN.STRUTTURA_RICH = RN.STRUTTURA_RICH&#xa;LEFT JOIN appuser.ANAG_CAUS CAU ON CAU.ID_ANAG_CAUS = RN.ID_ANAG_CAUS&#xa;LEFT JOIN appuser.FILE_PROCSTO P ON P.ID_FILE = FP.ID_FILE_PROCSTO_OUTPUT&#xa;LEFT JOIN appuser.TIPOLG_STNTF TNF ON TNF.IDTPLG_STNTF=RN.IDTPLG_STNTF_FLGIORN OR TNF.IDTPLG_STNTF=RN.IDTPLG_STNTF_FLMENS OR TNF.IDTPLG_STNTF=RN.IDTPLG_STNTF_FILE_ORARIO&#xa;WHERE TNF.STNTF='INVIATA' AND RN.ID_RICH_OLO = ?&#xa;AND P.CODFC_OLO_AGCOM  IN (SELECT CODFC_OLO_AGCOM&#xa;FROM appuser.OLO&#xa;WHERE CODFC_OLO_AGCOM = ?&#xa;OR COD_OLO_ACCORPANTE = ?&#xa;OR COD_OLO = (SELECT COD_OLO FROM appuser.OLO WHERE CODFC_OLO_AGCOM = ?))&#xa;ORDER BY RN.ID_NOTF, PO.TIMSTP_INVIO&#xa;) where ord =1" xsi:type="jdbcPalette:JDBCQueryActivity">

