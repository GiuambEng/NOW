                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/VisualizzazioneEsitiRichieste/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/VisualizzazioneEsitiRichieste/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Notifiche.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheOLOQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzaNotifichePPS_GA&quot;/>&#xa;    &lt;xsl:param name=&quot;Profile&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheDG_MKT_NEWSQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneNotificheOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($Profile, $Notifiche.parameters/tns1:tipoProfilo) and string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF)) > 0&quot;>&#xa;                &lt;tns1:VisualizzazioneNotificheOutput>&#xa;                    &lt;xsl:for-each select=&quot;$VisualizzazioneNotificheOLOQuery/Record&quot;>&#xa;                        &lt;tns1:VisualizzazioneNotificheOutput>&#xa;                            &lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&#xa;                                &lt;tns1:tipologiaNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&#xa;                                &lt;/tns1:tipologiaNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&#xa;                                &lt;tns1:causale>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/tns1:causale>&#xa;                            &lt;/xsl:if>&#xa;             