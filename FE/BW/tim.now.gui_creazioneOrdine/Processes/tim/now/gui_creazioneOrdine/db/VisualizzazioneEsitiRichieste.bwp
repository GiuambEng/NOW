                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/cmf.VisualizzazioneEsitiRichieste&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2e5bdaf0-442b-48d0-8c37-00ba220a18ec+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/VisualizzazioneEsitiRichieste/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneEsitiRichieste1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;TIPORICHIESTA&quot;/>&#xa;    &lt;xsl:param name=&quot;AMBITO&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneEsitiRichiesteQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VisualizzazioneEsitiRichieste1.parameters/tns2:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1.parameters/tns2:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;            &lt;TIPORICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$TIPORICHIESTA&quot;/>&#xa;            &lt;/TIPORICHIESTA>&#xa;            &lt;AMBITO>&#xa;                &lt;xsl:value-of select=&quot;$AMBITO&quot;/>&#xa;            &lt;/AMBITO>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
