ore(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns1:dataInvioFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&#xa;                                        &lt;tns1:dataInvioFile>&#xa;                                            &lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&#xa;                                        &lt;/tns1:dataInvioFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns1:VisualizzazioneNotificheOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:VisualizzazioneNotificheOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(contains($Notifiche.parameters/tns1:tipoProfilo,'DG') or contains($Notifiche.parameters/tns1:tipoProfilo,'MKT') or contains($Notifiche.parameters/tns1:tipoProfilo,'NEWS')) and string-length(string($VisualizzazioneNotificheDG_MKT_NEWSQuery/Record[1]/ID_NOTF)) > 0&quot;>&#xa;                &lt;tns1:VisualizzazioneNotificheOutput>&#xa;                    &lt;xsl:for-each select=&quot;$VisualizzazioneNotificheDG_MKT_NEWSQuery/Record&quot;>&#xa;                        &lt;tns1:VisualizzazioneNotificheOutput>&#xa;                            &lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&#xa;                                &lt;tns1:tipologiaNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&#xa;                                &lt;/tns1:tipologiaNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&#xa;                                &lt;tns1:causale>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/tns1:causale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&#xa;                                    &lt;tns1:dataCreazione>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns1:dataCreazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:dataCreazione>&#xa;                                        &lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&#xa;                                    &lt;/tns1:dataCreazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;TRACCIATO_FILE&quot;>&#xa;                                &lt;tns1:notificaXML>&#xa;                                    &lt;xsl:value-of select=&quot;TRACCIATO_FILE&quot;/>&#xa;                                &lt;/tns1:notificaXML>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                &lt;tns1:ultimoFileNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                &lt;/tns1:ultimoFileNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:ch