                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/cmf.VisualizzazioneEsitiRichieste&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2e5bdaf0-442b-48d0-8c37-00ba220a18ec+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/VisualizzazioneEsitiRichieste/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VisualizzazioneEsitiRichieste1&quot;/>&lt;xsl:param name=&quot;TIPORICHIESTA&quot;/>&lt;xsl:param name=&quot;AMBITO&quot;/>&lt;xsl:template name=&quot;VisualizzazioneEsitiRichiesteQuery-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VisualizzazioneEsitiRichieste1/parameters/tns2:VisualizzazioneEsitiRichiesteInput/tns2:idRichiesta)&quot;>&lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1/parameters/tns2:VisualizzazioneEsitiRichiesteInput/tns2:idRichiesta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRICHIESTAOLO>&lt;TIPORICHIESTA>&lt;xsl:value-of select=&quot;$TIPORICHIESTA&quot;/>&lt;/TIPORICHIESTA>&lt;AMBITO>&lt;xsl:value-of select=&quot;$AMBITO&quot;/>&lt;/AMBITO>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
