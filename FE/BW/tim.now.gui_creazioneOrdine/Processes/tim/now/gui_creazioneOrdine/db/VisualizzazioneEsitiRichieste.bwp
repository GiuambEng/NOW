                            <bpws:reply
                                name="VisualizzazioneNotificheOut"
                                operation="Notifiche"
                                partnerLink="VisualizzazioneEsitiRichieste"
                                portType="ns4:VisualizzazioneEsitiRichieste"
                                tibex:xpdlId="d8b2726d-3bf0-496e-a8fb-4321d2382bc8" variable="VisualizzazioneNotificheOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/VisualizzazioneEsitiRichieste/" xmlns:tns1="http://www.tim.com/NOW/cmf/VisualizzazioneEsitiRichieste/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="VisualizzazioneNotificheOLOQuery"/&gt;&lt;xsl:param name="Notifiche"/&gt;&lt;xsl:param name="VisualizzaNotifichePPS_GA"/&gt;&lt;xsl:param name="Profile"/&gt;&lt;xsl:param name="VisualizzazioneNotificheDG_MKT_NEWSQuery"/&gt;&lt;xsl:template name="VisualizzazioneNotificheOut-input" match="/"&gt;&lt;tns:NotificheResponse&gt;&lt;parameters&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($Profile, $Notifiche/parameters/tns1:VisualizzazioneNotificheInput/tns1:tipoProfilo) and string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF)) &gt; 0"&gt;&lt;tns1:VisualizzazioneNotificheOutput&gt;&lt;xsl:for-each select="$VisualizzazioneNotificheOLOQuery/Record"&gt;&lt;tns1:VisualizzazioneNotificheOutput&gt;&lt;xsl:if test="TIPOLG_NOTF"&gt;&lt;tns1:tipologiaNotifica&gt;&lt;xsl:value-of select="TIPOLG_NOTF"/&gt;&lt;/tns1:tipologiaNotifica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="DESCR_CAUS_OLO"&gt;&lt;tns1:causale&gt;&lt;xsl:value-of select="DESCR_CAUS_OLO"/&gt;&lt;/tns1:causale&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))&gt;0"&gt;&lt;tns1:dataCreazione&gt;&lt;xsl:value-of select="concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))"/&gt;&lt;/tns1:dataCreazione&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:dataCreazione&gt;&lt;xsl:value-of select="TIMSTP_CREAZIONE"/&gt;&lt;/tns1:dataCreazione&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="TRACCIATO_FILE"&gt;&lt;tns1:notificaXML&gt;&lt;xsl:value-of select="TRACCIATO_FILE"/&gt;&lt;/tns1:notificaXML&gt;&lt;/xsl:if&gt;&lt;tns1:ultimoFileNotifica&gt;&lt;xsl:value-of select="NOME_FILE"/&gt;&lt;/tns1:ultimoFileNotifica&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))&gt;0"&gt;&lt;tns1:dataInvioFile&gt;&lt;xsl:value-of select="concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))"/&gt;&lt;/tns1:dataInvioFile&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="TIMSTP_INVIO"&gt;&lt;tns1:dataInvioFile&gt;&lt;xsl:value-of select="TIMSTP_INVIO"/&gt;&lt;/tns1:dataInvioFile&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:VisualizzazioneNotificheOutput&gt;&lt;/xsl:for-each&gt;&lt;/tns1:VisualizzazioneNotificheOutput&gt;&lt;/xsl:when&gt;&lt;xsl:when test="(contains($Notifiche/parameters/tns1:VisualizzazioneNotificheInput/tns1:tipoProfilo,'DG') or contains($Notifiche/parameters/tns1:VisualizzazioneNotificheInput/tns1:tipoProfilo,'MKT') or contains($Notifiche/parameters/tns1:VisualizzazioneNotificheInput/tns1:tipoProfilo,'NEWS')) and string-length(string($VisualizzazioneNotificheDG_MKT_NEWSQuery/Record[1]/ID_NOTF)) &gt; 0"&gt;&lt;tns1:VisualizzazioneNotificheOutput&gt;&lt;xsl:for-each select="$VisualizzazioneNotificheDG_MKT_NEWSQuery/Record"&gt;&lt;tns1:VisualizzazioneNotificheOutput&gt;&lt;xsl:if test="TIPOLG_NOTF"&gt;&lt;tns1:tipologiaNotifica&gt;&lt;xsl:value-of select="TIPOLG_NOTF"/&gt;&lt;/tns1:tipologiaNotifica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="DESCR_CAUS_OLO"&gt;&lt;tns1:causale&gt;&lt;xsl:value-of select="DESCR_CAUS_OLO"/&gt;&lt;/tns1:causale&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))&gt;0"&gt;&lt;tns1:dataCreazione&gt;&lt;xsl:value-of select="concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))"/&gt;&lt;/tns1:dataCreazione&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:dataCreazione&gt;&lt;xsl:value-of select="TIMSTP_CREAZIONE"/&gt;&lt;/tns1:dataCreazione&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="TRACCIATO_FILE"&gt;&lt;tns1:notificaXML&gt;&lt;xsl:value-of select="TRACCIATO_FILE"/&gt;&lt;/tns1:notificaXML&gt;&lt;/xsl:if&gt;&lt;xsl:if test="NOME_FILE"&gt;&lt;tns1:ultimoFileNotifica&gt;&lt;xsl:value-of select="NOME_FILE"/&gt;&lt;/tns1:ultimoFileNotifica&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))&gt;0"&gt;&lt;tns1:dataInvioFile&gt;&lt;xsl:value-of select="concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))"/&gt;&lt;/tns1:dataInvioFile&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="TIMSTP_INVIO"&gt;&lt;tns1:dataInvioFile&gt;&lt;xsl:value-of select="TIMSTP_INVIO"/&gt;&lt;/tns1:dataInvioFile&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:VisualizzazioneNotificheOutput&gt;&lt;/xsl:for-each&gt;&lt;/tns1:VisualizzazioneNotificheOutput&gt;&lt;/xsl:when&gt;&lt;xsl:when test="(contains($Notifiche/parameters/tns1:VisualizzazioneNotificheInput/tns1:tipoProfilo, &amp;quot;PPS&amp;quot;) or contains($Notifiche/parameters/tns1:VisualizzazioneNotificheInput/tns1:tipoProfilo, &amp;quot;GA&amp;quot;)) and string-length(string($VisualizzaNotifichePPS_GA/Record[1]/ID_NOTF)) &gt; 0"&gt;&lt;tns1:VisualizzazioneNotificheOutput&gt;&lt;xsl:for-each select="$VisualizzaNotifichePPS_GA/Record"&gt;&lt;tns1:VisualizzazioneNotificheOutput&gt;&lt;xsl:if test="TIPOLG_NOTF"&gt;&lt;tns1:tipologiaNotifica&gt;&lt;xsl:value-of select="TIPOLG_NOTF"/&gt;&lt;/tns1:tipologiaNotifica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="DESCR_CAUS_OLO"&gt;&lt;tns1:causale&gt;&lt;xsl:value-of select="DESCR_CAUS_OLO"/&gt;&lt;/tns1:causale&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))&gt;0"&gt;&lt;tns1:dataCreazione&gt;&lt;xsl:value-of select="concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))"/&gt;&lt;/tns1:dataCreazione&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:dataCreazione&gt;&lt;xsl:value-of select="TIMSTP_CREAZIONE"/&gt;&lt;/tns1:dataCreazione&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="TRACCIATO_FILE"&gt;&lt;tns1:notificaXML&gt;&lt;xsl:value-of select="TRACCIATO_FILE"/&gt;&lt;/tns1:notificaXML&gt;&lt;/xsl:if&gt;&lt;xsl:if test="NOME_FILE"&gt;&lt;tns1:ultimoFileNotifica&gt;&lt;xsl:value-of select="NOME_FILE"/&gt;&lt;/tns1:ultimoFileNotifica&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))&gt;0"&gt;&lt;tns1:dataInvioFile&gt;&lt;xsl:value-of select="concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))"/&gt;&lt;/tns1:dataInvioFile&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="TIMSTP_INVIO"&gt;&lt;tns1:dataInvioFile&gt;&lt;xsl:value-of select="TIMSTP_INVIO"/&gt;&lt;/tns1:dataInvioFile&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:VisualizzazioneNotificheOutput&gt;&lt;/xsl:for-each&gt;&lt;/tns1:VisualizzazioneNotificheOutput&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:VisualizzazioneNotificheOutput/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/parameters&gt;&lt;/tns:NotificheResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
