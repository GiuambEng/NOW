                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;r1.DATAINVIORICHIESTA, &#xa;r1.STATORICHIESTANOW, &#xa;r1.STATORICHIESTAOLO,&#xa;r1.LAVORAZIONE,&#xa;r1.IDRICHIESTAOLO,&#xa;r1.CODICEORDINEOLO,&#xa;r1.CONTENUTOXML,&#xa;r1.OPERATORE&#xa;FROM BDS_1_CASEDATA_RICHIESTA r1 &#xa;INNER JOIN BDS_1_CASEDATA_RICHIESTA r2 ON (r1.CODICEORDINETITARGET= r2.CODICEORDINETI or r1.codiceordineolo = r2.codiceordineolo)&#xa;WHERE r2.IDRICHIESTAOLO = ? AND r1.TIPORICHIESTA = ? AND r1.AMBITO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPORICHIESTA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="AMBITO"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CONTENUTOXML"
                                    dataType="2011"
                                    status="OptionalElement" typeName="NCLOB"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1a6a45d6-3f38-400e-a42a-6bc8875cc011+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/VisualizzazioneEsitiRichieste/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TIPORICHIESTA&quot;/>&lt;xsl:param name=&quot;AMBITO&quot;/>&lt;xsl:param name=&quot;VisualizzazioneEsitiRichieste1&quot;/>&lt;xsl:template name=&quot;VisualizzazioneEsitiRichiesteQueryOLO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VisualizzazioneEsitiRichieste1/parameters/tns1:VisualizzazioneEsitiRichiesteInput/tns1:idRichiesta)&quot;>&lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1/parameters/tns1:VisualizzazioneEsitiRichiesteInput/tns1:idRichiesta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRICHIESTAOLO>&lt;TIPORICHIESTA>&lt;xsl:value-of select=&quot;$TIPORICHIESTA&quot;/>&lt;/TIPORICHIESTA>&lt;AMBITO>&lt;xsl:value-of select=&quot;$AMBITO&quot;/>&lt;/AMBITO>&lt;CODAGCOM1>&lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1/parameters/tns1:VisualizzazioneEsitiRichiesteInput/tns1:codOloAgcom&quot;/>&lt;/CODAGCOM1>&lt;CODAGCOM2>&lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1/parameters/tns1:VisualizzazioneEsitiRichiesteInput/tns1:codOloAgcom&quot;/>&lt;/CODAGCOM2>&lt;CODAGCOM3>&lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1/parameters/tns1:VisualizzazioneEsitiRichiesteInput/tns1:codOloAgcom&quot;/>&lt;/CODAGCOM3>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VisualizzazioneEsitiRichiesteQueryOLO-input"
                                    name="VisualizzazioneEsitiRichiesteQueryOLO"
                                    outputVariable="VisualizzazioneEsitiRichiesteQueryOLO"
                                    tibex:xpdlId="1a6a45d6-3f38-400e-a42a-6bc8875cc011" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToJDBCQuery1_CRMOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToVisualizzazioneEsitiRichiesteOut1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1a6a45d6-3f38-400e-a42a-6bc8875cc011+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/VisualizzazioneEsitiRichieste/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneEsitiRichieste1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;TIPORICHIESTA&quot;/>&#xa;    &lt;xsl:param name=&quot;AMBITO&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneEsitiRichiesteQueryOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VisualizzazioneEsitiRichieste1.parameters/tns1:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1.parameters/tns1:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;            &lt;TIPORICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$TIPORICHIESTA&quot;/>&#xa;            &lt;/TIPORICHIESTA>&#xa;            &lt;AMBITO>&#xa;                &lt;xsl:value-of select=&quot;$AMBITO&quot;/>&#xa;            &lt;/AMBITO>&#xa;            &lt;CODAGCOM1>&#xa;                &lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1.parameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/CODAGCOM1>&#xa;            &lt;CODAGCOM2>&#xa;                &lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1.parameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/CODAGCOM2>&#xa;            &lt;CODAGCOM3>&#xa;                &lt;xsl:value-of select=&quot;$VisualizzazioneEsitiRichieste1.parameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/CODAGCOM3>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;r1.DATAINVIORICHIESTA, &#xa;r1.STATORICHIESTANOW, &#xa;r1.STATORICHIESTAOLO,&#xa;r1.LAVORAZIONE,&#xa;r1.IDRICHIESTAOLO,&#xa;r1.CODICEORDINEOLO,&#xa;r1.CONTENUTOXML,&#xa;r1.OPERATORE&#xa;FROM BDS_1_CASEDATA_RICHIESTA r1 &#xa;INNER JOIN BDS_1_CASEDATA_RICHIESTA r2 ON (r1.CODICEORDINETITARGET= r2.CODICEORDINETI or r1.codiceordineolo = r2.codiceordineolo)&#xa;WHERE r2.IDRICHIESTAOLO = ? AND r1.TIPORICHIESTA = ? AND r1.AMBITO = ?&#xa;AND r1.codificaoloagcom  IN (SELECT CODFC_OLO_AGCOM&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?&#xa;OR COD_OLO_ACCORPANTE =?&#xa;OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = ?))" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPORICHIESTA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="AMBITO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODAGCOM1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODAGCOM2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODAGCOM3"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CONTENUTOXML"
                                    dataType="2011"
                                    status="OptionalElement" typeName="NCLOB"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
                <bpws:onMessage operation="Notifiche"
