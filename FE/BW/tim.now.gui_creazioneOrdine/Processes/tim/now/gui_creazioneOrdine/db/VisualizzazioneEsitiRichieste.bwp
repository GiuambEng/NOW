                                tibex:constructor="onMessageStart" tibex:xpdlId="d41657b8-4829-4ce3-ba13-5040748120fa">
                                <bpws:sources>
                                    <bpws:source linkName="OnMessageStart1ToJDBCQuery_OLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($Profile,$Notifiche/parameters/tns:VisualizzazioneNotificheInput/tns:tipoProfilo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($Profile,$Notifiche.parameters/tns:tipoProfilo)]]></bpws:transitionCondition>
