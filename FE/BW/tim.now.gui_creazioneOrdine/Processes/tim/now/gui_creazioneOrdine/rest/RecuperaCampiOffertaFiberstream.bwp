                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a9a7af9d-2160-430b-b020-778fa19850ef+input&quot; xmlns:tns4=&quot;http://www.example.org/RecuperaCampiFiberstream&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns8:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:provincia)>0 and string-length($post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:codiceVlan)=0&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT AV.codicevlan, AV.codificaoaoagcom, AV.PROVINCIA, P.SIGLA_PROV FROM ANAGRAFICA_VLAN_OPEN_FIBER AV INNER JOIN PROV P ON UPPER(AV.PROVINCIA)=P.DESCR_PROV WHERE AV.codificaoaoagcom='&amp;quot;,$post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:codOloAgcom, &amp;quot;' AND UPPER(AV.provincia)=UPPER('&amp;quot;,$post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:provincia,&amp;quot;') AND SYSDATE BETWEEN AV.DATAINVALIDITA AND AV.DATAFIVALIDITA&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:provincia)=0 and string-length($post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:codiceVlan)>0&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT AV.codicevlan, AV.codificaoaoagcom, AV.PROVINCIA, P.SIGLA_PROV FROM ANAGRAFICA_VLAN_OPEN_FIBER AV INNER JOIN PROV P ON UPPER(AV.PROVINCIA)=P.DESCR_PROV WHERE AV.codificaoaoagcom='&amp;quot;,$post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:codOloAgcom, &amp;quot;' AND AV.CODICEVLAN='&amp;quot;,$post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:codiceVlan ,&amp;quot;' AND SYSDATE BETWEEN AV.DATAINVALIDITA AND AV.DATAFIVALIDITA&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:provincia)>0 and string-length($post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:codiceVlan)>0&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT AV.codicevlan, AV.codificaoaoagcom, AV.PROVINCIA, P.SIGLA_PROV FROM ANAGRAFICA_VLAN_OPEN_FIBER AV INNER JOIN PROV P ON UPPER(AV.PROVINCIA)=P.DESCR_PROV WHERE AV.codificaoaoagcom='&amp;quot;,$post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:codOloAgcom, &amp;quot;' AND UPPER(AV.provincia)=UPPER('&amp;quot;,$post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:provincia,&amp;quot;') AND AV.CODICEVLAN='&amp;quot;,$post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:codiceVlan ,&amp;quot;' AND SYSDATE BETWEEN AV.DATAINVALIDITA AND AV.DATAFIVALIDITA&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT AV.codicevlan, AV.codificaoaoagcom, AV.PROVINCIA, P.SIGLA_PROV FROM ANAGRAFICA_VLAN_OPEN_FIBER AV INNER JOIN PROV P ON UPPER(AV.PROVINCIA)=P.DESCR_PROV WHERE AV.codificaoaoagcom='&amp;quot;,$post/item/tns4:InputVisualizzazioneVLANFiberStream/tns4:codOloAgcom, &amp;quot;'&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns8:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
