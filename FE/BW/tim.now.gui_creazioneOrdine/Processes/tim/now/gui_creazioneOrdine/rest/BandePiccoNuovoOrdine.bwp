                            <bpws:empty name="Empty" tibex:xpdlId="a939f034-ad2f-4622-b854-29c670bab72b">
                                <bpws:targets>
                                    <bpws:target linkName="get_bandepicconuovoordine_InputLog_INFOToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToJDBCQuery_TIPOCOS">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($get/parameters/tns:bandepicconuovoordineGetParameters/tns:tipoCos)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($get.parameters/tns:tipoCos)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($get/parameters/tns:bandepicconuovoordineGetParameters/tns:tipoVlan)>0  and not(string-length($get/parameters/tns:bandepicconuovoordineGetParameters/tns:tipoCos)>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($get.parameters/tns:tipoVlan)>0  and not(string-length($get.parameters/tns:tipoCos)>0)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToJDBCQuery1_EasyIPUBB">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$get/parameters/tns:bandepicconuovoordineGetParameters/tns:idOfferta = ('44','45','69')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$get.parameters/tns:idOfferta = ('44','45','69')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToJDBCQuery1_NoTipoCOS">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c6ead144-7ef6-46bd-a4b6-0048e93b3c2f+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/BandePiccoNuovoOrdine/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;getTipoCosFromAnagVlan&quot;/>&lt;xsl:template name=&quot;ListaCOS-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($get/parameters/tns1:bandepicconuovoordineGetParameters/tns1:tipoCos)>0&quot;>&lt;tipoCos>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:bandepicconuovoordineGetParameters/tns1:tipoCos)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:bandepicconuovoordineGetParameters/tns1:tipoCos&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tipoCos>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoCos>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($getTipoCosFromAnagVlan/Record[1]/TIPO_COS)&quot;>&lt;xsl:value-of select=&quot;$getTipoCosFromAnagVlan/Record[1]/TIPO_COS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tipoCos>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ListaCOS-input"
                                    name="ListaCOS"
                                    outputVariable="ListaCOS"
                                    tibex:xpdlId="c6ead144-7ef6-46bd-a4b6-0048e93b3c2f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToJDBCQuery_TIPOCOS"/>
                                    <bpws:target linkName="getTipoCosFromAnagVlanToListaCOS"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ListaCOSToListaBandePicco"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c6ead144-7ef6-46bd-a4b6-0048e93b3c2f+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/BandePiccoNuovoOrdine/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;getTipoCosFromAnagVlan&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaCOS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($get.parameters/tns1:tipoCos)>0&quot;>&#xa;                    &lt;tipoCos>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($get.parameters/tns1:tipoCos)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$get.parameters/tns1:tipoCos&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tipoCos>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipoCos>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($getTipoCosFromAnagVlan/Record[1]/TIPO_COS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$getTipoCosFromAnagVlan/Record[1]/TIPO_COS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attri