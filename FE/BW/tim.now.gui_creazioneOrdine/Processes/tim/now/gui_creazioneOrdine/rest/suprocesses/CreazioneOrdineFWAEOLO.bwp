                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/RichiesteFWAEOLO&quot; xmlns:tns=&quot;http://www.example.org/OrdiniFWAEOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;RichiestaOAO>&lt;Richiesta>&lt;Testata>&lt;CodiceOlo>&lt;xsl:value-of select=&quot;$Start/tns:codiceOlo&quot;/>&lt;/CodiceOlo>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/CodiceOrdineOlo>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/Note>&lt;/xsl:if>&lt;/Testata>&lt;Ordine>&lt;Attivazione>&lt;Accesso>&lt;Referente>&lt;Progressivo>&lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:progressivoReferente&quot;/>&lt;/Progressivo>&lt;QualificaRef>&lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:qualifica&quot;/>&lt;/QualificaRef>&lt;NomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:nome&quot;/>&lt;/NomeReferente>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:cognome&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;$Start/tns:datiReferenti[1]/tns:telefonoFisso&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:telefonoFisso&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferenti[1]/tns:cellulare&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:cellulare&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;EmailReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:email&quot;/>&lt;/EmailReferente>&lt;/Referente>&lt;Referente>&lt;Progressi