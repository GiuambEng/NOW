                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VP&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SQLDirect/unknownResultset/row)>0&quot;>&lt;tns:VPoutput>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&lt;tns:VPOutput>&lt;xsl:if test=&quot;not((string(column[name='COD_VP']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_VP']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_VP']/value)&quot;>&lt;tns:codiceVP>&lt;xsl:value-of select=&quot;column[name='COD_VP']/value&quot;/>&lt;/tns:codiceVP>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO']/value)&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;column[name='STATO']/value&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='MODALITA_FATTURAZIONE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='MODALITA_FATTURAZIONE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='MODALITA_FATTURAZIONE']/value)&quot;>&lt;tns:modalitaFatturazione>&lt;xsl:value-of select=&quot;column[name='MODALITA_FATTURAZIONE']/value&quot;/>&lt;/tns:modalitaFatturazione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPO']/value)&quot;>&lt;tns:tipo>&lt;xsl:value-of select=&quot;column[name='TIPO']/value&quot;/>&lt;/tns:tipo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='BANDA_MCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='BANDA_MCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='BANDA_MCR']/value)&quot;>&lt;tns:bandaMCR>&lt;xsl:value-of select=&quot;column[name='BANDA_MCR']/value&quot;/>&lt;/tns:bandaMCR>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='BANDA_PCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='BANDA_PCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='BANDA_PCR']/value)&quot;>&lt;tns:bandaPCR>&lt;xsl:value-of select=&quot;column[name='BANDA_PCR']/value&quot;/>&lt;/tns:bandaPCR>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_AREA_RACCOLTA']/value)&quot;>&lt;tns:codiceAreaRaccolta>&lt;xsl:value-of select=&quot;column[name='COD_AREA_RACCOLTA']/value&quot;/>&lt;/tns:codiceAreaRaccolta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESC_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESC_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESC_AREA_RACCOLTA']/value)&quot;>&lt;tns:descAreaRaccolta>&lt;xsl:value-of select=&quot;column[name='DESC_AREA_RACCOLTA']/value&quot;/>&lt;/tns:descAreaRaccolta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_KIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_KIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_KIT']/value)&quot;>&lt;tns:codiceKit>&lt;xsl:value-of select=&quot;column[name='COD_KIT']/value&quot;/>&lt;/tns:codiceKit>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='VPI_RETE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='VPI_RETE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='VPI_RETE']/value)&quot;>&lt;tns:vpiRete>&lt;xsl:value-of select=&quot;column[name='VPI_RETE']/value&quot;/>&lt;/tns:vpiRete>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='VPI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='VPI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='VPI']/value)&quot;>&lt;tns:vpi>&lt;xsl:value-of select=&quot;column[name='VPI']/value&quot;/>&lt;/tns:vpi>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPO_TRASPORTO']/value)&quot;>&lt;tns:tipoTrasporto>&lt;xsl:value-of select=&quot;column[name='TIPO_TRASPORTO']/value&quot;/>&lt;/tns:tipoTrasporto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CLLI']/value)&quot;>&lt;tns:clli>&lt;xsl:value-of select=&quot;column[name='CLLI']/value&quot;/>&lt;/tns:clli>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_CENTRALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CENTRALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CENTRALE']/value)&quot;>&lt;tns:nomeCentrale>&lt;xsl:value-of select=&quot;column[name='NOME_CENTRALE']/value&quot;/>&lt;/tns:nomeCentrale>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NUMERO_MAX_VC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NUMERO_MAX_VC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NUMERO_MAX_VC']/value)&quot;>&lt;tns:numeroMaxVc>&lt;xsl:value-of select=&quot;column[name='NUMERO_MAX_VC']/value&quot;/>&lt;/tns:numeroMaxVc>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO']/value)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;column[name='COD_OLO']/value&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='DEC_ATTIVAZIONE']/value)&quot;>&lt;tns:decAttivazione>&lt;xsl:value-of select=&quot;xsd:date(substring-before(string(column[name='DEC_ATTIVAZIONE']/value),&amp;quot;T&amp;quot;))&quot;/>&lt;/tns:decAttivazione>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='DEC']/value)&quot;>&lt;tns:dec>&lt;xsl:value-of select=&quot;xsd:date(substring-before(string(column[name='DEC']/value),&amp;quot;T&amp;quot;))&quot;/>&lt;/tns:dec>&lt;/xsl:if>&lt;/tns:VPOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:VPoutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VPoutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun elemento&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:VPoutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
