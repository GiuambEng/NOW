                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160523175700PLT" xmlns:tns="http://www.tim.com/NOW/rest/VP" xmlns:ns3="http://www.tim.com/NOW/rest/servizioricercaavanzata" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="Variable"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="JDBCQuery"/&gt;
    &lt;xsl:param name="SQLDirect"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns2:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($post/item/ns3:inputservizioricercaavanzata/ns3:exportRequest) and (upper-case($post/item/ns3:inputservizioricercaavanzata/ns3:exportRequest)='S' or upper-case($post/item/ns3:inputservizioricercaavanzata/ns3:exportRequest)='Y') and exists($SQLDirect/unknownResultset[1]/row[1]/column[1])"&gt;
                        &lt;tns:VPoutput&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="xsd:string($JDBCQuery/Record[1]/NEXTVAL)"/&gt;
                            &lt;/tns:idExportFile&gt;
                        &lt;/tns:VPoutput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:VPoutput&gt;
                            &lt;xsl:copy-of select="$Variable/tns:VPOutput"/&gt;
                            &lt;xsl:copy-of select="$Variable/tns:result"/&gt;
                        &lt;/tns:VPoutput&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns2:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
