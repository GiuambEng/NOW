                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/RecuperoCodDonating&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoCodDonating/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoCodDonating1&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaCodDonating1&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaCodDonating2&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoCodDonating2&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RecuperoCodDonating>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($get.parameters/tns1:idRisorsa1) and exists($get.parameters/tns1:idRisorsa2)&quot;>&#xa;                    &lt;tns:RecuperoCodDonatingOutput>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$RecuperoCodDonating1/Record[1]/CODFC_OLO_AGCOM = $get.parameters/tns1:oaoDonating1&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($RecuperoCodDonating1/Record[1]/COD_OLO_ACCORPANTE) and string-length($RecuperoCodDonating1/Record[1]/COD_OLO_ACCORPANTE)>0&quot;>&#xa;                                        &lt;tns:CodDonating1>&#xa;                                            &lt;tns:esito>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                            &lt;/tns:esito>&#xa;                                            &lt;xsl:if test=&quot;$RecuperoCodDonating1/Record[1]/COD_OLO_ACCORPANTE&quot;>&#xa;                                                &lt;tns:codDonating>&#xa;                                   