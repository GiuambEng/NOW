            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="b2ad2810-5a18-4a54-bdb4-fb575062a714">
                <bpws:onMessage operation="get"
                    partnerLink="recuperocoddonating"
                    portType="ns:recuperocoddonating"
                    tibex:xpdlId="a77a2b09-1c94-49e4-8be8-f6f510b45672" variable="get">
                    <bpws:scope name="scope1">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails"
                                tibex:faultNameVar="FaultName" tibex:xpdlId="4e958a06-e0ed-4cd9-8b3e-762a0bf4f8da">
                                <bpws:scope name="scope2">
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="CallProcess3ToReply" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
