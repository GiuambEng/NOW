                                    <bpws:reply name="Reply"
                                    operation="get"
                                    partnerLink="visualizzazioneserviziopzionalialternativi"
                                    portType="ns:visualizzazioneserviziopzionalialternativi"
                                    tibex:xpdlId="2f9e208f-3f42-455f-8c5a-994bd8b733c4" variable="Reply-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20240819153958PLT" xmlns:tns3="http://www.example.org/VisualizzazioneServiziOpzionaliAlternativi" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns:getResponse&gt;
            &lt;item&gt;
                &lt;tns3:VisualizzazioneServiziOpzionaliAlternativiOutput&gt;
                    &lt;tns3:result&gt;
                        &lt;tns3:severity&gt;
                            &lt;xsl:value-of select="'ERROR'"/&gt;
                        &lt;/tns3:severity&gt;
                        &lt;tns3:code&gt;
                            &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                        &lt;/tns3:code&gt;
                        &lt;tns3:details&gt;
                            &lt;xsl:value-of select="$FaultDetails/Msg"/&gt;
                        &lt;/tns3:details&gt;
                    &lt;/tns3:result&gt;
                &lt;/tns3:VisualizzazioneServiziOpzionaliAlternativiOutput&gt;
            &lt;/item&gt;
        &lt;/tns:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
