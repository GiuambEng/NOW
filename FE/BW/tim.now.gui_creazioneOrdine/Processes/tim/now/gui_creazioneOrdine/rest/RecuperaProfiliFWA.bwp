                                    <columnMetadata
                                    columnName="DESCR_PROFILO_FWA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="VELOCITA_DOWN"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="VELOCITA_UP"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
