                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/RecuperaProfiliFWA&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperaProfiliFWA/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InputProfilo&quot;/>&#xa;    &lt;xsl:param name=&quot;NoInput&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($get.parameters/tns1:profilo) >0&quot;>&#xa;                &lt;tns:outputRecuperaProfiliFWA>&#xa;                    &lt;xsl:for-each select=&quot;$InputProfilo/Record&quot;>&#xa;                        &lt;tns:recuperaProfiliFWAOutput>&#xa;                            &lt;tns:profilo>&#xa;                                &lt;xsl:value-of select=&quot;COD_PROFILO_FWA&quot;/>&#xa;                            &lt;/tns:profilo>&#xa;                            &lt;tns:descrizioneProfilo>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_PROFILO_FWA&quot;/>&#xa;                            &lt;/tns:descrizioneProfilo>&#xa;                            &lt;xsl:if test=&quot;exists(VELOCITA_UP)&quot;>&#xa;                                &lt;tns:velocitaUp>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(VELOCITA_UP)&quot;/>&#xa;                                &lt;/tns:velocitaUp>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(VELOCITA_DOWN)&quot;>&#xa;                                &lt;tns:velocitaDown>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(VELOCITA_DOWN)&quot;/>&#xa;                                &lt;/tns:velocitaDown>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:recuperaProfiliFWAOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputRecuperaProfiliFWA>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputRecuperaProfiliFWA>&#xa;                    &lt;xsl:for-each select=&quot;$NoInput/Record&quot;>&#xa;                        &lt;tns:recuperaProfiliFWAOutput>&#xa;                            &lt;tns:profilo>&#xa;                                &lt;xsl:value-of select=&quot;COD_PROFILO_FWA&quot;/>&#xa;                            &lt;/tns:profilo>&#xa;                        &lt;/tns:recuperaProfiliFWAOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputRecuperaProfiliFWA>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
