    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>get</variable>
                <variable>post</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperaProfili_IngetLog">
            <endingVariables>
                <variable>get_RecuperaProfili_IngetLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperaProfili_IngetLog_INFO">
            <endingVariables>
                <variable>get_RecuperaProfili_IngetLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="InputProfilo">
            <endingVariables>
                <variable>InputProfilo-input</variable>
            </endingVariables>
        </task>
        <task name="NoInput">
            <endingVariables>
                <variable>NoInput-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>InputProfilo</variable>
                <variable>NoInput</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperaProfili_out_Log">
            <endingVariables>
                <variable>get_RecuperaProfili_out_Log-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="CallProcess">
            <endingVariables>
                <variable>CallProcess-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
            </endingVariables>
        </task>
        <task name="RecuperaProfiliFWA_LogInput">
            <endingVariables>
                <variable>RecuperaProfiliFWA_LogInput-input</variable>
            </endingVariables>
        </task>
        <task name="RecuperaProfiliFWA_LogInfo">
            <endingVariables>
                <variable>RecuperaProfiliFWA_LogInfo-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="RecuperaProfiliFWA_LogOutput">
            <endingVariables>
                <variable>RecuperaProfiliFWA_LogOutput-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="ForEach">
            <endingVariables>
                <variable>Oscurato</variable>
            </endingVariables>
        </task>
        <task name="Assign3">
            <endingVariables>
                <variable>RecuperaProfili</variable>
            </endingVariables>
        </task>
        <task name="RecuperaProfili">
            <endingVariables>
                <variable>RecuperaProfili-input</variable>
            </endingVariables>
        </task>
        <task name="Oscurato">
            <endingVariables>
                <variable>Oscurato-input</variable>
            </endingVariables>
        </task>
        <task name="Profilo">
            <endingVariables>
                <variable>Profilo-input</variable>
            </endingVariables>
        </task>
        <task name="NoProfilo">
            <endingVariables>
                <variable>NoProfilo-input</variable>
            </endingVariables>
        </task>
        <task name="Assign4">
            <endingVariables>
                <variable>Profilo</variable>
                <variable>NoProfilo</variable>
            </endingVariables>
        </task>
        <task name="RecuperaProfiliFWA_LogError">
            <endingVariables>
                <variable>RecuperaProfiliFWA_LogError-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply1">
            <endingVariables>
                <variable>Reply1-input</variable>
                <variable>FaultDetails1</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
