                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/RecuperaProfiliFWA&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperaProfiliFWA/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;InputProfilo&quot;/>&lt;xsl:param name=&quot;NoInput&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($get/parameters/tns1:recuperaprofilifwaGetParameters/tns1:profilo) >0&quot;>&lt;tns:outputRecuperaProfiliFWA>&lt;xsl:for-each select=&quot;$InputProfilo/Record&quot;>&lt;tns:recuperaProfiliFWAOutput>&lt;tns:profilo>&lt;xsl:value-of select=&quot;COD_PROFILO_FWA&quot;/>&lt;/tns:profilo>&lt;tns:descrizioneProfilo>&lt;xsl:value-of select=&quot;DESCR_PROFILO_FWA&quot;/>&lt;/tns:descrizioneProfilo>&lt;xsl:if test=&quot;exists(VELOCITA_UP)&quot;>&lt;tns:velocitaUp>&lt;xsl:value-of select=&quot;xsd:int(VELOCITA_UP)&quot;/>&lt;/tns:velocitaUp>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(VELOCITA_DOWN)&quot;>&lt;tns:velocitaDown>&lt;xsl:value-of select=&quot;xsd:int(VELOCITA_DOWN)&quot;/>&lt;/tns:velocitaDown>&lt;/xsl:if>&lt;/tns:recuperaProfiliFWAOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputRecuperaProfiliFWA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputRecuperaProfiliFWA>&lt;xsl:for-each select=&quot;$NoInput/Record&quot;>&lt;tns:recuperaProfiliFWAOutput>&lt;tns:profilo>&lt;xsl:value-of select=&quot;COD_PROFILO_FWA&quot;/>&lt;/tns:profilo>&lt;/tns:recuperaProfiliFWAOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl