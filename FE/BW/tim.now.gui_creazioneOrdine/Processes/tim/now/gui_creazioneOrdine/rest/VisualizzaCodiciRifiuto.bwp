                                    tibex:xpdlId="a6b68f7e-2375-4aa8-83b2-f3703076753c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_visualizzazionecodicirifiuto_InputLog_INFOToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoCodiciRifiutoToAssignCodiciRifiuto"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a6b68f7e-2375-4aa8-83b2-f3703076753c+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaCodiciRifiuto/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoCodiciRifiuto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:ambitoServizioRecipient != 'REGOLATORIO'&quot;>&#xa;                    &lt;ambitoServRecipient>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                    &lt;/ambitoServRecipient>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ambitoServRecipient>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:ambitoServizioRecipient&quot;/>&#xa;                    &lt;/ambitoServRecipient>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:ambitoServizioDonating = 'FONIA'&quot;>&#xa;                    &lt;ambitoServDonating>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                    &lt;/ambitoServDonating>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ambitoServDonating>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                    &lt;/ambitoServDonating>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CN.COD_SCARTO_DONATING, AC.DESCR_CAUS_OLO&#xa;FROM CAUS_NOTF_RISC_KO_COD_SESS CN&#xa;LEFT JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = CN.ID_ANAG_CAUS&#xa;WHERE CN.AMBITO_SERVIZIO_DONATING = ? AND CN.AMBITO_SERVIZIO_RECIPIENT = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ambitoServRecipient"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ambitoServDonating"/>
                                    <columnMetadata
                                    columnName="COD_SCARTO_DONATING"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="VariableCodiciRifiuto"
                                    name="AssignCodiciRifiuto"
                                    outputVariable="VariableCodiciRifiuto"
                                    tibex:xpdlId="abb9c353-831a-4ca7-83b2-c3e3dde01f0b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RecuperoCodiciRifiutoToAssignCodiciRifiuto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignCodiciRifiutoToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/rest.listaCodiciRifiuto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoCodiciRifiuto&quot;/>&lt;xsl:template name=&quot;VariableCodiciRifiuto&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperoCodiciRifiuto/Record) >0&quot;>&lt;tns:listaCodiciRifiutoOutput>&lt;xsl:for-each select=&quot;$RecuperoCodiciRifiuto/Record&quot;>&lt;tns:listaCodiciRifiutoOutput>&lt;tns:codiceMotivoRifiuto>&lt;xsl:value-of select=&quot;COD_SCARTO_DONATING&quot;/>&lt;/tns:codiceMotivoRifiuto>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns:motivoRifiuto>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns:motivoRifiuto>&lt;/xsl:if>&lt;/tns:listaCodiciRifiutoOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:listaCodiciRifiutoOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:listaCodiciRifiutoOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun codice rifiuto trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:listaCodiciRifiutoOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
