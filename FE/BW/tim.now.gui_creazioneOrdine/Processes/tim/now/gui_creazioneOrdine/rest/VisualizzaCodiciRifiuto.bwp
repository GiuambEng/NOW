    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionecodicirifiuto_InputLog">
            <endingVariables>
                <variable>get_visualizzazionecodicirifiuto_InputLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionecodicirifiuto_InputLog_INFO">
            <endingVariables>
                <variable>get_visualizzazionecodicirifiuto_InputLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="RecuperoCodiciRifiuto">
            <endingVariables>
                <variable>RecuperoCodiciRifiuto-input</variable>
            </endingVariables>
        </task>
        <task name="AssignCodiciRifiuto">
            <endingVariables>
                <variable>RecuperoCodiciRifiuto</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionecodicirifiuto_outLog">
            <endingVariables>
                <variable>get_visualizzazionecodicirifiuto_outLog-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionecodicirifiuto_Error_Log">
            <endingVariables>
                <variable>get_visualizzazionecodicirifiuto_Error_Log-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
