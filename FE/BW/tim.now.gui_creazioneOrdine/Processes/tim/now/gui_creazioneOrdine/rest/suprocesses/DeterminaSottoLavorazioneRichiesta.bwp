                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8dfd5e98-2141-4cf0-b037-2ba4d0fdeb45+input&quot; xmlns:tns=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RecuperoOLODonating-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;IDRISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA>&lt;IDRISORSA1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA1>&lt;IDRISORSA2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA2>&lt;IDRISORSA3>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA3>&lt;IDRISORSA4>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA4>&lt;IDRISORSA5>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA5>&lt;IDRISORSA6>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA6>&lt;IDRISORSA7>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA7>&lt;IDRISORSA8>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA8>&lt;IDRISORSA9>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA9>&lt;IDRISORSA10>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA10>&lt;IDRISORSA11>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA11>&lt;IDRISORSA12>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA12>&lt;IDRISORSA13>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA13>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT A.CODIFICAOLOAGCOM&#xd;&#xa;FROM BDS_1_CASEDATA_ASSET A&#xd;&#xa;WHERE&#xd;&#xa;(&#xd;&#xa;    A.STATOASSET = 'ATTIVO'&#xd;&#xa;    AND A.IDRISORSA = ?&#xd;&#xa;)&#xd;&#xa;OR&#xd;&#xa;(&#xd;&#xa;    NOT EXISTS (&#xd;&#xa;        SELECT 1&#xd;&#xa;        FROM BDS_1_CASEDATA_ASSET B&#xd;&#xa;        WHERE B.STATOASSET = 'ATTIVO'&#xd;&#xa;        AND B.IDRISORSA = ?&#xd;&#xa;    )&#xd;&#xa;    AND A.STATOASSET = 'ATTIVO'&#xd;&#xa;    AND A.NUMEROFITTIZIO =&#xd;&#xa;        CASE&#xd;&#xa;            WHEN SUBSTR(?,2,1) IN ('2','6')&#xd;&#xa;                THEN '0' || ?&#xd;&#xa;            WHEN SUBSTR(?,3,1) IN ('0','1','5','9')&#xd;&#xa;                THEN ?&#xd;&#xa;            ELSE&#xd;&#xa;                SUBSTR(?,2)&#xd;&#xa;        END&#xd;&#xa;)&#xd;&#xa;OR&#xd;&#xa;(&#xd;&#xa;    NOT EXISTS (&#xd;&#xa;        SELECT 1&#xd;&#xa;        FROM BDS_1_CASEDATA_ASSET B&#xd;&#xa;        WHERE B.STATOASSET = 'ATTIVO'&#xd;&#xa;        AND B.IDRISORSA = ?&#xd;&#xa;    )&#xd;&#xa;    AND NOT EXISTS (&#xd;&#xa;        SELECT 1&#xd;&#xa;        FROM BDS_1_CASEDATA_ASSET C&#xd;&#xa;        WHERE C.STATOASSET = 'ATTIVO'&#xd;&#xa;        AND C.NUMEROFITTIZIO =&#xd;&#xa;            CASE&#xd;&#xa;                WHEN SUBSTR(?,2,1) IN ('2','6')&#xd;&#xa;                    THEN '0' || ?&#xd;&#xa;                WHEN SUBSTR(?,3,1) IN ('0','1','5','9')&#xd;&#xa;                    THEN ?&#xd;&#xa;                ELSE&#xd;&#xa;                    SUBSTR(?,2)&#xd;&#xa;            END&#xd;&#xa;    )&#xd;&#xa;    AND A.STATOASSET IN ('ATTIVO','IN LAVORAZIONE')&#xd;&#xa;    AND A.NUMEROTELEFONICO = ?&#xd;&#xa;)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA2"/>
                                    <PreparedParameters
