                                    expression="upper-case($Start/ns0:Lavorazione)='MIGRAZIONE' and $Start/ns0:OffertaCatalogo =('BitstreamNGAFTTCAB','BitstreamNGAFTTH','VULAFTTCAB','VULAFTTH','BitstreamATMAsimmetricoFlat', 'BitstreamATMAsimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite','EasyIPUBBFTTCAB','EasyIPUBBFTTH','SEMIEasyIPUBBFTTH','SEMIBitstreamNGAFTTH','SEMIVULAFTTH')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='MIGRAZIONE' and $Start/ns0:OffertaCatalogo =('BitstreamNGAFTTCAB','BitstreamNGAFTTH','VULAFTTCAB','VULAFTTH','BitstreamATMAsimmetricoFlat', 'BitstreamATMAsimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite','EasyIPUBBFTTCAB','EasyIPUBBFTTH','SEMIEasyIPUBBFTTH','SEMIBitstreamNGAFTTH','SEMIVULAFTTH')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="RecuperoOLODonatingToAssign_VARIAZIONEVP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Lavorazione = 'VARIAZIONE' and $Start/ns0:Servizio = 'VP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns0:Lavorazione = 'VARIAZIONE' and $Start/ns0:Servizio = 'VP']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="RecuperoOLODonatingToAssign_VARIAZIONEVLANNGA">
