            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperoOLODonating-input"
                    name="RecuperoOLODonating"
                    outputVariable="RecuperoOLODonating"
                    tibex:xpdlId="8dfd5e98-2141-4cf0-b037-2ba4d0fdeb45" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToAssign1_Name"/>
