                        </bpws:source>
                        <bpws:source linkName="JDBCQueryTovariazioneDatiNGAAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamNGAFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('VULAFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamNGAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('VULAFTTH')) or (contains(upper-case($Start/ns0:Servizio),upper-case('EASYIPUBBFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('EASYIPNGAFTTCAB'))) or (contains(upper-case($Start/ns0:Servizio),upper-case('EASYIPUBBFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('EASYIPNGAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('SEMIBitstreamNGAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('SEMIVULAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('SEMIEASYIPNGAFTTH'))))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamNGAFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('VULAFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamNGAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('VULAFTTH')) or (contains(upper-case($Start/ns0:Servizio),upper-case('EASYIPUBBFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('EASYIPNGAFTTCAB'))) or (contains(upper-case($Start/ns0:Servizio),upper-case('EASYIPUBBFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('EASYIPNGAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('SEMIBitstreamNGAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('SEMIVULAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('SEMIEASYIPNGAFTTH'))))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCQueryTovariazioneULLAssign">
