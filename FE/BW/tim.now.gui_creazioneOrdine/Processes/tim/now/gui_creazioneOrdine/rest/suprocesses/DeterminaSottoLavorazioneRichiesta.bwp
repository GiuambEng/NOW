                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoOLODonating&quot;/>&lt;xsl:template name=&quot;sottolavorazioneVariable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Attivazione274) and string-length($Start/tns:Attivazione274)>0&quot;>&lt;tns:outputSottolavRichiesta>&lt;tns:sottolavorazione>&lt;xsl:value-of select=&quot;'ATTIVAZIONE274'&quot;/>&lt;/tns:sottolavorazione>&lt;/tns:outputSottolavRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns:codificaRecipient)='TLC' and upper-case($RecuperoOLODonating/Record[1]/CODIFICAOLOAGCOM)!='TLC'&quot;>&lt;tns:outputSottolavRichiesta>&lt;tns:sottolavorazione>&lt;xsl:value-of select=&quot;'RIENTROINTI'&quot;/>&lt;/tns:sottolavorazione>&lt;/tns:outputSottolavRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns:codificaRecipient)!='TLC' or ( upper-case($RecuperoOLODonating/Record[1]/CODIFICAOLOAGCOM)=upper-case($Start/tns:codificaRecipient) and upper-case($Start/tns:codificaRecipient)='TLC')&quot;>&lt;tns:outputSottolavRichiesta>&lt;tns:sottolavorazione>&lt;xsl:value-of select=&quot;'MIGRAZIONEOLO'&quot;/>&lt;/tns:sottolavorazione>&lt;/tns:outputSottolavRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputSottolavRichiesta/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
