                        </bpws:source>
                        <bpws:source linkName="JDBCQueryTovariazioneDatiXDSLAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamATMAsim')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamATMSim')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamGBEAsim')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamGBESim')) or contains(upper-case($Start/ns0:Servizio),upper-case('EasyIPSpecialProfile')) or contains(upper-case($Start/ns0:Servizio),upper-case('EasyIPBasePlus')))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamATMAsim')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamATMSim')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamGBEAsim')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamGBESim')) or contains(upper-case($Start/ns0:Servizio),upper-case('EasyIPSpecialProfile')) or contains(upper-case($Start/ns0:Servizio),upper-case('EasyIPBasePlus')))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCQueryTovariazioneSLUAssign">
                            <tibex:DesignExpression>
