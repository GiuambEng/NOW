                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VisualizzazioneListaBandePicco&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzazioneListaBandPicco/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaCOS&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaNoCOS&quot;/>&#xa;    &lt;xsl:param name=&quot;getTipoCosFromAnagVlan&quot;/>&#xa;    &lt;xsl:param name=&quot;EasyIPUBB&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($get.parameters/tns1:tipoCos) = 0 and string-length($get.parameters/tns1:tipoVlan)=0 and string-length($get.parameters/tns1:idOfferta) =0&quot;>&#xa;                &lt;tns:VisualizzazioneListaBandePicco_Output>&#xa;                    &lt;xsl:for-each select=&quot;$ListaNoCOS/Record&quot;>&#xa;                        &lt;tns:VisualizzazioneListaBandePicco_Output>&#xa;                            &lt;xsl:if test=&quot;exists(BANDA_UPSTREAM) and string-length(string(BANDA_UPSTREAM))>0&quot;>&#xa;                                &lt;tns:BANDA_UPSTREAM>&#xa;                                    &lt;xsl:value-of select=&quot;if(  (BANDA_UPSTREAM>xsd:int(BANDA_UPSTREAM) ) or  (BANDA_UPSTREAM&amp;lt;xsd:int(BANDA_UPSTREAM) )   ) then string(BANDA_UPSTREAM) else xsd:int(BANDA_UPSTREAM)&amp;#xD;&amp;#xA;&quot;/>&#xa;                                &lt;/tns:BANDA_UPSTREAM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(BANDA_DOWNSTREAM) and string-length(string(BANDA_DOWNSTREAM))>0&quot;>&#xa;                                &lt;tns:BANDA_DOWNSTREAM>&#xa;                                    &lt;xsl:value-of select=&quot;if(  (BANDA_DOWNSTREAM>xsd:int(BANDA_DOWNSTREAM) ) or  (BANDA_DOWNSTREAM&amp;lt;xsd:int(BANDA_DOWNSTREAM) )   ) then string(BANDA_DOWNSTREAM) else xsd:int(BANDA_DOWNSTREAM)&quot;/>&#xa;                                &lt;/tns:BANDA_DOWNSTREAM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(ID_BANDA_PICCO) and string-length(string(ID_BANDA_PICCO))>0&quot;>&#xa;                                &lt;tns:IDENTIFICATIVO_BANDA_PICCO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_BANDA_PICCO)&quot;/>&#xa;                                &lt;/tns:IDENTIFICATIVO_BANDA_PICCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:MODELLO>&#xa;                                &lt;xsl:value-of select=&quot;MODELLO&quot;/>&#xa;                            &lt;/tns:MODELLO>&#xa;                            &lt;tns:TIPO_COS>&#xa;                                &lt;xsl:value-of select=&quot;TIPO_COS&quot;/>&#xa;                            &lt;/tns:TIPO_COS>&#xa;                        &lt;/tns:VisualizzazioneListaBandePicco_Output>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;LISTA RECUPERATA&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:VisualizzazioneListaBandePicco_Output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$get.parameters/tns1:tipoCos = $ListaCOS/Record[1]/TIPO_COS or $getTipoCosFromAnagVlan/Record[1]/TIPO_COS=$ListaCOS/Record[1]/TIPO_COS&quot;>&#xa;                &lt;tns:VisualizzazioneListaBandePicco_Output>&#xa;                    &lt;xsl:for-each select=&quot;$ListaCOS/Record&quot;>&#xa;                        &lt;tns:VisualizzazioneListaBandePicco_Output>&#xa;                            &lt;xsl:if test=&quot;exists(BANDA_UPSTREAM) and string-length(string(BANDA_UPSTREAM))>0&quot;>&#xa;                                &lt;tns:BANDA_UPSTREAM>&#xa;                                    &lt;xsl:value-of select=&quot;if(  (BANDA_UPSTREAM>xsd:int(BANDA_UPSTREAM) ) or  (BANDA_UPSTREAM&amp;lt;xsd:int(BANDA_UPSTREAM) )   ) then string(BANDA_UPSTREAM) else xsd:int(BANDA_UPSTREAM)&amp;#xD;&amp;#xA;&quot;/>&#xa;                                &lt;/tns:BANDA_UPSTREAM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(BANDA_DOWNSTREAM) and string-length(string(BANDA_DOWNSTREAM))>0&quot;>&#xa;                                &lt;tns:BANDA_DOWNSTREAM>&#xa;                                    &lt;xsl:value-of select=&quot;if(  (BANDA_DOWNSTREAM>xsd:int(BANDA_DOWNSTREAM) ) or  (BANDA_DOWNSTREAM&amp;lt;xsd:int(BANDA_DOWNSTREAM) )   ) then string(BANDA_DOWNSTREAM) else xsd:int(BANDA_DOWNSTREAM)&quot;/>&#xa;                                &lt;/tns:BANDA_DOWNSTREAM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(ID_BANDA_PICCO) and string-length(string(ID_BANDA_PICCO))>0&quot;>&#xa;                                &lt;tns:IDENTIFICATIVO_BANDA_PICCO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_BANDA_PICCO)&quot;/>&#xa;                                &lt;/tns:IDENTIFICATIVO_BANDA_PICCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:MODELLO>&#xa;                                &