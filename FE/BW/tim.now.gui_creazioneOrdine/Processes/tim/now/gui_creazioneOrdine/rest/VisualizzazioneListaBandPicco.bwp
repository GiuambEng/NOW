            <endingVariables>
                <variable>ListaCOS</variable>
                <variable>ListaNoCOS</variable>
                <variable>getTipoCosFromAnagVlan</variable>
                <variable>EasyIPUBB</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionelistabandapicco_InputLog">
            <endingVariables>
                <variable>get_visualizzazionelistabandapicco_InputLog-input</variable>
