                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0f6e0066-4250-402c-a636-457ae11951d7+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzazioneListaBandPicco/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;getTipoCosFromAnagVlan&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaCOS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($get.parameters/tns1:tipoCos)>0&quot;>&#xa;                    &lt;tipoCos>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($get.parameters/tns1:tipoCos)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$get.parameters/tns1:tipoCos&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tipoCos>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipoCos>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($getTipoCosFromAnagVlan/Record[1]/TIPO_COS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$getTipoCosFromAnagVlan/Record[1]/TIPO_COS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tipoCos>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT * &#xa;FROM BANDA_PICCO &#xa;WHERE TIPO_COS = ?&#xa;ORDER BY BANDA_DOWNSTREAM&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tipoCos"/>
                                    <columnMetadata
                                    columnName="BANDA_DOWNSTREAM"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BANDA_UPSTREAM"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_BANDA_PICCO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="MODELLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPO_COS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VisualizzazioneListaBandePicco&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzazioneListaBandPicco/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;ListaCOS&quot;/>&lt;xsl:param name=&quot;ListaNoCOS&quot;/>&lt;xsl:param name=&quot;getTipoCosFromAnagVlan&quot;/>&lt;xsl:param name=&quot;EasyIPUBB&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($get/parameters/tns1:visualizzazionelistabandpiccoGetParameters/tns1:tipoCos) = 0 and string-length($get/parameters/tns1:visualizzazionelistabandpiccoGetParameters/tns1:tipoVlan)=0 and string-length($get/parameters/tns1:visualizzazionelistabandpiccoGetParameters/tns1:idOfferta) =0&quot;>&lt;tns:VisualizzazioneListaBandePicco_Output>&lt;xsl:for-each select=&quot;$ListaNoCOS/Record&quot;>&lt;tns:VisualizzazioneListaBandePicco_Output>&lt;xsl:if test=&quot;exists(BANDA_UPSTREAM) and string-length(string(BANDA_UPSTREAM))>0&quot;>&lt;tns:BANDA_UPSTREAM>&lt;xsl:value-of select=&quot;if(  (BANDA_UPSTREAM>xsd:int(BANDA_UPSTREAM) ) or  (BANDA_UPSTREAM&amp;lt;xsd:int(BANDA_UPSTREAM) )   ) then string(BANDA_UPSTREAM) else xsd:int(BANDA_UPSTREAM)&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:BANDA_UPSTREAM>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(BANDA_DOWNSTREAM) and string-length(string(BANDA_DOWNSTREAM))>0&quot;>&lt;tns:BANDA_DOWNSTREAM>&lt;xsl:value-of select=&quot;if(  (BANDA_DOWNSTREAM>xsd:int(BANDA_DOWNSTREAM) ) or  (BANDA_DOWNSTREAM&amp;lt;xsd:int(BANDA_DOWNSTREAM) )   ) then string(BANDA_DOWNSTREAM) else xsd:int(BANDA_DOWNSTREAM)&quot;/>&lt;/tns:BANDA_DOWNSTREAM>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_BANDA_PICCO) and string-length(string(ID_BANDA_PICCO))>0&quot;>&lt;tns:IDENTIFICATIVO_BANDA_PICCO>&lt;xsl:value-of select=&quot;xsd:int(ID_BANDA_PICCO)&quot;/>&lt;/tns:IDENTIFICATIVO_BANDA_PICCO>&lt;/xsl:if>&lt;tns:MODELLO>&lt;xsl:value-of select=&quot;MODELLO&quot;/>&lt;/tns:MODELLO>&lt;tns:TIPO_COS>&lt;xsl:value-of select=&quot;TIPO_COS&quot;/>&lt;/tns:TIPO_COS>&lt;/tns:VisualizzazioneListaBandePicco_Output>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;LISTA RECUPERATA&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:VisualizzazioneListaBandePicco_Output>&lt;/xsl:when>&lt;xsl:when test=&quot;$get/parameters/tns1:visualizzazionelistabandpiccoGetParameters/tns1:tipoCos = $ListaCOS/Record[1]/TIPO_COS or $getTipoCosFromAnagVlan/Record[1]/TIPO_COS=$ListaCOS/Record[1]/TIPO_COS&quot;>&lt;tns:VisualizzazioneListaBandePicco_Output>&lt;xsl:for-each select=&quot;$ListaCOS/Record&quot;>&lt;tns:VisualizzazioneListaBandePicco_Output>&lt;xsl:if test=&quot;exists(BANDA_UPSTREAM) and string-length(string(BANDA_UPSTREAM))>0&quot;>&lt;tns:BANDA_UPSTREAM>&lt;xsl:value-of select=&quot;if(  (BANDA_UPSTREAM>xsd:int(BANDA_UPSTREAM) ) or  (BANDA_UPSTREAM&amp;lt;xsd:int(BANDA_UPSTREAM) )   ) then string(BANDA_UPSTREAM) else xsd:int(BANDA_UPSTREAM)&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:BANDA_UPSTREAM>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(BANDA_DOWNSTREAM) and string-length(string(BANDA_DOWNSTREAM))>0&quot;>&lt;tns:BANDA_DOWNSTREAM>&lt;xsl:value-of select=&quot;if(  (BANDA_DOWNSTREAM>xsd:int(BANDA_DOWNSTREAM) ) or  (BANDA_DOWNSTREAM&amp;lt;xsd:int(BANDA_DOWNSTREAM) )   ) then string(BANDA_DOWNSTREAM) else xsd:int(BANDA_DOWNSTREAM)&quot;/>&lt;/tns:BANDA_DOWNSTREAM>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_BANDA_PICCO) and string-length(string(ID_BANDA_PICCO))>0&quot;>&lt;tns:IDENTIFICATIVO_BANDA_PICCO>&lt;xsl:value-of select=&quot;xsd:int(ID_BANDA_PICCO)&quot;/>&lt;/tns:IDENTIFICATIVO_BANDA_PICCO>&lt;/xsl:if>&lt;tns:MODELLO>&lt;xsl:value-of select=&quot;MODELLO&quot;/>&lt;/tns:MODELLO>&lt;tns:TIPO_COS>&lt;xsl:value-of select=&quot;TIPO_COS&quot;/>&lt;/tns:TIPO_COS>&lt;/tns:VisualizzazioneListaBandePicco_Output>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;DATI RECUPERATI DA TIPO _COS FORNITO&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:VisualizzazioneListaBandePicco_Output>&lt;/xsl:when>&lt;xsl:when test=&quot;$get/parameters/tns1:visualizzazionelistabandpiccoGetParameters/tns1:idOfferta = ('44','45')&quot;>&lt;tns:VisualizzazioneListaBandePicco_Output>&lt;xsl:for-each select=&quot;$EasyIPUBB/Record&quot;>&lt;tns:VisualizzazioneListaBandePicco_Output>&lt;xsl:if test=&quot;exists(PROFILO_COMMERCIALE_UP) and string-length(string(PROFILO_COMMERCIALE_UP))>0&quot;>&lt;tns:BANDA_UPSTREAM>&lt;xsl:value-of select=&quot;if(  (PROFILO_COMMERCIALE_UP>xsd:int(PROFILO_COMMERCIALE_UP) ) or  (PROFILO_COMMERCIALE_UP&amp;lt;xsd:int(PROFILO_COMMERCIALE_UP) )   ) then string(PROFILO_COMMERCIALE_UP) else xsd:int(PROFILO_COMMERCIALE_UP)&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:BANDA_UPSTREAM>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(PROFILO_COMMERCIALE_DOWN) and string-length(string(PROFILO_COMMERCIALE_DOWN))>0&quot;>&lt;tns:BANDA_DOWNSTREAM>&lt;xsl:value-of select=&quot;if(  (PROFILO_COMMERCIALE_DOWN>xsd:int(PROFILO_COMMERCIALE_DOWN) ) or  (PROFILO_COMMERCIALE_DOWN&amp;lt;xsd:int(PROFILO_COMMERCIALE_DOWN) )   ) then string(PROFILO_COMMERCIALE_DOWN) else xsd:int(PROFILO_COMMERCIALE_DOWN)&quot;/>&lt;/tns:BANDA_DOWNSTREAM>&lt;/xsl:if>&lt;/tns:VisualizzazioneListaBandePicco_Output>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;LISTA RECUPERATA&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:VisualizzazioneListaBandePicco_Output>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VisualizzazioneListaBandePicco_Output>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($get/parameters/tns1:visualizzazionelistabandpiccoGetParameters/tns1:tipoVlan)>0  &quot;>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;TIPO_COS NON VALORIZZATO PER VLAN/SVLAN FORNITO&amp;quot;&quot;/>&lt;/tns:details>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;NESSUN DATO RECUPERATO CON IL TIPO_COS FORNITO&amp;quot;&quot;/>&lt;/tns:details>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:result>&lt;/tns:VisualizzazioneListaBandePicco_Output>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
