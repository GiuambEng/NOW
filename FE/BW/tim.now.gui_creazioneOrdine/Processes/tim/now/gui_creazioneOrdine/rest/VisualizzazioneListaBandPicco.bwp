            </endingVariables>
        </task>
        <task name="RenderXml">
            <endingVariables>
                <variable>RenderXml-input</variable>
            </endingVariables>
        </task>
        <task name="CallProcess">
            <endingVariables>
                <variable>CallProcess-input</variable>
                <variable>RenderXml</variable>
            </endingVariables>
        </task>
        <task name="post_errore_Reply">
            <endingVariables>
                <variable>post_errore_Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionelistabandapiccoPost_Error_Log">
            <endingVariables>
                <variable>get_visualizzazionelistabandapiccoPost_Error_Log-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="getOut">
