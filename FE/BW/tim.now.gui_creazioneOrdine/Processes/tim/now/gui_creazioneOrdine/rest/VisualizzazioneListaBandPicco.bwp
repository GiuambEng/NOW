    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>post</variable>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>RicercaAvanzataSQL</variable>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="RicercaAvanzata">
            <endingVariables>
                <variable>RicercaAvanzata-input</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionelistabandapiccoPost_outLog">
            <endingVariables>
                <variable>get_visualizzazionelistabandapiccoPost_outLog-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionelistabandapiccoPost_InputLog">
            <endingVariables>
                <variable>get_visualizzazionelistabandapiccoPost_InputLog-input</variable>
