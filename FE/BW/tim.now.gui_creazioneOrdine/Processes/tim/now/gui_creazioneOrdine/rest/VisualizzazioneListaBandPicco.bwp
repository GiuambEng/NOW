                    &lt;/tns:BANDA_UPSTREAM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(PROFILO_COMMERCIALE_DOWN) and string-length(string(PROFILO_COMMERCIALE_DOWN))>0&quot;>&#xa;                                &lt;tns:BANDA_DOWNSTREAM>&#xa;                                    &lt;xsl:value-of select=&quot;if(  (PROFILO_COMMERCIALE_DOWN>xsd:int(PROFILO_COMMERCIALE_DOWN) ) or  (PROFILO_COMMERCIALE_DOWN&amp;lt;xsd:int(PROFILO_COMMERCIALE_DOWN) )   ) then string(PROFILO_COMMERCIALE_DOWN) else xsd:int(PROFILO_COMMERCIALE_DOWN)&quot;/>&#xa;                                &lt;/tns:BANDA_DOWNSTREAM>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:VisualizzazioneListaBandePicco_Output>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;LISTA RECUPERATA&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:VisualizzazioneListaBandePicco_Output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:VisualizzazioneListaBandePicco_Output>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($get.parameters/tns1:tipoVlan)>0  &quot;>&#xa;                                &lt;tns:details>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;TIPO_COS NON VALORIZZATO PER VLAN/SVLAN FORNITO&amp;quot;&quot;/>&#xa;                                &lt;/tns:details>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:details>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NESSUN DATO RECUPERATO CON IL TIPO_COS FORNITO&amp;quot;&quot;/>&#xa;                                &lt;/tns:details>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:VisualizzazioneListaBandePicco_Output>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
