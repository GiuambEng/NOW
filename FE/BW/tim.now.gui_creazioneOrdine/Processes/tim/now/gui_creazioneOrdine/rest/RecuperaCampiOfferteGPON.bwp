                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2b0cf3ce-dc29-4cc6-9e84-44f1f56ad59b+input&quot; xmlns:tns=&quot;http://www.example.org/RecuperaCampiOfferteGPON&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post1&quot;/>&lt;xsl:template name=&quot;QueryIS-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;codOloAgcom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post1/item/tns:inputRecuperaCodSystemUnico/tns:codOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$post1/item/tns:inputRecuperaCodSystemUnico/tns:codOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOloAgcom>&lt;idGpon>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post1/item/tns:inputRecuperaCodSystemUnico/tns:idGpon)&quot;>&lt;xsl:value-of select=&quot;$post1/item/tns:inputRecuperaCodSystemUnico/tns:idGpon&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idGpon>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="QueryIS-input"
                                    name="QueryIS"
                                    outputVariable="QueryIS"
                                    tibex:xpdlId="2b0cf3ce-dc29-4cc6-9e84-44f1f56ad59b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
