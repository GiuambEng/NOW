&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20210406172922PLT" version="2.0"&gt;&lt;xsl:param name="Variable1"/&gt;&lt;xsl:template name="postOut1-input" match="/"&gt;&lt;tns3:postResponse1&gt;&lt;item&gt;&lt;xsl:copy-of select="$Variable1"/&gt;&lt;/item&gt;&lt;/tns3:postResponse1&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
