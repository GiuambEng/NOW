                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c8b14b99-4985-4d3e-9cd8-6b02c05b9e06+input&quot; xmlns:tns=&quot;http://www.example.org/RecuperaCampiOfferteGPON&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post2&quot;/>&lt;xsl:template name=&quot;JDBCQuery2-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;codOloAgcom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post2/item/tns:inputRecuperaCodSubAppalto/tns:codOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$post2/item/tns:inputRecuperaCodSubAppalto/tns:codOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOloAgcom>&lt;idGpon>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post2/item/tns:inputRecuperaCodSubAppalto/tns:idGpon)&quot;>&lt;xsl:value-of select=&quot;$post2/item/tns:inputRecuperaCodSubAppalto/tns:idGpon&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idGpon>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
