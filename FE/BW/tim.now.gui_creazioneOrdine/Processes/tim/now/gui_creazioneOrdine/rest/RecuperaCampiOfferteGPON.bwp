               &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices>&#xa;                &lt;tns4:Envelope>&#xa;                    &lt;tns4:Identifier>&#xa;                        &lt;tns4:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperaIdgpon&amp;quot;&quot;/>&#xa;                        &lt;/tns4:ServiceName>&#xa;                        &lt;tns4:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Operation>&#xa;                        &lt;tns4:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns5:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns4:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns5:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns4:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns5:httpHeaders/GUI-SID,$post/httpHeaders/tns5:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns4:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns5:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns4:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns5:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns4:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaIdgpon_&amp;quot;,$post/httpHeaders/tns5:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;tns4:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaIdgpon_&amp;quot;,$post/httpHeaders/tns5:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns4:trackID>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                    &lt;tns4:ErrorLog>&#xa;                        &lt;tns4:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns4:TimeStamp>&#xa;                        &lt;tns4:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorRecuperaIdgpon&amp;quot;,'SID:',$post/httpHeaders/tns5:httpHeaders/GUI-SID,'TID:',$post/httpHeaders/tns5:httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns4:Descrizione>&#xa;                        &lt;tns4:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns4:Codice>&#xa;                        &lt;tns4:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns4:track_position>&#xa;                    &lt;/tns4:ErrorLog>&#xa;                &lt;/tns4:Envelope>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
