&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.example.org/RecuperaCampiOfferteGPON" xmlns:tns3="http://xmlns.example.com/20210406172922PLT" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
