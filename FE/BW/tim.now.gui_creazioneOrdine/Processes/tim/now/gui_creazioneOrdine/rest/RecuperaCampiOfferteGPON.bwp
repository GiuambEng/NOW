                        &lt;/tns:details&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:outputRecuperaIdGpon&gt;
            &lt;/item&gt;
        &lt;/tns3:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
