                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$offertaQuery/Record[1]/NOME_OFFERTA_CATLG='BitstreamATMAsimmetricoLite' and exists($offertaQuery/Record/NOME_OFFERTA_CATLG)]]></bpws:transitionCondition>
