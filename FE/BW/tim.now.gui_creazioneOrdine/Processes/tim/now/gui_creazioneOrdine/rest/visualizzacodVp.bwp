                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT VP.COD_VP,VP.CLLI,VP.NOME_CENTRALE &#xa;FROM ANAG_VP VP&#xa;LEFT JOIN OLO O ON O.CODFC_OLO_AGCOM=VP.CODFC_OLO_AGCOM&#xa;WHERE upper(VP.STATO) = 'ACTIVE' AND (upper(VP.TIPO)='STANDARD' OR upper(VP.TIPO)='SPECIAL') &#xa;AND VP.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM&#xa;                         FROM OLO &#xa;                         WHERE CODFC_OLO_AGCOM = ? &#x9;OR COD_OLO_ACCORPANTE = ?&#xa;                         OR COD_OLO = (SELECT COD_OLO&#xa;                                            FROM OLO&#xa;                                            WHERE CODFC_OLO_AGCOM = ?))&#xa;ORDER BY VP.COD_VP" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM3"/>
                                    <columnMetadata
                                    columnName="COD_VP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CLLI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_CENTRALE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
