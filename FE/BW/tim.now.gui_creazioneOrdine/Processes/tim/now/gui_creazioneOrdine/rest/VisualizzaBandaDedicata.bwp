                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fc703dff-8248-4ab1-8e37-791511099718+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaBandaDedicata/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IdOfferta>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:visualizzabandadedicata1GetParameters/tns1:idOfferta&quot;/>&#xa;            &lt;/IdOfferta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get/parameters/tns1:visualizzabandadedicata1GetParameters/tns1:idOfferta = ('15','16')&quot;>&#xa;                    &lt;servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;                    &lt;/servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get/parameters/tns1:visualizzabandadedicata1GetParameters/tns1:idOfferta = '7'&quot;>&#xa;                    &lt;servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;GBE&amp;quot;&quot;/>&#xa;                    &lt;/servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get/parameters/tns1:visualizzabandadedicata1GetParameters/tns1:idOfferta = '41'&quot;>&#xa;                    &lt;servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;GBESIMM&amp;quot;&quot;/>&#xa;                    &lt;/servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VULA&amp;quot;&quot;/>&#xa;                    &lt;/servizio>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCQuery-input"
                                    name="JDBCQuery"
                                    outputVariable="JDBCQuery"
                                    tibex:xpdlId="fc703dff-8248-4ab1-8e37-791511099718" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_visualizzabandadedicata_InputLog_INFOToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JDBCQueryToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length(xsd:string($JDBCQuery/Record[1]/BP2)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length(xsd:string($JDBCQuery/Record[1]/BP2)) > 0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fc703dff-8248-4ab1-8e37-791511099718+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaBandaDedicata/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IdOfferta>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:idOfferta&quot;/>&#xa;            &lt;/IdOfferta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:idOfferta = ('15','16')&quot;>&#xa;                    &lt;servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;                    &lt;/servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:idOfferta = '7'&quot;>&#xa;                    &lt;servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;GBE&amp;quot;&quot;/>&#xa;                    &lt;/servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:idOfferta = '41'&quot;>&#xa;                    &lt;servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;GBESIMM&amp;quot;&quot;/>&#xa;                    &lt;/servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VULA&amp;quot;&quot;/>&#xa;                    &lt;/servizio>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty1"
                                    sqlStatement="select PVM.BP2,PVM.BP2_MAX,PVM.BP3,PVM.BP3_MAX,PVM.BP5,PVM.BP5_MAX,PVM.BP6,PVM.BP6_MAX,PVM.ID_PROFILO_BMD,PVM.ID_SOTTOFAMIG_OFFERTA,PVM.IDTPLG_VLAN,PVM.PROFILO,SFO.DESCR,TV.DESCR AS VLANDESCR&#xd;&#xa;from PROFILO_VLAN_BMD PVM&#xd;&#xa;LEFT JOIN SOTTO_FAMIG_OFFERTA SFO ON SFO.ID_SOTTOFAMIG_OFFERTA=PVM.ID_SOTTOFAMIG_OFFERTA&#xd;&#xa;LEFT JOIN TIPOLG_VLAN TV ON PVM.IDTPLG_VLAN=TV.IDTPLG_VLAN&#xd;&#xa;where PVM.ID_SOTTOFAMIG_OFFERTA = (select O.ID_SOTTOFAMIG_OFFERTA&#xd;&#xa;from offerta O&#xd;&#xa;where O.id_offerta=?) &#xd;&#xa;and TV.DESCR=?&#xd;&#xa;and PVM.FLAG_OSCURABILE = 'N'&#xd;&#xa;and PVM. ID_PROFILO_BMD NOT IN(458,462,464,461,457,466,451,452)&#xd;&#xa;ORDER BY PVM.PROFILO" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IdOfferta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="servizio"/>
                                    <columnMetadata
                                    columnName="BP2"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP2_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP3"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP3_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP5"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP5_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP6"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BP6_MAX"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_PROFILO_BMD"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_SOTTOFAMIG_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDTPLG_VLAN"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PROFILO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="VLANDESCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;get_visualizzabandadedicata_outLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaBandaDedicata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzaBandaDedicata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputVisualizzaBandaDedicata&amp;quot;,&amp;quot;SELECT PVM.BP2,PVM.BP2_MAX,PVM.BP3,PVM.BP3_MAX,PVM.BP5,PVM.BP5_MAX,PVM.BP6,PVM.BP6_MAX,PVM.ID_PROFILO_BMD,PVM.ID_SOTTOFAMIG_OFFERTA,PVM.IDTPLG_VLAN,PVM.PROFILO,SFO.DESCR,TV.DESCR AS VLANDESCR&amp;#xD;&amp;#xA;FROM  PROFILO_VLAN_BMD PVM &amp;#xD;&amp;#xA;LEFT JOIN PROFILO_TCNC_LINEA PTL ON PTL.ID_PROFILO_BMD=PVM.ID_PROFILO_BMD&amp;#xD;&amp;#xA;LEFT JOIN SOTTO_FAMIG_OFFERTA SFO ON SFO.ID_SOTTOFAMIG_OFFERTA=PVM.ID_SOTTOFAMIG_OFFERTA&amp;#xD;&amp;#xA;LEFT JOIN TIPOLG_VLAN TV ON PVM.IDTPLG_VLAN=TV.IDTPLG_VLAN&amp;#xD;&amp;#xA;WHERE PTL.PROFILO_TCNC_LINEA=?  AND PTL.ID_OFFERTA=?&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzaBandaDedicata&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns3:httpHeaders/GUI-SID, $get/httpHeaders/tns3:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaBandaDedicata_&amp;quot;, $get/httpHeaders/tns3:httpHeaders/GUI-SID, &amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaBandaDedicata_&amp;quot;, $get/httpHeaders/tns3:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
