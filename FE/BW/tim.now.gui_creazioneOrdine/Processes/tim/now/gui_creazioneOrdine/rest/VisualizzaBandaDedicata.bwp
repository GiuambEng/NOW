                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaBandaDedicata/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;get_visualizzabandadedicata_InputLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaBandaDedicata&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzaBandaDedicata&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Inputvisualizzabandadedicata:&amp;quot;, tib:render-xml($get.parameters/tns1:idOfferta, true(), true()))&quot;/>&#xa;                &lt;/tns4:Payload>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices>&#xa;                &lt;tns4:Envelope>&#xa;                    &lt;tns4:Identifier>&#xa;                        &lt;tns4:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.visualizzabandadedicata&amp;quot;&quot;/>&#xa;                        &lt;/tns4:ServiceName>&#xa;                        &lt;tns4:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns4:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns4:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID, $get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns4:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns4:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns4:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaBandaDedicata_&amp;quot;, $get.httpHeaders/GUI-SID, &amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;tns4:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaBandaDedicata_&amp;quot;, $get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns4:trackID>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                &lt;/tns4:Envelope>&#xa;                &lt;tns4:Playload>&#xa;                    &lt;tns4:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get.parameters/tns1:idOfferta)))&quot;/>&#xa;                    &lt;/tns4:Binary>&#xa;                    &lt;tns4:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($get.parameters/tns1:idOfferta)&quot;/>&#xa;                    &lt;/tns4:XMLString>&#xa;                &lt;/tns4:Playload>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_creazioneOrdine.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaBandaDedicata/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;get_visualizzabandadedicata_InputLog_INFO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaBandaDedicata&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzaBandaDedicata&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputVisualizzaBandaDedicata:&amp;quot;, tib:render-xml($get/parameters/tns1:visualizzabandadedicata1GetParameters/tns1:idOfferta, true(), true()))&quot;/>&#xa;                &lt;/tns4:Payload>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices>&#xa;                &lt;tns4:Envelope>&#xa;                    &lt;tns4:Identifier>&#xa;                        &lt;tns4:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzaBandaDedicata&amp;quot;&quot;/>&#xa;                        &lt;/tns4:ServiceName>&#xa;                        &lt;tns4:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns4:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns4:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns5:httpHeaders/GUI-SID, $get/httpHeaders/tns5:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns4:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns4:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns4:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaBandaDedicata_&amp;quot;, $get/httpHeaders/tns5:httpHeaders/GUI-SID, &amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;tns4:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaBandaDedicata_&amp;quot;, $get/httpHeaders/tns5:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns4:trackID>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                &lt;/tns4:Envelope>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_visualizzabandadedicata_InputLog_INFO-input"
                                    name="get_visualizzabandadedicata_InputLog_INFO"
                                    tibex:xpdlId="846f2d91-f10c-4e99-9be2-d8b48cb61862"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
