                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/VisualizzaBandaDedicata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:VisualizzaOutputBandaDedicata>&#xa;            &lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&#xa;                &lt;tns2:OutputVisualizzazioneBandaDedicata>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring-after(xsd:string(BP2), &amp;quot;.&amp;quot;) = ''&quot;>&#xa;                            &lt;tns2:bp2>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BP2)&quot;/>&#xa;                            &lt;/tns2:bp2>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:bp2>&#xa;                                &lt;xsl:value-of select=&quot;BP2&quot;/>&#xa;                            &lt;/tns2:bp2>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring-after(xsd:string(BP2_MAX), &amp;quot;.&amp;quot;) = ''&quot;>&#xa;                            &lt;tns2:bp2_Max>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BP2_MAX)&quot;/>&#xa;                            &lt;/tns2:bp2_Max>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:bp2_Max>&#xa;                                &lt;xsl:value-of select=&quot;BP2_MAX&quot;/>&#xa;                            &lt;/tns2:bp2_Max>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring-after(xsd:string(BP3), &amp;quot;.&amp;quot;) = ''&quot;>&#xa;                            &lt;tns2:bp3>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BP3)&quot;/>&#xa;                            &lt;/tns2:bp3>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:bp3>&#xa;                                &lt;xsl:value-of select=&quot;BP3&quot;/>&#xa;                            &lt;/tns2:bp3>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring-after(xsd:string(BP3_MAX), &amp;quot;.&amp;quot;) = ''&quot;>&#xa;                            &lt;tns2:bp3_Max>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BP3_MAX)&quot;/>&#xa;                            &lt;/tns2:bp3_Max>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:bp3_Max>&#xa;                                &lt;xsl:value-of select=&quot;BP3_MAX&quot;/>&#xa;                            &lt;/tns2:bp3_Max>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring-after(xsd:string(BP5), &amp;quot;.&amp;quot;) = ''&quot;>&#xa;                            &lt;tns2:bp5>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BP5)&quot;/>&#xa;                            &lt;/tns2:bp5>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:bp5>&#xa;                                &lt;xsl:value-of select=&quot;BP5&quot;/>&#xa;                            &lt;/tns2:bp5>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring-after(xsd:string(BP5_MAX), &amp;quot;.&amp;quot;) = ''&quot;>&#xa;                            &lt;tns2:bp5_Max>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BP5_MAX)&quot;/>&#xa;                            &lt;/tns2:bp5_Max>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:bp5_Max>&#xa;                                &lt;xsl:value-of select=&quot;BP5_MAX&quot;/>&#xa;                            &lt;/tns2:bp5_Max>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring-after(xsd:string(BP6), &amp;quot;.&amp;quot;) = ''&quot;>&#xa;                            &lt;tns2:bp6>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BP6)&quot;/>&#xa;                            &lt;/tns2:bp6>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:bp6>&#xa;                                &lt;xsl:value-of select=&quot;BP6&quot;/>&#xa;                            &lt;/tns2:bp6>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring-after(xsd:string(BP6_MAX), &amp;quot;.&amp;quot;) = ''&quot;>&#xa;                            &lt;tns2:bp6_Max>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BP6_MAX)&quot;/>&#xa;                            &lt;/tns2:bp6_Max>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:bp6_Max>&#xa;                                &lt;xsl:value-of select=&quot;BP6_MAX&quot;/>&#xa;                            &lt;/tns2:bp6_Max>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns2:id_profiloBmd>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ID_PROFILO_BMD)&quot;/>&#xa;                    &lt;/tns2:id_profiloBmd>&#xa;                    &lt;xsl:if test=&quot;PROFILO&quot;>&#xa;                        &lt;tns2:profilo>&#xa;                            &lt;xsl:value-of select=&quot;PROFILO&quot;/>&#xa;                        &lt;/tns2:profilo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:id_sottofamig_offerta>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ID_SOTTOFAMIG_OFFERTA)&quot;/>&#xa;                    &lt;/tns2:id_sottofamig_offerta>&#xa;                    &lt;xsl:if test=&quot;DESCR&quot;>&#xa;                        &lt;tns2:descr_sottofamig_offerta>&#xa;                            &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                        &lt;/tns2:descr_sottofamig_offerta>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:tipolog_VLAN>&#xa;                        &lt;xsl:value-of select=&quot;VLANDESCR&quot;/>&#xa;                    &lt;/tns2:tipolog_VLAN>&#xa;                &lt;/tns2:OutputVisualizzazioneBandaDedicata>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;tns2:result>&#xa;                &lt;tns2:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                &lt;/tns2:severity>&#xa;                &lt;tns2:code>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/tns2:code>&#xa;                &lt;tns2:details>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATI RECUPERATI&amp;quot;&quot;/>&#xa;                &lt;/tns2:details>&#xa;            &lt;/tns2:result>&#xa;        &lt;/tns2:VisualizzaOutputBandaDedicata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
