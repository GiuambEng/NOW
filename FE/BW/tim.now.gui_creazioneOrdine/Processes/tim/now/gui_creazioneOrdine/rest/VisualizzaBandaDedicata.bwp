                                    <bpws:sources>
                                    <bpws:source linkName="get_visualizzabandadedicata_InputLog_INFOToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$get/parameters/tns:visualizzabandadedicata1GetParameters/tns:idOfferta = ('7','41')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$get.parameters/tns:idOfferta = ('7','41')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="get_visualizzabandadedicata_InputLog_INFOToJDBCQuery1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
