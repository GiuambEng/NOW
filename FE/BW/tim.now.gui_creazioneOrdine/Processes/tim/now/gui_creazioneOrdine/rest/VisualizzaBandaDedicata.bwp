                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="Assign1"
                                    outputVariable="Variable"
                                    tibex:xpdlId="91e3858a-787f-489c-ae4d-7ad186898cba" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
