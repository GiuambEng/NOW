erente>&lt;/xsl:if>&lt;/ReferenteOnField>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:codiceDelivery&quot;>&lt;CodiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns1:codiceDelivery&quot;/>&lt;/CodiceDelivery>&lt;/xsl:if>&lt;IdGPON>&lt;xsl:value-of select=&quot;$Start/tns1:idGpon&quot;/>&lt;/IdGPON>&lt;xsl:if test=&quot;exists($Start/tns1:coinvestimento)&quot;>&lt;xsl:if test=&quot;$Start/tns1:coinvestimento&quot;>&lt;Coinvestimento>&lt;xsl:value-of select=&quot;$Start/tns1:coinvestimento&quot;/>&lt;/Coinvestimento>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Start/tns1:datiServiziOpzionali/tns1:codiceServizio)>0&quot;>&lt;xsl:for-each select=&quot;$Start/tns1:datiServiziOpzionali&quot;>&lt;ServiziOpzionali>&lt;CodiceServizio>&lt;xsl:value-of select=&quot;tns1:codiceServizio&quot;/>&lt;/CodiceServizio>&lt;xsl:if test=&quot;string-length(tns1:descrizioneServizio)>0&quot;>&lt;xsl:if test=&quot;tns1:descrizioneServizio&quot;>&lt;DescrizioneServizio>&lt;xsl:value-of select=&quot;tns1:descrizioneServizio&quot;/>&lt;/DescrizioneServizio>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(tns1:datiTecnici)>0&quot;>&lt;xsl:if test=&quot;tns1:datiTecnici&quot;>&lt;DatiTecnici>&lt;xsl:value-of select=&quot;tns1:datiTecnici&quot;/>&lt;/DatiTecnici>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(tns1:vincolantePerEspletamento)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;tns1:vincolantePerEspletamento = 'Y'&quot;>&lt;VincolantePerEspletamento>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/VincolantePerEspletamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;VincolantePerEspletamento>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/VincolantePerEspletamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;/ServiziOpzionali>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:offertaCatalogo = ('UBBSEMIGPON','SEMIGPON1BPNRR')&quot;>&lt;TipologiaAccessoUBB>&lt;xsl:value-of select=&quot;&amp;quo