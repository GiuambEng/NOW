datiAppuntamentoDisaggregazione/tns1:ownerPresaAppuntamento&quot;/>&lt;/OwnerPresaAppuntamento>&lt;xsl:if test=&quot;exists($Start/tns1:datiAppuntamentoDisaggregazione/tns1:dataAppuntamento) and string-length($Start/tns1:datiAppuntamentoDisaggregazione/tns1:ownerPresaAppuntamento)>0&quot;>&lt;Appuntamento>&lt;DataAppuntamento>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:datiAppuntamentoDisaggregazione/tns1:dataAppuntamento), 9, 2),'/',substring(xsd:string($Start/tns1:datiAppuntamentoDisaggregazione/tns1:dataAppuntamento), 6, 2),'/',substring(xsd:string($Start/tns1:datiAppuntamentoDisaggregazione/tns1:dataAppuntamento), 1, 4))&quot;/>&lt;/DataAppuntamento>&lt;FasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns1:datiAppuntamentoDisaggregazione/tns1:fasciaOraria&quot;/>&lt;/FasciaOraria>&lt;/Appuntamento>&lt;/xsl:if>&lt;/PresaAppuntamento>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:datiPrestazioniAggiuntive/tns1:flagPrestazioneAggiuntiva)>0&quot;>&lt;PrestazioniAggiuntive>&lt;FlagPrestazioneAggiuntiva>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/FlagPrestazioneAggiuntiva>&lt;PrestazioneAggiuntiva>&lt;xsl:value-of select=&quot;$Start/tns1:datiPrestazioniAggiuntive/tns1:prestazioneAggiuntiva&quot;/>&lt;/PrestazioneAggiuntiva>&lt;/PrestazioniAggiuntive>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiGestioneAutonoma/tns1:noteSu&quot;>&lt;NoteSU>&lt;xsl:value-of select=&quot;$Start/tns1:datiGestioneAutonoma/tns1:noteSu&quot;/>&lt;/NoteSU>&lt;/xsl:if>&lt;/GestioneAutonomaOperatore>&lt;/xsl:when>&lt;/xsl:choose>&lt;/Attivazione>&lt;/Ordine>&lt;/Richiesta>&lt;/RichiestaOAO>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
