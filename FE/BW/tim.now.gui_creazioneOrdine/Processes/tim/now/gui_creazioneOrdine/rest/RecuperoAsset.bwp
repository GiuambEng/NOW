                                    tibex:xpdlId="a669a629-96c3-4afb-bbbf-ba479dab90a5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RecuperoIDRisorsaToRecuperoAssetDINSys"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoAssetDINSysTorecuperoAssetAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a669a629-96c3-4afb-bbbf-ba479dab90a5+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoAsset/parameters&quot; xmlns:ns012=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoIDRisorsa.output&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoAssetDINSys-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperoIDRisorsa.output/ns012:IDRisorsaDIN)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoIDRisorsa.output/ns012:IDRisorsaDIN&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRISORSA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;substring($RecuperoIDRisorsa.output/ns012:IDRisorsaDIN, 2, 1) = (&amp;quot;2&amp;quot;,&amp;quot;6&amp;quot;)&quot;>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, $RecuperoIDRisorsa.output/ns012:IDRisorsaDIN)&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;substring($RecuperoIDRisorsa.output/ns012:IDRisorsaDIN, 3, 1) = (&amp;quot;0&amp;quot;,&amp;quot;1&amp;quot;,&amp;quot;5&amp;quot;,&amp;quot;9&amp;quot;)&quot;>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RecuperoIDRisorsa.output/ns012:IDRisorsaDIN)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoIDRisorsa.output/ns012:IDRisorsaDIN&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:value-of select=&quot;substring($RecuperoIDRisorsa.output/ns012:IDRisorsaDIN, 2)&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;NUMEROTELEFONICO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperoIDRisorsa.output/ns012:IDRisorsaDIN)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoIDRisorsa.output/ns012:IDRisorsaDIN&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NUMEROTELEFONICO>&#xa;            &lt;NUMEROFITTIZIO1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperoIDRisorsa.output/ns012:IDRisorsaDIN)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoIDRisorsa.output/ns012:IDRisorsaDIN&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NUMEROFITTIZIO1>&#xa;            &lt;CODIFICAOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:codAgcom&quot;/>&#xa;            &lt;/CODIFICAOLOAGCOM>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT A.IDASSET,A.IDRISORSA,A.NUMEROFITTIZIO, A.NUMEROTELEFONICO,A.OFFERTA,A.ASSETBTWHITELIST&#xa;FROM BDS_1_CASEDATA_ASSET A &#xa;LEFT JOIN OFFERTA O ON O.ID_OFFERTA=A.IDOFFERTA&#xa;WHERE A.STATOASSET='ATTIVO' AND ( A.IDRISORSA=? OR A.NUMEROFITTIZIO=? OR A.NUMEROTELEFONICO=? OR A.NUMEROFITTIZIO=?) &#xa;AND A.CODIFICAOLOAGCOM=? AND O.NOME_OFFERTA_CATLG!='NP' AND (A.OPERATORERETE is null or A.OPERATORERETE!='CSPA')" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROFITTIZIO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROFITTIZIO1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROFITTIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="ASSETBTWHITELIST"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
