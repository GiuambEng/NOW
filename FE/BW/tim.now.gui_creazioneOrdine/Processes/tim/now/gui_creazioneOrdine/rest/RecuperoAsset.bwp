                                    expression="not(exists($RecuperoAssetQuery/Record/IDASSET) and count($RecuperoAssetQuery/Record) > 0) and (upper-case($get/parameters/tns:recuperoassetGetParameters/tns:tipoLavorazione) = &quot;MIGRAZIONE&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
