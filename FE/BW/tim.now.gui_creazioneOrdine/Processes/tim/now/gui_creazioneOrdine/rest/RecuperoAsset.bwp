                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+408fd695-de5a-4a49-8d35-552113033771+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoAsset/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;RecuperoAssetQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSA>&lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperoassetGetParameters/tns1:idRisorsa&quot;/>&lt;/IDRISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($get/parameters/tns1:recuperoassetGetParameters/tns1:idRisorsa, 2, 1) = ('2','6')&quot;>&lt;NUMEROFITTIZIO>&lt;xsl:value-of select=&quot;concat('0', $get/parameters/tns1:recuperoassetGetParameters/tns1:idRisorsa)&quot;/>&lt;/NUMEROFITTIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($get/parameters/tns1:recuperoassetGetParameters/tns1:idRisorsa, 3, 1) = ('0','1','5','9')&quot;>&lt;NUMEROFITTIZIO>&lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperoassetGetParameters/tns1:idRisorsa&quot;/>&lt;/NUMEROFITTIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NUMEROFITTIZIO>&lt;xsl:value-of select=&quot;substring($get/parameters/tns1:recuperoassetGetParameters/tns1:idRisorsa, 2)&quot;/>&lt;/NUMEROFITTIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;NUMEROTELEFONICO>&lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperoassetGetParameters/tns1:idRisorsa&quot;/>&lt;/NUMEROTELEFONICO>&lt;NUMEROFITTIZIO1>&lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperoassetGetParameters/tns1:idRisorsa&quot;/>&lt;/NUMEROFITTIZIO1>&lt;CODIFICAOLOAGCOM>&lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperoassetGetParameters/tns1:codAgcom&quot;/>&lt;/CODIFICAOLOAGCOM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoAssetQuery-input"
                                    name="RecuperoAssetQuery"
                                    outputVariable="RecuperoAssetQuery"
                                    tibex:xpdlId="408fd695-de5a-4a49-8d35-552113033771" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToRecuperoAssetQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoAssetQueryToEmpty"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+408fd695-de5a-4a49-8d35-552113033771+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoAsset/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoAssetQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:idRisorsa&quot;/>&#xa;            &lt;/IDRISORSA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;substring($get.parameters/tns1:idRisorsa, 2, 1) = ('2','6')&quot;>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:value-of select=&quot;concat('0', $get.parameters/tns1:idRisorsa)&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;substring($get.parameters/tns1:idRisorsa, 3, 1) = ('0','1','5','9')&quot;>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:idRisorsa&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:value-of select=&quot;substring($get.parameters/tns1:idRisorsa, 2)&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;NUMEROTELEFONICO>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:idRisorsa&quot;/>&#xa;            &lt;/NUMEROTELEFONICO>&#xa;            &lt;NUMEROFITTIZIO1>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:idRisorsa&quot;/>&#xa;            &lt;/NUMEROFITTIZIO1>&#xa;            &lt;CODIFICAOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:codAgcom&quot;/>&#xa;            &lt;/CODIFICAOLOAGCOM>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT A.IDASSET,A.IDRISORSA,A.NUMEROFITTIZIO, A.NUMEROTELEFONICO,A.OFFERTA,A.ASSETBTWHITELIST&#xa;FROM BDS_1_CASEDATA_ASSET A &#xa;LEFT JOIN OFFERTA O ON O.ID_OFFERTA=A.IDOFFERTA&#xa;WHERE A.STATOASSET='ATTIVO' AND ( A.IDRISORSA=? OR A.NUMEROFITTIZIO=? OR A.NUMEROTELEFONICO=? OR A.NUMEROFITTIZIO=?) &#xa;AND A.CODIFICAOLOAGCOM=? AND O.NOME_OFFERTA_CATLG!='NP' AND (A.OPERATORERETE is null or A.OPERATORERETE!='CSPA')" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROFITTIZIO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROFITTIZIO1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROFITTIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="ASSETBTWHITELIST"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/rest.RecuperoAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoAsset/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoAssetQuery&quot;/>&lt;xsl:param name=&quot;RecuperoOrdineCorrelato&quot;/>&lt;xsl:param name=&quot;RecuperoAssetQueryCessazione&quot;/>&lt;xsl:param name=&quot;RecuperoAssetDINSys&quot;/>&lt;xsl:param name=&quot;ProfiliOlo&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;recuperoAssetVariable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperoAssetQuery/Record/IDASSET) and count($RecuperoAssetQuery/Record) > 0 and contains($ProfiliOlo, $get/parameters/tns1:recuperoassetGetParameters/tns1:tipoProfilo) and ($get/parameters/tns1:recuperoassetGetParameters/tns1:codAgcom = 'ALB') and (upper-case($get/parameters/tns1:recuperoassetGetParameters/tns1:tipoLavorazione)  = ('VARIAZIONE','CESSAZIONE'))&quot;>&lt;tns:RecuperoAssetOutput>&lt;xsl:for-each select=&quot;$RecuperoAssetQuery/Record&quot;>&lt;xsl:if test=&quot;string-length(ASSETBTWHITELIST)=0 or ASSETBTWHITELIST != 'TIMEXBT'&quot;>&lt;tns:recuperoAssetOutput>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/tns:recuperoAssetOutput>&lt;/xsl:if>&lt;/xsl:for-each>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:RecuperoAssetOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($RecuperoAssetQuery/Record/IDASSET) and count($RecuperoAssetQuery/Record) > 0&quot;>&lt;tns:RecuperoAssetOutput>&lt;xsl:for-each select=&quot;$RecuperoAssetQuery/Record&quot;>&lt;tns:recuperoAssetOutput>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/tns:recuperoAssetOutput>&lt;/xsl:for-each>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:RecuperoAssetOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($RecuperoOrdineCorrelato/Record/IDRISORSA) and count($RecuperoOrdineCorrelato/Record) > 0 and contains($ProfiliOlo, $get/parameters/tns1:recuperoassetGetParameters/tns1:tipoProfilo) and ($get/parameters/tns1:recuperoassetGetParameters/tns1:codAgcom = 'ALB')&quot;>&lt;tns:RecuperoAssetOutput>&lt;xsl:for-each select=&quot;$RecuperoAssetQueryCessazione/Record&quot;>&lt;xsl:if test=&quot;string-length(ASSETBTWHITELIST)=0 or ASSETBTWHITELIST != 'TIMEXBT'&quot;>&lt;tns:recuperoAssetOutput>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/tns:recuperoAssetOutput>&lt;/xsl:if>&lt;/xsl:for-each>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:RecuperoAssetOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($RecuperoOrdineCorrelato/Record/IDRISORSA) and count($RecuperoOrdineCorrelato/Record) > 0&quot;>&lt;tns:RecuperoAssetOutput>&lt;xsl:for-each select=&quot;$RecuperoAssetQueryCessazione/Record&quot;>&lt;tns:recuperoAssetOutput>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/tns:recuperoAssetOutput>&lt;/xsl:for-each>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:RecuperoAssetOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($RecuperoAssetDINSys/Record/IDRISORSA) and count($RecuperoAssetDINSys/Record) > 0&quot;>&lt;tns:RecuperoAssetOutput>&lt;xsl:for-each select=&quot;$RecuperoAssetDINSys/Record&quot;>&lt;tns:recuperoAssetOutput>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&lt;tns:numeroFittizio>&lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&lt;/tns:numeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/tns:recuperoAssetOutput>&lt;/xsl:for-each>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:RecuperoAssetOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RecuperoAssetOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:esito>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Lavorazione non possibile sulla risorsa inserita'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:RecuperoAssetOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="recuperoAssetVariable"
                                    name="recuperoAssetAssign"
                                    outputVariable="recuperoAssetVariable"
                                    tibex:xpdlId="563efbee-8770-4bc7-adc5-854bec3e7bbe" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyTorecuperoAssetAssign"/>
                                    <bpws:target linkName="RecuperoAssetDINSysTorecuperoAssetAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="recuperoAssetAssignToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/rest.RecuperoAsset&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoAsset/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoAssetQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOrdineCorrelato&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoAssetQueryCessazione&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoAssetDINSys&quot;/>&#xa;    &lt;xsl:param name=&quot;ProfiliOlo&quot;/>&#xa;    &lt;xsl:template name=&quot;recuperoAssetVariable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($RecuperoAssetQuery/Record/IDASSET) and count($RecuperoAssetQuery/Record) > 0 and contains($ProfiliOlo, $get.parameters/tns1:tipoProfilo) and ($get.parameters/tns1:codAgcom = 'ALB') and (upper-case($get.parameters/tns1:tipoLavorazione)  = ('VARIAZIONE','CESSAZIONE'))&quot;>&#xa;                &lt;tns:RecuperoAssetOutput>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoAssetQuery/Record&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(ASSETBTWHITELIST)=0 or ASSETBTWHITELIST != 'TIMEXBT'&quot;>&#xa;                            &lt;tns:recuperoAssetOutput>&#xa;                                &lt;tns:idAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                                &lt;/tns:idAsset>&#xa;                                &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                    &lt;tns:idRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                    &lt;/tns:idRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&#xa;                                    &lt;tns:numeroTelefonico>&#xa;                                        &lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&#xa;                                    &lt;/tns:numeroTelefonico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&#xa;                                    &lt;tns:numeroFittizio>&#xa;                                        &lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&#xa;                                    &lt;/tns:numeroFittizio>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                    &lt;tns:offerta>&#xa;                                        &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                    &lt;/tns:offerta>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:recuperoAssetOutput>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:esito>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:esito>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:RecuperoAssetOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($RecuperoAssetQuery/Record/IDASSET) and count($RecuperoAssetQuery/Record) > 0&quot;>&#xa;                &lt;tns:RecuperoAssetOutput>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoAssetQuery/Record&quot;>&#xa;                        &lt;tns:recuperoAssetOutput>&#xa;                            &lt;tns:idAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                            &lt;/tns:idAsset>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&#xa;                                &lt;tns:numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&#xa;                                &lt;/tns:numeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&#xa;                                &lt;tns:numeroFittizio>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&#xa;                                &lt;/tns:numeroFittizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns:offerta>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:recuperoAssetOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:esito>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:esito>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:RecuperoAssetOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($RecuperoOrdineCorrelato/Record/IDRISORSA) and count($RecuperoOrdineCorrelato/Record) > 0 and contains($ProfiliOlo, $get.parameters/tns1:tipoProfilo) and ($get.parameters/tns1:codAgcom = 'ALB')&quot;>&#xa;                &lt;tns:RecuperoAssetOutput>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoAssetQueryCessazione/Record&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(ASSETBTWHITELIST)=0 or ASSETBTWHITELIST != 'TIMEXBT'&quot;>&#xa;                            &lt;tns:recuperoAssetOutput>&#xa;                                &lt;tns:idAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                                &lt;/tns:idAsset>&#xa;                                &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                    &lt;tns:idRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                    &lt;/tns:idRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&#xa;                                    &lt;tns:numeroTelefonico>&#xa;                                        &lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&#xa;                                    &lt;/tns:numeroTelefonico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&#xa;                                    &lt;tns:numeroFittizio>&#xa;                                        &lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&#xa;                                    &lt;/tns:numeroFittizio>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                    &lt;tns:offerta>&#xa;                                        &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                    &lt;/tns:offerta>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:recuperoAssetOutput>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:esito>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:esito>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:RecuperoAssetOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($RecuperoOrdineCorrelato/Record/IDRISORSA) and count($RecuperoOrdineCorrelato/Record) > 0&quot;>&#xa;                &lt;tns:RecuperoAssetOutput>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoAssetQueryCessazione/Record&quot;>&#xa;                        &lt;tns:recuperoAssetOutput>&#xa;                            &lt;tns:idAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                            &lt;/tns:idAsset>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&#xa;                                &lt;tns:numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&#xa;                                &lt;/tns:numeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&#xa;                                &lt;tns:numeroFittizio>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&#xa;                                &lt;/tns:numeroFittizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns:offerta>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:recuperoAssetOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:esito>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:esito>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:RecuperoAssetOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($RecuperoAssetDINSys/Record/IDRISORSA) and count($RecuperoAssetDINSys/Record) > 0&quot;>&#xa;                &lt;tns:RecuperoAssetOutput>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoAssetDINSys/Record&quot;>&#xa;                        &lt;tns:recuperoAssetOutput>&#xa;                            &lt;tns:idAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                            &lt;/tns:idAsset>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&#xa;                                &lt;tns:numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&#xa;                                &lt;/tns:numeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMEROFITTIZIO&quot;>&#xa;                                &lt;tns:numeroFittizio>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROFITTIZIO&quot;/>&#xa;                                &lt;/tns:numeroFittizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns:offerta>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:recuperoAssetOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:esito>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:esito>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:RecuperoAssetOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:RecuperoAssetOutput>&#xa;                    &lt;tns:esito>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns:esito>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'Lavorazione non possibile sulla risorsa inserita'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:RecuperoAssetOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
