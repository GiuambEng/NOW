                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a669a629-96c3-4afb-bbbf-ba479dab90a5+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoAsset/parameters&quot; xmlns:ns012=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;RecuperoIDRisorsa&quot;/>&lt;xsl:template name=&quot;RecuperoAssetDINSys-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN)&quot;>&lt;xsl:value-of select=&quot;$RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN, 2, 1) = (&amp;quot;2&amp;quot;,&amp;quot;6&amp;quot;)&quot;>&lt;NUMEROFITTIZIO>&lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, $RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN)&quot;/>&lt;/NUMEROFITTIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN, 3, 1) = (&amp;quot;0&amp;quot;,&amp;quot;1&amp;quot;,&amp;quot;5&amp;quot;,&amp;quot;9&amp;quot;)&quot;>&lt;NUMEROFITTIZIO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN)&quot;>&lt;xsl:value-of select=&quot;$RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUMEROFITTIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NUMEROFITTIZIO>&lt;xsl:value-of select=&quot;substring($RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN, 2)&quot;/>&lt;/NUMEROFITTIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;NUMEROTELEFONICO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN)&quot;>&lt;xsl:value-of select=&quot;$RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUMEROTELEFONICO>&lt;NUMEROFITTIZIO1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN)&quot;>&lt;xsl:value-of select=&quot;$RecuperoIDRisorsa/output/ns012:Recupero_IDRisorsa_Response/ns012:IDRisorsaDIN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUMEROFITTIZIO1>&lt;CODIFICAOLOAGCOM>&lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperoassetGetParameters/tns1:codAgcom&quot;/>&lt;/CODIFICAOLOAGCOM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
