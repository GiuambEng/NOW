                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/concrete/BPM_CheckServiceAmmissibilita/" xmlns:tns1="http://xmlns.example.com/RecuperoAsset/parameters" xmlns:ns012="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" version="2.0"&gt;&lt;xsl:param name="get"/&gt;&lt;xsl:template name="RecuperoIDRisorsa-input" match="/"&gt;&lt;tns:RecuperoIDRisorsaRequest&gt;&lt;input&gt;&lt;ns012:Recupero_IDRisorsa_Request&gt;&lt;ns012:NumeroTelefonico&gt;&lt;xsl:value-of select="$get/parameters/tns1:recuperoassetGetParameters/tns1:idRisorsa"/&gt;&lt;/ns012:NumeroTelefonico&gt;&lt;ns012:IDRichiestaOLO&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns012:IDRichiestaOLO&gt;&lt;/ns012:Recupero_IDRisorsa_Request&gt;&lt;/input&gt;&lt;/tns:RecuperoIDRisorsaRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/concrete/BPM_CheckServiceAmmissibilita/&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoAsset/parameters&quot; xmlns:ns012=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoIDRisorsa-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns012:Recupero_IDRisorsa_Request>&#xa;            &lt;ns012:NumeroTelefonico>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:idRisorsa&quot;/>&#xa;            &lt;/ns012:NumeroTelefonico>&#xa;            &lt;ns012:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/ns012:IDRichiestaOLO>&#xa;        &lt;/ns012:Recupero_IDRisorsa_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
