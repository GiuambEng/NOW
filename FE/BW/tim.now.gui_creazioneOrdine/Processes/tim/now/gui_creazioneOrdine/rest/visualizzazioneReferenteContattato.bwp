                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VisualizzazioneReferenteContattato&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns1:visualizzazioneReferenteContattatoOutput>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns1:visualizzazioneReferenteContattatoOutput1>&lt;xsl:if test=&quot;exists(DATA_TELEFONATA) and string-length(string(DATA_TELEFONATA))>0&quot;>&lt;tns1:dataContatto>&lt;xsl:value-of select=&quot;xsd:date(substring-before(string(DATA_TELEFONATA),&amp;quot;T&amp;quot;))&quot;/>&lt;/tns1:dataContatto>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATA_VISITA_CONTATTO) and string-length(string(DATA_VISITA_CONTATTO))>0&quot;>&lt;tns1:dataVisitaContatto>&lt;xsl:value-of select=&quot;xsd:date(substring-before(string(DATA_VISITA_CONTATTO),&amp;quot;T&amp;quot;))&quot;/>&lt;/tns1:dataVisitaContatto>&lt;/xsl:if>&lt;xsl:if test=&quot;ESITO_CHIAMATA_CONTATTO&quot;>&lt;tns1:esitoChiamataContatto>&lt;xsl:value-of select=&quot;ESITO_CHIAMATA_CONTATTO&quot;/>&lt;/tns1:esitoChiamataContatto>&lt;/xsl:if>&lt;xsl:if test=&quot;CONTATTO_ULTERIORE&quot;>&lt;tns1:notaUlterioreContatto>&lt;xsl:value-of select=&quot;CONTATTO_ULTERIORE&quot;/>&lt;/tns1:notaUlterioreContatto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(COGNOMEREFERENTE, 'dk')&quot;>&lt;xsl:if test=&quot;COGNOMEREFERENTE&quot;>&lt;tns1:nominativoContatto>&lt;xsl:value-of select=&quot;COGNOMEREFERENTE&quot;/>&lt;/tns1:nominativoContatto>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:nominativoContatto>&lt;xsl:value-of select=&quot;concat(COGNOMEREFERENTE, ' ', NOMEREFERENTE)&quot;/>&lt;/tns1:nominativoContatto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(ORA_TELEFONATA) and string-length(ORA_TELEFONATA)>0&quot;>&lt;tns1:oraContatto>&lt;xsl:value-of select=&quot;tib:parse-time(&amp;quot;HH:mm&amp;quot;,ORA_TELEFONATA)&quot;/>&lt;/tns1:oraContatto>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(PROGRS_EVENTO_DTU) and string-length(string(PROGRS_EVENTO_DTU))>0&quot;>&lt;tns1:progressivoEventoDtu>&lt;xsl:value-of select=&quot;xsd:int(PROGRS_EVENTO_DTU)&quot;/>&lt;/tns1:progressivoEventoDtu>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ORA_VISITA_CONTATTO) and string-length(ORA_VISITA_CONTATTO)>0&quot;>&lt;tns1:oraVisitaContatto>&lt;xsl:value-of select=&quot;tib:parse-time(&amp;quot;HH:mm&amp;quot;,ORA_VISITA_CONTATTO)&quot;/>&lt;/tns1:oraVisitaContatto>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(PROGRS_REFTE) and string-length(string(PROGRS_REFTE))>0&quot;>&lt;tns1:progressivoReferente>&lt;xsl:value-of select=&quot;xsd:int(PROGRS_REFTE)&quot;/>&lt;/tns1:progressivoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;TELF_FISSO_REFTE = 'SI'&quot;>&lt;xsl:if test=&quot;TELEFONOFISSOREFERENTE&quot;>&lt;tns1:telefonoFissoReferente>&lt;xsl:value-of select=&quot;TELEFONOFISSOREFERENTE&quot;/>&lt;/tns1:telefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;TELF_MOBL_REFTE = &amp;quot;SI&amp;quot;&quot;>&lt;xsl:if test=&quot;TELEFONOMOBILEREFERENTE&quot;>&lt;tns1:telefonoMobileReferente>&lt;xsl:value-of select=&quot;TELEFONOMOBILEREFERENTE&quot;/>&lt;/tns1:telefonoMobileReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_INSMTO) and string-length(string(TIMSTP_INSMTO))>0&quot;>&lt;tns1:timestampInserimento>&lt;xsl:value-of select=&quot;xsd:date(substring-before(string(TIMSTP_INSMTO),&amp;quot;T&amp;quot;))&quot;/>&lt;/tns1:timestampInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;QUALIFICAREFERENTE&quot;>&lt;tns1:qualifica>&lt;xsl:value-of select=&quot;QUALIFICAREFERENTE&quot;/>&lt;/tns1:qualifica>&lt;/xsl:if>&lt;/tns1:visualizzazioneReferenteContattatoOutput1>&lt;/xsl:for-each>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:code>&lt;/tns1:result>&lt;/tns1:visualizzazioneReferenteContattatoOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
