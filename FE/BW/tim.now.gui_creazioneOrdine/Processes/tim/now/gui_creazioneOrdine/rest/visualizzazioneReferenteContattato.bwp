    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="VisualizzazioneReferenteContattatoOut">
            <endingVariables>
                <variable>VisualizzazioneReferenteContattatoOut-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionereferentecontattato_InputLog">
            <endingVariables>
                <variable>get_visualizzazionereferentecontattato_InputLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionereferentecontattato_InputLog_INFO">
            <endingVariables>
                <variable>get_visualizzazionereferentecontattato_InputLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionereferentecontattato_outLog">
            <endingVariables>
                <variable>get_visualizzazionereferentecontattato_outLog-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery">
            <endingVariables>
                <variable>JDBCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="get_visualizzazionereferentecontattato_Error_Log">
            <endingVariables>
                <variable>get_visualizzazionereferentecontattato_Error_Log-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
