                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/RecuperoConsistenzaIdRisorsa&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/ConfigurazioneFE&quot; xmlns:tns2=&quot;http://xmlns.example.com/RecuperoConsistenzaIdRisorsa/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CallConfigurazioneFE&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiClienteQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiSedeQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;OffertaQuery2&quot;/>&#xa;    &lt;xsl:param name=&quot;OffertaQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoConsistenzaIdRisorsaVariable&quot; match=&quot;/&quot;>&#xa;        &lt;tns:outputRecuperoConsistenzaIdRisorsa>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns2:tipoOperazione='MIGRAZIONE' and string-length(string ($OffertaQuery2/Record[1]/IDASSET))>0 and string-length($CallConfigurazioneFE/tns1:outputConfigurazioneFE[1]/tns1:codice)>0&quot;>&#xa;                    &lt;tns:OutputRecuperoConsistenzaIdRisorsa>&#xa;                        &lt;xsl:if test=&quot;$DatiClienteQuery/Record[1]/NOME&quot;>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;$DatiClienteQuery/Record[1]/NOME&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiClienteQuery/Record[1]/COGNOMERAGIONESOCIALE&quot;>&#xa;                            &lt;tns:cognome_ragSociale>&#xa;                                &lt;xsl:value-of select=&quot;$DatiClienteQuery/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&#xa;                            &lt;/tns:cognome_ragSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiClienteQuery/Record[1]/CODICEFISCALE&quot;>&#xa;                            &lt;tns:CF>&#xa;                                &lt;xsl:value-of select=&quot;$DatiClienteQuery/Record[1]/CODICEFISCALE&quot;/>&#xa;                            &lt;/tns:CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiClienteQuery/Record[1]/PARTITAIVA&quot;>&#xa;                            &lt;tns:P.IVA>&#xa;                                &lt;xsl:value-of select=&quot;$DatiClienteQuery/Record[1]/PARTITAIVA&quot;/>&#xa;                            &lt;/tns:P.IVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_PROV&quot;>&#xa;                                    &lt;tns:provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_PROV&quot;/>&#xa;                                    &lt;/tns:provincia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/PROVINCIA&quot;>&#xa;                                    &lt;tns:provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/PROVINCIA&quot;/>&#xa;                                    &lt;/tns:provincia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_COMUNE&quot;>&#xa;                                    &lt;tns:comune>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_COMUNE&quot;/>&#xa;                                    &lt;/tns:comune>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/COMUNE&quot;>&#xa;                                    &lt;tns:comune>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/COMUNE&quot;/>&#xa;                                    &lt;/tns:comune>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_COMUNE&quot;>&#xa;                                    &lt;tns:localita>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_COMUNE&quot;/>&#xa;                                    &lt;/tns:localita>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/LOCALITA&quot;>&#xa;                                    &lt;tns:localita>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/LOCALITA&quot;/>&#xa;                                    &lt;/tns:localita>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/CODICETOPONOMASTICA&quot;>&#xa;                            &lt;tns:codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/CODICETOPONOMASTICA&quot;/>&#xa;                            &lt;/tns:codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_PARTICELLA_TOPON&quot;>&#xa;                                    &lt;tns:descParticellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_PARTICELLA_TOPON&quot;/>&#xa;                                    &lt;/tns:descParticellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCRPARTTOPONOMASTICA&quot;>&#xa;                                    &lt;tns:descParticellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCRPARTTOPONOMASTICA&quot;/>&#xa;                                    &lt;/tns:descParticellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_VIA&quot;>&#xa;                                    &lt;tns:via>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_VIA&quot;/>&#xa;                                    &lt;/tns:via>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCRIZIONEVIA&quot;>&#xa;                                    &lt;tns:via>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCRIZIONEVIA&quot;/>&#xa;                                    &lt;/tns:via>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/NUMERO_CIVICO&quot;>&#xa;                                    &lt;tns:numero>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/NUMERO_CIVICO&quot;/>&#xa;                                    &lt;/tns:numero>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/NUMEROCIVICO&quot;>&#xa;                                    &lt;tns:numero>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/NUMEROCIVICO&quot;/>&#xa;                                    &lt;/tns:numero>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/CAP_NUM_CIV&quot;>&#xa;                                    &lt;tns:cap>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/CAP_NUM_CIV&quot;/>&#xa;                                    &lt;/tns:cap>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/CAP&quot;>&#xa;                                    &lt;tns:cap>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/CAP&quot;/>&#xa;                                    &lt;/tns:cap>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/COMPLESSO&quot;>&#xa;                            &lt;tns:complesso>&#xa;                                &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/COMPLESSO&quot;/>&#xa;                            &lt;/tns:complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/INTERNO&quot;>&#xa;                            &lt;tns:interno>&#xa;                                &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/INTERNO&quot;/>&#xa;                            &lt;/tns:interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/SCALA&quot;>&#xa;                            &lt;tns:scala>&#xa;                                &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/SCALA&quot;/>&#xa;                            &lt;/tns:scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/PIANO&quot;>&#xa;                            &lt;tns:piano>&#xa;                                &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/PIANO&quot;/>&#xa;                            &lt;/tns:piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/IDRISORSANOW&quot;>&#xa;                            &lt;tns:idRisorsaNow>&#xa;                                &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/IDRISORSANOW&quot;/>&#xa;                            &lt;/tns:idRisorsaNow>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:esito>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:esito>&#xa;                        &lt;xsl:for-each select=&quot;$CallConfigurazioneFE/tns1:outputConfigurazioneFE&quot;>&#xa;                            &lt;tns:otputConfigurazioneFE>&#xa;                                &lt;tns:codice>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:codice&quot;/>&#xa;                                &lt;/tns:codice>&#xa;                                &lt;tns:descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:descrizione&quot;/>&#xa;                                &lt;/tns:descrizione>&#xa;                            &lt;/tns:otputConfigurazioneFE>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns:OutputRecuperoConsistenzaIdRisorsa>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns2:tipoOperazione!='MIGRAZIONE' and string-length(string ($OffertaQuery/Record[1]/IDASSET))>0 and string-length($CallConfigurazioneFE/tns1:outputConfigurazioneFE[1]/tns1:codice)>0&quot;>&#xa;                    &lt;tns:OutputRecuperoConsistenzaIdRisorsa>&#xa;                        &lt;xsl:if test=&quot;$DatiClienteQuery/Record[1]/NOME&quot;>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;$DatiClienteQuery/Record[1]/NOME&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiClienteQuery/Record[1]/COGNOMERAGIONESOCIALE&quot;>&#xa;                            &lt;tns:cognome_ragSociale>&#xa;                                &lt;xsl:value-of select=&quot;$DatiClienteQuery/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&#xa;                            &lt;/tns:cognome_ragSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiClienteQuery/Record[1]/CODICEFISCALE&quot;>&#xa;                            &lt;tns:CF>&#xa;                                &lt;xsl:value-of select=&quot;$DatiClienteQuery/Record[1]/CODICEFISCALE&quot;/>&#xa;                            &lt;/tns:CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DatiClienteQuery/Record[1]/PARTITAIVA&quot;>&#xa;                            &lt;tns:P.IVA>&#xa;                                &lt;xsl:value-of select=&quot;$DatiClienteQuery/Record[1]/PARTITAIVA&quot;/>&#xa;                            &lt;/tns:P.IVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_PROV&quot;>&#xa;                                    &lt;tns:provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_PROV&quot;/>&#xa;                                    &lt;/tns:provincia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/PROVINCIA&quot;>&#xa;                                    &lt;tns:provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/PROVINCIA&quot;/>&#xa;                                    &lt;/tns:provincia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_COMUNE&quot;>&#xa;                                    &lt;tns:comune>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_COMUNE&quot;/>&#xa;                                    &lt;/tns:comune>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/COMUNE&quot;>&#xa;                                    &lt;tns:comune>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/COMUNE&quot;/>&#xa;                                    &lt;/tns:comune>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_COMUNE&quot;>&#xa;                                    &lt;tns:localita>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_COMUNE&quot;/>&#xa;                                    &lt;/tns:localita>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/LOCALITA&quot;>&#xa;                                    &lt;tns:localita>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/LOCALITA&quot;/>&#xa;                                    &lt;/tns:localita>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/CODICETOPONOMASTICA&quot;>&#xa;                            &lt;tns:codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/CODICETOPONOMASTICA&quot;/>&#xa;                            &lt;/tns:codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_PARTICELLA_TOPON&quot;>&#xa;                                    &lt;tns:descParticellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_PARTICELLA_TOPON&quot;/>&#xa;                                    &lt;/tns:descParticellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCRPARTTOPONOMASTICA&quot;>&#xa;                                    &lt;tns:descParticellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCRPARTTOPONOMASTICA&quot;/>&#xa;                                    &lt;/tns:descParticellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($DatiSedeQuery/Record/CODICETOPONOMASTICA) and string-length($DatiSedeQuery/Record[1]/CODICETOPONOMASTICA)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCR_VIA&quot;>&#xa;                                    &lt;tns:via>&#xa;                                        &lt;xsl:value-of select=&quot;$DatiSedeQuery/Record[1]/DESCR_VIA&quot;/>&#xa;                                    &lt;/tns:via>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$DatiSedeQuery/Record[1]/DESCRIZIONEVIA&quot;>&#xa;                                    &lt;tns:via>&#xa;      