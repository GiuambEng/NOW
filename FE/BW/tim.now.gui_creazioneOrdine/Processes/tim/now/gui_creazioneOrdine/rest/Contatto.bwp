                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contacts/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RiferimentiContatto&quot;/>&#xa;    &lt;xsl:template name=&quot;referentiVariable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($RiferimentiContatto/Record/ID_CONTATTO) and string-length(xsd:string($RiferimentiContatto/Record[1]/ID_CONTATTO))>0&quot;>&#xa;                &lt;tns:contactsReferencesOutput>&#xa;                    &lt;xsl:for-each select=&quot;$RiferimentiContatto/Record&quot;>&#xa;                        &lt;tns:riferimentiContatti>&#xa;                            &lt;xsl:if test=&quot;INDIRIZZO&quot;>&#xa;                                &lt;tns:indirizzo>&#xa;                                    &lt;xsl:value-of select=&quot;INDIRIZZO&quot;/>&#xa;                                &lt;/tns:indirizzo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMERO_CIVICO&quot;>&#xa;                                &lt;tns:numeroCivico>&#xa;                                    &lt;xsl:value-of select=&quot;NUMERO_CIVICO&quot;/>&#xa;                                &lt;/tns:numeroCivico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMERO_MOBL&quot;>&#xa;                                &lt;tns:numeroMobl>&#xa;                                    &lt;xsl:value-of select=&quot;NUMERO_MOBL&quot;/>&#xa;                                &lt;/tns:numeroMobl>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;PARTICELLA_TOPON&quot;>&#xa;                                &lt;tns:particellaTopon>&#xa;                                    &lt;xsl:value-of select=&quot;PARTICELLA_TOPON&quot;/>&#xa;                                &lt;/tns:particellaTopon>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;PREFISSO_FISSO&quot;>&#xa;                                &lt;tns:prefissoFisso>&#xa;                                    &lt;xsl:value-of select=&quot;PREFISSO_FISSO&quot;/>&#xa;                                &lt;/tns:prefissoFisso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;PREFISSO_MOBL&quot;>&#xa;                                &lt;tns:prefissoMobl>&#xa;                                    &lt;xsl:value-of select=&quot;PREFISSO_MOBL&quot;/>&#xa;                                &lt;/tns:prefissoMobl>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;PROV&quot;>&#xa;                                &lt;tns:prov>&#xa;                                    &lt;xsl:value-of select=&quot;PROV&quot;/>&#xa;                                &lt;/tns:prov>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TELF_FISSO&quot;>&#xa;                                &lt;tns:telfFisso>&#xa;                                    &lt;xsl:value-of select=&quot;TELF_FISSO&quot;/>&#xa;                                &lt;/tns:telfFisso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TELF_FISSO_ALTERNATIVO&quot;>&#xa;                                &lt;tns:telfFissoAlternativo>&#xa;                                    &lt;xsl:value-of select=&quot;TELF_FISSO_ALTERNATIVO&quot;/>&#xa;                                &lt;/tns:telfFissoAlternativo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CAP&quot;>&#xa;                                &lt;tns:cap>&#xa;                                    &lt;xsl:value-of select=&quot;CAP&quot;/>&#xa;                                &lt;/tns:cap>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CELLULARE_ALTERNATIVO&quot;>&#xa;                                &lt;tns:cellulareAlternativo>&#xa;                                    &lt;xsl:value-of select=&quot;CELLULARE_ALTERNATIVO&quot;/>&#xa;                                &lt;/tns:cellulareAlternativo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COD_ISTAT_COMUNE&quot;>&#xa;                                &lt;tns:codIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;COD_ISTAT_COMUNE&quot;/>&#xa;                                &lt;/tns:codIstatComune>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COD_ISTAT_INDIRIZZO&quot;>&#xa;                                &lt;tns:codIstatIndirizzo>&#xa;                                    &lt;xsl:value-of select=&quot;COD_ISTAT_INDIRIZZO&quot;/>&#xa;                                &lt;/tns:codIstatIndirizzo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COD_ISTAT_PROV&quot;>&#xa;                                &lt;tns:codIstatProvincia>&#xa;                                    &lt;xsl:value-of select=&quot;COD_ISTAT_PROV&quot;/>&#xa;                                &lt;/tns:codIstatProvincia>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COMUNE&quot;>&#xa;                                &lt;tns:comune>&#xa;                                    &lt;xsl:value-of select=&quot;COMUNE&quot;/>&#xa;                                &lt;/tns:comune>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;EMAIL&quot;>&#xa;                                &lt;tns:email>&#xa;                                    &lt;xsl:value-of select=&quot;EMAIL&quot;/>&#xa;                                &lt;/tns:email>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;FAX&quot;>&#xa;                                &lt;tns:fax>&#xa;                                    &lt;xsl:value-of select=&quot;FAX&quot;/>&#xa;                                &lt;/tns:fax>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:riferimentiContatti>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:contactsReferencesOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:contactsReferencesOutput>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:contactsReferencesOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
