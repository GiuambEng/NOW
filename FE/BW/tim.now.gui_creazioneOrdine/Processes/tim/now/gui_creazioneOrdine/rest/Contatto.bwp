                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contacts/&quot; xmlns:ns6=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;noRicercaJDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;ContattiSql&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputListaContatti&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($post.item/ns6:strutturaCondition[1]/ns6:nome)!=0&quot;>&#xa;                &lt;tns:OLOContactsListOutput>&#xa;                    &lt;xsl:for-each select=&quot;$ContattiSql/unknownResultset/row&quot;>&#xa;                        &lt;tns:contactListOutput>&#xa;                            &lt;tns:oao>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='NOME_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_OLO']/value)&quot;>&#xa;                                    &lt;tns:olo>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='NOME_OLO']/value&quot;/>&#xa;                                    &lt;/tns:olo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='RAGIONE_SOCIALE']/value)&quot;>&#xa;                                    &lt;tns:ragioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='RAGIONE_SOCIALE']/value&quot;/>&#xa;                                    &lt;/tns:ragioneSociale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='PARTITA_IVA']/value)&quot;>&#xa;                                    &lt;tns:partitaIva>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='PARTITA_IVA']/value&quot;/>&#xa;                                    &lt;/tns:partitaIva>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&#xa;                                    &lt;tns:codiceOloAgcom>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                                    &lt;/tns:codiceOloAgcom>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO']/value)&quot;>&#xa;                                    &lt;tns:codiceOloNumerico>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='COD_OLO']/value&quot;/>&#xa;                                    &lt;/tns:codiceOloNumerico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_OLO_ACCORPANTE']/value)&quot;>&#xa;                                    &lt;tns:flagAccorpante>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='FLAG_OLO_ACCORPANTE']/value&quot;/>&#xa;                                    &lt;/tns:flagAccorpante>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:oao>&#xa;                            &lt;tns:idContatto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(string(column[name='ID_CONTATTO']/value))&quot;/>&#xa;                            &lt;/tns:idContatto>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_PRIMARIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_PRIMARIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_PRIMARIO']/value)&quot;>&#xa;                                &lt;tns:primary>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_PRIMARIO']/value&quot;/>&#xa;                                &lt;/tns:primary>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME']/value)&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='NOME']/value&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='COGNOME']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COGNOME']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COGNOME']/value)&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='COGNOME']/value&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='TIPTITDESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPTITDESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPTITDESCR']/value)&quot;>&#xa;                                &lt;tns:mr_Ms>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='TIPTITDESCR']/value&quot;/>&#xa;                                &lt;/tns:mr_Ms>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='TIPREF']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPREF']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPREF']/value)&quot;>&#xa;                                &lt;tns:tipoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='TIPREF']/value&quot;/>&#xa;                                &lt;/tns:tipoReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='DESCRCAN']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCRCAN']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCRCAN']/value)&quot;>&#xa;                                &lt;tns:metodoContatto>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='DESCRCAN']/value&quot;/>&#xa;                                &lt;/tns:metodoContatto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OPERATORE']/value)&quot;>&#xa;                                &lt;tns:operatore>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='OPERATORE']/value&quot;/>&#xa;                                &lt;/tns:operatore>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataUltimoAggiornamento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_AGGTO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataUltimoAggiornamento>&#xa;                            &lt;tns:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_INSMTO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataInserimento>&#xa;                        &lt;/tns:contactListOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;xsl:if test=&quot;count($ContattiSql/unknownResultset/row)>=$MaxRows&quot;>&#xa;                            &lt;tns:code>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;LIMIT&amp;quot;&quot;/>&#xa;                            &lt;/tns:code>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OLOContactsListOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OLOContactsListOutput>&#xa;                    &lt;xsl:for-each select=&quot;$noRicercaJDBCQuery/Record&quot;>&#xa;                        &lt;tns:contactListOutput>&#xa;                            &lt;tns:oao>&#xa;                                &lt;xsl:if test=&quot;NOME_OLO&quot;>&#xa;                                    &lt;tns:olo>&#xa;                                        &lt;xsl:value-of select=&quot;NOME_OLO&quot;/>&#xa;                                    &lt;/tns:olo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&#xa;                                    &lt;tns:ragioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                                    &lt;/tns:ragioneSociale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;PARTITA_IVA&quot;>&#xa;                                    &lt;tns:partitaIva>&#xa;                                        &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&#xa;                                    &lt;/tns:partitaIva>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                    &lt;tns:codiceOloAgcom>&#xa;                                        &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                    &lt;/tns:codiceOloAgcom>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;COD_OLO&quot;>&#xa;                                    &lt;tns:codiceOloNumerico>&#xa;                                        &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                                    &lt;/tns:codiceOloNumerico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&#xa;                                    &lt;tns:flagAccorpante>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&#xa;                                    &lt;/tns:flagAccorpante>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:oao>&#xa;                            &lt;tns:idContatto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ID_CONTATTO)&quot;/>&#xa;                            &lt;/tns:idContatto>&#xa;                            &lt;xsl:if test=&quot;FLAG_PRIMARIO&quot;>&#xa;                                &lt;tns:primary>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_PRIMARIO&quot;/>&#xa;                                &lt;/tns:primary>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                            &lt;tns:cognome>&#xa;                                &lt;xsl:value-of select=&quot;COGNOME&quot;/>&#xa;                            &lt;/tns:cognome>&#xa;                            &lt;xsl:if test=&quot;TIPTITDESCR&quot;>&#xa;                                &lt;tns:mr_Ms>&#xa;                                    &lt;xsl:value-of select=&quot;TIPTITDESCR&quot;/>&#xa;                                &lt;/tns:mr_Ms>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPREF&quot;>&#xa;                                &lt;tns:tipoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;TIPREF&quot;/>&#xa;                                &lt;/tns:tipoReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCRCAN&quot;>&#xa;                                &lt;tns:metodoContatto>&#xa;                                    &lt;xsl:value-of select=&quot;DESCRCAN&quot;/>&#xa;                                &lt;/tns:metodoContatto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:operatore>&#xa;                                &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                            &lt;/tns:operatore>&#xa;                            &lt;xsl:if test=&quot;TIMSTP_AGGTO&quot;>&#xa;                                &lt;tns:dataUltimoAggiornamento>&#xa;                                    &lt;xsl:value-of select=&quot;TIMSTP_AGGTO&quot;/>&#xa;                                &lt;/tns:dataUltimoAggiornamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;TIMSTP_INSMTO&quot;/>&#xa;                            &lt;/tns:dataInserimento>&#xa;                        &lt;/tns:contactListOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;xsl:if test=&quot;count($noRicercaJDBCQuery/Record)>=$MaxRows&quot;>&#xa;                            &lt;tns:code>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;LIMIT&amp;quot;&quot;/>&#xa;                            &lt;/tns:code>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OLOContactsListOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
