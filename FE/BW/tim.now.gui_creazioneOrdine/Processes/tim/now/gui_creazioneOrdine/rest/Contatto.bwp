                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+652dd699-d8ee-4638-b2eb-3de26ef9fce2+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/Contatto/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:nuovordine-contatto1-ListaContattiGetParameters/tns1:codOlo&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;COD_OLO_ACCORPANTE>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:nuovordine-contatto1-ListaContattiGetParameters/tns1:codOlo&quot;/>&#xa;            &lt;/COD_OLO_ACCORPANTE>&#xa;            &lt;PROFILOINOLO>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:nuovordine-contatto1-ListaContattiGetParameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/PROFILOINOLO>&#xa;            &lt;PROFILOINOTHER>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:nuovordine-contatto1-ListaContattiGetParameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/PROFILOINOTHER>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
