                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($post/item/ns6:inputservizioricercaavanzata/ns6:exportRequest) and (upper-case($post/item/ns6:inputservizioricercaavanzata/ns6:exportRequest)='S' or upper-case($post/item/ns6:inputservizioricercaavanzata/ns6:exportRequest)='Y')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($post.item/ns6:exportRequest) and (upper-case($post.item/ns6:exportRequest)='S' or upper-case($post.item/ns6:exportRequest)='Y')]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
