                                    </bpws:flow>
                                </bpws:scope>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="OnMessageStartToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess1ToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess2TogetOut" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="get_ListaContatti_InLog_INFOToJDBCQuery1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery1Toget_ListaContatti_outp_Log" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="OnMessageStart"
                                tibex:constructor="onMessageStart" tibex:xpdlId="63676e3e-dd8b-4ff2-bdf6-17919b25dd9f">
                                <bpws:sources>
                                    <bpws:source linkName="OnMessageStartToCallProcess1"/>
