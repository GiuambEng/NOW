                            <bpws:empty name="Empty1" tibex:xpdlId="38bdd292-6cb1-490a-9be4-3bd17779244b">
                                <bpws:targets>
                                    <bpws:target linkName="post_Lista_InLog_INFOToEmpty1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty1ToRicercaAvanzata_RICERCAAVANZATA">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty1ToJDBCQuery2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($post/item/ns6:inputservizioricercaavanzata/ns6:strutturaCondition[1]/ns6:nome)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($post.item/ns6:strutturaCondition[1]/ns6:nome)=0]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+078508eb-190e-4eb6-9d55-74ee1e73d562+input&quot; xmlns:ns6=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns1=&quot;http://xmlns.example.com/Contatto/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;ContattiSql-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CO.CODFC_OLO_AGCOM,O.NOME AS NOME_OLO,O.RAGIONE_SOCIALE,O.PARTITA_IVA,O.COD_OLO,O.FLAG_OLO_ACCORPANTE,C.ID_CONTATTO,C.FLAG_PRIMARIO,C.NOME,C.COGNOME,TIPTIT.DESCR AS TIPTITDESCR, TIPCO.DESCR AS TIPREF, CAN.DESCR AS DESCRCAN,C.OPERATORE,C.TIMSTP_AGGTO,C.TIMSTP_INSMTO FROM CONTATTO C left Join CONTATTO_OLO CO ON C.ID_CONTATTO=CO.ID_CONTATTO left JOIN CANALE_CONTATTO CAN ON C.ID_CANALE_CONTATTO=CAN.ID_CANALE_CONTATTO left JOIN TIPOLG_CONTATTO TIPCO ON C.IDTPLG_CONTATTO=TIPCO.IDTPLG_CONTATTO LEFT JOIN TIPOLG_TITOLO TIPTIT ON C.IDTPLG_TITOLO= TIPTIT.IDTPLG_TITOLO LEFT JOIN OLO O ON O.CODFC_OLO_AGCOM = CO.CODFC_OLO_AGCOM WHERE (((CO.CODFC_OLO_AGCOM ='&amp;quot;,$post/parameters/tns1:nuovordine-contatto1-ListaContattiPostParameters/tns1:codOlo,&amp;quot;' OR COD_OLO_ACCORPANTE= '&amp;quot;,$post/parameters/tns1:nuovordine-contatto1-ListaContattiPostParameters/tns1:codOlo,&amp;quot;' ) AND '&amp;quot;,$post/parameters/tns1:nuovordine-contatto1-ListaContattiPostParameters/tns1:tipoProfilo,&amp;quot;'  like '%OLO%') OR ('&amp;quot;,$post/parameters/tns1:nuovordine-contatto1-ListaContattiPostParameters/tns1:tipoProfilo,&amp;quot;'  NOT like '%OLO%')) AND &amp;quot;,$RicercaAvanzata/ns6:outputcondition[1],&amp;quot;order by C.TIMSTP_AGGTO&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ContattiSql-input"
                                    name="ContattiSql"
                                    outputVariable="ContattiSql"
                                    tibex:xpdlId="078508eb-190e-4eb6-9d55-74ee1e73d562" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RicercaAvanzataToContattiSql"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SQLDirectToRicercaList"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+078508eb-190e-4eb6-9d55-74ee1e73d562+input&quot; xmlns:ns6=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns1=&quot;http://xmlns.example.com/Contatto/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:template name=&quot;ContattiSql-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CO.CODFC_OLO_AGCOM,O.NOME AS NOME_OLO,O.RAGIONE_SOCIALE,O.PARTITA_IVA,O.COD_OLO,O.FLAG_OLO_ACCORPANTE,C.ID_CONTATTO,C.FLAG_PRIMARIO,C.NOME,C.COGNOME,TIPTIT.DESCR AS TIPTITDESCR, TIPCO.DESCR AS TIPREF, CAN.DESCR AS DESCRCAN,C.OPERATORE,C.TIMSTP_AGGTO,C.TIMSTP_INSMTO FROM CONTATTO C left Join CONTATTO_OLO CO ON C.ID_CONTATTO=CO.ID_CONTATTO left JOIN CANALE_CONTATTO CAN ON C.ID_CANALE_CONTATTO=CAN.ID_CANALE_CONTATTO left JOIN TIPOLG_CONTATTO TIPCO ON C.IDTPLG_CONTATTO=TIPCO.IDTPLG_CONTATTO LEFT JOIN TIPOLG_TITOLO TIPTIT ON C.IDTPLG_TITOLO= TIPTIT.IDTPLG_TITOLO LEFT JOIN OLO O ON O.CODFC_OLO_AGCOM = CO.CODFC_OLO_AGCOM WHERE (((CO.CODFC_OLO_AGCOM ='&amp;quot;,$post.parameters/tns1:codOlo,&amp;quot;' OR COD_OLO_ACCORPANTE= '&amp;quot;,$post.parameters/tns1:codOlo,&amp;quot;' ) AND '&amp;quot;,$post.parameters/tns1:tipoProfilo,&amp;quot;'  like '%OLO%') OR ('&amp;quot;,$post.parameters/tns1:tipoProfilo,&amp;quot;'  NOT like '%OLO%')) AND &amp;quot;,$RicercaAvanzata/ns6:outputcondition[1],&amp;quot;order by C.TIMSTP_AGGTO&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7ff8535b-9e83-4ac6-a825-7e8d1b6522d8+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/Contatto/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns1:nuovordine-contatto1-ListaContattiPostParameters/tns1:codOlo&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;COD_OLO_ACCORPANTE>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns1:nuovordine-contatto1-ListaContattiPostParameters/tns1:codOlo&quot;/>&#xa;            &lt;/COD_OLO_ACCORPANTE>&#xa;            &lt;PROFILOINOLO>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns1:nuovordine-contatto1-ListaContattiPostParameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/PROFILOINOLO>&#xa;            &lt;PROFILOINOTHER>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns1:nuovordine-contatto1-ListaContattiPostParameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/PROFILOINOTHER>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="noRicercaJDBCQuery-input"
                                    name="noRicercaJDBCQuery"
                                    outputVariable="noRicercaJDBCQuery"
                                    tibex:xpdlId="7ff8535b-9e83-4ac6-a825-7e8d1b6522d8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToJDBCQuery2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery2ToRicercaList"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7ff8535b-9e83-4ac6-a825-7e8d1b6522d8+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/Contatto/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns1:codOlo&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;COD_OLO_ACCORPANTE>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns1:codOlo&quot;/>&#xa;            &lt;/COD_OLO_ACCORPANTE>&#xa;            &lt;PROFILOINOLO>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/PROFILOINOLO>&#xa;            &lt;PROFILOINOTHER>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/PROFILOINOTHER>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CO.CODFC_OLO_AGCOM, O.NOME AS NOME_OLO, O.RAGIONE_SOCIALE,&#xa;  O.PARTITA_IVA, O.COD_OLO, O.FLAG_OLO_ACCORPANTE, C.ID_CONTATTO,&#xa;  C.FLAG_PRIMARIO, C.NOME, C.COGNOME, TIPTIT.DESCR AS TIPTITDESCR,&#xa;  TIPCO.DESCR AS TIPREF, CAN.DESCR AS DESCRCAN, C.OPERATORE, C.TIMSTP_AGGTO,&#xa;  C.TIMSTP_INSMTO&#xa;  FROM&#xa;       CONTATTO C LEFT OUTER JOIN CONTATTO_OLO CO ON C.ID_CONTATTO = CO.ID_CONTATTO LEFT OUTER JOIN CANALE_CONTATTO CAN ON C.ID_CANALE_CONTATTO = CAN.ID_CANALE_CONTATTO LEFT OUTER JOIN TIPOLG_CONTATTO TIPCO ON C.IDTPLG_CONTATTO = TIPCO.IDTPLG_CONTATTO LEFT OUTER JOIN TIPOLG_TITOLO TIPTIT ON C.IDTPLG_TITOLO = TIPTIT.IDTPLG_TITOLO LEFT OUTER JOIN OLO O ON O.CODFC_OLO_AGCOM = CO.CODFC_OLO_AGCOM&#xa;  WHERE ((CO.CODFC_OLO_AGCOM = ? OR O.COD_OLO_ACCORPANTE = ?) AND ? LIKE '%OLO%')&#xa;    OR (? NOT LIKE '%OLO%') order by C.TIMSTP_AGGTO" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO_ACCORPANTE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILOINOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILOINOTHER"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="RAGIONE_SOCIALE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PARTITA_IVA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_OLO_ACCORPANTE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_CONTATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_PRIMARIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COGNOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPTITDESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPREF"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRCAN"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_AGGTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CryptoParams-input"
                                    name="CryptoParams"
                                    outputVariable="CryptoParams"
                                    tibex:xpdlId="9aa4dd31-38c1-465d-8fa2-77fe28e284fe"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ScopeToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessTopost_Lista_outp_Log"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/CryptoParams&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;CryptoParams-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CryptoParamsInput>&#xa;            &lt;tns1:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns1:idFile>&#xa;        &lt;/tns1:CryptoParamsInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_creazioneOrdine.sub.CryptoParams" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
