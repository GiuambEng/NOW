                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess12-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Contatto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.Contatto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ListaContatti Info : &amp;quot;,tib:render-xml($post/item, true(), true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.Contatto&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns1:httpHeaders/GUI-SID,$post/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Contatto_&amp;quot;,$post/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Contatto_&amp;quot;,$post/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
