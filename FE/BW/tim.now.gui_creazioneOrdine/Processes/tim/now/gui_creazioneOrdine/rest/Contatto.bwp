                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+652dd699-d8ee-4638-b2eb-3de26ef9fce2+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/Contatto/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOlo&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;COD_OLO_ACCORPANTE>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOlo&quot;/>&#xa;            &lt;/COD_OLO_ACCORPANTE>&#xa;            &lt;PROFILOINOLO>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/PROFILOINOLO>&#xa;            &lt;PROFILOINOTHER>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/PROFILOINOTHER>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CO.CODFC_OLO_AGCOM, O.NOME AS NOME_OLO, O.RAGIONE_SOCIALE,&#xa;  O.PARTITA_IVA, O.COD_OLO, O.FLAG_OLO_ACCORPANTE, C.ID_CONTATTO,&#xa;  C.FLAG_PRIMARIO, C.NOME, C.COGNOME, TIPTIT.DESCR AS TIPTITDESCR,&#xa;  TIPCO.DESCR AS TIPREF, CAN.DESCR AS DESCRCAN, C.OPERATORE, C.TIMSTP_AGGTO,&#xa;  C.TIMSTP_INSMTO&#xa;  FROM&#xa;  CONTATTO C &#xa;  LEFT JOIN CONTATTO_OLO CO ON C.ID_CONTATTO = CO.ID_CONTATTO &#xa;  LEFT JOIN CANALE_CONTATTO CAN ON C.ID_CANALE_CONTATTO = CAN.ID_CANALE_CONTATTO&#xa;  LEFT JOIN TIPOLG_CONTATTO TIPCO ON C.IDTPLG_CONTATTO = TIPCO.IDTPLG_CONTATTO&#xa;  LEFT JOIN TIPOLG_TITOLO TIPTIT ON C.IDTPLG_TITOLO = TIPTIT.IDTPLG_TITOLO&#xa;  LEFT JOIN OLO O ON O.CODFC_OLO_AGCOM = CO.CODFC_OLO_AGCOM&#xa;  WHERE ((CO.CODFC_OLO_AGCOM = ? OR O.COD_OLO_ACCORPANTE = ?) AND ? LIKE '%OLO%')&#xa;    OR (? NOT LIKE '%OLO%') order by C.TIMSTP_AGGTO&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO_ACCORPANTE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILOINOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILOINOTHER"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="RAGIONE_SOCIALE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PARTITA_IVA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_OLO_ACCORPANTE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_CONTATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_PRIMARIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COGNOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPTITDESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPREF"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRCAN"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_AGGTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
                <bpws:onMessage operation="get"
                    partnerLink="RiferimentiContatto"
                    portType="ns:contatto"
                    tibex:xpdlId="8804e996-77d5-4256-ac82-d2c4ed336110" variable="get2">
                    <bpws:scope name="scope3">
