                                    sqlStatement="SELECT ID_CONTATTO,INDIRIZZO, NUMERO_CIVICO, NUMERO_MOBL, PARTICELLA_TOPON, PREFISSO_FISSO, &#xa; PREFISSO_MOBL, PROV, TELF_FISSO, TELF_FISSO_ALTERNATIVO, CAP, CELLULARE_ALTERNATIVO,&#xa; COD_ISTAT_COMUNE, COD_ISTAT_INDIRIZZO, COD_ISTAT_PROV, COMUNE, EMAIL, FAX&#xa;  FROM RIF_CONTATTO&#xa;  WHERE ID_CONTATTO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

