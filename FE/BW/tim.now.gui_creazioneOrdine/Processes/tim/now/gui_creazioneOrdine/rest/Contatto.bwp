                            <bpws:empty name="OnMessageEnd"
                                tibex:constructor="onMessageEnd" tibex:xpdlId="84c44b77-1f75-410a-943f-b4f4c598e9d6"/>
                            <bpws:reply name="getOut" operation="get"
                                partnerLink="ListaContatti"
                                portType="ns:nuovordine-contatto1-ListaContatti"
                                tibex:xpdlId="d18e168e-1ade-48d6-bf08-2b6079419652" variable="getOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160422093851PLT" xmlns:tns="http://www.tim.com/NOW/rest/contacts/" xmlns:tns4="http://xmlns.example.com/Contatto/parameters" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="Profile"/&gt;
    &lt;xsl:param name="get"/&gt;
    &lt;xsl:param name="ListaContatti"/&gt;
    &lt;xsl:param name="MaxRows"/&gt;
    &lt;xsl:template name="getOut-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;item&gt;
                &lt;tns:OLOContactsListOutput&gt;
                    &lt;xsl:for-each select="$ListaContatti/Record"&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="(contains($Profile, $get/parameters/tns4:nuovordine-contatto1-ListaContattiGetParameters/tns4:tipoProfilo) = true()) and (FLAG_OLO_ACCORPANTE ='Y')"&gt;
                                &lt;tns:contactListOutput&gt;
                                    &lt;tns:oao&gt;
                                        &lt;xsl:if test="NOME_OLO"&gt;
                                            &lt;tns:olo&gt;
                                                &lt;xsl:value-of select="NOME_OLO"/&gt;
                                            &lt;/tns:olo&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="RAGIONE_SOCIALE"&gt;
                                            &lt;tns:ragioneSociale&gt;
                                                &lt;xsl:value-of select="RAGIONE_SOCIALE"/&gt;
                                            &lt;/tns:ragioneSociale&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="PARTITA_IVA"&gt;
                                            &lt;tns:partitaIva&gt;
                                                &lt;xsl:value-of select="PARTITA_IVA"/&gt;
                                            &lt;/tns:partitaIva&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="CODFC_OLO_AGCOM"&gt;
                                            &lt;tns:codiceOloAgcom&gt;
                                                &lt;xsl:value-of select="CODFC_OLO_AGCOM"/&gt;
                                            &lt;/tns:codiceOloAgcom&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="COD_OLO"&gt;
                                            &lt;tns:codiceOloNumerico&gt;
                                                &lt;xsl:value-of select="COD_OLO"/&gt;
                                            &lt;/tns:codiceOloNumerico&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="FLAG_OLO_ACCORPANTE"&gt;
                                            &lt;tns:flagAccorpante&gt;
                                                &lt;xsl:value-of select="FLAG_OLO_ACCORPANTE"/&gt;
                                            &lt;/tns:flagAccorpante&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns:oao&gt;
                                    &lt;tns:idContatto&gt;
                                        &lt;xsl:value-of select="xsd:int(ID_CONTATTO)"/&gt;
                                    &lt;/tns:idContatto&gt;
                                    &lt;xsl:if test="FLAG_PRIMARIO"&gt;
                                        &lt;tns:primary&gt;
                                            &lt;xsl:value-of select="FLAG_PRIMARIO"/&gt;
                                        &lt;/tns:primary&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:nome&gt;
                                        &lt;xsl:value-of select="NOME"/&gt;
                                    &lt;/tns:nome&gt;
                                    &lt;tns:cognome&gt;
                                        &lt;xsl:value-of select="COGNOME"/&gt;
                                    &lt;/tns:cognome&gt;
                                    &lt;xsl:if test="TIPTITDESCR"&gt;
                                        &lt;tns:mr_Ms&gt;
                                            &lt;xsl:value-of select="TIPTITDESCR"/&gt;
                                        &lt;/tns:mr_Ms&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="TIPREF"&gt;
                                        &lt;tns:tipoReferente&gt;
                                            &lt;xsl:value-of select="TIPREF"/&gt;
                                        &lt;/tns:tipoReferente&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="DESCRCAN"&gt;
                                        &lt;tns:metodoContatto&gt;
                                            &lt;xsl:value-of select="DESCRCAN"/&gt;
                                        &lt;/tns:metodoContatto&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:operatore&gt;
                                        &lt;xsl:value-of select="OPERATORE"/&gt;
                                    &lt;/tns:operatore&gt;
                                    &lt;xsl:if test="TIMSTP_AGGTO"&gt;
                                        &lt;tns:dataUltimoAggiornamento&gt;
                                            &lt;xsl:value-of select="TIMSTP_AGGTO"/&gt;
                                        &lt;/tns:dataUltimoAggiornamento&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:dataInserimento&gt;
                                        &lt;xsl:value-of select="TIMSTP_INSMTO"/&gt;
                                    &lt;/tns:dataInserimento&gt;
                                &lt;/tns:contactListOutput&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="(contains($Profile, $get/parameters/tns4:nuovordine-contatto1-ListaContattiGetParameters/tns4:tipoProfilo) = true()) and (FLAG_OLO_ACCORPANTE !='Y')"&gt;
                                &lt;tns:contactListOutput&gt;
                                    &lt;tns:oao&gt;
                                        &lt;xsl:if test="NOME_OLO"&gt;
                                            &lt;tns:olo&gt;
                                                &lt;xsl:value-of select="NOME_OLO"/&gt;
                                            &lt;/tns:olo&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="RAGIONE_SOCIALE"&gt;
                                            &lt;tns:ragioneSociale&gt;
                                                &lt;xsl:value-of select="RAGIONE_SOCIALE"/&gt;
                                            &lt;/tns:ragioneSociale&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="PARTITA_IVA"&gt;
                                            &lt;tns:partitaIva&gt;
                                                &lt;xsl:value-of select="PARTITA_IVA"/&gt;
                                            &lt;/tns:partitaIva&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="CODFC_OLO_AGCOM"&gt;
                                            &lt;tns:codiceOloAgcom&gt;
                                                &lt;xsl:value-of select="CODFC_OLO_AGCOM"/&gt;
                                            &lt;/tns:codiceOloAgcom&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="COD_OLO"&gt;
                                            &lt;tns:codiceOloNumerico&gt;
                                                &lt;xsl:value-of select="COD_OLO"/&gt;
                                            &lt;/tns:codiceOloNumerico&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="FLAG_OLO_ACCORPANTE"&gt;
                                            &lt;tns:flagAccorpante&gt;
                                                &lt;xsl:value-of select="FLAG_OLO_ACCORPANTE"/&gt;
                                            &lt;/tns:flagAccorpante&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns:oao&gt;
                                    &lt;tns:idContatto&gt;
                                        &lt;xsl:value-of select="xsd:int(ID_CONTATTO)"/&gt;
                                    &lt;/tns:idContatto&gt;
                                    &lt;xsl:if test="FLAG_PRIMARIO"&gt;
                                        &lt;tns:primary&gt;
                                            &lt;xsl:value-of select="FLAG_PRIMARIO"/&gt;
                                        &lt;/tns:primary&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:nome&gt;
                                        &lt;xsl:value-of select="NOME"/&gt;
                                    &lt;/tns:nome&gt;
                                    &lt;tns:cognome&gt;
                                        &lt;xsl:value-of select="COGNOME"/&gt;
                                    &lt;/tns:cognome&gt;
                                    &lt;xsl:if test="TIPTITDESCR"&gt;
                                        &lt;tns:mr_Ms&gt;
                                            &lt;xsl:value-of select="TIPTITDESCR"/&gt;
                                        &lt;/tns:mr_Ms&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="TIPREF"&gt;
                                        &lt;tns:tipoReferente&gt;
                                            &lt;xsl:value-of select="TIPREF"/&gt;
                                        &lt;/tns:tipoReferente&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="DESCRCAN"&gt;
                                        &lt;tns:metodoContatto&gt;
                                            &lt;xsl:value-of select="DESCRCAN"/&gt;
                                        &lt;/tns:metodoContatto&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:operatore&gt;
                                        &lt;xsl:value-of select="OPERATORE"/&gt;
                                    &lt;/tns:operatore&gt;
                                    &lt;xsl:if test="TIMSTP_AGGTO"&gt;
                                        &lt;tns:dataUltimoAggiornamento&gt;
                                            &lt;xsl:value-of select="TIMSTP_AGGTO"/&gt;
                                        &lt;/tns:dataUltimoAggiornamento&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:dataInserimento&gt;
                                        &lt;xsl:value-of select="TIMSTP_INSMTO"/&gt;
                                    &lt;/tns:dataInserimento&gt;
                                &lt;/tns:contactListOutput&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns:contactListOutput&gt;
                                    &lt;tns:oao&gt;
                                        &lt;xsl:if test="NOME_OLO"&gt;
                                            &lt;tns:olo&gt;
                                                &lt;xsl:value-of select="NOME_OLO"/&gt;
                                            &lt;/tns:olo&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="RAGIONE_SOCIALE"&gt;
                                            &lt;tns:ragioneSociale&gt;
                                                &lt;xsl:value-of select="RAGIONE_SOCIALE"/&gt;
                                            &lt;/tns:ragioneSociale&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="PARTITA_IVA"&gt;
                                            &lt;tns:partitaIva&gt;
                                                &lt;xsl:value-of select="PARTITA_IVA"/&gt;
                                            &lt;/tns:partitaIva&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="CODFC_OLO_AGCOM"&gt;
                                            &lt;tns:codiceOloAgcom&gt;
                                                &lt;xsl:value-of select="CODFC_OLO_AGCOM"/&gt;
                                            &lt;/tns:codiceOloAgcom&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="COD_OLO"&gt;
                                            &lt;tns:codiceOloNumerico&gt;
                                                &lt;xsl:value-of select="COD_OLO"/&gt;
                                            &lt;/tns:codiceOloNumerico&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="FLAG_OLO_ACCORPANTE"&gt;
                                            &lt;tns:flagAccorpante&gt;
                                                &lt;xsl:value-of select="FLAG_OLO_ACCORPANTE"/&gt;
                                            &lt;/tns:flagAccorpante&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns:oao&gt;
                                    &lt;tns:idContatto&gt;
                                        &lt;xsl:value-of select="xsd:int(ID_CONTATTO)"/&gt;
                                    &lt;/tns:idContatto&gt;
                                    &lt;xsl:if test="FLAG_PRIMARIO"&gt;
                                        &lt;tns:primary&gt;
                                            &lt;xsl:value-of select="FLAG_PRIMARIO"/&gt;
                                        &lt;/tns:primary&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:nome&gt;
                                        &lt;xsl:value-of select="NOME"/&gt;
                                    &lt;/tns:nome&gt;
                                    &lt;tns:cognome&gt;
                                        &lt;xsl:value-of select="COGNOME"/&gt;
                                    &lt;/tns:cognome&gt;
                                    &lt;xsl:if test="TIPTITDESCR"&gt;
                                        &lt;tns:mr_Ms&gt;
                                            &lt;xsl:value-of select="TIPTITDESCR"/&gt;
                                        &lt;/tns:mr_Ms&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="TIPREF"&gt;
                                        &lt;tns:tipoReferente&gt;
                                            &lt;xsl:value-of select="TIPREF"/&gt;
                                        &lt;/tns:tipoReferente&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="DESCRCAN"&gt;
                                        &lt;tns:metodoContatto&gt;
                                            &lt;xsl:value-of select="DESCRCAN"/&gt;
                                        &lt;/tns:metodoContatto&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:operatore&gt;
                                        &lt;xsl:value-of select="OPERATORE"/&gt;
                                    &lt;/tns:operatore&gt;
                                    &lt;xsl:if test="TIMSTP_AGGTO"&gt;
                                        &lt;tns:dataUltimoAggiornamento&gt;
                                            &lt;xsl:value-of select="TIMSTP_AGGTO"/&gt;
                                        &lt;/tns:dataUltimoAggiornamento&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:dataInserimento&gt;
                                        &lt;xsl:value-of select="TIMSTP_INSMTO"/&gt;
                                    &lt;/tns:dataInserimento&gt;
                                &lt;/tns:contactListOutput&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
                            &lt;xsl:value-of select="'INFO'"/&gt;
                        &lt;/tns:severity&gt;
                        &lt;tns:code&gt;
                            &lt;xsl:value-of select="if(count($ListaContatti/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'"/&gt;
                        &lt;/tns:code&gt;
                        &lt;xsl:if test="count($ListaContatti/Record) = 0"&gt;
                            &lt;tns:details&gt;
                                &lt;xsl:value-of select="&amp;quot;RECORD NON PRESENTI&amp;quot;"/&gt;
                            &lt;/tns:details&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:OLOContactsListOutput&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160422093851PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contacts/&quot; xmlns:tns4=&quot;http://xmlns.example.com/Contatto/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Profile&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaContatti&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:OLOContactsListOutput>&#xa;            &lt;xsl:for-each select=&quot;$ListaContatti/Record&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;(contains($Profile, $get.parameters/tns4:tipoProfilo) = true()) and (FLAG_OLO_ACCORPANTE ='Y')&quot;>&#xa;                        &lt;tns:contactListOutput>&#xa;                            &lt;tns:oao>&#xa;                                &lt;xsl:if test=&quot;NOME_OLO&quot;>&#xa;                                    &lt;tns:olo>&#xa;                                        &lt;xsl:value-of select=&quot;NOME_OLO&quot;/>&#xa;                                    &lt;/tns:olo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&#xa;                                    &lt;tns:ragioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                                    &lt;/tns:ragioneSociale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;PARTITA_IVA&quot;>&#xa;                                    &lt;tns:partitaIva>&#xa;                                        &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&#xa;                                    &lt;/tns:partitaIva>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                    &lt;tns:codiceOloAgcom>&#xa;                                        &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                    &lt;/tns:codiceOloAgcom>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;COD_OLO&quot;>&#xa;                                    &lt;tns:codiceOloNumerico>&#xa;                                        &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                                    &lt;/tns:codiceOloNumerico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&#xa;                                    &lt;tns:flagAccorpante>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&#xa;                                    &lt;/tns:flagAccorpante>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:oao>&#xa;                            &lt;tns:idContatto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ID_CONTATTO)&quot;/>&#xa;                            &lt;/tns:idContatto>&#xa;                            &lt;xsl:if test=&quot;FLAG_PRIMARIO&quot;>&#xa;                                &lt;tns:primary>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_PRIMARIO&quot;/>&#xa;                                &lt;/tns:primary>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                            &lt;tns:cognome>&#xa;                                &lt;xsl:value-of select=&quot;COGNOME&quot;/>&#xa;                            &lt;/tns:cognome>&#xa;                            &lt;xsl:if test=&quot;TIPTITDESCR&quot;>&#xa;                                &lt;tns:mr_Ms>&#xa;                                    &lt;xsl:value-of select=&quot;TIPTITDESCR&quot;/>&#xa;                                &lt;/tns:mr_Ms>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPREF&quot;>&#xa;                                &lt;tns:tipoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;TIPREF&quot;/>&#xa;                                &lt;/tns:tipoReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCRCAN&quot;>&#xa;                                &lt;tns:metodoContatto>&#xa;                                    &lt;xsl:value-of select=&quot;DESCRCAN&quot;/>&#xa;                                &lt;/tns:metodoContatto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:operatore>&#xa;                                &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                            &lt;/tns:operatore>&#xa;                            &lt;xsl:if test=&quot;TIMSTP_AGGTO&quot;>&#xa;                                &lt;tns:dataUltimoAggiornamento>&#xa;                                    &lt;xsl:value-of select=&quot;TIMSTP_AGGTO&quot;/>&#xa;                                &lt;/tns:dataUltimoAggiornamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;TIMSTP_INSMTO&quot;/>&#xa;                            &lt;/tns:dataInserimento>&#xa;                        &lt;/tns:contactListOutput>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;(contains($Profile, $get.parameters/tns4:tipoProfilo) = true()) and (FLAG_OLO_ACCORPANTE !='Y')&quot;>&#xa;                        &lt;tns:contactListOutput>&#xa;                            &lt;tns:oao>&#xa;                                &lt;xsl:if test=&quot;NOME_OLO&quot;>&#xa;                                    &lt;tns:olo>&#xa;                                        &lt;xsl:value-of select=&quot;NOME_OLO&quot;/>&#xa;                                    &lt;/tns:olo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&#xa;                                    &lt;tns:ragioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                                    &lt;/tns:ragioneSociale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;PARTITA_IVA&quot;>&#xa;                                    &lt;tns:partitaIva>&#xa;                                        &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&#xa;                                    &lt;/tns:partitaIva>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                    &lt;tns:codiceOloAgcom>&#xa;                                        &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                    &lt;/tns:codiceOloAgcom>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;COD_OLO&quot;>&#xa;                                    &lt;tns:codiceOloNumerico>&#xa;                                        &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                                    &lt;/tns:codiceOloNumerico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&#xa;                                    &lt;tns:flagAccorpante>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&#xa;                                    &lt;/tns:flagAccorpante>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:oao>&#xa;                            &lt;tns:idContatto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ID_CONTATTO)&quot;/>&#xa;                            &lt;/tns:idContatto>&#xa;                            &lt;xsl:if test=&quot;FLAG_PRIMARIO&quot;>&#xa;                                &lt;tns:primary>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_PRIMARIO&quot;/>&#xa;                                &lt;/tns:primary>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                            &lt;tns:cognome>&#xa;                                &lt;xsl:value-of select=&quot;COGNOME&quot;/>&#xa;                            &lt;/tns:cognome>&#xa;                            &lt;xsl:if test=&quot;TIPTITDESCR&quot;>&#xa;                                &lt;tns:mr_Ms>&#xa;                                    &lt;xsl:value-of select=&quot;TIPTITDESCR&quot;/>&#xa;                                &lt;/tns:mr_Ms>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPREF&quot;>&#xa;                                &lt;tns:tipoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;TIPREF&quot;/>&#xa;                                &lt;/tns:tipoReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCRCAN&quot;>&#xa;                                &lt;tns:metodoContatto>&#xa;                                    &lt;xsl:value-of select=&quot;DESCRCAN&quot;/>&#xa;                                &lt;/tns:metodoContatto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:operatore>&#xa;                                &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                            &lt;/tns:operatore>&#xa;                            &lt;xsl:if test=&quot;TIMSTP_AGGTO&quot;>&#xa;                                &lt;tns:dataUltimoAggiornamento>&#xa;                                    &lt;xsl:value-of select=&quot;TIMSTP_AGGTO&quot;/>&#xa;                                &lt;/tns:dataUltimoAggiornamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;TIMSTP_INSMTO&quot;/>&#xa;                            &lt;/tns:dataInserimento>&#xa;                        &lt;/tns:contactListOutput>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:contactListOutput>&#xa;                            &lt;tns:oao>&#xa;                                &lt;xsl:if test=&quot;NOME_OLO&quot;>&#xa;                                    &lt;tns:olo>&#xa;                                        &lt;xsl:value-of select=&quot;NOME_OLO&quot;/>&#xa;                                    &lt;/tns:olo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&#xa;                                    &lt;tns:ragioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                                    &lt;/tns:ragioneSociale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;PARTITA_IVA&quot;>&#xa;                                    &lt;tns:partitaIva>&#xa;                                        &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&#xa;                                    &lt;/tns:partitaIva>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                    &lt;tns:codiceOloAgcom>&#xa;                                        &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                    &lt;/tns:codiceOloAgcom>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;COD_OLO&quot;>&#xa;                                    &lt;tns:codiceOloNumerico>&#xa;                                        &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                                    &lt;/tns:codiceOloNumerico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&#xa;                                    &lt;tns:flagAccorpante>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&#xa;                                    &lt;/tns:flagAccorpante>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:oao>&#xa;                            &lt;tns:idContatto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ID_CONTATTO)&quot;/>&#xa;                            &lt;/tns:idContatto>&#xa;                            &lt;xsl:if test=&quot;FLAG_PRIMARIO&quot;>&#xa;                                &lt;tns:primary>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_PRIMARIO&quot;/>&#xa;                                &lt;/tns:primary>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                            &lt;tns:cognome>&#xa;                                &lt;xsl:value-of select=&quot;COGNOME&quot;/>&#xa;                            &lt;/tns:cognome>&#xa;                            &lt;xsl:if test=&quot;TIPTITDESCR&quot;>&#xa;                                &lt;tns:mr_Ms>&#xa;                                    &lt;xsl:value-of select=&quot;TIPTITDESCR&quot;/>&#xa;                                &lt;/tns:mr_Ms>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPREF&quot;>&#xa;                                &lt;tns:tipoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;TIPREF&quot;/>&#xa;                                &lt;/tns:tipoReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCRCAN&quot;>&#xa;                                &lt;tns:metodoContatto>&#xa;                                    &lt;xsl:value-of select=&quot;DESCRCAN&quot;/>&#xa;                                &lt;/tns:metodoContatto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:operatore>&#xa;                                &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                            &lt;/tns:operatore>&#xa;                            &lt;xsl:if test=&quot;TIMSTP_AGGTO&quot;>&#xa;                                &lt;tns:dataUltimoAggiornamento>&#xa;                                    &lt;xsl:value-of select=&quot;TIMSTP_AGGTO&quot;/>&#xa;                                &lt;/tns:dataUltimoAggiornamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;TIMSTP_INSMTO&quot;/>&#xa;                            &lt;/tns:dataInserimento>&#xa;                        &lt;/tns:contactListOutput>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;if(count($ListaContatti/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&#xa;                &lt;/tns:code>&#xa;                &lt;xsl:if test=&quot;count($ListaContatti/Record) = 0&quot;>&#xa;                    &lt;tns:details>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RECORD NON PRESENTI&amp;quot;&quot;/>&#xa;                    &lt;/tns:details>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:OLOContactsListOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess2TogetOut"/>
                                </bpws:targets>
                            </bpws:reply>
