                                    tibex:xpdlId="652dd699-d8ee-4638-b2eb-3de26ef9fce2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_ListaContatti_InLog_INFOToJDBCQuery1"/>
