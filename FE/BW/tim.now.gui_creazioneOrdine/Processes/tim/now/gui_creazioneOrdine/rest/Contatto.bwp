            </endingVariables>
        </task>
        <task name="get_RifContatto_outp_Log">
            <endingVariables>
                <variable>get_RifContatto_outp_Log-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="get_RifContatto_InLog">
            <endingVariables>
