                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contacts/&quot; xmlns:ns6=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;noRicercaJDBCQuery&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;ContattiSql&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;OutputListaContatti&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($post/item/ns6:inputservizioricercaavanzata/ns6:strutturaCondition[1]/ns6:nome)!=0&quot;>&lt;tns:OLOContactsListOutput>&lt;xsl:for-each select=&quot;$ContattiSql/unknownResultset/row&quot;>&lt;tns:contactListOutput>&lt;tns:oao>&lt;xsl:if test=&quot;not((string(column[name='NOME_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_OLO']/value)&quot;>&lt;tns:olo>&lt;xsl:value-of select=&quot;column[name='NOME_OLO']/value&quot;/>&lt;/tns:olo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='RAGIONE_SOCIALE']/value)&quot;>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;column[name='RAGIONE_SOCIALE']/value&quot;/>&lt;/tns:ragioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='PARTITA_IVA']/value)&quot;>&lt;tns:partitaIva>&lt;xsl:value-of select=&quot;column[name='PARTITA_IVA']/value&quot;/>&lt;/tns:partitaIva>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&lt;tns:codiceOloAgcom>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&lt;/tns:codiceOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO']/value)&quot;>&lt;tns:codiceOloNumerico>&lt;xsl:value-of select=&quot;column[name='COD_OLO']/value&quot;/>&lt;/tns:codiceOloNumerico>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_OLO_ACCORPANTE']/value)&quot;>&lt;tns:flagAccorpante>&lt;xsl:value-of select=&quot;column[name='FLAG_OLO_ACCORPANTE']/value&quot;/>&lt;/tns:flagAccorpante>&lt;/xsl:if>&lt;/tns:oao>&lt;tns:idContatto>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='ID_CONTATTO']/value))&quot;/>&lt;/tns:idContatto>&lt;xsl:if test=&quot;not((string(column[name='FLAG_PRIMARIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_PRIMARIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_PRIMARIO']/value)&quot;>&lt;tns:primary>&lt;xsl:value-of select=&quot;column[name='FLAG_PRIMARIO']/value&quot;/>&lt;/tns:primary>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME']/value)&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;column[name='NOME']/value&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COGNOME']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COGNOME']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COGNOME']/value)&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;column[name='COGNOME']/value&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPTITDESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPTITDESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPTITDESCR']/value)&quot;>&lt;tns:mr_Ms>&lt;xsl:value-of select=&quot;column[name='TIPTITDESCR']/value&quot;/>&lt;/tns:mr_Ms>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPREF']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPREF']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPREF']/value)&quot;>&lt;tns:tipoReferente>&lt;xsl:value-of select=&quot;column[name='TIPREF']/value&quot;/>&lt;/tns:tipoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCRCAN']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCRCAN']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCRCAN']/value)&quot;>&lt;tns:metodoContatto>&lt;xsl:value-of select=&quot;column[name='DESCRCAN']/value&quot;/>&lt;/tns:metodoContatto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OPERATORE']/value)&quot;>&lt;tns:operatore>&lt;xsl:value-of select=&quot;column[name='OPERATORE']/value&quot;/>&lt;/tns:operatore>&lt;/xsl:if>&lt;tns:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_AGGTO']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataUltimoAggiornamento>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_INSMTO']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInserimento>&lt;/tns:contactListOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;xsl:if test=&quot;count($ContattiSql/unknownResultset/row)>=$MaxRows&quot;>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;LIMIT&amp;quot;&quot;/>&lt;/tns:code>&lt;/xsl:if>&lt;/tns:result>&lt;/tns:OLOContactsListOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OLOContactsListOutput>&lt;xsl:for-each select=&quot;$noRicercaJDBCQuery/Record&quot;>&lt;tns:contactListOutput>&lt;tns:oao>&lt;xsl:if test=&quot;NOME_OLO&quot;>&lt;tns:olo>&lt;xsl:value-of select=&quot;NOME_OLO&quot;/>&lt;/tns:olo>&lt;/xsl:if>&lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&lt;/tns:ragioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;PARTITA_IVA&quot;>&lt;tns:partitaIva>&lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&lt;/tns:partitaIva>&lt;/xsl:if>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codiceOloAgcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codiceOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_OLO&quot;>&lt;tns:codiceOloNumerico>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:codiceOloNumerico>&lt;/xsl:if>&lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&lt;tns:flagAccorpante>&lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&lt;/tns:flagAccorpante>&lt;/xsl:if>&lt;/tns:oao>&lt;tns:idContatto>&lt;xsl:value-of select=&quot;xsd:int(ID_CONTATTO)&quot;/>&lt;/tns:idContatto>&lt;xsl:if test=&quot;FLAG_PRIMARIO&quot;>&lt;tns:primary>&lt;xsl:value-of select=&quot;FLAG_PRIMARIO&quot;/>&lt;/tns:primary>&lt;/xsl:if>&lt;tns:nome>&lt;xsl:value-of select=&quot;NOME&quot;/>&lt;/tns:nome>&lt;tns:cognome>&lt;xsl:value-of select=&quot;COGNOME&quot;/>&lt;/tns:cognome>&lt;xsl:if test=&quot;TIPTITDESCR&quot;>&lt;tns:mr_Ms>&lt;xsl:value-of select=&quot;TIPTITDESCR&quot;/>&lt;/tns:mr_Ms>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPREF&quot;>&lt;tns:tipoReferente>&lt;xsl:value-of select=&quot;TIPREF&quot;/>&lt;/tns:tipoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRCAN&quot;>&lt;tns:metodoContatto>&lt;xsl:value-of select=&quot;DESCRCAN&quot;/>&lt;/tns:metodoContatto>&lt;/xsl:if>&lt;tns:operatore>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/tns:operatore>&lt;xsl:if test=&quot;TIMSTP_AGGTO&quot;>&lt;tns:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;TIMSTP_AGGTO&quot;/>&lt;/tns:dataUltimoAggiornamento>&lt;/xsl:if>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TIMSTP_INSMTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:contactListOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;xsl:if test=&quot;count($noRicercaJDBCQuery/Record)>=$MaxRows&quot;>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;LIMIT&amp;quot;&quot;/>&lt;/tns:code>&lt;/xsl:if>&lt;/tns:result>&lt;/tns:OLOContactsListOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
