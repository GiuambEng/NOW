                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1470065396641&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/Contatto/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:template name=&quot;ExportData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Element>&#xa;            &lt;tns2:xmlParam>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns2:xmlParam>&#xa;            &lt;tns2:listOfColumn>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;olo,ragioneSociale,partitaIva,codiceOloAgcom,codiceOloNumerico,flagAccorpante,primary,nome,cognome,tipoReferente,metodoContatto,dataUltimoAggiornamento,dataInserimento&amp;quot;&quot;/>&#xa;            &lt;/tns2:listOfColumn>&#xa;            &lt;tns2:rootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OLOContactsListOutput&amp;quot;&quot;/>&#xa;            &lt;/tns2:rootElement>&#xa;            &lt;tns2:nameOfFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ListaContatti&amp;quot;&quot;/>&#xa;            &lt;/tns2:nameOfFile>&#xa;            &lt;tns2:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns2:idFile>&#xa;            &lt;tns2:userId>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns1:userId&quot;/>&#xa;            &lt;/tns2:userId>&#xa;            &lt;tns2:tipoProfilo>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/tns2:tipoProfilo>&#xa;            &lt;tns2:childElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;contactListOutput&amp;quot;&quot;/>&#xa;            &lt;/tns2:childElement>&#xa;        &lt;/tns2:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    spawn="true"
