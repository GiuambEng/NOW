                        &lt;/tns:details&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:contactsReferencesOutput&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse2&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
