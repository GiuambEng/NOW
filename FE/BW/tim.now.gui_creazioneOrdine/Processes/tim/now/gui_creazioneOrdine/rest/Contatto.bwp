    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>get</variable>
                <variable>get2</variable>
                <variable>LoggerName</variable>
                <variable>post</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
                <variable>Profile</variable>
                <variable>MaxRows</variable>
                <variable>ListaContatti</variable>
            </endingVariables>
        </task>
        <task name="get_ListaContatti_InLog_INFO">
            <endingVariables>
                <variable>get_ListaContatti_InLog_INFO-input</variable>
