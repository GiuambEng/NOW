             &lt;xsl:otherwise>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;upper-case($post.item/tns:tipologiaAccensioneRicarica)&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:tipoLavorazione =('ACCENSIONE','SCHEDULAZIONE','PROLUNGAMENTO')&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOTIPOLOGIARICARICA&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:taglioRicaricaInGiorni&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:tipoLavorazione ='ACCENSIONE'&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DATAINIZIORICARICADTU&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;ends-with($post.item/tns:dataInizioRicarica, &amp;quot;+02&amp;quot;)&quot;>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;concat(xsd:string(tib:add-to-dateTime(xsd:dateTime(substring-before($post.item/tns:dataInizioRicarica, &amp;quot;+&amp;quot;)),0,0,0,0,xsd:int($RecuperoTRecovery/Record[1]/VALORE_NUMERICO),0)), &amp;quot;+00:00&amp;quot;)&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;concat(xsd:string(tib:add-to-dateTime(xsd:dateTime(substring-before($post.item/tns:dataInizioRicarica, &amp;quot;+&amp;quot;)),0,0,0,0,xsd:int($RecuperoTRecovery/Record[1]/VALORE_NUMERICO),0)), &amp;quot;+00:00&amp;quot;)&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:tipoLavorazione ='ANNULLAMENTO'&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOASSETRICARICA&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:idRicarica&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivo>&#xa;                &lt;/dettaglioordine>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;upper-case($post.item/tns:offerta)&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:idRisorsa&quot;>&#xa;                    &lt;IDRisorsaNOW>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:idRisorsa&quot;/>&#xa;                    &lt;/IDRisorsaNOW>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ordine>&#xa;            &lt;xsl:if test=&quot;exists($RecuperoIdContratto/Record/IDCONTRATTO)&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($RecuperoIdContratto/Record[1]/IDCONTRATTO)&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;upper-case($post.item/tns:offerta)&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:offerta = 'BITSTREAMGBEASIMMETRICOFLAT'&quot;>&#xa;                    &lt;IDOfferta>&#xa;                        &lt;xsl:value-of select=&quot;7&quot;/>&#xa;                    &lt;/IDOfferta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:offerta = 'VULAFTTCAB'&quot;>&#xa;                    &lt;IDOfferta>&#xa;                        &lt;xsl:value-of select=&quot;17&quot;/>&#xa;                    &lt;/IDOfferta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDOfferta>&#xa;                        &lt;xsl:value-of select=&quot;15&quot;/>&#xa;                    &lt;/IDOfferta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codificaOao&quot;>&#xa;                &lt;codificaOLOAGCOMRic>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codificaOao&quot;/>&#xa;                &lt;/codificaOLOAGCOMRic>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:tipoLavorazione = 'ACCENSIONE'&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA',$post.item/tns:taglioRicaricaInGiorni)&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:tipoLavorazione = 'PROLUNGAMENTO'&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROLUNGAMENTORICARICA&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:tipoLavorazione = 'SPEGNIMENTO'&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SPEGNIMENTORICARICA&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:tipoLavorazione = 'SCHEDULAZIONE'&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SCHEDULAZIONERICARICA&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTORICARICA&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="CasedataRicariche" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerInfo&quot;/>&lt;xsl:param name=&quot;OutputRicariche&quot;/>&lt;xsl:template name=&quot;post_NuovaRicarica_OutputLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NuovaRicarica&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.NuovaRicarica&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;OutputNuovaRicarica:&amp;quot;,tib:render-xml($OutputRicariche, true(),true()))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.NuovaRicarica&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventID>&lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns2:httpHeaders/GUI-SID,$post/httpHeaders/tns2:httpHeaders/GUI-TID)&quot;/>&lt;/tns:EventID>&lt;xsl:if test=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-TID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-TID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;NuovaRicarica_&amp;quot;,$post/httpHeaders/tns2:httpHeaders/GUI-SID,&amp;quot;COMPLETE&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;NuovaRicarica_&amp;quot;,$post/httpHeaders/tns2:httpHeaders/GUI-SID)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="post_NuovaRicarica_OutputLog-input"
                                    name="post_NuovaRicarica_OutputLog"
                                    tibex:xpdlId="67f9f6f8-683c-4f9c-a313-43711597dab1"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyTopost_NuovaRicarica_OutputLog"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessTopostOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;OutputRicariche&quot;/>&#xa;    &lt;xsl:template name=&quot;post_NuovaRicarica_OutputLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NuovaRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.NuovaRicarica&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputNuovaRicarica:&amp;quot;,tib:render-xml($OutputRicariche, true(),true()))&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.NuovaRicarica&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;NuovaRicarica_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;COMPLETE&amp;quot;)&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;NuovaRicarica_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_creazioneOrdine.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RenderXml-input"
                                    name="RenderXml"
                                    outputVariable="RenderXml"
                                    tibex:xpdlId="45377285-ce59-483d-b9f8-b3b2d05ef369" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CasedataRicaricheToRenderXml"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderXmlToJDBCQuery"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CasedataRicariche&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$CasedataRicariche&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.renderxml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="casedata:RichiestaElement"
                                    outputStyle="text"
                                    validateInput="true" xsi:type="palettexml:RenderXml">
                                    <cdata>{http://NOW.it.telecomitalia.it/casedata}RichiestaElement</cdata>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
