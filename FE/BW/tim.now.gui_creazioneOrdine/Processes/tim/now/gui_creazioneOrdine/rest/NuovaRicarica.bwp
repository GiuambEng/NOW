                                    tibex:xpdlId="4a20c231-8879-4c29-b1ae-317cb8568a00" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToTracciatoRicariche"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="TracciatoRicaricheToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRicarica&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoIdContratto&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciatoRicariche&quot; match=&quot;/&quot;>&#xa;        &lt;RichiestaOloRicarica>&#xa;            &lt;Richiesta>&#xa;                &lt;DatiRisorsa>&#xa;                    &lt;CodiceOloAgcom>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codificaOao&quot;/>&#xa;                    &lt;/CodiceOloAgcom>&#xa;                    &lt;IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:idRisorsa&quot;/>&#xa;                    &lt;/IdRisorsa>&#xa;                    &lt;IdAsset>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:idAsset&quot;/>&#xa;                    &lt;/IdAsset>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:codiceOrdineOao&quot;>&#xa;                        &lt;CodiceOrdineOloTarget>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdineOao&quot;/>&#xa;                        &lt;/CodiceOrdineOloTarget>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:codiceOrdineTI&quot;>&#xa;                        &lt;CodiceOrdineTITarget>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdineTI&quot;/>&#xa;                        &lt;/CodiceOrdineTITarget>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:noteDaOperatore&quot;>&#xa;                        &lt;Note>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:noteDaOperatore&quot;/>&#xa;                        &lt;/Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;IdContratto>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoIdContratto/Record[1]/IDCONTRATTO&quot;/>&#xa;                    &lt;/IdContratto>&#xa;                    &lt;CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdineOao&quot;/>&#xa;                    &lt;/CodiceOrdineOLO>&#xa;                &lt;/DatiRisorsa>&#xa;                &lt;TipoAzione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns:tipoLavorazione ='ACCENSIONE'&quot;>&#xa;                            &lt;Accensione>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$post.item/tns:offerta = 'BITSTREAMGBEASIMMETRICOFLAT'&quot;>&#xa;                                        &lt;BitstreamGBEAsimmetricoFlat>&#xa;                                            &lt;DataInizioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataInizioRicarica>&#xa;                                            &lt;DataFineRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataFineRicarica>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($post.item/tns:tipologiaAccensioneRicarica)&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:taglioRicaricaInGiorni&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/BitstreamGBEAsimmetricoFlat>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$post.item/tns:offerta = 'VULAFTTCAB'&quot;>&#xa;                                        &lt;VULAFTTCAB>&#xa;                                            &lt;DataInizioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataInizioRicarica>&#xa;                                            &lt;DataFineRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataFineRicarica>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($post.item/tns:tipologiaAccensioneRicarica)&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:taglioRicaricaInGiorni&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/VULAFTTCAB>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;BitstreamNGAFTTCAB>&#xa;                                            &lt;DataInizioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataInizioRicarica>&#xa;                                            &lt;DataFineRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataFineRicarica>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($post.item/tns:tipologiaAccensioneRicarica)&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:taglioRicaricaInGiorni&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/BitstreamNGAFTTCAB>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/Accensione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns:tipoLavorazione ='SPEGNIMENTO'&quot;>&#xa;                            &lt;Spegnimento>&#xa;                                &lt;IdRicarica>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:idRicarica&quot;/>&#xa;                                &lt;/IdRicarica>&#xa;                                &lt;DataFineRicarica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                &lt;/DataFineRicarica>&#xa;                            &lt;/Spegnimento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns:tipoLavorazione ='PROLUNGAMENTO'&quot;>&#xa;                            &lt;Prolungamento>&#xa;                                &lt;IdRicarica>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:idRicarica&quot;/>&#xa;                                &lt;/IdRicarica>&#xa;                                &lt;DataInizioRicarica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                &lt;/DataInizioRicarica>&#xa;                                &lt;DatiProlungamento>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$post.item/tns:offerta = 'BITSTREAMGBEASIMMETRICOFLAT'&quot;>&#xa;                                            &lt;TaglioRicaricaXDSL>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:taglioRicaricaInGiorni&quot;/>&#xa;                                            &lt;/TaglioRicaricaXDSL>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;TaglioRicaricaNGA_VULA>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:taglioRicaricaInGiorni&quot;/>&#xa;                                            &lt;/TaglioRicaricaNGA_VULA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/DatiProlungamento>&#xa;                                &lt;DataFineRicarica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                &lt;/DataFineRicarica>&#xa;                            &lt;/Prolungamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns:tipoLavorazione ='SCHEDULAZIONE'&quot;>&#xa;                            &lt;Schedulazione>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;upper-case($post.item/tns:offerta) = 'BITSTREAMGBEASIMMETRICOFLAT'&quot;>&#xa;                                        &lt;BitstreamGBEAsimmetricoFlat>&#xa;                                            &lt;DataInizioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataInizioRicarica>&#xa;                                            &lt;DataFineRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataFineRicarica>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($post.item/tns:tipologiaAccensioneRicarica)&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:taglioRicaricaInGiorni&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/BitstreamGBEAsimmetricoFlat>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;upper-case($post.item/tns:offerta) = 'BITSTREAMNGAFTTCAB'&quot;>&#xa;                                        &lt;BitstreamNGAFTTCAB>&#xa;                                            &lt;DataInizioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataInizioRicarica>&#xa;                                            &lt;DataFineRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataFineRicarica>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($post.item/tns:tipologiaAccensioneRicarica)&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:taglioRicaricaInGiorni&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/BitstreamNGAFTTCAB>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;VULAFTTCAB>&#xa;                                            &lt;DataInizioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataInizioRicarica>&#xa;                                            &lt;DataFineRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post.item/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/DataFineRicarica>&#xa;                                            &lt;TipologiaAccensioneRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($post.item/tns:tipologiaAccensioneRicarica)&quot;/>&#xa;                                            &lt;/TipologiaAccensioneRicarica>&#xa;                                            &lt;TaglioRicarica>&#xa;                                                &lt;xsl:value-of select=&quot;$post.item/tns:taglioRicaricaInGiorni&quot;/>&#xa;                                            &lt;/TaglioRicarica>&#xa;                                        &lt;/VULAFTTCAB>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/Schedulazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;Annullamento>&#xa;                                &lt;IdRicarica>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:idRicarica&quot;/>&#xa;                                &lt;/IdRicarica>&#xa;                            &lt;/Annullamento>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/TipoAzione>&#xa;            &lt;/Richiesta>&#xa;        &lt;/RichiestaOloRicarica>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
