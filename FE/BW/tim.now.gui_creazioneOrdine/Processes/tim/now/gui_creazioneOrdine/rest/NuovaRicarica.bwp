                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRicarica&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;RecuperoIdContratto&quot;/>&lt;xsl:template name=&quot;TracciatoRicariche&quot; match=&quot;/&quot;>&lt;RichiestaOloRicarica>&lt;Richiesta>&lt;DatiRisorsa>&lt;CodiceOloAgcom>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:codificaOao&quot;/>&lt;/CodiceOloAgcom>&lt;IdRisorsa>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:idRisorsa&quot;/>&lt;/IdRisorsa>&lt;IdAsset>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:idAsset&quot;/>&lt;/IdAsset>&lt;xsl:if test=&quot;$post/item/tns:NuovaRicarica/tns:codiceOrdineOao&quot;>&lt;CodiceOrdineOloTarget>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:codiceOrdineOao&quot;/>&lt;/CodiceOrdineOloTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:NuovaRicarica/tns:codiceOrdineTI&quot;>&lt;CodiceOrdineTITarget>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:codiceOrdineTI&quot;/>&lt;/CodiceOrdineTITarget>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:NuovaRicarica/tns:noteDaOperatore&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:noteDaOperatore&quot;/>&lt;/Note>&lt;/xsl:if>&lt;IdContratto>&lt;xsl:value-of select=&quot;$RecuperoIdContratto/Record[1]/IDCONTRATTO&quot;/>&lt;/IdContratto>&lt;CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:codiceOrdineOao&quot;/>&lt;/CodiceOrdineOLO>&lt;/DatiRisorsa>&lt;TipoAzione>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns:NuovaRicarica/tns:tipoLavorazione ='ACCENSIONE'&quot;>&lt;Accensione>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns:NuovaRicarica/tns:offerta = 'BITSTREAMGBEASIMMETRICOFLAT'&quot;>&lt;BitstreamGBEAsimmetricoFlat>&lt;DataInizioRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataInizioRicarica>&lt;DataFineRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataFineRicarica>&lt;TipologiaAccensioneRicarica>&lt;xsl:value-of select=&quot;upper-case($post/item/tns:NuovaRicarica/tns:tipologiaAccensioneRicarica)&quot;/>&lt;/TipologiaAccensioneRicarica>&lt;TaglioRicarica>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:taglioRicaricaInGiorni&quot;/>&lt;/TaglioRicarica>&lt;/BitstreamGBEAsimmetricoFlat>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns:NuovaRicarica/tns:offerta = 'VULAFTTCAB'&quot;>&lt;VULAFTTCAB>&lt;DataInizioRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataInizioRicarica>&lt;DataFineRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataFineRicarica>&lt;TipologiaAccensioneRicarica>&lt;xsl:value-of select=&quot;upper-case($post/item/tns:NuovaRicarica/tns:tipologiaAccensioneRicarica)&quot;/>&lt;/TipologiaAccensioneRicarica>&lt;TaglioRicarica>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:taglioRicaricaInGiorni&quot;/>&lt;/TaglioRicarica>&lt;/VULAFTTCAB>&lt;/xsl:when>&lt;xsl:otherwise>&lt;BitstreamNGAFTTCAB>&lt;DataInizioRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataInizioRicarica>&lt;DataFineRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataFineRicarica>&lt;TipologiaAccensioneRicarica>&lt;xsl:value-of select=&quot;upper-case($post/item/tns:NuovaRicarica/tns:tipologiaAccensioneRicarica)&quot;/>&lt;/TipologiaAccensioneRicarica>&lt;TaglioRicarica>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:taglioRicaricaInGiorni&quot;/>&lt;/TaglioRicarica>&lt;/BitstreamNGAFTTCAB>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Accensione>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns:NuovaRicarica/tns:tipoLavorazione ='SPEGNIMENTO'&quot;>&lt;Spegnimento>&lt;IdRicarica>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:idRicarica&quot;/>&lt;/IdRicarica>&lt;DataFineRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataFineRicarica>&lt;/Spegnimento>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns:NuovaRicarica/tns:tipoLavorazione ='PROLUNGAMENTO'&quot;>&lt;Prolungamento>&lt;IdRicarica>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:idRicarica&quot;/>&lt;/IdRicarica>&lt;DataInizioRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataInizioRicarica>&lt;DatiProlungamento>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns:NuovaRicarica/tns:offerta = 'BITSTREAMGBEASIMMETRICOFLAT'&quot;>&lt;TaglioRicaricaXDSL>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:taglioRicaricaInGiorni&quot;/>&lt;/TaglioRicaricaXDSL>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TaglioRicaricaNGA_VULA>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:taglioRicaricaInGiorni&quot;/>&lt;/TaglioRicaricaNGA_VULA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DatiProlungamento>&lt;DataFineRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataFineRicarica>&lt;/Prolungamento>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns:NuovaRicarica/tns:tipoLavorazione ='SCHEDULAZIONE'&quot;>&lt;Schedulazione>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRicarica/tns:offerta) = 'BITSTREAMGBEASIMMETRICOFLAT'&quot;>&lt;BitstreamGBEAsimmetricoFlat>&lt;DataInizioRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataInizioRicarica>&lt;DataFineRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataFineRicarica>&lt;TipologiaAccensioneRicarica>&lt;xsl:value-of select=&quot;upper-case($post/item/tns:NuovaRicarica/tns:tipologiaAccensioneRicarica)&quot;/>&lt;/TipologiaAccensioneRicarica>&lt;TaglioRicarica>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:taglioRicaricaInGiorni&quot;/>&lt;/TaglioRicarica>&lt;/BitstreamGBEAsimmetricoFlat>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRicarica/tns:offerta) = 'BITSTREAMNGAFTTCAB'&quot;>&lt;BitstreamNGAFTTCAB>&lt;DataInizioRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataInizioRicarica>&lt;DataFineRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataFineRicarica>&lt;TipologiaAccensioneRicarica>&lt;xsl:value-of select=&quot;upper-case($post/item/tns:NuovaRicarica/tns:tipologiaAccensioneRicarica)&quot;/>&lt;/TipologiaAccensioneRicarica>&lt;TaglioRicarica>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:taglioRicaricaInGiorni&quot;/>&lt;/TaglioRicarica>&lt;/BitstreamNGAFTTCAB>&lt;/xsl:when>&lt;xsl:otherwise>&lt;VULAFTTCAB>&lt;DataInizioRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataInizioRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataInizioRicarica>&lt;DataFineRicarica>&lt;xsl:value-of select=&quot;xsd:dateTime(substring-before($post/item/tns:NuovaRicarica/tns:dataFineRicarica, &amp;quot;+&amp;quot;))&quot;/>&lt;/DataFineRicarica>&lt;TipologiaAccensioneRicarica>&lt;xsl:value-of select=&quot;upper-case($post/item/tns:NuovaRicarica/tns:tipologiaAccensioneRicarica)&quot;/>&lt;/TipologiaAccensioneRicarica>&lt;TaglioRicarica>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:taglioRicaricaInGiorni&quot;/>&lt;/TaglioRicarica>&lt;/VULAFTTCAB>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Schedulazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Annullamento>&lt;IdRicarica>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRicarica/tns:idRicarica&quot;/>&lt;/IdRicarica>&lt;/Annullamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TipoAzione>&lt;/Richiesta>&lt;/RichiestaOloRicarica>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="TracciatoRicariche"
