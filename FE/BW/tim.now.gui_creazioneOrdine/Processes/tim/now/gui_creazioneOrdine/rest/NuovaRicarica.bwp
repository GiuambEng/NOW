                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RenderXml&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;ns0:createProcessInstanceInput>&lt;ns0:processQName>&lt;ns0:moduleName>&lt;xsl:value-of select=&quot;'/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaMainProject.xpdl'&quot;/>&lt;/ns0:moduleName>&lt;ns0:processName>&lt;xsl:value-of select=&quot;'TINOWAcquisizioneRichiestaMaster'&quot;/>&lt;/ns0:processName>&lt;/ns0:processQName>&lt;ns0:operationName>&lt;xsl:value-of select=&quot;'StartEventAcquisizioneRichiestaMaster'&quot;/>&lt;/ns0:operationName>&lt;ns0:options>&lt;ns0:priority>&lt;xsl:value-of select=&quot;310&quot;/>&lt;/ns0:priority>&lt;/ns0:options>&lt;ns0:parameterMap>&lt;ns0:parameter>&lt;ns0:name>&lt;xsl:value-of select=&quot;'localRequest'&quot;/>&lt;/ns0:name>&lt;ns0:value>&lt;xsl:value-of select=&quot;$RenderXml&quot;/>&lt;/ns0:value>&lt;/ns0:parameter>&lt;/ns0:parameterMap>&lt;/ns0:createProcessInstanceInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
