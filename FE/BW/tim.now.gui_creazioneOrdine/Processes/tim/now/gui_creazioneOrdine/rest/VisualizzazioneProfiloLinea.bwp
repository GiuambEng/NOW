        <wsdl:definitions
            targetNamespace="http://xmlns.example.com/20160628174631PLT"
            xmlns:extns="http://www.tim.com/NOW/rest/VisualizzazioneProfiloLinea"
            xmlns:extns1="http://tns.tibco.com/bw/REST"
            xmlns:extns2="http://xmlns.example.com/VisualizzazioneProfiloLinea/parameters"
