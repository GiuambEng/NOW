sl:value-of select=&quot;$get/parameters/tns1:visualizzazioneprofilolineaGetParameters/tns1:idOfferta&quot;/>&lt;/idOfferta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;protocollo>&lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, $get/parameters/tns1:visualizzazioneprofilolineaGetParameters/tns1:protocollo, &amp;quot;%&amp;quot;)&quot;/>&lt;/protocollo>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
