                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VisualizzazioneProfiloLinea&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VisualizzazioneProfiloLineaQuerySimm&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($VisualizzazioneProfiloLineaQuerySimm/Record)>0&quot;>&lt;tns:VisualizzazioneProfiloOutput>&lt;xsl:for-each select=&quot;$VisualizzazioneProfiloLineaQuerySimm/Record&quot;>&lt;tns:visualizzazioneProfiloOutput>&lt;xsl:if test=&quot;exists(ID_PRFL_TCNC_LN)&quot;>&lt;tns:idProfiloTecnicoLinea>&lt;xsl:value-of select=&quot;xsd:int(ID_PRFL_TCNC_LN)&quot;/>&lt;/tns:idProfiloTecnicoLinea>&lt;/xsl:if>&lt;tns:profiloTecnicoLinea>&lt;xsl:value-of select=&quot;PROFILO_TCNC_LINEA&quot;/>&lt;/tns:profiloTecnicoLinea>&lt;xsl:if test=&quot;exists(ID_OFFERTA)&quot;>&lt;tns:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&lt;/tns:idOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;tns:flagVendibilita>&lt;xsl:value-of select=&quot;FLAG_VENDIBILITA&quot;/>&lt;/tns:flagVendibilita>&lt;xsl:if test=&quot;exists(MAX_VC_X_CF)&quot;>&lt;tns:maxVCxCF>&lt;xsl:value-of select=&quot;xsd:int(MAX_VC_X_CF)&quot;/>&lt;/tns:maxVCxCF>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(PROFILO_COMMERCIALE_DOWN)&quot;>&lt;tns:profiloCommercialeDown>&lt;xsl:value-of select=&quot;xsd:int(PROFILO_COMMERCIALE_DOWN)&quot;/>&lt;/tns:profiloCommercialeDown>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(PROFILO_COMMERCIALE_UP)&quot;>&lt;tns:profiloCommercialeUp>&lt;xsl:value-of select=&quot;xsd:int(PROFILO_COMMERCIALE_UP)&quot;/>&lt;/tns:profiloCommercialeUp>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(VELOCITA_AGGANCIO_DOWN_MAX)&quot;>&lt;tns:velocitaAggancioDownMax>&lt;xsl:value-of select=&quot;xsd:int(VELOCITA_AGGANCIO_DOWN_MAX)&quot;/>&lt;/tns:velocitaAggancioDownMax>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(VELOCITA_AGGANCIO_DOWN_MIN)&quot;>&lt;tns:velocitaAggancioDownMin>&lt;xsl:value-of select=&quot;xsd:int(VELOCITA_AGGANCIO_DOWN_MIN)&quot;/>&lt;/tns:velocitaAggancioDownMin>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(VELOCITA_AGGANCIO_UP_MAX)&quot;>&lt;tns:velocitaAggancioUpMax>&lt;xsl:value-of select=&quot;xsd:int(VELOCITA_AGGANCIO_UP_MAX)&quot;/>&lt;/tns:velocitaAggancioUpMax>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(VELOCITA_AGGANCIO_UP_MIN)&quot;>&lt;tns:velocitaAggancioUpMin>&lt;xsl:value-of select=&quot;xsd:int(VELOCITA_AGGANCIO_UP_MIN)&quot;/>&lt;/tns:velocitaAggancioUpMin>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(BANDA_NETTA)&quot;>&lt;tns:bandaNetta>&lt;xsl:value-of select=&quot;xsd:int(BANDA_NETTA)&quot;/>&lt;/tns:bandaNetta>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_MODEM&quot;>&lt;tns:codiceModem>&lt;xsl:value-of select=&quot;COD_MODEM&quot;/>&lt;/tns:codiceModem>&lt;/xsl:if>&lt;xsl:if test=&quot;MODEM&quot;>&lt;tns:modem>&lt;xsl:value-of select=&quot;MODEM&quot;/>&lt;/tns:modem>&lt;/xsl:if>&lt;xsl:if test=&quot;MODELLO_ACCS&quot;>&lt;tns:modelloAccesso>&lt;xsl:value-of select=&quot;MODELLO_ACCS&quot;/>&lt;/tns:modelloAccesso>&lt;/xsl:if>&lt;xsl:if test=&quot;PROTOCOLLO&quot;>&lt;tns:protocollo>&lt;xsl:value-of select=&quot;PROTOCOLLO&quot;/>&lt;/tns:protocollo>&lt;/xsl:if>&lt;xsl:if test=&quot;TECNOLOGIA_OLO&quot;>&lt;tns:tecnologiaOlo>&lt;xsl:value-of select=&quot;TECNOLOGIA_OLO&quot;/>&lt;/tns:tecnologiaOlo>&lt;/xsl:if>&lt;tns:tipoModulazione>&lt;xsl:value-of select=&quot;TIPO_MODULAZIONE&quot;/>&lt;/tns:tipoModulazione>&lt;xsl:if test=&quot;exists(ID_PROFILO_BMD)&quot;>&lt;tns:idProfiloBMD>&lt;xsl:value-of select=&quot;xsd:int(ID_PROFILO_BMD)&quot;/>&lt;/tns:idProfiloBMD>&lt;/xsl:if>&lt;tns:flagOscurabile>&lt;xsl:value-of select=&quot;FLAG_OSCURABILE&quot;/>&lt;/tns:flagOscurabile>&lt;/tns:visualizzazioneProfiloOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:VisualizzazioneProfiloOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VisualizzazioneProfiloOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun profilo trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:VisualizzazioneProfiloOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
