                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;O.OFFERTA, P.BANDA_NETTA,P.COD_MODEM, P.FLAG_VENDIBILITA, P.ID_OFFERTA, P.ID_PROFILO_BMD, P.ID_PRFL_TCNC_LN, P.MAX_VC_X_CF, P.MODELLO_ACCS,&#xa;P.MODEM, P.PROFILO_COMMERCIALE_DOWN, P.PROFILO_COMMERCIALE_UP, P.PROFILO_TCNC_LINEA, P.PROTOCOLLO, P.TECNOLOGIA_OLO, P.TIPO_MODULAZIONE,&#xa;P.VELOCITA_AGGANCIO_DOWN_MAX, P.VELOCITA_AGGANCIO_DOWN_MIN, P.VELOCITA_AGGANCIO_UP_MAX, P.VELOCITA_AGGANCIO_UP_MIN, P.FLAG_OSCURABILE&#xa;FROM PROFILO_TCNC_LINEA P &#xa;LEFT JOIN OFFERTA O ON P.ID_OFFERTA = O.ID_OFFERTA&#xa;WHERE P.ID_OFFERTA = ?&#xa;AND (P.TIPO_MODULAZIONE = ?&#xa;OR P.TIPO_MODULAZIONE = 'All')&#xa;AND P.FLAG_VENDIBILITA = 'Y'&#xa;ORDER BY P.PROFILO_TCNC_LINEA" xsi:type="jdbcPalette:JDBCQueryActivity">

