                    <bpws:targets>
                        <bpws:target linkName="Empty4ToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToJDBCQuery11"/>
                    </bpws:sources>
