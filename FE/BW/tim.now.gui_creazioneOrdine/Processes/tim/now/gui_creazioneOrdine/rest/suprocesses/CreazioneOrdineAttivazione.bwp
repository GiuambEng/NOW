                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloData.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProgettoWL&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataBPM&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FIBERSTREAM&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;ordine>&#xa;                &lt;xsl:variable name=&quot;countApparato2&quot; select=&quot;count($Start/tns:datiServiziAggiuntivi/tns:apparati)&quot;/>&#xa;                &lt;xsl:variable name=&quot;countServzAgg2&quot; select=&quot;count($Start/tns:datiServiziAggiuntivi)&quot;/>&#xa;                &lt;offertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FIBERSTREAM&amp;quot;&quot;/>&#xa;                &lt;/offertaCatalogo>&#xa;                &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                    &lt;cognomeRagioneSociale>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                    &lt;/cognomeRagioneSociale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                    &lt;nome>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                    &lt;/nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                    &lt;CF>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                    &lt;/CF>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                    &lt;PIVA>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                    &lt;/PIVA>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                    &lt;codiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                    &lt;/codiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                &lt;/xsl:if>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;dettaglioordine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;IDDettaglioOrdineParent>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdineParent>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;nomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ACCESSOFIBERSTREAM&amp;quot;&quot;/>&#xa;                    &lt;/nomeComponente>&#xa;                    &lt;integrationID>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/integrationID>&#xa;                    &lt;attributiDettaglioOrdine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;nomeAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'PROFILOTECNICOLINEA'&quot;/>&#xa;                        &lt;/nomeAttributo>&#xa;                        &lt;valoreAttributo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                        &lt;/valoreAttributo>&#xa;                        &lt;tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaDato>&#xa;                    &lt;/attributiDettaglioOrdine>&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivo>&#xa;                &lt;/dettaglioordine>&#xa;                &lt;xsl:for-each select=&quot;$Start/tns:datiServiziAggiuntivi&quot;>&#xa;                    &lt;dettaglioordine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(position()+1)&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;IDDettaglioOrdineParent>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdineParent>&#xa;                        &lt;IDDettaglioOrdineRoot>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdineRoot>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;nomeComponente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SERVIZIOAGGIUNTIVO&amp;quot;&quot;/>&#xa;                        &lt;/nomeComponente>&#xa;                        &lt;integrationID>&#xa;                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                        &lt;/integrationID>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position()+1)&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NOMESERVIZIO&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;tns:nomeServizio&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position()+1)&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;INFORMAZIONISERVIZIO&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;tns:informazioniServizio&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position()+1)&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VINCOLOSERVIZIO&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;tns:vincoloServizio&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                        &lt;progressivo>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                        &lt;/progressivo>&#xa;                    &lt;/dettaglioordine>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:for-each select=&quot;$Start/tns:datiServiziAggiuntivi/tns:apparati&quot;>&#xa;                    &lt;dettaglioordine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(position()+1+$countServzAgg2)&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;IDDettaglioOrdineParent>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(xsd:int(tns:idServizioAggiuntivo)+1)&quot;/>&#xa;                        &lt;/IDDettaglioOrdineParent>&#xa;                        &lt;IDDettaglioOrdineRoot>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdineRoot>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;nomeComponente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;APPARATO&amp;quot;&quot;/>&#xa;                        &lt;/nomeComponente>&#xa;                        &lt;integrationID>&#xa;                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                        &lt;/integrationID>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position()+1+$countServzAgg2)&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;      