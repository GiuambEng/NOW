                           &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;($Start/tns:idOfferta = '1') and (string-length($Start/tns:datiSlaPlusSu/tns:flagSlaPlusSu)>0) and (($OscuramServOpz/Record[1]/FLAG_OSCURMENTO !='1') or (count($OscuramServOpz/Record)=0))&quot;>&#xa;                            &lt;dettaglioordine>&#xa;                                &lt;xsl:variable name=&quot;indexSlaPlusSu&quot; select=&quot;xsd:int(count($Start/tns:datiServiziOpzionali)+(if(string-length($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento)>0) then 1 else 0)+(if(string-length($Start/tns:datiPrestazioniAggiuntive/tns:flagPrestazioneAggiuntiva)>0) then 1 else 0)+2)&quot;/>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$indexSlaPlusSu&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                             