&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;tns:progressivoReferente&quot;>&lt;progressivoReferente>&lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&lt;/progressivoReferente>&lt;/xsl:if>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tipoReferenteOrdine>&lt;qualificaReferente>&lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&lt;/qualificaReferente>&lt;xsl:if test=&quot;tns:cognome&quot;>&lt;cognomeReferente>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/cognomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;nomeReferente>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/nomeReferente>&lt;/xsl:if>&lt;telefonoFissoReferente>&lt;xsl:value-of select=&quot;concat(tns:distrettoFisso, tns:numeroFisso)&quot;/>&lt;/telefonoFissoReferente>&lt;telefonoMobileReferente>&lt;xsl:value-of select=&quot;concat(tns:distrettoMobile, tns:numeroMobile)&quot;/>&lt;/telefonoMobileReferente>&lt;/referente>&lt;/xsl:for-each>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&lt;/tipologiaAccesso>&lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&lt;tipologiaQualita>&lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&lt;/tipologiaQualita>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;'FEEDER'&quot;/>&lt;/offerta>&lt;/ordine>&lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&lt;/IDContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&lt;ISTATComune>&lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&lt;/ISTATComune>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;FEEDER&amp;quot;&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;$Start/tns:dad&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&lt;/DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;IDFasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/IDFasciaOraria>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:when test=&quot;(tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0) or (tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1)&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloData/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dac&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:datiOfferteMulticast/tns:primoFeeder)>0&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;'FEEDERSUCCESSIVO'&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;'PRIMOFEEDER'&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/x