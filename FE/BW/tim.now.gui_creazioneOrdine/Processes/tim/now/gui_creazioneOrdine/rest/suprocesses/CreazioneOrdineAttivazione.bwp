xD;&amp;#xA; and tns:componente=$currComponent and tns:progressivo=$currPosition]/tns:valore&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;progressivo>&lt;xsl:value-of select=&quot;xsd:int($currPosition)&quot;/>&lt;/progressivo>&lt;/dettaglioordine>&lt;/xsl:for-each>&lt;sede>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDSede>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDSede>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&lt;particellaToponomastica>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&lt;/particellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;>&lt;via>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;/>&lt;/via>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&lt;civico>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&lt;/civico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;>&lt;comune>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;/>&lt;/comune>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&lt;CAP>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&lt;/CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&lt;complesso>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&lt;/complesso>&lt;/xsl:if>&lt;xsl:if tes