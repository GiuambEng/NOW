                               &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico LAN 8 Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaISDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:LineaNonFonia>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;ns2:ParticellaToponomastica>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                        &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;ns2:Via>&#xa;                                                            &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                        &lt;/ns2:Via>&#xa;                                                        &lt;ns2:Civico>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                        &lt;/ns2:Civico>&#xa;                                                        &lt;ns2:Localita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                        &lt;/ns2:Localita>&#xa;                                                        &lt;ns2:CodiceComune>&#xa;                                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                        &lt;/ns2:CodiceComune>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                                            &lt;ns2:CodiceIndirizzo>&#xa;                                                                &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                                            &lt;/ns2:CodiceIndirizzo>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico LAN 8 Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaNonFonia>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:Accesso>&#xa;                                    &lt;ns2:VC>&#xa;                                        &lt;ns2:VPI>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI']/tns:valore)&quot;/>&#xa;                                        &lt;/ns2:VPI>&#xa;                                        &lt;ns2:VCI>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI']/tns:valore)&quot;/>&#xa;                                        &lt;/ns2:VCI>&#xa;                                    &lt;/ns2:VC>&#xa;                                &lt;/ns2:EasyIPSpecialProfileLite>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns2:Attivazione>&#xa;                &lt;/ns2:TipoRichiesta>&#xa;            &lt;/ns2:Richiesta>&#xa;        &lt;/ns2:TracciatoOLOxDSL>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TracciatoOloXDSL" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="TracciatoOloNGA"
                    name="TracciatoOloNGA"
                    outputVariable="TracciatoOloNGA"
                    tibex:xpdlId="cea27b46-c71a-4e73-8e13-748916a950e5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToTracciatoOloNGA"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloNGAToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="TracciatoOloNGAToEmpty5">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns1:offertaCatalogo = 'VLANNGA' or $Start/ns1:offertaCatalogo = 'VLANVULA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns1:offertaCatalogo = 'VLANNGA' or $Start/ns1:offertaCatalogo = 'VLANVULA']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:param name=&quot;MapperUserVlanID&quot;/>&lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&lt;xsl:param name=&quot;OscuramentoIntermediateAgent&quot;/>&lt;xsl:param name=&quot;OscuramentoToken&quot;/>&lt;xsl:param name=&quot;OscuramServOpz&quot;/>&lt;xsl:template name=&quot;TracciatoOloNGA&quot; match=&quot;/&quot;>&lt;ns0:TracciatoOLONGA>&lt;ns0:Richiesta>&lt;ns0:Testata>&lt;ns0:CodiceOlo>&lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&lt;/ns0:CodiceOlo>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;ns0:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/ns0:CodiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;ns0:CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/ns0:CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;ns0:CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/ns0:CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;ns0:Note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/ns0:Note>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIEasyIPUBBFTTH'&quot;>&lt;ns0:semiEasyIPNGA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:semiEasyIPNGA>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIBitstreamNGAFTTH'&quot;>&lt;ns0:semiBitstreamNGA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:semiBitstreamNGA>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIVULAFTTH'&quot;>&lt;ns0:semiVULA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:semiVULA>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'FULLGPONPLUS' or $Start/tns:offertaCatalogo = 'FULLGPONPLUSNGA'&quot;>&lt;ns0:FullGPONPLUS>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:FullGPONPLUS>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:idReteSecondariaOao&quot;>&lt;ns0:IdReteSecondariaOAO>&lt;xsl:value-of select=&quot;$Start/tns:idReteSecondariaOao&quot;/>&lt;/ns0:IdReteSecondariaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&lt;ns0:ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&lt;/ns0:ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:offertaCatalogo = ('BitstreamNGAFTTH','VULAFTTH','SEMIVULAFTTH','EasyIPUBBFTTH')&quot;>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICEOPERATORESECONDARIO']/tns:valore&quot;>&lt;ns0:CodiceOperatoreSecondario>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICEOPERATORESECONDARIO']/tns:valore&quot;/>&lt;/ns0:CodiceOperatoreSecondario>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:clusterAccesso&quot;>&lt;ns0:ClusterAccesso>&lt;xsl:value-of select=&quot;$Start/tns:clusterAccesso&quot;/>&lt;/ns0:ClusterAccesso>&lt;/xsl:if>&lt;/ns0:Testata>&lt;ns0:TipoRichiesta>&lt;ns0:Attivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamNGAFTTCAB'&quot;>&lt;ns0:BitstreamNGAFTTCAB>&lt;ns0:Accesso>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&lt;ns0:LineaPOTS>&lt;ns0:DatiSede>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&lt;ns0:ParticellaToponomastica>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&lt;/ns0:ParticellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&lt;ns0:Codice_Via>&lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&lt;/ns0:Codice_Via>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&lt;ns0:Civico>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&lt;/ns0:Civico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&lt;ns0:Localita>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&lt;/ns0:Localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;>&lt;ns0:Provincia>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;/>&lt;/ns0:Provincia>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&lt;ns0:CAP>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&lt;/ns0:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&lt;ns0:Complesso>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&lt;/ns0:Complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&lt;ns0:Scala>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&lt;/ns0:Scala>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&lt;ns0:Piano>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&lt;/ns0:Piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&lt;ns0:Interno>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&lt;/ns0:Interno>&lt;/xsl:if>&lt;/ns0:DatiSede>&lt;ns0:ClienteFinale>&lt;ns0:CognomeRagSoc>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&lt;/ns0:CognomeRagSoc>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&lt;ns0:Nome>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&lt;/ns0:Nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&lt;ns0:CF>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&lt;/ns0:CF>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:PIVA>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&lt;/ns0:PIVA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:ClienteFinale>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&lt;ns0:SlaProvisioning>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:SlaProvisioning>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&lt;ns0:CodiceQualita>&lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&lt;/ns0:CodiceQualita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&lt;ns0:CodiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&lt;/ns0:CodiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&lt;ns0:DAD>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&lt;/ns0:DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;ns0:FasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/ns0:FasciaOraria>&lt;/xsl:if>&lt;ns0:NumeroLinea>&lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&lt;/ns0:NumeroLinea>&lt;ns0:ProfiloTecnicoLinea>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&lt;/ns0:ProfiloTecnicoLinea>&lt;ns0:Tecnologia>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TECNOLOGIA']/tns:valore&quot;/>&lt;/ns0:Tecnologia>&lt;ns0:UserVLAN_1_TAGGING>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'USERVLAN1TAGGING']/tns:valore&quot;/>&lt;/ns0:UserVLAN_1_TAGGING>&lt;ns0:Encapsulation>&lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'ENCAPSULATION']/tns:valore)&quot;/>&lt;/ns0:Encapsulation>&lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&lt;ns0:Referente>&lt;ns0:Progressivo>&lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&lt;/ns0:Progressivo>&lt;ns0:Qualifica>&lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&lt;/ns0:Qualifica>&lt;ns0:Nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/ns0:Nome>&lt;ns0:Cognome>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/ns0:Cognome>&lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&lt;ns0:Telefono>&lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&lt;/ns0:Telefono>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cellulare&quot;>&lt;ns0:Mobile>&lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&lt;/ns0:Mobile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:email&quot;>&lt;ns0:Email>&lt;xsl:value-of select=&quot;tns:email&quot;/>&lt;/ns0:Email>&lt;/xsl:if>&lt;/ns0:Referente>&lt;/xsl:for-each>&lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&lt;ns0:ReferenteOLOperProblematicheOn-field>&lt;ns0:CognomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&lt;/ns0:CognomeReferente>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&lt;ns0:NomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&lt;/ns0:NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&lt;ns0:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&lt;/ns0:TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&lt;ns0:TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&lt;/ns0:TelefonoMobileReferente>&lt;/xsl:if>&lt;/ns0:ReferenteOLOperProblematicheOn-field>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:qualifica = 'Y'&quot;>&lt;ns0:Qualifica>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:Qualifica>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:qualifica = 'N'&quot;>&lt;ns0:Qualifica>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/ns0:Qualifica>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:test2 = 'Y'&quot;>&lt;ns0:Test2>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:Test2>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:test2 = 'N'&quot;>&lt;ns0:Test2>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/ns0:Test2>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(not(exists($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO)) or ($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO !='1')) and (upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'INTERMEDIATEAGENTFULL']/tns:valore)='Y')&quot;>&lt;ns0:INTERMEDIATE_AGENT_FULL>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:INTERMEDIATE_AGENT_FULL>&lt;/xsl:when>&lt;xsl:when test=&quot;(not(exists($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO)) or ($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO !='1')) and (upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'INTERMEDIATEAGENTFULL']/tns:valore)='N')&quot;>&lt;ns0:INTERMEDIATE_AGENT_FULL>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/ns0:INTERMEDIATE_AGENT_FULL>&lt;/xsl:when>&lt;/xsl:choose>&lt;/ns0:LineaPOTS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:LineaNonFonia>&lt;ns0:DatiSede>&lt;ns0:ParticellaToponomastica>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&lt;/ns0:ParticellaToponomastica>&lt;ns0:Codice_Via>&lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&lt;/ns0:Codice_Via>&lt;ns0:Civico>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&lt;/ns0:Civico>&lt;ns0:Locali