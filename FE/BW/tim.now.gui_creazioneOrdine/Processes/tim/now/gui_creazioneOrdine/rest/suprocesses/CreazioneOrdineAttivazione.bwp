    &lt;xsl:value-of select=&quot;'PCRUP'&quot;/>&#xa;                        &lt;/tns9:key>&#xa;                        &lt;tns9:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns9:componente>&#xa;                        &lt;tns9:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns9:tipologiaDato>&#xa;                        &lt;xsl:if test=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/PCR_UP &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_UP)&quot;>&#xa;                            &lt;tns9:valore>&#xa;                                &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/PCR_UP &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_UP)&quot;/>&#xa;                            &lt;/tns9:valore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns9:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns9:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns9:sezioneInferiore>&#xa;                    &lt;tns9:sezioneInferiore>&#xa;                        &lt;tns9:key>&#xa;                            &lt;xsl:value-of select=&quot;'SCRDOWN'&quot;/>&#xa;                        &lt;/tns9:key>&#xa;                        &lt;tns9:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns9:componente>&#xa;                        &lt;tns9:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns9:tipologiaDato>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;starts-with(xsd:string($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN), '37')=true()&quot;>&#xa;                                &lt;tns9:valore>&#xa;                                    &lt;xsl:value-of select=&quot;'37,5'&quot;/>&#xa;                                &lt;/tns9:valore>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/SCR_DOWN &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN)&quot;>&#xa;                                    &lt;tns9:valore>&#xa;                                        &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/SCR_DOWN &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN)&quot;/>&#xa;                                    &lt;/tns9:valore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&q