                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns03=&quot;http://vp.telecomitalia.it/crm/vp/order&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciatoOLOVP&quot; match=&quot;/&quot;>&#xa;        &lt;ns03:TracciatoOLOVP>&#xa;            &lt;ns03:Richiesta>&#xa;                &lt;ns03:Testata>&#xa;                    &lt;ns03:CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns03:CodiceOlo>&#xa;                    &lt;ns03:CodiceOloAgcom>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                    &lt;/ns03:CodiceOloAgcom>&#xa;                    &lt;ns03:CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                    &lt;/ns03:CodiceOrdineOlo>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                        &lt;ns03:Note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                        &lt;/ns03:Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                        &lt;ns03:CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                        &lt;/ns03:CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns03:Testata>&#xa;                &lt;ns03:TipoRichiesta>&#xa;                    &lt;ns03:Attivazione>&#xa;                        &lt;xsl:if test=&quot;count($Start/tns:datiReferenti/tns:progressivoReferente)>0&quot;>&#xa;                            &lt;ns03:Referente>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferenti[1]/tns:distrettoFisso&quot;>&#xa;                                    &lt;ns03:DistrettoFisso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:distrettoFisso&quot;/>&#xa;                                    &lt;/ns03:DistrettoFisso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferenti[1]/tns:numeroFisso&quot;>&#xa;                                    &lt;ns03:NumeroFisso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:numeroFisso&quot;/>&#xa;                                    &lt;/ns03:NumeroFisso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferenti[1]/tns:distrettoMobile&quot;>&#xa;                                    &lt;ns03:DistrettoMobile>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:distrettoMobile&quot;/>&#xa;                                    &lt;/ns03:DistrettoMobile>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferenti[1]/tns:numeroMobile&quot;>&#xa;                                    &lt;ns03:NumeroMobile>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:numeroMobile&quot;/>&#xa;                                    &lt;/ns03:NumeroMobile>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferenti[1]/tns:qualifica&quot;>&#xa;                                    &lt;ns03:Qualifica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferenti[1]/tns:qualifica&quot;/>&#xa;                                    &lt;/ns03:Qualifica>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/ns03:Referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;ns03:CodiceTDKIT>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICETDKIT']/tns:valore&quot;/>&#xa;                        &lt;/ns03:CodiceTDKIT>&#xa;                        &lt;ns03:MCR>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BANDAMCR']/tns:valore&quot;/>&#xa;                        &lt;/ns03:MCR>&#xa;                        &lt;ns03:PCR>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BANDAPCR']/tns:valore&quot;/>&#xa;                        &lt;/ns03:PCR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOVLAN']/tns:valore = 'SINGLETAG'&quot;>&#xa;                                &lt;ns03:TipoVLAN>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/ns03:TipoVLAN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns03:TipoVLAN>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                &lt;/ns03:TipoVLAN>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ns03:CLLICentrale>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICECLLI']/tns:valore&quot;/>&#xa;                        &lt;/ns03:CLLICentrale>&#xa;                        &lt;ns03:CaratteristicaVP>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CARATTERISTICAVP']/tns:valore&quot;/>&#xa;                        &lt;/ns03:CaratteristicaVP>&#xa;                        &lt;ns03:VPI>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'VPI']/tns:valore&quot;/>&#xa;                        &lt;/ns03:VPI>&#xa;                    &lt;/ns03:Attivazione>&#xa;                &lt;/ns03:TipoRichiesta>&#xa;            &lt;/ns03:Richiesta>&#xa;        &lt;/ns03:TracciatoOLOVP>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TracciatoOLOVP" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns03=&quot;http://vp.telecomitalia.it/crm/vp/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloData&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOLOVP&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProgettoWL&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataBPM&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;ordine>&#xa;                &lt;offertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VP&amp;quot;&quot;/>&#xa;                &lt;/offertaCatalogo>&#xa;                &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                    &lt;DAD>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                    &lt;/DAD>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                    &lt;DNOLOCollaudo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                    &lt;/DNOLOCollaudo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                    &lt;numeroVerdeOloCollaudo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                    &lt;/numeroVerdeOloCollaudo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                    &lt;numeroVerdeOloPT>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                    &lt;/numeroVerdeOloPT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                    &lt;noteCliente>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                    &lt;/noteCliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOLOVP/ns03:Richiesta/ns03:TipoRichiesta/ns03:Attivazione/ns03:CLLICentrale)&quot;>&#xa;                    &lt;xsl:if test=&quot;$TracciatoOLOVP/ns03:Richiesta/ns03:TipoRichiesta/ns03:Attivazione/ns03:CLLICentrale&quot;>&#xa;                        &lt;CLLI>&#xa;                            &lt;xsl:value-of select=&quot;$TracciatoOLOVP/ns03:Richiesta/ns03:TipoRichiesta/ns03:Attivazione/ns03:CLLICentrale&quot;/>&#xa;                        &lt;/CLLI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                    &lt;codiceOrdineOLOPadre>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                    &lt;/codiceOrdineOLOPadre>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                &lt;/xsl:if>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;dettaglioordine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;nomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVP&amp;quot;&quot;/>&#xa;                    &lt;/nomeComponente>&#xa;                    &lt;integrationID>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                    &lt;/integrationID>&#xa;                    &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key !='TIPOVLAN']&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;attributiDettaglioOrdine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;nomeAttributo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;TIPOVLAN&amp;quot;&quot;/>&#xa;                        &lt;/nomeAttributo>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOVLAN']/tns:valore = 'SINGLETAG'&quot;>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaDato>&#xa;                    &lt;/attributiDettaglioOrdine>&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivo>&#xa;                &lt;/dettaglioordine>&#xa;                &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                    &lt;referente>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;tns:progressivoReferente&quot;>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;qualificaReferente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&#xa;                        &lt;/qualificaReferente>&#xa;                        &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                            &lt;cognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                            &lt;/cognomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;telefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;concat(tns:distrettoFisso, tns:numeroFisso)&quot;/>&#xa;                        &lt;/telefonoFissoReferente>&#xa;                        &lt;telefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;concat(tns:distrettoMobile, tns:numeroMobile)&quot;/>&#xa;                        &lt;/telefonoMobileReferente>&#xa;                    &lt;/referente>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;tipologiaAccesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                &lt;/tipologiaAccesso>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                    &lt;tipologiaQualita>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                    &lt;/tipologiaQualita>&#xa;                &lt;/xsl:if>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VP&amp;quot;&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/ordine>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                &lt;ISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                &lt;/ISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VP&amp;quot;&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                &lt;DAD>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                &lt;/DAD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                &lt;IDFasciaOraria>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                &lt;/IDFasciaOraria>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0) or (tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1)&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloData/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;($Start/tns:oao = 'ALB') and (string-length($Start/tns:codiceProgetto)>0) and contains($CodProgettoWL, $Start/tns:codiceProgetto)&quot;>&#xa;                &lt;ordineAssetWhiteList>&#xa;                    &lt;xsl:value-of select=&quot;'TIM EX BT'&quot;/>&#xa;                &lt;/ordineAssetWhiteList>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CasedataBPM" name="CasedataBPMVP"
                    outputVariable="CasedataBPM"
                    tibex:xpdlId="9f79e60e-0453-46d9-b15f-9dd8fddd0346" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TracciatoOloVPToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CasedataBPMVPToEmpty3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns03=&quot;http://vp.telecomitalia.it/crm/vp/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloData.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOLOVP&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProgettoWL&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataBPM&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;ordine>&#xa;                &lt;offertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VP&amp;quot;&quot;/>&#xa;                &lt;/offertaCatalogo>&#xa;                &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                    &lt;DAD>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                    &lt;/DAD>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                    &lt;DNOLOCollaudo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                    &lt;/DNOLOCollaudo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                    &lt;numeroVerdeOloCollaudo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                    &lt;/numeroVerdeOloCollaudo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                    &lt;numeroVerdeOloPT>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                    &lt;/numeroVerdeOloPT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                    &lt;noteCliente>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                    &lt;/noteCliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOLOVP/ns03:Richiesta/ns03:TipoRichiesta/ns03:Attivazione/ns03:CLLICentrale)&quot;>&#xa;                    &lt;xsl:if test=&quot;$TracciatoOLOVP/ns03:Richiesta/ns03:TipoRichiesta/ns03:Attivazione/ns03:CLLICentrale&quot;>&#xa;                        &lt;CLLI>&#xa;                            &lt;xsl:value-of select=&quot;$TracciatoOLOVP/ns03:Richiesta/ns03:TipoRichiesta/ns03:Attivazione/ns03:CLLICentrale&quot;/>&#xa;                        &lt;/CLLI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                    &lt;codiceOrdineOLOPadre>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                    &lt;/codiceOrdineOLOPadre>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                &lt;/xsl:if>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;dettaglioordine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;nomeComponente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVP&amp;quot;&quot;/>&#xa;                    &lt;/nomeComponente>&#xa;                    &lt;integrationID>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                    &lt;/integrationID>&#xa;                    &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key !='TIPOVLAN']&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;attributiDettaglioOrdine>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDDettaglioOrdine>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;nomeAttributo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;TIPOVLAN&amp;quot;&quot;/>&#xa;                        &lt;/nomeAttributo>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOVLAN']/tns:valore = 'SINGLETAG'&quot;>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaDato>&#xa;                    &lt;/attributiDettaglioOrdine>&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivo>&#xa;                &lt;/dettaglioordine>&#xa;                &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                    &lt;referente>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;tns:progressivoReferente&quot;>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;qualificaReferente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&#xa;                        &lt;/qualificaReferente>&#xa;                        &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                            &lt;cognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                            &lt;/cognomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;telefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;concat(tns:distrettoFisso, tns:numeroFisso)&quot;/>&#xa;                        &lt;/telefonoFissoReferente>&#xa;                        &lt;telefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;concat(tns:distrettoMobile, tns:numeroMobile)&quot;/>&#xa;                        &lt;/telefonoMobileReferente>&#xa;                    &lt;/referente>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;tipologiaAccesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                &lt;/tipologiaAccesso>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                    &lt;tipologiaQualita>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                    &lt;/tipologiaQualita>&#xa;                &lt;/xsl:if>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VP&amp;quot;&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/ordine>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                &lt;ISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                &lt;/ISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VP&amp;quot;&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                &lt;DAD>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                &lt;/DAD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                &lt;IDFasciaOraria>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                &lt;/IDFasciaOraria>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns1:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns1:outputDate) !=0) or (tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1)&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloData.parameters/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;($Start/tns:oao = 'ALB') and (string-length($Start/tns:codiceProgetto)>0) and contains($CodProgettoWL, $Start/tns:codiceProgetto)&quot;>&#xa;                &lt;ordineAssetWhiteList>&#xa;                    &lt;xsl:value-of select=&quot;'TIM EX BT'&quot;/>&#xa;                &lt;/ordineAssetWhiteList>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
