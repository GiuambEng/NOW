                                    &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                                        &lt;/integrationID>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;$indexDisagg&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;NOTESU&amp;quot;&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:datiDisaggregazione/tns:noteSu&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                        &lt;/progressivo>&#xa;                                    &lt;/dettaglioordine>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Variable/tns2:root&quot;>&#xa;                            &lt;dettaglioordine>&#xa;                                &lt;xsl:variable name=&quot;currPosition2&quot; select=&quot;current()/tns2:progressivo&quot;/>&#xa;                                &lt;xsl:variable name=&quot;currComponent2&quot; select=&quot;current()/tns2:componente&quot;/>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2)+1)&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;IDDettaglioOrdineParent>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDDettaglioOrdineParent>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                    &lt;IDRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/IDRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;upper-case($currComponent2)&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key !='BANDAPICCOUP' and tns:key !='FLAGMULTICAST' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2)+1)&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key ='BANDAPICCOUP' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2)+1)&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;BANDAPICCOUP&amp;quot;&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;contains(string($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]/tns:valore),'.')&quot;>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;concat(substring-before($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]/tns:valore, '.'), ',',substring-after($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]/tns:valore, '.'))&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP'&amp;#xD;&amp;#xA; and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]/tns:valore&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key ='FLAGMULTICAST' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2)+1)&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;FLAGMULTICAST&amp;quot;&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'FLAGMULTICAST' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]/tns:valore = 'Y'&quot;>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($currPosition2)&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:provincia)&quot;>&#xa;                            &lt;sede>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDSede>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDSede>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;/>&#xa;                                    &lt;/via>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                    &lt;/civico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;>&#xa;                                    &lt;comune>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;/>&#xa;                                    &lt;/comune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;>&#xa;                                    &lt;provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;/>&#xa;                                    &lt;/provincia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                    &lt;CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                    &lt;/CAP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                    &lt;complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                    &lt;/complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                    &lt;interno>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                    &lt;/interno>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                    &lt;scala>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                    &lt;/scala>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                    &lt;piano>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                    &lt;/piano>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                                    &lt;codiceISTATComune>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                    &lt;/codiceISTATComune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;exists($RecuperoDatiIstat/Record/COD_ISTAT_PROV)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_PROV&quot;>&#xa;                                        &lt;codiceISTATProvincia>&#xa;                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_PROV&quot;/>&#xa;                                        &lt;/codiceISTATProvincia>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                    &lt;codiceToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                    &lt;/codiceToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tipologiaSede>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SEDECLIENTE&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaSede>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                            &lt;/sede>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;../tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;tns:progressivoReferente&quot;>&#xa;                                    &lt;progressivoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                    &lt;/progressivoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;tns:qualifica&quot;>&#xa;                                    &lt;qualificaReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                    &lt;/qualificaReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'LineaNonFonia'&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                        &lt;emailReferente>&#xa;                                            &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                        &lt;/emailReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;N&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEONFIELD&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:refOaoProgettiSpeciali)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                                    &lt;refOAOProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                                    &lt;/refOAOProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                            &lt;tipologiaQualita>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                            &lt;/tipologiaQualita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTCAB&amp;quot;&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:offertaCatalogo = 'VULAFTTCAB' and $Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                                &lt;numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                &lt;/numeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaLinea>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore)&quot;/>&#xa;                        &lt;/tipologiaLinea>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:clusterAccesso&quot;>&#xa;                            &lt;clusterAccesso>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:clusterAccesso&quot;/>&#xa;                            &lt;/clusterAccesso>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ordine>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VLANNGA'&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VLANNGA&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento !=&amp;quot;OP&amp;quot;)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                                &lt;DAD>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                                &lt;/DAD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                            &lt;DNOLOCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                            &lt;/DNOLOCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                            &lt;numeroVerdeOloCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                            &lt;/numeroVerdeOloCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                            &lt;numeroVerdeOloPT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                            &lt;/numeroVerdeOloPT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                            &lt;noteCliente>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                            &lt;/noteCliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICECLLI']/tns:valore)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICECLLI']/tns:valore&quot;>&#xa;                                &lt;CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICECLLI']/tns:valore&quot;/>&#xa;                                &lt;/CLLI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                            &lt;codiceOrdineOLOPadre>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                            &lt;/codiceOrdineOLOPadre>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                            &lt;codiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                            &lt;/codiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;tipologiaLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLavorazione>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;dettaglioordine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANNGA&amp;quot;&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key!='TIPOVLAN' and tns:key!='FAMIGLIAVLAN' and tns:key!='SUPERMACROAREA' and tns:componente!='TIPOCOS']&quot;>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FAMIGLIAVLAN']/tns:valore) >0&quot;>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;FAMIGLIAVLAN&amp;quot;&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FAMIGLIAVLAN']/tns:valore = 'VLAN MonoCoS Banda Condivisa'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FAMIGLIAVLAN']/tns:valore = 'VLAN MultiCoS Banda Condivisa'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &l