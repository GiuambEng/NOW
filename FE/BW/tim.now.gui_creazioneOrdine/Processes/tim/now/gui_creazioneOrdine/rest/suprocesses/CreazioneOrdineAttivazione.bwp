hen test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:NumeroLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                    &lt;/ns2:NumeroLinea>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;ns2:Tecnologia>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TECNOLOGIA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:Tecnologia>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/tns:valore = 'Y'&quot;>&#xa;                                                            &lt;ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/tns:valore = 'N'&quot;>&#xa;                                                            &lt;ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                        &lt;/xsl:when>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns2:LineaISDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:LineaNonFonia>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;ns2:ParticellaToponomastica>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                        &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;ns2:Via>&#xa;                                                            &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                        &lt;/ns2:Via>&#xa;                                                        &lt;ns2:Civico>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                        &lt;/ns2:Civico>&#xa;                                                        &lt;ns2:Localita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                        &lt;/ns2:Localita>&#xa;                                                        &lt;ns2:CodiceComune>&#xa;                                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                        &lt;/ns2:CodiceComune>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                                            &lt;ns2:CodiceIndirizzo>&#xa;                                                                &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                                            &lt;/ns2:CodiceIndirizzo>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                        &lt;ns2:Modem>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                &lt;ns2:Interfaccia>&#xa;                                                                    &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                                &lt;/ns2:Interfaccia>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns2:Modem>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;ns2:Tecnologia>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TECNOLOGIA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:Tecnologia>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:opzioneDinamica !='N'&quot;>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:opzioneDinamica&quot;>&#xa;                                                            &lt;ns2:OPZIONEDINAMICA>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:opzioneDinamica&quot;/>&#xa;                                                            &lt;/ns2:OPZIONEDINAMICA>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/tns:valore = 'Y'&quot;>&#xa;                                                            &lt;ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/tns:valore = 'N'&quot;>&#xa;                                                            &lt;ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                        &lt;/xsl:when>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;string-length($Start/tns:qualifica)>0&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:qualifica = 'Y'&quot;>&#xa;                                                                &lt;ns2:Qualifica>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                &lt;/ns2:Qualifica>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:Qualifica>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                                                &lt;/ns2:Qualifica>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaNonFonia>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:Accesso>&#xa;                                    &lt;xsl:for-each select=&quot;$Variable/tns2:root&quot;>&#xa;                                        &lt;ns2:VC>&#xa;                                            &lt;xsl:variable name=&quot;conditionCompPos2&quot; select=&quot;&amp;quot;tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2&amp;quot;&quot;/>&#xa;                                            &lt;xsl:variable name=&quot;currComponent2&quot; select=&quot;current()/tns2:componente&quot;/>&#xa;                                            &lt;xsl:variable name=&quot;currProgressivo2&quot; select=&quot;current()/tns2:progressivo&quot;/>&#xa;                                            &lt;ns2:VPI>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                            &lt;/ns2:VPI>&#xa;                                            &lt;ns2:VCI>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                            &lt;/ns2:VCI>&#xa;                                            &lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore) = 0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;>&#xa;                                                    &lt;ns2:CodeVlanSingleTag>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:CodeVlanSingleTag>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;>&#xa;                                                &lt;ns2:SVlanCode>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                &lt;/ns2:SVlanCode>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore) and exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;>&#xa;                                                &lt;ns2:CVlanCode>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                &lt;/ns2:CVlanCode>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROTOCOLLOPILA'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore = 'IPoA'&quot;>&#xa;                                                &lt;ns2:ProtocolloPilaIPoA>&#xa;                                                    &lt;ns2:IP_DSLAM>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IPDSLAM' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:IP_DSLAM>&#xa;                                                    &lt;ns2:IP_KIT>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IPKIT' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:IP_KIT>&#xa;                                                &lt;/ns2:ProtocolloPilaIPoA>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;>&#xa;                                                &lt;ns2:Profilo_BMD>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                &lt;/ns2:Profilo_BMD>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROTOCOLLOPILA'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;>&#xa;                                                &lt;ns2:ProtocolloPila>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROTOCOLLOPILA'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                &lt;/ns2:ProtocolloPila>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns2:VC>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns2:BitstreamGBEAsimmetricoFlat>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '41'&quot;>&#xa;                                &lt;ns2:BitstreamGBESimmetricoFlat>&#xa;                                    &lt;ns2:Accesso>&#xa;                                        &lt;ns2:LineaNonFonia>&#xa;                                            &lt;ns2:DatiSede>&#xa;                                                &lt;ns2:ParticellaToponomastica>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                &lt;/ns2:ParticellaToponomastica>&#xa;                                                &lt;ns2:Via>&#xa;                                                    &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                &lt;/ns2:Via>&#xa;                                                &lt;ns2:Civico>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                &lt;/ns2:Civico>&#xa;                                                &lt;ns2:Localita>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                &lt;/ns2:Localita>&#xa;                                                &lt;ns2:CodiceComune>&#xa;                                                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                &lt;/ns2:CodiceComune>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                    &lt;ns2:Complesso>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                    &lt;/ns2:Complesso>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                    &lt;ns2:Scala>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                    &lt;/ns2:Scala>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                    &lt;ns2:Piano>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                    &lt;/ns2:Piano>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                    &lt;ns2:Interno>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                    &lt;/ns2:Interno>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                    &lt;ns2:CAP>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                    &lt;/ns2:CAP>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                                    &lt;ns2:CodiceIndirizzo>&#xa;                                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                                    &lt;/ns2:CodiceIndirizzo>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/ns2:DatiSede>&#xa;                                            &lt;ns2:ClienteFinale>&#xa;                                                &lt;ns2:CognomeRagSoc>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                &lt;/ns2:CognomeRagSoc>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                    &lt;ns2:Nome>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                    &lt;/ns2:Nome>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                        &lt;ns2:CF>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                        &lt;/ns2:CF>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns2:PIVA>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                        &lt;/ns2:PIVA>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/ns2:ClienteFinale>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                    &lt;ns2:Modem>&#xa;                                                        &lt;ns2:Interfaccia>&#xa;                                                            &lt;xsl:value-of select=&quot;9&quot;/>&#xa;                                                        &lt;/ns2:Interfaccia>&#xa;                                                        &lt;ns2:Codice>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:Codice>&#xa;                                                    &lt;/ns2:Modem>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:Modem>&#xa;                                                        &lt;ns2:Codice>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:Codice>&#xa;                                                    &lt;/ns2:Modem>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                &lt;ns2:SlaProvisioning>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                &lt;/ns2:SlaProvisioning>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                &lt;ns2:CodiceQualita>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                &lt;/ns2:CodiceQualita>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                &lt;ns2:CodiceDelivery>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                &lt;/ns2:CodiceDelivery>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                &lt;ns2:DAD>&#xa;                                                    &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                &lt;/ns2:DAD>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                &lt;ns2:FasciaOraria>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                &lt;/ns2:FasciaOraria>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                            &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($Start/tns:dataDisponibilitaSede)&quot;>&#xa;                                                    &lt;ns2:DataDisponibilitaSede>&#xa;                                                        &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dataDisponibilitaSede), 9, 2),'/',substring(xsd:string($Start/tns:dataDisponibilitaSede), 6, 2),'/',substring(xsd:string($Start/tns:dataDisponibilitaSede), 1, 4))&quot;/>&#xa;                                                    &lt;/ns2:DataDisponibilitaSede>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:DataDisponibilitaSede>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;99/99/9999&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:DataDisponibilitaSede>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                &lt;ns2:Referente>&#xa;                                                    &lt;ns2:Progressivo>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                    &lt;/ns2:Progressivo>&#xa;                                                    &lt;ns2:Qualifica>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                    &lt;/ns2:Qualifica>&#xa;                                                    &lt;ns2:Nome>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                    &lt;/ns2:Nome>&#xa;                                                    &lt;ns2:Cognome>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                    &lt;/ns2:Cognome>&#xa;                                                    &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                        &lt;ns2:Telefono>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                        &lt;/ns2:Telefono>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                        &lt;ns2:Mobile>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                        &lt;/ns2:Mobile>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                        &lt;ns2:Email>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                        &lt;/ns2:Email>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:Referente>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;ns2:CognomeReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                    &lt;/ns2:CognomeReferente>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                        &lt;ns2:NomeReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                        &lt;/ns2:NomeReferente>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                        &lt;ns2:TelefonoFissoReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                        &lt;/ns2:TelefonoFissoReferente>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                        &lt;ns2:TelefonoMobileReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                        &lt;/ns2:TelefonoMobileReferente>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns2:LineaNonFonia>&#xa;                                    &lt;/ns2:Accesso>&#xa;                                    &lt;xsl:for-each select=&quot;$Variable/tns2:root&quot;>&#xa;                                        &lt;ns2:UserVlan>&#xa;                                            &lt;xsl:variable name=&quot;currProgressivo2&quot; select=&quot;current()/tns2:progressivo&quot;/>&#xa;                                            &lt;xsl:variable name=&quot;currComponent2&quot; select=&quot;current()/tns2:componente&quot;/>&#xa;                                            &lt;ns2:UserVlan>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'USERVLAN' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                            &lt;/ns2:UserVlan>&#xa;                                            &lt;ns2:SVlanCode>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                            &lt;/ns2:SVlanCode>&#xa;                                            &lt;ns2:CVlanCode>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                            &lt;/ns2:CVlanCode>&#xa;                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;>&#xa;                                                &lt;ns2:Profilo_BMD>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                &lt;/ns2:Profilo_BMD>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROTOCOLLOPILA'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;>&#xa;                                                &lt;ns2:ProtocolloPila>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROTOCOLLOPILA'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                &lt;/ns2:ProtocolloPila>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns2:UserVlan>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns2:BitstreamGBESimmetricoFlat>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '11'&quot;>&#xa;                                &lt;ns2:EasyIPBasePlusFlat>&#xa;                                    &lt;ns2:Accesso>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&#xa;                                                &lt;ns2:LineaPOTS>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                            &lt;ns2:ParticellaToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                            &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                            &lt;ns2:Via>&#xa;                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                            &lt;/ns2:Via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                            &lt;ns2:Civico>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                            &lt;/ns2:Civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                            &lt;ns2:Localita>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                            &lt;/ns2:Localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:NumeroLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                    &lt;/ns2:NumeroLinea>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico L2TP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICEPRODOTTOSPLITTER']/tns:valore = 'Y'&quot;>&#xa;                                                            &lt;ns2:Splitter>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Splitter>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Splitter>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Splitter>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaPOTS>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'ISDN'&quot;>&#xa;                                                &lt;ns2:LineaISDN>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                            &lt;ns2:ParticellaToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                            &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                            &lt;ns2:Via>&#xa;                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                            &lt;/ns2:Via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                            &lt;ns2:Civico>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                            &lt;/ns2:Civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                            &lt;ns2:Localita>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                            &lt;/ns2:Localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:NumeroLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                    &lt;/ns2:NumeroLinea>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico L2TP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaISDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:LineaNonFonia>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;ns2:ParticellaToponomastica>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                        &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;ns2:Via>&#xa;                                                            &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                        &lt;/ns2:Via>&#xa;                                                        &lt;ns2:Civico>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                        &lt;/ns2:Civico>&#xa;                                                        &lt;ns2:Localita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                        &lt;/ns2:Localita>&#xa;                                                        &lt;ns2:CodiceComune>&#xa;                                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                        &lt;/ns2:CodiceComune>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                                            &lt;ns2:CodiceIndirizzo>&#xa;                                                                &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                                            &lt;/ns2:CodiceIndirizzo>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico L2TP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;      