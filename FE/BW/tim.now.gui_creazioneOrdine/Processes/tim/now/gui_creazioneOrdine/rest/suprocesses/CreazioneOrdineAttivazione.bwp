                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloFWAToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;OscCodiceProgettoFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciatoOloFWA&quot; match=&quot;/&quot;>&#xa;        &lt;ns02:TracciatoOLOFWA>&#xa;            &lt;ns02:Richiesta>&#xa;                &lt;ns02:Testata>&#xa;                    &lt;ns02:CodiceOloAgcom>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                    &lt;/ns02:CodiceOloAgcom>&#xa;                    &lt;ns02:CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                    &lt;/ns02:CodiceOrdineOlo>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                        &lt;ns02:Note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                        &lt;/ns02:Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;($OscCodiceProgettoFWA/Record[1]/FLAG_OSCURMENTO = '0') or (count($OscCodiceProgettoFWA/Record)=0)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                            &lt;ns02:CodiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                            &lt;/ns02:CodiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns02:Testata>&#xa;                &lt;ns02:TipoRichiesta>&#xa;                    &lt;ns02:Attivazione>&#xa;                        &lt;ns02:FixedWirelessAccess>&#xa;                            &lt;ns02:DatiSede>&#xa;                                &lt;ns02:ParticellaToponomastica>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                &lt;/ns02:ParticellaToponomastica>&#xa;                                &lt;ns02:Via>&#xa;                                    &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                &lt;/ns02:Via>&#xa;                                &lt;ns02:Civico>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                &lt;/ns02:Civico>&#xa;                                &lt;ns02:Localita>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                &lt;/ns02:Localita>&#xa;                                &lt;ns02:CodiceComune>&#xa;                                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                &lt;/ns02:CodiceComune>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                    &lt;ns02:CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                    &lt;/ns02:CAP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                    &lt;ns02:Complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                    &lt;/ns02:Complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                    &lt;ns02:Scala>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                    &lt;/ns02:Scala>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                    &lt;ns02:Piano>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                    &lt;/ns02:Piano>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                    &lt;ns02:Interno>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                    &lt;/ns02:Interno>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                    &lt;ns02:CodiceIndirizzo>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                    &lt;/ns02:CodiceIndirizzo>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/ns02:DatiSede>&#xa;                            &lt;ns02:ClienteFinale>&#xa;                                &lt;ns02:CognomeRagSoc>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                &lt;/ns02:CognomeRagSoc>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                    &lt;ns02:Nome>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                    &lt;/ns02:Nome>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                        &lt;ns02:CF>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                        &lt;/ns02:CF>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns02:PIVA>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                        &lt;/ns02:PIVA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ns02:ClienteFinale>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                &lt;ns02:Referente>&#xa;                                    &lt;ns02:Progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                    &lt;/ns02:Progressivo>&#xa;                                    &lt;ns02:Qualifica>&#xa;                                        &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                    &lt;/ns02:Qualifica>&#xa;                                    &lt;ns02:Nome>&#xa;                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                    &lt;/ns02:Nome>&#xa;                                    &lt;ns02:Cognome>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                    &lt;/ns02:Cognome>&#xa;                                    &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                        &lt;ns02:Telefono>&#xa;                                            &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                        &lt;/ns02:Telefono>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                        &lt;ns02:Mobile>&#xa;                                            &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                        &lt;/ns02:Mobile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ns02:Referente>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;ns02:TipologiaCPE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLOGIACPE']/tns:valore&quot;/>&#xa;                            &lt;/ns02:TipologiaCPE>&#xa;                            &lt;ns02:FlagIntervento>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key ='FLAGINTERVENTO']/tns:valore&quot;/>&#xa;                            &lt;/ns02:FlagIntervento>&#xa;                            &lt;ns02:Profilo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key ='PROFILO']/tns:valore&quot;/>&#xa;                            &lt;/ns02:Profilo>&#xa;                            &lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key ='RISORSASWITCHOFF']/tns:valore)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key ='RISORSASWITCHOFF']/tns:valore&quot;>&#xa;                                    &lt;ns02:RisorsaSwitchOff>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key ='RISORSASWITCHOFF']/tns:valore&quot;/>&#xa;                                    &lt;/ns02:RisorsaSwitchOff>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns02:FixedWirelessAccess>&#xa;                    &lt;/ns02:Attivazione>&#xa;                &lt;/ns02:TipoRichiesta>&#xa;            &lt;/ns02:Richiesta>&#xa;        &lt;/ns02:TracciatoOLOFWA>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
