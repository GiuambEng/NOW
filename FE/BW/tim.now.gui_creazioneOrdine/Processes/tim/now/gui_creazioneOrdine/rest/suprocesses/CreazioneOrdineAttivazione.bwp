erta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) > 0&quot;>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition)+3)&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;($Start/tns:flagModem = 'Y' or ($Start/tns:flagModem = 'N' and $Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore = (&amp;quot;L5&amp;quot;,&amp;quot;L7&amp;quot;))) and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) = 0&quot;>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition)+2)&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;not($Start/tns:flagModem = 'Y' or ($Start/tns:flagModem = 'N' and $Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore = (&amp;quot;L5&amp;quot;,&amp;quot;L7&amp;quot;))) and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) > 0&quot;>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition)+2)&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition)+1)&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;tns9:key&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;tns9:valore&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tns9:tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($c