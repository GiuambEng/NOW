            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperoDatiIstatEOLO-input"
                    name="RecuperoDatiIstatEOLO"
                    outputVariable="RecuperoDatiIstatEOLO"
                    tibex:xpdlId="38b86b33-e920-4482-bb84-9c51e91c3b52" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToTracciatoOloFWAEOLO_FWAEOLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToTracciatoOloFWAEOLO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+38b86b33-e920-4482-bb84-9c51e91c3b52+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RecuperoDatiIstatEOLO-input&quot; match=&quot;/&quot;>&lt;tns6:jdbcQueryActivityInput>&lt;provincia>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:provincia)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/provincia>&lt;comune>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:comune)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/comune>&lt;via>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/via>&lt;numCivico>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:civico)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/numCivico>&lt;/tns6:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT P.CODISTATPROV, C.CODISTATCOMUNE, N.COD_TOPON&#xd;&#xa;FROM PROVINCIA_EOLO P, COMUNEO_LOCALITA_EOLO C, VIA_EOLO V , NUMERO_CIVICO_EOLO N&#xd;&#xa;WHERE P.CODISTATPROV = C.CODISTATPROV &#xd;&#xa;AND C.CODISTATCOMUNE = V.COD_ISTAT_COMUNE &#xd;&#xa;AND V.COD_STRADA = N.COD_STRADA &#xd;&#xa;AND upper(TRIM(P.DESCR_PROV)) = upper(?) &#xd;&#xa;AND upper(TRIM(C.DESCR_COMUNE))=upper(?) &#xd;&#xa;AND upper(TRIM(V.DESCR_VIA))=upper(?)&#xd;&#xa;AND upper(TRIM(N.NUMERO_CIVICO)) = upper(?)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="provincia"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="comune"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="via"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numCivico"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CODISTATPROV"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="CODISTATCOMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="COD_TOPON"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CreazioneOrdineGPON-input"
                    name="CreazioneOrdineGPON"
                    outputVariable="CreazioneOrdineGPON"
                    tibex:xpdlId="4bb12847-b8bb-4edb-a5bc-27d6d46e93d9"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToCreazioneOrdineGPON"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CreazioneOrdineGPONToIdArmadio"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
