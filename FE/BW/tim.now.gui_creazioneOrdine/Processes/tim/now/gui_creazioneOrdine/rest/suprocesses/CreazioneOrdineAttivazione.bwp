        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key ='BANDAPICCOUP' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition3)+1)&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;BANDAPICCOUP&amp;quot;&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;contains(string($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore),'.')&quot;>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;concat(substring-before($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore, '.'), ',',substring-after($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore, '.'))&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP'&amp;#xD;&amp;#xA; and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key ='FLAGMULTICAST' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition3)+1)&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;FLAGMULTICAST&amp;quot;&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'FLAGMULTICAST' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore ='Y'&quot;>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($currPosition3)&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:provincia)&quot;>&#xa;                            &lt;sede>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDSede>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDSede>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;/>&#xa;                                    &lt;/via>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                    &lt;/civico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;>&#xa;                                    &lt;comune>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;/>&#xa;                                    &lt;/comune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;>&#xa;                                    &lt;provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;/>&#xa;                                    &lt;/provincia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                    &lt;CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                    &lt;/CAP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                    &lt;complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                    &lt;/complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                    &lt;interno>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                    &lt;/interno>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                    &lt;scala>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                    &lt;/scala>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                    &lt;piano>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                    &lt;/piano>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                                    &lt;codiceISTATComune>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                    &lt;/codiceISTATComune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;exists($RecuperoDatiIstat/Record/COD_ISTAT_PROV)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_PROV&quot;>&#xa;                                        &lt;codiceISTATProvincia>&#xa;                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_PROV&quot;/>&#xa;                                        &lt;/codiceISTATProvincia>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                    &lt;codiceToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                    &lt;/codiceToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tipologiaSede>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SEDECLIENTE&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaSede>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                            &lt;/sede>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;../tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;tns:progressivoReferente&quot;>&#xa;                                    &lt;progressivoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                    &lt;/progressivoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;tns:qualifica&quot;>&#xa;                                    &lt;qualificaReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                    &lt;/qualificaReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'LineaNonFonia'&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                        &lt;emailReferente>&#xa;                                            &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                        &lt;/emailReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;N&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEONFIELD&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:refOaoProgettiSpeciali)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                                    &lt;refOAOProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                                    &lt;/refOAOProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($TracciatoOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:VULAFTTH/ns0:Accesso/ns0:LineaNonFonia/ns0:TOKEN) and (string-length($TracciatoOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:VULAFTTH/ns0:Accesso/ns0:LineaNonFonia/ns0:TOKEN)>0) and ($OscuramentoToken/Record[1]/COUNT =0)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;progressivoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/progressivoReferente>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;qualificaReferente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&#xa;                                &lt;/qualificaReferente>&#xa;                                &lt;telefonoFissoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;'3333333333'&quot;/>&#xa;                                &lt;/telefonoFissoReferente>&#xa;                                &lt;telefonoMobileReferente>&#xa;                                    &lt;xsl:value-of select=&quot;'3333333333'&quot;/>&#xa;                                &lt;/telefonoMobileReferente>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                            &lt;tipologiaQualita>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                            &lt;/tipologiaQualita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VULAFTTH'&quot;>&#xa;                                &lt;offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTH&amp;quot;&quot;/>&#xa;                                &lt;/offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'FULLGPONPLUS'&quot;>&#xa;                                &lt;offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUS&amp;quot;&quot;/>&#xa;                                &lt;/offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SEMIVULAFTTH&amp;quot;&quot;/>&#xa;                                &lt;/offerta>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns:numeroLinea)&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                                    &lt;numeroTelefonico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                    &lt;/numeroTelefonico>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tipologiaLinea>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore)&quot;/>&#xa;                        &lt;/tipologiaLinea>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns:codOperatoreSecondario)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:codOperatoreSecondario&quot;>&#xa;                                &lt;codOperatoreSecondario>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:codOperatoreSecondario&quot;/>&#xa;                                &lt;/codOperatoreSecondario>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:offertaCatalogo = 'VULAFTTH' or $Start/tns:offertaCatalogo = 'SEMIVULAFTTH'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:clusterAccesso&quot;>&#xa;                                &lt;clusterAccesso>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:clusterAccesso&quot;/>&#xa;                                &lt;/clusterAccesso>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ordine>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                &lt;ISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                &lt;/ISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                &lt;localita>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                &lt;/localita>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamNGAFTTCAB'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIBitstreamNGAFTTH'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'EasyIPUBBFTTCAB'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'EasyIPUBBFTTH'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIEasyIPUBBFTTH'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamNGAFTTH'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VULAFTTCAB'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTCAB&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIVULAFTTH'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SEMIVULAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VLANVULA'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VLANVULA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VLANNGA'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VLANNGA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'FULLGPONPLUS'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUS&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'FULLGPONPLUSNGA'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUSNGA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'LineaNonFonia'&quot;>&#xa;                    &lt;flagNaked>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                    &lt;/flagNaked>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;flagNaked>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/flagNaked>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento !=&amp;quot;OP&amp;quot;)&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                    &lt;DAD>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                    &lt;/DAD>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento !=&amp;quot;OP&amp;quot;)&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                    &lt;IDFasciaOraria>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                    &lt;/IDFasciaOraria>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns1:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns1:outputDate) !=0) or (tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1)&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloData.parameters/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore) and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore)>0&quot;>&#xa;                    &lt;disaggregato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/disaggregato>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(string-length($Start/tns:datiDisaggregazione/tns:systemUnico)>0) and (count($FlagFittizioCodProg/Record/FLAG_FITTIZIO)=0)&quot;>&#xa;                    &lt;disaggregato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                    &lt;/disaggregato>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;(string-length(xsd:string($RecuperoRendezVous/Record[1]/ID_OFFERTA)) >0) and (string-length($RecuperoRendezVous/Record[1]/CODFC_OLO_AGCOM) >0) and ($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'LineaNonFonia') and ((not(exists($Start/tns:token))) and (string-length($Start/tns:token)&amp;lt;=0))&quot;>&#xa;                &lt;rendezVous>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/rendezVous>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore) and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore)>0 and $RecuperaOscuramIdRisOLD/Record[1]/FLAG_OSCURMENTO !='1'&quot;>&#xa;                &lt;cambioTecnologia>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/cambioTecnologia>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;($Start/tns:oao = 'ALB') and (string-length($Start/tns:codiceProgetto)>0) and contains($CodProgettoWL, $Start/tns:codiceProgetto)&quot;>&#xa;                &lt;ordineAssetWhiteList>&#xa;                    &lt;xsl:value-of select=&quot;'TIM EX BT'&quot;/>&#xa;                &lt;/ordineAssetWhiteList>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($Start/tns:codOperatoreSecondario)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codOperatoreSecondario&quot;>&#xa;                    &lt;codOperatoreSecondario>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codOperatoreSecondario&quot;/>&#xa;                    &lt;/codOperatoreSecondario>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="CasedataBPM" xsi:type="generalactivities:BWAssign"/>
                                </properties>
