                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns1:attributiOfferta/ns1:sezioneInferiore[ns1:key = 'IDPROFILOVC'])[number($index)]]]></bpws:from>
