                                                 &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                            &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                            &lt;ns2:Via>&#xa;                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                            &lt;/ns2:Via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                            &lt;ns2:Civico>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                            &lt;/ns2:Civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                            &lt;ns2:Localita>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                            &lt;/ns2:Localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:NumeroLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                    &lt;/ns2:NumeroLinea>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico LAN 8 Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICEPRODOTTOSPLITTER']/tns:valore = 'Y'&quot;>&#xa;                                                            &lt;ns2:Splitter>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Splitter>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Splitter>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Splitter>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaPOTS>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'ISDN'&quot;>&#xa;                                                &lt;ns2:LineaISDN>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                            &lt;ns2:ParticellaToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                            &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                            &lt;ns2:Via>&#xa;                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                            &lt;/ns2:Via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                            &lt;ns2:Civico>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                            &lt;/ns2:Civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                            &lt;ns2:Localita>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                            &lt;/ns2:Localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:NumeroLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                    &lt;/ns2:NumeroLinea>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico LAN 8 Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaISDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:LineaNonFonia>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;ns2:ParticellaToponomastica>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                        &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;ns2:Via>&#xa;                                                            &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                        &lt;/ns2:Via>&#xa;                                                        &lt;ns2:Civico>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                        &lt;/ns2:Civico>&#xa;                                                        &lt;ns2:Localita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                        &lt;/ns2:Localita>&#xa;                                                        &lt;ns2:CodiceComune>&#xa;                                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                        &lt;/ns2:CodiceComune>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                                            &lt;ns2:CodiceIndirizzo>&#xa;                                                                &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                                            &lt;/ns2:CodiceIndirizzo>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico LAN 8 Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaNonFonia>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:Accesso>&#xa;                                    &lt;ns2:VC>&#xa;                                        &lt;ns2:VPI>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI']/tns:valore)&quot;/>&#xa;                                        &lt;/ns2:VPI>&#xa;                                        &lt;ns2:VCI>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI']/tns:valore)&quot;/>&#xa;                                        &lt;/ns2:VCI>&#xa;                                    &lt;/ns2:VC>&#xa;                                &lt;/ns2:EasyIPSpecialProfileFlat>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '63'&quot;>&#xa;                                &lt;ns2:VLAN>&#xa;                                    &lt;ns2:CodiceTDKIT>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICETDKIT']/tns:valore&quot;/>&#xa;                                    &lt;/ns2:CodiceTDKIT>&#xa;                                    &lt;ns2:CLLICentrale>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICECLLI']/tns:valore&quot;/>&#xa;                                    &lt;/ns2:CLLICentrale>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOVLAN']/tns:valore = 'SINGLETAG'&quot;>&#xa;                                            &lt;ns2:TipoVLAN>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/ns2:TipoVLAN>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns2:TipoVLAN>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/ns2:TipoVLAN>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FAMIGLIAVLAN']/tns:valore = 'VLAN MonoCoS Banda Condivisa'&quot;>&#xa;                                            &lt;ns2:FamigliaVLAN>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/ns2:FamigliaVLAN>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FAMIGLIAVLAN']/tns:valore = 'VLAN MultiCoS Banda Condivisa'&quot;>&#xa;                                            &lt;ns2:FamigliaVLAN>&#xa;                                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                            &lt;/ns2:FamigliaVLAN>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns2:FamigliaVLAN>&#xa;                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                            &lt;/ns2:FamigliaVLAN>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FAMIGLIAVLAN']/tns:valore = &amp;quot;VLAN MonoCoS Banda Condivisa&amp;quot;&quot;>&#xa;                                        &lt;ns2:TipoCoS>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IDENTIFICATIVOCOS']/tns:valore = 'VLAN MonoCoS Banda Condivisa CoS 0'&quot;>&#xa;                                                    &lt;ns2:CoS>&#xa;                                                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                    &lt;/ns2:CoS>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IDENTIFICATIVOCOS']/tns:valore = 'VLAN MonoCoS Banda Condivisa CoS 1'&quot;>&#xa;                                                    &lt;ns2:CoS>&#xa;                                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                    &lt;/ns2:CoS>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IDENTIFICATIVOCOS']/tns:valore = 'VLAN MonoCoS Banda Condivisa CoS 3'&quot;>&#xa;                                                    &lt;ns2:CoS>&#xa;                                                        &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                    &lt;/ns2:CoS>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:CoS>&#xa;                                                        &lt;xsl:value-of select=&quot;5&quot;/>&#xa;                                                    &lt;/ns2:CoS>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDA']/tns:valore)>0&quot;>&#xa;                                                &lt;ns2:Banda>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDA']/tns:valore)&quot;/>&#xa;                                                &lt;/ns2:Banda>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns2:TipoCoS>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDENTIFICATIVOCAR']/tns:valore)>0&quot;>&#xa;                                        &lt;ns2:CAR>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDENTIFICATIVOCAR']/tns:valore)&quot;/>&#xa;                                        &lt;/ns2:CAR>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOBMC']/tns:valore)>0&quot;>&#xa;                                        &lt;ns2:Profilo>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOBMC']/tns:valore)&quot;/>&#xa;                                        &lt;/ns2:Profilo>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns2:IDVLANOLO>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDENTIFICATIVOVLANOLO']/tns:valore)&quot;/>&#xa;                                    &lt;/ns2:IDVLANOLO>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SUPERMACROAREA']/tns:valore = 'Consegna su CAR di MAdR reale'&quot;>&#xa;                                            &lt;ns2:SuperMacroarea>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                            &lt;/ns2:SuperMacroarea>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SUPERMACROAREA']/tns:valore = &amp;quot;Consegna su CAR di MAdR 'SUPERMACROAREA'&amp;quot;&quot;>&#xa;                                            &lt;ns2:SuperMacroarea>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/ns2:SuperMacroarea>&#xa;                                        &lt;/xsl:when>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/ns2:VLAN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns2:EasyIPSpecialProfileLite>&#xa;                                    &lt;ns2:Accesso>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&#xa;                                                &lt;ns2:LineaPOTS>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                            &lt;ns2:ParticellaToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                            &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                            &lt;ns2:Via>&#xa;                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                            &lt;/ns2:Via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                            &lt;ns2:Civico>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                            &lt;/ns2:Civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                            &lt;ns2:Localita>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                            &lt;/ns2:Localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:NumeroLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                    &lt;/ns2:NumeroLinea>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico LAN 8 Virtual Dial UP'&quot;>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:ModalitaConsegna>&#xa;                                                                &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                                                            &lt;/ns2:ModalitaConsegna>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>