            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&lt;xsl:param name=&quot;RecuperoRendezVous&quot;/>&lt;xsl:param name=&quot;calcoloDRO&quot;/>&lt;xsl:param name=&quot;RecuperaOscuramIdRisOLD&quot;/>&lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&lt;xsl:param name=&quot;CalcoloData&quot;/>&lt;xsl:param name=&quot;OscuramServOpz&quot;/>&lt;xsl:param name=&quot;IdArmadio&quot;/>&lt;xsl:param name=&quot;ADD5DAI&quot;/>&lt;xsl:param name=&quot;ADD5DRO&quot;/>&lt;xsl:param name=&quot;CodProgettoWL&quot;/>&lt;xsl:param name=&quot;CreazioneOrdineGPON&quot;/>&lt;xsl:template name=&quot;CasedataBPM&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;'abc'&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/note>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'UBBSEMIGPON'&quot;>&lt;ordine>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;UBBSEMIGPON&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;xsl:if test=&quot;$Start/tns:dac&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dac&amp;lt;$ADD5DRO/parameters/tns1:Response/tns1:outputDate&quot;>&lt;DACRimodul