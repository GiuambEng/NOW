                      &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONEUSO&amp;quot;&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivo>&#xa;                        &lt;/dettaglioordine>&#xa;                        &lt;xsl:if test=&quot;($Start/tns:idOfferta = '3') and (count($Start/tns:datiServiziOpzionali/tns:codiceServizio)>0) and (($OscuramServOpz/Record[1]/FLAG_OSCURMENTO !='1') or (count($OscuramServOpz/Record)=0))&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns:datiServiziOpzionali&quot;>&#xa;                                &lt;dettaglioordine>&#xa; 