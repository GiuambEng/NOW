            </bpws:extensionActivity>
            <bpws:empty name="Empty1" tibex:xpdlId="12deceb1-b9f9-44c5-b210-56e5da4239cb">
                <bpws:targets>
                    <bpws:target linkName="MapperAttVCToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToAssign_Regolatorio">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($Start/ns1:offertaCatalogo) =('ULL','ULLDATI','SLU','VULL','SHA','WLR','CPS')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($Start/ns1:offertaCatalogo) =('ULL','ULLDATI','SLU','VULL','SHA','WLR','CPS')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToAssign2_NoOfferte">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToAssign_XSDL">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:offertaCatalogo=('BitstreamATMAsimmetricoFlat', 'BitstreamATMSimmetricoFlat','BitstreamATMAsimmetricoHL', 'BitstreamATMSimmetricoHL','BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite','VLAN')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:offertaCatalogo=('BitstreamATMAsimmetricoFlat', 'BitstreamATMSimmetricoFlat','BitstreamATMAsimmetricoHL', 'BitstreamATMSimmetricoHL','BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite','VLAN')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToMapper_NGA-VULA">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:offertaCatalogo =('BitstreamNGAFTTCAB','BitstreamNGAFTTH','VULAFTTCAB','VULAFTTH','EasyIPUBBFTTCAB','EasyIPUBBFTTH','VLANNGA','VLANVULA','SEMIBitstreamNGAFTTH','SEMIVULAFTTH','SEMIEasyIPUBBFTTH','FULLGPONPLUSNGA','FULLGPONPLUS')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns1:offertaCatalogo =('BitstreamNGAFTTCAB','BitstreamNGAFTTH','VULAFTTCAB','VULAFTTH','EasyIPUBBFTTCAB','EasyIPUBBFTTH','VLANNGA','VLANVULA','SEMIBitstreamNGAFTTH','SEMIVULAFTTH','SEMIEasyIPUBBFTTH','FULLGPONPLUSNGA','FULLGPONPLUS')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToTracciatoOloFWA">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:offertaCatalogo ='FixedWirelessAccess'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:offertaCatalogo ='FixedWirelessAccess']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToAssign_VP">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:offertaCatalogo ='VP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:offertaCatalogo ='VP']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToCreazioneOrdineGPON">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:offertaCatalogo =('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns1:offertaCatalogo =('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToAssign_Feeder">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:offertaCatalogo ='FEEDER'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:offertaCatalogo ='FEEDER']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToTracciatoOloFiberstream1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:offertaCatalogo ='FIBERSTREAM'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns1:offertaCatalogo ='FIBERSTREAM']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToTracciatoOloFWAEOLO_FWAEOLO">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:offertaCatalogo ='FWAITALIA1GIGASARDEGNA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns1:offertaCatalogo ='FWAITALIA1GIGASARDEGNA']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TracciatoOloRegolatorio"
                    name="TracciatoOloRegolatorio"
                    outputVariable="TracciatoOloRegolatorio"
                    tibex:xpdlId="c807a987-bf67-46b0-994a-9c68e4aa9f2d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToAssign_Regolatorio"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloRegolatorioToCasedataBPMRegolatorio"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoDestinazioneUsoFonia&quot;/>&lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&lt;xsl:param name=&quot;RecuperoDestinazioneUsoDati&quot;/>&lt;xsl:param name=&quot;OscuramServOpz&quot;/>&lt;xsl:template name=&quot;TracciatoOloRegolatorio&quot; match=&quot;/&quot;>&lt;RichiestaOloRegolatorio>&lt;Richiesta>&lt;Testata>&lt;CodiceOlo>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/CodiceOlo>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/CodiceOrdineOlo>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/Note>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&lt;ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&lt;/ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;/Testata>&lt;Ordine>&lt;Attivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '1'&quot;>&lt;ULLLineaNonAttiva>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/DESCR = &amp;quot;FONIA&amp;quot; and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)=0&quot;>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;/DestinazioneUso>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)=0 and $RecuperoDestinazioneUsoDati/Record[1]/DESCR = &amp;quot;DATI&amp;quot;&quot;>&lt;DestinazioneUso>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&lt;/BitRate>&lt;/dati>&lt;/DestinazioneUso>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)>0 and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)>0 and $Start/tns:oao = 'TLC'&quot;>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&lt;/BitRate>&lt;/dati>&lt;/DestinazioneUso>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&lt;/BitRate>&lt;/dati>&lt;/DestinazioneUso>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:dac)&quot;>&lt;DataDAC>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dac), 9, 2),'/',substring(xsd:string($Start/tns:dac), 6, 2),'/',substring(xsd:string($Start/tns:dac), 1, 4))&quot;/>&lt;/DataDAC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DataDAC>&lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&lt;/DataDAC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DatiCliente>&lt;CognomeRagSoc>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&lt;/CognomeRagSoc>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&lt;Nome>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&lt;/Nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&lt;/CF>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DatiCliente>&lt;Sede>&lt;ParticellaToponomastica>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&lt;/ParticellaToponomastica>&lt;Via>&lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&lt;/Via>&lt;Civico>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&lt;/Civico>&lt;Localita>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&lt;/Localita>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&lt;CAP>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&lt;/CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&lt;Complesso>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&lt;/Complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&lt;Scala>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&lt;/Scala>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&lt;Piano>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&lt;/Piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&lt;Interno>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&lt;/Interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&lt;CodiceIndirizzo>&lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&lt;/CodiceIndirizzo>&lt;/xsl:if>&lt;CodiceComune>&lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&lt;/CodiceComune>&lt;/Sede>&lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&lt;Referente>&lt;Progressivo>&lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&lt;/Progressivo>&lt;QualificaRef>&lt;xsl:value-of select=&quot;upper-case(tns:qualifica)&quot;/>&lt;/QualificaRef>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cellulare&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:email&quot;>&lt;EmailReferente>&lt;xsl:value-of select=&quot;tns:email&quot;/>&lt;/EmailReferente>&lt;/xsl:if>&lt;/Ref