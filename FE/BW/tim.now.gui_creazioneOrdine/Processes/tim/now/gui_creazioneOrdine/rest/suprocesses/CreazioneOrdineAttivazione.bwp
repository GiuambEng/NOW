lect=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/flag_Token>&lt;/referente>&lt;/xsl:if>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&lt;/tipologiaAccesso>&lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&lt;tipologiaQualita>&lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&lt;/tipologiaQualita>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VULAFTTH'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;VULAFTTH&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'FULLGPONPLUS'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUS&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;SEMIVULAFTTH&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&lt;codiceSLAAssurance>&lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&lt;/codiceSLAAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&lt;codiceSLAAssurance>&lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&lt;/codiceSLAAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&lt;codiceSLAAssurance>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/codiceSLAAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&lt;codiceSLAAssurance>&lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&lt;/codiceSLAAssurance>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codiceSLAAssurance>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/codiceSLAAssurance>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:numeroLinea)&quot;>&lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;tipologiaLinea>&lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore)&quot;/>&lt;/tipologiaLinea>&lt;xsl:if test=&quot;string-length($Start/tns:codOperatoreSecondario)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:codOperatoreSecondario&quot;>&lt;codOperatoreSecondario>&lt;xsl:value-of select=&quot;$Start/tns:codOperatoreSecondario&quot;/>&lt;/codOperatoreSecondario>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:offertaCatalogo = 'VULAFTTH' or $Start/tns:offertaCatalogo = 'SEMIVULAFTTH'&quot;>&lt;xsl:if test=&quot;$Start/tns:clusterAccesso&quot;>&lt;clusterAccesso>&lt;xsl:value-of select=&quot;$Start/tns:clusterAccesso&quot;/>&lt;/clusterAccesso>&lt;/xsl:if>&lt;/xsl:if>&lt;/ordine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&lt;/IDContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&lt;ISTATComune>&lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&lt;/ISTATComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamNGAFTTCAB'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIBitstreamNGAFTTH'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'EasyIPUBBFTTCAB'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'EasyIPUBBFTTH'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIEasyIPUBBFTTH'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamNGAFTTH'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VULAFTTCAB'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;VULAFTTCAB&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIVULAFTTH'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;SEMIVULAFTTH&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VLANVULA'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;VLANVULA&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VLANNGA'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;VLANNGA&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'FULLGPONPLUS'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUS&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'FULLGPONPLUSNGA'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUSNGA&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;VULAFTTH&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'LineaNonFonia'&quot;>&lt;flagNaked>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/flagNaked>&lt;/xsl:when>&lt;xsl:otherwise>&lt;flagNaked>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/flagNaked>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento !=&amp;quot;OP&amp;quot;)&quot;>&lt;xsl:if test=&quot;$Start/tns:dad&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&lt;/DAD>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento !=&amp;quot;OP&amp;quot;)&quot;>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;IDFasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/IDFasciaOraria>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:when test=&quot;(tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0) or (tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1)&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloData/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dac&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore) and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore)>0&quot;>&lt;disaggregato>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/disaggregato>&lt;/xsl:when>&lt;xsl:when test=&quot;(string-length($Start/tns:datiDisaggregazione/tns:systemUnico)>0) and (count($FlagFittizioCodProg/Record/FLAG_FITTIZIO)=0)&quot;>&lt;disaggregato>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/disaggregato>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;(string-length(xsd:string($RecuperoRendezVous/Record[1]/ID_OFFERTA)) >0) and (string-length($RecuperoRendezVous/Record[1]/CODFC_OLO_AGCOM) >0) and ($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'LineaNonFonia') and ((not(exists($Start/tns:token))) and (string-length($Start/tns:token)&amp;lt;=0))&quot;>&lt;rendezVous>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/rendezVous>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore) and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore)>0 and $RecuperaOscuramIdRisOLD/Record[1]/FLAG_OSCURMENTO !='1'&quot;>&lt;cambioTecnologia>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/cambioTecnologia>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/tns:oao = 'ALB') and (string-length($Start/tns:codiceProgetto)>0) and contains($CodProgettoWL, $Start/tns:codiceProgetto)&quot;>&lt;ordineAssetWhiteList>&lt;xsl:value-of select=&quot;'TIM EX BT'&quot;/>&lt;/ordineAssetWhiteList>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns:codOperatoreSecondario)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:codOperatoreSecondario&quot;>&lt;codOperatoreSecondario>&lt;xsl:value-of select=&quot;$Start/tns:codOperatoreSecondario&quot;/>&lt;/codOperatoreSecondario>&lt;/xsl:if>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
