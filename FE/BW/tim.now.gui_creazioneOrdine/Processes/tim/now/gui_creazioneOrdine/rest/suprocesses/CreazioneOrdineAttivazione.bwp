                      &lt;/attributiDettaglioOrdine>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Variable/tns2:root&quot;>&#xa;                            &lt;dettaglioordine>&#xa;                                &lt;xsl:variable name=&quot;currPosition&quot; select=&quot;current()/tns2:progressivo&quot;/>&#xa;                                &lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns2:componente&quot;/>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y' and (string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'SPLITTER']/tns:valore) > 0 or string-length($TracciatoOloXDSL/ns2:Richiesta[1]/ns2:TipoRichiesta/ns2:Attivazione/ns2:BitstreamATMAsimmetricoFlat/ns2:Accesso/ns2:LineaPOTS/ns2:Splitter) >0)&quot;>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition)+3)&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y' and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'SPLITTER']/tns:valore) = 0 and string-length($TracciatoOloXDSL/ns2:Richiesta[1]/ns2:TipoRichiesta/ns2:Attivazione/ns2:BitstreamATMAsimmetricoFlat/ns2:Accesso/ns2