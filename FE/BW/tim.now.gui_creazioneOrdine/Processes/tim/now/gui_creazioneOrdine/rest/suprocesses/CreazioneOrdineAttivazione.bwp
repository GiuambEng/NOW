            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TracciatoOloXDSL"
                    name="TracciatoOloXdsl"
                    outputVariable="TracciatoOloXDSL"
                    tibex:xpdlId="a7e63964-67ea-41c2-95d9-3b8b04ca6a6e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToAssign_XSDL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloXDSLToEmpty2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperAttVC&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciatoOloXDSL&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:TracciatoOLOxDSL>&#xa;            &lt;ns2:Richiesta>&#xa;                &lt;ns2:Testata>&#xa;                    &lt;ns2:CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns2:CodiceOlo>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                        &lt;ns2:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                        &lt;/ns2:CodiceOrdineOlo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                        &lt;ns2:CodiceOrdineOloPadre>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                        &lt;/ns2:CodiceOrdineOloPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                        &lt;ns2:CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                        &lt;/ns2:CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                        &lt;ns2:Note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                        &lt;/ns2:Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                        &lt;ns2:ReferentiOAOProgettiSpeciali>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                        &lt;/ns2:ReferentiOAOProgettiSpeciali>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns2:Testata>&#xa;                &lt;ns2:TipoRichiesta>&#xa;                    &lt;ns2:Attivazione>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '8'&quot;>&#xa;                                &lt;ns2:BitstreamATMAsimmetricoFlat>&#xa;                                    &lt;ns2:Accesso>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&#xa;                                                &lt;ns2:LineaPOTS>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                            &lt;ns2:ParticellaToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                            &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                            &lt;ns2:Via>&#xa;                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                            &lt;/ns2:Via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                            &lt;ns2:Civico>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                            &lt;/ns2:Civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                            &lt;ns2:Localita>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                            &lt;/ns2:Localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                        &lt;ns2:Modem>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns2:Modem>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quo