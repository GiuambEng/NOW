                    <bpws:source linkName="Empty4ToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:offertaCatalogo = 'VLAN'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:offertaCatalogo = 'VLAN']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty4ToCasedataBPMATM-GBE">
                        <tibex:DesignExpression>
