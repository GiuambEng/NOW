if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&lt;Interno>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&lt;/Interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&lt;CodiceIndirizzo>&lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&lt;/CodiceIndirizzo>&lt;/xsl:if>&lt;/DatiSede>&lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&lt;Referente>&lt;Progressivo>&lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&lt;/Progressivo>&lt;QualificaRef>&lt;xsl:value-of select=&quot;upper-case(tns:qualifica)&quot;/>&lt;/QualificaRef>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cellulare&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:email&quot;>&lt;EmailReferente>&lt;xsl:value-of select=&quot;tns:email&quot;/>&lt;/EmailReferente>&lt;/xsl:if>&lt;/Referente>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:clirPermanente = 'Y'&quot;>&lt;ClirPermanente>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/ClirPermanente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ClirPermanente>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ClirPermanente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FLAGMANTENIMENTOSTS']/tns:valore = 'Y'&quot;>&lt;FlagMantenimentoSTS>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/FlagMantenimentoSTS>&lt;/xsl:when