if test=&quot;tns:cognome&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'LineaNonFonia'&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                        &lt;emailReferente>&#xa;                                            &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                        &lt;/emailReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;N&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEONFIELD&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:refOaoProgettiSpeciali)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                                    &lt;refOAOProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                                    &lt;/refOAOProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                            &lt;tipologiaQualita>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                            &lt;/tipologiaQualita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILELITE&amp;quot;&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;codiceSLAAssurance>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                        &lt;/codiceSLAAssurance>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:offertaCatalogo = 'EasyIPSpecialProfileLite' and $Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = ('POTS','ISDN')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                                &lt;numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                &lt;/numeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaLinea>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore)&quot;/>&#xa;                        &lt;/tipologiaLinea>&#xa;                    &lt;/ordine>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                &lt;ISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                &lt;/ISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                &lt;localita>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                &lt;/localita>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'EasyIPBasePlusFlat'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSFLAT&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'EasyIPBasePlusLite'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSLITE&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'EasyIPSpecialProfileFlat'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILEFLAT&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILELITE&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'LineaNonFonia'&quot;>&#xa;                    &lt;flagNaked>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                    &lt;/flagNaked>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;flagNaked>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/flagNaked>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                &lt;DAD>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                &lt;/DAD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                &lt;IDFasciaOraria>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                &lt;/IDFasciaOraria>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0) or (tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1)&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloData/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore) and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore)>0&quot;>&#xa;                &lt;disaggregato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                &lt;/disaggregato>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length(xsd:string($RecuperoRendezVous/Record[1]/ID_OFFERTA)) >0 and string-length($RecuperoRendezVous/Record[1]/CODFC_OLO_AGCOM) >0 and $Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'LineaNonFonia'&quot;>&#xa;                &lt;rendezVous>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/rendezVous>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore) and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore)>0 and $RecuperaOscuramIdRisOLD/Record[1]/FLAG_OSCURMENTO !='1'&quot;>&#xa;                &lt;cambioTecnologia>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/cambioTecnologia>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;($Start/tns:oao = 'ALB') and (string-length($Start/tns:codiceProgetto)>0) and contains($CodProgettoWL, $Start/tns:codiceProgetto)&quot;>&#xa;                &lt;ordineAssetWhiteList>&#xa;                    &lt;xsl:value-of select=&quot;'TIM EX BT'&quot;/>&#xa;                &lt;/ordineAssetWhiteList>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CasedataBPM" name="CasedataBPMEasyIP"
                    outputVariable="CasedataBPM"
                    tibex:xpdlId="fd6057df-2bf0-437f-b6ac-bb73505af7f5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToAssign_EasyIP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CasedataBPMEasyIPToEmpty3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloData.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoRendezVous&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaOscuramIdRisOLD&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProgettoWL&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataBPM&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'EasyIPBasePlusFlat'&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSFLAT&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                            &lt;DAD>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                            &lt;/DAD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cogno