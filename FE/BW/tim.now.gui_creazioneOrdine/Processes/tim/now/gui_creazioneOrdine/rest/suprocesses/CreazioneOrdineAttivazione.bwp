:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                        &lt;ns2:Modem>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns2:Modem>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:NumeroLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                    &lt;/ns2:NumeroLinea>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaISDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:LineaNonFonia>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;ns2:ParticellaToponomastica>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                        &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;ns2:Via>&#xa;                                                            &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                        &lt;/ns2:Via>&#xa;                                                        &lt;ns2:Civico>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                        &lt;/ns2:Civico>&#xa;                                                        &lt;ns2:Localita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                        &lt;/ns2:Localita>&#xa;                                                        &lt;ns2:CodiceComune>&#xa;                                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                        &lt;/ns2:CodiceComune>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                                            &lt;ns2:CodiceIndirizzo>&#xa;                                                                &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                                            &lt;/ns2:CodiceIndirizzo>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                        &lt;ns2:Modem>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns2:Modem>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;string-length($Start/tns:qualifica)>0&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:qualifica = 'Y'&quot;>&#xa;                                                                &lt;ns2:Qualifica>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                &lt;/ns2:Qualifica>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:Qualifica>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                                                &lt;/ns2:Qualifica>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaNonFonia>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:Accesso>&#xa;                                    &lt;xsl:for-each select=&quot;$Variable/tns2:root&quot;>&#xa;                                        &lt;xsl:variable name=&quot;conditionCompPos&quot; select=&quot;&amp;quot;tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1&amp;quot;&quot;/>&#xa;                                        &lt;xsl:variable name=&quot;currComponent1&quot; select=&quot;current()/tns2:componente&quot;/>&#xa;                                        &lt;xsl:variable name=&quot;currProgressivo1&quot; select=&quot;current()/tns2:progressivo&quot;/>&#xa;                                        &lt;ns2:VC>&#xa;                                            &lt;ns2:VPI>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore)&quot;/>&#xa;                                            &lt;/ns2:VPI>&#xa;                                            &lt;ns2:VCI>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore)&quot;/>&#xa;                                            &lt;/ns2:VCI>&#xa;                                            &lt;ns2:ProfiloVC>&#xa;                                                &lt;ns2:ABR>&#xa;                                                    &lt;ns2:MCRDown>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='MCRDOWN' and  tns9:componente=$currComponent1 and tns9:progressivo=$currProgressivo1]/tns9:valore&quot;/>&#xa;                                                    &lt;/ns2:MCRDown>&#xa;                                                    &lt;ns2:MCRUp>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='MCRUP' and  tns9:componente=$currComponent1 and tns9:progressivo=$currProgressivo1]/tns9:valore&quot;/>&#xa;                                                    &lt;/ns2:MCRUp>&#xa;                                                    &lt;ns2:PCRDown>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='PCRDOWN' and  tns9:componente=$currComponent1 and tns9:progressivo=$currProgressivo1]/tns9:valore&quot;/>&#xa;                                                    &lt;/ns2:PCRDown>&#xa;                                                    &lt;ns2:PCRUp>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='PCRUP' and  tns9:componente=$currComponent1 and tns9:progressivo=$currProgressivo1]/tns9:valore&quot;/>&#xa;                                                    &lt;/ns2:PCRUp>&#xa;                                                    &lt;ns2:Consegna>&#xa;                                                        &lt;ns2:BandaDedicata>&#xa;                                                            &lt;ns2:CodiceTD>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore&quot;/>&#xa;                                                            &lt;/ns2:CodiceTD>&#xa;                                                        &lt;/ns2:BandaDedicata>&#xa;                                                    &lt;/ns2:Consegna>&#xa;                                                &lt;/ns2:ABR>&#xa;                                            &lt;/ns2:ProfiloVC>&#xa;                                        &lt;/ns2:VC>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns2:BitstreamATMAsimmetricoHL>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '40'&quot;>&#xa;                                &lt;ns2:BitstreamATMSimmetricoHL>&#xa;                                    &lt;ns2:Accesso>&#xa;                                        &lt;ns2:LineaNonFonia>&#xa;                                            &lt;ns2:DatiSede>&#xa;                                                &lt;ns2:ParticellaToponomastica>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                &lt;/ns2:ParticellaToponomastica>&#xa;                                                &lt;ns2:Via>&#xa;                                                    &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                &lt;/ns2:Via>&#xa;                                                &lt;ns2:Civico>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                &lt;/ns2:Civico>&#xa;                                                &lt;ns2:Localita>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                &lt;/ns2:Localita>&#xa;                                                &lt;ns2:CodiceComune>&#xa;                                                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                &lt;/ns2:CodiceComune>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                    &lt;ns2:Complesso>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                    &lt;/ns2:Complesso>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                    &lt;ns2:Scala>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                    &lt;/ns2:Scala>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                    &lt;ns2:Piano>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                    &lt;/ns2:Piano>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                    &lt;ns2:Interno>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                    &lt;/ns2:Interno>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                    &lt;ns2:CAP>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                    &lt;/ns2:CAP>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                                    &lt;ns2:CodiceIndirizzo>&#xa;                                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                                    &lt;/ns2:CodiceIndirizzo>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/ns2:DatiSede>&#xa;                                            &lt;ns2:ClienteFinale>&#xa;                                                &lt;ns2:CognomeRagSoc>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                &lt;/ns2:CognomeRagSoc>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                    &lt;ns2:Nome>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                    &lt;/ns2:Nome>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                        &lt;ns2:CF>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                        &lt;/ns2:CF>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;ns2:PIVA>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                        &lt;/ns2:PIVA>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/ns2:ClienteFinale>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                &lt;ns2:Modem>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore = (&amp;quot;L1&amp;quot;,&amp;quot;L3&amp;quot;,&amp;quot;L5&amp;quot;,&amp;quot;L7&amp;quot;)&quot;>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore = (&amp;quot;L&amp;quot;,&amp;quot;L2&amp;quot;,&amp;quot;L4&amp;quot;,&amp;quot;L6&amp;quot;,&amp;quot;N&amp;quot;,&amp;quot;N1&amp;quot;,&amp;quot;N2&amp;quot;,&amp;quot;N3&amp;quot;)&quot;>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;6&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore = (&amp;quot;O&amp;quot;,&amp;quot;O1&amp;quot;)&quot;>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;ns2:Codice>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:Codice>&#xa;                                                &lt;/ns2:Modem>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                &lt;ns2:SlaProvisioning>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                &lt;/ns2:SlaProvisioning>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:SlaAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:SlaAssurance>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                &lt;ns2:CodiceQualita>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                &lt;/ns2:CodiceQualita>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                &lt;ns2:CodiceDelivery>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                &lt;/ns2:CodiceDelivery>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                &lt;ns2:DAD>&#xa;                                                    &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                &lt;/ns2:DAD>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                &lt;ns2:FasciaOraria>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                &lt;/ns2:FasciaOraria>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                            &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TECNOLOGIA']/tns:valore&quot;>&#xa;                                                &lt;ns2:Tecnologia>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TECNOLOGIA']/tns:valore&quot;/>&#xa;                                                &lt;/ns2:Tecnologia>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($Start/tns:dataDisponibilitaSede)&quot;>&#xa;                                                    &lt;ns2:DataDisponibilitaSede>&#xa;                                                        &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dataDisponibilitaSede), 9, 2),'/',substring(xsd:string($Start/tns:dataDisponibilitaSede), 6, 2),'/',substring(xsd:string($Start/tns:dataDisponibilitaSede), 1, 4))&quot;/>&#xa;                                                    &lt;/ns2:DataDisponibilitaSede>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:DataDisponibilitaSede>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;99/99/9999&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:DataDisponibilitaSede>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                &lt;ns2:Referente>&#xa;                                                    &lt;ns2:Progressivo>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                    &lt;/ns2:Progressivo>&#xa;                                                    &lt;ns2:Qualifica>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                    &lt;/ns2:Qualifica>&#xa;                                                    &lt;ns2:Nome>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                    &lt;/ns2:Nome>&#xa;                                                    &lt;ns2:Cognome>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                    &lt;/ns2:Cognome>&#xa;                                                    &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                        &lt;ns2:Telefono>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                        &lt;/ns2:Telefono>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                        &lt;ns2:Mobile>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                        &lt;/ns2:Mobile>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                        &lt;ns2:Email>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                        &lt;/ns2:Email>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:Referente>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;ns2:CognomeReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                    &lt;/ns2:CognomeReferente>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                        &lt;ns2:NomeReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                        &lt;/ns2:NomeReferente>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                        &lt;ns2:TelefonoFissoReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                        &lt;/ns2:TelefonoFissoReferente>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                        &lt;ns2:TelefonoMobileReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                        &lt;/ns2:TelefonoMobileReferente>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns2:LineaNonFonia>&#xa;                                    &lt;/ns2:Accesso>&#xa;                                    &lt;ns2:Protocollo>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOPROTOCOLLO']/tns:valore = 'FR'&quot;>&#xa;                                                &lt;ns2:FR>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'LMI']/tns:valore&quot;>&#xa;                                                        &lt;ns2:TipoLMI>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'LMI']/tns:valore&quot;/>&#xa;                                                        &lt;/ns2:TipoLMI>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:for-each select=&quot;$Variable/tns2:root[tns2:componente='ATMVC']&quot;>&#xa;                                                        &lt;ns2:VC>&#xa;                                                            &lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;current()/tns2:progressivo&quot;/>&#xa;                                                            &lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns2:componente&quot;/>&#xa;                                                            &lt;ns2:DLCI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'DLCI' and tns:componente='ATMVC' and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:DLCI>&#xa;                                                            &lt;ns2:ProfiloVC>&#xa;                                                                &lt;ns2:ABR>&#xa;                                                                    &lt;ns2:MCR>&#xa;                                                                        &lt;xsl:value-of select=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='MCRUP' and  tns9:componente=$currComponent and tns9:progressivo=$currProgressivo]/tns9:valore&quot;/>&#xa;                                                                    &lt;/ns2:MCR>&#xa;                                                                    &lt;xsl:if test=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='PCRUP' and  tns9:componente=$currComponent and tns9:progressivo=$currProgressivo]/tns9:valore&quot;>&#xa;                                                                        &lt;ns2:PCR>&#xa;                                                                            &lt;xsl:value-of select=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='PCRUP' and  tns9:componente=$currComponent and tns9:progressivo=$currProgressivo]/tns9:valore&quot;/>&#xa;                                                                        &lt;/ns2:PCR>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;ns2:Consegna>&#xa;                                                                        &lt;ns2:BandaDedicata>&#xa;                                                                            &lt;ns2:CodiceTD>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                            &lt;/ns2:CodiceTD>&#xa;                                                                        &lt;/ns2:BandaDedicata>&#xa;                                                                    &lt;/ns2:Consegna>&#xa;                                                                &lt;/ns2:ABR>&#xa;                                                            &lt;/ns2:ProfiloVC>&#xa;                                                        &lt;/ns2:VC>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns2:FR>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:ATM>&#xa;                                                    &lt;xsl:for-each select=&quot;$Variable/tns2:root&quot;>&#xa;                                                        &lt;ns2:VC>&#xa;                                                            &lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns2:componente&quot;/>&#xa;                                                            &lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;current()/tns2:progressivo&quot;/>&#xa;                                                            &lt;ns2:VCI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:VCI>&#xa;                                                            &lt;ns2:VPI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:VPI>&#xa;                                                            &lt;ns2:ProfiloVC>&#xa;                                                                &lt;ns2:ABR>&#xa;                                                                    &lt;ns2:MCR>&#xa;                                                                        &lt;xsl:value-of select=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='MCRUP' and  tns9:componente=$currComponent and tns9:progressivo=$currProgressivo]/tns9:valore&quot;/>&#xa;                                                                    &lt;/ns2:MCR>&#xa;                                                                    &lt;xsl:if test=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='PCRUP' and  tns9:componente=$currComponent and tns9:progressivo=$currProgressivo]/tns9:valore&quot;>&#xa;                                                                        &lt;ns2:PCR>&#xa;                                                                            &lt;xsl:value-of select=&quot;$MapperAttVC/tns9:sezioneInferiore[tns9:key='PCRUP' and  tns9:componente=$currComponent and tns9:progressivo=$currProgressivo]/tns9:valore&quot;/>&#xa;                                                                        &lt;/ns2:PCR>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;ns2:Consegna>&#xa;                                                                        &lt;ns2:BandaDedicata>&#xa;                                                                            &lt;ns2:CodiceTD>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                            &lt;/ns2:CodiceTD>&#xa;                                                                        &lt;/ns2:BandaDedicata>&#xa;                                                                    &lt;/ns2:Consegna>&#xa;                                                                &lt;/ns2:ABR>&#xa;                                                            &lt;/ns2:ProfiloVC>&#xa;                                                        &lt;/ns2:VC>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns2:ATM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:Protocollo>&#xa;                                &lt;/ns2:BitstreamATMSimmetricoHL>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '10'&quot;>&#xa;                                &lt;ns2:BitstreamATMAsimmetricoLite>&#xa;                                    &lt;ns2:Accesso>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&#xa;                                                &lt;ns2:LineaPOTS>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                            &lt;ns2:ParticellaToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                            &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                            &lt;ns2:Via>&#xa;                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                            &lt;/ns2:Via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                            &lt;ns2:Civico>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                            &lt;/ns2:Civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                            &lt;ns2:Localita>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                            &lt;/ns2:Localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                        &lt;ns2:Modem>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns2:Modem>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:NumeroLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                    &lt;/ns2:NumeroLinea>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICEPRODOTTOSPLITTER']/tns:valore = 'Y'&quot;>&#xa;                                                            &lt;ns2:Splitter>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Splitter>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Splitter>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Splitter>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaPOTS>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'ISDN'&quot;>&#xa;                                                &lt;ns2:LineaISDN>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                            &lt;ns2:ParticellaToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                            &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                            &lt;ns2:Via>&#xa;                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                            &lt;/ns2:Via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                            &lt;ns2:Civico>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                            &lt;/ns2:Civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                            &lt;ns2:Localita>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                            &lt;/ns2:Localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                        &lt;ns2:Modem>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns2:Modem>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:NumeroLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                    &lt;/ns2:NumeroLinea>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:LineaISDN>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:LineaNonFonia>&#xa;                                                    &lt;ns2:DatiSede>&#xa;                                                        &lt;ns2:ParticellaToponomastica>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                        &lt;/ns2:ParticellaToponomastica>&#xa;                                                        &lt;ns2:Via>&#xa;                                                            &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                        &lt;/ns2:Via>&#xa;                                                        &lt;ns2:Civico>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                        &lt;/ns2:Civico>&#xa;                                                        &lt;ns2:Localita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                        &lt;/ns2:Localita>&#xa;                                                        &lt;ns2:CodiceComune>&#xa;                                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                        &lt;/ns2:CodiceComune>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;ns2:Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/ns2:Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;ns2:Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/ns2:Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;ns2:Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/ns2:Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;ns2:Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/ns2:Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;ns2:CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/ns2:CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                                            &lt;ns2:CodiceIndirizzo>&#xa;                                                                &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                                            &lt;/ns2:CodiceIndirizzo>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns2:DatiSede>&#xa;                                                    &lt;ns2:ClienteFinale>&#xa;                                                        &lt;ns2:CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/ns2:CognomeRagSoc>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;ns2:CF>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                &lt;/ns2:CF>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:PIVA>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                &lt;/ns2:PIVA>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:ClienteFinale>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                        &lt;ns2:Modem>&#xa;                                                            &lt;ns2:Interfaccia>&#xa;                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                            &lt;/ns2:Interfaccia>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;ns2:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                    &lt;/ns2:Codice>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns2:Modem>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                        &lt;ns2:SlaProvisioning>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:SlaProvisioning>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                        &lt;ns2:CodiceQualita>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                        &lt;/ns2:CodiceQualita>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                        &lt;ns2:CodiceDelivery>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                        &lt;/ns2:CodiceDelivery>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                        &lt;ns2:DAD>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                        &lt;/ns2:DAD>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                        &lt;ns2:FasciaOraria>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                        &lt;/ns2:FasciaOraria>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                                        &lt;ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                            &lt;ns2:CognomeReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                                            &lt;/ns2:CognomeReferente>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                                &lt;ns2:NomeReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                                &lt;/ns2:NomeReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoFissoReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoFissoReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                                &lt;ns2:TelefonoMobileReferente>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                                &lt;/ns2:TelefonoMobileReferente>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:ReferenteOLOperProblematicheOn-field>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;string-length($Start/tns:qualifica)>0&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:qualifica = 'Y'&quot;>&#xa;                                                                &lt;ns2:Qualifica>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                &lt;/ns2:Qualifica>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:Qualifica>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                                                &lt;/ns2:Qualifica>&#