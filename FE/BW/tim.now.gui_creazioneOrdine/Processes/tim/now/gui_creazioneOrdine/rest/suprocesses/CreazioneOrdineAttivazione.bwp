sl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;$indexSlaPlusSuUD&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VALORESLA&amp;quot;&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiSlaPlusSu/tns:valoreSla&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;($Start/tns:idOfferta = '3') and (string-length($Start/tns:datiDisaggregazione/tns:systemUnico)>0) and (($OscuramServOpz/Record[1]/FLAG_OSCURMENTO !='1') or (count($OscuramServOpz/Record)=0))&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($TracciatoOloRegolatorio/Richiesta[1]/Testata/CodiceProgetto)=0&quot;>&#xa;                                    &lt;dettaglioordine>&#xa;                                        &lt;xsl:variable name=&quot;indexDisaggrUD&quot; select=&quot;xsd:int(count($Start/tns:datiServiziOpzionali)+(if(string-length($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento)>0) then 1 else 0)+(if(string-length($Start/tns:datiPrestazioniAggiuntive/tns:flagPrestazioneAggiuntiva)>0) then 1 else 0)+(if(string-length($Start/tns:datiSlaPlusSu/tns:flagSlaPlusSu)>0) then 1 else 0)+2)&quot;/>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;$indexDisaggrUD&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                            &lt;IDRisorsa>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                            &lt;/IDRisorsa>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;nomeComponente>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;DISAGGREGAZIONE&amp;quot;&quot;/>&#xa;                                        &lt;/nomeComponente>&#xa;                                        &lt;integrationID>&#xa;                                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                        &lt;/integrationID>&#xa;                                        &lt;xsl:if test=&quot;string-length($TracciatoOloRegolatorio/Richiesta[1]/Testata/CodiceProgetto)=0&quot;>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                            