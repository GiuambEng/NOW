                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoValoriProfiloVC&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable1&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:root>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:progressivo=$currentElement/tns:progressivo ]/tns:valore = 'ABR'&quot;>&#xa;                    &lt;tns9:sezioneInferiore>&#xa;                        &lt;tns9:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRDOWN'&quot;/>&#xa;                        &lt;/tns9:key>&#xa;                        &lt;tns9:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns9:componente>&#xa;                        &lt;tns9:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns9:tipologiaDato>&#xa;                        &lt;tns9:valore>&#xa;                            &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.')) then&amp;#xD;&amp;#xA; concat(substring-before(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.'),',',substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.'))&amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN)&quot;/>&#xa;                        &lt;/tns9:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns9:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns9:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns9:sezioneInferiore>&#xa;                    &lt;tns9:sezioneInferiore>&#xa;                        &lt;tns9:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRUP'&quot;/>&#xa;                        &lt;/tns9:key>&#xa;                        &lt;tns9:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns9:componente>&#xa;                        &lt;tns9:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns9:tipologiaDato>&#xa;                        &lt;tns9:valore>&#xa;                            &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.')) then&amp;#xD;&amp;#xA; concat(substring-before(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.'),',',substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.'))&amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_UP)&quot;/>&#xa;                        &lt;/tns9:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns9:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns9:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns9:sezioneInferiore>&#xa;                    &lt;tns9:sezioneInferiore>&#xa;                        &lt;tns9:key>&#xa;                            &lt;xsl:value-of select=&quot;'MCRDOWN'&quot;/>&#xa;                        &lt;/tns9:key>&#xa;                        &lt;tns9:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns9:componente>&#xa;                        &lt;tns9:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns9:tipologiaDato>&#xa;                        &lt;xsl:if test=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/MCR_DOWN &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN)&quot;>&#xa;                            &lt;tns9:valore>&#xa;                                &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/MCR_DOWN &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN)&quot;/>&#xa;                            &lt;/tns9:valore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns9:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns9:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns9:sezioneInferiore>&#xa;                    &lt;tns9:sezioneInferiore>&#xa;                        &lt;tns9:key>&#xa;                            &lt;xsl:value-of select=&quot;'MCRUP'&quot;/>&#xa;                        &lt;/tns9:key>&#xa;                        &lt;tns9:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns9:componente>&#xa;                        &lt;tns9:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns9:tipologiaDato>&#xa;                        &lt;xsl:if test=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_UP),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_UP),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/MCR_UP &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/MCR_UP)&quot;>&#xa;                            &lt;tns9:valore>&#xa;                                &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_UP),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_UP),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/MCR_UP &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/MCR_UP)&quot;/>&#xa;                            &lt;/tns9:valore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns9:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns9:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns9:sezioneInferiore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:progressivo=$currentElement/tns:progressivo ]/tns:valore = 'CBR'&quot;>&#xa;                    &lt;tns9:sezioneInferiore>&#xa;                        &lt;tns9:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRDOWN'&quot;/>&#xa;                        &lt;/tns9:key>&#xa;                        &lt;tns9:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns9:componente>&#xa;                        &lt;tns9:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns9:tipologiaDato>&#xa;                        &lt;xsl:if test=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/PCR_DOWN &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN)&quot;>&#xa;                            &lt;tns9:valore>&#xa;                                &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.') and xsd:int(substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.'))>0)&amp;#xD;&amp;#xA;then&amp;#xD;&amp;#xA; $RecuperoValoriProfiloVC/Record[1]/PCR_DOWN &amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN)&quot;/>&#xa;                            &lt;/tns9:valore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns9:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns9:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns9:sezioneInferiore>&#xa;                    &lt;tns9:sezioneInferiore>&#xa;                        &lt;tns9