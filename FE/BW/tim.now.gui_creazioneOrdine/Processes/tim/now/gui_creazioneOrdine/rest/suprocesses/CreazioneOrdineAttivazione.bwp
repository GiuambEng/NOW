','FULLGPON1BPNRR','SEMIGPON1BPNRR')&quot;>&lt;tns:strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/tns:strutturaRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FWA&amp;quot;&quot;/>&lt;/tns:strutturaRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:outputLavorazioni>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:OutputLavorazioni>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputLavorazioni>&lt;tns:result>&lt;xsl:if test=&quot;$NoOfferte/tns:result/tns:severity&quot;>&lt;tns:severity>&lt;xsl:value-of select=&quot;$NoOfferte/tns:result/tns:severity&quot;/>&lt;/tns:severity>&lt;/xsl:if>&lt;xsl:if test=&quot;$NoOfferte/tns:result/tns:code&quot;>&lt;tns:code>&lt;xsl:value-of select=&quot;$NoOfferte/tns:result/tns:code&quot;/>&lt;/tns:code>&lt;/xsl:if>&lt;xsl:if test=&quot;$NoOfferte/tns:result/tns:details&quot;>&lt;tns:details>&lt;xsl:value-of select=&quot;$NoOfferte/tns:result/tns:details&quot;/>&lt;/tns:details>&lt;/xsl:if>&lt;/tns:result>&lt;/tns:OutputLavorazioni>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
