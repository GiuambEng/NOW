                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns03=&quot;http://vp.telecomitalia.it/crm/vp/order&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:ns1=&quot;http://multicast.telecomitalia.it/crm/multicast/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NoOfferte&quot;/>&lt;xsl:param name=&quot;RenderXml&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TracciatoOloRegolatorio&quot;/>&lt;xsl:param name=&quot;TracciatoOloXDSL&quot;/>&lt;xsl:param name=&quot;TracciatoOloNGA&quot;/>&lt;xsl:param name=&quot;TracciatoOLOVP&quot;/>&lt;xsl:param name=&quot;TracciatoOloFWA&quot;/>&lt;xsl:param name=&quot;TracciatoOLOMulticast&quot;/>&lt;xsl:param name=&quot;TracciatoOloFiberstream&quot;/>&lt;xsl:param name=&quot;TracciatoOloFWAEOLO&quot;/>&lt;xsl:param name=&quot;CreazioneOrdineGPON&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RenderXml)&quot;>&lt;tns:OutputLavorazioni>&lt;tns:outputLavorazioni>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns:offertaCatalogo) =('ULL','ULLDATI','SLU','VULL','SHA','WLR','CPS')&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloRegolatorio/Richiesta[1],false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo=('BitstreamATMAsimmetricoFlat', 'BitstreamATMSimmetricoFlat','BitstreamATMAsimmetricoHL', 'BitstreamATMSimmetricoHL','BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite','VLAN')&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloXDSL/ns2:Richiesta[1],false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo =('BitstreamNGAFTTCAB','BitstreamNGAFTTH','VULAFTTCAB','VULAFTTH','EasyIPUBBFTTCAB','EasyIPUBBFTTH','VLANNGA','VLANVULA','SEMIBitstreamNGAFTTH','SEMIVULAFTTH','SEMIEasyIPUBBFTTH','FULLGPONPLUSNGA','FULLGPONPLUS')&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloNGA/ns0:Richiesta[1],false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo ='VP'&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOLOVP/ns03:Richiesta,false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo =('UBBSEMIGPON','UBBFULLGPON','FULLGPON1BPNRR','SEMIGPON1BPNRR')&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($CreazioneOrdineGPON/Richiesta[1],false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo ='FEEDER'&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOLOMulticast/ns1:Richiesta,false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo ='FIBERSTREAM'&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloFiberstream/Richiesta[1],false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo ='FWAITALIA1GIGASARDEGNA'&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloFWAEOLO/Richiesta[1],false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:contenutoXmlOlo>&lt;xsl:value