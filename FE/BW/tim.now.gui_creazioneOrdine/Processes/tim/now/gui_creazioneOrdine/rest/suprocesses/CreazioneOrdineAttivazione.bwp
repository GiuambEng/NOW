staOLO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/IDRichiestaOLO>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTEONFIELD&amp;quot;&quot;/>&lt;/tipoReferenteOrdine>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;>&lt;cognomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&lt;/cognomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&lt;nomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&lt;/nomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&lt;telefonoFissoReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&lt;/telefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&lt;telefonoMobileReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&lt;/telefonoMobileReferente>&lt;/xsl:if>&lt;flag_Token>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/flag_Token>&lt;/referente>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:refOaoProgettiSpeciali)&quot;>&lt;referente>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/IDRichiestaOLO>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&lt;/tipoReferenteOrdine>&lt;flag_Token>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/flag_Token>&lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&lt;refOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&lt;/refOAOProgettiSpeciali>&lt;/xsl:if>&lt;/referente>&lt;/xsl:if>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&lt;/tipologiaAccesso>&lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&lt;tipologiaQualita>&lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&lt;/tipologiaQualita>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'FULLGPON1BPNRR'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;FULLGPON1BPNRR&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIGPON1BPNRR'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;SEMIGPON1BPNRR&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;UBBFULLGPON&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:dn&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/IDRisorsaNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore)&quot;>&lt;tipologiaLinea>&lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore)&quot;/>&lt;/tipologiaLinea>&lt;/xsl:if>&lt;operatoreRete>&lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&lt;/operatoreRete>&lt;/ordine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&lt;/IDContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&lt;ISTATComune>&lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&lt;/ISTATComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '65'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;'UBBSEMIGPON'&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '79'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;'SEMIGPON1BPNRR'&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '80'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;'FULLGPON1BPNRR'&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;'UBBFULLGPON'&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;$Start/tns:dad&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&lt;/DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento !=&amp;quot;OP&amp;quot;) or (($OscuramServOpz/Record[1]/FLAG_OSCURMENTO = '1') and ($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento = &amp;quot;OP&amp;quot;))&quot;>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;IDFasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/IDFasciaOraria>&lt;/xsl:if>&lt;/xsl:if>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&lt;/IDOfferta>&lt;xsl:choose>&lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloData/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:dn&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dac&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;operatoreRete>&lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&lt;/operatoreRete>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:flagNumerazioniAggiuntive = 'Y'&quot;>&lt;flagNumAggiuntive>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/flagNumAggiuntive>&lt;/xsl:when>&lt;xsl:otherwise>&lt;flagNumAggiuntive>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/flagNumAggiuntive>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:offertaCatalogo=('SEMIGPON1BPNRR','FULLGPON1BPNRR')&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;NORMALE&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(xsd:string($RecuperoRendezVous/Record[1]/ID_OFFERTA)) >0 and string-length($RecuperoRendezVous/Record[1]/CODFC_OLO_AGCOM) >0 and $Start/tns:idOfferta = ('1','3','5','21','22')&quot;>&lt;rendezVous>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/rendezVous>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore) and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key=&amp;quot;IDRISORSAOLD&amp;quot;]/tns:valore)>0 and $RecuperaOscuramIdRisOLD/Record[1]/FLAG_OSCURMENTO !='1'&quot;>&lt;cambioTecnologia>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/cambioTecnologia>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/tns:oao = 'ALB') and (string-length($Start/tns:codiceProgetto)>0) and contains($CodProgettoWL, $Start/tns:codiceProgetto)&quot;>&lt;ordineAssetWhiteList>&lt;xsl:value-of select=&quot;'TIM EX BT'&quot;/>&lt;/ordineAssetWhiteList>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'UBBSEMIGPON' and string-length($Start/tns:datiGestioneAutonoma/tns:impresaSystem)>0 and $Start/tns:datiGestioneAutonoma/tns:impresaSystem='Y'&quot;>&lt;gestioneAutonoma>&lt;xsl:value-of select=&quot;&amp;quot;IS&amp;quot;&quot;/>&lt;/gestioneAutonoma>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'UBBSEMIGPON' and string-length($Start/tns:datiGestioneAutonoma/tns:operatoreSystem)>0 and $Start/tns:datiGestioneAutonoma/tns:operatoreSystem='Y'&quot;>&lt;gestioneAutonoma>&lt;xsl:value-of select=&quot;&amp;quot;OS&amp;quot;&quot;/>&lt;/gestioneAutonoma>&lt;/xsl:when>&lt;/xsl:choose>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CasedataBPM" name="CasedataGPON"
                    outputVariable="CasedataBPM"
                    tibex:xpdlId="efdec6c0-9a14-441c-b1a6-73b7596a5a87" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="calcNextDateByDurationToCasedataGPON"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CasedataGPONToEmpty3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ADD5DAI.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloData.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ADD5DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoRendezVous&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaOscuramIdRisOLD&quot;/>&#xa;    &lt;xsl:param name=&quot;OscuramServOpz&quot;/>&#xa;    &lt;xsl:param name=&quot;IdArmadio&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProgettoWL&quot;/>&#xa;    &lt;xsl:param name=&quot;CreazioneOrdineGPON&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataBPM&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'UBBSEMIGPON'&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;UBBSEMIGPON&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&amp;lt;$ADD5DRO.parameters/tns1:outputDate&quot;>&#xa;                            &lt;DACRimodulata>&#xa;                                &lt;xsl:value-of select=&quot;$ADD5DAI.parameters/tns1:outputDate&quot;/>&#