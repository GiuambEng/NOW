                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns9=&quot;http://www.example.org/OrdiniFWAEOLO&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstatEOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciatoOloFWAEOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:nuovoOrdine>&#xa;            &lt;xsl:if test=&quot;$Start/tns:causaleOrdine&quot;>&#xa;                &lt;tns9:causaleOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:causaleOrdine&quot;/>&#xa;                &lt;/tns9:causaleOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:oao&quot;>&#xa;                &lt;tns9:oao>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                &lt;/tns9:oao>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;tns9:codiceOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/tns9:codiceOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                &lt;tns9:operatore>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                &lt;/tns9:operatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;tns9:codiceOrdinePadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/tns9:codiceOrdinePadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:i