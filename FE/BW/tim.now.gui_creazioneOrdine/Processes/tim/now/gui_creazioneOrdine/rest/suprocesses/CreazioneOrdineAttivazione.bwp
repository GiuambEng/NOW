                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns3=&quot;http://www.example.org/OrdiniFiberstream&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&lt;xsl:template name=&quot;TracciatoOloFiberstream-input&quot; match=&quot;/&quot;>&lt;tns3:nuovoOrdine>&lt;xsl:if test=&quot;$Start/tns:causaleOrdine&quot;>&lt;tns3:causaleOrdine>&lt;xsl:value-of select=&quot;$Start/tns:causaleOrdine&quot;/>&lt;/tns3:causaleOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:oao&quot;>&lt;tns3:oao>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/tns3:oao>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;tns3:codiceOrdine>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/tns3:codiceOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&lt;tns3:operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/tns3:operatore>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;tns3:codiceOrdinePadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/tns3:codiceOrdinePadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&lt;tns3:idContratto>&lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&lt;/tns3:idContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idContrattoOfferta&quot;>&lt;tns3:idContrattoOfferta>&lt;xsl:value-of select=&quot;$Start/tns:idContrattoOfferta&quot;/>&lt;/tns3:idContrattoOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;tns3:noteDaOperatore>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/tns3:noteDaOperatore>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;tns3:codiceProgetto>&lt;xsl:value-of select=&quo