logiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivo>&#xa;                        &lt;/dettaglioordine>&#xa;                        &lt;xsl:if test=&quot;(count($Start/tns:datiServiziOpzionali/tns:codiceServizio)>0) and (($OscuramServOpz/Record[1]/FLAG_OSCURMENTO !='1') or (count($OscuramServOpz/Record)=0))&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns:datiServiziOpzionali&quot;>&#xa;                                &lt;dettaglioordine>&#xa;                                    &lt;xsl:variable name=&quot;indexSOpz&quot; select=&quot;xsd:int(xsd:int(tns:id)+2)&quot;/>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;$indexSOpz&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;IDDettaglioOrdineParent>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdineParent>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quo