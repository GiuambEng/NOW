                                wsdlLocation="platform:/resource/tim.now.gui_creazioneOrdine/Service%20Descriptors/GetNextDateService_concrete_v.1.0.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
                                    action="calcNextDateByDuration" operationName="calcNextDateByDuration">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:calcNextDateByDurationRequest" wsdlLocation="platform:/resource/tim.now.gui_creazioneOrdine/Service%20Descriptors/GetNextDateService_concrete_v.1.0.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="GetNextDate:Request"
                                    partName="parameters" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    messageDirection="OUTPUT"
                                    messageQName="pt:calcNextDateByDurationResponse" wsdlLocation="platform:/resource/tim.now.gui_creazioneOrdine/Service%20Descriptors/GetNextDateService_concrete_v.1.0.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="GetNextDate:Response"
                                    partName="parameters" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration action="fault"
                                    messageDirection="FAULT"
                                    messageQName="pt:calcNextDateByDurationFault" wsdlLocation="platform:/resource/tim.now.gui_creazioneOrdine/Service%20Descriptors/GetNextDateService_concrete_v.1.0.wsdl">
                                    <messagePartConfigurations
                                    partElementName="GetNextDate:Fault"
                                    partName="parameters" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    <outputMapping direction="OUTPUT"/>
                                    <faultMappings direction="FAULT" faultName="fault"/>
                                    </context>
                                </operationConfiguration>
                                <operationConfiguration
                                    action="calcNextWorkingDate" operationName="calcNextWorkingDate">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:calcNextWorkingDateRequest" wsdlLocation="platform:/resource/tim.now.gui_creazioneOrdine/Service%20Descriptors/GetNextDateService_concrete_v.1.0.wsdl">
                                    <messagePartConfigurations
