ressivo>&lt;ns0:Qualifica>&lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&lt;/ns0:Qualifica>&lt;ns0:Nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/ns0:Nome>&lt;ns0:Cognome>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/ns0:Cognome>&lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&lt;ns0:Telefono>&lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&lt;/ns0:Telefono>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cellulare&quot;>&lt;ns0:Mobile>&lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&lt;/ns0:Mobile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:email&quot;>&lt;ns0:Email>&lt;xsl:value-of select=&quot;tns:email&quot;/>&lt;/ns0:Email>&lt;/xsl:if>&lt;/ns0:Referente>&lt;/xsl:for-each>&lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&lt;ns0:ReferenteOLOperProblematicheOn-field>&lt;ns0:CognomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&lt;/ns0:CognomeReferente>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&lt;ns0:NomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&lt;/ns0:NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&lt;ns0:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&lt;/ns0:TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&lt;ns0:TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&lt;/ns0:TelefonoMobileReferente>&lt;/xsl:if>&lt;/ns0:ReferenteOLOperProblematicheOn-field>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(not(exists($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO)) or ($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO !='1')) and (upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'INTERMEDIATEAGENTFULL']/tns:valore)='Y')&quot;>&lt;ns0:INTERMEDIATE_AGENT_FULL>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:INTERMEDIATE_AGENT_FULL>&lt;/xsl:when>&lt;xsl:when test=&quot;(not(exists($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO)) or ($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO !='1')) and (upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'INTERMEDIATEAGENTFULL']/tns:valore)='N')&quot;>&lt;ns0:INTERMEDIATE_AGENT_FULL>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/ns0:INTERMEDIATE_AGENT_FULL>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OscuramentoToken/Record[1]/COUNT =0&quot;>&lt;xsl:if test=&quot;$Start/tns:token&quot;>&lt;ns0:TOKEN>&lt;xsl:value-of select=&quot;$Start/tns:token&quot;/>&lt;/ns0:TOKEN>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;(($OscuramServOpz/Record[1]/FLAG_OSCURMENTO !='1') or (count($OscuramServOpz/Record)=0)) and (count($Start/tns:datiServiziOpzionali/tns:codiceServizio)>0)&quot;>&lt;xsl:for-each select=&quot;$Start/tns:datiServiziOpzionali&quot;>&lt;ns0:ServiziOpzionali>&lt;ns0:CodiceServizio>&lt;xsl:value-of select=&quot;tns:codiceServizio&quot;/>&lt;/ns0:CodiceServizio>&lt;xsl:if test=&quot;tns:descrizioneServizio&quot;>&lt;ns0:DescrizioneServizio>&lt;xsl:value-of select=&quot;tns:descrizioneServizio&quot;/>&lt;/ns0:DescrizioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:datiTecnici&quot;>&lt;ns0:DatiTecnici>&lt;xsl:value-of select=&quot;tns:datiTecnici&quot;/>&lt;/ns0:DatiTecnici>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;tns:vincolantePerEspletamento = 'Y'&quot;>&lt;ns0:VincolantePerEspletamento>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:VincolantePerEspletamento>&lt;/xsl:when>&lt;xsl:when test=&quot;tns:vincolantePerEspletamento = 'N'&quot;>&lt;ns0:VincolantePerEspletamento>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/ns0:VincolantePerEspletamento>&lt;/xsl:when>&lt;/xsl:choose>&lt;/ns0:ServiziOpzionali>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDRISORSAOLD']/tns:valore) and (string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDRISORSAOLD']/tns:valore)>0)&quot;>&lt;ns0:ServizioOLD>&lt;ns0:IDRisorsaOLD>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDRISORSAOLD']/tns:valore&quot;/>&lt;/ns0:IDRisorsaOLD>&lt;/ns0:ServizioOLD>&lt;/xsl:if>&lt;/ns0:LineaNonFonia>&lt;/ns0:Accesso>&lt;xsl:for-each select=&quot;$Variable/tns2:root&quot;>&lt;ns0:UserVlan>&lt;xsl:variable name=&quot;currComponent3&quot; select=&quot;current()/tns2:componente&quot;/>&lt;xsl:variable name=&quot;currProgressivo3&quot; select=&quot;current()/tns2:progressivo&quot;/>&lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'USERVLANID' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore)&quot;>&lt;ns0:UserVlan_ID>&lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'USERVLANID' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore)&quot;/>&lt;/ns0:UserVlan_ID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'FLAGMULTICAST' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore) = 0&quot;>&lt;ns0:SVlanCode>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;/>&lt;/ns0:SVlanCode>&lt;ns0:CVLAN_ID>&lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore)&quot;/>&lt;/ns0:CVLAN_ID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:FlagMulticast>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:FlagMulticast>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN'&amp;#xD;&amp;#xA; and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore),'.')&quot;>&lt;ns0:Banda_Picco_Down>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore, '.'), ',',substring-after($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore, '.'))&quot;/>&lt;/ns0:Banda_Picco_Down>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:Banda_Picco_Down>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;/>&lt;/ns0:Banda_Picco_Down>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP'&amp;#xD;&amp;#xA; and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore),'.')&quot;>&lt;ns0:Banda_Picco_UP>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore, '.'), ',',substring-after($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore, '.'))&quot;/>&lt;/ns0:Banda_Picco_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:Banda_Picco_UP>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;/>&lt;/ns0:Banda_Picco_UP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:UserVlan>&lt;/xsl:for-each>&lt;/ns0:VULAFTTH>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:Attivazione>&lt;/ns0:TipoRichiesta>&lt;/ns0:Richiesta>&lt;/ns0:TracciatoOLONGA>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
