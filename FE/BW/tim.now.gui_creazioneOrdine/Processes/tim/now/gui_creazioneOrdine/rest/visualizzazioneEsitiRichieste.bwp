                <variable>VisualizzazioneNotificheDG_MKT_NEWSQuery</variable>
                <variable>VisualizzazioneEsitiRichiesteQuery</variable>
                <variable>VisualizzazioneNotificheOLOQuery</variable>
                <variable>JDBCQuery</variable>
                <variable>VisualizzazioneEsitiRichiesteQueryOLO</variable>
