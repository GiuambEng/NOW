rameters/codAgcom)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:ordini-visualizzazioneEsitiRichiesteGetParameters/codAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codAgcom3>&lt;codAgcom1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:ordini-visualizzazioneEsitiRichiesteGetParameters/codAgcom)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:ordini-visualizzazioneEsitiRichiesteGetParameters/codAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codAgcom1>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
