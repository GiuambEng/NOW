                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select offerta, idrisorsa, codiceordineolo&#xa;from BDS_1_CASEDATA_RICHIESTA&#xa;where idrichiestaolo = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

