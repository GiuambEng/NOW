       &lt;/tns1:dataCreazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:notificaXML&quot;>&#xa;                                &lt;tns1:notificaXML>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:notificaXML&quot;/>&#xa;                                &lt;/tns1:notificaXML>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:ultimoFileNotifica&quot;>&#xa;                                &lt;tns1:ultimoFileNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:ultimoFileNotifica&quot;/>&#xa;                                &lt;/tns1:ultimoFileNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:dataInvioFile&quot;>&#xa;                                &lt;tns1:dataInvioFile>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:dataInvioFile&quot;/>&#xa;                                &lt;/tns1:dataInvioFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:idNotifica&quot;>&#xa;                                &lt;tns1:idNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:idNotifica&quot;/>&#xa;                                &lt;/tns1:idNotifica>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:visualizzazioneNotificheOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;$VariableRichieste/tns2:visualizzazioneEsitiRichiesteOutput&quot;>&#xa;                        &lt;tns1:visualizzazioneEsitiRichiesteOutput>&#xa;                            &lt;xsl:if test=&quot;tns2:dataInvio&quot;>&#xa;                                &lt;tns1:dataInvio>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:dataInvio&quot;/>&#xa;                                &lt;/tns1:dataInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:statoNow&quot;>&#xa;                                &lt;tns1:statoNow>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:statoNow&quot;/>&#xa;                                &lt;/tns1:statoNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:statoOao&quot;>&#xa;                                &lt;tns1:statoOao>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:statoOao&quot;/>&#xa;                                &lt;/tns1:statoOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:lavorazioneRichiesta&quot;>&#xa;                                &lt;tns1:lavorazioneRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:lavorazioneRichiesta&quot;/>&#xa;                                &lt;/tns1:lavorazioneRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:idRichiestaOlo&quot;>&#xa;                                &lt;tns1:idRichiestaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:idRichiestaOlo&quot;/>&#xa;                                &lt;/tns1:idRichiestaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:codiceRichiestaOao&quot;>&#xa;                                &lt;tns1:codiceRichiestaOao>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:codiceRichiestaOao&quot;/>&#xa;                                &lt;/tns1:codiceRichiestaOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:xml&quot;>&#xa;                                &lt;tns1:xml>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:xml&quot;/>&#xa;                                &lt;/tns1:xml>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns2:userId&quot;>&#xa;                                &lt;tns1:userId>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:userId&quot;/>&#xa;                                &lt;/tns1:userId>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:visualizzazioneEsitiRichiesteOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                        &lt;tns1:details>&#xa;                            &lt;xsl:value-of select=&quot;'RECORD ESISTENTI'&quot;/>&#xa;                        &lt;/tns1:details>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:VisualizzazioneEsiti>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:VisualizzazioneEsiti>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                        &lt;tns1:details>&#xa;                            &lt;xsl:value-of select=&quot;'NO RECORD'&quot;/>&#xa;                        &lt;/tns1:details>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:Visualizz