                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToEmpty1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1163ca07-555f-48c6-8424-8f92e7b31ca6+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TIPORICHIESTA&quot;/>&lt;xsl:param name=&quot;AMBITO&quot;/>&lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperoOfferta/Record[1]/IDRISORSA)&quot;>&lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/IDRISORSA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA>&lt;CODICEORDINEOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperoOfferta/Record[1]/CODICEORDINEOLO)&quot;>&lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/CODICEORDINEOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICEORDINEOLO>&lt;TIPORICHIESTA>&lt;xsl:value-of select=&quot;$TIPORICHIESTA&quot;/>&lt;/TIPORICHIESTA>&lt;AMBITO>&lt;xsl:value-of select=&quot;$AMBITO&quot;/>&lt;/AMBITO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;r1.DATAINVIORICHIESTA, &#xa;r1.STATORICHIESTANOW, &#xa;r1.STATORICHIESTAOLO,&#xa;r1.LAVORAZIONE,&#xa;r1.IDRICHIESTAOLO,&#xa;r1.CODICEORDINEOLO,&#xa;r1.CONTENUTOXML,&#xa;r1.OPERATORE,&#xa;ar.contenuto_xml_olo&#xa;FROM BDS_1_CASEDATA_RICHIESTA r1 &#xa;LEFT JOIN acquisizione_richieste AR ON TO_CHAR(r1.idrichiestaolo) = ar.id_richiesta_olo&#xa;WHERE r1.IDRISORSA = ? AND r1.CODICEORDINEOLO = ? AND r1.TIPORICHIESTA = ? AND r1.AMBITO = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICEORDINEOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPORICHIESTA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="AMBITO"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CONTENUTOXML"
                                    dataType="2011"
                                    status="OptionalElement" typeName="NCLOB"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CONTENUTO_XML_OLO"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
