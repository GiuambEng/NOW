                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/VisualizzazioneEsitiRichieste/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VisualizzazioneNotificheOLOQuery&quot;/>&lt;xsl:param name=&quot;VisualizzaNotifichePPS_GA&quot;/>&lt;xsl:param name=&quot;VisualizzazioneNotificheDG_MKT_NEWSQuery&quot;/>&lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQuery&quot;/>&lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQueryOLO&quot;/>&lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;VisualizzazioneNotificheOperation&quot;/>&lt;xsl:template name=&quot;VariableRichieste&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length(string($VisualizzazioneNotificheDG_MKT_NEWSQuery/Record[1]/ID_NOTF))>0 or string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF))>0 or string-length(string($VisualizzaNotifichePPS_GA/Record[1]/ID_NOTF))>0) and (string-length($VisualizzazioneEsitiRichiesteQueryOLO/Record[1]/IDRICHIESTAOLO) = 0 and string-length($VisualizzazioneEsitiRichiesteQuery/Record[1]/IDRICHIESTAOLO) = 0 and string-length($JDBCQuery/Record[1]/IDRICHIESTAOLO) = 0)&quot;>&lt;tns:VisualizzazioneEsitiNotifiche>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF)) > 0&quot;>&lt;xsl:for-each select=&quot;$VisualizzazioneNotificheOLOQuery/Record&quot;>&lt;tns:visualizzazioneNotificheOutput>&lt;xsl:variable name=&quot;currentId&quot; select=&quot;ID_NOTF&quot;/>&lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&lt;tns:tipologiaNotifica>&lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&lt;/tns:tipologiaNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns:causale>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns:causale>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$VisualizzazioneNotificheOperation/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica=$currentId]/tns1:contenutoXML&quot;>&lt;tns:notificaXML>&lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperation/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica=$currentId]/tns1:contenutoXML&quot;/>&lt;/tns:notificaXML>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_FILE&quot;>&lt;tns:ultimoFileNotifica>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:ultimoFileNotifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns:dataInvioFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInvioFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns:dataInvioFile>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns:dataInvioFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;ID_NOTF&quot;/>&lt;/tns:idNotifica>&lt;/tns:visualizzazioneNotificheOutput>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($VisualizzazioneNotificheDG_MKT_NEWSQuery/Record[1]/ID_NOTF)) > 0&quot;>&lt;xsl:for-each select=&quot;$VisualizzazioneNotificheDG_MKT_NEWSQuery/Record&quot;>&lt;tns:visualizzazioneNotificheOutput>&lt;xsl:variable name=&quot;currentId2&quot; select=&quot;ID_NOTF&quot;/>&lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&lt;tns:tipologiaNotifica>&lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&lt;/tns:tipologiaNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns:causale>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns:causale>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$VisualizzazioneNotificheOperation/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica =$currentId2 ]/tns1:contenutoXML&quot;>&lt;tns:notificaXML>&lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperation/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica =$currentId2 ]/tns1:contenutoXML&quot;/>&lt;/tns:notificaXML>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_FILE&quot;>&lt;tns:ultimoFileNotifica>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:ultimoFileNotifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns