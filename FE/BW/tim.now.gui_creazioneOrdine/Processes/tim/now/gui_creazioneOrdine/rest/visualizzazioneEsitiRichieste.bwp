                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&#xa;                                        &lt;tns:statoOao>&#xa;                                            &lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&#xa;                                        &lt;/tns:statoOao>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;LAVORAZIONE&quot;>&#xa;                                        &lt;tns:lavorazioneRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&#xa;                                        &lt;/tns:lavorazioneRichiesta>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns:idRichiestaOlo>&#xa;                                        &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                                    &lt;/tns:idRichiestaOlo>&#xa;                                    &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                        &lt;tns:codiceRichiestaOao>&#xa;                                            &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                        &lt;/tns:codiceRichiestaOao>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists(CONTENUTOXML) and string-length(CONTENUTOXML)&quot;>&#xa;                                            &lt;xsl:if test=&quot;CONTENUTOXML&quot;>&#xa;                                                &lt;tns:xml>&#xa;                                                    &lt;xsl:value-of select=&quot;CONTENUTOXML&quot;/>&#xa;                                                &lt;/tns:xml>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;CONTENUTO_XML_OLO&quot;>&#xa;                                                &lt;tns:xml>&#xa;                                                    &lt;xsl:value-of select=&quot;CONTENUTO_XML_OLO&quot;/>&#xa;                                                &lt;/tns:xml>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;exists(OPERATORE) and upper-case(OPERATORE)!='AUTOMATICO'&quot;>&#xa;                                        &lt;xsl:if test=&quot;OPERATORE&quot;>&#xa;                                            &lt;tns:userId>&#xa;                                                &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                                            &lt;/tns:userId>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns:visualizzazioneEsitiRichiesteOutput>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:for-each select=&quot;$VisualizzazioneEsitiRichiesteQuery/Record&quot;>&#xa;                                &lt;tns:visualizzazioneEsitiRichiesteOutput>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;contains(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;) and exists(DATAINVIORICHIESTA) and string-length(xsd:string(DATAINVIORICHIESTA))>0&quot;>&#xa;                                            &lt;tns:dataInvio>&#xa;                                                &lt;xsl:value-of select=&quot;substring-before(concat(substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAINVIORICHIESTA), &amp;quot;+&amp;quot;)), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                            &lt;/tns:dataInvio>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:dataInvio>&#xa;                                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                            &lt;/tns:dataInvio>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&#xa;                                        &lt;tns:statoNow>&#xa;                                            &lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&#xa;                                        &lt;/tns:statoNow>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&#xa;                                        &lt;tns:statoOao>&#xa;                                            &lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&#xa;                                        &lt;/tns:statoOao>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;LAVORAZIONE&quot;>&#xa;                                        &lt;tns:lavorazioneRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&#xa;                                        &lt;/tns:lavorazioneRichiesta>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns:idRichiestaOlo>&#xa;                                        &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                                    &lt;/tns:idRichiestaOlo>&#xa;                                    &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                        &lt;tns:codiceRichiestaOao>&#xa;                                            &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                        &lt;/tns:codiceRichiestaOao>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists(CONTENUTOXML) and string-length(CONTENUTOXML) >0&quot;>&#xa;                                            &lt;xsl:if test=&quot;CONTENUTOXML&quot;>&#xa;                                                &lt;tns:xml>&#xa;                                                    &lt;xsl:value-of select=&quot;CONTENUTOXML&quot;/>&#xa;                                                &lt;/tns:xml>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;CONTENUTO_XML_OLO&quot;>&#xa;                                                &lt;tns:xml>&#xa;                                                    &lt;xsl:value-of select=&quot;CONTENUTO_XML_OLO&quot;/>&#xa;                                                &lt;/tns:xml>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;exists(OPERATORE) and upper-case(OPERATORE)!='AUTOMATICO'&quot;>&#xa;                                        &lt;xsl:if test=&quot;OPERATORE&quot;>&#xa;                                            &lt;tns:userId>&#xa;                                                &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                                            &lt;/tns:userId>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns:visualizzazioneEsitiRichiesteOutput>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:VisualizzazioneEsitiNotifiche>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:VisualizzazioneEsitiNotifiche/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariableRichieste" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="OscuramentoSecolo-input"
                                    name="OscuramentoSecolo"
                                    outputVariable="OscuramentoSecolo"
                                    tibex:xpdlId="4dbef982-909a-477e-9a02-482baeb3d347" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToVisualizzazioneNotificheOperation">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$get/parameters/tns0:ordini-visualizzazioneEsitiRichiesteGetParameters/tipoProfilo = ('CRM_OLO','CRM_OLORO', 'CRM_OLO_SUPER', 'CRM_OLORO_SUPER', 'CRM_OPCC') and $OscuramentoSecolo/Record[1]/CONTEGGIO&lt;1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$get.parameters/tipoProfilo = ('CRM_OLO','CRM_OLORO', 'CRM_OLO_SUPER', 'CRM_OLORO_SUPER', 'CRM_OPCC') and $OscuramentoSecolo/Record[1]/CONTEGGIO<1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JDBCQuery1ToesitiRichiestePresenti">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4dbef982-909a-477e-9a02-482baeb3d347+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count(*) as conteggio&#xa;from oscuramento_agesp&#xa;where COD_AGESP='R58-20-1339' and FLAG_OSCURMENTO = '1'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="CONTEGGIO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
