                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fdd6c315-b661-4220-9a09-b7b4a87d4abb+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160421122350PLT/ConceptSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;VisualizzazioneNotificheDG_MKT_NEWSQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:ordini-visualizzazioneEsitiRichiesteGetParameters/idRichiesta)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:ordini-visualizzazioneEsitiRichiesteGetParameters/idRichiesta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idRichiesta>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VisualizzazioneNotificheDG_MKT_NEWSQuery-input"
                                    name="VisualizzazioneNotificheDG_MKT_NEWSQuery"
                                    outputVariable="VisualizzazioneNotificheDG_MKT_NEWSQuery"
                                    tibex:xpdlId="fdd6c315-b661-4220-9a09-b7b4a87d4abb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
