            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="a56946c9-5ae0-4ab6-ae00-8cac09f69160">
                <bpws:onMessage operation="get"
                    partnerLink="clusteraccesso"
                    portType="ns:clusteraccesso"
                    tibex:xpdlId="869957c5-3b3b-4933-921d-75111bc699cd" variable="get">
                    <bpws:scope name="scope1">
                        <bpws:faultHandlers>
