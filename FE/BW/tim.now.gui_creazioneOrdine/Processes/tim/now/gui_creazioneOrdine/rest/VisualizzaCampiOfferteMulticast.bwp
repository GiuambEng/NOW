                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0eebaa07-6ac9-4f42-94ee-39dc3743fc36+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaCampiOfferteMulticast&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;ClliFeederSucc-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;macroarea>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:descrArea)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:descrArea&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/macroarea>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;macroarea2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:descrArea)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:descrArea&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/macroarea2>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ClliFeederSucc-input"
                                    name="ClliFeederSucc"
                                    outputVariable="ClliFeederSucc"
                                    tibex:xpdlId="0eebaa07-6ac9-4f42-94ee-39dc3743fc36" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ClliFeederSuccToAssign4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0eebaa07-6ac9-4f42-94ee-39dc3743fc36+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaCampiOfferteMulticast&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;ClliFeederSucc-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;macroarea>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:descrArea)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:descrArea&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/macroarea>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;macroarea2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:descrArea)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:descrArea&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/macroarea2>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ACP.CODICE_CLLI_PDC, ACP.NOME_CENTRALE_PDC&#xa;FROM ANAG_CENTRALE_PDC ACP INNER JOIN ANAGRAFICA_ADR AA&#xa;ON ACP.ID_MACROAREA_CRMWS = AA.ID_ADR_CRMWS&#xa;WHERE ACP.STATO = 'ATTIVO' AND AA.TIPOLOGIA_ADR = 'MACROAREA' AND AA.DESCRIZIONE_AREA = ?&#xa;AND ACP.CODICE_CLLI_PDC NOT IN (&#xa;    SELECT DISTINCT ADA.VALOREATTRIBUTO&#xa;    FROM BDS_1_CASEDATA_ASSET A INNER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA &#xa;    ON A.IDASSET = ADA.IDASSET&#xa;    WHERE A.STATOASSET &lt;> 'CESSATO' AND A.OFFERTA = 'FEEDER' &#xa;    AND A.CODIFICAOLOAGCOM = ? AND ADA.NOMEATTRIBUTO IN ('CLLIFEEDERSUCCESSIVO','CLLIPRIMOFEEDER')&#xa;)&#xa;AND ACP.CODICE_CLLI_PDC NOT IN (&#xa;&#x9;SELECT DISTINCT VALOREATTRIBUTO&#xa;&#x9;FROM BDS_1_CASEDATA_ATTRIBTDTTGLRDN&#xa;&#x9;WHERE IDRICHIESTAOLO IN (&#xa;&#x9;SELECT DISTINCT IDRICHIESTAOLO &#xa;&#x9;&#x9;FROM BDS_1_CASEDATA_ATTRIBTDTTGLRDN&#xa;&#x9;&#x9;WHERE IDRICHIESTAOLO IN(&#xa;&#x9;&#x9;&#x9;&#x9;SELECT DISTINCT O.IDRICHIESTAOLO&#xa;&#x9;&#x9;&#x9;&#x9;FROM BDS_1_CASEDATA_ORDINE O INNER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLRDN ADO &#xa;&#x9;&#x9;&#x9;&#x9;&#x9;ON O.IDRICHIESTAOLO = ADO.IDRICHIESTAOLO INNER JOIN BDS_1_CASEDATA_RICHIESTA R&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;ON O.IDRICHIESTAOLO = R.IDRICHIESTAOLO&#xa;&#x9;&#x9;&#x9;&#x9;WHERE O.OFFERTA = 'FEEDER' AND O.CODIFICAOLOAGCOM = ? AND&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;R.STATORICHIESTANOW NOT IN ('SCARTATO','ESPLETAMENTOTECNICOKO','ANNULLATO','CHIUSO',&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;'FATTURAZIONEKO','ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','CHIUSOB2B') AND&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;R.TIPOLOGIASOTTOLAV = 'FEEDERSUCCESSIVO'&#xa;&#x9;&#x9;)AND NOMEATTRIBUTO = 'NOMEMACROAREA'&#xa;&#x9;&#x9;AND VALOREATTRIBUTO = ?&#xa;&#x9;)AND NOMEATTRIBUTO = 'CLLIFEEDERSUCCESSIVO'&#xa;)&#xa;ORDER BY ACP.CODICE_CLLI_PDC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="macroarea"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="macroarea2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom2"/>
                                    <columnMetadata
                                    columnName="CODICE_CLLI_PDC"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_CENTRALE_PDC"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="Assign3"
                                    outputVariable="Variable"
                                    tibex:xpdlId="b3631b9c-c2f5-4236-8650-282db81172f9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ClliPrimoFeederToAssign3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign3ToVisualizzaCampiOfferteMulticast_LogOutput"/>
                                    </bpws:sources>
