                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaCampiOfferteMulticast&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MacroAreaPrimo&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($MacroAreaPrimo/Record/DESCRIZIONE_AREA)>0&quot;>&lt;tns:outputVisualizzaCampiOfferteMulticast>&lt;xsl:for-each select=&quot;$MacroAreaPrimo/Record&quot;>&lt;tns:outputCampiOfferteMulticast>&lt;xsl:if test=&quot;DESCRIZIONE_AREA&quot;>&lt;tns:valoreCampo>&lt;xsl:value-of select=&quot;DESCRIZIONE_AREA&quot;/>&lt;/tns:valoreCampo>&lt;/xsl:if>&lt;/tns:outputCampiOfferteMulticast>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVisualizzaCampiOfferteMulticast>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVisualizzaCampiOfferteMulticast>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Attenzione, non esiste nessuna MacroArea senza Primo Feeder associato, non è possibile procedere con l’inserimento dell’ordine richiesto'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputVisualizzaCampiOfferteMulticast>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
