                                <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="Assign1"
                                    outputVariable="Variable"
                                    tibex:xpdlId="5add2add-7fbd-47aa-b277-e75d28e495c3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
