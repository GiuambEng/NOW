                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT VALOREATTRIBUTO&#xa;FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST&#xa;WHERE IDASSET IN(&#xa;    SELECT DISTINCT IDASSET &#xa;    FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST&#xa;    WHERE IDASSET IN(&#xa;            SELECT DISTINCT A.IDASSET&#xa;            FROM BDS_1_CASEDATA_ASSET A INNER JOIN BDS_1_CASEDATA_DETTAGLIOASSET DA ON A.IDASSET = DA.IDASSET&#xa;            INNER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON DA.IDASSET = ADA.IDASSET&#xa;            WHERE A.STATOASSET ='ATTIVO' AND A.OFFERTA = 'FEEDER' AND DA.NOMECOMPONENTE='ACCESSOFEEDER' AND&#xa;&#x9;&#x9;&#x9;A.CODIFICAOLOAGCOM = ? AND&#xa;            (ADA.NOMEATTRIBUTO = 'FLAGPRIMOFEEDER' AND ADA.VALOREATTRIBUTO = 'Y') &#xa;        )AND NOMEATTRIBUTO = 'NOMEMACROAREA' AND VALOREATTRIBUTO = ?&#xa;) AND NOMEATTRIBUTO = 'BANDA'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="macroarea"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
