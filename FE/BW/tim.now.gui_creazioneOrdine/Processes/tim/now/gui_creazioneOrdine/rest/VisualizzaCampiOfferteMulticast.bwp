                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1baa91b2-f5e2-4a4c-b272-5a837b609596+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaCampiOfferteMulticast&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;MacroAreaPrimo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom1>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT DESCRIZIONE_AREA&#xa;FROM ANAGRAFICA_ADR&#xa;WHERE DESCRIZIONE_AREA NOT IN(&#xa;    SELECT DISTINCT VALOREATTRIBUTO &#xa;    FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST&#xa;    WHERE IDASSET IN(&#xa;            SELECT DISTINCT A.IDASSET&#xa;            FROM BDS_1_CASEDATA_ASSET A INNER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA &#xa;            ON A.IDASSET = ADA.IDASSET&#xa;            WHERE A.STATOASSET &lt;> 'CESSATO' AND A.OFFERTA = 'FEEDER'  &#xa;&#x9;&#x9;&#x9;AND A.CODIFICAOLOAGCOM = ? AND&#xa;            (ADA.NOMEATTRIBUTO = 'FLAGPRIMOFEEDER' AND ADA.VALOREATTRIBUTO = 'Y')&#xa;        )AND NOMEATTRIBUTO = 'NOMEMACROAREA'&#xa;)&#xa;AND DESCRIZIONE_AREA NOT IN(&#xa;    SELECT DISTINCT VALOREATTRIBUTO &#xa;    FROM BDS_1_CASEDATA_ATTRIBTDTTGLRDN&#xa;    WHERE IDRICHIESTAOLO IN(&#xa;            SELECT DISTINCT O.IDRICHIESTAOLO&#xa;            FROM BDS_1_CASEDATA_ORDINE O INNER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLRDN ADO &#xa;                ON O.IDRICHIESTAOLO = ADO.IDRICHIESTAOLO INNER JOIN BDS_1_CASEDATA_RICHIESTA R&#xa;                ON O.IDRICHIESTAOLO = R.IDRICHIESTAOLO&#xa;            WHERE O.OFFERTA = 'FEEDER' AND O.CODIFICAOLOAGCOM = ? AND&#xa;                R.STATORICHIESTANOW NOT IN ('SCARTATO','ESPLETAMENTOTECNICOKO','ANNULLATO','CHIUSO',&#xa;                'FATTURAZIONEKO','ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','CHIUSOB2B') AND&#xa;                (ADO.NOMEATTRIBUTO = 'FLAGPRIMOFEEDER' AND ADO.VALOREATTRIBUTO = 'Y')&#xa;    )AND NOMEATTRIBUTO = 'NOMEMACROAREA'&#xa;)AND TIPOLOGIA_ADR='MACROAREA'&#xa;AND DESCRIZIONE_AREA NOT LIKE '%_CC'&#xa;AND DESCRIZIONE_AREA NOT LIKE '%_LIB'&#xa;ORDER BY DESCRIZIONE_AREA" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE_AREA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
