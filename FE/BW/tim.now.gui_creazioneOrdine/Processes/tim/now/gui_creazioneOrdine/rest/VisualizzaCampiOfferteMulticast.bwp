                                    sqlStatement="SELECT CAM.VALORE_ATTRIBUTO&#xa;FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM INNER JOIN TIPOLOG_CONTR_ATTR_MULTI TCA ON&#xa;CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = TCA.ID_TIPOLOG_CONTR_ATTR_MULTI&#xa;WHERE CAM.ID_CONTRATTO = ? AND CAM.DT_FINE_VALIDITA > SYSDATE &#xa;AND TCA.NOME_TIPOLOG_CONTR_ATTR_MULTI = 'IPSESSIONE'&#xa;ORDER BY CAM.VALORE_ATTRIBUTO" xsi:type="jdbcPalette:JDBCQueryActivity">

