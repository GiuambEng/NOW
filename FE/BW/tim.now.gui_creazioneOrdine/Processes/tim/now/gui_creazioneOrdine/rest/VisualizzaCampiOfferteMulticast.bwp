                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT DESCRIZIONE_AREA&#xa;FROM ANAGRAFICA_ADR&#xa;WHERE DESCRIZIONE_AREA IN(&#xa;    SELECT DISTINCT VALOREATTRIBUTO &#xa;    FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST&#xa;    WHERE IDASSET IN(&#xa;            SELECT DISTINCT A.IDASSET&#xa;            FROM BDS_1_CASEDATA_ASSET A INNER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA &#xa;            ON A.IDASSET = ADA.IDASSET&#xa;            WHERE A.STATOASSET ='ATTIVO' AND A.OFFERTA = 'FEEDER' AND A.CODIFICAOLOAGCOM = ? AND &#xa;            (ADA.NOMEATTRIBUTO = 'FLAGPRIMOFEEDER' AND ADA.VALOREATTRIBUTO = 'Y')&#xa;        )AND NOMEATTRIBUTO = 'NOMEMACROAREA'&#xa;)AND TIPOLOGIA_ADR='MACROAREA'&#xa;AND DESCRIZIONE_AREA NOT LIKE '%_CC'&#xa;AND DESCRIZIONE_AREA NOT LIKE '%_LIB'&#xa;ORDER BY DESCRIZIONE_AREA" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE_AREA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+288a4af0-c77f-425f-93bd-f2cc0ca2de6b+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaCampiOfferteMulticast&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;PrimoFeeder-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;codOloAgcom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:codOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:codOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOloAgcom>&lt;macroarea>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:descrArea)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaCampiOfferteMulticast/tns:descrArea&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/macroarea>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
