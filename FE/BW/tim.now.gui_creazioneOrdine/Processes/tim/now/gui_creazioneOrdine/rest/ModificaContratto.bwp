                                    DataTypeDisplayValue="VARCHAR" ParameterName="flagValido"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="dataFineValiditaContratto"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="timestampAggiornamento"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idContratto"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+168cf210-eccc-47c2-95a4-e225a85e8d76+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/ModificaContratto&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiornaDateFWA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;dataFineVal>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring-before($post/item/tns1:modificaContratto/tns1:modificaContrattoInput/tns1:dataFineAssociazioneOffertaContratto,&amp;quot;T&amp;quot;))&quot;/>&#xa;            &lt;/dataFineVal>&#xa;            &lt;timestampAggiornamento>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/timestampAggiornamento>&#xa;            &lt;idContratto>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($post/item/tns1:modificaContratto/tns1:modificaContrattoInput/tns1:idContratto)&quot;/>&#xa;            &lt;/idContratto>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="AggiornaDateFWA-input"
                                    name="AggiornaDateFWA"
                                    outputVariable="AggiornaDateFWA"
                                    tibex:xpdlId="168cf210-eccc-47c2-95a4-e225a85e8d76" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AggiornaDataFineValContrattoToAggiornaDateFWA"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AggiornaDateFWAToAssign1"/>
