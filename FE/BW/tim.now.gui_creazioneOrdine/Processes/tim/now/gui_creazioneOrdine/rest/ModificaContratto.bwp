                                    expression="if ($CountTipologie/Record[1]/COUNT = 0) then true() else if (($CountTipologie/Record[1]/COUNT > 0) and ($AggiornaDateFWA/noOfUpdates >0)) then true() else false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
