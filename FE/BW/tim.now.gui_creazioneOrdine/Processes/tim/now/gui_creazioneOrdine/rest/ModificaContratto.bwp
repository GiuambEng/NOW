                        &lt;/tns1:details&gt;
                    &lt;/tns1:result&gt;
                &lt;/tns1:outputModificaContratto&gt;
            &lt;/item&gt;
        &lt;/tns2:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
