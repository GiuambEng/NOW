                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($post/item/tns:modificaContratto/tns:modificaContrattoInput/tns:dataFineCoinvestimento)>0 or string-length($post/item/tns:modificaContratto/tns:modificaContrattoInput/tns:dataInizioCoinvestimento)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($post.item/tns:modificaContrattoInput/tns:dataFineCoinvestimento)>0 or string-length($post.item/tns:modificaContrattoInput/tns:dataInizioCoinvestimento)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CountBouquetToLocalTransaction2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="((string-length($post/item/tns:modificaContratto/tns:modificaContrattoInput/tns:contrattoFwaInfratel)>0) or (string-length($post/item/tns:modificaContratto/tns:modificaContrattoInput/tns:contrattoFwaPlus)>0) or (string-length($post/item/tns:modificaContratto/tns:modificaContrattoInput/tns:contrattoFwaDecommissioning)>0)) and not(tib:compare-date(xsd:date(substring-before($post/item/tns:modificaContratto/tns:modificaContrattoInput/tns:dataFineValiditaContratto,&quot;T&quot;)), xsd:date(substring-before(xsd:string(xsd:date($DettaglioContratto/Record[1]/DATAFI_VALID)), &quot;+&quot;))) != 0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[((string-length($post.item/tns:modificaContrattoInput/tns:contrattoFwaInfratel)>0) or (string-length($post.item/tns:modificaContrattoInput/tns:contrattoFwaPlus)>0) or (string-length($post.item/tns:modificaContrattoInput/tns:contrattoFwaDecommissioning)>0)) and not(tib:compare-date(xsd:date(substring-before($post.item/tns:modificaContrattoInput/tns:dataFineValiditaContratto,"T")), xsd:date(substring-before(xsd:string(xsd:date($DettaglioContratto/Record[1]/DATAFI_VALID)), "+"))) != 0)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CountBouquetToLocalTransaction1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
