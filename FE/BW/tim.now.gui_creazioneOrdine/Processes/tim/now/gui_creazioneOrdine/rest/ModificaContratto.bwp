                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CountBouquetToLocalTransaction">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="tib:compare-date(xsd:date(substring-before($post/item/tns:modificaContratto/tns:modificaContrattoInput/tns:dataFineValiditaContratto,&quot;T&quot;)), xsd:date(substring-before(xsd:string(xsd:date($DettaglioContratto/Record[1]/DATAFI_VALID)), &quot;+&quot;))) != 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[tib:compare-date(xsd:date(substring-before($post.item/tns:modificaContrattoInput/tns:dataFineValiditaContratto,"T")), xsd:date(substring-before(xsd:string(xsd:date($DettaglioContratto/Record[1]/DATAFI_VALID)), "+"))) != 0]]></bpws:transitionCondition>
