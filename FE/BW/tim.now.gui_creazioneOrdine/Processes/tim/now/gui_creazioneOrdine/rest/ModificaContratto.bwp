                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($post/item/tns:modificaContratto/tns:modificaContrattoInput/tns:bouquet)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
