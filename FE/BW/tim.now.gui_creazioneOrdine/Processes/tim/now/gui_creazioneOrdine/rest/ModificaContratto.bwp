                                    sqlStatement="UPDATE ASS_CONTR_TIPOLOG_CONTR_FWA&#xa;  SET DATA_FINE_VALIDITA = SYSDATE&#xa;  WHERE ID_CONTRATTO = ? AND ID_TIPOLOG_CONTR_FWA = 1" xsi:type="jdbcPalette:JDBCUpdateActivity">

