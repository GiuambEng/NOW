                                    <bpws:source linkName="AssignToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/ModificaContratto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AggiornaDataFineAssOfferta&quot;/>&lt;xsl:param name=&quot;AggiornaDataFineValContratto&quot;/>&lt;xsl:param name=&quot;AggiornaFlag&quot;/>&lt;xsl:param name=&quot;AggiornaDataFineValidContratto&quot;/>&lt;xsl:param name=&quot;AggiornaDataFineAssocOfferta&quot;/>&lt;xsl:param name=&quot;boolFineValidita&quot;/>&lt;xsl:param name=&quot;boolFineAssociazione&quot;/>&lt;xsl:param name=&quot;boolFlagFwa&quot;/>&lt;xsl:param name=&quot;boolDateCoinv&quot;/>&lt;xsl:param name=&quot;boolBouquet&quot;/>&lt;xsl:param name=&quot;boolSospensione&quot;/>&lt;xsl:param name=&quot;boolEmailFWAEOLO&quot;/>&lt;xsl:template name=&quot;ModificaContratto&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$AggiornaFlag/noOfUpdates>0 or ($AggiornaDataFineValidContratto/noOfUpdates >0 and $AggiornaDataFineAssocOfferta/noOfUpdates >0 and ($boolFineValidita = true())) or ($AggiornaDataFineAssOfferta/noOfUpdates >0 and $AggiornaDataFineValContratto/noOfUpdates >0 and ($boolFineAssociazione = true())) or ($boolFlagFwa = true()) or ($boolDateCoinv = true()) or ($boolBouquet = true()) or ($boolSospensione = true()) or ($boolEmailFWAEOLO=true())&quot;>&lt;tns1:outputModificaContratto>&lt;tns1:esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:esito>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:code>&lt;tns1:details>&lt;xsl:value-of select=&quot;&amp;quot;Modifica avvenuta con successo&amp;quot;&quot;/>&lt;/tns1:details>&lt;/tns1:result>&lt;/tns1:outputModificaContratto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:outputModificaContratto>&lt;tns1:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns1:esito>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:code>&lt;tns1:details>&lt;xsl:value-of select=&quot;&amp;quot;Modifica non avvenuta&amp;quot;&quot;/>&lt;/tns1:details>&lt;/tns1:result>&lt;/tns1:outputModificaContratto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
