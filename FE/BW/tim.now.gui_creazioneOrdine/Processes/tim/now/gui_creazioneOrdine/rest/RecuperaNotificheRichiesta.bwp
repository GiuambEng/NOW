                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns7=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperaNotificheRichiesta/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;get_RecuperaNotificheRichiesta_IngetLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperaNotificheRichiesta&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperaNotificheRichiesta&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputRecuperaNotificheRichiesta:&amp;quot;,tib:render-xml($get.parameters, true(),true()))&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;            &lt;tns6:ActiveLoggerServices>&#xa;                &lt;tns6:Envelope>&#xa;                    &lt;tns6:Identifier>&#xa;                        &lt;tns6:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperaNotificheRichiesta&amp;quot;&quot;/>&#xa;                        &lt;/tns6:ServiceName>&#xa;                        &lt;tns6:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Operation>&#xa;                        &lt;tns6:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns6:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns6:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID:&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID:&amp;quot;,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns6:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quo