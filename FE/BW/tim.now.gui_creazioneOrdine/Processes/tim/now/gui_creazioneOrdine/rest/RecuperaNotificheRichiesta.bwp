                                    <bpws:sources>
                                    <bpws:source linkName="AssignToget_RecuperaNotificheRichiesta_out_Log"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/RecuperaNotificheRichiesta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryDG_MKT_NEWS&quot;/>&lt;xsl:param name=&quot;QueryProfiliOlo&quot;/>&lt;xsl:param name=&quot;QueryPPS_GA&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($QueryProfiliOlo/Record[1]/ID_NOTF)) > 0&quot;>&lt;tns4:recuperaNotificheRichiestaOutput>&lt;xsl:for-each select=&quot;$QueryProfiliOlo/Record&quot;>&lt;tns4:outputRecuperaNotificheRichiesta>&lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&lt;tns4:tipologiaNotifica>&lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&lt;/tns4:tipologiaNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns4:causale>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns4:causale>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns4:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns4:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns4:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;TRACCIATO_FILE&quot;>&lt;tns4:notificaXML>&lt;xsl:value-of select=&quot;TRACCIATO_FILE&quot;/>&lt;/tns4:notificaXML>&lt;/xsl:if>&lt;tns4:ultimoFileNotifica>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns4:ultimoFileNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns4:dataInvioFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns4:dataInvioFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns4:dataInvioFile>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns4:dataInvioFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns4:outputRecuperaNotificheRichiesta>&lt;/xsl:for-each>&lt;tns4:result>&lt;tns4:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns4:severity>&lt;tns4:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns4:code>&lt;/tns4:result>&lt;/tns4:recuperaNotificheRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($QueryDG_MKT_NEWS/Record[1]/ID_NOTF)) > 0&quot;>&lt;tns4:recuperaNotificheRichiestaOutput>&lt;xsl:for-each select=&quot;$QueryDG_MKT_NEWS/Record&quot;>&lt;tns4:outputRecuperaNotificheRichiesta>&lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&lt;tns4:tipologiaNotifica>&lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&lt;/tns4:tipologiaNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns4:causale>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns4:causale>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns4:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns4:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns4:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;TRACCIATO_FILE&quot;>&lt;tns4:notificaXML>&lt;xsl:value-of select=&quot;TRACCIATO_FILE&quot;/>&lt;/tns4:notificaXML>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_FILE&quot;>&lt;tns4:ultimoFileNotifica>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns4:ultimoFileNotifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns4:dataInvioFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns4:dataInvioFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns4:dataInvioFile>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns4:dataInvioFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns4:outputRecuperaNotificheRichiesta>&lt;/xsl:for-each>&lt;tns4:result>&lt;tns4:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns4:severity>&lt;tns4:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns4:code>&lt;/tns4:result>&lt;/tns4:recuperaNotificheRichiestaOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($QueryPPS_GA/Record[1]/ID_NOTF)) > 0&quot;>&lt;tns4:recuperaNotificheRichiestaOutput>&lt;xsl:for-each select=&quot;$QueryPPS_GA/Record&quot;>&lt;tns4:outputRecuperaNotificheRichiesta>&lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&lt;tns4:tipologiaNotifica>&lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&lt;/tns4:tipologiaNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns4:causale>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns4:causale>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns4:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns4:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns4:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;TRACCIATO_FILE&quot;>&lt;tns4:notificaXML>&lt;xsl:value-of select=&quot;TRACCIATO_FILE&quot;/>&lt;/tns4:notificaXML>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_FILE&quot;>&lt;tns4:ultimoFileNotifica>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns4:ultimoFileNotifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns4:dataInvioFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns4:dataInvioFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns4:dataInvioFile>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns4:dataInvioFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns4:outputRecuperaNotificheRichiesta>&lt;/xsl:for-each>&lt;tns4:result>&lt;tns4:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns4:severity>&lt;tns4:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns4:code>&lt;/tns4:result>&lt;/tns4:recuperaNotificheRichiestaOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:recuperaNotificheRichiestaOutput>&lt;tns4:result>&lt;tns4:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns4:severity>&lt;tns4:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns4:code>&lt;tns4:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessuna notifica presente&amp;quot;&quot;/>&lt;/tns4:details>&lt;/tns4:result>&lt;/tns4:recuperaNotificheRichiestaOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bcd823ee-00b9-4718-999e-70ea6ff83e8d+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperaNotificheRichiesta/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiestaOlo>&#xa;            &lt;codAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:codAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:codAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom>&#xa;            &lt;codAgcom1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:codAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:codAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom1>&#xa;            &lt;codAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:codAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:codAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom2>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="QueryProfiliOlo-input"
                                    name="QueryProfiliOlo"
                                    outputVariable="QueryProfiliOlo"
                                    tibex:xpdlId="bcd823ee-00b9-4718-999e-70ea6ff83e8d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToQueryProfiliOlo"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bcd823ee-00b9-4718-999e-70ea6ff83e8d+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperaNotificheRichiesta/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiestaOlo>&#xa;            &lt;codAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:codAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:codAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom>&#xa;            &lt;codAgcom1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:codAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:codAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom1>&#xa;            &lt;codAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:codAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:codAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom2>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select  ID_FILE_PROCSTO_OUTPUT,TIMSTP_CREAZIONE,TRACCIATO_FILE, TIMSTP_INVIO, ID_NOTF,TIPOLG_NOTF, DESCR_CAUS_OLO,  NOME_FILE, CODFC_OLO_AGCOM&#xd;&#xa;from (&#xd;&#xa;SELECT FP.ID_FILE_PROCSTO_OUTPUT,   RN.TIMSTP_CREAZIONE,&#xd;&#xa;RN.TRACCIATO_FILE, PO.TIMSTP_INVIO, RN.ID_NOTF,&#xd;&#xa;TN.DESCR as TIPOLG_NOTF,CAU.DESCR_CAUS_OLO,P.NOME_FILE,RN.CODFC_OLO_AGCOM, dense_rank() over (partition by RN.ID_NOTF order by PO.TIMSTP_INVIO desc) as ord&#xd;&#xa;FROM appuser.RICH_ORDN_COMUNIC_NOTF RN &#xd;&#xa;LEFT JOIN appuser.FILE_NOTF_STANDARD FP ON  RN.ID_NOTF = FP.ID_NOTF&#xd;&#xa;LEFT JOIN appuser.FILE_PROCSTO_OUTPUT PO ON FP.ID_FILE_PROCSTO_OUTPUT = PO.ID_FILE_PROCSTO_OUTPUT &#xd;&#xa;LEFT JOIN appuser.TIPOLG_NOTF TN  ON  TN.COD_TIPOLG_NOTF = RN.COD_TIPOLG_NOTF AND TN.STRUTTURA_RICH = RN.STRUTTURA_RICH&#xd;&#xa;LEFT JOIN appuser.ANAG_CAUS CAU ON CAU.ID_ANAG_CAUS = RN.ID_ANAG_CAUS&#xd;&#xa;LEFT JOIN appuser.FILE_PROCSTO P ON P.ID_FILE = FP.ID_FILE_PROCSTO_OUTPUT&#xd;&#xa;LEFT JOIN appuser.TIPOLG_STNTF TNF ON TNF.IDTPLG_STNTF=RN.IDTPLG_STNTF_FLGIORN OR TNF.IDTPLG_STNTF=RN.IDTPLG_STNTF_FLMENS OR TNF.IDTPLG_STNTF=RN.IDTPLG_STNTF_FILE_ORARIO&#xd;&#xa;WHERE TNF.STNTF IN ('INVIATA','SOLO GUI','SOLO VIA EMAIL') &#xd;&#xa;AND RN.ID_RICH_OLO in ( select r1.idrichiestaolo&#xd;&#xa;from bds_1_casedata_richiesta r1&#xd;&#xa;inner join bds_1_casedata_richiesta r2 on (r1.codiceordineolotarget =r2.CODICEORDINETI or r1.codiceordineolotarget = r2.codiceordineolo)&#xd;&#xa;where r2.idrichiestaolo = ? and r1.statorichiestanow = 'SCARTATO' and r1.lavorazione ='ANNULLAMENTO')&#xd;&#xa;AND P.CODFC_OLO_AGCOM  IN (SELECT CODFC_OLO_AGCOM&#xd;&#xa;FROM appuser.OLO&#xd;&#xa;WHERE CODFC_OLO_AGCOM = ?&#xd;&#xa;OR COD_OLO_ACCORPANTE = ?&#xd;&#xa;OR COD_OLO = (SELECT COD_OLO FROM appuser.OLO WHERE CODFC_OLO_AGCOM = ?))&#xd;&#xa;ORDER BY RN.ID_NOTF, PO.TIMSTP_INVIO&#xd;&#xa;) where ord =1" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom2"/>
                                    <columnMetadata
                                    columnName="ID_FILE_PROCSTO_OUTPUT"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TRACCIATO_FILE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INVIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="ID_NOTF"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIPOLG_NOTF"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a1e7cfb8-a225-4edc-a82b-70c0aa63ba23+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperaNotificheRichiesta/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;QueryDG_MKT_NEWS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperanotificherichiestaGetParameters/tns1:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
