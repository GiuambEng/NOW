                                    sqlStatement="select  ID_FILE_PROCSTO_OUTPUT,TIMSTP_CREAZIONE,TRACCIATO_FILE, TIMSTP_INVIO, ID_NOTF,TIPOLG_NOTF, DESCR_CAUS_OLO,  NOME_FILE, CODFC_OLO_AGCOM&#xa;from (&#xa;SELECT FP.ID_FILE_PROCSTO_OUTPUT,   RN.TIMSTP_CREAZIONE,&#xa;RN.TRACCIATO_FILE, PO.TIMSTP_INVIO, RN.ID_NOTF,&#xa;TN.DESCR as TIPOLG_NOTF,CAU.DESCR_CAUS_OLO,P.NOME_FILE,RN.CODFC_OLO_AGCOM, dense_rank() over (partition by RN.ID_NOTF order by PO.TIMSTP_INVIO desc) as ord&#xa;FROM appuser.RICH_ORDN_COMUNIC_NOTF RN &#xa;LEFT JOIN appuser.FILE_NOTF_STANDARD FP ON  RN.ID_NOTF = FP.ID_NOTF&#xa;LEFT JOIN appuser.FILE_PROCSTO_OUTPUT PO ON FP.ID_FILE_PROCSTO_OUTPUT = PO.ID_FILE_PROCSTO_OUTPUT &#xa;LEFT JOIN appuser.TIPOLG_NOTF TN  ON  TN.COD_TIPOLG_NOTF = RN.COD_TIPOLG_NOTF AND TN.STRUTTURA_RICH = RN.STRUTTURA_RICH&#xa;LEFT JOIN appuser.ANAG_CAUS CAU ON CAU.ID_ANAG_CAUS = RN.ID_ANAG_CAUS&#xa;LEFT JOIN appuser.FILE_PROCSTO P ON P.ID_FILE = FP.ID_FILE_PROCSTO_OUTPUT&#xa;WHERE RN.ID_RICH_OLO in ( select r1.idrichiestaolo&#xa;from bds_1_casedata_richiesta r1&#xa;inner join bds_1_casedata_richiesta r2 on (r1.codiceordineolotarget =r2.CODICEORDINETI or r1.codiceordineolotarget = r2.codiceordineolo)&#xa;where r2.idrichiestaolo = ? and r1.statorichiestanow = 'SCARTATO' and r1.lavorazione ='ANNULLAMENTO') &#xa;ORDER BY RN.ID_NOTF, PO.TIMSTP_INVIO&#xa;) where ord =1" xsi:type="jdbcPalette:JDBCQueryActivity">

