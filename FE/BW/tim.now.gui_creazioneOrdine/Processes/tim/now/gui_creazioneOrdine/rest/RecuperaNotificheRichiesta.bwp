                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;get_RecuperaNotificheRichiesta_out_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperaNotificheRichiesta&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperaNotificheRichiesta&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns7:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns7:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputRecuperaNotificheRichiesta:&amp;quot;,substring(tib:render-xml($Variable, true(),true()),1,500),&amp;quot;.....&amp;quot;)&quot;/>&#xa;                &lt;/tns7:Payload>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;            &lt;tns7:ActiveLoggerServices>&#xa;                &lt;tns7:Envelope>&#xa;                    &lt;tns7:Identifier>&#xa;                        &lt;tns7:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperaNotificheRichiesta&amp;quot;&quot;/>&#xa;                        &lt;/tns7:ServiceName>&#xa;                        &lt;tns7:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Operation>&#xa;                        &lt;tns7:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns7:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns7:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID:&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID:&amp;quot;,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns7:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns7:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns7:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaNotificheRichiesta_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns7:EventType>&#xa;                        &lt;tns7:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaNotificheRichiesta_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns7:trackID>&#xa;                    &lt;/tns7:Identifier>&#xa;                    &lt;tns7:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns7:track_position>&#xa;                    &lt;tns7:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns7:Timestamp>&#xa;                &lt;/tns7:Envelope>&#xa;            &lt;/tns7:ActiveLoggerServices>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
