    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1469293436511"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/cmf/ComponenteProgressivo"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:nuovoOrdine" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="RichiestaOAO" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="RichiestaOAO" name="TracciatoFIberstream"/>
        <bpws:variable element="ns1:root" name="Variable"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToTracciatoOlo_ATTIVAZIONE"
                    tibex:label="ATTIVAZIONE" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToAssign_CESSAZIONE"
                    tibex:label="CESSAZIONE" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="AssignToEnd1" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToTracciatoOloAttivazione" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="29aae555-327c-48c9-88d1-67d13ed1bc09"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="0619889f-ad84-45e8-aa16-305d89230c8d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToEnd"/>
                        <bpws:target linkName="AssignToEnd1"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TracciatoFIberstream&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$TracciatoFIberstream&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TracciatoFIberstream"
                    name="TracciatoOloAttivazione"
                    outputVariable="TracciatoFIberstream"
                    tibex:xpdlId="b19ad919-4db8-44ce-a529-ab1029ae3e7d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToTracciatoOloAttivazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/OrdiniFiberstream&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;TracciatoFIberstream&quot; match=&quot;/&quot;>&lt;RichiestaOAO>&lt;Richiesta>&lt;Testata>&lt;CodiceOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&lt;/CodiceOperatore>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&lt;/CodiceOrdineOlo>&lt;xsl:if test=&quot;$Start/tns1:codiceProgetto&quot;>&lt;CodiceProgettoSpeciale>&lt;xsl:value-of select=&quot;$Start/tns1:codiceProgetto&quot;/>&lt;/CodiceProgettoSpeciale>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&lt;/Note>&lt;/xsl:if>&lt;/Testata>&lt;Ordine>&lt;Attivazione>&lt;Accesso>&lt;DataPrevistaAttivazione>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:dataPrevistaAttivazione), 9, 2),'/',substring(xsd:string($Start/tns1:dataPrevistaAttivazione), 6, 2),'/',substring(xsd:string($Start/tns1:dataPrevistaAttivazione), 1, 4))&quot;/>&lt;/DataPrevistaAttivazione>&lt;xsl:for-each select=&quot;$Start/tns1:datiReferenti&quot;>&lt;DatiReferente>&lt;Progressivo>&lt;xsl:value-of select=&quot;tns1:progressivoReferente&quot;/>&lt;/Progressivo>&lt;QualificaRef>&lt;xsl:value-of select=&quot;tns1:qualifica&quot;/>&lt;/QualificaRef>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;tns1:cognome&quot;/>&lt;/CognomeReferente>&lt;NomeReferente>&lt;xsl:value-of select=&quot;tns1:nome&quot;/>&lt;/NomeReferente>&lt;xsl:if test=&quot;string-length(tns1:telefonoFisso)>0&quot;>&lt;xsl:if test=&quot;tns1:telefonoFisso&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;tns1:telefonoFisso&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(tns1:cellulare)>0&quot;>&lt;xsl:if test=&quot;tns1:cellulare&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;tns1:cellulare&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(tns1:email)>0&quot;>&lt;xsl:if test=&quot;tns1:email&quot;>&lt;EmailReferente>&lt;xsl:value-of select=&quot;tns1:email&quot;/>&lt;/EmailReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;/DatiReferente>&lt;/xsl:for-each>&lt;xsl:if test=&quot;exists($Start/tns1:datiReferentiOnField)&quot;>&lt;DatiReferenteOnField>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferentiOnField/tns1:cognomeOnField&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;$Start/tns1:datiReferentiOnField/tns1:nomeOnField&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferentiOnField/tns1:nomeOnField&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiReferentiOnField/tns1:telefonoFissoOnField&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferentiOnField/tns1:telefonoFissoOnField&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiReferentiOnField/tns1:cellulareOnField&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferentiOnField/tns1:cellulareOnField&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;/DatiReferenteOnField>&lt;/xsl:if>&lt;DatiCliente>&lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;>&lt;NomeCliente>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;/>&lt;/NomeCliente>&lt;/xsl:if>&lt;CognomeCliente>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;/>&lt;/CognomeCliente>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:datiClienteFinale/tns1:cf)&quot;>&lt;Cf>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;/>&lt;/Cf>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns1:datiClienteFinale/tns1:p_iva)&quot;>&lt;Piva>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;/>&lt;/Piva>&lt;/xsl:when>&lt;/xsl:choose>&lt;/DatiCliente>&lt;DatiSede>&lt;ParticellaToponomastica>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;/>&lt;/ParticellaToponomastica>&lt;Via>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo&quot;/>&lt;/Via>&lt;Civico>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;/>&lt;/Civico>&lt;Localita>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:localita&quot;/>&lt;/Localita>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:cap&quot;>&lt;CAP>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:cap&quot;/>&lt;/CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:complesso&quot;>&lt;Complesso>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:complesso&quot;/>&lt;/Complesso>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:scala&quot;>&lt;Scala>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:scala&quot;/>&lt;/Scala>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:piano&quot;>&lt;Piano>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:piano&quot;/>&lt;/Piano>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:interno&quot;>&lt;Interno>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:interno&quot;/>&lt;/Interno>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:provincia&quot;>&lt;CodiceIstatIndirizzo>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:provincia&quot;/>&lt;/CodiceIstatIndirizzo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:codiceEgon&quot;>&lt;CodiceEGON>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:codiceEgon&quot;/>&lt;/CodiceEGON>&lt;/xsl:if>&lt;CodiceComune>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:codiceComune&quot;/>&lt;/CodiceComune>&lt;IdentificativoDelPOP>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:identificativoDelPOP&quot;/>&lt;/IdentificativoDelPOP>&lt;/DatiSede>&lt;DatiTecnici>&lt;Profilo>&lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key='PROFILOTECNICOLINEA']/tns1:valore&quot;/>&lt;/Profilo>&lt;xsl:for-each select=&quot;$Variable/tns3:root&quot;>&lt;xsl:variable name=&quot;currprogressivo&quot; select=&quot;current()/tns3:progressivo&quot;/>&lt;xsl:variable name=&quot;currcomponente&quot; select=&quot;current()/tns3:componente&quot;/>&lt;UserVlan>&lt;ServiceVlan>&lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneInferiore[tns1:key = 'SERVICEVLAN'&amp;#xD;&amp;#xA; and tns1:componente=$currcomponente and tns1:progressivo=$currprogressivo]/tns1:valore&quot;/>&lt;/ServiceVlan>&lt;UserVlan>&lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneInferiore[tns1:key = 'USERVLAN'&amp;#xD;&amp;#xA; and tns1:componente=$currcomponente and tns1:progressivo=$currprogressivo]/tns1:valore&quot;/>&lt;/UserVlan>&lt;ProfiloVlan>&lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneInferiore[tns1:key = 'PROFILOVLAN'&amp;#xD;&amp;#xA; and tns1:componente=$currcomponente and tns1:progressivo=$currprogressivo]/tns1:valore&quot;/>&lt;/ProfiloVlan>&lt;CustomerVlan>&lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneInferiore[tns1:key = 'CUSTOMERVLAN'&amp;#xD;&amp;#xA; and tns1:componente=$currcomponente and tns1:progressivo=$currprogressivo]/tns1:valore&quot;/>&lt;/CustomerVlan>&lt;/UserVlan>&lt;/xsl:for-each>&lt;/DatiTecnici>&lt;xsl:for-each select=&quot;$Start/tns1:datiServiziAggiuntivi&quot;>&lt;ServizioAggiuntivo>&lt;NomeServizio>&lt;xsl:value-of select=&quot;tns1:nomeServizio&quot;/>&lt;/NomeServizio>&lt;InformazioniServizio>&lt;xsl:value-of select=&quot;tns1:informazioniServizio&quot;/>&lt;/InformazioniServizio>&lt;VincoloServizio>&lt;xsl:value-of select=&quot;tns1:vincoloServizio&quot;/>&lt;/VincoloServizio>&lt;xsl:for-each select=&quot;tns1:apparati&quot;>&lt;Apparato>&lt;TipologiaApparato>&lt;xsl:value-of select=&quot;tns1:tipologiaApparato&quot;/>&lt;/TipologiaApparato>&lt;xsl:if test=&quot;tns1:passwordApparato&quot;>&lt;PasswordApparato>&lt;xsl:value-of select=&quot;tns1:passwordApparato&quot;/>&lt;/PasswordApparato>&lt;/xsl:if>&lt;CodiceApparato>&lt;xsl:value-of select=&quot;tns1:codiceApparato&quot;/>&lt;/CodiceApparato>&lt;AzioneApparato>&lt;xsl:value-of select=&quot;tns1:azioneApparato&quot;/>&lt;/AzioneApparato>&lt;QTAApparato>&lt;xsl:value-of select=&quot;xsd:int(tns1:qtaApparato)&quot;/>&lt;/QTAApparato>&lt;xsl:if test=&quot;tns1:causale&quot;>&lt;Causale>&lt;xsl:value-of select=&quot;tns1:causale&quot;/>&lt;/Causale>&lt;/xsl:if>&lt;/Apparato>&lt;/xsl:for-each>&lt;/ServizioAggiuntivo>&lt;/xsl:for-each>&lt;/Accesso>&lt;/Attivazione>&lt;/Ordine>&lt;/Richiesta>&lt;/RichiestaOAO>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TracciatoFIberstream" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TracciatoFIberstream"
                    name="TracciatoOloCessazione"
                    outputVariable="TracciatoFIberstream"
                    tibex:xpdlId="772d7cee-9d18-4f00-b1b6-a8b311a1e67e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAssign_CESSAZIONE"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/OrdiniFiberstream&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;TracciatoFIberstream&quot; match=&quot;/&quot;>&lt;RichiestaOAO>&lt;Richiesta>&lt;Testata>&lt;CodiceOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&lt;/CodiceOperatore>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&lt;/CodiceOrdineOlo>&lt;xsl:if test=&quot;$Start/tns1:codiceProgetto&quot;>&lt;CodiceProgettoSpeciale>&lt;xsl:value-of select=&quot;$Start/tns1:codiceProgetto&quot;/>&lt;/CodiceProgettoSpeciale>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&lt;/Note>&lt;/xsl:if>&lt;/Testata>&lt;Ordine>&lt;Cessazione>&lt;Accesso>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&lt;/IDRisorsa>&lt;/Accesso>&lt;/Cessazione>&lt;/Ordine>&lt;/Richiesta>&lt;/RichiestaOAO>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TracciatoFIberstream" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="2bab5bbb-f709-48a8-a85c-ac839b497d28">
                <bpws:targets>
                    <bpws:target linkName="StartToEnd"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToTracciatoOlo_ATTIVAZIONE">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:tipologiaLavorazione='ATTIVAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:tipologiaLavorazione='ATTIVAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign_CESSAZIONE">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Variable"
                    name="Assign" outputVariable="Variable"
                    tibex:xpdlId="3ee02192-3f18-4e55-b94c-15e883b5d9ee" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToTracciatoOlo_ATTIVAZIONE"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToTracciatoOloAttivazione"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:tns1=&quot;http://www.example.org/OrdiniFiberstream&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:root>&#xa;            &lt;xsl:for-each-group select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneInferiore&quot; group-by=&quot;concat(tns1:componente, tns1:progressivo)&quot;>&#xa;                &lt;xsl:if test=&quot;exists(tns1:componente)&quot;>&#xa;                    &lt;tns3:root>&#xa;                        &lt;tns3:componente>&#xa;                            &lt;xsl:value-of select=&quot;tns1:componente&quot;/>&#xa;                        &lt;/tns3:componente>&#xa;                        &lt;tns3:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;tns1:progressivo&quot;/>&#xa;                        &lt;/tns3:progressivo>&#xa;                    &lt;/tns3:root>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:for-each-group>&#xa;        &lt;/tns3:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
