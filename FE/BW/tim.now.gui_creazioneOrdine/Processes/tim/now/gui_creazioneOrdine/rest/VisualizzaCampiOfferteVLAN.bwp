                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if ($post/item/ns3:inputRecuperaCodiceTdKit/ns3:supermacroarea = &quot;Consegna su CAR di MAdR 'SUPERMACROAREA'&quot;) then &quot; AND AA.DESCRIZIONE_AREA = 'SUPERMACROAREA' &quot; else if ($post/item/ns3:inputRecuperaCodiceTdKit/ns3:supermacroarea = &quot;Consegna su CAR di MAdR 'SUPERMACROAREA CC'&quot;) then &quot;  AND AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_CC' &quot; else if ($post/item/ns3:inputRecuperaCodiceTdKit/ns3:supermacroarea = &quot;Consegna su CAR di MAdR 'SUPERMACROAREA LIB'&quot;) then &quot;  AND AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_LIB' &quot; else if ((($post/item/ns3:inputRecuperaCodiceTdKit/ns3:supermacroarea = &quot;Consegna su CAR di MAdR reale&quot;) or (string-length($post/item/ns3:inputRecuperaCodiceTdKit/ns3:supermacroarea)=0)) and (string-length($post/item/ns3:inputRecuperaCodiceTdKit/ns3:ccLib)=0)) then '' else if ($post/item/ns3:inputRecuperaCodiceTdKit/ns3:ccLib = 'CC') then &quot; AND AA.DESCRIZIONE_AREA LIKE '%_CC' AND AA.DESCRIZIONE_AREA &lt;> 'SUPERMACROAREA_CC' &quot; else &quot;  AND AA.DESCRIZIONE_AREA LIKE '%_LIB' AND AA.DESCRIZIONE_AREA &lt;> 'SUPERMACROAREA_LIB' &quot;"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="descrArea"
                                    name="DescrArea"
                                    outputVariable="descrArea"
                                    tibex:xpdlId="efe1b3d7-fefc-4169-8e44-26141a82bc34" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
