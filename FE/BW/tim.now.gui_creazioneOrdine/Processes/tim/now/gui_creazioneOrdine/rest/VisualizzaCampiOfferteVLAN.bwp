                                    sqlStatement="SELECT DISTINCT AA.DESCRIZIONE_AREA,AA.ID_ADR_CRMWS&#xa;FROM ANAGRAFICA_ADR AA INNER JOIN ANAG_CENTRALE_PDC ACP ON AA.ID_ADR_CRMWS = ACP.ID_MACROAREA_CRMWS INNER JOIN ANAGRAFICA_KIT_VLAN AKV ON ACP.CODICE_CLLI_PDC  = AKV.CLLI&#xa;WHERE AKV.CODICE_KIT = ? &#xa;ORDER BY AA.DESCRIZIONE_AREA ASC" xsi:type="jdbcPalette:JDBCQueryActivity">

