                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (($post/item/ns3:inputRecuperaCodiceTdKit/ns3:idOfferta = '62') or ((($post/item/ns3:inputRecuperaCodiceTdKit/ns3:supermacroarea = 'Consegna su CAR di MAdR reale') or (string-length($post/item/ns3:inputRecuperaCodiceTdKit/ns3:supermacroarea) = 0)) and (string-length($post/item/ns3:inputRecuperaCodiceTdKit/ns3:ccLib)=0))) then '' else if ($post/item/ns3:inputRecuperaCodiceTdKit/ns3:idOfferta = '63') then &quot; AND AKVAC.NOME_AGGREGATO LIKE 'Aggregato GBE%' &quot; else if ($post/item/ns3:inputRecuperaCodiceTdKit/ns3:famigliaVlan = 'VLAN MonoCoS Banda Condivisa') then &quot; AND AKVAC.NOME_AGGREGATO LIKE 'Aggregato NGA%' &quot; else if ($post/item/ns3:inputRecuperaCodiceTdKit/ns3:famigliaVlan = 'VLAN MultiCoS Banda Condivisa' and (string-length($post/item/ns3:inputRecuperaCodiceTdKit/ns3:bmcLight)>0)) then &quot; AND AKVAC.NOME_AGGREGATO = 'Aggregato NGA BMC Light' &quot; else  if ($post/item/ns3:inputRecuperaCodiceTdKit/ns3:famigliaVlan = 'VLAN MultiCoS Banda Condivisa') then &quot; AND AKVAC.NOME_AGGREGATO = 'Aggregato NGA BMC' &quot; else &quot; AND AKVAC.NOME_AGGREGATO = 'Aggregato NGA BMD' &quot;"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="nomeAggregato"
                                    name="NomeAggregato"
                                    outputVariable="nomeAggregato"
                                    tibex:xpdlId="7c3c5c09-af98-4191-b3ba-af921c9683b6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign3ToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="NomeAggregatoToTrascCos"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (($post.item/ns3:idOfferta = '62') or ((($post.item/ns3:supermacroarea = 'Consegna su CAR di MAdR reale') or (string-length($post.item/ns3:supermacroarea) = 0)) and (string-length($post.item/ns3:ccLib)=0))) then '' else if ($post.item/ns3:idOfferta = '63') then &quot; AND AKVAC.NOME_AGGREGATO LIKE 'Aggregato GBE%' &quot; else if ($post.item/ns3:famigliaVlan = 'VLAN MonoCoS Banda Condivisa') then &quot; AND AKVAC.NOME_AGGREGATO LIKE 'Aggregato NGA%' &quot; else if ($post.item/ns3:famigliaVlan = 'VLAN MultiCoS Banda Condivisa' and (string-length($post.item/ns3:bmcLight)>0)) then &quot; AND AKVAC.NOME_AGGREGATO = 'Aggregato NGA BMC Light' &quot; else  if ($post.item/ns3:famigliaVlan = 'VLAN MultiCoS Banda Condivisa') then &quot; AND AKVAC.NOME_AGGREGATO = 'Aggregato NGA BMC' &quot; else &quot; AND AKVAC.NOME_AGGREGATO = 'Aggregato NGA BMD' &quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
