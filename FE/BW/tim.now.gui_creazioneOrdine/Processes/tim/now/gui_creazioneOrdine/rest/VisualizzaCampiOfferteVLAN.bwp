                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable2&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaMacroarea_LogOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperaMacroarea&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperaMacroarea&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;xsl:if test=&quot;$post1.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns1:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post1.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns1:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputRecuperaMacroarea:&amp;quot;,tib:render-xml($Variable2, true(),true()))&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperaMacroarea&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;xsl:if test=&quot;$post1.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns1:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post1.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns1:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post1.httpHeaders/GUI-SID,$post1.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns1:EventID>&#xa;                        &lt;xsl:if test=&quot;$post1.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns1:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post1.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns1:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaMacroarea_&amp;quot;,$post1.httpHeaders/GUI-SID,&amp;quot;COMPLETE&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaMacroarea_&amp;quot;,$post1.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
