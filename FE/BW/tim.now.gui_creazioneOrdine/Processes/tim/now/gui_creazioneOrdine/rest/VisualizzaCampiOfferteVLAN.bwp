                                    sqlStatement="SELECT MODELLO_KIT&#xa;  FROM ANAGRAFICA_KIT_VLAN&#xa;  WHERE CODICE_KIT = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

