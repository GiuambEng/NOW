       &lt;tns:outputRecuperaMacroarea>&#xa;                    &lt;xsl:for-each select=&quot;$Query2Caso4/Record&quot;>&#xa;                        &lt;tns:listaMacroaree>&#xa;                            &lt;tns:descrizioneArea>&#xa;                                &lt;xsl:value-of select=&quot;NOME_MACRO_AREA&quot;/>&#xa;                            &lt;/tns:descrizioneArea>&#xa;                            &lt;tns:idAdrCrmws>&#xa;                                &lt;xsl:value-of select=&quot;ID_ADR_CRMWS&quot;/>&#xa;                            &lt;/tns:idAdrCrmws>&#xa;                        &lt;/tns:listaMacroaree>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputRecuperaMacroarea>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputRecuperaMacroarea>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun record trovato.'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputRecuperaMacroarea>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt