                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+930c9913-3af5-4c18-aa4f-e06f0033a766+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VisualizzaCampiOfferteVLAN&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputRecuperaCodiceTdKit/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputRecuperaCodiceTdKit/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;tdKitAsset1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputRecuperaCodiceTdKit/tns:codiceTdKitAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputRecuperaCodiceTdKit/tns:codiceTdKitAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tdKitAsset1>&#xa;            &lt;tdKitAsset2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputRecuperaCodiceTdKit/tns:codiceTdKitAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputRecuperaCodiceTdKit/tns:codiceTdKitAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tdKitAsset2>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
