                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VisualizzaCampiOfferteVLAN&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperaArea&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperaArea/unknownResultset/row/column/name)>0&quot;>&lt;tns:outputVisualizzaCampiOfferteVLAN>&lt;xsl:for-each select=&quot;$RecuperaArea/unknownResultset/row&quot;>&lt;tns:outputCampiOfferteVLAN>&lt;xsl:if test=&quot;not((string(column[name = 'DESCRIZIONE_AREA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'DESCRIZIONE_AREA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'DESCRIZIONE_AREA']/value)&quot;>&lt;tns:area>&lt;xsl:value-of select=&quot;column[name = 'DESCRIZIONE_AREA']/value&quot;/>&lt;/tns:area>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name = 'ID_ADR_CRMWS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'ID_ADR_CRMWS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'ID_ADR_CRMWS']/value)&quot;>&lt;tns:idArea>&lt;xsl:value-of select=&quot;column[name = 'ID_ADR_CRMWS']/value&quot;/>&lt;/tns:idArea>&lt;/xsl:if>&lt;/tns:outputCampiOfferteVLAN>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVisualizzaCampiOfferteVLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVisualizzaCampiOfferteVLAN>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputVisualizzaCampiOfferteVLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
