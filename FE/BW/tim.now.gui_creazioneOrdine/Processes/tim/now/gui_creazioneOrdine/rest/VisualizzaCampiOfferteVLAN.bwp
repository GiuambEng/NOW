                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT AKV.CODICE_KIT AS CODICEKIT,&#xa;                AKV.CLLI AS CLLI,&#xa;                AKV.MODELLO_KIT AS MODELLOKIT&#xa;FROM ANAGRAFICA_KIT_VLAN AKV&#xa;WHERE AKV.STATO IN ('Active',&#xa;                    'Temporary')&#xa;  AND AKV.CODIFICA_OLO_AGCOM = ?&#xa;  AND AKV.CODICE_KIT &lt;> ?&#xa;  AND AKV.MODELLO_KIT =&#xa;    (SELECT DISTINCT MODELLO_KIT&#xa;     FROM ANAGRAFICA_KIT_VLAN&#xa;     WHERE CODICE_KIT = ?)&#xa;ORDER BY AKV.CODICE_KIT ASC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tdKitAsset1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tdKitAsset2"/>
                                    <columnMetadata
                                    columnName="CODICEKIT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CLLI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="MODELLOKIT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
