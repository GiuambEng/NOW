                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if ((($post/item/ns3:inputRecuperaCodiceTdKit/ns3:supermacroarea = 'Consegna su CAR di MAdR reale') or (string-length($post/item/ns3:inputRecuperaCodiceTdKit/ns3:supermacroarea) = 0)) and (string-length($post/item/ns3:inputRecuperaCodiceTdKit/ns3:ccLib)=0)) then '' else &quot; INNER JOIN ANAGRAFICA_KIT_VLAN_ADR_CAR AKVAC ON AKV.CODICE_KIT = AKVAC.CODICE_KIT INNER JOIN ANAGRAFICA_ADR AA ON AA.ID_ADR_CRMWS = AKVAC.ID_ADR_CRMWS &quot;"
