                                <bpws:scope name="scope4">
                                    <bpws:flow name="flow4">
                                    <bpws:links>
                                    <bpws:link
                                    name="CallProcess3ToReply1" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;get1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:template name=&quot;get_VisualizzaNumeriCondivisori_ErrorLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaNumeriCondivisori&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzaNumeriCondivisori&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorVisualizzaNumeriCondivisori:&amp;quot;,tib:render-xml($FaultDetails1, true(),true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzaNumeriCondivisori&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get1/httpHeaders/tns1:httpHeaders/GUI-SID,$get1/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                           