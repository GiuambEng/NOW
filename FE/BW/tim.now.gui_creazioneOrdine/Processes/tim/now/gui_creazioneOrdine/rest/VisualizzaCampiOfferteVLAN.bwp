                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c46fbd9c-5a34-4f3e-80e7-9a33077655e5+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;join&quot;/>&#xa;    &lt;xsl:param name=&quot;tipologiaCos&quot;/>&#xa;    &lt;xsl:param name=&quot;lastBlock&quot;/>&#xa;    &lt;xsl:param name=&quot;descrArea&quot;/>&#xa;    &lt;xsl:param name=&quot;modelloKit&quot;/>&#xa;    &lt;xsl:param name=&quot;nomeAggregato&quot;/>&#xa;    &lt;xsl:param name=&quot;famigliaKit&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoTdKit-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;select distinct AKV.CODICE_KIT AS CODICEKIT,AKV.CLLI AS CLLI,AKV.MODELLO_KIT AS MODELLOKIT from ANAGRAFICA_KIT_VLAN AKV &amp;quot;,$join,&amp;quot; where AKV.STATO IN ('Active','Temporary') &amp;quot;,$descrArea,$nomeAggregato,$tipologiaCos,$famigliaKit,$lastBlock,$modelloKit,&amp;quot; order by AKV.CODICE_KIT asc&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns1:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
