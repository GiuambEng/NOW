                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperaMacroareaToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c4a22828-fd83-4f0d-92dd-161ff64f337a+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaCampiOfferteVLAN/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaMacroarea-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codiceKit>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:valoreCampo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:valoreCampo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codiceKit>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT distinct AA.descrizione_area, AA.id_adr_crmws&#xa;  FROM ANAGRAFICA_ADR AA INNER JOIN ANAGRAFICA_KIT_VLAN_ADR_CAR AKV &#xa;    ON AA.ID_ADR_CRMWS=AKV.ID_ADR_CRMWS&#xa;  where AA.tipologia_adr = 'MACROAREA' AND AKV.CODICE_KIT=?&#xa;  order by descrizione_area asc" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codiceKit"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE_AREA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_ADR_CRMWS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VisualizzaCampiOfferteVLAN&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaCampiOfferteVLAN/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperaMacroareaMadr&quot;/>&lt;xsl:param name=&quot;RecuperaMacroAreaAdr&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperaMacroareaMadr/Record) and string-length($RecuperaMacroareaMadr/Record[1]/DESCRIZIONE_AREA) > 0 and $get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:idOfferta = ('62','63')&quot;>&lt;tns:outputVisualizzaCampiOfferteVLAN>&lt;xsl:for-each select=&quot;$RecuperaMacroareaMadr/Record&quot;>&lt;xsl:if test=&quot;not(ends-with(DESCRIZIONE_AREA, '_CC') or (ends-with(DESCRIZIONE_AREA, '_LIB')))&quot;>&lt;tns:outputCampiOfferteVLAN>&lt;xsl:if test=&quot;DESCRIZIONE_AREA&quot;>&lt;tns:macroarea>&lt;xsl:value-of select=&quot;DESCRIZIONE_AREA&quot;/>&lt;/tns:macroarea>&lt;/xsl:if>&lt;tns:idMacroarea>&lt;xsl:value-of select=&quot;ID_ADR_CRMWS&quot;/>&lt;/tns:idMacroarea>&lt;/tns:outputCampiOfferteVLAN>&lt;/xsl:if>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVisualizzaCampiOfferteVLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($RecuperaMacroareaMadr/Record) and string-length($RecuperaMacroareaMadr/Record[1]/DESCRIZIONE_AREA) > 0 &quot;>&lt;tns:outputVisualizzaCampiOfferteVLAN>&lt;xsl:for-each select=&quot;$RecuperaMacroareaMadr/Record&quot;>&lt;tns:outputCampiOfferteVLAN>&lt;xsl:if test=&quot;DESCRIZIONE_AREA&quot;>&lt;tns:macroarea>&lt;xsl:value-of select=&quot;DESCRIZIONE_AREA&quot;/>&lt;/tns:macroarea>&lt;/xsl:if>&lt;tns:idMacroarea>&lt;xsl:value-of select=&quot;ID_ADR_CRMWS&quot;/>&lt;/tns:idMacroarea>&lt;/tns:outputCampiOfferteVLAN>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVisualizzaCampiOfferteVLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($RecuperaMacroAreaAdr/Record) and string-length($RecuperaMacroAreaAdr/Record[1]/DESCRIZIONE_AREA) > 0 and $get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:idOfferta = ('62','63')&quot;>&lt;tns:outputVisualizzaCampiOfferteVLAN>&lt;xsl:for-each select=&quot;$RecuperaMacroAreaAdr/Record&quot;>&lt;xsl:if test=&quot;not(ends-with(DESCRIZIONE_AREA, '_CC') or (ends-with(DESCRIZIONE_AREA, '_LIB')))&quot;>&lt;tns:outputCampiOfferteVLAN>&lt;xsl:if test=&quot;DESCRIZIONE_AREA&quot;>&lt;tns:macroarea>&lt;xsl:value-of select=&quot;DESCRIZIONE_AREA&quot;/>&lt;/tns:macroarea>&lt;/xsl:if>&lt;tns:idMacroarea>&lt;xsl:value-of select=&quot;ID_ADR_CRMWS&quot;/>&lt;/tns:idMacroarea>&lt;/tns:outputCampiOfferteVLAN>&lt;/xsl:if>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVisualizzaCampiOfferteVLAN>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($RecuperaMacroAreaAdr/Record) and string-length($RecuperaMacroAreaAdr/Record[1]/DESCRIZIONE_AREA) > 0&quot;>&lt;tns:outputVisualizzaCampiOfferteVLAN>&lt;xsl:for-each select=&quot;$RecuperaMacroareaMadr/Record&quot;>&lt;xsl:if test=&quot;not(ends-with(DESCRIZIONE_AREA, '_CC') or (ends-with(DESCRIZIONE_AREA, '_LIB')))&quot;>&lt;tns:outputCampiOfferteVLAN>&lt;xsl:if test=&quot;DESCRIZIONE_AREA&quot;>&lt;tns:macroarea>&lt;xsl:value-of select=&quot;DESCRIZIONE_AREA&quot;/>&lt;/tns:macroarea>&lt;/xsl:if>&lt;tns:idMacroarea>&lt;xsl:value-of select=&quot;ID_ADR_CRMWS&quot;/>&lt;/tns:idMacroarea>&lt;/tns:outputCampiOfferteVLAN>&lt;/xsl:if>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVisualizzaCampiOfferteVLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVisualizzaCampiOfferteVLAN>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputVisualizzaCampiOfferteVLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Variable"
                                    name="AssignMacroarea"
                                    outputVariable="Variable"
                                    tibex:xpdlId="75ad4178-2a10-45e7-a794-ee0d113ecc2f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RecuperaMacroareaToAssign"/>
                                    <bpws:target linkName="RecuperaMacroAreaAdrToAssignMacroarea"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToget_visualizzaCampiOfferteVLAN_outLog"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VisualizzaCampiOfferteVLAN&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaCampiOfferteVLAN/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaMacroareaMadr&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaMacroAreaAdr&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($RecuperaMacroareaMadr/Record) and string-length($RecuperaMacroareaMadr/Record[1]/DESCRIZIONE_AREA) > 0 and $get.parameters/tns1:idOfferta = ('62','63')&quot;>&#xa;                &lt;tns:outputVisualizzaCampiOfferteVLAN>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperaMacroareaMadr/Record&quot;>&#xa;                        &lt;xsl:if test=&quot;not(ends-with(DESCRIZIONE_AREA, '_CC') or (ends-with(DESCRIZIONE_AREA, '_LIB')))&quot;>&#xa;                            &lt;tns:outputCampiOfferteVLAN>&#xa;                                &lt;xsl:if test=&quot;DESCRIZIONE_AREA&quot;>&#xa;                                    &lt;tns:macroarea>&#xa;                                        &lt;xsl:value-of select=&quot;DESCRIZIONE_AREA&quot;/>&#xa;                                    &lt;/tns:macroarea>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns:idMacroarea>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ADR_CRMWS&quot;/>&#xa;                                &lt;/tns:idMacroarea>&#xa;                            &lt;/tns:outputCampiOfferteVLAN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputVisualizzaCampiOfferteVLAN>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($RecuperaMacroareaMadr/Record) and string-length($RecuperaMacroareaMadr/Record[1]/DESCRIZIONE_AREA) > 0 &quot;>&#xa;                &lt;tns:outputVisualizzaCampiOfferteVLAN>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperaMacroareaMadr/Record&quot;>&#xa;                        &lt;tns:outputCampiOfferteVLAN>&#xa;                            &lt;xsl:if test=&quot;DESCRIZIONE_AREA&quot;>&#xa;                                &lt;tns:macroarea>&#xa;                                    &lt;xsl:value-of select=&quot;DESCRIZIONE_AREA&quot;/>&#xa;                                &lt;/tns:macroarea>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:idMacroarea>&#xa;                                &lt;xsl:value-of select=&quot;ID_ADR_CRMWS&quot;/>&#xa;                            &lt;/tns:idMacroarea>&#xa;                        &lt;/tns:outputCampiOfferteVLAN>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputVisualizzaCampiOfferteVLAN>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($RecuperaMacroAreaAdr/Record) and string-length($RecuperaMacroAreaAdr/Record[1]/DESCRIZIONE_AREA) > 0 and $get.parameters/tns1:idOfferta = ('62','63')&quot;>&#xa;                &lt;tns:outputVisualizzaCampiOfferteVLAN>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperaMacroAreaAdr/Record&quot;>&#xa;                        &lt;xsl:if test=&quot;not(ends-with(DESCRIZIONE_AREA, '_CC') or (ends-with(DESCRIZIONE_AREA, '_LIB')))&quot;>&#xa;                            &lt;tns:outputCampiOfferteVLAN>&#xa;                                &lt;xsl:if test=&quot;DESCRIZIONE_AREA&quot;>&#xa;                                    &lt;tns:macroarea>&#xa;                                        &lt;xsl:value-of select=&quot;DESCRIZIONE_AREA&quot;/>&#xa;                                    &lt;/tns:macroarea>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns:idMacroarea>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ADR_CRMWS&quot;/>&#xa;                                &lt;/tns:idMacroarea>&#xa;                            &lt;/tns:outputCampiOfferteVLAN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputVisualizzaCampiOfferteVLAN>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($RecuperaMacroAreaAdr/Record) and string-length($RecuperaMacroAreaAdr/Record[1]/DESCRIZIONE_AREA) > 0&quot;>&#xa;                &lt;tns:outputVisualizzaCampiOfferteVLAN>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperaMacroareaMadr/Record&quot;>&#xa;                        &lt;xsl:if test=&quot;not(ends-with(DESCRIZIONE_AREA, '_CC') or (ends-with(DESCRIZIONE_AREA, '_LIB')))&quot;>&#xa;                            &lt;tns:outputCampiOfferteVLAN>&#xa;                                &lt;xsl:if test=&quot;DESCRIZIONE_AREA&quot;>&#xa;                                    &lt;tns:macroarea>&#xa;                                        &lt;xsl:value-of select=&quot;DESCRIZIONE_AREA&quot;/>&#xa;                                    &lt;/tns:macroarea>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns:idMacroarea>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ADR_CRMWS&quot;/>&#xa;                                &lt;/tns:idMacroarea>&#xa;                            &lt;/tns:outputCampiOfferteVLAN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputVisualizzaCampiOfferteVLAN>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputVisualizzaCampiOfferteVLAN>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputVisualizzaCampiOfferteVLAN>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
