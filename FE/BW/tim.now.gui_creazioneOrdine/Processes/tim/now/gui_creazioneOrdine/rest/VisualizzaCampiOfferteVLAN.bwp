                        </bpws:variables>
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails2"
                                tibex:faultNameVar="FaultName2" tibex:xpdlId="bfee919f-27b0-4235-93e3-c47ab3d64eb8">
                                <bpws:scope name="scope6">
                                    <bpws:flow name="flow6">
                                    <bpws:links>
                                    <bpws:link
                                    name="CallProcess3ToReply2" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>
