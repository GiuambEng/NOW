                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VisualizzaCampiOfferteVLAN&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoTdKit&quot;/>&lt;xsl:template name=&quot;VariabileTdKit&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperoTdKit/unknownResultset/row/column/name)>0&quot;>&lt;tns:outputRecuperaCodiceTdKit>&lt;xsl:for-each select=&quot;$RecuperoTdKit/unknownResultset/row&quot;>&lt;tns:outputCodiciTdKit>&lt;xsl:if test=&quot;not((string(column[name = 'CODICEKIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'CODICEKIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'CODICEKIT']/value)&quot;>&lt;tns:codiceTdKit>&lt;xsl:value-of select=&quot;column[name = 'CODICEKIT']/value&quot;/>&lt;/tns:codiceTdKit>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name = 'MODELLOKIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'MODELLOKIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'MODELLOKIT']/value)&quot;>&lt;tns:modelloKit>&lt;xsl:value-of select=&quot;column[name = 'MODELLOKIT']/value&quot;/>&lt;/tns:modelloKit>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name = 'CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'CLLI']/value)&quot;>&lt;tns:clli>&lt;xsl:value-of select=&quot;column[name = 'CLLI']/value&quot;/>&lt;/tns:clli>&lt;/xsl:if>&lt;/tns:outputCodiciTdKit>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputRecuperaCodiceTdKit>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputRecuperaCodiceTdKit>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record trovato.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputRecuperaCodiceTdKit>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
