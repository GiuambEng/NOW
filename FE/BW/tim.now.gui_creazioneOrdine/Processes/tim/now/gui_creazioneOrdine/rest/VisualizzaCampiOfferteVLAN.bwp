                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dc3b9965-d0e8-4229-b918-b0b092282b77+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaCampiOfferteVLAN/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaArea-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:idOfferta = '63'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;ends-with($get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:nomeCampo, '_LIB')&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT distinct AA.DESCRIZIONE_AREA, AA.ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA ,ANAG_CENTRALE_GBE ACG where AA.id_macroarea IN (SELECT ROW_ID_ADR_FIS FROM ASS_MADR_FISICA_COMMERCIALE WHERE ROW_ID_ADR_LIB = '&amp;quot;,$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo,&amp;quot;') and AA.tipologia_adr = 'AREA' and aa.id_adr_crmws = acg.id_adr_crmws order by descrizione_area asc&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;ends-with($get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:nomeCampo, '_CC')&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT distinct AA.DESCRIZIONE_AREA, AA.ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA ,ANAG_CENTRALE_GBE ACG where AA.id_macroarea IN (SELECT ROW_ID_ADR_FIS FROM ASS_MADR_FISICA_COMMERCIALE WHERE ROW_ID_ADR_CC = '&amp;quot;,$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo,&amp;quot;') and AA.tipologia_adr = 'AREA' and aa.id_adr_crmws = acg.id_adr_crmws order by descrizione_area asc&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT distinct AA.DESCRIZIONE_AREA, AA.ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA ,ANAG_CENTRALE_GBE ACG where AA.id_macroarea IN (SELECT DISTINCT ID_MACROAREA FROM APPUSER.ANAGRAFICA_ADR WHERE (ID_ADR_CRMWS = '&amp;quot;,$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo,&amp;quot;' OR ID_MACROAREA = '&amp;quot;,$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo,&amp;quot;') AND ID_MACROAREA IS NOT NULL) and AA.tipologia_adr = 'AREA' and aa.id_adr_crmws = acg.id_adr_crmws order by descrizione_area asc&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;ends-with($get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:nomeCampo, '_LIB')&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT distinct AA.DESCRIZIONE_AREA, AA.ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA ,ANAG_CENTRALE_NGA ACG where AA.id_macroarea IN (SELECT ROW_ID_ADR_FIS FROM ASS_MADR_FISICA_COMMERCIALE WHERE ROW_ID_ADR_LIB = '&amp;quot;,$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo,&amp;quot;') and AA.tipologia_adr = 'AREA' and aa.id_adr_crmws = acg.id_adr_crmws order by descrizione_area asc&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;ends-with($get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:nomeCampo, '_CC')&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT distinct AA.DESCRIZIONE_AREA, AA.ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA ,ANAG_CENTRALE_NGA ACG where AA.id_macroarea IN (SELECT ROW_ID_ADR_FIS FROM ASS_MADR_FISICA_COMMERCIALE WHERE ROW_ID_ADR_CC = '&amp;quot;,$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo,&amp;quot;') and AA.tipologia_adr = 'AREA' and aa.id_adr_crmws = acg.id_adr_crmws order by descrizione_area asc&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT distinct AA.DESCRIZIONE_AREA, AA.ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA ,ANAG_CENTRALE_NGA ACG where AA.id_macroarea = (SELECT DISTINCT ID_MACROAREA FROM APPUSER.ANAGRAFICA_ADR WHERE (ID_ADR_CRMWS = '&amp;quot;,$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo,&amp;quot;' OR ID_MACROAREA = '&amp;quot;,$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo,&amp;quot;') AND ID_MACROAREA IS NOT NULL) and AA.tipologia_adr = 'AREA' and aa.id_adr_crmws = acg.id_adr_crmws order by descrizione_area asc&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperaArea-input"
                                    name="RecuperaArea"
                                    outputVariable="RecuperaArea"
                                    tibex:xpdlId="dc3b9965-d0e8-4229-b918-b0b092282b77" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
