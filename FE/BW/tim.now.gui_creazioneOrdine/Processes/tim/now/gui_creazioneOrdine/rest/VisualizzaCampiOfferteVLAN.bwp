                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT AA.DESCRIZIONE_AREA, AA.ID_ADR_CRMWS&#xa;FROM ANAGRAFICA_ADR AA INNER JOIN ANAGRAFICA_KIT_VLAN_ADR_CAR AKVAC ON AA.ID_ADR_CRMWS = AKVAC.ID_ADR_CRMWS&#xa;WHERE AA.TIPOLOGIA_ADR = 'MACROAREA' AND AKVAC.CODICE_KIT = ?&#xa;AND AA.DESCRIZIONE_AREA NOT LIKE '%_CC' &#xa;AND AA.DESCRIZIONE_AREA NOT LIKE '%_LIB'&#xa;ORDER BY AA.DESCRIZIONE_AREA ASC" xsi:type="jdbcPalette:JDBCQueryActivity">

