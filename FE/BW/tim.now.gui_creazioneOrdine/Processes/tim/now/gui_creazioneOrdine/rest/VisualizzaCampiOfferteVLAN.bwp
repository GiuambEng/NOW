                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VisualizzaCampiOfferteVLAN&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperaNumCondiv&quot;/>&lt;xsl:template name=&quot;Variable1&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperaNumCondiv/Record/CODOLOAGCOM) > 0&quot;>&lt;tns:outputVisualizzaNumeriCondivisori>&lt;xsl:for-each select=&quot;$RecuperaNumCondiv/Record&quot;>&lt;tns:numeriCondivisori>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;CODOLOAGCOM&quot;/>&lt;/tns:codiceOlo>&lt;xsl:if test=&quot;CODOLOTITOLARE&quot;>&lt;tns:codiceOloTitolare>&lt;xsl:value-of select=&quot;CODOLOTITOLARE&quot;/>&lt;/tns:codiceOloTitolare>&lt;/xsl:if>&lt;/tns:numeriCondivisori>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVisualizzaNumeriCondivisori>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVisualizzaNumeriCondivisori>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record presente&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:result>&lt;/tns:outputVisualizzaNumeriCondivisori>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
