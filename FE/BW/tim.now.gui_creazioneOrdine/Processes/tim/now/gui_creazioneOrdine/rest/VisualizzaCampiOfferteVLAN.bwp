                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a6071306-2950-4fbb-8cbb-62dd8ea0d43c+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaCampiOfferteVLAN/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;ModelloKit-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codiceTdKit>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get/parameters/tns1:visualizzacampioffertevlanGetParameters/tns1:valoreCampo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codiceTdKit>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ModelloKit-input"
                                    name="ModelloKit"
                                    outputVariable="ModelloKit"
                                    tibex:xpdlId="a6071306-2950-4fbb-8cbb-62dd8ea0d43c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToModelloKit_Macroarea-OLD"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ModelloKitToRecuperaMacroareaMadr_MAdR">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($ModelloKit/Record[1]/MODELLO_KIT)='MADR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
