ontrattoOutput>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                        &lt;tns1:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Profilo non abilitato&amp;quot;&quot;/>&#xa;                        &lt;/tns1:details>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:outputNuovoContratto>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($ControlloCodiceContratto/Record) >0&quot;>&#xa;                &lt;tns1:outputNuovoContratto>&#xa;                    &lt;tns1:nuovoContrattoOutput>&#xa;                        &lt;tns1:esito>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:esito>&#xa;                    &lt;/tns1:nuovoContrattoOutput>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                        &lt;tns1:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Contratto duplicato, impossibile continuare&amp;quot;&quot;/>&#xa;                        &lt;/tns1:details>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:outputNuovoContratto>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count(