                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO CONTRATTO(COD_CONTRATTO,COD_OLO,CODFC_OLO_AGCOM,DATAFI_VALID,DATAINZ_VALID,FLAG_ABILITATO,FLAG_ANFIBIO,FLAG_DIFFIDATO,FLAG_FILE_NOTIFY,&#xd;&#xa;FLAG_NPD,FLAG_STANDARD,FLAG_VALIDO,ID_CONTRATTO,ID_CONTRATTO_CRMWS,ID_FAMIG_OFFERTA,ID_SOTTOFAMIG_OFFERTA,ID_STATO_CONTRATTO,IDTPLG_CONTRATTO,NOME_CONTRATTO,&#xd;&#xa;NOME_STANDARD,OPERATORE,TIMSTP_INSMTO,ID_SISTEMA,FLAG_MULTICAST,EMAIL_OFFERTAFWA1GIGASARDEGNA)&#xd;&#xa;VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

