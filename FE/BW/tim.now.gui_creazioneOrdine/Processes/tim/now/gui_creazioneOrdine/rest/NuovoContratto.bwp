&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20181009174941PLT" xmlns:tns1="http://www.tim.com/NOW/cmf/nuovoContratto" version="2.0"&gt;
