&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20181009174941PLT" xmlns:tns1="http://www.tim.com/NOW/cmf/nuovoContratto" version="2.0"&gt;&lt;xsl:param name="ControlloCodiceContratto"/&gt;&lt;xsl:param name="InsertContratto"/&gt;&lt;xsl:param name="InsertContrattoOffertaCatalogo"/&gt;&lt;xsl:param name="post"/&gt;&lt;xsl:param name="VerificheContrattiSemi"/&gt;&lt;xsl:param name="JDBCSequenceContract"/&gt;&lt;xsl:param name="VerificheContrattiFULLGPONPLUS"/&gt;&lt;xsl:template name="postOut-input" match="/"&gt;&lt;tns2:postResponse&gt;&lt;item&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$VerificheContrattiSemi/tns1:esito = 'KO'"&gt;&lt;tns1:outputNuovoContratto&gt;&lt;tns1:nuovoContrattoOutput&gt;&lt;tns1:esito&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:esito&gt;&lt;/tns1:nuovoContrattoOutput&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:code&gt;&lt;xsl:if test="$VerificheContrattiSemi/tns1:message"&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="$VerificheContrattiSemi/tns1:message"/&gt;&lt;/tns1:details&gt;&lt;/xsl:if&gt;&lt;/tns1:result&gt;&lt;/tns1:outputNuovoContratto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$VerificheContrattiFULLGPONPLUS/tns1:esito = 'KO'"&gt;&lt;tns1:outputNuovoContratto&gt;&lt;tns1:nuovoContrattoOutput&gt;&lt;tns1:esito&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:esito&gt;&lt;/tns1:nuovoContrattoOutput&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:code&gt;&lt;xsl:if test="$VerificheContrattiFULLGPONPLUS/tns1:message"&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="$VerificheContrattiFULLGPONPLUS/tns1:message"/&gt;&lt;/tns1:details&gt;&lt;/xsl:if&gt;&lt;/tns1:result&gt;&lt;/tns1:outputNuovoContratto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="not(contains($post/item/tns1:nuovoContratto/tns1:nuovoContratto[1]/tns1:tipoProfilo, 'DG'))"&gt;&lt;tns1:outputNuovoContratto&gt;&lt;tns1:nuovoContrattoOutput&gt;&lt;tns1:esito&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:esito&gt;&lt;/tns1:nuovoContrattoOutput&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:code&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="&amp;quot;Profilo non abilitato&amp;quot;"/&gt;&lt;/tns1:details&gt;&lt;/tns1:result&gt;&lt;/tns1:outputNuovoContratto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="count($ControlloCodiceContratto/Record) &gt;0"&gt;&lt;tns1:outputNuovoContratto&gt;&lt;tns1:nuovoContrattoOutput&gt;&lt;tns1:esito&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:esito&gt;&lt;/tns1:nuovoContrattoOutput&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:code&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="&amp;quot;Contratto duplicato, impossibile continuare&amp;quot;"/&gt;&lt;/tns1:details&gt;&lt;/tns1:result&gt;&lt;/tns1:outputNuovoContratto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="count($ControlloCodiceContratto/Record) =0 and ($InsertContratto/noOfUpdates &gt;0 and $InsertContrattoOffertaCatalogo/noOfUpdates &gt;0)"&gt;&lt;tns1:outputNuovoContratto&gt;&lt;tns1:nuovoContrattoOutput&gt;&lt;tns1:esito&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:esito&gt;&lt;xsl:if test="$JDBCSequenceContract/Record[1]/NEXTVAL"&gt;&lt;tns1:idContratto&gt;&lt;xsl:value-of select="$JDBCSequenceContract/Record[1]/NEXTVAL"/&gt;&lt;/tns1:idContratto&gt;&lt;/xsl:if&gt;&lt;/tns1:nuovoContrattoOutput&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:code&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="&amp;quot;Inserimento avvenuto con successo&amp;quot;"/&gt;&lt;/tns1:details&gt;&lt;/tns1:result&gt;&lt;/tns1:outputNuovoContratto&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:outputNuovoContratto&gt;&lt;tns1:nuovoContrattoOutput&gt;&lt;tns1:esito&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:esito&gt;&lt;/tns1:nuovoContrattoOutput&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:code&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="&amp;quot;Inserimento non effettuato&amp;quot;"/&gt;&lt;/tns1:details&gt;&lt;/tns1:result&gt;&lt;/tns1:outputNuovoContratto&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/item&gt;&lt;/tns2:postResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
