                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20181009174941PLT&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/nuovoContratto&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloCodiceContratto&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertContratto&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertContrattoOffertaCatalogo&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificheContrattiSemi&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCSequenceContract&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificheContrattiFULLGPONPLUS&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$VerificheContrattiSemi/tns1:esito = 'KO'&quot;>&#xa;                &lt;tns1:outputNuovoContratto>&#xa;                    &lt;tns1:nuovoContrattoOutput>&#xa;                        &lt;tns1:esito>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:esito>&#xa;                    &lt;/tns1:nuovoContrattoOutput>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                        &lt;xsl:if test=&quot;$VerificheContrattiSemi/tns1:message&quot;>&#xa;                            &lt;tns1:details>&#xa;                                &lt;xsl:value-of select=&quot;$VerificheContrattiSemi/tns1:message&quot;/>&#xa;