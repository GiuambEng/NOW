                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO ORDN_BOZZA_GUI(COD_OLO_NUMERICO,COD_ORDN_OLO,CODFC_OLO_AGCOM,NOTE,ORDN_BOZZA,TIMSTP_AGGTO,TIPOLG_LAVRZ,USERID)&#xa;VALUES (?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

