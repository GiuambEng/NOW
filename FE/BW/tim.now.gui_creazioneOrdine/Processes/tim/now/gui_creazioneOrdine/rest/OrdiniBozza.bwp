                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/OrdiniInBozza&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoLista&quot;/>&lt;xsl:template name=&quot;OrdiniInBozza&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperoLista/unknownResultset/row) > 0&quot;>&lt;tns:OrdiniInBozza>&lt;xsl:for-each select=&quot;$RecuperoLista/unknownResultset/row&quot;>&lt;tns:ordiniInBozza>&lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&lt;tns:codOloAgcom>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&lt;/tns:codOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_OLO_NUMERICO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO_NUMERICO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO_NUMERICO']/value)&quot;>&lt;tns:codOloNumerico>&lt;xsl:value-of select=&quot;column[name='COD_OLO_NUMERICO']/value&quot;/>&lt;/tns:codOloNumerico>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='USERID']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='USERID']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='USERID']/value)&quot;>&lt;tns:userId>&lt;xsl:value-of select=&quot;column[name='USERID']/value&quot;/>&lt;/tns:userId>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_ORDN_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_ORDN_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_ORDN_OLO']/value)&quot;>&lt;tns:codOrdineOlo>&lt;xsl:value-of select=&quot;column[name='COD_ORDN_OLO']/value&quot;/>&lt;/tns:codOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLG_LAVRZ']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLG_LAVRZ']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLG_LAVRZ']/value)&quot;>&lt;tns:tipologiaLavorazione>&lt;xsl:value-of select=&quot;column[name='TIPOLG_LAVRZ']/value&quot;/>&lt;/tns:tipologiaLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOTE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOTE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOTE']/value)&quot;>&lt;tns:note>&lt;xsl:value-of select=&quot;column[name='NOTE']/value&quot;/>&lt;/tns:note>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIMSTP_AGGTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIMSTP_AGGTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIMSTP_AGGTO']/value)&quot;>&lt;tns:ultimoAggiornamento>&lt;xsl:value-of select=&quot;column[name='TIMSTP_AGGTO']/value&quot;/>&lt;/tns:ultimoAggiornamento>&lt;/xsl:if>&lt;/tns:ordiniInBozza>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:OrdiniInBozza>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OrdiniInBozza>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;NESSUN ELEMENTO TROVATO&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OrdiniInBozza>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
