                                    sqlStatement="UPDATE ORDN_BOZZA_GUI&#xa;SET NOTE = ?, ORDN_BOZZA = ?,TIMSTP_AGGTO = ?&#xa;WHERE COD_ORDN_OLO = ?&#xa;AND CODFC_OLO_AGCOM = ?&#xa;  "
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

