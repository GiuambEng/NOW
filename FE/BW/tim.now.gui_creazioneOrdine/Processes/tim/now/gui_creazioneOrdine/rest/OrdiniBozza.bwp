                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                                &lt;tns:details&gt;
                                    &lt;xsl:value-of select="&amp;quot;Bozza aggiornata con successo&amp;quot;"/&gt;
                                &lt;/tns:details&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:OutputIns_DelOrdiniBozza&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:OutputIns_DelOrdiniBozza&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
