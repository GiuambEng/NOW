                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                                &lt;tns:details&gt;
                                    &lt;xsl:value-of select="&amp;quot;Bozza non aggiornata&amp;quot;"/&gt;
                                &lt;/tns:details&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:OutputIns_DelOrdiniBozza&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns2:postResponse1&gt;
    &lt;/xsl:template&gt;
