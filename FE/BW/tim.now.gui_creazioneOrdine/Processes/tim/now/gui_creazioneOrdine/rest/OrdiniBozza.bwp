                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InputLogUpdateOrdiniBozzaToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
