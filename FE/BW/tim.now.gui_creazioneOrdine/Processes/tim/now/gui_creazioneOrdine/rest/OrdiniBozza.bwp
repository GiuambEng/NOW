    &lt;xsl:param name="Update"/&gt;
    &lt;xsl:template name="UpdateOut-input" match="/"&gt;
        &lt;tns2:postResponse1&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="$Update/noOfUpdates &gt;0"&gt;
