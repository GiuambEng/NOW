                                    <bpws:reply name="Reply3"
                                    operation="get"
                                    partnerLink="dettaglioordinibozza"
                                    portType="ns:dettaglioordinibozza"
                                    tibex:xpdlId="ca6fb77e-cdbf-43eb-aa88-9f00cf46f2cb" variable="Reply3-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160916103735PLT" xmlns:tns="http://www.tim.com/NOW/rest/OrdiniInBozza" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails4"/&gt;
    &lt;xsl:template name="Reply3-input" match="/"&gt;
        &lt;tns2:getResponse1&gt;
            &lt;item&gt;
                &lt;tns:OrdiniInBozza&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;
                        &lt;/tns:severity&gt;
                        &lt;tns:code&gt;
                            &lt;xsl:value-of select="$FaultDetails4/MsgCode"/&gt;
                        &lt;/tns:code&gt;
                        &lt;tns:details&gt;
