                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3b7a3618-c67c-4674-9f65-c845a0fa29a4+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/OrdiniBozza/parameters&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/VerificaOLO&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;ProfiloOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaOlo&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoLista-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($ProfiloOlo,$get/parameters/tns1:listaordinibozza1GetParameters/tns1:tipoProfilo) = true()&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_OLO_NUMERICO,COD_ORDN_OLO,CODFC_OLO_AGCOM,NOTE,ORDN_BOZZA,TIMSTP_AGGTO,TIPOLG_LAVRZ,USERID FROM ORDN_BOZZA_GUI WHERE CODFC_OLO_AGCOM IN ('&amp;quot;, tib:concat-sequence-format($VerificaOlo/tns2:VerificaOlo[tns2:codiceAgcom!=$get/parameters/tns1:listaordinibozza1GetParameters/tns1:codOloAgcom]/tns2:codiceAgcom, &amp;quot;','&amp;quot;, true()), &amp;quot;') OR CODFC_OLO_AGCOM = '&amp;quot;,$get/parameters/tns1:listaordinibozza1GetParameters/tns1:codOloAgcom,&amp;quot;' ORDER BY TIMSTP_AGGTO DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT COD_OLO_NUMERICO,COD_ORDN_OLO,CODFC_OLO_AGCOM,NOTE,ORDN_BOZZA,TIMSTP_AGGTO,TIPOLG_LAVRZ,USERID FROM ORDN_BOZZA_GUI ORDER BY TIMSTP_AGGTO DESC&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoLista-input"
