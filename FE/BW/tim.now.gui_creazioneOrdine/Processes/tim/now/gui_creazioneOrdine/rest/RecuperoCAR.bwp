                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (contains($post/item/tns:inputRecuperoCAR/tns:supermacroarea, &quot;LIB&quot;)) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_LIB')&quot; else if (contains($post/item/tns:inputRecuperoCAR/tns:supermacroarea, &quot;CC&quot;)) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_CC')&quot; else if (contains($post/item/tns:inputRecuperoCAR/tns:supermacroarea, &quot;SUPERMACROAREA&quot;)) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA= 'SUPERMACROAREA')&quot; else if (($post/item/tns:inputRecuperoCAR/tns:supermacroarea = &quot;Consegna su CAR di MAdR reale&quot; or string-length($post/item/tns:inputRecuperoCAR/tns:supermacroarea) = 0) and string-length($post/item/tns:inputRecuperoCAR/tns:ccLib) = 0) then concat(&quot; IN ('&quot;, $AttributiNGA/Record[NOMEATTRIBUTO='IDADRCRMWS']/VALOREATTRIBUTO, &quot;','&quot;, $AttributiNGA/Record[NOMEATTRIBUTO='IDMADRCRMWS']/VALOREATTRIBUTO, &quot;')&quot;) else concat(&quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = '&quot;, $AttributiNGA/Record[NOMEATTRIBUTO='NOMEMACROAREA']/VALOREATTRIBUTO, &quot;_&quot;,$post/item/tns:inputRecuperoCAR/tns:ccLib,&quot;' AND AA.DESCRIZIONE_AREA NOT IN ('SUPERMACROAREA_CC','SUPERMACROAREA_LIB'))&quot;)"
