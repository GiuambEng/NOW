                                    expression="if ($AttributiNGA/Record[NOMEATTRIBUTO = 'SUPERMACROAREA']/VALOREATTRIBUTO = '1') then concat(&quot; AND AKV.ID_KIT_AREA_CAR NOT IN (SELECT DISTINCT ID_KIT_AREA_CAR FROM ANAGRAFICA_KIT_VLAN_ADR_CAR WHERE CODICE_CAR = '&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDENTIFICATIVOCAR']/VALOREATTRIBUTO,&quot;' AND ID_ADR_CRMWS IN (SELECT DISTINCT ID_ADR_CRMWS FROM ANAGRAFICA_ADR WHERE DESCRIZIONE_AREA = 'SUPERMACROAREA'))&quot;) else if ($AttributiNGA/Record[NOMEATTRIBUTO = 'SUPERMACROAREA']/VALOREATTRIBUTO = '2') then concat(&quot; AND AKV.ID_KIT_AREA_CAR NOT IN (SELECT DISTINCT ID_KIT_AREA_CAR FROM ANAGRAFICA_KIT_VLAN_ADR_CAR WHERE CODICE_CAR = '&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDENTIFICATIVOCAR']/VALOREATTRIBUTO,&quot;' AND ID_ADR_CRMWS IN (SELECT DISTINCT ID_ADR_CRMWS FROM ANAGRAFICA_ADR WHERE DESCRIZIONE_AREA = 'SUPERMACROAREA_CC'))&quot;) else if ($AttributiNGA/Record[NOMEATTRIBUTO = 'SUPERMACROAREA']/VALOREATTRIBUTO = '3') then concat(&quot; AND AKV.ID_KIT_AREA_CAR NOT IN (SELECT DISTINCT ID_KIT_AREA_CAR FROM ANAGRAFICA_KIT_VLAN_ADR_CAR WHERE  CODICE_CAR = '&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDENTIFICATIVOCAR']/VALOREATTRIBUTO,&quot;' AND ID_ADR_CRMWS IN (SELECT DISTINCT ID_ADR_CRMWS FROM ANAGRAFICA_ADR WHERE DESCRIZIONE_AREA = 'SUPERMACROAREA_LIB'))&quot;) else if ((($AttributiNGA/Record[NOMEATTRIBUTO = 'SUPERMACROAREA']/VALOREATTRIBUTO = '0') or (string-length($AttributiNGA/Record[NOMEATTRIBUTO = 'SUPERMACROAREA']/VALOREATTRIBUTO)=0)) and $AttributiNGA/Record[NOMEATTRIBUTO = 'TIPOLOGIACLUSTERVLAN']/VALOREATTRIBUTO = 'CC') then concat(&quot; AND AKV.ID_KIT_AREA_CAR NOT IN (SELECT DISTINCT ID_KIT_AREA_CAR FROM ANAGRAFICA_KIT_VLAN_ADR_CAR WHERE  CODICE_CAR = '&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDENTIFICATIVOCAR']/VALOREATTRIBUTO,&quot;' AND ID_ADR_CRMWS IN (SELECT DISTINCT ROW_ID_ADR_CC FROM ASS_MADR_FISICA_COMMERCIALE WHERE ROW_ID_ADR_FIS = '&quot;,$AttributiNGA/Record[NOMEATTRIBUTO = 'IDMADRCRMWS']/VALOREATTRIBUTO,&quot;'))&quot;) else if ((($AttributiNGA/Record[NOMEATTRIBUTO = 'SUPERMACROAREA']/VALOREATTRIBUTO = '0') or (string-length($AttributiNGA/Record[NOMEATTRIBUTO = 'SUPERMACROAREA']/VALOREATTRIBUTO)=0)) and $AttributiNGA/Record[NOMEATTRIBUTO = 'TIPOLOGIACLUSTERVLAN']/VALOREATTRIBUTO = 'LIB') then concat(&quot; AND AKV.ID_KIT_AREA_CAR NOT IN (SELECT DISTINCT ID_KIT_AREA_CAR FROM ANAGRAFICA_KIT_VLAN_ADR_CAR WHERE CODICE_CAR = '&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDENTIFICATIVOCAR']/VALOREATTRIBUTO,&quot;' AND ID_ADR_CRMWS IN (SELECT DISTINCT ROW_ID_ADR_LIB FROM ASS_MADR_FISICA_COMMERCIALE WHERE ROW_ID_ADR_FIS = '&quot;,$AttributiNGA/Record[NOMEATTRIBUTO = 'IDMADRCRMWS']/VALOREATTRIBUTO,&quot;'))&quot;) else concat(&quot; AND AKV.ID_KIT_AREA_CAR NOT IN (SELECT DISTINCT ID_KIT_AREA_CAR FROM ANAGRAFICA_KIT_VLAN_ADR_CAR WHERE CODICE_CAR = '&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDENTIFICATIVOCAR']/VALOREATTRIBUTO, &quot;' AND ID_ADR_CRMWS IN('&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDMADRCRMWS']/VALOREATTRIBUTO,&quot;','&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDADRCRMWS']/VALOREATTRIBUTO,&quot;'))&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
