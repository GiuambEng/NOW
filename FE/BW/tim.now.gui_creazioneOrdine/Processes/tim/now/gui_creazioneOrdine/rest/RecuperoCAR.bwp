                        &lt;/tns1:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoCAR_&amp;quot;,$post/httpHeaders/tns3:httpHeaders/GUI-SID,&amp;quot;COMPLETE&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoCAR_&amp;quot;,$post/httpHeaders/tns3:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
