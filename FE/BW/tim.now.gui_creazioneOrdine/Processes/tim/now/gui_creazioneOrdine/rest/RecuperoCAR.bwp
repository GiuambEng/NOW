                                    <bpws:reply name="Reply"
                                    operation="post"
                                    partnerLink="recuperocar"
                                    portType="ns:recuperocar"
                                    tibex:xpdlId="52cae4d8-283c-4cb0-9951-e285fa92bd6f" variable="Reply-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://xmlns.example.com/20201105171443PLT" xmlns:tns="http://www.example.org/RecuperoCAR" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns4:postResponse&gt;
            &lt;item&gt;
                &lt;tns:outputRecuperoCAR&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;
                        &lt;/tns:severity&gt;
                        &lt;tns:code&gt;
                            &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                        &lt;/tns:code&gt;
                        &lt;tns:details&gt;
                            &lt;xsl:value-of select="$FaultDetails/Msg"/&gt;
                        &lt;/tns:details&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:outputRecuperoCAR&gt;
            &lt;/item&gt;
