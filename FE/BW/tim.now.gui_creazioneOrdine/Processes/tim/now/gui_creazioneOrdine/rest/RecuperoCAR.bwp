                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOMEATTRIBUTO,VALOREATTRIBUTO&#xa;  FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST&#xa;  WHERE NOMEATTRIBUTO IN ('IDENTIFICATIVOCAR','IDMADRCRMWS','BMCLIGHT','IDADRCRMWS','SUPERMACROAREA','TIPOLOGIACLUSTERVLAN','NOMEMACROAREA')&#xa;  AND IDASSET = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

