                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c0a9dad6-bf5d-4acd-8fba-f05ad225ebdb+input&quot; xmlns:tns=&quot;http://www.example.org/RecuperoCAR&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;superMA&quot;/>&lt;xsl:param name=&quot;famVLAN&quot;/>&lt;xsl:param name=&quot;descrArea&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;ftthOnlySQL&quot;/>&lt;xsl:param name=&quot;modelloKit&quot;/>&lt;xsl:param name=&quot;varCar&quot;/>&lt;xsl:param name=&quot;nomeAggregato&quot;/>&lt;xsl:param name=&quot;carattCar&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns2:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT AKV.CODICE_CAR AS CODICECAR, AA.DESCRIZIONE_AREA AS DESCRIZIONEAREA, AKV.NOME_AGGREGATO AS NOMEAGGRAGATO,AKV.TIPOLOGIA_COMUNE AS TIPOLOGIACOMUNE,AKV.CARATTERISTICACAR AS CARATTERISTICACAR, AKV.FLAG_FTTH_ONLY AS FTTHONLY, AKV.BANDA_CAR AS BANDACAR FROM ANAGRAFICA_KIT_VLAN_ADR_CAR AKV INNER JOIN ANAGRAFICA_ADR AA ON AKV.ID_ADR_CRMWS = AA.ID_ADR_CRMWS WHERE AKV.CODICE_KIT='&amp;quot;,$post/item/tns:inputRecuperoCAR/tns:codiceTDKIT,&amp;quot;' &amp;quot;,$ftthOnlySQL,&amp;quot; &amp;quot;,$superMA,&amp;quot; AND AKV.ID_ADR_CRMWS &amp;quot;,$descrArea,$modelloKit,&amp;quot; AND AKV.ID_TIPOLOGIA_COS = (SELECT ID_TIPOLOGIA_COS FROM TIPOLOGIA_COS WHERE CODICE_TIPOLOGIA_COS = '&amp;quot;,$famVLAN,&amp;quot;') &amp;quot;,$nomeAggregato,$varCar,$carattCar,&amp;quot; ORDER BY AKV.CODICE_CAR ASC &amp;quot;)&quot;/>&lt;/statement>&lt;/tns2:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SQLDirect-input"
                                    name="SQLDirect"
                                    outputVariable="SQLDirect"
                                    tibex:xpdlId="c0a9dad6-bf5d-4acd-8fba-f05ad225ebdb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign4ToSQLDirect"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SQLDirectToAssign"/>
                                    </bpws:sources>
