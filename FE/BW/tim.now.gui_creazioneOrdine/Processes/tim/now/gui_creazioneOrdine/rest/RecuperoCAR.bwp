                                <bpws:sources>
                                    <bpws:source linkName="EmptyToAssignSuperMA_Variazione">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($post/item/tns:inputRecuperoCAR/tns:lavorazione)='VARIAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($post.item/tns:lavorazione)='VARIAZIONE']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToAssign2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if ((contains($post/item/tns:inputRecuperoCAR/tns:supermacroarea, 'CC')) or ((string-length($post/item/tns:inputRecuperoCAR/tns:supermacroarea)=0) and ($post/item/tns:inputRecuperoCAR/tns:ccLib='CC')) or (($post/item/tns:inputRecuperoCAR/tns:supermacroarea='Consegna su CAR di MAdR reale') and ($post/item/tns:inputRecuperoCAR/tns:ccLib='CC'))) then &quot; AND AKV.TIPOLOGIA_COMUNE='CC'&quot; else if  ((contains($post/item/tns:inputRecuperoCAR/tns:supermacroarea, 'LIB')) or ((string-length($post/item/tns:inputRecuperoCAR/tns:supermacroarea)=0) and ($post/item/tns:inputRecuperoCAR/tns:ccLib='LIB')) or (($post/item/tns:inputRecuperoCAR/tns:supermacroarea='Consegna su CAR di MAdR reale') and ($post/item/tns:inputRecuperoCAR/tns:ccLib='LIB'))) then &quot; AND AKV.TIPOLOGIA_COMUNE='LIB'&quot; else ''"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="superMA"
                                    name="Assign2"
                                    outputVariable="superMA"
                                    tibex:xpdlId="abebaa10-b096-40e7-98b7-ec281da40516" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToAssign2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign2ToAssign3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if ((contains($post.item/tns:supermacroarea, 'CC')) or ((string-length($post.item/tns:supermacroarea)=0) and ($post.item/tns:ccLib='CC')) or (($post.item/tns:supermacroarea='Consegna su CAR di MAdR reale') and ($post.item/tns:ccLib='CC'))) then &quot; AND AKV.TIPOLOGIA_COMUNE='CC'&quot; else if  ((contains($post.item/tns:supermacroarea, 'LIB')) or ((string-length($post.item/tns:supermacroarea)=0) and ($post.item/tns:ccLib='LIB')) or (($post.item/tns:supermacroarea='Consegna su CAR di MAdR reale') and ($post.item/tns:ccLib='LIB'))) then &quot; AND AKV.TIPOLOGIA_COMUNE='LIB'&quot; else ''" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="superMA" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (contains($post/item/tns:inputRecuperoCAR/tns:supermacroarea, 'LIB')) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_LIB')&quot; else if (contains($post/item/tns:inputRecuperoCAR/tns:supermacroarea, 'CC')) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_CC')&quot; else if (contains($post/item/tns:inputRecuperoCAR/tns:supermacroarea, 'SUPERMACROAREA')) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA')&quot; else if (($post/item/tns:inputRecuperoCAR/tns:supermacroarea= 'Consegna su CAR di MAdR reale' or string-length($post/item/tns:inputRecuperoCAR/tns:supermacroarea)=0) and string-length($post/item/tns:inputRecuperoCAR/tns:ccLib)=0) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA NOT IN ('SUPERMACROAREA','SUPERMACROAREA_CC', 'SUPERMACROAREA_LIB') AND NOT(AA.DESCRIZIONE_AREA LIKE '%_CC' OR AA.DESCRIZIONE_AREA LIKE '%_LIB'))&quot; else concat(&quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA LIKE '%_&quot;,$post/item/tns:inputRecuperoCAR/tns:ccLib,&quot;' AND AA.descrizione_area NOT IN ('SUPERMACROAREA_CC', 'SUPERMACROAREA_LIB'))&quot;)"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="descrArea"
                                    name="Assign3"
                                    outputVariable="descrArea"
                                    tibex:xpdlId="8039e83b-0693-48a9-8c23-cacf615458d6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign2ToAssign3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign3ToAssign4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (contains($post.item/tns:supermacroarea, 'LIB')) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_LIB')&quot; else if (contains($post.item/tns:supermacroarea, 'CC')) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_CC')&quot; else if (contains($post.item/tns:supermacroarea, 'SUPERMACROAREA')) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA')&quot; else if (($post.item/tns:supermacroarea= 'Consegna su CAR di MAdR reale' or string-length($post.item/tns:supermacroarea)=0) and string-length($post.item/tns:ccLib)=0) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA NOT IN ('SUPERMACROAREA','SUPERMACROAREA_CC', 'SUPERMACROAREA_LIB') AND NOT(AA.DESCRIZIONE_AREA LIKE '%_CC' OR AA.DESCRIZIONE_AREA LIKE '%_LIB'))&quot; else concat(&quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA LIKE '%_&quot;,$post.item/tns:ccLib,&quot;' AND AA.descrizione_area NOT IN ('SUPERMACROAREA_CC', 'SUPERMACROAREA_LIB'))&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
