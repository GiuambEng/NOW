                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (contains($post.item/tns:supermacroarea, &quot;LIB&quot;)) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_LIB')&quot; else if (contains($post.item/tns:supermacroarea, &quot;CC&quot;)) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = 'SUPERMACROAREA_CC')&quot; else if (contains($post.item/tns:supermacroarea, &quot;SUPERMACROAREA&quot;)) then &quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA= 'SUPERMACROAREA')&quot; else if (($post.item/tns:supermacroarea = &quot;Consegna su CAR di MAdR reale&quot; or string-length($post.item/tns:supermacroarea) = 0) and string-length($post.item/tns:ccLib) = 0) then concat(&quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA NOT IN ('SUPERMACROAREA','SUPERMACROAREA_CC', 'SUPERMACROAREA_LIB') AND NOT(AA.DESCRIZIONE_AREA LIKE '%_CC' OR AA.DESCRIZIONE_AREA LIKE '%_LIB')) AND AKV.ID_ADR_CRMWS IN('&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDADRCRMWS']/VALOREATTRIBUTO,&quot;','&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='IDMADRCRMWS']/VALOREATTRIBUTO,&quot;')&quot;) else concat(&quot; IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_ADR AA WHERE AA.DESCRIZIONE_AREA = '&quot;,$AttributiNGA/Record[NOMEATTRIBUTO='NOMEMACROAREA']/VALOREATTRIBUTO,&quot;_&quot;, $post.item/tns:ccLib, &quot;' AND AA.DESCRIZIONE_AREA NOT IN ('SUPERMACROAREA_CC','SUPERMACROAREA_LIB'))&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
