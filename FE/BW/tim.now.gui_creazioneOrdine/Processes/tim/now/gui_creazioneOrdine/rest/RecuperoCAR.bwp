                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns=&quot;http://www.example.org/RecuperoCAR&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerInfo&quot;/>&lt;xsl:param name=&quot;superMA&quot;/>&lt;xsl:param name=&quot;famVLAN&quot;/>&lt;xsl:param name=&quot;descrArea&quot;/>&lt;xsl:param name=&quot;ftthOnlySQL&quot;/>&lt;xsl:param name=&quot;modelloKit&quot;/>&lt;xsl:param name=&quot;varCar&quot;/>&lt;xsl:param name=&quot;nomeAggregato&quot;/>&lt;xsl:param name=&quot;carattCar&quot;/>&lt;xsl:template name=&quot;LogQuery-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Process>&lt;xsl:value-of select=&quot;&amp;quot;RecuperoCAR&amp;quot;&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperoCAR&amp;quot;&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;xsl:if test=&quot;$post/httpHeaders/tns3:httpHeaders/GUI-SID&quot;>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns3:httpHeaders/GUI-SID&quot;/>&lt;/tns1:BusinessID>&lt;/xsl:if>&lt;tns1:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;SQLDirect: SELECT AKV.CODICE_CAR AS CODICECAR, AA.DESCRIZIONE_AREA AS DESCRIZIONEAREA, AKV.NOME_AGGREGATO AS NOMEAGGRAGATO,AKV.TIPOLOGIA_COMUNE AS TIPOLOGIACOMUNE,AKV.FLAG_FTTH_ONLY AS FTTHONLY, AKV.BANDA_CAR AS BANDACAR FROM ANAGRAFICA_KIT_VLAN_ADR_CAR AKV INNER JOIN ANAGRAFICA_ADR AA ON AKV.ID_ADR_CRMWS = AA.ID_ADR_CRMWS WHERE AKV.CODICE_KIT='&amp;quot;,$post/item/tns:inputRecuperoCAR/tns:codiceTDKIT,&amp;quot;' &amp;quot;,$ftthOnlySQL,&amp;quot; &amp;quot;,$superMA,&amp;quot; AND AKV.ID_ADR_CRMWS &amp;quot;,$descrArea,$modelloKit,&amp;quot; AND AKV.ID_TIPOLOGIA_COS = (SELECT ID_TIPOLOGIA_COS FROM TIPOLOGIA_COS WHERE CODICE_TIPOLOGIA_COS = '&amp;quot;,$famVLAN,&amp;quot;') &amp;quot;,$nomeAggregato,$varCar,$carattCar,&amp;quot; ORDER BY AKV.CODICE_CAR ASC &amp;quot;)&quot;/>&lt;/tns1:Payload>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;tns1:ActiveLoggerServices>&lt;tns1:Envelope>&lt;tns1:Identifier>&lt;tns1:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperoCAR&amp;quot;&quot;/>&lt;/tns1:ServiceName>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns1:Source>&lt;xsl:if test=&quot;$post/httpHeaders/tns3:httpHeaders/GUI-SID&quot;>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns3:httpHeaders/GUI-SID&quot;/>&lt;/tns1:BusinessID>&lt;/xsl:if>&lt;tns1:EventID>&lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns3:httpHeaders/GUI-SID,$post/httpHeaders/tns3:httpHeaders/GUI-TID)&quot;/>&lt;/tns1:EventID>&lt;xsl:if test=&quot;$post/httpHeaders/tns3:httpHeaders/GUI-TID&quot;>&lt;tns1:CorrelationID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns3:httpHeaders/GUI-TID&quot;/>&lt;/tns1:CorrelationID>&lt;/xsl:if>&lt;tns1:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoCAR_&amp;quot;,$post/httpHeaders/tns3:httpHeaders/GUI-SID,&amp;quot;COMPLETE&amp;quot;)&quot;/>&lt;/tns1:EventType>&lt;tns1:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoCAR_&amp;quot;,$post/httpHeaders/tns3:httpHeaders/GUI-SID)&quot;/>&lt;/tns1:trackID>&lt;/tns1:Identifier>&lt;tns1:track_position>&lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&lt;/tns1:track_position>&lt;tns1:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:Timestamp>&lt;/tns1:Envelope>&lt;/tns1:ActiveLoggerServices>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogQuery-input"
                                    name="LogQuery"
                                    tibex:xpdlId="bff62392-dbe2-4844-8836-d577ef4065af"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SQLDirectToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns=&quot;http://www.example.org/RecuperoCAR&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;superMA&quot;/>&#xa;    &lt;xsl:param name=&quot;famVLAN&quot;/>&#xa;    &lt;xsl:param name=&quot;descrArea&quot;/>&#xa;    &lt;xsl:param name=&quot;ftthOnlySQL&quot;/>&#xa;    &lt;xsl:param name=&quot;modelloKit&quot;/>&#xa;    &lt;xsl:param name=&quot;varCar&quot;/>&#xa;    &lt;xsl:param name=&quot;nomeAggregato&quot;/>&#xa;    &lt;xsl:param name=&quot;carattCar&quot;/>&#xa;    &lt;xsl:template name=&quot;LogQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperoCAR&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperoCAR&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns1:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns1:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;SQLDirect: SELECT AKV.CODICE_CAR AS CODICECAR, AA.DESCRIZIONE_AREA AS DESCRIZIONEAREA, AKV.NOME_AGGREGATO AS NOMEAGGRAGATO,AKV.TIPOLOGIA_COMUNE AS TIPOLOGIACOMUNE,AKV.FLAG_FTTH_ONLY AS FTTHONLY, AKV.BANDA_CAR AS BANDACAR FROM ANAGRAFICA_KIT_VLAN_ADR_CAR AKV INNER JOIN ANAGRAFICA_ADR AA ON AKV.ID_ADR_CRMWS = AA.ID_ADR_CRMWS WHERE AKV.CODICE_KIT='&amp;quot;,$post.item/tns:codiceTDKIT,&amp;quot;' &amp;quot;,$ftthOnlySQL,&amp;quot; &amp;quot;,$superMA,&amp;quot; AND AKV.ID_ADR_CRMWS &amp;quot;,$descrArea,$modelloKit,&amp;quot; AND AKV.ID_TIPOLOGIA_COS = (SELECT ID_TIPOLOGIA_COS FROM TIPOLOGIA_COS WHERE CODICE_TIPOLOGIA_COS = '&amp;quot;,$famVLAN,&amp;quot;') &amp;quot;,$nomeAggregato,$varCar,$carattCar,&amp;quot; ORDER BY AKV.CODICE_CAR ASC &amp;quot;)&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.RecuperoCAR&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns1:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns1:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns1:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns1:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns1:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoCAR_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;COMPLETE&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoCAR_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_creazioneOrdine.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
