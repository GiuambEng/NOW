                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if ((string-length($post/item/tns:inputRecuperoCAR/tns:ftthOnly)=0 and string-length($post/item/tns:inputRecuperoCAR/tns:ccLib)=0 and $post/item/tns:inputRecuperoCAR/tns:flagDRG='Y') or (string-length($post/item/tns:inputRecuperoCAR/tns:ftthOnly)=0 and $post/item/tns:inputRecuperoCAR/tns:supermacroarea=('Consegna su CAR di MAdR reale','Consegna su CAR di MAdR ‘SUPERMACROAREA’') and $post/item/tns:inputRecuperoCAR/tns:flagDRG='Y')) then &quot; AND AKV.CARATTERISTICACAR LIKE 'DRG%'&quot; else &quot; AND AKV.CARATTERISTICACAR  is null&quot;"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="carattCar"
