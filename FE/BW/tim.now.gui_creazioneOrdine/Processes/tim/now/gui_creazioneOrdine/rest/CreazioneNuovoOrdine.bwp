       &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                        &lt;tns:email>&#xa;                            &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                        &lt;/tns:email>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:codiceReferente&quot;>&#xa;                        &lt;tns:codiceReferente>&#xa;                            &lt;xsl:value-of select=&quot;tns:codiceReferente&quot;/>&#xa;                        &lt;/tns:codiceReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:indirizzo&quot;>&#xa;                        &lt;tns:indirizzo>&#xa;                            &lt;xsl:value-of select=&quot;tns:indirizzo&quot;/>&#xa;                        &lt;/tns:indirizzo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:fax&quot;>&#xa;                        &lt;tns:fax>&#xa;                            &lt;xsl:value-of select=&quot;tns:fax&quot;/>&#xa;                        &lt;/tns:fax>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:cap&quot;>&#xa;                        &lt;tns:cap>&#xa;                            &lt;xsl:value-of select=&quot;tns:cap&quot;/>&#xa;                        &lt;/tns:cap>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:codiceComuneReferente&quot;>&#xa;                        &lt;tns:codiceComuneReferente>&#xa;                            &lt;xsl:value-of select=&quot;tns:codiceComuneReferente&quot;/>&#xa;                        &lt;/tns:codiceComuneReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:distrettoFisso&quot;>&#xa;                        &lt;tns:distrettoFisso>&#xa;                            &lt;xsl:value-of select=&quot;tns:distrettoFisso&quot;/>&#xa;                        &lt;/tns:distrettoFisso>&#xa;    