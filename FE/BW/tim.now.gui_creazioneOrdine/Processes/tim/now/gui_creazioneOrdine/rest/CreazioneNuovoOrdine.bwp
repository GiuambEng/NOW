                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+037835bf-21b4-4c59-9b7b-04246a9e5081+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;Migrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Attivazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Cessazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Variazione&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoSequence&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertRichieste-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'ATTIVAZIONE'&quot;>&#xa;                    &lt;CODICE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Attivazione/tns:outputLavorazioni/tns:codiceOloAgcom)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione/tns:outputLavorazioni/tns:codiceOloAgcom&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'CESSAZIONE'&quot;>&#xa;                    &lt;CODICE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Cessazione/tns:outputLavorazioni/tns:codiceOloAgcom)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Cessazione/tns:outputLavorazioni/tns:codiceOloAgcom&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'VARIAZIONE'&quot;>&#xa;                    &lt;CODICE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Variazione/tns:outputLavorazioni/tns:codiceOloAgcom)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione/tns:outputLavorazioni/tns:codiceOloAgcom&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODICE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Migrazione/tns:outputLavorazioni/tns:codiceOloAgcom)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Migrazione/tns:outputLavorazioni/tns:codiceOloAgcom&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;AMBITO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/AMBITO>&#xa;            &lt;ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoSequence/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/ID_RICHIESTA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'ATTIVAZIONE'&quot;>&#xa;                    &lt;CONTENUTO_XML_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Attivazione/tns:outputLavorazioni/tns:contenutoXmlOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione/tns:outputLavorazioni/tns:contenutoXmlOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'CESSAZIONE'&quot;>&#xa;                    &lt;CONTENUTO_XML_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Cessazione/tns:outputLavorazioni/tns:contenutoXmlOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Cessazione/tns:outputLavorazioni/tns:contenutoXmlOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'VARIAZIONE'&quot;>&#xa;                    &lt;CONTENUTO_XML_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Variazione/tns:outputLavorazioni/tns:contenutoXmlOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione/tns:outputLavorazioni/tns:contenutoXmlOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_XML_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Migrazione/tns:outputLavorazioni/tns:contenutoXmlOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Migrazione/tns:outputLavorazioni/tns:contenutoXmlOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = ('ATTIVAZIONE','CESSAZIONE') and upper-case($post/item/tns:nuovoOrdine/tns:offertaCatalogo) = 'CPS'&quot;>&#xa;                    &lt;STATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA_ELABORARE_CPS&amp;quot;&quot;/>&#xa;                    &lt;/STATO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/STATO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;XML_CASEDATA_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), false())&quot;/>&#xa;            &lt;/XML_CASEDATA_RICHIESTA>&#xa;            &lt;TIMESTAMP_CREAZIONE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMESTAMP_CREAZIONE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'ATTIVAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post/item/tns:nuovoOrdine/tns:offertaCatalogo) = 'CPS'&quot;>&#xa;                            &lt;STRUTTURARICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CPS&amp;quot;&quot;/>&#xa;                            &lt;/STRUTTURARICHIESTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;STRUTTURARICHIESTA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Attivazione/tns:outputLavorazioni/tns:strutturaRichiesta)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Attivazione/tns:outputLavorazioni/tns:strutturaRichiesta&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/STRUTTURARICHIESTA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post/item/tns:nuovoOrdine/tns:offertaCatalogo) = 'CPS'&quot;>&#xa;                            &lt;STRUTTURARICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CPS&amp;quot;&quot;/>&#xa;                            &lt;/STRUTTURARICHIESTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;STRUTTURARICHIESTA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Cessazione/tns:outputLavorazioni/tns:strutturaRichiesta)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Cessazione/tns:outputLavorazioni/tns:strutturaRichiesta&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/STRUTTURARICHIESTA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'VARIAZIONE'&quot;>&#xa;                    &lt;STRUTTURARICHIESTA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Variazione/tns:outputLavorazioni/tns:strutturaRichiesta)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione/tns:outputLavorazioni/tns:strutturaRichiesta&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STRUTTURARICHIESTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STRUTTURARICHIESTA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Migrazione/tns:outputLavorazioni/tns:strutturaRichiesta)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Migrazione/tns:outputLavorazioni/tns:strutturaRichiesta&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STRUTTURARICHIESTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CANALE_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/CANALE_RICHIESTA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'ATTIVAZIONE'&quot;>&#xa;                    &lt;CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Attivazione/tns:outputLavorazioni/tns:codiceOrdineOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione/tns:outputLavorazioni/tns:codiceOrdineOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'CESSAZIONE'&quot;>&#xa;                    &lt;CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Cessazione/tns:outputLavorazioni/tns:codiceOrdineOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Cessazione/tns:outputLavorazioni/tns:codiceOrdineOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:causaleOrdine = 'VARIAZIONE'&quot;>&#xa;                    &lt;CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Variazione/tns:outputLavorazioni/tns:codiceOrdineOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione/tns:outputLavorazioni/tns:codiceOrdineOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Migrazione/tns:outputLavorazioni/tns:codiceOrdineOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Migrazione/tns:outputLavorazioni/tns:codiceOrdineOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DN']/tns:valore)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DN']/tns:valore&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;(upper-case($post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore) = ('POTS','ISDN')) and (upper-case($post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'STRUTTURALINEA']/tns:valore) = ('PBX','GNR'))&quot;>&#xa;                    &lt;DN_ALTERNATIVO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'RADICALE']/tns:valore)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'RADICALE']/tns:valore&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN_ALTERNATIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(upper-case($post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore) = 'ISDN') and (upper-case($post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'STRUTTURALINEA']/tns:valore) = 'BRA')&quot;>&#xa;                    &lt;DN_ALTERNATIVO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DNPRIMARIO']/tns:valore)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$post/item/tns:nuovoOrdine/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DNPRIMARIO']/tns:valore&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN_ALTERNATIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DN_ALTERNATIVO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/DN_ALTERNATIVO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post/item/tns:nuovoOrdine/tns:idOfferta = ('65','66')&quot;>&#xa;                    &lt;PARAMETRO>&#xa;                        &lt;xsl:value-of select=&quot;'GPON'&quot;/>&#xa;                    &lt;/PARAMETRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;PARAMETRO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/PARAMETRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="InsertRichieste-input"
                                    name="InsertRichieste"
                                    outputVariable="InsertRichieste"
                                    tibex:xpdlId="037835bf-21b4-4c59-9b7b-04246a9e5081" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToInsertRichieste"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsertRichiesteToRepeatOnError">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="InsertRichiesteToOutputCreazioneNuovoOrdine_AttivazioneCPS">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($post/item/ns2:nuovoOrdine/ns2:offertaCatalogo) = 'CPS' and ($post/item/ns2:nuovoOrdine/ns2:causaleOrdine = 'ATTIVAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($post.item/ns2:offertaCatalogo) = 'CPS' and ($post.item/ns2:causaleOrdine = 'ATTIVAZIONE')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+037835bf-21b4-4c59-9b7b-04246a9e5081+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Migrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Attivazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Cessazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Variazione&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoSequence&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertRichieste-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'ATTIVAZIONE'&quot;>&#xa;                    &lt;CODICE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Attivazione/tns:outputLavorazioni/tns:codiceOloAgcom)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione/tns:outputLavorazioni/tns:codiceOloAgcom&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'CESSAZIONE'&quot;>&#xa;                    &lt;CODICE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Cessazione/tns:outputLavorazioni/tns:codiceOloAgcom)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Cessazione/tns:outputLavorazioni/tns:codiceOloAgcom&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'VARIAZIONE'&quot;>&#xa;                    &lt;CODICE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Variazione/tns:outputLavorazioni/tns:codiceOloAgcom)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione/tns:outputLavorazioni/tns:codiceOloAgcom&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODICE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Migrazione/tns:outputLavorazioni/tns:codiceOloAgcom)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Migrazione/tns:outputLavorazioni/tns:codiceOloAgcom&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;AMBITO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/AMBITO>&#xa;            &lt;ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoSequence/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/ID_RICHIESTA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'ATTIVAZIONE'&quot;>&#xa;                    &lt;CONTENUTO_XML_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Attivazione/tns:outputLavorazioni/tns:contenutoXmlOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione/tns:outputLavorazioni/tns:contenutoXmlOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'CESSAZIONE'&quot;>&#xa;                    &lt;CONTENUTO_XML_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Cessazione/tns:outputLavorazioni/tns:contenutoXmlOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Cessazione/tns:outputLavorazioni/tns:contenutoXmlOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'VARIAZIONE'&quot;>&#xa;                    &lt;CONTENUTO_XML_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Variazione/tns:outputLavorazioni/tns:contenutoXmlOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione/tns:outputLavorazioni/tns:contenutoXmlOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_XML_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Migrazione/tns:outputLavorazioni/tns:contenutoXmlOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Migrazione/tns:outputLavorazioni/tns:contenutoXmlOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = ('ATTIVAZIONE','CESSAZIONE') and upper-case($post.item/tns:offertaCatalogo) = 'CPS'&quot;>&#xa;                    &lt;STATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA_ELABORARE_CPS&amp;quot;&quot;/>&#xa;                    &lt;/STATO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/STATO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;XML_CASEDATA_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), false())&quot;/>&#xa;            &lt;/XML_CASEDATA_RICHIESTA>&#xa;            &lt;TIMESTAMP_CREAZIONE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMESTAMP_CREAZIONE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'ATTIVAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post.item/tns:offertaCatalogo) = 'CPS'&quot;>&#xa;                            &lt;STRUTTURARICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CPS&amp;quot;&quot;/>&#xa;                            &lt;/STRUTTURARICHIESTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;STRUTTURARICHIESTA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Attivazione/tns:outputLavorazioni/tns:strutturaRichiesta)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Attivazione/tns:outputLavorazioni/tns:strutturaRichiesta&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/STRUTTURARICHIESTA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'CESSAZIONE'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post.item/tns:offertaCatalogo) = 'CPS'&quot;>&#xa;                            &lt;STRUTTURARICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CPS&amp;quot;&quot;/>&#xa;                            &lt;/STRUTTURARICHIESTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;STRUTTURARICHIESTA>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Cessazione/tns:outputLavorazioni/tns:strutturaRichiesta)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Cessazione/tns:outputLavorazioni/tns:strutturaRichiesta&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/STRUTTURARICHIESTA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'VARIAZIONE'&quot;>&#xa;                    &lt;STRUTTURARICHIESTA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Variazione/tns:outputLavorazioni/tns:strutturaRichiesta)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione/tns:outputLavorazioni/tns:strutturaRichiesta&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STRUTTURARICHIESTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STRUTTURARICHIESTA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Migrazione/tns:outputLavorazioni/tns:strutturaRichiesta)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Migrazione/tns:outputLavorazioni/tns:strutturaRichiesta&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STRUTTURARICHIESTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CANALE_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/CANALE_RICHIESTA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'ATTIVAZIONE'&quot;>&#xa;                    &lt;CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Attivazione/tns:outputLavorazioni/tns:codiceOrdineOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione/tns:outputLavorazioni/tns:codiceOrdineOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'CESSAZIONE'&quot;>&#xa;                    &lt;CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Cessazione/tns:outputLavorazioni/tns:codiceOrdineOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Cessazione/tns:outputLavorazioni/tns:codiceOrdineOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine = 'VARIAZIONE'&quot;>&#xa;                    &lt;CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Variazione/tns:outputLavorazioni/tns:codiceOrdineOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Variazione/tns:outputLavorazioni/tns:codiceOrdineOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Migrazione/tns:outputLavorazioni/tns:codiceOrdineOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Migrazione/tns:outputLavorazioni/tns:codiceOrdineOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DN']/tns:valore)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DN']/tns:valore&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;(upper-case($post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore) = ('POTS','ISDN')) and (upper-case($post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'STRUTTURALINEA']/tns:valore) = ('PBX','GNR'))&quot;>&#xa;                    &lt;DN_ALTERNATIVO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'RADICALE']/tns:valore)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'RADICALE']/tns:valore&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN_ALTERNATIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(upper-case($post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore) = 'ISDN') and (upper-case($post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'STRUTTURALINEA']/tns:valore) = 'BRA')&quot;>&#xa;                    &lt;DN_ALTERNATIVO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DNPRIMARIO']/tns:valore)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DNPRIMARIO']/tns:valore&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN_ALTERNATIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DN_ALTERNATIVO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/DN_ALTERNATIVO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:idOfferta = ('65','66')&quot;>&#xa;                    &lt;PARAMETRO>&#xa;                        &lt;xsl:value-of select=&quot;'GPON'&quot;/>&#xa;                    &lt;/PARAMETRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;PARAMETRO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/PARAMETRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO ACQUISIZIONE_RICHIESTE(CODICE_OLO,AMBITO,ID_RICHIESTA,CONTENUTO_XML_OLO,STATO,XML_CASEDATA_RICHIESTA,TIMESTAMP_CREAZIONE,STRUTTURARICHIESTA,CANALE_RICHIESTA,CODICE_ORDINE_OLO,DN,DN_ALTERNATIVO,PARAMETRO)&#xd;&#xa;VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="AMBITO"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_RICHIESTA"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_XML_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="XML_CASEDATA_RICHIESTA"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_CREAZIONE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURARICHIESTA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CANALE_RICHIESTA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_ORDINE_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN_ALTERNATIVO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PARAMETRO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RecuperoSequence-input"
                                    name="RecuperoSequence"
                                    outputVariable="RecuperoSequence"
                                    tibex:xpdlId="0099db67-c197-4033-8652-e4f45524f868" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InfoLogCreazioneNuovoOrdineToRecuperoSequence"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoSequenceToEmpty"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0099db67-c197-4033-8652-e4f45524f868+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
