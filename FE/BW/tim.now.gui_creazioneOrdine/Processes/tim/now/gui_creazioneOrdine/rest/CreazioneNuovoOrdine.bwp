                                    tibex:xpdlId="d22a91b5-7e9b-49e2-8031-45b994948a06"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToCallProcess_Variazione"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VariazioneToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($Variazione/ns2:outputLavorazioni/ns2:xmlString)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($Variazione/ns2:outputLavorazioni/ns2:xmlString)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VariazioneToThrow2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Variazione/ns2:result/ns2:severity = 'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Variazione/ns2:result/ns2:severity = 'ERROR']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VariazioneToOutputCreazioneNuovoOrdine">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;Variazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:nuovoOrdine>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:causaleOrdine&quot;>&#xa;                &lt;tns:causaleOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:causaleOrdine&quot;/>&#xa;                &lt;/tns:causaleOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:oao&quot;>&#xa;                &lt;tns:oao>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:oao&quot;/>&#xa;                &lt;/tns:oao>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceOrdine&quot;>&#xa;                &lt;tns:codiceOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdine&quot;/>&#xa;                &lt;/tns:codiceOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:operatore&quot;>&#xa;                &lt;tns:operatore>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:operatore&quot;/>&#xa;                &lt;/tns:operatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceOrdinePadre&quot;>&#xa;                &lt;tns:codiceOrdinePadre>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/tns:codiceOrdinePadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idContratto&quot;>&#xa;                &lt;tns:idContratto>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idContratto&quot;/>&#xa;                &lt;/tns:idContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idContrattoOfferta&quot;>&#xa;                &lt;tns:idContrattoOfferta>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idContrattoOfferta&quot;/>&#xa;                &lt;/tns:idContrattoOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:noteDaOperatore&quot;>&#xa;                &lt;tns:noteDaOperatore>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:noteDaOperatore&quot;/>&#xa;                &lt;/tns:noteDaOperatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceProgetto&quot;>&#xa;                &lt;tns:codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceProgetto&quot;/>&#xa;                &lt;/tns:codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceDelivery&quot;>&#xa;                &lt;tns:codiceDelivery>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceDelivery&quot;/>&#xa;                &lt;/tns:codiceDelivery>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceQualita&quot;>&#xa;                &lt;tns:codiceQualita>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceQualita&quot;/>&#xa;                &lt;/tns:codiceQualita>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:tipoModifica&quot;>&#xa;                &lt;tns:tipoModifica>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:tipoModifica&quot;/>&#xa;                &lt;/tns:tipoModifica>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idRisorsa&quot;>&#xa;                &lt;tns:idRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idRisorsa&quot;/>&#xa;                &lt;/tns:idRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceSessione1&quot;>&#xa;                &lt;tns:codiceSessione1>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceSessione1&quot;/>&#xa;                &lt;/tns:codiceSessione1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idRisorsa2&quot;>&#xa;                &lt;tns:idRisorsa2>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idRisorsa2&quot;/>&#xa;                &lt;/tns:idRisorsa2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceSessione2&quot;>&#xa;                &lt;tns:codiceSessione2>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceSessione2&quot;/>&#xa;                &lt;/tns:codiceSessione2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:dac&quot;>&#xa;                &lt;tns:dac>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:dac&quot;/>&#xa;                &lt;/tns:dac>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:flagMonitoraggio&quot;>&#xa;                &lt;tns:flagMonitoraggio>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:flagMonitoraggio&quot;/>&#xa;                &lt;/tns:flagMonitoraggio>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:flagRientro&quot;>&#xa;                &lt;tns:flagRientro>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:flagRientro&quot;/>&#xa;                &lt;/tns:flagRientro>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:flagRientroVeloce&quot;>&#xa;                &lt;tns:flagRientroVeloce>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:flagRientroVeloce&quot;/>&#xa;                &lt;/tns:flagRientroVeloce>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:tipoRientro&quot;>&#xa;                &lt;tns:tipoRientro>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:tipoRientro&quot;/>&#xa;                &lt;/tns:tipoRientro>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:dataRicezioneRichiesta&quot;>&#xa;                &lt;tns:dataRicezioneRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:dataRicezioneRichiesta&quot;/>&#xa;                &lt;/tns:dataRicezioneRichiesta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:routingNumber&quot;>&#xa;                &lt;tns:routingNumber>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:routingNumber&quot;/>&#xa;                &lt;/tns:routingNumber>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:dn&quot;>&#xa;                &lt;tns:dn>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:dn&quot;/>&#xa;                &lt;/tns:dn>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:offertaCatalogo&quot;>&#xa;                &lt;tns:offertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:offertaCatalogo&quot;/>&#xa;                &lt;/tns:offertaCatalogo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:tipoVariazione&quot;>&#xa;                &lt;tns:tipoVariazione>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:tipoVariazione&quot;/>&#xa;                &lt;/tns:tipoVariazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:opzioneVariazione&quot;>&#xa;                &lt;tns:opzioneVariazione>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:opzioneVariazione&quot;/>&#xa;                &lt;/tns:opzioneVariazione>&#xa;            &lt;/xsl:if>&#xa;       