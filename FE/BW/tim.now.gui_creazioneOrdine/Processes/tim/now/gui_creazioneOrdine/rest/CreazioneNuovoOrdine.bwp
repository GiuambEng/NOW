                                    <bpws:source linkName="LogToJDBCUpdate3">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="contains($FaultDetails2/StackTrace,&quot;TimeoutException&quot;) or contains($FaultDetails2/StackTrace,&quot;Timeout&quot;) or contains($FaultDetails2/StackTrace,'timeout')&#xd;&#xa;or contains($FaultDetails2/StackTrace,'time out') or contains($FaultDetails2/StackTrace,'Time out') or contains($FaultDetails2/StackTrace,'time Out') or contains($FaultDetails2/StackTrace,'TimeOut') or contains($FaultDetails2/StackTrace,'Time Out')or contains($FaultDetails2/StackTrace,'Timeout')&#xd;&#xa;or contains($FaultDetails2/StackTrace,'timeOut') or contains($FaultDetails2/StackTrace,'timed out')or contains($FaultDetails2/StackTrace,'Timed out') or contains($FaultDetails2/StackTrace,'timed Out') or contains($FaultDetails2/StackTrace,'Timed Out') or contains($FaultDetails2/StackTrace,'timedout')&#xd;&#xa;or contains($FaultDetails2/StackTrace,'TimedOut') or contains($FaultDetails2/StackTrace,'Timedout') or contains($FaultDetails2/StackTrace,'timedOut')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($FaultDetails2/StackTrace,"TimeoutException") or contains($FaultDetails2/StackTrace,"Timeout") or contains($FaultDetails2/StackTrace,'timeout')
or contains($FaultDetails2/StackTrace,'time out') or contains($FaultDetails2/StackTrace,'Time out') or contains($FaultDetails2/StackTrace,'time Out') or contains($FaultDetails2/StackTrace,'TimeOut') or contains($FaultDetails2/StackTrace,'Time Out')or contains($FaultDetails2/StackTrace,'Timeout')
or contains($FaultDetails2/StackTrace,'timeOut') or contains($FaultDetails2/StackTrace,'timed out')or contains($FaultDetails2/StackTrace,'Timed out') or contains($FaultDetails2/StackTrace,'timed Out') or contains($FaultDetails2/StackTrace,'Timed Out') or contains($FaultDetails2/StackTrace,'timedout')
or contains($FaultDetails2/StackTrace,'TimedOut') or contains($FaultDetails2/StackTrace,'Timedout') or contains($FaultDetails2/StackTrace,'timedOut')]]></bpws:transitionCondition>
                                    </bpws:source>

