                                    <bpws:transitionCondition><![CDATA[$post.item/ns2:causaleOrdine = 'CESSAZIONE' and $Cessazione/ns2:outputLavorazioni/ns2:strutturaRichiesta = 'FWA' and string-length($createProcessInstance.params)]]></bpws:transitionCondition>
