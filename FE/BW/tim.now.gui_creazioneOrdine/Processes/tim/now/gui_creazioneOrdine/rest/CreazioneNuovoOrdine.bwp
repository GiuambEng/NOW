                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/bx/2009/management/process/BxProcessManagementService_1.10.0&quot; xmlns:ns0=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Cessazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Attivazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Migrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Variazione&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoSequence&quot;/>&#xa;    &lt;xsl:template name=&quot;createProcessInstance-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:createProcessInstanceInput>&#xa;            &lt;ns0:processQName>&#xa;                &lt;ns0:moduleName>&#xa;                    &lt;xsl:value-of select=&quot;'/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaMainProject.xpdl'&quot;/>&#xa;                &lt;/ns0:moduleName>&#xa;                &lt;ns0:processName>&#xa;                    &lt;xsl:value-of select=&quot;'TINOWAcquisizioneRichiestaMaster'&quot;/>&#xa;                &lt;/ns0:processName>&#xa;            &lt;/ns0:processQName>&#xa;            &lt;ns0:operationName>&#xa;                &lt;xsl:value-of select=&quot;'StartEventAcquisizioneRichiestaMaster'&quot;/>&#xa;            &lt;/ns0:operationName>&#xa;            &lt;ns0:options>&#xa;                &lt;ns0:priority>&#xa;                    &lt;xsl:value-of select=&quot;310&quot;/>&#xa;                &lt;/ns0:priority>&#xa;            &lt;/ns0:options>&#xa;            &lt;ns0:parameterMap>&#xa;                &lt;ns0:parameter>&#xa;                    &lt;ns0:name>&#xa;                        &lt;xsl:value-of select=&quot;'localRequest'&quot;/>&#xa;                    &lt;/ns0:name>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine='ATTIVAZIONE'&quot;>&#xa;                            &lt;ns0:value>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Attivazione/tns:outputLavorazioni/tns:xmlString)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Attivazione/tns:outputLavorazioni/tns:xmlString&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ns0:value>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns:causaleOrdine='VARIAZIONE'&quot;>&#xa;                            &lt;ns0:value>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Variazione/tns:outputLavorazioni/tns:xmlString)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Variazione/tns:outputLavorazioni/tns:xmlString&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/ns0:value>&#xa;                        &lt;/xsl:when>&#xa;                    