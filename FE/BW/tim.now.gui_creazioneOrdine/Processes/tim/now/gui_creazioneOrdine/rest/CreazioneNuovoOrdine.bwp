atalogo>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:offertaCatalogo&quot;/>&#xa;                &lt;/tns:offertaCatalogo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:tipoVariazione&quot;>&#xa;                &lt;tns:tipoVariazione>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:tipoVariazione&quot;/>&#xa;                &lt;/tns:tipoVariazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:opzioneVariazione&quot;>&#xa;                &lt;tns:opzioneVariazione>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:opzioneVariazione&quot;/>&#xa;                &lt;/tns:opzioneVariazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:variazione&quot;>&#xa;                &lt;tns:variazione>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:variazione&quot;/>&#xa;                &lt;/tns:variazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idullco&quot;>&#xa;                &lt;tns:idullco>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idullco&quot;/>&#xa;                &lt;/tns:idullco>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:flagNp&quot;>&#xa;                &lt;tns:flagNp>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:flagNp&quot;/>&#xa;                &lt;/tns:flagNp>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:dad&quot;>&#xa;                &lt;tns:dad>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:dad&quot;/>&#xa;                &lt;/tns:dad>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:fasciaOraria&quot;>&#xa;                &lt;tns:fasciaOraria>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:fasciaOraria&quot;/>&#xa;                &lt;/tns:fasciaOraria>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:numeroVerdeOperatorePT&quot;>&#xa;                &lt;tns:numeroVerdeOperatorePT>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:numeroVerdeOperatorePT&quot;/>&#xa;                &lt;/tns:numeroVerdeOperatorePT>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                &lt;tns:numeroVerdeOperatoreCollaudo>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                &lt;/tns:numeroVerdeOperatoreCollaudo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:centrale&quot;>&#xa;                &lt;tns:centrale>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:centrale&quot;/>&#xa;                &lt;/tns:centrale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceGAT&quot;>&#xa;                &lt;tns:codiceGAT>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceGAT&quot;/>&#xa;                &lt;/tns:codiceGAT>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:dnOperatoreCollaudo&quot;>&#xa;                &lt;tns:dnOperatoreCollaudo>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:dnOperatoreCollaudo&quot;/>&#xa;                &lt;/tns:dnOperatoreCollaudo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:numeroRichiestaColocazione&quot;>&#xa;                &lt;tns:numeroRichiestaColocazione>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:numeroRichiestaColocazione&quot;/>&#xa;                &lt;/tns:numeroRichiestaColocazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:flagMonitoraggioSTS&quot;>&#xa;                &lt;tns:flagMonitoragg