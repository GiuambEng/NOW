                                    expression="$index>3" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index>3]]></bpws:condition>
                                    <bpws:rethrow
                                    name="Rethrow" tibex:xpdlId="95a1732f-e4a2-4dca-a276-a8f761c43a74"/>
                                    <bpws:else>
