                        &lt;/ns0:moduleName&gt;
                        &lt;ns0:processName&gt;
                            &lt;xsl:value-of select="'TINOWAcquisizioneRichiestaMaster'"/&gt;
                        &lt;/ns0:processName&gt;
                    &lt;/ns0:processQName&gt;
                    &lt;ns0:operationName&gt;
                        &lt;xsl:value-of select="'StartEventAcquisizioneRichiestaMaster'"/&gt;
                    &lt;/ns0:operationName&gt;
                    &lt;ns0:options&gt;
                        &lt;ns0:priority&gt;
                            &lt;xsl:value-of select="310"/&gt;
                        &lt;/ns0:priority&gt;
                    &lt;/ns0:options&gt;
                    &lt;ns0:parameterMap&gt;
                        &lt;ns0:parameter&gt;
                            &lt;ns0:name&gt;
                                &lt;xsl:value-of select="'localRequest'"/&gt;
                            &lt;/ns0:name&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$post/item/tns:nuovoOrdine/tns:causaleOrdine='ATTIVAZIONE'"&gt;
                                    &lt;ns0:value&gt;
                                        &lt;xsl:choose&gt;
                                            &lt;xsl:when test="exists($Attivazione/tns:outputLavorazioni/tns:xmlString)"&gt;
                                                &lt;xsl:value-of select="$Attivazione/tns:outputLavorazioni/tns:xmlString"/&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:otherwise&gt;
                                                &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                            &lt;/xsl:otherwise&gt;
                                        &lt;/xsl:choose&gt;
                                    &lt;/ns0:value&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="$post/item/tns:nuovoOrdine/tns:causaleOrdine='VARIAZIONE'"&gt;
                                    &lt;ns0:value&gt;
                                        &lt;xsl:choose&gt;
                                            &lt;xsl:when test="exists($Variazione/tns:outputLavorazioni/tns:xmlString)"&gt;
                                                &lt;xsl:value-of select="$Variazione/tns:outputLavorazioni/tns:xmlString"/&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:otherwise&gt;
                                                &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                            &lt;/xsl:otherwise&gt;
                                        &lt;/xsl:choose&gt;
                                    &lt;/ns0:value&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="$post/item/tns:nuovoOrdine/tns:causaleOrdine='MIGRAZIONE'"&gt;
                                    &lt;ns0:value&gt;
                                        &lt;xsl:choose&gt;
                                            &lt;xsl:when test="exists($Migrazione/tns:outputLavorazioni/tns:xmlString)"&gt;
                                                &lt;xsl:value-of select="$Migrazione/tns:outputLavorazioni/tns:xmlString"/&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:otherwise&gt;
                                                &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                            &lt;/xsl:otherwise&gt;
                                        &lt;/xsl:choose&gt;
                                    &lt;/ns0:value&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;ns0:value&gt;
                                        &lt;xsl:choose&gt;
                                            &lt;xsl:when test="exists($Cessazione/tns:outputLavorazioni/tns:xmlString)"&gt;
                                                &lt;xsl:value-of select="$Cessazione/tns:outputLavorazioni/tns:xmlString"/&gt;
                                            &lt;/xsl:when&gt;
                                            &lt;xsl:otherwise&gt;
                                                &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                            &lt;/xsl:otherwise&gt;
                                        &lt;/xsl:choose&gt;
                                    &lt;/ns0:value&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/ns0:parameter&gt;
                        &lt;ns0:parameter&gt;
                            &lt;ns0:name&gt;
                                &lt;xsl:value-of select="'AcquisitionID'"/&gt;
                            &lt;/ns0:name&gt;
