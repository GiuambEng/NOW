                                    expression="$post/item/ns2:nuovoOrdine/ns2:causaleOrdine = 'CESSAZIONE' and $Cessazione/ns2:outputLavorazioni/ns2:strutturaRichiesta = 'FWA' and string-length($createProcessInstance/params/ns01:processID)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
