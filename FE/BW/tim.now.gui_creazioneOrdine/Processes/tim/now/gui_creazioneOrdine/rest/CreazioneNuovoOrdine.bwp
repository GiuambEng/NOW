vo>&lt;xsl:value-of select=&quot;tns:clliFeederSuccessivo&quot;/>&lt;/tns:clliFeederSuccessivo>&lt;/xsl:if>&lt;/tns:clliFeederSuccessivi>&lt;/xsl:for-each>&lt;/tns:datiOfferteMulticast>&lt;xsl:if test=&quot;$post/item/tns:nuovoOrdine/tns:refOaoProgettiSpeciali&quot;>&lt;tns:refOaoProgettiSpeciali>&lt;xsl:value-of select=&quot;$post/item/tns:nuovoOrdine/tns:refOaoProgettiSpeciali&quot;/>&lt;/tns:refOaoProgettiSpeciali>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$post/item/tns:nuovoOrdine/tns:datiServiziAggiuntivi&quot;>&lt;tns:datiServiziAggiuntivi>&lt;xsl:for-each select=&quot;tns:apparati&quot;>&lt;tns:apparati>&lt;xsl:if test=&quot;tns:codiceApparato&quot;>&lt;tns:codiceApparato>&lt;xsl:value-of select=&quot;tns:codiceApparato&quot;/>&lt;/tns:codiceApparato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:tipologiaApparato&quot;>&lt;tns:tipologiaApparato>&lt;xsl:value-of select=&quot;tns:tipologiaApparato&quot;/>&lt;/tns:tipologiaApparato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:passwordApparato&quot;>&lt;tns:passwordApparato>&lt;xsl:value-of select=&quot;tns:passwordApparato&quot;/>&lt;/tns:passwordApparato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:azioneApparato&quot;>&lt;tns:azioneApparato>&lt;xsl:value-of select=&quot;tns:azioneApparato&quot;/>&lt;/tns:azioneApparato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:qtaApparato&quot;>&lt;tns:qtaApparato>&lt;xsl:value-of select=&quot;tns:qtaApparato&quot;/>&lt;/tns:qtaApparato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:causale&quot;>&lt;tns:causale>&lt;xsl:value-of select=&quot;tns:causale&quot;/>&lt;/tns:causale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:idServizioAggiuntivo&quot;>&lt;tns:idServizioAggiuntivo>&lt;xsl:value-of select=&quot;tns:idServizioAggiuntivo&quot;/>&lt;/tns:idServizioAggiuntivo>&lt;/xsl:if>&lt;/tns:apparati>&lt;/xsl:for-each>&lt;xsl:if test=&quot;tns:nomeServizio&quot;>&lt;tns:nomeServizio>&lt;xsl:value-of select=&quot;tns:nomeServizio&quot;/>&lt;/tns:nomeServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:informazioniServizio&quot;>&lt;tns:informazioniServizio>&lt;xsl:value-of select=&quot;tns:informazioniServizio&quot;/>&lt;/tns:informazioniServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:vincoloServizio&quot;>&lt;tns:vincoloServizio>&lt;xsl:value-of select=&quot;tns:vincoloServizio&quot;/>&lt;/tns:vincoloServizio>&lt;/xsl:if>&lt;/tns:datiServiziAggiuntivi>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$post/item/tns:nuovoOrdine/tns:codOperatoreSecondario&quot;>&lt;tns:codOperatoreSecondario>&lt;xsl:value-of select=&quot;$post/item/tns:nuovoOrdine/tns:codOperatoreSecondario&quot;/>&lt;/tns:codOperatoreSecondario>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:nuovoOrdine/tns:dataPrevistaAttivazione&quot;>&lt;tns:dataPrevistaAttivazione>&lt;xsl:value-of select=&quot;$post/item/tns:nuovoOrdine/tns:dataPrevistaAttivazione&quot;/>&lt;/tns:dataPrevistaAttivazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:nuovoOrdine/tns:clusterAccesso&quot;>&lt;tns:clusterAccesso>&lt;xsl:value-of select=&quot;$post/item/tns:nuovoOrdine/tns:clusterAccesso&quot;/>&lt;/tns:clusterAccesso>&lt;/xsl:if>&lt;/tns:nuovoOrdine>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Attivazione-input"
                                    name="Attivazione"
                                    outputVariable="Attivazione"
                                    tibex:xpdlId="c1159cde-6194-4519-9d85-28f3d816ff0e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToCallProcess_Attivazione"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AttivazioneToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($Attivazione/ns2:outputLavorazioni/ns2:xmlString)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($Attivazione/ns2:outputLavorazioni/ns2:xmlString)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AttivazioneToOutputCreazioneNuovoOrdine">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AttivazioneToThrow">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Attivazione/ns2:result/ns2:severity = 'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Attivazione/ns2:result/ns2:severity = 'ERROR']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;Attivazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:nuovoOrdine>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:causaleOrdine&quot;>&#xa;                &lt;tns:causaleOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:causaleOrdine&quot;/>&#xa;                &lt;/tns:causaleOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:oao&quot;>&#xa;                &lt;tns:oao>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:oao&quot;/>&#xa;                &lt;/tns:oao>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceOrdine&quot;>&#xa;                &lt;tns:codiceOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdine&quot;/>&#xa;                &lt;/tns:codiceOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:operatore&quot;>&#xa;                &lt;tns:operatore>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:operatore&quot;/>&#xa;                &lt;/tns:operatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceOrdinePadre&quot;>&#xa;                &lt;tns:codiceOrdinePadre>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/tns:codiceOrdinePadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idContratto&quot;>&#xa;                &lt;tns:idContratto>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idContratto&quot;/>&#xa;                &lt;/tns:idContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idContrattoOfferta&quot;>&#xa;                &lt;tns:idContrattoOfferta>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idContrattoOfferta&quot;/>&#xa;                &lt;/tns:idContrattoOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:noteDaOperatore&quot;>&#xa;                &lt;tns:noteDaOperatore>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:noteDaOperatore&quot;/>&#xa;                &lt;/tns:noteDaOperatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceProgetto&quot;>&#xa;                &lt;tns:codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceProgetto&quot;/>&#xa;                &lt;/tns:codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceDelivery&quot;>&#xa;                &lt;tns:codiceDelivery>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceDelivery&quot;/>&#xa;                &lt;/tns:codiceDelivery>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceQualita&quot;>&#xa;                &lt;tns:codiceQualita>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceQualita&quot;/>&#xa;                &lt;/tns:codiceQualita>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:tipoModifica&quot;>&#xa;                &lt;tns:tipoModifica>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:tipoModifica&quot;/>&#xa;                &lt;/tns:tipoModifica>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idRisorsa&quot;>&#xa;                &lt;tns:idRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idRisorsa&quot;/>&#xa;                &lt;/tns:idRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceSessione1&quot;>&#xa;                &lt;tns:codiceSessione1>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceSessione1&quot;/>&#xa;                &lt;/tns:codiceSessione1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idRisorsa2&quot;>&#xa;                &lt;tns:idRisorsa2>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idRisorsa2&quot;/>&#xa;                &lt;/tns:idRisorsa2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceSessione2&quot;>&#xa;                &lt;tns:codiceSessione2>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceSessione2&quot;/>&#xa;                &lt;/tns:codiceSessione2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:dac&quot;>&#xa;                &lt;tns:dac>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:dac&quot;/>&#xa;                &lt;/tns:dac>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:flagMonitoraggio&quot;>&#xa;                &lt;tns:flagMonitoraggio>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:flagMonitoraggio&quot;/>&#xa;                &lt;/tns:flagMonitoraggio>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:flagRientro&quot;>&#xa;                &lt;tns:flagRientro>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:flagRientro&quot;/>&#xa;                &lt;/tns:flagRientro>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:flagRientroVeloce&quot;>&#xa;                &lt;tns:flagRientroVeloce>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:flagRientroVeloce&quot;/>&#xa;                &lt;/tns:flagRientroVeloce>&#xa;            &l