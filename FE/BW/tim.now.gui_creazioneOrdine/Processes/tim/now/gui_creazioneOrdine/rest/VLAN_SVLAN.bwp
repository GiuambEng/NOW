    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>post</variable>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="getOutsVLAN_SVLAN">
            <endingVariables>
                <variable>getOutsVLAN_SVLAN-input</variable>
            </endingVariables>
        </task>
        <task name="VLAN_SVLANAssign">
            <endingVariables>
                <variable>VLAN_Query</variable>
            </endingVariables>
        </task>
        <task name="get_VlanSvlan_InLog">
            <endingVariables>
                <variable>get_VlanSvlan_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_VlanSvlan_InLog_INFO">
            <endingVariables>
                <variable>get_VlanSvlan_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="get_VlanSvlan_outp_Log">
            <endingVariables>
                <variable>get_VlanSvlan_outp_Log-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="VLAN_Query">
            <endingVariables>
                <variable>VLAN_Query-input</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="get_VlanSvlan_ErrorLog">
            <endingVariables>
                <variable>get_VlanSvlan_ErrorLog-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>SQLDirect</variable>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="RicercaAvanzataCondition">
            <endingVariables>
                <variable>RicercaAvanzataCondition-input</variable>
            </endingVariables>
        </task>
        <task name="SQLDirect">
            <endingVariables>
                <variable>SQLDirect-input</variable>
            </endingVariables>
        </task>
        <task name="post_VlanSvlan_InLog">
            <endingVariables>
                <variable>post_VlanSvlan_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="post_VlanSvlan_InLog_INFO">
            <endingVariables>
                <variable>post_VlanSvlan_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="post_VlanSvlan_outp_Log">
            <endingVariables>
                <variable>post_VlanSvlan_outp_Log-input</variable>
                <variable>RicercaAvanzataCondition</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery">
            <endingVariables>
                <variable>JDBCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="RenderXml">
            <endingVariables>
                <variable>RenderXml-input</variable>
            </endingVariables>
        </task>
        <task name="ExportDati">
            <endingVariables>
                <variable>ExportDati-input</variable>
                <variable>RenderXml</variable>
            </endingVariables>
        </task>
        <task name="Reply1">
            <endingVariables>
                <variable>Reply1-input</variable>
                <variable>FaultDetails1</variable>
            </endingVariables>
        </task>
        <task name="post_VlanSvlan_ErrorLog">
            <endingVariables>
                <variable>post_VlanSvlan_ErrorLog-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
