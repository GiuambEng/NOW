                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VLAN_SVLAN&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VLAN_Query&quot;/>&#xa;    &lt;xsl:template name=&quot;VLAN_SVLANVariable&quot; match=&quot;/&quot;>&#xa;        &lt;tns:outputDettaglioVLAN_SVLAN>&#xa;            &lt;xsl:for-each select=&quot;$VLAN_Query/Record&quot;>&#xa;                &lt;tns:outputVLAN_SVLAN>&#xa;                    &lt;tns:codicevlan>&#xa;                        &lt;xsl:value-of select=&quot;COD_VLAN&quot;/>&#xa;                    &lt;/tns:codicevlan>&#xa;                    &lt;tns:tipobanda>&#xa;                        &lt;xsl:value-of select=&quot;TIPO_BANDA&quot;/>&#xa;                    &lt;/tns:tipobanda>&#xa;                    &lt;tns:tipocos>&#xa;                        &lt;xsl:value-of select=&quot;TIPO_COS&quot;/>&#xa;                    &lt;/tns:tipocos>&#xa;                    &lt;tns:flagencapsulation>&#xa;                        &lt;xsl:value-of select=&quot;FLAG_ENCAPSULATION&quot;/>&#xa;                    &lt;/tns:flagencapsulation>&#xa;                    &lt;tns:tipologia>&#xa;                        &lt;xsl:value-of select=&quot;TIPOLG&quot;/>&#xa;                    &lt;/tns:tipologia>&#xa;                    &lt;tns:stato>&#xa;                        &lt;xsl:value-of select=&quot;STATO&quot;/>&#xa;                    &lt;/tns:stato>&#xa;                    &lt;tns:nome>&#xa;                        &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                    &lt;/tns:nome>&#xa;                    &lt;tns:clli>&#xa;                        &lt;xsl:value-of select=&quot;CLLI&quot;/>&#xa;                    &lt;/tns:clli>&#xa;                    &lt;tns:nomecentrale>&#xa;                        &lt;xsl:value-of select=&quot;NOME_CENTRALE&quot;/>&#xa;                    &lt;/tns:nomecentrale>&#xa;                    &lt;xsl:if test=&quot;COD_KIT&quot;>&#xa;                        &lt;tns:codicekit>&#xa;                            &lt;xsl:value-of select=&quot;COD_KIT&quot;/>&#xa;                        &lt;/tns:codicekit>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:decattivazione>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(string(DEC_ATTIVAZIONE),&amp;quot;T&amp;quot;)&quot;/>&#xa;                    &lt;/tns:decattivazione>&#xa;                    &lt;tns:dec>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(string(DEC), &amp;quot;T&amp;quot;)&quot;/>&#xa;                    &lt;/tns:dec>&#xa;                    &lt;tns:codiceareadiraccolta>&#xa;                        &lt;xsl:value-of select=&quot;COD_AREA_RACCOLTA&quot;/>&#xa;                    &lt;/tns:codiceareadiraccolta>&#xa;                    &lt;tns:descareadiraccolta>&#xa;                        &lt;xsl:value-of select=&quot;DESC_AREA_RACCOLTA&quot;/>&#xa;                    &lt;/tns:descareadiraccolta>&#xa;                    &lt;tns:codicemacroarea>&#xa;                        &lt;xsl:value-of select=&quot;COD_MACRO_AREA&quot;/>&#xa;                    &lt;/tns:codicemacroarea>&#xa;                    &lt;xsl:if test=&quot;COD_SUPER_MACRO_AREA&quot;>&#xa;                        &lt;tns:codicesupermacroarea>&#xa;                            &lt;xsl:value-of select=&quot;COD_SUPER_MACRO_AREA&quot;/>&#xa;                        &lt;/tns:codicesupermacroarea>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;TIPO_TRASPORTO&quot;>&#xa;                        &lt;tns:tipotrasporto>&#xa;                            &lt;xsl:value-of select=&quot;TIPO_TRASPORTO&quot;/>&#xa;                        &lt;/tns:tipotrasporto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ID_VLAN_OLO&quot;>&#xa;                        &lt;tns:idvlanolo>&#xa;                            &lt;xsl:value-of select=&quot;ID_VLAN_OLO&quot;/>&#xa;                        &lt;/tns:idvlanolo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:flagvlantranslation>&#xa;                        &lt;xsl:value-of select=&quot;FLAG_VLAN_TRANSLATION&quot;/>&#xa;                    &lt;/tns:flagvlantranslation>&#xa;                    &lt;tns:descmacroarea>&#xa;                        &lt;xsl:value-of select=&quot;DESC_MACRO_AREA&quot;/>&#xa;                    &lt;/tns:descmacroarea>&#xa;                    &lt;xsl:if test=&quot;DESC_SUPER_MACRO_AREA&quot;>&#xa;                        &lt;tns:descsupermacroarea>&#xa;                            &lt;xsl:value-of select=&quot;DESC_SUPER_MACRO_AREA&quot;/>&#xa;                        &lt;/tns:descsupermacroarea>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;DSLAM_TYPE&quot;>&#xa;                        &lt;tns:dslamType>&#xa;                            &lt;xsl:value-of select=&quot;DSLAM_TYPE&quot;/>&#xa;                        &lt;/tns:dslamType>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;TIPOLOGIACLUSTERVLAN&quot;>&#xa;                        &lt;tns:tipologiaClusterComune>&#xa;                            &lt;xsl:value-of select=&quot;TIPOLOGIACLUSTERVLAN&quot;/>&#xa;                        &lt;/tns:tipologiaClusterComune>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;FLAGFTTHONLY&quot;>&#xa;                        &lt;tns:flagFtthOnly>&#xa;                            &lt;xsl:value-of select=&quot;FLAGFTTHONLY&quot;/>&#xa;                        &lt;/tns:flagFtthOnly>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:outputVLAN_SVLAN>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/tns:code>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:outputDettaglioVLAN_SVLAN>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
