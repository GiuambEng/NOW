                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+aea8f67e-5514-48ed-95f4-e3fe38f37fac+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzataCondition&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:strutturaCondition[1]/tns1:nome)=0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT CLLI, COD_AREA_RACCOLTA, TIPOLG, COD_KIT, COD_MACRO_AREA, COD_SUPER_MACRO_AREA, COD_VLAN, DEC, DEC_ATTIVAZIONE, DESC_AREA_RACCOLTA, DESC_MACRO_AREA, DESC_SUPER_MACRO_AREA, DSLAM_TYPE, FLAG_ENCAPSULATION, FLAG_VLAN_TRANSLATION, ID_VLAN_OLO, NOME, NOME_CENTRALE, STATO, TIPO_BANDA, TIPO_COS, TIPO_TRASPORTO, TIPOLOGIACLUSTERVLAN, FLAGFTTHONLY FROM ANAG_VLAN &amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CLLI, COD_AREA_RACCOLTA, TIPOLG, COD_KIT, COD_MACRO_AREA, COD_SUPER_MACRO_AREA, COD_VLAN, DEC, DEC_ATTIVAZIONE, DESC_AREA_RACCOLTA, DESC_MACRO_AREA, DESC_SUPER_MACRO_AREA, DSLAM_TYPE, FLAG_ENCAPSULATION, FLAG_VLAN_TRANSLATION, ID_VLAN_OLO, NOME, NOME_CENTRALE, STATO, TIPO_BANDA, TIPO_COS, TIPO_TRASPORTO, TIPOLOGIACLUSTERVLAN, FLAGFTTHONLY  FROM ANAG_VLAN WHERE &amp;quot;, $RicercaAvanzataCondition/tns1:outputcondition[1])&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
