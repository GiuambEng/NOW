                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VLAN_SVLAN&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns:outputDettaglioVLAN_SVLAN>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&lt;tns:outputVLAN_SVLAN>&lt;xsl:if test=&quot;not((string(column[name='COD_VLAN']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_VLAN']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_VLAN']/value)&quot;>&lt;tns:codicevlan>&lt;xsl:value-of select=&quot;column[name='COD_VLAN']/value&quot;/>&lt;/tns:codicevlan>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPO_BANDA']/value)&quot;>&lt;tns:tipobanda>&lt;xsl:value-of select=&quot;column[name='TIPO_BANDA']/value&quot;/>&lt;/tns:tipobanda>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPO_COS']/value)&quot;>&lt;tns:tipocos>&lt;xsl:value-of select=&quot;column[name='TIPO_COS']/value&quot;/>&lt;/tns:tipocos>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_ENCAPSULATION']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_ENCAPSULATION']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_ENCAPSULATION']/value)&quot;>&lt;tns:flagencapsulation>&lt;xsl:value-of select=&quot;column[name='FLAG_ENCAPSULATION']/value&quot;/>&lt;/tns:flagencapsulation>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLG']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLG']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLG']/value)&quot;>&lt;tns:tipologia>&lt;xsl:value-of select=&quot;column[name='TIPOLG']/value&quot;/>&lt;/tns:tipologia>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO']/value)&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;column[name='STATO']/value&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME']/value)&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;column[name='NOME']/value&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CLLI']/value)&quot;>&lt;tns:clli>&lt;xsl:value-of select=&quot;column[name='CLLI']/value&quot;/>&lt;/tns:clli>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_CENTRALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CENTRALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CENTRALE']/value)&quot;>&lt;tns:nomecentrale>&lt;xsl:value-of select=&quot;column[name='NOME_CENTRALE']/value&quot;/>&lt;/tns:nomecentrale>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_KIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_KIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_KIT']/value)&quot;>&lt;tns:codicekit>&lt;xsl:value-of select=&quot;column[name='COD_KIT']/value&quot;/>&lt;/tns:codicekit>&lt;/xsl:if>&lt;tns:decattivazione>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DEC_ATTIVAZIONE']/value), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:decattivazione>&lt;tns:dec>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DEC']/value), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dec>&lt;xsl:if test=&quot;not((string(column[name='COD_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_AREA_RACCOLTA']/value)&quot;>&lt;tns:codiceareadiraccolta>&lt;xsl:value-of select=&quot;column[name='COD_AREA_RACCOLTA']/value&quot;/>&lt;/tns:codiceareadiraccolta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESC_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESC_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESC_AREA_RACCOLTA']/value)&quot;>&lt;tns:descareadiraccolta>&lt;xsl:value-of select=&quot;column[name='DESC_AREA_RACCOLTA']/value&quot;/>&lt;/tns:descareadiraccolta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_MACRO_AREA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_MACRO_AREA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_MACRO_AREA']/value)&quot;>&lt;tns:codicemacroarea>&lt;xsl:value-of select=&quot;column[name='COD_MACRO_AREA']/value&quot;/>&lt;/tns:codicemacroarea>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_SUPER_MACRO_AREA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_SUPER_MACRO_AREA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_SUPER_MACRO_AREA']/value)&quot;>&lt;tns:codicesupermacroarea>&lt;xsl:value-of select=&quot;column[name='COD_SUPER_MACRO_AREA']/value&quot;/>&lt;/tns:codicesupermacroarea>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPO_TRASPORTO']/value)&quot;>&lt;tns:tipotrasporto>&lt;xsl:value-of select=&quot;column[name='TIPO_TRASPORTO']/value&quot;/>&lt;/tns:tipotrasporto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='ID_VLAN_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_VLAN_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_VLAN_OLO']/value)&quot;>&lt;tns:idvlanolo>&lt;xsl:value-of select=&quot;column[name='ID_VLAN_OLO']/value&quot;/>&lt;/tns:idvlanolo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_VLAN_TRANSLATION']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_VLAN_TRANSLATION']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_VLAN_TRANSLATION']/value)&quot;>&lt;tns:flagvlantranslation>&lt;xsl:value-of select=&quot;column[name='FLAG_VLAN_TRANSLATION']/value&quot;/>&lt;/tns:flagvlantranslation>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESC_MACRO_AREA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESC_MACRO_AREA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESC_MACRO_AREA']/value)&quot;>&lt;tns:descmacroarea>&lt;xsl:value-of select=&quot;column[name='DESC_MACRO_AREA']/value&quot;/>&lt;/tns:descmacroarea>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESC_SUPER_MACRO_AREA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESC_SUPER_MACRO_AREA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESC_SUPER_MACRO_AREA']/value)&quot;>&lt;tns:descsupermacroarea>&lt;xsl:value-of select=&quot;column[name='DESC_SUPER_MACRO_AREA']/value&quot;/>&lt;/tns:descsupermacroarea>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DSLAM_TYPE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DSLAM_TYPE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DSLAM_TYPE']/value)&quot;>&lt;tns:dslamType>&lt;xsl:value-of select=&quot;column[name='DSLAM_TYPE']/value&quot;/>&lt;/tns:dslamType>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLOGIACLUSTERVLAN']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLOGIACLUSTERVLAN']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLOGIACLUSTERVLAN']/value)&quot;>&lt;tns:tipologiaClusterComune>&lt;xsl:value-of select=&quot;column[name='TIPOLOGIACLUSTERVLAN']/value&quot;/>&lt;/tns:tipologiaClusterComune>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAGFTTHONLY']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAGFTTHONLY']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAGFTTHONLY']/value)&quot;>&lt;tns:flagFtthOnly>&lt;xsl:value-of select=&quot;column[name='FLAGFTTHONLY']/value&quot;/>&lt;/tns:flagFtthOnly>&lt;/xsl:if>&lt;/tns:outputVLAN_SVLAN>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;RISULTATI TROVATI&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputDettaglioVLAN_SVLAN>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
