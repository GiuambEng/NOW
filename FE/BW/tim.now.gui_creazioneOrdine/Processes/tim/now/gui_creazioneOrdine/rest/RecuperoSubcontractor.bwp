                                    sqlStatement="select O.CODFC_OLO_AGCOM, O.COD_OLO&#xa;FROM OLO O&#xa;WHERE O.CODFC_OLO_AGCOM NOT IN &#xa;(SELECT CODFC_OLO_AGCOM&#xa;FROM OLO_VLAN &#xa;WHERE ID_OLO_TITOLARE_VLAN = ? and stato='ACTIVE' AND DATAFI_VALID > SYSDATE)&#xa;ORDER BY O.CODFC_OLO_AGCOM ASC" xsi:type="jdbcPalette:JDBCQueryActivity">

