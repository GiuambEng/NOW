    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="a2ed0a64-0015-4830-8cea-d0b89c49067e">
                <bpws:onMessage operation="get"
                    partnerLink="recuperosubcontractor"
                    portType="ns:recuperosubcontractor"
                    tibex:xpdlId="56534264-6220-4d5d-a955-3d5d731821fb" variable="get">
                    <bpws:scope name="scope1">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails"
                                tibex:faultNameVar="FaultName" tibex:xpdlId="36e51f14-7116-4978-8806-fb421cd54987">
                                <bpws:scope name="scope2">
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="CallProcess3ToReply" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
