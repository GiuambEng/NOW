                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT OVV.ID_OLO_VLAN AS IDTITOLARE, OVV.CODFC_OLO_AGCOM&#xa;FROM OLO_VLAN OVV&#xa;WHERE OVV.ID_OLO_VLAN = OVV.ID_OLO_TITOLARE_VLAN and OVV.COD_VLAN = ? and ovv.stato='ACTIVE'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRisorsa"/>
                                    <columnMetadata
                                    columnName="IDTITOLARE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
