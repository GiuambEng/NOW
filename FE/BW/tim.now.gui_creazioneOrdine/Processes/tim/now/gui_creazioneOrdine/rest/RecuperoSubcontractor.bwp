                                    sqlStatement="SELECT DISTINCT OVV.ID_OLO_VLAN AS IDTITOLARE, OVV.CODFC_OLO_AGCOM&#xa;FROM OLO_VLAN OVV&#xa;WHERE OVV.ID_OLO_VLAN = OVV.ID_OLO_TITOLARE_VLAN and OVV.COD_VLAN = ? and ovv.stato='ACTIVE'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

