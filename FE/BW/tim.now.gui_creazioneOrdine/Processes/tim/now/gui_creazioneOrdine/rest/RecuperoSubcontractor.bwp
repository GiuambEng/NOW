                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Condivisori-input"
                                    name="Condivisori"
                                    outputVariable="Condivisori"
                                    tibex:xpdlId="9d24ceab-d08a-44de-89c3-4b89494be0e7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OloTitolareToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9d24ceab-d08a-44de-89c3-4b89494be0e7+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoSubcontractor/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OloTitolare&quot;/>&lt;xsl:template name=&quot;Condivisori-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idTitolare>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OloTitolare/Record[1]/IDTITOLARE)&quot;>&lt;xsl:value-of select=&quot;$OloTitolare/Record[1]/IDTITOLARE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idTitolare>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OV.CODFC_OLO_AGCOM AS CODICEOLO ,O.COD_OLO AS CODICEOLONUMERICO&#xa;FROM OLO_VLAN OV INNER JOIN OLO O ON OV.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM&#xa;WHERE OV.ID_OLO_VLAN &lt;> OV.ID_OLO_TITOLARE_VLAN AND OV.ID_OLO_TITOLARE_VLAN = ? AND OV.DATAFI_VALID > SYSDATE&#xa;AND OV.STATO='ACTIVE'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idTitolare"/>
                                    <columnMetadata
                                    columnName="CODICEOLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEOLONUMERICO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="Assign"
                                    outputVariable="Variable"
                                    tibex:xpdlId="5c0b81be-7f29-4f01-a6be-87766945f210" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RecuperoSubcontractor&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Condivisori&quot;/>&lt;xsl:param name=&quot;OloTitolare&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Condivisori/Record/CODICEOLO) > 0&quot;>&lt;tns:outputRecuperoSubcontractor>&lt;xsl:for-each select=&quot;$Condivisori/Record&quot;>&lt;tns:listaSubcontractor>&lt;tns:codOloAgcom>&lt;xsl:value-of select=&quot;CODICEOLO&quot;/>&lt;/tns:codOloAgcom>&lt;tns:codiceOloNumerico>&lt;xsl:value-of select=&quot;CODICEOLONUMERICO&quot;/>&lt;/tns:codiceOloNumerico>&lt;xsl:if test=&quot;$OloTitolare/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns:codOloAgcomTitolare>&lt;xsl:value-of select=&quot;$OloTitolare/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:codOloAgcomTitolare>&lt;/xsl:if>&lt;/tns:listaSubcontractor>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputRecuperoSubcontractor>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputRecuperoSubcontractor>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record presente in lista&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputRecuperoSubcontractor>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
