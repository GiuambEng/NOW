                                tibex:xpdlId="e2db0c95-cf86-4a06-ab4c-f42aba360e3e" variable="postOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20160524120533PLT" xmlns:tns="http://www.tim.com/NOW/rest/kitATM" xmlns:tns2="http://www.tim.com/NOW/rest/servizioricercaavanzata" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="Variable"/&gt;
    &lt;xsl:param name="JDBCQuery"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="SQLDirect"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns3:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($post/item/tns2:inputservizioricercaavanzata/tns2:exportRequest) and (upper-case($post/item/tns2:inputservizioricercaavanzata/tns2:exportRequest)='S' or upper-case($post/item/tns2:inputservizioricercaavanzata/tns2:exportRequest)='Y') and exists($SQLDirect/unknownResultset[1]/row[1])"&gt;
                        &lt;tns:kitATMoutput&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="xsd:string($JDBCQuery/Record[1]/NEXTVAL)"/&gt;
                            &lt;/tns:idExportFile&gt;
                        &lt;/tns:kitATMoutput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;xsl:copy-of select="$Variable"/&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns3:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://xmlns.example.com/20160524120533PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/kitATM&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirect&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($post.item/tns2:exportRequest) and (upper-case($post.item/tns2:exportRequest)='S' or upper-case($post.item/tns2:exportRequest)='Y') and exists($SQLDirect/unknownResultset[1]/row[1])&quot;>&#xa;                &lt;tns:kitATMoutput>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                    &lt;tns:idExportFile>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;                    &lt;/tns:idExportFile>&#xa;                &lt;/tns:kitATMoutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:copy-of select=&quot;$Variable&quot;/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
