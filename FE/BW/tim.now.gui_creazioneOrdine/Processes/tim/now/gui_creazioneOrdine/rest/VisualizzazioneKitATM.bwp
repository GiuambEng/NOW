                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/kitATM&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SQLDirect/unknownResultset/row)>0&quot;>&lt;tns:kitATMoutput>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&lt;tns:kitATMOutput>&lt;xsl:if test=&quot;not((string(column[name='COD_KIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_KIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_KIT']/value)&quot;>&lt;tns:codiceKit>&lt;xsl:value-of select=&quot;column[name='COD_KIT']/value&quot;/>&lt;/tns:codiceKit>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO']/value)&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;column[name='STATO']/value&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='DEC_ATTIVAZIONE']/value)&quot;>&lt;tns:decAttivazione>&lt;xsl:value-of select=&quot;xsd:date(substring-before(string(column[name='DEC_ATTIVAZIONE']/value),&amp;quot;T&amp;quot;))&quot;/>&lt;/tns:decAttivazione>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='DEC']/value)&quot;>&lt;tns:dec>&lt;xsl:value-of select=&quot;xsd:date(substring-before(string(column[name='DEC_ATTIVAZIONE']/value),&amp;quot;T&amp;quot;))&quot;/>&lt;/tns:dec>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CLLI']/value)&quot;>&lt;tns:clli>&lt;xsl:value-of select=&quot;column[name='CLLI']/value&quot;/>&lt;/tns:clli>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_AREA_RACCOLTA']/value)&quot;>&lt;tns:codiceAreaRaccolta>&lt;xsl:value-of select=&quot;column[name='COD_AREA_RACCOLTA']/value&quot;/>&lt;/tns:codiceAreaRaccolta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESC_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESC_AREA_RACCOLTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESC_AREA_RACCOLTA']/value)&quot;>&lt;tns:descAreaRaccolta>&lt;xsl:value-of select=&quot;column[name='DESC_AREA_RACCOLTA']/value&quot;/>&lt;/tns:descAreaRaccolta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO']/value)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;column[name='COD_OLO']/value&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='ID_PRIME_CONTRACTOR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_PRIME_CONTRACTOR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_PRIME_CONTRACTOR']/value)&quot;>&lt;tns:identificativoPrimeContractor>&lt;xsl:value-of select=&quot;column[name='ID_PRIME_CONTRACTOR']/value&quot;/>&lt;/tns:identificativoPrimeContractor>&lt;/xsl:if>&lt;/tns:kitATMOutput>&lt;/xsl:for-each>&lt;/tns:kitATMoutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:kitATMoutput/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
