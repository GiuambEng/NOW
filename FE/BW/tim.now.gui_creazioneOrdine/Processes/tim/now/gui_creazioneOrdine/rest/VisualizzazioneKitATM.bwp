ders/GUI-TID&quot;/>&#xa;                            &lt;/tns3:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzazioneKitATM_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns3:EventType>&#xa;                        &lt;tns3:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzazioneKitATM_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns3:trackID>&#xa;                    &lt;/tns3:Identifier>&#xa;                    &lt;tns3:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns3:track_position>&#xa;                    &lt;tns3:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns3:Timestamp>&#xa;                &lt;/tns3:Envelope>&#xa;                &lt;tns3:Playload>&#xa;                    &lt;tns3:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($post.item )))&quot;/>&#xa;                    &lt;/tns3:Binary>&#xa;                    &lt;tns3:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($post.item)&quot;/>&#xa;                    &lt;/tns3:XMLString>&#xa;                &lt;/tns3:Playload>&#xa;            &lt;/tns3:ActiveLoggerServices>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
