                            <bpws:reply name="KitATMOut" operation="get"
                                partnerLink="visualizzazionekitatm"
                                portType="ns:visualizzazionekitatm"
                                tibex:xpdlId="a424cb53-d6c8-4687-9b47-e0e2e4db77eb" variable="KitATMOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20160524120533PLT" xmlns:tns="http://www.tim.com/NOW/rest/kitATM" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="KitATMQuery"/&gt;
    &lt;xsl:template name="KitATMOut-input" match="/"&gt;
        &lt;tns3:getResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($KitATMQuery/Record)"&gt;
                        &lt;tns:kitATMoutput&gt;
                            &lt;xsl:for-each select="$KitATMQuery/Record"&gt;
                                &lt;tns:kitATMOutput&gt;
                                    &lt;tns:codiceKit&gt;
                                        &lt;xsl:value-of select="COD_KIT"/&gt;
                                    &lt;/tns:codiceKit&gt;
                                    &lt;tns:stato&gt;
                                        &lt;xsl:value-of select="STATO"/&gt;
                                    &lt;/tns:stato&gt;
                                    &lt;xsl:if test="exists(DEC_ATTIVAZIONE) and string-length(xsd:string(DEC_ATTIVAZIONE))&gt;0"&gt;
                                        &lt;tns:decAttivazione&gt;
                                            &lt;xsl:value-of select="xsd:date(DEC_ATTIVAZIONE)"/&gt;
                                        &lt;/tns:decAttivazione&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(DEC) and string-length(xsd:string(DEC))&gt;0"&gt;
                                        &lt;tns:dec&gt;
                                            &lt;xsl:value-of select="xsd:date(DEC)"/&gt;
                                        &lt;/tns:dec&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:clli&gt;
                                        &lt;xsl:value-of select="CLLI"/&gt;
                                    &lt;/tns:clli&gt;
                                    &lt;tns:codiceAreaRaccolta&gt;
                                        &lt;xsl:value-of select="COD_AREA_RACCOLTA"/&gt;
                                    &lt;/tns:codiceAreaRaccolta&gt;
                                    &lt;tns:descAreaRaccolta&gt;
                                        &lt;xsl:value-of select="DESC_AREA_RACCOLTA"/&gt;
                                    &lt;/tns:descAreaRaccolta&gt;
                                    &lt;tns:codificaOloAgcom&gt;
                                        &lt;xsl:value-of select="CODFC_OLO_AGCOM"/&gt;
                                    &lt;/tns:codificaOloAgcom&gt;
                                    &lt;tns:codiceOlo&gt;
                                        &lt;xsl:value-of select="COD_OLO"/&gt;
                                    &lt;/tns:codiceOlo&gt;
                                    &lt;xsl:if test="ID_PRIME_CONTRACTOR"&gt;
                                        &lt;tns:identificativoPrimeContractor&gt;
                                            &lt;xsl:value-of select="ID_PRIME_CONTRACTOR"/&gt;
                                        &lt;/tns:identificativoPrimeContractor&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:kitATMOutput&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:kitATMoutput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:kitATMoutput&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                                &lt;tns:details&gt;
                                    &lt;xsl:value-of select="'nessun record trovato'"/&gt;
                                &lt;/tns:details&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:kitATMoutput&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns3:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://xmlns.example.com/20160524120533PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/kitATM&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;KitATMQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;KitATMOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($KitATMQuery/Record)&quot;>&#xa;                &lt;tns:kitATMoutput>&#xa;                    &lt;xsl:for-each select=&quot;$KitATMQuery/Record&quot;>&#xa;                        &lt;tns:kitATMOutput>&#xa;                            &lt;tns:codiceKit>&#xa;                                &lt;xsl:value-of select=&quot;COD_KIT&quot;/>&#xa;                            &lt;/tns:codiceKit>&#xa;                            &lt;tns:stato>&#xa;                                &lt;xsl:value-of select=&quot;STATO&quot;/>&#xa;                            &lt;/tns:stato>&#xa;                            &lt;xsl:if test=&quot;exists(DEC_ATTIVAZIONE) and string-length(xsd:string(DEC_ATTIVAZIONE))>0&quot;>&#xa;                                &lt;tns:decAttivazione>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:date(DEC_ATTIVAZIONE)&quot;/>&#xa;                                &lt;/tns:decAttivazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DEC) and string-length(xsd:string(DEC))>0&quot;>&#xa;                                &lt;tns:dec>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:date(DEC)&quot;/>&#xa;                                &lt;/tns:dec>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:clli>&#xa;                                &lt;x