                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160524120533PLT" xmlns:tns="http://www.tim.com/NOW/rest/kitATM" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails1"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;item&gt;
                &lt;tns:kitATMoutput&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
