                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0a5a58a9-1ebb-4cea-9527-e49cff6bec57+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/Ricariche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idAssetRicarica>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:ListaRichiesteGetParameters/tns1:idRicarica&quot;/>&#xa;            &lt;/idAssetRicarica>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoRichieste-input"
                                    name="RecuperoRichieste"
                                    outputVariable="RecuperoRichieste"
                                    tibex:xpdlId="0a5a58a9-1ebb-4cea-9527-e49cff6bec57" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="getInputLogInfoToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0a5a58a9-1ebb-4cea-9527-e49cff6bec57+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/Ricariche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idAssetRicarica>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:idRicarica&quot;/>&#xa;            &lt;/idAssetRicarica>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;(&#xa;SELECT DISTINCT TRO.STATO_RICH_OLO_GUI&#xa;FROM TIPOLG_RICH_COMSTOLO TRO&#xa;WHERE R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO&#xa;) AS STATO_RICH_OLO_GUI, &#xa;R.CODIFICAOLOAGCOM, R.DATAINVIORICHIESTA, R.IDRISORSA, R.TIPORICHIESTA, R.LAVORAZIONE, R.OFFERTA, &#xa;TRN.STATO_RICH_NOW_GUI, AC.DESCR_CAUS_OLO, ROCN.TIMSTP_CREAZIONE, ROCN.TRACCIATO_MAIL, TN.DESCR&#xa;FROM BDS_1_CASEDATA_RICHIESTA R&#xa;LEFT JOIN ASSET_RICARICA_RICHIESTA ARR ON ARR.IDRICHIESTAOLO = R.IDRICHIESTAOLO&#xa;LEFT JOIN BDS_1_CASEDATA_ASSETRICARICA AR ON ARR.IDASSETRICARICA = AR.IDASSETRICARICA&#xa;LEFT OUTER JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW&#xa;LEFT JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = R.IDANAGRAFICACAUSALEGUI&#xa;LEFT JOIN RICH_ORDN_COMUNIC_NOTF ROCN ON ROCN.ID_ANAG_CAUS = AC.ID_ANAG_CAUS&#xa;LEFT JOIN TIPOLG_NOTF TN ON TN.COD_TIPOLG_NOTF = ROCN.COD_TIPOLG_NOTF AND TN.STRUTTURA_RICH = ROCN.STRUTTURA_RICH&#xa;WHERE AR.IDASSETRICARICA = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idAssetRicarica"/>
                                    <columnMetadata
                                    columnName="STATO_RICH_OLO_GUI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPORICHIESTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_RICH_NOW_GUI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TRACCIATO_MAIL"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
