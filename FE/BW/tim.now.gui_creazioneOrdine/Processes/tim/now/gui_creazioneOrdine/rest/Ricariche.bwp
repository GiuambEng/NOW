                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+68ee98a3-8cb9-4730-bf8e-88fa2e0811fb+input&quot; xmlns:tns=&quot;http://www.example.org/Ricariche&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:template name=&quot;OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post1/item/tns:Input_ListaRichiesteRicarica_RicercaAvanzata/tns:strutturaCondition[1]/tns:nome) = 0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT ( SELECT DISTINCT TRO.STATO_RICH_OLO_GUI FROM TIPOLG_RICH_COMSTOLO TRO WHERE R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) AS STATO_RICH_OLO_GUI, R.DATAINVIORICHIESTA, R.CODIFICAOLOAGCOM, R.IDRISORSA, R.TIPORICHIESTA, R.LAVORAZIONE, R.OFFERTA, AC.DESCR_CAUS_OLO FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = R.IDANAGRAFICACAUSALE WHERE R.TIPORICHIESTA = 'RICARICA' AND R.CODIFICAOLOAGCOM IN ('&amp;quot;, tib:concat-sequence-format($Variable/tns2:profiloOlo/tns2:anagraficaOlo/tns2:codiceAgcom, &amp;quot;','&amp;quot;,  true()), &amp;quot;') FETCH FIRST 500 ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT ( SELECT DISTINCT TRO.STATO_RICH_OLO_GUI FROM TIPOLG_RICH_COMSTOLO TRO WHERE R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) AS STATO_RICH_OLO_GUI, R.DATAINVIORICHIESTA, R.CODIFICAOLOAGCOM, R.IDRISORSA, R.TIPORICHIESTA, R.LAVORAZIONE, R.OFFERTA, AC.DESCR_CAUS_OLO FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = R.IDANAGRAFICACAUSALE WHERE R.TIPORICHIESTA = 'RICARICA' AND R.CODIFICAOLOAGCOM IN ('&amp;quot;, tib:concat-sequence-format($Variable/tns2:profiloOlo/tns2:anagraficaOlo/tns2:codiceAgcom, &amp;quot;','&amp;quot;,  true()), &amp;quot;') AND &amp;quot;,$RicercaAvanzata/tns3:outputcondition[1],&amp;quot; FETCH FIRST 500 ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="OLO-input" name="OLO"
                                    outputVariable="OLO"
                                    tibex:xpdlId="68ee98a3-8cb9-4730-bf8e-88fa2e0811fb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
