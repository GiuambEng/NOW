&lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;xsl:if test=&quot;count($OLO/unknownResultset/row)>=$MaxRows&quot;>&#xa;                            &lt;tns:details>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;LIMIT&amp;quot;&quot;/>&#xa;                            &lt;/tns:details>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:Output_ListaRichiesteRicarica_RicercaAvanzata>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;contains($tipoProfilo, $post1.parameters/tns1:tipoProfilo) = false() and string-length(string($NoOLO/unknownResultset/row[1]/column[name = 'CODIFICAOLOAGCOM']/value)) >0&quot;>&#xa;                &lt;tns:Output_ListaRichiesteRicarica_RicercaAvanzata>&#xa;                    &lt;xsl:for-each select=&quot;$NoOLO/unknownResultset/row&quot;>&#xa;                        &lt;tns:ListaRichiesteRicarica>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name = 'CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'CODIFICAOLOAGCOM']/value)&quot;>&#xa;                                &lt;tns:codificaOAO>&#xa;                                    &lt;xsl:value-of select=&quot;column[name = 'CODIFICAOLOAGCOM']/value&quot;/>&#xa;                                &lt;/tns:codificaOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name = 'DATAINVIORICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'DATAINVIORICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'DATAINVIORICHIESTA']/value)&quot;>&#xa;                                &lt;tns:dataInvio>&#xa;                                    &lt;xsl:value-of select=&quot;column[name = 'DATAINVIORICHIESTA']/value&quot;/>&#xa;                                &lt;/tns:dataInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name = 'IDRISORSA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'IDRISORSA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'IDRISORSA']/value)&quot;>&#xa;                                &lt;tns:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;column[name = 'IDRISORSA']/value&quot;/>&#xa;                                &lt;/tns:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name = 'TIPORICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'TIPORICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'TIPORICHIESTA']/value)&quot;>&#xa;                                &lt;tns:tipologiaRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;column[name = 'TIPORICHIESTA']/value&quot;/>&#xa;                                &lt;/tns:tipologiaRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name = 'LAVORAZIONE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'LAVORAZIONE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'LAVORAZIONE']/value)&quot;>&#xa;                                &lt;tns:tipologiaLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;column[name = 'LAVORAZIONE']/value&quot;/>&#xa;                                &lt;/tns:tipologiaLavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name = 'OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'OFFERTA']/value)&quot;>&#xa;                                &lt;tns:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;column[name = 'OFFERTA']/value&quot;/>&#xa;                                &lt;/tns:offerta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name = 'STATO_RICH_OLO_GUI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'STATO_RICH_OLO_GUI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'STATO_RICH_OLO_GUI']/value)&quot;>&#xa;                                &lt;tns:statoOao>&#xa;                                    &lt;xsl:value-of select=&quot;column[name = 'STATO_RICH_OLO_GUI']/value&quot;/>&#xa;                                &lt;/tns:statoOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name = 'DESCR_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'DESCR_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'DESCR_CAUS_OLO']/value)&quot;>&#xa;                                &lt;tns:descrizioneCausale>&#xa;                                    &lt;xsl:value-of select=&quot;column[name = 'DESCR_CAUS_OLO']/value&quot;/>&#xa;                                &lt;/tns:descrizioneCausale>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:ListaRichiesteRicarica>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;xsl:if test=&quot;count($NoOLO/unknownResultset/row)>=$MaxRows&quot;>&#xa;                            &lt;tns:details>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;LIMIT&amp;quot;&quot;/>&#xa;                            &lt;/tns:details>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:Output_ListaRichiesteRicarica_RicercaAvanzata>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Output_ListaRichiesteRicarica_RicercaAvanzata>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi corrispondenti ai criteri di ricerca&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:Output_ListaRichiesteRicarica_RicercaAvanzata>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
