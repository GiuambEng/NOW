                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Ricariche&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoRichieste&quot;/>&lt;xsl:template name=&quot;ListaRichieste&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperoRichieste/Record) >0&quot;>&lt;tns:Output_ListaRichieste>&lt;xsl:for-each select=&quot;$RecuperoRichieste/Record&quot;>&lt;tns:listaRichieste>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;) and exists(DATAINVIORICHIESTA) and string-length(xsd:string(DATAINVIORICHIESTA))>0&quot;>&lt;tns:dataInvio>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAINVIORICHIESTA), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInvio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DATAINVIORICHIESTA&quot;>&lt;tns:dataInvio>&lt;xsl:value-of select=&quot;DATAINVIORICHIESTA&quot;/>&lt;/tns:dataInvio>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPORICHIESTA&quot;>&lt;tns:tipologiaRichiesta>&lt;xsl:value-of select=&quot;TIPORICHIESTA&quot;/>&lt;/tns:tipologiaRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;LAVORAZIONE&quot;>&lt;tns:tipologiaLavorazione>&lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&lt;/tns:tipologiaLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_RICH_NOW_GUI&quot;>&lt;tns:statoNow>&lt;xsl:value-of select=&quot;STATO_RICH_NOW_GUI&quot;/>&lt;/tns:statoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_RICH_OLO_GUI&quot;>&lt;tns:statoOao>&lt;xsl:value-of select=&quot;STATO_RICH_OLO_GUI&quot;/>&lt;/tns:statoOao>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns:causale>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns:causale>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:tipologiaNotifica>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:tipologiaNotifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns:dataMail>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataMail>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_CREAZIONE&quot;>&lt;tns:dataMail>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns:dataMail>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;TRACCIATO_MAIL&quot;>&lt;tns:mail>&lt;xsl:value-of select=&quot;TRACCIATO_MAIL&quot;/>&lt;/tns:mail>&lt;/xsl:if>&lt;/tns:listaRichieste>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_ListaRichieste>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Output_ListaRichieste>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessuna richiesta presente&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:Output_ListaRichieste>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
