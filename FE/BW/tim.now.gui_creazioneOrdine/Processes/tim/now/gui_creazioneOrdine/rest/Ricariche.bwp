&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20180316111552PLT" xmlns:tns="http://www.example.org/Ricariche" xmlns:tns2="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="RicercaAvanzataSubProcess"/&gt;
    &lt;xsl:param name="CryptoIdFile"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns3:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($post/item/tns:Input_ListaRicariche_RicercaAvanzata/tns:exportRequest) and (upper-case($post/item/tns:Input_ListaRicariche_RicercaAvanzata/tns:exportRequest)='S' or upper-case($post/item/tns:Input_ListaRicariche_RicercaAvanzata/tns:exportRequest)='Y')"&gt;
                        &lt;tns:Output_ListaRicariche_RicercaAvanzata&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="$CryptoIdFile/tns2:idFileCriptato"/&gt;
                            &lt;/tns:idExportFile&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:Output_ListaRicariche_RicercaAvanzata&gt;
                    &lt;/xsl:when&gt;
