.STATO_RICH_OLO_GUI FROM TIPOLG_RICH_COMSTOLO TRO WHERE R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) AS STATO_RICH_OLO_GUI, R.DATAINVIORICHIESTA, R.CODIFICAOLOAGCOM, R.IDRISORSA, R.TIPORICHIESTA, R.LAVORAZIONE, R.OFFERTA, AC.DESCR_CAUS_OLO FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = R.IDANAGRAFICACAUSALE WHERE R.TIPORICHIESTA = 'RICARICA' AND R.CODIFICAOLOAGCOM IN ('&amp;quot;, tib:concat-sequence-format($Variable/tns2:profiloOlo/tns2:anagraficaOlo/tns2:codiceAgcom, &amp;quot;','&amp;quot;,  true()), &amp;quot;') AND &amp;quot;,$RicercaAvanzata/tns3:outputcondition[1],&amp;quot; FETCH FIRST 500 ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
