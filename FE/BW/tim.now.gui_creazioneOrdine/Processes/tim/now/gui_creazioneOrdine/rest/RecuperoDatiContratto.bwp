tns4:Payload>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices>&#xa;                &lt;tns4:Envelope>&#xa;                    &lt;tns4:Identifier>&#xa;                        &lt;tns4:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.rest.RecuperaDatiContratto&amp;quot;&quot;/>&#xa;                        &lt;/tns4:ServiceName>&#xa;                        &lt;tns4:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns4:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns4:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns5:httpHeaders/GUI-SID,$get/httpHeaders/tns5:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns4:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns4:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns4:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaDatiContratto_&amp;quot;,$get/httpHeaders/tns5:httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;tns4:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaDatiContratto_&amp;quot;,$get/httpHeaders/tns5:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns4:trackID>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                &lt;/tns4:Envelope>&#xa;                &lt;tns4:Playload>&#xa;                    &lt;tns4:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get/parameters/tns2:recuperodaticontrattoGetParameters )))&quot;/>&#xa;                    &lt;/tns4:Binary>&#xa;                    &lt;tns4:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($get/parameters/tns2:recuperodaticontrattoGetParameters)&quot;/>&#xa;                    &lt;/tns4:XMLString>&#xa;                &lt;/tns4:Playload>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
