;quot;,$get2.httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns3:EventType>&#xa;                        &lt;tns3:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaFlagMulticast_&amp;quot;,$get2.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns3:trackID>&#xa;                    &lt;/tns3:Identifier>&#xa;                    &lt;tns3:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns3:track_position>&#xa;                    &lt;tns3:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns3:Timestamp>&#xa;                    &lt;tns3:ErrorLog>&#xa;                        &lt;tns3:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns3:TimeStamp>&#xa;                        &lt;tns3:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorRecuperaFlagMulticast&amp;quot;,'SID:',$get2.httpHeaders/GUI-SID,'TID:',$get2.httpHeaders/GUI-TID,'ST',$FaultDetails2/StackTrace)&quot;/>&#xa;                        &lt;/tns3:Descrizione>&#xa;                        &lt;tns3:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails2/MsgCode&quot;/>&#xa;                        &lt;/tns3:Codice>&#xa;                        &lt;tns3:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns3:track_position>&#xa;                    &lt;/tns3:ErrorLog>&#xa;                &lt;/tns3:Envelope>&#xa;            &lt;/tns3:ActiveLoggerServices>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
