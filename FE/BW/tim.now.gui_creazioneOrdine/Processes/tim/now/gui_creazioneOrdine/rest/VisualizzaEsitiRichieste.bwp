                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VisualizzazioneNotificheOLOQuery&quot;/>&lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQueryOLO&quot;/>&lt;xsl:param name=&quot;VisualizzaNotifichePPS_GA&quot;/>&lt;xsl:param name=&quot;VisualizzazioneNotificheDG_MKT_NEWSQuery&quot;/>&lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQuery&quot;/>&lt;xsl:param name=&quot;VisualizzaNotifiche&quot;/>&lt;xsl:param name=&quot;QueryPPS_GA_Del82&quot;/>&lt;xsl:param name=&quot;QueryDG_MKT_NEWS_Del82&quot;/>&lt;xsl:param name=&quot;QueryProfiliOloDel82&quot;/>&lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQueryOLODel82&quot;/>&lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQuery_Del82&quot;/>&lt;xsl:template name=&quot;VariableRichieste&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length(string($VisualizzazioneNotificheDG_MKT_NEWSQuery/Record[1]/ID_NOTF))>0 or string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF))>0 or string-length(string($VisualizzaNotifichePPS_GA/Record[1]/ID_NOTF))>0) and (string-length($VisualizzazioneEsitiRichiesteQueryOLO/Record[1]/IDRICHIESTAOLO) = 0 and string-length($VisualizzazioneEsitiRichiesteQuery/Record[1]/IDRICHIESTAOLO) = 0 and string-length($JDBCQuery/Record[1]/IDRICHIESTAOLO) = 0)&quot;>&lt;tns:outputVisualizzaEsitiRichieste>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF)) > 0&quot;>&lt;xsl:for-each select=&quot;$VisualizzazioneNotificheOLOQuery/Record&quot;>&lt;tns:visualizzazioneNotificheOutput>&lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&lt;tns:tipologiaNotifica>&lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&lt;/tns:tipologiaNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns:causale>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns:causale>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$VisualizzaNotifiche/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica =xsd:int(current()/ID_NOTF)]/tns1:contenutoXML&quot;>&lt;tns:notificaXML>&lt;xsl:value-of select=&quot;$VisualizzaNotifiche/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica =xsd:int(current()/ID_NOTF)]/tns1:contenutoXML&quot;/>&lt;/tns:notificaXML>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_FILE&quot;>&lt;tns:ultimoFileNotifica>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:ultimoFileNotifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns:dataInvioFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInvioFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns:dataInvioFile>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns:dataInvioFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;ID_NOTF&quot;/>&lt;/tns:idNotifica>&lt;/tns:visualizzazioneNotificheOutput>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string($VisualizzazioneNotificheDG_MKT_NEWSQuery/Record[1]/ID_NOTF)) > 0&quot;>&lt;xsl:for-each select=&quot;$VisualizzazioneNotificheDG_MKT_NEWSQuery/Record&quot;>&lt;tns:visualizzazioneNotificheOutput>&lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&lt;tns:tipologiaNotifica>&lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&lt;/tns:tipologiaNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns:causale>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns:causale>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$VisualizzaNotifiche/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica =xsd:int(current()/ID_NOTF)]/tns1:contenutoXML&quot;>&lt;tns:notificaXML>&lt;xsl:value-of select=&quot;$VisualizzaNotifiche/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica =xsd:int(current()/ID_NOTF)]/tns1:contenutoXML&quot;/>&lt;/tns:notificaXML>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_FILE&quot;>&lt;tns:ultimoFileNotifica>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:ultimoFileNotifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns:dataInvioFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInvioFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns:dataInvioFile>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns:dataInvioFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;ID_NOTF&quot;/>&lt;/tns:idNotifica>&lt;/tns:visualizzazioneNotificheOutput>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$VisualizzaNotifichePPS_GA/Record&quot;>&lt;tns:visualizzazioneNotificheOutput>&lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&lt;tns:tipologiaNotifica>&lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&lt;/tns:tipologiaNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns:causale>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns:causale>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataCreazione>&lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&lt;/tns:dataCreazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$VisualizzaNotifiche/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica =xsd:int(current()/ID_NOTF)]/tns1:contenutoXML&quot;>&lt;tns:notificaXML>&lt;xsl:value-of select=&quot;$VisualizzaNotifiche/Output/tns1:Response/tns1:DatiNotificheResponse[tns1:IDNotifica =xsd:int(current()/ID_NOTF)]/tns1:contenutoXML&quot;/>&lt;/tns:notificaXML>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_FILE&quot;>&lt;tns:ultimoFileNotifica>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:ultimoFileNotifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns:dataInvioFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:dataInvioFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns:dataInvioFile>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns:dataInvioFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:idNotifica>&lt;xsl:value-of select=&quot;ID_NOTF&quot;/>&lt;/tns:idNotifica>&lt;/tns:visualizzazioneNotificheOutput>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:outputVisualizzaEsitiRichieste>&lt;/xsl:when>&lt;xsl:when test=&quot;(string-length($VisualizzazioneEsitiRichiesteQueryOLO/Record[1]/IDRICHIESTAOLO) > 0 or string-length($VisualizzazioneEsitiRichiesteQuery/Record[1]/IDRICHIESTAOLO) > 0 or string-length($JDBCQuery/Record[1]/IDRICHIESTAOLO) > 0) and (string-length(string($VisualizzazioneNotificheDG_MKT_NEWSQuery/Record[1]/ID_NOTF))=0 and string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF))=0 and string-length(string($VisualizzaNotifichePPS_GA/Record[1]/ID_NOTF))=0)&quot;>&lt;tns:outputVisualizzaEsitiRichieste>&lt;xsl:choose>&lt;xsl:when test=&quot;count($VisualizzazioneEsitiRichiesteQueryOLO/Record)>0 and count($VisualizzazioneEsitiRichiesteQuery/Record) =0&quot;>&lt;xsl:for-each select=&quot;$VisualizzazioneEsitiRichiesteQueryOLO/Record&quot;>&lt;tns:visualizzazioneEsitiRichiesteOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;) and exists(DATAINVIORICHIESTA) and string-length(xsd:string(DATAINVIORICHIESTA))>0&quot;>&lt;tns:dataInvio>&lt;xsl:value-of select=&quot;substring-before(concat(substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAINVIORICHIESTA), &amp;quot;+&amp;quot;)), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInvio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataInvio>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInvio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:statoNow>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:statoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:statoOao>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:statoOao>&lt;/xsl:if>&lt;xsl:if test=&quot;LAVORAZIONE&quot;>&lt;tns:lavorazioneRichiesta>&lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&lt;/tns:lavorazioneRichiesta>&lt;/xsl:if>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiestaOlo>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:codiceRichiestaOao>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceRichiestaOao>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(CONTENUTOXML) and string-length(CONTENUTOXML) >0&quot;>&lt;xsl:if test=&quot;CONTENUTOXML&quot;>&lt;tns:xml>&lt;xsl:value-of select=&quot;CONTENUTOXML&quot;/>&lt;/tns:xml>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;CONTENUTO_XML_OLO&quot;>&lt;tns:xml>&lt;xsl:value-of select=&quot;CONTENUTO_XML_OLO&quot;/>&lt;/tns:xml>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(OPERATORE) and upper-case(OPERATORE)!='AUTOMATICO'&quot;>&lt;xsl:if test=&quot;OPERATORE&quot;>&lt;tns:userId>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/tns:userId>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:visualizzazioneEsitiRichiesteOutput>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;count($VisualizzazioneEsitiRichiesteQueryOLO/Record)=0 and $RecuperoOfferta/Record[1]/OFFERTA = 'NP'&quot;>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns:visualizzazioneEsitiRichiesteOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;) and exists(DATAINVIORICHIESTA) and string-length(xsd:string(DATAINVIORICHIESTA))>0&quot;>&lt;tns:dataInvio>&lt;xsl:value-of select=&quot;substring-before(concat(substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAINVIORICHIESTA), &amp;quot;+&amp;quot;)), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInvio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:dataInvio>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInvio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:statoNow>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:statoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:statoOao>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:statoOao>&lt;/xsl:if>&lt;xsl:if test=&quot;LAVORAZIONE&quot;>&lt;tns:lavorazioneRichiesta>&lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&lt;/tns:lavorazioneRichiesta>&lt;/xsl:if>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiestaOlo>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:codiceRichiestaOao>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceRichiestaOao>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(CONTENUTOXML) and string-length(CONTENUTOXML) >0&quot;>&lt;xsl:if test=&quot;CONTENUTOXML&quot;>&lt;tns:xml>&lt;xsl:value-of select=&quot;CONTENUTOXML&quot;/>