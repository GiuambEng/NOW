                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
