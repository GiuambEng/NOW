                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;r1.DATAINVIORICHIESTA, &#xa;r1.STATORICHIESTANOW, &#xa;r1.STATORICHIESTAOLO,&#xa;r1.LAVORAZIONE,&#xa;r1.IDRICHIESTAOLO,&#xa;r1.CODICEORDINEOLO,&#xa;r1.CONTENUTOXML,&#xa;r1.OPERATORE,&#xa;ar.contenuto_xml_olo&#xa;FROM BDS_1_CASEDATA_RICHIESTA r1 &#xa;INNER JOIN BDS_1_CASEDATA_RICHIESTA r2 ON (r1.CODICEORDINETITARGET= r2.CODICEORDINETI or r1.codiceordineolotarget = r2.codiceordineolo)&#xa;LEFT JOIN acquisizione_richieste AR ON TO_CHAR(r1.idrichiestaolo) = ar.id_richiesta_olo&#xa;WHERE r2.IDRICHIESTAOLO = ? AND r1.TIPORICHIESTA = ? AND r1.AMBITO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

