                                &lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&#xa;                                            &lt;/tns:dataCreazione>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;$VisualizzaNotifiche.Output/tns1:DatiNotificheResponse[tns1:IDNotifica =xsd:int(current()/ID_NOTF)]/tns1:contenutoXML&quot;>&#xa;                                        &lt;tns:notificaXML>&#xa;                                            &lt;xsl:value-of select=&quot;$VisualizzaNotifiche.Output/tns1:DatiNotificheResponse[tns1:IDNotifica =xsd:int(current()/ID_NOTF)]/tns1:contenutoXML&quot;/>&#xa;                                        &lt;/tns:notificaXML>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                        &lt;tns:ultimoFileNotifica>&#xa;                                            &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                        &lt;/tns:ultimoFileNotifica>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&#xa;                                            &lt;tns:dataInvioFile>&#xa;                                                &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                            &lt;/tns:dataInvioFile>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&#xa;                                                &lt;tns:dataInvioFile>&#xa;                                                    &lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&#xa;                                                &lt;/tns:dataInvioFile>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;tns:idNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;ID_NOTF&quot;/>&#xa;                                    &lt;/tns:idNotifica>&#xa;                                &lt;/tns:visualizzazioneNotificheOutput>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length(string($VisualizzazioneNotificheDG_MKT_NEWSQuery/Record[1]/ID_NOTF)) > 0&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$VisualizzazioneNotificheDG_MKT_NEWSQuery/Record&quot;>&#xa;                                &lt;tns:visualizzazioneNotificheOutput>&#xa;                                    &lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&#xa;                                        &lt;tns:tipologiaNotifica>&#xa;                                            &lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&#xa;                                        &lt;/tns:tipologiaNotifica>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&#xa;                                        &lt;tns:causale>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&#xa;                                        &lt;/tns:causale>&#xa;                                    &lt;/xsl:if>&#xa;  