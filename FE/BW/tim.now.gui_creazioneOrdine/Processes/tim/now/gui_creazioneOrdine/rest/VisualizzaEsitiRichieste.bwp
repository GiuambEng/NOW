                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns7=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaEsitiRichieste&amp;quot;&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzaEsitiRichieste&amp;quot;&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns7:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns8:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns7:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns8:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns8:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot; inputQuery:&amp;quot;,$post/item/tns:inputVisualizzaEsitiRichieste/tns:idRichiesta)&quot;/>&#xa;                &lt;/tns8:Payload>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;            &lt;tns8:ActiveLoggerServices>&#xa;                &lt;tns8:Envelope>&#xa;                    &lt;tns8:Identifier>&#xa;                        &lt;tns8:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.visualizzazioneEsitiRichieste&amp;quot;&quot;/>&#xa;                        &lt;/tns8:ServiceName>&#xa;                        &lt;tns8:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Operation>&#xa;                        &lt;tns8:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns7:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns8:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns7:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns8:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns8:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns7:httpHeaders/GUI-SID,$post/httpHeaders/tns7:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns8:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns7:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns8:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns7:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns8:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns8:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaEsitiRichieste_&amp;quot;,&amp;#x9;$post/httpHeaders/tns7:httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns8:EventType>&#xa;                        &lt;tns8:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaEsitiRichieste_&amp;quot;,&amp;#x9;$post/httpHeaders/tns7:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns8:trackID>&#xa;                    &lt;/tns8:Identifier>&#xa;                    &lt;tns8:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns8:track_position>&#xa;                    &lt;tns8:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns8:Timestamp>&#xa;                &lt;/tns8:Envelope>&#xa;            &lt;/tns8:ActiveLoggerServices>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
