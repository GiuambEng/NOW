                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; xmlns:tns7=&quot;http://www.example.org/Tokenizzazione&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheOperation.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheOLOQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQueryOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;DetokenizzaRichieste&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableRichieste&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF))>0 and string-length($VisualizzazioneEsitiRichiesteQueryOLO/Record[1]/IDRICHIESTAOLO) = 0&quot;>&#xa;                &lt;tns:outputVisualizzaEsitiRichieste>&#xa;                    &lt;xsl:for-each select=&quot;$VisualizzazioneNotificheOLOQuery/Record&quot;>&#xa;                        &lt;tns:visualizzazioneNotificheOutput>&#xa;                            &lt;xsl:variable name=&quot;currentId&quot; select=&quot;xsd:int(ID_NOTF)&quot;/>&#xa;                            &lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&#xa;                                &lt;tns:tipologiaNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&#xa;                                &lt;/tns:tipologiaNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&#xa;                                &lt;tns:causale>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:causale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&#xa;                                    &lt;tns:dataCreazione>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:dataCreazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:dataCreazione>&#xa;                                        &lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&#xa;                                    &lt;/tns:dataCreazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperation.Output/tns1:DatiNotificheResponse[tns1:IDNotifica =$currentId]/tns1:contenutoXML&quot;>&#xa;                                &lt;tns:notificaXML>&#xa;                                    &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperation.Output/tns1:DatiNotificheResponse[tns1:IDNotifica =$currentId]/tns1:contenutoXML&quot;/>&#xa;                                &lt;/tns:notificaXML>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                &lt;tns:ultimoFileNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                &lt;/tns:ultimoFileNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&#xa;                                    &lt;tns:dataInvioFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:dataInvioFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&#xa;                                        &lt;tns:dataInvioFile>&#xa;                                            &lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&#xa;                                        &lt;/tns:dataInvioFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:idNotifica>&#xa;                                &lt;xsl:value-of select=&quot;ID_NOTF&quot;/>&#xa;                            &lt;/tns:idNotifica>&#xa;                        &lt;/tns:visualizzazioneNotificheOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:outputVisualizzaEsitiRichieste>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($VisualizzazioneEsitiRichiesteQueryOLO/Record[1]/IDRICHIESTAOLO) > 0  and string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF))=0&quot;>&#xa;                &lt;tns:outputVisualizzaEsitiRichieste>&#xa;                    &lt;xsl:for-each select=&quot;$VisualizzazioneEsitiRichiesteQueryOLO/Record&quot;>&#xa;                        &lt;tns:visualizzazioneEsitiRichiesteOutput>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;) and exists(DATAINVIORICHIESTA) and string-length(xsd:string(DATAINVIORICHIESTA))>0&quot;>&#xa;                                    &lt;tns:dataInvio>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before(concat(substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAINVIORICHIESTA), &amp;quot;+&amp;quot;)), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:dataInvio>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:dataInvio>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:dataInvio>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&#xa;                                &lt;tns:statoNow>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&#xa;                                &lt;/tns:statoNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&#xa;                                &lt;tns:statoOao>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&#xa;                                &lt;/tns:statoOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;LAVORAZIONE&quot;>&#xa;                                &lt;tns:lavorazioneRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&#xa;                                &lt;/tns:lavorazioneRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:idRichiestaOlo>&#xa;                                &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                            &lt;/tns:idRichiestaOlo>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                &lt;tns:codiceRichiestaOao>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns:codiceRichiestaOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaRichieste/tns7:listaXml[tns7:codRichiestaOao=$VisualizzazioneEsitiRichiesteQueryOLO/Record/IDRICHIESTAOLO]/tns7:xml&quot;>&#xa;                                &lt;tns:xml>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaRichieste/tns7:listaXml[tns7:codRichiestaOao=$VisualizzazioneEsitiRichiesteQueryOLO/Record/IDRICHIESTAOLO]/tns7:xml&quot;/>&#xa;                                &lt;/tns:xml>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(OPERATORE) and upper-case(OPERATORE)!='AUTOMATICO'&quot;>&#xa;                                &lt;xsl:if test=&quot;OPERATORE&quot;>&#xa;                                    &lt;tns:userId>&#xa;                                        &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                                    &lt;/tns:userId>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:visualizzazioneEsitiRichiesteOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:outputVisualizzaEsitiRichieste>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF))>0 and string-length($VisualizzazioneEsitiRichiesteQueryOLO/Record[1]/IDRICHIESTAOLO) > 0&quot;>&#xa;                &lt;tns:outputVisualizzaEsitiRichieste>&#xa;                    &lt;xsl:for-each select=&quot;$VisualizzazioneNotificheOLOQuery/Record&quot;>&#xa;                        &lt;tns:visualizzazioneNotificheOutput>&#xa;                            &lt;xsl:variable name=&quot;currentId2&quot; select=&quot;xsd:int(ID_NOTF)&quot;/>&#xa;                            &lt;xsl:if test=&quot;TIPOLG_NOTF&quot;>&#xa;                                &lt;tns:tipologiaNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLG_NOTF&quot;/>&#xa;                                &lt;/tns:tipologiaNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&#xa;                                &lt;tns:causale>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:causale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREAZIONE) and string-length(xsd:string(TIMSTP_CREAZIONE))>0&quot;>&#xa;                                    &lt;tns:dataCreazione>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREAZIONE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREAZIONE), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:dataCreazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:dataCreazione>&#xa;                                        &lt;xsl:value-of select=&quot;TIMSTP_CREAZIONE&quot;/>&#xa;                                    &lt;/tns:dataCreazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperation.Output/tns1:DatiNotificheResponse[tns1:IDNotifica=$currentId2]/tns1:contenutoXML&quot;>&#xa;                                &lt;tns:notificaXML>&#xa;                                    &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperation.Output/tns1:DatiNotificheResponse[tns1:IDNotifica=$currentId2]/tns1:contenutoXML&quot;/>&#xa;                                &lt;/tns:notificaXML>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                &lt;tns:ultimoFileNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                &lt;/tns:ultimoFileNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&#xa;                                    &lt;tns:dataInvioFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:dataInvioFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&#xa;                                        &lt;tns:dataInvioFile>&#xa;                                            &lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&#xa;                                        &lt;/tns:dataInvioFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:idNotifica>&#xa;                                &lt;xsl:value-of select=&quot;ID_NOTF&quot;/>&#xa;                            &lt;/tns:idNotifica>&#xa;                        &lt;/tns:visualizzazioneNotificheOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;$VisualizzazioneEsitiRichiesteQueryOLO/Record&quot;>&#xa;                        &lt;tns:visualizzazioneEsitiRichiesteOutput>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;) and exists(DATAINVIORICHIESTA) and string-length(xsd:string(DATAINVIORICHIESTA))>0&quot;>&#xa;                                    &lt;tns:dataInvio>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before(concat(substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATAINVIORICHIESTA), &amp;quot;+&amp;quot;)), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:dataInvio>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:dataInvio>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATAINVIORICHIESTA), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:dataInvio>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&#xa;                                &lt;tns:statoNow>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&#xa;                                &lt;/tns:statoNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&#xa;                                &lt;tns:statoOao>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&#xa;                                &lt;/tns:statoOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;LAVORAZIONE&quot;>&#xa;                                &lt;tns:lavorazioneRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&#xa;                                &lt;/tns:lavorazioneRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:idRichiestaOlo>&#xa;                                &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                            &lt;/tns:idRichiestaOlo>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                &lt;tns:codiceRichiestaOao>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns:codiceRichiestaOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaRichieste/tns7:listaXml[tns7:codRichiestaOao=$VisualizzazioneEsitiRichiesteQueryOLO/Record/IDRICHIESTAOLO]/tns7:xml&quot;>&#xa;                                &lt;tns:xml>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaRichieste/tns7:listaXml[tns7:codRichiestaOao=$VisualizzazioneEsitiRichiesteQueryOLO/Record/IDRICHIESTAOLO]/tns7:xml&quot;/>&#xa;                                &lt;/tns:xml>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(OPERATORE) and upper-case(OPERATORE)!='AUTOMATICO'&quot;>&#xa;                                &lt;xsl:if test=&quot;OPERATORE&quot;>&#xa;                                    &lt;tns:userId>&#xa;                                        &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                                    &lt;/tns:userId>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:visualizzazioneEsitiRichiesteOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:outputVisualizzaEsitiRichieste>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputVisualizzaEsitiRichieste/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
