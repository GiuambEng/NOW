                            </bpws:extensionActivity>
                            <bpws:empty name="Empty3" tibex:xpdlId="e1208d38-c7af-4ab0-8d8c-52e880ab13b4">
                                <bpws:targets>
                                    <bpws:target linkName="Log1ToEmpty3"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty3ToJDBCQuery1_DG-MKT-NEWS">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($post/item/ns1:inputVisualizzaEsitiRichieste/ns1:tipoProfilo,'DG') or contains($post/item/ns1:inputVisualizzaEsitiRichieste/ns1:tipoProfilo,'MKT') or contains($post/item/ns1:inputVisualizzaEsitiRichieste/ns1:tipoProfilo,'NEWS')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($post.item/ns1:tipoProfilo,'DG') or contains($post.item/ns1:tipoProfilo,'MKT') or contains($post.item/ns1:tipoProfilo,'NEWS')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty3ToJDBCQuery_PPS-GA">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b8ead113-1231-4b46-bb5f-35106ed33ad2+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VisualizzaNotifichePPS_GA-input"
                                    name="VisualizzaNotifichePPS_GA"
                                    outputVariable="VisualizzaNotifichePPS_GA"
                                    tibex:xpdlId="b8ead113-1231-4b46-bb5f-35106ed33ad2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty3ToJDBCQuery_PPS-GA"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VisualizzaNotifichePPS_GAToEmpty4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b8ead113-1231-4b46-bb5f-35106ed33ad2+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select  ID_FILE_PROCSTO_OUTPUT,TIMSTP_CREAZIONE,TRACCIATO_FILE, TIMSTP_INVIO, ID_NOTF,TIPOLG_NOTF, DESCR_CAUS_OLO,  NOME_FILE, CODFC_OLO_AGCOM&#xa;from (&#xa;SELECT FP.ID_FILE_PROCSTO_OUTPUT,   RN.TIMSTP_CREAZIONE,&#xa;RN.TRACCIATO_FILE, PO.TIMSTP_INVIO, RN.ID_NOTF,&#xa;TN.DESCR as TIPOLG_NOTF,CAU.DESCR_CAUS_OLO,P.NOME_FILE,RN.CODFC_OLO_AGCOM, dense_rank() over (partition by RN.ID_NOTF order by PO.TIMSTP_INVIO desc) as ord&#xa;FROM appuser.RICH_ORDN_COMUNIC_NOTF RN &#xa;LEFT JOIN appuser.FILE_NOTF_STANDARD FP ON  RN.ID_NOTF = FP.ID_NOTF&#xa;LEFT JOIN appuser.FILE_PROCSTO_OUTPUT PO ON FP.ID_FILE_PROCSTO_OUTPUT = PO.ID_FILE_PROCSTO_OUTPUT &#xa;LEFT JOIN appuser.TIPOLG_NOTF TN  ON  TN.COD_TIPOLG_NOTF = RN.COD_TIPOLG_NOTF AND TN.STRUTTURA_RICH = RN.STRUTTURA_RICH&#xa;LEFT JOIN appuser.ANAG_CAUS CAU ON CAU.ID_ANAG_CAUS = RN.ID_ANAG_CAUS&#xa;LEFT JOIN appuser.FILE_PROCSTO P ON P.ID_FILE = FP.ID_FILE_PROCSTO_OUTPUT&#xa;WHERE RN.ID_RICH_OLO = ? &#xa;ORDER BY RN.ID_NOTF, PO.TIMSTP_INVIO&#xa;) where ord =1" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>
