/tns7:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaEsitiRichieste_&amp;quot;,&amp;#x9;$post/httpHeaders/tns8:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns7:EventType>&#xa;                        &lt;tns7:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaEsitiRichieste_&amp;quot;,&amp;#x9;$post/httpHeaders/tns8:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns7:trackID>&#xa;                    &lt;/tns7:Identifier>&#xa;                    &lt;tns7:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns7:track_position>&#xa;                    &lt;tns7:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns7:Timestamp>&#xa;                    &lt;tns7:ErrorLog>&#xa;                        &lt;tns7:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns7:TimeStamp>&#xa;                        &lt;tns7:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaEsitiRichieste&amp;quot;,'SID:',$post/httpHeaders/tns8:httpHeaders/GUI-SID,'TID:',$post/httpHeaders/tns8:httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns7:Descrizione>&#xa;                        &lt;tns7:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns7:Codice>&#xa;                        &lt;tns7:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns7:track_positi