                                portType="ns:visualizzaesitirichieste"
                                tibex:xpdlId="52944f96-9573-41ac-b575-27125bfb7d53" variable="postOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://xmlns.example.com/20201207123608PLT" xmlns:tns="http://www.example.org/VisualizzaEsitiRichieste" version="2.0"&gt;
    &lt;xsl:param name="VariableRichieste"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns7:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="count($VariableRichieste/tns:visualizzazioneNotificheOutput) &gt;0 or count($VariableRichieste/tns:visualizzazioneEsitiRichiesteOutput) &gt;0"&gt;
                        &lt;tns:outputVisualizzaEsitiRichieste&gt;
                            &lt;xsl:for-each select="$VariableRichieste/tns:visualizzazioneNotificheOutput"&gt;
                                &lt;tns:visualizzazioneNotificheOutput&gt;
                                    &lt;xsl:if test="tns:tipologiaNotifica"&gt;
                                        &lt;tns:tipologiaNotifica&gt;
                                            &lt;xsl:value-of select="tns:tipologiaNotifica"/&gt;
                                        &lt;/tns:tipologiaNotifica&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:causale"&gt;
                                        &lt;tns:causale&gt;
                                            &lt;xsl:value-of select="tns:causale"/&gt;
                                        &lt;/tns:causale&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:dataCreazione"&gt;
                                        &lt;tns:dataCreazione&gt;
                                            &lt;xsl:value-of select="tns:dataCreazione"/&gt;
                                        &lt;/tns:dataCreazione&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:notificaXML"&gt;
                                        &lt;tns:notificaXML&gt;
                                            &lt;xsl:value-of select="tns:notificaXML"/&gt;
                                        &lt;/tns:notificaXML&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:ultimoFileNotifica"&gt;
                                        &lt;tns:ultimoFileNotifica&gt;
                                            &lt;xsl:value-of select="tns:ultimoFileNotifica"/&gt;
                                        &lt;/tns:ultimoFileNotifica&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:dataInvioFile"&gt;
                                        &lt;tns:dataInvioFile&gt;
                                            &lt;xsl:value-of select="tns:dataInvioFile"/&gt;
                                        &lt;/tns:dataInvioFile&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:idNotifica"&gt;
                                        &lt;tns:idNotifica&gt;
                                            &lt;xsl:value-of select="tns:idNotifica"/&gt;
                                        &lt;/tns:idNotifica&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:visualizzazioneNotificheOutput&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;xsl:for-each select="$VariableRichieste/tns:visualizzazioneEsitiRichiesteOutput"&gt;
                                &lt;tns:visualizzazioneEsitiRichiesteOutput&gt;
                                    &lt;xsl:if test="tns:dataInvio"&gt;
                                        &lt;tns:dataInvio&gt;
                                            &lt;xsl:value-of select="tns:dataInvio"/&gt;
                                        &lt;/tns:dataInvio&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:statoNow"&gt;
                                        &lt;tns:statoNow&gt;
                                            &lt;xsl:value-of select="tns:statoNow"/&gt;
                                        &lt;/tns:statoNow&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:statoOao"&gt;
                                        &lt;tns:statoOao&gt;
                                            &lt;xsl:value-of select="tns:statoOao"/&gt;
                                        &lt;/tns:statoOao&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:lavorazioneRichiesta"&gt;
                                        &lt;tns:lavorazioneRichiesta&gt;
                                            &lt;xsl:value-of select="tns:lavorazioneRichiesta"/&gt;
                                        &lt;/tns:lavorazioneRichiesta&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:idRichiestaOlo"&gt;
                                        &lt;tns:idRichiestaOlo&gt;
                                            &lt;xsl:value-of select="tns:idRichiestaOlo"/&gt;
                                        &lt;/tns:idRichiestaOlo&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:codiceRichiestaOao"&gt;
                                        &lt;tns:codiceRichiestaOao&gt;
                                            &lt;xsl:value-of select="tns:codiceRichiestaOao"/&gt;
                                        &lt;/tns:codiceRichiestaOao&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:xml"&gt;
                                        &lt;tns:xml&gt;
                                            &lt;xsl:value-of select="tns:xml"/&gt;
                                        &lt;/tns:xml&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:userId"&gt;
                                        &lt;tns:userId&gt;
                                            &lt;xsl:value-of select="tns:userId"/&gt;
                                        &lt;/tns:userId&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:visualizzazioneEsitiRichiesteOutput&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                                &lt;tns:details&gt;
                                    &lt;xsl:value-of select="'RECORD ESISTENTI'"/&gt;
                                &lt;/tns:details&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:outputVisualizzaEsitiRichieste&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:outputVisualizzaEsitiRichieste&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                                &lt;tns:details&gt;
                                    &lt;xsl:value-of select="'NO RECORD'"/&gt;
                                &lt;/tns:details&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:outputVisualizzaEsitiRichieste&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns7:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://xmlns.example.com/20201207123608PLT&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VariableRichieste&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($VariableRichieste/tns:visualizzazioneNotificheOutput) >0 or count($VariableRichieste/tns:visualizzazioneEsitiRichiesteOutput) >0&quot;>&#xa;                &lt;tns:outputVisualizzaEsitiRichieste>&#xa;                    &lt;xsl:for-each select=&quot;$VariableRichieste/tns:visualizzazioneNotificheOutput&quot;>&#xa;                        &lt;tns:visualizzazioneNotificheOutput>&#xa;                            &lt;xsl:if test=&quot;tns:tipologiaNotifica&quot;>&#xa;                                &lt;tns:tipologiaNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;tns:tipologiaNotifica&quot;/>&#xa;                                &lt;/tns:tipologiaNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:causale&quot;>&#xa;                                &lt;tns:causale>&#xa;                                    &lt;xsl:value-of select=&quot;tns:causale&quot;/>&#xa;                                &lt;/tns:causale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:dataCreazione&quot;>&#xa;                                &lt;tns:dataCreazione>&#xa;                                    &lt;xsl:value-of select=&quot;tns:dataCreazione&quot;/>&#xa;                                &lt;/tns:dataCreazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:notificaXML&quot;>&#xa;                                &lt;tns:notificaXML>&#xa;                                    &lt;xsl:value-of select=&quot;tns:notificaXML&quot;/>&#xa;                                &lt;/tns:notificaXML>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:ultimoFileNotifica&quot;>&#xa;                                &lt;tns:ultimoFileNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ultimoFileNotifica&quot;/>&#xa;                                &lt;/tns:ultimoFileNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:dataInvioFile&quot;>&#xa;                                &lt;tns:dataInvioFile>&#xa;                                    &lt;xsl:value-of select=&quot;tns:dataInvioFile&quot;/>&#xa;                                &lt;/tns:dataInvioFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:idNotifica&quot;>&#xa;                                &lt;tns:idNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;tns:idNotifica&quot;/>&#xa;                                &lt;/tns:idNotifica>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:visualizzazioneNotificheOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;$VariableRichieste/tns:visualizzazioneEsitiRichiesteOutput&quot;>&#xa;                        &lt;tns:visualizzazioneEsitiRichiesteOutput>&#xa;                            &lt;xsl:if test=&quot;tns:dataInvio&quot;>&#xa;                                &lt;tns:dataInvio>&#xa;                                    &lt;xsl:value-of select=&quot;tns:dataInvio&quot;/>&#xa;                                &lt;/tns:dataInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:statoNow&quot;>&#xa;                                &lt;tns:statoNow>&#xa;                                    &lt;xsl:value-of select=&quot;tns:statoNow&quot;/>&#xa;                                &lt;/tns:statoNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:statoOao&quot;>&#xa;                                &lt;tns:statoOao>&#xa;                                    &lt;xsl:value-of select=&quot;tns:statoOao&quot;/>&#xa;                                &lt;/tns:statoOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:lavorazioneRichiesta&quot;>&#xa;                                &lt;tns:lavorazioneRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;tns:lavorazioneRichiesta&quot;/>&#xa;                                &lt;/tns:lavorazioneRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:idRichiestaOlo&quot;>&#xa;                                &lt;tns:idRichiestaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;tns:idRichiestaOlo&quot;/>&#xa;                                &lt;/tns:idRichiestaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:codiceRichiestaOao&quot;>&#xa;                                &lt;tns:codiceRichiestaOao>&#xa;                                    &lt;xsl:value-of select=&quot;tns:codiceRichiestaOao&quot;/>&#xa;                                &lt;/tns:codiceRichiestaOao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:xml&quot;>&#xa;                                &lt;tns:xml>&#xa;                                    &lt;xsl:value-of select=&quot;tns:xml&quot;/>&#xa;                                &lt;/tns:xml>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:userId&quot;>&#xa;                                &lt;tns:userId>&#xa;                                    &lt;xsl:value-of select=&quot;tns:userId&quot;/>&#xa;                                &lt;/tns:userId>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:visualizzazioneEsitiRichiesteOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'RECORD ESISTENTI'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputVisualizzaEsitiRichieste>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputVisualizzaEsitiRichieste>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'NO RECORD'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputVisualizzaEsitiRichieste>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
