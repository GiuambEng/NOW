                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3b80f173-9c3e-4afc-8271-c9ebff138d17+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneNotificheOLOQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;idRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiesta>&#xa;            &lt;codAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom>&#xa;            &lt;codAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom2>&#xa;            &lt;codAgcom3>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom3>&#xa;            &lt;codAgcom4>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom4>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VisualizzazioneNotificheOLOQuery-input"
                                    name="VisualizzazioneNotificheOLOQuery"
                                    outputVariable="VisualizzazioneNotificheOLOQuery"
                                    tibex:xpdlId="3b80f173-9c3e-4afc-8271-c9ebff138d17" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToVisualizzazioneNotificheOLOQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VisualizzazioneNotificheOLOQueryToEmpty4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3b80f173-9c3e-4afc-8271-c9ebff138d17+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneNotificheOLOQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;idRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiesta>&#xa;            &lt;codAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom>&#xa;            &lt;codAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom2>&#xa;            &lt;codAgcom3>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom3>&#xa;            &lt;codAgcom4>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom4>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select  ID_FILE_PROCSTO_OUTPUT,TIMSTP_CREAZIONE,TRACCIATO_FILE, TIMSTP_INVIO, ID_NOTF,TIPOLG_NOTF, DESCR_CAUS_OLO,  NOME_FILE, CODFC_OLO_AGCOM&#xa;from (&#xa;SELECT FP.ID_FILE_PROCSTO_OUTPUT,   RN.TIMSTP_CREAZIONE,&#xa;RN.TRACCIATO_FILE, PO.TIMSTP_INVIO, RN.ID_NOTF,&#xa;TN.DESCR as TIPOLG_NOTF,CAU.DESCR_CAUS_OLO,P.NOME_FILE,RN.CODFC_OLO_AGCOM, dense_rank() over (partition by RN.ID_NOTF order by PO.TIMSTP_INVIO desc) as ord&#xa;FROM appuser.RICH_ORDN_COMUNIC_NOTF RN &#xa;LEFT JOIN appuser.FILE_NOTF_STANDARD FP ON  RN.ID_NOTF = FP.ID_NOTF&#xa;LEFT JOIN appuser.FILE_PROCSTO_OUTPUT PO ON FP.ID_FILE_PROCSTO_OUTPUT = PO.ID_FILE_PROCSTO_OUTPUT &#xa;LEFT JOIN appuser.TIPOLG_NOTF TN  ON  TN.COD_TIPOLG_NOTF = RN.COD_TIPOLG_NOTF AND TN.STRUTTURA_RICH = RN.STRUTTURA_RICH&#xa;LEFT JOIN appuser.ANAG_CAUS CAU ON CAU.ID_ANAG_CAUS = RN.ID_ANAG_CAUS&#xa;LEFT JOIN appuser.FILE_PROCSTO P ON P.ID_FILE = FP.ID_FILE_PROCSTO_OUTPUT&#xa;LEFT JOIN appuser.TIPOLG_STNTF TNF ON TNF.IDTPLG_STNTF=RN.IDTPLG_STNTF_FLGIORN OR TNF.IDTPLG_STNTF=RN.IDTPLG_STNTF_FLMENS OR TNF.IDTPLG_STNTF=RN.IDTPLG_STNTF_FILE_ORARIO&#xa;WHERE TNF.STNTF IN ('INVIATA','SOLO GUI','SOLO VIA EMAIL') AND RN.ID_RICH_OLO = ?&#xa;AND NVL(P.CODFC_OLO_AGCOM, ?) IN (SELECT CODFC_OLO_AGCOM&#xa;FROM appuser.OLO&#xa;WHERE CODFC_OLO_AGCOM = ?&#xa;OR COD_OLO_ACCORPANTE = ?&#xa;OR COD_OLO = (SELECT COD_OLO FROM appuser.OLO WHERE CODFC_OLO_AGCOM = ?))&#xa;ORDER BY RN.ID_NOTF, PO.TIMSTP_INVIO&#xa;) where ord =1&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiesta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom3"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom4"/>
                                    <columnMetadata
                                    columnName="ID_FILE_PROCSTO_OUTPUT"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TRACCIATO_FILE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INVIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="ID_NOTF"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIPOLG_NOTF"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+84ae1f91-9946-4121-9a68-96d008e06551+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TIPORICHIESTA&quot;/>&#xa;    &lt;xsl:param name=&quot;AMBITO&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneEsitiRichiesteQueryOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiestaOlo>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$TIPORICHIESTA&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;$AMBITO&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;codAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom>&#xa;            &lt;codAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom2>&#xa;            &lt;codAgcom3>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns:inputVisualizzaEsitiRichieste/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom3>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VisualizzazioneEsitiRichiesteQueryOLO-input"
                                    name="VisualizzazioneEsitiRichiesteQueryOLO"
                                    outputVariable="VisualizzazioneEsitiRichiesteQueryOLO"
                                    tibex:xpdlId="84ae1f91-9946-4121-9a68-96d008e06551" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToVisualizzazioneEsitiRichiesteQueryOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VisualizzazioneEsitiRichiesteQueryOLOToEmpty4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+84ae1f91-9946-4121-9a68-96d008e06551+input&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;TIPORICHIESTA&quot;/>&#xa;    &lt;xsl:param name=&quot;AMBITO&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneEsitiRichiesteQueryOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:idRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:idRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRichiestaOlo>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$TIPORICHIESTA&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;$AMBITO&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;codAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom>&#xa;            &lt;codAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom2>&#xa;            &lt;codAgcom3>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codAgcom3>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;r1.DATAINVIORICHIESTA, &#xa;r1.STATORICHIESTANOW, &#xa;r1.STATORICHIESTAOLO,&#xa;r1.LAVORAZIONE,&#xa;r1.IDRICHIESTAOLO,&#xa;r1.CODICEORDINEOLO,&#xa;r1.CONTENUTOXML,&#xa;r1.OPERATORE,&#xa;ar.contenuto_xml_olo&#xa;FROM BDS_1_CASEDATA_RICHIESTA r1 &#xa;INNER JOIN BDS_1_CASEDATA_RICHIESTA r2 ON (r1.CODICEORDINETITARGET= r2.CODICEORDINETI or r1.codiceordineolotarget = r2.codiceordineolo)&#xa;LEFT JOIN acquisizione_richieste AR ON TO_CHAR(r1.idrichiestaolo) = ar.id_richiesta_olo&#xa;WHERE r2.IDRICHIESTAOLO = ? AND r1.TIPORICHIESTA = ? AND r1.AMBITO = ?&#xa;AND r1.codificaoloagcom  IN (SELECT CODFC_OLO_AGCOM&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?&#xa;OR COD_OLO_ACCORPANTE =?&#xa;OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = ?))&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tipoRichiesta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ambito"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codAgcom3"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
