                                    <value
                                    sharedResourceProperty="jdbcProperty1"
                                    sqlStatement="SELECT RN.TIMESTAMP_CREAZ,&#xa;&#xa;RN.TRACCIATO,&#xa;&#xa;decode(TN.DESCR,'Notifica di avviso Cessazione vs Donating','Richiesta di Verifica Codice Sessione',TN.DESCR)as TIPOLG_NOTF, CAU.DESCR_CAUS_OLO, RN.CODIFICA_OLO_AGCOM, RN.ID_RICHORDN_COMNOTFDEL82, RN.ID_ANAGRAFICA_CAUSALE&#xa;&#xa;FROM appuser.RICH_ORDN_COMUNIC_NOTF_DEL82 RN&#xa;&#xa;INNER JOIN appuser.TIPOLG_NOTF TN  ON  TN.COD_TIPOLG_NOTF = RN.COD_TIPOLOGIA_NOTIF AND TN.STRUTTURA_RICH = RN.STRUTTURA_RICHIESTA&#xa;&#xa;LEFT JOIN appuser.ANAG_CAUS CAU ON CAU.ID_ANAG_CAUS = RN.ID_ANAGRAFICA_CAUSALE&#xa;&#xa;AND RN.CODIFICA_OLO_AGCOM  IN (SELECT CODFC_OLO_AGCOM&#xa;&#xa;FROM appuser.OLO&#xa;&#xa;WHERE CODFC_OLO_AGCOM = ?&#xa;&#xa;OR COD_OLO_ACCORPANTE = ?&#xa;&#xa;OR COD_OLO = (SELECT COD_OLO FROM appuser.OLO WHERE CODFC_OLO_AGCOM = ?))&#xa;&#xa;WHERE rn.id_tipol_stato_notifica='2' AND RN.ID_RICHIESTA_OLO=?&#xa;&#xa;order by 1 asc" xsi:type="jdbcPalette:JDBCQueryActivity">

