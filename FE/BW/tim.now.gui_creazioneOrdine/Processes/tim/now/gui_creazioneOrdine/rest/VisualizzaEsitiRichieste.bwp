                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaEsitiRichieste&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzaNotifiche.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheOLOQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQueryOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzaNotifichePPS_GA&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheDG_MKT_NEWSQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryPPS_GA_Del82&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryDG_MKT_NEWS_Del82&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryProfiliOloDel82&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQueryOLODel82&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneEsitiRichiesteQuery_Del82&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableRichieste&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(string-length(string($VisualizzazioneNotificheDG_MKT_NEWSQuery/Record[1]/ID_NOTF))>0 or string-length(string($VisualizzazioneNotificheOLOQuery/Record[1]/ID_NOTF))>0 or string-length(string($VisualizzaNotifichePPS_GA/Record[1]/ID_NOTF))>0) and (string-length($VisualizzazioneEsitiRichiesteQueryOLO/Record[1]/IDRICHIESTAOLO) = 0 and string-length($VisualizzazioneEsitiRichiesteQuery/Record[1]/IDRICHIESTAOLO) = 0 and string-length($JDBCQuery/Record[1]/IDRICHIESTAOLO) = 0)&quot;>&#xa;                &lt;tns:outputVisualizzaEsiti