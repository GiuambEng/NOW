<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no"
    name="tim.now.gui_creazioneOrdine.rest.VisualizzazionePosizioneCoda"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20160621104244"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://xmlns.example.com/20160621104244PLT"
    xmlns:ns0="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns1="http://www.tim.com/NOW/wsdl/abstract/UnicaRAQueuePositionMonitor/"
    xmlns:ns10="http://www.tibco.com/namespaces/tnt/plugins/jdbc"
    xmlns:ns11="http://www.tibco.com/namespaces/tnt/plugins/jdbc+2096cc63-d5e3-4275-a8ca-df156fcee842+input"
    xmlns:ns12="http://www.tibco.com/namespaces/tnt/plugins/jdbc+2096cc63-d5e3-4275-a8ca-df156fcee842+output"
    xmlns:ns13="http://www.tibco.com/namespaces/tnt/plugins/jdbc+0c240783-5289-410f-99bc-6c7c8b6797b6+input"
    xmlns:ns14="http://www.tibco.com/namespaces/tnt/plugins/jdbc+49ab06de-50ec-4d3a-ba1a-b4c2da9109d6+input"
    xmlns:ns15="http://www.tibco.com/namespaces/tnt/plugins/jdbc+49ab06de-50ec-4d3a-ba1a-b4c2da9109d6+output"
    xmlns:ns16="http://www.tibco.com/namespaces/tnt/plugins/jdbc+e74f7d9c-e7e6-4369-ac01-2b639cb07cff+input"
    xmlns:ns17="http://www.tibco.com/namespaces/tnt/plugins/jdbc+ec84f543-c716-40f1-ae40-c3a0be549ad3+input"
    xmlns:ns18="http://www.tibco.com/namespaces/tnt/plugins/jdbc+e3de039f-fef7-4576-b7dc-38518fdd4468+input"
    xmlns:ns19="http://www.tibco.com/namespaces/tnt/plugins/jdbc+e3de039f-fef7-4576-b7dc-38518fdd4468+output"
    xmlns:ns2="http://www.tibco.com/pe/WriteToLogActivitySchema"
    xmlns:ns3="http://www.tim.com/NOW/rest/VisualizzazionePosizioneCoda"
    xmlns:ns4="http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoIN"
    xmlns:ns5="http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoOUT"
    xmlns:ns6="http://www.tim.com/NOW/cmf/GenericLogger"
    xmlns:ns7="http://www.tibco.com/namespaces/tnt/plugins/jdbc+da6dddac-6d97-459d-8368-4ff6e59ae943+input"
    xmlns:ns8="http://www.tibco.com/namespaces/tnt/plugins/jdbc+da6dddac-6d97-459d-8368-4ff6e59ae943+output"
