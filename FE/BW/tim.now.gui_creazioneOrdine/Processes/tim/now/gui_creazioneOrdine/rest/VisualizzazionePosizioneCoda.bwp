                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoIN&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzazionePosizioneCoda/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:SERVIZIO>&#xa;            &lt;xsl:attribute name=&quot;nome&quot;>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaPosizione&amp;quot;&quot;/>&#xa;            &lt;/xsl:attribute>&#xa;            &lt;ns1:Input>&#xa;                &lt;xsl:if test=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;>&#xa;                    &lt;ns1:Distretto>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;/>&#xa;                    &lt;/ns1:Distretto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$RecuperoDistretto/Record[1]/DESCR = &amp;quot;DATI&amp;quot;&quot;>&#xa;                        &lt;ns1:IdTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;substring(tib:trim(substring($get.parameters/tns:idRisorsa, 1, 12)), 4)&quot;/>&#xa;                        &lt;/ns1:IdTelefonico>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns1:IdTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;$get.parameters/tns:idRisorsa&quot;/>&#xa;                        &lt;/ns1:IdTelefonico>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns1:Input>&#xa;        &lt;/ns1:SERVIZIO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
