                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoIN&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzazionePosizioneCoda/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;ns1:SERVIZIO>&lt;xsl:attribute name=&quot;nome&quot;>&lt;xsl:value-of select=&quot;&amp;quot;VisualizzaPosizione&amp;quot;&quot;/>&lt;/xsl:attribute>&lt;ns1:Input>&lt;xsl:if test=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;>&lt;ns1:Distretto>&lt;xsl:value-of select=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;/>&lt;/ns1:Distretto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperoDistretto/Record[1]/DESCR = &amp;quot;DATI&amp;quot;&quot;>&lt;ns1:IdTelefonico>&lt;xsl:value-of select=&quot;substring(tib:trim(substring($get/parameters/tns:visualizzazioneposizionecodaGetParameters/tns:idRisorsa, 1, 12)), 4)&quot;/>&lt;/ns1:IdTelefonico>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns1:IdTelefonico>&lt;xsl:value-of select=&quot;$get/parameters/tns:visualizzazioneposizionecodaGetParameters/tns:idRisorsa&quot;/>&lt;/ns1:IdTelefonico>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns1:Input>&lt;/ns1:SERVIZIO>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="UnicaRA"
                                    name="AssignUnicaRA"
                                    outputVariable="UnicaRA"
                                    tibex:xpdlId="f528b5bf-1dcc-4972-9998-f7b49dbb5e01" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
