f test=&quot;string-length($Start/tns1:codiceOrdineOloVlan)>0&quot;>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CODICEORDINEOLODAOLO&amp;quot;&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdineOloVlan&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;attributiDettaglioOrdine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;CODICEORDINEOLODAOLO&amp;quot;&quot;/>&#xa;                                &lt;/nomeAttributo>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdineOloVlan&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                                &lt;tipologiaDato>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaDato>&#xa;                            &lt;/attributiDettaglioOrdine>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivo>&#xa;                &lt;/dettaglioordine>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;xsl:if test=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;>&#xa;                    &lt;distretto>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;/>&#xa;                    &lt;/distretto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ordine>&#xa;            &lt;IDContratto>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoDistretto/Record[1]/IDCONTRATTO)&quot;/>&#xa;            &lt;/IDContratto>&#xa;            &lt;xsl:if test=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;string-length($DettaglioAsset.parameters/tns:id_offerta)>0&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($DettaglioAsset.parameters/tns:id_offerta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns3:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$DRO.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length(xsd:string($Start/tns1:dac)) =0&quot;>&#xa;                &lt;DACFile>&#xa;                    &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                &lt;/DACFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariabileCessazione" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;VariabileCessazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;string-length($RecuperoOloNumerico/Record[1]/COD_OLO)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                    &lt;codificaOLONOW>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/codificaOLONOW>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;ordine>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:offertaCatalogo&quot;>&#xa;                    &lt;offertaCatalogo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:offertaCatalogo&quot;/>&#xa;                    &lt;/offertaCatalogo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:offertaCatalogo&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;xsl:if test=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;>&#xa;                    &lt;distretto>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;/>&#xa;                    &lt;/distretto>&#xa;                &lt;/xsl:if>&#xa;                &lt;operatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;                &lt;/operatoreRete>&#xa;            &lt;/ordine>&#xa;            &lt;IDContratto>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoDistretto/Record[1]/IDCONTRATTO)&quot;/>&#xa;            &lt;/IDContratto>&#xa;            &lt;xsl:if test=&quot;$DettaglioAsset/parameters/tns:OutputAssetDetails/tns:tipoServizio&quot;>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAsset/parameters/tns:OutputAssetDetails/tns:tipoServizio&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;string-length($DettaglioAsset/parameters/tns:OutputAssetDetails/tns:id_offerta)>0&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($DettaglioAsset/parameters/tns:OutputAssetDetails/tns:id_offerta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns3:Response/tns3:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns3:Response/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$DRO/parameters/tns3:Response/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;operatoreRete>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;            &lt;/operatoreRete>&#xa;            &lt;xsl:if test=&quot;string-length(xsd:string($Start/tns1:dac)) =0&quot;>&#xa;                &lt;DACFile>&#xa;                    &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                &lt;/DACFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VariabileCessazione"
                    name="CasedataGPON"
                    outputVariable="VariabileCessazione"
                    tibex:xpdlId="1b63c7f5-8fdd-4e19-8c4f-c73a63ebf3ea" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CreazioneOrdineGPONToCasedataGPON"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CasedataGPONToInputCreateProcessBPM"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioAsset.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&#xa;    &lt;xsl:template name=&quot;VariabileCessazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;string-length($RecuperoOloNumerico/Record[1]/COD_OLO)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                    &lt;codificaOLONOW>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/codificaOLONOW>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;ordine>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:offertaCatalogo&quot;>&#xa;                    &lt;offertaCatalogo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:offertaCatalogo&quot;/>&#xa;                    &lt;/offertaCatalogo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:offertaCatalogo&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;xsl:if test=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;>&#xa;                    &lt;distretto>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;/>&#xa;                    &lt;/distretto>&#xa;                &lt;/xsl:if>&#xa;                &lt;operatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;                &lt;/operatoreRete>&#xa;            &lt;/ordine>&#xa;            &lt;IDContratto>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoDistretto/Record[1]/IDCONTRATTO)&quot;/>&#xa;            &lt;/IDContratto>&#xa;            &lt;xsl:if test=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;string-length($DettaglioAsset.parameters/tns:id_offerta)>0&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($DettaglioAsset.parameters/tns:id_offerta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns3:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$DRO.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;operatoreRete>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FC&amp;quot;&quot;/>&#xa;            &lt;/operatoreRete>&#xa;            &lt;xsl:if test=&quot;string-length(xsd:string($Start/tns1:dac)) =0&quot;>&#xa;                &lt;DACFile>&#xa;                    &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                &lt;/DACFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariabileCessazione" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Sottolavorazione"
                    name="Sottolavorazione"
                    outputVariable="Sottolavorazione"
                    tibex:xpdlId="2584e0ce-c09a-4914-a5fc-37696e951dbd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TracciatoOloRegolatorioToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToCasedataBPMRegolatorio"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (string-length($VariabileRegolatorio/Richiesta[1]/Ordine/Cessazione/CessazioneWLRLineaAttiva/Rientro/DataRicezioneRichiesta)>0 or string-length($VariabileRegolatorio/Richiesta[1]/Ordine/Cessazione/CessazioneULL/ULL-NP/Rientro/RientroVeloce/TipoRientro)>0 or string-length($VariabileRegolatorio/Richiesta[1]/Ordine/Cessazione/CessazioneULL/Vull/Rientro/DataRicezioneRichiesta)>0 or string-length($VariabileRegolatorio/Richiesta[1]/Ordine/Cessazione/CessazioneULL/ULLDati-NP/Rientro/RientroVeloce/TipoRientro)>0 or string-length($VariabileRegolatorio/Richiesta[1]/Ordine/Cessazione/CessazioneSLU/SLU-NP/Rientro/RientroVeloce/TipoRientro)>0) then 'RIENTROINTI' else ''" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Sottolavorazione" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="TracciatoOloFiberstream-input"
                    name="TracciatoOloFiberstream"
                    outputVariable="TracciatoOloFiberstream"
                    tibex:xpdlId="cfbc0a91-7e46-4bff-bcf4-8812a01fb154"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloFiberstreamToInputCreateProcessBPM"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns2=&quot;http://www.example.org/OrdiniFiberstream&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;TracciatoOloFiberstream-input&quot; match=&quot;/&quot;>&lt;tns2:nuovoOrdine>&lt;xsl:if test=&quot;$Start/tns1:causaleOrdine&quot;>&lt;tns2:causaleOrdine>&lt;xsl:value-of select=&quot;$Start/tns1:causaleOrdine&quot;/>&lt;/tns2:causaleOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:oao&quot;>&lt;tns2:oao>&lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&lt;/tns2:oao>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&lt;tns2:codiceOrdine>&lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&lt;/tns2:codiceOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:operatore&quot;>&lt;tns2:operatore>&lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&lt;/tns2:operatore>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:codiceOrdinePadre&quot;>&lt;tns2:codiceOrdinePadre>&lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdinePadre&quot;/>&lt;/tns2:codiceOrdinePadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:idContratto&quot;>&lt;tns2:idContratto>&lt;xsl:value-of select=&quot;$Start/tns1:idContratto&quot;/>&lt;/tns2:idContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:idContrattoOfferta&quot;>&lt;tns2:idContrattoOfferta>&lt;xsl:value-of select=&quot;$Start/tns1:idContrattoOfferta&quot;/>&lt;/tns2:idContrattoOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&lt;tns2:noteDaOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&lt;/tns2:noteDaOperatore>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:codiceProgetto&quot;>&lt;tns2:codiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns1:codiceProgetto&quo