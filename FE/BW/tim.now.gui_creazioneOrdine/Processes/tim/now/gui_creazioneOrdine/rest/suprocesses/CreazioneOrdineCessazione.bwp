inale/tns1:dataEmissione), 9, 2),'/',substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataEmissione), 6, 2),'/',substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataEmissione), 1, 4))&quot;/>&lt;/DataEmissione>&lt;/xsl:if>&lt;Referente>&lt;CodiceReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:codiceReferente&quot;/>&lt;/CodiceReferente>&lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:nome&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:nome&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:cognome&quot;>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:cognome&quot;/>&lt;/CognomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:indirizzo&quot;>&lt;IndirizzoReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:indirizzo&quot;/>&lt;/IndirizzoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:telefonoFisso&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:telefonoFisso&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:fax&quot;>&lt;FaxReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:fax&quot;/>&lt;/FaxReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:email&quot;>&lt;EmailReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:email&quot;/>&lt;/EmailReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:cap&quot;>&lt;CapReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:cap&quot;/>&lt;/CapReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:codiceComuneReferente&quot;>&lt;CodiceComuneReferente>&lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:codiceComuneReferente&quot;/>&lt;/Codice