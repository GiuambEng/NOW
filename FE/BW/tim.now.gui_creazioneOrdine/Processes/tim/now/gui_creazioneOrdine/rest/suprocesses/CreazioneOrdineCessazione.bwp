Contratto>&lt;/xsl:if>&lt;DatiCliente>&lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;>&lt;CognomeRagSoc>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;/>&lt;/CognomeRagSoc>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;>&lt;Nome>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;/>&lt;/Nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:datiClienteFinale/tns1:cf)&quot;>&lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;/>&lt;/CF>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DatiCliente>&lt;DatiSede>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;>&lt;ParticellaToponomastica>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;/>&lt;/ParticellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo)&quot;>&lt;Via>&lt;xsl:value-of select=&quot;substring($Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo, 1, 70)&quot;/>&lt;/Via>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;>&lt;Civico>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;/>&lt;/Civico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:localita&quot;>&lt;Localita>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:localita&quot;/>&lt;/Localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:cap&quot;>&lt;CAP>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:cap&quot;/>&lt;/CAP>&lt;/xsl:if>&lt;/DatiSede>&lt;xsl:for-each select=&quot;$Start/tns1:datiReferenti[1]&quot;>&lt;Referente>&lt;Progressivo>&lt;xsl:value-of select=&quot;tns1:progressivoReferente&quot;/>&lt;/Progressivo>&lt;QualificaRef>&lt;xsl:value-of select=&quot;tns1:qualifica&quot;/>&lt;/QualificaRef>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;tns1:cognome&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;tns1:nome&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;tns1:nome&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:telefonoFisso&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;tns1:telefonoFisso&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:cellulare&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;tns1:cellulare&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:email&quot;>&lt;EmailReferente>&lt;xsl:value-of select=&quot;tns1:email&quot;/>&lt;/EmailReferente>&lt;/xsl:if>&lt;/Referente>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:dac)&quot;>&lt;DataDAC>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:dac), 9, 2),'/',substring(xsd:string($Start/tns1:dac), 6, 2),'/',substring(xsd:string($Start/tns1:dac), 1, 4))&quot;/>&lt;/DataDAC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DataDAC>&lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&lt;/DataDAC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:recapitoTelefonicoCliente&quot;>&lt;RecapitoAlternativoCliente>&lt;xsl:value-of select=&quot;$Start/tns1:recapitoTelefonicoCliente&quot;/>&lt;/RecapitoAlternativoCliente>&lt;/xsl:if>&lt;/CessazioneWLRLineaNonAttiva>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Cessazione>&lt;/Ordine>&lt;/Richiesta>&lt;/RichiestaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VariabileRegolatorio"
                    name="TracciatoOloRegolatorio"
                    outputVariable="VariabileRegolatorio"
                    tibex:xpdlId="6f21385b-bb27-49bf-bfbd-98a5ff29df01" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAssign_Regolatorio"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloRegolatorioToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DettaglioAsset.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;GetNomeOffCatalog&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;VariabileRegolatorio&quot; match=&quot;/&quot;>&#xa;        &lt;RichiestaOloRegolatorio>&#xa;            &lt;Richiesta>&#xa;                &lt;Testata>&#xa;                    &lt;CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                    &lt;/CodiceOlo>&#xa;                    &lt;CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                    &lt;/CodiceOrdineOlo>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:codiceOrdinePadre&quot;>&#xa;                        &lt;CodiceOrdineOloPadre>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdinePadre&quot;/>&#xa;                        &lt;/CodiceOrdineOloPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:codiceProgetto&quot;>&#xa;                        &lt;CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:codiceProgetto&quot;/>&#xa;                        &lt;/CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&#xa;                        &lt;Note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&#xa;                        &lt;/Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:refOaoProgettiSpeciali&quot;>&#xa;                        &lt;ReferentiOAOProgettiSpeciali>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:refOaoProgettiSpeciali&quot;/>&#xa;                        &lt;/ReferentiOAOProgettiSpeciali>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Testata>&#xa;                &lt;Ordine>&#xa;                    &lt;Cessazione>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = 'ULL' and $DettaglioAsset.parameters/tns:id_offerta = ('1','2')&quot;>&#xa;                                &lt;CessazioneULL>&#xa;                                    &lt;ULL>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($Start/tns1:dac)&quot;>&#xa;                                                &lt;DataDAC>&#xa;                                                    &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:dac), 9, 2),'/',substring(xsd:string($Start/tns1:dac), 6, 2),'/',substring(xsd:string($Start/tns1:dac), 1, 4))&quot;/>&#xa;                                                &lt;/DataDAC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;DataDAC>&#xa;                                                    &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                                                &lt;/DataDAC>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;DatiCliente>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;>&#xa;                                                &lt;CognomeRagSoc>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;/>&#xa;                                                &lt;/CognomeRagSoc>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;>&#xa;                                                &lt;Nome>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;/>&#xa;                                                &lt;/Nome>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($Start/tns1:datiClienteFinale/tns1:cf)&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;>&#xa;                                                        &lt;CF>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;/>&#xa;                                                        &lt;/CF>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;>&#xa;                                                        &lt;PIVA>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;/>&#xa;                                                        &lt;/PIVA>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/DatiCliente>&#xa;                                        &lt;Sede>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;>&#xa;                                                &lt;ParticellaToponomastica>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;/>&#xa;                                                &lt;/ParticellaToponomastica>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;exists($Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo)&quot;>&#xa;                                                &lt;Via>&#xa;                                                    &lt;xsl:value-of select=&quot;substring($Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo, 1, 70)&quot;/>&#xa;                                                &lt;/Via>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;>&#xa;                                                &lt;Civico>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;/>&#xa;                                                &lt;/Civico>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:localita&quot;>&#xa;                                                &lt;Localita>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:localita&quot;/>&#xa;                                                &lt;/Localita>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:cap&quot;>&#xa;                                                &lt;CAP>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:cap&quot;/>&#xa;                                                &lt;/CAP>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:complesso&quot;>&#xa;                                                &lt;Complesso>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:complesso&quot;/>&#xa;                                                &lt;/Complesso>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:scala&quot;>&#xa;                                                &lt;Scala>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:scala&quot;/>&#xa;                                                &lt;/Scala>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:piano&quot;>&#xa;                                                &lt;Piano>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:piano&quot;/>&#xa;                                                &lt;/Piano>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:interno&quot;>&#xa;                                                &lt;Interno>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:interno&quot;/>&#xa;                                                &lt;/Interno>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo&quot;>&#xa;                                                &lt;CodiceIndirizzo>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo&quot;/>&#xa;                                                &lt;/CodiceIndirizzo>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:comune&quot;>&#xa;                                                &lt;CodiceComune>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:comune&quot;/>&#xa;                                                &lt;/CodiceComune>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/Sede>&#xa;                                        &lt;xsl:for-each select=&quot;$Start/tns1:datiReferenti[1]&quot;>&#xa;                                            &lt;Referente>&#xa;                                                &lt;Progressivo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:progressivoReferente&quot;/>&#xa;                                                &lt;/Progressivo>&#xa;                                                &lt;QualificaRef>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:qualifica&quot;/>&#xa;                                                &lt;/QualificaRef>&#xa;                                                &lt;CognomeReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:cognome&quot;/>&#xa;                                                &lt;/CognomeReferente>&#xa;                                                &lt;xsl:if test=&quot;tns1:nome&quot;>&#xa;                                                    &lt;NomeReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;tns1:nome&quot;/>&#xa;                                                    &lt;/NomeReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;tns1:telefonoFisso&quot;>&#xa;                                                    &lt;TelefonoFissoReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;tns1:telefonoFisso&quot;/>&#xa;                                                    &lt;/TelefonoFissoReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;tns1:cellulare&quot;>&#xa;                                                    &lt;TelefonoMobileReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;tns1:cellulare&quot;/>&#xa;                                                    &lt;/TelefonoMobileReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;tns1:email&quot;>&#xa;                                                    &lt;EmailReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;tns1:email&quot;/>&#xa;                                                    &lt;/EmailReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/Referente>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;IDRisorsa>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                        &lt;/IDRisorsa>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns1:flagMonitoraggio='N'&quot;>&#xa;                                                &lt;FlagMonitoraggio>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/FlagMonitoraggio>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;FlagMonitoraggio>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                &lt;/FlagMonitoraggio>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ULL>&#xa;                                &lt;/CessazioneULL>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;upper-case($GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG) = 'ULLDATI' and $DettaglioAsset.parameters/tns: