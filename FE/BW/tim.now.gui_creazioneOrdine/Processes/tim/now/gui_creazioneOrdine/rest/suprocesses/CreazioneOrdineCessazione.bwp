                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="6a831661-6e7c-4731-baaf-0b2a424a6b81">
                <bpws:targets>
                    <bpws:target linkName="GetNomeOffCatalogToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToAssign_Regolatorio">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = ('ULL','ULLDati','SLU','VULL','SHA','WLR','CPS')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = ('ULL','ULLDati','SLU','VULL','SHA','WLR','CPS')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign1_ServiziXDSL">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG)=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMSIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL','BITSTREAMATMSIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMGBEASIMMETRICOFLAT', 'BITSTREAMGBESIMMETRICOFLAT', 'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE','VLAN')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG)=('BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMSIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL','BITSTREAMATMSIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMGBEASIMMETRICOFLAT', 'BITSTREAMGBESIMMETRICOFLAT', 'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE','VLAN')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign1_ServiziNGA">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG)=('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH','EASYIPUBBFTTCAB','EASYIPUBBFTTH','VLANVULA','VLANNGA','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPUBBFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[upper-case($GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG)=('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH','EASYIPUBBFTTCAB','EASYIPUBBFTTH','VLANVULA','VLANNGA','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPUBBFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToJDBCQuery_ServiziFWA">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = 'FixedWirelessAccess'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = 'FixedWirelessAccess']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign1_VP">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = 'VP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = 'VP']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToCreazioneOrdineGPON">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG) =('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[upper-case($GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG) =('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG) =('FIBERSTREAM')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[upper-case($GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG) =('FIBERSTREAM')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetNomeOffCatalog&quot;/>&lt;xsl:param name=&quot;DettaglioAsset&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;VariabileRegolatorio&quot; match=&quot;/&quot;>&lt;RichiestaOloRegolatorio>&lt;Richiesta>&lt;Testata>&lt;CodiceOlo>&lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&lt;/CodiceOlo>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&lt;/CodiceOrdineOlo>&lt;xsl:if test=&quot;$Start/tns1:codiceOrdinePadre&quot;>&lt;CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdinePadre&quot;/>&lt;/CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:codiceProgetto&quot;>&lt;CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns1:codiceProgetto&quot;/>&lt;/CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&lt;/Note>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:refOaoProgettiSpeciali&quot;>&lt;ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$Start/tns1:refOaoProgettiSpeciali&quot;/>&lt;/ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;/Testata>&lt;Ordine>&lt;Cessazione>&lt;xsl:choose>&lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = 'ULL' and $DettaglioAsset/parameters/tns:OutputAssetDetails/tns:id_offerta = ('1','2')&quot;>&lt;CessazioneULL>&lt;ULL>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:dac)&quot;>&lt;DataDAC>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:dac), 9, 2),'/',substring(xsd:string($Start/tns1:dac), 6, 2),'/',substring(xsd:string($Start/tns1:dac), 1, 4))&quot;/>&lt;/DataDAC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DataDAC>&lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&lt;/DataDAC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DatiCliente>&lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;>&lt;CognomeRagSoc>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;/>&lt;/CognomeRagSoc>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;>&lt;Nome>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;/>&lt;/Nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:datiClienteFinale/tns1:cf)&quot;>&lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;/>&lt;/CF>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DatiCliente>&lt;Sede>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;>&lt;ParticellaToponomastica>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;/>&lt;/ParticellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo)&quot;>&lt;Via>&lt;xsl:value-of select=&quot;substring($Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo, 1, 70)&quot;/>&lt;/Via>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;>&lt;Civico>&lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;/>&lt;/Civico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:localita&