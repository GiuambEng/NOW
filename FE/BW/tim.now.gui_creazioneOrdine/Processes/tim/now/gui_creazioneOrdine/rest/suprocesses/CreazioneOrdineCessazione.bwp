                         &lt;/Radicale>&#xa;                                                            &lt;QuantitaLinee>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'QUANTITALINEE']/tns1:valore&quot;/>&#xa;                                                            &lt;/QuantitaLinee>&#xa;                                                        &lt;/GNR>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/POTS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ISDN>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'STRUTTURALINEA']/tns1:valore = 'BRA'&quot;>&#xa;                                                        &lt;BRA>&#xa;                                                            &lt;DNPrimario>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'DNPRIMARIO']/tns1:valore&quot;/>&#xa;                                                            &lt;/DNPrimario>&#xa;                                                        &lt;/BRA>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'STRUTTURALINEA']/tns1:valore = 'PBX'&quot;>&#xa;                                                        &lt;PBX>&#xa;                                                            &lt;Radicale>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'RADICALE']/tns1:valore&quot;/>&#xa;                                                            &lt;/Radicale>&#xa;                                                            &lt;QuantitaLinee>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'QUANTITALINEE']/tns1:valore&quot;/>&#xa;                                                            &lt;/QuantitaLinee>&#xa;                                                        &lt;/PBX>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;GNR>&#xa;                                                            &lt;Radicale>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'RADICALE']/tns1:valore&quot;/>&#xa;                                                            &lt;/Radicale>&#xa;                                                            &lt;QuantitaLinee>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'QUANTITALINEE']/tns1:valore&quot;/>&#xa;                                                            &lt;/QuantitaLinee>&#xa;                                                        &lt;/GNR>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/ISDN>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;DatiCliente>&#xa;                                        &lt;CognomeRagSoc>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;/>&#xa;                                        &lt;/CognomeRagSoc>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;>&#xa;                                            &lt;Nome>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;/>&#xa;                                            &lt;/Nome>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($Start/tns1:datiClienteFinale/tns1:cf)&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;>&#xa;                                                    &lt;CF>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;/>&#xa;                                                    &lt;/CF>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;>&#xa;                                                    &lt;PIVA>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;/>&#xa;                                                    &lt;/PIVA>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/DatiCliente>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:numeroBolletta&quot;>&#xa;                                        &lt;NumeroBolletta>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:numeroBolletta&quot;/>&#xa;                                        &lt;/NumeroBolletta>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:bimestreRiferimento&quot;>&#xa;                                        &lt;BimestreRiferimento>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:bimestreRiferimento&quot;/>&#xa;                                        &lt;/BimestreRiferimento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:tipoDocumento&quot;>&#xa;                                        &lt;TipoDocumento>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:tipoDocumento&quot;/>&#xa;                                        &lt;/TipoDocumento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:numeroDocumento&quot;>&#xa;                                        &lt;NumeroDocumento>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:numeroDocumento&quot;/>&#xa;                                        &lt;/NumeroDocumento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:autoritaEmittente&quot;>&#xa;                                        &lt;AutoritaEmittente>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:autoritaEmittente&quot;/>&#xa;                                        &lt;/AutoritaEmittente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns1:datiClienteFinale/tns1:dataEmissione)&quot;>&#xa;                                        &lt;DataEmissione>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataEmissione), 9, 2),'/',substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataEmissione), 6, 2),'/',substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataEmissione), 1, 4))&quot;/>&#xa;                                        &lt;/DataEmissione>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;Referente>&#xa;                                        &lt;CodiceReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:codiceReferente&quot;/>&#xa;                                        &lt;/CodiceReferente>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:nome&quot;>&#xa;                                            &lt;NomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:nome&quot;/>&#xa;                                            &lt;/NomeReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:cognome&quot;>&#xa;                                            &lt;CognomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:cognome&quot;/>&#xa;                                            &lt;/CognomeReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:indirizzo&quot;>&#xa;                                            &lt;IndirizzoReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:indirizzo&quot;/>&#xa;                                            &lt;/IndirizzoReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:telefonoFisso&quot;>&#xa;                                            &lt;TelefonoFissoReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:telefonoFisso&quot;/>&#xa;                                            &lt;/TelefonoFissoReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:fax&quot;>&#xa;                                            &lt;FaxReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:fax&quot;/>&#xa;                                            &lt;/FaxReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:email&quot;>&#xa;                                            &lt;EmailReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:email&quot;/>&#xa;                                            &lt;/EmailReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:cap&quot;>&#xa;                                            &lt;CapReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:cap&quot;/>&#xa;                                            &lt;/CapReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiReferenti[1]/tns1:codiceComuneReferente&quot;>&#xa;                                            &lt;CodiceComuneReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiReferenti[1]/tns1:codiceComuneReferente&quot;/>&#xa;                                            &lt;/CodiceComuneReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/Referente>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:codiceRipensamentoMaiRichiesto&quot;>&#xa;                                        &lt;CodeRipensamentoMaiRichiesto>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:codiceRipensamentoMaiRichiesto&quot;/>&#xa;                                        &lt;/CodeRipensamentoMaiRichiesto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns1:datiClienteFinale/tns1:dataSottoscrizioneNuovoContratto)&quot;>&#xa;                                        &lt;DataSottoscrizioneNuovoContratto>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataSottoscrizioneNuovoContratto), 9, 2),'/',substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataSottoscrizioneNuovoContratto), 6, 2),'/',substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataSottoscrizioneNuovoContratto), 1, 4))&quot;/>&#xa;                                        &lt;/DataSottoscrizioneNuovoContratto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;DataRichiestaCessazione>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataRichiestaCessazione), 9, 2),'/',substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataRichiestaCessazione), 6, 2),'/',substring(xsd:string($Start/tns1:datiClienteFinale/tns1:dataRichiestaCessazione), 1, 4))&quot;/>&#xa;                                    &lt;/DataRichiestaCessazione>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:codiceOloCessazione&quot;>&#xa;                                        &lt;CodiceOloCess>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:codiceOloCessazione&quot;/>&#xa;                                        &lt;/CodiceOloCess>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/CessazioneCPS>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;CessazioneWLRLineaNonAttiva>&#xa;                                    &lt;DN>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/DN>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns1:dataSottoscrizioneContratto)&quot;>&#xa;                                        &lt;DataSottoscrizioneContratto>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:dataSottoscrizioneContratto), 9, 2),'/',substring(xsd:string($Start/tns1:dataSottoscrizioneContratto), 6, 2),'/',substring(xsd:string($Start/tns1:dataSottoscrizioneContratto), 1, 4))&quot;/>&#xa;                                        &lt;/DataSottoscrizioneContratto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;DatiCliente>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;>&#xa;                                            &lt;CognomeRagSoc>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cognomeRagioneSociale&quot;/>&#xa;                                            &lt;/CognomeRagSoc>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;>&#xa;                                            &lt;Nome>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:nome&quot;/>&#xa;                                            &lt;/Nome>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($Start/tns1:datiClienteFinale/tns1:cf)&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;>&#xa;                                                    &lt;CF>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:cf&quot;/>&#xa;                                                    &lt;/CF>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;>&#xa;                                                    &lt;PIVA>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns1:datiClienteFinale/tns1:p_iva&quot;/>&#xa;                                                    &lt;/PIVA>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/DatiCliente>&#xa;                                    &lt;DatiSede>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;>&#xa;                                            &lt;ParticellaToponomastica>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;/>&#xa;                                            &lt;/ParticellaToponomastica>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;exists($Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo)&quot;>&#xa;                                            &lt;Via>&#xa;                                                &lt;xsl:value-of select=&quot;substring($Start/tns1:indirizzoDatiClienteFinale/tns1:indirizzo, 1, 70)&quot;/>&#xa;                                            &lt;/Via>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;>&#xa;                                            &lt;Civico>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;/>&#xa;                                            &lt;/Civico>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:localita&quot;>&#xa;                                            &lt;Localita>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:localita&quot;/>&#xa;                                            &lt;/Localita>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:cap&quot;>&#xa;                                            &lt;CAP>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:indirizzoDatiClienteFinale/tns1:cap&quot;/>&#xa;                                            &lt;/CAP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/DatiSede>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns1:datiReferenti[1]&quot;>&#xa;                                        &lt;Referente>&#xa;                                            &lt;Progressivo>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:progressivoReferente&quot;/>&#xa;                                            &lt;/Progressivo>&#xa;                                            &lt;QualificaRef>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:qualifica&quot;/>&#xa;                                            &lt;/QualificaRef>&#xa;                                            &lt;CognomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:cognome&quot;/>&#xa;                                            &lt;/CognomeReferente>&#xa;                                            &lt;xsl:if test=&quot;tns1:nome&quot;>&#xa;                                                &lt;NomeReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:nome&quot;/>&#xa;                                                &lt;/NomeReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns1:telefonoFisso&quot;>&#xa;                                                &lt;TelefonoFissoReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:telefonoFisso&quot;/>&#xa;                                                &lt;/TelefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns1:cellulare&quot;>&#xa;                                                &lt;TelefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:cellulare&quot;/>&#xa;                                                &lt;/TelefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns1:email&quot;>&#xa;                                                &lt;EmailReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:email&quot;/>&#xa;                                                &lt;/EmailReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/Referente>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Start/tns1:dac)&quot;>&#xa;                                            &lt;DataDAC>&#xa;                                                &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:dac), 9, 2),'/',substring(xsd:string($Start/tns1:dac), 6, 2),'/',substring(xsd:string($Start/tns1:dac), 1, 4))&quot;/>&#xa;                                            &lt;/DataDAC>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DataDAC>&#xa;                                                &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                                            &lt;/DataDAC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns1:recapitoTelefonicoCliente&quot;>&#xa;                                        &lt;RecapitoAlternativoCliente>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:recapitoTelefonicoCliente&quot;/>&#xa;                                        &lt;/RecapitoAlternativoCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/CessazioneWLRLineaNonAttiva>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/Cessazione>&#xa;                &lt;/Ordine>&#xa;            &lt;/Richiesta>&#xa;        &lt;/RichiestaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariabileRegolatorio" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;GetNomeOffCatalog&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&#xa;    &lt;xsl:param name=&quot;Sottolavorazione&quot;/>&#xa;    &lt;xsl:template name=&quot;VariabileCessazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RecuperoOloNumerico/Record/COD_OLO) and string-length($RecuperoOloNumerico/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = 'ULL'&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ULL&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:flagMonitoraggio = 'Y'&quot;>&#xa;                                &lt;flagMonitoraggio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/flagMonitoraggio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns1:flagMonitoraggio = 'N'&quot;>&#xa;                                &lt;flagMonitoraggio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/flagMonitoraggio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:flagMonitoraggio&quot;>&#xa;                                    &lt;flagMonitoraggio>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:flagMonitoraggio&quot;/>&#xa;                                    &lt;/flagMonitoraggio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;tipologiaLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLavorazione>&#xa;                        &lt;xsl:if test=&quot;string-length($Sottolavorazione)>0&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;'RIENTROINTI'&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;xsl:if test=&quot;string-length(xsd:string($Start/tns1:dataRicezioneRichiesta))>0&quot;>&#xa;                            &lt;dettaglioordine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                                    &lt;IDRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/IDRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOULL'&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'DATARICEZIONERICHIESTA'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:dataRicezioneRichiesta&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;string-length($Start/tns1:tipoRientro)>0&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of sele