-of select=&quot;'SI'&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns1:refOaoProgettiSpeciali)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:refOaoProgettiSpeciali&quot;>&#xa;                                    &lt;refOAOProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:refOaoProgettiSpeciali&quot;/>&#xa;                                    &lt;/refOAOProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;>&#xa;                            &lt;distretto>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;/>&#xa;                            &lt;/distretto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ordine>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDContratto>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoDistretto/Record[1]/IDCONTRATTO)&quot;/>&#xa;            &lt;/IDContratto>&#xa;            &lt;xsl:if test=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;string-length($DettaglioAsset.parameters/tns:id_offerta)>0&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($DettaglioAsset.parameters/tns:id_offerta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns3:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$DRO.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length(xsd:string($Start/tns1:dac)) =0&quot;>&#xa;                &lt;DACFile>&#xa;                    &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                &lt;/DACFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariabileCessazione" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VariabileServiziFWA"
                    name="TracciatoOLOFWA"
                    outputVariable="VariabileServiziFWA"
                    tibex:xpdlId="e36f0a80-fd0a-4d85-b4ac-5973c0f12a11" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToTracciatoOLOFWA"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOLOFWAToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;VariabileServiziFWA&quot; match=&quot;/&quot;>&#xa;        &lt;ns02:TracciatoOLOFWA>&#xa;            &lt;ns02:Richiesta>&#xa;                &lt;ns02:Testata>&#xa;                    &lt;ns02:CodiceOloAgcom>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                    &lt;/ns02:CodiceOloAgcom>&#xa;                    &lt;ns02:CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                    &lt;/ns02:CodiceOrdineOlo>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&#xa;                        &lt;ns02:Note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&#xa;                        &lt;/ns02:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns02:Testata>&#xa;                &lt;ns02:TipoRichiesta>&#xa;                    &lt;ns02:Cessazione>&#xa;                        &lt;ns02:FixedWirelessAccess>&#xa;                            &lt;ns02:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                            &lt;/ns02:IDENTIFICATIVO_RISORSA>&#xa;                        &lt;/ns02:FixedWirelessAccess>&#xa;                    &lt;/ns02:Cessazione>&#xa;                &lt;/ns02:TipoRichiesta>&#xa;            &lt;/ns02:Richiesta>&#xa;        &lt;/ns02:TracciatoOLOFWA>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariabileServiziFWA" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO&quot;/>&#xa;    &lt;xsl:param name=&quot;SedeFWA&quot;/>&#xa;    &lt;xsl:param name=&quot;ReferentiFWA&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&#xa;    &lt;xsl:template name=&quot;VariabileCessazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FWA&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperoOloNumerico/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;ordine>&#xa;                &lt;offertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FIXEDWIRELESSACCESS&amp;quot;&quot;/>&#xa;                &lt;/offertaCatalogo>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;xsl:for-each select=&quot;$SedeFWA/Record&quot;>&#xa;                    &lt;sede>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDSede>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(IDSEDE)&quot;/>&#xa;                        &lt;/IDSede>&#xa;                        &lt;xsl:if test=&quot;PARTICELLATOPONOMASTICA&quot;>&#xa;                            &lt;particellaToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;PARTICELLATOPONOMASTICA&quot;/>&#xa;                            &lt;/particellaToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;VIA&quot;>&#xa;                            &lt;via>&#xa;                                &lt;xsl:value-of select=&quot;VIA&quot;/>&#xa;                            &lt;/via>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICEVIA&quot;>&#xa;                            &lt;codiceVia>&#xa;                                &lt;xsl:value-of select=&quot;CODICEVIA&quot;/>&#xa;                            &lt;/codiceVia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CIVICO&quot;>&#xa;                            &lt;civico>&#xa;                                &lt;xsl:value-of select=&quot;CIVICO&quot;/>&#xa;                            &lt;/civico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;LOCALITA&quot;>&#xa;                            &lt;localita>&#xa;                                &lt;xsl:value-of select=&quot;LOCALITA&quot;/>&#xa;                            &lt;/localita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;COMUNE&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;COMUNE&quot;/>&#xa;                            &lt;/comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;PROVINCIA&quot;>&#xa;                            &lt;provincia>&#xa;                                &lt;xsl:value-of select=&quot;PROVINCIA&quot;/>&#xa;                            &lt;/provincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;COMPLESSO&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;COMPLESSO&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;INTERNO&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;INTERNO&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;SCALA&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;SCALA&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;PIANO&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;PIANO&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;INDIRIZZOESTESO&quot;>&#xa;                            &lt;indirizzoEsteso>&#xa;                                &lt;xsl:value-of select=&quot;INDIRIZZOESTESO&quot;/>&#xa;                            &lt;/indirizzoEsteso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICEISTATCOMUNE&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;CODICEISTATCOMUNE&quot;/>&#xa;                            &lt;/codiceISTATComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICEISTATPROVINCIA&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;CODICEISTATPROVINCIA&quot;/>&#xa;                            &lt;/codiceISTATProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICETOPONOMASTICA&quot;>&#xa;                            &lt;codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;CODICETOPONOMASTICA&quot;/>&#xa;                            &lt;/codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaSede>&#xa;                            &lt;xsl:value-of select=&quot;TIPOLOGIASEDE&quot;/>&#xa;                        &lt;/tipologiaSede>&#xa;                        &lt;xsl:if test=&quot;SIGLAPROVINCIA&quot;>&#xa;                            &lt;siglaProvincia>&#xa;                                &lt;xsl:value-of select=&quot;SIGLAPROVINCIA&quot;/>&#xa;                            &lt;/siglaProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICENUMEROCIVICO&quot;>&#xa;                            &lt;codiceNumeroCivico>&#xa;                                &lt;xsl:value-of select=&quot;CODICENUMEROCIVICO&quot;/>&#xa;                            &lt;/codiceNumeroCivico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;CODICECOMUNEINPUT&quot;>&#xa;                            &lt;CODICECOMUNEINPUT>&#xa;                                &lt;xsl:value-of select=&quot;CODICECOMUNEINPUT&quot;/>&#xa;                            &lt;/CODICECOMUNEINPUT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/sede>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:for-each select=&quot;$ReferentiFWA/Record&quot;>&#xa;                    &lt;referente>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;CREATED&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;LASTUPDATE&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;LASTUPDATE&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;progressivoReferente>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(PROGRESSIVOREFERENTE)&quot;/>&#xa;                        &lt;/progressivoReferente>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;TIPOREFERENTEORDINE&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;xsl:if test=&quot;QUALIFICAREFERENTE&quot;>&#xa;                            &lt;qualificaReferente>&#xa;                                &lt;xsl:value-of select=&quot;QUALIFICAREFERENTE&quot;/>&#xa;                            &lt;/qualificaReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;COGNOMEREFERENTE&quot;>&#xa;                            &lt;cognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;COGNOMEREFERENTE&quot;/>&#xa;                            &lt;/cognomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;NOMEREFERENTE&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;NOMEREFERENTE&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;TELEFONOFISSOREFERENTE&quot;>&#xa;                            &lt;telefonoFissoReferente>&#xa;                                &lt;xsl:value-of select=&quot;TELEFONOFISSOREFERENTE&quot;/>&#xa;                            &lt;/telefonoFissoReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;TELEFONOMOBILEREFERENTE&quot;>&#xa;                            &lt;telefonoMobileReferente>&#xa;                                &lt;xsl:value-of select=&quot;TELEFONOMOBILEREFERENTE&quot;/>&#xa;                            &lt;/telefonoMobileReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/referente>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAsset/parameters/tns:OutputAssetDetails/tns:tipoServizio&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;xsl:if test=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;>&#xa;                    &lt;distretto>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;/>&#xa;                    &lt;/distretto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ordine>&#xa;            &lt;IDContratto>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoDistretto/Record[1]/IDCONTRATTO)&quot;/>&#xa;            &lt;/IDContratto>&#xa;            &lt;xsl:if test=&quot;$DettaglioAsset/parameters/tns:OutputAssetDetails/tns:tipoServizio&quot;>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAsset/parameters/tns:OutputAssetDetails/tns:tipoServizio&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;string-length($DettaglioAsset/parameters/tns:OutputAssetDetails/tns:id_offerta)>0&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($DettaglioAsset/parameters/tns:OutputAssetDetails/tns:id_offerta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns3:Response/tns3:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns3:Response/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$DRO/parameters/tns3:Response/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length(xsd:string($Start/tns1:dac)) =0&quot;>&#xa;                &lt;DACFile>&#xa;                    &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                &lt;/DACFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VariabileCessazione"
                    name="CasedataBPMFWA"
                    outputVariable="VariabileCessazione"
                    tibex:xpdlId="eeb5c66b-3a67-45d2-b00d-ded7840db9b4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery1ToCasedataBPMFWA"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CasedataBPMFWAToInputCreateProcessBPM"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioAsset.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&#xa;    &lt;xsl:param name=&quot;SedeFWA&quot;/>&#xa;    &lt;xsl:param name=&quot;ReferentiFWA&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:template name=&quot;VariabileCessazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FWA&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperoOloNumerico/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;ordine>&#xa;                &lt;offertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FIXEDWIRELESSACCESS&amp;quot;&quot;/>&#xa;                &lt;/offertaCatalogo>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;xsl:for-each select=&quot;$SedeFWA/Record&quot;>&#xa;                    &lt;sede>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDSede>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(IDSEDE)&quot;/>&#xa;                        &lt;/IDSede>&#xa;                        &lt;xsl:if test=&quot;PARTICELLATOPONOMASTICA&quot;>&#xa;                            &lt;particellaToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;PARTICELLATOPONOMASTICA&quot;/>&#xa;                            &lt;/particellaToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;VIA&quot;>&#xa;                            &lt;via>&#xa;                                &lt;xsl:value-of select=&quot;VIA&quot;/>&#xa;                            &lt;/via>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICEVIA&quot;>&#xa;                            &lt;codiceVia>&#xa;                                &lt;xsl:value-of select=&quot;CODICEVIA&quot;/>&#xa;                            &lt;/codiceVia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CIVICO&quot;>&#xa;                            &lt;civico>&#xa;                                &lt;xsl:value-of select=&quot;CIVICO&quot;/>&#xa;                            &lt;/civico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;LOCALITA&quot;>&#xa;                            &lt;localita>&#xa;                                &lt;xsl:value-of select=&quot;LOCALITA&quot;/>&#xa;                            &lt;/localita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;COMUNE&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;COMUNE&quot;/>&#xa;                            &lt;/comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;PROVINCIA&quot;>&#xa;                            &lt;provincia>&#xa;                                &lt;xsl:value-of select=&quot;PROVINCIA&quot;/>&#xa;                            &lt;/provincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;COMPLESSO&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;COMPLESSO&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;INTERNO&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;INTERNO&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;SCALA&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;SCALA&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;PIANO&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;PIANO&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;INDIRIZZOESTESO&quot;>&#xa;                            &lt;indirizzoEsteso>&#xa;                                &lt;xsl:value-of select=&quot;INDIRIZZOESTESO&quot;/>&#xa;                            &lt;/indirizzoEsteso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICEISTATCOMUNE&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;CODICEISTATCOMUNE&quot;/>&#xa;                            &lt;/codiceISTATComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICEISTATPROVINCIA&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;CODICEISTATPROVINCIA&quot;/>&#xa;                            &lt;/codiceISTATProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICETOPONOMASTICA&quot;>&#xa;                            &lt;codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;CODICETOPONOMASTICA&quot;/>&#xa;                            &lt;/codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaSede>&#xa;                            &lt;xsl:value-of select=&quot;TIPOLOGIASEDE&quot;/>&#xa;                        &lt;/tipologiaSede>&#xa;                        &lt;xsl:if test=&quot;SIGLAPROVINCIA&quot;>&#xa;                            &lt;siglaProvincia>&#xa;                                &lt;xsl:value-of select=&quot;SIGLAPROVINCIA&quot;/>&#xa;                            &lt;/siglaProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODICENUMEROCIVICO&quot;>&#xa;                            &lt;codiceNumeroCivico>&#xa;                                &lt;xsl:value-of select=&quot;CODICENUMEROCIVICO&quot;/>&#xa;                            &lt;/codiceNumeroCivico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;CODICECOMUNEINPUT&quot;>&#xa;                            &lt;CODICECOMUNEINPUT>&#xa;                                &lt;xsl:value-of select=&quot;CODICECOMUNEINPUT&quot;/>&#xa;                            &lt;/CODICECOMUNEINPUT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/sede>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:for-each select=&quot;$ReferentiFWA/Record&quot;>&#xa;                    &lt;referente>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;CREATED&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;LASTUPDATE&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;LASTUPDATE&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;progressivoReferente>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(PROGRESSIVOREFERENTE)&quot;/>&#xa;                        &lt;/progressivoReferente>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;TIPOREFERENTEORDINE&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;xsl:if test=&quot;QUALIFICAREFERENTE&quot;>&#xa;                            &lt;qualificaReferente>&#xa;                                &lt;xsl:value-of select=&quot;QUALIFICAREFERENTE&quot;/>&#xa;                            &lt;/qualificaReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;COGNOMEREFERENTE&quot;>&#xa;                            &lt;cognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;COGNOMEREFERENTE&quot;/>&#xa;                            &lt;/cognomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;NOMEREFERENTE&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;NOMEREFERENTE&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;TELEFONOFISSOREFERENTE&quot;>&#xa;                            &lt;telefonoFissoReferente>&#xa;                                &lt;xsl:value-of select=&quot;TELEFONOFISSOREFERENTE&quot;/>&#xa;                            &lt;/telefonoFissoReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;TELEFONOMOBILEREFERENTE&quot;>&#xa;                            &lt;telefonoMobileReferente>&#xa;                                &lt;xsl:value-of select=&quot;TELEFONOMOBILEREFERENTE&quot;/>&#xa;                            &lt;/telefonoMobileReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/referente>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;xsl:if test=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;>&#xa;                    &lt;distretto>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;/>&#xa;                    &lt;/distretto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ordine>&#xa;            &lt;IDContratto>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoDistretto/Record[1]/IDCONTRATTO)&quot;/>&#xa;            &lt;/IDContratto>&#xa;            &lt;xsl:if test=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAsset.parameters/tns:tipoServizio&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;string-length($DettaglioAsset.parameters/tns:id_offerta)>0&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($DettaglioAsset.parameters/tns:id_offerta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns3:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$DRO.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length(xsd:string($Start/tns1:dac)) =0&quot;>&#xa;                &lt;DACFile>&#xa;                    &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                &lt;/DACFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
