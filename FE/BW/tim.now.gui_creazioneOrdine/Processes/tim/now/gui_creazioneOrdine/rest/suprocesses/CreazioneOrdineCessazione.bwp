            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VariabileServiziXDSL"
                    name="TracciatoOloXDSL"
                    outputVariable="VariabileServiziXDSL"
                    tibex:xpdlId="1c046231-cb0a-485f-a714-54c67f5e95a5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAssign1_ServiziXDSL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignServiziXDSLToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;GetNomeOffCatalog&quot;/>&#xa;    &lt;xsl:template name=&quot;VariabileServiziXDSL&quot; match=&quot;/&quot;>&#xa;        &lt;ns01:TracciatoOLOxDSL>&#xa;            &lt;ns01:Richiesta>&#xa;                &lt;ns01:Testata>&#xa;                    &lt;ns01:CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;                    &lt;/ns01:CodiceOlo>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                        &lt;ns01:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOlo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:codiceOrdinePadre&quot;>&#xa;                        &lt;ns01:CodiceOrdineOloPadre>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdinePadre&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOloPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:codiceProgetto&quot;>&#xa;                        &lt;ns01:CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:codiceProgetto&quot;/>&#xa;                        &lt;/ns01:CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:noteDaOperatore&quot;>&#xa;                        &lt;ns01:Note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:noteDaOperatore&quot;/>&#xa;                        &lt;/ns01:Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:refOaoProgettiSpeciali&quot;>&#xa;                        &lt;ns01:ReferentiOAOProgettiSpeciali>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:refOaoProgettiSpeciali&quot;/>&#xa;                        &lt;/ns01:ReferentiOAOProgettiSpeciali>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns01:Testata>&#xa;                &lt;ns01:TipoRichiesta>&#xa;                    &lt;ns01:Cessazione>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'BitstreamATMAsimmetricoFlat'&quot;>&#xa;                                &lt;ns01:BitstreamATMAsimmetricoFlat>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/ns01:BitstreamATMAsimmetricoFlat>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'BitstreamATMSimmetricoFlat'&quot;>&#xa;                                &lt;ns01:BitstreamATMSimmetricoFlat>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns1:datiReferenti&quot;>&#xa;                                        &lt;ns01:Referente>&#xa;                                            &lt;ns01:Progressivo>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:progressivoReferente&quot;/>&#xa;                                            &lt;/ns01:Progressivo>&#xa;                                            &lt;ns01:Qualifica>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:qualifica&quot;/>&#xa;                                            &lt;/ns01:Qualifica>&#xa;                                            &lt;ns01:Nome>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:nome&quot;/>&#xa;                                            &lt;/ns01:Nome>&#xa;                                            &lt;ns01:Cognome>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:cognome&quot;/>&#xa;                                            &lt;/ns01:Cognome>&#xa;                                            &lt;xsl:if test=&quot;tns1:telefonoFisso&quot;>&#xa;                                                &lt;ns01:Telefono>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:telefonoFisso&quot;/>&#xa;                                                &lt;/ns01:Telefono>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns1:cellulare&quot;>&#xa;                                                &lt;ns01:Mobile>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:cellulare&quot;/>&#xa;                                                &lt;/ns01:Mobile>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns1:email&quot;>&#xa;                                                &lt;ns01:Email>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:email&quot;/>&#xa;                                                &lt;/ns01:Email>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns01:Referente>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns01:BitstreamATMSimmetricoFlat>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'BitstreamATMAsimmetricoHL'&quot;>&#xa;                                &lt;ns01:BitstreamATMAsimmetricoHL>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/ns01:BitstreamATMAsimmetricoHL>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'BitstreamATMSimmetricoHL'&quot;>&#xa;                                &lt;ns01:BitstreamATMSimmetricoHL>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns1:datiReferenti&quot;>&#xa;                                        &lt;ns01:Referente>&#xa;                                            &lt;ns01:Progressivo>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:progressivoReferente&quot;/>&#xa;                                            &lt;/ns01:Progressivo>&#xa;                                            &lt;ns01:Qualifica>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:qualifica&quot;/>&#xa;                                            &lt;/ns01:Qualifica>&#xa;                                            &lt;ns01:Nome>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:nome&quot;/>&#xa;                                            &lt;/ns01:Nome>&#xa;                                            &lt;ns01:Cognome>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:cognome&quot;/>&#xa;                                            &lt;/ns01:Cognome>&#xa;                                            &lt;xsl:if test=&quot;tns1:telefonoFisso&quot;>&#xa;                                                &lt;ns01:Telefono>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:telefonoFisso&quot;/>&#xa;                                                &lt;/ns01:Telefono>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns1:cellulare&quot;>&#xa;                                                &lt;ns01:Mobile>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:cellulare&quot;/>&#xa;                                                &lt;/ns01:Mobile>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns1:email&quot;>&#xa;                                                &lt;ns01:Email>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:email&quot;/>&#xa;                                                &lt;/ns01:Email>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns01:Referente>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns01:BitstreamATMSimmetricoHL>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'BitstreamATMAsimmetricoLite'&quot;>&#xa;                                &lt;ns01:BitstreamATMAsimmetricoLite>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/ns01:BitstreamATMAsimmetricoLite>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'BitstreamGBEAsimmetricoFlat'&quot;>&#xa;                                &lt;ns01:BitstreamGBEAsimmetricoFlat>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/ns01:BitstreamGBEAsimmetricoFlat>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'BitstreamGBESimmetricoFlat'&quot;>&#xa;                                &lt;ns01:BitstreamGBESimmetricoFlat>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns1:datiReferenti&quot;>&#xa;                                        &lt;ns01:Referente>&#xa;                                            &lt;ns01:Progressivo>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:progressivoReferente&quot;/>&#xa;                                            &lt;/ns01:Progressivo>&#xa;                                            &lt;ns01:Qualifica>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:qualifica&quot;/>&#xa;                                            &lt;/ns01:Qualifica>&#xa;                                            &lt;ns01:Nome>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:nome&quot;/>&#xa;                                            &lt;/ns01:Nome>&#xa;                                            &lt;ns01:Cognome>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:cognome&quot;/>&#xa;                                            &lt;/ns01:Cognome>&#xa;                                            &lt;xsl:if test=&quot;tns1:telefonoFisso&quot;>&#xa;                                                &lt;ns01:Telefono>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:telefonoFisso&quot;/>&#xa;                                                &lt;/ns01:Telefono>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns1:cellulare&quot;>&#xa;                                                &lt;ns01:Mobile>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:cellulare&quot;/>&#xa;                                                &lt;/ns01:Mobile>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns1:email&quot;>&#xa;                                                &lt;ns01:Email>&#xa;                                                    &lt;xsl:value-of select=&quot;tns1:email&quot;/>&#xa;                                                &lt;/ns01:Email>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns01:Referente>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns01:BitstreamGBESimmetricoFlat>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'EasyIPBasePlusFlat'&quot;>&#xa;                                &lt;ns01:EasyIPBasePlusFlat>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/ns01:EasyIPBasePlusFlat>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'EasyIPBasePlusLite'&quot;>&#xa;                                &lt;ns01:EasyIPBasePlusLite>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/ns01:EasyIPBasePlusLite>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'EasyIPSpecialProfileFlat'&quot;>&#xa;                                &lt;ns01:EasyIPSpecialProfileFlat>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/ns01:EasyIPSpecialProfileFlat>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG= 'VLAN'&quot;>&#xa;                                &lt;ns01:VLAN>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns1:codiceOrdineTIVlan)>0&quot;>&#xa;                                            &lt;ns01:TI>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdineTIVlan&quot;/>&#xa;                                            &lt;/ns01:TI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;ns01:ISP>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdineOloVlan&quot;/>&#xa;                                            &lt;/ns01:ISP>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/ns01:VLAN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns01:EasyIPSpecialProfileLite>&#xa;                                    &lt;ns01:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/ns01:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/ns01:EasyIPSpecialProfileLite>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns01:Cessazione>&#xa;                &lt;/ns01:TipoRichiesta>&#xa;            &lt;/ns01:Richiesta>&#xa;        &lt;/ns01:TracciatoOLOxDSL>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariabileServiziXDSL" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetNomeOffCatalog&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&#xa;    &lt;xsl:template name=&quot;VariabileCessazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:idRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperoOloNumerico/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdine&quot;/>&#xa;                &lt;/codi