                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select r.idrichiestaolo, r.created, r.lastupdate, r.operatore, r.progressivoreferente,&#xa;r.tiporeferenteordine, r.qualificareferente, r.cognomereferente, r.nomereferente,&#xa;r.telefonofissoreferente,r.telefonomobilereferente,r.emailreferente&#xa;from bds_1_casedata_asset a inner join &#xa;bds_1_casedata_referente r on r.idrichiestaolo=a.idrichiestaolo&#xa;where a.idAsset=?" xsi:type="jdbcPalette:JDBCQueryActivity">
