                    inputVariable="InputCreateProcessBPM-input"
                    name="InputCreateProcessBPM"
                    tibex:xpdlId="c9d632dc-7ce3-4326-a7de-db8eecffaac4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
