;>&#xa;                                                    &lt;TelefonoFissoReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;tns1:telefonoFisso&quot;/>&#xa;                                                    &lt;/TelefonoFissoReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;tns1:cellulare&quot;>&#xa;                                                    &lt;TelefonoMobileReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;tns1:cellulare&quot;/>&#xa;                                                    &lt;/TelefonoMobileReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;tns1:email&quot;>&#xa;                                                    &lt;EmailReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;tns1:email&quot;/>&#xa;                                                    &lt;/EmailReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/Referente>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;IDRisorsa>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                        &lt;/IDRisorsa>&#xa;                                        &lt;xsl:if test=&quot;upper-case($Start/tns1:flagRientro)='Y'&quot;>&#xa;                                            &lt;Rientro>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;exists($Start/tns1:dataRicezioneRichiesta)&quot;>&#xa;                                                        &lt;DataRicezioneRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns1:dataRicezioneRichiesta), 9, 2),'/',substring(xsd:string($Start/tns1:dataRicezioneRichiesta), 6, 2),'/',substring(xsd:string($Start/tns1:dataRicezioneRichiesta), 1, 4))&quot;/>&#xa;                                                        &lt;/DataRicezioneRichiesta>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;DataRicezioneRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                                                        &lt;/DataRicezioneRichiesta>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;xsl:if test=&quot;upper-case($Start/tns1:flagRientroVeloce)='Y'&quot;>&#xa;                                                    &lt;RientroVeloce>&#xa;                                                        &lt;TipoRientro>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns1:tipoRientro&quot;/>&#xa;                                                        &lt;/TipoRientro>&#xa;                                                    &lt;/RientroVeloce>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/Rientro>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/SLU-NP>&#xa;                                &lt;/CessazioneSLU>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GetNomeOffCatalog/Record[1]/NOME_OFFERTA_CATLG = 'CPS' and $DettaglioAsset.parameters/tns:id_offerta = '47'&quot;>&#xa;                                &lt;CessazioneCPS>&#xa;                                    &lt;DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/DataOrdine>&#xa;                                    &lt;OpzioneTraffico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'OPZIONETRAFFICO']/tns1:valore&quot;/>&#xa;                                    &lt;/OpzioneTraffico>&#xa;                                    &lt;DataSottoscrizioneContratto>&#xa;                                        &lt;xsl:value-of select=&quot;format-date(xsd:date($Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'DSC']/tns1:valore), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/DataSottoscrizioneContratto>&#xa;                                    &lt;DN>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:idRisorsa&quot;/>&#xa;                                    &lt;/DN>&#xa;                                    &lt;CodeCarrierOlo>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'CODICECARRIEROLO']/tns1:valore&quot;/>&#xa;                                    &lt;/CodeCarrierOlo>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns1:attributiOfferta/tns1:sezioneSuperiore[tns1:key = 'TIPOLINEA']/tns1:valore = 'POTS'&quot;>&#xa;                                            &lt;POTS>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test