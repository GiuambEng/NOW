       &lt;/ns03:TI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns03:ISP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:codiceOrdineOloVlan&quot;/>&#xa;                                    &lt;/ns03:ISP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns03:VP>&#xa;                        &lt;ns03:DRC>&#xa;                            &lt;xsl:value-of select=&quot;xsd:dateTime($Start/tns1:drc)&quot;/>&#xa;                        &lt;/ns03:DRC>&#xa;                    &lt;/ns03:Cessazione>&#xa;                &lt;/ns03:TipoRichiesta>&#xa;            &lt;/ns03:Richiesta>&#xa;        &lt;/ns03:TracciatoOLOVP>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
