                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PARTICELLATOPONOMASTICA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnName="VIA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
