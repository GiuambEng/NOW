                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select s.idrichiestaolo, s.idsede, s.particellatoponomastica, s.via, s.codicevia,&#xa;s.civico, s.localita, s.comune, s.provincia, s.cap, s.complesso, s.interno, s.scala, s.piano,&#xa;s.indirizzoesteso, s.codiceistatcomune, s.codiceistatprovincia, s.codicetoponomastica,&#xa;s.tipologiasede, s.siglaprovincia, s.codicenumerocivico, s.operatore, s.codicecomuneinput&#xa;from bds_1_casedata_asset a inner join &#xa;bds_1_casedata_sede s on s.idrichiestaolo=a.idrichiestaolo&#xa;where a.idAsset=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
