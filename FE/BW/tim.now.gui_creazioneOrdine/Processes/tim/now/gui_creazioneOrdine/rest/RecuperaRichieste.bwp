&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20171002130858PLT" xmlns:tns4="http://www.tim.com/NOW/rest/recuperaRichiestePerLavorazione" xmlns:tns1="http://xmlns.example.com/RecuperaRichieste/parameters" version="2.0"&gt;&lt;xsl:param name="RecuperoRichieste"/&gt;&lt;xsl:param name="get"/&gt;&lt;xsl:param name="FlagOscuramento"/&gt;&lt;xsl:param name="RecuperoRichiesteOF"/&gt;&lt;xsl:template name="getOut-input" match="/"&gt;&lt;tns3:getResponse&gt;&lt;item&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RecuperoRichieste/Record)"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="(upper-case($get/parameters/tns1:recuperarichiesteGetParameters/tns1:lavorazione) = 'ATTIVAZIONE' and $get/parameters/tns1:recuperarichiesteGetParameters/tns1:idOfferta = ('1','2','3','4','5','6','21','22','23','24','25','26','27','28','29') and $get/parameters/tns1:recuperarichiesteGetParameters/tns1:statoNow = 'SOSPESO OPERE SPECIALI') or ($FlagOscuramento/Record[1]/FLAG_OSCURMENTO = '1' and $get/parameters/tns1:recuperarichiesteGetParameters/tns1:statoNow = 'SOSPESO OPERE SPECIALI')"&gt;&lt;tns4:outputRecuperaRichieste&gt;&lt;xsl:for-each select="$RecuperoRichieste/Record[RICHIESTA !='ANNULLAMENTO']"&gt;&lt;tns4:outputRichieste&gt;&lt;xsl:if test="RICHIESTA"&gt;&lt;tns4:richiesta&gt;&lt;xsl:value-of select="RICHIESTA"/&gt;&lt;/tns4:richiesta&gt;&lt;/xsl:if&gt;&lt;xsl:if test="LABEL_RICHIESTA"&gt;&lt;tns4:richiestaLabel&gt;&lt;xsl:value-of select="LABEL_RICHIESTA"/&gt;&lt;/tns4:richiestaLabel&gt;&lt;/xsl:if&gt;&lt;/tns4:outputRichieste&gt;&lt;/xsl:for-each&gt;&lt;tns4:result&gt;&lt;tns4:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns4:severity&gt;&lt;tns4:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns4:code&gt;&lt;/tns4:result&gt;&lt;/tns4:outputRecuperaRichieste&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:outputRecuperaRichieste&gt;&lt;xsl:for-each select="$RecuperoRichieste/Record"&gt;&lt;tns4:outputRichieste&gt;&lt;xsl:if test="RICHIESTA"&gt;&lt;tns4:richiesta&gt;&lt;xsl:value-of select="RICHIESTA"/&gt;&lt;/tns4:richiesta&gt;&lt;/xsl:if&gt;&lt;xsl:if test="LABEL_RICHIESTA"&gt;&lt;tns4:richiestaLabel&gt;&lt;xsl:value-of select="LABEL_RICHIESTA"/&gt;&lt;/tns4:richiestaLabel&gt;&lt;/xsl:if&gt;&lt;/tns4:outputRichieste&gt;&lt;/xsl:for-each&gt;&lt;tns4:result&gt;&lt;tns4:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns4:severity&gt;&lt;tns4:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns4:code&gt;&lt;/tns4:result&gt;&lt;/tns4:outputRecuperaRichieste&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($RecuperoRichiesteOF/Record)"&gt;&lt;tns4:outputRecuperaRichieste&gt;&lt;xsl:for-each select="$RecuperoRichiesteOF/Record"&gt;&lt;tns4:outputRichieste&gt;&lt;tns4:richiesta&gt;&lt;xsl:value-of select="RICHIESTA"/&gt;&lt;/tns4:richiesta&gt;&lt;tns4:richiestaLabel&gt;&lt;xsl:value-of select="LABEL_RICHIESTA"/&gt;&lt;/tns4:richiestaLabel&gt;&lt;/tns4:outputRichieste&gt;&lt;/xsl:for-each&gt;&lt;tns4:result&gt;&lt;tns4:severity&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/tns4:severity&gt;&lt;tns4:code&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/tns4:code&gt;&lt;/tns4:result&gt;&lt;/tns4:outputRecuperaRichieste&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:outputRecuperaRichieste&gt;&lt;tns4:result&gt;&lt;tns4:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns4:severity&gt;&lt;tns4:code&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns4:code&gt;&lt;tns4:details&gt;&lt;xsl:value-of select="&amp;quot;Nessuna richiesta possibile&amp;quot;"/&gt;&lt;/tns4:details&gt;&lt;/tns4:result&gt;&lt;/tns4:outputRecuperaRichieste&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/item&gt;&lt;/tns3:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://xmlns.example.com/20171002130858PLT&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/recuperaRichiestePerLavorazione&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperaRichieste/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoRichieste&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoRichiesteOF&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($RecuperoRichieste/Record)&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;(upper-case($get.parameters/tns1:lavorazione) = 'ATTIVAZIONE' and $get.parameters/tns1:idOfferta = ('1','2','3','4','5','6','21','22','23','24','25','26','27','28','29') and $get.parameters/tns1:statoNow = 'SOSPESO OPERE SPECIALI') or ($FlagOscuramento/Record[1]/FLAG_OSCURMENTO = '1' and $get.parameters/tns1:statoNow = 'SOSPESO OPERE SPECIALI')&quot;>&#xa;                        &lt;tns4:outputRecuperaRichieste>&#xa;                            &lt;xsl:for-each select=&quot;$RecuperoRichieste/Record[RICHIESTA !='ANNULLAMENTO']&quot;>&#xa;                                &lt;tns4:outputRichieste>&#xa;                                    &lt;xsl:if test=&quot;RICHIESTA&quot;>&#xa;                                        &lt;tns4:richiesta>&#xa;                                            &lt;xsl:value-of select=&quot;RICHIESTA&quot;/>&#xa;                                        &lt;/tns4:richiesta>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;LABEL_RICHIESTA&quot;>&#xa;                                        &lt;tns4:richiestaLabel>&#xa;                                            &lt;xsl:value-of select=&quot;LABEL_RICHIESTA&quot;/>&#xa;                                        &lt;/tns4:richiestaLabel>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns4:outputRichieste>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns4:result>&#xa;                                &lt;tns4:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns4:severity>&#xa;                                &lt;tns4:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns4:code>&#xa;                            &lt;/tns4:result>&#xa;                        &lt;/tns4:outputRecuperaRichieste>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:outputRecuperaRichieste>&#xa;                            &lt;xsl:for-each select=&quot;$RecuperoRichieste/Record&quot;>&#xa;                                &lt;tns4:outputRichieste>&#xa;                                    &lt;xsl:if test=&quot;RICHIESTA&quot;>&#xa;                                        &lt;tns4:richiesta>&#xa;                                            &lt;xsl:value-of select=&quot;RICHIESTA&quot;/>&#xa;                                        &lt;/tns4:richiesta>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;LABEL_RICHIESTA&quot;>&#xa;                                        &lt;tns4:richiestaLabel>&#xa;                                            &lt;xsl:value-of select=&quot;LABEL_RICHIESTA&quot;/>&#xa;                                        &lt;/tns4:richiestaLabel>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns4:outputRichieste>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns4:result>&#xa;                                &lt;tns4:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns4:severity>&#xa;                                &lt;tns4:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns4:code>&#xa;                            &lt;/tns4:result>&#xa;                        &lt;/tns4:outputRecuperaRichieste>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($RecuperoRichiesteOF/Record)&quot;>&#xa;                &lt;tns4:outputRecuperaRichieste>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoRichiesteOF/Record&quot;>&#xa;                        &lt;tns4:outputRichieste>&#xa;                            &lt;tns4:richiesta>&#xa;                                &lt;xsl:value-of select=&quot;RICHIESTA&quot;/>&#xa;                            &lt;/tns4:richiesta>&#xa;                            &lt;tns4:richiestaLabel>&#xa;                                &lt;xsl:value-of select=&quot;LABEL_RICHIESTA&quot;/>&#xa;                            &lt;/tns4:richiestaLabel>&#xa;                        &lt;/tns4:outputRichieste>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns4:result>&#xa;                        &lt;tns4:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns4:severity>&#xa;                        &lt;tns4:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns4:code>&#xa;                    &lt;/tns4:result>&#xa;                &lt;/tns4:outputRecuperaRichieste>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:outputRecuperaRichieste>&#xa;                    &lt;tns4:result>&#xa;                        &lt;tns4:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:severity>&#xa;                        &lt;tns4:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:code>&#xa;                        &lt;tns4:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessuna richiesta possibile&amp;quot;&quot;/>&#xa;                        &lt;/tns4:details>&#xa;                    &lt;/tns4:result>&#xa;                &lt;/tns4:outputRecuperaRichieste>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
