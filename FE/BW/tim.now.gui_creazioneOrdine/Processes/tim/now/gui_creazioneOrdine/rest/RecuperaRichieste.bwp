                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20171002130858PLT" xmlns:tns4="http://www.tim.com/NOW/rest/recuperaRichiestePerLavorazione" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="RecupRichiesteError-input" match="/"&gt;
        &lt;tns3:getResponse&gt;
            &lt;item&gt;
                &lt;tns4:outputRecuperaRichieste&gt;
                    &lt;tns4:result&gt;
                        &lt;tns4:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;Error&amp;quot;"/&gt;
