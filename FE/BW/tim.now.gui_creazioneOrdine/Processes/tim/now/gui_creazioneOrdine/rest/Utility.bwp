                            <bpws:empty name="Empty1" tibex:xpdlId="98921064-1dce-4902-a08e-e6505ab15b5b">
                                <bpws:targets>
                                    <bpws:target linkName="OloInvoke2ToEmpty1_FLAGN"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty1ToIdslucoInvoke2_ACCORPATO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$OloInvoke2/output/tns4:isOloAccorpanteOutput/tns4:codOloAccorpante != ''" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
