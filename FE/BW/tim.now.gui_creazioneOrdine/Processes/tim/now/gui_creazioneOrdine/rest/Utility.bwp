                      &lt;tns9:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Utility_&amp;quot;,$get3.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns9:EventType>&#xa;                        &lt;tns9:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Utility_&amp;quot;,$get3.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns9:trackID>&#xa;                    &lt;/tns9:Identifier>&#xa;                    &lt;tns9:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns9:track_position>&#xa;                    &lt;tns9:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns9:Timestamp>&#xa;                    &lt;tns9:ErrorLog>&#xa;                        &lt;tns9:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns9:TimeStamp>&#xa;                    &lt;/tns9:ErrorLog>&#xa;                &lt;/tns9:Envelope>&#xa;            &lt;/tns9:ActiveLoggerServices>&#xa;        &lt;/tns9:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
