ntType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Utility_&amp;quot;,$get3.httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns10:EventType>&#xa;                        &lt;tns10:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Utility_&amp;quot;,$get3.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns10:trackID>&#xa;                    &lt;/tns10:Identifier>&#xa;                    &lt;tns10:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns10:track_position>&#xa;                    &lt;tns10:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns10:Timestamp>&#xa;                &lt;/tns10:Envelope>&#xa;            &lt;/tns10:ActiveLoggerServices>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
