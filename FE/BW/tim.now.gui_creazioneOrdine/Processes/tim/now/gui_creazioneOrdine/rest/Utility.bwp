                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/cmf/visualizzaIDULLCO&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/cliente&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OloInvoke&quot;/>&lt;xsl:param name=&quot;IdullcoInvoke_Accorpato&quot;/>&lt;xsl:param name=&quot;IdullcoInvoke_Accorpante&quot;/>&lt;xsl:param name=&quot;IdullcoInvoke_CodNonUnivoco&quot;/>&lt;xsl:param name=&quot;ISColocato&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$OloInvoke/output/tns2:isOloAccorpanteOutput/tns2:flagAccorpante='Y' or count($ISColocato/Record)>0&quot;>&lt;ns:ResponseIDULLCOolo>&lt;xsl:if test=&quot;count($IdullcoInvoke_Accorpante/output/ns:ResponseIDULLCOolo/ns:visulizzaIDULLCO) > 0&quot;>&lt;xsl:copy-of select=&quot;$IdullcoInvoke_Accorpante/output/ns:ResponseIDULLCOolo/ns:visulizzaIDULLCO&quot;/>&lt;/xsl:if>&lt;ns:result>&lt;ns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/ns:severity>&lt;ns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:code>&lt;/ns:result>&lt;/ns:ResponseIDULLCOolo>&lt;/xsl:when>&lt;xsl:when test=&quot;count($IdullcoInvoke_Accorpato/output/ns:ResponseIDULLCOolo/ns:visulizzaIDULLCO) = 0 and count($IdullcoInvoke_Accorpante/output/ns:ResponseIDULLCOolo/ns:visulizzaIDULLCO) = 0 and count($IdullcoInvoke_CodNonUnivoco/output/ns:ResponseIDULLCOolo/ns:visulizzaIDULLCO) = 0&quot;>&lt;ns:ResponseIDULLCOolo>&lt;ns:result>&lt;ns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/ns:severity>&lt;ns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:code>&lt;ns:details>&lt;xsl:value-of select=&quot;'NO RECORD'&quot;/>&lt;/ns:details>&lt;/ns:result>&lt;/ns:ResponseIDULLCOolo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$OloInvoke/output/tns2:isOloAccorpanteOutput/tns2:codOloAccorpante !=''&quot;>&lt;ns:ResponseIDULLCOolo>&lt;xsl:copy-of select=&quot;$IdullcoInvoke_Accorpato/output/ns:ResponseIDULLCOolo/ns:visulizzaIDULLCO&quot;/>&lt;ns:result>&lt;ns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/ns:severity>&lt;ns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:code>&lt;/ns:result>&lt;/ns:ResponseIDULLCOolo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ResponseIDULLCOolo>&lt;xsl:copy-of select=&quot;$IdullcoInvoke_CodNonUnivoco/output/ns:ResponseIDULLCOolo/ns:visulizzaIDULLCO&quot;/>&lt;ns:result>&lt;ns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/ns:severity>&lt;ns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:code>&lt;/ns:result>&lt;/ns:ResponseIDULLCOolo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
