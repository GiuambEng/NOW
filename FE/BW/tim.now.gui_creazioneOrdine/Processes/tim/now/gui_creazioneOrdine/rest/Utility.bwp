                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns3=&quot;http://xmlns.example.com/20160418153620PLT/ConceptSchema&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d0c1ad59-a1b6-483c-9f2f-e4db4095ddd5+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DRO&quot;/>&#xa;    &lt;xsl:param name=&quot;get8&quot;/>&#xa;    &lt;xsl:template name=&quot;CodPrgtAccorp-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:jdbcQueryActivityInput>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;format-date($DRO/parameters/tns9:Response/tns9:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get8/parameters/tns3:nuovordine-CodiceProgettoGetParameters/codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get8/parameters/tns3:nuovordine-CodiceProgettoGetParameters/codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get8/parameters/tns3:nuovordine-CodiceProgettoGetParameters/codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get8/parameters/tns3:nuovordine-CodiceProgettoGetParameters/codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns10:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CodPrgt-input"
                                    name="CodPrgt"
                                    outputVariable="CodPrgt"
                                    tibex:xpdlId="d0c1ad59-a1b6-483c-9f2f-e4db4095ddd5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DROToCodPrgtAccorp"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CodPrgtToCodProgettoAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns3=&quot;http://xmlns.example.com/20160418153620PLT/ConceptSchema&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d0c1ad59-a1b6-483c-9f2f-e4db4095ddd5+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get8.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;CodPrgtAccorp-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:jdbcQueryActivityInput>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;format-date($DRO.parameters/tns9:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get8.parameters/codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get8.parameters/codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get8.parameters/codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get8.parameters/codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns10:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT P.COD_PRGT,P.CODFC_OLO_AGCOM,P.DATAFI_VALID,P.DATAINZ_VALID,P.FLAG_FITTIZIO,P.ID_PRGT,P.REPORT, P.ONESTEP, P.PRODOTTI_A_CATALOGO &#xd;&#xa;FROM PRGT P &#xd;&#xa;LEFT JOIN OLO O ON P.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM &#xd;&#xa;WHERE P.DATAFI_VALID > to_Date(?,'DD/MM/YY')&#xd;&#xa;AND O.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM OLO&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE (COD_OLO = (SELECT COD_OLO&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM OLO&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE CODFC_OLO_AGCOM = ?)) &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM OLO&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE COD_OLO = (SELECT COD_OLO&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM OLO&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE CODFC_OLO_AGCOM = ?)))&#xd;&#xa;ORDER BY P.COD_PRGT" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom2"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="COD_PRGT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="DATAFI_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="4"
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="5"
                                    columnName="FLAG_FITTIZIO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="6"
                                    columnName="ID_PRGT"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata
