ame>&#xa;                &lt;tns9:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns9:LogLevel>&#xa;                &lt;tns9:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns9:LogJMS>&#xa;            &lt;/tns9:GenericLogger>&#xa;            &lt;tns9:ActiveLoggerServices>&#xa;                &lt;tns9:Envelope>&#xa;                    &lt;tns9:Identifier>&#xa;                        &lt;tns9:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.rest.Utility&amp;quot;&quot;/>&#xa;                        &lt;/tns9:ServiceName>&#xa;                        &lt;tns9:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Operation>&#xa;                        &lt;tns9:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Source>&#xa;                        &lt;xsl:if test=&quot;$get8.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns9:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get8.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns9:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns9:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get8.httpHeaders/GUI-SID,$get8.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns9:EventID>&#xa;                        &lt;xsl:if test=&quot;$get8.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns9:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get8.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns9:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                   