                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/codiceProgetto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodPrgtDaVull&quot;/>&lt;xsl:param name=&quot;CodPrgt&quot;/>&lt;xsl:template name=&quot;VariableOutputCodProgetto&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CodPrgt/Record/COD_PRGT) and string-length($CodPrgt/Record[1]/COD_PRGT)>0&quot;>&lt;tns:CodProgettoOutput>&lt;xsl:for-each select=&quot;$CodPrgt/Record&quot;>&lt;tns:codiciProgetto>&lt;tns:cod_prgt>&lt;xsl:value-of select=&quot;COD_PRGT&quot;/>&lt;/tns:cod_prgt>&lt;tns:codfc_olo_agcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codfc_olo_agcom>&lt;tns:datafi_valid>&lt;xsl:value-of select=&quot;DATAFI_VALID&quot;/>&lt;/tns:datafi_valid>&lt;tns:datainz_valid>&lt;xsl:value-of select=&quot;DATAINZ_VALID&quot;/>&lt;/tns:datainz_valid>&lt;tns:flag_fittizio>&lt;xsl:value-of select=&quot;FLAG_FITTIZIO&quot;/>&lt;/tns:flag_fittizio>&lt;tns:id_prgt>&lt;xsl:value-of select=&quot;ID_PRGT&quot;/>&lt;/tns:id_prgt>&lt;tns:report>&lt;xsl:value-of select=&quot;REPORT&quot;/>&lt;/tns:report>&lt;tns:flagVull>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagVull>&lt;tns:oneStep>&lt;xsl:value-of select=&quot;ONESTEP&quot;/>&lt;/tns:oneStep>&lt;xsl:if test=&quot;PRODOTTI_A_CATALOGO&quot;>&lt;tns:prodottiACatalogo>&lt;xsl:value-of select=&quot;PRODOTTI_A_CATALOGO&quot;/>&lt;/tns:prodottiACatalogo>&lt;/xsl:if>&lt;/tns:codiciProgetto>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$CodPrgtDaVull/Record&quot;>&lt;tns:codiciProgetto>&lt;tns:cod_prgt>&lt;xsl:value-of select=&quot;COD_PRGT&quot;/>&lt;/tns:cod_prgt>&lt;tns:codfc_olo_agcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codfc_olo_agcom>&lt;tns:flagVull>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagVull>&lt;/tns:codiciProgetto>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:CodProgettoOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodProgettoOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono record&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:CodProgettoOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
