                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://www.tim.com/NOW/wsdl/abstract/VisualizzaIDSLUCO/" xmlns:tns8="http://www.tim.com/NOW/cmf/visualizzaIDSLUCO" xmlns:tns2="http://www.tim.com/NOW/cmf/cliente" xmlns:tns3="http://xmlns.example.com/20160418153620PLT/ConceptSchema" version="2.0"&gt;&lt;xsl:param name="ListaOlInvoke"/&gt;&lt;xsl:param name="get3"/&gt;&lt;xsl:param name="Oscurato"/&gt;&lt;xsl:param name="IsColocato"/&gt;&lt;xsl:template name="IdslucoInvoke_Accorpante-input" match="/"&gt;&lt;tns7:visualizzaIDSLUCORequest&gt;&lt;input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Oscurato/Record/COUNT=0 and count($IsColocato/Record)&gt;0"&gt;&lt;tns8:RequestVisualizzaIDSLUCO&gt;&lt;xsl:for-each select="$ListaOlInvoke/output/tns2:ListaOloPerNuovoOrdineOutput/tns2:profiloOlo/tns2:anagraficaOlo"&gt;&lt;tns8:codificaOLOAgcom&gt;&lt;xsl:value-of select="tns2:codiceAgcom"/&gt;&lt;/tns8:codificaOLOAgcom&gt;&lt;/xsl:for-each&gt;&lt;xsl:for-each select="$IsColocato/Record"&gt;&lt;tns8:codificaOLOAgcom&gt;&lt;xsl:value-of select="CODFC_OLO_AGCOM_CONDIVISORE"/&gt;&lt;/tns8:codificaOLOAgcom&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$get3/parameters/tns3:nuovordine-idslucoGetParameters/valoreRicerca"&gt;&lt;tns8:valoreRicerca&gt;&lt;xsl:value-of select="$get3/parameters/tns3:nuovordine-idslucoGetParameters/valoreRicerca"/&gt;&lt;/tns8:valoreRicerca&gt;&lt;/xsl:if&gt;&lt;/tns8:RequestVisualizzaIDSLUCO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns8:RequestVisualizzaIDSLUCO&gt;&lt;xsl:for-each select="$ListaOlInvoke/output/tns2:ListaOloPerNuovoOrdineOutput/tns2:profiloOlo/tns2:anagraficaOlo"&gt;&lt;tns8:codificaOLOAgcom&gt;&lt;xsl:value-of select="tns2:codiceAgcom"/&gt;&lt;/tns8:codificaOLOAgcom&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$get3/parameters/tns3:nuovordine-idslucoGetParameters/valoreRicerca"&gt;&lt;tns8:valoreRicerca&gt;&lt;xsl:value-of select="$get3/parameters/tns3:nuovordine-idslucoGetParameters/valoreRicerca"/&gt;&lt;/tns8:valo