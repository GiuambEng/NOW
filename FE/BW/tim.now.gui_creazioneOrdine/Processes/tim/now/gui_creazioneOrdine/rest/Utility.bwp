                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/cmf/visualizzaIDULLCO&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/cliente&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdullcoInvoke_Accorpante.output&quot;/>&#xa;    &lt;xsl:param name=&quot;IdullcoInvoke_Accorpato.output&quot;/>&#xa;    &lt;xsl:param name=&quot;OloInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;IdullcoInvoke_CodNonUnivoco.output&quot;/>&#xa;    &lt;xsl:param name=&quot;ISColocato&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$OloInvoke.output/tns2:flagAccorpante='Y' or count($ISColocato/Record)>0&quot;>&#xa;                &lt;ns:ResponseIDULLCOolo>&#xa;                    &lt;xsl:if test=&quot;count($IdullcoInvoke_Accorpante.output/ns:visulizzaIDULLCO) > 0&quot;>&#xa;                        &lt;xsl:copy-of select=&quot;$IdullcoInvoke_Accorpante.output/ns:visulizzaIDULLCO&quot;/>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:result>&#xa;                        &lt;ns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/ns:severity>&#xa;                        &lt;ns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/ns:code>&#xa;                    &lt;/ns:result>&#xa;                &lt;/ns:ResponseIDULLCOolo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($IdullcoInvoke_Accorpato.output/ns:visulizzaIDULLCO) = 0 and count($IdullcoInvoke_Accorpante.output/ns:visulizzaIDULLCO) = 0 and count($IdullcoInvoke_CodNonUnivoco.output/ns:visulizzaIDULLCO) = 0&quot;>&#xa;                &lt;ns:ResponseIDULLCOolo>&#xa;                    &lt;ns:result>&#xa;                        &lt;ns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/ns:severity>&#xa;                        &lt;ns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/ns:code>&#xa;                        &lt;ns:details>&#xa;                            &lt;xsl:value-of select=&quot;'NO RECORD'&quot;/>&#xa;                        &lt;/ns:details>&#xa;                    &lt;/ns:result>&#xa;                &lt;/ns:ResponseIDULLCOolo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$OloInvoke.output/tns2:codOloAccorpante !=''&quot;>&#xa;                        &lt;ns:ResponseIDULLCOolo>&#xa;                            &lt;xsl:copy-of select=&quot;$IdullcoInvoke_Accorpato.output/ns:visulizzaIDULLCO&quot;/>&#xa;                            &lt;ns:result>&#xa;                                &lt;ns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/ns:severity>&#xa;                                &lt;ns:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/ns:code>&#xa;                            &lt;/ns:result>&#xa;                        &lt;/ns:ResponseIDULLCOolo>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ResponseIDULLCOolo>&#xa;                            &lt;xsl:copy-of select=&quot;$IdullcoInvoke_CodNonUnivoco.output/ns:visulizzaIDULLCO&quot;/>&#xa;                            &lt;ns:result>&#xa;                                &lt;ns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/ns:severity>&#xa;                                &lt;ns:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/ns:code>&#xa;                            &lt;/ns:result>&#xa;                        &lt;/ns:ResponseIDULLCOolo>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
