                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns10=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;get_VisualizzaIdullco_OutLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:CW_BUS_MESSAGE>&#xa;            &lt;tns9:GenericLogger>&#xa;                &lt;tns9:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Utility&amp;quot;&quot;/>&#xa;                &lt;/tns9:Process>&#xa;                &lt;tns9:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.rest.Utility&amp;quot;&quot;/>&#xa;                &lt;/tns9:Service>&#xa;                &lt;tns9:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns9:Operation>&#xa;                &lt;xsl:if test=&quot;$get2/httpHeaders/tns10:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns9:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get2/httpHeaders/tns10:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns9:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns9:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputUtility:&amp;quot;,tib:render-xml($Mapper, true(),true()))&quot;/>&#xa;                &lt;/tns9:Payload>&#xa;                &lt;tns9:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns9:LoggerName>&#xa;                &lt;tns9:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns9:LogLevel>&#xa;                &lt;tns9:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns9:LogJMS>&#xa;            &lt;/tns9:GenericLogger>&#xa;            &lt;tns9:ActiveLoggerServices>&#xa;                &lt;tns9:Envelope>&#xa;                    &lt;tns9:Identifier>&#xa;                        &lt;tns9:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.rest.Utility&amp;quot;&quot;/>&#xa;                        &lt;/tns9:ServiceName>&#xa;                        &lt;tns9:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Operation>&#xa;                        &lt;tns9:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Source>&#xa;                        &lt;xsl:if test=&quot;$get2/httpHeaders/tns10:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns9:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get2/httpHeaders/tns10:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns9:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns9:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get2/httpHeaders/tns10:httpHeaders/GUI-SID,$get2/httpHeaders/tns10:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns9:EventID>&#xa;                        &lt;xsl:if test=&quot;$get2/httpHeaders/tns10:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns9:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get2/httpHeaders/tns10:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns9:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns9:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Utility_&amp;quot;,$get2/httpHeaders/tns10:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns9:EventType>&#xa;                        &lt;tns9:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Utility_&amp;quot;,$get2/httpHeaders/tns10:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns9:trackID>&#xa;                    &lt;/tns9:Identifier>&#xa;                    &lt;tns9:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns9:track_position>&#xa;                    &lt;tns9:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns9:Timestamp>&#xa;                &lt;/tns9:Envelope>&#xa;            &lt;/tns9:ActiveLoggerServices>&#xa;        &lt;/tns9:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
