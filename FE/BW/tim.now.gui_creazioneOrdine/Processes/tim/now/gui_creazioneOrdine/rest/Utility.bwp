                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns9=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://xmlns.example.com/20160418153620PLT/ConceptSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;get3.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;get_VisualizzaIdsluco_InputLog_INFO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Utility&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.rest.Utility&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;xsl:if test=&quot;$get3.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns10:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get3.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns10:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns10:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputUtility:&amp;quot;,tib:render-xml($get3.parameters, true(),true()))&quot;/>&#xa;                &lt;/tns10:Pay