e>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Utility_&amp;quot;,$get2.httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns10:EventType>&#xa;                        &lt;tns10:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Utility_&amp;quot;,$get2.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns10:trackID>&#xa;                    &lt;/tns10:Identifier>&#xa;                    &lt;tns10:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns10:track_position>&#xa;                    &lt;tns10:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns10:Timestamp>&#xa;                &lt;/tns10:Envelope>&#xa;                &lt;tns10:Playload>&#xa;                    &lt;tns10:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get2.parameters )))&quot;/>&#xa;                    &lt;/tns10:Binary>&#xa;                    &lt;tns10:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($get2.parameters)&quot;/>&#xa;                    &lt;/tns10:XMLString>&#xa;                &lt;/tns10:Playload>&#xa;            &lt;/tns10:ActiveLoggerServices>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
