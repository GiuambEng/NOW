                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns9="http://xmlns.example.com/20160418153620PLT" xmlns:tns10="http://www.tim.com/NOW/cmf/AutocompletamentoDatiSede" version="2.0"&gt;
    &lt;xsl:param name="AutocompletamentoDatiSedeInvoke1"/&gt;
    &lt;xsl:template name="AutocompletamentoDatiSedeOut-input1" match="/"&gt;
        &lt;tns9:getResponse1&gt;
            &lt;item&gt;
                &lt;tns10:DatiSedeOutput&gt;
                    &lt;xsl:for-each select="$AutocompletamentoDatiSedeInvoke1/parameters/tns10:DatiSedeOutput/tns10:provincia"&gt;
                        &lt;tns10:provincia&gt;
                            &lt;xsl:value-of select="."/&gt;
                        &lt;/tns10:provincia&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:for-each select="$AutocompletamentoDatiSedeInvoke1/parameters/tns10:DatiSedeOutput/tns10:comune"&gt;
                        &lt;tns10:comune&gt;
                            &lt;xsl:value-of select="."/&gt;
                        &lt;/tns10:comune&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:for-each select="$AutocompletamentoDatiSedeInvoke1/parameters/tns10:DatiSedeOutput/tns10:particellaToponomastica"&gt;
                        &lt;tns10:particellaToponomastica&gt;
                            &lt;xsl:value-of select="."/&gt;
                        &lt;/tns10:particellaToponomastica&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:for-each select="$AutocompletamentoDatiSedeInvoke1/parameters/tns10:DatiSedeOutput/tns10:indirizzo"&gt;
                        &lt;tns10:indirizzo&gt;
                            &lt;xsl:value-of select="."/&gt;
                        &lt;/tns10:indirizzo&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:for-each select="$AutocompletamentoDatiSedeInvoke1/parameters/tns10:DatiSedeOutput/tns10:civico"&gt;
                        &lt;tns10:civico&gt;
                            &lt;xsl:value-of select="."/&gt;
                        &lt;/tns10:civico&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;tns10:result&gt;
                        &lt;tns10:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                        &lt;/tns10:severity&gt;
                        &lt;tns10:code&gt;
                            &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                        &lt;/tns10:code&gt;
                    &lt;/tns10:result&gt;
                &lt;/tns10:DatiSedeOutput&gt;
            &lt;/item&gt;
