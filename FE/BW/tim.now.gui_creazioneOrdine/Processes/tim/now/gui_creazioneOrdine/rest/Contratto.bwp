                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+083b4108-9736-45d4-96e7-67624a3f6907+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160416194928PLT/ConceptSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;DRO&quot;/>&lt;xsl:template name=&quot;ContrattiOlo-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;DRO1>&lt;xsl:value-of select=&quot;string(format-date($DRO/parameters/tns2:Response/tns2:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&lt;/DRO1>&lt;DRO2>&lt;xsl:value-of select=&quot;string(format-date($DRO/parameters/tns2:Response/tns2:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&lt;/DRO2>&lt;codOloAgcom>&lt;xsl:value-of select=&quot;$get/parameters/tns1:contrattoGetParameters/codOLOAgcom&quot;/>&lt;/codOloAgcom>&lt;codOloAccorpante>&lt;xsl:value-of select=&quot;$get/parameters/tns1:contrattoGetParameters/codOLOAgcom&quot;/>&lt;/codOloAccorpante>&lt;codOloAgcom2>&lt;xsl:value-of select=&quot;$get/parameters/tns1:contrattoGetParameters/codOLOAgcom&quot;/>&lt;/codOloAgcom2>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ContrattiOlo-input"
                                    name="ContrattiOlo"
                                    outputVariable="ContrattiOlo"
                                    tibex:xpdlId="083b4108-9736-45d4-96e7-67624a3f6907" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="calcNextWorkingDateToContrattiOloAccorpanti_Name"/>
                                    </bpws:targets>
