                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+083b4108-9736-45d4-96e7-67624a3f6907+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160416194928PLT/ConceptSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ContrattiOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;DRO1>&#xa;                &lt;xsl:value-of select=&quot;string(format-date($DRO.parameters/tns2:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&#xa;            &lt;/DRO1>&#xa;            &lt;DRO2>&#xa;                &lt;xsl:value-of select=&quot;string(format-date($DRO.parameters/tns2:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&#xa;            &lt;/DRO2>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/codOLOAgcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/codOLOAgcom&quot;/>&#xa;            &lt;/codOloAccorpante>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/codOLOAgcom&quot;/>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TOR.OPERATORERETE,C.ID_TPLG_OPERATORE,C.COD_CONTRATTO, C.COD_OLO, C.CODFC_OLO_AGCOM, C.DATAFI_VALID, C.DATAINZ_VALID, C.FLAG_ABILITATO, C.FLAG_ANFIBIO, C.FLAG_DIFFIDATO, &#xa;C.FLAG_FILE_NOTIFY, C.FLAG_NPD, C.FLAG_STANDARD, C.FLAG_VALIDO, C.ID_COD_CONTRATTO_PADRE, C.ID_CONTRATTO, C.ID_CONTRATTO_CRMWS, &#xa;C.ID_FAMIG_OFFERTA, C.ID_SOTTOFAMIG_OFFERTA, C.ID_STATO_CONTRATTO, C.IDTPLG_CONTRATTO, C.NOME_CONTRATTO, C.NOME_STANDARD,  &#xa;C.STATO_STANDARD, C.TIMSTP_AGGTO, C.TIMSTP_INSMTO, C.TIPO, C.FLAG_MULTICAST&#xa;FROM CONTRATTO C&#xa;LEFT JOIN  TIPOLG_OPERATORE_RETE TOR ON TOR.ID_TPLG_OPERATORE=C.ID_TPLG_OPERATORE&#xa;WHERE &#xa;C.DATAINZ_VALID &lt;= to_Date(?,'DD/MM/YY')&#xa;AND (C.DATAFI_VALID >= to_Date(?,'DD/MM/YY')&#xa;OR C.DATAFI_VALID IS NULL) &#xa;AND &#xa;C.ID_STATO_CONTRATTO = 6&#xa;AND C.ID_SOTTOFAMIG_OFFERTA NOT IN (SELECT ID_SOTTOFAMIG_OFFERTA &#xa;                              FROM SOTTO_FAMIG_OFFERTA &#xa;                              WHERE DESCR IN ('NP','IAV','NPNG'))&#xa;AND C.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM&#xa;                         FROM OLO &#xa;                         WHERE CODFC_OLO_AGCOM = ? &#x9;OR COD_OLO_ACCORPANTE = ?&#xa;                         OR COD_OLO = (SELECT COD_OLO&#xa;                                            FROM OLO&#xa;                                            WHERE CODFC_OLO_AGCOM = ?))&#xa;ORDER BY C.NOME_CONTRATTO" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAccorpante"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom2"/>
