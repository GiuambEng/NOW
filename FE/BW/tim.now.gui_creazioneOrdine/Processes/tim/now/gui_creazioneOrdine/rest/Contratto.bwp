                            </bpws:extensionActivity>
                            <bpws:invoke inputVariable="DRO-input"
                                name="DRO"
                                operation="calcNextWorkingDate"
                                outputVariable="DRO"
                                partnerLink="GetNextDatePortType"
                                portType="ns2:GetNextDatePortType" tibex:xpdlId="34b09151-4bae-4803-8d6b-150c9adfb7f1">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" version="2.0"&gt;&lt;xsl:template name="calcNextWorkingDate-input" match="/"&gt;&lt;tns:calcNextWorkingDateRequest&gt;&lt;parameters&gt;&lt;tns1:CalcRequest&gt;&lt;tns1:inputDate&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/tns1:inputDate&gt;&lt;/tns1:CalcRequest&gt;&lt;/parameters&gt;&lt;/tns:calcNextWorkingDateRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;calcNextWorkingDate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CalcRequest>&#xa;            &lt;tns1:inputDate>&#xa;                &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;            &lt;/tns1:inputDate>&#xa;        &lt;/tns1:CalcRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="get_visualizzacontratto_InputLog_INFOToDRO"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="calcNextWorkingDateToContrattiOloAccorpanti_Name">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="DROToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(string-length($get/parameters/tns:contrattoGetParameters/flagMulticast)>0) and (upper-case($get/parameters/tns:contrattoGetParameters/flagMulticast)='Y')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(string-length($get.parameters/flagMulticast)>0) and (upper-case($get.parameters/flagMulticast)='Y')]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c0cf9b94-770a-44f2-adfd-ce4c3496926c+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160416194928PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DRO&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;ContrattiOloMulticast-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;DRO1>&lt;xsl:value-of select=&quot;string(format-date($DRO/parameters/tns2:Response/tns2:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&lt;/DRO1>&lt;DRO2>&lt;xsl:value-of select=&quot;string(format-date($DRO/parameters/tns2:Response/tns2:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&lt;/DRO2>&lt;codOloAgcom>&lt;xsl:value-of select=&quot;$get/parameters/tns1:contrattoGetParameters/codOLOAgcom&quot;/>&lt;/codOloAgcom>&lt;codOloAccorpante>&lt;xsl:value-of select=&quot;$get/parameters/tns1:contrattoGetParameters/codOLOAgcom&quot;/>&lt;/codOloAccorpante>&lt;codOloAgcom2>&lt;xsl:value-of select=&quot;$get/parameters/tns1:contrattoGetParameters/codOLOAgcom&quot;/>&lt;/codOloAgcom2>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ContrattiOloMulticast-input"
                                    name="ContrattiOloMulticast"
                                    outputVariable="ContrattiOloMulticast"
                                    tibex:xpdlId="c0cf9b94-770a-44f2-adfd-ce4c3496926c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DROToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToContrattiAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c0cf9b94-770a-44f2-adfd-ce4c3496926c+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160416194928PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ContrattiOloMulticast-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;DRO1>&#xa;                &lt;xsl:value-of select=&quot;string(format-date($DRO.parameters/tns2:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&#xa;            &lt;/DRO1>&#xa;            &lt;DRO2>&#xa;                &lt;xsl:value-of select=&quot;string(format-date($DRO.parameters/tns2:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&#xa;            &lt;/DRO2>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/codOLOAgcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/codOLOAgcom&quot;/>&#xa;            &lt;/codOloAccorpante>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/codOLOAgcom&quot;/>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TOR.OPERATORERETE,C.ID_TPLG_OPERATORE,C.COD_CONTRATTO, C.COD_OLO, C.CODFC_OLO_AGCOM, C.DATAFI_VALID, C.DATAINZ_VALID, C.FLAG_ABILITATO, C.FLAG_ANFIBIO, C.FLAG_DIFFIDATO, &#xa;C.FLAG_FILE_NOTIFY, C.FLAG_NPD, C.FLAG_STANDARD, C.FLAG_VALIDO, C.ID_COD_CONTRATTO_PADRE, C.ID_CONTRATTO, C.ID_CONTRATTO_CRMWS, &#xa;C.ID_FAMIG_OFFERTA, C.ID_SOTTOFAMIG_OFFERTA, C.ID_STATO_CONTRATTO, C.IDTPLG_CONTRATTO, C.NOME_CONTRATTO, C.NOME_STANDARD,  &#xa;C.STATO_STANDARD, C.TIMSTP_AGGTO, C.TIMSTP_INSMTO, C.TIPO, C.FLAG_MULTICAST&#xa;FROM CONTRATTO C&#xa;LEFT JOIN  TIPOLG_OPERATORE_RETE TOR ON TOR.ID_TPLG_OPERATORE=C.ID_TPLG_OPERATORE&#xa;INNER JOIN CONTRATTO_OFFERTA_CATLG COC ON C.ID_CONTRATTO = COC.ID_CONTRATTO&#xa;WHERE &#xa;C.DATAINZ_VALID &lt;= to_Date(?,'DD/MM/YY')&#xa;AND (C.DATAFI_VALID >= to_Date(?,'DD/MM/YY')&#xa;OR C.DATAFI_VALID IS NULL) &#xa;AND &#xa;C.ID_STATO_CONTRATTO = 6&#xa;AND C.ID_SOTTOFAMIG_OFFERTA NOT IN (SELECT ID_SOTTOFAMIG_OFFERTA &#xa;                              FROM SOTTO_FAMIG_OFFERTA &#xa;                              WHERE DESCR IN ('NP','IAV','NPNG'))&#xa;AND C.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM&#xa;                         FROM OLO &#xa;                         WHERE CODFC_OLO_AGCOM = ? &#x9;OR COD_OLO_ACCORPANTE = ?&#xa;                         OR COD_OLO = (SELECT COD_OLO&#xa;                                            FROM OLO&#xa;                                            WHERE CODFC_OLO_AGCOM = ?))&#xa;AND COC.ID_OFFERTA = 15 &#xa;AND C.FLAG_MULTICAST = 'SI'&#xa;ORDER BY C.NOME_CONTRATTO" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAccorpante"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom2"/>
                                    <columnMetadata
                                    columnName="OPERATORERETE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_TPLG_OPERATORE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_CONTRATTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="FLAG_ABILITATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_ANFIBIO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_FILE_NOTIFY"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_NPD"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_STANDARD"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_VALIDO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_COD_CONTRATTO_PADRE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO_CRMWS"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_FAMIG_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_SOTTOFAMIG_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_STATO_CONTRATTO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDTPLG_CONTRATTO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOME_CONTRATTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_STANDARD"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_STANDARD"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_AGGTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIPO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_MULTICAST"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
