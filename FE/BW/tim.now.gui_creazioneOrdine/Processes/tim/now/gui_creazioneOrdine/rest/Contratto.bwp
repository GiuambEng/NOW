                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contratto&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ContrattiOlo&quot;/>&lt;xsl:param name=&quot;ContrattiOloMulticast&quot;/>&lt;xsl:template name=&quot;VariableLista&quot; match=&quot;/&quot;>&lt;tns:outputListaContratti>&lt;xsl:choose>&lt;xsl:when test=&quot;count($ContrattiOlo/Record/ID_CONTRATTO)>0&quot;>&lt;xsl:for-each select=&quot;$ContrattiOlo/Record&quot;>&lt;tns:contratto>&lt;xsl:if test=&quot;exists(ID_CONTRATTO)&quot;>&lt;tns:idContratto>&lt;xsl:value-of select=&quot;xsd:int(ID_CONTRATTO)&quot;/>&lt;/tns:idContratto>&lt;/xsl:if>&lt;tns:codiceContratto>&lt;xsl:value-of select=&quot;COD_CONTRATTO&quot;/>&lt;/tns:codiceContratto>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_CONTRATTO&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;NOME_CONTRATTO&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPO&quot;>&lt;tns:tipo>&lt;xsl:value-of select=&quot;TIPO&quot;/>&lt;/tns:tipo>&lt;/xsl:if>&lt;tns:flagNPD>&lt;xsl:value-of select=&quot;FLAG_NPD&quot;/>&lt;/tns:flagNPD>&lt;xsl:if test=&quot;FLAG_ABILITATO&quot;>&lt;tns:flagAbilitato>&lt;xsl:value-of select=&quot;FLAG_ABILITATO&quot;/>&lt;/tns:flagAbilitato>&lt;/xsl:if>&lt;tns:flagValido>&lt;xsl:value-of select=&quot;FLAG_VALIDO&quot;/>&lt;/tns:flagValido>&lt;xsl:if test=&quot;FLAG_STANDARD&quot;>&lt;tns:flagStandard>&lt;xsl:value-of select=&quot;FLAG_STANDARD&quot;/>&lt;/tns:flagStandard>&lt;/xsl:if>&lt;tns:flagFileNotify>&lt;xsl:value-of select=&quot;FLAG_FILE_NOTIFY&quot;/>&lt;/tns:flagFileNotify>&lt;tns:flagDiffidato>&lt;xsl:value-of select=&quot;FLAG_DIFFIDATO&quot;/>&lt;/tns:flagDiffidato>&lt;tns:flagAnfibio>&lt;xsl:value-of select=&quot;FLAG_ANFIBIO&quot;/>&lt;/tns:flagAnfibio>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string(ID_COD_CONTRATTO_PADRE))>0&quot;>&lt;tns:idContrattoPadre>&lt;xsl:value-of select=&quot;xsd:int(ID_COD_CONTRATTO_PADRE)&quot;/>&lt;/tns:idContrattoPadre>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:idContrattoPadre>&lt;xsl:value-of select=&quot;xsd:int(ID_CONTRATTO)&quot;/>&lt;/tns:idContrattoPadre>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;STATO_STANDARD&quot;>&lt;tns:statoStandard>&lt;xsl:value-of select=&quot;STATO_STANDARD&quot;/>&lt;/tns:statoStandard>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_AGGTO)&quot;>&lt;tns:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_AGGTO), 'T')&quot;/>&lt;/tns:dataUltimoAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_INSMTO)&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_INSMTO), 'T')&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;ID_CONTRATTO_CRMWS&quot;>&lt;tns:identificativoContrattoCRMW>&lt;xsl:value-of select=&quot;ID_CONTRATTO_CRMWS&quot;/>&lt;/tns:identificativoContrattoCRMW>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_STANDARD&quot;>&lt;tns:nomeStandard>&lt;xsl:value-of select=&quot;NOME_STANDARD&quot;/>&lt;/tns:nomeStandard>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATAINZ_VALID)&quot;>&lt;tns:dataInizio>&lt;xsl:value-of select=&quot;substring-before(string(DATAINZ_VALID), 'T')&quot;/>&lt;/tns:dataInizio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATAFI_VALID)&quot;>&lt;tns:dataFine>&lt;xsl:value-of select=&quot;substring-before(string(DATAFI_VALID), 'T')&quot;/>&lt;/tns:dataFine>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(IDTPLG_CONTRATTO)&quot;>&lt;tns:identificativoTipologiaContratto>&lt;xsl:value-of select=&quot;xsd:int(IDTPLG_CONTRATTO)&quot;/>&lt;/tns:identificativoTipologiaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_OLO&quot;>&lt;tns:codOlo>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:codOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_FAMIG_OFFERTA)&quot;>&lt;tns:idFamigliaOfferta>&lt;xsl:value-of select=&quot;xsd:int(ID_FAMIG_OFFERTA)&quot;/>&lt;/tns:idFamigliaOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_SOTTOFAMIG_OFFERTA)&quot;>&lt;tns:idSottofamigliaOfferta>&lt;xsl:value-of select=&quot;xsd:int(ID_SOTTOFAMIG_OFFERTA)&quot;/>&lt;/tns:idSottofamigliaOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_STATO_CONTRATTO)&quot;>&lt;tns:idStatoContratto>&lt;xsl:value-of select=&quot;xsd:int(ID_STATO_CONTRATTO)&quot;/>&lt;/tns:idStatoContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;OPERATORERETE&quot;>&lt;tns:operatoreRete>&lt;xsl:value-of select=&quot;OPERATORERETE&quot;/>&lt;/tns:operatoreRete>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_TPLG_OPERATORE) and string-length(string(ID_TPLG_OPERATORE))&amp;lt;0&quot;>&lt;tns:idOperatoreRete>&lt;xsl:value-of select=&quot;xsd:int(ID_TPLG_OPERATORE)&quot;/>&lt;/tns:idOperatoreRete>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'SI'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'NO'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:contratto>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;count($ContrattiOloMulticast/Record/ID_CONTRATTO)>0&quot;>&lt;xsl:for-each select=&quot;$ContrattiOloMulticast/Record&quot;>&lt;tns:contratto>&lt;xsl:if test=&quot;exists(ID_CONTRATTO)&quot;>&lt;tns:idContratto>&lt;xsl:value-of select=&quot;xsd:int(ID_CONTRATTO)&quot;/>&lt;/tns:idContratto>&lt;/xsl:if>&lt;tns:codiceContratto>&lt;xsl:value-of select=&quot;COD_CONTRATTO&quot;/>&lt;/tns:codiceContratto>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_CONTRATTO&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;NOME_CONTRATTO&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPO&quot;>&lt;tns:tipo>&lt;xsl:value-of select=&quot;TIPO&quot;/>&lt;/tns:tipo>&lt;/xsl:if>&lt;tns:flagNPD>&lt;xsl:value-of select=&quot;FLAG_NPD&quot;/>&lt;/tns:flagNPD>&lt;xsl:if test=&quot;FLAG_ABILITATO&quot;>&lt;tns:flagAbilitato>&lt;xsl:value-of select=&quot;FLAG_ABILITATO&quot;/>&lt;/tns:flagAbilitato>&lt;/xsl:if>&lt;tns:flagValido>&lt;xsl:value-of select=&quot;FLAG_VALIDO&quot;/>&lt;/tns:flagValido>&lt;xsl:if test=&quot;FLAG_STANDARD&quot;>&lt;tns:flagStandard>&lt;xsl:value-of select=&quot;FLAG_STANDARD&quot;/>&lt;/tns:flagStandard>&lt;/xsl:if>&lt;tns:flagFileNotify>&lt;xsl:value-of select=&quot;FLAG_FILE_NOTIFY&quot;/>&lt;/tns:flagFileNotify>&lt;tns:flagDiffidato>&lt;xsl:value-of select=&quot;FLAG_DIFFIDATO&quot;/>&lt;/tns:flagDiffidato>&lt;tns:flagAnfibio>&lt;xsl:value-of select=&quot;FLAG_ANFIBIO&quot;/>&lt;/tns:flagAnfibio>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string(ID_COD_CONTRATTO_PADRE))>0&quot;>&lt;tns:idContrattoPadre>&lt;xsl:value-of select=&quot;xsd:int(ID_COD_CONTRATTO_PADRE)&quot;/>&lt;/tns:idContrattoPadre>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:idContrattoPadre>&lt;xsl:value-of select=&quot;xsd:int(ID_CONTRATTO)&quot;/>&lt;/tns:idContrattoPadre>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;STATO_STANDARD&quot;>&lt;tns:statoStandard>&lt;xsl:value-of select=&quot;STATO_STANDARD&quot;/>&lt;/tns:statoStandard>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_AGGTO)&quot;>&lt;tns:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_AGGTO), 'T')&quot;/>&lt;/tns:dataUltimoAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_INSMTO)&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_INSMTO), 'T')&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;ID_CONTRATTO_CRMWS&quot;>&lt;tns:identificativoContrattoCRMW>&lt;xsl:value-of select=&quot;ID_CONTRATTO_CRMWS&quot;/>&lt;/tns:identificativoContrattoCRMW>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_STANDARD&quot;>&lt;tns:nomeStandard>&lt;xsl:value-of select=&quot;NOME_STANDARD&quot;/>&lt;/tns:nomeStandard>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATAINZ_VALID)&quot;>&lt;tns:dataInizio>&lt;xsl:value-of select=&quot;substring-before(string(DATAINZ_VALID), 'T')&quot;/>&lt;/tns:dataInizio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATAFI_VALID)&quot;>&lt;tns:dataFine>&lt;xsl:value-of select=&quot;substring-before(string(DATAFI_VALID), 'T')&quot;/>&lt;/tns:dataFine>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(IDTPLG_CONTRATTO)&quot;>&lt;tns:identificativoTipologiaContratto>&lt;xsl:value-of select=&quot;xsd:int(IDTPLG_CONTRATTO)&quot;/>&lt;/tns:identificativoTipologiaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_OLO&quot;>&lt;tns:codOlo>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:codOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_FAMIG_OFFERTA)&quot;>&lt;tns:idFamigliaOfferta>&lt;xsl:value-of select=&quot;xsd:int(ID_FAMIG_OFFERTA)&quot;/>&lt;/tns:idFamigliaOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_SOTTOFAMIG_OFFERTA)&quot;>&lt;tns:idSottofamigliaOfferta>&lt;xsl:value-of select=&quot;xsd:int(ID_SOTTOFAMIG_OFFERTA)&quot;/>&lt;/tns:idSottofamigliaOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_STATO_CONTRATTO)&quot;>&lt;tns:idStatoContratto>&lt;xsl:value-of select=&quot;xsd:int(ID_STATO_CONTRATTO)&quot;/>&lt;/tns:idStatoContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;OPERATORERETE&quot;>&lt;tns:operatoreRete>&lt;xsl:value-of select=&quot;OPERATORERETE&quot;/>&lt;/tns:operatoreRete>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(ID_TPLG_OPERATORE) and string-length(string(ID_TPLG_OPERATORE))&amp;lt;0&quot;>&lt;tns:idOperatoreRete>&lt;xsl:value-of select=&quot;xsd:int(ID_TPLG_OPERATORE)&quot;/>&lt;/tns:idOperatoreRete>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'SI'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'NO'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:contratto>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;xsl:if test=&quot;count($ContrattiOlo/Record/ID_CONTRATTO)=0 and count($ContrattiOloMulticast/Record/ID_CONTRATTO)=0&quot;>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun contratto presente'&quot;/>&lt;/tns:details>&lt;/xsl:if>&lt;/tns:result>&lt;/tns:outputListaContratti>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
