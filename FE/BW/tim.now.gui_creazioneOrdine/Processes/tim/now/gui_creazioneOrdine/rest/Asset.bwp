                                    sqlStatement="SELECT DISTINCT A.IDRISORSA,ACF.DATAINIZIOVALIDITA,ACF.TIPOLOGIAASSOCIAZIONE&#xa;FROM BDS_1_CASEDATA_ASSOCZNCNLFDRLT ACF INNER JOIN &#xa;&#x9;BDS_1_CASEDATA_ASSET A ON ACF.IDASSETCANALE = A.IDASSET&#xa;WHERE ACF.IDASSETFEEDER = ? AND ACF.DATAFINEVALIDITA>SYSDATE&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

