                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+19d07355-c2cf-43c0-bbde-ee3d397a5aee+input&quot; xmlns:tns4=&quot;http://xmlns.example.com/Asset/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoSediOltCanale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;idAsset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get3/parameters/tns4:sedioltdettaglioassetGetParameters/tns4:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get3/parameters/tns4:sedioltdettaglioassetGetParameters/tns4:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoSediOltCanale-input"
                                    name="RecuperoSediOltCanale"
                                    outputVariable="RecuperoSediOltCanale"
                                    tibex:xpdlId="19d07355-c2cf-43c0-bbde-ee3d397a5aee" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess3ToJDBCQuery2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery2ToAssign3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+19d07355-c2cf-43c0-bbde-ee3d397a5aee+input&quot; xmlns:tns4=&quot;http://xmlns.example.com/Asset/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoSediOltCanale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;idAsset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get3.parameters/tns4:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get3.parameters/tns4:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select distinct a.des,a.idrisorsa,&#xa;    (select valoreattributo &#xa;    from bds_1_casedata_attribtdttglsst ada &#xa;    where ada.idasset = a.idasset and nomeattributo = 'NOMEMACROAREA') as NOMEMACROAREA, &#xa;    (select valoreattributo &#xa;    from bds_1_casedata_attribtdttglsst ada &#xa;    where ada.idasset = a.idasset and nomeattributo = 'CODICEMACROAREA') as CODICEMACROAREA,&#xa;    (select valoreattributo &#xa;    from bds_1_casedata_attribtdttglsst ada &#xa;    where ada.idasset = a.idasset and nomeattributo = 'NOMECENTRALEPDC') as NOMECENTRALEPDC,&#xa;    (select valoreattributo &#xa;    from bds_1_casedata_attribtdttglsst ada &#xa;    where ada.idasset = a.idasset and nomeattributo = 'CODICECLLIPDC') as CODICECLLIPDC,&#xa;    (select valoreattributo &#xa;    from bds_1_casedata_attribtdttglsst ada &#xa;    where ada.idasset = a.idasset and nomeattributo = 'CLLICENTRALE') as CLLICENTRALE&#xa;from bds_1_casedata_asset a&#xa;where a.idasset in (&#xa;select acf.idassetolt&#xa;from bds_1_casedata_assoczncnlfdrlt acf&#xa;where acf.idassetcanale = ? and acf.tipologiaassociazione = 'OLT'&#xa;)&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idAsset"/>
                                    <columnMetadata
                                    columnName="DES"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEMACROAREA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEMACROAREA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMECENTRALEPDC"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICECLLIPDC"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CLLICENTRALE"
                                    dataType="-9"
