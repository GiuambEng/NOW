                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OV.COD_VLAN as CODICEVLAN, OV.CODFC_OLO_AGCOM AS CODICEOLO ,OV.DATAFI_VALID AS DATAFINEVALIDITA, &#xa;    (SELECT DISTINCT OV.codfc_olo_agcom&#xa;    FROM OLO_VLAN OV INNER JOIN OLO O ON OV.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM&#xa;    WHERE OV.STATO='ACTIVE' AND OV.COD_VLAN = ? AND OV.DATAFI_VALID > SYSDATE&#xa;    AND OV.ID_OLO_VLAN = OV.ID_OLO_TITOLARE_VLAN)AS CODICEOLOTITOLARE&#xa;FROM OLO_VLAN OV INNER JOIN OLO O ON OV.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM&#xa;WHERE OV.STATO='ACTIVE' AND OV.COD_VLAN = ? AND OV.DATAFI_VALID > SYSDATE &#xa;AND OV.ID_OLO_VLAN &lt;> OV.ID_OLO_TITOLARE_VLAN" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRisorsa"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRisorsa1"/>
                                    <columnMetadata
                                    columnName="CODICEVLAN"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEOLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAFINEVALIDITA"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="CODICEOLOTITOLARE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
