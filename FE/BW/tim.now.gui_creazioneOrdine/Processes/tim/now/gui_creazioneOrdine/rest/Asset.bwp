                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/asset&quot; xmlns:tns5=&quot;http://xmlns.example.com/Asset/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Profile&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCnoOLOQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCOLOQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;outputLista&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($Profile, $get/parameters/tns5:Asset-ListaAssetGetParameters/tns5:tipoProfilo) and string-length( string($JDBCOLOQuery/Record[1]/IDASSET))>0&quot;>&#xa;                &lt;tns4:OutputAsset1>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCOLOQuery/Record&quot;>&#xa;                        &lt;tns4:OutputAsset>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                &lt;tns4:codiceOlo>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns4:codiceOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                                &lt;tns4:codiceOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns4:codiceOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns4:oao>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns4:oao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDASSETCRMWS&quot;>&#xa;                                &lt;tns4:idAssetCrm>&#xa;                                    &lt;xsl:value-of select=&quot;IDASSETCRMWS&quot;/>&#xa;                                &lt;/tns4:idAssetCrm>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns4:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns4:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns4:identificativoAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                            &lt;/tns4:identificativoAsset>&#xa;                            &lt;xsl:if test=&quot;STATOASSET&quot;>&#xa;                                &lt;tns4:identificativoStatoAsset>&#xa;                                    &lt;xsl:value-of select=&quot;STATOASSET&quot;/>&#xa;                                &lt;/tns4:identificativoStatoAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPOLOGIAACCESSO&quot;>&#xa;                                &lt;tns4:identificativoTipologiaAccesso>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&#xa;                                &lt;/tns4:identificativoTipologiaAccesso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns4:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns4:offerta>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns4:OutputAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns4:result>&#xa;                        &lt;tns4:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:severity>&#xa;                        &lt;tns4:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($JDBCOLOQuery/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&#xa;                        &lt;/tns4:code>&#xa;                    &lt;/tns4:result>&#xa;                &lt;/tns4:OutputAsset1>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not(contains($Profile, $get/parameters/tns5:Asset-ListaAssetGetParameters/tns5:tipoProfilo)) and string-length( string($JDBCnoOLOQuery/Record[1]/IDASSET))>0&quot;>&#xa;                &lt;tns4:OutputAsset1>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCnoOLOQuery/Record&quot;>&#xa;                        &lt;tns4:OutputAsset>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                &lt;tns4:codiceOlo>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns4:codiceOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                                &lt;tns4:codiceOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns4:codiceOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns4:oao>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns4:oao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDASSETCRMWS&quot;>&#xa;                                &lt;tns4:idAssetCrm>&#xa;                                    &lt;xsl:value-of select=&quot;IDASSETCRMWS&quot;/>&#xa;                                &lt;/tns4:idAssetCrm>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns4:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns4:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns4:identificativoAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                            &lt;/tns4:identificativoAsset>&#xa;                            &lt;xsl:if test=&quot;STATOASSET&quot;>&#xa;                                &lt;tns4:identificativoStatoAsset>&#xa;                                    &lt;xsl:value-of select=&quot;STATOASSET&quot;/>&#xa;                                &lt;/tns4:identificativoStatoAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPOLOGIAACCESSO&quot;>&#xa;                                &lt;tns4:identificativoTipologiaAccesso>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&#xa;                                &lt;/tns4:identificativoTipologiaAccesso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns4:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns4:offerta>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns4:OutputAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns4:result>&#xa;                        &lt;tns4:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:severity>&#xa;                        &lt;tns4:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($JDBCnoOLOQuery/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&#xa;                        &lt;/tns4:code>&#xa;                    &lt;/tns4:result>&#xa;                &lt;/tns4:OutputAsset1>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:OutputAsset1>&#xa;                    &lt;tns4:result>&#xa;                        &lt;tns4:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:severity>&#xa;                        &lt;tns4:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns4:code>&#xa;                        &lt;tns4:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&#xa;                        &lt;/tns4:details>&#xa;                    &lt;/tns4:result>&#xa;                &lt;/tns4:OutputAsset1>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="outputLista"
                                    name="ListaOutput"
                                    outputVariable="outputLista"
                                    tibex:xpdlId="3a08fac5-3566-468c-9f05-d32afabbacf5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCOLOQueryToListaOutput"/>
                                    <bpws:target linkName="JDBCnoOLOQueryToListaOutput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ListaOutputNoRecordToget_Asset_out_Name">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/asset&quot; xmlns:tns5=&quot;http://xmlns.example.com/Asset/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Profile&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCnoOLOQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCOLOQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;outputLista&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($Profile, $get.parameters/tns5:tipoProfilo) and string-length( string($JDBCOLOQuery/Record[1]/IDASSET))>0&quot;>&#xa;                &lt;tns4:OutputAsset1>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCOLOQuery/Record&quot;>&#xa;                        &lt;tns4:OutputAsset>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                &lt;tns4:codiceOlo>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns4:codiceOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                                &lt;tns4:codiceOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns4:codiceOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns4:oao>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns4:oao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDASSETCRMWS&quot;>&#xa;                                &lt;tns4:idAssetCrm>&#xa;                                    &lt;xsl:value-of select=&quot;IDASSETCRMWS&quot;/>&#xa;                                &lt;/tns4:idAssetCrm>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns4:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns4:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns4:identificativoAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                            &lt;/tns4:identificativoAsset>&#xa;                            &lt;xsl:if test=&quot;STATOASSET&quot;>&#xa;                                &lt;tns4:identificativoStatoAsset>&#xa;                                    &lt;xsl:value-of select=&quot;STATOASSET&quot;/>&#xa;                                &lt;/tns4:identificativoStatoAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPOLOGIAACCESSO&quot;>&#xa;                                &lt;tns4:identificativoTipologiaAccesso>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&#xa;                                &lt;/tns4:identificativoTipologiaAccesso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns4:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns4:offerta>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns4:OutputAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns4:result>&#xa;                        &lt;tns4:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:severity>&#xa;                        &lt;tns4:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($JDBCOLOQuery/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&#xa;                        &lt;/tns4:code>&#xa;                    &lt;/tns4:result>&#xa;                &lt;/tns4:OutputAsset1>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not(contains($Profile, $get.parameters/tns5:tipoProfilo)) and string-length( string($JDBCnoOLOQuery/Record[1]/IDASSET))>0&quot;>&#xa;                &lt;tns4:OutputAsset1>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCnoOLOQuery/Record&quot;>&#xa;                        &lt;tns4:OutputAsset>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                &lt;tns4:codiceOlo>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns4:codiceOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                                &lt;tns4:codiceOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns4:codiceOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns4:oao>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns4:oao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDASSETCRMWS&quot;>&#xa;                                &lt;tns4:idAssetCrm>&#xa;                                    &lt;xsl:value-of select=&quot;IDASSETCRMWS&quot;/>&#xa;                                &lt;/tns4:idAssetCrm>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns4:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns4:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns4:identificativoAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                            &lt;/tns4:identificativoAsset>&#xa;                            &lt;xsl:if test=&quot;STATOASSET&quot;>&#xa;                                &lt;tns4:identificativoStatoAsset>&#xa;                                    &lt;xsl:value-of select=&quot;STATOASSET&quot;/>&#xa;                                &lt;/tns4:identificativoStatoAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPOLOGIAACCESSO&quot;>&#xa;                                &lt;tns4:identificativoTipologiaAccesso>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&#xa;                                &lt;/tns4:identificativoTipologiaAccesso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns4:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns4:offerta>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns4:OutputAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns4:result>&#xa;                        &lt;tns4:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:severity>&#xa;                        &lt;tns4:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($JDBCnoOLOQuery/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&#xa;                        &lt;/tns4:code>&#xa;                    &lt;/tns4:result>&#xa;                &lt;/tns4:OutputAsset1>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:OutputAsset1>&#xa;                    &lt;tns4:result>&#xa;                        &lt;tns4:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:severity>&#xa;                        &lt;tns4:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns4:code>&#xa;                        &lt;tns4:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&#xa;                        &lt;/tns4:details>&#xa;                    &lt;/tns4:result>&#xa;                &lt;/tns4:OutputAsset1>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="outputLista" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;outputLista&quot;/>&#xa;    &lt;xsl:template name=&quot;get_Asset_out_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Asset&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.rest.Asset&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputListaAsset:&amp;quot;,substring(tib:render-xml($outputLista, true(),true()),1,500),&amp;quot;.....&amp;quot;)&quot;/>&#xa;                &lt;/tns5:Payload>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.rest.Asset&amp;quot;&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID:&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID:&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns5:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns5:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns5:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Asset_&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns5:EventType>&#xa;                        &lt;tns5:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Asset_&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns5:trackID>&#xa;                    &lt;/tns5:Identifier>&#xa;                    &lt;tns5:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns5:track_position>&#xa;                    &lt;tns5:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns5:Timestamp>&#xa;                &lt;/tns5:Envelope>&#xa;            &lt;/tns5:ActiveLoggerServices>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_Asset_out_Log-input"
                                    name="get_Asset_out_Log"
                                    tibex:xpdlId="ece2f841-e554-4096-810c-f7c3b3567868"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ListaOutputNoRecordToget_Asset_out_Name"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToListaAssetOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;outputLista&quot;/>&#xa;    &lt;xsl:template name=&quot;get_Asset_out_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Asset&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.rest.Asset&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputListaAsset:&amp;quot;,substring(tib:render-xml($outputLista, true(),true()),1,500),&amp;quot;.....&amp;quot;)&quot;/>&#xa;                &lt;/tns5:Payload>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.rest.Asset&amp;quot;&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID:&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID:&amp;quot;,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns5:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns5:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns5:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Asset_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns5:EventType>&#xa;                        &lt;tns5:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Asset_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns5:trackID>&#xa;                    &lt;/tns5:Identifier>&#xa;                    &lt;tns5:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns5:track_position>&#xa;                    &lt;tns5:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns5:Timestamp>&#xa;                &lt;/tns5:Envelope>&#xa;            &lt;/tns5:ActiveLoggerServices>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_creazioneOrdine.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://xmlns.example.com/Asset/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;get_Asset_IngetLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Asset&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.Asset&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputAsset:&amp;quot;,tib:render-xml($get/parameters/tns6:Asset-ListaAssetGetParameters, true(),true()))&quot;/>&#xa;                &lt;/tns5:Payload>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.Asset&amp;quot;&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID:&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID:&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns5:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;