                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT A.TIPOLOGIAACCESSO,A.IDASSET,A.CODIFICAOLOAGCOM,A.CODICEORDINEOLO,A.IDRISORSA ,A.IDASSETCRMWS,A.OFFERTA ,A.CODICEORDINETI,O.CLLI,A.STATOASSET, A.IDRISORSAOPERATORERETE&#xa;FROM BDS_1_CASEDATA_ASSET A &#xa;LEFT JOIN BDS_1_CASEDATA_ORDINE O ON A.IDPRIMOORDINE=O.IDRICHIESTAOLO&#xa;WHERE A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM&#xa;FROM OLO&#xa;WHERE (COD_OLO = (SELECT COD_OLO&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?)) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM&#xa;FROM OLO&#xa;WHERE COD_OLO = (SELECT COD_OLO&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?)))&#xa;ORDER BY A.LASTUPDATE DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

