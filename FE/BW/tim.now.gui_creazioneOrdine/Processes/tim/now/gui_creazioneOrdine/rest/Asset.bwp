                            <bpws:invoke inputVariable="Servizi-input"
                                name="Servizi" operation="Servizi"
                                outputVariable="Servizi"
                                partnerLink="AssetPort"
                                portType="ns1:AssetPort" tibex:xpdlId="ff7222ac-7933-4444-808b-35a880d8fb15">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/cmf/AssetDetails" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/Asset/" version="2.0"&gt;
    &lt;xsl:param name="DettaglioAssetInvoke"/&gt;
    &lt;xsl:template name="Servizi-input" match="/"&gt;
        &lt;tns4:ServiziRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:inputServiziAsset&gt;
                    &lt;xsl:if test="$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:idAsset"&gt;
                        &lt;tns1:idAsset&gt;
                            &lt;xsl:value-of select="$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:idAsset"/&gt;
                        &lt;/tns1:idAsset&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:id_offerta"&gt;
                        &lt;tns1:idOfferta&gt;
                            &lt;xsl:value-of select="$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:id_offerta"/&gt;
                        &lt;/tns1:idOfferta&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:id_risorsa"&gt;
                        &lt;tns1:idRisorsa&gt;
                            &lt;xsl:value-of select="$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:id_risorsa"/&gt;
                        &lt;/tns1:idRisorsa&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:statoAsset"&gt;
                        &lt;tns1:statoAsset&gt;
                            &lt;xsl:value-of select="$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:statoAsset"/&gt;
                        &lt;/tns1:statoAsset&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns1:inputServiziAsset&gt;
            &lt;/parameters&gt;
        &lt;/tns4:ServiziRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/Asset/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DettaglioAssetInvoke.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Servizi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:inputServiziAsset>&#xa;            &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:idAsset&quot;>&#xa;                &lt;tns1:idAsset>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:idAsset&quot;/>&#xa;                &lt;/tns1:idAsset>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:id_offerta&quot;>&#xa;                &lt;tns1:idOfferta>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:id_offerta&quot;/>&#xa;                &lt;/tns1:idOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:id_risorsa&quot;>&#xa;                &lt;tns1:idRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:id_risorsa&quot;/>&#xa;                &lt;/tns1:idRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:statoAsset&quot;>&#xa;                &lt;tns1:statoAsset>&#xa;                    &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:statoAsset&quot;/>&#xa;                &lt;/tns1:statoAsset>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:inputServiziAsset>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="DettaglioAssetInvokeToCopy_1_AssetTrovato"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ServiziToSubcontractor">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    <bpws:source linkName="ServiziToCallProcess_Consistenza">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$get1/parameters/tns3:Asset-DettaglioAssetGetParameters/flagConsistenza='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$get1.parameters/flagConsistenza='Y']]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="getConfigurazioneFE-input"
                                    name="getConfigurazioneFE"
                                    outputVariable="getConfigurazioneFE"
                                    tibex:xpdlId="aa694a4b-3fc5-4053-8342-7a804eb843c8"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery2TogetConfigurazioneFE"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="getConfigurazioneFEToSubcontractor"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ConfigurazioneFE&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;getConfigurazioneFE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:InputConfigurazioneFE>&#xa;            &lt;tns3:codFunzione>&#xa;                &lt;xsl:value-of select=&quot;'C11M08F38'&quot;/>&#xa;            &lt;/tns3:codFunzione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($RecuperoOfferta/Record[1]/OFFERTA, 'NP') = true()&quot;>&#xa;                    &lt;tns3:offerta>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(concat($RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG,'+','NP'))&quot;/>&#xa;                    &lt;/tns3:offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:offerta>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG)&quot;/>&#xa;                    &lt;/tns3:offerta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:InputConfigurazioneFE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_creazioneOrdine.sub.ConfigurazioneFEsub" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty" tibex:xpdlId="f3425e91-797d-456f-a835-82be4332d3b7">
                                <bpws:targets>
                                    <bpws:target linkName="get_Asset_InLog_INFOToEmpty"/>
