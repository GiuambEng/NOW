                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;get1&quot;/>&#xa;    &lt;xsl:param name=&quot;outputDettaglioVariable&quot;/>&#xa;    &lt;xsl:template name=&quot;get_Asset_outp_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Asset&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.Asset&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$get1/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get1/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputDettaglioAsset:&amp;quot;,tib:render-xml($outputDettaglioVariable))&quot;/>&#xa;                &lt;/tns5:Payload>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &