Invoke.parameters/tns1:oaoDonating&quot;/>&#xa;                            &lt;/tns:oaoDonating>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:oaoDonor&quot;>&#xa;                            &lt;tns:oaoDonor>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:oaoDonor&quot;/>&#xa;                            &lt;/tns:oaoDonor>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:statoAsset&quot;>&#xa;                            &lt;tns:statoAsset>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:statoAsset&quot;/>&#xa;                            &lt;/tns:statoAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:nome&quot;>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:nome&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:cognome_ragSociale&quot;>&#xa;                            &lt;tns:cognome_ragSociale>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:cognome_ragSociale&quot;/>&#xa;                            &lt;/tns:cognome_ragSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:CF&quot;>&#xa;                            &lt;tns:CF>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:CF&quot;/>&#xa;                            &lt;/tns:CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:P.IVA&quot;>&#xa;                            &lt;tns:P.IVA>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:P.IVA&quot;/>&#xa;                            &lt;/tns:P.IVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Servizi.parameters/tns1:outputServizi&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(tns1:prodotto)>0&quot;>&#xa;                                    &lt;tns:servizi>&#xa;                                        &lt;xsl:for-each select=&quot;tns1:customizzazione/tns1:outputVisualizzazioneCustomizzazione[tns1:attributoCustomizzazione!='DESCR_BMD']&quot;>&#xa;                                            &lt;xsl:if test=&quot;(tns1:attributoCustomizzazione='DATARESTITUZIONEPRODOTTI' and tns1:valoreCustomizzazione !='01-01-1900') or (tns1:attributoCustomizzazione='CONTRIBUTOCESSAZIONEFWA' and $get1.parameters/tipoProfilo = ('CRM_DG','CRM_DG_SUPER')) or ((tns1:attributoCustomizzazione !='DATARESTITUZIONEPRODOTTI') and (tns1:attributoCustomizzazione !='CONTRIBUTOCESSAZIONEFWA'))&quot;>&#xa;                                                &lt;tns:customizzazione>&#xa;                                                    &lt;xsl:if test=&quot;tns1:attributoCustomizzazione&quot;>&#xa;                                                        &lt;tns:attributoCustomizzazione>&#xa;                                                            &lt;xsl:value-of select=&quot;tns1:attributoCustomizzazione&quot;/>&#xa;                                                        &lt;/tns:attributoCustomizzazione>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;tns1:attributoCustomizzazione='FLAGMULTICAST' and tns1:valoreCustomizzazione = 'SI'&quot;>&#xa;                                                            &lt;tns:valoreCustomizzazione>&#xa;                                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                            &lt;/tns:valoreCustomizzazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;tns1:attributoCustomizzazione='PROFILOBMD'&quot;>&#xa;                                                            &lt;xsl:if test=&quot;current()/..[1]/tns1:outputVisualizzazioneCustomizzazione[tns1:attributoCustomizzazione='DESCR_BMD']/tns1:valoreCustomizzazione&quot;>&#xa;                                                                &lt;tns:valoreCustomizzazione>&#xa;                                                                    &lt;xsl:value-of select=&quot;current()/..[1]/tns1:outputVisualizzazioneCustomizzazione[tns1:attributoCustomizzazione='DESCR_BMD']/tns1:valoreCustomizzazione&quot;/>&#xa;                                                                &lt;/tns:valoreCustomizzazione>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;xsl:if test=&quot;tns1:valoreCustomizzazione&quot;>&#xa;                                                                &lt;tns:valoreCustomizzazione>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns1:valoreCustomizzazione&quot;/>&#xa;                                                                &lt;/tns:valoreCustomizzazione>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/tns:customizzazione>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;xsl:if test=&quot;tns1:prodotto&quot;>&#xa;                                            &lt;tns:prodotto>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:prodotto&quot;/>&#xa;                                            &lt;/tns:prodotto>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns:servizi>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                                &lt;tns:caratteristicaNP>&#xa;                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                &lt;/tns:caratteristicaNP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:caratteristicaNP>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/tns:caratteristicaNP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:nomeOffertaCatalogo&quot;>&#xa;                            &lt;tns:nomeOffertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:nomeOffertaCatalogo&quot;/>&#xa;                            &lt;/tns:nomeOffertaCatalogo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codSlaAssurance&quot;>&#xa;                            &lt;tns:codSlaAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codSlaAssurance&quot;/>&#xa;                            &lt;/tns:codSlaAssurance>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codIstatComune&quot;>&#xa;                            &lt;tns:codIstatComune>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codIstatComune&quot;/>&#xa;                            &lt;/tns:codIstatComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:opzioneDinamica&quot;>&#xa;                            &lt;tns:opzioneDinamica>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:opzioneDinamica&quot;/>&#xa;                            &lt;/tns:opzioneDinamica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:statoServizioDinamico&quot;>&#xa;                            &lt;tns:statoServizioDinamico>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:statoServizioDinamico&quot;/>&#xa;                            &lt;/tns:statoServizioDinamico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:ordineOao&quot;>&#xa;                            &lt;tns:ordineOao>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:ordineOao&quot;/>&#xa;                            &lt;/tns:ordineOao>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:ordineTI&quot;>&#xa;                            &lt;tns:ordineTI>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:ordineTI&quot;/>&#xa;                            &lt;/tns:ordineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:idRisorsaOperatoreRete&quot;>&#xa;                            &lt;tns:idRisorsaOperatoreRete>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:idRisorsaOperatoreRete&quot;/>&#xa;                            &lt;/tns:idRisorsaOperatoreRete>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Subcontractor/Record&quot;>&#xa;                            &lt;tns:listaSubcontractor>&#xa;                                &lt;tns:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEVLAN&quot;/>&#xa;                                &lt;/tns:idRisorsa>&#xa;                                &lt;tns:codOaoSubcontractor>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEOLO&quot;/>&#xa;                                &lt;/tns:codOaoSubcontractor>&#xa;                                &lt;xsl:if test=&quot;CODICEOLOTITOLARE&quot;>&#xa;                                    &lt;tns:codOaoTitolare>&#xa;                                        &lt;xsl:value-of select=&quot;CODICEOLOTITOLARE&quot;/>&#xa;                                    &lt;/tns:codOaoTitolare>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;DATAFINEVALIDITA&quot;>&#xa;                                    &lt;tns:dataInserimentoSubcontractor>&#xa;                                        &lt;xsl:value-of select=&quot;DATAFINEVALIDITA&quot;/>&#xa;                                    &lt;/tns:dataInserimentoSubcontractor>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:listaSubcontractor>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:operatoreRete&quot;>&#xa;                            &lt;tns:operatoreRete>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:operatoreRete&quot;/>&#xa;                            &lt;/tns:operatoreRete>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$RecuperaDatiMulticast/Record&quot;>&#xa;                            &lt;tns:datiMulticast>&#xa;                                &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                    &lt;tns:idRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                    &lt;/tns:idRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;TIPOLOGIAASSOCIAZIONE&quot;>&#xa;                                    &lt;tns:tipologia>&#xa;                                        &lt;xsl:value-of select=&quot;TIPOLOGIAASSOCIAZIONE&quot;/>&#xa;                                    &lt;/tns:tipologia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns:dataAbilitazione>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATAINIZIOVALIDITA), 'T')&quot;/>&#xa;                                &lt;/tns:dataAbilitazione>&#xa;                            &lt;/tns:datiMulticast>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:statoDisabilitazioneAsset&quot;>&#xa;                            &lt;tns:statoDisabilitazioneAsset>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:statoDisabilitazioneAsset&quot;/>&#xa;                            &lt;/tns:statoDisabilitazioneAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:caratterizzazioneArea&quot;>&#xa;                            &lt;tns:caratterizzazioneArea>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:caratterizzazioneArea&quot;/>&#xa;                            &lt;/tns:caratterizzazioneArea>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:ontOperatore&quot;>&#xa;                            &lt;tns:ontOperatore>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:ontOperatore&quot;/>&#xa;                            &lt;/tns:ontOperatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:modelloServizioPerValidazioni&quot;>&#xa;                            &lt;tns:modelloServizioPerValidazioni>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:modelloServizioPerValidazioni&quot;/>&#xa;                            &lt;/tns:modelloServizioPerValidazioni>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codiceOperatoreSecondario&quot;>&#xa;                            &lt;tns:codiceOperatoreSecondario>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codiceOperatoreSecondario&quot;/>&#xa;                            &lt;/tns:codiceOperatoreSecondario>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:descrizioneOperatoreSecondario&quot;>&#xa;                            &lt;tns:descrizioneOperatoreSecondario>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:descrizioneOperatoreSecondario&quot;/>&#xa;                            &lt;/tns:descrizioneOperatoreSecondario>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:outputAssetDetails>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputAssetDetails>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($DettaglioAssetInvoke.parameters/tns1:idAsset)>0 and $get1.parameters/flagConsistenza='Y'&quot;>&#xa;                &lt;tns:OutputAssetDetails>&#xa;                    &lt;tns:outputAssetDetails>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codOAOAgcom&quot;>&#xa;                            &lt;tns:codOAOAgcom>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codOAOAgcom&quot;/>&#xa;                            &lt;/tns:codOAOAgcom>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:dec>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($DettaglioAssetInvoke.parameters/tns1:dec, &amp;quot;T&amp;quot;)&quot;/>&#xa;                        &lt;/tns:dec>&#xa;                        &lt;tns:des>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($DettaglioAssetInvoke.parameters/tns1:des, &amp;quot;T&amp;quot;)&quot;/>&#xa;                        &lt;/tns:des>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:centrale&quot;>&#xa;                            &lt;tns:centrale>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:centrale&quot;/>&#xa;                            &lt;/tns:centrale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:desPrimoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($DettaglioAssetInvoke.parameters/tns1:desPrimoOrdine, &amp;quot;T&amp;quot;)&quot;/>&#xa;                        &lt;/tns:desPrimoOrdine>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:identificativoAssetDa&quot;>&#xa;                            &lt;tns:identificativoAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:identificativoAssetDa&quot;/>&#xa;                            &lt;/tns:identificativoAssetDa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:identificativoContratto&quot;>&#xa;                            &lt;tns:identificativoContratto>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:identificativoContratto&quot;/>&#xa;                            &lt;/tns:identificativoContratto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codcontratto&quot;>&#xa;                            &lt;tns:codcontratto>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codcontratto&quot;/>&#xa;                            &lt;/tns:codcontratto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:nomecontratto&quot;>&#xa;                            &lt;tns:nomecontratto>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:nomecontratto&quot;/>&#xa;                            &lt;/tns:nomecontratto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:statoContratto&quot;>&#xa;                            &lt;tns:statoContratto>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:statoContratto&quot;/>&#xa;                            &lt;/tns:statoContratto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:primoOrdineTI&quot;>&#xa;                            &lt;tns:primoOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:primoOrdineTI&quot;/>&#xa;                            &lt;/tns:primoOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codiceOrdineOAOPrimoOrdine&quot;>&#xa;                            &lt;tns:codiceOrdineOAOPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codiceOrdineOAOPrimoOrdine&quot;/>&#xa;                            &lt;/tns:codiceOrdineOAOPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:provincia&quot;>&#xa;                            &lt;tns:provincia>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:provincia&quot;/>&#xa;                            &lt;/tns:provincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:comune&quot;>&#xa;                            &lt;tns:comune>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:comune&quot;/>&#xa;                            &lt;/tns:comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:localita&quot;>&#xa;                            &lt;tns:localita>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:localita&quot;/>&#xa;                            &lt;/tns:localita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:descParticellaToponomastica&quot;>&#xa;                            &lt;tns:descParticellaToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:descParticellaToponomastica&quot;/>&#xa;                            &lt;/tns:descParticellaToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codiceToponomastica&quot;>&#xa;                            &lt;tns:codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codiceToponomastica&quot;/>&#xa;                            &lt;/tns:codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:via&quot;>&#xa;                            &lt;tns:via>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:via&quot;/>&#xa;                            &lt;/tns:via>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:numero&quot;>&#xa;                            &lt;tns:numero>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:numero&quot;/>&#xa;                            &lt;/tns:numero>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:cap&quot;>&#xa;                            &lt;tns:cap>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:cap&quot;/>&#xa;                            &lt;/tns:cap>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:complesso&quot;>&#xa;                            &lt;tns:complesso>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:complesso&quot;/>&#xa;                            &lt;/tns:complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:interno&quot;>&#xa;                            &lt;tns:interno>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:interno&quot;/>&#xa;                            &lt;/tns:interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:scala&quot;>&#xa;                            &lt;tns:scala>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:scala&quot;/>&#xa;                            &lt;/tns:scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:piano&quot;>&#xa;                            &lt;tns:piano>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:piano&quot;/>&#xa;                            &lt;/tns:piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:lineariferimento&quot;>&#xa;                            &lt;tns:lineariferimento>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:lineariferimento&quot;/>&#xa;                            &lt;/tns:lineariferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:lna_la&quot;>&#xa;                            &lt;tns:lna_la>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:lna_la&quot;/>&#xa;                            &lt;/tns:lna_la>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:modalitaFatturazione&quot;>&#xa;                            &lt;tns:modalitaFatturazione>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:modalitaFatturazione&quot;/>&#xa;                            &lt;/tns:modalitaFatturazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:numeroTelefonica&quot;>&#xa;                            &lt;tns:numeroTelefonica>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:numeroTelefonica&quot;/>&#xa;                            &lt;/tns:numeroTelefonica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:operatore&quot;>&#xa;                            &lt;tns:operatore>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:operatore&quot;/>&#xa;                            &lt;/tns:operatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:oraDes&quot;>&#xa;                            &lt;tns:oraDes>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:oraDes&quot;/>&#xa;                            &lt;/tns:oraDes>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:ro&quot;>&#xa;                            &lt;tns:ro>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:ro&quot;/>&#xa;                            &lt;/tns:ro>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:timeStampAggiornamentoAsset>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($DettaglioAssetInvoke.parameters/tns1:timeStampAggiornamentoAsset,&amp;quot;T&amp;quot;)&quot;/>&#xa;                        &lt;/tns:timeStampAggiornamentoAsset>&#xa;                        &lt;tns:timeInserimentoAsset>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($DettaglioAssetInvoke.parameters/tns1:timeInserimentoAsset,&amp;quot;T&amp;quot;)&quot;/>&#xa;                        &lt;/tns:timeInserimentoAsset>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:tipoServizio&quot;>&#xa;                            &lt;tns:tipoServizio>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:tipoServizio&quot;/>&#xa;                            &lt;/tns:tipoServizio>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:id_offerta&quot;>&#xa;                            &lt;tns:id_offerta>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:id_offerta&quot;/>&#xa;                            &lt;/tns:id_offerta>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:numeroFittizio&quot;>&#xa;                            &lt;tns:numeroFittizio>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:numeroFittizio&quot;/>&#xa;                            &lt;/tns:numeroFittizio>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:idAssetCRMWS>&#xa;                            &lt;xsl:value-of select=&quot;string($DettaglioAssetInvoke.parameters/tns1:idAssetCRMWS)&quot;/>&#xa;                        &lt;/tns:idAssetCRMWS>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:id_risorsa&quot;>&#xa;                            &lt;tns:id_risorsa>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:id_risorsa&quot;/>&#xa;                            &lt;/tns:id_risorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:idRisorsaNow&quot;>&#xa;                            &lt;tns:idRisorsaNow>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:idRisorsaNow&quot;/>&#xa;                            &lt;/tns:idRisorsaNow>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:idAsset>&#xa;                            &lt;xsl:value-of select=&quot;string($DettaglioAssetInvoke.parameters/tns1:idAsset)&quot;/>&#xa;                        &lt;/tns:idAsset>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:oaoDonating&quot;>&#xa;                            &lt;tns:oaoDonating>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:oaoDonating&quot;/>&#xa;                            &lt;/tns:oaoDonating>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:oaoDonor&quot;>&#xa;                            &lt;tns:oaoDonor>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:oaoDonor&quot;/>&#xa;                            &lt;/tns:oaoDonor>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:statoAsset&quot;>&#xa;                            &lt;tns:statoAsset>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:statoAsset&quot;/>&#xa;                            &lt;/tns:statoAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:nome&quot;>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:nome&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:cognome_ragSociale&quot;>&#xa;                            &lt;tns:cognome_ragSociale>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:cognome_ragSociale&quot;/>&#xa;                            &lt;/tns:cognome_ragSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:CF&quot;>&#xa;                            &lt;tns:CF>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:CF&quot;/>&#xa;                            &lt;/tns:CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:P.IVA&quot;>&#xa;                            &lt;tns:P.IVA>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:P.IVA&quot;/>&#xa;                            &lt;/tns:P.IVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Servizi.parameters/tns1:outputServizi&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(tns1:prodotto)>0 and contains(tib:concat-sequence-format($getConfigurazioneFE/tns3:outputConfigurazioneFE/tns3:codice, &amp;quot;','&amp;quot;, true()),tns1:prodotto)&quot;>&#xa;                                    &lt;tns:servizi>&#xa;                                        &lt;xsl:for-each select=&quot;tns1:customizzazione/tns1:outputVisualizzazioneCustomizzazione[tns1:attributoCustomizzazione!='DESCR_BMD']&quot;>&#xa;                                            &lt;xsl:if test=&quot;(tns1:attributoCustomizzazione='DATARESTITUZIONEPRODOTTI' and tns1:valoreCustomizzazione !='01-01-1900') or (tns1:attributoCustomizzazione !='DATARESTITUZIONEPRODOTTI')&quot;>&#xa;                                                &lt;tns:customizzazione>&#xa;                                                    &lt;xsl:if test=&quot;tns1:attributoCustomizzazione&quot;>&#xa;                                                        &lt;tns:attributoCustomizzazione>&#xa;                                                            &lt;xsl:value-of select=&quot;tns1:attributoCustomizzazione&quot;/>&#xa;                                                        &lt;/tns:attributoCustomizzazione>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;current()/tns1:attributoCustomizzazione='FLAGMULTICAST' and tns1:valoreCustomizzazione = 'SI'&quot;>&#xa;                                                            &lt;tns:valoreCustomizzazione>&#xa;                                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                            &lt;/tns:valoreCustomizzazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;current()/tns1:attributoCustomizzazione='PROFILOBMD'&quot;>&#xa;                                                            &lt;xsl:if test=&quot;current()/..[1]/tns1:outputVisualizzazioneCustomizzazione[tns1:attributoCustomizzazione='DESCR_BMD']/tns1:valoreCustomizzazione&quot;>&#xa;                                                                &lt;tns:valoreCustomizzazione>&#xa;                                                                    &lt;xsl:value-of select=&quot;current()/..[1]/tns1:outputVisualizzazioneCustomizzazione[tns1:attributoCustomizzazione='DESCR_BMD']/tns1:valoreCustomizzazione&quot;/>&#xa;                                                                &lt;/tns:valoreCustomizzazione>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;xsl:if test=&quot;tns1:valoreCustomizzazione&quot;>&#xa;                                                                &lt;tns:valoreCustomizzazione>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns1:valoreCustomizzazione&quot;/>&#xa;                                                                &lt;/tns:valoreCustomizzazione>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/tns:customizzazione>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;xsl:if test=&quot;tns1:prodotto&quot;>&#xa;                                            &lt;tns:prodotto>&#xa;                                                &lt;xsl:value-of select=&quot;tns1:prodotto&quot;/>&#xa;                                            &lt;/tns:prodotto>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns:servizi>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                                &lt;tns:caratteristicaNP>&#xa;                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                &lt;/tns:caratteristicaNP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:caratteristicaNP>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/tns:caratteristicaNP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:nomeOffertaCatalogo&quot;>&#xa;                            &lt;tns:nomeOffertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:nomeOffertaCatalogo&quot;/>&#xa;                            &lt;/tns:nomeOffertaCatalogo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codSlaAssurance&quot;>&#xa;                            &lt;tns:codSlaAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codSlaAssurance&quot;/>&#xa;                            &lt;/tns:codSlaAssurance>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codIstatComune&quot;>&#xa;                            &lt;tns:codIstatComune>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codIstatComune&quot;/>&#xa;                            &lt;/tns:codIstatComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:opzioneDinamica&quot;>&#xa;                            &lt;tns:opzioneDinamica>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:opzioneDinamica&quot;/>&#xa;                            &lt;/tns:opzioneDinamica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:statoServizioDinamico&quot;>&#xa;                            &lt;tns:statoServizioDinamico>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:statoServizioDinamico&quot;/>&#xa;                            &lt;/tns:statoServizioDinamico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:ordineOao&quot;>&#xa;                            &lt;tns:ordineOao>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:ordineOao&quot;/>&#xa;                            &lt;/tns:ordineOao>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:ordineTI&quot;>&#xa;                            &lt;tns:ordineTI>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:ordineTI&quot;/>&#xa;                            &lt;/tns:ordineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:idRisorsaOperatoreRete&quot;>&#xa;                            &lt;tns:idRisorsaOperatoreRete>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:idRisorsaOperatoreRete&quot;/>&#xa;                            &lt;/tns:idRisorsaOperatoreRete>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Subcontractor/Record&quot;>&#xa;                            &lt;tns:listaSubcontractor>&#xa;                                &lt;tns:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEVLAN&quot;/>&#xa;                                &lt;/tns:idRisorsa>&#xa;                                &lt;tns:codOaoSubcontractor>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEOLO&quot;/>&#xa;                                &lt;/tns:codOaoSubcontractor>&#xa;                                &lt;xsl:if test=&quot;CODICEOLOTITOLARE&quot;>&#xa;                                    &lt;tns:codOaoTitolare>&#xa;                                        &lt;xsl:value-of select=&quot;CODICEOLOTITOLARE&quot;/>&#xa;                                    &lt;/tns:codOaoTitolare>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;DATAFINEVALIDITA&quot;>&#xa;                                    &lt;tns:dataInserimentoSubcontractor>&#xa;                                        &lt;xsl:value-of select=&quot;DATAFINEVALIDITA&quot;/>&#xa;                                    &lt;/tns:dataInserimentoSubcontractor>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:listaSubcontractor>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:operatoreRete&quot;>&#xa;                            &lt;tns:operatoreRete>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:operatoreRete&quot;/>&#xa;                            &lt;/tns:operatoreRete>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$RecuperaDatiMulticast/Record&quot;>&#xa;                            &lt;tns:datiMulticast>&#xa;                                &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                    &lt;tns:idRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                    &lt;/tns:idRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;TIPOLOGIAASSOCIAZIONE&quot;>&#xa;                                    &lt;tns:tipologia>&#xa;                                        &lt;xsl:value-of select=&quot;TIPOLOGIAASSOCIAZIONE&quot;/>&#xa;                                    &lt;/tns:tipologia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns:dataAbilitazione>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATAINIZIOVALIDITA), 'T')&quot;/>&#xa;                                &lt;/tns:dataAbilitazione>&#xa;                            &lt;/tns:datiMulticast>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:statoDisabilitazioneAsset&quot;>&#xa;                            &lt;tns:statoDisabilitazioneAsset>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:statoDisabilitazioneAsset&quot;/>&#xa;                            &lt;/tns:statoDisabilitazioneAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:caratterizzazioneArea&quot;>&#xa;                            &lt;tns:caratterizzazioneArea>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:caratterizzazioneArea&quot;/>&#xa;                            &lt;/tns:caratterizzazioneArea>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:ontOperatore&quot;>&#xa;                            &lt;tns:ontOperatore>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:ontOperatore&quot;/>&#xa;                            &lt;/tns:ontOperatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:modelloServizioPerValidazioni&quot;>&#xa;                            &lt;tns:modelloServizioPerValidazioni>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:modelloServizioPerValidazioni&quot;/>&#xa;                            &lt;/tns:modelloServizioPerValidazioni>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codiceOperatoreSecondario&quot;>&#xa;                            &lt;tns:codiceOperatoreSecondario>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codiceOperatoreSecondario&quot;/>&#xa;                            &lt;/tns:codiceOperatoreSecondario>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:descrizioneOperatoreSecondario&quot;>&#xa;                            &lt;tns:descrizioneOperatoreSecondario>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:descrizioneOperatoreSecondario&quot;/>&#xa;                            &lt;/tns:descrizioneOperatoreSecondario>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:outputAssetDetails>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputAssetDetails>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OutputAssetDetails>&#xa;                    &lt;tns:outputAssetDetails/>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputAssetDetails>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:name