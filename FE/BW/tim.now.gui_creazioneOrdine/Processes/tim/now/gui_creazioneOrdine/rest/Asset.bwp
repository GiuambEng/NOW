                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160421170250PLT/ConceptSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ConfigurazioneFE&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DettaglioAssetInvoke&quot;/>&lt;xsl:param name=&quot;Servizi&quot;/>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:param name=&quot;getConfigurazioneFE&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Subcontractor&quot;/>&lt;xsl:param name=&quot;RecuperaDatiMulticast&quot;/>&lt;xsl:template name=&quot;outputDettaglioVariable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:idAsset)>0 and $get1/parameters/tns2:Asset-DettaglioAssetGetParameters/flagConsistenza!='Y'&quot;>&lt;tns:OutputAssetDetails>&lt;tns:outputAssetDetails>&lt;xsl:if test=&quot;$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:codOAOAgcom&quot;>&lt;tns:codOAOAgcom>&lt;xsl:value-of select=&quot;$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:codOAOAgcom&quot;/>&lt;/tns:codOAOAgcom>&lt;/xsl:if>&lt;tns:dec>&lt;xsl:value-of select=&quot;substring-before($DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:dec, &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dec>&lt;tns:des>&lt;xsl:value-of select=&quot;substring-before($DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:des, &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:des>&lt;xsl:if test=&quot;$DettaglioAssetInvoke/parameters/tns1:OutputAssetDetails/tns1:centrale&quot;>&lt;tns:central