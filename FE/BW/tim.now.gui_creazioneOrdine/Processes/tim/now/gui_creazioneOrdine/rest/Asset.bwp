                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e16fc1e3-8697-4399-8044-87e7601508a4+input&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160421170250PLT/ConceptSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1&quot;/>&#xa;    &lt;xsl:template name=&quot;Subcontractor-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;idRisorsa>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get1/parameters/tns2:Asset-DettaglioAssetGetParameters/idRisorsa)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get1/parameters/tns2:Asset-DettaglioAssetGetParameters/idRisorsa&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRisorsa>&#xa;            &lt;idRisorsa1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get1/parameters/tns2:Asset-DettaglioAssetGetParameters/idRisorsa)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get1/parameters/tns2:Asset-DettaglioAssetGetParameters/idRisorsa&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idRisorsa1>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
