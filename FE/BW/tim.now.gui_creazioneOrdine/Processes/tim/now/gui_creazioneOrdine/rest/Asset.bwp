        &lt;tns5:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($post/item/tns7:inputservizioricercaavanzata/tns7:exportRequest) and (upper-case($post/item/tns7:inputservizioricercaavanzata/tns7:exportRequest)='S' or upper-case($post/item/tns7:inputservizioricercaavanzata/tns7:exportRequest)='Y')"&gt;
