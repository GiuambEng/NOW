                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettagliasset&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/AssetDetails&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160421170250PLT/ConceptSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ConfigurazioneFE&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioAssetInvoke.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Servizi.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;getConfigurazioneFE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;Subcontractor&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaDatiMulticast&quot;/>&#xa;    &lt;xsl:template name=&quot;outputDettaglioVariable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($DettaglioAssetInvoke.parameters/tns1:idAsset)>0 and $get1.parameters/flagConsistenza!='Y'&quot;>&#xa;                &lt;tns:OutputAssetDetails>&#xa;                    &lt;tns:outputAssetDetails>&#xa;                        &lt;xsl:if test=&quot;$DettaglioAssetInvoke.parameters/tns1:codOAOAgcom&quot;>&#xa;                            &lt;tns:codOAOAgcom>&#xa;                                &lt;xsl:value-of select=&quot;$DettaglioAssetInvoke.parameters/tns1:codOAOAgcom&quot;/>&#xa;                            &lt;/tns:codOAOAgcom>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:dec>&#xa;                            &lt;xsl:value-of select=&quot;substring-before($DettaglioAssetInvoke.parameters/tns1:dec, &amp;quot;T&amp;quot;)&quot;/>&#xa;                      