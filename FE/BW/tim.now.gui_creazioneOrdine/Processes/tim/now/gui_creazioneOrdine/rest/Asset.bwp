                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+130bb01e-36c6-44ef-bd66-7f48fbcb7823+input&quot; xmlns:tns4=&quot;http://xmlns.example.com/Asset/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoFeederCanale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;idAsset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get2/parameters/tns4:feederdettaglioassetGetParameters/tns4:idAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get2/parameters/tns4:feederdettaglioassetGetParameters/tns4:idAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idAsset>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
