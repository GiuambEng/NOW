                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT C.DESCR_COMUNE&#xa;FROM PROVINCIA_EOLO P, COMUNEO_LOCALITA_EOLO C&#xa;WHERE P.CODISTATPROV = C.CODISTATPROV AND upper(TRIM(P.DESCR_PROV)) = upper(?)&#xa;ORDER BY C.DESCR_COMUNE" xsi:type="jdbcPalette:JDBCQueryActivity">

