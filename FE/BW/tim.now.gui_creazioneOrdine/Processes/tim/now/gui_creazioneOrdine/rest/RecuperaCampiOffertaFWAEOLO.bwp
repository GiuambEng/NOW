                                    inputVariable="JDBCQuery5-input"
                                    name="JDBCQuery5"
                                    outputVariable="JDBCQuery5"
                                    tibex:xpdlId="a8444253-3699-472b-8ed3-2ae5a7388bdc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
