                <bpws:onMessage operation="post"
                    partnerLink="visualizzazionesvlancode"
                    portType="ns:visualizzazionesvlancode"
                    tibex:xpdlId="a95877be-bb2b-4f41-b3c3-52d32e3b06f3" variable="post">
