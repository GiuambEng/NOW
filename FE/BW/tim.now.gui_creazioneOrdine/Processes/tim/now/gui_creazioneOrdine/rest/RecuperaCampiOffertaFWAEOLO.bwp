:indirizzo)&amp;lt;3&quot;>&lt;DESCR_INDIRIZZO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns4:autocompletamentodatisedeGetParameters/tns4:indirizzo)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns4:autocompletamentodatisedeGetParameters/tns4:indirizzo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_INDIRIZZO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_INDIRIZZO>&lt;xsl:value-of select=&quot;concat('%',$get/parameters/tns4:autocompletamentodatisedeGetParameters/tns4:indirizzo,'%')&quot;/>&lt;/DESCR_INDIRIZZO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns3:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
