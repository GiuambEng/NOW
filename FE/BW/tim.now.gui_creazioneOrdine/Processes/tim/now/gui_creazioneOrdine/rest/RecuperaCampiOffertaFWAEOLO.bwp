hoose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns4:autocompletamentodatisedeGetParameters/tns4:particellaToponomastica)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get/parameters/tns4:autocompletamentodatisedeGetParameters/tns4:particellaToponomastica&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_PARTICELLA_TOPON>&#xa;            &lt;DESCR_VIA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns4:autocompletamentodatisedeGetParameters/tns4:indirizzo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get/parameters/tns4:autocompletamentodatisedeGetParameters/tns4:indirizzo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_VIA>&#xa;        &lt;/tns8:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
