                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+aa66ada4-47fd-4e61-888d-010877e2a1a7+input&quot; xmlns:tns4=&quot;http://xmlns.example.com/RecuperaCampiOffertaFWAEOLO/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;DESCR_PROV>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns4:provincia)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns4:provincia&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_PROV>&#xa;            &lt;DESCR_COMUNE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns4:comune)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns4:comune&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_COMUNE>&#xa;            &lt;DESCR_PARTICELLA_TOPON>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns4:particellaToponomastica)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns4:particellaToponomastica&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_PARTICELLA_TOPON>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($get.parameters/tns4:indirizzo)&amp;lt;3&quot;>&#xa;                    &lt;DESCR_INDIRIZZO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($get.parameters/tns4:indirizzo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$get.parameters/tns4:indirizzo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DESCR_INDIRIZZO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_INDIRIZZO>&#xa;                        &lt;xsl:value-of select=&quot;concat('%',$get.parameters/tns4:indirizzo,'%')&quot;/>&#xa;                    &lt;/DESCR_INDIRIZZO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
