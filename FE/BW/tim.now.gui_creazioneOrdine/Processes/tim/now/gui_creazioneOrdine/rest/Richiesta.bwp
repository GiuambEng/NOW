                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichiestaAnnullamento&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;RichiestaDesospensione&quot;/>&lt;xsl:param name=&quot;RichiestaCancAccod&quot;/>&lt;xsl:param name=&quot;VariableRichiestaOloRegolatorio&quot;/>&lt;xsl:param name=&quot;VisualizzazioneDettaglioOrdine&quot;/>&lt;xsl:param name=&quot;VariableRichiestaOloXDSL&quot;/>&lt;xsl:param name=&quot;VariableRichiestaOloNGA&quot;/>&lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&lt;xsl:param name=&quot;DRO&quot;/>&lt;xsl:param name=&quot;RichiestaInterruzioneMigrazione&quot;/>&lt;xsl:param name=&quot;RichiestaRimodDacRecipient&quot;/>&lt;xsl:param name=&quot;RichiestaAccettazioneOpereSpeciali&quot;/>&lt;xsl:param name=&quot;RichiestaRiscontroCodiceSessione&quot;/>&lt;xsl:param name=&quot;RichiestaPreventivo&quot;/>&lt;xsl:param name=&quot;calcoloDRO&quot;/>&lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&lt;xsl:template name=&quot;VariableRichiestaElement&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;'abc'&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaAnnullamento&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaDesospensione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaCancAccod&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CANCELLAZIONEACCODAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaInterruzioneMigrazione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaRimodDacRecipient&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDACDARECIPIENT&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaAccettazioneOpereSpeciali&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ACCETTAZIONEOPERESPECIALI&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaRiscontroCodiceSessione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RISCONTROCODICESESSIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaPreventivo&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RICHIESTAPREVENTIVOOPERESPECIALI&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = (1,2,3,4,5,6,21,22,23,24,25,26,27,28,29)&quot;>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = (15,16,17,18,44,45,61,62,65,66,67,68,69,76,77,78,79,80)&quot;>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 75&quot;>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FIBERSTREAM&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:OAO&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceRichiesta&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceRichiesta&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:codiceOrdineOlo&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:codiceOrdineOlo&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta) !=$RichiestaInterruzioneMigrazione&quot;>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:noteDaOperatore&quot;>&lt;note>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:noteDaOperatore&quot;/>&lt;/note>&lt;/xsl:if>&lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/OFFERTA&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/OFFERTA&quot;/>&lt;/offerta>&lt;/xsl:if>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:DAD&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:DAD&quot;/>&lt;/DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:FasciaOraria&quot;>&lt;IDFasciaOraria>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:FasciaOraria&quot;/>&lt;/IDFasciaOraria>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($VisualizzazioneDettaglioOrdine/Record/IDOFFERTA)&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA)&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns2:Response/tns2:outputDate) !=0&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns2:Response/tns2:outputDate&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;$DRO/parameters/tns2:Response/tns2:outputDate&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaRimodDacRecipient&quot;>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:dac&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:dac&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaRiscontroCodiceSessione and (string-length($VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaOk) >0 or string-length(xsd:string($VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:OK)) >0 or string-length(xsd:string($VariableRichiestaOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione/ns0:StatoRichiesta/ns0:OK)) >0)&quot;>&lt;esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/esito>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaRiscontroCodiceSessione and not(string-length($VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaOk) >0 or string-length(xsd:string($VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:OK)) >0 or string-length(xsd:string($VariableRichiestaOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione/ns0:StatoRichiesta/ns0:OK)) >0)&quot;>&lt;esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/esito>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns:NuovaRichiesta/tns:flagAccettazione = 'Y'&quot;>&lt;flagOpereSpeciali>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/flagOpereSpeciali>&lt;/xsl:when>&lt;xsl:otherwise>&lt;flagOpereSpeciali>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/flagOpereSpeciali>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:noteAltreLavorazioni&quot;>&lt;noteAltreLavorazioni>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:noteAltreLavorazioni&quot;/>&lt;/noteAltreLavorazioni>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaNok/CodiceMotivoRifiutoMig) > 0&quot;>&lt;xsl:if test=&quot;$VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaNok/CodiceMotivoRifiutoMig&quot;>&lt;codiceRifiutoDonating>&lt;xsl:value-of select=&quot;$VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaNok/CodiceMotivoRifiutoMig&quot;/>&lt;/codiceRifiutoDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:KO/ns01:CodiceMotivoRifiuto) > 0&quot;>&lt;xsl:if test=&quot;$VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:KO/ns01:CodiceMotivoRifiuto&quot;>&lt;codiceRifiutoDonating>&lt;xsl:value-of select=&quot;$VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:KO/ns01:CodiceMotivoRifiuto&quot;/>&lt;/codiceRifiutoDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$VariableRichiestaOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione/ns0:StatoRichiesta/ns0:KO/ns0:CodiceMotivoRifiuto&quot;>&lt;codiceRifiutoDonating>&lt;xsl:value-of select=&quot;$VariableRichiestaOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione/ns0:StatoRichiesta/ns0:KO/ns0:CodiceMotivoRifiuto&quot;/>&lt;/codiceRifiutoDonating>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
