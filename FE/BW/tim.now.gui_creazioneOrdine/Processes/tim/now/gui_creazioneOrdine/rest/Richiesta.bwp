uovaRichiesta/tns:CodiceOrdineTI&quot;/>&lt;/CodiceOrdineFornitore>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:codiceOrdineOlo&quot;/>&lt;/CodiceOrdineOlo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Annullamento>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaRimodApp&quot;>&lt;RimodulazioneAppuntamento>&lt;CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&lt;/CodiceOrdineFornitore>&lt;DataAppuntamentoDesiderata>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($post/item/tns:NuovaRichiesta/tns:DAD), 9, 2),'/',substring(xsd:string($post/item/tns:NuovaRichiesta/tns:DAD), 6, 2),'/',substring(xsd:string($post/item/tns:NuovaRichiesta/tns:DAD), 1, 4))&quot;/>&lt;/DataAppuntamentoDesiderata>&lt;FasciaOraria>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:FasciaOraria&quot;/>&lt;/FasciaOraria>&lt;/RimodulazioneAppuntamento>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=$RichiestaDesospensione&quot;>&lt;InterruzioneSospensione>&lt;CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&lt;/CodiceOrdineFornitore>&lt;DataAppuntamentoDesiderata>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($post/item/tns:NuovaRichiesta/tns:DAD), 9, 2),'/',substring(xsd:string($post/item/tns:NuovaRichiesta/tns:DAD), 6, 2),'/',substring(xsd:string($post/item/tns:NuovaRichiesta/tns:DAD), 1, 4))&quot;/>&lt;/DataAppuntamentoDesiderata>&lt;FasciaOraria>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:FasciaOraria&quot;/>&lt;/FasciaOraria>&lt;ReferenteDesospensione>&lt;QualificaRef>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Qualifica&quot;/>&lt;/QualificaRef>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Cognome&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Nome&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Nome&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:TelefonoFissoReferente&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:TelefonoFissoReferente&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:CellulareReferente&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:CellulareReferente&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;/ReferenteDesospensione>&lt;/InterruzioneSospensione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Comunicazione>&lt;AccettazioneOpereSpeciali>&lt;CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&lt;/CodiceOrdineFornitore>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns:NuovaRichiesta/tns:flagAccettazione = 'Y'&quot;>&lt;FlagAccettazione>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/FlagAccettazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FlagAccettazione>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FlagAccettazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/AccettazioneOpereSpeciali>&lt;/Comunicazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Richiesta>&lt;/RichiestaOAO>&lt;/xsl:template>&lt;/xsl:stylesheet>"
