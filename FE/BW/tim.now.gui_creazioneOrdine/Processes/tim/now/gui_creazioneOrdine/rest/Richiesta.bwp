                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_AGGIORNAMENTO"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_RICHIESTA"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
