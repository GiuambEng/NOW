eratore&quot;/>&#xa;                        &lt;/Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Testata>&#xa;                &lt;Annullamento>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI) and string-length($post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI)&quot;>&#xa;                            &lt;CodiceOrdineRiferimentoTI>&#xa;                                &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                            &lt;/CodiceOrdineRiferimentoTI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CodiceOrdineOlo>&#xa;                                &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:codiceOrdineOlo&quot;/>&#xa;                            &lt;/CodiceOrdineOlo>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/Annullamento>&#xa;            &lt;/Richiesta>&#xa;        &lt;/RichiestaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
