                                    <bpws:target linkName="AssignToAssignRichiesta4"/>
                                    <bpws:target linkName="AssignXMLInterrMigrazioneXDSLToAssignRichiesta1"/>
                                    <bpws:target linkName="AssignXMLInterrMigrazioneNGAToAssignRichiesta"/>
                                    <bpws:target linkName="AssignXMLRiscontroCodiceSessioneRegolatorioToAssignRichiesta"/>
                                    <bpws:target linkName="AssignXMLRiscontroCodiceSessioneXDSLToAssignRichiesta"/>
                                    <bpws:target linkName="AssignXMLRiscontroCodiceSessioneNGAToAssignRichiesta"/>
                                    <bpws:target linkName="AssignXMLRimodDACRecipientRegolatorioToAssignRichiesta"/>
                                    <bpws:target linkName="AssignXMLRichiestaPreventivoFFTHToAssignRichiesta"/>
                                    <bpws:target linkName="Assign2ToAssignRichiesta"/>
                                    <bpws:target linkName="RichiestaFiberstreamToAssignRichiesta"/>
                                    <bpws:target linkName="AssignXMLFWAEOLOToAssignRichiesta"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignRichiestaToRenderXml"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaAnnullamento&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaDesospensione&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaCancAccod&quot;/>&#xa;    &lt;xsl:param name=&quot;VariableRichiestaOloRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneDettaglioOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;VariableRichiestaOloXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;VariableRichiestaOloNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaInterruzioneMigrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRimodDacRecipient&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaAccettazioneOpereSpeciali&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRiscontroCodiceSessione&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaPreventivo&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableRichiestaElement&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaAnnullamento&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaDesospensione&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaCancAccod&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CANCELLAZIONEACCODAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaInterruzioneMigrazione&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaRimodDacRecipient&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDACDARECIPIENT&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaAccettazioneOpereSpeciali&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ACCETTAZIONEOPERESPECIALI&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaRiscontroCodiceSessione&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RISCONTROCODICESESSIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaPreventivo&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RICHIESTAPREVENTIVOOPERESPECIALI&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = (1,2,3,4,5,6,21,22,23,24,25,26,27,28,29)&quot;>&#xa;                    &lt;strutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                    &lt;/strutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = (15,16,17,18,44,45,61,62,65,66,67,68,69,76,77,78,79,80)&quot;>&#xa;                    &lt;strutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;                    &lt;/strutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 75&quot;>&#xa;                    &lt;strutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FIBERSTREAM&amp;quot;&quot;/>&#xa;                    &lt;/strutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;strutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                    &lt;/strutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns:OAO&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:CodiceRichiesta&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:CodiceRichiesta&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceOrdineOlo&quot;>&#xa;                &lt;codiceOrdineOLOTarget>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdineOlo&quot;/>&#xa;                &lt;/codiceOrdineOLOTarget>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;upper-case($post.item/tns:CausaleRichiesta) !=$RichiestaInterruzioneMigrazione&quot;>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:CodiceOrdineTI&quot;>&#xa;                    &lt;codiceOrdineTITarget>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:CodiceOrdineTI&quot;/>&#xa;                    &lt;/codiceOrdineTITarget>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/OFFERTA&quot;>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/OFFERTA&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:DAD&quot;>&#xa;                &lt;DAD>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:DAD&quot;/>&#xa;                &lt;/DAD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:FasciaOraria&quot;>&#xa;                &lt;IDFasciaOraria>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:FasciaOraria&quot;/>&#xa;                &lt;/IDFasciaOraria>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($VisualizzazioneDettaglioOrdine/Record/IDOFFERTA)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns2:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns2:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$DRO.parameters/tns2:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaRimodDacRecipient&quot;>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:dac&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:dac&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaRiscontroCodiceSessione and (string-length($VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaOk) >0 or string-length(xsd:string($VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:OK)) >0 or string-length(xsd:string($VariableRichiestaOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione/ns0:StatoRichiesta/ns0:OK)) >0)&quot;>&#xa;                    &lt;esito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post.item/tns:CausaleRichiesta)=$RichiestaRiscontroCodiceSessione and not(string-length($VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaOk) >0 or string-length(xsd:string($VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:OK)) >0 or string-length(xsd:string($VariableRichiestaOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione/ns0:StatoRichiesta/ns0:OK)) >0)&quot;>&#xa;                    &lt;esito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/esito>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns:flagAccettazione = 'Y'&quot;>&#xa;                    &lt;flagOpereSpeciali>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/flagOpereSpeciali>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;flagOpereSpeciali>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                    &lt;/flagOpereSpeciali>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:noteAltreLavorazioni&quot;>&#xa;                &lt;noteAltreLavorazioni>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:noteAltreLavorazioni&quot;/>&#xa;                &lt;/noteAltreLavorazioni>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaNok/CodiceMotivoRifiutoMig) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaNok/CodiceMotivoRifiutoMig&quot;>&#xa;                        &lt;codiceRifiutoDonating>&#xa;                            &lt;xsl:value-of select=&quot;$VariableRichiestaOloRegolatorio/Richiesta[1]/Comunicazione/RiscontroCodiceSessione/RichiestaNok/CodiceMotivoRifiutoMig&quot;/>&#xa;                        &lt;/codiceRifiutoDonating>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:KO/ns01:CodiceMotivoRifiuto) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:KO/ns01:CodiceMotivoRifiuto&quot;>&#xa;                        &lt;codiceRifiutoDonating>&#xa;                            &lt;xsl:value-of select=&quot;$VariableRichiestaOloXDSL/ns01:Richiesta[1]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:KO/ns01:CodiceMotivoRifiuto&quot;/>&#xa;                        &lt;/codiceRifiutoDonating>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$VariableRichiestaOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione/ns0:StatoRichiesta/ns0:KO/ns0:CodiceMotivoRifiuto&quot;>&#xa;                        &lt;codiceRifiutoDonating>&#xa;                            &lt;xsl:value-of select=&quot;$VariableRichiestaOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione/ns0:StatoRichiesta/ns0:KO/ns0:CodiceMotivoRifiuto&quot;/>&#xa;                        &lt;/codiceRifiutoDonating>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariableRichiestaElement" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="createProcessInstance-input"
                                name="createProcessInstance"
                                operation="createProcessInstance"
                                outputVariable="createProcessInstance"
                                partnerLink="processManagement"
                                portType="ns1:processManagement" tibex:xpdlId="24cebf3a-5fef-4dce-a662-c4230240fc06">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tibco.com/bx/2009/management/process/BxProcessManagementService_1.10.0" xmlns:ns1="http://www.tibco.com/bx/2009/management/processManagerType" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/NuovaRichiesta" version="2.0"&gt;
    &lt;xsl:param name="RenderXml"/&gt;
    &lt;xsl:param name="RenderXmlDesospensione"/&gt;
    &lt;xsl:param name="RichiestaDesospensione"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="RecuperoSequence"/&gt;
    &lt;xsl:param name="RichiestaRimodApp"/&gt;
    &lt;xsl:template name="createProcessInstance-input" match="/"&gt;
        &lt;tns5:createProcessInstanceRequest&gt;
            &lt;params&gt;
                &lt;ns1:createProcessInstanceInput&gt;
                    &lt;ns1:processQName&gt;
                        &lt;ns1:moduleName&gt;
                            &lt;xsl:value-of select="'/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaMainProject.xpdl'"/&gt;
                        &lt;/ns1:moduleName&gt;
                        &lt;ns1:processName&gt;
                            &lt;xsl:value-of select="'TINOWAcquisizioneRichiestaMaster'"/&gt;
                        &lt;/ns1:processName&gt;
                    &lt;/ns1:processQName&gt;
                    &lt;ns1:operationName&gt;
                        &lt;xsl:value-of select="'StartEventAcquisizioneRichiestaMaster'"/&gt;
                    &lt;/ns1:operationName&gt;
                    &lt;ns1:options&gt;
                        &lt;ns1:priority&gt;
                            &lt;xsl:value-of select="310"/&gt;
                        &lt;/ns1:priority&gt;
                    &lt;/ns1:options&gt;
                    &lt;ns1:parameterMap&gt;
                        &lt;ns1:parameter&gt;
                            &lt;ns1:name&gt;
                                &lt;xsl:value-of select="'localRequest'"/&gt;
                            &lt;/ns1:name&gt;
                            &lt;ns1:value&gt;
                                &lt;xsl:value-of select="$RenderXml"/&gt;
                            &lt;/ns1:value&gt;
                        &lt;/ns1:parameter&gt;
                        &lt;ns1:parameter&gt;
                            &lt;ns1:name&gt;
                                &lt;xsl:value-of select="'AcquisitionID'"/&gt;
                            &lt;/ns1:name&gt;
                            &lt;ns1:value&gt;
                                &lt;xsl:value-of select="xsd:int($RecuperoSequence/Record[1]/NEXTVAL)"/&gt;
                            &lt;/ns1:value&gt;
                        &lt;/ns1:parameter&gt;
                        &lt;xsl:if test="upper-case($post/item/tns:NuovaRichiesta/tns:CausaleRichiesta)=($RichiestaDesospensione,$RichiestaRimodApp)"&gt;
                            &lt;ns1:parameter&gt;
                                &lt;ns1:name&gt;
                                    &lt;xsl:value-of select="'referenteAltreLavorazioni'"/&gt;
                                &lt;/ns1:name&gt;
                                &lt;ns1:value&gt;
                                    &lt;xsl:value-of select="$RenderXmlDesospensione"/&gt;
                                &lt;/ns1:value&gt;
                            &lt;/ns1:parameter&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns1:parameterMap&gt;
                &lt;/ns1:createProcessInstanceInput&gt;
            &lt;/params&gt;
        &lt;/tns5:createProcessInstanceRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/bx/2009/management/process/BxProcessManagementService_1.10.0&quot; xmlns:ns1=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXmlDesospensione&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaDesospensione&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoSequence&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaRimodApp&quot;/>&#xa;    &lt;xsl:template name=&quot;createProcessInstance-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:createProcessInstanceInput>&#xa;            &lt;ns1:processQName>&#xa;                &lt;ns1:moduleName>&#xa;                    &lt;xsl:value-of select=&quot;'/tim.NOW.bpm.TelecomItaliaMainProject/Process Packages/tim.NOW.bpm.TelecomItaliaMainProject.xpdl'&quot;/>&#xa;                &lt;/ns1:moduleName>&#xa;                &lt;ns1:processName>&#xa;                    &lt;xsl:value-of select=&quot;'TINOWAcquisizioneRichiestaMaster'&quot;/>&#xa;                &lt;/ns1:processName>&#xa;            &lt;/ns1:processQName>&#xa;            &lt;ns1:operationName>&#xa;                &lt;xsl:value-of select=&quot;'StartEventAcquisizioneRichiestaMaster'&quot;/>&#xa;            &lt;/ns1:operationName>&#xa;            &lt;ns1:options>&#xa;                &lt;ns1:priority>&#xa;                    &lt;xsl:value-of select=&quot;310&quot;/>&#xa;                &lt;/ns1:priority>&#xa;            &lt;/ns1:options>&#xa;            &lt;ns1:parameterMap>&#xa;                &lt;ns1:parameter>&#xa;                    &lt;ns1:name>&#xa;                        &lt;xsl:value-of select=&quot;'localRequest'&quot;/>&#xa;                    &lt;/ns1:name>&#xa;                    &lt;ns1:value>&#xa;                        &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;                    &lt;/ns1:value>&#xa;                &lt;/ns1:parameter>&#xa;                &lt;ns1:parameter>&#xa;                    &lt;ns1:name>&#xa;                        &lt;xsl:value-of select=&quot;'AcquisitionID'&quot;/>&#xa;                    &lt;/ns1:name>&#xa;                    &lt;ns1:value>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($RecuperoSequence/Record[1]/NEXTVAL)&quot;/>&#xa;                    &lt;/ns1:value>&#xa;                &lt;/ns1:parameter>&#xa;                &lt;xsl:if test=&quot;upper-case($post.item/tns:CausaleRichiesta)=($RichiestaDesospensione,$RichiestaRimodApp)&quot;>&#xa;                    &lt;ns1:parameter>&#xa;                        &lt;ns1:name>&#xa;                            &lt;xsl:value-of select=&quot;'referenteAltreLavorazioni'&quot;/>&#xa;                        &lt;/ns1:name>&#xa;                        &lt;ns1:value>&#xa;                            &lt;xsl:value-of select=&quot;$RenderXmlDesospensione&quot;/>&#xa;                        &lt;/ns1:value>&#xa;                    &lt;/ns1:parameter>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns1:parameterMap>&#xa;        &lt;/ns1:createProcessInstanceInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
