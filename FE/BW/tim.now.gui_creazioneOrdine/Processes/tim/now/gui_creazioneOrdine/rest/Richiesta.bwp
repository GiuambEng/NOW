ue-of select=&quot;concat(substring(xsd:string($post/item/tns:NuovaRichiesta/tns:dac), 9, 2),'/',substring(xsd:string($post/item/tns:NuovaRichiesta/tns:dac), 6, 2),'/',substring(xsd:string($post/item/tns:NuovaRichiesta/tns:dac), 1, 4))&quot;/>&lt;/NuovaDAC>&lt;/RimodulazioneDACdaRecipient>&lt;/Richiesta>&lt;/RichiestaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
