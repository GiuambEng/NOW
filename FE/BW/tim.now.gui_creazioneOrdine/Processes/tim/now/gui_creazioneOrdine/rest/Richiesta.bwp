                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneDettaglioOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableRichiestaOloXDSL&quot; match=&quot;/&quot;>&#xa;        &lt;ns01:TracciatoOLOxDSL>&#xa;            &lt;ns01:Richiesta>&#xa;                &lt;ns01:Testata>&#xa;                    &lt;ns01:CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns01:CodiceOlo>&#xa;                    &lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceRichiesta&quot;>&#xa;                        &lt;ns01:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceRichiesta&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOlo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;>&#xa;                        &lt;ns01:CodiceOrdineOloPadre>&#xa;                            &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOloPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;>&#xa;                        &lt;ns01:CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;/>&#xa;                        &lt;/ns01:CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:noteDaOperatore&quot;>&#xa;                        &lt;ns01:Note>&#xa;                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:noteDaOperatore&quot;/>&#xa;                        &lt;/ns01:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns01:Testata>&#xa;                &lt;ns01:TipoRichiesta>&#xa;                    &lt;ns01:Comunicazione>&#xa;                        &lt;ns01:RimodulazioneDataAppuntamento>&#xa;                            &lt;ns01:CodiceOrdineRiferimentoTI>&#xa;                                &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                            &lt;/ns01:CodiceOrdineRiferimentoTI>&#xa;                            &lt;ns01:DataAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;concat(substring(xsd:string($post/item/tns:NuovaRichiesta/tns:DAD), 9, 2),'/',substring(xsd:string($post/item/tns:NuovaRichiesta/tns:DAD), 6, 2),'/',substring(xsd:string($post/item/tns:NuovaRichiesta/tns:DAD), 1, 4))&quot;/>&#xa;                            &lt;/ns01:DataAppuntamento>&#xa;                            &lt;ns01:FasciaOraria>&#xa;                                &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:FasciaOraria&quot;/>&#xa;                            &lt;/ns01:FasciaOraria>&#xa;                            &lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:noteAltreLavorazioni&quot;>&#xa;                                &lt;ns01:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:noteAltreLavorazioni&quot;/>&#xa;                                &lt;/ns01:Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Cognome)>0&quot;>&#xa;                                &lt;ns01:Referente>&#xa;                                    &lt;ns01:Qualifica>&#xa;                                        &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Qualifica&quot;/>&#xa;                                    &lt;/ns01:Qualifica>&#xa;                                    &lt;ns01:Nome>&#xa;                                        &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Nome&quot;/>&#xa;                                    &lt;/ns01:Nome>&#xa;                                    &lt;ns01:Cognome>&#xa;                                        &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Cognome&quot;/>&#xa;                                    &lt;/ns01:Cognome>&#xa;                                    &lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:TelefonoFissoReferente&quot;>&#xa;                                        &lt;ns01:Telefono>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:TelefonoFissoReferente&quot;/>&#xa;                                        &lt;/ns01:Telefono>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:CellulareReferente&quot;>&#xa;                                        &lt;ns01:Mobile>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:CellulareReferente&quot;/>&#xa;                                        &lt;/ns01:Mobile>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Email&quot;>&#xa;                                        &lt;ns01:Email>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:ReferenteDesospensione/tns:Email&quot;/>&#xa;                                        &lt;/ns01:Email>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ns01:Referente>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns01:RimodulazioneDataAppuntamento>&#xa;                    &lt;/ns01:Comunicazione>&#xa;                &lt;/ns01:TipoRichiesta>&#xa;            &lt;/ns01:Richiesta>&#xa;        &lt;/ns01:TracciatoOLOxDSL>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
