                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;VisualizzazioneDettaglioOrdine&quot;/>&lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&lt;xsl:template name=&quot;VariableRichiestaOloNGA&quot; match=&quot;/&quot;>&lt;ns0:TracciatoOLONGA>&lt;ns0:Richiesta>&lt;ns0:Testata>&lt;ns0:CodiceOlo>&lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&lt;/ns0:CodiceOlo>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceRichiesta&quot;>&lt;ns0:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceRichiesta&quot;/>&lt;/ns0:CodiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;>&lt;ns0:CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;/>&lt;/ns0:CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;>&lt;ns0:CodiceProgetto>&lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;/>&lt;/ns0:CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:noteDaOperatore&quot;>&lt;ns0:Note>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:noteDaOperatore&quot;/>&lt;/ns0:Note>&lt;/xsl:if>&lt;/ns0:Testata>&lt;ns0:TipoRichiesta>&lt;ns0:Comunicazione>&lt;ns0:Annullamento>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI) and string-length($post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI)&quot;>&lt;ns0:CodiceOrdineRiferimentoTI>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&lt;/ns0:CodiceOrdineRiferimentoTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:codiceOrdineOlo&quot;/>&lt;/ns0:CodiceOrdineOlo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:Annullamento>&lt;/ns0:Comunicazione>&lt;/ns0:TipoRichiesta>&lt;/ns0:Richiesta>&lt;/ns0:TracciatoOLONGA>&lt;/xsl:template>&lt;/xsl:stylesheet>"
