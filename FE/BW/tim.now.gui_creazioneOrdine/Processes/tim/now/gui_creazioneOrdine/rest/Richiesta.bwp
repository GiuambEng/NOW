                                    sqlStatement="UPDATE ACQUISIZIONE_RICHIESTE&#xa;SET STATO = ?, ERRORE = ?, TIMESTAMP_AGGIORNAMENTO = ?&#xa;WHERE ID_RICHIESTA = ?&#xa;AND STATO != 'ELABORATO'" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
