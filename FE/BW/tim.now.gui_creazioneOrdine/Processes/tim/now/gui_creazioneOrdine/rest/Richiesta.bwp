                                    expression="upper-case($post/item/ns3:NuovaRichiesta/ns3:CausaleRichiesta)=($RichiestaDesospensione,$RichiestaRimodApp)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
