#xa;                        &lt;/Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Testata>&#xa;                &lt;InterruzioneSospensione>&#xa;                    &lt;CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:CodiceOrdineTI&quot;/>&#xa;                    &lt;/CodiceOrdineRiferimentoTI>&#xa;                    &lt;DataAppuntamentoDesiderata>&#xa;                        &lt;xsl:value-of select=&quot;concat(substring(xsd:string($post.item/tns:DAD), 9, 2),'/',substring(xsd:string($post.item/tns:DAD), 6, 2),'/',substring(xsd:string($post.item/tns:DAD), 1, 4))&quot;/>&#xa;                    &lt;/DataAppuntamentoDesiderata>&#xa;                    &lt;FasciaOraria>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:FasciaOraria&quot;/>&#xa;                    &lt;/FasciaOraria>&#xa;                    &lt;ReferenteDesospensione>&#xa;                        &lt;QualificaRef>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:Qualifica&quot;/>&#xa;                        &lt;/QualificaRef>&#xa;                        &lt;CognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:Cognome&quot;/>&#xa;                        &lt;/CognomeReferente>&#xa;                        &lt;xsl:if test=&quot;$post.item/tns:ReferenteDesospensione/tns:Nome&quot;>&#xa;                            &lt;NomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:Nome&quot;/>&#xa;                            &lt;/NomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$post.item/tns:ReferenteDesospensione/tns:TelefonoFissoReferente&quot;>&#xa;                            &lt;TelefonoFissoReferente>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:TelefonoFissoReferente&quot;/>&#xa;                            &lt;/TelefonoFissoReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$post.item/tns:ReferenteDesospensione/tns:CellulareReferente&quot;>&#xa;                            &lt;TelefonoMobileReferente>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:CellulareReferente&quot;/>&#xa;                            &lt;/TelefonoMobileReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ReferenteDesospensione>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:noteAltreLavorazioni&quot;>&#xa;                        &lt;Note>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:noteAltreLavorazioni&quot;/>&#xa;                        &lt;/Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/InterruzioneSospensione>&#xa;            &lt;/Richiesta>&#xa;        &lt;/RichiestaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
