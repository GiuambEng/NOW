                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; xmlns:tns1=&quot;http://www.example.org/RichiesteFiberstream&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneDettaglioOrdine&quot;/>&#xa;    &lt;xsl:template name=&quot;RichiestaFiberstream-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NuovaRichiesta>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:CausaleRichiesta&quot;>&#xa;                &lt;tns1:CausaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:CausaleRichiesta&quot;/>&#xa;                &lt;/tns1:CausaleRichiesta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:OAO&quot;>&#xa;                &lt;tns1:OAO>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:OAO&quot;/>&#xa;                &lt;/tns1:OAO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:operatore&quot;>&#xa;                &lt;tns1:operatore>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:operatore&quot;/>&#xa;                &lt;/tns1:operatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:CodiceRichiesta&quot;>&#xa;                &lt;tns1:CodiceRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:CodiceRichiesta&quot;/>&#xa;                &lt;/tns1:CodiceRichiesta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:CodiceOrdineTI&quot;>&#xa;                &lt;tns1:CodiceOrdineTI>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:CodiceOrdineTI&quot;/>&#xa;                &lt;/tns1:CodiceOrdineTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:idRichiestaOlo&quot;>&#xa;                &lt;tns1:idRichiestaOlo>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:idRichiestaOlo&quot;/>&#xa;                &lt;/tns1:idRichiestaOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceOrdineOlo&quot;>&#xa;                &lt;tns1:codiceOrdineOlo>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdineOlo&quot;/>&#xa;                &lt;/tns1:codiceOrdineOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:DAD&quot;>&#xa;                &lt;tns1:DAD>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:DAD&quot;/>&#xa;                &lt;/tns1:DAD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:dac&quot;>&#xa;                &lt;tns1:dac>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:dac&quot;/>&#xa;                &lt;/tns1:dac>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:FasciaOraria&quot;>&#xa;                &lt;tns1:FasciaOraria>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:FasciaOraria&quot;/>&#xa;                &lt;/tns1:FasciaOraria>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:noteDaOperatore&quot;>&#xa;                &lt;tns1:noteDaOperatore>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:noteDaOperatore&quot;/>&#xa;                &lt;/tns1:noteDaOperatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:noteAltreLavorazioni&quot;>&#xa;                &lt;tns1:noteAltreLavorazioni>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:noteAltreLavorazioni&quot;/>&#xa;                &lt;/tns1:noteAltreLavorazioni>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:flagAccettazione&quot;>&#xa;                &lt;tns1:flagAccettazione>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:flagAccettazione&quot;/>&#xa;                &lt;/tns1:flagAccettazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:riscontroCodiceSessione&quot;>&#xa;                &lt;tns1:riscontroCodiceSessione>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:riscontroCodiceSessione&quot;/>&#xa;                &lt;/tns1:riscontroCodiceSessione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:causaleRifiuto&quot;>&#xa;                &lt;tns1:causaleRifiuto>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:causaleRifiuto&quot;/>&#xa;                &lt;/tns1:causaleRifiuto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codiceMotivoRifiuto&quot;>&#xa;                &lt;tns1:codiceMotivoRifiuto>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codiceMotivoRifiuto&quot;/>&#xa;                &lt;/tns1:codiceMotivoRifiuto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:motivoRifiuto&quot;>&#xa;                &lt;tns1:motivoRifiuto>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:motivoRifiuto&quot;/>&#xa;                &lt;/tns1:motivoRifiuto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;>&#xa;                &lt;tns1:codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;/>&#xa;                &lt;/tns1:codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$post.item/tns:ReferenteDesospensione&quot;>&#xa;                &lt;tns1:ReferenteDesospensione>&#xa;                    &lt;xsl:if test=&quot;tns:Nome&quot;>&#xa;                        &lt;tns1:Nome>&#xa;                            &lt;xsl:value-of select=&quot;tns:Nome&quot;/>&#xa;                        &lt;/tns1:Nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:Cognome&quot;>&#xa;                        &lt;tns1:Cognome>&#xa;                            &lt;xsl:value-of select=&quot;tns:Cognome&quot;/>&#xa;                        &lt;/tns1:Cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:TelefonoFissoReferente&quot;>&#xa;                        &lt;tns1:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;tns:TelefonoFissoReferente&quot;/>&#xa;                        &lt;/tns1:TelefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:CellulareReferente&quot;>&#xa;                        &lt;tns1:CellulareReferente>&#xa;                            &lt;xsl:value-of select=&quot;tns:CellulareReferente&quot;/>&#xa;                        &lt;/tns1:CellulareReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:Qualifica&quot;>&#xa;                        &lt;tns1:Qualifica>&#xa;                            &lt;xsl:value-of select=&quot;tns:Qualifica&quot;/>&#xa;                        &lt;/tns1:Qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:Email&quot;>&#xa;                        &lt;tns1:Email>&#xa;                            &lt;xsl:value-of select=&quot;tns:Email&quot;/>&#xa;                        &lt;/tns1:Email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:ReferenteDesospensione>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:NuovaRichiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
