                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneDettaglioOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableRichiestaOloXDSL&quot; match=&quot;/&quot;>&#xa;        &lt;ns01:TracciatoOLOxDSL>&#xa;            &lt;ns01:Richiesta>&#xa;                &lt;ns01:Testata>&#xa;                    &lt;ns01:CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns01:CodiceOlo>&#xa;                    &lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceRichiesta&quot;>&#xa;                        &lt;ns01:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceRichiesta&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOlo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;>&#xa;                        &lt;ns01:CodiceOrdineOloPadre>&#xa;                            &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOloPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;>&#xa;                        &lt;ns01:CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;/>&#xa;                        &lt;/ns01:CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post/item/tns:NuovaRichiesta/tns:noteDaOperatore&quot;>&#xa;                        &lt;ns01:Note>&#xa;                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:noteDaOperatore&quot;/>&#xa;                        &lt;/ns01:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns01:Testata>&#xa;                &lt;ns01:TipoRichiesta>&#xa;                    &lt;ns01:Comunicazione>&#xa;                        &lt;ns01:CancellazioneAccodamento>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 8&quot;>&#xa;                                    &lt;ns01:AccessoATMAsimmetricoFlat>&#xa;                                        &lt;ns01:TI>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                                        &lt;/ns01:TI>&#xa;                                    &lt;/ns01:AccessoATMAsimmetricoFlat>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 9&quot;>&#xa;                                    &lt;ns01:AccessoATMAsimmetricoHL>&#xa;                                        &lt;ns01:TI>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                                        &lt;/ns01:TI>&#xa;                                    &lt;/ns01:AccessoATMAsimmetricoHL>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 10&quot;>&#xa;                                    &lt;ns01:AccessoATMAsimmetricoLite>&#xa;                                        &lt;ns01:TI>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                                        &lt;/ns01:TI>&#xa;                                    &lt;/ns01:AccessoATMAsimmetricoLite>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 7&quot;>&#xa;                                    &lt;ns01:AccessoGBEAsimmetricoFlat>&#xa;                                        &lt;ns01:TI>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                                        &lt;/ns01:TI>&#xa;                                    &lt;/ns01:AccessoGBEAsimmetricoFlat>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 11&quot;>&#xa;                                    &lt;ns01:EasyIPBasePlusFlat>&#xa;                                        &lt;ns01:TI>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                                        &lt;/ns01:TI>&#xa;                                    &lt;/ns01:EasyIPBasePlusFlat>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 12&quot;>&#xa;                                    &lt;ns01:EasyIPBasePlusLite>&#xa;                                        &lt;ns01:TI>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                                        &lt;/ns01:TI>&#xa;                                    &lt;/ns01:EasyIPBasePlusLite>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA =  13&quot;>&#xa;                                    &lt;ns01:EasyIPSpecialProfileFlat>&#xa;                                        &lt;ns01:TI>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                                        &lt;/ns01:TI>&#xa;                                    &lt;/ns01:EasyIPSpecialProfileFlat>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns01:EasyIPSpecialProfileLite>&#xa;                                        &lt;ns01:TI>&#xa;                                            &lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceOrdineTI&quot;/>&#xa;                                        &lt;/ns01:TI>&#xa;                                    &lt;/ns01:EasyIPSpecialProfileLite>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns01:CancellazioneAccodamento>&#xa;                    &lt;/ns01:Comunicazione>&#xa;                &lt;/ns01:TipoRichiesta>&#xa;            &lt;/ns01:Richiesta>&#xa;        &lt;/ns01:TracciatoOLOxDSL>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
