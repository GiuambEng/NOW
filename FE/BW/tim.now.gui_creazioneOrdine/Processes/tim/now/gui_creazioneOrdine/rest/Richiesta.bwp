                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneDettaglioOrdine&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableRichiestaOloRegolatorio&quot; match=&quot;/&quot;>&#xa;        &lt;RichiestaOloRegolatorio>&#xa;            &lt;Richiesta>&#xa;                &lt;Testata>&#xa;                    &lt;CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:OAO&quot;/>&#xa;                    &lt;/CodiceOlo>&#xa;                    &lt;CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:CodiceRichiesta&quot;/>&#xa;                    &lt;/CodiceOrdineOlo>&#xa;                    &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;>&#xa;                        &lt;CodiceOrdineOloPadre>&#xa;                            &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;/>&#xa;                        &lt;/CodiceOrdineOloPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;>&#xa;                        &lt;CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;/>&#xa;                        &lt;/CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:noteDaOperatore&quot;>&#xa;                        &lt;Note>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:noteDaOperatore&quot;/>&#xa;                        &lt;/Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Testata>&#xa;                &lt;RimodulazioneAppuntamento>&#xa;                    &lt;CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:CodiceOrdineTI&quot;/>&#xa;                    &lt;/CodiceOrdineRiferimentoTI>&#xa;                    &lt;DataAppuntamentoDesiderata>&#xa;                        &lt;xsl:value-of select=&quot;concat(substring(xsd:string($post.item/tns:DAD), 9, 2),'/',substring(xsd:string($post.item/tns:DAD), 6, 2),'/',substring(xsd:string($post.item/tns:DAD), 1, 4))&quot;/>&#xa;                    &lt;/DataAppuntamentoDesiderata>&#xa;                    &lt;FasciaOraria>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:FasciaOraria&quot;/>&#xa;                    &lt;/FasciaOraria>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:noteAltreLavorazioni&quot;>&#xa;                        &lt;Note>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:noteAltreLavorazioni&quot;/>&#xa;                        &lt;/Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($post.item/tns:ReferenteDesospensione/tns:Cognome)>0&quot;>&#xa;                        &lt;Referente>&#xa;                            &lt;QualificaRef>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:Qualifica&quot;/>&#xa;                            &lt;/QualificaRef>&#xa;                            &lt;CognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:Cognome&quot;/>&#xa;                            &lt;/CognomeReferente>&#xa;                            &lt;xsl:if test=&quot;$post.item/tns:ReferenteDesospensione/tns:Nome&quot;>&#xa;                                &lt;NomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:Nome&quot;/>&#xa;                                &lt;/NomeReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$post.item/tns:ReferenteDesospensione/tns:TelefonoFissoReferente&quot;>&#xa;                                &lt;TelefonoFissoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:TelefonoFissoReferente&quot;/>&#xa;                                &lt;/TelefonoFissoReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$post.item/tns:ReferenteDesospensione/tns:CellulareReferente&quot;>&#xa;                                &lt;TelefonoMobileReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:CellulareReferente&quot;/>&#xa;                                &lt;/TelefonoMobileReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$post.item/tns:ReferenteDesospensione/tns:Email&quot;>&#xa;                                &lt;EmailReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:ReferenteDesospensione/tns:Email&quot;/>&#xa;                                &lt;/EmailReferente>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/Referente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/RimodulazioneAppuntamento>&#xa;            &lt;/Richiesta>&#xa;        &lt;/RichiestaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
