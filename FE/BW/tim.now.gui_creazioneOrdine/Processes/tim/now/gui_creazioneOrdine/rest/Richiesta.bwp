L_OLO>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($AssignXMLFWAEOLO/Richiesta[1])&quot;/>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_XML_OLO>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($VariableRichiestaOloXDSL/ns01:Richiesta[1])&quot;/>&#xa;                    &lt;/CONTENUTO_XML_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;STATO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INELABORAZIONE&amp;quot;&quot;/>&#xa;            &lt;/STATO>&#xa;            &lt;XML_CASEDATA_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), true())&quot;/>&#xa;            &lt;/XML_CASEDATA_RICHIESTA>&#xa;            &lt;TIMESTAMP_CREAZIONE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMESTAMP_CREAZIONE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = (1,2,3,4,5,6,21,22,23,24,25,26,27,28,29)&quot;>&#xa;                    &lt;STRUTTURARICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                    &lt;/STRUTTURARICHIESTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA =(15,16,17,18,44,45,61,62,65,66,67,68,69,76,79,80)&quot;>&#xa;                    &lt;STRUTTURARICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;                    &lt;/STRUTTURARICHIESTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 75&quot;>&#xa;                    &lt;STRUTTURARICHIESTA>&#xa;                        &