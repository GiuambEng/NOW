                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneDettaglioOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableRichiestaOloNGA&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:TracciatoOLONGA>&#xa;            &lt;ns0:Richiesta>&#xa;                &lt;ns0:Testata>&#xa;                    &lt;ns0:CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns0:CodiceOlo>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:CodiceRichiesta&quot;>&#xa;                        &lt;ns0:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:CodiceRichiesta&quot;/>&#xa;                        &lt;/ns0:CodiceOrdineOlo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;>&#xa;                        &lt;ns0:CodiceOrdineOloPadre>&#xa;                            &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;/>&#xa;                        &lt;/ns0:CodiceOrdineOloPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;>&#xa;                        &lt;ns0:CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/CODICEPROGETTO&quot;/>&#xa;                        &lt;/ns0:CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:noteDaOperatore&quot;>&#xa;                        &lt;ns0:Note>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:noteDaOperatore&quot;/>&#xa;                        &lt;/ns0:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns0:Testata>&#xa;                &lt;ns0:TipoRichiesta>&#xa;                    &lt;ns0:Comunicazione>&#xa;                        &lt;ns0:Annullamento>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($post.item/tns:CodiceOrdineTI) and string-length($post.item/tns:CodiceOrdineTI)&quot;>&#xa;                                    &lt;ns0:CodiceOrdineRiferimentoTI>&#xa;                                        &lt;xsl:value-of select=&quot;$post.item/tns:CodiceOrdineTI&quot;/>&#xa;                                    &lt;/ns0:CodiceOrdineRiferimentoTI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns0:CodiceOrdineOlo>&#xa;                                        &lt;xsl:value-of select=&quot;$post.item/tns:codiceOrdineOlo&quot;/>&#xa;                                    &lt;/ns0:CodiceOrdineOlo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns0:Annullamento>&#xa;                    &lt;/ns0:Comunicazione>&#xa;                &lt;/ns0:TipoRichiesta>&#xa;            &lt;/ns0:Richiesta>&#xa;        &lt;/ns0:TracciatoOLONGA>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
