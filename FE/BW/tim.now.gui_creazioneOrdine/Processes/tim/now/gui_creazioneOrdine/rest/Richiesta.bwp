                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7d62db28-c0cf-46b7-a330-b7a8758065d4+input&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovaRichiesta&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VisualizzazioneDettaglioOrdine&quot;/>&lt;xsl:param name=&quot;VariableRichiestaOloRegolatorio&quot;/>&lt;xsl:param name=&quot;VariableRichiestaOloXDSL&quot;/>&lt;xsl:param name=&quot;VariableRichiestaOloNGA&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;RecuperoSequence&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;VariableRichiestaOloGPON&quot;/>&lt;xsl:param name=&quot;AssignXMLFWAEOLO&quot;/>&lt;xsl:param name=&quot;AssignXMLFiberstream&quot;/>&lt;xsl:template name=&quot;InsertRichiesta-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcUpdateActivityInput>&lt;CODICE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns:NuovaRichiesta/tns:OAO)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:OAO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_OLO>&lt;AMBITO>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/AMBITO>&lt;ID_RICHIESTA>&lt;xsl:value-of select=&quot;xsd:int($RecuperoSequence/Record[1]/NEXTVAL)&quot;/>&lt;/ID_RICHIESTA>&lt;xsl:choose>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = (1,2,3,4,5,6,21,22,23,24,25,26,27,28,29)&quot;>&lt;CONTENUTO_XML_OLO>&lt;xsl:value-of select=&quot;tib:render-xml($VariableRichiestaOloRegolatorio/Richiesta[1])&quot;/>&lt;/CONTENUTO_XML_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA =(15,16,17,18,44,45,61,62,67,68,69)&quot;>&lt;CONTENUTO_XML_OLO>&lt;xsl:value-of select=&quot;tib:render-xml($VariableRichiestaOloNGA/ns0:Richiesta[1])&quot;/>&lt;/CONTENUTO_XML_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA =(65,66,79,80)&quot;>&lt;CONTENUTO_XML_OLO>&lt;xsl:value-of select=&quot;tib:render-xml($VariableRichiestaOloGPON/Richiesta[1])&quot;/>&lt;/CONTENUTO_XML_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 75&quot;>&lt;CONTENUTO_XML_OLO>&lt;xsl:value-of select=&quot;tib:render-xml($AssignXMLFiberstream/Richiesta[1])&quot;/>&lt;/CONTENUTO_XML_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 76&quot;>&lt;CONTENUTO_XML_OLO>&lt;xsl:value-of select=&quot;tib:render-xml($AssignXMLFWAEOLO/Richiesta[1])&quot;/>&lt;/CONTENUTO_XML_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CONTENUTO_XML_OLO>&lt;xsl:value-of select=&quot;tib:render-xml($VariableRichiestaOloXDSL/ns01:Richiesta[1])&quot;/>&lt;/CONTENUTO_XML_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;STATO>&lt;xsl:value-of select=&quot;&amp;quot;INELABORAZIONE&amp;quot;&quot;/>&lt;/STATO>&lt;XML_CASEDATA_RICHIESTA>&lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), true())&quot;/>&lt;/XML_CASEDATA_RICHIESTA>&lt;TIMESTAMP_CREAZIONE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMESTAMP_CREAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = (1,2,3,4,5,6,21,22,23,24,25,26,27,28,29)&quot;>&lt;STRUTTURARICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&lt;/STRUTTURARICHIESTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA =(15,16,17,18,44,45,61,62,65,66,67,68,69,76,79,80)&quot;>&lt;STRUTTURARICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/STRUTTURARICHIESTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$VisualizzazioneDettaglioOrdine/Record[1]/IDOFFERTA = 75&quot;>&lt;STRUTTURARICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;FIBERSTREAM&amp;quot;&quot;/>&lt;/STRUTTURARICHIESTA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STRUTTURARICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&lt;/STRUTTURARICHIESTA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CANALE_RICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/CANALE_RICHIESTA>&lt;CODICE_ORDINE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns:NuovaRichiesta/tns:CodiceRichiesta)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns:NuovaRichiesta/tns:CodiceRichiesta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_OLO>&lt;/tns3:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
