uot;'string'&quot;/>&#xa;                        &lt;/tns:domain>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneInferiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBEAsimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat'&quot;>&#xa;                    &lt;tns:sezioneInferiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;'KIT IP'&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;'IPKIT'&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;tns:componente>&#xa;                            &lt;xsl:value-of select=&quot;'GBEVC'&quot;/>&#xa;                        &lt;/tns:componente>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:domain>&#xa;                            &lt;xsl:value-of select=&quot;'string'&quot;/>&#xa;                        &lt;/tns:domain>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneInferiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'Azione'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'AZIONE'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBEAsimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat'&quot;>&#xa;                            &lt;tns:componente>&#xa;                                &lt;xsl:value-of select=&quot;'GBEVC'&quot;/>&#xa;                            &lt;/tns:componente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:componente>&#xa;                                &lt;xsl:value-of select=&quot;'USERVLAN'&quot;/>&#xa;                            &lt;/tns:componente>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;            &lt;/tns:offertaOutput>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns:code>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:Offerta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
