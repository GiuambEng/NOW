:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TIPOBANDACONSEGNA']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;/>&#xa;                                    &lt;/tns:mandatory>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='EasyIPBasePlusLite' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='EasyIPBasePlusLite'&quot;>&#xa;                                &lt;tns:mandatory>&#xa;                                    &lt;xsl:value-of select=&quot;'false'&quot;/>&#xa;                                &lt;/tns:mandatory>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='EasyIPBasePlusFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='EasyIPBasePlusFlat' and $ChiamaCatalogo='Y'&quot;>&#xa;                                &lt;xsl:if test=&quot;$MasterCatalogRecordAction.mcResponsePart/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_EASYIPBasePlusFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='ATMVC_AccessoATMAsimFlat ']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TIPOBANDACONSEGNA']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;>&#xa;                                    &lt;tns:mandatory>&#xa;                                        &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction.mcResponsePart/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_EASYIPBasePlusFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='ATMVC_AccessoATMAsimFlat ']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TIPOBANDACONSEGNA']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;/>&#xa;                                    &lt;/tns:mandatory>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:mandatory>&#xa;                                    &lt;xsl:value-of select=&quot;'false'&quot;/>&#xa;                                &lt;/tns:mandatory>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneInferiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'VPI'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'VPI'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'NUMBER'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'int'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'VCI'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'VCI'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'NUMBER'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'int'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'Codice TD'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'CODICETD'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'Azione'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'AZIONE'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;            &lt;/tns:offertaOutput>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns:code>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:Offerta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="OutputDettOfferta" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Offerta&quot; xmlns:tns1=&quot;http://xmlns.example.com/IntegrazioneCatalogo/parameters&quot; xmlns:ns=&quot;http://www.tibco.com/cim/services/mastercatalogrecord/wsdl/2.0&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;MasterCatalogRecordAction&quot;/>&lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&lt;xsl:param name=&quot;ChiamaCatalogo&quot;/>&lt;xsl:template name=&quot;OutputDettOfferta&quot; match=&quot;/&quot;>&lt;tns:Offerta>&lt;tns:offertaOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta) and string-length($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta)>0&quot;>&lt;xsl:if test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:sezioneSuperiore>&lt;tns:label>&lt;xsl:value-of select=&quot;'Encapsulation'&quot;/>&lt;/tns:label>&lt;tns:key>&lt;xsl:value-of select=&quot;'ENCAPSULATION'&quot;/>&lt;/tns:key>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo=('VULAFTTH','SEMIVULAFTTH','FULLGPONPLUS') or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG=('VULAFTTH','SEMIVULAFTTH','FULLGPONPLUS')&quot;>&lt;tns:componente>&lt;xsl:value-of select=&quot;'ACCESSOVULAFTTH'&quot;/>&lt;/tns:componente>&lt;/xsl:when>&lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo=('BitstreamNGAFTTH','SEMIBitstreamNGAFTTH','FULLGPONPLUSNGA') or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG=('BitstreamNGAFTTH','SEMIBitstreamNGAFTTH','FULLGPONPLUSNGA')&quot;>&lt;tns:componente>&lt;xsl:value-of select=&quot;'ACCESSONGAFTTH'&quot;/>&lt;/tns:componente>&lt;/xsl:when>&lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='VULAFTTCAB' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VULAFTTCAB'&quot;>&lt;tns:componente>&lt;xsl:value-of select=&quot;'ACCESSOVULAFTTCAB'&quot;/>&lt;/tns:componente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:componente>&lt;xsl:value-of select=&quot;'ACCESSONGAFTTCAB'&quot;/>&lt;/tns:componente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tns:tipologiaDato>&lt;tns:domain>&lt;xsl:value-of select=&quot;'list'&quot;/>&lt;/tns:domain>&lt;tns:progressivo>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:progressivo>&lt;/tns:sezioneSuperiore>&lt;tns:sezioneSuperiore>&lt;tns:label>&lt;xsl:value-of select=&quot;'Tipo Linea'&quot;/>&lt;/tns:label>&lt;tns:key>&lt;xsl:value-of select=&quot;'TIPOLINEA'&quot;/>&lt;/tns:key>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo=('VULAFTTH','SEMIVULAFTTH','FULLGPONPLUS') or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG=('VULAFTTH','SEMIVULAFTTH','FULLGPONPLUS')&quot;>&lt;tns:componente>&lt;xsl:value-of select=&quot;'ACCESSOVULAFTTH'&quot;/>&lt;/tns:componente>&lt;/xsl:when>&lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo=('BitstreamNGAFTTH','SEMIBitstreamNGAFTTH','FULLGPONPLUSNGA') or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG=('BitstreamNGAFTTH','SEMIBitstreamNGAFTTH','FULLGPONPLUSNGA')&quot;>&lt;tns:componente>&lt;xsl:value-of select=&quot;'ACCESSON