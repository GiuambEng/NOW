       &lt;/tns:mandatory>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;($get.parameters/tns1:offertaCatalogo='VLANNGA' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLANNGA') or ($get.parameters/tns1:offertaCatalogo='VLAN' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLAN')&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;TipoVLAN&amp;quot;&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;TIPOVLAN&amp;quot;&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='VLANNGA' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLANNGA'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANNGA&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='VLAN' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLAN'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANGBE&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANVULA&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:domain>&#xa;                            &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                        &lt;/tns:domain>&#xa;                        &lt;tns:default>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SINGLETAG;DOUBLETAG&amp;quot;&quot;/>&#xa;                        &lt;/tns:default>&#xa;                        &lt;tns:mandatory>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;true&amp;quot;&quot;/>&#xa;                        &lt;/tns:mandatory>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;($get.parameters/tns1:offertaCatalogo='VLANNGA' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLANNGA') or ($get.parameters/tns1:offertaCatalogo='VLAN' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLAN')&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CAR&amp;quot;&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOCAR&amp;quot;&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='VLANNGA' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLANNGA'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANNGA&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='VLAN' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLAN'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANGBE&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANVULA&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:domain>&#xa;                            &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                        &lt;/tns:domain>&#xa;                        &lt;tns:default>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CAR 1;CAR 2;CAR 3;CAR 4;CAR 5&amp;quot;&quot;/>&#xa;                        &lt;/tns:default>&#xa;                        &lt;tns:mandatory>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;true&amp;quot;&quot;/>&#xa;                        &lt;/tns:mandatory>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;($get.parameters/tns1:offertaCatalogo='VLANNGA' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLANNGA') or ($get.parameters/tns1:offertaCatalogo='VLAN' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLAN')&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Profilo BMC&amp;quot;&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PROFILOBMC&amp;quot;&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='VLANNGA' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLANNGA'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANNGA&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='VLANGBE' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLANGBE'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANGBE&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:componente>&#xa;                          