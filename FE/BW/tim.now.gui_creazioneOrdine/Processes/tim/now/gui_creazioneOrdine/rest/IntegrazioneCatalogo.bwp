Record[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='IDPROFILOVC']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;>&#xa;                                &lt;tns:mandatory>&#xa;                                    &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_ATMAsimmetricoHL']/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='ATMVC_ AccessoATMAsimHL']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='IDPROFILOVC']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;/>&#xa;                                &lt;/tns:mandatory>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamATMAsimmetricoHL' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamATMAsimmetricoHL'&quot;>&#xa;                            &lt;tns:mandatory>&#xa;                                &lt;xsl:value-of select=&quot;'true'&quot;/>&#xa;                            &lt;/tns:mandatory>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamATMAsimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamATMAsimmetricoFlat' and $ChiamaCatalogo='Y'&quot;>&#xa;                            &lt;xsl:if test=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_ATMAsimFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='ATMVC_AccessoATMAsimFlat ']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='IDPROFILOVC']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;>&#xa;                                &lt;tns:mandatory>&#xa;                                    &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_ATMAsimFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='ATMVC_AccessoATMAsimFlat ']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='IDPROFILOVC']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;/>&#xa;                                &lt;/tns:mandatory>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:mandatory>&#xa;                                &lt;xsl:value-of select=&quot;'true'&quot;/>&#xa;                            &lt;/tns:mandatory>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#x