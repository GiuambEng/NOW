                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Offerta&quot; xmlns:tns1=&quot;http://xmlns.example.com/IntegrazioneCatalogo/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&lt;xsl:template name=&quot;OutputDettOfferta&quot; match=&quot;/&quot;>&lt;tns:Offerta>&lt;tns:offertaOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta) and string-length($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta)>0&quot;>&lt;xsl:if test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='VLANNGA' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLANNGA') or ($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='VLAN' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLAN')&quot;>&lt;tns:sezioneSuperiore>&lt;tns:label>&lt;xsl:value-of select=&quot;&amp;quot;FamigliaVLAN&amp;quot;&quot;/>&lt;/tns:label>&lt;tns:key>&lt;xsl:value-of select=&quot;&amp;quot;FAMIGLIAVLAN&amp;quot;&quot;/>&lt;/tns:key>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='VLANNGA' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='V