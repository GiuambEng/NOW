>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'Codice VP'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'CODICEVP'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'Codice TD'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'CODICETD'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'DLCI'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'DLCI'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'NUMBER'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'int'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'Azione'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'AZIONE'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'Richiesta Monitoraggio'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'RICHIESTAMONITORAGGIO'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'flag'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:default>&#xa;                        &lt;xsl:value-of select=&quot;'Y;N'&quot;/>&#xa;                    &lt;/tns:default>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;            &lt;/tns:offertaOutput>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns:code>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:Offerta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
