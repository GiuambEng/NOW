                            </bpws:reply>
                            <bpws:invoke
                                inputVariable="MasterCatalogRecordAction-input"
                                name="MasterCatalogRecordAction"
                                operation="MasterCatalogRecordAction"
                                outputVariable="MasterCatalogRecordAction"
                                partnerLink="CIMPortType"
                                portType="ns1:CIMPortType" tibex:xpdlId="05f26467-5d70-46b2-8575-ab67f25368d9">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tibco.com/cim/services/mastercatalogrecordworkitem/wsdl/2.0" xmlns:ns="http://www.tibco.com/cim/services/mastercatalogrecord/wsdl/2.0" xmlns:tns1="http://xmlns.example.com/IntegrazioneCatalogo/parameters" version="2.0"&gt;
    &lt;xsl:param name="get"/&gt;
    &lt;xsl:param name="CompanyName"/&gt;
    &lt;xsl:param name="UserName"/&gt;
    &lt;xsl:param name="Password"/&gt;
    &lt;xsl:param name="RecuperoOfferta"/&gt;
    &lt;xsl:template name="MasterCatalogRecordAction-input" match="/"&gt;
        &lt;tns4:MasterCatalogRecordRequest&gt;
            &lt;mcRequestPart&gt;
                &lt;ns:DataService&gt;
                    &lt;xsl:attribute name="version"&gt;
                        &lt;xsl:value-of select="2.0"/&gt;
                    &lt;/xsl:attribute&gt;
                    &lt;ns:Identity&gt;
                        &lt;ns:DirectoryPath&gt;
                            &lt;ns:Directory&gt;
                                &lt;xsl:attribute name="type"&gt;
                                    &lt;xsl:value-of select="&amp;quot;Enterprise&amp;quot;"/&gt;
                                &lt;/xsl:attribute&gt;
                                &lt;xsl:value-of select="$CompanyName"/&gt;
                            &lt;/ns:Directory&gt;
                            &lt;ns:Directory&gt;
                                &lt;xsl:attribute name="type"&gt;
                                    &lt;xsl:value-of select="'User'"/&gt;
                                &lt;/xsl:attribute&gt;
                                &lt;xsl:value-of select="$UserName"/&gt;
                            &lt;/ns:Directory&gt;
                        &lt;/ns:DirectoryPath&gt;
                        &lt;ns:Authentication&gt;
                            &lt;xsl:value-of select="$Password"/&gt;
                        &lt;/ns:Authentication&gt;
                    &lt;/ns:Identity&gt;
                    &lt;ns:Transaction&gt;
                        &lt;ns:Command&gt;
                            &lt;xsl:attribute name="type"&gt;
                                &lt;xsl:value-of select="&amp;quot;Query&amp;quot;"/&gt;
                            &lt;/xsl:attribute&gt;
                            &lt;ns:StartCount&gt;
                                &lt;xsl:value-of select="1"/&gt;
                            &lt;/ns:StartCount&gt;
                            &lt;ns:MaxCount&gt;
                                &lt;xsl:value-of select="1000"/&gt;
                            &lt;/ns:MaxCount&gt;
                            &lt;ns:MasterCatalogRecord&gt;
                                &lt;xsl:attribute name="etype"&gt;
                                    &lt;xsl:value-of select="&amp;quot;Entity&amp;quot;"/&gt;
                                &lt;/xsl:attribute&gt;
                                &lt;ns:ExternalKeys&gt;
                                    &lt;ns:Key&gt;
                                        &lt;xsl:attribute name="name"&gt;
                                            &lt;xsl:value-of select="&amp;quot;MASTERCATALOGNAME&amp;quot;"/&gt;
                                        &lt;/xsl:attribute&gt;
                                        &lt;xsl:value-of select="&amp;quot;PRODUCT&amp;quot;"/&gt;
                                    &lt;/ns:Key&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="exists($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta) and string-length($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta)&gt;0"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIVULAFTTH'"&gt;
                                                    &lt;ns:Key&gt;
                                                        &lt;xsl:attribute name="name"&gt;
                                                            &lt;xsl:value-of select="&amp;quot;PRODUCTID&amp;quot;"/&gt;
                                                        &lt;/xsl:attribute&gt;
                                                        &lt;xsl:value-of select="'VULAFTTH'"/&gt;
                                                    &lt;/ns:Key&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:when test="$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIBitstreamNGAFTTH'"&gt;
                                                    &lt;ns:Key&gt;
                                                        &lt;xsl:attribute name="name"&gt;
                                                            &lt;xsl:value-of select="&amp;quot;PRODUCTID&amp;quot;"/&gt;
                                                        &lt;/xsl:attribute&gt;
                                                        &lt;xsl:value-of select="'BitstreamNGAFTTH'"/&gt;
                                                    &lt;/ns:Key&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:when test="$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIEasyIPUBBFTTH'"&gt;
                                                    &lt;ns:Key&gt;
                                                        &lt;xsl:attribute name="name"&gt;
                                                            &lt;xsl:value-of select="&amp;quot;PRODUCTID&amp;quot;"/&gt;
                                                        &lt;/xsl:attribute&gt;
                                                        &lt;xsl:value-of select="'EasyIPUBBFTTH'"/&gt;
                                                    &lt;/ns:Key&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:otherwise&gt;
                                                    &lt;xsl:if test="$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG"&gt;
                                                        &lt;ns:Key&gt;
                                                            &lt;xsl:attribute name="name"&gt;
                                                                &lt;xsl:value-of select="&amp;quot;PRODUCTID&amp;quot;"/&gt;
                                                            &lt;/xsl:attribute&gt;
                                                            &lt;xsl:value-of select="$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG"/&gt;
                                                        &lt;/ns:Key&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:otherwise&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo=  'SEMIVULAFTTH'"&gt;
                                                    &lt;ns:Key&gt;
                                                        &lt;xsl:attribute name="name"&gt;
                                                            &lt;xsl:value-of select="&amp;quot;PRODUCTID&amp;quot;"/&gt;
                                                        &lt;/xsl:attribute&gt;
                                                        &lt;xsl:value-of select="'VULAFTTH'"/&gt;
                                                    &lt;/ns:Key&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:when test="$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo=  'SEMIBitstreamNGAFTTH'"&gt;
                                                    &lt;ns:Key&gt;
                                                        &lt;xsl:attribute name="name"&gt;
                                                            &lt;xsl:value-of select="&amp;quot;PRODUCTID&amp;quot;"/&gt;
                                                        &lt;/xsl:attribute&gt;
                                                        &lt;xsl:value-of select="'BitstreamNGAFTTH'"/&gt;
                                                    &lt;/ns:Key&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:when test="$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo=  'SEMIEasyIPUBBFTTH'"&gt;
                                                    &lt;ns:Key&gt;
                                                        &lt;xsl:attribute name="name"&gt;
                                                            &lt;xsl:value-of select="&amp;quot;PRODUCTID&amp;quot;"/&gt;
                                                        &lt;/xsl:attribute&gt;
                                                        &lt;xsl:value-of select="'EasyIPUBBFTTH'"/&gt;
                                                    &lt;/ns:Key&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:otherwise&gt;
                                                    &lt;xsl:if test="$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo"&gt;
                                                        &lt;ns:Key&gt;
                                                            &lt;xsl:attribute name="name"&gt;
                                                                &lt;xsl:value-of select="&amp;quot;PRODUCTID&amp;quot;"/&gt;
                                                            &lt;/xsl:attribute&gt;
                                                            &lt;xsl:value-of select="$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo"/&gt;
                                                        &lt;/ns:Key&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:otherwise&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;ns:Key&gt;
                                        &lt;xsl:attribute name="name"&gt;
                                            &lt;xsl:value-of select="&amp;quot;RECORD_STATE&amp;quot;"/&gt;
                                        &lt;/xsl:attribute&gt;
                                        &lt;xsl:value-of select="&amp;quot;CONFIRMED&amp;quot;"/&gt;
                                    &lt;/ns:Key&gt;
                                &lt;/ns:ExternalKeys&gt;
                                &lt;ns:Return&gt;
                                    &lt;ns:RelationshipData&gt;
                                        &lt;ns:Relationship&gt;
                                            &lt;ns:RelationType&gt;
                                                &lt;xsl:value-of select="&amp;quot;ProductComprisedOf&amp;quot;"/&gt;
                                            &lt;/ns:RelationType&gt;
                                            &lt;ns:RelationDepth&gt;
                                                &lt;xsl:value-of select="5"/&gt;
                                            &lt;/ns:RelationDepth&gt;
                                        &lt;/ns:Relationship&gt;
                                        &lt;ns:Relationship&gt;
                                            &lt;ns:RelationType&gt;
                                                &lt;xsl:value-of select="&amp;quot;Characteristic&amp;quot;"/&gt;
                                            &lt;/ns:RelationType&gt;
                                            &lt;ns:RelationDepth&gt;
                                                &lt;xsl:value-of select="5"/&gt;
                                            &lt;/ns:RelationDepth&gt;
                                        &lt;/ns:Relationship&gt;
                                    &lt;/ns:RelationshipData&gt;
                                &lt;/ns:Return&gt;
                            &lt;/ns:MasterCatalogRecord&gt;
                        &lt;/ns:Command&gt;
                    &lt;/ns:Transaction&gt;
                &lt;/ns:DataService&gt;
            &lt;/mcRequestPart&gt;
        &lt;/tns4:MasterCatalogRecordRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/cim/services/mastercatalogrecordworkitem/wsdl/2.0&quot; xmlns:ns=&quot;http://www.tibco.com/cim/services/mastercatalogrecord/wsdl/2.0&quot; xmlns:tns1=&quot;http://xmlns.example.com/IntegrazioneCatalogo/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CompanyName&quot;/>&#xa;    &lt;xsl:param name=&quot;UserName&quot;/>&#xa;    &lt;xsl:param name=&quot;Password&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;MasterCatalogRecordAction-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:DataService>&#xa;            &lt;xsl:attribute name=&quot;version&quot;>&#xa;                &lt;xsl:value-of select=&quot;2.0&quot;/>&#xa;            &lt;/xsl:attribute>&#xa;            &lt;ns:Identity>&#xa;                &lt;ns:DirectoryPath>&#xa;                    &lt;ns:Directory>&#xa;                        &lt;xsl:attribute name=&quot;type&quot;>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Enterprise&amp;quot;&quot;/>&#xa;                        &lt;/xsl:attribute>&#xa;                        &lt;xsl:value-of select=&quot;$CompanyName&quot;/>&#xa;                    &lt;/ns:Directory>&#xa;                    &lt;ns:Directory>&#xa;                        &lt;xsl:attribute name=&quot;type&quot;>&#xa;                            &lt;xsl:value-of select=&quot;'User'&quot;/>&#xa;                        &lt;/xsl:attribute>&#xa;                        &lt;xsl:value-of select=&quot;$UserName&quot;/>&#xa;                    &lt;/ns:Directory>&#xa;                &lt;/ns:DirectoryPath>&#xa;                &lt;ns:Authentication>&#xa;                    &lt;xsl:value-of select=&quot;$Password&quot;/>&#xa;                &lt;/ns:Authentication>&#xa;            &lt;/ns:Identity>&#xa;            &lt;ns:Transaction>&#xa;                &lt;ns:Command>&#xa;                    &lt;xsl:attribute name=&quot;type&quot;>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Query&amp;quot;&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                    &lt;ns:StartCount>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/ns:StartCount>&#xa;                    &lt;ns:MaxCount>&#xa;                        &lt;xsl:value-of select=&quot;1000&quot;/>&#xa;                    &lt;/ns:MaxCount>&#xa;                    &lt;ns:MasterCatalogRecord>&#xa;                        &lt;xsl:attribute name=&quot;etype&quot;>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Entity&amp;quot;&quot;/>&#xa;                        &lt;/xsl:attribute>&#xa;                        &lt;ns:ExternalKeys>&#xa;                            &lt;ns:Key>&#xa;                                &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;MASTERCATALOGNAME&amp;quot;&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;PRODUCT&amp;quot;&quot;/>&#xa;                            &lt;/ns:Key>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($get.parameters/tns1:idOfferta) and string-length($get.parameters/tns1:idOfferta)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIVULAFTTH'&quot;>&#xa;                                            &lt;ns:Key>&#xa;                                                &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;PRODUCTID&amp;quot;&quot;/>&#xa;                                                &lt;/xsl:attribute>&#xa;                                                &lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&#xa;                                            &lt;/ns:Key>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIBitstreamNGAFTTH'&quot;>&#xa;                                            &lt;ns:Key>&#xa;                                                &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;PRODUCTID&amp;quot;&quot;/>&#xa;                                                &lt;/xsl:attribute>&#xa;                                                &lt;xsl:value-of select=&quot;'BitstreamNGAFTTH'&quot;/>&#xa;                                            &lt;/ns:Key>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIEasyIPUBBFTTH'&quot;>&#xa;                                            &lt;ns:Key>&#xa;                                                &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;PRODUCTID&amp;quot;&quot;/>&#xa;                                                &lt;/xsl:attribute>&#xa;                                                &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                                            &lt;/ns:Key>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                                                &lt;ns:Key>&#xa;                                                    &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;PRODUCTID&amp;quot;&quot;/>&#xa;                                                    &lt;/xsl:attribute>&#xa;                                                    &lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                                                &lt;/ns:Key>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo=  'SEMIVULAFTTH'&quot;>&#xa;                                            &lt;ns:Key>&#xa;                                                &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;PRODUCTID&amp;quot;&quot;/>&#xa;                                                &lt;/xsl:attribute>&#xa;                                                &lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&#xa;                                            &lt;/ns:Key>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo=  'SEMIBitstreamNGAFTTH'&quot;>&#xa;                                            &lt;ns:Key>&#xa;                                                &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;PRODUCTID&amp;quot;&quot;/>&#xa;                                                &lt;/xsl:attribute>&#xa;                                                &lt;xsl:value-of select=&quot;'BitstreamNGAFTTH'&quot;/>&#xa;                                            &lt;/ns:Key>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo=  'SEMIEasyIPUBBFTTH'&quot;>&#xa;                                            &lt;ns:Key>&#xa;                                                &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;PRODUCTID&amp;quot;&quot;/>&#xa;                                                &lt;/xsl:attribute>&#xa;                                                &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                                            &lt;/ns:Key>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo&quot;>&#xa;                                                &lt;ns:Key>&#xa;                                                    &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;PRODUCTID&amp;quot;&quot;/>&#xa;                                                    &lt;/xsl:attribute>&#xa;                                                    &lt;xsl:value-of select=&quot;$get.parameters/tns1:offertaCatalogo&quot;/>&#xa;                                                &lt;/ns:Key>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;ns:Key>&#xa;                                &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RECORD_STATE&amp;quot;&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CONFIRMED&amp;quot;&quot;/>&#xa;                            &lt;/ns:Key>&#xa;                        &lt;/ns:ExternalKeys>&#xa;                        &lt;ns:Return>&#xa;                            &lt;ns:RelationshipData>&#xa;                                &lt;ns:Relationship>&#xa;                                    &lt;ns:RelationType>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;ProductComprisedOf&amp;quot;&quot;/>&#xa;                                    &lt;/ns:RelationType>&#xa;                                    &lt;ns:RelationDepth>&#xa;                                        &lt;xsl:value-of select=&quot;5&quot;/>&#xa;                                    &lt;/ns:RelationDepth>&#xa;                                &lt;/ns:Relationship>&#xa;                                &lt;ns:Relationship>&#xa;                                    &lt;ns:RelationType>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Characteristic&amp;quot;&quot;/>&#xa;                                    &lt;/ns:RelationType>&#xa;                                    &lt;ns:RelationDepth>&#xa;                                        &lt;xsl:value-of select=&quot;5&quot;/>&#xa;                                    &lt;/ns:RelationDepth>&#xa;                                &lt;/ns:Relationship>&#xa;                            &lt;/ns:RelationshipData>&#xa;                        &lt;/ns:Return>&#xa;                    &lt;/ns:MasterCatalogRecord>&#xa;                &lt;/ns:Command>&#xa;            &lt;/ns:Transaction>&#xa;        &lt;/ns:DataService>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
