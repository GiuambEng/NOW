                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Offerta&quot; xmlns:tns1=&quot;http://xmlns.example.com/IntegrazioneCatalogo/parameters&quot; xmlns:ns=&quot;http://www.tibco.com/cim/services/mastercatalogrecord/wsdl/2.0&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;MasterCatalogRecordAction&quot;/>&lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&lt;xsl:param name=&quot;ChiamaCatalogo&quot;/>&lt;xsl:template name=&quot;OutputDettOfferta&quot; match=&quot;/&quot;>&lt;tns:Offerta>&lt;tns:offertaOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta) and string-length($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta)>0&quot;>&lt;xsl:if test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:sezioneSuperiore>&lt;tns:label>&lt;xsl:value-of select=&quot;'Modulazione'&quot;/>&lt;/tns:label>&lt;tns:key>&lt;xsl:value-of select=&quot;'MODULAZIONE'&quot;/>&lt;/tns:key>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='EasyIPBasePlusLite' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='EasyIPBasePlusLite'&quot;>&lt;tns:componente>&lt;xsl:value-of select=&quot;'ACCESSOEASYIPBASEPLUSLITE'&quot;/>&lt;/tns:componente>&lt;/xsl:when>&lt;xsl:when