                             &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='VLANGBE' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='VLANGBE'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANGBE&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RACCOLTAVLANVULA&amp;quot;&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:domain>&#xa;                            &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                        &lt;/tns:domain>&#xa;                        &lt;tns:default>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                        &lt;/tns:default>&#xa;                        &lt;tns:mandatory>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;true&amp;quot;&quot;/>&#xa;                        &lt;/tns:mandatory>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:sezioneSuperiore>&#xa;                    &lt;tns:label>&#xa;                