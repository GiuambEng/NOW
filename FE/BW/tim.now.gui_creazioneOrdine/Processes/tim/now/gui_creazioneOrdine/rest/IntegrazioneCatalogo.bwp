                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Offerta&quot; xmlns:tns1=&quot;http://xmlns.example.com/IntegrazioneCatalogo/parameters&quot; xmlns:ns=&quot;http://www.tibco.com/cim/services/mastercatalogrecord/wsdl/2.0&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;MasterCatalogRecordAction.mcResponsePart&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;ChiamaCatalogo&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputDettOfferta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Offerta>&#xa;            &lt;tns:offertaOutput>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:idOfferta) and string-length($get.parameters/tns1:idOfferta)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo&quot;>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;$get.parameters/tns1:offertaCatalogo&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:sezioneSuperiore>&#xa;                    &lt;tns:label>&#xa;                   