                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2bb7e07a-126b-435b-858d-be0d93b7a15f+input&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160428153422PLT/ConceptSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1&quot;/>&#xa;    &lt;xsl:template name=&quot;offertaQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;idContratto>&#xa;                &lt;xsl:value-of select=&quot;$get1/parameters/tns2:integrazionecatalogo1GetParameters/contratto&quot;/>&#xa;            &lt;/idContratto>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="offertaQuery-input"
                                    name="offertaQuery"
                                    outputVariable="offertaQuery"
                                    tibex:xpdlId="2bb7e07a-126b-435b-858d-be0d93b7a15f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_IntCatal_InLog_INFOToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2bb7e07a-126b-435b-858d-be0d93b7a15f+input&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160428153422PLT/ConceptSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;offertaQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;idContratto>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/contratto&quot;/>&#xa;            &lt;/idContratto>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT O.NOME_OFFERTA_CATLG, O.OFFERTA, O.ID_OFFERTA&#xa;  FROM&#xa;       CONTRATTO_OFFERTA_CATLG COC JOIN OFFERTA O ON O.ID_OFFERTA = COC.ID_OFFERTA JOIN CONTRATTO C ON COC.ID_CONTRATTO = C.ID_CONTRATTO&#xa;  WHERE C.ID_CONTRATTO IN (?)&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idContratto"/>
                                    <columnMetadata
                                    columnName="NOME_OFFERTA_CATLG"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/sceltaOfferta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160428153422PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;offertaQuery&quot;/>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:template name=&quot;offertaMapper-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($offertaQuery/Record[1]/OFFERTA)>0 and $get1/parameters/tns2:integrazionecatalogo1GetParameters/lavorazione = ('ATTIVAZIONE','MIGRAZIONE')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($get1/parameters/tns2:integrazionecatalogo1GetParameters/flagMulticast) = 'Y'&quot;>&lt;tns3:ListaOfferteOutput>&lt;xsl:for-each select=&quot;$offertaQuery/Record[contains(OFFERTA, 'NP')=false() and NOME_OFFERTA_CATLG = 'FEEDER']&quot;>&lt;tns3:listaOffertaoutput>&lt;tns3:nomeOfferta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns3:nomeOfferta>&lt;tns3:nomeOffertaCatalogo>&lt;xsl:value-of select=&quot;NOME_OFFERTA_CATLG&quot;/>&lt;/tns3:nomeOffertaCatalogo>&lt;tns3:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&lt;/tns3:idOfferta>&lt;/tns3:listaOffertaoutput>&lt;/xsl:for-each>&lt;tns3:result>&lt;tns3:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns3:severity>&lt;tns3:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns3:code>&lt;/tns3:result>&lt;/tns3:ListaOfferteOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;$offertaQuery/Record[OFFERTA=('FULLGPONPLUS','FULLGPONPLUSNGA')]&quot;>&lt;tns3:ListaOfferteOutput>&lt;xsl:for-each select=&quot;$offertaQuery/Record&quot;>&lt;tns3:listaOffertaoutput>&lt;tns3:nomeOfferta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns3:nomeOfferta>&lt;tns3:nomeOffertaCatalogo>&lt;xsl:value-of select=&quot;NOME_OFFERTA_CATLG&quot;/>&lt;/tns3:nomeOffertaCatalogo>&lt;tns3:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&lt;/tns3:idOfferta>&lt;/tns3:listaOffertaoutput>&lt;/xsl:for-each>&lt;tns3:result>&lt;tns3:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns3:severity>&lt;tns3:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns3:code>&lt;/tns3:result>&lt;/tns3:ListaOfferteOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns3:ListaOfferteOutput>&lt;xsl:for-each select=&quot;$offertaQuery/Record[contains(OFFERTA, 'NP')=false() and ID_OFFERTA !=71 and ID_OFFERTA !=72 and ID_OFFERTA !=73 and ID_OFFERTA !=70]&quot;>&lt;tns3:listaOffertaoutput>&lt;tns3:nomeOfferta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns3:nomeOfferta>&lt;tns3:nomeOffertaCatalogo>&lt;xsl:value-of select=&quot;NOME_OFFERTA_CATLG&quot;/>&lt;/tns3:nomeOffertaCatalogo>&lt;tns3:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&lt;/tns3:idOfferta>&lt;/tns3:listaOffertaoutput>&lt;/xsl:for-each>&lt;tns3:result>&lt;tns3:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns3:severity>&lt;tns3:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns3:code>&lt;/tns3:result>&lt;/tns3:ListaOfferteOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns3:ListaOfferteOutput>&lt;xsl:for-each select=&quot;$offertaQuery/Record[ID_OFFERTA !=71 and ID_OFFERTA !=72 and ID_OFFERTA !=73 and ID_OFFERTA !=70]&quot;>&lt;tns3:listaOffertaoutput>&lt;tns3:nomeOfferta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns3:nomeOfferta>&lt;tns3:nomeOffertaCatalogo>&lt;xsl:value-of select=&quot;NOME_OFFERTA_CATLG&quot;/>&lt;/tns3:nomeOffertaCatalogo>&lt;tns3:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&lt;/tns3:idOfferta>&lt;/tns3:listaOffertaoutput>&lt;/xsl:for-each>&lt;tns3:result>&lt;tns3:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns3:severity>&lt;tns3:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns3:code>&lt;/tns3:result>&lt;/tns3:ListaOfferteOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="offertaMapper-input"
                                    name="offertaMapper"
                                    outputVariable="offertaMapper"
                                    tibex:xpdlId="cbc534af-f8af-47fb-a9c8-2abba2681c0e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="offertaMapperToget_IntCatal_outp_Log"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/sceltaOfferta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160428153422PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;offertaQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;offertaMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($offertaQuery/Record[1]/OFFERTA)>0 and $get1.parameters/lavorazione = ('ATTIVAZIONE','MIGRAZIONE')&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($get1.parameters/flagMulticast) = 'Y'&quot;>&#xa;                        &lt;tns3:ListaOfferteOutput>&#xa;                            &lt;xsl:for-each select=&quot;$offertaQuery/Record[contains(OFFERTA, 'NP')=false() and NOME_OFFERTA_CATLG = 'FEEDER']&quot;>&#xa;                                &lt;tns3:listaOffertaoutput>&#xa;                                    &lt;tns3:nomeOfferta>&#xa;                                        &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                    &lt;/tns3:nomeOfferta>&#xa;                                    &lt;tns3:nomeOffertaCatalogo>&#xa;                                        &lt;xsl:value-of select=&quot;NOME_OFFERTA_CATLG&quot;/>&#xa;                                    &lt;/tns3:nomeOffertaCatalogo>&#xa;                                    &lt;tns3:idOfferta>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&#xa;                                    &lt;/tns3:idOfferta>&#xa;                                &lt;/tns3:listaOffertaoutput>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns3:result>&#xa;                                &lt;tns3:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns3:severity>&#xa;                                &lt;tns3:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns3:code>&#xa;                            &lt;/tns3:result>&#xa;                        &lt;/tns3:ListaOfferteOutput>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$offertaQuery/Record[OFFERTA=('FULLGPONPLUS','FULLGPONPLUSNGA')]&quot;>&#xa;                        &lt;tns3:ListaOfferteOutput>&#xa;                            &lt;xsl:for-each select=&quot;$offertaQuery/Record&quot;>&#xa;                                &lt;tns3:listaOffertaoutput>&#xa;                                    &lt;tns3:nomeOfferta>&#xa;                                        &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                    &lt;/tns3:nomeOfferta>&#xa;                                    &lt;tns3:nomeOffertaCatalogo>&#xa;                                        &lt;xsl:value-of select=&quot;NOME_OFFERTA_CATLG&quot;/>&#xa;                                    &lt;/tns3:nomeOffertaCatalogo>&#xa;                                    &lt;tns3:idOfferta>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&#xa;                                    &lt;/tns3:idOfferta>&#xa;                                &lt;/tns3:listaOffertaoutput>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns3:result>&#xa;                                &lt;tns3:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns3:severity>&#xa;                                &lt;tns3:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns3:code>&#xa;                            &lt;/tns3:result>&#xa;                        &lt;/tns3:ListaOfferteOutput>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:ListaOfferteOutput>&#xa;                            &lt;xsl:for-each select=&quot;$offertaQuery/Record[contains(OFFERTA, 'NP')=false() and ID_OFFERTA !=71 and ID_OFFERTA !=72 and ID_OFFERTA !=73 and ID_OFFERTA !=70]&quot;>&#xa;                                &lt;tns3:listaOffertaoutput>&#xa;                                    &lt;tns3:nomeOfferta>&#xa;                                        &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                    &lt;/tns3:nomeOfferta>&#xa;                                    &lt;tns3:nomeOffertaCatalogo>&#xa;                                        &lt;xsl:value-of select=&quot;NOME_OFFERTA_CATLG&quot;/>&#xa;                                    &lt;/tns3:nomeOffertaCatalogo>&#xa;                                    &lt;tns3:idOfferta>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&#xa;                                    &lt;/tns3:idOfferta>&#xa;                                &lt;/tns3:listaOffertaoutput>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns3:result>&#xa;                                &lt;tns3:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns3:severity>&#xa;                                &lt;tns3:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns3:code>&#xa;                            &lt;/tns3:result>&#xa;                        &lt;/tns3:ListaOfferteOutput>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:ListaOfferteOutput>&#xa;                    &lt;xsl:for-each select=&quot;$offertaQuery/Record[ID_OFFERTA !=71 and ID_OFFERTA !=72 and ID_OFFERTA !=73 and ID_OFFERTA !=70]&quot;>&#xa;                        &lt;tns3:listaOffertaoutput>&#xa;                            &lt;tns3:nomeOfferta>&#xa;                                &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                            &lt;/tns3:nomeOfferta>&#xa;                            &lt;tns3:nomeOffertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;NOME_OFFERTA_CATLG&quot;/>&#xa;                            &lt;/tns3:nomeOffertaCatalogo>&#xa;                            &lt;tns3:idOfferta>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&#xa;                            &lt;/tns3:idOfferta>&#xa;                        &lt;/tns3:listaOffertaoutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:ListaOfferteOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:sceltaOfferta="http://www.tim.com/NOW/cmf/sceltaOfferta" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="sceltaOfferta:ListaOfferteOutput" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
