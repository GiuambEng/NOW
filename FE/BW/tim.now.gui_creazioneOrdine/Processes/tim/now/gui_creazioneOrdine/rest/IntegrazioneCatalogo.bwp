                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Offerta&quot; xmlns:tns1=&quot;http://xmlns.example.com/IntegrazioneCatalogo/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputDettOfferta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Offerta>&#xa;            &lt;tns:offertaOutput>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:idOfferta) and string-length($get.parameters/tns1:idOfferta)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo&quot;>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;$get.parameters/tns1:offertaCatalogo&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'SVLANCODE'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'SVLANCODE'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'USERVLAN'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'CVLAN ID'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'CVLANID'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'USERVLAN'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'NUMBER'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'int'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'UserVlan ID'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'USERVLANID'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'USERVLAN'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'NUMBER'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'int'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'IDVLAN OLO'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'IDVLANOLO'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'USERVLAN'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'string'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;                &lt;tns:sezioneInferiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'IDVLAN EOLO'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'IDVLANEOLO'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;'USERVLAN'&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'string'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneInferiore>&#xa;            &lt;/tns:offertaOutput>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns:code>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:Offerta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
