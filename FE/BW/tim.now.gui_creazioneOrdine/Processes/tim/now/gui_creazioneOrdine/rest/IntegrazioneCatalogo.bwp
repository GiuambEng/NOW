                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/cim/services/mastercatalogrecord/wsdl/2.0&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Offerta&quot; xmlns:tns1=&quot;http://xmlns.example.com/IntegrazioneCatalogo/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;MasterCatalogRecordAction.mcResponsePart&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;ChiamaCatalogo&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputDettOfferta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Offerta>&#xa;            &lt;tns:offertaOutput>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:idOfferta) and string-length($get.parameters/tns1:idOfferta)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo&quot;>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;$get.parameters/tns1:offertaCatalogo&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo=('ULL','ULLDati','SLU') or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG=('ULL','ULLDati','SLU')&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;'Inizio Validita'&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='ULL' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='ULL'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOULL'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='ULLDati' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='ULLDati'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOULLDATI'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOSLU'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'DATE'&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:domain>&#xa;                            &lt;xsl:value-of select=&quot;'date'&quot;/>&#xa;                        &lt;/tns:domain>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$ChiamaCatalogo='Y'&quot;>&#xa;                                &lt;xsl:if test=&quot;$MasterCatalogRecordAction.mcResponsePart/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:EntityData/ns:Attribute[@name='StartDate']&quot;>&#xa;                                    &lt;tns:default>&#xa;                                        &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction.mcResponsePart/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:EntityData/ns:Attribute[@name='StartDate']&quot;/>&#xa;                                    &lt;/tns:default>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:default>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/tns:default>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo=('ULL','ULLDati','SLU') or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG=('ULL','ULLDati','SLU')&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;'Fine validita'&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='ULL' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='ULL'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOULL'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='ULLDati' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='ULLDati'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOULLDATI'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOSLU'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'DATE'&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:domain>&#xa;                            &lt;xsl:value-of select=&quot;'date'&quot;/>&#xa;                        &lt;/tns:domain>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$ChiamaCatalogo='Y'&quot;>&#xa;                                &lt;xsl:if test=&quot;$MasterCatalogRecordAction.mcResponsePart/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:EntityData/ns:Attribute[@name='EndDate']&quot;>&#xa;                                    &lt;tns:default>&#xa;                                        &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction.mcResponsePart/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:EntityData/ns:Attribute[@name='EndDate']&quot;/>&#xa;                                    &lt;/tns:default>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:default>&#xa;                                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                &lt;/tns:default>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo=('ULL','ULLDati','SLU','SHA') or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG=('ULL','ULLDati','SLU','SHA')&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;'Bit rate'&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;'BITRATE'&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='ULL' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOULL'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='ULLDati' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='ULLDati'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOULLDATI'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='SLU' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='SLU'&quot;>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOSLU'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:componente>&#xa;                                    &lt;xsl:value-of select=&quot;'ACCESSOSHA'&quot;/>&#xa;                                &lt;/tns:componente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'NUMBER'&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:domain>&#xa;                            &lt;xsl:value-of select=&quot;'int'&quot;/>&#xa;                        &lt;/tns:domain>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns1:offertaCatalogo='ULL' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='ULL' and $ChiamaCatalogo='Y'&quot;>&#xa;                                &lt;xsl:if test=&quot;$MasterCatalogRecordAction.mcResponsePart/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='AccessoULL']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='BIT RATE']/ns:EntityData/ns:Attribute[@name='DefaultValue']&quot;>&#xa;                                    &lt;tns:default>&#x