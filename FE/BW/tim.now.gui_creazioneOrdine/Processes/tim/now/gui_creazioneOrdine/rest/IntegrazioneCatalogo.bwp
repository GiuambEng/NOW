                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/cim/services/mastercatalogrecord/wsdl/2.0&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Offerta&quot; xmlns:tns1=&quot;http://xmlns.example.com/IntegrazioneCatalogo/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MasterCatalogRecordAction&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;ChiamaCatalogo&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputDettOfferta&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Offerta>&#xa;            &lt;tns:offertaOutput>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta) and string-length($get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:idOfferta)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo&quot;>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBEAsimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat'&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;'Modulazione'&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;'MODULAZIONE'&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;tns:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ACCESSOGBEASIMFLAT'&quot;/>&#xa;                        &lt;/tns:componente>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:domain>&#xa;                            &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                        &lt;/tns:domain>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$ChiamaCatalogo='Y'&quot;>&#xa;                                &lt;xsl:if test=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_BitstreamGBEAsimmetricoFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='MODULAZIONE']/ns:EntityData/ns:Attribute[@name='RangeValue']&quot;>&#xa;                                    &lt;tns:default>&#xa;                                        &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_BitstreamGBEAsimmetricoFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='MODULAZIONE']/ns:EntityData/ns:Attribute[@name='RangeValue']&quot;/>&#xa;                                    &lt;/tns:default>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:default>&#xa;                                    &lt;xsl:value-of select=&quot;'Interleaved;Fast'&quot;/>&#xa;                                &lt;/tns:default>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$ChiamaCatalogo='Y'&quot;>&#xa;                                &lt;xsl:if test=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_BitstreamGBEAsimmetricoFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='MODULAZIONE']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;>&#xa;                                    &lt;tns:mandatory>&#xa;                                        &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_BitstreamGBEAsimmetricoFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='MODULAZIONE']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;/>&#xa;                                    &lt;/tns:mandatory>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:mandatory>&#xa;                                    &lt;xsl:value-of select=&quot;'true'&quot;/>&#xa;                                &lt;/tns:mandatory>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:sezioneSuperiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'Tipo Linea'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'TIPOLINEA'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBEAsimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat'&quot;>&#xa;                            &lt;tns:componente>&#xa;                                &lt;xsl:value-of select=&quot;'ACCESSOGBEASIMFLAT'&quot;/>&#xa;                            &lt;/tns:componente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:componente>&#xa;                                &lt;xsl:value-of select=&quot;'ACCESSOGBESIMFLAT'&quot;/>&#xa;                            &lt;/tns:componente>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xsl:value-of select=&quot;'list'&quot;/>&#xa;                    &lt;/tns:domain>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBEAsimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat' and $ChiamaCatalogo='Y'&quot;>&#xa;                            &lt;xsl:if test=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_BitstreamGBEAsimmetricoFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TIPOLINEA_GBE']/ns:EntityData/ns:Attribute[@name='RangeValue']&quot;>&#xa;                                &lt;tns:default>&#xa;                                    &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_BitstreamGBEAsimmetricoFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TIPOLINEA_GBE']/ns:EntityData/ns:Attribute[@name='RangeValue']&quot;/>&#xa;                                &lt;/tns:default>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBEAsimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat'&quot;>&#xa;                            &lt;tns:default>&#xa;                                &lt;xsl:value-of select=&quot;'POTS;ISDN;LineaNonFonia'&quot;/>&#xa;                            &lt;/tns:default>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBESimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat' and $ChiamaCatalogo='Y'&quot;>&#xa;                            &lt;xsl:if test=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_GBESimFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TipoLinea_GBESimFlat']/ns:EntityData/ns:Attribute[@name='RangeValue']&quot;>&#xa;                                &lt;tns:default>&#xa;                                    &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_GBESimFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TipoLinea_GBESimFlat']/ns:EntityData/ns:Attribute[@name='RangeValue']&quot;/>&#xa;                                &lt;/tns:default>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:default>&#xa;                                &lt;xsl:value-of select=&quot;'LineaNonFonia'&quot;/>&#xa;                            &lt;/tns:default>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBEAsimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat' and $ChiamaCatalogo='Y'&quot;>&#xa;                            &lt;xsl:if test=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_BitstreamGBEAsimmetricoFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TIPOLINEA_GBE']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;>&#xa;                                &lt;tns:mandatory>&#xa;                                    &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_BitstreamGBEAsimmetricoFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TIPOLINEA_GBE']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;/>&#xa;                                &lt;/tns:mandatory>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBESimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat' and $ChiamaCatalogo='Y'&quot;>&#xa;                            &lt;xsl:if test=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_GBESimFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TipoLinea_GBESimFlat']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;>&#xa;                                &lt;tns:mandatory>&#xa;                                    &lt;xsl:value-of select=&quot;$MasterCatalogRecordAction/mcResponsePart/ns:DataService/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_GBESimFlat']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='TipoLinea_GBESimFlat']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;/>&#xa;                                &lt;/tns:mandatory>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:mandatory>&#xa;                                &lt;xsl:value-of select=&quot;'true'&quot;/>&#xa;                            &lt;/tns:mandatory>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneSuperiore>&#xa;                &lt;tns:sezioneSuperiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'Profilo Tecnico Linea'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'PROFILOTECNICOLINEA'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$get/parameters/tns1:nuovordine-offerta1GetParameters/tns1:offertaCatalogo='BitstreamGBEAsimmetricoFlat' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='BitstreamGBEAsimmetricoFlat'&quot;>&#xa;                            &lt;tns:componente>&#xa;                                &lt;xsl:value-of select=&quot;'ACCESSOGBEASIMFLAT'&quot;/>&#xa;                            &lt;/tns:componente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:componente>&#xa;                                &lt;xsl:value-of select=&quot;'ACCESSOGBESIMFLAT'&quot;/>&#xa;                            &lt;/tns:componente>&#xa;                        &lt;/xsl:otherwise>&#xa;        