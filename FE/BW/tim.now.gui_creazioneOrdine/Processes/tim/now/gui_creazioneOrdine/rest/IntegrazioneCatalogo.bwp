  &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Opzione Traffico&amp;quot;&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OPZIONETRAFFICO&amp;quot;&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;tns:componente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACCESSOCPS&amp;quot;&quot;/>&#xa;                        &lt;/tns:componente>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:mandatory>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;true&amp;quot;&quot;/>&#xa;                        &lt;/tns:mandatory>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo='CPS' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='CPS'&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Codice Carrier Olo&amp;quot;&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CODICECARRIEROLO&amp;quot;&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;tns:componente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACCESSOCPS&amp;quot;&quot;/>&#xa;                        &lt;/tns:componente>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:mandatory>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;true&amp;quot;&quot;/>&#xa;                        &lt;/tns:mandatory>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo='CPS' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='CPS'&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Data Sottoscrizione Contratto&amp;quot;&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DSC&amp;quot;&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;tns:componente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACCESSOCPS&amp;quot;&quot;/>&#xa;                        &lt;/tns:componente>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATE&amp;quot;&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:mandatory>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;true&amp;quot;&quot;/>&#xa;                        &lt;/tns:mandatory>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo='CPS' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='CPS'&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DN&amp;quot;&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DN&amp;quot;&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;tns:componente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACCESSOCPS&amp;quot;&quot;/>&#xa;                        &lt;/tns:componente>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:mandatory>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;true&amp;quot;&quot;/>&#xa;                        &lt;/tns:mandatory>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$get.parameters/tns1:offertaCatalogo='CPS' or $RecuperoOfferta/Record[1]/NOME_OFFERTA_CATLG='CPS'&quot;>&#xa;                    &lt;tns:sezioneSuperiore>&#xa;                        &lt;tns:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DNPRIMARIO&amp;quot;&quot;/>&#xa;                        &lt;/tns:label>&#xa;                        &lt;tns:key>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DNPRIMARIO&amp;quot;&quot;/>&#xa;                        &lt;/tns:key>&#xa;                        &lt;tns:componente>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACCESSOCPS&amp;quot;&quot;/>&#xa;                        &lt;/tns:componente>&#xa;                        &lt;tns:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                        &lt;/tns:tipologiaDato>&#xa;                        &lt;tns:mandatory>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;true&amp;quot;&quot;/>&#xa;                        &lt;/tns:mandatory>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/tns:sezioneSuperiore>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:offertaOutput>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns:code>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:Offerta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
