&lt;xsl:value-of select=&quot;$MasterCatalogRecordAction.mcResponsePart/ns:Transaction[1]/ns:Response[1]/ns:MasterCatalogRecord[1]/ns:RelationshipData/ns:Relationship[ns:RelationType='PRODUCTCOMPRISEDOF']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='Accesso_FixedWirelessAccess']/ns:RelationshipData/ns:Relationship[ns:RelationType='CHARACTERISTIC']/ns:RelatedEntities/ns:MasterCatalogRecord[ns:ExternalKeys/ns:Key[@name='PRODUCTID']='FLAGINTERVENTO']/ns:EntityData/ns:Attribute[@name='Mandatory']&quot;/>&#xa;                                &lt;/tns:mandatory>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:mandatory>&#xa;                                &lt;xsl:value-of select=&quot;'true'&quot;/>&#xa;                            &lt;/tns:mandatory>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:progressivo>&#xa;                &lt;/tns:sezioneSuperiore>&#xa;                &lt;tns:sezioneSuperiore>&#xa;                    &lt;tns:label>&#xa;                        &lt;xsl:value-of select=&quot;'PROFILO'&quot;/>&#xa;                    &lt;/tns:label>&#xa;                    &lt;tns:key>&#xa;                        &lt;xsl:value-of select=&quot;'PROFILO'&quot;/>&#xa;                    &lt;/tns:key>&#xa;                    &lt;tns:componente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ACCESSOFWA&amp;quot;&quot;/>&#xa;                    &lt;/tns:componente>&#xa;                    &lt;tns:tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                    &lt;/tns:tipologiaDato>&#xa;                    &lt;tns:domain>&#xa;                        &lt;xs