                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:inputservizioricercaavanzata>&#xa;            &lt;xsl:copy-of select=&quot;$post1/item/tns1:inputservizioricercaavanzata/tns1:strutturaCondition&quot;/>&#xa;            &lt;xsl:if test=&quot;$post1/item/tns1:inputservizioricercaavanzata/tns1:indiceriga&quot;>&#xa;                &lt;tns1:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$post1/item/tns1:inputservizioricercaavanzata/tns1:indiceriga&quot;/>&#xa;                &lt;/tns1:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1/item/tns1:inputservizioricercaavanzata/tns1:numerorighe&quot;>&#xa;                &lt;tns1:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$post1/item/tns1:inputservizioricercaavanzata/tns1:numerorighe&quot;/>&#xa;                &lt;/tns1:numerorighe>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Ricerca_Avanazata-input"
                                    name="Ricerca_Avanazata"
                                    outputVariable="Ricerca_Avanazata"
                                    tibex:xpdlId="30e44e4e-3be7-4ad8-8ae1-7dea1ca1d2ab"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToRicerca_Avanazata"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToSQLDirect"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:inputservizioricercaavanzata>&#xa;            &lt;xsl:copy-of select=&quot;$post1.item/tns1:strutturaCondition&quot;/>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns1:indiceriga&quot;>&#xa;                &lt;tns1:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns1:indiceriga&quot;/>&#xa;                &lt;/tns1:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns1:numerorighe&quot;>&#xa;                &lt;tns1:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns1:numerorighe&quot;/>&#xa;                &lt;/tns1:numerorighe>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_creazioneOrdine.sub.RicercaAvanzataConditions" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4eea67b7-1783-4971-8d8d-34805611897b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ricerca_Avanazata&quot;/>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post1/item/tns1:inputservizioricercaavanzata/tns1:strutturaCondition[1]/tns1:nome)=0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT SLA.SLA, TIPLIN.TIPOLG_LINEA, SOTLAV.DESCR, O.OFFERTA,  LAV.TIPOLG_LAVRZ, SLA.DATAFI_VALID, SLA.DATAINZ_VALID, SLA.FLAG_MONITORAGGIO,SLA.FLAG_RECLAMO FROM     APPUSER.SLA_ORDN SLA LEFT OUTER JOIN APPUSER.TIPOLG_LINEA TIPLIN ON SLA.IDTPLG_LINEA = TIPLIN.IDTPLG_LINEA LEFT OUTER JOIN APPUSER.TIPOLG_SOTTO_LAVRZ SOTLAV ON SLA.IDTPLG_SOTTO_LAVRZ = SOTLAV.IDTPLG_SOTTO_LAVRZ LEFT OUTER JOIN APPUSER.OFFERTA O ON O.ID_OFFERTA = SLA.ID_OFFERTA LEFT OUTER JOIN APPUSER.TIPOLG_LAVRZ LAV ON LAV.IDTPLG_LAVRZ = SLA.IDTPLG_LAVRZ&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT SLA.SLA, TIPLIN.TIPOLG_LINEA, SOTLAV.DESCR, O.OFFERTA,  LAV.TIPOLG_LAVRZ, SLA.DATAFI_VALID, SLA.DATAINZ_VALID, SLA.FLAG_MONITORAGGIO,SLA.FLAG_RECLAMO FROM     APPUSER.SLA_ORDN SLA LEFT OUTER JOIN APPUSER.TIPOLG_LINEA TIPLIN ON SLA.IDTPLG_LINEA = TIPLIN.IDTPLG_LINEA LEFT OUTER JOIN APPUSER.TIPOLG_SOTTO_LAVRZ SOTLAV ON SLA.IDTPLG_SOTTO_LAVRZ = SOTLAV.IDTPLG_SOTTO_LAVRZ LEFT OUTER JOIN APPUSER.OFFERTA O ON O.ID_OFFERTA = SLA.ID_OFFERTA LEFT OUTER JOIN APPUSER.TIPOLG_LAVRZ LAV ON LAV.IDTPLG_LAVRZ = SLA.IDTPLG_LAVRZ WHERE &amp;quot;, tib:concat-sequence-format($Ricerca_Avanazata/tns1:outputcondition, &amp;quot;','&amp;quot;, true()), &amp;quot;&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SQLDirect-input"
                                    name="SQLDirect"
                                    outputVariable="SQLDirect"
                                    tibex:xpdlId="4eea67b7-1783-4971-8d8d-34805611897b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToSQLDirect"/>
                                    <bpws:target linkName="EmptyToSQLDirect_NORICAVANZATA"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SQLDirectToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4eea67b7-1783-4971-8d8d-34805611897b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Ricerca_Avanazata&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post1.item/tns1:strutturaCondition[1]/tns1:nome)=0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT SLA.SLA, TIPLIN.TIPOLG_LINEA, SOTLAV.DESCR, O.OFFERTA,  LAV.TIPOLG_LAVRZ, SLA.DATAFI_VALID, SLA.DATAINZ_VALID, SLA.FLAG_MONITORAGGIO,SLA.FLAG_RECLAMO FROM     APPUSER.SLA_ORDN SLA LEFT OUTER JOIN APPUSER.TIPOLG_LINEA TIPLIN ON SLA.IDTPLG_LINEA = TIPLIN.IDTPLG_LINEA LEFT OUTER JOIN APPUSER.TIPOLG_SOTTO_LAVRZ SOTLAV ON SLA.IDTPLG_SOTTO_LAVRZ = SOTLAV.IDTPLG_SOTTO_LAVRZ LEFT OUTER JOIN APPUSER.OFFERTA O ON O.ID_OFFERTA = SLA.ID_OFFERTA LEFT OUTER JOIN APPUSER.TIPOLG_LAVRZ LAV ON LAV.IDTPLG_LAVRZ = SLA.IDTPLG_LAVRZ&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT SLA.SLA, TIPLIN.TIPOLG_LINEA, SOTLAV.DESCR, O.OFFERTA,  LAV.TIPOLG_LAVRZ, SLA.DATAFI_VALID, SLA.DATAINZ_VALID, SLA.FLAG_MONITORAGGIO,SLA.FLAG_RECLAMO FROM     APPUSER.SLA_ORDN SLA LEFT OUTER JOIN APPUSER.TIPOLG_LINEA TIPLIN ON SLA.IDTPLG_LINEA = TIPLIN.IDTPLG_LINEA LEFT OUTER JOIN APPUSER.TIPOLG_SOTTO_LAVRZ SOTLAV ON SLA.IDTPLG_SOTTO_LAVRZ = SOTLAV.IDTPLG_SOTTO_LAVRZ LEFT OUTER JOIN APPUSER.OFFERTA O ON O.ID_OFFERTA = SLA.ID_OFFERTA LEFT OUTER JOIN APPUSER.TIPOLG_LAVRZ LAV ON LAV.IDTPLG_LAVRZ = SLA.IDTPLG_LAVRZ WHERE &amp;quot;, tib:concat-sequence-format($Ricerca_Avanazata/tns1:outputcondition, &amp;quot;','&amp;quot;, true()), &amp;quot;&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="AssignSLATime"
                                    outputVariable="Variable"
                                    tibex:xpdlId="6a44a335-889d-4542-af06-6f8b18273016" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SQLDirectToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignSLATimeToCallProcess2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AssignSLATimeToScope_ExportData">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($post1/item/ns6:inputservizioricercaavanzata/ns6:exportRequest) and (upper-case($post1/item/ns6:inputservizioricercaavanzata/ns6:exportRequest)='S' or upper-case($post1/item/ns6:inputservizioricercaavanzata/ns6:exportRequest)='Y') and exists($SQLDirect/unknownResultset[1]/row[1])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($post1.item/ns6:exportRequest) and (upper-case($post1.item/ns6:exportRequest)='S' or upper-case($post1.item/ns6:exportRequest)='Y') and exists($SQLDirect/unknownResultset[1]/row[1])]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/visualizzazioneSlaTime&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns:visualizzazioneSlaTimeOutput>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&lt;tns:visualizzazioneSlaTime>&lt;xsl:if test=&quot;not((string(column[name='SLA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='SLA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='SLA']/value)&quot;>&lt;tns:giorniSla>&lt;xsl:value-of select=&quot;column[name='SLA']/value&quot;/>&lt;/tns:giorniSla>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLG_LINEA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLG_LINEA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLG_LINEA']/value)&quot;>&lt;tns:tipoLinea>&lt;xsl:value-of select=&quot;column[name='TIPOLG_LINEA']/value&quot;/>&lt;/tns:tipoLinea>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR']/value)&quot;>&lt;tns:causaleOrdine>&lt;xsl:value-of select=&quot;column[name='DESCR']/value&quot;/>&lt;/tns:causaleOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']/value)&quot;>&lt;tns:prodotto>&lt;xsl:value-of select=&quot;column[name='OFFERTA']/value&quot;/>&lt;/tns:prodotto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLG_LAVRZ']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLG_LAVRZ']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLG_LAVRZ']/value)&quot;>&lt;tns:tipoLavorazione>&lt;xsl:value-of select=&quot;column[name='TIPOLG_LAVRZ']/value&quot;/>&lt;/tns:tipoLavorazione>&lt;/xsl:if>&lt;tns:dataInizio>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATAINZ_VALID']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizio>&lt;tns:dataFine>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATAFI_VALID']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFine>&lt;xsl:if test=&quot;not((string(column[name='FLAG_MONITORAGGIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_MONITORAGGIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_MONITORAGGIO']/value)&quot;>&lt;tns:flagMonitoraggio>&lt;xsl:value-of select=&quot;column[name='FLAG_MONITORAGGIO']/value&quot;/>&lt;/tns:flagMonitoraggio>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_RECLAMO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_RECLAMO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_RECLAMO']/value)&quot;>&lt;tns:flagReclamo>&lt;xsl:value-of select=&quot;column[name='FLAG_RECLAMO']/value&quot;/>&lt;/tns:flagReclamo>&lt;/xsl:if>&lt;/tns:visualizzazioneSlaTime>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;not(exists($SQLDirect/unknownResultset[1]/row[1]))&quot;>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'NESSUN RISULTATO TROVATO'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:visualizzazioneSlaTimeOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:param name=&quot;Ricerca_Avanazata&quot;/>&#xa;    &lt;xsl:template name=&quot;post_SlaTime_outp_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$post1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputVisualizzazioneSlaTime:&amp;quot;,&amp;quot;SELECT SLA.SLA, TIPLIN.TIPOLG_LINEA, SOTLAV.DESCR, O.OFFERTA,  LAV.TIPOLG_LAVRZ, SLA.DATAFI_VALID, SLA.DATAINZ_VALID, SLA.FLAG_MONITORAGGIO,SLA.FLAG_RECLAMO FROM     APPUSER.SLA_ORDN SLA LEFT OUTER JOIN APPUSER.TIPOLG_LINEA TIPLIN ON SLA.IDTPLG_LINEA = TIPLIN.IDTPLG_LINEA LEFT OUTER JOIN APPUSER.TIPOLG_SOTTO_LAVRZ SOTLAV ON SLA.IDTPLG_SOTTO_LAVRZ = SOTLAV.IDTPLG_SOTTO_LAVRZ LEFT OUTER JOIN APPUSER.OFFERTA O ON O.ID_OFFERTA = SLA.ID_OFFERTA LEFT OUTER JOIN APPUSER.TIPOLG_LAVRZ LAV ON LAV.IDTPLG_LAVRZ = SLA.IDTPLG_LAVRZ WHERE &amp;quot;, tib:concat-sequence-format($Ricerca_Avanazata/tns2:outputcondition, &amp;quot;','&amp;quot;, true()), &amp;quot;&amp;quot;)&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;            &lt;tns3:ActiveLoggerServices>&#xa;                &lt;tns3:Envelope>&#xa;                    &lt;tns3:Identifier>&#xa;                        &lt;tns3:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ServiceName>&#xa;                        &lt;tns3:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Operation>&#xa;                        &lt;tns3:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Source>&#xa;                        &lt;xsl:if test=&quot;$post1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tn