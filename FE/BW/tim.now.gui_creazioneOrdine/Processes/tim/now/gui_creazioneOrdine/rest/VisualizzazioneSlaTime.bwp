&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160511122117PLT" xmlns:tns="http://www.tim.com/NOW/rest/visualizzazioneSlaTime" version="2.0"&gt;
