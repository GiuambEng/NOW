    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>post1</variable>
                <variable>get1</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="VisualizzazioneSlaTimeOut">
            <endingVariables>
                <variable>VisualizzazioneSlaTimeOut-input</variable>
                <variable>SLATimeQuery</variable>
            </endingVariables>
        </task>
        <task name="get_SlaTime_out_Log">
            <endingVariables>
                <variable>get_SlaTime_out_Log-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="get_SlaTime_IngetLog">
            <endingVariables>
                <variable>get_SlaTime_IngetLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_SlaTime_IngetLog_INFO">
            <endingVariables>
                <variable>get_SlaTime_IngetLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="SLATimeQuery">
            <endingVariables>
                <variable>SLATimeQuery-input</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails2</variable>
            </endingVariables>
        </task>
        <task name="get_SlaTime_Error_Log">
            <endingVariables>
                <variable>get_SlaTime_Error_Log-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>SQLDirect</variable>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="Ricerca_Avanazata">
            <endingVariables>
                <variable>Ricerca_Avanazata-input</variable>
            </endingVariables>
        </task>
        <task name="SQLDirect">
            <endingVariables>
                <variable>SQLDirect-input</variable>
            </endingVariables>
        </task>
        <task name="post_SlaTime_outp_Log">
            <endingVariables>
                <variable>post_SlaTime_outp_Log-input</variable>
                <variable>LoggerInfo</variable>
                <variable>Ricerca_Avanazata</variable>
            </endingVariables>
        </task>
        <task name="post_SlaTime_InLog">
            <endingVariables>
                <variable>post_SlaTime_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="post_SlaTime_InLog_INFO">
