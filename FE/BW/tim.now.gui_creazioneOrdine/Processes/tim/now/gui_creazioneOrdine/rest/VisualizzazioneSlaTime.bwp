            </endingVariables>
        </task>
        <task name="JDBCQuery">
            <endingVariables>
                <variable>JDBCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="RenderXml">
            <endingVariables>
                <variable>RenderXml-input</variable>
            </endingVariables>
        </task>
        <task name="ExportDati">
            <endingVariables>
                <variable>ExportDati-input</variable>
                <variable>RenderXml</variable>
            </endingVariables>
        </task>
        <task name="post_SlaTime_ErrorLog">
            <endingVariables>
                <variable>post_SlaTime_ErrorLog-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply1">
            <endingVariables>
                <variable>Reply1-input</variable>
                <variable>FaultDetails4</variable>
            </endingVariables>
        </task>
