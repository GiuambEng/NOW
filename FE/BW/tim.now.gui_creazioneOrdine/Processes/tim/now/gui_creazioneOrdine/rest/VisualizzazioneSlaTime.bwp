                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="SLATimeQuery-input"
                                    name="SLATimeQuery"
                                    outputVariable="SLATimeQuery"
                                    tibex:xpdlId="eedd207f-d94d-49ab-a175-e1f9d988facb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
