.FLAG_MONITORAGGIO,SLA.FLAG_RECLAMO FROM     APPUSER.SLA_ORDN SLA LEFT OUTER JOIN APPUSER.TIPOLG_LINEA TIPLIN ON SLA.IDTPLG_LINEA = TIPLIN.IDTPLG_LINEA LEFT OUTER JOIN APPUSER.TIPOLG_SOTTO_LAVRZ SOTLAV ON SLA.IDTPLG_SOTTO_LAVRZ = SOTLAV.IDTPLG_SOTTO_LAVRZ LEFT OUTER JOIN APPUSER.OFFERTA O ON O.ID_OFFERTA = SLA.ID_OFFERTA LEFT OUTER JOIN APPUSER.TIPOLG_LAVRZ LAV ON LAV.IDTPLG_LAVRZ = SLA.IDTPLG_LAVRZ WHERE &amp;quot;, tib:concat-sequence-format($Ricerca_Avanazata/tns2:outputcondition, &amp;quot;','&amp;quot;, true()), &amp;quot;&amp;quot;)&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;            &lt;tns3:ActiveLoggerServices>&#xa;                &lt;tns3:Envelope>&#xa;                    &lt;tns3:Identifier>&#xa;                        &lt;tns3:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ServiceName>&#xa;                        &lt;tns3:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Operation>&#xa;                        &lt;tns3:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Source>&#xa;                        &lt;xsl:if test=&quot;$post1.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns3:BusinessID>&#xa;                    