                            <bpws:reply name="VisualizzazioneSlaTimeOut"
                                operation="get"
                                partnerLink="visualizzazioneslatime"
                                portType="ns:visualizzazioneslatime3"
                                tibex:xpdlId="e76d57cf-8ce3-4e90-9b14-816e04d59d27" variable="VisualizzazioneSlaTimeOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://xmlns.example.com/20160511122117PLT" xmlns:tns="http://www.tim.com/NOW/rest/visualizzazioneSlaTime" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="SLATimeQuery"/&gt;
    &lt;xsl:template name="VisualizzazioneSlaTimeOut-input" match="/"&gt;
        &lt;tns1:getResponse4&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($SLATimeQuery/Record)"&gt;
                        &lt;tns:visualizzazioneSlaTimeOutput&gt;
                            &lt;xsl:for-each select="$SLATimeQuery/Record"&gt;
                                &lt;tns:visualizzazioneSlaTime&gt;
                                    &lt;tns:giorniSla&gt;
                                        &lt;xsl:value-of select="xsd:int(SLA)"/&gt;
                                    &lt;/tns:giorniSla&gt;
                                    &lt;xsl:if test="TIPOLG_LINEA"&gt;
                                        &lt;tns:tipoLinea&gt;
                                            &lt;xsl:value-of select="TIPOLG_LINEA"/&gt;
                                        &lt;/tns:tipoLinea&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="DESCR"&gt;
                                        &lt;tns:causaleOrdine&gt;
                                            &lt;xsl:value-of select="DESCR"/&gt;
                                        &lt;/tns:causaleOrdine&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="OFFERTA"&gt;
                                        &lt;tns:prodotto&gt;
                                            &lt;xsl:value-of select="OFFERTA"/&gt;
                                        &lt;/tns:prodotto&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="TIPOLG_LAVRZ"&gt;
                                        &lt;tns:tipoLavorazione&gt;
                                            &lt;xsl:value-of select="TIPOLG_LAVRZ"/&gt;
                                        &lt;/tns:tipoLavorazione&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:dataInizio&gt;
                                        &lt;xsl:value-of select="substring-before(string(DATAINZ_VALID),&amp;quot;T&amp;quot;)"/&gt;
                                    &lt;/tns:dataInizio&gt;
                                    &lt;tns:dataFine&gt;
                                        &lt;xsl:value-of select="substring-before(string(DATAFI_VALID),&amp;quot;T&amp;quot;)"/&gt;
                                    &lt;/tns:dataFine&gt;
                                    &lt;xsl:if test="FLAG_MONITORAGGIO"&gt;
                                        &lt;tns:flagMonitoraggio&gt;
                                            &lt;xsl:value-of select="FLAG_MONITORAGGIO"/&gt;
                                        &lt;/tns:flagMonitoraggio&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="FLAG_RECLAMO"&gt;
                                        &lt;tns:flagReclamo&gt;
                                            &lt;xsl:value-of select="FLAG_RECLAMO"/&gt;
                                        &lt;/tns:flagReclamo&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:visualizzazioneSlaTime&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:visualizzazioneSlaTimeOutput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:visualizzazioneSlaTimeOutput&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                                &lt;tns:details&gt;
                                    &lt;xsl:value-of select="&amp;quot;Nessun record trovato&amp;quot;"/&gt;
                                &lt;/tns:details&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:visualizzazioneSlaTimeOutput&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns1:getResponse4&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160511122117PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/visualizzazioneSlaTime&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SLATimeQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneSlaTimeOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($SLATimeQuery/Record)&quot;>&#xa;                &lt;tns:visualizzazioneSlaTimeOutput>&#xa;                    &lt;xsl:for-each select=&quot;$SLATimeQuery/Record&quot;>&#xa;                        &lt;tns:visualizzazioneSlaTime>&#xa;                            &lt;tns:giorniSla>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(SLA)&quot;/>&#xa;                            &lt;/tns:giorniSla>&#xa;                            &lt;xsl:if test=&quot;TIPOLG_LINEA&quot;>&#xa;                                &lt;tns:tipoLinea>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLG_LINEA&quot;/>&#xa;                                &lt;/tns:tipoLinea>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR&quot;>&#xa;                                &lt;tns:causaleOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                                &lt;/tns:causaleOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns:prodotto>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns:prodotto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPOLG_LAVRZ&quot;>&#xa;                                &lt;tns:tipoLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;TIPOLG_LAVRZ&quot;/>&#xa;                                &lt;/tns:tipoLavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataInizio>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DATAINZ_VALID),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataInizio>&#xa;                            &lt;tns:dataFine>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DATAFI_VALID),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataFine>&#xa;                            &lt;xsl:if test=&quot;FLAG_MONITORAGGIO&quot;>&#xa;                                &lt;tns:flagMonitoraggio>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_MONITORAGGIO&quot;/>&#xa;                                &lt;/tns:flagMonitoraggio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;FLAG_RECLAMO&quot;>&#xa;                                &lt;tns:flagReclamo>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_RECLAMO&quot;/>&#xa;                                &lt;/tns:flagReclamo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:visualizzazioneSlaTime>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:visualizzazioneSlaTimeOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:visualizzazioneSlaTimeOutput>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:visualizzazioneSlaTimeOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToVisualizzazioneSlaTimeOut"/>
                                </bpws:targets>
                                <bpws:correlations/>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;get1&quot;/>&#xa;    &lt;xsl:template name=&quot;get_SlaTime_out_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputVisualizzazioneSlaTime:&amp;quot;,&amp;quot;SELECT SLA.SLA, TIPLIN.TIPOLG_LINEA, SOTLAV.DESCR, O.OFFERTA,LAV.TIPOLG_LAVRZ, SLA.DATAFI_VALID, SLA.DATAINZ_VALID, SLA.FLAG_MONITORAGGIO,SLA.FLAG_RECLAMO FROM APPUSER.SLA_ORDN SLA LEFT OUTER JOIN APPUSER.TIPOLG_LINEA TIPLIN ON SLA.IDTPLG_LINEA = TIPLIN.IDTPLG_LINEA LEFT OUTER JOIN APPUSER.TIPOLG_SOTTO_LAVRZ SOTLAV ON SLA.IDTPLG_SOTTO_LAVRZ = SOTLAV.IDTPLG_SOTTO_LAVRZ LEFT OUTER JOIN APPUSER.OFFERTA O ON O.ID_OFFERTA = SLA.ID_OFFERTA LEFT OUTER JOIN APPUSER.TIPOLG_LAVRZ LAV ON LAV.IDTPLG_LAVRZ = SLA.IDTPLG_LAVRZ&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get1/httpHeaders/tns1:httpHeaders/GUI-SID,$get1/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzazionaSlaTime_&amp;quot;,$get1/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizazioneSlaTime_&amp;quot;,$get1/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_SlaTime_out_Log-input"
