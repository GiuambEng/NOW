                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20160511122117PLT" xmlns:tns="http://www.tim.com/NOW/rest/visualizzazioneSlaTime" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/rest/servizioricercaavanzata" version="2.0"&gt;
    &lt;xsl:param name="JDBCQuery"/&gt;
    &lt;xsl:param name="Variable"/&gt;
    &lt;xsl:param name="post1"/&gt;
    &lt;xsl:param name="SQLDirect"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns3:postResponse2&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($post1/item/tns2:inputservizioricercaavanzata/tns2:exportRequest) and (upper-case($post1/item/tns2:inputservizioricercaavanzata/tns2:exportRequest)='S' or upper-case($post1/item/tns2:inputservizioricercaavanzata/tns2:exportRequest)='Y') and exists($SQLDirect/unknownResultset[1]/row[1])"&gt;
                        &lt;tns:visualizzazioneSlaTimeOutput&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="xsd:string($JDBCQuery/Record[1]/NEXTVAL)"/&gt;
                            &lt;/tns:idExportFile&gt;
                        &lt;/tns:visualizzazioneSlaTimeOutput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;xsl:copy-of select="$Variable"/&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns3:postResponse2&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
