                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToVisualizzazioneSlaTimeOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;get_SlaTime_out_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputVisualizzazioneSlaTime:&amp;quot;,&amp;quot;SELECT SLA.SLA, TIPLIN.TIPOLG_LINEA, SOTLAV.DESCR, O.OFFERTA,LAV.TIPOLG_LAVRZ, SLA.DATAFI_VALID, SLA.DATAINZ_VALID, SLA.FLAG_MONITORAGGIO,SLA.FLAG_RECLAMO FROM APPUSER.SLA_ORDN SLA LEFT OUTER JOIN APPUSER.TIPOLG_LINEA TIPLIN ON SLA.IDTPLG_LINEA = TIPLIN.IDTPLG_LINEA LEFT OUTER JOIN APPUSER.TIPOLG_SOTTO_LAVRZ SOTLAV ON SLA.IDTPLG_SOTTO_LAVRZ = SOTLAV.IDTPLG_SOTTO_LAVRZ LEFT OUTER JOIN APPUSER.OFFERTA O ON O.ID_OFFERTA = SLA.ID_OFFERTA LEFT OUTER JOIN APPUSER.TIPOLG_LAVRZ LAV ON LAV.IDTPLG_LAVRZ = SLA.IDTPLG_LAVRZ&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.VisualizzazioneSlaTime&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get1.httpHeaders/GUI-SID,$get1.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzazionaSlaTime_&amp;quot;,$get1.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizazioneSlaTime_&amp;quot;,$get1.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
