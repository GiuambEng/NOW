                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+eedd207f-d94d-49ab-a175-e1f9d988facb+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT SLA.SLA, TIPLIN.TIPOLG_LINEA, SOTLAV.DESCR, O.OFFERTA,&#xa;  LAV.TIPOLG_LAVRZ, SLA.DATAFI_VALID, SLA.DATAINZ_VALID, SLA.FLAG_MONITORAGGIO,&#xa;  SLA.FLAG_RECLAMO&#xa;  FROM&#xa;  SLA_ORDN SLA LEFT JOIN TIPOLG_LINEA TIPLIN ON SLA.IDTPLG_LINEA = TIPLIN.IDTPLG_LINEA LEFT JOIN TIPOLG_SOTTO_LAVRZ SOTLAV ON SLA.IDTPLG_SOTTO_LAVRZ = SOTLAV.IDTPLG_SOTTO_LAVRZ LEFT JOIN OFFERTA O ON O.ID_OFFERTA = SLA.ID_OFFERTA LEFT JOIN TIPOLG_LAVRZ LAV ON LAV.IDTPLG_LAVRZ = SLA.IDTPLG_LAVRZ&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="SLA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIPOLG_LINEA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLG_LAVRZ"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="FLAG_MONITORAGGIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_RECLAMO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
