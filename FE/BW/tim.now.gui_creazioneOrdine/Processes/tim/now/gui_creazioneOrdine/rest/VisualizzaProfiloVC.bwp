                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+034aafe0-7ba3-4de9-abd6-b07ae95b19e1+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaProfiloVC/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;ProfiloVCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idOfferta>&lt;xsl:value-of select=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:idOfferta&quot;/>&lt;/idOfferta>&lt;tipoProfilo>&lt;xsl:value-of select=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:tipoProfilo&quot;/>&lt;/tipoProfilo>&lt;profiloTecnicoLinea>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:profTecnicoLinea)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:profTecnicoLinea&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/profiloTecnicoLinea>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ProfiloVCQuery-input"
                                    name="ProfiloVCQuery"
                                    outputVariable="ProfiloVCQuery"
                                    tibex:xpdlId="034aafe0-7ba3-4de9-abd6-b07ae95b19e1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToProfiloVCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ProfiloVCQueryToEmpty1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+034aafe0-7ba3-4de9-abd6-b07ae95b19e1+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaProfiloVC/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ProfiloVCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;idOfferta>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:idOfferta&quot;/>&#xa;            &lt;/idOfferta>&#xa;            &lt;tipoProfilo>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/tipoProfilo>&#xa;            &lt;profiloTecnicoLinea>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:profTecnicoLinea)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:profTecnicoLinea&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/profiloTecnicoLinea>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT     distinct P.FLAG_VENDIBILITA, P.ID_OFFERTA, P.ID_PRFL_VC, P.MCR_DOWN, P.MCR_UP, P.PCR_DOWN, P.PCR_UP, P.PROFILO, P.SCR_DOWN,&#xd;&#xa; P.SCR_UP, P.TIPOLG_PROFILO, O.OFFERTA , PTL.PROTOCOLLO&#xd;&#xa;FROM PROFILO_VC P&#xd;&#xa;LEFT JOIN OFFERTA O ON O.ID_OFFERTA = P.ID_OFFERTA&#xd;&#xa;LEFT JOIN prfl_vc_prfl_tcnc_ln VCPTN ON VCPTN.id_prfl_vc= P.id_prfl_vc&#xd;&#xa;LEFT JOIN profilo_tcnc_linea PTL ON VCPTN.id_prfl_tcnc_ln=PTL.id_prfl_tcnc_ln and O.ID_OFFERTA = PTL.ID_OFFERTA  and VCPTN.id_prfl_vc= P.id_prfl_vc&#xd;&#xa;WHERE P.FLAG_VENDIBILITA = 'Y' AND P.ID_OFFERTA = ? AND P.TIPOLG_PROFILO = ? and  PTL.PROFILO_TCNC_LINEA  = ? &#xd;&#xa;  group by protocollo,P.FLAG_VENDIBILITA, P.ID_OFFERTA, P.ID_PRFL_VC, P.MCR_DOWN, P.MCR_UP, P.PCR_DOWN, P.PCR_UP, P.PROFILO, P.SCR_DOWN, P.SCR_UP, P.TIPOLG_PROFILO, O.OFFERTA, PTL.PROTOCOLLO&#xd;&#xa;ORDER BY P.PROFILO" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idOfferta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tipoProfilo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="profiloTecnicoLinea"/>
                                    <columnMetadata
                                    columnName="FLAG_VENDIBILITA"
                                    dataType="1"
                                    status="OptionalElement" typeName="CHAR"/>
                                    <columnMetadata
                                    columnName="ID_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_PRFL_VC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="MCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="MCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PROFILO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="SCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIPOLG_PROFILO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROTOCOLLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f65f7277-3524-44ff-9958-bb3e0897e41a+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaProfiloVC/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;ProfiloVCSimmetrico-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:caratteristica = 'FLAT' and $get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:idOfferta = ('9','10')&quot;>&lt;idOfferta>&lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&lt;/idOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:caratteristica = 'FLAT' and $get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:idOfferta = '40'&quot;>&lt;idOfferta>&lt;xsl:value-of select=&quot;&amp;quot;39&amp;quot;&quot;/>&lt;/idOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:caratteristica = 'HIGH LEVEL' and $get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:idOfferta = '39'&quot;>&lt;idOfferta>&lt;xsl:value-of select=&quot;&amp;quot;40&amp;quot;&quot;/>&lt;/idOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:caratteristica = 'HIGH LEVEL' and $get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:idOfferta = ('8','10')&quot;>&lt;idOfferta>&lt;xsl:value-of select=&quot;&amp;quot;9&amp;quot;&quot;/>&lt;/idOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:caratteristica = 'LITE' and $get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:idOfferta = ('8','9')&quot;>&lt;idOfferta>&lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&lt;/idOfferta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idOfferta>&lt;xsl:value-of select=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:idOfferta&quot;/>&lt;/idOfferta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipoProfilo>&lt;xsl:value-of select=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:tipoProfilo&quot;/>&lt;/tipoProfilo>&lt;profiloTecnicoLinea>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:profTecnicoLinea)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:visualizzaprofilovcGetParameters/tns1:profTecnicoLinea&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/profiloTecnicoLinea>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ProfiloVCSimmetrico-input"
                                    name="ProfiloVCSimmetrico"
                                    outputVariable="ProfiloVCSimmetrico"
                                    tibex:xpdlId="f65f7277-3524-44ff-9958-bb3e0897e41a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToProfiloVCSimmetrico_VariazCaratteristica"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ProfiloVCSimmetricoToEmpty1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f65f7277-3524-44ff-9958-bb3e0897e41a+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaProfiloVC/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ProfiloVCSimmetrico-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:caratteristica = 'FLAT' and $get.parameters/tns1:idOfferta = ('9','10')&quot;>&#xa;                    &lt;idOfferta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&#xa;                    &lt;/idOfferta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:caratteristica = 'FLAT' and $get.parameters/tns1:idOfferta = '40'&quot;>&#xa;                    &lt;idOfferta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;39&amp;quot;&quot;/>&#xa;                    &lt;/idOfferta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:caratteristica = 'HIGH LEVEL' and $get.parameters/tns1:idOfferta = '39'&quot;>&#xa;                    &lt;idOfferta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;40&amp;quot;&quot;/>&#xa;                    &lt;/idOfferta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:caratteristica = 'HIGH LEVEL' and $get.parameters/tns1:idOfferta = ('8','10')&quot;>&#xa;                    &lt;idOfferta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;9&amp;quot;&quot;/>&#xa;                    &lt;/idOfferta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:caratteristica = 'LITE' and $get.parameters/tns1:idOfferta = ('8','9')&quot;>&#xa;                    &lt;idOfferta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                    &lt;/idOfferta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;idOfferta>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:idOfferta&quot;/>&#xa;                    &lt;/idOfferta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tipoProfilo>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:tipoProfilo&quot;/>&#xa;            &lt;/tipoProfilo>&#xa;            &lt;profiloTecnicoLinea>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:profTecnicoLinea)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:profTecnicoLinea&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/profiloTecnicoLinea>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT     distinct P.FLAG_VENDIBILITA, P.ID_OFFERTA, P.ID_PRFL_VC, P.MCR_DOWN, P.MCR_UP, P.PCR_DOWN, P.PCR_UP, P.PROFILO, P.SCR_DOWN,&#xa; P.SCR_UP, P.TIPOLG_PROFILO, O.OFFERTA , PTL.PROTOCOLLO&#xa;FROM PROFILO_VC P&#xa;LEFT JOIN OFFERTA O ON O.ID_OFFERTA = P.ID_OFFERTA&#xa;LEFT JOIN prfl_vc_prfl_tcnc_ln VCPTN ON VCPTN.id_prfl_vc= P.id_prfl_vc&#xa;LEFT JOIN profilo_tcnc_linea PTL ON VCPTN.id_prfl_tcnc_ln=PTL.id_prfl_tcnc_ln and O.ID_OFFERTA = PTL.ID_OFFERTA  and VCPTN.id_prfl_vc= P.id_prfl_vc&#xa;WHERE P.FLAG_VENDIBILITA = 'Y' AND P.ID_OFFERTA = ? AND P.TIPOLG_PROFILO = ? and  PTL.PROFILO_TCNC_LINEA  = ? &#xa;  group by protocollo,P.FLAG_VENDIBILITA, P.ID_OFFERTA, P.ID_PRFL_VC, P.MCR_DOWN, P.MCR_UP, P.PCR_DOWN, P.PCR_UP, P.PROFILO, P.SCR_DOWN, P.SCR_UP, P.TIPOLG_PROFILO, O.OFFERTA, PTL.PROTOCOLLO&#xa;ORDER BY P.PROFILO" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idOfferta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tipoProfilo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="profiloTecnicoLinea"/>
                                    <columnMetadata
                                    columnName="FLAG_VENDIBILITA"
                                    dataType="1"
                                    status="OptionalElement" typeName="CHAR"/>
                                    <columnMetadata
                                    columnName="ID_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_PRFL_VC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="MCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="MCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="PROFILO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="SCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIPOLG_PROFILO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROTOCOLLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty" tibex:xpdlId="ea5c74a4-ba6a-4425-959c-1be53e50457e">
                                <bpws:targets>
                                    <bpws:target linkName="get_visualizzaprofilovc_InputLog_INFOToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToProfiloVCSimmetrico_VariazCaratteristica">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($get/parameters/tns:visualizzaprofilovcGetParameters/tns:caratteristica)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($get.parameters/tns:caratteristica)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToProfiloVCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="Empty1" tibex:xpdlId="a2bb59a1-8820-4ad0-9484-76583800f6fb">
                                <bpws:targets>
                                    <bpws:target linkName="ProfiloVCQueryToEmpty1"/>
                                    <bpws:target linkName="ProfiloVCSimmetricoToEmpty1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty1ToAssignProfiloNonTrovato">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty1ToAssignProfiloTrovato">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length(string($ProfiloVCQuery/Record[1]/ID_OFFERTA))>0 or string-length(string($ProfiloVCSimmetrico/Record[1]/ID_OFFERTA))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length(string($ProfiloVCQuery/Record[1]/ID_OFFERTA))>0 or string-length(string($ProfiloVCSimmetrico/Record[1]/ID_OFFERTA))>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
