;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico Virtual Dial UP'&quot;>&#xa;                                                                            &lt;ns1:ModalitaConsegna>&#xa;                                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                                            &lt;/ns1:ModalitaConsegna>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico Virtual Dial UP'&quot;>&#xa;                                                                            &lt;ns1:ModalitaConsegna>&#xa;                                                                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                                            &lt;/ns1:ModalitaConsegna>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico LAN 8 Virtual Dial UP'&quot;>&#xa;                                                                            &lt;ns1:ModalitaConsegna>&#xa;                                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                                            &lt;/ns1:ModalitaConsegna>&#xa;                                    