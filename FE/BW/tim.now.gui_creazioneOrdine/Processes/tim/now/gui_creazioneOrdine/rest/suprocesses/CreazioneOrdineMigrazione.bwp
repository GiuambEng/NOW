                        &lt;xsl:choose>&#xa;                                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                                &lt;ns1:CF>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                                &lt;/ns1:CF>&#xa;                                                                            &lt;/xsl:when>&#xa;                                                                            &lt;xsl:otherwise>&#xa;                                                                                &lt;ns1:PIVA>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                                &lt;/ns1:PIVA>&#xa;                                                                            &lt;/xsl:otherwise>&#xa;                                                                        &lt;/xsl:choose>&#xa;                                                                    &lt;/ns1:ClienteFinale>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                                        &lt;ns1:SlaProvisioning>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                        &lt;/ns1:SlaProvisioning>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                                        &lt;ns1:CodiceQualita>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                                        &lt;/ns1:CodiceQualita>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                                        &lt;ns1:CodiceDelivery>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                                        &lt;/ns1:CodiceDelivery>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                                        &lt;ns1:DAD>&#xa;                                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                                        &lt;/ns1:DAD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                                        &lt;ns1:FasciaOraria>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                                        &lt;/ns1:FasciaOraria>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;ns1:ProfiloTecnicoLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                                    &lt;/ns1:ProfiloTecnicoLinea>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico L2TP'&quot;>&#xa;                                                                            &lt;ns1:ModalitaConsegna>&#xa;                                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                                            &lt;/ns1:ModalitaConsegna>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:ModalitaConsegna>&#xa;                                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore)&quot;/>&#xa;                                                                            &lt;/ns1:ModalitaConsegna>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                                        &lt;ns1:Referente>&#xa;                                                                            &lt;ns1:Progressivo>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                                            &lt;/ns1:Progressivo>&#xa;                                                                            &lt;ns1:Qualifica>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                                            &lt;/ns1:Qualifica>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                            &lt;ns1:Cognome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                                            &lt;/ns1:Cognome>&#xa;                                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                                &lt;ns1:Telefono>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                                &lt;/ns1:Telefono>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                                &lt;ns1:Mobile>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                                &lt;/ns1:Mobile>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                                &lt;ns1:Email>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                                &lt;/ns1:Email>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                        &lt;/ns1:Referente>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns1:LineaNonFonia>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns1:Accesso>&#xa;                                                    &lt;ns1:VC>&#xa;                                                        &lt;ns1:VPI>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI']/tns:valore)&quot;/>&#xa;                                                        &lt;/ns1:VPI>&#xa;                                                        &lt;ns1:VCI>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI']/tns:valore)&quot;/>&#xa;                                                        &lt;/ns1:VCI>&#xa;                                                        &lt;ns1:ABR>&#xa;                                                            &lt;ns1:Consegna>&#xa;                                                                &lt;ns1:BandaDedicata>&#xa;                                                                    &lt;ns1:CodiceTD>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD']/tns:valore&quot;/>&#xa;                                                                    &lt;/ns1:CodiceTD>&#xa;                                                                &lt;/ns1:BandaDedicata>&#xa;                                                            &lt;/ns1:Consegna>&#xa;                                                        &lt;/ns1:ABR>&#xa;                                                    &lt;/ns1:VC>&#xa;                                                &lt;/ns1:EasyIPBasePlusFlat>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '12'&quot;>&#xa;                                                &lt;ns1:EasyIPBasePlusLite>&#xa;                                                    &lt;ns1:Accesso>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&#xa;                                                                &lt;ns1:LineaPOTS>&#xa;                                                                    &lt;ns1:DatiSede>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                                            &lt;ns1:ParticellaToponomastica>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                                            &lt;/ns1:ParticellaToponomastica>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                                            &lt;ns1:Via>&#xa;                                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                                            &lt;/ns1:Via>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                                            &lt;ns1:Civico>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                                            &lt;/ns1:Civico>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                                            &lt;ns1:Localita>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                                            &lt;/ns1:Localita>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                    &lt;/ns1:DatiSede>&#xa;                                                                    &lt;ns1:ClienteFinale>&#xa;                                                                        &lt;ns1:CognomeRagSoc>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                                        &lt;/ns1:CognomeRagSoc>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:choose>&#xa;                                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                                &lt;ns1:CF>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                                &lt;/ns1:CF>&#xa;                                                                            &lt;/xsl:when>&#xa;                                                                            &lt;xsl:otherwise>&#xa;                                                                                &lt;ns1:PIVA>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                                &lt;/ns1:PIVA>&#xa;                                                                            &lt;/xsl:otherwise>&#xa;                                                                        &lt;/xsl:choose>&#xa;                                                                    &lt;/ns1:ClienteFinale>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                                        &lt;ns1:SlaProvisioning>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                        &lt;/ns1:SlaProvisioning>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                                        &lt;ns1:CodiceQualita>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                                        &lt;/ns1:CodiceQualita>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                                        &lt;ns1:CodiceDelivery>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                                        &lt;/ns1:CodiceDelivery>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                                        &lt;ns1:DAD>&#xa;                                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                                        &lt;/ns1:DAD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                                        &lt;ns1:FasciaOraria>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                                        &lt;/ns1:FasciaOraria>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;ns1:NumeroLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                                    &lt;/ns1:NumeroLinea>&#xa;                                                                    &lt;ns1:ProfiloTecnicoLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                                    &lt;/ns1:ProfiloTecnicoLinea>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico L2TP'&quot;>&#xa;                                                                            &lt;ns1:ModalitaConsegna>&#xa;                                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                                            &lt;/ns1:ModalitaConsegna>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:ModalitaConsegna>&#xa;                                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore)&quot;/>&#xa;                                                                            &lt;/ns1:ModalitaConsegna>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICEPRODOTTOSPLITTER']/tns:valore = 'Y'&quot;>&#xa;                                                                            &lt;ns1:Splitter>&#xa;                                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                                            &lt;/ns1:Splitter>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Splitter>&#xa;                                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                                            &lt;/ns1:Splitter>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                                        &lt;ns1:Referente>&#xa;                                                                            &lt;ns1:Progressivo>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                                            &lt;/ns1:Progressivo>&#xa;                                                                            &lt;ns1:Qualifica>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                                            &lt;/ns1:Qualifica>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                            &lt;ns1:Cognome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                                            &lt;/ns1:Cognome>&#xa;                                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                                &lt;ns1:Telefono>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                                &lt;/ns1:Telefono>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                                &lt;ns1:Mobile>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                                &lt;/ns1:Mobile>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                                &lt;ns1:Email>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                                &lt;/ns1:Email>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                        &lt;/ns1:Referente>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns1:LineaPOTS>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'ISDN'&quot;>&#xa;                                                                &lt;ns1:LineaISDN>&#xa;                                                                    &lt;ns1:DatiSede>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                                            &lt;ns1:ParticellaToponomastica>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                                            &lt;/ns1:ParticellaToponomastica>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                                            &lt;ns1:Via>&#xa;                                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                                            &lt;/ns1:Via>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indiriz