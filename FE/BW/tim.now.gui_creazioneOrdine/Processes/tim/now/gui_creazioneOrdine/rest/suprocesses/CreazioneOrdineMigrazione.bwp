            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="a67337b5-60d2-4a46-8595-bed8a206d95f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenderXmlToEnd"/>
                        <bpws:target linkName="AssignNoOfferteToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;NoOfferte&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;CasedataMigrazione&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($RenderXml)&quot;>&#xa;                &lt;tns:OutputLavorazioni>&#xa;                    &lt;tns:outputLavorazioni>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($Start/tns:offertaCatalogo) =('ULL','ULLDATI','SLU','VULL','SHA','WLR')&quot;>&#xa;                                &lt;tns:contenutoXmlOlo>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloRegolatorio/Richiesta[1], false(), true())&quot;/>&#xa;                                &lt;/tns:contenutoXmlOlo>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo=('BitstreamATMAsimmetricoFlat','BitstreamATMSimmetricoFlat', 'BitstreamATMAsimmetricoHL', 'BitstreamATMSimmetricoHL','BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat', 'BitstreamGBESimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite')&quot;>&#xa;                                &lt;tns:contenutoXmlOlo>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloXDSL/ns1:Richiesta[1],false(),true())&quot;/>&#xa;                                &lt;/tns:contenutoXmlOlo>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:contenutoXmlOlo>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloNGA/ns0:Richiesta[1],false(),true())&quot;/>&#xa;                                &lt;/tns:contenutoXmlOlo>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns:xmlString>&#xa;                            &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;                        &lt;/tns:xmlString>&#xa;                        &lt;tns:codiceOloAgcom>&#xa;                            &lt;xsl:value-of select=&quot;$CasedataMigrazione/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns:codiceOloAgcom>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                            &lt;tns:codiceOrdineOlo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                            &lt;/tns:codiceOrdineOlo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:canaleRichiesta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns:canaleRichiesta>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($Start/tns:offertaCatalogo) =('ULL','ULLDATI','SLU','VULL','SHA','WLR')&quot;>&#xa;                                &lt;tns:strutturaRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                                &lt;/tns:strutturaRichiesta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo=('BitstreamATMAsimmetricoFlat','BitstreamATMSimmetricoFlat', 'BitstreamATMAsimmetricoHL', 'BitstreamATMSimmetricoHL','BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat', 'BitstreamGBESimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite')&quot;>&#xa;                                &lt;tns:strutturaRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                                &lt;/tns:strutturaRichiesta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:strutturaRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;                                &lt;/tns:strutturaRichiesta>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:outputLavorazioni>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputLavorazioni>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OutputLavorazioni>&#xa;                    &lt;tns:result>&#xa;                        &lt;xsl:if test=&quot;$NoOfferte/tns:result/tns:severity&quot;>&#xa;                            &lt;tns:severity>&#xa;                                &lt;xsl:value-of select=&quot;$NoOfferte/tns:result/tns:severity&quot;/>&#xa;                            &lt;/tns:severity>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NoOfferte/tns:result/tns:code&quot;>&#xa;                            &lt;tns:code>&#xa;                                &lt;xsl:value-of select=&quot;$NoOfferte/tns:result/tns:code&quot;/>&#xa;                            &lt;/tns:code>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NoOfferte/tns:result/tns:details&quot;>&#xa;                            &lt;tns:details>&#xa;                                &lt;xsl:value-of select=&quot;$NoOfferte/tns:result/tns:details&quot;/>&#xa;                            &lt;/tns:details>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputLavorazioni>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TracciatoOloRegolatorio"
                    name="TracciatoOloRegolatorio"
                    outputVariable="TracciatoOloRegolatorio"
                    tibex:xpdlId="046acaac-6208-462c-ad35-abef4e95dc2b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToTracciatoOloRegolatorio"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloRegolatorioToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoDestinazioneUsoFonia&quot;/>&lt;xsl:param name=&quot;RecuperoDestinazioneUsoDati&quot;/>&lt;xsl:param name=&quot;OscuramServOpz&quot;/>&lt;xsl:template name=&quot;TracciatoOloRegolatorio&quot; match=&quot;/&quot;>&lt;RichiestaOloRegolatorio>&lt;Richiesta>&lt;Testata>&lt;CodiceOlo>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/CodiceOlo>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/CodiceOrdineOlo>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/Note>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&lt;ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&lt;/ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;/Testata>&lt;Ordine>&lt;Migrazione>&lt;CodiceRisorsa1>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/CodiceRisorsa1>&lt;CodiceSessione1>&lt;xsl:value-of select=&quot;$Start/tns:codiceSessione1&quot;/>&lt;/CodiceSessione1>&lt;CodiceDonating1>&lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating1)&quot;/>&lt;/CodiceDonating1>&lt;xsl:if test=&quot;$Start/tns:idRisorsa2&quot;>&lt;CodiceRisorsa2>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa2&quot;/>&lt;/CodiceRisorsa2>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceSessione2&quot;>&lt;CodiceSessione2>&lt;xsl:value-of select=&quot;$Start/tns:codiceSessione2&quot;/>&lt;/CodiceSessione2>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:oaoDonating2)&quot;>&lt;CodiceDonating2>&lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating2)&quot;/>&lt;/CodiceDonating2>&lt;/xsl:if>&lt;Servizio>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'ULL'&quot;>&lt;Ull>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/DESCR = &amp;quot;FONIA&amp;quot; and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)=0&quot;>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;/DestinazioneUso>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)=0 and $RecuperoDestinazioneUsoDati/Record[1]/DESCR = &amp;quot;DATI&amp;quot;&quot;>&lt;DestinazioneUso>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&lt;/BitRate>&lt;/dati>&lt;/DestinazioneUso>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)>0 and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)>0&quot;>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&lt;/BitRate>&lt;/dati>&lt;/DestinazioneUso>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&lt;/BitRate>&lt;/dati>&lt;/DestinazioneUso>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IdUllCo>&lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&lt;/IdUllCo>&lt;PosizionePermutatore1>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEPERMUTATORE1']/tns:valore&quot;/>&lt;/PosizionePermutatore1>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEPERMUTATORE2']/tns:valore&quot;>&lt;PosizionePermutatore2>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEPERMUTATORE2']/tns:valore&quot;/>&lt;/PosizionePermutatore2>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:flagNp='Y'&quot;>&lt;NP>&lt;RoutingNumberRecipient>&lt;xsl:value-of select=&quot;$Start/tns:routingNumber&quot;/>&lt;/RoutingNumberRecipient>&lt;DN>&lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&lt;/DN>&lt;xsl:for-each select=&quot;$Start/tns:dnAggiuntive&quot;>&lt;DNaggiuntive>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/DNaggiuntive>&lt;/xsl:for-each>&lt;/NP>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:flagMonitoraggio ='Y'&quot;>&lt;FlagMonitoraggio>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/FlagMonitoraggio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FlagMonitoraggio>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FlagMonitoraggio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;(($OscuramServOpz/Record[1]/FLAG_OSCURMENTO !='1') or (count($OscuramServOpz/Record)=0)) and (string-length($Start/tns:datiDisaggregazione/tns:systemUnico)>0)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '1'&quot;>&lt;Disaggregazione>&lt;SystemUnico>&lt;xsl:value-of select=&quot;$Start/tns:datiDisaggregazione/tns:systemUnico&quot;/>&lt;/SystemUnico>&lt;/Disaggregazione>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/tns:idOfferta = '2') and ($Start/tns:flagNp = 'N')&quot;>&lt;Disaggregazione>&lt;SystemUnico>&lt;xsl:value-of select=&quot;$Start/tns:datiDisaggregazione/tns:systemUnico&quot;/>&lt;/SystemUnico>&lt;/Disaggregazione>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/tns:idOfferta = '1') and (count($Start/tns:datiServiziOpzionali/tns:codiceServizio)>0) and (($OscuramServOpz/Record[1]/FLAG_OSCURMENTO !='1') or (count($OscuramServOpz/Record)=0))&quot;>&lt;xsl:for-each select=&quot;$Start/tns:datiServiziOpzionali&quot;>&lt;ServiziOpzionali>&lt;CodiceServizio>&lt;xsl:value-of select=&quot;tns:codiceServizio&quot;/>&lt;/CodiceServizio>&lt;xsl:if test=&quot;tns:descrizioneServizio&quot;>&lt;DescrizioneServizio>&lt;xsl:value-of select=&quot;tns:descrizioneServizio&quot;/>&lt;/DescrizioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:datiTecnici&quot;>&lt;DatiTecnici>&lt;xsl:value-of select=&quot;tns:datiTecnici&quot;/>&lt;/DatiTecnici>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;tns:vincolantePerEspletamento = 'Y'&quot;>&lt;VincolantePerEspletamento>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/VincolantePerEspletamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;VincolantePerEspletamento>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/VincolantePerEspletamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ServiziOpzionali>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/Ull>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'VULL'&quot;>&lt;Vull>&lt;CodiceServizio>&lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&lt;/CodiceServizio>&lt;xsl:if test=&quot;$Start/tns:dn&quot;>&lt;DN>&lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&lt;/DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:numeroRichiestaColocazione&quot;>&lt;NumRichColocaz>&lt;xsl:value-of select=&quot;$Start/tns:numeroRichiestaColocazione&quot;/>&lt;/NumRichColocaz>&lt;/xsl:if>&lt;/Vull>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'WLR'&quot;>&lt;WLR>&lt;CodiceServizio>&lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&lt;/CodiceServizio>&lt;xsl:if test=&quot;$Start/tns:flagNp='Y'&quot;>&lt;NP>&lt;DN>&lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&lt;/DN>&lt;xsl:for-each select=&quot;$Start/tns:dnAggiuntive&quot;>&lt;DNaggiuntive>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/DNaggiuntive>&lt;/xsl:for-each>&lt;/NP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:clirPermanente&quot;>&lt;ClirPermanente>&lt;xsl:value-of select=&quot;$Start/tns:clirPermanente&quot;/>&lt;/ClirPermanente>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:flagMantenimentoSTS = 'Y'&quot;>&lt;FlagMantenimentoSTS>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/FlagMantenimentoSTS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FlagMantenimentoSTS>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/FlagMantenimentoSTS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/WLR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;SLU>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/DESCR = &amp;quot;FONIA&amp;quot; and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)=0&quot;>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;/DestinazioneUso>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)=0 and $RecuperoDestinazioneUsoDati/Record[1]/DESCR = &amp;quot;DATI&amp;quot;&quot;>&lt;DestinazioneUso>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&lt;/BitRate>&lt;/dati>&lt;/DestinazioneUso>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)>0 and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)>0&quot;>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&lt;/BitRate>&lt;/dati>&lt;/DestinazioneUso>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&lt;/BitRate>&lt;/dati>&lt;/DestinazioneUso>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IdentificativoSLU>&lt;IdSLUCo>&lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&lt;/IdSLUCo>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEARLOLO1']/tns:valore&quot;>&lt;PosizioneARLOLO1>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEARLOLO1']/tns:valore&quot;/>&lt;/PosizioneARLOLO1>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEARLOLO2']/tns:valore&quot;>&lt;PosizioneARLOLO2>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEARLOLO2']/tns:valore&quot;/>&lt;/PosizioneARLOLO2>&lt;/xsl:if>&lt;PosizioneARLTI1>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEARLTI1']/tns:valore&quot;/>&lt;/PosizioneARLTI1>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEARLTI2']/tns:valore&quot;>&lt;PosizioneARLTI2>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'POSIZIONEARLTI2']/tns:valore&quot;/>&lt;/PosizioneARLTI2>&lt;/xsl:if>&lt;/IdentificativoSLU>&lt;xsl:if test=&quot;$Start/tns:flagNp='Y'&quot;>&lt;NP>&lt;RoutingNumberRecipient>&lt;xsl:value-of select=&quot;$Start/tns:routingNumber&quot;/>&lt;/RoutingNumberRecipient>&lt;DN>&lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&lt;/DN>&lt;xsl:for-each select=&quot;$Start/tns:dnAggiuntive&quot;>&lt;DNaggiuntive>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/DNaggiuntive>&lt;/xsl:for-each>&lt;/NP>&lt;/xsl:if>&lt;xsl:if test=&quot;(string-length($Start/tns:datiDisaggregazione/tns:systemUnico)>0) and (($OscuramServOpz/Record[1]/FLAG_OSCURMENTO !='1') or (count($OscuramServOpz/Record)=0))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '5'&quot;>&lt;Disaggregazione>&lt;SystemUnico>&lt;xsl:value-of select=&quot;$Start/tns:datiDisaggregazione/tns:systemUnico&quot;/>&lt;/SystemUnico>&lt;/Disaggregazione>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/tns:idOfferta = '6') and ($Start/tns:flagNp = 'N')&quot;>&lt;Disaggregazione>&lt;SystemUnico>&lt;xsl:value-of select=&quot;$Start/tns:datiDisaggregazione/tns:systemUnico&quot;/>&lt;/SystemUnico>&lt;/Disaggregazione>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/tns:idOfferta = '5') and (count($Start/tns:datiServiziOpzionali/tns:codiceServizio)>0) and (($OscuramServOpz/Record[1]/FLAG_OSCURMENTO !='1') or (count($OscuramServOpz/Record)=0))&quot;>&lt;xsl:for-each select=&quot;$Start/tns:datiServiziOpzionali&quot;>&lt;ServiziOpzionali>&lt;CodiceServizio>&lt;xsl:value-of select=&quot;tns:codiceServizio&quot;/>&lt;/CodiceServizio>&lt;xsl:if test=&quot;tns:descrizioneServizio&quot;>&lt;DescrizioneServizio>&lt;xsl:value-of select=&quot;tns:descrizioneServizio&quot;/>&lt;/DescrizioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:datiTecnici&quot;>&lt;DatiTecnici>&lt;xsl:value-of select=&quot;tns:datiTecnici&quot;/>&lt;/DatiTecnici>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;tns:vincolantePerEspletamento = &amp;quot;Y&amp;quot;&quot;>&lt;VincolantePerEspletamento>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/VincolantePerEspletamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;VincolantePerEspletamento>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/VincolantePerEspletamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ServiziOpzionali>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/SLU>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Servizio>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:dac)&quot;>&lt;DataDAC>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dac), 9, 2),'/',substring(xsd:string($Start/tns:dac), 6, 2),'/',substring(xsd:string($Start/tns:dac), 1, 4))&quot;/>&lt;/DataDAC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DataDAC>&lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&lt;/DataDAC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&lt;Referente>&lt;Progressivo>&lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&lt;/Progressivo>&lt;QualificaRef>&lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&lt;/QualificaRef>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cellulare&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:email&quot;>&lt;EmailReferente>&lt;xsl:value-of select=&quot;tns:email&quot;/>&lt;/EmailReferente>&lt;/xsl:if>&lt;/Referente>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&lt;CodiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&lt;/CodiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&lt;CodiceQualita>&lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&lt;/CodiceQualita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;FasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/FasciaOraria>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&lt;DataAppuntamentoDesiderata>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&lt;/DataAppuntamentoDesiderata>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&lt;DNOLOCollaudo>&lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&lt;/DNOLOCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&lt;NumeroVerdeOloCollaudo>&lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&lt;/NumeroVerdeOloCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&lt;NumeroVerdeOloPT>&lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&lt;/NumeroVerdeOloPT>&lt;/xsl:if>&lt;/Migrazione>&lt;/Ordine>&lt;/Richiesta>&lt;/RichiestaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TracciatoOloRegolatorio" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperoDestinazioneUsoFonia-input"
                    name="RecuperoDestinazioneUsoFonia"
                    outputVariable="RecuperoDestinazioneUsoFonia"
                    tibex:xpdlId="322dcbf0-6133-41a9-859e-609dbe5be58d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToRecuperoDestinazioneUsoFonia"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperoDestinazioneUsoToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+322dcbf0-6133-41a9-859e-609dbe5be58d+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoDestinazioneUsoFonia-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;destinazioneUsoFonia>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DESTINAZIONEUSOFONIA']/tns:valore)&quot;/>&#xa;            &lt;/destinazioneUsoFonia>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TL.COD, TL.TIPOLG_LINEA, TA.DESCR&#xa;FROM TIPOLG_LINEA TL&#xa;JOIN TIPOLG_ACCS TA ON TA.IDTPLG_ACCS = TL.IDTPLG_ACCS&#xa;WHERE TL.TIPOLG_LINEA = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="destinazioneUsoFonia"/>
                                    <columnMetadata columnName="COD"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLG_LINEA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&lt;xsl:param name=&quot;CalcoloData&quot;/>&lt;xsl:param name=&quot;RecuperoDestinazioneUsoFonia&quot;/>&lt;xsl:param name=&quot;RecuperoDestinazioneUsoDati&quot;/>&lt;xsl:param name=&quot;DeterminaSottoLavorazioneRegolatorio&quot;/>&lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&lt;xsl:param name=&quot;TracciatoOloRegolatorio&quot;/>&lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&lt;xsl:param name=&quot;calcoloDRO&quot;/>&lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&lt;xsl:param name=&quot;OscuramServOpz&quot;/>&lt;xsl:param name=&quot;FlagFittizioCodProg&quot;/>&lt;xsl:template name=&quot;CasedataMigrazione&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/note>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'ULL'&quot;>&lt;ordine>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;ULL&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;xsl:if test=&quot;$Start/tns:dac&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento != &amp;quot;OP&amp;quot;) or (($OscuramServOpz/Record[1]/FLAG_OSCURMENTO = '1') and ($Start/tns:datiAppuntamentoDisaggregazione/tns:ownerPresaAppuntamento = &amp;quot;OP&amp;quot;))&quot;>&lt;xsl:if test=&quot;$Start/tns:dad&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&lt;/DAD>&lt;/xsl:if>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&lt;/cognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&lt;/CF>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&lt;IDSLUCo>&lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&lt;/IDSLUCo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&lt;IDULLCo>&lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&lt;/IDULLCo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&lt;codiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&lt;/codiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&lt;DNOLOCollaudo>&lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&lt;/DNOLOCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&lt;numeroVerdeOloCollaudo>&lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&lt;/numeroVerdeOloCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&lt;numeroVerdeOloPT>&lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&lt;/numeroVerdeOloPT>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:flagMonitoraggio = 'N'&quot;>&lt;flagMonitoraggio>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/flagMonitoraggio>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:flagMonitoraggio = 'S'&quot;>&lt;flagMonitoraggio>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/flagMonitoraggio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;flagMonitoraggio>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/flagMonitoraggio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;xsl:if test=&quot;$DeterminaSottoLavorazioneRegolatorio/tns2:sottolavorazione&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneRegolatorio/tns2:sottolavorazione&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '1'&quot;>&lt;LNA_LA>&lt;xsl:value-of select=&quot;&amp;quot;LNA&amp;quot;&quot;/>&lt;/LNA_LA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;LNA_LA>&lt;xsl:value-of select=&quot;&amp;quot;LA&amp;quot;&quot;/>&lt;/LNA_LA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;/xsl:if>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;xsl:if test=&quot;count($Start/tns:attributiOfferta/tns:sezioneSuperiore)>0&quot;>&lt;dettaglioordine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;nomeComponente>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[1]/tns:componente&quot;/>&lt;/nomeComponente>&lt;integrationID>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/integrationID>&lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key!='DESTINAZIONEUSOFONIA' and tns:key!='DESTINAZIONEUSODATI']&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;tns:key&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;tns:valore&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DESTINAZIONEUSOFONIA']/tns:valore = ('POTS','ISDN BRA','ISDN PRA') or $Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DESTINAZIONEUSODATI']/tns:valore = ('ADSL','SDSL','VDSL','HDSL')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)>0 and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)=0&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONEUSO&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)=0 and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)>0&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONEUSO&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)>0 and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)>0 and $Start/tns:oao = 'TLC'&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONEUSO&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;concat($RecuperoDestinazioneUsoFonia/Record[1]/COD, '|', $RecuperoDestinazioneUsoDati/Record[1]/COD)&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&q