                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&lt;xsl:param name=&quot;Variabile&quot;/>&lt;xsl:param name=&quot;UserVlanID&quot;/>&lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&lt;xsl:param name=&quot;OscuramentoIntermediateAgent&quot;/>&lt;xsl:template name=&quot;TracciatoOloNGA&quot; match=&quot;/&quot;>&lt;ns0:TracciatoOLONGA>&lt;ns0:Richiesta>&lt;ns0:Testata>&lt;ns0:CodiceOlo>&lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&lt;/ns0:CodiceOlo>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;ns0:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/ns0:CodiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;ns0:CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/ns0:CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;ns0:CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/ns0:CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;ns0:Note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/ns0:Note>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIVULAFTTH'&quot;>&lt;ns0:semiVULA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:semiVULA>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIBitstreamNGAFTTH'&quot;>&lt;ns0:semiBitstreamNGA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:semiBitstreamNGA>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'SEMIEasyIPUBBFTTH'&quot;>&lt;ns0:semiEasyIPNGA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:semiEasyIPNGA>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:idReteSecondariaOao&quot;>&lt;ns0:IdReteSecondariaOAO>&lt;xsl:value-of select=&quot;$Start/tns:idReteSecondariaOao&quot;/>&lt;/ns0:IdReteSecondariaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&lt;ns0:ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&lt;/ns0:ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:clusterAccesso&quot;>&lt;ns0:ClusterAccesso>&lt;xsl:value-of select=&quot;$Start/tns:clusterAccesso&quot;/>&lt;/ns0:ClusterAccesso>&lt;/xsl:if>&lt;/ns0:Testata>&lt;ns0:TipoRichiesta>&lt;ns0:Migrazione>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:tipoMigrazione= 'MigrazioneOLO'&quot;>&lt;ns0:MigrazioneOLO>&lt;ns0:Servizio>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamNGAFTTCAB'&quot;>&lt;ns0:BitstreamNGAFTTCAB>&lt;ns0:Accesso>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&lt;ns0:LineaPOTS>&lt;ns0:DatiSede>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&lt;ns0:ParticellaToponomastica>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&lt;/ns0:ParticellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&lt;ns0:Codice_Via>&lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&lt;/ns0:Codice_Via>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&lt;ns0:Civico>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&lt;/ns0:Civico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&lt;ns0:Localita>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&lt;/ns0:Localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;>&lt;ns0:Provincia>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;/>&lt;/ns0:Provincia>&lt;/xsl:if>&lt;/ns0:DatiSede>&lt;ns0:ClienteFinale>&lt;ns0:CognomeRagSoc>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&lt;/ns0:CognomeRagSoc>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&lt;ns0:Nome>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&lt;/ns0:Nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&lt;ns0:CF>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&lt;/ns0:CF>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:PIVA>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&lt;/ns0:PIVA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:ClienteFinale>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&lt;ns0:SlaProvisioning>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:SlaProvisioning>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&lt;ns0:CodiceQualita>&lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&lt;/ns0:CodiceQualita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&lt;ns0:CodiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&lt;/ns0:CodiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&lt;ns0:DAD>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&lt;/ns0:DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;ns0:FasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/ns0:FasciaOraria>&lt;/xsl:if>&lt;ns0:NumeroLinea>&lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&lt;/ns0:NumeroLinea>&lt;ns0:ProfiloTecnicoLinea>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&lt;/ns0:ProfiloTecnicoLinea>&lt;ns0:Tecnologia>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TECNOLOGIA']/tns:valore&quot;/>&lt;/ns0:Tecnologia>&lt;ns0:UserVLAN_1_TAGGING>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'USERVLAN1TAGGING']/tns:valore&quot;/>&lt;/ns0:UserVLAN_1_TAGGING>&lt;ns0:Encapsulation>&lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'ENCAPSULATION']/tns:valore)&quot;/>&lt;/ns0:Encapsulation>&lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&lt;ns0:Referente>&lt;ns0:Progressivo>&lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&lt;/ns0:Progressivo>&lt;ns0:Qualifica>&lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&lt;/ns0:Qualifica>&lt;ns0:Nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/ns0:Nome>&lt;ns0:Cognome>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/ns0:Cognome>&lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&lt;ns0:Telefono>&lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&lt;/ns0:Telefono>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cellulare&quot;>&lt;ns0:Mobile>&lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&lt;/ns0:Mobile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:email&quot;>&lt;ns0:Email>&lt;xsl:value-of select=&quot;tns:email&quot;/>&lt;/ns0:Email>&lt;/xsl:if>&lt;/ns0:Referente>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:qualifica = 'Y'&quot;>&lt;ns0:Qualifica>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:Qualifica>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:qualifica = 'N'&quot;>&lt;ns0:Qualifica>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/ns0:Qualifica>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:test2 = &amp;quot;Y&amp;quot;&quot;>&lt;ns0:Test2>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:Test2>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:test2 = &amp;quot;N&amp;quot;&quot;>&lt;ns0:Test2>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/ns0:Test2>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(not(exists($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO)) or ($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO !='1')) and (upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'INTERMEDIATEAGENTFULL']/tns:valore)='Y')&quot;>&lt;ns0:INTERMEDIATE_AGENT_FULL>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/ns0:INTERMEDIATE_AGENT_FULL>&lt;/xsl:when>&lt;xsl:when test=&quot;(not(exists($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO)) or ($OscuramentoIntermediateAgent/Record[1]/FLAG_OSCURMENTO !='1')) and (upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'INTERMEDIATEAGENTFULL']/tns:valore)='N')&quot;>&lt;ns0:INTERMEDIATE_AGENT_FULL>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/ns0:INTERMEDIATE_AGENT_FULL>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns:datiReferentiOnField/tns:cognomeOnField)>0&quot;>&lt;ns0:ReferenteOLOperProblematicheOn-field>&lt;ns0:CognomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&lt;/ns0:CognomeReferente>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&lt;ns0:NomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&lt;/ns0:NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&lt;ns0:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&lt;/ns0:TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&lt;ns0:TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&lt;/ns0:TelefonoMobileReferente>&lt;/xsl:if>&lt;/ns0:ReferenteOLOperProblematicheOn-field>&lt;/xsl:if>&lt;/ns0:LineaPOTS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:LineaNonFonia>&lt;ns0:DatiSede>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&lt;ns0:ParticellaToponomastica>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&lt;/ns0:ParticellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&lt;ns0:Codice_Via>&lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&lt;/ns0:Codice_Via>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&lt;ns0:Civico>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&lt;/ns0:Civico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&lt;ns0:Localita>&lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&lt;/ns0:Localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&lt;ns0:CodiceComune>&lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&lt;/ns0:CodiceComune>&lt;/xsl:if>&lt;/ns0:DatiSede>&lt;ns0:ClienteFinale>&lt;ns0:CognomeRagSoc>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&lt;/ns0:CognomeRagSoc>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&lt;ns0:Nome>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&lt;/ns0:Nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&lt;ns0:CF>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&lt;/ns0:CF>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:PIVA>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&lt;/ns0:PIVA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:ClienteFinale>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&lt;ns0:SlaProvisioning>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&l