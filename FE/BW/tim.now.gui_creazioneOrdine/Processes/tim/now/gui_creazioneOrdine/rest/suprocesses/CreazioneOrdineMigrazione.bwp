                                                             &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                                        &lt;ns1:Referente>&#xa;                                                                            &lt;ns1:Progressivo>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                                            &lt;/ns1:Progressivo>&#xa;                                                                            &lt;ns1:Qualifica>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                                            &lt;/ns1:Qualifica>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                            &lt;ns1:Cognome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                                            &lt;/ns1:Cognome>&#xa;                                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                                &lt;ns1:Telefono>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                                &lt;/ns1:Telefono>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                                &lt;ns1:Mobile>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                                &lt;/ns1:Mobile>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                                &lt;ns1:Email>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                                &lt;/ns1:Email>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                        &lt;/ns1:Referente>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns1:LineaNonFonia>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns1:Accesso>&#xa;                                                    &lt;ns1:VC>&#xa;                                                        &lt;ns1:VPI>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI']/tns:valore)&quot;/>&#xa;                                                        &lt;/ns1:VPI>&#xa;                                                        &lt;ns1:VCI>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI']/tns:valore)&quot;/>&#xa;                                                        &lt;/ns1:VCI>&#xa;                                                    &lt;/ns1:VC>&#xa;                                                &lt;/ns1:EasyIPSpecialProfileLite>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns1:Servizio>&#xa;                                    &lt;ns1:DatiMigrazione>&#xa;                                        &lt;ns1:CodiceRisorsa1>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                        &lt;/ns1:CodiceRisorsa1>&#xa;                                        &lt;ns1:CodiceSessione1>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceSessione1&quot;/>&#xa;                                        &lt;/ns1:CodiceSessione1>&#xa;                                        &lt;ns1:CodiceOLO1>&#xa;                                            &lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating1)&quot;/>&#xa;                                        &lt;/ns1:CodiceOLO1>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa2&quot;>&#xa;                                            &lt;ns1:CodiceRisorsa2>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa2&quot;/>&#xa;                                            &lt;/ns1:CodiceRisorsa2>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:codiceSessione2&quot;>&#xa;                                            &lt;ns1:CodiceSessione2>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:codiceSessione2&quot;/>&#xa;                                            &lt;/ns1:CodiceSessione2>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;exists($Start/tns:oaoDonating2)&quot;>&#xa;                                            &lt;ns1:CodiceOLO2>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating2)&quot;/>&#xa;                                            &lt;/ns1:CodiceOLO2>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($Start/tns:dac)&quot;>&#xa;                                                &lt;ns1:DAC>&#xa;                                                    &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dac), 9, 2),'/',substring(xsd:string($Start/tns:dac), 6, 2),'/',substring(xsd:string($Start/tns:dac), 1, 4))&quot;/>&#xa;                                                &lt;/ns1:DAC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns1:DAC>&#xa;                                                    &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                                                &lt;/ns1:DAC>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;exists($Start/tns:flagNumerazioniAggiuntive)&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:flagNumerazioniAggiuntive&quot;>&#xa;                                                &lt;ns1:FlagNumerazioniAggiuntive>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:flagNumerazioniAggiuntive&quot;/>&#xa;                                                &lt;/ns1:FlagNumerazioniAggiuntive>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:flagNp='Y'&quot;>&#xa;                                            &lt;ns1:NP>&#xa;                                                &lt;ns1:RoutingNumberRecipient>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:routingNumber&quot;/>&#xa;                                                &lt;/ns1:RoutingNumberRecipient>&#xa;                                                &lt;ns1:DN>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&#xa;                                                &lt;/ns1:DN>&#xa;                                                &lt;xsl:for-each select=&quot;$Start/tns:dnAggiuntive&quot;>&#xa;                                                    &lt;ns1:DN>&#xa;                                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                    &lt;/ns1:DN>&#xa;                                                &lt;/xsl:for-each>&#xa;                                            &lt;/ns1:NP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns1:DatiMigrazione>&#xa;                                &lt;/ns1:MigrazioneOLO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns1:Attivazione274>&#xa;                                    &lt;ns1:Servizio>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '8'&quot;>&#xa;                                                &lt;ns1:BitstreamATMAsimmetricoFlat>&#xa;                                                    &lt;ns1:Accesso>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&#xa;                                                                &lt;ns1:LineaPOTS>&#xa;                                                                    &lt;ns1:DatiSede>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                                            &lt;ns1:ParticellaToponomastica>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                                            &lt;/ns1:ParticellaToponomastica>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                                            &lt;ns1:Via>&#xa;                                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                                            &lt;/ns1:Via>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                                            &lt;ns1:Civico>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                                            &lt;/ns1:Civico>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                                            &lt;ns1:Localita>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                                            &lt;/ns1:Localita>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                    &lt;/ns1:DatiSede>&#xa;                                                                    &lt;ns1:ClienteFinale>&#xa;                                                                        &lt;ns1:CognomeRagSoc>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                                        &lt;/ns1:CognomeRagSoc>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:choose>&#xa;                                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                                &lt;ns1:CF>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                                &lt;/ns1:CF>&#xa;                                                                            &lt;/xsl:when>&#xa;                                                                            &lt;xsl:otherwise>&#xa;                                                                                &lt;ns1:PIVA>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                                &lt;/ns1:PIVA>&#xa;                                                                            &lt;/xsl:otherwise>&#xa;                                                                        &lt;/xsl:choose>&#xa;                                                                    &lt;/ns1:ClienteFinale>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                        &lt;ns1:Modem>&#xa;                                                                            &lt;ns1:Interfaccia>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Interfaccia>&#xa;                                                                            &lt;xsl:choose>&#xa;                                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:when>&#xa;                                                                                &lt;xsl:otherwise>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:otherwise>&#xa;                                                                            &lt;/xsl:choose>&#xa;                                                                        &lt;/ns1:Modem>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                                        &lt;ns1:SlaProvisioning>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                        &lt;/ns1:SlaProvisioning>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                                        &lt;ns1:CodiceQualita>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                                        &lt;/ns1:CodiceQualita>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                                        &lt;ns1:CodiceDelivery>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                                        &lt;/ns1:CodiceDelivery>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                                        &lt;ns1:DAD>&#xa;                                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                                        &lt;/ns1:DAD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                                        &lt;ns1:FasciaOraria>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                                        &lt;/ns1:FasciaOraria>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;ns1:NumeroLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                                    &lt;/ns1:NumeroLinea>&#xa;                                                                    &lt;ns1:ProfiloTecnicoLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                                    &lt;/ns1:ProfiloTecnicoLinea>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICEPRODOTTOSPLITTER']/tns:valore = 'Y'&quot;>&#xa;                                                                            &lt;ns1:Splitter>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Splitter>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Splitter>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Splitter>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                                        &lt;ns1:Referente>&#xa;                                                                            &lt;ns1:Progressivo>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                                            &lt;/ns1:Progressivo>&#xa;                                                                            &lt;ns1:Qualifica>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                                            &lt;/ns1:Qualifica>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                            &lt;ns1:Cognome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                                            &lt;/ns1:Cognome>&#xa;                                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                                &lt;ns1:Telefono>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                                &lt;/ns1:Telefono>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                                &lt;ns1:Mobile>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                                &lt;/ns1:Mobile>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                                &lt;ns1:Email>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                                &lt;/ns1:Email>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                        &lt;/ns1:Referente>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns1:LineaPOTS>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'ISDN'&quot;>&#xa;                                                                &lt;ns1:LineaISDN>&#xa;                                                                    &lt;ns1:DatiSede>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                                            &lt;ns1:ParticellaToponomastica>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                                            &lt;/ns1:ParticellaToponomastica>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                                            &lt;ns1:Via>&#xa;                                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                                            &lt;/ns1:Via>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                                            &lt;ns1:Civico>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                                            &lt;/ns1:Civico>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                                            &lt;ns1:Localita>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                                            &lt;/ns1:Localita>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                    &lt;/ns1:DatiSede>&#xa;                                                                    &lt;ns1:ClienteFinale>&#xa;                                                                        &lt;ns1:CognomeRagSoc>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                                        &lt;/ns1:CognomeRagSoc>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:choose>&#xa;                                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                                &lt;ns1:CF>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                                &lt;/ns1:CF>&#xa;                                                                            &lt;/xsl:when>&#xa;                                                                            &lt;xsl:otherwise>&#xa;                                                                                &lt;ns1:PIVA>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                                &lt;/ns1:PIVA>&#xa;                                                                            &lt;/xsl:otherwise>&#xa;                                                                        &lt;/xsl:choose>&#xa;                                                                    &lt;/ns1:ClienteFinale>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                        &lt;ns1:Modem>&#xa;                                                                            &lt;ns1:Interfaccia>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Interfaccia>&#xa;                                                                            &lt;xsl:choose>&#xa;                                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:when>&#xa;                                                                                &lt;xsl:otherwise>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:otherwise>&#xa;                                                                            &lt;/xsl:choose>&#xa;                                                                        &lt;/ns1:Modem>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                                        &lt;ns1:SlaProvisioning>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                        &lt;/ns1:SlaProvisioning>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                                        &lt;ns1:CodiceQualita>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                                        &lt;/ns1:CodiceQualita>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                                        &lt;ns1:CodiceDelivery>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                                        &lt;/ns1:CodiceDelivery>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                                        &lt;ns1:DAD>&#xa;                                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                                        &lt;/ns1:DAD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                                        &lt;ns1:FasciaOraria>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                                        &lt;/ns1:FasciaOraria>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;ns1:NumeroLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                                    &lt;/ns1:NumeroLinea>&#xa;                                                                    &lt;ns1:ProfiloTecnicoLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                                    &lt;/ns1:ProfiloTecnicoLinea>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                                        &lt;ns1:Referente>&#xa;                                                                            &lt;ns1:Progressivo>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                                            &lt;/ns1:Progressivo>&#xa;                                                                            &lt;ns1:Qualifica>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                                            &lt;/ns1:Qualifica>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                            &lt;ns1:Cognome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                                            &lt;/ns1:Cognome>&#xa;                                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                                &lt;ns1:Telefono>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                                &lt;/ns1:Telefono>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                                &lt;ns1:Mobile>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                                &lt;/ns1:Mobile>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                                &lt;ns1:Email>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                                &lt;/ns1:Email>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                        &lt;/ns1:Referente>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns1:LineaISDN>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns1:LineaNonFonia>&#xa;                                                                    &lt;ns1:DatiSede>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                                            &lt;ns1:ParticellaToponomastica>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                                            &lt;/ns1:ParticellaToponomastica>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                                            &lt;ns1:Via>&#xa;                                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                                            &lt;/ns1:Via>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                                            &lt;ns1:Civico>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                                            &lt;/ns1:Civico>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                                            &lt;ns1:Localita>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                                            &lt;/ns1:Localita>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                    &lt;/ns1:DatiSede>&#xa;                                                                    &lt;ns1:ClienteFinale>&#xa;                                                                        &lt;ns1:CognomeRagSoc>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                                        &lt;/ns1:CognomeRagSoc>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:choose>&#xa;                                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                                &lt;ns1:CF>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                                &lt;/ns1:CF>&#xa;                                                                            &lt;/xsl:when>&#xa;                                                                            &lt;xsl:otherwise>&#xa;                                                                                &lt;ns1:PIVA>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                                &lt;/ns1:PIVA>&#xa;                                                                            &lt;/xsl:otherwise>&#xa;                                                                        &lt;/xsl:choose>&#xa;                                                                    &lt;/ns1:ClienteFinale>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                        &lt;ns1:Modem>&#xa;                                                                            &lt;ns1:Interfaccia>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Interfaccia>&#xa;                                                                            &lt;xsl:choose>&#xa;                                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:when>&#xa;                                                                                &lt;xsl:otherwise>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:otherwise>&#xa;                                                                            &lt;/xsl:choose>&#xa;                                                                        &lt;/ns1:Modem>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                                        &lt;ns1:SlaProvisioning>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                        &lt;/ns1:SlaProvisioning>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                                        &lt;ns1:CodiceQualita>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                                        &lt;/ns1:CodiceQualita>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                                        &lt;ns1:CodiceDelivery>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                                        &lt;/ns1:CodiceDelivery>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                                        &lt;ns1:DAD>&#xa;                                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                                        &lt;/ns1:DAD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                                        &lt;ns1:FasciaOraria>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                                        &lt;/ns1:FasciaOraria>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;ns1:ProfiloTecnicoLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                                    &lt;/ns1:ProfiloTecnicoLinea>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                                        &lt;ns1:Referente>&#xa;                                                                            &lt;ns1:Progressivo>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                                            &lt;/ns1:Progressivo>&#xa;                                                                            &lt;ns1:Qualifica>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                                            &lt;/ns1:Qualifica>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                            &lt;ns1:Cognome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                                            &lt;/ns1:Cognome>&#xa;                                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                                &lt;ns1:Telefono>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                                &lt;/ns1:Telefono>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                                &lt;ns1:Mobile>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                                &lt;/ns1:Mobile>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                                &lt;ns1:Email>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                                &lt;/ns1:Email>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                        &lt;/ns1:Referente>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns1:LineaNonFonia>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns1:Accesso>&#xa;                                                    &lt;xsl:for-each select=&quot;$Variabile/tns3:root&quot;>&#xa;                                                        &lt;xsl:variable name=&quot;conditionCompPos&quot; select=&quot;&amp;quot;tns:componente=$currComponent and tns:progressivo=$currProgressivo&amp;quot;&quot;/>&#xa;                                                        &lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;current()/tns3:progressivo&quot;/>&#xa;                                                        &lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns3:componente&quot;/>&#xa;                                                        &lt;ns1:VC>&#xa;                                                            &lt;ns1:VPI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns1:VPI>&#xa;                                                            &lt;ns1:VCI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns1:VCI>&#xa;                                                            &lt;ns1:ProfiloVC>&#xa;                                                                &lt;xsl:choose>&#xa;                                                                    &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = 'ABR'&quot;>&#xa;                                                                        &lt;ns1:ABR>&#xa;                                                                            &lt;ns1:MCRDown>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='MCRDOWN' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:MCRDown>&#xa;                                                                            &lt;ns1:MCRUp>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='MCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:MCRUp>&#xa;                                                                            &lt;ns1:PCRDown>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRDOWN' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:PCRDown>&#xa;                                                                            &lt;ns1:PCRUp>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:PCRUp>&#xa;                                                                            &lt;ns1:Consegna>&#xa;                                                                                &lt;xsl:choose>&#xa;                                                                                    &lt;xsl:when test=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOBANDACONSEGNA' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore) = 'DEDICATA'&quot;>&#xa;                                                                                        &lt;ns1:BandaDedicata>&#xa;                                                                                            &lt;ns1:CodiceTD>&#xa;                                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                            &lt;/ns1:CodiceTD>&#xa;                                                                                        &lt;/ns1:BandaDedicata>&#xa;                                                                                    &lt;/xsl:when>&#xa;                                                                                    &lt;xsl:otherwise>&#xa;                                                                                        &lt;ns1:BandaCondivisa>&#xa;                                                                                            &lt;ns1:CodiceVP>&#xa;                                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICEVP' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                            &lt;/ns1:CodiceVP>&#xa;                                                                                        &lt;/ns1:BandaCondivisa>&#xa;                                                                                    &lt;/xsl:otherwise>&#xa;                                                                                &lt;/xsl:choose>&#xa;                                                                            &lt;/ns1:Consegna>&#xa;                                                                        &lt;/ns1:ABR>&#xa;                                                                    &lt;/xsl:when>&#xa;                                                                    &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = 'CBR'&quot;>&#xa;                                                                        &lt;ns1:CBR>&#xa;                                                                            &lt;ns1:PCRDown>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRDOWN' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:PCRDown>&#xa;                                                                            &lt;ns1:PCRUp>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:PCRUp>&#xa;                                                                            &lt;ns1:Consegna>&#xa;                                                                                &lt;ns1:BandaDedicata>&#xa;                                                                                    &lt;ns1:CodiceTD>&#xa;                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                    &lt;/ns1:CodiceTD>&#xa;                                                                                &lt;/ns1:BandaDedicata>&#xa;                                                                            &lt;/ns1:Consegna>&#xa;                                                                        &lt;/ns1:CBR>&#xa;                                                                    &lt;/xsl:when>&#xa;                                                                    &lt;xsl:otherwise>&#xa;                                                                        &lt;ns1:VBR>&#xa;                                                                            &lt;ns1:PCRDown>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRDOWN' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:PCRDown>&#xa;                                                                            &lt;ns1:PCRUp>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:PCRUp>&#xa;                                                                            &lt;ns1:SCRDown>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='SCRDOWN' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:SCRDown>&#xa;                                                                            &lt;ns1:SCRUp>&#xa;                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='SCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                            &lt;/ns1:SCRUp>&#xa;                                                                            &lt;ns1:Consegna>&#xa;                                                                                &lt;ns1:BandaDedicata>&#xa;                                                                                    &lt;ns1:CodiceTD>&#xa;                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                    &lt;/ns1:CodiceTD>&#xa;                                                                                &lt;/ns1:BandaDedicata>&#xa;                                                                            &lt;/ns1:Consegna>&#xa;                                                                        &lt;/ns1:VBR>&#xa;                                                                    &lt;/xsl:otherwise>&#xa;                                                                &lt;/xsl:choose>&#xa;                                                            &lt;/ns1:ProfiloVC>&#xa;                                                        &lt;/ns1:VC>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns1:BitstreamATMAsimmetricoFlat>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '9'&quot;>&#xa;                                                &lt;ns1:BitstreamATMAsimmetricoHL>&#xa;                                                    &lt;ns1:Accesso>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'POTS'&quot;>&#xa;                                                                &lt;ns1:LineaPOTS>&#xa;                                                                    &lt;ns1:DatiSede>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                                            &lt;ns1:ParticellaToponomastica>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                                            &lt;/ns1:ParticellaToponomastica>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                                            &lt;ns1:Via>&#xa;                                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                                            &lt;/ns1:Via>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                                            &lt;ns1:Civico>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                                            &lt;/ns1:Civico>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                                            &lt;ns1:Localita>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                                            &lt;/ns1:Localita>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                    &lt;/ns1:DatiSede>&#xa;                                                                    &lt;ns1:ClienteFinale>&#xa;                                                                        &lt;ns1:CognomeRagSoc>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                                        &lt;/ns1:CognomeRagSoc>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:choose>&#xa;                                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                                &lt;ns1:CF>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                                &lt;/ns1:CF>&#xa;                                                                            &lt;/xsl:when>&#xa;                                                                            &lt;xsl:otherwise>&#xa;                                                                                &lt;ns1:PIVA>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                                &lt;/ns1:PIVA>&#xa;                                                                            &lt;/xsl:otherwise>&#xa;                                                                        &lt;/xsl:choose>&#xa;                                                                    &lt;/ns1:ClienteFinale>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                        &lt;ns1:Modem>&#xa;                                                                            &lt;ns1:Interfaccia>&#xa;                                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                                            &lt;/ns1:Interfaccia>&#xa;                                                                            &lt;xsl:choose>&#xa;                                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:when>&#xa;                                                                                &lt;xsl:otherwise>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:otherwise>&#xa;                                                                            &lt;/xsl:choose>&#xa;                                                                        &lt;/ns1:Modem>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                                        &lt;ns1:SlaProvisioning>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                        &lt;/ns1:SlaProvisioning>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                                        &lt;ns1:CodiceQualita>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                                        &lt;/ns1:CodiceQualita>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                                        &lt;ns1:CodiceDelivery>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                                        &lt;/ns1:CodiceDelivery>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                                        &lt;ns1:DAD>&#xa;                                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                                        &lt;/ns1:DAD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                                        &lt;ns1:FasciaOraria>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                                        &lt;/ns1:FasciaOraria>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;ns1:NumeroLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                                                    &lt;/ns1:NumeroLinea>&#xa;                                                                    &lt;ns1:ProfiloTecnicoLinea>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                                    &lt;/ns1:ProfiloTecnicoLinea>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Modulazione>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:Modulazione>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                                        &lt;ns1:Referente>&#xa;                                                                            &lt;ns1:Progressivo>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                                            &lt;/ns1:Progressivo>&#xa;                                                                            &lt;ns1:Qualifica>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                                            &lt;/ns1:Qualifica>&#xa;                                                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                            &lt;ns1:Cognome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                                            &lt;/ns1:Cognome>&#xa;                                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                                &lt;ns1:Telefono>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                                &lt;/ns1:Telefono>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                                &lt;ns1:Mobile>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                                &lt;/ns1:Mobile>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                                &lt;ns1:Email>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                                &lt;/ns1:Email>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                        &lt;/ns1:Referente>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICEPRODOTTOSPLITTER']/tns:valore = 'Y'&quot;>&#xa;                                                                            &lt;ns1:Splitter>&#xa;                                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                                            &lt;/ns1:Splitter>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Splitter>&#xa;                                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                                            &lt;/ns1:Splitter>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                &lt;/ns1:LineaPOTS>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = 'ISDN'&quot;>&#xa;                                                                &lt;ns1:LineaISDN>&#xa;                                                                    &lt;ns1:DatiSede>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                                            &lt;ns1:ParticellaToponomastica>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                                            &lt;/ns1:ParticellaToponomastica>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                                            &lt;ns1:Via>&#xa;                                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                                            &lt;/ns1:Via>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                                            &lt;ns1:Civico>&#xa;                                                                                &l