                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1469293436511&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperUserVlanID-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:MapperInput>&#xa;            &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key='USERVLANID']&quot;>&#xa;                &lt;inputUserVlanId>&#xa;                    &lt;userVlanId>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(tns:valore)&quot;/>&#xa;                    &lt;/userVlanId>&#xa;                    &lt;xsl:if test=&quot;tns:componente&quot;>&#xa;                        &lt;componente>&#xa;                            &lt;xsl:value-of select=&quot;tns:componente&quot;/>&#xa;                        &lt;/componente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:progressivo&quot;>&#xa;                        &lt;progressivo>&#xa;                            &lt;xsl:value-of select=&quot;tns:progressivo&quot;/>&#xa;                        &lt;/progressivo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/inputUserVlanId>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns4:MapperInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
