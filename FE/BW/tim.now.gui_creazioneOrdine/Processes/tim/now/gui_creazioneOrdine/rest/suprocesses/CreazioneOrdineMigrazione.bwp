            &lt;/xsl:if>&#xa;                                                                        &lt;xsl:choose>&#xa;                                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                                &lt;ns1:CF>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                                &lt;/ns1:CF>&#xa;                                                                            &lt;/xsl:when>&#xa;                                                                            &lt;xsl:otherwise>&#xa;                                                                                &lt;ns1:PIVA>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                                &lt;/ns1:PIVA>&#xa;                                                                            &lt;/xsl:otherwise>&#xa;                                                                        &lt;/xsl:choose>&#xa;                                                                    &lt;/ns1:ClienteFinale>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                        &lt;ns1:Modem>&#xa;                                                                            &lt;ns1:Interfaccia>&#xa;                                                                                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                                                                            &lt;/ns1:Interfaccia>&#xa;                                                                            &lt;xsl:choose>&#xa;                                                                                &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M01&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:when>&#xa;                                                                                &lt;xsl:otherwise>&#xa;                                                                                    &lt;ns1:Codice>&#xa;                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;M00&amp;quot;&quot;/>&#xa;                                                                                    &lt;/ns1:Codice>&#xa;                                                                                &lt;/xsl:otherwise>&#xa;                                                                            &lt;/xsl:choose>&#xa;                                                                        &lt;/ns1:Modem>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                                                        &lt;ns1:CodiceDelivery>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                                                        &lt;/ns1:CodiceDelivery>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                                                        &lt;ns1:SlaProvisioning>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                        &lt;/ns1:SlaProvisioning>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:choose>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                                            &lt;/ns1:SlaAssurance>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                                            &lt;ns1:SlaAssurance>&#xa;                                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                    