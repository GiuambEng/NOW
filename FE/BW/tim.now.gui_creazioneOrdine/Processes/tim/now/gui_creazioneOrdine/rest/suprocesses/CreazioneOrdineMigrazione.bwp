        &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;N&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEONFIELD&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:refOaoProgettiSpeciali)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                                    &lt;refOAOProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                                    &lt;/refOAOProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                            &lt;tipologiaQualita>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                            &lt;/tipologiaQualita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOLITE&amp;quot;&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:offertaCatalogo = 'BitstreamATMAsimmetricoLite' and $Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = ('POTS','ISDN')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                                &lt;numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                &lt;/numeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:tipoMigrazione = 'Attivazione274'&quot;>&#xa;                            &lt;codificaOLOAGCOMDonating>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                            &lt;/codificaOLOAGCOMDonating>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='TIPOLINEA']/tns:valore)&quot;>&#xa;                            &lt;tipologiaLinea>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='TIPOLINEA']/tns:valore)&quot;/>&#xa;                            &lt;/tipologiaLinea>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;(string-length($RecuperoOneStep/Record[1]/ONESTEP)>0 and upper-case($RecuperoOneStep/Record[1]/ONESTEP) = ('Y','SI')) and ($Start/tns:oao !=($Start/tns:oaoDonating1,$Start/tns:oaoDonating2)) and (string-length($Start/tns:fasciaOraria)>0)&quot;>&#xa;                            &lt;IDFasciaOrariaUA>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:fasciaOraria)&quot;/>&#xa;                            &lt;/IDFasciaOrariaUA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ordine>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;(string-length($RecuperoOneStep/Record[1]/ONESTEP)>0 and upper-case($RecuperoOneStep/Record[1]/ONESTEP) = ('Y','SI')) and ($Start/tns:oao !=($Start/tns:oaoDonating1,$Start/tns:oaoDonating2))&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:dac)  and (string-length($Start/tns:fasciaOraria)>0)&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                                            &lt;DAD>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                                            &lt;/DAD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:fasciaOraria)>0&quot;>&#xa;                                        &lt;DAD>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:date('99/99/9999')&quot;/>&#xa;                                        &lt;/DAD>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                                    &lt;DAD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                                    &lt;/DAD>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                            &lt;codiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                            &lt;/codiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                            &lt;DNOLOCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                            &lt;/DNOLOCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                            &lt;numeroVerdeOloCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                            &lt;/numeroVerdeOloCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                            &lt;numeroVerdeOloPT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                            &lt;/numeroVerdeOloPT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                            &lt;noteCliente>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                            &lt;/noteCliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                            &lt;codiceOrdineOLOPadre>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                            &lt;/codiceOrdineOLOPadre>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                            &lt;codiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                            &lt;/codiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;tipologiaLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLavorazione>&#xa;                        &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;dettaglioordine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[1]/tns:componente)&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key!='SLAASSURANCE' and tns:key!='SLAPROVISIONING']&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:key = 'MODULAZIONE'&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;tns:valore = 'Interleaved'&quot;>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;tns:valore = 'Fast'&quot;>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;    