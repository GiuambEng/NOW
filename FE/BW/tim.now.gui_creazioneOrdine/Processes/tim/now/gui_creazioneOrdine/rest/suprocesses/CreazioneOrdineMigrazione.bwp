:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                                                        &lt;ns1:CodiceQualita>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                                                        &lt;/ns1:CodiceQualita>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                                                        &lt;ns1:DAD>&#xa;                                                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                                                        &lt;/ns1:DAD>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                                                        &lt;ns1:FasciaOraria>&#xa;                                                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                                                        &lt;/ns1:FasciaOraria>&#xa;                                                                    &lt;/xsl:if>&#xa;                                                                    &lt;ns1:NumeroLinea>&#xa;                                              