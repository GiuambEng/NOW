                            &lt;sede>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDSede>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDSede>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;/>&#xa;                                    &lt;/via>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                    &lt;/civico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;>&#xa;                                    &lt;comune>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;/>&#xa;                                    &lt;/comune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;>&#xa;                                    &lt;provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;/>&#xa;                                    &lt;/provincia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                    &lt;CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                    &lt;/CAP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                    &lt;complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                    &lt;/complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                    &lt;interno>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                    &lt;/interno>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                    &lt;scala>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                    &lt;/scala>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                    &lt;piano>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                    &lt;/piano>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                                    &lt;codiceISTATComune>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                    &lt;/codiceISTATComune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;exists($RecuperoDatiIstat/Record/COD_ISTAT_PROV)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_PROV&quot;>&#xa;                                        &lt;codiceISTATProvincia>&#xa;                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_PROV&quot;/>&#xa;                                        &lt;/codiceISTATProvincia>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_PARTICELLA_TOPON&quot;>&#xa;                                    &lt;codiceToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_PARTICELLA_TOPON&quot;/>&#xa;                                    &lt;/codiceToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tipologiaSede>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SEDECLIENTE&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaSede>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                            &lt;/sede>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;../tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;tns:progressivoReferente&quot;>&#xa;                                    &lt;progressivoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                    &lt;/progressivoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;tns:qualifica&quot;>&#xa;                                    &lt;qualificaReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                    &lt;/qualificaReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;N&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEONFIELD&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:refOaoProgettiSpeciali)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                                    &lt;refOAOProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                                    &lt;/refOAOProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                            &lt;tipologiaQualita>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                            &lt;/tipologiaQualita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:offertaCatalogo = 'BitstreamGBEAsimmetricoFlat' and $Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = ('POTS','ISDN')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                                &lt;numeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                                &lt;/numeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:tipoMigrazione = 'Attivazione274'&quot;>&#xa;                            &lt;codificaOLOAGCOMDonating>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                            &lt;/codificaOLOAGCOMDonating>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='TIPOLINEA']/tns:valore)&quot;>&#xa;                            &lt;tipologiaLinea>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='TIPOLINEA']/tns:valore)&quot;/>&#xa;                            &lt;/tipologiaLinea>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;(string-length($RecuperoOneStep/Record[1]/ONESTEP)>0 and upper-case($RecuperoOneStep/Record[1]/ONESTEP) = ('Y','SI')) and ($Start/tns:oao !=($Start/tns:oaoDonating1,$Start/tns:oaoDonating2)) and (string-length($Start/tns:fasciaOraria)>0)&quot;>&#xa;                            &lt;IDFasciaOrariaUA>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:fasciaOraria)&quot;/>&#xa;                            &lt;/IDFasciaOrariaUA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ordine>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                &lt;ISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                &lt;/ISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                &lt;localita>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                &lt;/localita>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamATMAsimmetricoFlat'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamATMAsimmetricoHL'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOHL&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamATMAsimmetricoLite'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOLITE&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = ('POTS','ISDN')&quot;>&#xa;                    &lt;flagNaked>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/flagNaked>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;flagNaked>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                    &lt;/flagNaked>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;(string-length($RecuperoOneStep/Record[1]/ONESTEP)>0 and upper-case($RecuperoOneStep/Record[1]/ONESTEP) = ('Y','SI')) and ($Start/tns:oao !=($Start/tns:oaoDonating1,$Start/tns:oaoDonating2))&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/tns:dac)  and (string-length($Start/tns:fasciaOraria)>0)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                                &lt;DAD>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                                &lt;/DAD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns:fasciaOraria)>0&quot;>&#xa;                            &lt;DAD>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date('99/99/9999')&quot;/>&#xa;                            &lt;/DAD>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                        &lt;DAD>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                        &lt;/DAD>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($Start/tns:fasciaOraria)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                    &lt;IDFasciaOraria>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                    &lt;/IDFasciaOraria>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloData/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:tipoMigrazione = 'Attivazione274'&quot;>&#xa;                &lt;codificaOLOAGCOMDonating>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                &lt;/codificaOLOAGCOMDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                &lt;codiceRisorsaDonating>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                &lt;/codiceRisorsaDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idRisorsa2&quot;>&#xa;                &lt;codiceRisorsaDonating2>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa2&quot;/>&#xa;                &lt;/codiceRisorsaDonating2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:tipoMigrazione = &amp;quot;Attivazione274&amp;quot;&quot;>&#xa;                    &lt;cowCodeOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                    &lt;/cowCodeOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:tipoMigrazione !=&amp;quot;Attivazione274&amp;quot; and string-length($Start/tns:oaoDonating1) >0&quot;>&#xa;                    &lt;cowCodeOLO>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating1)&quot;/>&#xa;                    &lt;/cowCodeOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;cowCodeOLO>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating1)&quot;/>&#xa;                    &lt;/cowCodeOLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:oaoDonating2) and (exists($TracciatoOloXDSL/ns1:Richiesta/ns1:TipoRichiesta/ns1:Migrazione/ns1:MigrazioneOLO/ns1:DatiMigrazione/ns1:CodiceRisorsa2) or exists($TracciatoOloXDSL/ns1:Richiesta/ns1:TipoRichiesta/ns1:Migrazione/ns1:Attivazione274/ns1:DatiMigrazione/ns1:CodiceRisorsa2)) and (exists($TracciatoOloXDSL/ns1:Richiesta/ns1:TipoRichiesta/ns1:Migrazione/ns1:MigrazioneOLO/ns1:DatiMigrazione/ns1:CodiceSessione2) or exists($TracciatoOloXDSL/ns1:Richiesta/ns1:TipoRichiesta/ns1:Migrazione/ns1:Attivazione274/ns1:DatiMigrazione/ns1:CodiceSessione2))&quot;>&#xa;                &lt;cowCodeOLO2>&#xa;                    &lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating2)&quot;/>&#xa;                &lt;/cowCodeOLO2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceSessione1&quot;>&#xa;                &lt;codiceSessione>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceSessione1&quot;/>&#xa;                &lt;/codiceSessione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceSessione2&quot;>&#xa;                &lt;codiceSessione2>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceSessione2&quot;/>&#xa;                &lt;/codiceSessione2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dn&quot;>&#xa;                &lt;DNAggiuntivo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&#xa;                &lt;/DNAggiuntivo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$Start/tns:dnAggiuntive&quot;>&#xa;                &lt;xsl:if test=&quot;. !=../tns:dn&quot;>&#xa;                    &lt;DNAggiuntivo>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/DNAggiuntivo>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:flagNumerazioniAggiuntive)&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/tns:flagNumerazioniAggiuntive&quot;>&#xa;                    &lt;flagNumAggiuntive>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:flagNumerazioniAggiuntive&quot;/>&#xa;                    &lt;/flagNumAggiuntive>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;>&#xa;                &lt;tipologiaSottolav>&#xa;                    &lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;/>&#xa;                &lt;/tipologiaSottolav>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione = 'MIGRAZIONEOLO' and $TracciatoOloXDSL/ns1:Richiesta[1]/ns1:TipoRichiesta/ns1:Migrazione/ns1:MigrazioneOLO/ns1:DatiMigrazione/ns1:CodiceSessione1 = 'CAMBIOTECNOLOGIA' and xsd:int($ControlloOscuramento/Record[1]/FLAG_OSCURMENTO) = 0&quot;>&#xa;                &lt;cambioTecnologia>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/cambioTecnologia>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CasedataMigrazione"
                    name="CasedataBPMATM-GBE"
                    outputVariable="CasedataMigrazione"
                    tibex:xpdlId="6300c2da-209e-48bf-912a-376678dc858a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToCasedataBPMATM-GBE"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CasedataBPMATM-GBEToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloData.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;Variabile&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperAttVC&quot;/>&#xa;    &lt;xsl:param name=&quot;DeterminaSottoLavorazioneXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOneStep&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataMigrazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamATMAsimmetricoFlat'&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;(string-length($RecuperoOneStep/Record[1]/ONESTEP)>0 and upper-case($RecuperoOneStep/Record[1]/ONESTEP) = ('Y','SI')) and ($Start/tns:oao !=($Start/tns:oaoDonating1,$Start/tns:oaoDonating2))&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:dac)  and (string-length($Start/tns:fasciaOraria)>0)&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                                            &lt;DAD>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                                            &lt;/DAD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:fasciaOraria)>0&quot;>&#xa;                                        &lt;DAD>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:date('99/99/9999')&quot;/>&#xa;                                        &lt;/DAD>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                                    &lt;DAD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                                    &lt;/DAD>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                            &lt;codiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;   