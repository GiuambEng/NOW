ore = 'Y'&quot;>&#xa;                                                            &lt;valoreAttributo>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                            &lt;/valoreAttributo>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;valoreAttributo>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/valoreAttributo>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;tipologiaDato>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                    &lt;/tipologiaDato>&#xa;                                                &lt;/attributiDettaglioOrdine>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;attributiDettaglioOrdine>&#xa;                                                    &lt;IDRichiestaOLO>&#xa;                                                        &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                                    &lt;/IDRichiestaOLO>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:flagModem = 'Y'&quot;>&#xa;                                                         