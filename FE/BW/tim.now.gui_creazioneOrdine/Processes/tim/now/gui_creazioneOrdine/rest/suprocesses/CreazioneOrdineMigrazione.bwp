                                  &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivo>&#xa;                        &lt;/dettaglioordine>&#xa;                        &lt;xsl:for-each select=&quot;$Variabile/tns3:root&quot;>&#xa;                            &lt;dettaglioordine>&#xa;                                &lt;xsl:variable name=&quot;currPosition&quot; select=&quot;current()/tns3:progressivo&quot;/>&#xa;                                &lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns3:componente&quot;/>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition)+1)&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;IDDettaglioOrdineParent>&#xa;                                  