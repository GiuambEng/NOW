                                    &lt;ns1:Splitter>&#xa;                                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                                            &lt;/ns1:Splitter>&#xa;                                                                        &lt;/xsl:when>&#xa;                                                                        &lt;xsl:otherwise>&#xa;                                                                            &lt;ns1:Splitter>&#xa;                                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                                            &lt;/ns1:Splitter>&#xa;                                                                        &lt;/xsl:otherwise>&#xa;                                                                    &lt;/xsl:choose>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                                        &lt;ns1:Referente>&#xa;                                                                            &lt;ns1:Progressivo>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                                            &lt;/ns1:Progressivo>&#xa;                                                                            &lt;ns1:Qualifica>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                                            &lt;/ns1:Qualifica>&#xa;                                                                            &lt;ns1:Nome>&#xa;                   