>&lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloData/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:tipoMigrazione = 'Attivazione274'&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOLINEA']/tns:valore = ('POTS','ISDN')&quot;>&lt;xsl:if test=&quot;$Start/tns:numeroLinea&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns:numeroLinea&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dac&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;codiceRisorsaDonating>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/codiceRisorsaDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idRisorsa2&quot;>&lt;codiceRisorsaDonating2>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa2&quot;/>&lt;/codiceRisorsaDonating2>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:tipoMigrazione = &amp;quot;Attivazione274&amp;quot;&quot;>&lt;cowCodeOLO>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/cowCodeOLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:tipoMigrazione !=&amp;quot;Attivazione274&amp;quot; and string-length($Start/tns:oaoDonating1) >0&quot;>&lt;cowCodeOLO>&lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating1)&quot;/>&lt;/cowCodeOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;cowCodeOLO>&lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating1)&quot;/>&lt;/cowCodeOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Start/tns:oaoDonating2) and (exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:DatiMigrazione/ns0:CodiceRisorsa2) or exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:DatiMigrazione/ns0:CodiceRisorsa2)) and (exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:DatiMigrazione/ns0:CodiceSessione2) or exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:DatiMigrazione/ns0:CodiceSessione2))&quot;>&lt;cowCodeOLO2>&lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating2)&quot;/>&lt;/cowCodeOLO2>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceSessione1&quot;>&lt;codiceSessione>&lt;xsl:value-of select=&quot;$Start/tns:codiceSessione1&quot;/>&lt;/codiceSessione>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceSessione2&quot;>&lt;codiceSessione2>&lt;xsl:value-of select=&quot;$Start/tns:codiceSessione2&quot;/>&lt;/codiceSessione2>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dn&quot;>&lt;DNAggiuntivo>&lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&lt;/DNAggiuntivo>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns:dnAggiuntive&quot;>&lt;xsl:if test=&quot;. !=../tns:dn&quot;>&lt;DNAggiuntivo>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/DNAggiuntivo>&lt;/xsl:if>&lt;/xsl:for-each>&lt;xsl:if test=&quot;exists($Start/tns:flagNumerazioniAggiuntive)&quot;>&lt;xsl:if test=&quot;$Start/tns:flagNumerazioniAggiuntive&quot;>&lt;flagNumAggiuntive>&lt;xsl:value-of select=&quot;$Start/tns:flagNumerazioniAggiuntive&quot;/>&lt;/flagNumAggiuntive>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$DeterminaSottoLavorazioneNGA/tns2:sottolavorazione&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneNGA/tns2:sottolavorazione&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:if>&lt;xsl:if test=&quot;(($Start/tns:offertaCatalogo = 'BitstreamNGAFTTCAB') or ($Start/tns:offertaCatalogo = 'VULAFTTCAB') or ($Start/tns:offertaCatalogo = 'EasyIPUBBFTTCAB')) and ($TracciatoOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:DatiMigrazione/ns0:CodiceSessione1 = 'CAMBIOTECNOLOGIA') and (string-length($Start/tns:codiceProgetto)>0)&quot;>&lt;disaggregato>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/disaggregato>&lt;/xsl:if>&lt;xsl:if test=&quot;$DeterminaSottoLavorazioneNGA/tns2:sottolavorazione = 'MIGRAZIONEOLO' and $TracciatoOloNGA/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:DatiMigrazione/ns0:CodiceSessione1 = 'CAMBIOTECNOLOGIA' and xsd:int($ControlloOscuramento/Record[1]/FLAG_OSCURMENTO) = 0&quot;>&lt;cambioTecnologia>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/cambioTecnologia>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CasedataMigrazione"
                    name="CasedataBPMNGA"
                    outputVariable="CasedataMigrazione"
                    tibex:xpdlId="9d4e64e5-9430-4709-b537-80e82d05d27b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Copy_1_DeterminaSottoLavorazioneXDSLToCasedataBPMNGA"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CasedataBPMNGAToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloData.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;Variabile&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;DeterminaSottoLavorazioneNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;OscuramentoIntermediateAgent&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;OscuramServOpz&quot;/>&#xa;    &lt;xsl:param name=&quot;OscuratoQualifica&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOneStep&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataMigrazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamNGAFTTCAB'&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;(string-length($RecuperoOneStep/Record[1]/ONESTEP)>0 and upper-case($RecuperoOneStep/Record[1]/ONESTEP) = ('Y','SI')) and ($Start/tns:oao !=($Start/tns:oaoDonating1,$Start/tns:oaoDonating2))&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:dac)  and (string-length($Start/tns:fasciaOraria)>0)&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                                            &lt;DAD>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                                            &lt;/DAD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:fasciaOraria)>0&quot;>&#xa;                                        &lt;DAD>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:date('99/99/9999')&quot;/>&#xa;                                        &lt;/DAD>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                                    &lt;DAD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                                    &lt;/DAD>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                            &lt;codiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                            &lt;/codiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                            &lt;DNOLOCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                            &lt;/DNOLOCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                            &lt;numeroVerdeOloCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                            &lt;/numeroVerdeOloCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                            &lt;numeroVerdeOloPT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                            &lt;/numeroVerdeOloPT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                            &lt;codiceOrdineOLOPadre>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                            &lt;/codiceOrdineOLOPadre>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                            &lt;codiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                            &lt;/codiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;tipologiaLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLavorazione>&#xa;                        &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneNGA/tns2:sottolavorazione&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneNGA/tns2:sottolavorazione&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;dettaglioordine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[1]/tns:componente)&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#