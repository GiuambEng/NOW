                <tibex:extActivity
                    inputVariable="DeterminaSottoLavorazioneNGA-input"
                    name="DeterminaSottoLavorazioneNGA"
                    outputVariable="DeterminaSottoLavorazioneNGA"
                    tibex:xpdlId="ee3e78d5-6a0b-4bff-baf3-e0cd0789a240"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TracciatoOloNGAToCopy_1_DeterminaSottoLavorazioneXDSL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_DeterminaSottoLavorazioneXDSLToCasedataBPMNGA"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoNomeOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloNGA&quot;/>&#xa;    &lt;xsl:template name=&quot;DeterminaSottoLavorazioneNGA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputSottolavRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                &lt;tns2:codiceRisorsa1>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                &lt;/tns2:codiceRisorsa1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:oao&quot;>&#xa;                &lt;tns2:codificaRecipient>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                &lt;/tns2:codificaRecipient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                &lt;tns2:OffertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                &lt;/tns2:OffertaCatalogo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'BitstreamNGAFTTCAB'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'EasyIPUBBFTTCAB'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPUBBFTTCAB&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIEasyIPUBBFTTH'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SEMIEASYIPUBBFTTH&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'EasyIPUBBFTTH'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPUBBFTTH&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'BitstreamNGAFTTH'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIBitstreamNGAFTTH'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG ='VULAFTTCAB'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTCAB&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG ='SEMIVULAFTTH'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SEMIVULAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Lavorazione>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274)&quot;>&#xa;                &lt;tns2:Attivazione274>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns2:Attivazione274>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:inputSottolavRichiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.gui_creazioneOrdine.rest.suprocesses.DeterminaSottoLavorazioneRichiesta" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperoOloNumerico-input"
                    name="RecuperoOloNumerico"
                    outputVariable="RecuperoOloNumerico"
                    tibex:xpdlId="bd035395-4257-48a1-899a-b4efb3f093d7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperoOloNumericoToRecuperoDatiIstat"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bd035395-4257-48a1-899a-b4efb3f093d7+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:oao)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_OLO&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CasedataMigrazione" name="Assign"
                    outputVariable="CasedataMigrazione"
                    tibex:xpdlId="20a4d84a-8637-4518-96c6-e5c74dfb0dda" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToAssign_FLAGNPY"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToInputCreateProcessBPM"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CasedataMigrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Variabile&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataMigrazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;$CasedataMigrazione/created&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;$CasedataMigrazione/lastUpdate&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$CasedataMigrazione/operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$CasedataMigrazione/IDRichiestaOLO&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;$CasedataMigrazione/statoRichiestaNOW&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;xsl:if test=&quot;$CasedataMigrazione/statoRichiestaPrecedNOW&quot;>&#xa;                &lt;statoRichiestaPrecedNOW>&#xa;                    &lt;xsl:value-of select=&quot;$CasedataMigrazione/statoRichiestaPrecedNOW&quot;/>&#xa;                &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$CasedataMigrazione/statoRichiestaOLO&quot;>&#xa;                &lt;statoRichiestaOLO>&#xa;                    &