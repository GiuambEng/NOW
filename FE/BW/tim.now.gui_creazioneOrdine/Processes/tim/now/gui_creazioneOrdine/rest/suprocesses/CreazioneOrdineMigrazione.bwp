            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="DeterminaSottoLavorazioneXDSL-input"
                    name="DeterminaSottoLavorazioneXDSL"
                    outputVariable="DeterminaSottoLavorazioneXDSL"
                    tibex:xpdlId="2659cf34-4ec2-4088-b764-8184ce7b2df8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TracciatoOloXDSLToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToCasedataBPMEasyIP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToCasedataBPMATM-GBE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:offertaCatalogo = ('BitstreamATMAsimmetricoFlat', 'BitstreamATMSimmetricoFlat', 'BitstreamATMAsimmetricoHL', 'BitstreamATMSimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns0:offertaCatalogo = ('BitstreamATMAsimmetricoFlat', 'BitstreamATMSimmetricoFlat', 'BitstreamATMAsimmetricoHL', 'BitstreamATMSimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoNomeOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;DeterminaSottoLavorazioneXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputSottolavRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                &lt;tns2:codiceRisorsa1>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                &lt;/tns2:codiceRisorsa1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:oao&quot;>&#xa;                &lt;tns2:codificaRecipient>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                &lt;/tns2:codificaRecipient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                &lt;tns2:OffertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                &lt;/tns2:OffertaCatalogo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'BitstreamATMAsimmetricoFlat'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'BitstreamATMAsimmetricoHL'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOHL&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG ='BitstreamATMAsimmetricoLite'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOLITE&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'BitstreamGBEAsimmetricoFlat'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG='EasyIPBasePlusFlat'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG='EasyIPBasePlusLite'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSLITE&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG='EasyIPSpecialProfileFlat'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILEFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILELITE&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Lavorazione>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloXDSL/ns1:Richiesta/ns1:TipoRichiesta/ns1:Migrazione/ns1:Attivazione274)&quot;>&#xa;                &lt;tns2:Attivazione274>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns2:Attivazione274>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:inputSottolavRichiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.gui_creazioneOrdine.rest.suprocesses.DeterminaSottoLavorazioneRichiesta" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
