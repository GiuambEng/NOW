                                            &lt;ns1:Nome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                                            &lt;/ns1:Nome>&#xa;                                                                            &lt;ns1:Cognome>&#xa;                                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                                            &lt;/ns1:Cognome>&#xa;                                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                                &lt;ns1:Telefono>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                                &lt;/ns1:Telefono>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                                &lt;ns1:Mobile>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                                &lt;/ns1:Mobile>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                                &lt;ns1:Email>&#xa;                                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                                &lt;/ns1:Email>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                        &lt;/ns1:Referente>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns1:LineaNonFonia>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns1:Accesso>&#xa;                                                    &lt;ns1:VC>&#xa;                                                        &lt;ns1:VPI>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI']/tns:valore)&quot;/>&#xa;                                                        &lt;/ns1:VPI>&#xa;                                                        &lt;ns1:VCI>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI']/tns:valore)&quot;/>&#xa;                                                        &lt;/ns1:VCI>&#xa;                                                    &lt;/ns1:VC>&#xa;                                                &lt;/ns1:EasyIPSpecialProfileLite>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns1:Servizio>&#xa;                                    &lt;ns1:DatiMigrazione>&#xa;                                        &lt;ns1:CodiceRisorsa1>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                        &lt;/ns1:CodiceRisorsa1>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:codiceSessione1&quot;>&#xa;                                            &lt;ns1:CodiceSessione1>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:codiceSessione1&quot;/>&#xa;                                            &lt;/ns1:CodiceSessione1>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;ns1:CodiceOLO1>&#xa;                                            &lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating1)&quot;/>&#xa;                                        &lt;/ns1:CodiceOLO1>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa2&quot;>&#xa;                                            &lt;ns1:CodiceRisorsa2>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa2&quot;/>&#xa;                                            &lt;/ns1:CodiceRisorsa2>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:codiceSessione2&quot;>&#xa;                                            &lt;ns1:CodiceSessione2>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:codiceSessione2&quot;/>&#xa;                                            &lt;/ns1:CodiceSessione2>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;exists($Start/tns:oaoDonating2)&quot;>&#xa;                                            &lt;ns1:CodiceOLO2>&#xa;                                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:oaoDonating2)&quot;/>&#xa;                                            &lt;/ns1:CodiceOLO2>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($Start/tns:dac)&quot;>&#xa;                                                &lt;ns1:DAC>&#xa;                                                    &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dac), 9, 2),'/',substring(xsd:string($Start/tns:dac), 6, 2),'/',substring(xsd:string($Start/tns:dac), 1, 4))&quot;/>&#xa;                                                &lt;/ns1:DAC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns1:DAC>&#xa;                                                    &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                                                &lt;/ns1:DAC>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;exists($Start/tns:flagNumerazioniAggiuntive)&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:flagNumerazioniAggiuntive&quot;>&#xa;                                                &lt;ns1:FlagNumerazioniAggiuntive>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:flagNumerazioniAggiuntive&quot;/>&#xa;                                                &lt;/ns1:FlagNumerazioniAggiuntive>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:flagNp='Y'&quot;>&#xa;                                            &lt;ns1:NP>&#xa;                                                &lt;ns1:RoutingNumberRecipient>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:routingNumber&quot;/>&#xa;                                                &lt;/ns1:RoutingNumberRecipient>&#xa;                                                &lt;ns1:DN>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&#xa;                                                &lt;/ns1:DN>&#xa;                                                &lt;xsl:for-each select=&quot;$Start/tns:dnAggiuntive&quot;>&#xa;                                                    &lt;ns1:DN>&#xa;                                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                    &lt;/ns1:DN>&#xa;                                                &lt;/xsl:for-each>&#xa;                                            &lt;/ns1:NP>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns1:DatiMigrazione>&#xa;                                &lt;/ns1:Attivazione274>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns1:Migrazione>&#xa;                &lt;/ns1:TipoRichiesta>&#xa;            &lt;/ns1:Richiesta>&#xa;        &lt;/ns1:TracciatoOLOxDSL>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TracciatoOloXDSL" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="a21409f4-981d-4503-a688-174d518fe7fe">
                <bpws:targets>
                    <bpws:target linkName="LogCalcoloDataToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToMapper"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit"
                        tibex:xpdlId="00c1c259-a4f5-4128-ae24-063616d0851c" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+5cf20520-7da5-437d-b7cc-fddbfecc7c5c" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$Start/ns0:attributiOfferta/ns0:sezioneInferiore[ns0:key = 'IDPROFILOVC']" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns0:attributiOfferta/ns0:sezioneInferiore[ns0:key = 'IDPROFILOVC'])]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns0:Iterate_Current_Element_sezioneInferiore"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToRecuperoValoriProfiloVC" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="RecuperoValoriProfiloVCToMapperProfiloVC" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="MapperToAccumulate" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="b436d4ab-ea71-4b0e-949b-b119f3cefb22" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToRecuperoValoriProfiloVC"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns0:attributiOfferta/ns0:sezioneInferiore[ns0:key = 'IDPROFILOVC'])[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="5cf20520-7da5-437d-b7cc-fddbfecc7c5c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperProfiloVC</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="RecuperoValoriProfiloVC-input"
                                    name="RecuperoValoriProfiloVC"
                                    outputVariable="RecuperoValoriProfiloVC"
                                    tibex:xpdlId="ab9a8595-2347-436f-83ba-35352e09d675" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToRecuperoValoriProfiloVC"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoValoriProfiloVCToMapperProfiloVC"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ab9a8595-2347-436f-83ba-35352e09d675+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoValoriProfiloVC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;idProfiloVC>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($currentElement/tns:valore)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement/tns:valore&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idProfiloVC>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select MCR_DOWN, MCR_UP, PCR_DOWN, PCR_UP, SCR_DOWN, SCR_UP&#xa;from PROFILO_VC&#xa;where ID_PRFL_VC = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idProfiloVC"/>

                                    <columnMetadata
                                    columnName="MCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="MCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="PCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="PCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="SCR_DOWN"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="SCR_UP"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="MapperProfiloVC-input"
                                    name="MapperProfiloVC"
                                    outputVariable="MapperProfiloVC"
                                    tibex:xpdlId="6ffca2c1-9915-4382-88df-76185d5e4a6b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RecuperoValoriProfiloVCToMapperProfiloVC"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToAccumulate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoValoriProfiloVC&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperProfiloVC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:root>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:progressivo=$currentElement/tns:progressivo ]/tns:valore = 'ABR'&quot;>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRDOWN'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRUP'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_UP)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'MCRDOWN'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'MCRUP'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/MCR_UP)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:progressivo=$currentElement/tns:progressivo ]/tns:valore = 'CBR'&quot;>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRDOWN'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRUP'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_UP)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRDOWN'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRUP'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_UP)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'SCRDOWN'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;starts-with(xsd:string($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN), '37')=true()&quot;>&#xa;                                &lt;tns4:valore>&#xa;                                    &lt;xsl:value-of select=&quot;'37,5'&quot;/>&#xa;                                &lt;/tns4:valore>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:valore>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN)&quot;/>&#xa;                                &lt;/tns4:valore>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'SCRUP'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;starts-with(xsd:string($RecuperoValoriProfiloVC/Record[1]/SCR_UP), '37')=true()&quot;>&#xa;                                &lt;tns4:valore>&#xa;                                    &lt;xsl:value-of select=&quot;'37,5'&quot;/>&#xa;                                &lt;/tns4:valore>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:valore>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($RecuperoValoriProfiloVC/Record[1]/SCR_UP)&quot;/>&#xa;                                &lt;/tns4:valore>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:RecuperoValoriProfiloVC="http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="RecuperoValoriProfiloVC:root" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperAttVC-input" name="MapperAttVC"
                    outputVariable="MapperAttVC"
                    tibex:xpdlId="ed02fd8c-66d3-4598-ab88-1d49fb6a2fe6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperAttVCToEmpty_Name">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperAttVC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:root>&#xa;            &lt;xsl:for-each select=&quot;$Accumulate/tns4:root/tns4:sezioneInferiore&quot;>&#xa;                &lt;tns4:sezioneInferiore>&#xa;                    &lt;xsl:if test=&quot;tns4:key&quot;>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;tns4:key&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:componente&quot;>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;tns4:componente&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:tipologiaDato&quot;>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;tns4:tipologiaDato&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:valore&quot;>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;tns4:valore&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:progressivo&quot;>&#xa;                        &lt;tns4:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;tns4:progressivo&quot;/>&#xa;                        &lt;/tns4:progressivo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:sezioneInferiore>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns4:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:RecuperoValoriProfiloVC="http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="RecuperoValoriProfiloVC:root" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloData&quot;/>&#xa;    &lt;xsl:param name=&quot;Variabile&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperAttVC&quot;/>&#xa;    &lt;xsl:param name=&quot;DeterminaSottoLavorazioneXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOneStep&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataMigrazione&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'BitstreamATMAsimmetricoFlat'&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;(string-length($RecuperoOneStep/Record[1]/ONESTEP)>0 and upper-case($RecuperoOneStep/Record[1]/ONESTEP) = ('Y','SI')) and ($Start/tns:oao !=($Start/tns:oaoDonating1,$Start/tns:oaoDonating2))&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns:dac)  and (string-length($Start/tns:fasciaOraria)>0)&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                                            &lt;DAD>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                                            &lt;/DAD>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($Start/tns:fasciaOraria)>0&quot;>&#xa;                                        &lt;DAD>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:date('99/99/9999')&quot;/>&#xa;                                        &lt;/DAD>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                                    &lt;DAD>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                                    &lt;/DAD>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                            &lt;codiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                            &lt;/