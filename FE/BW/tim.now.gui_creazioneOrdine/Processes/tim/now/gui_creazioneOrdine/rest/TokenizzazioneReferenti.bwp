                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (upper-case($post/item/tns:inputTokenizzazione/tns:lavorazione) = 'ATTIVAZIONE') then $OffertaXML/Record[1]/NOME_OFFERTA_ESTERNA&#xd;&#xa;else if (upper-case($post/item/tns:inputTokenizzazione/tns:lavorazione) = 'VARIAZIONE') then &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(if ($NomeOffCtlg/Record[1]/NOME_OFFERTA_CATLG = ('ULL','ULLDATI','SHA')) then 'ULL'&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else if ($NomeOffCtlg/Record[1]/NOME_OFFERTA_CATLG = 'SLU') then 'SLU'&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else if ($NomeOffCtlg/Record[1]/NOME_OFFERTA_CATLG = ('WLR','VULL')) then 'WLR'&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else $OffertaXML/Record[1]/NOME_OFFERTA_ESTERNA)&#xd;&#xa;&#x9;else if (upper-case($post/item/tns:inputTokenizzazione/tns:lavorazione) = 'CESSAZIONE') then &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(if ($NomeOffCtlg/Record[1]/NOME_OFFERTA_CATLG = ('VULL','SHA') or $post/item/tns:inputTokenizzazione/tns:idOfferta = ('1','2','3','4','27','28')) then 'ULL'&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else if ($NomeOffCtlg/Record[1]/NOME_OFFERTA_CATLG = 'SLU' or $post/item/tns:inputTokenizzazione/tns:idOfferta = ('5','6')) then 'SLU'&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else if ($post/item/tns:inputTokenizzazione/tns:idOfferta = '25') then 'WLRLINEAATTIVA'&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else $OffertaXML/Record[1]/NOME_OFFERTA_ESTERNA)&#xd;&#xa;&#x9;&#x9;else if (upper-case($post/item/tns:inputTokenizzazione/tns:lavorazione) = 'MIGRAZIONE') then&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(if ($NomeOffCtlg/Record[1]/NOME_OFFERTA_CATLG = ('ULL','ULLDATI','SHA','VULL','WLR','SLU')) then $NomeOffCtlg/Record[1]/NOME_OFFERTA_CATLG&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else $OffertaXML/Record[1]/NOME_OFFERTA_ESTERNA)&#xd;&#xa;&#x9;&#x9;else $OffertaXML/Record[1]/NOME_OFFERTA_ESTERNA"
