                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Tokenizzazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;esitoOK&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$esitoOK=false()&quot;>&lt;tns:outputTokenizzazione>&lt;tns:referentiTokenizzati>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;xsl:for-each select=&quot;$post/item/tns:inputTokenizzazione/tns:numeriReferenti&quot;>&lt;tns:numeriReferenti>&lt;xsl:if test=&quot;tns:id&quot;>&lt;tns:id>&lt;xsl:value-of select=&quot;tns:id&quot;/>&lt;/tns:id>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:numeroFisso&quot;>&lt;tns:numeroFisso>&lt;xsl:value-of select=&quot;tns:numeroFisso&quot;/>&lt;/tns:numeroFisso>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:numeroMobile&quot;>&lt;tns:numeroMobile>&lt;xsl:value-of select=&quot;tns:numeroMobile&quot;/>&lt;/tns:numeroMobile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cognome&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codFiscale&quot;>&lt;tns:codFiscale>&lt;xsl:value-of select=&quot;tns:codFiscale&quot;/>&lt;/tns:codFiscale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:pIva&quot;>&lt;tns:pIva>&lt;xsl:value-of select=&quot;tns:pIva&quot;/>&lt;/tns:pIva>&lt;/xsl:if>&lt;/tns:numeriReferenti>&lt;/xsl:for-each>&lt;/tns:referentiTokenizzati>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Tokenizzazione non andata a buon fine&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputTokenizzazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputTokenizzazione>&lt;tns:referentiTokenizzati>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:esito>&lt;xsl:for-each select=&quot;$Accumulate/tns:numeriReferente&quot;>&lt;tns:numeriReferenti>&lt;xsl:if test=&quot;tns:id&quot;>&lt;tns:id>&lt;xsl:value-of select=&quot;tns:id&quot;/>&lt;/tns:id>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:numeroFisso&quot;>&lt;tns:numeroFisso>&lt;xsl:value-of select=&quot;tns:numeroFisso&quot;/>&lt;/tns:numeroFisso>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:numeroMobile&quot;>&lt;tns:numeroMobile>&lt;xsl:value-of select=&quot;tns:numeroMobile&quot;/>&lt;/tns:numeroMobile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cognome&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codFiscale&quot;>&lt;tns:codFiscale>&lt;xsl:value-of select=&quot;tns:codFiscale&quot;/>&lt;/tns:codFiscale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:pIva&quot;>&lt;tns:pIva>&lt;xsl:value-of select=&quot;tns:pIva&quot;/>&lt;/tns:pIva>&lt;/xsl:if>&lt;/tns:numeriReferenti>&lt;/xsl:for-each>&lt;/tns:referentiTokenizzati>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputTokenizzazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
