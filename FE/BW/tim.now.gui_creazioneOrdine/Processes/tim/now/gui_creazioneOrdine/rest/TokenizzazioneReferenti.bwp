    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>post</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
            </endingVariables>
        </task>
        <task name="TokenizzazioneReferenti_InLog">
            <endingVariables>
                <variable>TokenizzazioneReferenti_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="TokenizzazioneReferenti_InLog_INFO">
            <endingVariables>
                <variable>TokenizzazioneReferenti_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="CodiceIstatComune">
            <endingVariables>
                <variable>CodiceIstatComune-input</variable>
            </endingVariables>
        </task>
        <task name="VerificaRollout_NOWSecolo">
            <endingVariables>
                <variable>VerificaRollout_NOWSecolo-input</variable>
                <variable>CodiceIstatComune</variable>
                <variable>CodOloNumerico</variable>
                <variable>OffertaXML</variable>
                <variable>RecuperaCodComuneDin</variable>
                <variable>IstatDesospVariazione</variable>
                <variable>CodIstatAsset</variable>
