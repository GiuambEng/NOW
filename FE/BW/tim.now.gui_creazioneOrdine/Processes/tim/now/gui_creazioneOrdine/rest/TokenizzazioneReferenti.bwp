                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Tokenizzazione&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TokenFisso.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:numeriReferente>&#xa;            &lt;xsl:if test=&quot;string-length($TokenFisso.Output/tns1:N_Recap_Cliente)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$TokenFisso.Output/tns1:N_Recap_Cliente&quot;>&#xa;                    &lt;tns:numeroFisso>&#xa;                        &lt;xsl:value-of select=&quot;$TokenFisso.Output/tns1:N_Recap_Cliente&quot;/>&#xa;                    &lt;/tns:numeroFisso>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($TokenFisso.Output/tns1:N_Recap_Cliente_ALT)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$TokenFisso.Output/tns1:N_Recap_Cliente_ALT&quot;>&#xa;                    &lt;tns:numeroMobile>&#xa;                        &lt;xsl:value-of select=&quot;$TokenFisso.Output/tns1:N_Recap_Cliente_ALT&quot;/>&#xa;                    &lt;/tns:numeroMobile>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:numeriReferenti[$index]/tns:id&quot;>&#xa;                &lt;tns:id>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:numeriReferenti[$index]/tns:id&quot;/>&#xa;                &lt;/tns:id>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($TokenFisso.Output/tns1:Nome)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$TokenFisso.Output/tns1:Nome&quot;>&#xa;                    &lt;tns:nome>&#xa;                        &lt;xsl:value-of select=&quot;$TokenFisso.Output/tns1:Nome&quot;/>&#xa;                    &lt;/tns:nome>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($TokenFisso.Output/tns1:CognomeRagioneSociale)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$TokenFisso.Output/tns1:CognomeRagioneSociale&quot;>&#xa;                    &lt;tns:cognome>&#xa;                        &lt;xsl:value-of select=&quot;$TokenFisso.Output/tns1:CognomeRagioneSociale&quot;/>&#xa;                    &lt;/tns:cognome>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($TokenFisso.Output/tns1:CodiceFiscale)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$TokenFisso.Output/tns1:CodiceFiscale&quot;>&#xa;                    &lt;tns:codFiscale>&#xa;                        &lt;xsl:value-of select=&quot;$TokenFisso.Output/tns1:CodiceFiscale&quot;/>&#xa;                    &lt;/tns:codFiscale>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($TokenFisso.Output/tns1:PIVA)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$TokenFisso.Output/tns1:PIVA&quot;>&#xa;                    &lt;tns:pIva>&#xa;                        &lt;xsl:value-of select=&quot;$TokenFisso.Output/tns1:PIVA&quot;/>&#xa;                    &lt;/tns:pIva>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:numeriReferente>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
