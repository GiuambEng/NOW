>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                    &lt;tns:nome>&#xa;                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                    &lt;/tns:nome>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                                    &lt;tns:cognome>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                    &lt;/tns:cognome>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:codFiscale&quot;>&#xa;                                    &lt;tns:codFiscale>&#xa;                                        &lt;xsl:value-of select=&quot;tns:codFiscale&quot;/>&#xa;                                    &lt;/tns:codFiscale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:pIva&quot;>&#xa;                                    &lt;tns:pIva>&#xa;                                        &lt;xsl:value-of select=&quot;tns:pIva&quot;/>&#xa;                                    &lt;/tns:pIva>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:numeriReferenti>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns:referentiTokenizzati>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;      