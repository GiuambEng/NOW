&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20201008103413PLT" xmlns:tns1="http://www.example.org/Tokenizzazione" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="post"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:postResponse&gt;&lt;item&gt;&lt;tns1:outputTokenizzazione&gt;&lt;tns1:referentiTokenizzati&gt;&lt;tns1:esito&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:esito&gt;&lt;xsl:for-each select="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti"&gt;&lt;tns1:numeriReferenti&gt;&lt;xsl:if test="tns1:id"&gt;&lt;tns1:id&gt;&lt;xsl:value-of select="tns1:id"/&gt;&lt;/tns1:id&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:numeroFisso"&gt;&lt;tns1:numeroFisso&gt;&lt;xsl:value-of select="tns1:numeroFisso"/&gt;&lt;/tns1:numeroFisso&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:numeroMobile"&gt;&lt;tns1:numeroMobile&gt;&lt;xsl:value-of select="tns1:numeroMobile"/&gt;&lt;/tns1:numeroMobile&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:nome"&gt;&lt;tns1:nome&gt;&lt;xsl:value-of select="tns1:nome"/&gt;&lt;/tns1:nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:cognome"&gt;&lt;tns1:cognome&gt;&lt;xsl:value-of select="tns1:cognome"/&gt;&lt;/tns1:cognome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:codFiscale"&gt;&lt;tns1:codFiscale&gt;&lt;xsl:value-of select="tns1:codFiscale"/&gt;&lt;/tns1:codFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:pIva"&gt;&lt;tns1:pIva&gt;&lt;xsl:value-of select="tns1:pIva"/&gt;&lt;/tns1:pIva&gt;&lt;/xsl:if&gt;&lt;/tns1:numeriReferenti&gt;&lt;/xsl:for-each&gt;&lt;/tns1:referentiTokenizzati&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/tns1:code&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/tns1:details&gt;&lt;/tns1:result&gt;&lt;/tns1:outputTokenizzazione&gt;&lt;/item&gt;&lt;/t