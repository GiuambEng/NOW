                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($index<=count($post.item/tns:numeriReferenti/tns:id)) and ($esitoOK = true())]]></bpws:condition>
                                    <bpws:flow name="flow2">
