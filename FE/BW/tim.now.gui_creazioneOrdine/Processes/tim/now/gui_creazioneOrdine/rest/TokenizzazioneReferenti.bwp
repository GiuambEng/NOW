                                    inputVariable="TokenFisso-input"
                                    name="TokenFisso"
                                    operation="Create_token_NOWSecolo"
                                    outputVariable="TokenFisso"
                                    partnerLink="NOW_SECOLOPortType"
                                    portType="ns5:NOW_SECOLOPortType" tibex:xpdlId="eb588dde-306e-4ce7-9ed6-4129c632e5db">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/NOW_SECOLO/" xmlns:tns1="http://www.example.org/Tokenizzazione" xmlns:tns2="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="post"/&gt;&lt;xsl:param name="VerificaRollout_NOWSecolo"/&gt;&lt;xsl:template name="TokenFisso-input" match="/"&gt;&lt;tns:Create_token_NOWSecoloRequest&gt;&lt;Input&gt;&lt;tns2:RequestCreate_token&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:codOloAgcom"&gt;&lt;tns2:CodificaOLOAGCOM&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:codOloAgcom"/&gt;&lt;/tns2:CodificaOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo"&gt;&lt;tns2:CodiceOrdineOLO&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo"/&gt;&lt;/tns2:CodiceOrdineOLO&gt;&lt;/xsl:if&gt;&lt;tns2:Funzione&gt;&lt;xsl:value-of select="&amp;quot;ACQGUI&amp;quot;"/&gt;&lt;/tns2:Funzione&gt;&lt;tns2:ChiaveRiferimento&gt;&lt;xsl:value-of select="concat($post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))"/&gt;&lt;/tns2:ChiaveRiferimento&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($post/item/tns1:inputTokenizzazione/tns1:operatore)&gt;0"&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:operatore"&gt;&lt;tns2:Operatore&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:operatore"/&gt;&lt;/tns2:Operatore&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:Operatore&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns2:Operatore&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($post/item/tns1:inputTokenizzazione/tns1:IPClient)&gt;0"&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:IPClient"&gt;&lt;tns2:IPClient&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:IPClient"/&gt;&lt;/tns2:IPClient&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IPClient&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns2:IPClient&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:numeroFisso"&gt;&lt;tns2:N_Recap_Cliente&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:numeroFisso"/&gt;&lt;/tns2:N_Recap_Cliente&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:numeroMobile"&gt;&lt;tns2:N_Recap_Cliente_ALT&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:numeroMobile"/&gt;&lt;/tns2:N_Recap_Cliente_ALT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:nome"&gt;&lt;tns2:Nome&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:nome"/&gt;&lt;/tns2:Nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:cognome"&gt;&lt;tns2:CognomeRagioneSociale&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:cognome"/&gt;&lt;/tns2:CognomeRagioneSociale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:codFiscale"&gt;&lt;tns2:CodiceFiscale&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:codFiscale"/&gt;&lt;/tns2:CodiceFiscale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:pIva"&gt;&lt;tns2:PIVA&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[$index]/tns1:pIva"/&gt;&lt;/tns2:PIVA&