            </endingVariables>
        </task>
        <task name="Mapper">
            <endingVariables>
                <variable>Mapper-input</variable>
            </endingVariables>
        </task>
        <task name="Assign2">
            <endingVariables>
                <variable>Accumulate</variable>
            </endingVariables>
        </task>
        <task name="TokenizzazioneReferenti_outp_Log">
            <endingVariables>
                <variable>TokenizzazioneReferenti_outp_Log-input</variable>
                <variable>LoggerInfo</variable>
                <variable>TokenizzazioneRichieste</variable>
                <variable>DatiRolloutDesosp</variable>
                <variable>VerificaRollout_NOWSecolo</variable>
