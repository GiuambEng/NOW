lect=&quot;$post/item/tns1:inputTokenizzazione/tns1:indirizzoClienteFinale/tns1:indirizzo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/indirizzo>&lt;civico>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:inputTokenizzazione/tns1:indirizzoClienteFinale/tns1:civico)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:inputTokenizzazione/tns1:indirizzoClienteFinale/tns1:civico&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/civico>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CodiceIstatComune-input"
