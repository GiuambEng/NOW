                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($post.item/tns:numeriReferenti[$index]/tns:numeroFisso)>0 or string-length($post.item/tns:numeriReferenti[$index]/tns:numeroMobile)>0 or string-length($post.item/tns:numeriReferenti[$index]/tns:cognome)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty4ToAccumulate">
                                    <tibex:DesignExpression>

                                    <tibex:expression
