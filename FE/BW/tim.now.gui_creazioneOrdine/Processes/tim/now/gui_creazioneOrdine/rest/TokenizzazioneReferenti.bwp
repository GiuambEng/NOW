                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Tokenizzazione&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TokenFisso&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:numeriReferente>&lt;xsl:if test=&quot;string-length($TokenFisso/Output/tns1:ResponseCreate_token/tns1:N_Recap_Cliente)>0&quot;>&lt;xsl:if test=&quot;$TokenFisso/Output/tns1:ResponseCreate_token/tns1:N_Recap_Cliente&quot;>&lt;tns:numeroFisso>&lt;xsl:value-of select=&quot;$TokenFisso/Output/tns1:ResponseCreate_token/tns1:N_Recap_Cliente&quot;/>&lt;/tns:numeroFisso>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($TokenFisso/Output/tns1:ResponseCreate_token/tns1:N_Recap_Cliente_ALT)>0&quot;>&lt;xsl:if test=&quot;$TokenFisso/Output/tns1:ResponseCreate_token/tns1:N_Recap_Cliente_ALT&quot;>&lt;tns:numeroMobile>&lt;xsl:value-of select=&quot;$TokenFisso/Output/tns1:ResponseCreate_token/tns1:N_Recap_Cliente_ALT&quot;/>&lt;/tns:numeroMobile>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:inputTokenizzazione/tns:numeriReferenti[$index]/tns:id&quot;>&lt;tns:id>&lt;xsl:value-of select=&quot;$post/item/tns:inputTokenizzazione/tns:numeriReferenti[$index]/tns:id&quot;/>&lt;/tns:id>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($TokenFisso/Output/tns1:ResponseCreate_token/tns1:Nome)>0&quot;>&lt;xsl:if test=&quot;$TokenFisso/Output/tns1:ResponseCreate_token/tns1:Nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;$TokenFisso/Output/tns1:ResponseCreate_token/tns1:Nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($TokenFisso/Output/tns1:ResponseCreate_token/tns1:CognomeRagioneSociale)>0&quot;>&lt;xsl:if