                                partnerLink="NOW_SECOLO_RolloutServicePortType"
                                portType="ns4:NOW_SECOLO_RolloutServicePortType" tibex:xpdlId="120fffe9-ffa5-4158-9706-4fc129873ce7">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/NOW_SECOLO_ROLLOUT/" xmlns:tns1="http://www.example.org/Tokenizzazione" xmlns:tns2="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/" version="2.0"&gt;&lt;xsl:param name="post"/&gt;&lt;xsl:param name="CodiceIstatComune"/&gt;&lt;xsl:param name="CodOloNumerico"/&gt;&lt;xsl:param name="RecuperaCodComuneDin"/&gt;&lt;xsl:param name="OffertaXML"/&gt;&lt;xsl:param name="offertaRollout"/&gt;&lt;xsl:param name="DatiRolloutDesosp"/&gt;&lt;xsl:param name="IstatDesospVariazione"/&gt;&lt;xsl:param name="CodIstatAsset"/&gt;&lt;xsl:template name="VerificaRollout_NOWSecolo-input" match="/"&gt;&lt;tns:VerificaRollout_NOWSecoloRequest&gt;&lt;Input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="upper-case($post/item/tns1:inputTokenizzazione/tns1:lavorazione)=('DESOSPENSIONE','RIMODULAZIONEDAD')"&gt;&lt;tns2:RequestVerificaRollout&gt;&lt;xsl:if test="$DatiRolloutDesosp/Record[1]/CODIFICAOLOAGCOM"&gt;&lt;tns2:CodificaOLOAGCOM&gt;&lt;xsl:value-of select="$DatiRolloutDesosp/Record[1]/CODIFICAOLOAGCOM"/&gt;&lt;/tns2:CodificaOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CodOloNumerico/Record[1]/COD_OLO"&gt;&lt;tns2:CodificaOloNumerico&gt;&lt;xsl:value-of select="$CodOloNumerico/Record[1]/COD_OLO"/&gt;&lt;/tns2:CodificaOloNumerico&gt;&lt;/xsl:if&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="upper-case($DatiRolloutDesosp/Record[1]/OFFERTA)"/&gt;&lt;/tns2:Offerta&gt;&lt;tns2:Lavorazione&gt;&lt;xsl:value-of select="upper-case($DatiRolloutDesosp/Record[1]/LAVORAZIONE)"/&gt;&lt;/tns2:Lavorazione&gt;&lt;xsl:choose&gt;&lt;xsl:when test="((string-length($DatiRolloutDesosp/Record[1]/LAVORAZIONE) &gt; 0) and ($DatiRolloutDesosp/Record[1]/LAVORAZIONE = 'VARIAZIONE')) and $post/item/tns1:inputTokenizzazione/tns1:lavorazione = ('DESOSPENSIONE','RIMODULAZIONEDAD')"&gt;&lt;xsl:if test="$IstatDesospVariazione/Record[1]/CODICEISTATCOMUNE"&gt;&lt;tns2:CodiceIstatComune&gt;&lt;xsl:value-of select="$IstatDesospVariazione/Record[1]/CODICEISTATCOMUNE"/&gt;&lt;/tns2:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($DatiRolloutDesosp/Record[1]/ISTATCOMUNE) = 0 and string-length($DatiRolloutDesosp/Record[1]/NUMEROTELEFONICO)&gt;0"&gt;&lt;xsl:if test="$RecuperaCodComuneDin/Record[1]/CODICEISTATCOMUNE"&gt;&lt;tns2:CodiceIstatComune&gt;&lt;xsl:value-of select="$RecuperaCodComuneDin/Record[1]/CODICEISTATCOMUNE"/&gt;&lt;/tns2:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($DatiRolloutDesosp/Record[1]/ISTATCOMUNE) = 0"&gt;&lt;xsl:if test="$CodIstatAsset/Record[1]/CODICEISTATCOMUNE"&gt;&lt;tns2:CodiceIstatComune&gt;&lt;xsl:value-of select="$CodIstatAsset/Record[1]/CODICEISTATCOMUNE"/&gt;&lt;/tns2:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$DatiRolloutDesosp/Record[1]/ISTATCOMUNE"&gt;&lt;tns2:CodiceIstatComune&gt;&lt;xsl:value-of select="$DatiRolloutDesosp/Record[1]/ISTATCOMUNE"/&gt;&lt;/tns2:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[tns1:id=&amp;quot;-1&amp;quot;]/tns1:id)&gt;0"&gt;&lt;tns2:FlagReferente&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns2:FlagReferente&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FlagReferente&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/tns2:FlagReferente&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[tns1:id=&amp;quot;-1&amp;quot;]/tns1:id)&gt;0"&gt;&lt;tns2:FlagClienteFinale&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/tns2:FlagClienteFinale&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FlagClienteFinale&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns2:FlagClienteFinale&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo"&gt;&lt;tns2:CodiceOrdineOLO&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo"/&gt;&lt;/tns2:CodiceOrdineOLO&gt;&lt;/xsl:if&gt;&lt;/tns2:RequestVerificaRollout&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:RequestVerificaRollout&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:codOloAgcom"&gt;&lt;tns2:CodificaOLOAGCOM&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:codOloAgcom"/&gt;&lt;/tns2:CodificaOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CodOloNumerico/Record[1]/COD_OLO"&gt;&lt;tns2:CodificaOloNumerico&gt;&lt;xsl:value-of select="$CodOloNumerico/Record[1]/COD_OLO"/&gt;&lt;/tns2:CodificaOloNumerico&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="upper-case($post/item/tns1:inputTokenizzazione/tns1:lavorazione) = ('CESSAZIONE','MIGRAZIONE','VARIAZIONE')"&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="upper-case($offertaRollout)"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$post/item/tns1:inputTokenizzazione/tns1:idOfferta = '7'"&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$post/item/tns1:inputTokenizzazione/tns1:idOfferta = '22'"&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="&amp;quot;WLRLINEANONATTIVA&amp;quot;"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$post/item/tns1:inputTokenizzazione/tns1:idOfferta = '25'"&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="&amp;quot;WLRLINEAATTIVA&amp;quot;"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$post/item/tns1:inputTokenizzazione/tns1:idOfferta = '27'"&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="'ULLLINEAATTIVANP'"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$post/item/tns1:inputTokenizzazione/tns1:idOfferta = '28'"&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="'ULLDATILINEAATTIVANP'"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$post/item/tns1:inputTokenizzazione/tns1:idOfferta = '29'"&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="&amp;quot;SLULINEAATTIVANP&amp;quot;"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$post/item/tns1:inputTokenizzazione/tns1:idOfferta = '41'"&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="&amp;quot;BITSTREAMGBESIMMETRICOFLAT&amp;quot;"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="upper-case($OffertaXML/Record[1]/NOME_OFFERTA_ESTERNA)"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns2:Lavorazione&gt;&lt;xsl:value-of select="upper-case($post/item/tns1:inputTokenizzazione/tns1:lavorazione)"/&gt;&lt;/tns2:Lavorazione&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($post/item/tns1:inputTokenizzazione/tns1:codIstatComune) = 0 and string-length($post/item/tns1:inputTokenizzazione/tns1:indirizzoClienteFinale/tns1:comune) = 0"&gt;&lt;xsl:if test="$RecuperaCodComuneDin/Record[1]/CODICEISTATCOMUNE"&gt;&lt;tns2:CodiceIstatComune&gt;&lt;xsl:value-of select="$RecuperaCodComuneDin/Record[1]/CODICEISTATCOMUNE"/&gt;&lt;/tns2:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($post/item/tns1:inputTokenizzazione/tns1:indirizzoClienteFinale/tns1:comune)&gt;0 or upper-case($post/item/tns1:inputTokenizzazione/tns1:lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;"&gt;&lt;xsl:if test="$CodiceIstatComune/Record[1]/COD_ISTAT_COMUNE"&gt;&lt;tns2:CodiceIstatComune&gt;&lt;xsl:value-of select="$CodiceIstatComune/Record[1]/COD_ISTAT_COMUNE"/&gt;&lt;/tns2:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:codIstatComune"&gt;&lt;tns2:CodiceIstatComune&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:codIstatComune"/&gt;&lt;/tns2:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[tns1:id=&amp;quot;-1&amp;quot;]/tns1:id)&gt;0"&gt;&lt;tns2:FlagReferente&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns2:FlagReferente&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FlagReferente&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/tns2:FlagReferente&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($post/item/tns1:inputTokenizzazione/tns1:numeriReferenti[tns1:id=&amp;quot;-1&amp;quot;]/tns1:id)&gt;0"&gt;&lt;tns2:FlagClienteFinale&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/tns2:FlagClienteFinale&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FlagClienteFinale&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns2:FlagClienteFinale&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo"&gt;&lt;tns2:CodiceOrdineOLO&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo"/&gt;&lt;/tns2:CodiceOrdineOLO&gt;&lt;/xsl:if&gt;&lt;/tns2:RequestVerificaRollout&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/Input&gt;&lt;/tns:VerificaRollout_NOWSecoloRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/NOW_SECOLO_ROLLOUT/&quot; xmlns:tns1=&quot;http://www.example.org/Tokenizzazione&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceIstatComune&quot;/>&#xa;    &lt;xsl:param name=&quot;CodOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaCodComuneDin&quot;/>&#xa;    &lt;xsl:param name=&quot;OffertaXML&quot;/>&#xa;    &lt;xsl:param name=&quot;offertaRollout&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiRolloutDesosp&quot;/>&#xa;    &lt;xsl:param name=&quot;IstatDesospVariazione&quot;/>&#xa;    &lt;xsl:param name=&quot;CodIstatAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaRollout_NOWSecolo-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;upper-case($post.item/tns1:lavorazione)=('DESOSPENSIONE','RIMODULAZIONEDAD')&quot;>&#xa;                &lt;tns2:RequestVerificaRollout>&#xa;                    &lt;xsl:if test=&quot;$DatiRolloutDesosp/Record[1]/CODIFICAOLOAGCOM&quot;>&#xa;                        &lt;tns2:CodificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$DatiRolloutDesosp/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                        &lt;/tns2:CodificaOLOAGCOM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CodOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                        &lt;tns2:CodificaOloNumerico>&#xa;                            &lt;xsl:value-of select=&quot;$CodOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/tns2:CodificaOloNumerico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($DatiRolloutDesosp/Record[1]/OFFERTA)&quot;/>&#xa;                    &lt;/tns2:Offerta>&#xa;                    &lt;tns2:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($DatiRolloutDesosp/Record[1]/LAVORAZIONE)&quot;/>&#xa;                    &lt;/tns2:Lavorazione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;((string-length($DatiRolloutDesosp/Record[1]/LAVORAZIONE) > 0) and ($DatiRolloutDesosp/Record[1]/LAVORAZIONE = 'VARIAZIONE')) and $post.item/tns1:lavorazione = ('DESOSPENSIONE','RIMODULAZIONEDAD')&quot;>&#xa;                            &lt;xsl:if test=&quot;$IstatDesospVariazione/Record[1]/CODICEISTATCOMUNE&quot;>&#xa;                                &lt;tns2:CodiceIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;$IstatDesospVariazione/Record[1]/CODICEISTATCOMUNE&quot;/>&#xa;                                &lt;/tns2:CodiceIstatComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($DatiRolloutDesosp/Record[1]/ISTATCOMUNE) = 0 and string-length($DatiRolloutDesosp/Record[1]/NUMEROTELEFONICO)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$RecuperaCodComuneDin/Record[1]/CODICEISTATCOMUNE&quot;>&#xa;                                &lt;tns2:CodiceIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;$RecuperaCodComuneDin/Record[1]/CODICEISTATCOMUNE&quot;/>&#xa;                                &lt;/tns2:CodiceIstatComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($DatiRolloutDesosp/Record[1]/ISTATCOMUNE) = 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$CodIstatAsset/Record[1]/CODICEISTATCOMUNE&quot;>&#xa;                                &lt;tns2:CodiceIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;$CodIstatAsset/Record[1]/CODICEISTATCOMUNE&quot;/>&#xa;                                &lt;/tns2:CodiceIstatComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$DatiRolloutDesosp/Record[1]/ISTATCOMUNE&quot;>&#xa;                                &lt;tns2:CodiceIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;$DatiRolloutDesosp/Record[1]/ISTATCOMUNE&quot;/>&#xa;                                &lt;/tns2:CodiceIstatComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($post.item/tns1:numeriReferenti[tns1:id=&amp;quot;-1&amp;quot;]/tns1:id)>0&quot;>&#xa;                            &lt;tns2:FlagReferente>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns2:FlagReferente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:FlagReferente>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns2:FlagReferente>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($post.item/tns1:numeriReferenti[tns1:id=&amp;quot;-1&amp;quot;]/tns1:id)>0&quot;>&#xa;                            &lt;tns2:FlagClienteFinale>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns2:FlagClienteFinale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:FlagClienteFinale>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns2:FlagClienteFinale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:codOrdineOlo&quot;>&#xa;                        &lt;tns2:CodiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:codOrdineOlo&quot;/>&#xa;                        &lt;/tns2:CodiceOrdineOLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:RequestVerificaRollout>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:RequestVerificaRollout>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:codOloAgcom&quot;>&#xa;                        &lt;tns2:CodificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:codOloAgcom&quot;/>&#xa;                        &lt;/tns2:CodificaOLOAGCOM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CodOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                        &lt;tns2:CodificaOloNumerico>&#xa;                            &lt;xsl:value-of select=&quot;$CodOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/tns2:CodificaOloNumerico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post.item/tns1:lavorazione) = ('CESSAZIONE','MIGRAZIONE','VARIAZIONE')&quot;>&#xa;                            &lt;tns2:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($offertaRollout)&quot;/>&#xa;                            &lt;/tns2:Offerta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns1:idOfferta = '7'&quot;>&#xa;                            &lt;tns2:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Offerta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns1:idOfferta = '22'&quot;>&#xa;                            &lt;tns2:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;WLRLINEANONATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Offerta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns1:idOfferta = '25'&quot;>&#xa;                            &lt;tns2:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;WLRLINEAATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Offerta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns1:idOfferta = '27'&quot;>&#xa;                            &lt;tns2:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;'ULLLINEAATTIVANP'&quot;/>&#xa;                            &lt;/tns2:Offerta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns1:idOfferta = '28'&quot;>&#xa;                            &lt;tns2:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;'ULLDATILINEAATTIVANP'&quot;/>&#xa;                            &lt;/tns2:Offerta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns1:idOfferta = '29'&quot;>&#xa;                            &lt;tns2:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;SLULINEAATTIVANP&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Offerta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$post.item/tns1:idOfferta = '41'&quot;>&#xa;                            &lt;tns2:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBESIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Offerta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($OffertaXML/Record[1]/NOME_OFFERTA_ESTERNA)&quot;/>&#xa;                            &lt;/tns2:Offerta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns2:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($post.item/tns1:lavorazione)&quot;/>&#xa;                    &lt;/tns2:Lavorazione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($post.item/tns1:codIstatComune) = 0 and string-length($post.item/tns1:indirizzoClienteFinale/tns1:comune) = 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$RecuperaCodComuneDin/Record[1]/CODICEISTATCOMUNE&quot;>&#xa;                                &lt;tns2:CodiceIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;$RecuperaCodComuneDin/Record[1]/CODICEISTATCOMUNE&quot;/>&#xa;                                &lt;/tns2:CodiceIstatComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($post.item/tns1:indirizzoClienteFinale/tns1:comune)>0 or upper-case($post.item/tns1:lavorazione) = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:if test=&quot;$CodiceIstatComune/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                                &lt;tns2:CodiceIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;$CodiceIstatComune/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                &lt;/tns2:CodiceIstatComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$post.item/tns1:codIstatComune&quot;>&#xa;                                &lt;tns2:CodiceIstatComune>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns1:codIstatComune&quot;/>&#xa;                                &lt;/tns2:CodiceIstatComune>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($post.item/tns1:numeriReferenti[tns1:id=&amp;quot;-1&amp;quot;]/tns1:id)>0&quot;>&#xa;                            &lt;tns2:FlagReferente>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns2:FlagReferente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:FlagReferente>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns2:FlagReferente>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($post.item/tns1:numeriReferenti[tns1:id=&amp;quot;-1&amp;quot;]/tns1:id)>0&quot;>&#xa;                            &lt;tns2:FlagClienteFinale>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns2:FlagClienteFinale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:FlagClienteFinale>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns2:FlagClienteFinale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:codOrdineOlo&quot;>&#xa;                        &lt;tns2:CodiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:codOrdineOlo&quot;/>&#xa;                        &lt;/tns2:CodiceOrdineOLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:RequestVerificaRollout>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="Assign3ToVerificaRollout_NOWSecolo"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="VerificaRollout_RolloutKO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaRollout_NOWSecolo/Output/tns1:ResponseVerificaRollout/tns1:ESITO = &quot;KO&quot; or $VerificaRollout_NOWSecolo/Output/tns1:ResponseVerificaRollout/tns1:TOKENIZZAZIONE_RECAPITI =&quot;NO&quot; or ($post/item/tns:inputTokenizzazione/tns:numeriReferenti[1]/tns:id =&quot;-1&quot; and $VerificaRollout_NOWSecolo/Output/tns1:ResponseVerificaRollout/tns1:TOKENIZZAZIONE = 'C2PLUS')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$VerificaRollout_NOWSecolo.Output/tns1:ESITO = "KO" or $VerificaRollout_NOWSecolo.Output/tns1:TOKENIZZAZIONE_RECAPITI ="NO" or ($post.item/tns:numeriReferenti[1]/tns:id ="-1" and $VerificaRollout_NOWSecolo.Output/tns1:TOKENIZZAZIONE = 'C2PLUS')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VerificaRollout_NOWSecoloToIterate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Tokenizzazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns:outputTokenizzazione>&lt;tns:referentiTokenizzati>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;xsl:for-each select=&quot;$post/item/tns:inputTokenizzazione/tns:numeriReferenti&quot;>&lt;tns:numeriReferenti>&lt;xsl:if test=&quot;tns:id&quot;>&lt;tns:id>&lt;xsl:value-of select=&quot;tns:id&quot;/>&lt;/tns:id>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:numeroFisso&quot;>&lt;tns:numeroFisso>&lt;xsl:value-of select=&quot;tns:numeroFisso&quot;/>&lt;/tns:numeroFisso>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:numeroMobile&quot;>&lt;tns:numeroMobile>&lt;xsl:value-of select=&quot;tns:numeroMobile&quot;/>&lt;/tns:numeroMobile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:cognome&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codFiscale&quot;>&lt;tns:codFiscale>&lt;xsl:value-of select=&quot;tns:codFiscale&quot;/>&lt;/tns:codFiscale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:pIva&quot;>&lt;tns:pIva>&lt;xsl:value-of select=&quot;tns:pIva&quot;/>&lt;/tns:pIva>&lt;/xsl:if>&lt;/tns:numeriReferenti>&lt;/xsl:for-each>&lt;/tns:referentiTokenizzati>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Rollout con esito KO&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputTokenizzazione>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Variable"
                                    name="Assign"
                                    outputVariable="Variable"
                                    tibex:xpdlId="2fb4cd2c-b838-452d-baeb-ac2269325ac8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaRollout_RolloutKO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Tokenizzazione&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;tns:outputTokenizzazione>&#xa;            &lt;tns:referentiTokenizzati>&#xa;                &lt;tns:esito>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                &lt;/tns:esito>&#xa;                &lt;xsl:for-each select=&quot;$post.item/tns:numeriReferenti&quot;>&#xa;                    &lt;tns:numeriReferenti>&#xa;                        &lt;xsl:if test=&quot;tns:id&quot;>&#xa;                            &lt;tns:id>&#xa;                                &lt;xsl:value-of select=&quot;tns:id&quot;/>&#xa;                            &lt;/tns:id>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:numeroFisso&quot;>&#xa;                            &lt;tns:numeroFisso>&#xa;                                &lt;xsl:value-of select=&quot;tns:numeroFisso&quot;/>&#xa;                            &lt;/tns:numeroFisso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:numeroMobile&quot;>&#xa;                            &lt;tns:numeroMobile>&#xa;                                &lt;xsl:value-of select=&quot;tns:numeroMobile&quot;/>&#xa;                            &lt;/tns:numeroMobile>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                            &lt;tns:cognome>&#xa;                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                            &lt;/tns:cognome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:codFiscale&quot;>&#xa;                            &lt;tns:codFiscale>&#xa;                                &lt;xsl:value-of select=&quot;tns:codFiscale&quot;/>&#xa;                            &lt;/tns:codFiscale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:pIva&quot;>&#xa;                            &lt;tns:pIva>&#xa;                                &lt;xsl:value-of select=&quot;tns:pIva&quot;/>&#xa;                            &lt;/tns:pIva>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:numeriReferenti>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns:referentiTokenizzati>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/tns:code>&#xa;                &lt;tns:details>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Rollout con esito KO&amp;quot;&quot;/>&#xa;                &lt;/tns:details>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:outputTokenizzazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
