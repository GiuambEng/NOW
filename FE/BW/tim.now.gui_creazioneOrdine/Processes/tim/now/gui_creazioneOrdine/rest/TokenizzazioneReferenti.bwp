                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/NOW_SECOLO/&quot; xmlns:tns1=&quot;http://www.example.org/Tokenizzazione&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaRollout_NOWSecolo.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;TokenFisso-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RequestCreate_token>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:codOloAgcom&quot;>&#xa;                &lt;tns2:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:codOloAgcom&quot;/>&#xa;                &lt;/tns2:CodificaOLOAGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:codOrdineOlo&quot;>&#xa;                &lt;tns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:codOrdineOlo&quot;/>&#xa;                &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:Funzione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ACQGUI&amp;quot;&quot;/>&#xa;            &lt;/tns2:Funzione>&#xa;            &lt;tns2:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat($post.item/tns1:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns2:ChiaveRiferimento>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:operatore)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:operatore&quot;>&#xa;                        &lt;tns2:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:operatore&quot;/>&#xa;                        &lt;/tns2:Operatore>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:Operatore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:IPClient)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:IPClient&quot;>&#xa;                        &lt;tns2:IPClient>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:IPClient&quot;/>&#xa;                        &lt;/tns2:IPClient>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:IPClient>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:numeroFisso&quot;>&#xa;                &lt;tns2:N_Recap_Cliente>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:numeroFisso&quot;/>&#xa;                &lt;/tns2:N_Recap_Cliente>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:numeroMobile&quot;>&#xa;                &lt;tns2:N_Recap_Cliente_ALT>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:numeroMobile&quot;/>&#xa;                &lt;/tns2:N_Recap_Cliente_ALT>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:nome&quot;>&#xa;                &lt;tns2:Nome>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:nome&quot;/>&#xa;                &lt;/tns2:Nome>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:cognome&quot;>&#xa;                &lt;tns2:CognomeRagioneSociale>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:cognome&quot;/>&#xa;                &lt;/tns2:CognomeRagioneSociale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:codFiscale&quot;>&#xa;                &lt;tns2:CodiceFiscale>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:codFiscale&quot;/>&#xa;                &lt;/tns2:CodiceFiscale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:pIva&quot;>&#xa;                &lt;tns2:PIVA>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:numeriReferenti[$index]/tns1:pIva&quot;/>&#xa;                &lt;/tns2:PIVA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaRollout_NOWSecolo.Output/tns3:TOKENIZZAZIONE&quot;>&#xa;                &lt;tns2:TOKENIZZAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecolo.Output/tns3:TOKENIZZAZIONE&quot;/>&#xa;                &lt;/tns2:TOKENIZZAZIONE>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:RequestCreate_token>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
