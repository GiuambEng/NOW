                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.example.org/OrdiniNPNG&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post2&quot;/>&lt;xsl:param name=&quot;RecuperoOloNum&quot;/>&lt;xsl:param name=&quot;DRO&quot;/>&lt;xsl:param name=&quot;ADD8DRO&quot;/>&lt;xsl:param name=&quot;SeqCodOrdine&quot;/>&lt;xsl:template name=&quot;RichiestaBPM&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;'abc'&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:olo = 'TLC'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPNG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:dn&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:dn&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:olo&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;concat('Vco-',$post2/item/tns:inputCambioOloNPNG/tns:dn,'-',string($SeqCodOrdine/Record[1]/NEXTVAL))&quot;/>&lt;/codiceOrdineOLO>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&lt;/dataInvioRichiesta>&lt;ordine>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;NPNG&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;DAC>&lt;xsl:value-of select=&quot;$ADD8DRO/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DAC>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOloNum/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;concat('Vco-',$post2/item/tns:inputCambioOloNPNG/tns:dn,'-',string($SeqCodOrdine/Record[1]/NEXTVAL))&quot;/>&lt;/codiceOrdineOLO>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:olo&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:dn&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:dn&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;'abc'&quot;/>&lt;/IDRichiestaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:olo = 'TLC'&quot;>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&lt;/tipologiaLavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&lt;/tipologiaLavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;'CAMBIOOLO'&quot;/>&lt;/tipologiaSottolav>&lt;xsl:if test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:operatore&quot;>&lt;operatore>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:operatore&quot;/>&lt;/operatore>&lt;/xsl:if>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;dettaglioordine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:dn&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:dn&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;nomeComponente>&lt;xsl:value-of select=&quot;'ACCESSONPNG'&quot;/>&lt;/nomeComponente>&lt;integrationID>&lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&lt;/integrationID>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:olo&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'CODIFICAOLOAGCOMDONATING'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:olo&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:olo&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'DATACUTOVER'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:dataCutOver&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:olo&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'ORACUTOVER'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;'00:00'&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;progressivo>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivo>&lt;/dettaglioordine>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&lt;/tipologiaAccesso>&lt;offerta>&lt;xsl:value-of select=&quot;'NPNG'&quot;/>&lt;/offerta>&lt;xsl:if test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:dn&quot;>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:dn&quot;/>&lt;/IDRisorsaNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:olo&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:olo&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/ordine>&lt;offerta>&lt;xsl:value-of select=&quot;'NPNG'&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date($DRO)&quot;/>&lt;/DRO>&lt;xsl:if test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:olo&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:olo&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;DAC>&lt;xsl:value-of select=&quot;$ADD8DRO/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DAC>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;'CAMBIOOLO'&quot;/>&lt;/tipologiaSottolav>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
