                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/TracciatoNPNG&quot; xmlns:tns=&quot;http://www.example.org/OrdiniNPNG&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post2.item&quot;/>&#xa;    &lt;xsl:template name=&quot;TrcciatoOloNPNG&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaNPNG>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;tns2:CambioOlo>&#xa;                    &lt;tns2:dataOrdine>&#xa;                        &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                    &lt;/tns2:dataOrdine>&#xa;                    &lt;xsl:if test=&quot;$post2.item/tns:dn&quot;>&#xa;                        &lt;tns2:dn>&#xa;                            &lt;xsl:value-of select=&quot;$post2.item/tns:dn&quot;/>&#xa;                        &lt;/tns2:dn>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post2.item/tns:nuovoOlo/tns:olo&quot;>&#xa;                        &lt;tns2:olo>&#xa;                            &lt;xsl:value-of select=&quot;$post2.item/tns:nuovoOlo/tns:olo&quot;/>&#xa;                        &lt;/tns2:olo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post2.item/tns:stato&quot;>&#xa;                        &lt;tns2:stato>&#xa;                            &lt;xsl:value-of select=&quot;$post2.item/tns:stato&quot;/>&#xa;                        &lt;/tns2:stato>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post2.item/tns:opzioneTraffico&quot;>&#xa;                        &lt;tns2:opzioneTraffico>&#xa;                            &lt;xsl:value-of select=&quot;$post2.item/tns:opzioneTraffico&quot;/>&#xa;                        &lt;/tns2:opzioneTraffico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if