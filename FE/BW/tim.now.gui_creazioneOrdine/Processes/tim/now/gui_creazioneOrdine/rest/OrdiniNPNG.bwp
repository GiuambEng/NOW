                                    <bpws:sources>
                                    <bpws:source linkName="InsertRichiesteToRepeatOnError"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+19960e42-c183-4531-b07d-3138ed11e005+input&quot; xmlns:tns=&quot;http://www.example.org/OrdiniNPNG&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/TracciatoNPNG&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post2.item&quot;/>&#xa;    &lt;xsl:param name=&quot;TrcciatoOloNPNG&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoSequence&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertRichieste-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;CODICE_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post2.item/tns:olo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post2.item/tns:olo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_OLO>&#xa;            &lt;AMBITO>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/AMBITO>&#xa;            &lt;ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoSequence/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/ID_RICHIESTA>&#xa;            &lt;CONTENUTO_XML_OLO>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($TrcciatoOloNPNG/tns2:Richiesta,false(),true())&quot;/>&#xa;            &lt;/CONTENUTO_XML_OLO>&#xa;            &lt;STATO>&#xa;                &lt;xsl:value-of select=&quot;'INELABORAZIONE'&quot;/>&#xa;            &lt;/STATO>&#xa;            &lt;XML_CASEDATA_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Mapper, true(), false())&quot;/>&#xa;            &lt;/XML_CASEDATA_RICHIESTA>&#xa;            &lt;TIMESTAMP_CREAZIONE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMESTAMP_CREAZIONE>&#xa;            &lt;STRUTTURA_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;'NPNG'&quot;/>&#xa;            &lt;/STRUTTURA_RICHIESTA>&#xa;            &lt;CANALE_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;'GUI'&quot;/>&#xa;            &lt;/CANALE_RICHIESTA>&#xa;            &lt;DN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post2.item/tns:dn)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post2.item/tns:dn&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DN>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO ACQUISIZIONE_RICHIESTE(CODICE_OLO,AMBITO,ID_RICHIESTA,CONTENUTO_XML_OLO,STATO,XML_CASEDATA_RICHIESTA,TIMESTAMP_CREAZIONE,STRUTTURARICHIESTA,CANALE_RICHIESTA,DN)&#xa;VALUES (?,?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="AMBITO"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_RICHIESTA"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_XML_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="XML_CASEDATA_RICHIESTA"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_CREAZIONE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURA_RICHIESTA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CANALE_RICHIESTA"/>

                                    <PreparedParameters
