                                portType="ns15:processManagement" tibex:xpdlId="70321990-dc46-4370-bfdb-a8c2f78614fb">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tibco.com/bx/2009/management/process/BxProcessManagementService_1.10.0" xmlns:ns0="http://www.tibco.com/bx/2009/management/processManagerType" xmlns:tns="http://www.example.org/OrdiniNPNG" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="post1"/&gt;
    &lt;xsl:param name="RichLavMan"/&gt;
    &lt;xsl:template name="createProcessInstance-input" match="/"&gt;
        &lt;tns2:createProcessInstanceRequest&gt;
            &lt;params&gt;
                &lt;ns0:createProcessInstanceInput&gt;
                    &lt;ns0:processQName&gt;
                        &lt;ns0:moduleName&gt;
                            &lt;xsl:value-of select="'/tim.NOW.bpm.BusinessService/Process Packages/tim.NOW.bpm.pageFlow.sendSignals.xpdl'"/&gt;
                        &lt;/ns0:moduleName&gt;
                        &lt;ns0:processName&gt;
                            &lt;xsl:value-of select="'SendSignalSbloccoNPNG'"/&gt;
                        &lt;/ns0:processName&gt;
                    &lt;/ns0:processQName&gt;
                    &lt;ns0:operationName&gt;
                        &lt;xsl:value-of select="'StartNPNG'"/&gt;
                    &lt;/ns0:operationName&gt;
                    &lt;ns0:options&gt;
                        &lt;ns0:priority&gt;
                            &lt;xsl:value-of select="310"/&gt;
                        &lt;/ns0:priority&gt;
                    &lt;/ns0:options&gt;
                    &lt;ns0:parameterMap&gt;
                        &lt;ns0:parameter&gt;
                            &lt;ns0:name&gt;
                                &lt;xsl:value-of select="'IDRichiestaOLO'"/&gt;
                            &lt;/ns0:name&gt;
                            &lt;ns0:value&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($post1/item/tns:inputLavorazioneManualeNPNG/tns:idRichiestaOloTarget)"&gt;
                                        &lt;xsl:value-of select="$post1/item/tns:inputLavorazioneManualeNPNG/tns:idRichiestaOloTarget"/&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/ns0:value&gt;
                        &lt;/ns0:parameter&gt;
                        &lt;ns0:parameter&gt;
                            &lt;ns0:name&gt;
                                &lt;xsl:value-of select="'DettOrdine'"/&gt;
                            &lt;/ns0:name&gt;
                            &lt;ns0:value&gt;
                                &lt;xsl:value-of select="tib:render-xml($RichLavMan,false(),true())"/&gt;
                            &lt;/ns0:value&gt;
                        &lt;/ns0:parameter&gt;
                        &lt;xsl:if test="string-length($post1/item/tns:inputLavorazioneManualeNPNG/tns:causaleRifiuto)&gt;0"&gt;
                            &lt;ns0:parameter&gt;
                                &lt;ns0:name&gt;
                                    &lt;xsl:value-of select="'IDAnagraficaCausale'"/&gt;
                                &lt;/ns0:name&gt;
                                &lt;ns0:value&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="exists($post1/item/tns:inputLavorazioneManualeNPNG/tns:causaleRifiuto)"&gt;
                                            &lt;xsl:value-of select="$post1/item/tns:inputLavorazioneManualeNPNG/tns:causaleRifiuto"/&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/ns0:value&gt;
                            &lt;/ns0:parameter&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns0:parameterMap&gt;
                &lt;/ns0:createProcessInstanceInput&gt;
            &lt;/params&gt;
        &lt;/tns2:createProcessInstanceRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/bx/2009/management/process/BxProcessManagementService_1.10.0&quot; xmlns:ns0=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:tns=&quot;http://www.example.org/OrdiniNPNG&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:param name=&quot;RichLavMan&quot;/>&#xa;    &lt;xsl:template name=&quot;createProcessInstance-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:createProcessInstanceInput>&#xa;            &lt;ns0:processQName>&#xa;                &lt;ns0:moduleName>&#xa;                    &lt;xsl:value-of select=&quot;'/tim.NOW.bpm.BusinessService/Process Packages/tim.NOW.bpm.pageFlow.sendSignals.xpdl'&quot;/>&#xa;                &lt;/ns0:moduleName>&#xa;                &lt;ns0:processName>&#xa;                    &lt;xsl:value-of select=&quot;'SendSignalSbloccoNPNG'&quot;/>&#xa;                &lt;/ns0:processName>&#xa;            &lt;/ns0:processQName>&#xa;            &lt;ns0:operationName>&#xa;                &lt;xsl:value-of select=&quot;'StartNPNG'&quot;/>&#xa;            &lt;/ns0:operationName>&#xa;            &lt;ns0:options>&#xa;                &lt;ns0:priority>&#xa;                    &lt;xsl:value-of select=&quot;310&quot;/>&#xa;                &lt;/ns0:priority>&#xa;            &lt;/ns0:options>&#xa;            &lt;ns0:parameterMap>&#xa;                &lt;ns0:parameter>&#xa;                    &lt;ns0:name>&#xa;                        &lt;xsl:value-of select=&quot;'IDRichiestaOLO'&quot;/>&#xa;                    &lt;/ns0:name>&#xa;                    &lt;ns0:value>&#xa;                        &lt;xsl:choose>&#xa;        