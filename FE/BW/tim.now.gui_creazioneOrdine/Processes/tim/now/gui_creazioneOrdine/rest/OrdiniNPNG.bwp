ccessivo>&lt;xsl:value-of select=&quot;'ESPLETATOKO'&quot;/>&lt;/tns:statoSuccessivo>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$DatiAttributi/Record[NOMEATTRIBUTO='ORACUTOVER']/VALOREATTRIBUTO&quot;>&lt;tns:oraCutOver>&lt;xsl:value-of select=&quot;$DatiAttributi/Record[NOMEATTRIBUTO='ORACUTOVER']/VALOREATTRIBUTO&quot;/>&lt;/tns:oraCutOver>&lt;/xsl:if>&lt;/tns:dettaglioOrdineNPNG>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputDettaglioOrdineNPNG>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
