                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:scope name="RepeatOnError"
                                tibex:group="repeatOnError" tibex:xpdlId="0bf6195b-2aab-4ab3-a3d1-661cefe68d68">
                                <bpws:targets>
                                    <bpws:target linkName="InsertRichiesteToRepeatOnError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="RepeatOnErrorToEmpty"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    <bpws:variable
                                    name="repeatOnError_success_flag"
                                    sca-bpel:internal="true" type="xsd:boolean"/>
                                    <bpws:variable name="FaultName6"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns0:FaultDetail"
                                    name="FaultDetails6" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:scope name="innerScope">
                                    <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails6" tibex:faultNameVar="FaultName6">
                                    <bpws:if name="if">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index>3" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index>3]]></bpws:condition>
                                    <bpws:rethrow
                                    name="Rethrow" tibex:xpdlId="9283c911-9eae-47c3-a6ec-6a53d02a6f74"/>
                                    <bpws:else>
                                    <bpws:assign
                                    name="Assign4" validate="no">
                                    <bpws:copy>

                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                    </bpws:if>
                                    </bpws:catchAll>
                                    </bpws:faultHandlers>
                                    <bpws:flow name="flow13">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStartToJDBCUpdate" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="GroupStartToJDBCUpdate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="JDBCUpdateToScope" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="JDBCUpdate1ToScope" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ScopeToGroupEnd" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart"
                                    tibex:group="groupStart" tibex:xpdlId="66f03f86-42b2-48d6-a776-49927c843950">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCUpdate">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToJDBCUpdate1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index =1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index =1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:assign name="GroupEnd"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="24f64cae-0b75-4e37-a041-a441a23ea250" validate="no">
                                    <bpws:targets>
                                    <bpws:target linkName="ScopeToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="JDBCUpdate-input"
