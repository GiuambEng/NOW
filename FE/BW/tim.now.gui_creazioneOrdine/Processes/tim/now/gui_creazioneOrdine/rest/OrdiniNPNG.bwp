         &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:noteAggiuntive&quot;>&#xa;                        &lt;tns2:noteAggiuntive>&#xa;                            &lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:noteAggiuntive&quot;/>&#xa;                        &lt;/tns2:noteAggiuntive>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post2/item/tns:inputCambioOloNPNG/tns:codiceProvisioning&quot;>&#xa;                        &lt;tns2:codiceProvisioning>&#xa;                            &lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:codiceProvisioning&quot;/>&#xa;                        &lt;/tns2:codiceProvisioning>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:nuovoOlo>&#xa;                        &lt;tns2:nuovoOlo>&#xa;                            &lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:olo&quot;/>&#xa;                        &lt;/tns2:nuovoOlo>&#xa;                        &lt;tns2:dataCutOver>&#xa;                            &lt;xsl:value-of select=&quot;$post2/item/tns:inputCambioOloNPNG/tns:nuovoOlo/tns:dataCutOver&quot;/>&#xa;                        &lt;/tns2:dataCutOver>&#xa;                        &lt;tns2:oraCutOver>&#xa;                            &lt;xsl:value-of select=&quot;'00:00'&quot;/>&#xa;                        &lt;/tns2:oraCutOver>&#xa;                    &lt;/tns2:nuovoOlo>&#xa;                &lt;/tns2:CambioOlo>&#xa;            &lt;/tns2:Richiesta>&#xa;        &lt;/tns2:RichiestaNPNG>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
