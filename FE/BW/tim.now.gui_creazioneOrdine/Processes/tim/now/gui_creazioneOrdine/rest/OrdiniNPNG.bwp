lue-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;nomeAttributo>&#xa;                    &lt;xsl:value-of select=&quot;'CAUSORDINE'&quot;/>&#xa;                &lt;/nomeAttributo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$post1.item/tns:lavorazione ='ATTIVAZIONE'&quot;>&#xa;                        &lt;valoreAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                        &lt;/valoreAttributo>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$post1.item/tns:lavorazione ='CESSAZIONE'&quot;>&#xa;                        &lt;valoreAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                        &lt;/valoreAttributo>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;valoreAttributo>&#xa;                            &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                        &lt;/valoreAttributo>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tipologiaDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                &lt;/tipologiaDato>&#xa;            &lt;/attributiDettaglioOrdine>&#xa;            &lt;attributiDettaglioOrdine>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;IDDettaglioOrdine>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/IDDettaglioOrdine>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;nomeAttributo>&#xa;                    &lt;xsl:value-of select=&quot;'TIPORECORD'&quot;/>&#xa;                &lt;/nomeAttributo>&#xa;                &lt;valoreAttributo>&#xa;                    &lt;xsl:value-of select=&quot;'02'&quot;/>&#xa;                &lt;/valoreAttributo>&#xa;                &lt;tipologiaDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                &lt;/tipologiaDato>&#xa;            &lt;/attributiDettaglioOrdine>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:statoSuccessivo = ('INVIATOADELIVERY','ESPLETAMENTOTECNICO','ESPLETATO')&quot;>&#xa;                &lt;attributiDettaglioOrdine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeAttributo>&#xa;                        &lt;xsl:value-of select=&quot;'STATOORDINE'&quot;/>&#xa;                    &lt;/nomeAttributo>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$post1.item/tns:statoSuccessivo = 'INVIATOADELIVERY'&quot;>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaDato>&#xa;                &lt;/attributiDettaglioOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:statoSuccessivo = ('ESPLETAMENTOTECNICO','ESPLETAMENTOTECNICOKO','ESPLETATO', 'ESPLETATOKO')&quot;>&#xa;                &lt;attributiDettaglioOrdine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeAttributo>&#xa;                        &lt;xsl:value-of select=&quot;'DES'&quot;/>&#xa;                    &lt;/nomeAttributo>&#xa;                    &lt;valoreAttributo>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:dataDes&quot;/>&#xa;                    &lt;/valoreAttributo>&#xa;                    &lt;tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaDato>&#xa;                &lt;/attributiDettaglioOrdine>&#xa;                &lt;attributiDettaglioOrdine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeAttributo>&#xa;                        &lt;xsl:value-of select=&quot;'ORADES'&quot;/>&#xa;                    &lt;/nomeAttributo>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($post1.item/tns:oraDes)=4&quot;>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;,$post1.item/tns:oraDes)&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;$post1.item/tns:oraDes&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaDato>&#xa;                &lt;/attributiDettaglioOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($post1.item/tns:dataCutover)>0&quot;>&#xa;                &lt;attributiDettaglioOrdine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeAttributo>&#xa;                        &lt;xsl:value-of select=&quot;'DATACUTOVER'&quot;/>&#xa;                    &lt;/nomeAttributo>&#xa;                    &lt;valoreAttributo>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:dataCutover&quot;/>&#xa;                    &lt;/valoreAttributo>&#xa;                    &lt;tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaDato>&#xa;                &lt;/attributiDettaglioOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($post1.item/tns:oraCutover)>0&quot;>&#xa;                &lt;attributiDettaglioOrdine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeAttributo>&#xa;                        &lt;xsl:value-of select=&quot;'ORACUTOVER'&quot;/>&#xa;                    &lt;/nomeAttributo>&#xa;                    &lt;valoreAttributo>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oraCutover&quot;/>&#xa;                    &lt;/valoreAttributo>&#xa;                    &lt;tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaDato>&#xa;                &lt;/attributiDettaglioOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($post1.item/tns:tipoPortabilita)>0&quot;>&#xa;                &lt;attributiDettaglioOrdine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeAttributo>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIPOPORTAB&amp;quot;&quot;/>&#xa;                    &lt;/nomeAttributo>&#xa;                    &lt;valoreAttributo>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:tipoPortabilita&quot;/>&#xa;                    &lt;/valoreAttributo>&#xa;                    &lt;tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaDato>&#xa;                &lt;/attributiDettaglioOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($post1.item/tns:unitaOrganizzativa)>0&quot;>&#xa;                &lt;attributiDettaglioOrdine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeAttributo>&#xa;                        &lt;xsl:value-of select=&quot;'UO'&quot;/>&#xa;                    &lt;/nomeAttributo>&#xa;                    &lt;valoreAttributo>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:unitaOrganizzativa&quot;/>&#xa;                    &lt;/valoreAttributo>&#xa;                    &lt;tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaDato>&#xa;                &lt;/attributiDettaglioOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($post1.item/tns:ultimaFattura)>0&quot;>&#xa;                &lt;attributiDettaglioOrdine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:va