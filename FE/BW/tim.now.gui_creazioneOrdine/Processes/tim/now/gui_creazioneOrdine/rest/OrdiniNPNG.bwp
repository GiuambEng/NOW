>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;DettaglioOrdineNPNG_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;tns4:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;DettaglioOrdineNPNG_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns4:trackID>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                &lt;/tns4:Envelope>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
