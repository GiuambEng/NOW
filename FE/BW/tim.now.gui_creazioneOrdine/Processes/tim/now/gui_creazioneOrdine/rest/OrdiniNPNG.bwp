elect=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeAttributo>&#xa;                        &lt;xsl:value-of select=&quot;'CODICEULTIMAFATTURA'&quot;/>&#xa;                    &lt;/nomeAttributo>&#xa;                    &lt;valoreAttributo>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:ultimaFattura&quot;/>&#xa;                    &lt;/valoreAttributo>&#xa;                    &lt;tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaDato>&#xa;                &lt;/attributiDettaglioOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($post1.item/tns:penultimaFattura)>0&quot;>&#xa;                &lt;attributiDettaglioOrdine>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/IDDettaglioOrdine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;nomeAttributo>&#xa;                        &lt;xsl:value-of select=&quot;'CODICEPENULTIMAFATTURA'&quot;/>&#xa;                    &lt;/nomeAttributo>&#xa;                    &lt;valoreAttributo>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:penultimaFattura&quot;/>&#xa;                    &lt;/valoreAttributo>&#xa;                    &lt;tipologiaDato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaDato>&#xa;                &lt;/attributiDettaglioOrdine>&#xa;            &lt;/xsl:if>&#xa;            &lt;attributiDettaglioOrdine>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:oao&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;IDDettaglioOrdine>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/IDDettaglioOrdine>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;nomeAttributo>&#xa;                    &lt;xsl:value-of select=&quot;'CANALEESITO'&quot;/>&#xa;                &lt;/nomeAttributo>&#xa;                &lt;valoreAttributo>&#xa;                    &lt;xsl:value-of select=&quot;'GUI'&quot;/>&#xa;                &lt;/valoreAttributo>&#xa;                &lt;tipologiaDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                &lt;/tipologiaDato>&#xa;            &lt;/attributiDettaglioOrdine>&#xa;            &lt;progressivo>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/progressivo>&#xa;        &lt;/ns:DettaglioOrdineElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
