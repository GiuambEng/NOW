                        &lt;/tns:details&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:outputDettaglioOrdineNPNG&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
