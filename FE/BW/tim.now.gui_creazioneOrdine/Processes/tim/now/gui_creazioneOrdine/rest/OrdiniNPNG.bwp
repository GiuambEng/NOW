tns:codiceProvisioning&quot;>&#xa;                        &lt;tns2:codiceProvisioning>&#xa;                            &lt;xsl:value-of select=&quot;$post2.item/tns:codiceProvisioning&quot;/>&#xa;                        &lt;/tns2:codiceProvisioning>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:nuovoOlo>&#xa;                        &lt;tns2:nuovoOlo>&#xa;                            &lt;xsl:value-of select=&quot;$post2.item/tns:nuovoOlo/tns:olo&quot;/>&#xa;                        &lt;/tns2:nuovoOlo>&#xa;                        &lt;tns2:dataCutOver>&#xa;                            &lt;xsl:value-of select=&quot;$post2.item/tns:nuovoOlo/tns:dataCutOver&quot;/>&#xa;                        &lt;/tns2:dataCutOver>&#xa;                        &lt;tns2:oraCutOver>&#xa;                            &lt;xsl:value-of select=&quot;'00:00'&quot;/>&#xa;                        &lt;/tns2:oraCutOver>&#xa;                    &lt;/tns2:nuovoOlo>&#xa;                &lt;/tns2:CambioOlo>&#xa;            &lt;/tns2:Richiesta>&#xa;        &lt;/tns2:RichiestaNPNG>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
