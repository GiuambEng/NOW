                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VisualizzazioneCodiceVlanCodiceSvlan&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzacodVlanSvlan/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;tipologia_servizi&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;($post.parameters/tns2:servizio=('VULAFTTH','SEMIVULAFTTH'))  or ($post.parameters/tns2:servizio='VULAFTTCAB') or ($post.parameters/tns2:servizio='FULLGPONPLUS')&quot;>&#xa;                &lt;tns1:tipologia_servizi>&#xa;                    &lt;tns1:tipologiaServizi>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VULA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:tipologiaServizi>&#xa;                &lt;/tns1:tipologia_servizi>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;($post.parameters/tns2:servizio=('BitstreamNGAFTTH','SEMIBitstreamNGAFTTH'))  or ($post.parameters/tns2:servizio='BitstreamNGAFTTCAB') or ($post.parameters/tns2:servizio='FULLGPONPLUSNGA')&quot;>&#xa;                &lt;tns1:tipologia_servizi>&#xa;                    &lt;tns1:tipologiaServizi>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:tipologiaServizi>&#xa;                &lt;/tns1:tipologia_servizi>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;($post.parameters/tns2:servizio='BitstreamGBEAsimmetricoFlat')  or ($post.parameters/tns2:servizio='BitstreamGBESimmetricoFlat')&quot;>&#xa;                &lt;tns1:tipologia_servizi>&#xa;                    &lt;tns1:tipologiaServizi>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;GBE&amp;quot;&quot;/>&#xa;                    &lt;/tns1:tipologiaServizi>&#xa;                &lt;/tns1:tipologia_servizi>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:tipologia_servizi>&#xa;                    &lt;tns1:tipologiaServizi>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/tns1:tipologiaServizi>&#xa;                &lt;/tns1:tipologia_servizi>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
