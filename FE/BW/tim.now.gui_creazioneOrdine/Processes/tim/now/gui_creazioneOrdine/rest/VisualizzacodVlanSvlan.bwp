                                    sqlStatement="SELECT OV.DATAINZ_VALID,OV.CODFC_OLO_AGCOM,AV.CLLI,AV.COD_AREA_RACCOLTA,AV.COD_KIT,AV.COD_MACRO_AREA,&#xa;AV.COD_SUPER_MACRO_AREA,AV.COD_VLAN,AV.DEC,AV.DEC_ATTIVAZIONE,AV.DESC_AREA_RACCOLTA,AV.DESC_MACRO_AREA,&#xa;AV.DESC_SUPER_MACRO_AREA,AV.DSLAM_TYPE,AV.FLAG_ENCAPSULATION,AV.FLAG_VLAN_TRANSLATION,AV.ID_VLAN_OLO,&#xa;AV.NOME,AV.NOME_CENTRALE,AV.STATO,AV.TIPO_BANDA, AV.TIPO_COS, AV.TIPO_TRASPORTO, AV.TIPOLG &#xa;FROM   ANAG_VLAN AV &#xa;LEFT JOIN OLO_VLAN OV ON OV.COD_VLAN=AV.COD_VLAN&#xa;WHERE OV.COD_VLAN=AV.COD_VLAN&#xa;AND AV.FLAG_ENCAPSULATION=?&#xa;AND AV.TIPOLG = ?&#xa;AND OV.CODFC_OLO_AGCOM = ?&#xa;AND AV.STATO IN ('ACTIVE','in lavorazione') &#xa;AND OV.DATAINZ_VALID &lt; to_Date(?,'DD/MM/YY') &#xa;AND (OV.DATAFI_VALID > to_Date(?,'DD/MM/YY') &#xa;OR OV.DATAFI_VALID IS NULL)&#xa;AND AV.ID_TPLG_OPERATORE=?&#xa;ORDER BY AV.COD_VLAN" xsi:type="jdbcPalette:JDBCQueryActivity">

