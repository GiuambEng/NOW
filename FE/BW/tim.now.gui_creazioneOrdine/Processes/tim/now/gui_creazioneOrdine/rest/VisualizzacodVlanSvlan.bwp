                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VisualizzazioneCodiceVlanCodiceSvlan&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzacodVlanSvlan/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;encapsulationVariable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($post.parameters/tns2:encapsulation)>0 and upper-case($post.parameters/tns2:encapsulation)=&amp;quot;DOUBLETAG&amp;quot;&quot;>&#xa;                &lt;tns1:inputvisualizzazionecodicevlancodicesvlan>&#xa;                    &lt;tns1:encapsulation>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                    &lt;/tns1:encapsulation>&#xa;                &lt;/tns1:inputvisualizzazionecodicevlancodicesvlan>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($post.parameters/tns2:encapsulation)>0 and upper-case($post.parameters/tns2:encapsulation)=&amp;quot;SINGLETAG&amp;quot;&quot;>&#xa;                &lt;tns1:inputvisualizzazionecodicevlancodicesvlan>&#xa;                    &lt;tns1:encapsulation>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/tns1:encapsulation>&#xa;                &lt;/tns1:inputvisualizzazionecodicevlancodicesvlan>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:inputvisualizzazionecodicevlancodicesvlan>&#xa;                    &lt;tns1:encapsulation>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/tns1:encapsulation>&#xa;                &lt;/tns1:inputvisualizzazionecodicevlancodicesvlan>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
