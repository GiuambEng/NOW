                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+90d455ac-1648-45a2-9f19-00021470788e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VisualizzazioneCodiceVlanCodiceSvlan&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzacodVlanSvlan/parameters&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;encapsulationVariable&quot;/>&#xa;    &lt;xsl:param name=&quot;tipologia_servizi&quot;/>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;Copy_1_QueryTipologiaOperRete&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($encapsulationVariable/tns1:encapsulation) >0 and string-length(string($Copy_1_QueryTipologiaOperRete/Record[1]/ID_TPLG_OPERATORE))=0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT OV.DATAINZ_VALID,OV.CODFC_OLO_AGCOM,AV.CLLI,AV.COD_AREA_RACCOLTA,AV.COD_KIT,AV.COD_MACRO_AREA,AV.COD_SUPER_MACRO_AREA,AV.COD_VLAN,AV.DEC,AV.DEC_ATTIVAZIONE,AV.DESC_AREA_RACCOLTA,AV.DESC_MACRO_AREA,AV.DESC_SUPER_MACRO_AREA,AV.DSLAM_TYPE,AV.FLAG_ENCAPSULATION,AV.FLAG_VLAN_TRANSLATION,AV.ID_VLAN_OLO,AV.NOME,AV.NOME_CENTRALE,AV.STATO,AV.TIPO_BANDA, AV.TIPO_COS,AV.TIPO_TRASPORTO, AV.TIPOLG FROM   ANAG_VLAN AV LEFT JOIN OLO_VLAN OV ON OV.COD_VLAN=AV.COD_VLAN  WHERE OV.COD_VLAN=AV.COD_VLAN AND AV.FLAG_ENCAPSULATION='&amp;quot;,$encapsulationVariable/tns1:encapsulation,&amp;quot;'  AND AV.TIPOLG = '&amp;quot;,$tipologia_servizi/tns1:tipologiaServizi,&amp;quot;'  AND OV.CODFC_OLO_AGCOM = '&amp;quot;,$post.parameters/tns2:codoloagcom,&amp;quot;' AND AV.STATO IN ('ACTIVE','in lavorazione') AND OV.DATAINZ_VALID &amp;lt; to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') AND (OV.DATAFI_VALID > to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') OR OV.DATAFI_VALID IS NULL) AND AV.ID_TPLG_OPERATORE IS NULL AND &amp;quot;,upper-case($RicercaAvanzata/tns4:outputcondition[1]), &amp;quot;ORDER BY AV.COD_VLAN&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($encapsulationVariable/tns1:encapsulation) >0 and string-length(string($Copy_1_QueryTipologiaOperRete/Record[1]/ID_TPLG_OPERATORE))>0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT OV.DATAINZ_VALID,OV.CODFC_OLO_AGCOM,AV.CLLI,AV.COD_AREA_RACCOLTA,AV.COD_KIT,AV.COD_MACRO_AREA,AV.COD_SUPER_MACRO_AREA,AV.COD_VLAN,AV.DEC,AV.DEC_ATTIVAZIONE,AV.DESC_AREA_RACCOLTA,AV.DESC_MACRO_AREA,AV.DESC_SUPER_MACRO_AREA,AV.DSLAM_TYPE,AV.FLAG_ENCAPSULATION,AV.FLAG_VLAN_TRANSLATION,AV.ID_VLAN_OLO,AV.NOME,AV.NOME_CENTRALE,AV.STATO,AV.TIPO_BANDA, AV.TIPO_COS,AV.TIPO_TRASPORTO, AV.TIPOLG FROM   ANAG_VLAN AV LEFT JOIN OLO_VLAN OV ON OV.COD_VLAN=AV.COD_VLAN  WHERE OV.COD_VLAN=AV.COD_VLAN AND AV.FLAG_ENCAPSULATION='&amp;quot;,$encapsulationVariable/tns1:encapsulation,&amp;quot;'  AND AV.TIPOLG = '&amp;quot;,$tipologia_servizi/tns1:tipologiaServizi,&amp;quot;'  AND OV.CODFC_OLO_AGCOM = '&amp;quot;,$post.parameters/tns2:codoloagcom,&amp;quot;' AND AV.STATO IN ('ACTIVE','in lavorazione') AND OV.DATAINZ_VALID &amp;lt; to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') AND (OV.DATAFI_VALID > to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') OR OV.DATAFI_VALID IS NULL) AND AV.ID_TPLG_OPERATORE='&amp;quot;,string(xsd:int($Copy_1_QueryTipologiaOperRete/Record[1]/ID_TPLG_OPERATORE)),&amp;quot;' AND &amp;quot;,upper-case($RicercaAvanzata/tns4:outputcondition[1]), &amp;quot;ORDER BY AV.COD_VLAN&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($encapsulationVariable/tns1:encapsulation) = 0 and ($tipologia_servizi/tns1:tipologiaServizi='VULA' or $post.parameters/tns2:servizio='BitstreamGBESimmetricoFlat') and string-length(string($Copy_1_QueryTipologiaOperRete/Record[1]/ID_TPLG_OPERATORE))=0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT OV.DATAINZ_VALID,OV.CODFC_OLO_AGCOM,AV.CLLI,AV.COD_AREA_RACCOLTA,AV.COD_KIT,AV.COD_MACRO_AREA,AV.COD_SUPER_MACRO_AREA,AV.COD_VLAN,AV.DEC,AV.DEC_ATTIVAZIONE,AV.DESC_AREA_RACCOLTA,AV.DESC_MACRO_AREA,AV.DESC_SUPER_MACRO_AREA,AV.DSLAM_TYPE,AV.FLAG_ENCAPSULATION,AV.FLAG_VLAN_TRANSLATION,AV.ID_VLAN_OLO,AV.NOME,AV.NOME_CENTRALE,AV.STATO,AV.TIPO_BANDA, AV.TIPO_COS,AV.TIPO_TRASPORTO, AV.TIPOLG FROM   ANAG_VLAN AV LEFT JOIN OLO_VLAN OV ON OV.COD_VLAN=AV.COD_VLAN  WHERE OV.COD_VLAN=AV.COD_VLAN AND AV.FLAG_ENCAPSULATION='Y'  AND AV.TIPOLG = '&amp;quot;,$tipologia_servizi/tns1:tipologiaServizi,&amp;quot;'  AND OV.CODFC_OLO_AGCOM = '&amp;quot;,$post.parameters/tns2:codoloagcom,&amp;quot;' AND AV.STATO IN ('ACTIVE','in lavorazione') AND OV.DATAINZ_VALID &amp;lt; to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') AND (OV.DATAFI_VALID > to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') OR OV.DATAFI_VALID IS NULL) AND  AV.ID_TPLG_OPERATORE IS NULL AND &amp;quot;,upper-case($RicercaAvanzata/tns4:outputcondition[1]), &amp;quot;ORDER BY AV.COD_VLAN&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($encapsulationVariable/tns1:encapsulation) = 0 and ($tipologia_servizi/tns1:tipologiaServizi='VULA' or $post.parameters/tns2:servizio='BitstreamGBESimmetricoFlat') and string-length(string($Copy_1_QueryTipologiaOperRete/Record[1]/ID_TPLG_OPERATORE))>0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT OV.DATAINZ_VALID,OV.CODFC_OLO_AGCOM,AV.CLLI,AV.COD_AREA_RACCOLTA,AV.COD_KIT,AV.COD_MACRO_AREA,AV.COD_SUPER_MACRO_AREA,AV.COD_VLAN,AV.DEC,AV.DEC_ATTIVAZIONE,AV.DESC_AREA_RACCOLTA,AV.DESC_MACRO_AREA,AV.DESC_SUPER_MACRO_AREA,AV.DSLAM_TYPE,AV.FLAG_ENCAPSULATION,AV.FLAG_VLAN_TRANSLATION,AV.ID_VLAN_OLO,AV.NOME,AV.NOME_CENTRALE,AV.STATO,AV.TIPO_BANDA, AV.TIPO_COS,AV.TIPO_TRASPORTO, AV.TIPOLG FROM   ANAG_VLAN AV LEFT JOIN OLO_VLAN OV ON OV.COD_VLAN=AV.COD_VLAN  WHERE OV.COD_VLAN=AV.COD_VLAN  AND AV.TIPOLG = '&amp;quot;,$tipologia_servizi/tns1:tipologiaServizi,&amp;quot;'  AND OV.CODFC_OLO_AGCOM = '&amp;quot;,$post.parameters/tns2:codoloagcom,&amp;quot;' AND AV.STATO IN ('ACTIVE','in lavorazione') AND OV.DATAINZ_VALID &amp;lt; to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') AND (OV.DATAFI_VALID > to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') OR OV.DATAFI_VALID IS NULL) AND AV.ID_TPLG_OPERATORE='&amp;quot;,string(xsd:int($Copy_1_QueryTipologiaOperRete/Record[1]/ID_TPLG_OPERATORE)),&amp;quot;' AND &amp;quot;,upper-case($RicercaAvanzata/tns4:outputcondition[1]), &amp;quot;ORDER BY AV.COD_VLAN&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($encapsulationVariable/tns1:encapsulation) = 0 and $tipologia_servizi/tns1:tipologiaServizi!='VULA' and $post.parameters/tns2:servizio!='BitstreamGBESimmetricoFlat' and string-length(string($Copy_1_QueryTipologiaOperRete/Record[1]/ID_TPLG_OPERATORE))=0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT OV.DATAINZ_VALID,OV.CODFC_OLO_AGCOM,AV.CLLI,AV.COD_AREA_RACCOLTA,AV.COD_KIT,AV.COD_MACRO_AREA,AV.COD_SUPER_MACRO_AREA,AV.COD_VLAN,AV.DEC,AV.DEC_ATTIVAZIONE,AV.DESC_AREA_RACCOLTA,AV.DESC_MACRO_AREA,AV.DESC_SUPER_MACRO_AREA,AV.DSLAM_TYPE,AV.FLAG_ENCAPSULATION,AV.FLAG_VLAN_TRANSLATION,AV.ID_VLAN_OLO,AV.NOME,AV.NOME_CENTRALE,AV.STATO,AV.TIPO_BANDA, AV.TIPO_COS,AV.TIPO_TRASPORTO, AV.TIPOLG FROM   ANAG_VLAN AV LEFT JOIN OLO_VLAN OV ON OV.COD_VLAN=AV.COD_VLAN  WHERE OV.COD_VLAN=AV.COD_VLAN  AND AV.TIPOLG = '&amp;quot;,$tipologia_servizi/tns1:tipologiaServizi,&amp;quot;'  AND OV.CODFC_OLO_AGCOM = '&amp;quot;,$post.parameters/tns2:codoloagcom,&amp;quot;' AND AV.STATO IN ('ACTIVE','in lavorazione') AND OV.DATAINZ_VALID &amp;lt; to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') AND (OV.DATAFI_VALID > to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') OR OV.DATAFI_VALID IS NULL) AND  AV.ID_TPLG_OPERATORE IS NULL AND &amp;quot;,upper-case($RicercaAvanzata/tns4:outputcondition[1]), &amp;quot;ORDER BY AV.COD_VLAN&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT OV.DATAINZ_VALID,OV.CODFC_OLO_AGCOM,AV.CLLI,AV.COD_AREA_RACCOLTA,AV.COD_KIT,AV.COD_MACRO_AREA,AV.COD_SUPER_MACRO_AREA,AV.COD_VLAN,AV.DEC,AV.DEC_ATTIVAZIONE,AV.DESC_AREA_RACCOLTA,AV.DESC_MACRO_AREA,AV.DESC_SUPER_MACRO_AREA,AV.DSLAM_TYPE,AV.FLAG_ENCAPSULATION,AV.FLAG_VLAN_TRANSLATION,AV.ID_VLAN_OLO,AV.NOME,AV.NOME_CENTRALE,AV.STATO,AV.TIPO_BANDA, AV.TIPO_COS,AV.TIPO_TRASPORTO, AV.TIPOLG FROM   ANAG_VLAN AV LEFT JOIN OLO_VLAN OV ON OV.COD_VLAN=AV.COD_VLAN  WHERE OV.COD_VLAN=AV.COD_VLAN  AND AV.TIPOLG = '&amp;quot;,$tipologia_servizi/tns1:tipologiaServizi,&amp;quot;'  AND OV.CODFC_OLO_AGCOM = '&amp;quot;,$post.parameters/tns2:codoloagcom,&amp;quot;' AND AV.STATO IN ('ACTIVE','in lavorazione') AND OV.DATAINZ_VALID &amp;lt; to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') AND (OV.DATAFI_VALID > to_Date('&amp;quot;,string(format-date($DRO1.parameters/tns3:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;)),&amp;quot;','DD/MM/YY') OR OV.DATAFI_VALID IS NULL) AND AV.ID_TPLG_OPERATORE='&amp;quot;,string(xsd:int($Copy_1_QueryTipologiaOperRete/Record[1]/ID_TPLG_OPERATORE)),&amp;quot;' AND &amp;quot;,upper-case($RicercaAvanzata/tns4:outputcondition[1]), &amp;quot;ORDER BY AV.COD_VLAN&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
