select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/tns1:encapsulation>&#xa;                &lt;/tns1:inputvisualizzazionecodicevlancodicesvlan>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
