                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4fb70ea0-0b3c-4048-9c8f-14a40c08594f+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzacodVlanSvlan/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;tipologia_servizi&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryTipologiaOperRete&quot;/>&#xa;    &lt;xsl:template name=&quot;NoEncapsulation_opRete-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;servizio>&#xa;                &lt;xsl:value-of select=&quot;$tipologia_servizi&quot;/>&#xa;            &lt;/servizio>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns2:codoloagcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;DRO1>&#xa;                &lt;xsl:value-of select=&quot;string(format-date($DRO.parameters/tns4:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&#xa;            &lt;/DRO1>&#xa;            &lt;DRO2>&#xa;                &lt;xsl:value-of select=&quot;string(format-date($DRO.parameters/tns4:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&#xa;            &lt;/DRO2>&#xa;            &lt;ID_TPLG_OPERATORE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($QueryTipologiaOperRete/Record[1]/ID_TPLG_OPERATORE)&quot;/>&#xa;            &lt;/ID_TPLG_OPERATORE>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OV.DATAINZ_VALID,OV.CODFC_OLO_AGCOM,AV.CLLI,AV.COD_AREA_RACCOLTA,AV.COD_KIT,AV.COD_MACRO_AREA,AV.COD_SUPER_MACRO_AREA,&#xa;AV.COD_VLAN,AV.DEC,AV.DEC_ATTIVAZIONE,AV.DESC_AREA_RACCOLTA,AV.DESC_MACRO_AREA,AV.DESC_SUPER_MACRO_AREA,AV.DSLAM_TYPE,&#xa;AV.FLAG_ENCAPSULATION,AV.FLAG_VLAN_TRANSLATION,AV.ID_VLAN_OLO,AV.NOME,AV.NOME_CENTRALE,AV.STATO,AV.TIPO_BANDA, &#xa;AV.TIPO_COS, AV.TIPO_TRASPORTO, AV.TIPOLG &#xa;FROM ANAG_VLAN AV &#xa;LEFT JOIN OLO_VLAN OV ON OV.COD_VLAN=AV.COD_VLAN&#xa;WHERE OV.COD_VLAN=AV.COD_VLAN   &#xa;AND AV.TIPOLG=?&#xa;AND OV.CODFC_OLO_AGCOM = ? &#xa;AND AV.STATO IN ('ACTIVE','in lavorazione') &#xa;AND OV.DATAINZ_VALID &lt; to_Date(?,'DD/MM/YY') &#xa;AND (OV.DATAFI_VALID > to_Date(?,'DD/MM/YY') &#xa;OR OV.DATAFI_VALID IS NULL)&#xa;AND AV.ID_TPLG_OPERATORE=?&#xa;ORDER BY AV.COD_VLAN" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="servizio"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_TPLG_OPERATORE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CLLI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_AREA_RACCOLTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_KIT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_MACRO_AREA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_SUPER_MACRO_AREA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_VLAN"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DEC"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DEC_ATTIVAZIONE"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DESC_AREA_RACCOLTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESC_MACRO_AREA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESC_SUPER_MACRO_AREA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DSLAM_TYPE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_ENCAPSULATION"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_VLAN_TRANSLATION"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_VLAN_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_CENTRALE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPO_BANDA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPO_COS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPO_TRASPORTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLG"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
