                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e480e6e8-06f4-466e-a384-e262f9040bec+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzacodVlanSvlan/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DRO&quot;/>&#xa;    &lt;xsl:param name=&quot;tipologia_servizi&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;EncapsulationY-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;servizio>&#xa;                &lt;xsl:value-of select=&quot;$tipologia_servizi&quot;/>&#xa;            &lt;/servizio>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns2:visualizzacodvlansvlanGetParameters/tns2:codoloagcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;DRO1>&#xa;                &lt;xsl:value-of select=&quot;string(format-date($DRO/parameters/tns4:Response/tns4:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&#xa;            &lt;/DRO1>&#xa;            &lt;DRO2>&#xa;                &lt;xsl:value-of select=&quot;string(format-date($DRO/parameters/tns4:Response/tns4:outputDate,&amp;quot;[D01]-[MMM]-[Y0001]&amp;quot;))&quot;/>&#xa;            &lt;/DRO2>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
