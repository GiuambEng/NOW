                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+91149a0d-b44f-4008-85db-dc25257f26a9+input&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzacodVlanSvlan/parameters&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VisualizzazioneCodiceVlanCodiceSvlan&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;tipologia_servizi&quot;/>&#xa;    &lt;xsl:param name=&quot;encapsulationVariable&quot;/>&#xa;    &lt;xsl:template name=&quot;Encapsulation-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;encapsulation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($encapsulationVariable/tns1:encapsulation)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$encapsulationVariable/tns1:encapsulation&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/encapsulation>&#xa;            &lt;servizio>&#xa;                &lt;xsl:value-of select=&quot;$tipologia_servizi&quot;/>&#xa;            &lt;/servizio>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns2:codoloagcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;DRO1>&#xa;                &lt;xsl:value-of select=&quot;string(format-date($DRO.parameters/tns3:outputDate,&amp;quot;[