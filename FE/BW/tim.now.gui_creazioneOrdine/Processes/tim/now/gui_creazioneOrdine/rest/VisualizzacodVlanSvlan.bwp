                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VisualizzazioneCodiceVlanCodiceSvlan&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Encapsulation&quot;/>&lt;xsl:template name=&quot;visualizVlan&quot; match=&quot;/&quot;>&lt;tns1:outputrestcodvlancodslan>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Encapsulation/Record[1]/COD_VLAN) and string-length($Encapsulation/Record[1]/COD_VLAN) >0&quot;>&lt;xsl:for-each select=&quot;$Encapsulation/Record&quot;>&lt;tns1:outputrestcodvlancodsvlan>&lt;tns1:codicevlan>&lt;xsl:value-of select=&quot;COD_VLAN&quot;/>&lt;/tns1:codicevlan>&lt;tns1:tipobanda>&lt;xsl:value-of select=&quot;TIPO_BANDA&quot;/>&lt;/tns1:tipobanda>&lt;tns1:tipocos>&lt;xsl:value-of select=&quot;TIPO_COS&quot;/>&lt;/tns1:tipocos>&lt;tns1:flagencapsulation>&lt;xsl:value-of select=&quot;FLAG_ENCAPSULATION&quot;/>&lt;/tns1:flagencapsulation>&lt;tns1:tipologia>&lt;xsl:value-of select=&quot;TIPOLG&quot;/>&lt;/tns1:tipologia>&lt;tns1:stato>&lt;xsl:value-of select=&quot;STATO&quot;/>&lt;/tns1:stato>&lt;tns1:nome>&lt;xsl:value-of select=&quot;NOME&quot;/>&lt;/tns1:nome>&lt;tns1:clli>&lt;xsl:value-of select=&quot;CLLI&quot;/>&lt;/tns1:clli>&lt;tns1:nomecentrale>&lt;xsl:value-of select=&quot;NOME_CENTRALE&quot;/>&lt;/tns1:nomecentrale>&lt;xsl:if test=&quot;COD_KIT&quot;>&lt;tns1:codicekit>&lt;xsl:value-of select=&quot;COD_KIT&quot;/>&lt;/tns1:codicekit>&lt;/xsl:if>&lt;tns1:dec>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DEC), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns1:dec>&lt;tns1:decattivazione>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DEC_ATTIVAZIONE), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns1:decattivazione>&lt;tns1:codiceareadiraccolta>&lt;xsl:value-of select=&quot;COD_AREA_RACCOLTA&quot;/>&lt;/tns1:codiceareadiraccolta>&lt;tns1:descareadiraccolta>&lt;xsl:value-of select=&quot;DESC_AREA_RACCOLTA&quot;/>&lt;/tns1:descareadiraccolta>&lt;tns1:codicemacroarea>&lt;xsl:value-of select=&quot;COD_MACRO_AREA&quot;/>&lt;/tns1:codicemacroarea>&lt;xsl:if test=&quot;COD_SUPER_MACRO_AREA&quot;>&lt;tns1:codicesupermacroarea>&lt;xsl:value-of select=&quot;COD_SUPER_MACRO_AREA&quot;/>&lt;/tns1:codicesupermacroarea>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPO_TRASPORTO&quot;>&lt;tns1:tipotrasporto>&lt;xsl:value-of select=&quot;TIPO_TRASPORTO&quot;/>&lt;/tns1:tipotrasporto>&lt;/xsl:if>&lt;xsl:if test=&quot;ID_VLAN_OLO&quot;>&lt;tns1:idvlanolo>&lt;xsl:value-of select=&quot;ID_VLAN_OLO&quot;/>&lt;/tns1:idvlanolo>&lt;/xsl:if>&lt;tns1:flagvlantranslation>&lt;xsl:value-of select=&quot;FLAG_VLAN_TRANSLATION&quot;/>&lt;/tns1:flagvlantranslation>&lt;tns1:descmacroarea>&lt;xsl:value-of select=&quot;DESC_MACRO_AREA&quot;/>&lt;/tns1:descmacroarea>&lt;xsl:if test=&quot;DESC_SUPER_MACRO_AREA&quot;>&lt;tns1:descsupermacroarea>&lt;xsl:value-of select=&quot;DESC_SUPER_MACRO_AREA&quot;/>&lt;/tns1:descsupermacroarea>&lt;/xsl:if>&lt;xsl:if test=&quot;DSLAM_TYPE&quot;>&lt;tns1:dslamType>&lt;xsl:value-of select=&quot;DSLAM_TYPE&quot;/>&lt;/tns1:dslamType>&lt;/xsl:if>&lt;/tns1:outputrestcodvlancodsvlan>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:code>&lt;/tns1:result>&lt;/tns1:outputrestcodvlancodslan>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
