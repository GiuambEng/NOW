ot;tns:operazione&quot;>&#xa;                        &lt;tns:operazione>&#xa;                            &lt;xsl:value-of select=&quot;tns:operazione&quot;/>&#xa;                        &lt;/tns:operazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:valore&quot;>&#xa;                        &lt;tns:valore>&#xa;                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                        &lt;/tns:valore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:tipo&quot;>&#xa;                        &lt;tns:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns:tipo&quot;/>&#xa;                        &lt;/tns:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$post/item/tns:inputservizioricercaavanzata/tns:indiceriga&quot;>&#xa;                &lt;tns:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns:inputservizioricercaavanzata/tns:indiceriga&quot;/>&#xa;                &lt;/tns:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post/item/tns:inputservizioricercaavanzata/tns:numerorighe&quot;>&#xa;                &lt;tns:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns:inputservizioricercaavanzata/tns:numerorighe&quot;/>&#xa;                &lt;/tns:numerorighe>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post/item/tns:inputservizioricercaavanzata/tns:exportRequest&quot;>&#xa;                &lt;tns:exportRequest>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns:inputservizioricercaavanzata/tns:exportRequest&quot;/>&#xa;                &lt;/tns:exportRequest>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
