                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VisualizzazioneCodiceVlanCodiceSvlan&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzacodVlanSvlan/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;tipologia_servizi&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($post/parameters/tns2:visualizzacodvlansvlanPostParameters/tns2:servizio=('VULAFTTH','SEMIVULAFTTH'))  or ($post/parameters/tns2:visualizzacodvlansvlanPostParameters/tns2:servizio='VULAFTTCAB') or ($post/parameters/tns2:visualizzacodvlansvlanPostParameters/tns2:servizio='FULLGPONPLUS')&quot;>&lt;tns1:tipologia_servizi>&lt;tns1:tipologiaServizi>&lt;xsl:value-of select=&quot;&amp;quot;VULA&amp;quot;&quot;/>&lt;/tns1:tipologiaServizi>&lt;/tns1:tipologia_servizi>&lt;/xsl:when>&lt;xsl:when test=&quot;($post/parameters/tns2:visualizzacodvlansvlanPostParameters/tns2:servizio=('BitstreamNGAFTTH','SEMIBitstreamNGAFTTH'))  or ($post/parameters/tns2:visualizzacodvlansvlanPostParameters/tns2:servizio='BitstreamNGAFTTCAB') or ($post/parameters/tns2:visualizzacodvlansvlanPostParameters/tns2:servizio='FULLGPONPLUSNGA')&quot;>&lt;tns1:tipologia_servizi>&lt;tns1:tipologiaServizi>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/tns1:tipologiaServizi>&lt;/tns1:tipologia_servizi>&lt;/xsl:when>&lt;xsl:when test=&quot;($post/parameters/tns2:visualizzacodvlansvlanPostParameters/tns2:servizio='BitstreamGBEAsimmetricoFlat')  or ($post/parameters/tns2:visualizzacodvlansvlanPostParameters/tns2:servizio='BitstreamGBESimmetricoFlat')&quot;>&lt;tns1:tipologia_servizi>&lt;tns1:tipologiaServizi>&lt;xsl:value-of select=&quot;&amp;quot;GBE&amp;quot;&quot;/>&lt;/tns1:tipologiaServizi>&lt;/tns1:tipologia_servizi>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:tipologia_servizi>&lt;tns1:tipologiaServizi>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:tipologiaServizi>&lt;/tns1:tipologia_servizi>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
