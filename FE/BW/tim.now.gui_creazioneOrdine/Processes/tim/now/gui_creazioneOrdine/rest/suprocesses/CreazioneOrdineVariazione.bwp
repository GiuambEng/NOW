                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:mapper_1469293436511="http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1469293436511" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
