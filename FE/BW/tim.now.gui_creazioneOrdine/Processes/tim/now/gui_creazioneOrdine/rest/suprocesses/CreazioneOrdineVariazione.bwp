tributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:componente=$currComponent3 and tns:progressivo=$currPosition3]&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:key !='AZIONE' and string-length($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore) > 0&quot;>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) = 1&quot;>&#xa;                                                        &lt;IDDettaglioOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                        &lt;/IDDettaglioOrdine>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIO