                             &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                    &lt;/qualificaReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                    &lt;emailReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                    &lt;/emailReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;N&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEONFIELD&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:refOaoProgettiSpeciali)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                                    &lt;refOAOProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                                    &lt;/refOAOProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FONIA&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                            &lt;tipologiaQualita>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                            &lt;/tipologiaQualita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:idOfferta = '22'&quot;>&#xa;                                &lt;offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;WLRLINEANONATTIVA&amp;quot;&quot;/>&#xa;                                &lt;/offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;WLRLINEAATTIVA&amp;quot;&quot;/>&#xa;                                &lt;/offerta>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ordine>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                &lt;ISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                &lt;/ISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                &lt;localita>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                &lt;/localita>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '1'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '2'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ULLLINEAATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '3'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEANONATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '4'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEAATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '5'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SLULINEANONATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '6'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SLULINEAATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '22'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;WLRLINEANONATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '25'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;WLRLINEAATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '23'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SHACONMANODOPERA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '24'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SHASENZAMANODOPERA&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '27'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ULLLINEAATTIVANP&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '28'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEAATTIVANP&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SLULINEAATTIVANP&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                &lt;IDFasciaOraria>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                &lt;/IDFasciaOraria>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns3:Response/tns3:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns3:Response/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloData/parameters/tns3:Response/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dn&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'WLR' and not($Start/tns:dac)&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;$DRO6DAYS/parameters/tns3:Response/tns3:outputDate&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                        &lt;DAC>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                        &lt;/DAC>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE/tns4:lna_la) and string-length($CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[1]/tns4:lna_la)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:idOfferta=('22','1','3')&quot;>&#xa;                            &lt;xsl:if test=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[tns4:lna_la='LNA']/tns4:codice&quot;>&#xa;                                &lt;servizioOrigine>&#xa;                                    &lt;xsl:value-of select=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[tns4:lna_la='LNA']/tns4:codice&quot;/>&#xa;                                &lt;/servizioOrigine>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[tns4:lna_la='LA']/tns4:codice&quot;>&#xa;                                &lt;servizioOrigine>&#xa;                                    &lt;xsl:value-of select=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[tns4:lna_la='LA']/tns4:codice&quot;/>&#xa;                                &lt;/servizioOrigine>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[1]/tns4:codice&quot;>&#xa;                        &lt;servizioOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[1]/tns4:codice&quot;/>&#xa;                        &lt;/servizioOrigine>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Attivazione STS'&amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;exists($Start/tns:stsDaAttivare)&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:stsDaAttivare&quot;>&#xa;                        &lt;codiceSTS>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:stsDaAttivare&quot;/>&#xa;                        &lt;/codiceSTS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Cessazione STS'&amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;exists($Start/tns:stsDaCessare)&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:stsDaCessare&quot;>&#xa;                        &lt;codiceSTS>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:stsDaCessare&quot;/>&#xa;                        &lt;/codiceSTS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$Start/tns:numerazioneAggiuntiva&quot;>&#xa;                &lt;DNAggiuntivo>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/DNAggiuntivo>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneRegolatorio/tns2:sottolavorazione&quot;>&#xa;                &lt;tipologiaSottolav>&#xa;                    &lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneRegolatorio/tns2:sottolavorazione&quot;/>&#xa;                &lt;/tipologiaSottolav>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CasedataBPM"
                    name="CasedataBPMRegolatorio"
                    outputVariable="CasedataBPM"
                    tibex:xpdlId="1f973385-511e-4b1c-b1c9-06e5d581d762" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToCasedataBPMRegolatorio"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CasedataBPMRegolatorioToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/ConfigurazioneFE&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloData.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO6DAYS.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDestinazioneUsoFonia&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDestinazioneUsoDati&quot;/>&#xa;    &lt;xsl:param name=&quot;DeterminaSottoLavorazioneRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;CallRecuperoServizioOrigine&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:template name=&quot;CasedataBPM&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                &lt;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:offertaCatalogo = 'ULL'&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ULL&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                            &lt;DAD>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                            &lt;/DAD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                            &lt;codiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                            &lt;/codiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                            &lt;DNOLOCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                            &lt;/DNOLOCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                            &lt;numeroVerdeOloCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                            &lt;/numeroVerdeOloCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                            &lt;numeroVerdeOloPT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                            &lt;/numeroVerdeOloPT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:flagMonitoraggio = 'N'&quot;>&#xa;                                &lt;flagMonitoraggio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/flagMonitoraggio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:flagMonitoraggio = 'Y'&quot;>&#xa;                                &lt;flagMonitoraggio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/flagMonitoraggio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:flagMonitoraggio&quot;>&#xa;                                    &lt;flagMonitoraggio>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:flagMonitoraggio&quot;/>&#xa;                                    &lt;/flagMonitoraggio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                            &lt;codiceOrdineOLOPadre>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                            &lt;/codiceOrdineOLOPadre>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                            &lt;codiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                            &lt;/codiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;tipologiaLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLavorazione>&#xa;                        &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneRegolatorio/tns2:sottolavorazione&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneRegolatorio/tns2:sottolavorazione&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:idOfferta ='1'&quot;>&#xa;                                &lt;LNA_LA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;LNA&amp;quot;&quot;/>&#xa;                                &lt;/LNA_LA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;LNA_LA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;LA&amp;quot;&quot;/>&#xa;                                &lt;/LNA_LA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;dettaglioordine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[1]/tns:componente)&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key!='DESTINAZIONEUSOFONIA' and tns:key!='DESTINAZIONEUSODATI']&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:key = 'DESTINAZIONEUSO'&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;tns:key = 'INDICATOREDIASSURANCE'&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;tns:valore = 'Y'&quot;>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:offertaCatalogo = 'ULL'&quot;>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;IDULLCO&amp;quot;&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DESTINAZIONEUSOFONIA']/tns:valore = ('POTS','ISDN BRA','ISDN PRA') or $Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DESTINAZIONEUSODATI']/tns:valore = ('ADSL','SDSL','VDSL','HDSL')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)>0 and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)=0&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONEUSO&amp;quot;&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($RecuperoDestinazioneUsoFonia/Record[1]/COD)=0 and string-length($RecuperoDestinazioneUsoDati/Record[1]/COD)>0&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select