s:valore, '.'))&quot;/>&lt;/ns0:Banda_Picco_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP'&amp;#xD;&amp;#xA; and tns:componente=$currComponent6 and tns:progressivo=$currProgressivo6]/tns:valore&quot;>&lt;ns0:Banda_Picco_UP>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCOUP'&amp;#xD;&amp;#xA; and tns:componente=$currComponent6 and tns:progressivo=$currProgressivo6]/tns:valore&quot;/>&lt;/ns0:Banda_Picco_UP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:UserVlan>&lt;/ns0:UserVlan>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:RiconfigurazioneUserVLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:CambioSla>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ns0:SlaAssurance>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:CambioSla>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:TipoVariazione>&lt;/ns0:VULAFTTH>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns0:Variazione>&lt;/ns0:TipoRichiesta>&lt;/ns0:Richiesta>&lt;/ns0:TracciatoOLONGA>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
