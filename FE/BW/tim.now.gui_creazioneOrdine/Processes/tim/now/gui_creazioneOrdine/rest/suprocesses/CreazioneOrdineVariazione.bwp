                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG =('BitstreamNGAFTTCAB','BitstreamNGAFTTH','VULAFTTCAB','VULAFTTH','EasyIPUBBFTTCAB','EasyIPUBBFTTH','VLANNGA','SEMIBitstreamNGAFTTH','SEMIVULAFTTH','SEMIEasyIPUBBFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToAssign">
                        <tibex:DesignExpression>
