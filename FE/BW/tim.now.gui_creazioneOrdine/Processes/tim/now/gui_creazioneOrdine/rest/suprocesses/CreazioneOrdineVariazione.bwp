                        <bpws:source linkName="CallProcessToCasedataBPMVP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:ns02=&quot;http://vp.telecomitalia.it/crm/vp/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOLOVP&quot;/>&#xa;    &lt;xsl:template name=&quot;DeterminaSottoLavorazioneVP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputSottolavRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                &lt;tns2:codiceRisorsa1>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                &lt;/tns2:codiceRisorsa1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:oao&quot;>&#xa;                &lt;tns2:codificaRecipient>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                &lt;/tns2:codificaRecipient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:offertaCatalogo&quot;>&#xa;                &lt;tns2:OffertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:offertaCatalogo&quot;/>&#xa;                &lt;/tns2:OffertaCatalogo>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:Servizio>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VP&amp;quot;&quot;/>&#xa;            &lt;/tns2:Servizio>&#xa;            &lt;tns2:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Lavorazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($TracciatoOLOVP/ns02:Richiesta/ns02:TipoRichiesta/ns02:Variazione/ns02:TipoVariazione/ns02:VariazioneKIT/ns02:CodiceTDKIT)&quot;>&#xa;                    &lt;tns2:TipoVariazione>&#xa;                        &lt;xsl:value-of select=&quot;upper-case('VariazioneTDKIT')&quot;/>&#xa;                    &lt;/tns2:TipoVariazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:TipoVariazione>&#xa;                        &lt;xsl:value-of select=&quot;upper-case('CaratteristicaVP')&quot;/>&#xa;                    &lt;/tns2:TipoVariazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:inputSottolavRichiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.gui_creazioneOrdine.rest.suprocesses.DeterminaSottoLavorazioneRichiesta" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="BandaNGA-input"
                    name="BandaNGA" outputVariable="BandaNGA"
                    tibex:xpdlId="f88be4d4-a639-4f94-9f46-0f4494af77f2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
