                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoNomeOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;DeterminaSottoLavorazioneRegolatorio-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputSottolavRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                &lt;tns2:codiceRisorsa1>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                &lt;/tns2:codiceRisorsa1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:oao&quot;>&#xa;                &lt;tns2:codificaRecipient>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                &lt;/tns2:codificaRecipient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                &lt;tns2:OffertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                &lt;/tns2:OffertaCatalogo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'ULL'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:idOfferta = '1'&quot;>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ULLLINEAATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG) = 'ULLDATI'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:idOfferta = '3'&quot;>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEANONATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEAATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SLU'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:idOfferta = '5'&quot;>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;SLULINEANONATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;SLULINEAATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SHA'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:idOfferta = '23'&quot;>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;SHACONMANODOPERA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;SHASENZAMANODOPERA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:idOfferta = '22'&quot;>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;WLRLINEANONATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;WLRLINEAATTIVA&amp;quot;&quot;/>&#xa;                            &lt;/tns2:Servizio>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Lavorazione>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTSMultinumero/AggiuntiviISDN)&quot;>&#xa;                &lt;xsl:if test=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTSMultinumero/AggiuntiviISDN&quot;>&#xa;                    &lt;tns2:AggiuntiviISDN>&#xa;                        &lt;xsl:value-of select=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTSMultinumero/AggiuntiviISDN&quot;/>&#xa;                    &lt;/tns2:AggiuntiviISDN>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneULL/DestinazioneUso) or exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneSLU/DestinazioneUso)&quot;>&#xa;                &lt;tns2:destinazioneUso>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns2:destinazioneUso>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneULL/CessSolaNPsuULL-NP)&quot;>&#xa;                &lt;tns2:CessSolaNPsuULL-NP>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns2:CessSolaNPsuULL-NP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneULL/CessSoloUllsuULL-NP)&quot;>&#xa;                &lt;tns2:CessSoloUllsuULL-NP>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns2:CessSoloUllsuULL-NP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneSLU/CessSolaNPsuSLU-NP)&quot;>&#xa;                &lt;tns2:CessSolaNPsuSLU-NP>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns2:CessSolaNPsuSLU-NP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneSLU/CessSoloSLUsuSLU-NP)&quot;>&#xa;                &lt;tns2:CessSoloSLUsuSLU-NP>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns2:CessSoloSLUsuSLU-NP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneULL/CambioCoppia)&quot;>&#xa;                &lt;tns2:CambioCoppia>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns2:CambioCoppia>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneULL/Trasloco)&quot;>&#xa;                &lt;tns2:Trasloco>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns2:Trasloco>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:AttivazioneSTS>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTS)&quot;>&#xa;                    &lt;xsl:if test=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTS&quot;>&#xa;                        &lt;tns2:CodiceSTS>&#xa;                            &lt;xsl:value-of select=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTS&quot;/>&#xa;                        &lt;/tns2:CodiceSTS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTSMultinumero)&quot;>&#xa;                    &lt;tns2:CodiceSTSMultinumero>&#xa;                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                    &lt;/tns2:CodiceSTSMultinumero>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:AttivazioneSTS>&#xa;            &lt;tns2:CessazioneSTS>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/CessazioneSTS/CodiceSTS)&quot;>&#xa;                    &lt;xsl:if test=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/CessazioneSTS/CodiceSTS&quot;>&#xa;                        &lt;tns2:CodiceSTS>&#xa;                            &lt;xsl:value-of select=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/CessazioneSTS/CodiceSTS&quot;/>&#xa;                        &lt;/tns2:CodiceSTS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/CessazioneSTS/CodiceSTSMultinumero)&quot;>&#xa;                    &lt;tns2:CodiceSTSMultinumero>&#xa;                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                    &lt;/tns2:CodiceSTSMultinumero>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:CessazioneSTS>&#xa;            &lt;tns2:PrestazioniWLR>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR)&quot;>&#xa;                    &lt;xsl:if test=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR&quot;>&#xa;                        &lt;tns2:CodicePrestazioneAssociataWLR>&#xa;                            &lt;xsl:value-of select=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR&quot;/>&#xa;                        &lt;/tns2:CodicePrestazioneAssociataWLR>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco)&quot;>&#xa;                    &lt;xsl:if test=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco&quot;>&#xa;                        &lt;tns2:Trasloco>&#xa;                            &lt;xsl:value-of select=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco&quot;/>&#xa;                        &lt;/tns2:Trasloco>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia)&quot;>&#xa;                    &lt;xsl:if test=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia&quot;>&#xa;                        &lt;tns2:CambioTipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;$TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia&quot;/>&#xa;                        &lt;/tns2:CambioTipologiaAccesso>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TracciatoOloRegolatorio/Richiesta/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioCanali)&quot;>&#xa;                    &lt;tns2:CambioCanali>&#xa;                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                    &lt;/tns2:CambioCanali>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:PrestazioniWLR>&#xa;        &lt;/tns2:inputSottolavRichiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.gui_creazioneOrdine.rest.suprocesses.DeterminaSottoLavorazioneRichiesta" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="DeterminaSottoLavorazioneXDSL-input"
                    name="DeterminaSottoLavorazioneXDSL"
                    outputVariable="DeterminaSottoLavorazioneXDSL"
                    tibex:xpdlId="bfc7ca94-f1fb-4cea-a2e2-680196c6f5eb"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TracciatoOloXDSLVariazioneToCopy_1_DeterminaSottoLavorazioneRegolatorio"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_DeterminaSottoLavorazioneRegolatorioToCasedataBPMEasyIP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = ('EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = ('EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="DeterminaSottoLavorazioneXDSLToEmpty2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = ('BitstreamATMAsimmetricoFlat','BitstreamATMSimmetricoFlat', 'BitstreamATMSimmetricoHL', 'BitstreamATMAsimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat','VLAN')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = ('BitstreamATMAsimmetricoFlat','BitstreamATMSimmetricoFlat', 'BitstreamATMSimmetricoHL', 'BitstreamATMAsimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat','VLAN')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoOloXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;DeterminaSottoLavorazioneXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputSottolavRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                &lt;tns2:codiceRisorsa1>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                &lt;/tns2:codiceRisorsa1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:oao&quot;>&#xa;                &lt;tns2:codificaRecipient>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                &lt;/tns2:codificaRecipient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:offertaCatalogo&quot;>&#xa;                &lt;tns2:OffertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:offertaCatalogo&quot;/>&#xa;                &lt;/tns2:OffertaCatalogo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '8'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '39'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMSIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '9'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOHL&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '40'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMSIMMETRICOHL&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '10'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOLITE&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '41'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBESIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '7'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '11'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '12'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSLITE&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '13'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILEFLAT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '63'&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VLAN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILELITE&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Lavorazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMAsimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMSimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamGBEAsimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamGBESimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:EasyIPBasePlus/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:EasyIPSpecialProfile/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso)&quot;>&#xa;                    &lt;tns2:TipoVariazione>&#xa;                        &lt;xsl:value-of select=&quot;upper-case('RiconfigurazioneAccesso')&quot;/>&#xa;                    &lt;/tns2:TipoVariazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMAsimm/ns2:TipoVariazione/ns2:IncrementoDecrementoVC) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMSimm/ns2:TipoVariazione/ns2:IncrementoDecrementoVC) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamGBEAsimm/ns2:TipoVariazione/ns2:IncrementoDecrementoVC) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamGBESimm/ns2:TipoVariazione/ns2:IncrementoDecrementoUserVlan)&quot;>&#xa;                    &lt;tns2:TipoVariazione>&#xa;                        &lt;xsl:value-of select=&quot;upper-case('IncrementoDecrementoVC')&quot;/>&#xa;                    &lt;/tns2:TipoVariazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMAsimm/ns2:TipoVariazione/ns2:CambioSla) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMSimm/ns2:TipoVariazione/ns2:CambioSla) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamGBEAsimm/ns2:TipoVariazione/ns2:CambioSla) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamGBESimm/ns2:TipoVariazione/ns2:CambioSla)&quot;>&#xa;                    &lt;tns2:TipoVariazione>&#xa;                        &lt;xsl:value-of select=&quot;upper-case('CambioSLA')&quot;/>&#xa;                    &lt;/tns2:TipoVariazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:VLAN/ns2:TipoVariazione/ns2:VariazioneBanda) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:VLAN/ns2:TipoVariazione/ns2:VariazioneKIT) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:VLAN/ns2:TipoVariazione/ns2:VariazioneCAR) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:VLAN/ns2:TipoVariazione/ns2:VariazioneNumeroCondivisori)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:VLAN/ns2:TipoVariazione/ns2:VariazioneBanda)&quot;>&#xa;                            &lt;tns2:TipoVariazione>&#xa;                                &lt;xsl:value-of select=&quot;upper-case('VariazioneBanda')&quot;/>&#xa;                            &lt;/tns2:TipoVariazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:VLAN/ns2:TipoVariazione/ns2:VariazioneKIT)&quot;>&#xa;                            &lt;tns2:TipoVariazione>&#xa;                                &lt;xsl:value-of select=&quot;upper-case('VariazioneTDKIT')&quot;/>&#xa;                            &lt;/tns2:TipoVariazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:VLAN/ns2:TipoVariazione/ns2:VariazioneCAR)&quot;>&#xa;                            &lt;tns2:TipoVariazione>&#xa;                                &lt;xsl:value-of select=&quot;upper-case('VariazioneCAR')&quot;/>&#xa;                            &lt;/tns2:TipoVariazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:TipoVariazione>&#xa;                                &lt;xsl:value-of select=&quot;upper-case('VariazioneNumeroCondivisori')&quot;/>&#xa;                            &lt;/tns2:TipoVariazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:TipoVariazione>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:TipoVariazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMAsimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:Caratteristica) and  not((exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMAsimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:Modulazione)or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMAsimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:Flag_Ordine_Unico) or exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMAsimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:ProfiloTecnicoLinea)))&quot;>&#xa;                    &lt;xsl:if test=&quot;$TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMAsimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:Caratteristica&quot;>&#xa;                        &lt;tns2:Caratteristica>&#xa;                            &lt;xsl:value-of select=&quot;$TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMAsimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:Caratteristica&quot;/>&#xa;                        &lt;/tns2:Caratteristica>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMSimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:Caratteristica) and  not(exists($TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMSimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:ProfiloTecnicoLinea))&quot;>&#xa;                    &lt;xsl:if test=&quot;$TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMSimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:Caratteristica&quot;>&#xa;                        &lt;tns2:Caratteristica>&#xa;                            &lt;xsl:value-of select=&quot;$TracciatoOloXDSL/ns2:Richiesta/ns2:TipoRichiesta/ns2:Variazione/ns2:BitstreamATMSimm/ns2:TipoVariazione/ns2:RiconfigurazioneAccesso/ns2:Caratteristica&quot;/>&#xa;                        &lt;/tns2:Caratteristica>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:inputSottolavRichiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
