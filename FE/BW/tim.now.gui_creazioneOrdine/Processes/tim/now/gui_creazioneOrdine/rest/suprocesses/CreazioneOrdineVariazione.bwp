            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoOloNumerico&quot;/>&lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:param name=&quot;TracciatoOloNGA&quot;/>&lt;xsl:param name=&quot;DeterminaSottoLavorazioneNGA&quot;/>&lt;xsl:param name=&quot;CalcoloData&quot;/>&lt;xsl:param name=&quot;calcoloDRO&quot;/>&lt;xsl:param name=&quot;CalcoloGiornoLavorativo&quot;/>&lt;xsl:param name=&quot;OscuramentoIntermediateAgent&quot;/>&lt;xsl:param name=&quot;BandaNGA&quot;/>&lt;xsl:template name=&quot;CasedataBPM&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;'abc'&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Downgrade Fast'&quot;>&lt;note>&lt;xsl:value-of select=&quot;concat('CODICETTM', $Start/tns:idTicketTTM, '|', $Start/tns:noteDaOperatore)&quot;/>&lt;/note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '15'&quot;>&lt;ordine>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;xsl:if test=&quot;$Start/tns:dac&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dad&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&lt;/DAD>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&lt;/cognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&lt;/CF>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&lt;IDSLUCo>&lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&lt;/IDSLUCo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&lt;IDULLCo>&lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&lt;/IDULLCo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&lt;codiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&lt;/codiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&lt;DNOLOCollaudo>&lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&lt;/DNOLOCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&lt;numeroVerdeOloCollaudo>&lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&lt;/numeroVerdeOloCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&lt;numeroVerdeOloPT>&lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&lt;/numeroVerdeOloPT>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:idTicketTTM&quot;>&lt;codiceTTM>&lt;xsl:value-of select=&quot;$Start/tns:idTicketTTM&quot;/>&lt;/codiceTTM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;noteCliente>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/noteCliente>&lt;/xsl:if>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;'abc'&quot;/>&lt;/IDRichiestaOLO>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;xsl:if test=&quot;$DeterminaSottoLavorazioneNGA/tns2:sottolavorazione&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneNGA/tns2:sottolavorazione&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;/xsl:if>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;xsl:if test=&quot;$Start/tns:opzioneVariazione != 'Cambio SLA'&quot;>&lt;dettaglioordine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;nomeComponente>&lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[1]/tns:componente)&quot;/>&lt;/nomeComponente>&lt;integrationID>&lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&lt;/integrationID>&lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key!='SLAASSURANCE' and tns:key!='SLAPROVISIONING' and tns:key!='FLAGNUOVOMODELLO' and tns:key!='INTERMEDIATEAGENTFULL']&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;tns:key&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;tns:valore&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;SLAPROVISIONING&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:variazione='Variazione Tagging'&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;USERVLANID&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key='USERVLANID' and tns:progressivo = '1']/tns:valore&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'INTERMEDIATEAGENTFULL']/tns:valore = 'Y') and ((count($OscuramentoIntermediateAgent/Record)=0) or