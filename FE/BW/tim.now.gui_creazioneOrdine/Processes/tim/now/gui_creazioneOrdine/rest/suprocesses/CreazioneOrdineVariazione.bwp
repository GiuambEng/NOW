            <bpws:empty name="Empty1" tibex:xpdlId="ab2c949a-6dde-4c7c-b2a5-1b88b5eca132">
                <bpws:targets>
                    <bpws:target linkName="MapperAttVCToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToTracciatoOloRegolatorioVariazione_Regolatorio">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG) =('ULL','ULLDATI','SLU','VULL','SHA','WLR')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG) =('ULL','ULLDATI','SLU','VULL','SHA','WLR')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToTracciatoOloXDSLVariazione_XDSL">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG =('BitstreamATMAsimmetricoFlat','BitstreamATMSimmetricoFlat', 'BitstreamATMAsimmetricoHL','BitstreamATMSimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite','VLAN')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG =('BitstreamATMAsimmetricoFlat','BitstreamATMSimmetricoFlat', 'BitstreamATMAsimmetricoHL','BitstreamATMSimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite','VLAN')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToMapper_NGA">
                        <tibex:DesignExpression>
