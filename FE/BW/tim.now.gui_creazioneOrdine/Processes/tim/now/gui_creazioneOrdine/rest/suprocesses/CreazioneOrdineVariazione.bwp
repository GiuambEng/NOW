s:codiceDelivery&quot;/>&#xa;                            &lt;/codiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                            &lt;DNOLOCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                            &lt;/DNOLOCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                            &lt;numeroVerdeOloCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                            &lt;/numeroVerdeOloCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                            &lt;numeroVerdeOloPT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                            &lt;/numeroVerdeOloPT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                            &lt;noteCliente>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                            &lt;/noteCliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                            &lt;codiceOrdineOLOPadre>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                            &lt;/codiceOrdineOLOPadre>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                            &lt;codiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                            &lt;/codiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;tipologiaLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLavorazione>&#xa;                        &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:opzioneVariazione !='Incremento/decremento VC' and $Start/tns:opzioneVariazione !='Cambio SLA'&quot;>&#xa;                            &lt;dettaglioordine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                    &lt;IDRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/IDRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[1]/tns:componente)&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key!='SLAASSURANCE' and tns:key!='SLAPROVISIONING' and tns:key!='CARATTERISTICA']&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;tns:key = 'MODULAZIONE'&quot;>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;tns:valore = 'Interleaved'&quot;>&#xa;                                                        &lt;valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                        &lt;/valoreAttributo>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;tns:valore = 'Fast'&quot;>&#xa;                                                        &lt;valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                        &lt;/valoreAttributo>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                        &lt;/valoreAttributo>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SLAPROVISIONING&amp;quot;&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) > 0&quot;>&#xa;                            &lt;dettaglioordine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Incremento/decremento VC' or $Start/tns:opzioneVariazione = 'Cambio SLA'&quot;>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;IDDettaglioOrdineParent>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDDettaglioOrdineParent>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                    &lt;IDRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/IDRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;PROTOCOLLO&amp;quot;&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Incremento/decremento VC' or $Start/tns:opzioneVariazione = 'Cambio SLA'&quot;>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;xsl:if test=&quot;tns:valore = 'FR' and exists(../tns:sezioneInferiore[tns:key = 'LMI']/tns:valore)&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Incremento/decremento VC' or $Start/tns:opzioneVariazione = 'Cambio SLA'&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;TIPOLMI&amp;quot;&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;../tns:sezioneInferiore[tns:key = 'LMI']/tns:valore&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Variable/tns1:root[tns1:componente !='PROTOCOLLO']&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:opzioneVariazione !='Cambio SLA' and not(exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore))&quot;>&#xa;                                &lt;dettaglioordine>&#xa;                                    &lt;xsl:variable name=&quot;currPosition1&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                    &lt;xsl:variable name=&quot;currComponent1&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition1)+2)&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;IDDettaglioOrdineParent>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdineParent>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                        &lt;IDRisorsa>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                        &lt;/IDRisorsa>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;nomeComponente>&#xa;                                        &lt;xsl:value-of select=&quot;upper-case($currComponent1)&quot;/>&#xa;                                    &lt;/nomeComponente>&#xa;                                    &lt;integrationID>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                                    &lt;/integrationID>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:componente=$currComponent1 and tns:progressivo=$currPosition1]&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:key !='AZIONE' and tns:key !='RICHIESTAMONITORAGGIO'&quot;>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition1)+2)&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tn