                           &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($Start/tns:codiceOrdineTIVlan)&quot;>&#xa;                                    &lt;ns02:TI>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdineTIVlan&quot;/>&#xa;                                    &lt;/ns02:TI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns02:ISP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdineOloVlan&quot;/>&#xa;                                    &lt;/ns02:ISP>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns02:IdRiferimento>&#xa;                        &lt;ns02:TipoVariazione>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($Start/tns:opzioneVariazione) = 'VARIAZIONETDKIT'&quot;>&#xa;                                    &lt;ns02:VariazioneKIT>&#xa;                                        &lt;ns02:CodiceTDKIT>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICETDKIT']/tns:valore&quot;/>&#xa;                                        &lt;/ns02:CodiceTDKIT>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CARATTERISTICAVP']/tns:valore&quot;>&#xa;                                            &lt;ns02:CaratteristicaVP>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CARATTERISTICAVP']/tns:valore&quot;/>&#xa;                                            &lt;/ns02:CaratteristicaVP>&#xa;                                        &lt;/xsl:if>