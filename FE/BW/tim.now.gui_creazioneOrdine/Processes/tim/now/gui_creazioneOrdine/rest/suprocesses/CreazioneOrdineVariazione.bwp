                  &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.')) then&amp;#xD;&amp;#xA; concat(substring-before(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.'),',',substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.'))&amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_UP)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'SCRDOWN'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN),'.')) then&amp;#xD;&amp;#xA; concat(substring-before(xsd:string($RecuperoValoriProfiloVC/Record[1]/SCR_DOWN),'.'