uperiore[tns:key = 'CAPOSTIPITE']/tns:valore&quot;>&#xa;                                                    &lt;Capostipite>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CAPOSTIPITE']/tns:valore&quot;/>&#xa;                                                    &lt;/Capostipite>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'QUANTITALINEE']/tns:valore)&quot;>&#xa;                                                    &lt;QuantitaLinee>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'QUANTITALINEE']/tns:valore)&quot;/>&#xa;                                                    &lt;/QuantitaLinee>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/CessSoloSLUsuSLU-NP>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Start/tns:dac)&quot;>&#xa;                                            &lt;DataDAC>&#xa;                                                &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dac), 9, 2),'/',substring(xsd:string($Start/tns:dac), 6, 2),'/',substring(xsd:string($Start/tns:dac), 1, 4))&quot;/>&#xa;                                            &lt;/DataDAC>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DataDAC>&#xa;                                                &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                                            &lt;/DataDAC>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                        &lt;Referente>&#xa;                                            &lt;Progressivo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                            &lt;/Progressivo>&#xa;                                            &lt;QualificaRef>&#xa;                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                            &lt;/QualificaRef>&#xa;                                            &lt;CognomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                            &lt;/CognomeReferente>&#xa;                                            &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                                &lt;NomeReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                &lt;/NomeReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                &lt;TelefonoFissoReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                &lt;/TelefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                &lt;TelefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                &lt;/TelefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                &lt;EmailReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                &lt;/EmailReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/Referente>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                        &lt;CodiceQualita>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                        &lt;/CodiceQualita>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                        &lt;CodiceDelivery>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                        &lt;/CodiceDelivery>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                        &lt;DataAppuntamentoDesiderata>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                        &lt;/DataAppuntamentoDesiderata>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                        &lt;FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                        &lt;/FasciaOraria>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                                        &lt;DNOLOCollaudo>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                                        &lt;/DNOLOCollaudo>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                                        &lt;NumeroVerdeOloCollaudo>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                                        &lt;/NumeroVerdeOloCollaudo>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                                        &lt;NumeroVerdeOloPT>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                                        &lt;/NumeroVerdeOloPT>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ReferenteOnField>&#xa;                                        &lt;CognomeReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                        &lt;/CognomeReferente>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                            &lt;NomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                            &lt;/NomeReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                            &lt;TelefonoFissoReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                            &lt;/TelefonoFissoReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                            &lt;TelefonoMobileReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                            &lt;/TelefonoMobileReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ReferenteOnField>&#xa;                                &lt;/VariazioneSLU>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;VariazioneWLR>&#xa;                                    &lt;DN>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/DN>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:idOfferta = '22'&quot;>&#xa;                                            &lt;OrigineLinea>&#xa;                                                &lt;xsl:value-of select=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[2]/tns4:codice&quot;/>&#xa;                                            &lt;/OrigineLinea>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:idOfferta = '25'&quot;>&#xa;                                            &lt;OrigineLinea>&#xa;                                                &lt;xsl:value-of select=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[1]/tns4:codice&quot;/>&#xa;                                            &lt;/OrigineLinea>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;OrigineLinea>&#xa;                                                &lt;xsl:value-of select=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[1]/tns4:codice&quot;/>&#xa;                                            &lt;/OrigineLinea>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;DatiCliente>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                                            &lt;CognomeRagSoc>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                            &lt;/CognomeRagSoc>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                            &lt;Nome>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                            &lt;/Nome>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                                                    &lt;CF>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                    &lt;/CF>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                                                    &lt;PIVA>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                    &lt;/PIVA>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/DatiCliente>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Start/tns:dataSottoscrizioneContratto)&quot;>&#xa;                                            &lt;DataSottoscrizioneContratto>&#xa;                                                &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dataSottoscrizioneContratto), 9, 2),'/',substring(xsd:string($Start/tns:dataSottoscrizioneContratto), 6, 2),'/',substring(xsd:string($Start/tns:dataSottoscrizioneContratto), 1, 4))&quot;/>&#xa;                                            &lt;/DataSottoscrizioneContratto>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;DataSottoscrizioneContratto>&#xa;                                                &lt;xsl:value-of select=&quot;'99/99/9999'&quot;/>&#xa;                                            &lt;/DataSottoscrizioneContratto>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Attivazione STS'&quot;>&#xa;                                            &lt;AttivazioneSTS>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;exists($Start/tns:stsDaAttivare)&quot;>&#xa;                                                        &lt;CodiceSTS>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:stsDaAttivare&quot;/>&#xa;                                                        &lt;/CodiceSTS>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;CodiceSTSMultinumero>&#xa;                                                            &lt;AggiuntiviISDN>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:aggiuntiviISDN)&quot;/>&#xa;                                                            &lt;/AggiuntiviISDN>&#xa;                                                        &lt;/CodiceSTSMultinumero>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/AttivazioneSTS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Cessazione STS'&quot;>&#xa;                                            &lt;CessazioneSTS>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;exists($Start/tns:stsDaCessare)&quot;>&#xa;                                                        &lt;CodiceSTS>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:stsDaCessare&quot;/>&#xa;                                                        &lt;/CodiceSTS>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;CodiceSTSMultinumero>&#xa;                                                            &lt;AggiuntiviISDN>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:aggiuntiviISDN)&quot;/>&#xa;                                                            &lt;/AggiuntiviISDN>&#xa;                                                            &lt;xsl:for-each select=&quot;$Start/tns:numerazioneAggiuntiva&quot;>&#xa;                                                                &lt;NumerazioneAggiuntiva>&#xa;                                                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                                &lt;/NumerazioneAggiuntiva>&#xa;                                                            &lt;/xsl:for-each>&#xa;                                                        &lt;/CodiceSTSMultinumero>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/CessazioneSTS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;PrestazioniWLR>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Prestazione'&quot;>&#xa;                                                        &lt;CodicePrestazioneAssociataWLR>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:prestazione&quot;/>&#xa;                                                        &lt;/CodicePrestazioneAssociataWLR>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Trasloco'&quot;>&#xa;                                                        &lt;Trasloco>&#xa;                                                            &lt;CodiceTrasloco>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:codiceTrasloco&quot;/>&#xa;                                                            &lt;/CodiceTrasloco>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FLAGMANTENIMENTOPRODOTTI']/tns:valore = 'Y'&quot;>&#xa;                                                                    &lt;FlagMantenimentoProdotti>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                    &lt;/FlagMantenimentoProdotti>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;FlagMantenimentoProdotti>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                    &lt;/FlagMantenimentoProdotti>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                            &lt;RecapitoTelefonicoCliente>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:recapitoTelefonicoCliente&quot;/>&#xa;                                                            &lt;/RecapitoTelefonicoCliente>&#xa;                                                            &lt;DatiNuovaSede>&#xa;                                                                &lt;ParticellaToponomastica>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                                &lt;/ParticellaToponomastica>&#xa;                                                                &lt;Via>&#xa;                                                                    &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                                &lt;/Via>&#xa;                                                                &lt;Civico>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                                &lt;/Civico>&#xa;                                                                &lt;Localita>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                                &lt;/Localita>&#xa;                                                                &lt;CodiceComune>&#xa;                                                                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                                &lt;/CodiceComune>&#xa;                                                            &lt;/DatiNuovaSede>&#xa;                                                        &lt;/Trasloco>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Cambio Canali (Incremento/Decremento Canali)'&quot;>&#xa;                                                        &lt;CambioCanali>&#xa;                                                            &lt;QuantitaLinee>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'QUANTITALINEE']/tns:valore)&quot;/>&#xa;                                                            &lt;/QuantitaLinee>&#xa;                                                            &lt;Direzionalita>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'DIREZIONALITA']/tns:valore)&quot;/>&#xa;                                                            &lt;/Direzionalita>&#xa;                                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SELEZIONEPASSANTE']/tns:valore)&quot;>&#xa;                                                                &lt;xsl:choose>&#xa;                                                                    &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SELEZIONEPASSANTE']/tns:valore = 'Y'&quot;>&#xa;                                                                        &lt;SelezionePassante>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                        &lt;/SelezionePassante>&#xa;                                                                    &lt;/xsl:when>&#xa;                                                                    &lt;xsl:otherwise>&#xa;                                                                        &lt;SelezionePassante>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                        &lt;/SelezionePassante>&#xa;                                                                    &lt;/xsl:otherwise>&#xa;                                                                &lt;/xsl:choose>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'ACCESSONUMERICO']/tns:valore)&quot;>&#xa;                                                                &lt;xsl:choose>&#xa;                                                                    &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'ACCESSONUMERICO']/tns:valore = 'accesso analogico'&quot;>&#xa;                                                                        &lt;AccessoNumerico>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                        &lt;/AccessoNumerico>&#xa;                                                                    &lt;/xsl:when>&#xa;                                                                    &lt;xsl:otherwise>&#xa;                                                                        &lt;AccessoNumerico>&#xa;                                                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                        &lt;/AccessoNumerico>&#xa;                                                                    &lt;/xsl:otherwise>&#xa;                                                                &lt;/xsl:choose>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/CambioCanali>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;CambioTipologiaAccesso>&#xa;                                                            &lt;CodiceCambioTipologia>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:tipologiaAccesso&quot;/>&#xa;                                                            &lt;/CodiceCambioTipologia>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FLAGMANTENIMENTOPRODOTTI']/tns:valore = 'Y'&quot;>&#xa;                                                                    &lt;FlagMantenimentoProdotti>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                                    &lt;/FlagMantenimentoProdotti>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;FlagMantenimentoProdotti>&#xa;                                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                                    &lt;/FlagMantenimentoProdotti>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/CambioTipologiaAccesso>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/PrestazioniWLR>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                        &lt;CodiceDelivery>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                        &lt;/CodiceDelivery>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                        &lt;DataAppuntamentoDesiderata>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                        &lt;/DataAppuntamentoDesiderata>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                        &lt;FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                        &lt;/FasciaOraria>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                        &lt;CodiceQualita>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                        &lt;/CodiceQualita>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:dac)&quot;>&#xa;                                        &lt;DataDAC>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dac), 9, 2),'/',substring(xsd:string($Start/tns:dac), 6, 2),'/',substring(xsd:string($Start/tns:dac), 1, 4))&quot;/>&#xa;                                        &lt;/DataDAC>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                        &lt;Referente>&#xa;                                            &lt;Progressivo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                            &lt;/Progressivo>&#xa;                                            &lt;QualificaRef>&#xa;                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                            &lt;/QualificaRef>&#xa;                                            &lt;CognomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                            &lt;/CognomeReferente>&#xa;                                            &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                                &lt;NomeReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                &lt;/NomeReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                &lt;TelefonoFissoReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                &lt;/TelefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                &lt;TelefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                &lt;/TelefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                &lt;EmailReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                &lt;/EmailReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/Referente>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                                        &lt;ReferenteOnField>&#xa;                                            &lt;CognomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                            &lt;/CognomeReferente>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                                &lt;NomeReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                                &lt;/NomeReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                                &lt;TelefonoFissoReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                                &lt;/TelefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                                &lt;TelefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                                &lt;/TelefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ReferenteOnField>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/VariazioneWLR>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/Variazione>&#xa;                &lt;/Ordine>&#xa;            &lt;/Richiesta>&#xa;        &lt;/RichiestaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
