                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:tns2=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TracciatoOloNGA&quot;/>&lt;xsl:param name=&quot;ParentalControl&quot;/>&lt;xsl:template name=&quot;DeterminaSottoLavorazioneNGA-input&quot; match=&quot;/&quot;>&lt;tns2:inputSottolavRichiesta>&lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&lt;tns2:codiceRisorsa1>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/tns2:codiceRisorsa1>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:oao&quot;>&lt;tns2:codificaRecipient>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/tns2:codificaRecipient>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:offertaCatalogo&quot;>&lt;tns2:OffertaCatalogo>&lt;xsl:value-of select=&quot;$Start/tns:offertaCatalogo&quot;/>&lt;/tns2:OffertaCatalogo>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '15'&quot;>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '44'&quot;>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '45'&quot;>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '69'&quot;>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '16'&quot;>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '67'&quot;>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '17'&quot;>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;VULAFTTCAB&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '68'&quot;>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;SEMIVULAFTTH&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta = '61'&quot;>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;VLANNGA&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Servizio>&lt;xsl:value-of select=&quot;&amp;quot;VULAFTTH&amp;quot;&quot;/>&lt;/tns2:Servizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&lt;/tns2:Lavorazione>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamNGAFTTCAB/ns0:TipoVariazione/ns0:RiconfigurazioneAccesso) or exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamNGAFTTH/ns0:TipoVariazione/ns0:RiconfigurazioneAccesso) or exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Variazione/ns0:VULAFTTCAB/ns0:TipoVariazione/ns0:RiconfigurazioneAccesso) or exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Variazione/ns0:VULAFTTH/ns0:TipoVariazione/ns0:RiconfigurazioneAccesso) or (exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Variazione/ns0:EasyIPUBBFTTCAB/ns0:TipoVariazione/ns0:RiconfigurazioneAccesso) and exists($TracciatoOloNGA/ns0:Richiesta/ns0:TipoRichiesta/ns0:Variazione/ns0:EasyIPUBBFTTCAB/ns0:TipoVariazione/ns0:RiconfigurazioneAccesso/ns0:ProfiloTecnicoLinea)) 