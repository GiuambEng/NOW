            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ParentalControl"
                    name="TracciatoOloNGAVariazioneParentalControl"
                    outputVariable="ParentalControl"
                    tibex:xpdlId="b3b3f3c1-ce63-4658-998f-92d42e26b67c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperUserVlanIDToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToDeterminaSottoLavorazioneNGA"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga/variazioneparentalcontrol&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoNomeOfferta&quot;/>&lt;xsl:template name=&quot;ParentalControl&quot; match=&quot;/&quot;>&lt;ns1:Richiesta>&lt;ns1:Testata>&lt;ns1:CodiceOlo>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/ns1:CodiceOlo>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;ns1:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/ns1:CodiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;ns1:CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/ns1:CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;ns1:CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/ns1:CodiceProgetto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Downgrade Fast'&quot;>&lt;ns1:Note>&lt;xsl:value-of select=&quot;concat('CODICETTM', $Start/tns:idTicketTTM, '|', $Start/tns:noteDaOperatore)&quot;/>&lt;/ns1:Note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;ns1:Note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/ns1:Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIEasyIPUBBFTTH'&quot;>&lt;ns1:semiEasyIPNGA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns1:semiEasyIPNGA>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIBitstreamNGAFTTH'&quot;>&lt;ns1:semiBitstreamNGA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns1:semiBitstreamNGA>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIVULAFTTH'&quot;>&lt;ns1:semiVULA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns1:semiVULA>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'FULLGPONPLUS' or $RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'FULLGPONPLUSNGA'&quot;>&lt;ns1:FullGPONPLUS>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns1:FullGPONPLUS>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:idReteSecondariaOao&quot;>&lt;ns1:IdReteSecondariaOAO>&lt;xsl:value-of select=&quot;$Start/tns:idReteSecondariaOao&quot;/>&lt;/ns1:IdReteSecondariaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&lt;ns1:ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&lt;/ns1:ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;/ns1:Testata>&lt;ns1:TipoRichiesta>&lt;ns1:Variazione>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG ='EasyIPUBBFTTCAB'&quot;>&lt;ns1:EasyIPUBBFTTCAB>&lt;ns1:IDENTIFICATIVO_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/ns1:IDENTIFICATIVO_RISORSA>&lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&lt;ns1:CodiceQualita>&lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&lt;/ns1:CodiceQualita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&lt;ns1:CodiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&lt;/ns1:CodiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&lt;ns1:DAD>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&lt;/ns1:DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;ns1:FasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/ns1:FasciaOraria>&lt;/xsl:if>&lt;ns1:TipoVariazione>&lt;ns1:VariazioneParentalControl>&lt;ns1:Profilo>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILO']/tns:valore&quot;/>&lt;/ns1:Profilo>&lt;/ns1:VariazioneParentalControl>&lt;/ns1:TipoVariazione>&lt;/ns1:EasyIPUBBFTTCAB>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns1:EasyIPUBBFTTH>&lt;ns1:IDENTIFICATIVO_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/ns1:IDENTIFICATIVO_RISORSA>&lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&lt;ns1:CodiceQualita>&lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&lt;/ns1:CodiceQualita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&lt;ns1:CodiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&lt;/ns1:CodiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&lt;ns1:DAD>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&lt;/ns1:DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;ns1:FasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/ns1:FasciaOraria>&lt;/xsl:if>&lt;ns1:TipoVariazione>&lt;ns1:VariazioneParentalControl>&lt;ns1:Profilo>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILO']/tns:valore&quot;/>&lt;/ns1:Profilo>&lt;/ns1:VariazioneParentalControl>&lt;/ns1:TipoVariazione>&lt;/ns1:EasyIPUBBFTTH>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns1:Variazione>&lt;/ns1:TipoRichiesta>&lt;/ns1:Richiesta>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ParentalControl" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
