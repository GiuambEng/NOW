                    <bpws:targets>
                        <bpws:target linkName="RenderXmlToEnd"/>
                        <bpws:target linkName="NoOfferteToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns02=&quot;http://vp.telecomitalia.it/crm/vp/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga/variazioneparentalcontrol&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RenderXml&quot;/>&lt;xsl:param name=&quot;NoOfferte&quot;/>&lt;xsl:param name=&quot;RecuperoNomeOfferta&quot;/>&lt;xsl:param name=&quot;TracciatoOloRegolatorio&quot;/>&lt;xsl:param name=&quot;TracciatoOloXDSL&quot;/>&lt;xsl:param name=&quot;TracciatoOloNGA&quot;/>&lt;xsl:param name=&quot;CasedataBPM&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TracciatoOLOVP&quot;/>&lt;xsl:param name=&quot;ParentalControl&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RenderXml)&quot;>&lt;tns:OutputLavorazioni>&lt;tns:outputLavorazioni>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG) =('ULL','ULLDATI','SLU','VULL','SHA','WLR')&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloRegolatorio/Richiesta[1],false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG =('BitstreamATMAsimmetricoFlat','BitstreamATMSimmetricoFlat', 'BitstreamATMAsimmetricoHL','BitstreamATMSimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite','VLAN')&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloXDSL/ns2:Richiesta[1],false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG ='VP'&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOLOVP/ns02:Richiesta,false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParentalControl/ns1:Testata)&quot;>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($ParentalControl,false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:contenutoXmlOlo>&lt;xsl:value-of select=&quot;tib:render-xml($TracciatoOloNGA/ns0:Richiesta[1],false(),true())&quot;/>&lt;/tns:contenutoXmlOlo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:xmlString>&lt;xsl:value-of select=&quot;$RenderXml&quot;/>&lt;/tns:xmlString>&lt;tns:codiceOloAgcom>&lt;xsl:value-of select=&quot;$CasedataBPM/codificaOLOAGCOM&quot;/>&lt;/tns:codiceOloAgcom>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;tns:codiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/tns:codiceOrdineOlo>&lt;/xsl:if>&lt;tns:canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns:canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG) =('ULL','ULLDATI','SLU','VULL','SHA','WLR') and $Start/tns:opzioneVariazione = &amp;quot;Destinazione d'uso&amp;quot;&quot;>&lt;tns:strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;VDU&amp;quot;&quot;/>&lt;/tns:strutturaRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG) =('ULL','ULLDATI','SLU','VULL','SHA','WLR') and $Start/tns:opzioneVariazione !=&amp;quot;Destinazione d'uso&amp;quot;&quot;>&lt;tns:strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&lt;/tns:strutturaRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG =('BitstreamATMAsimmetricoFlat','BitstreamATMSimmetricoFlat', 'BitstreamATMAsimmetricoHL','BitstreamATMSimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat','BitstreamGBESimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite','VLAN','VP')&quot;>&lt;tns:strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&lt;/tns:strutturaRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/tns:strutturaRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:outputLavorazioni>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:OutputLavorazioni>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputLavorazioni>&lt;tns:result>&lt;xsl:if test=&quot;$NoOfferte/tns:result/tns:severity&quot;>&lt;tns:severity>&lt;xsl:value-of select=&quot;$NoOfferte/tns:result/tns:severity&quot;/>&lt;/tns:severity>&lt;/xsl:if>&lt;xsl:if test=&quot;$NoOfferte/tns:result/tns:code&quot;>&lt;tns:code>&lt;xsl:value-of select=&quot;$NoOfferte/tns:result/tns:code&quot;/>&lt;/tns:code>&lt;/xsl:if>&lt;xsl:if test=&quot;$NoOfferte/tns:result/tns:details&quot;>&lt;tns:details>&lt;xsl:value-of select=&quot;$NoOfferte/tns:result/tns:details&quot;/>&lt;/tns:details>&lt;/xsl:if>&lt;/tns:result>&lt;/tns:OutputLavorazioni>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TracciatoOloRegolatorio"
                    name="TracciatoOloRegolatorioVariazione"
                    outputVariable="TracciatoOloRegolatorio"
                    tibex:xpdlId="43e8a579-c858-4d8c-a26b-8eab83fed060" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToTracciatoOloRegolatorioVariazione_Regolatorio"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloRegolatorioVariazioneToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/ConfigurazioneFE&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiIstat&quot;/>&#xa;    &lt;xsl:param name=&quot;CallRecuperoServizioOrigine&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDestinazioneUsoFonia&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDestinazioneUsoDati&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoNomeOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciatoOloRegolatorio&quot; match=&quot;/&quot;>&#xa;        &lt;RichiestaOloRegolatorio>&#xa;            &lt;Richiesta>&#xa;                &lt;Testata>&#xa;                    &lt;CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                    &lt;/CodiceOlo>&#xa;                    &lt;CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                    &lt;/CodiceOrdineOlo>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                        &lt;CodiceOrdineOloPadre>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                        &lt;/CodiceOrdineOloPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                        &lt;CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                        &lt;/CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                        &lt;ReferentiOAOProgettiSpeciali>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                        &lt;/ReferentiOAOProgettiSpeciali>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/Testata>&#xa;                &lt;Ordine>&#xa;                    &lt;Variazione>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG) = ('ULL', 'ULLDATI','SHA')&quot;>&#xa;                                &lt;VariazioneULL>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = &amp;quot;Destinazione d'uso&amp;quot;&quot;>&#xa;                                            &lt;DestinazioneUso>&#xa;                                                &lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/DESCR = &amp;quot;FONIA&amp;quot;&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;>&#xa;                                                        &lt;fonia>&#xa;                                                            &lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoFonia/Record[1]/COD&quot;/>&#xa;                                                        &lt;/fonia>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$RecuperoDestinazioneUsoDati/Record[1]/DESCR = &amp;quot;DATI&amp;quot;&quot;>&#xa;                                                    &lt;dati>&#xa;                                                        &lt;TipoDati>&#xa;                                                            &lt;xsl:value-of select=&quot;$RecuperoDestinazioneUsoDati/Record[1]/COD&quot;/>&#xa;                                                        &lt;/TipoDati>&#xa;                                                        &lt;BitRate>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'BITRATE']/tns:valore&quot;/>&#xa;                                                        &lt;/BitRate>&#xa;                                                    &lt;/dati>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:dn&quot;>&#xa;                                                    &lt;DN>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&#xa;                                                    &lt;/DN>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;exists($Start/tns:datiClienteFinale/tns:cognomeRagioneSociale)&quot;>&#xa;                                                    &lt;DatiCliente>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                                                            &lt;CognomeRagSoc>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                            &lt;/CognomeRagSoc>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                                                            &lt;Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                                                            &lt;/Nome>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists($Start/tns:datiClienteFinale/tns:cf)&quot;>&#xa;                                                                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                                                                    &lt;CF>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                                                                    &lt;/CF>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                                                                    &lt;PIVA>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                                                                    &lt;/PIVA>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/DatiCliente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:provincia)&quot;>&#xa;                                                    &lt;Sede>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                                            &lt;ParticellaToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                                            &lt;/ParticellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo)&quot;>&#xa;                                                            &lt;Via>&#xa;                                                                &lt;xsl:value-of select=&quot;substring($Start/tns:indirizzoDatiClienteFinale/tns:indirizzo, 1, 70)&quot;/>&#xa;                                                            &lt;/Via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                                            &lt;Civico>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                                            &lt;/Civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                                            &lt;Localita>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                                            &lt;/Localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                                            &lt;CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                                            &lt;/CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                                            &lt;Complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                                            &lt;/Complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                                            &lt;Scala>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                                            &lt;/Scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                                            &lt;Piano>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                                            &lt;/Piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                                            &lt;Interno>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                                            &lt;/Interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                                            &lt;CodiceIndirizzo>&#xa;                                                                &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                                            &lt;/CodiceIndirizzo>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                                                            &lt;CodiceComune>&#xa;                                                                &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                                            &lt;/CodiceComune>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/Sede>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;IDRisorsa>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                                &lt;/IDRisorsa>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:routingNumber&quot;>&#xa;                                                    &lt;RoutingNumber>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:routingNumber&quot;/>&#xa;                                                    &lt;/RoutingNumber>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CAPOSTIPITE']/tns:valore&quot;>&#xa;                                                    &lt;Capostipite>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CAPOSTIPITE']/tns:valore&quot;/>&#xa;                                                    &lt;/Capostipite>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'QUANTITALINEE']/tns:valore)&quot;>&#xa;                                                    &lt;QuantitaLinee>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'QUANTITALINEE']/tns:valore)&quot;/>&#xa;                                                    &lt;/QuantitaLinee>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;ServizioOriginale>&#xa;                                                    &lt;xsl:value-of select=&quot;$CallRecuperoServizioOrigine/tns4:outputConfigurazioneFE[1]/tns4:codice&quot;/>&#xa;                                                &lt;/ServizioOriginale>&#xa;                                            &lt;/DestinazioneUso>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Decremento NP'&quot;>&#xa;                                            &lt;CessSolaNPsuULL-NP>&#xa;                                                &lt;xsl:if test=&quot;$Start/tns:dn&quot;>&#xa;                                                    &lt;DN>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&#xa;                                                    &lt;/DN>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;RoutingNumber>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:routingNumber&quot;/>&#xa;                                                &lt;/RoutingNumber>&#xa;                                                &lt;DatiCliente>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                                                        &lt;CognomeRagSoc>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                                                        &lt;/CognomeRagSoc>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;     