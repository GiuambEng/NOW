       &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;$MapperAttVC/tns5:sezioneInferiore[tns5:componente=$currComponent3 and tns5:progressivo=$currPosition3]&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) = 1&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) > 1 and xsd:int($progrAzione) >0&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition3) - xsd:int($progrAzione))&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int($currPosition3)&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns5:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns5:valore&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns5:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:idOfferta = '7'&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) = 1&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) > 1 and xsd:int($progrAzione) >0&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition3) - xsd:int($progrAzione))&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int($currPosition3)&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;ENCAPSULATIONRICHIESTA&amp;quot;&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore) > 0&quot;>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;DOUBLETAG&amp;quot;&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;SINGLETAG&amp;quot;&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($currPosition3)&quot;/>&#xa;                                    &lt;/progressivo>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore = 'C'&quot;>&#xa;                                            &lt;azione>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                            &lt;/azione>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore&quot;>&#xa;                                                &lt;azione>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent3 and tns:progressivo=$currPosition3]/tns:valore&quot;/>&#xa;                                                &lt;/azione>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/dettaglioordine>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:provincia)&quot;>&#xa;                            &lt;sede>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDSede>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDSede>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;/>&#x