ns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) > 1 and xsd:int($progrAzione) >0 and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) > 0&quot;>&#xa;                                                        &lt;IDDettaglioOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int((xsd:int(xsd:int($currPosition1) - xsd:int($progrAzione)) +1))&quot;/>&#xa;                                                        &lt;/IDDettaglioOrdine>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) > 1 and xsd:int($progrAzione) >0 and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) = 0&quot;>&#xa;                                                        &lt;IDDettaglioOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition1) - xsd:int($progrAzione))&quot;/>&#xa;                                                        &lt;/IDDettaglioOrdine>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;IDDettaglioOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int($currPosition1)&quot;/>&#xa;                                                        &lt;/IDDettaglioOrdine>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;$MapperAttVC/tns5:sezioneInferiore[tns5:componente=$currComponent1 and tns5:progressivo=$currPosition1]&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) = 1 and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) > 0&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) = 1 and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) = 0&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) > 1 and xsd:int($progrAzione) >0 and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) > 0&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int((xsd:int(xsd:int($currPosition1) - xsd:int($progrAzione)) +1))&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) > 1 and xsd:int($progrAzione) >0 and string-length($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:componente = 'PROTOCOLLO']/tns:valore) = 0&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition1) - xsd:int($progrAzione))&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int($currPosition1)&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>