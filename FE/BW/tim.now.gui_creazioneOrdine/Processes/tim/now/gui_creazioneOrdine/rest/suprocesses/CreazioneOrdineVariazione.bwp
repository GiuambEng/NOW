            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperoOloNumerico-input"
                    name="RecuperoOloNumerico"
                    outputVariable="RecuperoOloNumerico"
                    tibex:xpdlId="0dc5316b-62ec-41d3-b9d6-a1119add1bba" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToRecuperoOloNumerico"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperoOloNumericoToRecuperoDestinazioneUso"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0dc5316b-62ec-41d3-b9d6-a1119add1bba+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoOloNumerico-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:oao)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_OLO&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TracciatoOloXDSL"
                    name="TracciatoOloXDSLVariazione"
                    outputVariable="TracciatoOloXDSL"
                    tibex:xpdlId="d533e9e2-f6d2-4f44-879f-d8979abb05da" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToTracciatoOloXDSLVariazione_XDSL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloXDSLVariazioneToCopy_1_DeterminaSottoLavorazioneRegolatorio"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperAttVC&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoNomeOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciatoOloXDSL&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:TracciatoOLOxDSL>&#xa;            &lt;ns2:Richiesta>&#xa;                &lt;ns2:Testata>&#xa;                    &lt;ns2:CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                    &lt;/ns2:CodiceOlo>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                        &lt;ns2:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                        &lt;/ns2:CodiceOrdineOlo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                        &lt;ns2:CodiceOrdineOloPadre>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                        &lt;/ns2:CodiceOrdineOloPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                        &lt;ns2:CodiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                        &lt;/ns2:CodiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Downgrade Fast'&quot;>&#xa;                            &lt;ns2:Note>&#xa;                                &lt;xsl:value-of select=&quot;concat('CODICETTM', $Start/tns:idTicketTTM, '|', $Start/tns:noteDaOperatore)&quot;/>&#xa;                            &lt;/ns2:Note>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&#xa;                                &lt;ns2:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&#xa;                                &lt;/ns2:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                        &lt;ns2:ReferentiOAOProgettiSpeciali>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                        &lt;/ns2:ReferentiOAOProgettiSpeciali>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns2:Testata>&#xa;                &lt;ns2:TipoRichiesta>&#xa;                    &lt;ns2:Variazione>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = ('BitstreamATMAsimmetricoFlat','BitstreamATMAsimmetricoLite','BitstreamATMAsimmetricoHL')&quot;>&#xa;                                &lt;ns2:BitstreamATMAsimm>&#xa;                                    &lt;ns2:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/ns2:IDENTIFICATIVO_RISORSA>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                        &lt;ns2:CodiceQualita>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                        &lt;/ns2:CodiceQualita>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                        &lt;ns2:CodiceDelivery>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                        &lt;/ns2:CodiceDelivery>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                        &lt;ns2:DAD>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                        &lt;/ns2:DAD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                        &lt;ns2:FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                        &lt;/ns2:FasciaOraria>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns2:TipoVariazione>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = ('Riconfigurazione Accesso', 'Downgrade Fast')&quot;>&#xa;                                                &lt;ns2:RiconfigurazioneAccesso>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='CARATTERISTICA']/tns:valore='FLAT'&quot;>&#xa;                                                            &lt;ns2:Caratteristica>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Caratteristica>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='CARATTERISTICA']/tns:valore='LITE'&quot;>&#xa;                                                            &lt;ns2:Caratteristica>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Caratteristica>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Caratteristica>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Caratteristica>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:flagOrdineUnico = 'Y'&quot;>&#xa;                                                        &lt;ns2:Flag_Ordine_Unico>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:Flag_Ordine_Unico>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;>&#xa;                                                        &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                        &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&#xa;                                                        &lt;ns2:DatiVC>&#xa;                                                            &lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                                            &lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                                            &lt;ns2:VPI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:VPI>&#xa;                                                            &lt;ns2:VCI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:VCI>&#xa;                                                            &lt;ns2:ProfiloVC>&#xa;                                                                &lt;xsl:choose>&#xa;                                                                    &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = 'ABR'&quot;>&#xa;                                                                        &lt;ns2:ABR>&#xa;                                                                            &lt;xsl:i