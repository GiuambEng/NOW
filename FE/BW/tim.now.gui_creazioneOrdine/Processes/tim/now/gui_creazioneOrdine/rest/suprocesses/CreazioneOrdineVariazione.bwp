             &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                            &lt;DAD>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                            &lt;/DAD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                            &lt;codiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                            &lt;/codiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                            &lt;DNOLOCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                            &lt;/DNOLOCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                            &lt;numeroVerdeOloCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                            &lt;/numeroVerdeOloCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                            &lt;numeroVerdeOloPT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                            &lt;/numeroVerdeOloPT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                            &lt;codiceOrdineOLOPadre>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                            &lt;/codiceOrdineOLOPadre>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                            &lt;codiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                            &lt;/codiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;tipologiaLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLavorazione>&#xa;                        &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;dettaglioordine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[1]/tns:componente)&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key!='SLAPROVISIONING' and tns:key!='SLAASSURANCE' and tns:key!='CARATTERISTICA' and tns:key !='MODALITACONSEGNA']&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:key = 'MODULAZIONE'&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;tns:valore = 'Interleaved'&quot;>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;tns:valore = 'Fast'&quot;>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;SLAPROVISIONING&amp;quot;&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:idOfferta = '14'&quot;>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;MODALITACONSEGNA&amp;quot;&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico Virtual Dial UP'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico Virtual Dial UP'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico LAN 8 Virtual Dial UP'&quot;>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivo>&#xa;                        &lt;/dettaglioordine>&#xa;                        &lt;dettaglioordine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;IDDettaglioOrdineParent>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdineParent>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:dateTime(xsd:date(substring(xsd:string(current-date()),1,10)))&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneInferiore[1]/tns:componente)&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore&quot;>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivo>&#xa;                        &lt;/dettaglioordine>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:provincia)&quot;>&#xa;                            &lt;sede>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDSede>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDSede>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;/>&#xa;                                    &lt;/via>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                    &lt;/civico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;>&#xa;                                    &lt;comune>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;/>&#xa;                                    &lt;/comune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;>&#xa;                                    &lt;provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;/>&#xa;                                    &lt;/provincia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                    &lt;CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                    &lt;/CAP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                    &lt;complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                    &lt;/complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;>&#xa;                                    &lt;interno>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;/>&#xa;                                    &lt;/interno>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;>&#xa;                                    &lt;scala>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:scala&quot;/>&#xa;                                    &lt;/scala>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;>&#xa;                                    &lt;piano>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:piano&quot;/>&#xa;                                    &lt;/piano>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                                    &lt;codiceISTATComune>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                                    &lt;/codiceISTATComune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;exists($RecuperoDatiIstat/Record/COD_ISTAT_PROV)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_PROV&quot;>&#xa;                                        &lt;codiceISTATProvincia>&#xa;                                            &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_PROV&quot;/>&#xa;                                        &lt;/codiceISTATProvincia>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;>&#xa;                                    &lt;codiceToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_TOPON&quot;/>&#xa;                                    &lt;/codiceToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tipologiaSede>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SEDECLIENTE&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaSede>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                            &lt;/sede>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;../tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;tns:progressivoReferente&quot;>&#xa;                                    &lt;progressivoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                    &lt;/progressivoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;tns:qualifica&quot;>&#xa;                                    &lt;qualificaReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                    &lt;/qualificaReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                    &lt;emailReferente>&#xa;                                        &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                    &lt;/emailReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;Y&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;tns:flagToken = &amp;quot;N&amp;quot;&quot;>&#xa;                                        &lt;flag_Token>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                        &lt;/flag_Token>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:datiReferentiOnField/tns:cognomeOnField)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEONFIELD&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;>&#xa;                                    &lt;cognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cognomeOnField&quot;/>&#xa;                                    &lt;/cognomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;>&#xa;                                    &lt;nomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:nomeOnField&quot;/>&#xa;                                    &lt;/nomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:telefonoFissoOnField&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:datiReferentiOnField/tns:cellulareOnField&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:refOaoProgettiSpeciali)&quot;>&#xa;                            &lt;referente>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                                    &lt;refOAOProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                                    &lt;/refOAOProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                            &lt;tipologiaQualita>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                            &lt;/tipologiaQualita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILELITE&amp;quot;&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;codiceSLAAssurance>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                        &lt;/codiceSLAAssurance>&#xa;                    &lt;/ordine>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:idContratto&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:idContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;>&#xa;                &lt;ISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperoDatiIstat/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                &lt;/ISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                &lt;localita>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                &lt;/localita>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '11'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSFLAT&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '12'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSLITE&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta ='13'&quot;>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILEFLAT&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILELITE&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                &lt;DAD>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                &lt;/DAD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                &lt;IDFasciaOraria>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                &lt;/IDFasciaOraria>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns3:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloData.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dn&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='CARATTERISTICA']/tns:valore='FLAT'&quot;>&#xa;                    &lt;caratteristica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                    &lt;/caratteristica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;caratteristica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/caratteristica>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;>&#xa;                &lt;tipologiaSottolav>&#xa;                    &lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;/>&#xa;                &lt;/tipologiaSottolav>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="CasedataBPM" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="InputCreateProcessBPM-input"
                    name="InputCreateProcessBPM"
