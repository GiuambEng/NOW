sl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;tipoReferenteOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                &lt;/tipoReferenteOrdine>&#xa;                                &lt;flag_Token>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                &lt;/flag_Token>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&#xa;                                    &lt;refOAOProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&#xa;                                    &lt;/refOAOProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                            &lt;tipologiaQualita>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                            &lt;/tipologiaQualita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMSIMMETRICO&amp;quot;&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;codiceSLAAssurance>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/codiceSLAAssurance>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ordine>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:idOfferta = '10'&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOLITE&amp;quot;&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dac&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dad&quot;>&#xa;                            &lt;DAD>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&#xa;                            &lt;/DAD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:cf&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:datiClienteFinale/tns:p_iva&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idsluco&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idsluco&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idullco&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idullco&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                            &lt;codiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                            &lt;/codiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:dnOperatoreCollaudo&quot;>&#xa;                            &lt;DNOLOCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:dnOperatoreCollaudo&quot;/>&#xa;                            &lt;/DNOLOCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;>&#xa;                            &lt;numeroVerdeOloCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatoreCollaudo&quot;/>&#xa;                            &lt;/numeroVerdeOloCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:numeroVerdeOperatorePT&quot;>&#xa;                            &lt;numeroVerdeOloPT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:numeroVerdeOperatorePT&quot;/>&#xa;                            &lt;/numeroVerdeOloPT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperoOloNumerico/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&#xa;                            &lt;codiceOrdineOLOPadre>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&#xa;                            &lt;/codiceOrdineOLOPadre>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&#xa;                            &lt;codiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&#xa;                            &lt;/codiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;'abc'&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;tipologiaLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLavorazione>&#xa;                        &lt;xsl:if test=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneXDSL/tns2:sottolavorazione&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:operatore&quot;>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:opzioneVariazione !='Incremento/decremento VC' and $Start/tns:opzioneVariazione !='Cambio SLA'&quot;>&#xa;                            &lt;dettaglioordine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                    &lt;IDRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/IDRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneSuperiore[1]/tns:componente)&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key!='SLAASSURANCE' and tns:key!='SLAPROVISIONING' and tns:key!='CARATTERISTICA']&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;tns:key = 'MODULAZIONE'&quot;>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;tns:valore = 'Interleaved'&quot;>&#xa;                                                        &lt;valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                        &lt;/valoreAttributo>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;tns:valore = 'Fast'&quot;>&#xa;                                                        &lt;valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                        &lt;/valoreAttributo>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                        &lt;/valoreAttributo>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAPROVISIONING']/tns:valore = 'Y'&quot;>&#xa;                                    &lt;attributiDettaglioOrdine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SLAPROVISIONING&amp;quot;&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                    &lt;/attributiDettaglioOrdine>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:opzioneVariazione !='Cambio SLA' and not(exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore))&quot;>&#xa;                                &lt;dettaglioordine>&#xa;                                    &lt;xsl:variable name=&quot;currPosition2&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                    &lt;xsl:variable name=&quot;currComponent2&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2)+1)&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;IDDettaglioOrdineParent>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdineParent>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                        &lt;IDRisorsa>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                        &lt;/IDRisorsa>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;nomeComponente>&#xa;                                        &lt;xsl:value-of select=&quot;upper-case($currComponent2)&quot;/>&#xa;                                    &lt;/nomeComponente>&#xa;                                    &lt;integrationID>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                                    &lt;/integrationID>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:componente=$currComponent2 and tns:progressivo=$currPosition2]&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:key !='AZIONE'&quot;>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;IDDettaglioOrdine>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2)+1)&quot;/>&#xa;                                                &lt;/IDDettaglioOrdine>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;$MapperAttVC/tns5:sezioneInferiore[tns5:componente=$currComponent2 and tns5:progressivo=$currPosition2]&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2)+1)&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns5:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns5:valore&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns5:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($currPosition2)&quot;/>&#xa;                                    &lt;/progressivo>&#xa;                                &lt;/dettaglioordine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore)&quot;>&#xa;                                &lt;dettaglioordine>&#xa;                                    &lt;xsl:variable name=&quot;currPosition2&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                    &lt;xsl:variable name=&quot;currComponent2&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) = 1&quot;>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) > 1 and xsd:int($progrAzione) >0&quot;>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2) - xsd:int($progrAzione))&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;IDDettaglioOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int($currPosition2)&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;IDDettaglioOrdineParent>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioOrdineParent>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                        &lt;IDRisorsa>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                        &lt;/IDRisorsa>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;nomeComponente>&#xa;                                        &lt;xsl:value-of select=&quot;upper-case($currComponent2)&quot;/>&#xa;                                    &lt;/nomeComponente>&#xa;                                    &lt;integrationID>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                                    &lt;/integrationID>&#xa;                                    &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:componente=$currComponent2 and tns:progressivo=$currPosition2]&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns:key !='AZIONE'&quot;>&#xa;                                            &lt;attributiDettaglioOrdine>&#xa;                                                &lt;IDRichiestaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                                &lt;/IDRichiestaOLO>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) = 1&quot;>&#xa;                                                        &lt;IDDettaglioOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                        &lt;/IDDettaglioOrdine>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) > 1 and xsd:int($progrAzione) >0&quot;>&#xa;                                                        &lt;IDDettaglioOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2) - xsd:int($progrAzione))&quot;/>&#xa;                                                        &lt;/IDDettaglioOrdine>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;IDDettaglioOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int($currPosition2)&quot;/>&#xa;                                                        &lt;/IDDettaglioOrdine>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                                &lt;/nomeAttributo>&#xa;                                                &lt;valoreAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                                &lt;/valoreAttributo>&#xa;                                                &lt;tipologiaDato>&#xa;                                                    &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                                &lt;/tipologiaDato>&#xa;                                            &lt;/attributiDettaglioOrdine>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;$MapperAttVC/tns5:sezioneInferiore[tns5:componente=$currComponent2 and tns5:progressivo=$currPosition2]&quot;>&#xa;                                        &lt;attributiDettaglioOrdine>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) = 1&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;count($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE']/tns:valore) > 1 and xsd:int($progrAzione) >0&quot;>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int(xsd:int($currPosition2) - xsd:int($progrAzione))&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;IDDettaglioOrdine>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int($currPosition2)&quot;/>&#xa;                                                    &lt;/IDDettaglioOrdine>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns5:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns5:valore&quot;/>&#xa;                                            &lt;/valoreAttributo>&#xa;                                            &lt;tipologiaDato>&#xa;                                                &lt;xsl:value-of select=&quot;tns5:tipologiaDato&quot;/>&#xa;                                            &lt;/tipologiaDato>&#xa;                                        &lt;/attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($currPosition2)&quot;/>&#xa;                                    &lt;/progressivo>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]/tns:valore = 'C'&quot;>&#xa;                                            &lt;azione>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                            &lt;/azione>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]/tns:valore&quot;>&#xa;                                                &lt;azione>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent2 and tns:progressivo=$currPosition2]/tns:valore&quot;/>&#xa;                                                &lt;/azione>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/dettaglioordine>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:provincia)&quot;>&#xa;                            &lt;sede>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDSede>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDSede>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;/>&#xa;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:indirizzo&quot;/>&#xa;                                    &lt;/via>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:civico&quot;/>&#xa;                                    &lt;/civico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;>&#xa;                                    &lt;comune>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:comune&quot;/>&#xa;                                    &lt;/comune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;>&#xa;                                    &lt;provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:provincia&quot;/>&#xa;                                    &lt;/provincia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;>&#xa;                                    &lt;CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:cap&quot;/>&#xa;                                    &lt;/CAP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;>&#xa;                                    &lt;complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:complesso&quot;/>&#xa;                                    &lt;/complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;>&#xa;                                    &lt;interno>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:interno&quot;/>&#xa;                                    &lt;/interno>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoD