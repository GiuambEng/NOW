                    tibex:xpdlId="dad9d8b7-00d1-43f3-8ed8-bffdb728d8f1"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TracciatoOloNGAVariazioneToCopy_1_DeterminaSottoLavorazioneXDSL"/>
