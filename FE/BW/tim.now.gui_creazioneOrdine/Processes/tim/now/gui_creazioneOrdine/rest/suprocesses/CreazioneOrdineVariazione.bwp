            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="TracciatoOloNGA"
                    name="TracciatoOloNGAVariazione"
                    outputVariable="TracciatoOloNGA"
                    tibex:xpdlId="f5bb3e08-ad99-4545-b0f9-883792d723b4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperUserVlanIDToTracciatoOloNGAVariazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TracciatoOloNGAVariazioneToCopy_1_DeterminaSottoLavorazioneXDSL"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:param name=&quot;MapperUserVlanID&quot;/>&lt;xsl:param name=&quot;RecuperoNomeOfferta&quot;/>&lt;xsl:param name=&quot;OscuramentoIntermediateAgent&quot;/>&lt;xsl:template name=&quot;TracciatoOloNGA&quot; match=&quot;/&quot;>&lt;ns0:TracciatoOLONGA>&lt;ns0:Richiesta>&lt;ns0:Testata>&lt;ns0:CodiceOlo>&lt;xsl:value-of select=&quot;$Start/tns:oao&quot;/>&lt;/ns0:CodiceOlo>&lt;xsl:if test=&quot;$Start/tns:codiceOrdine&quot;>&lt;ns0:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdine&quot;/>&lt;/ns0:CodiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceOrdinePadre&quot;>&lt;ns0:CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$Start/tns:codiceOrdinePadre&quot;/>&lt;/ns0:CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceProgetto&quot;>&lt;ns0:CodiceProgetto>&lt;xsl:value-of select=&quot;$Start/tns:codiceProgetto&quot;/>&lt;/ns0:CodiceProgetto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Downgrade Fast'&quot;>&lt;ns0:Note>&lt;xsl:value-of select=&quot;concat('CODICETTM', $Start/tns:idTicketTTM, '|', $Start/tns:noteDaOperatore)&quot;/>&lt;/ns0:Note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:noteDaOperatore&quot;>&lt;ns0:Note>&lt;xsl:value-of select=&quot;$Start/tns:noteDaOperatore&quot;/>&lt;/ns0:Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIEasyIPUBBFTTH'&quot;>&lt;ns0:semiEasyIPNGA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:semiEasyIPNGA>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIBitstreamNGAFTTH'&quot;>&lt;ns0:semiBitstreamNGA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:semiBitstreamNGA>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'SEMIVULAFTTH'&quot;>&lt;ns0:semiVULA>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:semiVULA>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'FULLGPONPLUS' or $RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'FULLGPONPLUSNGA'&quot;>&lt;ns0:FullGPONPLUS>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:FullGPONPLUS>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:idReteSecondariaOao&quot;>&lt;ns0:IdReteSecondariaOAO>&lt;xsl:value-of select=&quot;$Start/tns:idReteSecondariaOao&quot;/>&lt;/ns0:IdReteSecondariaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:refOaoProgettiSpeciali&quot;>&lt;ns0:ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$Start/tns:refOaoProgettiSpeciali&quot;/>&lt;/ns0:ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;/ns0:Testata>&lt;ns0:TipoRichiesta>&lt;ns0:Variazione>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'BitstreamNGAFTTCAB'&quot;>&lt;ns0:BitstreamNGAFTTCAB>&lt;ns0:IDENTIFICATIVO_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/ns0:IDENTIFICATIVO_RISORSA>&lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&lt;ns0:CodiceQualita>&lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&lt;/ns0:CodiceQualita>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&lt;ns0:CodiceDelivery>&lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&lt;/ns0:CodiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&lt;ns0:DAD>&lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&lt;/ns0:DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;ns0:FasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/ns0:FasciaOraria>&lt;/xsl:if>&lt;ns0:TipoVariazione>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = ('Riconfigurazione Accesso', 'Downgrade Fast')&quot;>&lt;ns0:RiconfigurazioneAccesso>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:variazione = 'Profilo Tecnico Linea'&quot;>&lt;xsl:if test=&quot;$Start/tns:profiloTecnicoLineaAsset !=$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;>&lt;ns0:ProfiloTecnicoLinea>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&lt;/ns0:ProfiloTecnicoLinea>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&lt;ns0:UserVlan>&lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;current()/tns1:progressivo&quot;/>&lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns1:componente&quot;/>&lt;xsl:if test=&quot;$MapperUserVlanID/inputUserVlanId[componente=$currComponent and progressivo=$currProgressivo]/userVlanId&quot;>&lt;ns0:UserVlan_ID>&lt;xsl:value-of select=&quot;$MapperUserVlanID/inputUserVlanId[componente=$currComponent and progressivo=$currProgressivo]/userVlanId&quot;/>&lt;/ns0:UserVlan_ID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'FLAGMULTICAST' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)>0&quot;>&lt;ns0:FlagMulticast>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/ns0:FlagMulticast>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'ENCAPSULATION']/tns:valore = 'SINGLETAG'&quot;>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;>&lt;ns0:CodeVlanSingleTag>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&lt;/ns0:CodeVlanSingleTag>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;>&lt;ns0:SVlanCode>&lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&lt;/ns0:SVlanCode>&lt;/xsl:if>&lt;ns0:CVLAN_ID>&lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&lt;/ns0:CVLAN_ID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;>&lt;ns0:Profilo_BMD>&lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&lt;/ns0:Profilo_BMD>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN'&amp;#xD;&amp;#xA; and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = &amp;quot;0.42&amp;quot;) or ($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN'&amp;#xD;&amp;#xA; and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = &amp;quot;0,42&amp;quot;) or ($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN'&amp;#xD;&amp;#xA; and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = &amp;quot;.42&amp;quot;)&quot;>&lt;ns0:Banda_Picco_Down>&lt;xsl:value-of select=&quot;&amp;quot;0,420&amp;quot;&quot;/>&lt;/ns0:Banda_Picco_Down>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN'&amp;#xD;&amp;#xA; and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = &amp;quot;0.13&amp;quot;) or ($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN'&amp;#xD;&amp;#xA; and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = &amp;quot;0,13&amp;quot;) or ($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN'&amp;#xD;&amp;#xA; and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = &amp;quot;.13&amp;quot;)&quot;>&lt;ns0:Banda_Picco_Down>&lt;xsl:value-of select=&quot;&amp;quot;0,130&amp;quot;&quot;/>&lt;/ns0:Banda_Picco_Down>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN'&amp;#xD;&amp;#xA; and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = &amp;quot;1.2&amp;quot;&quot;>&lt;ns0:Banda_Picco_Down>&lt;xsl:value-of select=&quot;&amp;quot;1,200&amp;quot;&quot;/>&lt;/ns0:Banda_Picco_Down>&lt;/xsl:when>&lt;xsl:when test=&quot;contains(string($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDAPICCODOWN'&amp;#xD;&amp;#xA; and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore),'.')&quot;>&lt;ns0:Banda_Picco_Down>&lt;xsl:value-of select=&quot;concat(subst