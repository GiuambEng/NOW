tns:idOfferta ='61'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;VLANNGA&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta ='77'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUS&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:idOfferta ='78'&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUSNGA&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;VULAFTTH&amp;quot;&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;$Start/tns:dad&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;$Start/tns:dad&quot;/>&lt;/DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&lt;IDFasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&lt;/IDFasciaOraria>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns:idOfferta)&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($Start/tns:idOfferta)&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns3:Response/tns3:outputDate) !=0&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo/parameters/tns3:Response/tns3:outputDate&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;$CalcoloData/parameters/tns3:Response/tns3:outputDate&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:dn&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns:dn&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:dac&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$Start/tns:dac&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;xsl:if test=&quot;$DeterminaSottoLavorazioneNGA/tns2:sottolavorazione&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;$DeterminaSottoLavorazioneNGA/tns2:sottolavorazione&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
