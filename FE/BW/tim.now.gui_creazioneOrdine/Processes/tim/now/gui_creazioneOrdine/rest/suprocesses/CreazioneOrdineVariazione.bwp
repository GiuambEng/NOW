                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty2ToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'VLAN'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
