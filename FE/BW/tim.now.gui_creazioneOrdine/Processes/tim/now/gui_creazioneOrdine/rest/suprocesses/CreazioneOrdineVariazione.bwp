value-of select=&quot;1&quot;/>&#xa;                                            &lt;/IDDettaglioOrdine>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;nomeAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                            &lt;/nomeAttributo>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;tns:valore = 'Y'&quot;>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/valoreAttributo>&#xa;                                                &lt;/xsl:otherwise>&#xa;                            