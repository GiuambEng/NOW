 &lt;/ns2:CodiceTD>&#xa;                                                                                &lt;/ns2:BandaDedicata>&#xa;                                                                            &lt;/ns2:Consegna>&#xa;                                                                        &lt;/ns2:VBR>&#xa;                                                                    &lt;/xsl:otherwise>&#xa;                                                                &lt;/xsl:choose>&#xa;                                                            &lt;/ns2:ProfiloVC>&#xa;                                                        &lt;/ns2:DatiVC>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns2:IncrementoDecrementoVC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:CambioSla>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns2:CambioSla>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:TipoVariazione>&#xa;                                &lt;/ns2:BitstreamATMAsimm>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = ('BitstreamATMSimmetricoFlat','BitstreamATMSimmetricoHL')&quot;>&#xa;                                &lt;ns2:BitstreamATMSimm>&#xa;                                    &lt;ns2:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/ns2:IDENTIFICATIVO_RISORSA>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                        &lt;ns2:CodiceQualita>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                        &lt;/ns2:CodiceQualita>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                        &lt;ns2:CodiceDelivery>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                        &lt;/ns2:CodiceDelivery>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                        &lt;ns2:DAD>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                        &lt;/ns2:DAD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                        &lt;ns2:FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                        &lt;/ns2:FasciaOraria>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns2:TipoVariazione>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Riconfigurazione Accesso'&quot;>&#xa;                                                &lt;ns2:RiconfigurazioneAccesso>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='CARATTERISTICA']/tns:valore='FLAT'&quot;>&#xa;                                                            &lt;ns2:Caratteristica>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Caratteristica>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Caratteristica>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:Caratteristica>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;>&#xa;                                                        &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                        &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:DatiVC>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOPROTOCOLLO']/tns:valore = 'FR'&quot;>&#xa;                                                                &lt;ns2:FR>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root[tns1:componente!='PROTOCOLLO']&quot;>&#xa;                                                                        &lt;ns2:VC>&#xa;                                                                            &lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                                                            &lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                                                            &lt;ns2:DLCI>&#xa;                                                                                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'DLCI' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                                            &lt;/ns2:DLCI>&#xa;                                                                            &lt;ns2:ProfiloVC>&#xa;                                                                                &lt;ns2:ABR>&#xa;                                                                                    &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='MCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;>&#xa;                                                                                        &lt;ns2:MCR>&#xa;                                                                                            &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='MCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                                        &lt;/ns2:MCR>&#xa;                                                                                    &lt;/xsl:if>&#xa;                                                                                    &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;>&#xa;                                                                                        &lt;ns2:PCR>&#xa;                                                                                            &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                                        &lt;/ns2:PCR>&#xa;                                                                                    &lt;/xsl:if>&#xa;                                                                                    &lt;ns2:Consegna>&#xa;                                                                                        &lt;xsl:if test=&quot;if($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'RICHIESTAMONITORAGGIO']/tns:valore = 'Y') then &amp;quot;SI&amp;quot; else ()&quot;>&#xa;                                                                                            &lt;ns2:RichiestaMonitoraggio>&#xa;                                                                                                &lt;xsl:value-of select=&quot;if($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'RICHIESTAMONITORAGGIO']/tns:valore = 'Y') then &amp;quot;SI&amp;quot; else ()&quot;/>&#xa;                                                                                            &lt;/ns2:RichiestaMonitoraggio>&#xa;                                                                                        &lt;/xsl:if>&#xa;                                                                                        &lt;xsl:choose>&#xa;                                                                                            &lt;xsl:when test=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOBANDACONSEGNA' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore) = 'DEDICATA'&quot;>&#xa;                                                                                                &lt;ns2:BandaDedicata>&#xa;                                                                                                    &lt;ns2:CodiceTD>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                                    &lt;/ns2:CodiceTD>&#xa;                                                                                                &lt;/ns2:BandaDedicata>&#xa;                                                                                            &lt;/xsl:when>&#xa;                                                                                            &lt;xsl:otherwise>&#xa;                                                                                                &lt;ns2:BandaCondivisa>&#xa;                                                                                                    &lt;ns2:CodiceVP>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICEVP' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                                    &lt;/ns2:CodiceVP>&#xa;                                                                                                &lt;/ns2:BandaCondivisa>&#xa;                                                                                            &lt;/xsl:otherwise>&#xa;                                                                                        &lt;/xsl:choose>&#xa;                                                                                    &lt;/ns2:Consegna>&#xa;                                                                                &lt;/ns2:ABR>&#xa;                                                                            &lt;/ns2:ProfiloVC>&#xa;                                                                        &lt;/ns2:VC>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns2:FR>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:ATM>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&#xa;                                                                        &lt;ns2:VC>&#xa;                                                                            &lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                                                            &lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                                                            &lt;ns2:VCI>&#xa;                                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                                            &lt;/ns2:VCI>&#xa;                                                                            &lt;ns2:VPI>&#xa;                                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                                            &lt;/ns2:VPI>&#xa;                                                                            &lt;ns2:ProfiloVC>&#xa;                                                                                &lt;xsl:choose>&#xa;                                                                                    &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = 'ABR'&quot;>&#xa;                                                                                        &lt;ns2:ABR>&#xa;                                                                                            &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='MCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;>&#xa;                                                                                                &lt;ns2:MCR>&#xa;                                                                                                    &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='MCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                                                &lt;/ns2:MCR>&#xa;                                                                                            &lt;/xsl:if>&#xa;                                                                                            &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;>&#xa;                                                                                                &lt;ns2:PCR>&#xa;                                                                                                    &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                                                &lt;/ns2:PCR>&#xa;                                                                                            &lt;/xsl:if>&#xa;                                                                                            &lt;ns2:Consegna>&#xa;                                                                                                &lt;xsl:if test=&quot;if($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'RICHIESTAMONITORAGGIO']/tns:valore = 'Y') then &amp;quot;SI&amp;quot; else ()&quot;>&#xa;                                                                                                    &lt;ns2:RichiestaMonitoraggio>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;if($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'RICHIESTAMONITORAGGIO']/tns:valore = 'Y') then &amp;quot;SI&amp;quot; else ()&quot;/>&#xa;                                                                                                    &lt;/ns2:RichiestaMonitoraggio>&#xa;                                                                                                &lt;/xsl:if>&#xa;                                                                                                &lt;xsl:choose>&#xa;                                                                                                    &lt;xsl:when test=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOBANDACONSEGNA' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore) = 'DEDICATA'&quot;>&#xa;                                                                                                        &lt;ns2:BandaDedicata>&#xa;                                                                                                            &lt;ns2:CodiceTD>&#xa;                                                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                                            &lt;/ns2:CodiceTD>&#xa;                                                                                                        &lt;/ns2:BandaDedicata>&#xa;                                                                                                    &lt;/xsl:when>&#xa;                                                                                                    &lt;xsl:otherwise>&#xa;                                                                                                        &lt;ns2:BandaCondivisa>&#xa;                                                                                                            &lt;ns2:CodiceVP>&#xa;                                                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICEVP' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                                            &lt;/ns2:CodiceVP>&#xa;                                                                                                        &lt;/ns2:BandaCondivisa>&#xa;                                                                                                    &lt;/xsl:otherwise>&#xa;                                                                                                &lt;/xsl:choose>&#xa;                                                                                            &lt;/ns2:Consegna>&#xa;                                                                                        &lt;/ns2:ABR>&#xa;                                                                                    &lt;/xsl:when>&#xa;                                                                                    &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore = 'CBR'&quot;>&#xa;                                                                                        &lt;ns2:CBR>&#xa;                                                                                            &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;>&#xa;                                                                                                &lt;ns2:PCR>&#xa;                                                                                                    &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                                                &lt;/ns2:PCR>&#xa;                                                                                            &lt;/xsl:if>&#xa;                                                                                            &lt;ns2:Consegna>&#xa;                                                                                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'RICHIESTAMONITORAGGIO']/tns:valore = 'Y'&quot;>&#xa;                                                                                                    &lt;ns2:RichiestaMonitoraggio>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                                                    &lt;/ns2:RichiestaMonitoraggio>&#xa;                                                                                                &lt;/xsl:if>&#xa;                                                                                                &lt;ns2:BandaDedicata>&#xa;                                                                                                    &lt;ns2:CodiceTD>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                                    &lt;/ns2:CodiceTD>&#xa;                                                                                                &lt;/ns2:BandaDedicata>&#xa;                                                                                            &lt;/ns2:Consegna>&#xa;                                                                                        &lt;/ns2:CBR>&#xa;                                                                                    &lt;/xsl:when>&#xa;                                                                                    &lt;xsl:otherwise>&#xa;                                                                                        &lt;ns2:VBR>&#xa;                                                                                            &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='SCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;>&#xa;                                                                                                &lt;ns2:SCR>&#xa;                                                                                                    &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='SCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                                                &lt;/ns2:SCR>&#xa;                                                                                            &lt;/xsl:if>&#xa;                                                                                            &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;>&#xa;                                                                                                &lt;ns2:PCR>&#xa;                                                                                                    &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent and tns4:progressivo=$currProgressivo]/tns4:valore&quot;/>&#xa;                                                                                                &lt;/ns2:PCR>&#xa;                                                                                            &lt;/xsl:if>&#xa;                                                                                            &lt;ns2:Consegna>&#xa;                                                                                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'RICHIESTAMONITORAGGIO']/tns:valore = 'Y'&quot;>&#xa;                                                                                                    &lt;ns2:RichiestaMonitoraggio>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                                                                    &lt;/ns2:RichiestaMonitoraggio>&#xa;                                                                                                &lt;/xsl:if>&#xa;                                                                                                &lt;ns2:BandaDedicata>&#xa;                                                                                                    &lt;ns2:CodiceTD>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                                                                    &lt;/ns2:CodiceTD>&#xa;                                                                                                &lt;/ns2:BandaDedicata>&#xa;                                                                                            &lt;/ns2:Consegna>&#xa;                                                                                        &lt;/ns2:VBR>&#xa;                                                                                    &lt;/xsl:otherwise>&#xa;                                                                                &lt;/xsl:choose>&#xa;                                                                            &lt;/ns2:ProfiloVC>&#xa;                                                                        &lt;/ns2:VC>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns2:ATM>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:DatiVC>&#xa;                                                &lt;/ns2:RiconfigurazioneAccesso>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Incremento/decremento VC'&quot;>&#xa;                                                &lt;ns2:IncrementoDecrementoVC>&#xa;                                                    &lt;ns2:DatiVC>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'TIPOPROTOCOLLO']/tns:valore = 'FR'&quot;>&#xa;                                                                &lt;ns2:FR>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&#xa;                                                                        &lt;ns2:VC>&#xa;                                                                            &lt;xsl:variable name=&quot;currProgressivo1&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                                                            &lt;xsl:variable name=&quot;currComponent1&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                                                            &lt;ns2:AzioneVC>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore&quot;/>&#xa;                                                                            &lt;/ns2:AzioneVC>&#xa;                                                                            &lt;ns2:DLCI>&#xa;                                                                                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'DLCI' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore)&quot;/>&#xa;                                                                            &lt;/ns2:DLCI>&#xa;                                                                            &lt;ns2:ProfiloVC>&#xa;                                                                                &lt;ns2:ABR>&#xa;                                                                                    &lt;ns2:MCR>&#xa;                                                                                        &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='MCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;/>&#xa;                                                                                    &lt;/ns2:MCR>&#xa;                                                                                    &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;>&#xa;                                                                                        &lt;ns2:PCR>&#xa;                                                                                            &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;/>&#xa;                                                                                        &lt;/ns2:PCR>&#xa;                                                                                    &lt;/xsl:if>&#xa;                                                                                    &lt;ns2:Consegna>&#xa;                                                                                        &lt;xsl:choose>&#xa;                                                                                            &lt;xsl:when test=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOBANDACONSEGNA' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore) = 'DEDICATA'&quot;>&#xa;                                                                                                &lt;ns2:BandaDedicata>&#xa;                                                                                                    &lt;ns2:CodiceTD>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore&quot;/>&#xa;                                                                                                    &lt;/ns2:CodiceTD>&#xa;                                                                                                &lt;/ns2:BandaDedicata>&#xa;                                                                                            &lt;/xsl:when>&#xa;                                                                                            &lt;xsl:otherwise>&#xa;                                                                                                &lt;ns2:BandaCondivisa>&#xa;                                                                                                    &lt;ns2:CodiceVP>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICEVP' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore&quot;/>&#xa;                                                                                                    &lt;/ns2:CodiceVP>&#xa;                                                                                                &lt;/ns2:BandaCondivisa>&#xa;                                                                                            &lt;/xsl:otherwise>&#xa;                                                                                        &lt;/xsl:choose>&#xa;                                                                                    &lt;/ns2:Consegna>&#xa;                                                                                &lt;/ns2:ABR>&#xa;                                                                            &lt;/ns2:ProfiloVC>&#xa;                                                                        &lt;/ns2:VC>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns2:FR>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;ns2:ATM>&#xa;                                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&#xa;                                                                        &lt;ns2:VC>&#xa;                                                                            &lt;xsl:variable name=&quot;currProgressivo1&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                                                            &lt;xsl:variable name=&quot;currComponent1&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                                                            &lt;ns2:AzioneVC>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore&quot;/>&#xa;                                                                            &lt;/ns2:AzioneVC>&#xa;                                                                            &lt;ns2:VCI>&#xa;                                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore)&quot;/>&#xa;                                                                            &lt;/ns2:VCI>&#xa;                                                                            &lt;ns2:VPI>&#xa;                                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore)&quot;/>&#xa;                                                                            &lt;/ns2:VPI>&#xa;                                                                            &lt;ns2:ProfiloVC>&#xa;                                                                                &lt;xsl:choose>&#xa;                                                                                    &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore = 'ABR'&quot;>&#xa;                                                                                        &lt;ns2:ABR>&#xa;                                                                                            &lt;ns2:MCR>&#xa;                                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='MCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;/>&#xa;                                                                                            &lt;/ns2:MCR>&#xa;                                                                                            &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;>&#xa;                                                                                                &lt;ns2:PCR>&#xa;                                                                                                    &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;/>&#xa;                                                                                                &lt;/ns2:PCR>&#xa;                                                                                            &lt;/xsl:if>&#xa;                                                                                            &lt;ns2:Consegna>&#xa;                                                                                                &lt;xsl:choose>&#xa;                                                                                                    &lt;xsl:when test=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOBANDACONSEGNA' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore) = 'DEDICATA'&quot;>&#xa;                                                                                                        &lt;ns2:BandaDedicata>&#xa;                                                                                                            &lt;ns2:CodiceTD>&#xa;                                                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore&quot;/>&#xa;                                                                                                            &lt;/ns2:CodiceTD>&#xa;                                                                                                        &lt;/ns2:BandaDedicata>&#xa;                                                                                                    &lt;/xsl:when>&#xa;                                                                                                    &lt;xsl:otherwise>&#xa;                                                                                                        &lt;ns2:BandaCondivisa>&#xa;                                                                                                            &lt;ns2:CodiceVP>&#xa;                                                                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICEVP' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore&quot;/>&#xa;                                                                                                            &lt;/ns2:CodiceVP>&#xa;                                                                                                        &lt;/ns2:BandaCondivisa>&#xa;                                                                                                    &lt;/xsl:otherwise>&#xa;                                                                                                &lt;/xsl:choose>&#xa;                                                                                            &lt;/ns2:Consegna>&#xa;                                                                                        &lt;/ns2:ABR>&#xa;                                                                                    &lt;/xsl:when>&#xa;                                                                                    &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore = 'CBR'&quot;>&#xa;                                                                                        &lt;ns2:CBR>&#xa;                                                                                            &lt;ns2:PCR>&#xa;                                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;/>&#xa;                                                                                            &lt;/ns2:PCR>&#xa;                                                                                            &lt;ns2:Consegna>&#xa;                                                                                                &lt;ns2:BandaDedicata>&#xa;                                                                                                    &lt;ns2:CodiceTD>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore&quot;/>&#xa;                                                                                                    &lt;/ns2:CodiceTD>&#xa;                                                                                                &lt;/ns2:BandaDedicata>&#xa;                                                                                            &lt;/ns2:Consegna>&#xa;                                                                                        &lt;/ns2:CBR>&#xa;                                                                                    &lt;/xsl:when>&#xa;                                                                                    &lt;xsl:otherwise>&#xa;                                                                                        &lt;ns2:VBR>&#xa;                                                                                            &lt;ns2:SCR>&#xa;                                                                                                &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='SCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;/>&#xa;                                                                                            &lt;/ns2:SCR>&#xa;                                                                                            &lt;xsl:if test=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;>&#xa;                                                                                                &lt;ns2:PCR>&#xa;                                                                                                    &lt;xsl:value-of select=&quot;$MapperAttVC/tns4:sezioneInferiore[tns4:key='PCRUP' and  tns4:componente=$currComponent1 and tns4:progressivo=$currProgressivo1]/tns4:valore&quot;/>&#xa;                                                                                                &lt;/ns2:PCR>&#xa;                                                                                            &lt;/xsl:if>&#xa;                                                                                            &lt;ns2:Consegna>&#xa;                                                                                                &lt;ns2:BandaDedicata>&#xa;                                                                                                    &lt;ns2:CodiceTD>&#xa;                                                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD' and tns:componente=$currComponent1 and tns:progressivo=$currProgressivo1]/tns:valore&quot;/>&#xa;                                                                                                    &lt;/ns2:CodiceTD>&#xa;                                                                                                &lt;/ns2:BandaDedicata>&#xa;                                                                                            &lt;/ns2:Consegna>&#xa;                                                                                        &lt;/ns2:VBR>&#xa;                                                                                    &lt;/xsl:otherwise>&#xa;                                                                                &lt;/xsl:choose>&#xa;                                                                            &lt;/ns2:ProfiloVC>&#xa;                                                                        &lt;/ns2:VC>&#xa;                                                                    &lt;/xsl:for-each>&#xa;                                                                &lt;/ns2:ATM>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/ns2:DatiVC>&#xa;                                                    &lt;xsl:for-each select=&quot;$Start/tns:datiReferenti&quot;>&#xa;                                                        &lt;ns2:Referente>&#xa;                                                            &lt;ns2:Progressivo>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:progressivoReferente&quot;/>&#xa;                                                            &lt;/ns2:Progressivo>&#xa;                                                            &lt;ns2:Qualifica>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:qualifica&quot;/>&#xa;                                                            &lt;/ns2:Qualifica>&#xa;                                                            &lt;ns2:Nome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                                            &lt;/ns2:Nome>&#xa;                                                            &lt;ns2:Cognome>&#xa;                                                                &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                                            &lt;/ns2:Cognome>&#xa;                                                            &lt;xsl:if test=&quot;tns:telefonoFisso&quot;>&#xa;                                                                &lt;ns2:Telefono>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:telefonoFisso&quot;/>&#xa;                                                                &lt;/ns2:Telefono>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:cellulare&quot;>&#xa;                                                                &lt;ns2:Mobile>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:cellulare&quot;/>&#xa;                                                                &lt;/ns2:Mobile>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;tns:email&quot;>&#xa;                                                                &lt;ns2:Email>&#xa;                                                                    &lt;xsl:value-of select=&quot;tns:email&quot;/>&#xa;                                                                &lt;/ns2:Email>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:Referente>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns2:IncrementoDecrementoVC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:CambioSla>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns2:CambioSla>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:TipoVariazione>&#xa;                                &lt;/ns2:BitstreamATMSimm>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'BitstreamGBEAsimmetricoFlat'&quot;>&#xa;                                &lt;ns2:BitstreamGBEAsimm>&#xa;                                    &lt;ns2:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/ns2:IDENTIFICATIVO_RISORSA>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                        &lt;ns2:CodiceQualita>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                        &lt;/ns2:CodiceQualita>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                        &lt;ns2:CodiceDelivery>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                        &lt;/ns2:CodiceDelivery>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                        &lt;ns2:DAD>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                        &lt;/ns2:DAD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                        &lt;ns2:FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                        &lt;/ns2:FasciaOraria>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns2:TipoVariazione>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = ('Riconfigurazione Accesso', 'Downgrade Fast')&quot;>&#xa;                                                &lt;ns2:RiconfigurazioneAccesso>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Modulazione>&#xa;                                                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                            &lt;/ns2:Modulazione>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;>&#xa;                                                        &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                            &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                        &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&#xa;                                                        &lt;ns2:DatiVC>&#xa;                                                            &lt;xsl:variable name=&quot;currProgressivo2&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                                            &lt;xsl:variable name=&quot;currComponent2&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                                            &lt;ns2:VPI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:VPI>&#xa;                                                            &lt;ns2:VCI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:VCI>&#xa;                                                            &lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore) = 0&quot;>&#xa;                                                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;>&#xa;                                                                    &lt;ns2:CodeVlanSingleTag>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                                    &lt;/ns2:CodeVlanSingleTag>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;>&#xa;                                                                &lt;ns2:SVlanCode>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                                &lt;/ns2:SVlanCode>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore) and exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;>&#xa;                                                                &lt;ns2:CVlanCode>&#xa;                                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                                &lt;/ns2:CVlanCode>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;ns2:ProtocolloPilaIPoA>&#xa;                                                                &lt;ns2:IP_DSLAM>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IPDSLAM' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                                &lt;/ns2:IP_DSLAM>&#xa;                                                                &lt;ns2:IP_KIT>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IPKIT' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                                &lt;/ns2:IP_KIT>&#xa;                                                            &lt;/ns2:ProtocolloPilaIPoA>&#xa;                                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;>&#xa;                                                                &lt;ns2:Profilo_BMD>&#xa;                                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                                &lt;/ns2:Profilo_BMD>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:DatiVC>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'INTERMEDIATEAGENTFULL']/tns:valore = 'Y'&quot;>&#xa;                                                            &lt;ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'INTERMEDIATEAGENTFULL']/tns:valore = 'N'&quot;>&#xa;                                                            &lt;ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:INTERMEDIATE_AGENT_FULL>&#xa;                                                        &lt;/xsl:when>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns2:RiconfigurazioneAccesso>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Incremento/decremento VC'&quot;>&#xa;                                                &lt;ns2:IncrementoDecrementoVC>&#xa;                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&#xa;                                                        &lt;ns2:DatiVC>&#xa;                                                            &lt;xsl:variable name=&quot;currProgressivo3&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                                            &lt;xsl:variable name=&quot;currComponent3&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                                            &lt;ns2:AzioneVC>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;/>&#xa;                                                            &lt;/ns2:AzioneVC>&#xa;                                                            &lt;ns2:VPI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:VPI>&#xa;                                                            &lt;ns2:VCI>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:VCI>&#xa;                                                            &lt;xsl:if test=&quot;string-length($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore) = 0&quot;>&#xa;                                                                &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;>&#xa;                                                                    &lt;ns2:CodeVlanSingleTag>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;/>&#xa;                                                                    &lt;/ns2:CodeVlanSingleTag>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;>&#xa;                                                                &lt;ns2:SVlanCode>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;/>&#xa;                                                                &lt;/ns2:SVlanCode>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore) and exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore)&quot;>&#xa;                                                                &lt;ns2:CVlanCode>&#xa;                                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore)&quot;/>&#xa;                                                                &lt;/ns2:CVlanCode>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;ns2:ProtocolloPilaIPoA>&#xa;                                                                &lt;ns2:IP_DSLAM>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IPDSLAM' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;/>&#xa;                                                                &lt;/ns2:IP_DSLAM>&#xa;                                                                &lt;ns2:IP_KIT>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IPKIT' and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore&quot;/>&#xa;                                                                &lt;/ns2:IP_KIT>&#xa;                                                            &lt;/ns2:ProtocolloPilaIPoA>&#xa;                                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore)&quot;>&#xa;                                                                &lt;ns2:Profilo_BMD>&#xa;                                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent3 and tns:progressivo=$currProgressivo3]/tns:valore)&quot;/>&#xa;                                                                &lt;/ns2:Profilo_BMD>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:DatiVC>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns2:IncrementoDecrementoVC>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:CambioSla>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns2:CambioSla>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:TipoVariazione>&#xa;                                &lt;/ns2:BitstreamGBEAsimm>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'BitstreamGBESimmetricoFlat'&quot;>&#xa;                                &lt;ns2:BitstreamGBESimm>&#xa;                                    &lt;ns2:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/ns2:IDENTIFICATIVO_RISORSA>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                        &lt;ns2:CodiceQualita>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                        &lt;/ns2:CodiceQualita>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                        &lt;ns2:CodiceDelivery>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                        &lt;/ns2:CodiceDelivery>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                        &lt;ns2:DAD>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                        &lt;/ns2:DAD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                        &lt;ns2:FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                        &lt;/ns2:FasciaOraria>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns2:TipoVariazione>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Riconfigurazione Accesso'&quot;>&#xa;                                                &lt;ns2:RiconfigurazioneAccesso>&#xa;                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&#xa;                                                        &lt;ns2:UserVlan>&#xa;                                                            &lt;xsl:variable name=&quot;currProgressivo2&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                                            &lt;xsl:variable name=&quot;currComponent2&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                                            &lt;ns2:UserVlan>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'USERVLAN' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:UserVlan>&#xa;                                                            &lt;ns2:SVlanCode>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore&quot;/>&#xa;                                                            &lt;/ns2:SVlanCode>&#xa;                                                            &lt;ns2:CVlanCode>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:CVlanCode>&#xa;                                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;>&#xa;                                                                &lt;ns2:Profilo_BMD>&#xa;                                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent2 and tns:progressivo=$currProgressivo2]/tns:valore)&quot;/>&#xa;                                                                &lt;/ns2:Profilo_BMD>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:UserVlan>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns2:RiconfigurazioneAccesso>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'Incremento/decremento UserVLan'&quot;>&#xa;                                                &lt;ns2:IncrementoDecrementoUserVlan>&#xa;                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root&quot;>&#xa;                                                        &lt;ns2:UserVlan>&#xa;                                                            &lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;current()/tns1:progressivo&quot;/>&#xa;                                                            &lt;xsl:variable name=&quot;currComponent&quot; select=&quot;current()/tns1:componente&quot;/>&#xa;                                                            &lt;ns2:AzioneUserVlan>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                            &lt;/ns2:AzioneUserVlan>&#xa;                                                            &lt;ns2:UserVlan>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'USERVLAN' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:UserVlan>&#xa;                                                            &lt;ns2:SVlanCode>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'SVLANCODE' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore&quot;/>&#xa;                                                            &lt;/ns2:SVlanCode>&#xa;                                                            &lt;ns2:CVlanCode>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CVLANID' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:CVlanCode>&#xa;                                                            &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore) and ($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore !='C')&quot;>&#xa;                                                                &lt;ns2:Profilo_BMD>&#xa;                                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'PROFILOBMD'and tns:componente=$currComponent and tns:progressivo=$currProgressivo]/tns:valore)&quot;/>&#xa;                                                                &lt;/ns2:Profilo_BMD>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/ns2:UserVlan>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns2:IncrementoDecrementoUserVlan>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:CambioSla>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria H.24'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria Saturday'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;E&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria FAST'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SLAASSURANCE']/tns:valore = 'Copertura Oraria GOLD'&quot;>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;G&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:SlaAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SlaAssurance>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns2:CambioSla>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:TipoVariazione>&#xa;                                &lt;/ns2:BitstreamGBESimm>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = ('EasyIPBasePlusFlat','EasyIPBasePlusLite')&quot;>&#xa;                                &lt;ns2:EasyIPBasePlus>&#xa;                                    &lt;ns2:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/ns2:IDENTIFICATIVO_RISORSA>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                        &lt;ns2:CodiceQualita>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                        &lt;/ns2:CodiceQualita>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                        &lt;ns2:CodiceDelivery>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                        &lt;/ns2:CodiceDelivery>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                        &lt;ns2:DAD>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                        &lt;/ns2:DAD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                        &lt;ns2:FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                        &lt;/ns2:FasciaOraria>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns2:TipoVariazione>&#xa;                                        &lt;ns2:RiconfigurazioneAccesso>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='CARATTERISTICA']/tns:valore='FLAT'&quot;>&#xa;                                                    &lt;ns2:Caratteristica>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:Caratteristica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:Caratteristica>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:Caratteristica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                    &lt;ns2:Modulazione>&#xa;                                                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                                    &lt;/ns2:Modulazione>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:Modulazione>&#xa;                                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                    &lt;/ns2:Modulazione>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:flagOrdineUnico = 'Y'&quot;>&#xa;                                                &lt;ns2:Flag_Ordine_Unico>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                &lt;/ns2:Flag_Ordine_Unico>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;>&#xa;                                                &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns2:DatiVC>&#xa;                                                &lt;ns2:VPI>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI']/tns:valore)&quot;/>&#xa;                                                &lt;/ns2:VPI>&#xa;                                                &lt;ns2:VCI>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI']/tns:valore)&quot;/>&#xa;                                                &lt;/ns2:VCI>&#xa;                                                &lt;ns2:ABR>&#xa;                                                    &lt;ns2:Consegna>&#xa;                                                        &lt;ns2:BandaDedicata>&#xa;                                                            &lt;ns2:CodiceTD>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICETD']/tns:valore&quot;/>&#xa;                                                            &lt;/ns2:CodiceTD>&#xa;                                                        &lt;/ns2:BandaDedicata>&#xa;                                                    &lt;/ns2:Consegna>&#xa;                                                &lt;/ns2:ABR>&#xa;                                            &lt;/ns2:DatiVC>&#xa;                                        &lt;/ns2:RiconfigurazioneAccesso>&#xa;                                    &lt;/ns2:TipoVariazione>&#xa;                                &lt;/ns2:EasyIPBasePlus>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG = 'VLAN'&quot;>&#xa;                                &lt;ns2:VLAN>&#xa;                                    &lt;ns2:IdRiferimento>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists($Start/tns:codiceOrdineOloVlan)&quot;>&#xa;                                                &lt;ns2:ISP>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdineOloVlan&quot;/>&#xa;                                                &lt;/ns2:ISP>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:TI>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:codiceOrdineTIVlan&quot;/>&#xa;                                                &lt;/ns2:TI>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:IdRiferimento>&#xa;                                    &lt;ns2:TipoVariazione>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'VariazioneBanda'&quot;>&#xa;                                                &lt;ns2:VariazioneBanda>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'FAMIGLIAVLAN']/tns:valore = 'VLAN MonoCoS Banda Condivisa' and ($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IDENTIFICATIVOCOS']/tns:valore = 'VLAN MonoCoS Banda Condivisa CoS 3' or $Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'IDENTIFICATIVOCOS']/tns:valore = 'VLAN MonoCoS Banda Condivisa CoS 5')&quot;>&#xa;                                                            &lt;ns2:Banda>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'BANDA']/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:Banda>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns2:Profilo>&#xa;                                                                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOBMC']/tns:valore)&quot;/>&#xa;                                                            &lt;/ns2:Profilo>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns2:VariazioneBanda>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;upper-case($Start/tns:opzioneVariazione) = 'VARIAZIONETDKIT'&quot;>&#xa;                                                &lt;ns2:VariazioneKIT>&#xa;                                                    &lt;ns2:CodiceTDKIT>&#xa;                                                        &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'CODICETDKIT']/tns:valore&quot;/>&#xa;                                                    &lt;/ns2:CodiceTDKIT>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDENTIFICATIVOCAR']/tns:valore)&quot;>&#xa;                                                        &lt;ns2:CAR>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDENTIFICATIVOCAR']/tns:valore)&quot;/>&#xa;                                                        &lt;/ns2:CAR>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns2:IDVLANOLO>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDENTIFICATIVOVLANOLO']/tns:valore)&quot;/>&#xa;                                                    &lt;/ns2:IDVLANOLO>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SUPERMACROAREA']/tns:valore = 'Consegna su CAR di MAdR reale'&quot;>&#xa;                                                            &lt;ns2:SuperMacroarea>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SuperMacroarea>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SUPERMACROAREA']/tns:valore = &amp;quot;Consegna su CAR di MAdR 'SUPERMACROAREA'&amp;quot;&quot;>&#xa;                                                            &lt;ns2:SuperMacroarea>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SuperMacroarea>&#xa;                                                        &lt;/xsl:when>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                    &lt;xsl:if test=&quot;exists($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'VARIAZIONECONCORDATA']/tns:valore)&quot;>&#xa;                                                        &lt;ns2:VariazioneConcordata>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                        &lt;/ns2:VariazioneConcordata>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/ns2:VariazioneKIT>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$Start/tns:opzioneVariazione = 'VariazioneCAR'&quot;>&#xa;                                                &lt;ns2:VariazioneCAR>&#xa;                                                    &lt;ns2:CAR>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:integer($Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'IDENTIFICATIVOCAR']/tns:valore)&quot;/>&#xa;                                                    &lt;/ns2:CAR>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SUPERMACROAREA']/tns:valore = 'Consegna su CAR di MAdR reale'&quot;>&#xa;                                                            &lt;ns2:SuperMacroarea>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SuperMacroarea>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'SUPERMACROAREA']/tns:valore = &amp;quot;Consegna su CAR di MAdR 'SUPERMACROAREA'&amp;quot;&quot;>&#xa;                                                            &lt;ns2:SuperMacroarea>&#xa;                                                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                            &lt;/ns2:SuperMacroarea>&#xa;                                                        &lt;/xsl:when>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns2:VariazioneCAR>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns2:VariazioneNumeroCondivisori>&#xa;                                                    &lt;xsl:for-each select=&quot;$Variable/tns1:root[tns1:componente = 'OLOVLAN']&quot;>&#xa;                                                        &lt;ns2:SubContractor>&#xa;                                                            &lt;xsl:variable name=&quot;currComponent4&quot; select=&quot;tns1:componente&quot;/>&#xa;                                                            &lt;xsl:variable name=&quot;currProgressivo4&quot; select=&quot;tns1:progressivo&quot;/>&#xa;                                                            &lt;ns2:AzioneSubcontractor>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'AZIONE' and tns:componente = $currComponent4 and tns:progressivo = $currProgressivo4]/tns:valore&quot;/>&#xa;                                                            &lt;/ns2:AzioneSubcontractor>&#xa;                                                            &lt;ns2:CodiceOlo>&#xa;                                                                &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'CODICEOLONUMERICO' and tns:componente = $currComponent4 and tns:progressivo = $currProgressivo4]/tns:valore&quot;/>&#xa;                                                            &lt;/ns2:CodiceOlo>&#xa;                                                        &lt;/ns2:SubContractor>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns2:VariazioneNumeroCondivisori>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns2:TipoVariazione>&#xa;                                &lt;/ns2:VLAN>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns2:EasyIPSpecialProfile>&#xa;                                    &lt;ns2:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                    &lt;/ns2:IDENTIFICATIVO_RISORSA>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceQualita&quot;>&#xa;                                        &lt;ns2:CodiceQualita>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceQualita&quot;/>&#xa;                                        &lt;/ns2:CodiceQualita>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:codiceDelivery&quot;>&#xa;                                        &lt;ns2:CodiceDelivery>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:codiceDelivery&quot;/>&#xa;                                        &lt;/ns2:CodiceDelivery>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists($Start/tns:dad)&quot;>&#xa;                                        &lt;ns2:DAD>&#xa;                                            &lt;xsl:value-of select=&quot;concat(substring(xsd:string($Start/tns:dad), 9, 2),'/',substring(xsd:string($Start/tns:dad), 6, 2),'/',substring(xsd:string($Start/tns:dad), 1, 4))&quot;/>&#xa;                                        &lt;/ns2:DAD>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$Start/tns:fasciaOraria&quot;>&#xa;                                        &lt;ns2:FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$Start/tns:fasciaOraria&quot;/>&#xa;                                        &lt;/ns2:FasciaOraria>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns2:TipoVariazione>&#xa;                                        &lt;ns2:RiconfigurazioneAccesso>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key='CARATTERISTICA']/tns:valore='FLAT'&quot;>&#xa;                                                    &lt;ns2:Caratteristica>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:Caratteristica>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:Caratteristica>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:Caratteristica>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODULAZIONE']/tns:valore = 'Interleaved'&quot;>&#xa;                                                    &lt;ns2:Modulazione>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:Modulazione>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:Modulazione>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:Modulazione>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:flagOrdineUnico = 'Y'&quot;>&#xa;                                                &lt;ns2:Flag_Ordine_Unico>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;SI&amp;quot;&quot;/>&#xa;                                                &lt;/ns2:Flag_Ordine_Unico>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;>&#xa;                                                &lt;ns2:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'PROFILOTECNICOLINEA']/tns:valore&quot;/>&#xa;                                                &lt;/ns2:ProfiloTecnicoLinea>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Dinamico Virtual Dial UP'&quot;>&#xa;                                                    &lt;ns2:ModalitaConsegna>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:ModalitaConsegna>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico Virtual Dial UP'&quot;>&#xa;                                                    &lt;ns2:ModalitaConsegna>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:ModalitaConsegna>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneSuperiore[tns:key = 'MODALITACONSEGNA']/tns:valore = 'Statico LAN 8 Virtual Dial UP'&quot;>&#xa;                                                    &lt;ns2:ModalitaConsegna>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:ModalitaConsegna>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns2:ModalitaConsegna>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                                    &lt;/ns2:ModalitaConsegna>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                            &lt;ns2:DatiVC>&#xa;                                                &lt;ns2:VCI>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VCI']/tns:valore)&quot;/>&#xa;                                                &lt;/ns2:VCI>&#xa;                                                &lt;ns2:VPI>&#xa;                                                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'VPI']/tns:valore)&quot;/>&#xa;                                                &lt;/ns2:VPI>&#xa;                                                &lt;ns2:ABR/>&#xa;                                            &lt;/ns2:DatiVC>&#xa;                                        &lt;/ns2:RiconfigurazioneAccesso>&#xa;                                    &lt;/ns2:TipoVariazione>&#xa;                                &lt;/ns2:EasyIPSpecialProfile>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns2:Variazione>&#xa;                &lt;/ns2:TipoRichiesta>&#xa;            &lt;/ns2:Richiesta>&#xa;        &lt;/ns2:TracciatoOLOxDSL>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TracciatoOloXDSL" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Variable"
                    name="AssignCompProgr" outputVariable="Variable"
                    tibex:xpdlId="d50b48eb-90c0-47a5-8a2d-eba4f2846e4a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallRecuperoServizioOrigineToAssignCompProgr"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignCompProgrToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignCompProgrToCopy_1_AssignCompProgr">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:opzioneVariazione = ('Incremento/decremento VC', 'Incremento/decremento UserVLan','Riconfigurazione UserVLAN')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns0:opzioneVariazione = ('Incremento/decremento VC', 'Incremento/decremento UserVLan','Riconfigurazione UserVLAN')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/ComponenteProgressivo&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns1:root>&lt;xsl:for-each-group select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore&quot; group-by=&quot;concat(tns:componente, tns:progressivo)&quot;>&lt;xsl:if test=&quot;exists(tns:componente)&quot;>&lt;tns1:root>&lt;tns1:componente>&lt;xsl:value-of select=&quot;tns:componente&quot;/>&lt;/tns1:componente>&lt;tns1:progressivo>&lt;xsl:value-of select=&quot;tns:progressivo&quot;/>&lt;/tns1:progressivo>&lt;/tns1:root>&lt;/xsl:if>&lt;/xsl:for-each-group>&lt;/tns1:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="06d80016-55ad-4dcf-a553-2bc75e09dd99">
                <bpws:targets>
                    <bpws:target linkName="AssignCompProgrToEmpty"/>
                    <bpws:target linkName="Copy_1_AssignCompProgrToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToIterate"/>
                </bpws:sources>
            </bpws:empty>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="17ecbf24-9d9b-477c-b6c1-5eb29f63bdcd">
                <bpws:targets>
                    <bpws:target linkName="EmptyToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToMapperAttVC"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit"
                        tibex:xpdlId="df3cec8d-a4b0-498d-be3f-cd8b37a2c4d4" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+bff25b88-7d1b-4b72-8302-55d46d27daea" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$Start/ns0:attributiOfferta/ns0:sezioneInferiore[ns0:key = 'IDPROFILOVC']" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns0:attributiOfferta/ns0:sezioneInferiore[ns0:key = 'IDPROFILOVC'])]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns0:Iterate_Current_Element_sezioneInferiore"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="AssignToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="JDBCQueryToAssign" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="MapperToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="d7c2793e-5566-4954-8c0c-7fb0092930f2" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns0:attributiOfferta/ns0:sezioneInferiore[ns0:key = 'IDPROFILOVC'])[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="bff25b88-7d1b-4b72-8302-55d46d27daea" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperProfiloVC</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="ProfiloVC"
                                    name="AssignProfiloVC"
                                    outputVariable="ProfiloVC"
                                    tibex:xpdlId="bb4c7719-e4f9-4f87-b759-376e6078315b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoValoriProfiloVC&quot;/>&#xa;    &lt;xsl:template name=&quot;ProfiloVC&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:root>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:progressivo=$currentElement/tns:progressivo ]/tns:valore = 'ABR'&quot;>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRDOWN'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.')) then&amp;#xD;&amp;#xA; concat(substring-before(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.'),',',substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.'))&amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRUP'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.')) then&amp;#xD;&amp;#xA; concat(substring-before(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.'),',',substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_UP),'.'))&amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/PCR_UP)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'MCRDOWN'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN),'.')) then&amp;#xD;&amp;#xA; concat(substring-before(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN),'.'),',',substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN),'.'))&amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/MCR_DOWN)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'MCRUP'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_UP),'.')) then&amp;#xD;&amp;#xA; concat(substring-before(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_UP),'.'),',',substring-after(xsd:string($RecuperoValoriProfiloVC/Record[1]/MCR_UP),'.'))&amp;#xD;&amp;#xA; else&amp;#xD;&amp;#xA; xsd:int($RecuperoValoriProfiloVC/Record[1]/MCR_UP)&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                        &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                            &lt;tns4:progressivo>&#xa;                                &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                            &lt;/tns4:progressivo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:sezioneInferiore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore[tns:key = 'TIPOPROFILOVC' and tns:progressivo=$currentElement/tns:progressivo ]/tns:valore = 'CBR'&quot;>&#xa;                    &lt;tns4:sezioneInferiore>&#xa;                        &lt;tns4:key>&#xa;                            &lt;xsl:value-of select=&quot;'PCRDOWN'&quot;/>&#xa;                        &lt;/tns4:key>&#xa;                        &lt;tns4:componente>&#xa;                            &lt;xsl:value-of select=&quot;'ATMVC'&quot;/>&#xa;                        &lt;/tns4:componente>&#xa;                        &lt;tns4:tipologiaDato>&#xa;                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                        &lt;/tns4:tipologiaDato>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;if(contains(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.')) then&amp;#xD;&amp;#xA; concat(substring-before(xsd:string($RecuperoValoriProfiloVC/Record[1]/PCR_DOWN),'.'),',',substring-after(xsd:string($