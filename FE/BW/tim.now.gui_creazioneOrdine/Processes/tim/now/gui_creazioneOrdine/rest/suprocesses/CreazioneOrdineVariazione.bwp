                                <tibex:expression
                                    expression="$Start/ns0:offertaCatalogo = 'VLANNGA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
