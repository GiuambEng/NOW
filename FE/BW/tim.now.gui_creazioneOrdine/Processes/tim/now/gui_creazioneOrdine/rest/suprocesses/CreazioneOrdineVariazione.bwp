                                    sqlStatement="select MCR_DOWN, MCR_UP, PCR_DOWN, PCR_UP, SCR_DOWN, SCR_UP&#xa;from PROFILO_VC&#xa;where ID_PRFL_VC = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
