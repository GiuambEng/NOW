                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/ConfigurazioneFE&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/NuovoOrdine&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperoNomeOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallRecuperoServizioOrigine-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:InputConfigurazioneFE>&#xa;            &lt;tns4:codFunzione>&#xa;                &lt;xsl:value-of select=&quot;'C11M08F46'&quot;/>&#xa;            &lt;/tns4:codFunzione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($RecuperoNomeOfferta/Record[1]/OFFERTA, 'NP') = true()&quot;>&#xa;                    &lt;tns4:offerta>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(concat($RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG,'+','NP'))&quot;/>&#xa;                    &lt;/tns4:offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:offerta>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($RecuperoNomeOfferta/Record[1]/NOME_OFFERTA_CATLG)&quot;/>&#xa;                    &lt;/tns4:offerta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:opzioneVariazione&quot;>&#xa;                &lt;tns4:opzioneVariazione>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:opzioneVariazione&quot;/>&#xa;                &lt;/tns4:opzioneVariazione>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:InputConfigurazioneFE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
