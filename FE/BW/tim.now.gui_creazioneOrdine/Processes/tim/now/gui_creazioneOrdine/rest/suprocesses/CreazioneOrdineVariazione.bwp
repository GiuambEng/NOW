                            &lt;xsl:value-of select=&quot;$Start/tns:operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:idRisorsa&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Start/tns:attributiOfferta/tns:sezioneInferiore[1]/tns:componente)&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int('1')&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;xsl:for-each select=&quot;$Start/tns:attributiOfferta/tns:sezioneInferiore&quot;>&#xa;                                &lt;attributiDettaglioOrdine>&#xa;                                    &lt;IDRichiestaOLO>&#xa;                                        &lt;xsl:value-of select=&quot;../../tns:oao&quot;/>&#xa;                                    &lt;/IDRichiestaOLO>&#xa;                                    &lt;IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                                    &lt;/IDDettaglioOrdine>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;../../tns:operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;tns:key&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;tns:tipologiaDato&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                &lt;/attributiDettaglioOrdine>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivo>&#xa;                        &lt;/dettaglioordine>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns:indirizzoDatiClienteFinale/tns:provincia)&quot;>&#xa;                            &lt;sede>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDSede>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDSede>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:indirizzoDatiClienteFinale/tns:partToponomasti