<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/visualizzaCodiceVP" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/visualizzaCodiceVP">

      <element name="outVisualizzaCodVp" type="tns:VisializzaCodVPOut"></element>

    <complexType name="VisializzaCodVPOut">
    	<sequence>
    		<element name="codiceVP" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="clli" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="nomeCentrale" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>



    <element name="OutVisualizzaCodVp">
    	<complexType>
    		<sequence>
    			<element ref="tns:outVisualizzaCodVp"
    				maxOccurs="unbounded" minOccurs="0">
    			</element>
    			<element name="result" type="tns:result" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>

    <complexType name="result">
    	<sequence>
    		<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>