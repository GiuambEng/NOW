<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VisualizzazioneListaBandePicco" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/VisualizzazioneListaBandePicco">

    <element name="VisualizzazioneListaBandePicco_Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="column" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="operation" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="1" name="value" type="string">
    			</element>

    			<element maxOccurs="1" minOccurs="0" name="tipoCos" type="string"/>
    		</sequence>
    	</complexType>
    </element>

    <element name="VisualizzazioneListaBandePicco_Output" type="tns:VisualizzazioneListaBandePicco_Output">
    </element>
    
    <complexType name="VisualizzazioneListaBandePicco_Output">
    	<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="VisualizzazioneListaBandePicco_Output">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="BANDA_UPSTREAM" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="BANDA_DOWNSTREAM" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="IDENTIFICATIVO_BANDA_PICCO" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="MODELLO" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="TIPO_COS" type="string"/>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" minOccurs="0" maxOccurs="1">
				<complexType>
					<sequence>
						<element maxOccurs="1" minOccurs="0" name="severity" type="string">
						</element>
						<element maxOccurs="1" minOccurs="0" name="code" type="string">
						</element>
						<element maxOccurs="1" minOccurs="0" name="details" type="string">
						</element>
					</sequence>
				</complexType>
			</element>
    			
            <element maxOccurs="1" minOccurs="0" name="idExportFile" type="string"/>
        </sequence>
    
    
    </complexType>

    <element name="VisualizzazioneListaBandePicco_Fault">
    	<complexType>
    	<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
			</sequence>
    	
    	</complexType>
    </element>
</schema>
