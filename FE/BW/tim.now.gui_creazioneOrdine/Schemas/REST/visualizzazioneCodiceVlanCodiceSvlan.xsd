<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/VisualizzazioneCodiceVlanCodiceSvlan" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VisualizzazioneCodiceVlanCodiceSvlan">

    <element name="visualizzazionecodicevlancodicesvlan"
    	type="tns:visualizzazionevlancodicesvlan">
    </element>
    
    <complexType name="visualizzazionevlancodicesvlan">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0"
    			ref="tns:inputvisualizzazionecodicevlancodicesvlan">
    		</element>
    		<element maxOccurs="unbounded" minOccurs="0"
    			ref="tns:outputvisualizzazionecodicevlancodicesvlan">
    		</element>
    		<element
    			ref="tns:faultvisualizzazionecodicevlancodicesvlan">
    		</element>
    	</sequence>
    </complexType>

    <complexType name="inputcodicevlansvlan">
    	<sequence>
    		<element name="codoloagcom" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="encapsulation" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="servizio" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <complexType name="outputcodicevlansvlan">
    	<sequence>
    		<element name="codicevlan" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="tipobanda" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="tipocos" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="flagencapsulation" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="tipologia" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="stato" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="clli" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="nomecentrale" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="codicekit" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="dec" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="decattivazione" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="codiceareadiraccolta" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="descareadiraccolta" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="codicemacroarea" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="codicesupermacroarea" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="tipotrasporto" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="idvlanolo" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="flagvlantranslation" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="dataconsegnaolo" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="descmacroarea" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="descsupermacroarea" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="dslamType" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <element name="inputvisualizzazionecodicevlancodicesvlan"
    	type="tns:inputcodicevlansvlan">
    </element>
    <element name="outputvisualizzazionecodicevlancodicesvlan"
    	type="tns:outputcodicevlansvlan">
    </element>
    <element name="faultvisualizzazionecodicevlancodicesvlan"
    	type="string">
    </element>

    <element name="outputrestvisualizzazionecodicevlancodicesvlan"
    	type="tns:restoutputvisualizzazionevlansvlan">
    </element>
    
    <complexType name="restoutputvisualizzazionevlansvlan">
    	<sequence>
    		<element
    			name="outputrestvisualizzazionecodicevlancodicesvlan"
    			type="tns:outputcodicevlansvlan" minOccurs="0" maxOccurs="unbounded">
    		</element>
    		<element name="result"
    			type="tns:resultvisualizzazionecodicevlancodicesvlan" maxOccurs="unbounded" minOccurs="0">
    		</element>
    	</sequence>
    </complexType>

    <complexType name="resultvisualizzazionecodicevlancodicesvlan">
    	<sequence>
    		<element name="severity" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="code" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="details" type="string" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>
    <element name="outputrestcodvlancodslan" type="tns:outputrestcodvlancodslan"></element>

    <complexType name="outputrestcodvlancodslan">
    	<sequence>
    		<element name="outputrestcodvlancodsvlan" type="tns:outputcodicevlansvlan" minOccurs="0" maxOccurs="unbounded"></element>
    		<element name="result" type="tns:resultvisualizzazionecodicevlancodicesvlan" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>

    <element name="tipologia_servizi" type="tns:tipologia_servizio"></element>
    
    <complexType name="tipologia_servizio">
    	<sequence>
    		<element name="tipologiaServizi" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>