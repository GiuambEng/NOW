<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/rest.VisualizzaTaglioRicarica" xmlns:tns="http://www.example.org/rest.VisualizzaTaglioRicarica" elementFormDefault="qualified">

    <element name="Output_VisualizzaTaglioRicarica"
    	type="tns:Output_VisualizzaTaglioRicarica">
    </element>


    <complexType name="Output_VisualizzaTaglioRicarica">
    	<sequence>
    		<element name="ListaTaglioRicaricaPerOfferta"
    			maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="taglioRicarica" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result" maxOccurs="1" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="code" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="details" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
</schema>