<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VisualizzazioneServiziOpzionaliAlternativi" xmlns:tns="http://www.example.org/VisualizzazioneServiziOpzionaliAlternativi" elementFormDefault="qualified">

    <element name="VisualizzazioneServiziOpzionaliAlternativiOutput">
    	<complexType>
    		<sequence>
    			<element name="listaServiziOpzionaliAlternativi"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codiceProgetto" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="servizioOpzionalePadre" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="servizioOpzionaleAlternativo" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="descrizioneAnagraficaServizioOpzionale" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>