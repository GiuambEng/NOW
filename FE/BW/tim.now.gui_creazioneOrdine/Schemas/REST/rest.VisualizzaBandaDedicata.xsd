<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/VisualizzaBandaDedicata" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VisualizzaBandaDedicata">
    <element name="OutputVisualizzazioneBandaDedicata" type="tns:VisualizzaBandaDedicata"></element>

    <complexType name="VisualizzaBandaDedicata">
    	<sequence>
    		<element name="bp2" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="bp2_Max" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="bp3" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="bp3_Max" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="bp5" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="bp5_Max" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="bp6" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="bp6_Max" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="id_profiloBmd" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="profilo" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="id_sottofamig_offerta" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="descr_sottofamig_offerta" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="tipolog_VLAN" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="VisualizzaOutputBandaDedicata">
    	<complexType>
    		<sequence>
    			<element ref="tns:OutputVisualizzazioneBandaDedicata"
    				minOccurs="0" maxOccurs="unbounded">
    			</element>
    			<element name="result" type="tns:result" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>


    <complexType name="reusult"></complexType>

    <complexType name="result">
    	<sequence>
    		<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="InputBandaDedicata" type="tns:InputBandaDedicata"></element>
    
    <complexType name="InputBandaDedicata">
    	<sequence>
    		<element name="profiloTecnicoLinea" type="string" maxOccurs="1" minOccurs="0"></element>
            <element name="identificativoOffertaSelezionata" type="string" maxOccurs="1" minOccurs="0"></element>
        </sequence>
    </complexType>

    <element name="InputBandaDed">
    	<complexType>
    		<sequence>
    			<element ref="tns:InputBandaDed" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>