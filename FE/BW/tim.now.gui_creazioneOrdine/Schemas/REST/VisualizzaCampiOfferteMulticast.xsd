<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VisualizzaCampiOfferteMulticast" xmlns:tns="http://www.example.org/VisualizzaCampiOfferteMulticast" elementFormDefault="qualified">

    <element name="inputVisualizzaCampiOfferteMulticast">
    	<complexType>
    		<sequence>
    			<element name="nomeCampo" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="descrArea" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="clliFeeder" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="idContratto" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="flagPrimoFeeder" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputVisualizzaCampiOfferteMulticast">
    	<complexType>
    		<sequence>
    			<element name="outputCampiOfferteMulticast"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="valoreCampo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipoApparato" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="nomeCentrale" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>