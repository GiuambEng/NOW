<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RecuperoCAR" xmlns:tns="http://www.example.org/RecuperoCAR" elementFormDefault="qualified">

    <element name="inputRecuperoCAR">
    	<complexType>
    		<sequence>
    			<element name="idOfferta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="famigliaVLAN" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codiceTDKIT" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ftthOnly" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="area" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="macroarea" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="supermacroarea" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="lavorazione" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ccLib" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="cos" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idAsset" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="sottolavorazione" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="bmcLight" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="flagDRG" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputRecuperoCAR">
    	<complexType>
    		<sequence>
    			<element name="outputCAR" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codiceCAR" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="macroArea" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="aggregatoBMCLight"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipologiaComune"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ftthOnly" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="bandaCar" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="DRG" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>