<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RecuperaCampiOfferteGPON" xmlns:tns="http://www.example.org/RecuperaCampiOfferteGPON" elementFormDefault="qualified">

    <element name="outputRecuperaIdGpon">
    	<complexType>
    		<sequence>
    			<element name="outputIdGpon" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="IDGPON" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codiceAreaCentrale"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="puntoInterconnessione"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codificaOlo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="fattoreDiSplitting"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataRegistrazioneFattoreDiSplitting" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idGponValido" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputRecuperaIdGpon">
    	<complexType>
    		<sequence>
    			<element name="codOloAgcom" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputRecuperaCodSystemUnico">
    	<complexType>
    		<sequence>
    			<element name="codOloAgcom" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
                <element name="systemType" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="idGpon" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputRecupereCodSystemUnico">
    	<complexType>
    		<sequence>
    			<element name="outputCodSystemUnico"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codSystemUnico" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idAreaDiCentrale" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
                <element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputRecuperaCodSubAppalto">
    	<complexType>
    		<sequence>
    			<element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="idGpon" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputRecuperaCodSubAppalto">
    	<complexType>
    		<sequence>
    			<element name="codSubAppalto" maxOccurs="unbounded"
    				minOccurs="0" type="string">
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputTipologiaImpresa">
    	<complexType>
    		<sequence>
    			<element name="codOloAgcom" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idAreaDiCentrale" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codImpresa" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputTipologiaImpresa">
    	<complexType>
    		<sequence>
    			<element name="outputTipologiaImpresa"
    				maxOccurs="unbounded" minOccurs="0" type="string">
    			</element>
    			<element name="result">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>