<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/exportToExcel" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/exportToExcel">
	<element name="Fault" type="tns:Fault">    </element>
	<element name="Input_exportToExcel" type="tns:Input_exportToExcel">
    </element>
	<element name="Output_exportToExcel" type="tns:Output_exportToExcel">
    </element>
	<complexType name="Output_exportToExcel">
		<sequence>
			<element name="id_File" type="int">
            </element>
			<element name="result" type="tns:result">
            </element>
		</sequence>
	</complexType>
	<complexType name="result">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="severity" type="string">
							</element>
			<element maxOccurs="1" minOccurs="0" name="code" type="string">
							</element>
			<element maxOccurs="1" minOccurs="0" name="details" type="string">
							</element>
		</sequence>
	</complexType>
	<complexType name="Input_exportToExcel">
		<sequence>
			<element name="User_ID" type="string">
    		</element>
			<element maxOccurs="unbounded" minOccurs="0" name="ID_Richiesta" type="string">
    		</element>
			<element name="COD_OLO_AGCOM" type="string">
    		</element>
			<element name="Tipo_Profilo" type="string">
    		</element>
			<element name="Tipo_Lista" type="string">
    		</element>
			<element maxOccurs="1" minOccurs="0" name="xmlToExcel_RicercaAvanzata" type="tns:xmlToExcel_RicercaAvanzata">
				</element>
		</sequence>
	</complexType>
	<complexType name="xmlToExcel_RicercaAvanzata">
		<sequence>
			<element minOccurs="0" name="numerorighe" type="string"/>
			<element minOccurs="0" name="indiceriga" type="string"/>
			<element maxOccurs="unbounded" minOccurs="0" name="strutturaCondition">
				<complexType>
					<sequence>
						<element minOccurs="0" name="nome" type="string"/>
						<element minOccurs="0" name="operazione" type="string"/>
						<element minOccurs="0" name="valore" type="string"/>
						<element minOccurs="0" name="tipo" type="string"/>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
	<complexType name="Fault">
		<sequence>
			<element maxOccurs="1" minOccurs="1" name="message" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
		</sequence>
	</complexType>

	<element name="exportToExcel_Input">
		<complexType>
		<sequence>
			<element name="User_ID" type="string"></element>
			<element maxOccurs="unbounded" minOccurs="0"
				name="ID_Richiesta" type="string">
			</element>
			<element name="COD_OLO_AGCOM" type="string"></element>
			<element name="Tipo_Profilo" type="string"></element>
			<element name="Tipo_Lista" type="string"></element>
			<element name="RicercaAvanzata_xmlToExcel"
				type="tns:RicercaAvanzata_xmlToExcel" maxOccurs="1" minOccurs="0">
			</element>
		</sequence>
		</complexType>
	</element>

	<complexType name="RicercaAvanzata_xmlToExcel">
		<sequence>

			<element minOccurs="0" name="numerorighe" type="string" />
			<element minOccurs="0" name="indiceriga" type="string" />
			<element name="exportRequest" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="strutturaCondition"
				type="tns:strutturaCondition" maxOccurs="unbounded" minOccurs="1">
			</element>
			
		</sequence>
	</complexType>

	<complexType name="strutturaCondition">
		<sequence>
			<element minOccurs="0" name="nome" type="string" />
			<element minOccurs="0" name="operazione" type="string" />
			<element minOccurs="0" name="valore" type="string" />
			<element minOccurs="0" name="tipo" type="string" />
		</sequence>
	</complexType>
</schema>
