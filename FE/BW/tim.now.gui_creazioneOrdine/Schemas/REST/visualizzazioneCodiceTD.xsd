<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/REST/VisualizzaCodiceTD" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/REST/VisualizzaCodiceTD">

    <element name="VisualizzaCodiceTD">
    	<complexType>
    		<sequence>
    			<element ref="tns:InputVisualizzaCodiceTD" minOccurs="1" maxOccurs="1"></element>
    			<element ref="tns:OutputVisualizzaCodiceTD" maxOccurs="unbounded" minOccurs="0"></element>
    			<element ref="tns:FaultVisualizzaCodiceTD">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="InputVisualizzaCodiceTD">
    	<sequence>
    		<element name="codcf_olo_agcom" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    	</sequence>
    </complexType>
    
    <complexType name="OutputVisualizzaCodiceTD">
    	<sequence>
    	<element name="VisualizzaCodiceTD_Output" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="COD_KIT" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="CLLI" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_PRIME_CONTRACTOR" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    		
    			</element>
    		<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType></element>
    	</sequence>
    </complexType>
    
    <complexType name="FaultVisualizzaCodiceTD">
    		<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
    </complexType>
    
    
    
    
    <element name="InputVisualizzaCodiceTD" type="tns:InputVisualizzaCodiceTD"></element>
    <element name="OutputVisualizzaCodiceTD" type="tns:OutputVisualizzaCodiceTD"></element>
    <element name="FaultVisualizzaCodiceTD" type="tns:FaultVisualizzaCodiceTD"></element>
</schema>