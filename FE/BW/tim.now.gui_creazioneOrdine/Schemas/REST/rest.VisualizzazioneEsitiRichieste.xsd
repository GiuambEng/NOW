<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VisualizzazioneEsitiRichieste/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/VisualizzazioneEsitiRichieste/">

    <element name="VisualizzazioneEsitiRichiesteInput">
      <complexType>
            <sequence>
                  <element maxOccurs="1" minOccurs="1" name="idRichiesta" type="string"/>
            </sequence>
      </complexType>
    </element>
    
    <element name="VisualizzazioneEsitiRichiesteOutput">
      <complexType>
            <sequence>
                  <element maxOccurs="unbounded" minOccurs="0" name="VisualizzazioneEsitiRichiesteOutput">
                        <complexType>
                             <sequence>
                                   <element maxOccurs="1" minOccurs="0" name="dataInvio" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="statoNow" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="statoOao" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="codiceCausaleNow" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="codiceCausaleOao" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="lavorazioneRichiesta" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="idRichiestaOlo" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="codiceRichiestaOao" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="xml" type="string"/>
                             </sequence>
                        </complexType>
                  </element>
                  <element maxOccurs="1" minOccurs="0" name="result">
                        <complexType>
                             <sequence>
                                   <element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="code" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="details" type="string"/>
                             </sequence>
                        </complexType>
                  </element>
            </sequence>
      </complexType>
    </element>
    
    <element name="VisualizzazioneEsitiRichiesteFault">
      <complexType>
            <sequence>
                  <element name="msg" type="string"/>
                  <element name="code" type="string"/>
            </sequence>
      </complexType>
    </element>


    <element name="VisualizzazioneEsitiNotificheInput">
      <complexType>
            <sequence>
                  <element maxOccurs="1" minOccurs="0" name="idRichiesta" type="string">
                  </element>
                  <element maxOccurs="1" minOccurs="0" name="tipoProfilo" type="string"/>
            </sequence>
      </complexType>
    </element>

    <element name="VisualizzaEsitiNotificheOutput">
      <complexType>
            <sequence>
                  <element maxOccurs="unbounded" minOccurs="0" name="VisualizzazioneEsitiNotificheOutput">
                        <complexType>
                             <sequence>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="tipologiaNotifica" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="causale" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="dataCreazione" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="notificaXML" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="ultimoFileNotifica" type="string" />
                             	<element maxOccurs="1" minOccurs="0"
                             		name="dataInvioFile" type="string" />

                             </sequence>
                        </complexType>
                  </element>

                  <element maxOccurs="1" minOccurs="0" name="result">
                        <complexType>
                             <sequence>
                                   <element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="code" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="details" type="string"/>
                             </sequence>
                        </complexType>
                  </element>
            </sequence>
      </complexType>
    </element>

    <element name="VisualizzazioneEsiti">
      <complexType>
            <sequence>
                  <element maxOccurs="unbounded" minOccurs="0" name="visualizzazioneNotificheOutput">
                        <complexType>
                             <sequence>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="tipologiaNotifica" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="causale" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="dataCreazione" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="notificaXML" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="ultimoFileNotifica" type="string" />
                             	<element maxOccurs="1" minOccurs="0"
                             		name="dataInvioFile" type="string" />

                             	<element name="idNotifica"
                             		type="string" maxOccurs="1" minOccurs="0">
                             	</element>
                             </sequence>
                        </complexType>
                  </element>
                  <element maxOccurs="unbounded" minOccurs="0" name="visualizzazioneEsitiRichiesteOutput">
                        <complexType>
                             <sequence>
                                   <element maxOccurs="1" minOccurs="0" name="dataInvio" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="statoNow" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="statoOao" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="lavorazioneRichiesta" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="idRichiestaOlo" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="codiceRichiestaOao" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="xml" type="string"/>
                            <element minOccurs="0" name="userId" type="string"/>
                        </sequence>
                        </complexType>
                  </element>
                  <element maxOccurs="1" minOccurs="0" name="result">
                        <complexType>
                              <sequence>
                                   <element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="code" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="details" type="string"/>
                             </sequence>
                        </complexType>
                  </element>
            </sequence>
      </complexType>
    </element>

    


    <complexType name="VisualizzazioneEsiti">
      <sequence>
            <element maxOccurs="unbounded" minOccurs="0" name="richieste">
                  <complexType>
                        <sequence>
                             <element maxOccurs="1" minOccurs="0" name="dataInvio" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="statoNow" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="statoOao" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="codiceCausaleNow" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="codiceCausaleOao" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="lavorazioneRichiesta" type="string"/>
                        </sequence>
                  </complexType>
            </element>
            <element maxOccurs="unbounded" minOccurs="0" name="notifiche">
                  <complexType>
                        <sequence>
                             <element maxOccurs="1" minOccurs="0" name="origineNotifica" type="string"/>
                             <element maxOccurs="1" minOccurs="0" name="strutturaRichiesta" type="string"/>
                             <element maxOccurs="1" minOccurs="0" name="timeStampCreazione" type="string"/>
                             <element maxOccurs="1" minOccurs="0" name="tracciatoFile" type="string"/>
                             <element maxOccurs="1" minOccurs="0" name="tracciatoMail" type="string"/>
                        </sequence>
                  </complexType>
            </element>
            <element maxOccurs="1" minOccurs="0" name="result">
                  <complexType>
                        <sequence>
                             <element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
                             <element maxOccurs="1" minOccurs="0" name="code" type="string"/>
                             <element maxOccurs="1" minOccurs="0" name="details" type="string"/>
                        </sequence>
                  </complexType>
            </element>
      </sequence>
    </complexType>
</schema>
