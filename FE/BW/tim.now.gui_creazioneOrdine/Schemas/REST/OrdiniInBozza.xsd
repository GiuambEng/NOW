<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/OrdiniInBozza" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/OrdiniInBozza">

    <element name="OrdiniInBozza">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:ordiniInBozza"/>
    			<element maxOccurs="1" minOccurs="0" ref="tns:result"/>
    		</sequence>
    	</complexType>
    </element>


 <element name="OutputIns_DelOrdiniBozza">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" ref="tns:result"/>
    		</sequence>
    	</complexType>
    </element>
    <complexType name="OrdiniInBozzaType">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="codOloAgcom"
    			type="string" />
    		<element maxOccurs="1" minOccurs="0" name="codOloNumerico"
    			type="string" />
    		<element maxOccurs="1" minOccurs="0" name="ordineBozza"
    			type="string" />
    		<element maxOccurs="1" minOccurs="0" name="userId"
    			type="string" />
    		<element maxOccurs="1" minOccurs="0" name="codOrdineOlo"
    			type="string" />
    		<element name="codOrdineOloNew" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element maxOccurs="1" minOccurs="0"
    			name="tipologiaLavorazione" type="string" />
    		<element maxOccurs="1" minOccurs="0" name="note"
    			type="string" />
    		<element maxOccurs="1" minOccurs="0"
    			name="ultimoAggiornamento" type="string" />
    	</sequence>
    </complexType>
    <element name="ordiniInBozza" type="tns:OrdiniInBozzaType">
    </element>
    <element name="result">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="severity" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="code" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="details" type="string">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <complexType name="resultArray">
    <sequence>
      <element maxOccurs="unbounded" minOccurs="0" ref="tns:result"/>
    </sequence>
  </complexType>
</schema>
