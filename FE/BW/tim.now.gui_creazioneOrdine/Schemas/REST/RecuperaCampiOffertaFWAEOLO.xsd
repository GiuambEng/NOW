<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RecuperaCampiOffertaFWAEOLO" xmlns:tns="http://www.example.org/RecuperaCampiOffertaFWAEOLO" elementFormDefault="qualified">

    <element name="VisualizzazioneSVLANCodeInput">
    	<complexType>
    		<sequence>
                <element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="idVlanOlolight" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="svlanCodelight" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="idVlanEololight" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="VisualizzazioneSVLANCodeOutput">
    	<complexType>
    		<sequence>
    			<element name="svlanCodeList" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="idVlanOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="svlanCode" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idVlanEolo" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="AutocompletamentoDatiSedeOutput">
    	<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0"
					name="provincia" type="string" />
				<element maxOccurs="unbounded" minOccurs="0"
					name="comune" type="string" />
				<element maxOccurs="unbounded" minOccurs="0"
					name="particellaToponomastica" type="string" />
				<element maxOccurs="unbounded" minOccurs="0"
					name="indirizzo" type="string" />
                <element name="civico" type="string" maxOccurs="unbounded" minOccurs="0"></element>
                <element name="codiceEgon" type="string"
					maxOccurs="unbounded" minOccurs="0">
				</element>
				<element minOccurs="0" name="result">
					<complexType>
						<sequence>

							<element minOccurs="0" name="severity"
								type="string" />
							<element minOccurs="0" name="code"
								type="string" />
							<element minOccurs="0" name="details"
								type="string" />


						</sequence>
					</complexType>
				</element>
			</sequence>
    	</complexType>
    </element>
</schema>