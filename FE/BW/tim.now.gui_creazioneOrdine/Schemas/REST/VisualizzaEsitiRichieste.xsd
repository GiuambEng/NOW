<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VisualizzaEsitiRichieste" xmlns:tns="http://www.example.org/VisualizzaEsitiRichieste" elementFormDefault="qualified">

    <element name="inputVisualizzaEsitiRichieste">
    	<complexType>
    		<sequence>
    			<element name="idRichiesta" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="tipoProfilo" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="IPClient" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="operatore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codOrdineOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputVisualizzaEsitiRichieste">
    	<complexType>
    		<sequence>
    			<element name="visualizzazioneNotificheOutput"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="tipologiaNotifica" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="causale" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="dataCreazione" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="notificaXML" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="ultimoFileNotifica" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="dataInvioFile" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idNotifica" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="visualizzazioneEsitiRichiesteOutput" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="dataInvio" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="statoNow" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="statoOao" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="lavorazioneRichiesta" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idRichiestaOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codiceRichiestaOao" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="xml" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="userId" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>