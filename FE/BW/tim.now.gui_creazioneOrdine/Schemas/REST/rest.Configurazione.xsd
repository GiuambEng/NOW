<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/rest.Configurazione" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/rest.Configurazione">

    <element name="OutputConfigurazione">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="outputConfigurazione">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="codice" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="descrizione" type="string">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="result">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="details" type="string"/>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

</schema>
