<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ClusterAccesso" xmlns:tns="http://www.example.org/ClusterAccesso" elementFormDefault="qualified">

    <element name="ClusterAccessoOutput">
    	<complexType>
    		<sequence>
    			<element name="ClusterAccesso" type="string"
    				maxOccurs="unbounded" minOccurs="0">
    			</element>
    			<element name="result">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>