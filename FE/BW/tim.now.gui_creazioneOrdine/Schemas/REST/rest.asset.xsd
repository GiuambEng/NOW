<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://NOW.it.telecomitalia.it/casedata" xmlns:tns="http://www.tim.com/NOW/rest/asset" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/asset">








	<element name="Asset">
		<complexType>
			<sequence>
				<element ref="tns:InputAsset"/>
				<element ref="tns:FaultAsset"/>
				<element ref="tns:OutputAsset1"/>
			</sequence>
		</complexType>
	</element>

	<complexType name="InputAsset">
		<sequence>
			<element maxOccurs="unbounded" minOccurs="0" name="inputAsset">
				<complexType>
					<sequence>
						<element maxOccurs="1" minOccurs="0" name="cod_Olo_Agcom" type="string"/>
					</sequence>
				</complexType>
      </element>
		</sequence>
	</complexType>

	<complexType name="FaultAsset">
		<sequence>
			<element name="error_message" type="string"/>
		</sequence>
	</complexType>
	<element name="InputAsset" type="tns:InputAsset"/>
	<element name="FaultAsset" type="tns:FaultAsset"/>

	<complexType name="OutputAsset">
		<sequence>
			<element maxOccurs="unbounded" minOccurs="0" name="OutputAsset">
				<complexType>
					<sequence>
						<element maxOccurs="1" minOccurs="0"
							name="codiceOlo" type="string" />
						<element maxOccurs="1" minOccurs="0"
							name="codiceOrdineTI" type="string" />
						<element maxOccurs="1" minOccurs="0" name="oao"
							type="string" />
						<element maxOccurs="1" minOccurs="0"
							name="idAssetCrm" type="string" />
						<element maxOccurs="1" minOccurs="0"
							name="idRisorsa" type="string" />
						<element maxOccurs="1" minOccurs="0"
							name="identificativoAsset" type="string">
						</element>
						<element maxOccurs="1" minOccurs="0"
							name="identificativoStatoAsset" type="string">
						</element>
						<element maxOccurs="1" minOccurs="0"
							name="identificativoTipologiaAccesso" type="string">
						</element>
						<element maxOccurs="1" minOccurs="0"
							name="offerta" type="string" />
						<element name="idRisorsaOperatoreRete" type="string" maxOccurs="1" minOccurs="0"></element>
					</sequence>
				</complexType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="result">
				<complexType>
					<sequence>
						<element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
						<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
						<element maxOccurs="1" minOccurs="0" name="details" type="string"/>
					</sequence>
				</complexType>
			</element>
            <element minOccurs="0" name="idExportFile" type="string"/>
        </sequence>
	</complexType>
	<element name="OutputAsset1" type="tns:OutputAsset"/>
</schema>
