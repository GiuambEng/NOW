<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RecuperoSubcontractor" xmlns:tns="http://www.example.org/RecuperoSubcontractor" elementFormDefault="qualified">

    <element name="outputRecuperoSubcontractor">
    	<complexType>
    		<sequence>
    			<element name="listaSubcontractor" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codiceOloNumerico" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codOloAgcomTitolare" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputRecuperaCodOloSubcontractor">
    	<complexType>
    		<sequence>
    			<element name="listaCodOloSubcontractor"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codOloAgcom" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codOloNumerico" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codOloAgcomTitolare" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>