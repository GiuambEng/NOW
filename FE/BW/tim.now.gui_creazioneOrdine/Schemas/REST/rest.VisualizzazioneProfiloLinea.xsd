<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/VisualizzazioneProfiloLinea" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VisualizzazioneProfiloLinea">

    <element name="VisualizzazioneProfiloOutput">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:visualizzazioneProfiloOutput">
    			</element>
    			<element name="result" type="tns:result" maxOccurs="1"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType></element>

    <complexType name="visualizzazioneProfilooutput">
    	<sequence>
    		<element name="idProfiloTecnicoLinea" type="int"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="profiloTecnicoLinea" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="idOfferta" type="int" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="offerta" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagVendibilita" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="maxVCxCF" type="int" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="profiloCommercialeDown" type="int"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="profiloCommercialeUp" type="int"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="velocitaAggancioDownMax" type="int"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="velocitaAggancioDownMin" type="int"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="velocitaAggancioUpMax" type="int"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="velocitaAggancioUpMin" type="int"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="bandaNetta" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="codiceModem" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="modem" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="modelloAccesso" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="protocollo" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="tecnologiaOlo" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="tipoModulazione" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="idProfiloBMD" type="int" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagOscurabile" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    	</sequence>
    </complexType>


    <complexType name="result">
    	<sequence>
    		<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <element name="visualizzazioneProfiloOutput"
    	type="tns:visualizzazioneProfilooutput">
    </element>
</schema>