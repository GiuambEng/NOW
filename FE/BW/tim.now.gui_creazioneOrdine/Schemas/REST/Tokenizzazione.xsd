<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Tokenizzazione" xmlns:tns="http://www.example.org/Tokenizzazione" elementFormDefault="qualified">

    <element name="inputTokenizzazione">
    	<complexType>
    		<sequence>
    			<element name="codOloAgcom" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codOrdineOlo" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idOfferta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="lavorazione" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codIstatComune" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="dn" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="operatore" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="IPClient" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="indirizzoClienteFinale" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="provincia" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="comune" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="partToponomastica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="indirizzo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="civico" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
                <element name="codiceOrdineTi" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="numeriReferenti" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="id" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="numeroFisso" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="numeroMobile" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="cognome" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codFiscale" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="pIva" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputTokenizzazione">
    	<complexType>
    		<sequence>
                <element name="referentiTokenizzati" maxOccurs="1"
                	minOccurs="0">
                	<complexType>
                		<sequence>
                			<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="numeriReferenti" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="id" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="numeroFisso" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="numeroMobile" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="cognome" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codFiscale" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="pIva" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
                        </sequence>
                	</complexType>
                </element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="numeriReferente" type="tns:referenteTokenizzato">
    </element>

    <complexType name="referenteTokenizzato">
    	<sequence>
    		<element name="numeroFisso" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="numeroMobile" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="id" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="cognome" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="codFiscale" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="pIva" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="outputNotificheDetokenizzate">
    	<complexType>
    		<sequence>
    			<element name="notificaDetokenizzata" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="idNotifica" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="xml" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputDetokenizzaRichieste">
    	<complexType>
    		<sequence>
    			<element name="listaRichieste" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="lavorazione" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codRichiestaOlo"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="xml" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="IPClient" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="operatore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codOrdineOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputDetokenizzaRichieste">
    	<complexType>
    		<sequence>
    			<element name="listaXml" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
                            <element name="codRichiestaOao" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="xml" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="xmlDetokenizzazione">
    	<sequence>
    		<element name="codRichiestaOao" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="xml" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="xmlDetokenizzato" type="tns:xmlDetokenizzazione"></element>

    <element name="inputDetokenizzaNotifica">
    	<complexType>
    		<sequence>
    			<element name="idNotifica" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="operatore" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="IPClient" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="tipoProfilo" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputHashingClienteFinale">
    	<complexType>
    		<sequence>
    			<element name="cognome" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="CF" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="PIVA" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codOrdineOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="IPClient" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="operatore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputHashingClienteFinale">
    	<complexType>
    		<sequence>
    			<element name="cognome" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="CF" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="PIVA" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>