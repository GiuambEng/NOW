<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/recuperoComuneProvincia" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/recuperoComuneProvincia">

    <element name="recuperoComuneProvinciaOutput"
    	type="tns:recuperoComuneProvincia">
    </element>
    
    <complexType name="recuperoComuneProvincia">
    	<sequence>
    		<element name="descrProvincia" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="idProvincia" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="descrComune" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="idComune" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="recuperoComuneeProvincia">
    	<complexType>
    		<sequence>
    			<element name="recuperooutput"
    				type="tns:recuperoComuneProvincia" minOccurs="0" maxOccurs="unbounded">
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>