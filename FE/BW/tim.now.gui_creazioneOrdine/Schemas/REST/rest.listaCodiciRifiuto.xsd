<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/rest.listaCodiciRifiuto" xmlns:tns="http://www.example.org/rest.listaCodiciRifiuto" elementFormDefault="qualified">

    <element name="listaCodiciRifiutoOutput"
    	type="tns:listaCodiciRifiutoOutput">
    </element>
    
    <complexType name="listaCodiciRifiutoOutput">
    	<sequence>
    		<element name="listaCodiciRifiutoOutput"
    			maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="codiceMotivoRifiuto" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="motivoRifiuto" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result" maxOccurs="1" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
</schema>