<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/VerificaCodice_OLO_numerico" xmlns:tns="http://www.tim.com/NOW/rest/VerificaCodice_OLO_numerico" elementFormDefault="qualified">

    <element name="Input_VerificaCodice_OLO_numerico"
    	type="tns:Input_VerificaCodice_OLO_numerico">
    </element>
    
    <element name="Output_VerificaCodice_OLO_numerico"
    	type="tns:Output_VerificaCodice_OLO_numerico">
    </element>
    
    <complexType name="Input_VerificaCodice_OLO_numerico">
    	<sequence>
    		<element name="Codifica_OLO_AGCOM" type="string" maxOccurs="1" minOccurs="1"></element>
    	</sequence>
    </complexType>

    <complexType name="Output_VerificaCodice_OLO_numerico">
    	<sequence>
    		<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
            <element name="result">
    			<complexType>
    				<sequence>
							<element name="severity" type="string" minOccurs="0" maxOccurs="1">
							</element>
							<element name="code" type="string" minOccurs="0" maxOccurs="1">
							</element>
							<element name="details" type="string" minOccurs="0" maxOccurs="1">
							</element>
						</sequence>
    			
    			</complexType>
    		</element>
        </sequence>
    </complexType>

    <element name="Fault_VerificaCodice_OLO_numerico"
    	type="tns:Fault_VerificaCodice_OLO_numerico">
    </element>
    
    <complexType name="Fault_VerificaCodice_OLO_numerico">
    	<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
    
    </complexType>
</schema>