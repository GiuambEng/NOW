<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/RecuperaProfiliFWA" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/RecuperaProfiliFWA">

    <element name="outputRecuperaProfiliFWA">
    	<complexType>
    		<sequence>
    			<element name="recuperaProfiliFWAOutput" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="profilo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="descrizioneProfilo"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="velocitaUp" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="velocitaDown" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputRecuperaProfiliFWA">
    	<complexType>
    		<sequence>
                <element name="profili" maxOccurs="unbounded" minOccurs="0"
                	type="string">
                </element>
                
    		</sequence>
    	</complexType>
    </element>
</schema>