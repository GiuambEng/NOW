<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/RecuperaNotificheRichiesta" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/RecuperaNotificheRichiesta">

    <element name="recuperaNotificheRichiestaOutput">
    	<complexType>
    		<sequence>
    			<element name="outputRecuperaNotificheRichiesta"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="tipologiaNotifica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="causale" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="dataCreazione"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="notificaXML" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="ultimoFileNotifica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInvioFile" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>