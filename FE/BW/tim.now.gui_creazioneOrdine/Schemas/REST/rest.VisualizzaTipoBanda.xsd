<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/rest.VisualizzaTipoBanda" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/rest.VisualizzaTipoBanda">

    <element name="inputVisualizzaTipoBanda">
    	<complexType>
    		<sequence>
    			<element name="VisualizzaTipoBanda"
    				maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codiceVlanSvlan"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputVisualizzaTipoBanda">
    	<complexType>
    		<sequence>
    			<element name="outputVisualizzaTipoBanda"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="tipoCos" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="tipoBanda" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>