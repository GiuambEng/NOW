<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/VisualizzazionePosizioneCoda" xmlns:tns="http://www.tim.com/NOW/rest/VisualizzazionePosizioneCoda" elementFormDefault="qualified">

    <element name="VisualizzazionePosizioneCoda_Fault">
    	<complexType>
    			<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
    	</complexType>
    </element>
    
    <element name="VisualizzazionePosizioneCoda_Output"
    	type="tns:VisualizzazionePosizioneCoda_Output">
    </element>

    <element name="VisualizzazionePosizioneCoda_Input">
    	<complexType>
    		<sequence>
    			<element name="Id_Risorsa" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Id_Telefonico" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Nome_Servizio" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="VisualizzazionePosizioneCoda_Output">
    	<sequence>
    		<element name="Esito " type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="result">
    			<complexType>
    				<sequence>
							<element name="severity" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
							<element name="code" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
							<element name="details" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
						</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
</schema>