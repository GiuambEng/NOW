                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="NomeCliente" minOccurs="0">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="30" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:choice>
                <xs:element name="CF">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
