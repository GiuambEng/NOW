                                                    <xs:restriction base="CodiceOrdine">
                                                        <xs:maxLength value="31" />
                                                        <xs:minLength value="1" />
                                                    </xs:restriction>
                                                </xs:simpleType>
                                            </xs:element>
                                            <xs:element name="ReferenteDesospensione" type="ReferenteInterruzioneSospensione" />
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                            </xs:choice>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:simpleType name="CodiceOrdine">
        <xs:restriction base="xs:string">
            <xs:maxLength value="31" />
