        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="ReferenteInterruzioneSospensione">
        <xs:sequence>
            <xs:element name="QualificaRef">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="2" />
                        <xs:enumeration value="O" />
                        <xs:enumeration value="CF" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="CognomeReferente">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="50" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="NomeReferente" >
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="30" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="TelefonoFissoReferente" minOccurs="0">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="15" />
                    </xs:restriction>
