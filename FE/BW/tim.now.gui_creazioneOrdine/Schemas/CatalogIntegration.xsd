<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/cmf/CatalogIntegration/" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/CatalogIntegration/">

    <element name="root">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" ref="tns:PRODUCT_ID">
    			</element>
    		</sequence>
    	</complexType>
  </element>
    <element name="PRODUCT_ID">
    	<simpleType>
    		<restriction base="string">
    			<enumeration value="ULL"/>
    			<enumeration value="SLU"/>
    			<enumeration value="ULLDati"/>
    		</restriction>
    	</simpleType>
    </element>
</schema>
