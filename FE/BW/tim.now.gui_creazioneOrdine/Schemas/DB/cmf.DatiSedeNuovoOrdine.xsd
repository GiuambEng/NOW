<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/DatiSedeNuovoOrdine" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/DatiSedeNuovoOrdine">

    <element name="datiSede">
    	<complexType>
    		<sequence>
    			<element ref="tns:datiSedeInput"></element>
    			<element ref="tns:datiSedeOutput" maxOccurs="unbounded" minOccurs="0"></element>
    			<element ref="tns:datiSedeFault"></element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="datiSedeInputType">
    	<sequence>
    		<element name="codOrdineOlo" type="string"></element>
    	</sequence>
    </complexType>
    
    <complexType name="datiSedeOutputType">
    	<sequence>
    		<element name="datiSedeOutputNuovoOrdine"
    			type="tns:datiSedeOutputNuovoOrdineType" maxOccurs="unbounded" minOccurs="0">
    		</element>
    	</sequence>
    </complexType>
    
    <complexType name="datiSedeFaultType">
    	<sequence>
    		<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <element name="datiSedeInput" type="tns:datiSedeInputType"></element>
    <element name="datiSedeOutput" type="tns:datiSedeOutputType"></element>
    <element name="datiSedeFault" type="tns:datiSedeFaultType"></element>

    <complexType name="datiSedeOutputNuovoOrdineType">
    	<sequence>
    		<element name="idRichiestaOlo" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="idSede" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="particellaToponomastica" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="provincia" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="cap" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="tipologiaSede" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="scala" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>