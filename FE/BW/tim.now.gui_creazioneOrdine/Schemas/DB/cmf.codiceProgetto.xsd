<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/codiceProgetto" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/cmf/codiceProgetto">
	<element name="CodiceProgetto" type="tns:CodiceProgetto"/>
	<complexType name="CodiceProgetto">
		<sequence>
			<element maxOccurs="unbounded" minOccurs="0" name="CodProgetto" type="tns:CodProgetto"/>
		</sequence>
	</complexType>
	<complexType name="CodProgetto">
		<sequence>
			<element ref="tns:CodProgettoInput" maxOccurs="unbounded" minOccurs="0"/>
			<element maxOccurs="unbounded" minOccurs="0" ref="tns:CodProgettoOutput">
    		</element>
			<element ref="tns:CodProgettoFault" maxOccurs="unbounded" minOccurs="0"/>
		</sequence>
	</complexType>
	<complexType name="CodProgettoInput">
		<sequence>
			<element name="CodProgettoInput" maxOccurs="unbounded" minOccurs="0">
				<complexType>
					<sequence>
						<element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
					</sequence>
				</complexType></element>
		</sequence>
	</complexType>
	<complexType name="CodProgettoFault">
		<sequence>
			<element name="messaggio" type="string" maxOccurs="1" minOccurs="0"/>
			<element name="codice" type="string" maxOccurs="1" minOccurs="0"/>
		</sequence>
	</complexType>
	<element name="CodProgettoInput" type="tns:CodProgettoInput"/>
	<element name="CodProgettoOutput" type="tns:CodProgettoOutput"/>
	<element name="CodProgettoFault" type="tns:CodProgettoFault"/>
	<complexType name="CodProgettoOutput">
		<sequence>
			<element maxOccurs="unbounded" minOccurs="0" name="codiciProgetto">
				<complexType>
					<sequence>
						<element name="cod_prgt" type="string"
							maxOccurs="1" minOccurs="0" />
						<element name="codfc_olo_agcom" type="string"
							maxOccurs="1" minOccurs="0" />
						<element name="datafi_valid" type="string"
							maxOccurs="1" minOccurs="0" />
						<element name="datainz_valid" type="string"
							maxOccurs="1" minOccurs="0" />
						<element name="flag_fittizio" type="string"
							maxOccurs="1" minOccurs="0" />
						<element name="id_prgt" type="string"
							maxOccurs="1" minOccurs="0" />
						<element name="report" type="string"
							maxOccurs="1" minOccurs="0" />
						<element name="flagVull" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="oneStep" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="prodottiACatalogo" type="string" maxOccurs="1" minOccurs="0"></element>
					</sequence>
				</complexType>
			</element>
			<element name="result" maxOccurs="1" minOccurs="0">
				<complexType>
					<sequence>
						<element name="severity" type="string" maxOccurs="1" minOccurs="0">
    					</element>
						<element name="code" type="string" maxOccurs="1" minOccurs="0">
    					</element>
						<element name="details" type="string" maxOccurs="1" minOccurs="0">
    					</element>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
</schema>
