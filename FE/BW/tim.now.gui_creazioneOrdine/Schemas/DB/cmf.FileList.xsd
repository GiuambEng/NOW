<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/FileList/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/cmf/FileList/">

    <element name="FileListInput">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="ClientCode" type="string"/>
    		</sequence>
    	</complexType>
  </element>





    <element name="FileListOutput">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="File" type="tns:File"/>
    		</sequence>
    	</complexType>
  </element>

    <complexType name="File">
    	<sequence>
    		<element name="NOMEFILE" type="string"/>
    		<element name="DIMENSIONEFILE" type="string"/>
    		<element name="IDENTIFICATIVOCAUSALESCARTO" type="string">
    		</element>
    		<element name="QUANTITARECORDKO" type="string"/>
    		<element name="QUANTITARECORDNOW" type="string"/>
    		<element name="QUANTITARECORDOK" type="string"/>
    		<element name="QUANTITARECORDTOTALI" type="string"/>
    		<element name="TIMESTAMPAGGIORNAMENTO" type="dateTime"/>
    		<element name="STATONOTIFICA" type="string"/>
    		<element name="IDRICHIESTA" type="string"/>
    		<element name="DATACREAZIONE" type="string"/>
    		<element name="TOTALEORDINICRMWS" type="string"/>
    	</sequence>
    </complexType>

    <complexType name="SEMAFORO">
    	<sequence>
    		<element ref="tns:SEMAFORO_INPUT"/>
    		<element ref="tns:SEMAFORO_OUTPUT"/>
    	</sequence>
    </complexType>
    <element name="SEMAFORO" type="tns:SEMAFORO"/>

    <complexType name="SEMAFORO_INPUT">
    	<sequence>
    		<element name="IDFILE" type="string" />
    	</sequence>
    </complexType>
    
    <complexType name="SEMAFORO_OUTPUT">
    	<sequence>
    		<element name="SEMAFORO" type="string"/>
    	</sequence>
    </complexType>
    <element name="SEMAFORO_INPUT" type="tns:SEMAFORO_INPUT"/>
    <element name="SEMAFORO_OUTPUT" type="tns:SEMAFORO_OUTPUT"/>


    <element name="Output_Rest">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:Semaforo"/>
    		</sequence>
    	</complexType>
    </element>
    <element name="Semaforo" type="tns:SEMAFORO_OUTPUT"/>

    <element name="VisualizzaInput" type="tns:VisualizzaInput">
    </element>
    

    <complexType name="VisualizzaInput">
    	<sequence>
    		<element name="CodiceAgCom" type="string"/>
    	</sequence>
    </complexType>
    
    <complexType name="VisualizzaOutput">
    	<sequence>
    		<element name="Tipologia" type="string" />
    		<element name="NomeFile"
    			type="string" />
    		<element name="DataCreazione" type="date" />
    		<element name="CodificaOlo" type="string" />
    		<element name="DimensioneFile" type="string"></element>
    		<element name="EsitoInvio" type="string"></element>
    		<element name="QuantitaRecordTotali" type="string"></element>
    		<element name="DataInvio" type="date"></element>
    	</sequence>
    </complexType>

    <element name="Accorpante">
    	<complexType>
    		<sequence>
    			<element ref="tns:accorpanteInput"></element>
    			<element ref="tns:accorpanteOutput"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="accorpanteInput" type="tns:accorpanteInput"></element>

    <complexType name="accorpanteInput">
    	<sequence>
    		<element name="userid" type="string"></element>
    	</sequence>
    </complexType>
    <element name="accorpanteOutput" type="tns:accorpanteOutput"></element>

    <complexType name="accorpanteOutput">
    	<sequence>
    		<element name="flagOloAccorpante" type="string"></element>
    	</sequence>
    </complexType>

    <element name="listaOLO">
    	<complexType>
    		<sequence>
    			<element ref="tns:listaOLOInput"></element>
    			<element ref="tns:listaOLOOutput"></element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="NewType"></complexType>
    <element name="listaOLOInput" type="tns:listaOLOInput"></element>
    <element name="listaOLOOutput" type="tns:listaOLOOutput"></element>

    <complexType name="listaOLOInput">
    	<sequence>
    		<element name="codiceAgcom" type="string"></element>
    	</sequence>
    </complexType>
    
    <complexType name="listaOLOOutput">
    	<sequence>
    		<element name="codiceAgcom" type="string"></element>
    		<element name="flagAccorpante" type="string"></element>
    		<element ref="tns:anagraficaOLO" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="anagrafica">
    	<sequence>
    		<element name="nome" type="string"></element>
    		<element name="codiceAgcom" type="string"></element>
    	</sequence>
    </complexType>
    <element name="Anagrafica" type="tns:anagrafica"></element>

    <complexType name="anagraficaOLO">
    	<sequence>
    		<element name="nome" type="string"></element>
    		<element name="codiceAgcom" type="string"></element>
    	</sequence>
    </complexType>
    <element name="anagraficaOLO" type="tns:anagraficaOLO"></element>

    <element name="VisualizzaOutput" type="tns:NewType1"></element>
    
    <complexType name="NewType1">
    	<sequence>
    		<element minOccurs="0" maxOccurs="unbounded"
    			ref="tns:Visualizza">
    		</element>
    	</sequence>
    </complexType>
    <element name="Visualizza" type="tns:VisualizzaOutput"></element>

    <element name="Output_Rest_Visualizzazione" type="tns:NewType2"></element>
    
    <complexType name="NewType2">
    	<sequence>
    		<element minOccurs="0" maxOccurs="unbounded"
    			ref="tns:Outpu_rest_visual">
    		</element>
    	</sequence>
    </complexType>
    <element name="Outpu_rest_visual">
    	<complexType>
    		<sequence>
    			<element name="Output_Visual" type="tns:VisualizzaOutput"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>
