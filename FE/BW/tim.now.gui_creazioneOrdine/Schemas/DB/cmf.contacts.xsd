<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/cmf/contacts/" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/contacts/">
       <element name="contacts">
             <complexType>
                    <sequence>
                           <element name="OLOContactsList">
                                  <complexType>
                                        <sequence>
                                               <element ref="tns:OLOContactsListInput">
                                        </element>
                                               <element ref="tns:OLOContactsListOutput" maxOccurs="unbounded" minOccurs="0">
                                        </element>
                                               <element ref="tns:OLOContactsListFault">
                                        </element>
                                        </sequence>
                                  </complexType>
                           </element>
                           <element name="otherContactsList">
                                  <complexType>
                                        <sequence>
                                               <element ref="tns:otherContactsListInput"/>
                                               <element ref="tns:otherContactsListOutput" maxOccurs="unbounded" minOccurs="0">
                                        </element>
                                               <element ref="tns:otherContactsListFault"/>
                                        </sequence>
                                  </complexType>
                           </element>
                           <element name="contactsDetail">
                                  <complexType>
                                        <sequence>
                                               <element ref="tns:contactsDetailInput">
                                        </element>
                                               <element ref="tns:contactsDetailOutput">
                                        </element>
                                               <element ref="tns:contactsDetailFault">
                                        </element>
                                        </sequence>
                                  </complexType>
                           </element>
                           <element name="contactsReferences">
                                  <complexType>
                                        <sequence>
                                               <element ref="tns:contactsReferencesInput">
                                        </element>
                                               <element ref="tns:contactsReferencesOutput">
                                        </element>
                                               <element ref="tns:contactsReferencesFault">
                                        </element>
                                        </sequence>
                                  </complexType>
                           </element>
                    </sequence>
             </complexType>
       </element>
       <complexType name="contactsDetailOutput">
             <sequence>
                    <element name="contactDetailOutput" maxOccurs="unbounded" minOccurs="0">
                           <complexType>
                                  <sequence>
                                   <element name="oao" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                        <element name="primary" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                        <element name="nome" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                        <element name="cognome" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                        <element name="mr_Ms" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                        <element name="tipoReferente" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                        <element name="metodoContatto" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                        <element name="operatore" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                        <element name="dataUltimoAggiornamento" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                        <element name="dataInserimento" type="string" maxOccurs="1" minOccurs="0">
                                  </element>
                                 
                                  </sequence>
                           </complexType>
                    </element>
             </sequence>
       </complexType>
       <element name="OLOContactsListInput" type="tns:ContactsListInput">
    </element>
       <element name="OLOContactsListOutput" type="tns:contactsListOutput">
    </element>
       <element name="OLOContactsListFault" type="tns:contactsFault">
    </element>
       <element name="otherContactsListInput" type="tns:contactsListInput">
    </element>
       <element name="otherContactsListOutput" type="tns:contactsListOutput">
    </element>
       <element name="otherContactsListFault" type="tns:contactsFault">
    </element>
       <complexType name="contactsDetailInput">
             <sequence>
                    <element maxOccurs="1" minOccurs="1" name="identificativoContatto" type="string"/>
             </sequence>
       </complexType>
       <complexType name="contactsListInput">
             <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="codOLO" type="string"/>
             </sequence>
       </complexType>
       <complexType name="contactsListOutput">
             <sequence>
                    <element name="contactListOutput" maxOccurs="unbounded" minOccurs="0">
                           <complexType>
                                  <sequence>
                                  <element name="oao" maxOccurs="1" minOccurs="0">
                            <complexType>
                            	<sequence>
                            		<element name="olo" type="string"
                            			maxOccurs="1" minOccurs="0">
                            		</element>
                            		<element name="ragioneSociale"
                            			type="string" maxOccurs="1"
                            			minOccurs="0">
                            		</element>
                            		<element name="partitaIva"
                            			type="string" maxOccurs="1"
                            			minOccurs="0">
                            		</element>
                            		<element name="codiceOloAgcom"
                            			type="string" maxOccurs="1"
                            			minOccurs="0">
                            		</element>
                            		<element name="codiceOloNumerico"
                            			type="string" maxOccurs="1"
                            			minOccurs="0">
                            		</element>
                            		<element name="flagAccorpante"
                            			type="string" maxOccurs="1" minOccurs="0">
                            		</element>
                            	</sequence>
                            </complexType>
                                   </element>
                                  	<element name="idContatto"
                                  		type="string" maxOccurs="1" minOccurs="0">
                                  	</element>
                                  	<element name="primary"
                                  		type="string" maxOccurs="1"
                                  		minOccurs="0">
                                  	</element>
                                  	<element name="nome" type="string"
                                  		maxOccurs="1" minOccurs="0">
                                  	</element>
                                  	<element name="cognome"
                                  		type="string" maxOccurs="1"
                                  		minOccurs="0">
                                  	</element>
                                  	<element name="mr_Ms"
                                  		type="string" maxOccurs="1"
                                  		minOccurs="0">
                                  	</element>
                                  	<element name="tipoReferente"
                                  		type="string" maxOccurs="1"
                                  		minOccurs="0">
                                  	</element>
                                  	<element name="metodoContatto"
                                  		type="string" maxOccurs="1"
                                  		minOccurs="0">
                                  	</element>
                                  	<element name="operatore"
                                  		type="string" maxOccurs="1"
                                  		minOccurs="0">
                                  	</element>
                                  	<element
                                  		name="dataUltimoAggiornamento"
                                  		type="string" maxOccurs="1"
                                  		minOccurs="0">
                                  	</element>
                                  	<element name="dataInserimento"
                                  		type="string" maxOccurs="1"
                                  		minOccurs="0">
                                  	</element>
                                  </sequence>
                           </complexType>
                    </element>
             </sequence>
       </complexType>
       <complexType name="contactsFault">
             <sequence>
                    <element maxOccurs="1" minOccurs="1" name="message" type="string"/>
                    <element maxOccurs="1" minOccurs="0" name="code" type="string"/>
             </sequence>
       </complexType>
       <complexType name="ContactsListInput">
             <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" name="codOlo" type="string"/>
             </sequence>
       </complexType>
       <element name="contactsDetailInput" type="tns:contactsDetailInput">
    </element>
       <element name="contactsDetailOutput" type="tns:contactsDetailOutput">
    </element>
       <element name="contactsDetailFault" type="tns:contactsFault"/>
       <complexType name="contactsReferencesInput">
             <sequence>
                    <element name="idContatto" type="string">
             </element>
             </sequence>
       </complexType>
       <complexType name="contactsReferencesOutput">
             <sequence>

             	<element name="riferimentiContatti" maxOccurs="unbounded" minOccurs="0">
             		<complexType>
             			<sequence>
             				<element name="indirizzo" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="numeroCivico" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="numeroMobl" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="particellaTopon"
             					type="string" maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="prefissoFisso" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="prefissoMobl" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="prov" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="telfFisso" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="telfFissoAlternativo"
             					type="string" maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="cap" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="cellulareAlternativo"
             					type="string" maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="codIstatComune"
             					type="string" maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="codIstatIndirizzo"
             					type="string" maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="codIstatProvincia"
             					type="string" maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="comune" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="email" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="fax" type="string"
             					maxOccurs="1" minOccurs="0">
             				</element>
             				<element name="idContatto" type="string" maxOccurs="1" minOccurs="0"></element>
             			</sequence>
             		</complexType>
             	</element>
             </sequence>
       </complexType>
       <complexType name="contactsReferencesFault">
             <sequence>
                    <element name="message" type="string" maxOccurs="1" minOccurs="1">
             </element>
                    <element name="code" type="string" maxOccurs="1" minOccurs="0">
             </element>
             </sequence>
       </complexType>
       <element name="contactsReferencesInput" type="tns:contactsReferencesInput">
    </element>
       <element name="contactsReferencesOutput" type="tns:contactsReferencesOutput">
    </element>
       <element name="contactsReferencesFault" type="tns:contactsReferencesFault">
    </element>
</schema>

