<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/cmf/cmf.VisualizzazioneListaBandePicco" xmlns:tns="http://www.tim.com/NOW/cmf/cmf.VisualizzazioneListaBandePicco" elementFormDefault="qualified">

    <element name="VisualizzazioneListaBandePicco_Input">
    	<complexType>

    		<sequence>
    			<element name="VisualizzazioneListaBandePicco_Input"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>

    					<sequence>
    						<element name="column" type="string"
    							maxOccurs="1" minOccurs="1">
    						</element>
    						<element name="operation" type="string"
    							maxOccurs="1" minOccurs="1">
    						</element>
    						<element name="value" type="string"
    							maxOccurs="1" minOccurs="1">
    						</element>

    						<element name="tipoCos" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>

    				</complexType>
    			</element>
    			<element name="concatResult" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="VisualizzazioneListaBandePicco_Fault">
    	<complexType>
    	<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
    	</complexType>
    </element>
    
    <element name="VisualizzazioneListaBandePicco_Output">
    	<complexType>
    		<sequence>
    			<element name="VisualizzazioneListaBandePicco_Output" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="BANDA_UPSTREAM"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="BANDA_DOWNSTREAM"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="IDENTIFICATIVO_BANDA_PICCO"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="MODELLO" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="TIPO_COS" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>