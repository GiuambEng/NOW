<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/Asset"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/cmf/Asset"
	xmlns:Q1="http://NOW.it.telecomitalia.it/casedata">








	<element name="Asset">
		<complexType>
			<sequence>
				<element ref="tns:InputAsset"></element>
				<element ref="tns:FaultAsset"></element>
				<element ref="tns:OutputAsset1" minOccurs="0" maxOccurs="unbounded"></element>
			</sequence>
		</complexType>
	</element>

	<complexType name="InputAsset">
		<sequence>
			<element name="inputAsset" maxOccurs="unbounded" minOccurs="0">
				<complexType>
					<sequence>
						<element name="cod_Olo_Agcom" type="string" maxOccurs="1" minOccurs="0"></element>
					</sequence>
				</complexType></element>
		</sequence>
	</complexType>

	<complexType name="FaultAsset">
		<sequence>
			<element name="error_message" type="string"></element>
		</sequence>
	</complexType>
	<element name="InputAsset" type="tns:InputAsset"></element>
	<element name="FaultAsset" type="tns:FaultAsset"></element>

	<complexType name="OutputAsset">
		<sequence>
			<element name="OutputAsset" maxOccurs="unbounded" minOccurs="0">
				<complexType>
					<sequence>
						<element name="codiceOlo" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="codiceOrdineTI" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
                        <element name="oao" type="string" minOccurs="0" maxOccurs="1"></element>
                        <element name="idAssetCrm" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="idRisorsa" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="identificativoAsset"
							type="string" maxOccurs="1" minOccurs="0">
						</element>
						<element name="identificativoStatoAsset"
							type="string" maxOccurs="1" minOccurs="0">
						</element>
						<element name="identificativoTipologiaAccesso"
							type="string" maxOccurs="1" minOccurs="0">
						</element>
						<element name="offerta" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
					</sequence>
				</complexType></element>
		</sequence>
	</complexType>
	<element name="OutputAsset1" type="tns:OutputAsset"></element>
</schema>