<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/VisualizzazioneReferenteContattato" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/VisualizzazioneReferenteContattato">

    <element name="VisualizzazioneReferenteContattato">
    	<complexType>
    		<sequence>
    			<element name="referenteContattato">
    				<complexType>
    					<sequence>
    						<element
    							ref="tns:visualizzazioneReferenteContattatoInput">
    						</element>
    						<element maxOccurs="unbounded" minOccurs="0"
    							ref="tns:visualizzazioneReferenteContattatoOutput">
    						</element>
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType></element>
    <element name="visualizzazioneReferenteContattatoInput">
    	<complexType>
    		<sequence>
    			<element name="idOrdine" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="visualizzazioneReferenteContattatoOutput">
        <complexType>
        	<sequence>
        		<element maxOccurs="unbounded" minOccurs="0"
        			ref="tns:visualizzazioneReferenteContattatoOutput1">
        		</element>
        	</sequence>
        </complexType>
    </element>
    <element name="visualizzazioneReferenteContattatoOutput1">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="1" name="dataContatto"
    				type="date">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="dataVisitaContatto" type="date">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="esitoChiamataContatto" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="nominativoContatto" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="notaUlterioreContatto" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1" name="oraContatto"
    				type="time">
    			</element>
    			<element name="progressivoEventoDtu" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="oraVisitaContatto" type="time" maxOccurs="1" minOccurs="0"></element>
    			<element name="progressivoReferente" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element minOccurs="0" maxOccurs="1"
    				name="telefonoFissoReferente" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="telefonoMobileReferente" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1"
    				name="timestampInserimento" type="date">
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>