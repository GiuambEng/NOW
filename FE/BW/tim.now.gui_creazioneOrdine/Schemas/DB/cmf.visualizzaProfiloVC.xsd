<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/visualizzaProfiloVC" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/visualizzaProfiloVC">

    <element name="inputVisualizzaProfiloVC">
    	<complexType>
    		<sequence>
    			<element name="profilo" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="idOfferta" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="tipoProfilo" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>

    <element name="outputVisualizzaProfiloVC">
    	<complexType>
    		<sequence>
    			<element name="outputVisualizzaProfiloVC" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    					<element name="identificativoProfiloVc"
    						type="decimal" maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="profilo" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="tipoProfilo" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="flagVendibilita" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
                        <element name="mcr_Down" type="decimal"
    						maxOccurs="1" minOccurs="0">
    					</element>
                        <element name="mcr_Up" type="decimal" maxOccurs="1" minOccurs="0"></element>
                        <element name="pcr_Down" type="decimal"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="pcr_Up" type="decimal" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="scr_Down" type="decimal"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="scr_Up" type="decimal" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="identificativoOfferta" type="decimal"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="offerta" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    				</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType></element>

    <element name="faultVisualizzaProfiloVC">
    	<complexType>
    		<sequence>
    			<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
</schema>