<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/AutocompletamentoDatiSede" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/cmf/AutocompletamentoDatiSede">
	<element name="DatiSede">
		<complexType>
			<sequence>
				<element ref="tns:DatiSedeInput"/>
				<element ref="tns:DatiSedeOutput"/>
				<element ref="tns:DatiSedeFault"/>
			</sequence>
		</complexType>
	</element>
	<element name="DatiSedeInput">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="Modalita">
					<simpleType>
						<restriction base="string">
                		</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Provincia" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Comune" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ParticellaToponomastica" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Indirizzo" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="DatiSedeOutput">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0" name="provincia" type="string"/>
				<element maxOccurs="unbounded" minOccurs="0" name="comune" type="string"/>
				<element maxOccurs="unbounded" minOccurs="0" name="particellaToponomastica" type="string"/>
				<element maxOccurs="unbounded" minOccurs="0" name="indirizzo" type="string"/>
				<element maxOccurs="unbounded" minOccurs="0" name="civico" type="string"/>
				<element minOccurs="0" name="result">
    			<complexType>
					<sequence>
						
						<element minOccurs="0" name="severity" type="string"/>
						<element minOccurs="0" name="code" type="string"/>
						<element minOccurs="0" name="details" type="string"/>  
						
							    		
					</sequence>
				</complexType>
			    </element>
			</sequence>
		</complexType>
	</element>
	<element name="DatiSedeFault">
		<complexType>
			<sequence>
				<element name="Messaggio" type="string"/>
				<element name="Codice" type="string"/>
			</sequence>
		</complexType>
	</element>
    <element name="operationRequest">
    <complexType>
      <sequence>
        <element name="in" type="string"/>
      </sequence>
    </complexType>
  </element>
    <element name="operationResponse">
    <complexType>
      <sequence>
        <element name="out" type="string"/>
      </sequence>
    </complexType>
  </element>
    <element name="operationRequest1">
    <complexType>
      <sequence>
        <element name="in" type="string"/>
      </sequence>
    </complexType>
  </element>
</schema>
