<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/VisualizzazioneEsitiRichieste/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/cmf/VisualizzazioneEsitiRichieste/">

    <element name="VisualizzazioneEsitiRichiesteInput">
      <complexType>
            <sequence>
                  <element maxOccurs="1" minOccurs="0" name="idRichiesta" type="string"/>
                <element name="codOloAgcom" type="string"/>
                <element name="tipoProfilo" type="string"/>
            </sequence>
      </complexType>
    </element>
    
    <element name="VisualizzazioneEsitiRichiesteOutput">
      <complexType>
            <sequence>
                  <element maxOccurs="unbounded" minOccurs="0" name="VisualizzazioneEsitiRichiesteOutput">
                        <complexType>
                             <sequence>
                                   <element maxOccurs="1" minOccurs="0" name="dataInvio" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="statoNow" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="statoOao" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="lavorazioneRichiesta" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="idRichiestaOlo" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="codiceRichiestaOao" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="xml" type="string"/>
                            <element minOccurs="0" name="userId" type="string"/>
                        </sequence>
                        </complexType>
                  </element>
            </sequence>
      </complexType>
    </element>
    
    <element name="VisualizzazioneEsitiRichiesteFault">
      <complexType>
            <sequence>
                  <element name="msg" type="string"/>
                  <element name="code" type="string"/>
            </sequence>
      </complexType>
    </element>


    <element name="VisualizzazioneNotificheInput">
      <complexType>
            <sequence>
                  <element maxOccurs="1" minOccurs="0" name="idRichiesta" type="string">
                  </element>
                  <element maxOccurs="1" minOccurs="0" name="tipoProfilo" type="string"/>
                <element maxOccurs="1" minOccurs="0" name="codAgcom" type="string"/>
            </sequence>
      </complexType>
    </element>

    <element name="VisualizzazioneNotificheOutput">
      <complexType>
            <sequence>
                  <element maxOccurs="unbounded" minOccurs="0" name="VisualizzazioneNotificheOutput">
                        <complexType>
                             <sequence>
                                   <element maxOccurs="1" minOccurs="0" name="tipologiaNotifica" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="causale" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="dataCreazione" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="notificaXML" type="string">
                                   </element>
                            <element maxOccurs="1" minOccurs="0" name="ultimoFileNotifica" type="string"/>
                            <element maxOccurs="1" minOccurs="0" name="dataInvioFile" type="string"/>

                             </sequence>
                        </complexType>
                  </element>
                  
            </sequence>
      </complexType>
    </element>

    <element name="VisualizzazioneEsitiNotifiche">
      <complexType>
            <sequence>
                  <element maxOccurs="unbounded" minOccurs="0" name="visualizzazioneNotificheOutput">
                        <complexType>
                             <sequence>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="tipologiaNotifica" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="causale" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="dataCreazione" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="notificaXML" type="string">
                             	</element>
                             	<element maxOccurs="1" minOccurs="0"
                             		name="ultimoFileNotifica" type="string" />
                             	<element maxOccurs="1" minOccurs="0"
                             		name="dataInvioFile" type="string" />

                             	<element name="idNotifica"
                             		type="string" maxOccurs="1" minOccurs="0">
                             	</element>
                             </sequence>
                        </complexType>
                  </element>
                  <element maxOccurs="unbounded" minOccurs="0" name="visualizzazioneEsitiRichiesteOutput">
                        <complexType>
                             <sequence>
                                   <element maxOccurs="1" minOccurs="0" name="dataInvio" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="statoNow" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="statoOao" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="lavorazioneRichiesta" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="idRichiestaOlo" type="string">
                                   </element>
                                   <element maxOccurs="1" minOccurs="0" name="codiceRichiestaOao" type="string"/>
                                   <element maxOccurs="1" minOccurs="0" name="xml" type="string"/>
                            <element minOccurs="0" name="userId" type="string"/>
                        </sequence>
                        </complexType>
                  </element>
            </sequence>
      </complexType>
    </element>
</schema>
