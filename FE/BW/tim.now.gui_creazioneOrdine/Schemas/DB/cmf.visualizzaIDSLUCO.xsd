							<element name="testarmadio" type="string" maxOccurs="1" minOccurs="0">
    						</element>
						</sequence>
					</complexType>
				</element>
				<element name="result" minOccurs="0">
					<complexType>
						<sequence>
							<element name="severity" type="string" minOccurs="0"/>
