<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/DownloadFile/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/DownloadFile/">

    <element name="DownloadFileInput">
    	<complexType>
    		<sequence>
    			<element name="IDFile" type="string" minOccurs="1" maxOccurs="1"></element>
    		</sequence>
    	</complexType></element>

    <element name="DownloadFileOutput">
    	<complexType>
    		<sequence>
    			<element name="IDFile" type="string" minOccurs="1" maxOccurs="1"></element>
    			<element name="FileContent" type="hexBinary" minOccurs="0" maxOccurs="1"></element>
    		</sequence>
    	</complexType></element>
</schema>