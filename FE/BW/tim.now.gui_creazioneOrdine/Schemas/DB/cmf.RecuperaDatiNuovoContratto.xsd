<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/RecuperaDatiNuovoContratto" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/RecuperaDatiNuovoContratto">

    <element name="recuperaDatiContratto">
    	<complexType>
    		<sequence>
    			<element ref="tns:recuperaDatiContrattoInput"></element>
    			<element ref="tns:recuperaDatiContrattoOutput">
    			</element>
    			<element ref="tns:recuperaDatiContrattoFault"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="recuperaDatiContrattoInput">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="1"
    				name="idFamigliaOfferta" type="string">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="recuperaDatiContrattoOutput">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="unbounded"
    				name="tipoServizio" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="unbounded"
    				name="idFamigliaOfferta" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="unbounded"
    				name="tipoProdotti" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="unbounded"
    				name="idSottofamigliaOfferta" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="unbounded"
    				name="offerta" type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="unbounded"
    				name="idOfferta" type="string">
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="recuperaDatiContrattoFault">
    	<complexType>
    		<sequence>
    			<element name="Messaggio" type="string"></element>
    			<element name="Codice" type="string"></element>
    		</sequence>
    	</complexType>
    </element>


    <element name="recuperoContratti">
    	<complexType>
    		<sequence>
    			<element name="recuperoContrattoOutput">
    				<complexType>
    					<sequence>
    						<element name="tipologiaContrattoOutput"
    							maxOccurs="unbounded" minOccurs="0">
    							<complexType>
    								<sequence>
    									<element name="tipologiaContratto"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="idTipologiaContratto"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    								</sequence>
    							</complexType>
    						</element>
    						<element name="result" maxOccurs="1"
    							minOccurs="0">
    							<complexType>
    								<sequence>
    									<element name="severity"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="code"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="details"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    								</sequence>
    							</complexType>
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="recuperaFlagMulticastOutput">
    	<complexType>
    		<sequence>
    			<element name="flagMulticast" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>