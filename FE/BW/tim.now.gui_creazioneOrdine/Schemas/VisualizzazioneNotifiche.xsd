<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/" targetNamespace="http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/" elementFormDefault="qualified">
	<element name="Request">
		<complexType>
			<sequence>
				<element name="DatiNotifiche" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="IDNotifica" type="int"/>
							<element name="Operatore" type="string" minOccurs="0"/>
							<element name="FunzioneChiamante" type="string" minOccurs="0"/>
							<element name="IPClient" type="string" minOccurs="0"/>
							<element name="isOLO" type="boolean" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Response">
		<complexType>
			<sequence>
				<element name="DatiNotificheResponse" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="contenutoXML" type="string" minOccurs="0"/>
							<element name="IDNotifica" type="int" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Msg" type="string" minOccurs="0"/>
				<element name="MsgCode" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>
