<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns:ns1="http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoFAULT"
	 targetNamespace="http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoFAULT"
	 elementFormDefault="unqualified"
	 attributeFormDefault="unqualified">
	<xs:element name="FAULT" type="ns1:FAULT_TYPE"/>
	<xs:complexType name="FAULT_TYPE">
		<xs:sequence>
			<xs:element name="CODE_ERROR">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DESC_ERROR">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="255"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>