<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/NuovaRichiesta" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/cmf/NuovaRichiesta">

    <element name="NuovaRichiesta">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0"
    				name="CausaleRichiesta" type="string" />
    			<element name="OAO" type="string" minOccurs="0"
    				maxOccurs="1" />
    			<element name="operatore" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				name="CodiceRichiesta" type="string" />
    			<element name="CodiceOrdineTI" type="string"
    				minOccurs="0" maxOccurs="1" />
    			<element name="idRichiestaOlo" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codiceOrdineOlo" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="DAD"
    				type="date" />
    			<element name="dac" type="date" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="FasciaOraria"
    				type="string" />
    			<element name="noteDaOperatore" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="noteAltreLavorazioni" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="flagAccettazione" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="riscontroCodiceSessione" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="causaleRifiuto" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codiceMotivoRifiuto" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="motivoRifiuto" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element maxOccurs="1" minOccurs="0"
    				name="ReferenteDesospensione">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0"
    							name="Nome" type="string" />
    						<element maxOccurs="1" minOccurs="0"
    							name="Cognome" type="string" />
    						<element maxOccurs="1" minOccurs="0"
    							name="TelefonoFissoReferente" type="string" />
    						<element maxOccurs="1" minOccurs="0"
    							name="CellulareReferente" type="string" />
    						<element maxOccurs="1" minOccurs="0"
    							name="Qualifica" type="string" />
    						<element name="Email" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>

    		</sequence>
    	</complexType>
  </element>
    	
    	<element name="outputNuovaRichiesta">
		<complexType>
			<sequence>
				<element minOccurs="0" name="processID" type="string">
				</element>
				<element minOccurs="0" name="result">
					<complexType>
						<sequence>
							<element minOccurs="0" name="severity" type="string"> 		</element>
							<element minOccurs="0" name="code" type="string">    		</element>
							<element minOccurs="0" name="details" type="string">    		</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

    <element name="Process_ID">
    	<complexType>
    		<sequence>
    			<element name="ProcessID" type="string"/>
    		</sequence>
    	</complexType>
  </element>
</schema>
