<?xml version="1.0" encoding="UTF-8"?>
<schema
	targetNamespace="http://www.tim.com/NOW/cmf/CessazioneNuovoOrdine"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/cmf/CessazioneNuovoOrdine"
	xmlns:pref="http://www.tim.com/NOW/cmf/NewOrder">

	<element name="cessazione">
		<complexType>
			<sequence>
				<element ref="tns:inputCessazione"></element>
				<element maxOccurs="1" minOccurs="0"
					ref="tns:outputCessazione">
				</element>
				<element ref="tns:faultCessazione"></element>
			</sequence>
		</complexType>
	</element>

	<complexType name="inputCessazioneType">
		<sequence>
			<element name="cessazioneInput">
				<complexType>
					<sequence>
						<element name="causaleOrdine" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="codiceOrdine" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="codiceOrdinePadre"
							type="string" maxOccurs="1" minOccurs="0">
						</element>
						<element name="operatore" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="dataCreazione" type="date" maxOccurs="1" minOccurs="0"></element>
						<element name="oao" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="idContratto" type="int" maxOccurs="1" minOccurs="0"></element>
						<element name="codiceProgetto" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="codiceDelivery" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="codiceQualita" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="notaOperatore" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="offertaCatalogo" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="idContrattoOfferta"
							type="int" maxOccurs="1" minOccurs="0">
						</element>
						<element name="inputDataReferences"
							type="tns:inputDataReferencesType" maxOccurs="unbounded" minOccurs="0">
						</element>
						<element name="inputDataReferencesOnField"
							type="tns:inputDataReferencesOnFieldType" maxOccurs="1" minOccurs="0">
						</element>
						<element
							name="anagraficaIndirizzoDatiClienteFinale" type="tns:anagraficaIndirizzoDatiClienteFinaleType" maxOccurs="1" minOccurs="0">
						</element>
						<element name="anagraficaDatiClienteFinale"
							type="tns:anagraficaDatiClienteFinaleType" maxOccurs="1" minOccurs="0">
						</element>
						<element name="attributiOfferta"
							type="tns:attributiOffertaType" maxOccurs="1" minOccurs="0">
						</element>
						<element name="dac" type="date" maxOccurs="1" minOccurs="0"></element>
						<element name="dad" type="date" maxOccurs="1" minOccurs="0"></element>
						<element name="fasciaOraria" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="idullco" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="numeroVerdeOperatorePT"
							type="string" maxOccurs="1" minOccurs="0">
						</element>
						<element name="numeroVerdeOperatoreCollaudo"
							type="string" maxOccurs="1" minOccurs="0">
						</element>
						<element name="centrale" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="codiceGAT" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="dnOperatoreCollaudo"
							type="string" maxOccurs="1" minOccurs="0">
						</element>
						<element name="idsluco" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="flagMonitoraggio"
							type="string" maxOccurs="1" minOccurs="0">
						</element>
						<element name="dataUltimaModifica"
							type="date" maxOccurs="1" minOccurs="0">
						</element>
						<element name="tipoModifica" type="string" maxOccurs="1" minOccurs="0"></element>
						<element name="idRisorsa" type="string" maxOccurs="1" minOccurs="0"></element>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>

	<complexType name="outputCessazioneType">
		<sequence>
			<element name="cessazioneOutput" maxOccurs="1" minOccurs="0">
				<complexType>
					<sequence>
						<element name="xmlString" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
					</sequence>
				</complexType>
			</element>
			<element name="result" maxOccurs="1" minOccurs="0">
				<complexType>
					<sequence>
						<element name="severity" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="code" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="details" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>

	<complexType name="faultCessazioneType">
		<sequence>
			<element name="message" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="code" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
		</sequence>
	</complexType>
	<element name="inputCessazione" type="tns:inputCessazioneType"></element>
	<element name="outputCessazione" type="tns:outputCessazioneType"></element>
	<element name="faultCessazione" type="tns:faultCessazioneType"></element>

	<complexType name="inputDataReferencesType">
		<sequence>
			<element name="progressivoReferente" type="int" maxOccurs="1" minOccurs="0"></element>
			<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="cognome" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="telefonoFisso" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="cellulare" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="qualifica" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>

	<complexType name="inputDataReferencesOnFieldType">
		<sequence>
			<element name="nomeOnField" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="cognomeOnField" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="telefonoFissoOnField" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="cellulareOnField" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>

	<complexType name="anagraficaIndirizzoDatiClienteFinaleType">
		<sequence>
			<element name="provincia" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="localita" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="comune" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="partToponomastica" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="indirizzo" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="civico" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="cap" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="piano" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="complesso" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="scala" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="interno" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>

	<complexType name="anagraficaDatiClienteFinaleType">
		<sequence>
			<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="cognomeRagioneSociale" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="cf" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="p_iva" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>

	<complexType name="attributiOffertaType">
		<sequence>
			<element name="sezioneSuperiore" type="tns:parametri" maxOccurs="unbounded" minOccurs="0"></element>
			<element name="sezioneInferiore" type="tns:parametri" maxOccurs="unbounded" minOccurs="0"></element>
		</sequence>
	</complexType>

	<complexType name="parametri">
		<sequence>
			<element name="key" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="componente" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="tipologiaDato" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="valore" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="progressivo" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>
</schema>