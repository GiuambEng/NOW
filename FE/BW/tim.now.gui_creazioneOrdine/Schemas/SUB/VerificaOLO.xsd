<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/VerificaOLO" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/VerificaOLO">

    <element name="VerificaOLO">
    	<complexType>
    		<sequence>
    			<element ref="tns:inputVerificaOLO"></element>
    			<element ref="tns:outputVerificaOlo"></element>
    		</sequence>
    	</complexType></element>
    <element name="inputVerificaOLO">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="1" name="tipoProfilo"
    				type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1" name="codiceAgcom"
    				type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1" name="noDiffida"
    				type="string">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="outputVerificaOlo">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="unbounded"
    				name="VerificaOlo">
    				<complexType>
    					<sequence>
    						<element minOccurs="0" maxOccurs="1"
    							name="nome" type="string">
    						</element>
    						<element minOccurs="0" maxOccurs="1"
    							name="operatore" type="string">
    						</element>
    						<element minOccurs="0" maxOccurs="1"
    							name="codiceAgcom" type="string">
    						</element>
    						<element minOccurs="0" maxOccurs="1"
    							name="flagAccorpante" type="string">
    						</element>
    						<element name="codiceAgcomNumerico" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>