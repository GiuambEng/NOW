<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/ConfigurazioneFE" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/ConfigurazioneFE">

    <element name="ConfigurzioneFE">
    	<complexType>
    		<sequence>
    			<element ref="tns:InputConfigurazioneFE"></element>
    			<element ref="tns:OutputConfigurazioneFE"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="InputConfigurazioneFE">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="1" name="codFunzione"
    				type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1" name="offerta"
    				type="string">
    			</element>
    			<element name="opzioneVariazione" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="idAsset" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idOfferta" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="OutputConfigurazioneFE">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="unbounded"
    				name="outputConfigurazioneFE">
    				<complexType>
    					<sequence>
    						<element name="codice" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="descrizione" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="lna_la" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>