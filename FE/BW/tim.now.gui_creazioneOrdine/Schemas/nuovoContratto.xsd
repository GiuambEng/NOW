<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/nuovoContratto" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/nuovoContratto">

    <element name="nuovoContratto">
    	<complexType>
    		<sequence>
    			<element name="nuovoContratto" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codiceContratto"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codificaOloAgcom"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codiceOloNumerico"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="flagAbilitato" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="flagFileNotify" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="flagValido" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="nomeContratto" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInizioValiditaContratto"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataFineValiditaContratto"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idFamigliaOfferta"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idSottofamigliaOfferta"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="operatore" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idOfferta" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element
    							name="dataInizioAssociazioneOffertaContratto" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element
    							name="dataFineAssociazioneOffertaContratto" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipoProfilo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idTipologiaContratto"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="contrattoFwaInfratel"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="contrattoFwaPlus"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="contrattoFwaDecommissioning"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInizioCoinvestimento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataFineCoinvestimento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="flagMulticast" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="datiSospensioneServizio"
    							maxOccurs="1" minOccurs="0">
    							<complexType>
    								<sequence>
    									<element name="flagDisabil"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element
    										name="dataInizioDisabil" type="string" maxOccurs="1"
    										minOccurs="0">
    									</element>
    									<element name="dataFineDisabil"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    								</sequence>
    							</complexType>
    						</element>

    						<element name="emailOffertaFwa1GigaSardegna" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputNuovoContratto">
    	<complexType>
    		<sequence>
    			<element name="nuovoContrattoOutput" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idContratto" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputVerificheContrattiSemi">
    	<complexType>
    		<sequence>
    			<element name="semiVula" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="semiBitstream" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="semiEasyIp" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputVerificheContrattiSemi">
    	<complexType>
    		<sequence>
    			<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputVerificheContrattiFULLGPONPLUS">
    	<complexType>
    		<sequence>
    			<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputVerificheContrattiFULLGPONPLUS">
    	<complexType>
    		<sequence>
    			<element name="fullGponPlus" type="string"></element>
    			<element name="fullGponPlusNga" type="string"></element>
    			<element name="codOloAgcom" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>