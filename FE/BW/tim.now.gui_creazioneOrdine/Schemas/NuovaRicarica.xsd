<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/NuovaRicarica" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/NuovaRicarica">

    <element name="NuovaRicarica">
    	<complexType>
    		<sequence>
    			<element name="idRisorsa" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idAsset" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="tipoLavorazione" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="operatore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="offerta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codificaOao" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="dataInizioRicarica" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="dataFineRicarica" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="taglioRicaricaInGiorni" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codiceOrdineTI" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codiceOrdineOao" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="noteDaOperatore" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="idRicarica" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="tipologiaAccensioneRicarica"
    				type="string" maxOccurs="1" minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputNuovaRicarica">
    	<complexType>
    		<sequence>
    			<element name="processID" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>