<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/CryptoListParams" xmlns:tns="http://www.example.org/CryptoListParams" elementFormDefault="qualified">

    <element name="CryptoListParamsInput"
    	type="tns:CryptoListParamsInput">
    </element>
    
    <complexType name="CryptoListParamsInput">
    	<sequence>
    		<element name="listIdFile" maxOccurs="unbounded"
    			minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="idFile" type="string"
    						maxOccurs="unbounded" minOccurs="0">
    					</element>
    					<element name="idFiltro" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="CryptoListParamsOutput"
    	type="tns:CryptoListParamsOutput">
    </element>
    
    <complexType name="CryptoListParamsOutput">
    	<sequence>
    		<element name="ListIdFileOutput" maxOccurs="unbounded"
    			minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="idFileCriptato" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="idFiltro" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="position" type="int" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
</schema>