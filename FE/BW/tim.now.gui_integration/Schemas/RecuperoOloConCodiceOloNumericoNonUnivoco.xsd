<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/RecuperoOloConCodiceOloNumericoNonUnivoco" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/RecuperoOloConCodiceOloNumericoNonUnivoco">

    <element name="recuperoOlo">
    	<complexType>
    		<sequence>
    			<element name="recuperoOloConCodiceNonUnivoco">
    				<complexType>
    					<sequence>
    						<element ref="tns:recuperoOloInput">
    						</element>
    						<element ref="tns:recuperoOloOutput">
    						</element>
    						<element ref="tns:recuperoOloFault">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			
    		</sequence>
    	</complexType>
    </element>

    <complexType name="recuperoOloInputType">
    	<sequence>
    		<element name="codiceAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="recuperoOloOutputType">
    	<sequence>
    		<element name="codiceAgcomNonUnivoco" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="recuperoOloFaultType">
    	<sequence>
    		<element name="message" type="string" maxOccurs="1" minOccurs="1"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <element name="recuperoOloInput" type="tns:recuperoOloInputType"></element>
    <element name="recuperoOloOutput"
    	type="tns:recuperoOloOutputType">
    </element>
    <element name="recuperoOloFault" type="tns:recuperoOloFaultType"></element>
</schema>