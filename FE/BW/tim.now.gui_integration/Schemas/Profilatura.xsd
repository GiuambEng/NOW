<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/Profilatura" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/Profilatura">




    <element name="profilatura" type="tns:NewType"></element>
    
    <complexType name="NewType">
    	<sequence>
    		<element name="profilatura" type="tns:NewType1"
    			maxOccurs="unbounded" minOccurs="0">
    		</element>
    		<element name="result" type="tns:NewType2" maxOccurs="1"
    			minOccurs="0">
    		</element>
    	</sequence>
    </complexType>

    <complexType name="NewType1">
    	<sequence>
    		<element name="idArea" type="string"></element>
    		<element name="idFunction" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="label" type="string"></element>
    		<element name="enabledProfiles" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>


    <complexType name="NewType2">
    	<sequence>
    		<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>