<?xml version="1.0" encoding="UTF-8"?>
<!-- Prima emissione per servizio verifica Idrisorsa Metroweb-->
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SECOLO/" targetNamespace="http://www.tim.com/NOW/xsd/NOW_SECOLO/" elementFormDefault="qualified">
	<element name="RequestCreate_token">
		<complexType>
			<sequence>
				<element name="CodificaOLOAGCOM" type="string" minOccurs="0"/>
				<element name="CodiceOrdineOLO" type="string" minOccurs="0"/>
				<element name="Funzione" type="string" minOccurs="0"/>
				<element name="ChiaveRiferimento" type="string" minOccurs="0"/>
				<element name="Operatore" type="string" minOccurs="0"/>
				<element name="IPClient" type="string" minOccurs="0"/>
				<element name="N_Recap_Cliente" type="string" minOccurs="0"/>
				<element name="N_Recap_Cliente_ALT" type="string" minOccurs="0"/>
				<element name="Note" type="string" minOccurs="0"/>
				<element name="Nome" type="string" minOccurs="0"/>
				<element name="CognomeRagioneSociale" type="string" minOccurs="0"/>
				<element name="CodiceFiscale" type="string" minOccurs="0"/>
				<element name="PIVA" type="string" minOccurs="0"/>
				<element name="TOKENIZZAZIONE" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<enumeration value="C2PLUS"/>
							<enumeration value="D420"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ResponseCreate_token">
		<complexType>
			<sequence>
				<element name="Token" type="string" minOccurs="0"/>
				<element name="N_Recap_Cliente" type="string" minOccurs="0"/>
				<element name="N_Recap_Cliente_ALT" type="string" minOccurs="0"/>
				<element name="Note" type="string" minOccurs="0"/>
				<element name="Nome" type="string" minOccurs="0"/>
				<element name="CognomeRagioneSociale" type="string" minOccurs="0"/>
				<element name="CodiceFiscale" type="string" minOccurs="0"/>
				<element name="PIVA" type="string" minOccurs="0"/>
				<element name="ESITO">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="RequestDecode_token">
		<complexType>
			<sequence>
				<element name="CodificaOLOAGCOM" type="string" minOccurs="0"/>
				<element name="CodiceOrdineOLO" type="string" minOccurs="0"/>
				<element name="Funzione" type="string" minOccurs="0"/>
				<element name="ChiaveRiferimento" type="string" minOccurs="0"/>
				<element name="Operatore" type="string" minOccurs="0"/>
				<element name="IPClient" type="string" minOccurs="0"/>
				<element name="Token" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="ResponseDecode_token">
		<complexType>
			<sequence>
				<element name="ESITO">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE" type="string" minOccurs="0"/>
				<element name="N_Recap_Cliente" type="string" minOccurs="0"/>
				<element name="N_Recap_Cliente_ALT" type="string" minOccurs="0"/>
				<element name="Note" type="string" minOccurs="0"/>
				<element name="Nome" type="string" minOccurs="0"/>
				<element name="CognomeRagioneSociale" type="string" minOccurs="0"/>
				<element name="CodiceFiscale" type="string" minOccurs="0"/>
				<element name="PIVA" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="RETURN_CODE" type="string" minOccurs="0"/>
				<element name="DESCRIZIONE" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>
