<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/Offerta" targetNamespace="http://www.tim.com/NOW/rest/Offerta" elementFormDefault="qualified">
	<element name="Offerta">
		<complexType>
			<sequence>
				<element ref="tns:offertaOutput" minOccurs="0"/>
				<element name="result" type="tns:result" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="offertaOutput">
		<sequence>
			<element name="offerta" type="string" minOccurs="0"/>
			<element name="sezioneSuperiore" type="tns:parametri" minOccurs="0" maxOccurs="unbounded"/>
			<element name="sezioneInferiore" type="tns:parametri" minOccurs="0" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="parametri">
		<sequence>
			<element name="label" type="string" minOccurs="0" />
			<element name="key" type="string" minOccurs="0" />
			<element name="componente" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="tipologiaDato" type="string" minOccurs="0" />
			<element name="domain" type="string" minOccurs="0" />
			<element name="default" type="string" minOccurs="0" />
			<element name="mandatory" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="progressivo" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>
	<element name="offertaOutput" type="tns:offertaOutput"/>
	<complexType name="result">
		<sequence>
			<element name="severity" type="string" minOccurs="0"/>
			<element name="code" type="string" minOccurs="0"/>
			<element name="details" type="string" minOccurs="0"/>
		</sequence>
	</complexType>
</schema>
