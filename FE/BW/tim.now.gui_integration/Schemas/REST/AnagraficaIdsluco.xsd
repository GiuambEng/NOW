<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/AnagraficaIdsluco" xmlns:tns="http://www.example.org/AnagraficaIdsluco" elementFormDefault="qualified">

    <element name="Input_AnagraficaIdsluco_RicercaAvanzata"
    	type="tns:Input_AnagraficaIdsluco_RicercaAvanzata">
    </element>
    
    <complexType name="Input_AnagraficaIdsluco_RicercaAvanzata">
    	<sequence>
    		<element name="numerorighe" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="indiceriga" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="exportRequest" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="strutturaCondition" maxOccurs="unbounded"
    			minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="operazione" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="valore" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="tipo" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Output_AnagraficaIdsluco"
    	type="tns:Output_AnagraficaIdsluco">
    </element>
    
    <complexType name="Output_AnagraficaIdsluco">
    	<sequence>
    		<element name="listaIdsluco" maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="IDSLUCO" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="CLLI" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="Da" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="A" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="CodificaOAO" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
</schema>