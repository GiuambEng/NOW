<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/AnagraficaDisaggregazione" xmlns:tns="http://www.example.org/AnagraficaDisaggregazione" elementFormDefault="qualified">

    <element name="Input_AnagraficaDisaggregazione_RicercaAvanzata"
    	type="tns:Input_AnagraficaDisaggregazione_RicercaAvanzata">
    </element>
    
    <complexType
    	name="Input_AnagraficaDisaggregazione_RicercaAvanzata">
    	<sequence>
    		<element name="numerorighe" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="indiceriga" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="exportRequest" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="strutturaCondition" maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="operazione" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="valore" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="tipo" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Output_AnagraficaDisaggregazione"
    	type="tns:Output_AnagraficaDisaggregazione">
    </element>
    
    <complexType name="Output_AnagraficaDisaggregazione">
    	<sequence>
    		<element name="listaDisaggregazione" maxOccurs="unbounded"
    			minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="olo" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="codiceImpresa" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="ragioneSociale" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="areaDiCantiere" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="dataInizioValiditaProvisioning"
    						type="string" maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="dataFineValiditaProvisioning"
    						type="string" maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="disaggregazioneAppuntamento" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="code" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
</schema>