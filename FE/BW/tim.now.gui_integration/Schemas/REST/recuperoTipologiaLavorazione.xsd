<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/recuperoTipologiaLavorazione" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/recuperoTipologiaLavorazione">

    <element name="OutputRecuperoTipologiaLavorazione">
    	<complexType>
    		<sequence>
    			<element name="outputRecuperoTipologiaLavorazione"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="flagComunicazione" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="flagOrdini" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idTipologiaLavorazione" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="tipologiaLavorazione" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="tipologiaLavorazioneGUI" type="string" maxOccurs="1" minOccurs="0">
    						</element>
                            <element name="tipologiaLavorazioneDTU" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>