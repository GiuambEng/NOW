<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/AnagraficaGpon" xmlns:tns="http://www.example.org/AnagraficaGpon" elementFormDefault="qualified">

    <element name="AnagraficaGponOutput">
    	<complexType>
    		<sequence>
    			<element name="listaAnagraficaGpon"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="idGpon" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="puntoInterconnessione"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codificaOloAgcom"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codiceAreaCentrale"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataFineValidita"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipoAccesso" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="coinvestimento" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="timestampInserimento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="timestampAggiornamento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idFileProcstoInput"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="numeroRecord" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="fattoreDiSplitting" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="dataRegistrazioneFattoreSplitting" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idGponValido" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="StoricoSplittingGponOutput">
    	<complexType>
    		<sequence>
    			<element name="listaStoricoGpon" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="fattoreDiSplittingAttuale" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="fattoreDiSplittingOld" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="dataRegistrazioneFattoreSplitting" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="dataFineRegistrazioneFattoreSplitting" type="string" maxOccurs="1" minOccurs="0"></element>
                        </sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>