<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RecuperaSystemUnico" xmlns:tns="http://www.example.org/RecuperaSystemUnico" elementFormDefault="qualified">

    <element name="inputRecuperaSysUnicoCodServizio">
    	<complexType>
    		<sequence>
    			<element name="codificaOloAgcom" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="idullco" type="string" maxOccurs="1"
    				minOccurs="0" nillable="true">
    			</element>
    			<element name="idsluco" type="string" maxOccurs="1"
    				minOccurs="0" nillable="true">
    			</element>
    			<element name="idOfferta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="datiClienteFinale" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="provincia" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="comune" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="partToponomastica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="indirizzo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="civico" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="flagCodiceServizio" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="RU1560" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputRecuperaSysUnicoCodServizio">
    	<complexType>
    		<sequence>
    			<element name="systemUnico" maxOccurs="unbounded"
    				minOccurs="0" type="string">
    			</element>
    			<element name="codiceServizio" type="string" maxOccurs="unbounded" minOccurs="0"></element>
                <element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
            </sequence>
    	</complexType>
    </element>
</schema>