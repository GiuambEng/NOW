<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/AnagraficaRadius" xmlns:tns="http://www.example.org/AnagraficaRadius" elementFormDefault="qualified">

    <element name="outputAnagraficaRadius">
    	<complexType>
    		<sequence>
    			<element name="listaAnagraficaRadius" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codiceISP" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ordineOneStep" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="lavorazione" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tecnologia" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="gestioneRadius" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="fornitoreRadius"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ownership" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="sopensioneOrdine"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dnsParentalControl" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="realm" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="piattaformaO2O" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="cluster" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="descrizioneCluster"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"></element>
    						<element name="code" type="string"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="idExportFile" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>