<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/servizioricercaavanzata" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/servizioricercaavanzata">
	<element name="servizioricercaavanzata" type="tns:servizioricercaavanzata"/>
	<complexType name="servizioricercaavanzata">
		<sequence>
			<element minOccurs="0" ref="tns:inputservizioricercaavanzata"/>
			<element minOccurs="0" ref="tns:outputservizioricercaavanzata"/>
		</sequence>
	</complexType>
	<complexType name="requestservizioricercaavanzata">
		<sequence>
			<element maxOccurs="unbounded" minOccurs="0" name="strutturaCondition" type="tns:requestricercaavanzata"/>
			<element minOccurs="0" name="indiceriga" type="string"/>
			<element minOccurs="0" name="numerorighe" type="string"/>
            <element minOccurs="0" name="exportRequest" type="string"/>
        </sequence>
	</complexType>
	<complexType name="outputcondition">
		<sequence>
			<element maxOccurs="unbounded" minOccurs="0" name="outputcondition" type="string"/>
		</sequence>
	</complexType>
	<complexType name="requestricercaavanzata">
		<sequence>
			<element minOccurs="0" name="nome" type="string"/>
			<element minOccurs="0" name="operazione" type="string"/>
			<element minOccurs="0" name="valore" type="string"/>
			<element maxOccurs="1" minOccurs="0" name="tipo" type="string"/>
		</sequence>
	</complexType>
	<element name="inputservizioricercaavanzata" type="tns:requestservizioricercaavanzata"/>
	<element name="outputservizioricercaavanzata" type="tns:outputcondition"/>
</schema>
