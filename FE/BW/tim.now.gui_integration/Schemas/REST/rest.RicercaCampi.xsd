<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/RicercaCampi" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/RicercaCampi">

    <element name="inputRicercaCampi">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="tipoLista"
    				type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="tipoProfilo"
    				type="string" />
    			<element name="flagHashing" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
  </element>

    <element name="outputRicercaCampi">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="outputRicercaCampi">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="nomeDB" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="tipoDato" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="label" type="string">
    						</element>
                            <element minOccurs="0" name="default" type="string"/>
                        </sequence>
    				</complexType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="result">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="details" type="string"/>
    					</sequence>
    				</complexType>
        </element>
    		</sequence>
    	</complexType>
  </element>
</schema>
