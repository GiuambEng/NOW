<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/fileDiNotifiche" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/fileDiNotifiche">
    <element name="fileDiNotifiche">
    	<complexType>
    		<sequence>
    			<element name="fileDiNotifiche">
    				<complexType>
    					<sequence>
    						<element ref="tns:fileDiNotificheInput">
    						</element>
    						<element maxOccurs="unbounded" minOccurs="0" ref="tns:fileDiNotificheOutput">
    						</element>
    						<element ref="tns:fileDiNotificheFault">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="fileDiNotificheInputType">
    	<sequence>
    		<element maxOccurs="unbounded" minOccurs="0" name="inputFileDiNotifiche">
    			<complexType>
    				<sequence>
    					<element maxOccurs="1" minOccurs="0" name="codOloAgcom" type="string"/>
    				</sequence>
    			</complexType>
      </element>
    	</sequence>
    </complexType>
    
    <complexType name="fileDiNotificheOutputType">
    	<sequence>
    		<element maxOccurs="unbounded" minOccurs="0" name="listaFileNotifiche">
    			<complexType>
    				<sequence>
    					<element maxOccurs="1" minOccurs="0" name="tipoNotifica" type="string">
    					</element>
    					<element maxOccurs="1" minOccurs="0" name="nomeFile" type="string">
    					</element>
    					<element maxOccurs="1" minOccurs="0" name="codOloAgcom" type="string">
    					</element>
    					<element maxOccurs="1" minOccurs="0" name="dimensioneFile" type="string">
    					</element>
    					<element maxOccurs="1" minOccurs="0" name="esitoInvio" type="string">
    					</element>
    					<element maxOccurs="1" minOccurs="0" name="quantitaRecordTotali" type="string">
    					</element>
    					<element maxOccurs="1" minOccurs="0" name="timestampCreazioneFile" type="string">
    					</element>
    					<element maxOccurs="1" minOccurs="0" name="timestampInvio" type="string"/>
    					<element maxOccurs="1" minOccurs="0" name="idFile" type="string">
    					</element>

    					<element maxOccurs="1" minOccurs="0" name="filtroIdFile" type="string">
    					</element>
    					<element maxOccurs="1" minOccurs="0" name="posizione" type="int"/>
    				</sequence>
    			</complexType>
    		</element>
            <element maxOccurs="1" minOccurs="0" name="idExportFile" type="string"/>
            <element maxOccurs="1" minOccurs="0" name="result">
    			<complexType>
    				<sequence>
    					<element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
    					<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
    					<element maxOccurs="1" minOccurs="0" name="details" type="string"/>
    				</sequence>
    			</complexType>
    		</element>

    	</sequence>
    </complexType>
    
    <complexType name="fileDiNotificheFaultType">
    	<sequence>
    		<element maxOccurs="1" minOccurs="1" name="message" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
    	</sequence>
    </complexType>
    <element name="fileDiNotificheInput" type="tns:fileDiNotificheInputType">
    </element>
    <element name="fileDiNotificheOutput" type="tns:fileDiNotificheOutputType">
    </element>
    <element name="fileDiNotificheFault" type="tns:fileDiNotificheFaultType">
    </element>

    <element name="Salvaricerca_Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="strutturaCondition">
    				<complexType>
    					<sequence>
    						<element minOccurs="0" name="nome" type="string"/>
    						<element minOccurs="0" name="operazione" type="string"/>
    						<element minOccurs="0" name="valore" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="tipo" type="string">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="indiceriga" type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="numerorighe" type="string">
    		</element>

    		<element maxOccurs="1" minOccurs="0" name="exportRequest" type="string"/>
    		</sequence>
    	</complexType>
  </element>

    <element name="mapperOutput" type="tns:mapperOutput"/>
    
    <complexType name="mapperOutput">
    	<sequence>
    		<element maxOccurs="unbounded" minOccurs="0" name="mapperListOutput">
    			<complexType>
    				<sequence>
    					<element maxOccurs="1" minOccurs="0" name="idFile" type="string"/>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="assignIdFile" type="tns:assignIdFile"/>
    
    <complexType name="assignIdFile">
    	<sequence>
    		<element maxOccurs="unbounded" minOccurs="0" name="root">
    			<complexType>
    				<sequence>
    					<element maxOccurs="1" minOccurs="0" name="idFile" type="string">
    					</element>
    					<element maxOccurs="1" minOccurs="0" name="idFiltro" type="string"/>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
</schema>
