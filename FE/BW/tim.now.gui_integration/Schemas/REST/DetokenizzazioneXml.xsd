<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/DetokenizzazioneXml" xmlns:tns="http://www.example.org/DetokenizzazioneXml" elementFormDefault="qualified">

    <element name="inputDetokenizzazioneXml">
    	<complexType>
    		<sequence>
    			<element name="codOloAgcom" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idOfferta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codOrdineOlo" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="operatore" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="IPClient" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
                <element name="lavorazione" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="tokenReferenti" maxOccurs="unbounded"
    				minOccurs="0" type="tns:tokenReferenti">
    			</element>
    			<element name="tracciatoXml" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputDetokenizzazioneXml">
    	<complexType>
    		<sequence>
    			<element name="tracciatoDetokenizzato" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="tokenReferenti">
    	<sequence>
    		<element name="tokenFisso" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="tokenMobile" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="id" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="cognome" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="codFiscale" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="pIva" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="referenti" type="tns:tokenReferenti"></element>

    <element name="inputDetokenizzaXml">
    	<complexType>
    		<sequence>
    			<element name="flagDetok" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="flagTokFittizia" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="pattern" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codOloAgcom" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codOrdineOlo" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idOfferta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="lavorazione" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codOrdineTi" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
                <element name="idRichiestaOlo" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="operatore" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="IPClient" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="tracciatoXml" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="listaReferente">
    	<complexType>
    		<sequence>
    			<element name="datiSensibili" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="progressivo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="qualifica" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="nome" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="cognome" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="telefono" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="mobile" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="email" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="clienteFinale">
    	<complexType>
    		<sequence>
    			<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="cognome" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="CF" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="PIVA" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="referente">
    	<complexType>
    		<sequence>
    			<element name="progressivo" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="qualifica" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="nome" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="cognome" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="telefono" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="mobile" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="email" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="progressivi">
    	<complexType>
    		<sequence>
    			<element name="progressivo" type="int" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputExtractRefReq">
    	<complexType>
    		<sequence>
    			<element name="offerta" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="tracciatoXml" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="inputDetokenizzaNP">
    	<complexType>
    		<sequence>
    			<element name="tracciatoXml" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="nome" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="cognome" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="telefono" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="lavorazione" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>