<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/calendarioFestivita/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/calendarioFestivita/">

    <element name="calendarioFestivitaIn">
    	<complexType>
    		<sequence>
    			<element name="dataFestivita" type="date"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="flagCiclico" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="note" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="operatore" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="dataInserimento" type="dateTime" minOccurs="0" maxOccurs="1"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="calendarioFestivitaOut">
    	<complexType>
    		<sequence>
    			<element name="calendarioFestivitaOut"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="dataFestivita" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="flagCiclico" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInserimento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="note" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="operatore" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="calendarioFestivitaFault">
    	<complexType>
    		<sequence>
    			<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>