<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RichiestaPreventivo" xmlns:tns="http://www.example.org/RichiestaPreventivo" elementFormDefault="qualified">


    <element name="richiestaPreventivoOut">
    	<complexType>
    		<sequence>
    			<element name="esito" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codice" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType>
</element>
</schema>