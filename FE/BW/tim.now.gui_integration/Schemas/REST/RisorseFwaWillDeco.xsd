<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RisorseFwaWillDeco" xmlns:tns="http://www.example.org/RisorseFwaWillDeco" elementFormDefault="qualified">

    <element name="VisualizzaListaRisorseFwaOutput">
    	<complexType>
    		<sequence>
    			<element name="listaRisorseFwa" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="idRisorsaSwitchOff" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="dataScadenzaSwitchOff" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="statoMigrato" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="EsitoEditing">
    	<complexType>
    		<sequence>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			
    		</sequence>
    	</complexType>
    </element>
    
    <element name="ModificaRisorsaFwaInput">
    	<complexType>
    		<sequence>
    			<element name="idRisorsaSwitchOff" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="dataScadenzaSwitchOff" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="operatore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="NuovaRisorsaFwaInput">
    	<complexType>
    		<sequence>
    			<element name="idRisorsaSwitchOff" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="dataScadenzaSwitchOff" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="operatore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="DettaglioRisorsaOutput">
    	<complexType>
    		<sequence>
    			<element name="dettaglioRisorsa" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
                            <element name="idRisorsaSwitchOff" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="dataScadenzaSwitchOff" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="statoMigrato" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="dataInserimento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataUltimaModifica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="operatoreInserimento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="operatoreUltimaModifica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>