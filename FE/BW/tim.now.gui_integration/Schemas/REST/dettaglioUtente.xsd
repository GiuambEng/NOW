<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/dettaglioUtente" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/dettaglioUtente">

    <element name="utente" type="tns:utenteType"></element>
    
    <complexType name="utenteType">
    	<sequence>
    		<element ref="tns:inputDettaglioUtente"></element>
    		<element ref="tns:outputDettaglioUtente" maxOccurs="1" minOccurs="0"></element>
    		<element ref="tns:faultDettaglioUtente"></element>
    	</sequence>
    </complexType>
    <element name="inputDettaglioUtente" type="tns:inputUtente"></element>
    <element name="outputDettaglioUtente" type="tns:outputUtente"></element>
    <element name="faultDettaglioUtente" type="tns:faultUtente"></element>

    <complexType name="inputUtente">
    	<sequence>
    		<element name="inputUtente" type="tns:inputUtenteType" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="outputUtente">
    	<sequence>
    		<element name="outputUtente" type="tns:outputUtenteType"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="result" type="tns:resultType" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		
    	</sequence>
    </complexType>

    <complexType name="outputUtenteType">
    	<sequence>
    		<element name="codiceProfilo" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="userId" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="userAlias" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="matricola" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="idTipologiaUtente" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="nome" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="cognome" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="dataFineValidita" type="date" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="dataInizioValidita" type="date" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagDisabilitato" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="indirizzoEmail" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="codificaOloAgcom" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagAccorpante" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagAccorpato" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="resultType">
    	<sequence>
    		<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <complexType name="inputUtenteType">
    	<sequence>
    		<element name="userId" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <complexType name="faultUtente">
    	<sequence>
    		<element name="message" type="string" maxOccurs="1" minOccurs="1"></element>
    		<element name="fault" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>