<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VisualizzaFileIncentivi"
	xmlns:tns="http://www.example.org/VisualizzaFileIncentivi"
	elementFormDefault="qualified">

	<element name="VisualizzaFileIncentiviInput">
		<complexType>
			<sequence>
				<element name="numerorighe" type="string" maxOccurs="1"
					minOccurs="0"></element>
				<element name="indiceriga" type="string" maxOccurs="1"
					minOccurs="0"></element>
				<element name="strutturaCondition" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="nome" type="string" maxOccurs="1"
								minOccurs="0"></element>
							<element name="operazione" type="string" maxOccurs="1"
								minOccurs="0"></element>
							<element name="valore" type="string" maxOccurs="1"
								minOccurs="0"></element>
							<element name="tipo" type="string" maxOccurs="1"
								minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>

			</sequence>
		</complexType>
	</element>

	<element name="VisualizzaFileIncentiviOutput">
		<complexType>
			<sequence>
				<element name="listaFileIncentivi" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="idFile" type="string" maxOccurs="1"
								minOccurs="0">
							</element>
							<element name="nomeFile" type="string" maxOccurs="1"
								minOccurs="0">
							</element>
							<element name="codificaOao" type="string" maxOccurs="1"
								minOccurs="0">
							</element>
							<element name="dataCreazioneFile" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="position" type="int" maxOccurs="1"
								minOccurs="0" />
							<element name="tipologiaFile" type="string" maxOccurs="1"
								minOccurs="0" />
						</sequence>
					</complexType>
				</element>
				<element name="result" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<element name="severity" type="string" maxOccurs="1"
								minOccurs="0"></element>
							<element name="code" type="string" maxOccurs="1"
								minOccurs="0"></element>
							<element name="details" type="string" maxOccurs="1"
								minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

	<element name="DettaglioFileIncentiviOutput">
		<complexType>
			<sequence>
                <element name="dettaglioFileIncentivi" maxOccurs="unbounded" minOccurs="0">
					<complexType>
						<sequence>
                            <element name="idRisorsa" type="string" maxOccurs="1" minOccurs="0" />
                            <element name="clli" type="string" maxOccurs="1" minOccurs="0" />
                            <element name="offerta" type="string" maxOccurs="1" minOccurs="0" />
                            <element name="dataIn" type="string" maxOccurs="1" minOccurs="0" />
                            <element name="dataOut" type="string" maxOccurs="1" minOccurs="0" />
                            <element name="descrizioneErrore" type="string" maxOccurs="1" minOccurs="0" />
						</sequence>
					</complexType>
				</element>
                <element name="result" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<element name="severity" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="code" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="details" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

    <element name="RecordFileIncentivi">
    	<complexType>
						<sequence>
							<element name="idFile" type="string" maxOccurs="1"
								minOccurs="0">
							</element>
							<element name="nomeFile" type="string" maxOccurs="1"
								minOccurs="0">
							</element>
							<element name="codificaOao" type="string" maxOccurs="1"
								minOccurs="0">
							</element>
							<element name="dataCreazioneFile" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="position" type="int" maxOccurs="1"
								minOccurs="0" />
							<element name="tipologiaFile" type="string" maxOccurs="1"
								minOccurs="0" />
						</sequence>
					</complexType>
    </element>
</schema>