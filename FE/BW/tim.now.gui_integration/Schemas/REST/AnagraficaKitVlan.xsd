<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/AnagraficaKitVlan" xmlns:tns="http://www.example.org/AnagraficaKitVlan" elementFormDefault="qualified">

    <element name="AnagraficaKitVlanInput">
    	<complexType>
    		<sequence>
    			<element name="numerorighe" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="indiceriga" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="strutturaCondition" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="operazione" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="valore" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="tipo" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="AnagraficaKitVlanOutput">
    	<complexType>
    		<sequence>
    			<element name="listaAnagraficaKitVlan"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="abilitatoNga" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="clli" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codiceKit" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codiceOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codificaOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="dec" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="decAttivazione" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="famigliaKit" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idPrimeContractor" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="modelloKit" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="stato"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>