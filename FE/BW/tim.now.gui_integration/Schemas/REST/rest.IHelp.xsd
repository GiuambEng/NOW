<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/IHelp"
	xmlns:tns="http://www.tim.com/NOW/rest/IHelp" elementFormDefault="qualified">

	<element name="IHelpInput">
		<complexType>
			<sequence>
				<element name="Data_inserimento" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="Data_aggiornamento" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="Visibile" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Operatore" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Note" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Titolo" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Contenuto" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Id_IHelp" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="OPERATORE_ULTIMO_AGGTO" type="string" maxOccurs="1" minOccurs="0"></element>
			    <element name="Id_Ambito" type="string" maxOccurs="1" 	minOccurs="1"></element>
			    <element name="Desc_Ambito" type="string" maxOccurs="1" 	minOccurs="0"></element>
			    
			</sequence>
		</complexType>
	</element>

	<element name="IHelpOutput" type="tns:IHelpOutput"></element>

	<element name="IHelpFault">
		<complexType></complexType>
	</element>

	<complexType name="IHelpOutput">
		<sequence>
			<element name="IHelpOutput" maxOccurs="unbounded" minOccurs="0">
				<complexType>
					<sequence>
						<element name="Data_inserimento" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="Data_aggiornamento" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="Visibile" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="Operatore" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="Note" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="Titolo" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="Contenuto" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="Id_IHelp" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="OPERATORE_ULTIMO_AGGTO" type="string" maxOccurs="1" minOccurs="0"></element>
					    <element name="Id_Ambito" type="string" maxOccurs="1" 	minOccurs="1"></element>
					     <element name="Desc_Ambito" type="string" maxOccurs="1" 	minOccurs="0"></element>
					</sequence>
				</complexType>
			</element>
			<element name="result">
				<complexType>
					<sequence>
						<element name="severity" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
						<element name="code" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
						<element name="details" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
</schema>