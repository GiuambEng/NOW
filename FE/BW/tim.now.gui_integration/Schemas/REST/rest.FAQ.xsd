<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/rest.FAQ"
	xmlns:tns="http://www.tim.com/NOW/rest/rest.FAQ" elementFormDefault="qualified">
	<element name="FAQ_Input">
		<complexType>
			<sequence>

				<element name="Domanda" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Risposta" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Note" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Operatore" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Visibile" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Data_aggiornamento" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="Data_inserimento" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="ID_FAQ" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="OPERATORE_ULTIMO_AGGTO" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>


	<element name="FAQ_Fault">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
		</complexType>
	</element>




	<element name="FAQ_Output" type="tns:FAQ_Output"></element>
	
    <complexType name="FAQ_Output">
    	<sequence>
    		<element name="FAQ_Output" maxOccurs="unbounded" minOccurs="0">
					<complexType>
						<sequence>
							<element name="Domanda" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="Risposta" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="Note" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="Operatore" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="Visibile" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="Data_aggiornamento"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="Data_inserimento"
								type="string" maxOccurs="1" minOccurs="0">
							</element>

							<element name="ID_FAQ" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="OPERATORE_ULTIMO_AGGTO" type="string" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
    		<element name="result">
					<complexType>
						<sequence>
							<element name="severity" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
							<element name="code" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
							<element name="details" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
						</sequence>
					</complexType>
				</element>
    	</sequence>

    </complexType>
</schema>