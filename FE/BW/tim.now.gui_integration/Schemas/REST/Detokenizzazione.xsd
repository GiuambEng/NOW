<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Detokenizzazione" xmlns:tns="http://www.example.org/Detokenizzazione" elementFormDefault="qualified">

    <element name="inputTokenizzazione">
    	<complexType>
    		<sequence>
    			<element name="codOloAgcom" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codOrdineOlo" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="operatore" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="IPClient" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="tokenReferenti" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="tokenFisso" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tokenMobile" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tokenCF" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="id" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="referenteContattato" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="flagAsset" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputTokenizzazione">
    	<complexType>
    		<sequence>
    			<element name="referentiDetokenizzati" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="numeriReferenti"
    							maxOccurs="unbounded" minOccurs="0">
    							<complexType>
    								<sequence>
    									<element name="numeroFisso"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="numeroMobile"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="id" type="string"
    										maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="nome"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="cognome"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="codFiscale"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    									<element name="pIva"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    								</sequence>
    							</complexType>
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="numeriReferente">
    	<sequence>
    		<element name="numeroFissoReferente" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="numeroMobileReferente" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="id" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="cognome" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="codFiscale" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="pIva" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="numeriDetokenizzati" type="tns:numeriReferente">
    </element>
</schema>