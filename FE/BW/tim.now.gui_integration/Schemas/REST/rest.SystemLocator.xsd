<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:tns1="http://www.tim.com/NOW/rest/SystemLocator" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/SystemLocator">

    <import namespace="http://www.tim.com/NOW/xsd/CommonSchema/" schemaLocation="../CommonSchema.xsd"/>
    <element name="RichiestaLocalizzatore">
    	<complexType>
    		<sequence>
   			<element name="Testata" type="tns1:testataType"/>
    			<element name="Richiesta" type="tns1:richiestaType"/>
    		</sequence>
    	</complexType>
    </element>
    

    <complexType name="testataType">
    	<sequence>
    		<element name="Transaction_id">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"/>
    				</restriction>
    			</simpleType>
    		</element>

    		<element name="Transaction_date" type="dateTime"/>
    		<element name="Sistema_origine">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="NOW"/>
    					<enumeration value="PORTALE"/>
    					<enumeration value="NOWDISAMB"/>
    					<enumeration value="NOWUPLOAD"/>
    				</restriction>
    			</simpleType>
    		</element>
    		
    	</sequence>
    </complexType>

    <complexType name="richiestaType">
    	<sequence>
    		<element name="DataRichiesta" type="dateTime"/>
    		<element maxOccurs="1" minOccurs="0" name="CodiceOLO" type="tns:CodificaOLOAGCOM">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="CodiceISP" type="tns:CodiceOLO">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="CodiceComune">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="10"/>
    				</restriction>
    			</simpleType>
    		</element>

    		<element maxOccurs="1" minOccurs="0" name="Servizio">
    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"/>
    				</restriction>
    			</simpleType>
    		</element>

    		<element maxOccurs="1" minOccurs="0" name="FlagNaked">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="S"/>
    					<enumeration value="N"/>
    					<enumeration value=""/>
    				</restriction>
    			</simpleType>
    		</element>

    		<element maxOccurs="1" minOccurs="0" name="Richiesta" type="tns:Lavorazione">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="Ambito_XDSL">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="S"/>
    					<enumeration value="N"/>
    					<enumeration value=""/>
    				</restriction>
    			</simpleType>
    		</element>
    		
    		<element maxOccurs="1" minOccurs="0" name="CodiceOrdineRiferimentoTI">

    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"/>
    				</restriction>
    			</simpleType>
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="CodiceOrdineRiferimentoOLO">

    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"/>
    				</restriction>
    			</simpleType>
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="IdRisorsa">

    			<simpleType>
    				<restriction base="string">
    					<maxLength value="50"/>
    				</restriction>
    			</simpleType>
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="IdCorrelazione">

    			<simpleType>
    				<restriction base="string">
    					<maxLength value="10"/>
    				</restriction>
    			</simpleType>
    		</element>
    	</sequence>
    </complexType>

    <element name="RispostaLocalizzatore">
    	<complexType>
    		<sequence>
    			<element name="Testata" type="tns1:testataType"/>
    			<element name="Risposta" type="tns1:rispostaType"/>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="rispostaType">
    	<sequence>
    		<element name="DataRisposta" type="dateTime"/>
    		<element name="SistemaDiCompetenza">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="NOW"/>
    					<enumeration value="CRMWS"/>
    					<enumeration value="KO"/>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="RC">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="00"/>
    					<enumeration value="01"/>
    					<enumeration value="02"/>
    					<enumeration value="03"/>
    					<enumeration value="04"/>
    					<enumeration value="05"/>
    					<enumeration value="06"/>
    					<enumeration value="07"/>
    					<enumeration value="08"/>
    					<enumeration value="09"/>
    					<enumeration value="10"/>
    					<enumeration value="11"/>
    					<enumeration value="12"/>
    					<enumeration value="13"/>
    					<enumeration value="14"/>
    					<enumeration value="99"/>
    				</restriction>
    			</simpleType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Fault">
    	<complexType>
    		<sequence>
    			<element name="Code" type="string"/>
    			<element name="Description" type="string"/>
    		</sequence>
    	</complexType>
  </element>
</schema>
