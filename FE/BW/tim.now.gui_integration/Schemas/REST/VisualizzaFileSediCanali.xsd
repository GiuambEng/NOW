<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VisualizzaFileSediCanali" xmlns:tns="http://www.example.org/VisualizzaFileSediCanali" elementFormDefault="qualified">


    <element name="VisualizzaFileSediCanaliOutput">
    	<complexType>
    		<sequence>
    			<element name="outputVisualizzaFileSediCanali"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="nomeFile" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipologiaTracciato"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInserimentoFile"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataUltimoAggiornamento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="numeroOrdini" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="statoElaborazioneFile"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idFile" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idInterfaccia" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="position" type="int" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="DatiCalcolabili">
    	<complexType>
    		<sequence>
    			<element name="dati" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
                            <element name="dataUltimoAggiornamento" type="string" maxOccurs="1" minOccurs="0"></element>
                            <element name="numOrdini" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idFile" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			
    		</sequence>
    	</complexType>
    </element>
</schema>