<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/Salvaricerca"
	xmlns:tns="http://www.tim.com/NOW/rest/Salvaricerca"
	elementFormDefault="qualified">

	<element name="Salvaricerca_Input">
		<complexType>
			<sequence>
				<element name="strutturaCondition" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="nome" type="string" minOccurs="0" />
							<element name="operazione" type="string" minOccurs="0" />
							<element name="valore" type="string" minOccurs="0" />
							<element name="tipo" type="string" minOccurs="0"
								maxOccurs="1">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="DESCR" type="string" maxOccurs="1" minOccurs="0">
				</element>
				<element name="NOME_FILTRO" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="TIMSTP_INSMTO" type="string" maxOccurs="1"
					minOccurs="0">
				</element>

			</sequence>
		</complexType>
	</element>

	<element name="Salvaricerca_Output" type="tns:Salvaricerca_Output">
	</element>

	<element name="Salvaricerca_Fault">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>

		</complexType>
	</element>

	<complexType name="Salvaricerca_Output">
		<sequence>
			<element name="Salvaricerca_Output" maxOccurs="unbounded"
				minOccurs="0">
				<complexType>
					<sequence>
						<element name="strutturaCondition" maxOccurs="unbounded"
							minOccurs="0">
							<complexType>
								<sequence>
									<element name="nome" type="string" minOccurs="0" />
									<element name="operazione" type="string" minOccurs="0" />
									<element name="valore" type="string" minOccurs="0" />
									<element name="tipo" type="string" minOccurs="0"
										maxOccurs="1">
									</element>
								</sequence>
							</complexType>
						</element>
						<element name="DESCR" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="NOME_FILTRO" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="TIMSTP_INSMTO" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="USERID" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="COD_FUNZIONE" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
					</sequence>


				</complexType>
			</element>
			<element name="result">
				<complexType>
					<sequence>
						<element name="severity" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
						<element name="code" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
						<element name="details" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
					</sequence>

				</complexType>
			</element>
		</sequence>
	</complexType>

    <element name="Salvaricerca_Post_Output"
    	type="tns:Salvaricerca_Post_Output">
    </element>
    
    <complexType name="Salvaricerca_Post_Output">


    	<sequence>
    	
    		<element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="code" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="details" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    				
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

</schema>