<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/AnagraficaMarcaggioComuni" xmlns:tns="http://www.example.org/AnagraficaMarcaggioComuni" elementFormDefault="qualified">

    <element name="AnagraficaMarcaggioComuniInput">
    	<complexType>
    		<sequence>
    			<element name="numerorighe" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="indiceriga" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="exportRequest" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
                <element name="fileType" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="strutturaCondition" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="nome" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="operazione" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="valore" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="AnagraficaMarcaggioComuniOutput">
    	<complexType>
    		<sequence>
    			<element name="listaAnagraficaMarcaggioComuni"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codiceIstatComune"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipologiaClusterComune"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="descrizioneComune"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="offerta" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInizioLiberalizzazione"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element
    							name="dataFineMarcaggioNuoviAccessi" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInizioMarcaggio"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codicePricing" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInizioValiditaPricing"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataFineValiditaPricing"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="versioning" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="idExportFile" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>