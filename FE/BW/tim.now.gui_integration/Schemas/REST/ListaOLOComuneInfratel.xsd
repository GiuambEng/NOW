<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ListaOLOComuneInfratel" xmlns:tns="http://www.example.org/ListaOLOComuneInfratel" elementFormDefault="qualified">

    <element name="Output_ListaOLOComuneInfratel">
    	<complexType>
    		<sequence>
    			<element name="listaOLOComuneInfratel"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codificaOloAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codiceIstatComune" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="dataInizioValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="dataFineValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="timestampInserimento" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="timestampAggiornamento" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="nota" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>