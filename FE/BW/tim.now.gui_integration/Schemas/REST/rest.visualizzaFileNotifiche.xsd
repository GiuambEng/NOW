<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/visualizzaFileNotifiche" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/visualizzaFileNotifiche">

    <element name="fileNotifiche">
    	<complexType>
    		<sequence>
    			<element name="listaFileNotifiche">
    				<complexType>
    					<sequence>
    						<element
    							ref="tns:listaFileNotificheInput">
    						</element>
    						<element maxOccurs="unbounded" minOccurs="0"
    							ref="tns:listaFileNotificheOutput">
    						</element>
    						<element
    							ref="tns:listaFileNotificheFault">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="listaFileNotificheInputType">
    	<sequence>
    		<element name="codOrdineOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="listaFileNotificheOutputType">
    	<sequence>
    		<element name="listaFileNotifiche" maxOccurs="unbounded"
    			minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="idFileProcessatoOutput"
    						type="string" maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="idNotifica" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="tipoNotifica" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="nomeFile" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="codOloAgcom" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="dimensioneFile" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="esitoInvio" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="quantitaRecordTotali"
    						type="string" maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="timestampCreazioneFile"
    						type="string" maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="timestampInvio" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    					<element name="position" type="int" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result" maxOccurs="1" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
    
    <complexType name="listaFileNotificheFaultType">
    	<sequence>
    		<element name="message" type="string" maxOccurs="1" minOccurs="1"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <element name="listaFileNotificheInput"
    	type="tns:listaFileNotificheInputType">
    </element>
    <element name="listaFileNotificheOutput"
    	type="tns:listaFileNotificheOutputType">
    </element>
    <element name="listaFileNotificheFault"
    	type="tns:listaFileNotificheFaultType">
    </element>
</schema>