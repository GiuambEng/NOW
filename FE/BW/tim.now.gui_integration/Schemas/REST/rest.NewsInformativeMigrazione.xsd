<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/NewsInformativeMigrazione"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/rest/NewsInformativeMigrazione">

	<element name="ListaNewsEInfoMigOutput" type="tns:ListaNewsInfoMigOutput">
	</element>

	<element name="ListaNewsEInfoMigFault">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
		</complexType>
	</element>

	<element name="ListaNewsEMigInput">
		<complexType>
			<sequence>
				<element name="ID_NEWS" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
				<element name="CONTENUTO" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="FLAG_VISIBILITA" type="string" maxOccurs="1"
