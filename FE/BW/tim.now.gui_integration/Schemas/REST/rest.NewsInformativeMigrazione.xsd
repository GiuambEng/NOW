						</element>
						<element name="DATE_ULTIMA_MODIFICA" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
					</sequence>
				</complexType>
			</element>
			<element name="result">
				<complexType>
					<sequence>
						<element name="severity" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
						<element name="code" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
						<element name="details" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
</schema>