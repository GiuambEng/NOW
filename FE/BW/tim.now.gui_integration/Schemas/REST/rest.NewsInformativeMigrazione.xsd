				<element name="TITOLO" type="string" maxOccurs="1"
					minOccurs="0">
				</element>

				<element name="FLAG_ELIMINA" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="OPERATORE_ULTIMA_MODIFICA" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="DATE_INSERIMENTO" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="DATE_ULTIMA_MODIFICA" type="string"
					maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<complexType name="ListaNewsInfoMigOutput">




		<sequence>

			<element name="ListaNewsInfoMigOutput" maxOccurs="unbounded"
				minOccurs="0">
				<complexType>
					<sequence>
						<element name="CONTENUTO" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="FLAG_VISIBILITA" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="ID_NEWS" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="NOTE" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="OPERATORE" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="TITOLO" type="string" maxOccurs="1"
							minOccurs="0">
						</element>

						<element name="FLAG_ELIMINA" type="string" maxOccurs="1"
							minOccurs="0">
						</element>
						<element name="OPERATORE_ULTIMA_MODIFICA" type="string"
							maxOccurs="1" minOccurs="0">
