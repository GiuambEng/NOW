<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VP" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/VP">
<element name="VPoutput">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:VPOutput">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="result" type="tns:result">
    			</element>
                <element minOccurs="0" name="idExportFile" type="string"/>
            </sequence>
    	</complexType>
  </element>

    <complexType name="VPoutput">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="codiceVP" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="stato" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="modalitaFatturazione" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="tipo" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="bandaMCR" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="bandaPCR" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="codiceAreaRaccolta" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="descAreaRaccolta" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="codiceKit" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="vpiRete" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="vpi" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="tipoTrasporto" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="clli" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="nomeCentrale" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="dataConsegnaOlo" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="numeroMaxVc" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="codificaOloAgcom" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="codiceOlo" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="decAttivazione" type="date"/>
    		<element maxOccurs="1" minOccurs="0" name="dec" type="date"/>
    	</sequence>
    </complexType>

    <complexType name="result">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="details" type="string"/>
    	</sequence>
    </complexType>
    <element name="VPOutput" type="tns:VPoutput"/>
</schema>
