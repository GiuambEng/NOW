<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/FileRisorseFwaDecommissioning" xmlns:tns="http://www.example.org/FileRisorseFwaDecommissioning" elementFormDefault="qualified">

    <element name="VisualizzaFIleFwaOutput">
    	<complexType>
    		<sequence>
    			<element name="listaFileFwa" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="idFile" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInserimento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataUltimaModifica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="nomeFile" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="numeroRecord" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="operatoreInserimento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="operatoreUltimaModifica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="descrizioneEsito"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="position" type="int" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="CaricamentoFileFwaOutput">
    	<complexType>
    		<sequence>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="CaricamentoFileFwaInput">
    	<complexType>
    		<sequence>
    			<element name="nomefile" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="contenutofile" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

</schema>