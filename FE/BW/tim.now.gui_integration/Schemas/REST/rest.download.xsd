<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/download" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/download">

    <element name="download">
    	<complexType>
    		<sequence>
    			<element ref="tns:downloadInput"></element>
    			<element maxOccurs="1" minOccurs="0"
    				ref="tns:downloadOutput">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="downloadInput">
    	<complexType>
    		<sequence>
    			<element name="idFile" type="int" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="downloadOutput">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="1"
    				name="outputDownload" type="tns:outputDownloadType">
    			</element>
    			<element minOccurs="0" maxOccurs="1" name="result" type="tns:resultType">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="outputDownloadType">
    	<sequence>
    		<element name="idContenutoFile" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="nomeFile" type="string" maxOccurs="1" minOccurs="0"></element>
            <element name="contenutoFile" type="string" maxOccurs="1" minOccurs="0">
    		</element>
        </sequence>
    </complexType>
    
    <complexType name="resultType">
    	<sequence>
    		<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>