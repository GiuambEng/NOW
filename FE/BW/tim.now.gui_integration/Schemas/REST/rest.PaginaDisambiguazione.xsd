<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/PaginaDisambiguazione" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/PaginaDisambiguazione">
<element name="PaginaDisamboutput">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:PaginaDisambOutput">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="result" type="tns:result">
    			</element>
    		</sequence>
    	</complexType>
  </element>

    <complexType name="PaginaDisamboutput">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="offerta"
    			type="string" />
    		<element minOccurs="0" name="nomeOfferta" type="string" />
    		<element name="idOfferta" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <complexType name="result">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="details" type="string"/>
    	</sequence>
    </complexType>
    <element name="PaginaDisambOutput" type="tns:PaginaDisamboutput"/>
</schema>
