<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/CaricamentoFileDaGui" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/CaricamentoFileDaGui">

    <element name="caricamentofiledagui" type="tns:caricamentofiledagui">
    </element>
    
    <complexType name="caricamentofiledagui">
    	<sequence>
    		<element ref="tns:inputcaricamentofiledagui"/>
    		<element ref="tns:outputcaricamentofiledagui"/>
    		<element ref="tns:faultcaricamentofiledagui"/>
    	
    	</sequence>
    </complexType>

    <complexType name="inputcaricamentofiledagui">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="nomefile"
    			type="string" />

    		<element maxOccurs="1" minOccurs="0" name="contenutofile"
    			type="string" />
    		<element name="codagcom" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="outputcaricamentofiledagui">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="result" type="tns:result"/>
    	</sequence>
    </complexType>
    
    <complexType name="faultcaricamentofiledagui">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="errormessage" type="string"/>
    	</sequence>
    </complexType>
    <element name="inputcaricamentofiledagui" type="tns:inputcaricamentofiledagui">
    </element>
    <element name="outputcaricamentofiledagui" type="tns:outputcaricamentofiledagui">
    </element>
    <element name="faultcaricamentofiledagui" type="tns:faultcaricamentofiledagui">
    </element>

    <complexType name="variabilepath">
    	<sequence>
    		<element name="nomefile" type="string"/>
    	</sequence>
    </complexType>

    <complexType name="esitocaricamento">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="esitocaricamento" type="string"/>
    	</sequence>
    </complexType>

    <complexType name="result">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="details" type="string"/>
    	</sequence>
    </complexType>
</schema>
