<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/OrdiniDonatingLista" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/OrdiniDonatingLista">

    <element name="ordiniDonatingLista">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1"
    				ref="tns:outputOrdiniDonatingLista">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="outputOrdiniDonatingListaType">
    	<sequence>
    		<element name="listaOrdiniDonatingOutput"
    			maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="ordineTI" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="statoOAO" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="oaoDonating" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="idRichiestaOLO" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="oao" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="codiceOrdineOao" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="statoNow" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="offerta" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="flagDiffidato" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="ambitoServizioRecipient" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="ambitoServizioDonating" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result" maxOccurs="1" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
    <element name="outputOrdiniDonatingLista"
    	type="tns:outputOrdiniDonatingListaType">
    </element>

    <element name="outputOrdiniDonatingDettaglio">
    	<complexType>
    		<sequence>
    			<element name="OutputOrdiniDonatingDettaglio"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="tipologiaNotifica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="causale" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataCreazione" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="notificaXML" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ultimoFileNotifica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInvioFile " type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="OutputOrdiniDonatingRichieste"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="codiceRichiestaOao"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInvio" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="statoNow" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="statoOao" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="xml" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="lavorazione" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="userId" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType></element>

    <element name="inputOrdiniDonatingLista">
    	<complexType>
    		<sequence>
    			<element name="codOrdineTi" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="nomeFileNotifica" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="tipoProfilo" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codificaAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="idRisorsa" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codiceSessione" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>