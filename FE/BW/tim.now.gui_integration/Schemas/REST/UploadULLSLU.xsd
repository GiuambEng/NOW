<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/UploadULLSLU" xmlns:tns="http://www.example.org/UploadULLSLU" elementFormDefault="qualified">

    <element name="inputUploadULLSLU">
    	<complexType>
    		<sequence>
    			<element name="nomeFile" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="contenutoFile" type="base64Binary" maxOccurs="1" minOccurs="0"></element>
    			<element name="id_Operatore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputUploadULLSLU">
    	<complexType>
    		<sequence>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>