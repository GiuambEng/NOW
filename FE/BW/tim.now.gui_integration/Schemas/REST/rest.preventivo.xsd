<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/preventivo" xmlns:tns="http://www.tim.com/NOW/rest/preventivo" elementFormDefault="qualified">


    <element name="Output_Preventivo">
    	<complexType>
    		<sequence>
    			<element name="Lista_Output_Preventivo"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="dataAccettazioneOao"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataPreventivo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="contributoCliente"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="opa" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="permessi" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="timeoutAccettazione"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="importoTotale" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="note" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="numGiorniPrevisto"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="stato" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataUltimaModifica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataInserimento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="dataTimeoutAccettazione"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="descrizioneArticolo"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="importoArticolo"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="quantitaArticolo"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="prezziEspostiIn" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result">
    				<complexType>
					<sequence>
						<element name="severity" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
						<element name="code" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
						<element name="details" type="string" minOccurs="0"
							maxOccurs="1">
						</element>
					</sequence>

				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Fault_Preventivo">
    	<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>

		</complexType>
    </element>
    
    <element name="Input_Preventivo">
    	<complexType>
    		<sequence>
    			<element name="idRichOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>