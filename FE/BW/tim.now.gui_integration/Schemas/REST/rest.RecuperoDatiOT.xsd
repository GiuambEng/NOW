    						<element name="statoOLO_DA" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="strutturaRichiesta"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="timestampTracciamento"
    							type="string" maxOccurs="1" minOccurs="0">
