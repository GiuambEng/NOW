    						</element>
    						<element name="DAC_DA" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idRisorsa" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idRisorsaNow" type="string"
    							maxOccurs="1" minOccurs="0">
