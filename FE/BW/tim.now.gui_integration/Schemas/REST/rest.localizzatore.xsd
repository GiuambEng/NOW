<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/Localizzatore" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/Localizzatore">

    <element name="InputRestLocalizzatore">
    	<complexType>
    		<sequence>
    			<element name="Transaction_Id" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="CodiceOLO" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CodiceISP" type="int" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CodiceComune" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Servizio" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Lavorazione" maxOccurs="1" minOccurs="0"
    				type="string">
    			</element>
    			<element name="CodiceOrdineOlo" maxOccurs="1"
    				minOccurs="0" type="string">
    			</element>
    			<element name="CodiceOrdineRiferimentoTI" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="IdRisorsa" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="IdRisorsa2" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="DN" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="sottolavorazione" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="DNAggiuntivi" type="string"
    				maxOccurs="unbounded" minOccurs="0">
    			</element>
    			<element name="rientro" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="tipoLinea" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="numeroLinea" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="tipologiaAccesso" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="provincia" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>

    <element name="OutputRestLocalizzatore">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string" minOccurs="0" maxOccurs="1"></element>
    			<element name="Descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="result" minOccurs="0" maxOccurs="1">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" minOccurs="0" maxOccurs="1"></element>
    						<element name="code" type="string" minOccurs="0" maxOccurs="1"></element>
    						<element name="details" type="string" minOccurs="0" maxOccurs="1"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="TrascodificaOfferta" type="tns:NewType"></element>
    
    <simpleType name="NewType">
    	<restriction base="string"></restriction>
    </simpleType>
</schema>