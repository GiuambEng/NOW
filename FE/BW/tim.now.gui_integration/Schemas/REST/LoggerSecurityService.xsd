<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/LoggerSecurityService" xmlns:tns="http://www.example.org/LoggerSecurityService" elementFormDefault="qualified">
    <element name="LoggerSecurity">
    	<complexType>
    		<sequence>
    			<element ref="tns:loggerSecurityInput" maxOccurs="1" minOccurs="0"></element>
    			<element ref="tns:loggerSecurityOutput" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="LoggerSecurityInput">
    <sequence>
    	<element maxOccurs="1" minOccurs="0" name="APPLICAZIONE_CLIENT"
    		type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="DESCR_FUNZIONE"
    		type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="DESCR_PROFILO"
    		type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="HOSTNAME_CLIENT"
    		type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="IP_CLIENT "
    		type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="IP_SERVER "
    		type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="OS_USER"
    		type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0"
    		name="PARAMETRI_OPERAZIONE " type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="SERVER_NAME "
    		type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="SESSION_ID"
    		type="string">
    	</element>

    	<element name="TIMSTP_INSMTO" type="dateTime" minOccurs="0"
    		maxOccurs="1">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="TIPO_OPERAZIONE "
    		type="string">
    	</element>
    	<element maxOccurs="1" minOccurs="0" name="USERID"
    		type="string">
    	</element>
    	<element name="TIMSTP_INIZIO" type="dateTime" maxOccurs="1" minOccurs="0"></element>
    	<element name="TIMSTP_FINE" type="dateTime" maxOccurs="1" minOccurs="0"></element>
    	<element name="NUM_DATI_ESPORTATI" type="int" maxOccurs="1" minOccurs="0"></element>
    	<element name="CONTENUTO_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    	<element name="NOME_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    	<element name="ESITO" type="string" maxOccurs="1" minOccurs="0"></element>
    </sequence>
    </complexType>

    <complexType name="LoggerSecurityOutput">
    	<sequence>

            <element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
            <element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
            <element name="result" type="tns:result" maxOccurs="1" minOccurs="0">
    		</element>
        </sequence>
    </complexType>

    <complexType name="result">
    	<sequence>
    		<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <complexType name="Output">
    	<sequence>
    		<element name="Ok" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="loggerSecurityInput"
    	type="tns:LoggerSecurityInput">
    </element>
    <element name="loggerSecurityOutput"
    	type="tns:LoggerSecurityOutput">
    </element>

    <element name="LogOutLoggerSecurity">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0"
    				ref="tns:logOutInput">
    			</element>
    			<element maxOccurs="1" minOccurs="0"
    				ref="tns:logOutOutput">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="logOutInput" type="tns:LoggerSecurityInput"></element>
    <element name="logOutOutput" type="tns:LoggerSecurityOutput"></element>

</schema>