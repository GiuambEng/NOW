<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/ProfiliLinea" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/ProfiliLinea">

    <element name="ProfiliLineaOutput">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:profiliLineaOutput">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="result" type="tns:result">
    			</element>
                <element minOccurs="0" name="idExportFile" type="string"/>
            </sequence>
    	</complexType>
  </element>

    <complexType name="ProfiliLineaoutput">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0"
    			name="idProfiloTecnicoLinea" type="int">
    		</element>
    		<element maxOccurs="1" minOccurs="0"
    			name="profiloTecnicoLinea" type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="idOfferta"
    			type="int">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="offerta"
    			type="string" />
    		<element maxOccurs="1" minOccurs="0" name="flagVendibilita"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="maxVCxCF"
    			type="int">
    		</element>
    		<element maxOccurs="1" minOccurs="0"
    			name="profiloCommercialeDown" type="int">
    		</element>
    		<element maxOccurs="1" minOccurs="0"
    			name="profiloCommercialeUp" type="int">
    		</element>
    		<element maxOccurs="1" minOccurs="0"
    			name="velocitaAggancioDownMax" type="int">
    		</element>
    		<element maxOccurs="1" minOccurs="0"
    			name="velocitaAggancioDownMin" type="int">
    		</element>
    		<element maxOccurs="1" minOccurs="0"
    			name="velocitaAggancioUpMax" type="int">
    		</element>
    		<element maxOccurs="1" minOccurs="0"
    			name="velocitaAggancioUpMin" type="int">
    		</element>
    		<element name="bandaNetta" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element maxOccurs="1" minOccurs="0" name="codiceModem"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="modem"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="modelloAccesso"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="protocollo"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="tecnologiaOlo"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="tipoModulazione"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="idProfiloBMD"
    			type="int">
    		</element>

    	</sequence>
    </complexType>
    
    <complexType name="result">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="severity" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="code" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="details" type="string"/>
    	</sequence>
    </complexType>
    <element name="profiliLineaOutput" type="tns:ProfiliLineaoutput"/>
</schema>
