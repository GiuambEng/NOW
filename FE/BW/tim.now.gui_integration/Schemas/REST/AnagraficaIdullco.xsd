<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/AnagraficaIdullco" xmlns:tns="http://www.example.org/AnagraficaIdullco" elementFormDefault="qualified">

    <element name="Input_AnagraficaIdullco_RicercaAvanzata"
    	type="tns:Input_AnagraficaIdullco_RicercaAvanzata">
    </element>
    
    <complexType name="Input_AnagraficaIdullco_RicercaAvanzata">
    	<sequence>
    		<element name="numerorighe" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="indiceriga" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="exportRequest" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="strutturaCondition" maxOccurs="unbounded"
    			minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="nome" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="operazione" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="valore" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="tipo" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="Output_AnagraficaIdullco"
    	type="tns:Output_AnagraficaIdullco">
    </element>
    
    <complexType name="Output_AnagraficaIdullco">
    	<sequence>
    		<element name="listaIdullco" maxOccurs="unbounded"
    			minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="IDULLCO" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="CLLI" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="CodiceGAT" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="CodificaOAO" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="DRCP" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="Centrale" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    		<element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
</schema>