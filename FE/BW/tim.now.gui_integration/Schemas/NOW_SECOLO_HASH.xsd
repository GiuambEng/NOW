<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SECOLO_HASH/" targetNamespace="http://www.tim.com/NOW/xsd/NOW_SECOLO_HASH/" elementFormDefault="qualified">
	<element name="RequestGet_Multiple_Hash_Secolo">
		<complexType>
			<sequence>
				<element name="CodificaOLOAGCOM" type="string" minOccurs="0"/>
				<element name="CodiceOrdineOLO" type="string" minOccurs="0"/>
				<element name="Funzione" type="string" minOccurs="0"/>
				<element name="ChiaveRiferimento" type="string" minOccurs="0"/>
				<element name="Operatore" type="string" minOccurs="0"/>
				<element name="IPClient" type="string" minOccurs="0"/>
				<element name="HashIN" minOccurs="0" maxOccurs="20">
					<complexType>
						<sequence>
							<element name="key" type="string" minOccurs="0"/>
							<element name="value" type="string" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
				<element name="Bonifica" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="1"/>
							<enumeration value="Y"/>
							<enumeration value="N"/>
						</restriction>
					</simpleType>
				</element>
				<element name="IdRichOLO" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="ResponseGet_Multiple_Hash_Secolo">
		<complexType>
			<sequence>
				<element name="HashOUT" minOccurs="0" maxOccurs="20">
					<complexType>
						<sequence>
							<element name="key" type="string" minOccurs="0"/>
							<element name="value" type="string" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
				<element name="ESITO">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DESCRIZIONE" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="RETURN_CODE" type="string" minOccurs="0"/>
				<element name="DESCRIZIONE" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>