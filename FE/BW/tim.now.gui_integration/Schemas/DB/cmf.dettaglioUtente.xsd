<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/dettaglioUtente" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/dettaglioUtente">

    <element name="utente">
    	<complexType>
    		<sequence>
    			<element name="dettaglioUtente">
    				<complexType>
    					<sequence>
    						<element ref="tns:dettaglioUtenteInput"></element>
    						<element ref="tns:dettaglioUtenteOutput" maxOccurs="1" minOccurs="0">
    						</element>
    						<element ref="tns:dettaglioUtenteFault">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="dettaglioUtenteInput" type="tns:dettaglioUtenteInput"></element>
    <element name="dettaglioUtenteOutput" type="tns:dettaglioUtenteOutput"></element>
    <element name="dettaglioUtenteFault" type="tns:dettaglioUtenteFault"></element>

    <complexType name="dettaglioUtenteInput">
    	<sequence>
    		<element name="userId" type="string" maxOccurs="1" minOccurs="1"></element>
    	</sequence>
    </complexType>
    
    <complexType name="dettaglioUtenteOutput">
    	<sequence>
    		<element name="utenteOutput" minOccurs="0"
    			maxOccurs="1">
    			<complexType>
    				<sequence>
    					<element name="codProfilo" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="userId" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="userAlias" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="matricola" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="idTipologiaUtente" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="nome" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="cognome" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="dataFineValidita" type="date"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="dataInizioValidita" type="date"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="flagDisabilitato" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="indirizzoEmail" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="codificaOloAgcom" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="flagAccorpante" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="flagAccorpato" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
    
    <complexType name="dettaglioUtenteFault">
    	<sequence>
    		<element name="message" type="string" maxOccurs="1" minOccurs="1"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>