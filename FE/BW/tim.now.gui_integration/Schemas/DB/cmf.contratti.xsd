<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/contratti" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/contratti" xmlns:Q1="http://www.example.org/commons">

    <element name="ListaContrattiAttivazioneInput"
    	type="tns:listaAttivazioneInput">
    </element>
    
    <complexType name="listaAttivazioneInput">
    	<sequence>
    		<element name="listaContrattiAttivazione" maxOccurs="unbounded" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="codiceAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType></element>
    	</sequence>
    </complexType>

    <complexType name="listaAttivazioneOutput">
    	<sequence>
    		<element name="contratto" type="tns:contrattoAttivazione"
    			minOccurs="0" maxOccurs="unbounded">
    		</element>
    	</sequence>
    </complexType>
    
    <complexType name="contrattoAttivazione">
    	<sequence>
    		<element name="idContratto" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="codiceContratto" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="codificaOAO" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="nome" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="tipo" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="idTipoServizio" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="stato" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="tipoProdotti" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagNPD" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagAbilitato" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagValido" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="dataInizio" type="dateTime" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="dataFine" type="dateTime" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagDiffidato" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagStandard" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagFileNotify" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="flagAnfibio" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="idContrattoPadre" type="decimal"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="statoStandard" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="dataUltimoAggiornamento" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="dataInserimento" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="identificativoContrattoCRMW" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="nomeStandard" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="identificativoTipologiaContratto"
    			type="string" minOccurs="0" maxOccurs="1">
    		</element>
            <element name="tipoContratto" type="string" maxOccurs="1" minOccurs="0"></element>
            <element name="oao" maxOccurs="1" minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="olo" type="string" maxOccurs="1"
    						minOccurs="0">
    					</element>
    					<element name="ragioneSociale" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="partitaIva" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="codiceOloAgcom" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="codiceOloNumerico" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="flagAccorpante" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    
    <element name="ListaContrattiAttivazioneFault"
    	type="tns:fault_type">
    </element>

    <element name="ListaContrattoAttivazioneOutput"
    	type="tns:listaAttivazioneOutput">
    </element>

    <complexType name="fault_type">
    	<sequence>
    		<element name="messaggio" type="string"></element>
    		<element name="codice" type="string"></element>
    	</sequence>
    </complexType>



    

</schema>