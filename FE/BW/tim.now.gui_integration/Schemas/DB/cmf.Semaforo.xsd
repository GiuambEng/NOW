<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/Semaforo" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/Semaforo">
<element name="OloAccorpante">
    	<complexType>
    		<sequence>
    			<element ref="tns:oloAccorpanteInput"></element>
    			<element ref="tns:oloAccorpanteOutput"></element>
    		</sequence>
    	</complexType></element>

    <complexType name="oloAccorpanteInput">
    	<sequence>
    		<element name="userId" type="string"></element>
    	</sequence>
    </complexType>
    
    <complexType name="oloAccorpanteOutput">
    	<sequence>
    		<element ref="tns:flagOloAccorpante"></element>
    	</sequence>
    </complexType>
    <element name="oloAccorpanteInput" type="tns:oloAccorpanteInput"></element>
    <element name="oloAccorpanteOutput"
    	type="tns:oloAccorpanteOutput">
    </element>

    <element name="File">
    	<complexType>
    		<sequence>
    			<element ref="tns:fileListInput"></element>
    			<element ref="tns:fileListOutput"></element>
    		</sequence>
    	</complexType></element>

    <complexType name="fileListInput">
    	<sequence>
    		<element name="clientCode" type="int" maxOccurs="1" minOccurs="1"></element>
    	</sequence>
    </complexType>
    
    <complexType name="fileListOutput">
    	<sequence>
    		<element ref="tns:listaAttributiRecuperati" minOccurs="0" maxOccurs="unbounded"></element>
    	</sequence>
    </complexType>
    <element name="fileListInput" type="tns:fileListInput"></element>
    <element name="fileListOutput" type="tns:fileListOutput"></element>

    <complexType name="listaAttributiRecuperati">
    	<sequence>
    		<element name="NOMEFILE" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="DIMENSIONEFILE" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="IDENTIFICATIVOCAUSALESCARTO" type="string"
    			maxOccurs="1" minOccurs="0">
    		</element>
    		<element name="QUANTITARECORDKO" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="QUANTITARECORDNOW" type="string"
    			maxOccurs="1" minOccurs="0" />
    		<element name="QUANTITARECORDOK" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="QUANTITARECORDTOTALI" type="string"
    			maxOccurs="1" minOccurs="0" />
    		<element name="IDINTERFACCIA" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="IDESECPROCFILE" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="ESITO" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="APERTURAFILE" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="CHIUSURAFILE" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="CODOLOAGCOM" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="DESCRSTATOACQUISIZIONE" type="string"
    			maxOccurs="1" minOccurs="0" />
    		<element name="DATAFILE" type="string" maxOccurs="1"
    			minOccurs="0" />
    		<element name="IDFILE" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="SEMAFORO" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="DATA_ARRIVO" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="TOT_ORDINI_CRMWS" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="ID_TIPOLOGIA_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <element name="listaAttributiRecuperati">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="unbounded"
    				ref="tns:lista">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="ListaOlo">
    	<complexType>
    		<sequence>
    			<element ref="tns:listaOloInput"></element>
    			<element ref="tns:listaOloOutput"></element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="listaOloInput">
    	<sequence>
    		<element name="codiceAgcom" type="string"></element>
    	</sequence>
    </complexType>
    
    <complexType name="listaOloOutput">
    	<sequence>
    		<element name="codiceAgcom" type="string"></element>
    		<element name="flagOloAccorpante" type="string"></element>
    		<element ref="tns:listaOlo_AnagraficaOlo"></element>
    	</sequence>
    </complexType>
    <element name="listaOloInput" type="tns:listaOloInput"></element>
    <element name="listaOloOutput" type="tns:listaOloOutput"></element>

    <complexType name="listaOlo_AnagraficaOlo">
    	<sequence>
    		<element name="nome" type="string"></element>
    		<element name="codiceAgcom" type="string"></element>
    		<element name="flagAccorpante" type="string"></element>
    	</sequence>
    </complexType>
    <element name="listaOlo_AnagraficaOlo"
    	type="tns:listaOlo_AnagraficaOlo">
    </element>

    <element name="Semaforo">
    	<complexType>
    		<sequence>
    			<element ref="tns:semaforoInput"></element>
    			<element ref="tns:semaforoOutput"></element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="semaforoInput">
    	<sequence>
    		<element name="idFile" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="causaleScarto" type="string" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="qntTOT" type="int" minOccurs="0"
    			maxOccurs="1">
    		</element>
    		<element name="qntNOW" type="int" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>
    
    <complexType name="semaforoOutput">
    	<sequence>
    		<element name="semaforo" type="string" minOccurs="0" maxOccurs="1"></element>
    		<element name="idFile" type="string" minOccurs="0" maxOccurs="1"></element>
    	</sequence>
    </complexType>
    <element name="semaforoInput" type="tns:NewType4"></element>
    <element name="semaforoOutput">
    	<complexType>
    		<sequence>
    			<element name="Output" type="tns:semaforoOutput" minOccurs="0" maxOccurs="unbounded"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Visualizzazione">
    	<complexType>
    		<sequence>
    			<element ref="tns:visualizzaInput"></element>
    			<element ref="tns:visualizzaOutput"></element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="visulizzaInput">
    	<sequence>
    		<element name="codOloAgcom" minOccurs="0" maxOccurs="unbounded" type="string"></element>
    	</sequence>
    </complexType>
    
    <complexType name="visualizzaOutput">
    	<sequence>
    		<element name="Tipologia" type="string" />
    		<element name="NomeFile" type="string" />
    		<element name="DataCreazione" type="string" />
    		<element name="CodificaOlo" type="string" />
    		<element name="DimensioneFile" type="string" />
    		<element name="EsitoInvio" type="string" />
    		<element name="QuantitaRecordTotali" type="string" />
    		<element name="DataInvio" type="string" />

    		<element name="Qt_rcd_totali" type="string"></element>
    		<element name="Qt_rcd_Now" type="string"></element>
    		<element name="Tot_Ok" type="string"></element>
    		<element name="Tot_KO" type="string"></element>
    		<element name="IdFile" type="string"></element>
    		<element name="NewElement2" type="string"></element>
    	</sequence>
    </complexType>
    <element name="visualizzaInput" type="tns:visulizzaInput"></element>
    <element name="visualizzaOutput" type="tns:NewType1"></element>

    <complexType name="visualizza">
    	<sequence>
            <element name="Tipologia" type="string"/>
    		<element name="NomeFile" type="string"/>
    		<element name="DataCreazione" type="date"/>
    		<element name="CodificaOlo" type="string"/>
    		<element name="DimensioneFile" type="string"/>
    		<element name="EsitoInvio" type="string"/>
    		<element name="QuantitaRecordTotali" type="string"/>
    		<element name="DataInvio" type="date"/>
    	</sequence>
    </complexType>

    <element name="OutputRestSemaforo" type="tns:OutputRestSemaforo"></element>

    <complexType name="OutputRestSemaforo">
    	<sequence>
    		<element ref="tns:semaforoOutput" minOccurs="0" maxOccurs="unbounded"></element>
    	</sequence>
    </complexType>

    <element name="OutputRestVisualizza"
    	type="tns:OutputRestVisualizza">
    </element>
    
    <complexType name="OutputRestVisualizza">
    	<sequence>
    		<element ref="tns:visualizzaOutput" minOccurs="0" maxOccurs="unbounded"></element>
    	</sequence>
    </complexType>

    <complexType name="Output"></complexType>
    <element name="lista" type="tns:listaAttributiRecuperati"></element>
    <element name="flagOloAccorpante" type="string"></element>
    <element name="visualizza" type="tns:visualizza"></element>

    <complexType name="NewType"></complexType>

    <complexType name="NewType1">
    	<sequence>
    		<element name="NewElement" type="tns:listaAttributiRecuperati" minOccurs="0" maxOccurs="unbounded"></element>
    	</sequence>
    </complexType>

    <element name="VisualizzaNonOlo">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="unbounded"
    				ref="tns:visualizzaNonOloInput">
    			</element>
    			<element ref="tns:VisualizzaNonOloOutput" minOccurs="0" maxOccurs="unbounded"></element>
    		</sequence>
    	</complexType></element>


    <complexType name="visualizzaNonOloInput">
    	<sequence>
    		<element name="codiceAgcom" type="string"></element>
    	</sequence>
    </complexType>
    
    <complexType name="VisualizzaNonOloOutput"></complexType>
    <element name="visualizzaNonOloInput"
    	type="tns:visualizzaNonOloInput">
    </element>
    <element name="VisualizzaNonOloOutput"
    	type="tns:NewType3">
    </element>


    <complexType name="NewType2"></complexType>

    <complexType name="NewType3">
    	<sequence>
    		<element minOccurs="0" maxOccurs="unbounded"
    			ref="tns:listaAttributiRecuperati">
    		</element>
    	</sequence>
    </complexType>

    <element name="VisNonOloOutput" type="string"></element>

    <complexType name="listaAttributiRecuperatiNonOlo">
        		<sequence>
    			<element name="Nomefile" type="string"></element>
    			<element name="StatoAcquisizione" type="string"></element>
    			<element name="dataarrivo" type="string"></element>
    			<element name="nomefile" type="string"></element>
    			<element name="qtrectot" type="string"></element>
    			<element name="totnow" type="string"></element>
    			<element name="totok" type="string"></element>
    			<element name="totko" type="string"></element>
    			<element name="causscarto" type="string"></element>
    			<element name="datafile" type="string"></element>
    			<element name="esito" type="string"></element>
    			<element name="idfile" type="string"></element>
    			<element name="idinterfaccia" type="string"></element>
    			<element name="apertura" type="string"></element>
    			<element name="chiusura" type="string"></element>
    		</sequence>
    </complexType>

    <complexType name="NewType4">
    	<sequence>
    		<element minOccurs="0" maxOccurs="unbounded"
    			ref="tns:semaforoInput1">
    		</element>
    	</sequence>
    </complexType>
    <element name="semaforoInput1" type="tns:semaforoInput"></element>
</schema>