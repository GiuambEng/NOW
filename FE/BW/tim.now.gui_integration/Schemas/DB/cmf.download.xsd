<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/download" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/download">

    <element name="download">
    	<complexType>
    		<sequence>
    			<element name="download" type="tns:downloadType"></element>
    		</sequence>
    	</complexType></element>

    <complexType name="downloadType">
    	<sequence>
    		<element ref="tns:downloadInput"></element>
    		<element maxOccurs="1" minOccurs="0"
    			ref="tns:downloadOutput">
    		</element>
    		<element ref="tns:downloadFault"></element>
    	</sequence>
    </complexType>

    <complexType name="downloadInput">
    	<sequence>
    		<element name="idFile" type="int" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="downloadOutput">
    	<sequence>
    		<element name="dettaglioDownloadOutput"
    			type="tns:dettaglioDownloadOutputType" maxOccurs="1" minOccurs="0">
    		</element>
    	</sequence>
    </complexType>
    
    <complexType name="downloadFault">
    	<sequence>
    		<element name="message" type="string" minOccurs="1" maxOccurs="1"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="dettaglioDownloadOutputType">
    	<sequence>
    		<element name="idFile" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="contenutoFile" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="idContenutoFile" type="string" maxOccurs="1"
    			minOccurs="0">
    		</element>
    		<element name="nomeFile" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    <element name="downloadInput" type="tns:downloadInput"></element>
    <element name="downloadOutput" type="tns:downloadOutput"></element>
    <element name="downloadFault" type="tns:downloadFault"></element>
</schema>