<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/cmf.LoggerSecurityService" xmlns:tns="http://www.example.org/cmf.LoggerSecurityService" elementFormDefault="qualified">
  <element name="LoggerSecurity">
    	<complexType>
    		<sequence>
    			<element ref="tns:LoggerInput"/>
    			<element ref="tns:LoggerOutput"/>
    		</sequence>
    	</complexType>
  </element>

    <complexType name="LoggerInput">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0"
    			name="APPLICAZIONE_CLIENT" type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="DESCR_FUNZIONE"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="DESCR_PROFILO"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="HOSTNAME_CLIENT"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="IP_CLIENT "
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="IP_SERVER "
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="OS_USER"
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0"
    			name="PARAMETRI_OPERAZIONE " type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="SERVER_NAME "
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="SESSION_ID"
    			type="string">
    		</element>

    		<element maxOccurs="1" minOccurs="0" name="TIMSTP_INSMTO"
    			type="dateTime" />
    		<element maxOccurs="1" minOccurs="0" name="TIPO_OPERAZIONE "
    			type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="USERID"
    			type="string">
    		</element>
    		<element name="TIMSTP_INIZIO" type="dateTime" maxOccurs="1" minOccurs="0"></element>
    		<element name="TIMSTP_FINE" type="dateTime" maxOccurs="1" minOccurs="0"></element>
    		<element name="NUM_DATI_ESPORTATI" type="int" maxOccurs="1" minOccurs="0"></element>
    		<element name="CONTENUTO_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="NOME_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="ESITO" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>

    </complexType>
    
    <complexType name="LoggerOutput">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="OK" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="KO" type="string"/>
    	</sequence>
    </complexType>
    <element name="LoggerInput" type="tns:LoggerInput"/>
    <element name="LoggerOutput" type="tns:LoggerOutput"/>

    <complexType name="LoggerOut_in">
    <sequence>
    		<element maxOccurs="1" minOccurs="0" name="APPLICAZIONE_CLIENT" type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="DESCR_FUNZIONE" type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="DESCR_PROFILO" type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="HOSTNAME_CLIENT" type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="IP_CLIENT " type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="IP_SERVER " type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="OS_USER" type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="PARAMETRI_OPERAZIONE " type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="SERVER_NAME " type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="SESSION_ID" type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="TIMSTP_INSMTO" type="dateTime">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="TIPO_OPERAZIONE " type="string">
    		</element>
    		<element maxOccurs="1" minOccurs="0" name="USERID" type="string">
    		</element>
    	</sequence>
    </complexType>

    <complexType name="LoggerOut_Out">
    	<sequence>
    		<element maxOccurs="1" minOccurs="0" name="OK" type="string"/>
    		<element maxOccurs="1" minOccurs="0" name="KO" type="string"/>
    	</sequence>
    </complexType>

    <element name="LoggerSecurityOut">
    	<complexType>
    		<sequence>
    			<element ref="tns:LoggerOut_in"/>
    			<element ref="tns:LoggerOut_Out"/>
    		</sequence>
    	</complexType>
    </element>

    <element name="LoggerOut_in" type="tns:LoggerOut_in"/>

    <element name="LoggerOut_Out" type="tns:LoggerOut_Out"/>



</schema>
