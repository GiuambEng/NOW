<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/cmf/cliente" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/cliente">
	<element name="ListaOloPerNuovoOrdineInput" type="tns:listaOloNOInput">
    </element>
	<element name="ListaOloPerNuovoOrdineOutput" type="tns:listaOloNOOutput">
    </element>
	<complexType name="listaOloNOInput">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="codiceAgcom" type="string"/>
		</sequence>
	</complexType>
	<complexType name="listaOloNOOutput">
		<sequence>
			<element name="profiloOlo" maxOccurs="1" minOccurs="0">
				<complexType>
					<sequence>
						<element name="codiceAgcom" type="string" maxOccurs="1" minOccurs="0">
    					</element>
						<element name="flagAccorpante" type="string" maxOccurs="1" minOccurs="0">
    					</element>
						<element name="anagraficaOlo" maxOccurs="unbounded" minOccurs="0">
							<complexType>
								<sequence>
									<element name="nome"
										type="string">
									</element>
									<element name="operatore"
										type="string">
									</element>
									<element name="codiceAgcom"
										type="string">
									</element>
									<element name="flagAccorpante"
										type="string">
									</element>
								</sequence>
							</complexType>
						</element>
					</sequence>
				</complexType>
			</element>
			<element name="result" minOccurs="0">
				<complexType>
					<sequence>
						<element name="severity" minOccurs="0" type="string">
    		</element>
						<element name="code" minOccurs="0" type="string">
    		</element>
						<element name="details" minOccurs="0" type="string">
    		</element>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
	<complexType name="anagraficaOLO">
		<sequence>
			<element name="nome" type="string" />
			<element name="operatore" type="string" />
			<element name="codRete" type="string" />
			<element name="flagAccorpante" type="string" />

			<element name="codiceAgcom" type="string"></element>
		</sequence>
	</complexType>
	<element name="isOloAccorpanteInput" type="tns:oloAccorpanteInput"/>
	<element name="isOloAccorpanteOutput" type="tns:oloAccorpanteOutput"/>
	<complexType name="oloAccorpanteInput">
		<sequence>
			<element name="userid" type="string"/>
		</sequence>
	</complexType>
	<complexType name="oloAccorpanteOutput">
		<sequence>
			<element name="flagAccorpante" type="string" maxOccurs="1" minOccurs="0"/>
			<element name="codOloAccorpante" type="string" maxOccurs="1" minOccurs="0"></element>
			<element name="codOloNumerico" type="string" maxOccurs="1" minOccurs="0"></element>
		</sequence>
	</complexType>
	<element name="ListaOloPerNUovoOrdineFault" type="tns:fault_type">
    </element>
	<complexType name="fault_type">
		<sequence>
			<element name="messaggio" type="string">
    		</element>
			<element name="codice" type="string">
    		</element>
		</sequence>
	</complexType>
	<element name="isOloAccorpanteFault" type="tns:fault_type">
    </element>

	<element name="listaOloMapper" type="tns:oloMapper"></element>
	
    <complexType name="oloMapper">
    	<sequence>
    		<element name="listaOlo" type="tns:anagraficaOLO" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>
