    						<element name="idAnagCausale"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idEventoOrdNOW"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="idNotifica" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="idRichiestaOLO"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="lavorazioneRichiesta"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="operatore" type="string" maxOccurs="1" minOccurs="0"></element>
