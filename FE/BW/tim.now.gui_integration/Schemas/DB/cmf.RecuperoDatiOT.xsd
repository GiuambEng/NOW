    						<element name="statoNOW_A" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="statoNOW_DA" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="statoOLO_A" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="statoOLO_DA" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="strutturaRichiesta"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="timestampTracciamento"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipoRichiesta" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType></element>

    <element name="faultRecuperoDatiOT">
    	<complexType>
    		<sequence>
    			<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
</schema>