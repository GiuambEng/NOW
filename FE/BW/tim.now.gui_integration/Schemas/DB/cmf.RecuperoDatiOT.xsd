<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/RecuperoDatiOT" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/RecuperoDatiOT">

    <element name="inputRecuperoDatiOT">
    	<complexType>
    		<sequence>
    			<element name="codOrdineTI" type="string"
    				maxOccurs="unbounded" minOccurs="0">
    			</element>
    			<element name="codOrdineOlo" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>

    <element name="outputRecuperoDatiOT">
    	<complexType>
    		<sequence>
    			<element name="outputRecuperoDatiOT" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="canaleRichiesta"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codOrdineOLO"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codOrdineOLOPadre"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codOrdineOLOTarget"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codOrdineTI" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="codOLOAgcom" type="string" maxOccurs="1" minOccurs="0"></element>
