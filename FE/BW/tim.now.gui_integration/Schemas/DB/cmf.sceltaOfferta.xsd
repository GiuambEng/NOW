<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/sceltaOfferta" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/sceltaOfferta">

    <element name="Offerta">
    	<complexType>
    		<sequence>
    			<element name="ListaOfferte">
    				<complexType>
    					<sequence>
    						<element ref="tns:ListaOfferteInput"></element>
    						<element ref="tns:ListaOfferteOutput"></element>
    						<element ref="tns:ListaOfferteFault"></element>
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType></element>
    <element name="ListaOfferteInput">
    	<complexType>
    		<sequence>
    			<element name="idContratto" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
    <element name="ListaOfferteOutput">
        <complexType>
        	<sequence>
        		<element name="listaOffertaoutput" maxOccurs="unbounded"
        			minOccurs="0">
        			<complexType>
        				<sequence>
        					<element name="nomeOfferta" type="string"
        						maxOccurs="1" minOccurs="0">
        					</element>
        					<element name="nomeOffertaCatalogo"
        						type="string" maxOccurs="1" minOccurs="0">
        					</element>
        					<element name="idOfferta" type="string" maxOccurs="1" minOccurs="0"></element>
        				</sequence>
        			</complexType>
        		</element>
        		<element name="result" maxOccurs="1" minOccurs="0">
        			<complexType>
        				<sequence>
        					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
        					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
        					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
        				</sequence>
        			</complexType></element>
        	</sequence>
        </complexType>
    </element>
    <element name="ListaOfferteFault">
    	<complexType>
    		<sequence>
    			<element name="code" type="string"></element>
    			<element name="message" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>