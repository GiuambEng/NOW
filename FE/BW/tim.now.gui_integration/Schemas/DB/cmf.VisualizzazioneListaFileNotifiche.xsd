<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/VisualizzazioneFileNotifiche" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/VisualizzazioneFileNotifiche">

    <element name="fileNotifiche">
    	<complexType>
    		<sequence>
    			<element name="listaFileNotifiche">
    				<complexType>
    					<sequence>
    						<element
    							ref="tns:listaFileNotificheInput">
    						</element>
    						<element maxOccurs="unbounded" minOccurs="0"
    							ref="tns:listaFileNotificheOutput">
    						</element>
    						<element
    							ref="tns:listaFileNotificheFault">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="listaFileNotificheInput" type="tns:listaFileNotificheInput"></element>
    <element name="listaFileNotificheOutput" type="tns:listaFileNotificheOutput"></element>
    <element name="listaFileNotificheFault" type="tns:listaFileNotificheFault"></element>

    <complexType name="listaFileNotificheOutput">
    	<sequence>
    		<element name="fileNotifiche" maxOccurs="unbounded"
    			minOccurs="0">
    			<complexType>
    				<sequence>
    					<element name="idFileProcessatoOutput" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="idNotifica" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="tipoNotifica" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="nomeFile" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="codOloAgcom" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="dimensioneFile" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="esitoInvio" type="string"
    						maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="quantitaRecordTotali"
    						type="string" maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="timestampCreazioneFile"
    						type="date" maxOccurs="1" minOccurs="0">
    					</element>
    					<element name="timestampInvio" type="date"
    						minOccurs="0" maxOccurs="1">
    					</element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
    
    <complexType name="listaFileNotificheInput">
    	<sequence>
    		<element name="idRichiestaOLO" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="listaFileNotificheFault">
    	<sequence>
    		<element name="message" type="string" maxOccurs="1" minOccurs="1"></element>
    		<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>