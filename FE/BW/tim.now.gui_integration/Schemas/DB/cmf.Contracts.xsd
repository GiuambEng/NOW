<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/cmf/Contracts" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:pref="http://www.tim.com/NOW/xsd/listaContratti" xmlns:tns="http://www.tim.com/NOW/cmf/Contracts">

	<element name="Contracts">
		<complexType>
			<sequence>
				<element name="ContractsList">
					<complexType>
						<sequence>
							<element ref="tns:ContractsListInput" maxOccurs="unbounded" minOccurs="1">
							</element>
							<element ref="tns:ContractsListOutput" maxOccurs="unbounded" minOccurs="1">
							</element>
							<element ref="tns:ContractsListFault">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="ContractsDetail">
					<complexType>
						<sequence>
							<element ref="tns:ContractsDetailInput">
							</element>
							<element ref="tns:ContractsDetailOutput">
							</element>
							<element ref="tns:ContractsDetailFault">
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>




	<complexType name="ContractsListInput">
		<sequence>
			<element maxOccurs="unbounded" minOccurs="1" name="codiceOlo" type="string">
			</element>
		</sequence>
	</complexType>
	<element name="ContractsListInput" type="tns:ContractsListInput"/>
	<complexType name="ContractsListOutput">

		<sequence>
			<element name="contratto" type="tns:contratto"
				maxOccurs="unbounded" minOccurs="0" />







		</sequence>
	</complexType>
	
	<complexType name="ContractsListFault">
		<sequence>
			<element name="messageError" type="string"/>
			<element name="messageCode" type="string"/>
		</sequence>
	</complexType>
	<element name="ContractsListOutput" type="tns:ContractsListOutput"/>
	<element name="ContractsListFault" type="tns:ContractsListFault"/>

	<complexType name="ContractsDetailInput">
		<sequence>
			<element maxOccurs="1" minOccurs="1" name="codiceContratto" type="string"/>
		</sequence>
	</complexType>

	<complexType name="ContractsDetailOutput">
		<sequence>
			<element name="codiceContratto" type="string" />
			<element name="nomeContratto" type="string" />
			<element name="tipo" type="string" />
			<element name="stato" type="decimal" />
			<element name="tipoProdotti" type="string" />
			<element name="flagNpd" type="string" />
			<element name="cliente" type="string" />
			<element name="flagAbilitato" type="string" />
			<element name="flagValido" type="string" />
			<element name="dataInizioValidita" type="date" />
			<element name="dataFineValidita" type="date" />
			<element name="flagDiffidato" type="string" />
			<element name="flagStandard" type="string" />
			<element name="flagFileNotify" type="string" />
			<element name="tipoContratto" type="string" />
			<element name="flagAnfibio" type="string" />
		</sequence>
	</complexType>

	<complexType name="ContractsDetailFault">
		<sequence>
			<element name="messageError" type="string"/>
			<element name="messageCode" type="string"/>
		</sequence>
	</complexType>
	<element name="ContractsDetailInput" type="tns:ContractsDetailInput"/>
	<element name="ContractsDetailOutput" type="tns:ContractsDetailOutput"/>
	<element name="ContractsDetailFault" type="tns:ContractsDetailFault"/>


    <complexType name="contratto">
    		<sequence>
    			<element name="contratto" type="string" />
    			<element name="nome" type="string" />


    			<element name="tipoServizio" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="cliente" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="dataInizio" type="dateTime" />
    			<element name="dataFine" type="dateTime" />
    			<element name="moroso" type="string" />
    			<element name="flagDiffidato" type="string"
    				maxOccurs="1" minOccurs="1">
    			</element>

    		</sequence>
    </complexType>
</schema>
