<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders"
	xmlns:tns="http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders"
	elementFormDefault="qualified">

	<element name="xmlToExcel_OrdersListaOutput">
		<complexType>
			<sequence>
				<element name="xmlToExcel_OrdersListaOutput" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="codiceordineolo" type="string" minOccurs="0" />
							<element name="cod_olo_now" type="string" minOccurs="0" />
							<element name="descriz_causal_olo" type="string"
								minOccurs="0" />
							<element name="tipoRichiesta" type="string" minOccurs="0" />
							<element name="codiceordineti" type="string" minOccurs="0" />
							<element name="codfc_olo_agcom" type="string" minOccurs="0" />
							<element name="canalerichiesta" type="string" minOccurs="0" />
							<element name="statorichiesteolo" type="string"
								minOccurs="0" />
							<element name="statorichiestanow" type="string"
								minOccurs="0" />
							<element name="descrz_caus_now_dg" type="string"
								minOccurs="0" />
							<element name="idRichietaOlo" type="string" minOccurs="0" />
						</sequence>

					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>


	<element name="xmlToExcel_Input" type="tns:xmlToExcel_Input"></element>

	<complexType name="xmlToExcel_Input">
		<sequence>
			<element name="User_ID" type="string"></element>
			<element name="ID_Richiesta" type="string" maxOccurs="unbounded"
				minOccurs="0">
			</element>
			<element name="COD_OLO_AGCOM" type="string"></element>
			<element name="Tipo_Profilo" type="string"></element>
			<element name="ID_File" type="int"></element>
			<element name="Tipo_Lista" type="string"></element>
			<element name="xmlToExcel_RicercaAvanzata" maxOccurs="1"
				minOccurs="0">
				<complexType>

					<sequence>
						<element name="numerorighe" type="string"
							minOccurs="0" />
						<element name="indiceriga" type="string"
							minOccurs="0" />
						<element name="exportRequest" type="string"
							maxOccurs="1" minOccurs="0">
						</element>
						<element name="strutturaCondition" minOccurs="0"
							maxOccurs="unbounded">
							<complexType>
								<sequence>
									<element name="nome" type="string"
										minOccurs="0" />
									<element name="operazione"
										type="string" minOccurs="0" />
									<element name="valore" type="string"
										minOccurs="0" />
									<element name="tipo" type="string"
										minOccurs="0" />
								</sequence>
							</complexType>
						</element>
						<element name="idReport" type="string" maxOccurs="1" minOccurs="0"></element>
					</sequence>

				</complexType>
			</element>
		</sequence>
	</complexType>

</schema>