<?xml version="1.0" encoding="UTF-8"?>
<schema
	targetNamespace="http://www.tim.com/NOW/restSubprocesses/cmf.mappaOffertaULL"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/restSubprocesses/cmf.mappaOffertaULL" xmlns:pref="http://www.tibco.com/cim/services/mastercatalogrecord/wsdl/2.0">


	<import schemaLocation="../MasterCatalogRecord_Action.xsd" namespace="http://www.tibco.com/cim/services/mastercatalogrecord/wsdl/2.0"></import>
	<element name="mappaUllDatiOutput" type="tns:listaOfferte"></element>

	<element name="mappaUllDatiFault" type="tns:fault"></element>

	<complexType name="offerta">
		<sequence>
			<element name="nome" type="string"></element>
			<element name="accesso" type="string"></element>
			<element name="dataInizioValidita" type="string"></element>
			<element name="dataFineValidita" type="string"></element>
			<element name="bitRate" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="permutatore1" type="string"></element>
			<element name="permutatore2" type="string"></element>
			<element name="destinazioneUso" type="string"
				maxOccurs="unbounded" minOccurs="0">
			</element>
			<element name="assurance" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
		</sequence>
	</complexType>


	<complexType name="fault">
		<sequence>
			<element name="messaggio" type="string"></element>
			<element name="codice" type="string"></element>
		</sequence>
	</complexType>

	<element name="mappaUllDatiInput" type="pref:DataServiceType"></element>

	<complexType name="listaOfferte">
		<sequence>
			<element name="offerta" type="tns:offerta" minOccurs="0" maxOccurs="unbounded"></element>
		</sequence>
	</complexType>
</schema>