<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RecuperaTimeoutOUTSchema" xmlns:tns="http://www.example.org/RecuperaTimeoutOUTSchema" elementFormDefault="qualified">

  





    

    <element name="TimeOutType" type="tns:TimeoutType"></element>

    <complexType name="TimeoutType">
    	<sequence>
    		<element name="Esito" type="string"></element>
     <element   name="result">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="severity" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="code" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="details" type="string">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    	</sequence>
    </complexType>
</schema>