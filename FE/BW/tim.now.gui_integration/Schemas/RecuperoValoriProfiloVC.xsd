<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/cmf/RecuperoValoriProfiloVC">

    <element name="root">
    	<complexType>
    		<sequence>
    			<element name="sezioneInferiore"
    				type="tns:sezioneInferioreType" maxOccurs="unbounded"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="sezioneInferioreType">
    	<sequence>
    		<element name="key" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="componente" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="tipologiaDato" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="valore" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="progressivo" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>