                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:referente>&lt;tns:progressivo>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:progressivo>&lt;xsl:if test=&quot;$Variable/tns:qualifica&quot;>&lt;tns:qualifica>&lt;xsl:value-of select=&quot;$Variable/tns:qualifica&quot;/>&lt;/tns:qualifica>&lt;/xsl:if>&lt;xsl:if test=&quot;$Variable/tns:nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;$Variable/tns:nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$Variable/tns:cognome&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;$Variable/tns:cognome&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;xsl:if test=&quot;$Variable/tns:telefono&quot;>&lt;tns:telefono>&lt;xsl:value-of select=&quot;$Variable/tns:telefono&quot;/>&lt;/tns:telefono>&lt;/xsl:if>&lt;xsl:if test=&quot;$Variable/tns:mobile&quot;>&lt;tns:mobile>&lt;xsl:value-of select=&quot;$Variable/tns:mobile&quot;/>&lt;/tns:mobile>&lt;/xsl:if>&lt;xsl:if test=&quot;$Variable/tns:email&quot;>&lt;tns:email>&lt;xsl:value-of select=&quot;$Variable/tns:email&quot;/>&lt;/tns:email>&lt;/xsl:if>&lt;/tns:referente>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
