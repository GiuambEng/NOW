        <task name="End">
            <endingVariables>
                <variable>Start</variable>
            </endingVariables>
        </task>
        <task name="Regolatorio">
            <endingVariables>
                <variable>Regolatorio-input</variable>
            </endingVariables>
        </task>
        <task name="NGA">
            <endingVariables>
                <variable>NGA-input</variable>
            </endingVariables>
        </task>
        <task name="XDSL">
            <endingVariables>
                <variable>XDSL-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>Regolatorio</variable>
            </endingVariables>
        </task>
        <task name="Assign1">
            <endingVariables>
                <variable>NGA</variable>
            </endingVariables>
        </task>
        <task name="Assign2">
            <endingVariables>
                <variable>XDSL</variable>
            </endingVariables>
        </task>
        <task name="NP">
            <endingVariables>
