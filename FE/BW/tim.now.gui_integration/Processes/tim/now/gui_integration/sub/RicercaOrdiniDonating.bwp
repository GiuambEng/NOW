                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+646458f7-c428-4903-9daa-ef451491274a+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/OrdiniDonatingLista&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;NumInputVariable&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;OLOQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with(tib:trim($NumInputVariable), tib:trim(&amp;quot;AND&amp;quot;))&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO, (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;' OR COD_OLO_ACCORPANTE ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;')) oloric WHERE R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' AND (R.CODIFICAOLOAGCOMDONATING IN (oloric.CODFC_OLO_AGCOM) or R.COWCODEOLO IN (select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE&amp;#xD;&amp;#xA;where O.CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;') or R.COWCODEOLO2 IN (select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE&amp;#xD;&amp;#xA;where O.CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;')) AND   &amp;quot;,tib:substring-before-last($NumInputVariable, tib:trim(&amp;quot;AND&amp;quot;)),&amp;quot; FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN BDS_1_CASEDATA_ASSET A (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO, (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;' OR COD_OLO_ACCORPANTE ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;')) oloric WHERE R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' AND (R.CODIFICAOLOAGCOMDONATING IN (oloric.CODFC_OLO_AGCOM) or R.COWCODEOLO IN (select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE&amp;#xD;&amp;#xA;where O.CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;') or R.COWCODEOLO2 IN (select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE&amp;#xD;&amp;#xA;where O.CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns:codificaAgcom,&amp;quot;')) AND   &amp;quot;,$NumInputVariable,&amp;quot; FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <attributeBindings
                                bindingType="moduleProperty"
