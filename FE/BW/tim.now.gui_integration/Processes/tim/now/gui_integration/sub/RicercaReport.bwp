                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+16b93a3d-9739-49c4-93f8-d8fecdf9738b+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IdReport&quot;/>&lt;xsl:template name=&quot;UpdateReport-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;idReport>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IdReport/Record[1]/ID_STORICO_REPORT_HASH)&quot;>&lt;xsl:value-of select=&quot;$IdReport/Record[1]/ID_STORICO_REPORT_HASH&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idReport>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
