                    name="GUILISTAASSET" outputVariable="GUILISTAASSET"
                    tibex:xpdlId="6646deba-039a-4e99-a03a-3aac706e7d1e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JavaInvokeToGUILISTAASSET"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GUILISTAASSETToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
