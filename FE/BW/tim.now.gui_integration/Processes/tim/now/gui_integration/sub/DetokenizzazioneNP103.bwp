                        <bpws:target linkName="RenderXml1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Render103R&quot;/>&lt;xsl:param name=&quot;Render103N&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:outputDetokenizzazioneXml>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Render103N)>0&quot;>&lt;tns:tracciatoDetokenizzato>&lt;xsl:value-of select=&quot;$Render103N&quot;/>&lt;/tns:tracciatoDetokenizzato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:tracciatoDetokenizzato>&lt;xsl:value-of select=&quot;$Render103R&quot;/>&lt;/tns:tracciatoDetokenizzato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:outputDetokenizzazioneXml>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
