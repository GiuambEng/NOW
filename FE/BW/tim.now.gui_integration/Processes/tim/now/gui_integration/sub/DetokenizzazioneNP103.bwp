                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="fdeaf204-68a8-4ee7-b6f2-c51b8a4c0869">
                <bpws:targets>
                    <bpws:target linkName="StartToEnd"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToParseXml1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($Start/ns0:lavorazione) = ('VALIDFORMALEDONORRECIPIENT','VALIDTECNICADONATINGDONOR','COMESITODONORRECIPIENT','ESPLETAMENTODONORRECIPIENTDONATING','ESPLETAMENTOCESSAZIONE','VALIDFORMALECESSAZIONE','ESPLETAMENTODONATINGDONOR')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:lavorazione) = ('VALIDFORMALEDONORRECIPIENT','VALIDTECNICADONATINGDONOR','COMESITODONORRECIPIENT','ESPLETAMENTODONORRECIPIENTDONATING','ESPLETAMENTOCESSAZIONE','VALIDFORMALECESSAZIONE','ESPLETAMENTODONATINGDONOR')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToParseXml">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
