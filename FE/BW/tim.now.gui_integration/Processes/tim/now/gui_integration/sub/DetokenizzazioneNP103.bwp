                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenderXmlToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="ParseXml1ToAssign1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign1ToRenderXml1" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenderXml1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToParseXml" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="797f4274-9ec0-4aec-a2a2-5abea7eeadf1"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
