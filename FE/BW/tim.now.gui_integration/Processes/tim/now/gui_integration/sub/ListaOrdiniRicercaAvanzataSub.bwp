                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a1fe6418-2585-44e3-a567-154429aada73+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;ListaOrdiniAccorpante-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns3:Tipo_Lista=&amp;quot;SOSPESO&amp;quot; or $Start/tns3:Tipo_Lista=&amp;quot;ACCODATO&amp;quot;&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT MAIN_QUERY.*,        EXT.COD_CAUS_OLO,        EXT.COD_CAUS_NOW_DG,        EXT.DESCR_CAUS_OLO,        EXT.DESCR_CAUS_NOW_DG,        EXT.COD_TIPOLG_NOTF FROM (SELECT /*+ FULL(R) PARALLEL(R, 12) */  (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.STATORICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO,R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,TRN.STATO_RICH_NOW_GUI, R.CREATED,R.LASTUPDATE,R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE,   R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES, RO.RO,RO.DADRIMODULATA,RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,RO.DATAINVIOORDINEADELIVERY,RO.DAD, RO.DEC,RO.OFFERTA,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY, RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO,RO.DUVO, RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE,RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO,AC.DESCR_CAUS_INTERNO from BDS_1_CASEDATA_RICHIESTA R LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW left join BDS_1_CASEDATA_ORDINE RO ON RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY'))) LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO WHERE &amp;quot;, $RicercaAvanzata/tns2:outputcondition[1], &amp;quot;AND R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW' AND  R.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;') OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;')))  AND R.STATORICHIESTAOLO='&amp;quot;,$Start/tns3:Tipo_Lista,&amp;quot;'   ORDER BY R.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot;  ROWS ONLY) MAIN_QUERY outer apply (SELECT AC.COD_CAUS_OLO AS COD_CAUS_OLO,         AC.COD_CAUS_NOW_DG AS COD_CAUS_NOW_DG,        AC.DESCR_CAUS_OLO AS DESCR_CAUS_OLO,        AC.DESCR_CAUS_NOW_DG AS DESCR_CAUS_NOW_DG,        NOTF.COD_TIPOLG_NOTF AS COD_TIPOLG_NOTF,        ROW_NUMBER() OVER (PARTITION BY TRACC.ID_RICH_OLO ORDER BY TRACC.TIMSTP_INSMTO DESC) MAX_INSMTO               FROM RICH_ORDN_COMUNIC_TRACC TRACC               JOIN RICH_ORDN_COMUNIC_NOTF NOTF ON TRACC.ID_NOTF = NOTF.ID_NOTF               JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = TRACC.ID_ANAG_CAUS               WHERE TRACC.ID_RICH_OLO = MAIN_QUERY.IDRICHIESTAOLO &amp;#x9;&amp;#x9;&amp;#x9;  AND  TRACC.STATO_OLO_A= MAIN_QUERY.STATORICHIESTAOLO AND ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO')))) EXT   WHERE(EXT.MAX_INSMTO = 1 OR EXT.MAX_INSMTO IS NULL)&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns3:Tipo_Lista=&amp;quot;OPERASPECIALE&amp;quot;&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT MAIN_QUERY.*,        EXT.COD_CAUS_OLO,        EXT.COD_CAUS_NOW_DG,        EXT.DESCR_CAUS_OLO,        EXT.DESCR_CAUS_NOW_DG,        EXT.COD_TIPOLG_NOTF FROM (SELECT /*+ FULL(R) PARALLEL(R, 12) */ (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.STATORICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO,R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,TRN.STATO_RICH_NOW_GUI, R.CREATED,R.LASTUPDATE,R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE,   R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES, RO.RO,RO.DADRIMODULATA,RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,RO.DATAINVIOORDINEADELIVERY,RO.DAD, RO.DEC,RO.OFFERTA,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY, RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO,RO.DUVO, RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE,RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO,AC.DESCR_CAUS_INTERNO from BDS_1_CASEDATA_RICHIESTA R LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW left join BDS_1_CASEDATA_ORDINE RO ON RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY'))) LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO WHERE &amp;quot;, $RicercaAvanzata/tns2:outputcondition[1], &amp;quot;AND R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW' AND  R.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;') OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;')))  AND R.FLAGOPERESPECIALI='S'   ORDER BY R.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot;  ROWS ONLY) MAIN_QUERY outer apply (SELECT AC.COD_CAUS_OLO AS COD_CAUS_OLO,   AC.COD_CAUS_NOW_DG AS COD_CAUS_NOW_DG,  AC.DESCR_CAUS_OLO AS DESCR_CAUS_OLO,  AC.DESCR_CAUS_NOW_DG AS DESCR_CAUS_NOW_DG,  NOTF.COD_TIPOLG_NOTF AS COD_TIPOLG_NOTF,  ROW_NUMBER() OVER (PARTITION BY TRACC.ID_RICH_OLO ORDER BY TRACC.TIMSTP_INSMTO DESC) MAX_INSMTO FROM RICH_ORDN_COMUNIC_TRACC TRACC JOIN RICH_ORDN_COMUNIC_NOTF NOTF ON TRACC.ID_NOTF = NOTF.ID_NOTF JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = TRACC.ID_ANAG_CAUS WHERE TRACC.ID_RICH_OLO = MAIN_QUERY.IDRICHIESTAOLO &amp;#x9;&amp;#x9;&amp;#x9;  AND  TRACC.STATO_OLO_A= MAIN_QUERY.STATORICHIESTAOLO  AND ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO')))) EXT   WHERE(EXT.MAX_INSMTO = 1 OR EXT.MAX_INSMTO IS NULL)&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT MAIN_QUERY.*,        EXT.COD_CAUS_OLO,        EXT.COD_CAUS_NOW_DG,        EXT.DESCR_CAUS_OLO,        EXT.DESCR_CAUS_NOW_DG,        EXT.COD_TIPOLG_NOTF FROM (SELECT /*+ FULL(R) PARALLEL(R, 12) */ (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.STATORICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO,R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,TRN.STATO_RICH_NOW_GUI, R.CREATED,R.LASTUPDATE,R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE,   R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES, RO.RO,RO.DADRIMODULATA,RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,RO.DATAINVIOORDINEADELIVERY,RO.DAD, RO.DEC,RO.OFFERTA,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY, RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO,RO.DUVO, RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE,RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO,AC.DESCR_CAUS_INTERNO from BDS_1_CASEDATA_RICHIESTA R LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW left join BDS_1_CASEDATA_ORDINE RO ON RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY'))) LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO WHERE &amp;quot;, $RicercaAvanzata/tns2:outputcondition[1], &amp;quot;AND R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW' AND  R.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;') OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;')))   ORDER BY R.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot;  ROWS ONLY) MAIN_QUERY outer apply (SELECT AC.COD_CAUS_OLO AS COD_CAUS_OLO,                        AC.COD_CAUS_NOW_DG AS COD_CAUS_NOW_DG,                       AC.DESCR_CAUS_OLO AS DESCR_CAUS_OLO,                       AC.DESCR_CAUS_NOW_DG AS DESCR_CAUS_NOW_DG,                       NOTF.COD_TIPOLG_NOTF AS COD_TIPOLG_NOTF,                       ROW_NUMBER() OVER (PARTITION BY TRACC.ID_RICH_OLO ORDER BY TRACC.TIMSTP_INSMTO DESC) MAX_INSMTO               FROM RICH_ORDN_COMUNIC_TRACC TRACC               JOIN RICH_ORDN_COMUNIC_NOTF NOTF ON TRACC.ID_NOTF = NOTF.ID_NOTF               JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = TRACC.ID_ANAG_CAUS               WHERE TRACC.ID_RICH_OLO = MAIN_QUERY.IDRICHIESTAOLO &amp;#x9;&amp;#x9;&amp;#x9;  AND  TRACC.STATO_OLO_A= MAIN_QUERY.STATORICHIESTAOLO                AND ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR&amp;#xD;&amp;#xA;                    (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR&amp;#xD;&amp;#xA;                    (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR&amp;#xD;&amp;#xA;                    (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO')))) EXT   WHERE(EXT.MAX_INSMTO = 1 OR EXT.MAX_INSMTO IS NULL)&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
