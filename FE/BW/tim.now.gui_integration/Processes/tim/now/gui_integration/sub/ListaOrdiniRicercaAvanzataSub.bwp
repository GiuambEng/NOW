                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7b34f3c7-37a1-4e33-a535-16217d710d1d+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;ListaOrdiniAccorpanteFiltriCausali-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns3:Tipo_Lista=&amp;quot;SOSPESO&amp;quot; or $Start/tns3:Tipo_Lista=&amp;quot;ACCODATO&amp;quot;&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;select (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.STATORICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO,R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,TRN.STATO_RICH_NOW_GUI, R.CREATED,R.LASTUPDATE,R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE, AC.DESCR_CAUS_OLO,  R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,AC.COD_CAUS_NOW_DG,AC.COD_CAUS_OLO,AC.DESCR_CAUS_NOW_DG,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES,RO.RO,RO.DADRIMODULATA,RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,RO.DATAINVIOORDINEADELIVERY,RO.DAD, RO.DEC,RO.OFFERTA,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY, RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO,RO.DUVO, RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE,RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO,AC.DESCR_CAUS_INTERNO FROM RICH_ORDN_COMUNIC_TRACC TRACC join RICH_ORDN_COMUNIC_NOTF NOTF on TRACC.ID_NOTF = NOTF.ID_NOTF JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS=TRACC.ID_ANAG_CAUS join BDS_1_CASEDATA_RICHIESTA R ON TRACC.ID_RICH_OLO=R.IDRICHIESTAOLO LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW left join BDS_1_CASEDATA_ORDINE RO ON RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO  AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY'))) LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO WHERE  tracc.id_notf is not null and TRACC.ID_ANAG_CAUS is not null and tracc.TIMSTP_INSMTO = (select max(tracc.TIMSTP_INSMTO) FROM RICH_ORDN_COMUNIC_TRACC TRA WHERE TRACC.ID_RICH_OLO = TRA.ID_RICH_OLO AND  TRACC.STATO_OLO_A= R.STATORICHIESTAOLO) and ( (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') ) AND   R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW'  AND  R.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;') OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;')))  AND R.STATORICHIESTAOLO='&amp;quot;,$Start/tns3:Tipo_Lista,&amp;quot;' AND &amp;quot;, $RicercaAvanzata/tns2:outputcondition[1], &amp;quot;  ORDER BY R.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns3:Tipo_Lista=&amp;quot;OPERASPECIALE&amp;quot;&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;select (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.STATORICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO,R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,TRN.STATO_RICH_NOW_GUI, R.CREATED,R.LASTUPDATE,R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE, AC.DESCR_CAUS_OLO,  R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,AC.COD_CAUS_NOW_DG,AC.COD_CAUS_OLO,AC.DESCR_CAUS_NOW_DG,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES,RO.RO,RO.DADRIMODULATA,RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,RO.DATAINVIOORDINEADELIVERY,RO.DAD, RO.DEC,RO.OFFERTA,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY, RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO,RO.DUVO, RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE,RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO,AC.DESCR_CAUS_INTERNO FROM RICH_ORDN_COMUNIC_TRACC TRACC join RICH_ORDN_COMUNIC_NOTF NOTF on TRACC.ID_NOTF = NOTF.ID_NOTF JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS=TRACC.ID_ANAG_CAUS join BDS_1_CASEDATA_RICHIESTA R ON TRACC.ID_RICH_OLO=R.IDRICHIESTAOLO LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW left join BDS_1_CASEDATA_ORDINE RO ON RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO  AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY'))) LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO WHERE  tracc.id_notf is not null and TRACC.ID_ANAG_CAUS is not null and tracc.TIMSTP_INSMTO = (select max(tracc.TIMSTP_INSMTO) FROM RICH_ORDN_COMUNIC_TRACC TRA WHERE TRACC.ID_RICH_OLO = TRA.ID_RICH_OLO AND  TRACC.STATO_OLO_A= R.STATORICHIESTAOLO) and ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO'))  ) AND   R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW'  AND  R.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;') OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;')))  AND R.FLAGOPERESPECIALI='S' AND &amp;quot;, $RicercaAvanzata/tns2:outputcondition[1], &amp;quot;  ORDER BY R.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;select (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.STATORICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO,R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,TRN.STATO_RICH_NOW_GUI, R.CREATED,R.LASTUPDATE,R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE, AC.DESCR_CAUS_OLO,  R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,AC.COD_CAUS_NOW_DG,AC.COD_CAUS_OLO,AC.DESCR_CAUS_NOW_DG,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES,RO.RO,RO.DADRIMODULATA,RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,RO.DATAINVIOORDINEADELIVERY,RO.DAD, RO.DEC,RO.OFFERTA,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY, RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO,RO.DUVO, RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE,RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO,AC.DESCR_CAUS_INTERNO FROM RICH_ORDN_COMUNIC_TRACC TRACC join RICH_ORDN_COMUNIC_NOTF NOTF on TRACC.ID_NOTF = NOTF.ID_NOTF JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS=TRACC.ID_ANAG_CAUS join BDS_1_CASEDATA_RICHIESTA R ON TRACC.ID_RICH_OLO=R.IDRICHIESTAOLO LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW left join BDS_1_CASEDATA_ORDINE RO ON RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO  AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY'))) LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO WHERE  tracc.id_notf is not null and TRACC.ID_ANAG_CAUS is not null and tracc.TIMSTP_INSMTO = (select max(tracc.TIMSTP_INSMTO) FROM RICH_ORDN_COMUNIC_TRACC TRA WHERE TRACC.ID_RICH_OLO = TRA.ID_RICH_OLO AND  TRACC.STATO_OLO_A= R.STATORICHIESTAOLO) and ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO'))  ) AND   R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW'  AND  R.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;') OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns3:COD_OLO_AGCOM,&amp;quot;')))   AND &amp;quot;, $RicercaAvanzata/tns2:outputcondition[1], &amp;quot;  ORDER BY R.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
