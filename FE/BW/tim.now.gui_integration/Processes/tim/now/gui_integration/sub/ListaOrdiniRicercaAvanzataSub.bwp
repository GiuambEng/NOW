l and tracc.TIMSTP_INSMTO = (select max(tracc.TIMSTP_INSMTO) FROM RICH_ORDN_COMUNIC_TRACC TRA WHERE TRACC.ID_RICH_OLO = TRA.ID_RICH_OLO AND  TRACC.STATO_OLO_A= R.STATORICHIESTAOLO) and ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR  (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO'))) AND   R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW'  and  &amp;quot;, $RicercaAvanzata/tns1:outputcondition[1], &amp;quot;  ORDER BY R.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
