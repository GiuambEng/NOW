            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="listaOrdini_Advanced"
                    name="Copy_1_Tutti"
                    outputVariable="listaOrdini_Advanced"
                    tibex:xpdlId="768f94bd-ea1c-4b72-8ba0-428913f08d8c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListaOrdiniAccorpanteFiltriCausaliToCopy_1_Tutti"/>
                        <bpws:target linkName="ListaOrdiniNoOloFiltriCausaliToCopy_1_Tutti"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_TuttiToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/restSubprocesses/OrdiniXmlTOExcel&quot; xmlns:tns=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaOrdiniNoOloFiltriCausali&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaOrdiniAccorpanteFiltriCausali&quot;/>&#xa;    &lt;xsl:param name=&quot;ProfiliOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;listaOrdini_Advanced&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:OrdiniOutput_xmlToExcel>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($ProfiliOLO, $Start/tns:Tipo_Profilo)=false() &quot;>&#xa;                    &lt;xsl:for-each select=&quot;$ListaOrdiniNoOloFiltriCausali/unknownResultset/row[column[name='STATORICHIESTAOLO']/value=('SCARTATO','ACCODATO','SOSPESO','ESPLETAMENTOTECNICOKO','ANNULLATO')]&quot;>&#xa;                        &lt;tns2:ordiniOutput_xmlToExcel>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CODICEORDINEOLO']/value)&quot;>&#xa;                                &lt;tns2:CodiceOrdine_OAO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='CODICEORDINEOLO']/value&quot;/>&#xa;                                &lt;/tns2:CodiceOrdine_OAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='DATAINVIORICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='DATAINVIORICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='DATAINVIORICHIESTA']/value)&quot;>&#xa;                                &lt;tns2:DataCreazione>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='DATAINVIORICHIESTA']/value&quot;/>&#xa;                                &lt;/tns2:DataCreazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CODICEORDINETI']/value)&quot;>&#xa;                                &lt;tns2:OrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='CODICEORDINETI']/value&quot;/>&#xa;                                &lt;/tns2:OrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='CANALERICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CANALERICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CANALERICHIESTA']/value)&quot;>&#xa;                                &lt;tns2:Canale>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='CANALERICHIESTA']/value&quot;/>&#xa;                                &lt;/tns2:Canale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='TIPORICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='TIPORICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='TIPORICHIESTA']/value)&quot;>&#xa;                                &lt;tns2:ORDINE_OD_ALTRO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='TIPORICHIESTA']/value&quot;/>&#xa;                                &lt;/tns2:ORDINE_OD_ALTRO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='STATO_RICH_NOW_GUI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='STATO_RICH_NOW_GUI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='STATO_RICH_NOW_GUI']/value)&quot;>&#xa;                                &lt;tns2:StatoNOW>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='STATO_RICH_NOW_GUI']/value&quot;/>&#xa;                                &lt;/tns2:StatoNOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='STATO_RICH_OLO_GUI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='STATO_RICH_OLO_GUI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='STATO_RICH_OLO_GUI']/value)&quot;>&#xa;                                &lt;tns2:StatoOAO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='STATO_RICH_OLO_GUI']/value&quot;/>&#xa;                                &lt;/tns2:StatoOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CODIFICAOLOAGCOM']/value)&quot;>&#xa;                                &lt;tns2:CodificaOAO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='CODIFICAOLOAGCOM']/value&quot;/>&#xa;                                &lt;/tns2:CodificaOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='CODIFICAOLONOW']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CODIFICAOLONOW']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CODIFICAOLONOW']/value)&quot;>&#xa;                                &lt;tns2:CodiceOAO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='CODIFICAOLONOW']/value&quot;/>&#xa;                                &lt;/tns2:CodiceOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='NOTE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='NOTE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='NOTE']/value)&quot;>&#xa;                                &lt;tns2:Note>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='NOTE']/value&quot;/>&#xa;                                &lt;/tns2:Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='IDRISORSA']/value)&quot;>&#xa;                                &lt;tns2:Id_RisorsaNow>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='IDRISORSA']/value&quot;/>&#xa;                                &lt;/tns2:Id_RisorsaNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='DRO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='DRO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='DRO']/value)&quot;>&#xa;                                &lt;tns2:DRO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='DRO']/value&quot;/>&#xa;                                &lt;/tns2:DRO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='NAME1']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='NAME1']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='NAME1']/value)&quot;>&#xa;                                &lt;tns2:OAO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='NAME1']/value&quot;/>&#xa;                                &lt;/tns2:OAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='COD_CAUS_NOW_DG']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='COD_CAUS_NOW_DG']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='COD_CAUS_NOW_DG']/value)&quot;>&#xa;                                &lt;tns2:CodiceCausale_NOW>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='COD_CAUS_NOW_DG']/value&quot;/>&#xa;                                &lt;/tns2:CodiceCausale_NOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='COD_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='COD_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='COD_CAUS_OLO']/value)&quot;>&#xa;                                &lt;tns2:CodiceCausale_OAO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='COD_CAUS_OLO']/value&quot;/>&#xa;                                &lt;/tns2:CodiceCausale_OAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='DESCR_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='DESCR_CAUS_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='DESCR_CAUS_OLO']/value)&quot;>&#xa;                                &lt;tns2:Causale_OAO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='DESCR_CAUS_OLO']/value&quot;/>&#xa;                                &lt;/tns2:Causale_OAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='DESCR_CAUS_NOW_DG']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='DESCR_CAUS_NOW_DG']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='DESCR_CAUS_NOW_DG']/value)&quot;>&#xa;                                &lt;tns2:DescrizioneCausale_NOW>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='DESCR_CAUS_NOW_DG']/value&quot;/>&#xa;                                &lt;/tns2:DescrizioneCausale_NOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='IDRISORSA']/value /@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='IDRISORSA']/value /@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='IDRISORSA']/value )&quot;>&#xa;                                &lt;tns2:Id_Risorsa>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='IDRISORSA']/value &quot;/>&#xa;                                &lt;/tns2:Id_Risorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='DAC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='DAC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='DAC']/value)&quot;>&#xa;                                &lt;tns2:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='DAC']/value&quot;/>&#xa;                                &lt;/tns2:DAC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='DES']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='DES']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='DES']/value)&quot;>&#xa;                                &lt;tns2:DES>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='DES']/value&quot;/>&#xa;                                &lt;/tns2:DES>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='CODICEORDINEOLOPADRE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CODICEORDINEOLOPADRE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CODICEORDINEOLOPADRE']/value)&quot;>&#xa;                                &lt;tns2:CODICE_ORDINE_OAO_PADRE>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='CODICEORDINEOLOPADRE']/value&quot;/>&#xa;                                &lt;/tns2:CODICE_ORDINE_OAO_PADRE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='CODICEORDINETITARGET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CODICEORDINETITARGET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CODICEORDINETITARGET']/value)&quot;>&#xa;                                &lt;tns2:CODICE_ORDINE_OAO_TARGET>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='CODICEORDINETITARGET']/value&quot;/>&#xa;                                &lt;/tns2:CODICE_ORDINE_OAO_TARGET>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='CODICEPROGETTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CODICEPROGETTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CODICEPROGETTO']/value)&quot;>&#xa;                                &lt;tns2:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='CODICEPROGETTO']/value&quot;/>&#xa;                                &lt;/tns2:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='FLAGNAKED']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='FLAGNAKED']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='FLAGNAKED']/value)&quot;>&#xa;                                &lt;tns2:Naked>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='FLAGNAKED']/value&quot;/>&#xa;                                &lt;/tns2:Naked>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='LAVORAZIONE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='LAVORAZIONE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='LAVORAZIONE']/value)&quot;>&#xa;                                &lt;tns2:Lavorazione_Richiesta>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='LAVORAZIONE']/value&quot;/>&#xa;                                &lt;/tns2:Lavorazione_Richiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='TESTMODE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='TESTMODE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='TESTMODE']/value)&quot;>&#xa;                                &lt;tns2:TestMode>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='TESTMODE']/value&quot;/>&#xa;                                &lt;/tns2:TestMode>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='LASTUPDATE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='LASTUPDATE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='LASTUPDATE']/value)&quot;>&#xa;                                &lt;tns2:DataAggiornamento1>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='LASTUPDATE']/value&quot;/>&#xa;                                &lt;/tns2:DataAggiornamento1>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='CREATED']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CREATED']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CREATED']/value)&quot;>&#xa;                                &lt;tns2:DataInserimento>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='CREATED']/value&quot;/>&#xa;                                &lt;/tns2:DataInserimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='DUVO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='DUVO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='DUVO']/value)&quot;>&#xa;                                &lt;tns2:DUVO>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='DUVO']/value&quot;/>&#xa;                                &lt;/tns2:DUVO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='TIPOLG_SOTTO_LAVRZ_GUI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='TIPOLG_SOTTO_LAVRZ_GUI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='TIPOLG_SOTTO_LAVRZ_GUI']/value)&quot;>&#xa;                                &lt;tns2:Sottolavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;./column[name='TIPOLG_SOTTO_LAVRZ_GUI']/value&quot;/>&#xa;                                &lt;/tns2:Sottolavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(./column[name='TIPOLG_LAVRZ_GUI']/value/@x