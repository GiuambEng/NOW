                processName="tim.now.gui_integration.db.ClienteDB" serviceName="Cliente"/>
        </bpws:partnerLink>
    </bpws:partnerLinks>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:ActivityInput" name="Log-input" sca-bpel:internal="true"/>
        <bpws:variable name="ProfiliOLO" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Processes/ProfiliOLO" type="xsd:string"/>
        <bpws:variable element="ns3:inputservizioricercaavanzata"
            name="RicercaAvanzata-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:outputservizioricercaavanzata"
            name="RicercaAvanzata" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ActivityInputType"
            name="ListaOrdiniNoOlo-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcGeneralActivityOutput"
            name="ListaOrdiniNoOlo" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:ActivityInputType"
            name="ListaOrdiniAccorpante-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcGeneralActivityOutput"
            name="ListaOrdiniAccorpante" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:OrdiniOutput_xmlToExcel" name="listaOrdini_Advanced"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource"
            tibex:propertySource="/Connections/JDBC/JDBCConntection" type="xsd:string"/>
        <bpws:variable name="TimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/JDBC/TimeOut" type="xsd:int"/>
        <bpws:variable name="MaxRows" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/JDBC/MaxRows" type="xsd:int"/>
        <bpws:variable element="tns:xmlToExcel_Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns8:OrdiniOutput_xmlToExcel"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns11:ActivityInputType"
            name="ListaOrdiniNoOloFiltriCausali-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcGeneralActivityOutput"
            name="ListaOrdiniNoOloFiltriCausali" sca-bpel:internal="true"/>
        <bpws:variable element="ns12:ActivityInputType"
            name="ListaOrdiniAccorpanteFiltriCausali-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcGeneralActivityOutput"
            name="ListaOrdiniAccorpanteFiltriCausali" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLog_ProfolioNoOlo"
                    tibex:label="ProfolioNoOlo" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToListaOrdiniAccorpante"
                    tibex:label="OLO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToListaOrdiniNoOlo"
                    tibex:label="ProfiloNoOlo" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="TuttiToEnd_Name" tibex:label="" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListaOrdiniNoOloToTutti" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListaOrdiniAccorpanteToTutti" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToRicercaAvanzata" tibex:linkType="SUCCESS"/>
                <bpws:link name="RicercaAvanzataToEmpty" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="RicercaAvanzataToCopy_1_FiltriCausali"
                    tibex:label="FiltriCausali" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Copy_1_EmptyToCopy_1_OTHER"
                    tibex:label="OTHER" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Copy_1_EmptyToCopy_1_OLO"
                    tibex:label="OLO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link
                    name="ListaOrdiniAccorpanteFiltriCausaliToCopy_1_Tutti" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="ListaOrdiniNoOloFiltriCausaliToCopy_1_Tutti" tibex:linkType="SUCCESS"/>
                <bpws:link name="Copy_1_TuttiToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="71a86105-889a-4531-95b6-65fcfbcac938"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog_ProfolioNoOlo">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="af36b011-0ddf-4fb7-8213-409d73d53f80" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TuttiToEnd_Name"/>
                        <bpws:target linkName="Copy_1_TuttiToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/restSubprocesses/OrdiniXmlTOExcel&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;listaOrdini_Advanced&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$listaOrdini_Advanced&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log-input"
                    name="Log"
                    tibex:xpdlId="2227c8b1-7838-4357-8e08-eb6ac5471b07" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLog_ProfolioNoOlo"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToRicercaAvanzata"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Post_InputListaordininoolo:&amp;quot;,tib:render-xml($Start, true(), true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="RicercaAvanzata-input"
                    name="RicercaAvanzata"
                    outputVariable="RicercaAvanzata"
                    tibex:xpdlId="cb226603-345f-4e48-bbbb-baf2bd3c6407"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToRicercaAvanzata"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RicercaAvanzataToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="RicercaAvanzataToCopy_1_FiltriCausali">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="contains(tib:concat-sequence-format($Start/tns:xmlToExcel_RicercaAvanzata/tns:strutturaCondition/tns:nome, ',',true()), &quot;AC.COD_CAUS_NOW_DG&quot;) or contains(tib:concat-sequence-format($Start/tns:xmlToExcel_RicercaAvanzata/tns:strutturaCondition/tns:nome, ',',true()), &quot;AC.COD_CAUS_OLO&quot;) or contains(tib:concat-sequence-format($Start/tns:xmlToExcel_RicercaAvanzata/tns:strutturaCondition/tns:nome, ',',true()), &quot;AC.DESCR_CAUS_OLO&quot;) or contains(tib:concat-sequence-format($Start/tns:xmlToExcel_RicercaAvanzata/tns:strutturaCondition/tns:nome, ',',true()), &quot;AC.DESCR_CAUS_NOW_DG&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[contains(tib:concat-sequence-format($Start/tns:xmlToExcel_RicercaAvanzata/tns:strutturaCondition/tns:nome, ',',true()), "AC.COD_CAUS_NOW_DG") or contains(tib:concat-sequence-format($Start/tns:xmlToExcel_RicercaAvanzata/tns:strutturaCondition/tns:nome, ',',true()), "AC.COD_CAUS_OLO") or contains(tib:concat-sequence-format($Start/tns:xmlToExcel_RicercaAvanzata/tns:strutturaCondition/tns:nome, ',',true()), "AC.DESCR_CAUS_OLO") or contains(tib:concat-sequence-format($Start/tns:xmlToExcel_RicercaAvanzata/tns:strutturaCondition/tns:nome, ',',true()), "AC.DESCR_CAUS_NOW_DG")]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&lt;tns:inputservizioricercaavanzata>&lt;xsl:for-each select=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:strutturaCondition&quot;>&lt;tns:strutturaCondition>&lt;xsl:if test=&quot;tns1:nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;tns1:nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:operazione&quot;>&lt;tns:operazione>&lt;xsl:value-of select=&quot;tns1:operazione&quot;/>&lt;/tns:operazione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:valore&quot;>&lt;tns:valore>&lt;xsl:value-of select=&quot;tns1:valore&quot;/>&lt;/tns:valore>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:tipo&quot;>&lt;tns:tipo>&lt;xsl:value-of select=&quot;tns1:tipo&quot;/>&lt;/tns:tipo>&lt;/xsl:if>&lt;/tns:strutturaCondition>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:indiceriga&quot;>&lt;tns:indiceriga>&lt;xsl:value-of select=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:indiceriga&quot;/>&lt;/tns:indiceriga>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:numerorighe&quot;>&lt;tns:numerorighe>&lt;xsl:value-of select=&quot;$Start/tns1:xmlToExcel_RicercaAvanzata/tns1:numerorighe&quot;/>&lt;/tns:numerorighe>&lt;/xsl:if>&lt;/tns:inputservizioricercaavanzata>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.gui_integration.sub.RicercaAvanzataConditions" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ListaOrdiniNoOlo-input"
                    name="ListaOrdiniNoOlo"
                    outputVariable="ListaOrdiniNoOlo"
                    tibex:xpdlId="5e4ac630-b9b5-4792-ad76-570e2440cca2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToListaOrdiniNoOlo"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListaOrdiniNoOloToTutti"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5e4ac630-b9b5-4792-ad76-570e2440cca2+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ListaOrdiniNoOlo-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:Tipo_Lista=&amp;quot;SOSPESO&amp;quot; or $Start/tns2:Tipo_Lista=&amp;quot;ACCODATO&amp;quot;&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot; SELECT MAIN_QUERY.*,EXT.COD_CAUS_OLO,        EXT.COD_CAUS_NOW_DG,EXT.DESCR_CAUS_OLO,        EXT.DESCR_CAUS_NOW_DG, EXT.COD_TIPOLG_NOTF FROM (SELECT /*+ FULL(R) PARALLEL(R, 12) */ (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.STATORICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA,R.CODICEORDINEOLO, R.CODIFICAOLOAGCOM,R.CODICEORDINETI, R.CANALERICHIESTA ,TRN.STATO_RICH_NOW_GUI,R.CREATED,R.LASTUPDATE,R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE, R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES,RO.RO,RO.DADRIMODULATA,RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,RO.DATAINVIOORDINEADELIVERY,RO.DAD,RO.DEC,RO.OFFERTA,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY,RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO, RO.DUVO,RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE,RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO,AC.DESCR_CAUS_INTERNO  from BDS_1_CASEDATA_RICHIESTA R left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM left join BDS_1_CASEDATA_ORDINE RO ON  RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA  LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY'))) LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ WHERE R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW' and  &amp;quot;, $RicercaAvanzata/tns1:outputcondition[1],&amp;quot;  AND R.STATORICHIESTAOLO='&amp;quot;,$Start/tns2:Tipo_Lista,&amp;quot;' ORDER BY R.LASTUPDATE DESC FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY) MAIN_QUERY outer apply (SELECT AC.COD_CAUS_OLO AS COD_CAUS_OLO,                        AC.COD_CAUS_NOW_DG AS COD_CAUS_NOW_DG,AC.DESCR_CAUS_OLO AS DESCR_CAUS_OLO, AC.DESCR_CAUS_NOW_DG AS DESCR_CAUS_NOW_DG,NOTF.COD_TIPOLG_NOTF AS COD_TIPOLG_NOTF, ROW_NUMBER() OVER (PARTITION BY TRACC.ID_RICH_OLO ORDER BY TRACC.TIMSTP_INSMTO DESC) MAX_INSMTO FROM RICH_ORDN_COMUNIC_TRACC TRACC JOIN RICH_ORDN_COMUNIC_NOTF NOTF ON TRACC.ID_NOTF = NOTF.ID_NOTF               JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = TRACC.ID_ANAG_CAUS               WHERE TRACC.ID_RICH_OLO = MAIN_QUERY.IDRICHIESTAOLO AND ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR  (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO')))) EXT   WHERE(EXT.MAX_INSMTO = 1 OR EXT.MAX_INSMTO IS NULL)&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:Tipo_Lista=&amp;quot;OPERASPECIALE&amp;quot;&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT MAIN_QUERY.*, EXT.COD_CAUS_OLO, EXT.COD_CAUS_NOW_DG, EXT.DESCR_CAUS_OLO, EXT.DESCR_CAUS_NOW_DG, EXT.COD_TIPOLG_NOTF FROM (SELECT /*+ FULL(R) PARALLEL(R, 12) */    (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.STATORICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA,R.CODICEORDINEOLO, R.CODIFICAOLOAGCOM,R.CODICEORDINETI, R.CANALERICHIESTA ,TRN.STATO_RICH_NOW_GUI,R.CREATED,R.LASTUPDATE,R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE, R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES,RO.RO,RO.DADRIMODULATA,RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,RO.DATAINVIOORDINEADELIVERY,RO.DAD,RO.DEC,RO.OFFERTA,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY,RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO, RO.DUVO,RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE,RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO,AC.DESCR_CAUS_INTERNO  from BDS_1_CASEDATA_RICHIESTA R left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM left join BDS_1_CASEDATA_ORDINE RO ON  RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA  LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY'))) LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ WHERE R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW' and  &amp;quot;, $RicercaAvanzata/tns1:outputcondition[1], &amp;quot; AND R.FLAGOPERESPECIALI='S' ORDER BY R.LASTUPDATE DESC   FETCH FIRST  &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY) MAIN_QUERY outer apply (SELECT AC.COD_CAUS_OLO AS COD_CAUS_OLO,  AC.COD_CAUS_NOW_DG AS COD_CAUS_NOW_DG, AC.DESCR_CAUS_OLO AS DESCR_CAUS_OLO, AC.DESCR_CAUS_NOW_DG AS DESCR_CAUS_NOW_DG, NOTF.COD_TIPOLG_NOTF AS COD_TIPOLG_NOTF, ROW_NUMBER() OVER (PARTITION BY TRACC.ID_RICH_OLO ORDER BY TRACC.TIMSTP_INSMTO DESC) MAX_INSMTO FROM RICH_ORDN_COMUNIC_TRACC TRACC JOIN RICH_ORDN_COMUNIC_NOTF NOTF ON TRACC.ID_NOTF = NOTF.ID_NOTF JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = TRACC.ID_ANAG_CAUS WHERE TRACC.ID_RICH_OLO = MAIN_QUERY.IDRICHIESTAOLO  AND ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR&amp;#xD;&amp;#xA;      (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR&amp;#xD;&amp;#xA;      (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR&amp;#xD;&amp;#xA;      (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO')) &amp;#xD;&amp;#xA;      )) EXT   WHERE(EXT.MAX_INSMTO = 1 OR EXT.MAX_INSMTO IS NULL)&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT MAIN_QUERY.*,        EXT.COD_CAUS_OLO,        EXT.COD_CAUS_NOW_DG,        EXT.DESCR_CAUS_OLO,        EXT.DESCR_CAUS_NOW_DG,        EXT.COD_TIPOLG_NOTF FROM (SELECT /*+ FULL(R) PARALLEL(R, 12) */ (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.STATORICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA,R.CODICEORDINEOLO, R.CODIFICAOLOAGCOM,R.CODICEORDINETI, R.CANALERICHIESTA ,TRN.STATO_RICH_NOW_GUI,R.CREATED,R.LASTUPDATE,R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE, R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES,RO.RO,RO.DADRIMODULATA,RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,RO.DATAINVIOORDINEADELIVERY,RO.DAD,RO.DEC,RO.OFFERTA,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY,RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO, RO.DUVO,RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE,RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO,AC.DESCR_CAUS_INTERNO  from BDS_1_CASEDATA_RICHIESTA R left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM left join BDS_1_CASEDATA_ORDINE RO ON  RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA  LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &amp;lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY'))) LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ WHERE R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW' and  &amp;quot;, $RicercaAvanzata/tns1:outputcondition[1],&amp;quot;  ORDER BY R.LASTUPDATE DESC  FETCH FIRST  &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY) MAIN_QUERY outer apply (SELECT AC.COD_CAUS_OLO AS COD_CAUS_OLO,     AC.COD_CAUS_NOW_DG AS COD_CAUS_NOW_DG,    AC.DESCR_CAUS_OLO AS DESCR_CAUS_OLO,    AC.DESCR_CAUS_NOW_DG AS DESCR_CAUS_NOW_DG,    NOTF.COD_TIPOLG_NOTF AS COD_TIPOLG_NOTF,    ROW_NUMBER() OVER (PARTITION BY TRACC.ID_RICH_OLO ORDER BY TRACC.TIMSTP_INSMTO DESC) MAX_INSMTO               FROM RICH_ORDN_COMUNIC_TRACC TRACC               JOIN RICH_ORDN_COMUNIC_NOTF NOTF ON TRACC.ID_NOTF = NOTF.ID_NOTF               JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = TRACC.ID_ANAG_CAUS               WHERE TRACC.ID_RICH_OLO = MAIN_QUERY.IDRICHIESTAOLO AND ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO'))  )) EXT   WHERE(EXT.MAX_INSMTO = 1 OR EXT.MAX_INSMTO IS NULL)&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
