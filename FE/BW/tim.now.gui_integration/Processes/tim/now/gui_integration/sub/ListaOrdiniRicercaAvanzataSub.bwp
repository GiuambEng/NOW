                <tibex:activityExtension
                    inputVariable="ListaOrdiniAccorpante-input"
                    name="ListaOrdiniAccorpante"
                    outputVariable="ListaOrdiniAccorpante"
                    tibex:xpdlId="a1fe6418-2585-44e3-a567-154429aada73" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToListaOrdiniAccorpante"/>
