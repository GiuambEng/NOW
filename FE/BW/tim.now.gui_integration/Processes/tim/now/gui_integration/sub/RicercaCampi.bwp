nomeDB>&lt;ns1:tipoDato>&lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&lt;/ns1:tipoDato>&lt;ns1:label>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE ASSET WHITE LIST&amp;quot;&quot;/>&lt;/ns1:label>&lt;/ns1:outputRicercaCampi>&lt;ns1:outputRicercaCampi>&lt;ns1:nomeDB>&lt;xsl:value-of select=&quot;&amp;quot;A.IDRISORSAOPERATORERETE&amp;quot;&quot;/>&lt;/ns1:nomeDB>&lt;ns1:tipoDato>&lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&lt;/ns1:tipoDato>&lt;ns1:label>&lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVO RISORSA OPERATORE RETE&amp;quot;&quot;/>&lt;/ns1:label>&lt;/ns1:outputRicercaCampi>&lt;ns1:outputRicercaCampi>&lt;ns1:nomeDB>&lt;xsl:value-of select=&quot;&amp;quot;A.STATODISASSET&amp;quot;&quot;/>&lt;/ns1:nomeDB>&lt;ns1:tipoDato>&lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&lt;/ns1:tipoDato>&lt;ns1:label>&lt;xsl:value-of select=&quot;&amp;quot;STATO DISABILITAZIONE ASSET&amp;quot;&quot;/>&lt;/ns1:label>&lt;/ns1:outputRicercaCampi>&lt;ns1:outputRicercaCampi>&lt;ns1:nomeDB>&lt;xsl:value-of select=&quot;&amp;quot;ADA.NOMEATTRIBUTO='CARATTERIZZAZIONEGEO' AND ADA.VALOREATTRIBUTO&amp;quot;&quot;/>&lt;/ns1:nomeDB>&lt;ns1:tipoDato>&lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&lt;/ns1:tipoDato>&lt;ns1:label>&lt;xsl:value-of select=&quot;&amp;quot;CARATTERIZZAZIONE GEO&amp;quot;&quot;/>&lt;/ns1:label>&lt;/ns1:outputRicercaCampi>&lt;ns1:outputRicercaCampi>&lt;ns1:nomeDB>&lt;xsl:value-of select=&quot;&amp;quot;A.ONTOPERATORE&amp;quot;&quot;/>&lt;/ns1:nomeDB>&lt;ns1:tipoDato>&lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&lt;/ns1:tipoDato>&lt;ns1:label>&lt;xsl:value-of select=&quot;&amp;quot;ONT OPERATORE&amp;quot;&quot;/>&lt;/ns1:label>&lt;/ns1:outputRicercaCampi>&lt;ns1:outputRicercaCampi>&lt;ns1:nomeDB>&lt;xsl:value-of select=&quot;&amp;quot;A.MODELSERVPERVALIDAZIONI&amp;quot;&quot;/>&lt;/ns1:nomeDB>&lt;ns1:tipoDato>&lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/