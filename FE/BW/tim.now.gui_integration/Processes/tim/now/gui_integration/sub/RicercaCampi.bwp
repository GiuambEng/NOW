omeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TP.DESCR&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DESCRIZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FPO.QT_RECD_NOW&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INT&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;QUANTITA RECORD NOW&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FPO.QT_RECD_OK&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INT&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;QUANTITA RECORD OK&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FPO.QT_RECD_KO&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select