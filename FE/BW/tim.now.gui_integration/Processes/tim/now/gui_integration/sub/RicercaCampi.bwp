            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="entitàAssign"
                    name="SLATimeAssign" outputVariable="entitàAssign"
                    tibex:xpdlId="60fadc2e-284e-4e43-9535-0bc2b79575f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RicercaCampiLogInputToSLATimeAssign_SLATime"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SLATimeAssignToRicercaCampiLogOutput"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/cmf/RicercaCampi&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;entitàAssign&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SLA.SLA&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INT&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GIORNI SLA&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TIPLIN.TIPOLG_LINEA&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TIPO LINEA&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SOTLAV.DESCR&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CAUSALE ORDINE&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;O.OFFERTA&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PRODOTTO&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LAV.TIPOLG_LAVRZ&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TIPO LAVORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SLA.DATAFI_VALID&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATA FINE&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#x