                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/cmf/RicercaCampi&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Profile&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoNOWQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoOAOQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;entitàAssign&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Start/ns1:tipoProfilo = 'CRM_OPCC'&quot;>&#xa;                &lt;ns1:outputRicercaCampi>&#xa;                    &lt;ns1:outputRicercaCampi>&#xa;                        &lt;ns1:nomeDB>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;R.CODICEORDINEOLO&amp;quot;&quot;/>&#xa;                        &lt;/ns1:nomeDB>&#xa;                        &lt;ns1:tipoDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                        &lt;/ns1:tipoDato>&#xa;                        &lt;ns1:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CODICE ORDINE OAO&amp;quot;&quot;/>&#xa;                        &lt;/ns1:label>&#xa;                    &lt;/ns1:outputRicercaCampi>&#xa;                &lt;/ns1:outputRicercaCampi>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns1:outputRicercaCampi>&#xa;                    &lt;xsl:if test=&quot;not(contains($Profile,$Start/ns1:tipoProfilo))&quot;>&#xa;                        &lt;ns1:outputRicercaCampi>&#xa;                            &lt;ns1:nomeDB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AC.COD_CAUS_NOW_DG&amp;quot;&quot;/>&#xa;                            &lt;/ns1:nomeDB>&#xa;