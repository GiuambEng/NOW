                        &lt;/ns1:tipoDato>&#xa;                        &lt;ns1:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVO RISORSA OPERATORE RETE&amp;quot;&quot;/>&#xa;                        &lt;/ns1:label>&#xa;                    &lt;/ns1:outputRicercaCampi>&#xa;                    &lt;ns1:outputRicercaCampi>&#xa;                        &lt;ns1:nomeDB>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ADO.NOMEATTRIBUTO='IDRISORSAOLD' AND ADO.VALOREATTRIBUTO&amp;quot;&quot;/>&#xa;                        &lt;/ns1:nomeDB>&#xa;                        &lt;ns1:tipoDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                        &lt;/ns1:tipoDato>&#xa;                        &lt;ns1:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ID RISORSA OLD&amp;quot;&quot;/>&#xa;                        &lt;/ns1:label>&#xa;                    &lt;/ns1:outputRicercaCampi>&#xa;                    &lt;xsl:if test=&quot;$Start/ns1:tipoProfilo = ('CRM_DG', 'CRM_DGRO', 'CRM_MKTG', 'CRM_GA', 'CRM_PPS', 'CRM_DG_SUPER', 'CRM_DGRO_SUPER', 'CRM_MKTG_SUPER', 'CRM_GA_SUPER', 'CRM_PPS_SUPER')&quot;>&#xa;                        &lt;ns1:outputRicercaCampi>&#xa;                            &lt;ns1:nomeDB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;R.OPERATORERETE&amp;quot;&quot;/>&#xa;                            &lt;/ns1:nomeDB>&#xa;                            &lt;ns1:tipoDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                            &lt;/ns1:tipoDato>&#xa;                            &lt;ns1:label>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OPERATORE RETE&amp;quot;&quot;/>&#xa;                            &lt;/ns1:label>&#xa;                        &lt;/ns1:outputRicercaCampi>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:outputRicercaCampi>&#xa;                        &lt;ns1:nomeDB>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;R.IDOFFERTA IN (65,66) AND R.CODICEORDINETI&amp;quot;&quot;/>&#xa;                        &lt;/ns1:nomeDB>&#xa;                        &lt;ns1:tipoDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                        &lt;/ns1:tipoDato>&#xa;                        &lt;ns1:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CODICE ORDINE FORNITORE&amp;quot;&quot;/>&#xa;                        &lt;/ns1:label>&#xa;                    &lt;/ns1:outputRicercaCampi>&#xa;                    &lt;ns1:outputRicercaCampi>&#xa;                        &lt;ns1:nomeDB>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;R.IDOFFERTA IN (65,66) AND RO.DAC&amp;quot;&quot;/>&#xa;                        &lt;/ns1:nomeDB>&#xa;                        &lt;ns1:tipoDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATE&amp;quot;&quot;/>&#xa;                        &lt;/ns1:tipoDato>&#xa;                        &lt;ns1:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DAI&amp;quot;&quot;/>&#xa;                        &lt;/ns1:label>&#xa;                    &lt;/ns1:outputRicercaCampi>&#xa;                    &lt;ns1:outputRicercaCampi>&#xa;                        &lt;ns1:nomeDB>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;R.IDOFFERTA IN (65,66) AND RO.DACRIMODULATA&amp;quot;&quot;/>&#xa;                        &lt;/ns1:nomeDB>&#xa;                        &lt;ns1:tipoDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATE&amp;quot;&quot;/>&#xa;                        &lt;/ns1:tipoDato>&#xa;                        &lt;ns1:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DAI RIMODULATA&amp;quot;&quot;/>&#xa;                        &lt;/ns1:label>&#xa;                    &lt;/ns1:outputRicercaCampi>&#xa;                    &lt;ns1:outputRicercaCampi>&#xa;                        &lt;ns1:nomeDB>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;R.ORDINEASSETWHITELIST&amp;quot;&quot;/>&#xa;                        &lt;/ns1:nomeDB>&#xa;                        &lt;ns1:tipoDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                        &lt;/ns1:tipoDato>&#xa;                        &lt;ns1:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ORDINE ASSET WHITE LIST&amp;quot;&quot;/>&#xa;                        &lt;/ns1:label>&#xa;                    &lt;/ns1:outputRicercaCampi>&#xa;                    &lt;ns1:outputRicercaCampi>&#xa;                        &lt;ns1:nomeDB>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ADO.NOMEATTRIBUTO='CARATTERIZZAZIONEGEO' AND ADO.VALOREATTRIBUTO&amp;quot;&quot;/>&#xa;                        &lt;/ns1:nomeDB>&#xa;                        &lt;ns1:tipoDato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                        &lt;/ns1:tipoDato>&#xa;                        &lt;ns1:label>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CARATTERIZZAZIONE GEO&amp;quot;&quot;/>&#xa;                        &lt;/ns1:label>&#xa;                    &lt;/ns1:outputRicercaCampi>&#xa;                    &lt;xsl:if test=&quot;contains($Start/ns1:tipoProfilo, 'DG')&quot;>&#xa;                        &lt;ns1:outputRicercaCampi>&#xa;                            &lt;ns1:nomeDB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;R.CODICERISORSADONATING&amp;quot;&quot;/>&#xa;                            &lt;/ns1:nomeDB>&#xa;                            &lt;ns1:tipoDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                            &lt;/ns1:tipoDato>&#xa;                            &lt;ns1:label>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CODICE RISORSA DONATING 1&amp;quot;&quot;/>&#xa;                            &lt;/ns1:label>&#xa;                        &lt;/ns1:outputRicercaCampi>&#xa;                        &lt;ns1:outputRicercaCampi>&#xa;                            &lt;ns1:nomeDB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;R.CODICERISORSADONATING2&amp;quot;&quot;/>&#xa;                            &lt;/ns1:nomeDB>&#xa;                            &lt;ns1:tipoDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                            &lt;/ns1:tipoDato>&#xa;                            &lt;ns1:label>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CODICE RISORSA DONATING 2&amp;quot;&quot;/>&#xa;                            &lt;/ns1:label>&#xa;                        &lt;/ns1:outputRicercaCampi>&#xa;                        &lt;ns1:outputRicercaCampi>&#xa;                            &lt;ns1:nomeDB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;R.CODICESESSIONE&amp;quot;&quot;/>&#xa;                            &lt;/ns1:nomeDB>&#xa;                            &lt;ns1:tipoDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                            &lt;/ns1:tipoDato>&#xa;                            &lt;ns1:label>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CODICE SESSIONE 1&amp;quot;&quot;/>&#xa;                            &lt;/ns1:label>&#xa;                        &lt;/ns1:outputRicercaCampi>&#xa;                        &lt;ns1:outputRicercaCampi>&#xa;                            &lt;ns1:nomeDB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;R.CODICESESSIONE2&amp;quot;&quot;/>&#xa;                            &lt;/ns1:nomeDB>&#xa;                            &lt;ns1:tipoDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                            &lt;/ns1:tipoDato>&#xa;                            &lt;ns1:label>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CODICE SESSIONE 2&amp;quot;&quot;/>&#xa;                            &lt;/ns1:label>&#xa;                        &lt;/ns1:outputRicercaCampi>&#xa;                        &lt;ns1:outputRicercaCampi>&#xa;                            &lt;ns1:nomeDB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;R.IDRISORSA&amp;quot;&quot;/>&#xa;                            &lt;/ns1:nomeDB>&#xa;                            &lt;ns1:tipoDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                            &lt;/ns1:tipoDato>&#xa;                            &lt;ns1:label>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CODICE RISORSA RECIPIENT&amp;quot;&quot;/>&#xa;                            &lt;/ns1:label>&#xa;                        &lt;/ns1:outputRicercaCampi>&#xa;                        &lt;ns1:outputRicercaCampi>&#xa;                            &lt;ns1:nomeDB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ROD.NOME='DN' AND ROD.VALORE&amp;quot;&quot;/>&#xa;                            &lt;/ns1:nomeDB>&#xa;                            &lt;ns1:tipoDato>&#xa;                                &lt;xsl:value-of select=&quot;'STRING'&quot;/>&#xa;                            &lt;/ns1:tipoDato>&#xa;                            &lt;ns1:label>&#xa;                                &lt;xsl:value-of select=&quot;'DN'&quot;/>&#xa;                            &lt;/ns1:label>&#xa;                        &lt;/ns1:outputRicercaCampi>&#xa;                        &lt;ns1:outputRicercaCampi>&#xa;                            &lt;ns1:nomeDB>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ADO.NOMEATTRIBUTO='NUMEROTELEFONICO' AND ADO.VALOREATTRIBUTO&amp;quot;&quot;/>&#xa;                            &lt;/ns1:nomeDB>&#xa;                            &lt;ns1:tipoDato>&#xa;                                &lt;xsl:value-of select=&quot;'STRING'&quot;/>&#xa;                            &lt;/ns1:tipoDato>&#xa;                            &lt;ns1:label>&#xa;                                &lt;xsl:value-of select=&quot;'DN AGGIUNTIVE'&quot;/>&#xa;                            &lt;/ns1:label>&#xa;                        &lt;/ns1:outputRicercaCampi>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:outputRicercaCampi>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
