/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FP.TIMSTP_APERTURA_FILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATA INIZIO ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FP.TIMSTP_CHIUSURA_FILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DATA FINE ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;            &lt;ns1:outputRicercaCampi>&#xa;                &lt;ns1:nomeDB>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FP.DESCR_STATO_FILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:nomeDB>&#xa;                &lt;ns1:tipoDato>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;STRING&amp;quot;&quot;/>&#xa;                &lt;/ns1:tipoDato>&#xa;                &lt;ns1:label>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DESCRIZIONE STATO FILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:label>&#xa;            &lt;/ns1:outputRicercaCampi>&#xa;        &lt;/ns1:outputRicercaCampi>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:o