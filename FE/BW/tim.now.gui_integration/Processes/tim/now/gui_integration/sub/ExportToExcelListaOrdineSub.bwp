                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/restSubprocesses/OrdiniXmlTOExcel&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OrdiniLista&quot;/>&lt;xsl:param name=&quot;ID_RICH_OLO&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ProfiliOLO&quot;/>&lt;xsl:template name=&quot;OrdiniLista_Mapper-input&quot; match=&quot;/&quot;>&lt;tns:OrdiniOutput_xmlToExcel>&lt;xsl:for-each select=&quot;$OrdiniLista/tns:ordiniOutput_xmlToExcel&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(current()/tns:OrdineTI)>0&quot;>&lt;tns:ordiniOutput_xmlToExcel>&lt;xsl:if test=&quot;tns:CodiceOrdine_OAO&quot;>&lt;tns:CodiceOrdine_OAO>&lt;xsl:value-of select=&quot;tns:CodiceOrdine_OAO&quot;/>&lt;/tns:CodiceOrdine_OAO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DataCreazione&quot;>&lt;tns:DataCreazione>&lt;xsl:value-of select=&quot;tns:DataCreazione&quot;/>&lt;/tns:DataCreazione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:OrdineTI&quot;>&lt;tns:OrdineTI>&lt;xsl:value-of select=&quot;tns:OrdineTI&quot;/>&lt;/tns:OrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Canale&quot;>&lt;tns:Canale>&lt;xsl:value-of select=&quot;tns:Canale&quot;/>&lt;/tns:Canale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ORDINE_OD_ALTRO&quot;>&lt;tns:ORDINE_OD_ALTRO>&lt;xsl:value-of select=&quot;tns:ORDINE_OD_ALTRO&quot;/>&lt;/tns:ORDINE_OD_ALTRO>&lt;/xsl:if>&lt;xsl:if test=&quot;not(contains($ProfiliOLO,$Start/tns1:Tipo_Profilo))&quot;>&lt;xsl:if test=&quot;tns:StatoNOW&quot;>&lt;tns:StatoNOW>&lt;xsl:value-of select=&quot;tns:StatoNOW&quot;/>&lt;/tns:StatoNOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:StatoOAO&quot;>&lt;tns:StatoOAO>&lt;xsl:value-of select=&quot;tns:StatoOAO&qu