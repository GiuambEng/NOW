            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="xmlToExcel-input"
                    name="xmlToExcel" outputVariable="xmlToExcel"
                    tibex:xpdlId="017f6960-826f-4fa7-ae9f-23919bdd6c01"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenderXmlToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="xmlToExcelToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcel&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;ProfiliOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;xmlToExcel-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input_XmlToExcel>&#xa;            &lt;tns2:xmlParameter>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns2:xmlParameter>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($ProfiliOLO,$Start/tns1:Tipo_Profilo)&quot;>&#xa;                    &lt;tns2:listOfElements>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CodiceOrdine_OAO,DataCreazione,OrdineTI,Canale,ORDINE_OD_ALTRO,StatoOAO,CodificaOAO,CodiceOAO,Note,DRO,OAO,CodiceCausale_OAO,Causale_OAO,Id_Risorsa,DAC,DES,CODICE_ORDINE_OAO_PADRE,CODICE_ORDINE_OAO_TARGET,CodiceProgetto,Naked,TestMode,DataAggiornamento1,DataInserimento,Sottolavorazione,TipoLavorazione,TipoPacchetto,NoteDaSistema,Contratto,NomeFile,DataChiusuraOrdine,IdentificativoCorrelazioni,TotOrdiniPacchetto,CodiceDelivery,CodiceQualita,Monitoraggio,Offerta,DACRimodulata,DataEspletamentoCommerciale,DAD,FasciaOraria,DataInvioOrdineDelivery,IDULLCo,NumeroVerdeOAOPT,NumeroVerdeOAOCollaudo,DADRimodulata,OAODonating,OAODonor,DNOAOCollaudo,IDSLUCo,Id_RisorsaNow,Centrale,CodiceGAT,DataPrevistaSoluzione,Nome,CognomeRagioneSociale,Cf,Piva,Indirizzo,Piano,Provincia,Scala,Complesso,Cap,Localita,CodiceIstatComune,Comune,CodiceToponomastica,InAttesaDesospensioneDaOao,dataUltimoAppuntamento,oraUltimoAppuntamento,codiceRisorsaDonating1,codiceRisorsaDonating2&amp;quot;&quot;/>&#xa;                    &lt;/tns2:listOfElements>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:listOfElements>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CodiceOrdine_OAO,DataCreazione,OrdineTI,Canale,ORDINE_OD_ALTRO,StatoNOW,StatoOAO,CodificaOAO,CodiceOAO,Note,DRO,OAO,CodiceCausale_NOW,CodiceCausale_OAO,Causale_OAO,DescrizioneCausale_NOW,Id_Risorsa,DAC,DES,CODICE_ORDINE_OAO_PADRE,CODICE_ORDINE_OAO_TARGET,CodiceProgetto,Naked,TestMode,DataAggiornamento1,DataInserimento,Sottolavorazione,TipoLavorazione,TipoPacchetto,NoteDaSistema,Contratto,NomeFile,DataChiusuraOrdine,IdentificativoCorrelazioni,TotOrdiniPacchetto,CodiceDelivery,CodiceQualita,Monitoraggio,Offerta,DACRimodulata,DataEspletamentoCommerciale,DAD,FasciaOraria,DataInvioOrdineDelivery,IDULLCo,NumeroVerdeOAOPT,NumeroVerdeOAOCollaudo,DADRimodulata,OAODonating,OAODonor,DNOAOCollaudo,IDSLUCo,Id_RisorsaNow,Centrale,CodiceGAT,DataPrevistaSoluzione,Nome,CognomeRagioneSociale,Cf,Piva,Indirizzo,Piano,Provincia,Scala,Complesso,Cap,Localita,CodiceIstatComune,Comune,CodiceToponomastica,InAttesaDesospensioneDaOao,dataUltimoAppuntamento,oraUltimoAppuntamento,codiceRisorsaDonating1,codiceRisorsaDonating2&amp;quot;&quot;/>&#xa;                    &lt;/tns2:listOfElements>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:rootElementParameter>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OrdiniOutput_xmlToExcel&amp;quot;&quot;/>&#xa;            &lt;/tns2:rootElementParameter>&#xa;            &lt;tns2:NameOfFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ListaOrdini&amp;quot;&quot;/>&#xa;            &lt;/tns2:NameOfFile>&#xa;            &lt;tns2:childrootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ordiniOutput_xmlToExcel&amp;quot;&quot;/>&#xa;            &lt;/tns2:childrootElement>&#xa;        &lt;/tns2:Input_XmlToExcel>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.gui_integration.sub.XmlToExcel" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="EXPORT_LISTA_ORDINI-input"
                    name="EXPORT_LISTA_ORDINI"
                    outputVariable="EXPORT_LISTA_ORDINI"
                    tibex:xpdlId="d6f647e5-b57e-45fc-9319-bd1452957710" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="xmlToExcelToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EXPORT_LISTA_ORDINIToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d6f647e5-b57e-45fc-9319-bd1452957710+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;xmlToExcel&quot;/>&#xa;    &lt;xsl:template name=&quot;EXPORT_LISTA_ORDINI-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:ID_File&quot;/>&#xa;            &lt;/ID_FILE>&#xa;            &lt;NOME_FILE>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;ExportListaOrdini_&amp;quot;,$Start/tns1:User_ID, &amp;quot;_&amp;quot;,xsd:string($Start/tns1:ID_File),&amp;quot;.xls&amp;quot;)&quot;/>&#xa;            &lt;/NOME_FILE>&#xa;            &lt;CONTENUTO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:base64Binary($xmlToExcel)&quot;/>&#xa;            &lt;/CONTENUTO_FILE>&#xa;            &lt;ESITO>&#xa;                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;            &lt;/ESITO>&#xa;            &lt;USERID>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:User_ID&quot;/>&#xa;            &lt;/USERID>&#xa;            &lt;PROFILO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:Tipo_Profilo&quot;/>&#xa;            &lt;/PROFILO>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO EXPORT_LISTA (ID_FILE,NOME_FILE,CONTENUTO_FILE,ESITO,USERID,PROFILO) VALUES (?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILE"/>
                                    <PreparedParameters
                                    DataType="2004"
                                    DataTypeDisplayValue="BLOB" ParameterName="CONTENUTO_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="USERID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILO"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ID_RICH_OLO-input" name="ID_RICH_OLO"
                    outputVariable="ID_RICH_OLO"
                    tibex:xpdlId="7886c9db-6b41-4eb5-8c29-1b4bc4fc9669" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRecDatiToID_RICH_OLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ID_RICH_OLOToOrdiniLista_Mapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7886c9db-6b41-4eb5-8c29-1b4bc4fc9669+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/restSubprocesses/OrdiniXmlTOExcel&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OrdiniLista&quot;/>&#xa;    &lt;xsl:template name=&quot;ID_RICH_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;select RIC.NOME , RIC.VALORE ,RIC.ID_RICH_OLO &amp;#xD;&amp;#xA;FROM RICH_OLO_DETT RIC WHERE ID_RICH_OLO IN ('&amp;quot;, tib:concat-sequence-format($OrdiniLista/tns:ordiniOutput_xmlToExcel[tns:OrdineTI = &amp;quot;&amp;quot;]/tns:IDRICHIESTAOLO, &amp;quot;','&amp;quot;, true()), &amp;quot;') and RIC.NOME in ('IDENTIFICATIVOCORRELAZIONI','CODICEDELIVERY','FLAGMONITORAGGIO','FASCIAORARIA','IDULLCO','NUMEROVERDEOLOPT','NUMEROVERDEOLOCOLLAUDO','DNOLOCOLLAUDO','IDSLUCO')&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
