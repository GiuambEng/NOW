        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="SQLDirectToMapperListaOLO" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperListaOLOToLog1" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToSQLDirect" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="8d564e8c-a470-4d22-9d5b-6bce7fed0d95"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="91251e83-b8b8-4c86-88f4-45282dec6aa8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/Cliente/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/cliente&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperListaOLO&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns3:ListaOloPerNuovoOrdineOutput>&lt;tns3:profiloOlo>&lt;xsl:if test=&quot;$Start/tns3:codiceAgcom&quot;>&lt;tns3:codiceAgcom>&lt;xsl:value-of select=&quot;$Start/tns3:codiceAgcom&quot;/>&lt;/tns3:codiceAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapperListaOLO/tns3:listaOlo[tns3:codiceAgcom=$Start/tns3:codiceAgcom]/tns3:flagAccorpante&quot;>&lt;tns3:flagAccorpante>&lt;xsl:value-of select=&quot;$MapperListaOLO/tns3:listaOlo[tns3:codiceAgcom=$Start/tns3:codiceAgcom]/tns3:flagAccorpante&quot;/>&lt;/tns3:flagAccorpante>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$MapperListaOLO/tns3:listaOlo&quot;>&lt;tns3:anagraficaOlo>&lt;tns3:nome>&lt;xsl:value-of select=&quot;tns3:nome&quot;/>&lt;/tns3:nome>&lt;tns3:operatore>&lt;xsl:value-of select=&quot;tns3:operatore&quot;/>&lt;/tns3:operatore>&lt;tns3:codiceAgcom>&lt;xsl:value-of select=&quot;tns3:codiceAgcom&quot;/>&lt;/tns3:codiceAgcom>&lt;tns3:flagAccorpante>&lt;xsl:value-of select=&quot;tns3:flagAccorpante&quot;/>&lt;/tns3:flagAccorpante>&lt;/tns3:anagraficaOlo>&lt;/xsl:for-each>&lt;/tns3:profiloOlo>&lt;/tns3:ListaOloPerNuovoOrdineOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ListaOlo-input"
                    name="ListaOlo" outputVariable="ListaOlo"
                    tibex:xpdlId="d642af2e-1a49-4d43-abd4-94735ef8df63" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SQLDirectToMapperListaOLO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e97f41e7-a568-4708-b3aa-a3fd28fff7de+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d642af2e-1a49-4d43-abd4-94735ef8df63+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns1:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:codiceAgcom)>0 and $Start/tns2:codiceAgcom != &amp;quot;NO-OLO&amp;quot;&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CODFC_OLO_AGCOM, NOME, &amp;quot;,&amp;quot; OPERATORE, CODFC_OLO_RETE, FLAG_OLO_ACCORPANTE &amp;quot;, &amp;#xD;&amp;#xA;&amp;quot; FROM OLO&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot; WHERE &amp;quot;, &amp;quot;CODFC_OLO_AGCOM&amp;quot;, &amp;quot;='&amp;quot;,$Start/tns2:codiceAgcom,&amp;quot;'  OR COD_OLO_ACCORPANTE = '&amp;quot;,$Start/tns2:codiceAgcom,&amp;quot;' ORDER BY CODFC_OLO_AGCOM&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;&amp;quot;SELECT CODFC_OLO_AGCOM, NOME, OPERATORE, CODFC_OLO_RETE, FLAG_OLO_ACCORPANTE FROM OLO ORDER BY CODFC_OLO_AGCOM&amp;quot;&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperListaOLO-input"
                    name="MapperListaOLO"
                    outputVariable="MapperListaOLO"
                    tibex:xpdlId="03c956ff-ec56-4259-86c4-8466a8e2185a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SQLDirectToMapperListaOLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperListaOLOToLog1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ListaOlo&quot;/>&lt;xsl:template name=&quot;MapperListaOLO-input&quot; match=&quot;/&quot;>&lt;tns:listaOloMapper>&lt;xsl:for-each select=&quot;$ListaOlo/unknownResultset/row&quot;>&lt;tns:listaOlo>&lt;tns:nome>&lt;xsl:value-of select=&quot;column[name='NOME']/value&quot;/>&lt;/tns:nome>&lt;tns:operatore>&lt;xsl:value-of select=&quot;column[name='OPERATORE']/value&quot;/>&lt;/tns:operatore>&lt;tns:codRete>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_RETE']/value&quot;/>&lt;/tns:codRete>&lt;tns:flagAccorpante>&lt;xsl:value-of select=&quot;column[name='FLAG_OLO_ACCORPANTE']/value&quot;/>&lt;/tns:flagAccorpante>&lt;tns:codiceAgcom>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&lt;/tns:codiceAgcom>&lt;/tns:listaOlo>&lt;/xsl:for-each>&lt;/tns:listaOloMapper>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:cliente="http://www.tim.com/NOW/cmf/cliente"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="cliente:listaOloMapper" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log-In-input"
                    name="Log-In"
                    tibex:xpdlId="d3c0ba90-62d8-4fe6-9c54-e271fbb87422" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToSQLDirect"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input GetListaOlo:&amp;quot;,tib:render-xml($Start, true(), true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log-Out-input"
                    name="Log-Out"
                    tibex:xpdlId="115dbd8e-a844-4929-96e5-0b98878b8e23" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperListaOLOToLog1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperListaOLO&quot;/>&lt;xsl:template name=&quot;Log1-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output GetListaOlo:&amp;quot;,tib:render-xml($MapperListaOLO, true(), true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
