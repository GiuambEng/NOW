                                    &lt;/tns:flagAccorpante>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:for-each select=&quot;$Accumulate/tns:ListaOloPerNuovoOrdineOutput/tns:profiloOlo/tns:anagraficaOlo&quot;>&#xa;                                    &lt;tns:anagraficaOlo>&#xa;                                        &lt;tns:nome>&#xa;                                            &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                        &lt;/tns:nome>&#xa;                                        &lt;tns:operatore>&#xa;                                            &lt;xsl:value-of select=&quot;tns:operatore&quot;/>&#xa;                                        &lt;/tns:operatore>&#xa;                                        &lt;tns:codiceAgcom>&#xa;                                            &lt;xsl:value-of select=&quot;tns:codiceAgcom&quot;/>&#xa;                                        &lt;/tns:codiceAgcom>&#xa;                                        &lt;tns:flagAccorpante>&#xa;                                            &lt;xsl:value-of select=&quot;tns:flagAccorpante&quot;/>&#xa;                                        &lt;/tns:flagAccorpante>&#xa;                                    &lt;/tns:anagraficaOlo>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/tns:profiloOlo>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:ListaOloPerNuovoOrdineOutput>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
