                <bpws:link name="AssignToEmpty1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty1ToIterate1_NoDiffidati"
                    tibex:label="NoDiffidati" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Iterate1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty1ToEnd_ConDiffidati"
                    tibex:label="ConDiffidati" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
