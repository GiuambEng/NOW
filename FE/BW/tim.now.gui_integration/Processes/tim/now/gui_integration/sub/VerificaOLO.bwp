tails>&#xa;                            &lt;xsl:value-of select=&quot;'NO RECORD'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:ListaOloPerNuovoOrdineOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$OloInvoke.output/tns:codOloAccorpante != ''&quot;>&#xa;                        &lt;tns:ListaOloPerNuovoOrdineOutput>&#xa;                            &lt;tns:profiloOlo>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:codiceAgcom&quot;>&#xa;                                    &lt;tns:codiceAgcom>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:codiceAgcom&quot;/>&#xa;                                    &lt;/tns:codiceAgcom>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$OloInvoke.output/tns:flagAccorpante&quot;>&#xa;                                    &lt;tns:flagAccorpante>&#xa;                                        &lt;xsl:value-of select=&quot;$OloInvoke.output/tns:flagAccorpante&quot;/>&#xa;                                    &lt;/tns:flagAccorpante>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:for-each select=&quot;$ListaOloAccorpati.output/tns:profiloOlo/tns:anagraficaOlo&quot;>&#xa;                                    &lt;tns:anagraficaOlo>&#xa;                                        &lt;tns:nome>&#xa;                                            &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                        &lt;/tns:nome>&#xa;                                        &lt;tns:operatore>&#xa;                                            &lt;xsl:value-of select=&quot;tns:operatore&quot;/>&#xa;                                        &lt;/tns:operatore>&#xa;                                        &