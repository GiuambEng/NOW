                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/Cliente/" xmlns:tns1="http://www.tim.com/NOW/cmf/cliente" version="2.0"&gt;&lt;xsl:template name="ListaNoOlo-input" match="/"&gt;&lt;tns:getListaOloPerOrdineRequest&gt;&lt;input&gt;&lt;tns1:ListaOloPerNuovoOrdineInput&gt;&lt;tns1:codiceAgcom&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:codiceAgcom&gt;&lt;/tns1:ListaOloPerNuovoOrdineInput&gt;&lt;/input&gt;&lt;/tns:getListaOloPerOrdineRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/Cliente/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/cliente&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;ListaNoOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ListaOloPerNuovoOrdineInput>&#xa;            &lt;tns1:codiceAgcom>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/tns1:codiceAgcom>&#xa;        &lt;/tns1:ListaOloPerNuovoOrdineInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="StartToInvoke_ProfiloNoOlo"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToAssign"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/VerificaOLO&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/cliente&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ListaNoOlo&quot;/>&lt;xsl:template name=&quot;ListaOloOutput&quot; match=&quot;/&quot;>&lt;tns1:ListaOloPerNuovoOrdineOutput>&lt;tns1:profiloOlo>&lt;xsl:if test=&quot;$Start/tns:codiceAgcom&quot;>&lt;tns1:codiceAgcom>&lt;xsl:value-of select=&quot;$Start/tns:codiceAgcom&quot;/>&lt;/tns1:codiceAgcom>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$ListaNoOlo/output/tns1:ListaOloPerNuovoOrdineOutput/tns1:profiloOlo/tns1:anagraficaOlo&quot;/>&lt;/tns1:profiloOlo>&lt;/tns1:ListaOloPerNuovoOrdineOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ListaOloOutput" name="Assign"
                    outputVariable="ListaOloOutput"
                    tibex:xpdlId="22ecad11-5f61-4a57-9f39-4f034b68cb7b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/VerificaOLO&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/cliente&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaNoOlo.output&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaOloOutput&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ListaOloPerNuovoOrdineOutput>&#xa;            &lt;tns1:profiloOlo>&#xa;                &lt;xsl:if test=&quot;$Start/tns:codiceAgcom&quot;>&#xa;                    &lt;tns1:codiceAgcom>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceAgcom&quot;/>&#xa;                    &lt;/tns1:codiceAgcom>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:copy-of select=&quot;$ListaNoOlo.output/tns1:profiloOlo/tns1:anagraficaOlo&quot;/>&#xa;            &lt;/tns1:profiloOlo>&#xa;        &lt;/tns1:ListaOloPerNuovoOrdineOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
