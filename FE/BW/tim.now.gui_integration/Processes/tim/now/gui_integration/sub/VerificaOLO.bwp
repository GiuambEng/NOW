    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>Start</variable>
                <variable>AccumulateOloNoDiff</variable>
            </endingVariables>
        </task>
        <task name="OloInvoke">
            <endingVariables>
                <variable>OloInvoke-input</variable>
            </endingVariables>
        </task>
        <task name="ListaOloAccorpante">
            <endingVariables>
                <variable>ListaOloAccorpante-input</variable>
            </endingVariables>
        </task>
        <task name="ListaOloAccorpati">
            <endingVariables>
                <variable>ListaOloAccorpati-input</variable>
            </endingVariables>
        </task>
        <task name="OloNonUnivoco">
            <endingVariables>
                <variable>OloNonUnivoco-input</variable>
            </endingVariables>
        </task>
        <task name="Iterate">
            <endingVariables>
                <variable>OloNonUnivoco</variable>
                <variable>currentElement</variable>
                <variable>Mapper</variable>
            </endingVariables>
        </task>
        <task name="ListaOloNonUnivoco">
            <endingVariables>
                <variable>ListaOloNonUnivoco-input</variable>
            </endingVariables>
        </task>
        <task name="Mapper">
            <endingVariables>
                <variable>Mapper-input</variable>
                <variable>ListaOloNonUnivoco</variable>
            </endingVariables>
        </task>
        <task name="ListaOlo">
            <endingVariables>
                <variable>OloInvoke</variable>
                <variable>ListaOloAccorpante</variable>
                <variable>ListaOloAccorpati</variable>
                <variable>Accumulate</variable>
            </endingVariables>
        </task>
        <task name="ListaNoOlo">
            <endingVariables>
                <variable>ListaNoOlo-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>ListaNoOlo</variable>
            </endingVariables>
        </task>
        <task name="Iterate1">
            <endingVariables>
                <variable>Mapper1</variable>
                <variable>currentElement</variable>
            </endingVariables>
        </task>
        <task name="JDBCQueryContrattoDiff">
            <endingVariables>
                <variable>JDBCQueryContrattoDiff-input</variable>
            </endingVariables>
        </task>
        <task name="Mapper1">
            <endingVariables>
                <variable>Mapper1-input</variable>
                <variable>JDBCQueryContrattoDiff</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
