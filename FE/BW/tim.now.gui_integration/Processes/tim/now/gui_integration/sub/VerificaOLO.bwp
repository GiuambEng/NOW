                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate1" tibex:group="iterate" tibex:xpdlId="3aa20453-b355-42ac-97dc-6d4d704c1abc">
                <bpws:targets>
                    <bpws:target linkName="Empty1ToIterate1_NoDiffidati"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate1ToEnd"/>
                </bpws:sources>
                <bpws:sequence name="sequence1" tibex:group="iterate">
                    <bpws:assign name="GroupInit1"
                        tibex:group="groupInit"
                        tibex:xpdlId="6cc8f820-e468-4fa2-aaaf-929ef26d0ebd" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+2dca1f32-cda6-43bb-af9e-a562390af651" version="2.0"> <xsl:template name="AccumulateOloNoDiff" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="AccumulateOloNoDiff"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="index" name="iterate1"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$ListaOloOutput/tns:profiloOlo/tns:anagraficaOlo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListaOloOutput/tns:profiloOlo/tns:anagraficaOlo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope1">
                            <bpws:variables>
                                <bpws:variable
                                    element="tns:Iterate1_Current_Element_anagraficaOlo"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link name="JDBCQueryToMapper1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1ToJDBCQuery" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Mapper1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart1"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="7ba90a83-d132-486d-8109-61db099fef07" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBCQuery"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListaOloOutput/tns:profiloOlo/tns:anagraficaOlo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="AccumulateOloNoDiff"
                                    outputVariable="AccumulateOloNoDiff"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="2dca1f32-cda6-43bb-af9e-a562390af651" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Mapper1ToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper1</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="JDBCQueryContrattoDiff-input"
                                    name="JDBCQueryContrattoDiff"
                                    outputVariable="JDBCQueryContrattoDiff"
                                    tibex:xpdlId="aa5f7382-6e28-44d1-8449-c7431697eac3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToMapper1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+aa5f7382-6e28-44d1-8449-c7431697eac3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/cliente&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;JDBCQueryContrattoDiff-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$currentElement/tns1:codiceAgcom&quot;/>&lt;/CODFC_OLO_AGCOM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_DIFFIDATO&#xa;FROM CONTRATTO&#xa;WHERE CODFC_OLO_AGCOM = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <columnMetadata
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Mapper1-input"
                                    name="Mapper1"
                                    outputVariable="Mapper1"
                                    tibex:xpdlId="a3ef9c4e-6dbc-4713-9733-d875b3b02469" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToMapper1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/VerificaOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQueryContrattoDiff&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&lt;tns:ListaOloPerNuovoOrdineOutput>&lt;tns:profiloOlo>&lt;xsl:if test=&quot;$Start/tns1:codiceAgcom&quot;>&lt;tns:codiceAgcom>&lt;xsl:value-of select=&quot;$Start/tns1:codiceAgcom&quot;/>&lt;/tns:codiceAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not(exists($JDBCQueryContrattoDiff/Record[FLAG_DIFFIDATO='Y']))&quot;>&lt;tns:anagraficaOlo>&lt;xsl:copy-of select=&quot;$currentElement/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$currentElement/@*&quot;/>&lt;xsl:copy-of select=&quot;$currentElement/node()&quot;/>&lt;/tns:anagraficaOlo>&lt;/xsl:if>&lt;/tns:profiloOlo>&lt;/tns:ListaOloPerNuovoOrdineOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:cliente="http://www.tim.com/NOW/cmf/cliente"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="cliente:ListaOloPerNuovoOrdineOutput" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
