                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($Start/ns0:noDiffida) and $Start/ns0:noDiffida='nodiffida'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($Start/ns0:noDiffida) and $Start/ns0:noDiffida='nodiffida']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToEnd_ConDiffidati">
