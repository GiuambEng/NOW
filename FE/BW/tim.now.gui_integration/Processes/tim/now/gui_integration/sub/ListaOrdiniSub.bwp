ta>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;OFFERTA_RICH&quot;>&lt;tns2:Offerta>&lt;xsl:value-of select=&quot;OFFERTA_RICH&quot;/>&lt;/tns2:Offerta>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;DACRIMODULATA&quot;>&lt;tns2:DACRimodulata>&lt;xsl:value-of select=&quot;DACRIMODULATA&quot;/>&lt;/tns2:DACRimodulata>&lt;/xsl:if>&lt;xsl:if test=&quot;DEC&quot;>&lt;tns2:DataEspletamentoCommerciale>&lt;xsl:value-of select=&quot;DEC&quot;/>&lt;/tns2:DataEspletamentoCommerciale>&lt;/xsl:if>&lt;xsl:if test=&quot;DAD&quot;>&lt;tns2:DAD>&lt;xsl:value-of select=&quot;DAD&quot;/>&lt;/tns2:DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;FASCIA_ORARIA&quot;>&lt;tns2:FasciaOraria>&lt;xsl:value-of select=&quot;FASCIA_ORARIA&quot;/>&lt;/tns2:FasciaOraria>&lt;/xsl:if>&lt;xsl:if test=&quot;DATAINVIOORDINEADELIVERY&quot;>&lt;tns2:DataInvioOrdineDelivery>&lt;xsl:value-of select=&quot;DATAINVIOORDINEADELIVERY&quot;/>&lt;/tns2:DataInvioOrdineDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;DATAINVIOCOMMERCIALIZZ&quot;>&lt;tns2:DataInvioCommercializzazione>&lt;xsl:value-of select=&quot;DATAINVIOCOMMERCIALIZZ&quot;/>&lt;/tns2:DataInvioCommercializzazione>&lt;/xsl:if>&lt;xsl:if test=&quot;IDULLCO&quot;>&lt;tns2:IDULLCo>&lt;xsl:value-of select=&quot;IDULLCO&quot;/>&lt;/tns2:IDULLCo>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROVERDEOLOPT&quot;>&lt;tns2:NumeroVerdeOAOPT>&lt;xsl:value-of select=&quot;NUMEROVERDEOLOPT&quot;/>&lt;/tns2:NumeroVerdeOAOPT>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROVERDEOLOCOLLAUDO&quot;>&lt;tns2:NumeroVerdeOAOCollaudo>&lt;xsl:value-of select=&quot;NUMEROVERDEOLOCOLLAUDO&quot;/>&lt;/tns2:NumeroVerdeOAOCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;CLLI&quot;>&lt;tns2:Centrale>&lt;xsl:value-of select=&quot;CLLI&quot;/>&lt;/tns2:Centrale>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_GAT&quot;>&lt;tns2:CodiceGAT>&lt;xsl:value-of select=&quot;COD_GAT&quot;/>&lt;/tns2:CodiceGAT>&lt;/xsl:if>&lt;xsl:if test=&quot;DNOLOCOLLAUDO&quot;>&lt;tns2:DNOAOCollaudo>&lt;xsl:value-of select=&quot;DNOLOCOLLAUDO&quot;/>&lt;/tns2:DNOAOCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;IDSLUCO&quot;>&lt;tns2:IDSLUCo>&lt;xsl:value-of select=&quot;IDSLUCO&quot;/>&lt;/tns2:IDSLUCo>&lt;/xsl:if>&lt;xsl:if test=&quot;DADRIMODULATA&quot;>&lt;tns2:DADRimodulata>&lt;xsl:value-of select=&quot;DADRIMODULATA&quot;/>&lt;/tns2:DADRimodulata>&lt;/xsl:if>&lt;xsl:if test=&quot;RO&quot;>&lt;tns2:RO>&lt;xsl:value-of select=&quot;RO&quot;/>&lt;/tns2:RO>&lt;/xsl:if>&lt;tns2:IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns2:IDRICHIESTAOLO>&lt;xsl:if test=&quot;CODIFICAOLOAGCOMDONATING&quot;>&lt;tns2:OAODonating>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOMDONATING&quot;/>&lt;/tns2:OAODonating>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOMDONOR&quot;>&lt;tns2:OAODonor>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOMDONOR&quot;/>&lt;/tns2:OAODonor>&lt;/xsl:if>&lt;tns2:DataPrevistaSoluzione>&lt;xsl:value-of select=&quot;substring-before(string(DPS),'T')&quot;/>&lt;/tns2:DataPrevistaSoluzione>&lt;/tns2:ordiniOutput_xmlToExcel>&lt;/xsl:for-each>&lt;/tns2:OrdiniOutput_xmlToExcel>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:OrdiniOutput_xmlToExcel/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
