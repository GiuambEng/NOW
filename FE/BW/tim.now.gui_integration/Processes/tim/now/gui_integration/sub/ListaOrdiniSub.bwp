                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AccorpToAssignAccorp"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+287464cf-3079-437a-98fe-56b11447d123+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;Accorp-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODIFICAOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:COD_OLO_AGCOM &quot;/>&lt;/CODIFICAOLOAGCOM>&lt;CODFCOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:COD_OLO_AGCOM &quot;/>&lt;/CODFCOLOAGCOM>&lt;CODIFCOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:COD_OLO_AGCOM &quot;/>&lt;/CODIFCOLOAGCOM>&lt;MaxRows>&lt;xsl:value-of select=&quot;$MaxRows&quot;/>&lt;/MaxRows>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcConnection"
                                    sqlStatement="SELECT MAIN_QUERY.*,&#xa;       EXT.COD_CAUS_OLO,&#xa;       EXT.COD_CAUS_NOW_DG,&#xa;       EXT.DESCR_CAUS_OLO,&#xa;       EXT.DESCR_CAUS_NOW_DG,&#xa;       EXT.COD_TIPOLG_NOTF&#xa;FROM (SELECT /*+ FULL(R) PARALLEL(R, 12) */ &#xa;    (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.OFFERTA AS OFFERTA_RICH,R.NUMEROTELEFONICO,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO, &#xa;R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,&#xa;TRN.STATO_RICH_NOW_GUI, R.STATORICHIESTAOLO,R.CREATED,R.LASTUPDATE,&#xa;R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,&#xa;R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE, &#xa;  R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES, RO.RO,RO.DADRIMODULATA,&#xa;RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,&#xa;RO.DATAINVIOORDINEADELIVERY,RO.DAD, RO.DEC,RO.OFFERTA AS OFFERTA_ORD,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY, &#xa;RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO,RO.DUVO, RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE, &#xa;RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,RO.LASTUPDATE as RO_LASTUPDATE,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO   &#xa;from BDS_1_CASEDATA_RICHIESTA R&#xa;left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE &#xa;LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW&#xa;left join BDS_1_CASEDATA_ORDINE RO ON RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO&#xa;left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM&#xa;LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT  &#xa;LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA  &#xa;LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE&#xa;LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV&#xa;AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ&#xa;LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY')))&#xa;LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO    &#xa;WHERE R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW' AND R.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?&#xa;OR COD_OLO_ACCORPANTE = ?&#xa;OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = ?))   ORDER BY R.LASTUPDATE DESC&#xa;                FETCH FIRST ? ROWS ONLY) MAIN_QUERY&#xa;outer apply (SELECT AC.COD_CAUS_OLO AS COD_CAUS_OLO, &#xa;                      AC.COD_CAUS_NOW_DG AS COD_CAUS_NOW_DG,&#xa;                      AC.DESCR_CAUS_OLO AS DESCR_CAUS_OLO,&#xa;                      AC.DESCR_CAUS_NOW_DG AS DESCR_CAUS_NOW_DG,&#xa;                      NOTF.COD_TIPOLG_NOTF AS COD_TIPOLG_NOTF,&#xa;                      ROW_NUMBER() OVER (PARTITION BY TRACC.ID_RICH_OLO ORDER BY TRACC.TIMSTP_INSMTO DESC) MAX_INSMTO&#xa;              FROM RICH_ORDN_COMUNIC_TRACC TRACC&#xa;              JOIN RICH_ORDN_COMUNIC_NOTF NOTF ON TRACC.ID_NOTF = NOTF.ID_NOTF&#xa;              JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = TRACC.ID_ANAG_CAUS&#xa;              WHERE TRACC.ID_RICH_OLO = MAIN_QUERY.IDRICHIESTAOLO AND  TRACC.STATO_OLO_A= MAIN_QUERY.STATORICHIESTAOLO&#xa;               AND ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR&#xa;                    (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR&#xa;                    (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR&#xa;                    (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO')) &#xa;                    )) EXT&#xa;  WHERE(EXT.MAX_INSMTO = 1 OR EXT.MAX_INSMTO IS NULL)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
