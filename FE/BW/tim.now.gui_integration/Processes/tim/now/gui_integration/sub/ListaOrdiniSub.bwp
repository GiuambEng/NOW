                <bpws:sources>
                    <bpws:source linkName="Empty1ToJDBCQuery2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/tns:Tipo_Lista = 'SOSPESO' or $Start/tns:Tipo_Lista = 'ACCODATO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/tns:Tipo_Lista = 'SOSPESO' or $Start/tns:Tipo_Lista = 'ACCODATO']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToJDBCQuery3">
