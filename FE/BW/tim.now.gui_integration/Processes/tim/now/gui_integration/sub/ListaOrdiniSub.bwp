            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ListaOrdiniNoOlo_TUTTI-input"
                    name="ListaOrdiniNoOlo_TUTTI"
                    outputVariable="ListaOrdiniNoOlo_TUTTI"
                    tibex:xpdlId="9e2b7322-ec47-4170-88c9-2ab6815d2f0b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToJDBCQuery_TUTTI"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListaOrdiniNoOlo_TUTTIToCopy_1_Tutti_NoOLO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9e2b7322-ec47-4170-88c9-2ab6815d2f0b+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;ListaOrdiniNoOlo_TUTTI-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;MaxRows>&lt;xsl:value-of select=&quot;$MaxRows&quot;/>&lt;/MaxRows>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="  SELECT MAIN_QUERY.*,&#xa;       EXT.COD_CAUS_OLO,&#xa;       EXT.COD_CAUS_NOW_DG,&#xa;       EXT.DESCR_CAUS_OLO,&#xa;       EXT.DESCR_CAUS_NOW_DG,&#xa;       EXT.COD_TIPOLG_NOTF&#xa;FROM (SELECT /*+ FULL(R) PARALLEL(R, 12) */ &#xa;  (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,RO.DPS,R.OFFERTA AS OFFERTA_RICH,R.CODIFICAOLOAGCOMDONATING,R.CODIFICAOLOAGCOMDONOR,R.CODIFICAOLONOW, R.TIPORICHIESTA, R.CODICEORDINEOLO, &#xa;R.CODIFICAOLOAGCOM, R.CODICEORDINETI, R.CANALERICHIESTA ,&#xa;TRN.STATO_RICH_NOW_GUI, R.STATORICHIESTAOLO,R.CREATED,R.LASTUPDATE,&#xa;R.NOTE,R.DRO,R.CODICEORDINEOLOPADRE,R.CODICEORDINEOLOTARGET,&#xa;R.CODICEPROGETTO,R.FLAGNAKED,R.TESTMODE,R.IDRISORSA,R.DATAINVIORICHIESTA,R.IDCORRELAZIONE, &#xa;R.IDRICHIESTAOLO ,R.LAVORAZIONE,O.NOME as Name1,R.OPERATORE,FP.NOME_FILE,FO.FASCIA_ORARIA,RO.DAC,RO.DES, RO.RO,RO.DADRIMODULATA,&#xa;RO.IDSLUCO,RO.DNOLOCOLLAUDO,CLC_ID.CLLI,RO.NUMEROVERDEOLOCOLLAUDO,RO.NUMEROVERDEOLOPT,RO.IDULLCO,RO.DATAINVIOCOMMERCIALIZZ,&#xa;RO.DATAINVIOORDINEADELIVERY,RO.DAD, RO.DEC,RO.OFFERTA AS OFFERTA_ORD,RO.CODICETTM,RO.TOTALEORDINIPACCHETTO,RO.CODICEDELIVERY, &#xa;RO.DATACHIUSURAORDINE,RO.TOTALEORDRILEVPACCHETTO,RO.FLAGMONITORAGGIO,RO.DUVO, RO.MODALITAFATTURAZIONE, RO.DPP,RO.TIPOPACCHETTO, RO.FLAGLAVORAZIONEMANUALE, &#xa;RO.NOME as Name2,RO.NOTEDASISTEMA,RO.TIPOLOGIAQUALITA,RO.DACRIMODULATA,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,CLC_ID.COD_GAT,CNT.NOME_CONTRATTO   &#xa;from BDS_1_CASEDATA_RICHIESTA R&#xa;left join ANAG_CAUS AC ON AC.ID_ANAG_CAUS=R.IDANAGRAFICACAUSALE &#xa;LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW&#xa;left join BDS_1_CASEDATA_ORDINE RO ON RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO&#xa;left join OLO O ON O.CODFC_OLO_AGCOM=R.CODIFICAOLOAGCOM&#xa;LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE=R.IDFILEINPUT  &#xa;LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA=R.IDFASCIAORARIA  &#xa;LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = RO.TIPOLOGIALAVORAZIONE&#xa;LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=RO.TIPOLOGIASOTTOLAV&#xa;AND TL.IDTPLG_LAVRZ = TSL.IDTPLG_LAVRZ&#xa;LEFT JOIN CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &lt; TO_DATE(CLC_ID.DATAFI_VALID,'DD-MM-YY')))&#xa;LEFT JOIN CONTRATTO  CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO &#xa;WHERE R.TIPORICHIESTA='ORDINE' AND R.AMBITO='NOW'  ORDER BY R.LASTUPDATE DESC&#xa;                FETCH FIRST ? ROWS ONLY) MAIN_QUERY&#xa;outer apply (SELECT AC.COD_CAUS_OLO AS COD_CAUS_OLO, &#xa;                      AC.COD_CAUS_NOW_DG AS COD_CAUS_NOW_DG,&#xa;                      AC.DESCR_CAUS_OLO AS DESCR_CAUS_OLO,&#xa;                      AC.DESCR_CAUS_NOW_DG AS DESCR_CAUS_NOW_DG,&#xa;                      NOTF.COD_TIPOLG_NOTF AS COD_TIPOLG_NOTF,&#xa;                      ROW_NUMBER() OVER (PARTITION BY TRACC.ID_RICH_OLO ORDER BY TRACC.TIMSTP_INSMTO DESC) MAX_INSMTO&#xa;              FROM RICH_ORDN_COMUNIC_TRACC TRACC&#xa;              JOIN RICH_ORDN_COMUNIC_NOTF NOTF ON TRACC.ID_NOTF = NOTF.ID_NOTF&#xa;              JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = TRACC.ID_ANAG_CAUS&#xa;              WHERE TRACC.ID_RICH_OLO = MAIN_QUERY.IDRICHIESTAOLO AND  TRACC.STATO_OLO_A= MAIN_QUERY.STATORICHIESTAOLO&#xa;               AND ((NOTF.COD_TIPOLG_NOTF IN ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS') AND TRACC.STATO_OLO_A = 'SCARTATO') OR&#xa;                    (NOTF.COD_TIPOLG_NOTF IN ('CO', 'KA') AND TRACC.STATO_OLO_A = 'ACCODATO') OR&#xa;                    (NOTF.COD_TIPOLG_NOTF IN ('SC', 'SP') AND TRACC.STATO_OLO_A = 'SOSPESO') OR&#xa;                    (NOTF.COD_TIPOLG_NOTF IN ('KD', 'KO') AND TRACC.STATO_OLO_A IN ('ESPLETAMENTOTECNICOKO','ANNULLATO')) &#xa;                    )) EXT&#xa;  WHERE(EXT.MAX_INSMTO = 1 OR EXT.MAX_INSMTO IS NULL)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="MaxRows"/>
                                    <columnMetadata
                                    columnName="STATO_RICH_OLO_GUI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="DPS"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="OFFERTA_RICH"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOMDONATING"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOMDONOR"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLONOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPORICHIESTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINETI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CANALERICHIESTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_RICH_NOW_GUI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="LASTUPDATE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="NOTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnName="DRO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLOPADRE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLOTARGET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEPROGETTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAGNAKED"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TESTMODE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDCORRELAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NAME1"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FASCIA_ORARIA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="DAC"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata columnName="DES"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata columnName="RO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DADRIMODULATA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDSLUCO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DNOLOCOLLAUDO"
