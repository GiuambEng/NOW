                <tibex:activityExtension inputVariable="Accorp-input"
                    name="Accorp" outputVariable="Accorp"
                    tibex:xpdlId="287464cf-3079-437a-98fe-56b11447d123" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
