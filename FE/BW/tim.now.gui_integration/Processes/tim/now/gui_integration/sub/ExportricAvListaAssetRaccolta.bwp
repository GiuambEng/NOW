                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+e13d61bb-9ca0-4e83-a654-e7be4f67aa85+JavaInvokeActivityInput&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:template name=&quot;JavaInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:JavaInvokeActivityInput>&#xa;            &lt;MethodParameters>&#xa;                &lt;OldString>&#xa;                    &lt;xsl:value-of select=&quot;$RicercaAvanzata/tns1:outputcondition[1]&quot;/>&#xa;                &lt;/OldString>&#xa;                &lt;OldChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;upper(ADA.&amp;quot;&quot;/>&#xa;                &lt;/OldChar>&#xa;                &lt;OldChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ADA.VALOREATTRIBUTO)&amp;quot;&quot;/>&#xa;                &lt;/OldChar>&#xa;                &lt;NewChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ADA.&amp;quot;&quot;/>&#xa;                &lt;/NewChar>&#xa;                &lt;NewChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ADA.VALOREATTRIBUTO&amp;quot;&quot;/>&#xa;                &lt;/NewChar>&#xa;            &lt;/MethodParameters>&#xa;        &lt;/tns2:JavaInvokeActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
