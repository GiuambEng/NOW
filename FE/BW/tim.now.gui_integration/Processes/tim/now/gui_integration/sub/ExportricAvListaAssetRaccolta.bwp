DA.IDASSET WHERE IDOFFERTA IN (61,62,63,64) AND AR.CODIFICAOLOAGCOM IN (SELECT /*+ QB_NAME(QUERY_OLO)*/ TO_NCHAR(CODFC_OLO_AGCOM) FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns:COD_OLO_AGCOM,&amp;quot;'))) AND &amp;quot;,$JavaInvoke/MethodReturnValue,&amp;quot; ORDER BY AR.LASTUPDATE DESC FETCH FIRST 2000 ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/tns:Tipo_Profilo, 'OLO')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT /*+ FULL(AR) PARALLEL(AR, 12) */ DISTINCT AR.CODICEORDINEOLO, AR.CODICEORDINETI, AR.CODIFICAOLOAGCOM, AR.IDASSET, AR.IDRISORSA, AR.STATOASSET, AR.OFFERTA, AR.CREATED, AR.LASTUPDATE,AR.DES,AR.DEC FROM BDS_1_CASEDATA_ASSET AR INNER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON AR.IDASSET = ADA.IDASSET WHERE IDOFFERTA IN (61,62,63,64) AND AR.CODIFICAOLOAGCOM IN (SELECT /*+ QB_NAME(QUERY_OLO)*/ TO_NCHAR(CODFC_OLO_AGCOM) FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns:COD_OLO_AGCOM,&amp;quot;'))) ORDER BY AR.LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome)>0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT /*+ FULL(AR) PARALLEL(AR, 12) */ DISTINCT AR.IDOFFERTA, AR.CODICEORDINEOLO, AR.CODICEORDINETI, AR.CODIFICAOLOAGCOM, AR.IDASSET, AR.IDRISORSA, AR.STATOASSET, AR.OFFERTA, AR.CREATED, AR.LASTUPDATE,AR.DES,AR.DEC,(SELECT DISTINCT VALOREATTRIBUTO FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA WHERE NOMEATTRIBUTO = 'CODICETDKIT' AND ADA.IDASSET = AR.IDASSET) AS TDKIT,(SELECT DISTINCT VALOREATTRIBUTO FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA WHERE NOMEATTRIBUTO = 'IDENTIFICATIVOVLANOLO' AND ADA.IDASSET = AR.IDASSET) AS IDENTIFICATIVOVLANOLO,(SELECT DISTINCT VALOREATTRIBUTO FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA WHERE NOMEATTRIBUTO = 'BMCLIGHT' AND ADA.IDASSET = AR.IDASSET) AS BMCLIGHT,(SELECT DISTINCT VALOREATTRIBUTO FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA WHERE NOMEATTRIBUTO = 'CODICECLLI' AND ADA.IDASSET = AR.IDASSET) AS CODICECLLI,(SELECT DISTINCT VALOREATTRIBUTO FROM BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA WHERE NOMEATTRIBUTO = 'NOMEMACROAREA' AND ADA.IDASSET = AR.IDASSET) AS NOMEMACROAREA FROM BDS_1_CASEDATA_ASSET AR INNER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON AR.IDASSET = ADA.IDASSET WHERE IDOFFERTA IN (61,62,63,64) AND &amp;quot;,$JavaInvoke/MethodReturnValue,&amp;quot; ORDER BY AR.LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT /*+ FULL(AR) PARALLEL(AR, 12) */ DISTINCT AR.CODICEORDINEOLO, AR.CODICEORDINETI, AR.CODIFICAOLOAGCOM, AR.IDASSET, AR.IDRISORSA, AR.STATOASSET, AR.OFFERTA, AR.CREATED, AR.LASTUPDATE,AR.DES,AR.DEC FROM BDS_1_CASEDATA_ASSET AR INNER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON AR.IDASSET = ADA.IDASSET WHERE IDOFFERTA IN (61,62,63,64) AND &amp;quot;,$JavaInvoke/MethodReturnValue,&amp;quot; ORDER BY AR.LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:ActivityInputType>&#xa;    &lt;/xsl:t