            <bpws:empty name="Empty1" tibex:xpdlId="d8e982fc-3da5-43f5-a122-6efa1dd05fdf">
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToSQLDirect">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToSQLDirect1_Export">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/tns:RicercaAvanzata/tns:exportRequest = 'Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/tns:RicercaAvanzata/tns:exportRequest = 'Y']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RicAvNoAttr-input" name="RicAvNoAttr"
                    outputVariable="RicAvNoAttr"
                    tibex:xpdlId="e78b7d44-27cf-4371-b045-e591cd00ebae" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RicAvNoAttrToAssign5"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e78b7d44-27cf-4371-b045-e591cd00ebae+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns=&quot;http://www.example.org/AssetRaccolta&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;RicAvNoAttr-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($Start/tns:Tipo_Profilo, 'OLO')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT AR.LASTUPDATE,AR.CODICEORDINEOLO, AR.CODICEORDINETI, AR.CODIFICAOLOAGCOM, AR.IDASSET, AR.IDRISORSA, AR.STATOASSET, AR.OFFERTA FROM BDS_1_CASEDATA_ASSET AR WHERE AR.IDOFFERTA IN (61,62,63,64) AND AR.CODIFICAOLOAGCOM IN (SELECT /*+ QB_NAME(QUERY_OLO)*/ TO_NCHAR(CODFC_OLO_AGCOM) FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns:COD_OLO_AGCOM,&amp;quot;'))) AND &amp;quot;,$RicercaAvanzata/tns1:outputcondition[1],&amp;quot; ORDER BY AR.LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT AR.LASTUPDATE,AR.CODICEORDINEOLO, AR.CODICEORDINETI, AR.CODIFICAOLOAGCOM, AR.IDASSET, AR.IDRISORSA, AR.STATOASSET, AR.OFFERTA FROM BDS_1_CASEDATA_ASSET AR WHERE IDOFFERTA IN (61,62,63,64) AND &amp;quot;,$RicercaAvanzata/tns1:outputcondition[1],&amp;quot; ORDER BY AR.LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="2000"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ExportNoAttr-input"
                    name="ExportNoAttr" outputVariable="ExportNoAttr"
                    tibex:xpdlId="85af3607-8a33-445e-a83d-c783c49d8244" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToSQLDirect1_Export"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ExportNoAttrToAssign2">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+85af3607-8a33-445e-a83d-c783c49d8244+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns=&quot;http://www.example.org/AssetRaccolta&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;ExportNoAttr-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($Start/tns:Tipo_Profilo, 'OLO') and count($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome)>0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT AR.IDOFFERTA,AR.LASTUPDATE,AR.CODICEORDINEOLO,AR.CODICEORDINETI,AR.CODIFICAOLOAGCOM,AR.IDASSET,AR.IDRISORSA,AR.STATOASSET,AR.OFFERTA,max(decode(NOMEATTRIBUTO, 'CODICETDKIT', VALOREATTRIBUTO)) AS TDKIT,max(decode(NOMEATTRIBUTO, 'IDENTIFICATIVOVLANOLO', VALOREATTRIBUTO)) AS IDENTIFICATIVOVLANOLO,&amp;#x9;&amp;#x9;max(decode(NOMEATTRIBUTO, 'BMCLIGHT', VALOREATTRIBUTO)) AS BMCLIGHT,max(decode(NOMEATTRIBUTO, 'CODICECLLI', VALOREATTRIBUTO)) AS CODICECLLI,max(decode(NOMEATTRIBUTO, 'NOMEMACROAREA', VALOREATTRIBUTO)) AS NOMEMACROAREA FROM BDS_1_CASEDATA_ASSET AR LEFT JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON ADA.IDASSET = AR.IDASSET AND ADA.NOMEATTRIBUTO IN ('CODICETDKIT', 'IDENTIFICATIVOVLANOLO', 'BMCLIGHT', 'CODICECLLI', 'NOMEMACROAREA') WHERE IDOFFERTA IN (61,62,63,64) AND AR.CODIFICAOLOAGCOM IN (SELECT /*+ QB_NAME(QUERY_OLO)*/ TO_NCHAR(CODFC_OLO_AGCOM) FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns:COD_OLO_AGCOM,&amp;quot;'))) AND &amp;quot;,$RicercaAvanzata/tns1:outputcondition[1],&amp;quot; GROUP BY AR.IDOFFERTA,AR.LASTUPDATE,AR.CODICEORDINEOLO,AR.CODICEORDINETI,AR.CODIFICAOLOAGCOM,AR.IDASSET,AR.IDRISORSA,AR.STATOASSET,AR.OFFERTA ORDER BY AR.LASTUPDATE DESC FETCH FIRST 2000 ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Start/tns:Tipo_Profilo, 'OLO')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT AR.IDOFFERTA,AR.LASTUPDATE,AR.CODICEORDINEOLO,AR.CODICEORDINETI,AR.CODIFICAOLOAGCOM,AR.IDASSET,AR.IDRISORSA,AR.STATOASSET,AR.OFFERTA,max(decode(NOMEATTRIBUTO, 'CODICETDKIT', VALOREATTRIBUTO)) AS TDKIT,max(decode(NOMEATTRIBUTO, 'IDENTIFICATIVOVLANOLO', VALOREATTRIBUTO)) AS IDENTIFICATIVOVLANOLO,&amp;#x9;&amp;#x9;max(decode(NOMEATTRIBUTO, 'BMCLIGHT', VALOREATTRIBUTO)) AS BMCLIGHT,max(decode(NOMEATTRIBUTO, 'CODICECLLI', VALOREATTRIBUTO)) AS CODICECLLI,max(decode(NOMEATTRIBUTO, 'NOMEMACROAREA', VALOREATTRIBUTO)) AS NOMEMACROAREA FROM BDS_1_CASEDATA_ASSET AR LEFT JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON ADA.IDASSET = AR.IDASSET AND ADA.NOMEATTRIBUTO IN ('CODICETDKIT', 'IDENTIFICATIVOVLANOLO', 'BMCLIGHT', 'CODICECLLI', 'NOMEMACROAREA') WHERE IDOFFERTA IN (61,62,63,64) AND AR.CODIFICAOLOAGCOM IN (SELECT /*+ QB_NAME(QUERY_OLO)*/ TO_NCHAR(CODFC_OLO_AGCOM) FROM OLO WHERE (COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;, $Start/tns:COD_OLO_AGCOM,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns:COD_OLO_AGCOM,&amp;quot;'))) GROUP BY AR.IDOFFERTA,AR.LASTUPDATE,AR.CODICEORDINEOLO,AR.CODICEORDINETI,AR.CODIFICAOLOAGCOM,AR.IDASSET,AR.IDRISORSA,AR.STATOASSET,AR.OFFERTA ORDER BY AR.LASTUPDATE DESC FETCH FIRST 2000 ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome)>0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT AR.IDOFFERTA,AR.LASTUPDATE,AR.CODICEORDINEOLO,AR.CODICEORDINETI,AR.CODIFICAOLOAGCOM,AR.IDASSET,AR.IDRISORSA,AR.STATOASSET,AR.OFFERTA,max(decode(NOMEATTRIBUTO, 'CODICETDKIT', VALOREATTRIBUTO)) AS TDKIT,max(decode(NOMEATTRIBUTO, 'IDENTIFICATIVOVLANOLO', VALOREATTRIBUTO)) AS IDENTIFICATIVOVLANOLO,&amp;#x9;&amp;#x9;max(decode(NOMEATTRIBUTO, 'BMCLIGHT', VALOREATTRIBUTO)) AS BMCLIGHT,max(decode(NOMEATTRIBUTO, 'CODICECLLI', VALOREATTRIBUTO)) AS CODICECLLI,max(decode(NOMEATTRIBUTO, 'NOMEMACROAREA', VALOREATTRIBUTO)) AS NOMEMACROAREA FROM BDS_1_CASEDATA_ASSET AR LEFT JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON ADA.IDASSET = AR.IDASSET AND ADA.NOMEATTRIBUTO IN ('CODICETDKIT', 'IDENTIFICATIVOVLANOLO', 'BMCLIGHT', 'CODICECLLI', 'NOMEMACROAREA') WHERE IDOFFERTA IN (61,62,63,64) AND &amp;quot;,$RicercaAvanzata/tns1:outputcondition[1],&amp;quot; GROUP BY AR.IDOFFERTA,AR.LASTUPDATE,AR.CODICEORDINEOLO,AR.CODICEORDINETI,AR.CODIFICAOLOAGCOM,AR.IDASSET,AR.IDRISORSA,AR.STATOASSET,AR.OFFERTA ORDER BY AR.LASTUPDATE DESC FETCH FIRST 2000 ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT AR.IDOFFERTA,AR.LASTUPDATE,AR.CODICEORDINEOLO,AR.CODICEORDINETI,AR.CODIFICAOLOAGCOM,AR.IDASSET,AR.IDRISORSA,AR.STATOASSET,AR.OFFERTA,max(decode(NOMEATTRIBUTO, 'CODICETDKIT', VALOREATTRIBUTO)) AS TDKIT,max(decode(NOMEATTRIBUTO, 'IDENTIFICATIVOVLANOLO', VALOREATTRIBUTO)) AS IDENTIFICATIVOVLANOLO,&amp;#x9;&amp;#x9;max(decode(NOMEATTRIBUTO, 'BMCLIGHT', VALOREATTRIBUTO)) AS BMCLIGHT,max(decode(NOMEATTRIBUTO, 'CODICECLLI', VALOREATTRIBUTO)) AS CODICECLLI,max(decode(NOMEATTRIBUTO, 'NOMEMACROAREA', VALOREATTRIBUTO)) AS NOMEMACROAREA FROM BDS_1_CASEDATA_ASSET AR LEFT JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON ADA.IDASSET = AR.IDASSET AND ADA.NOMEATTRIBUTO IN ('CODICETDKIT', 'IDENTIFICATIVOVLANOLO', 'BMCLIGHT', 'CODICECLLI', 'NOMEMACROAREA') WHERE IDOFFERTA IN (61,62,63,64)) GROUP BY AR.IDOFFERTA,AR.LASTUPDATE,AR.CODICEORDINEOLO,AR.CODICEORDINETI,AR.CODIFICAOLOAGCOM,AR.IDASSET,AR.IDRISORSA,AR.STATOASSET,AR.OFFERTA ORDER BY AR.LASTUPDATE DESC FETCH FIRST 2000 ROWS ONLY&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
