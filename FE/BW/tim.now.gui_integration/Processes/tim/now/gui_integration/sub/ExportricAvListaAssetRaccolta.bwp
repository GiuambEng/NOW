            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="84edd459-450c-4eaa-90ff-980ee63010f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd"/>
                        <bpws:target linkName="MapperToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AssetRaccolta&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;not(string-length($Start/tns:RicercaAvanzata/tns:exportRequest)>0 and $Start/tns:RicercaAvanzata/tns:exportRequest = 'Y')&quot;>&lt;tns:outputListaAssetRaccolta>&lt;xsl:copy-of select=&quot;$Mapper/tns:ListaAssetRaccoltaOutput&quot;/>&lt;xsl:copy-of select=&quot;$Mapper/tns:result&quot;/>&lt;/tns:outputListaAssetRaccolta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputListaAssetRaccolta>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;tns:idExportFile>&lt;xsl:value-of select=&quot;$Start/tns:ID_File&quot;/>&lt;/tns:idExportFile>&lt;/tns:outputListaAssetRaccolta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="RicercaAvanzata-input"
                    name="RicercaAvanzata"
                    outputVariable="RicercaAvanzata"
                    tibex:xpdlId="25883e2a-9d51-4566-92a2-7b87d49b5c78"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess_RicAv"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RicercaAvanzataToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AssetRaccolta&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&lt;tns1:inputservizioricercaavanzata>&lt;xsl:for-each select=&quot;$Start/tns:RicercaAvanzata/tns:strutturaCondition&quot;>&lt;tns1:strutturaCondition>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;tns1:nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/tns1:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:operazione&quot;>&lt;tns1:operazione>&lt;xsl:value-of select=&quot;tns:operazione&quot;/>&lt;/tns1:operazione>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;tns:nome = 'AR.OFFERTA'&quot;>&lt;tns1:valore>&lt;xsl:value-of select=&quot;upper-case(tns:valore)&quot;/>&lt;/tns1:valore>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns:valore&quot;>&lt;tns1:valore>&lt;xsl:value-of select=&quot;tns:valore&quot;/>&lt;/tns1:valore>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns:tipo&quot;>&lt;tns1:tipo>&lt;xsl:value-of select=&quot;tns:tipo&quot;/>&lt;/tns1:tipo>&lt;/xsl:if>&lt;/tns1:strutturaCondition>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$Start/tns:RicercaAvanzata/tns:indiceriga&quot;>&lt;tns1:indiceriga>&lt;xsl:value-of select=&quot;$Start/tns:RicercaAvanzata/tns:indiceriga&quot;/>&lt;/tns1:indiceriga>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RicercaAvanzata/tns:numerorighe&quot;>&lt;tns1:numerorighe>&lt;xsl:value-of select=&quot;$Start/tns:RicercaAvanzata/tns:numerorighe&quot;/>&lt;/tns1:numerorighe>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RicercaAvanzata/tns:exportRequest&quot;>&lt;tns1:exportRequest>&lt;xsl:value-of select=&quot;$Start/tns:RicercaAvanzata/tns:exportRequest&quot;/>&lt;/tns1:exportRequest>&lt;/xsl:if>&lt;/tns1:inputservizioricercaavanzata>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.gui_integration.sub.RicercaAvanzataConditions" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="d43c2c9b-fbe8-4a8b-9c3d-391ecfb0fcef">
