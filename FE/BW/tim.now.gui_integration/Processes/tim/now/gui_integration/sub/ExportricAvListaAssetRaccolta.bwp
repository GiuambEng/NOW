                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AssetRaccolta&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ExportAttr&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ExportAttr/unknownResultset/row/column[name = 'IDASSET']/value) and string-length(string($ExportAttr/unknownResultset/row/column[name = 'IDASSET']/value))>0&quot;>&lt;tns:ricercaAvanzataExportOutput>&lt;xsl:for-each select=&quot;$ExportAttr/unknownResultset/row&quot;>&lt;xsl:variable name=&quot;currIdAsset2&quot; select=&quot;string(column[name='IDASSET']/value)&quot;/>&lt;tns:OutputDatiQuery>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLO']/value)&quot;>&lt;tns:codiceOrdineOlo>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLO']/value&quot;/>&lt;/tns:codiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINETI']/value)&quot;>&lt;tns:codiceOrdineTi>&lt;xsl:value-of select=&quot;column[name='CODICEORDINETI']/value&quot;/>&lt;/tns:codiceOrdineTi>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDRISORSA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDRISORSA']/value)&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;column[name='IDRISORSA']/value&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATOASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATOASSET']/value)&quot;>&lt;tns:statoAsset>&lt;xsl:value-of select=&quot;column[name='STATOASSET']/value&quot;/>&lt;/tns:statoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']/value)&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;column[name='OFFERTA']/value&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CREATED']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CREATED']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CREATED']/value)&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;column[name='CREATED']/value&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='LASTUPDATE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='LASTUPDATE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='LASTUPDATE']/value)&quot;>&lt;tns:dataAggiornamento>&lt;xsl:value-of select=&quot;column[name='LASTUPDATE']/value&quot;/>&lt;/tns:dataAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DES']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DES']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DES']/value)&quot;>&lt;tns:des>&lt;xsl:value-of select=&quot;column[name='DES']/value&quot;/>&lt;/tns:des>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DEC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DEC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DEC']/value)&quot;>&lt;tns:dec>&lt;xsl:value-of select=&quot;column[name='DEC']/value&quot;/>&lt;/tns:dec>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TDKIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TDKIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TDKIT']/value)&quot;>&lt;tns:codiceTdKit>&lt;xsl:value-of select=&quot;column[name='TDKIT']/value&quot;/>&lt;/tns:codiceTdKit>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDENTIFICATIVOVLANOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDENTIFICATIVOVLANOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDENTIFICATIVOVLANOLO']/value)&quot;>&lt;tns:idvlanolo>&lt;xsl:value-of select=&quot;column[name='IDENTIFICATIVOVLANOLO']/value&quot;/>&lt;/tns:idvlanolo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='BMCLIGHT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='BMCLIGHT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='BMCLIGHT']/value)&quot;>&lt;tns:bmcLight>&lt;xsl:value-of select=&quot;column[name='BMCLIGHT']/value&quot;/>&lt;/tns:bmcLight>&lt;/xsl:if>&lt;xsl:if test=&quot;column[name='IDOFFERTA']/value = ('61','63')&quot;>&lt;xsl:if test=&quot;not((string(column[name='NOMEMACROAREA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOMEMACROAREA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOMEMACROAREA']/value)&quot;>&lt;tns:nomeMacroarea>&lt;xsl:value-of select=&quot;column[name='NOMEMACROAREA']/value&quot;/>&lt;/tns:nomeMacroarea>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;column[name='IDOFFERTA']/value = ('61','62','63')&quot;>&lt;xsl:if test=&quot;not((string(column[name='CODICECLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICECLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICECLLI']/value)&quot;>&lt;tns:codiceClli>&lt;xsl:value-of select=&quot;column[name='CODICECLLI']/value&quot;/>&lt;/tns:codiceClli>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDASSET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDASSET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDASSET']/value)&quot;>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;column[name='IDASSET']/value&quot;/>&lt;/tns:idAsset>&lt;/xsl:if>&lt;/tns:OutputDatiQuery>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if (count($ExportAttr/unknownResultset/row/column[name = 'IDASSET']/value)&amp;lt;$MaxRows) then 'OK' else 'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:ricercaAvanzataExportOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ricercaAvanzataExportOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record presente.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:ricercaAvanzataExportOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
