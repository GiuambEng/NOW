                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToEmpty1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCQueryToJavaInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="((string-length($Start/tns:RicercaAvanzata/tns:strutturaCondition[1]/tns:nome)>0 and (upper-case($Start/tns:RicercaAvanzata/tns:exportRequest)='Y' or upper-case($Start/tns:RicercaAvanzata/tns:exportRequest)='S')) or (string-length($Start/tns:RicercaAvanzata/tns:strutturaCondition[1]/tns:nome)>0)) &#xd;&#xa;and &#xd;&#xa;&#xd;&#xa;((contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='CODICETDKIT' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='SUPERMACROAREA' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='NOMEMACROAREA' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='IDENTIFICATIVOVLANOLO' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='IDVLANRETE' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='FAMIGLIAVLAN' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='BMCLIGHT' AND ADA.VALOREATTRIBUTO&quot;) or &#xd;&#xa;contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='IDENTIFICATIVOCOS' AND ADA.VALOREATTRIBUTO&quot;) or&#xd;&#xa;contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,&quot;,&quot;,true()),&quot;ADA.NOMEATTRIBUTO='INTERMEDIATEAGENTDHCPOPTION82' AND ADA.VALOREATTRIBUTO&quot;)))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[((string-length($Start/tns:RicercaAvanzata/tns:strutturaCondition[1]/tns:nome)>0 and (upper-case($Start/tns:RicercaAvanzata/tns:exportRequest)='Y' or upper-case($Start/tns:RicercaAvanzata/tns:exportRequest)='S')) or (string-length($Start/tns:RicercaAvanzata/tns:strutturaCondition[1]/tns:nome)>0)) 
and 

((contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,",",true()),"ADA.NOMEATTRIBUTO='CODICETDKIT' AND ADA.VALOREATTRIBUTO") or 
contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,",",true()),"ADA.NOMEATTRIBUTO='SUPERMACROAREA' AND ADA.VALOREATTRIBUTO") or 
contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,",",true()),"ADA.NOMEATTRIBUTO='NOMEMACROAREA' AND ADA.VALOREATTRIBUTO") or 
contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,",",true()),"ADA.NOMEATTRIBUTO='IDENTIFICATIVOVLANOLO' AND ADA.VALOREATTRIBUTO") or 
contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,",",true()),"ADA.NOMEATTRIBUTO='IDVLANRETE' AND ADA.VALOREATTRIBUTO") or 
contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,",",true()),"ADA.NOMEATTRIBUTO='FAMIGLIAVLAN' AND ADA.VALOREATTRIBUTO") or 
contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,",",true()),"ADA.NOMEATTRIBUTO='BMCLIGHT' AND ADA.VALOREATTRIBUTO") or 
contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,",",true()),"ADA.NOMEATTRIBUTO='IDENTIFICATIVOCOS' AND ADA.VALOREATTRIBUTO") or
contains(tib:concat-sequence-format($Start/tns:RicercaAvanzata/tns:strutturaCondition/tns:nome,",",true()),"ADA.NOMEATTRIBUTO='INTERMEDIATEAGENTDHCPOPTION82' AND ADA.VALOREATTRIBUTO")))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2b8c5c1c-7221-437b-b359-04fe0317c2fb+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
