                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1470065396641&quot; xmlns:tns=&quot;http://www.example.org/AssetRaccolta&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;XmlToExcel-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Element>&#xa;            &lt;tns1:xmlParam>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns1:xmlParam>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Oscuramento/Record[1]/COUNT>0&quot;>&#xa;                    &lt;tns1:listOfColumn>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;codiceOrdineOlo,codiceOrdineTi,idRisorsa,statoAsset,offerta,dataInserimento,dataAggiornamento,des,dec,codiceTdKit,idvlanolo,bmcLight&amp;quot;&quot;/>&#xa;                    &lt;/tns1:listOfColumn>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:listOfColumn>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;codiceOrdineOlo,codiceOrdineTi,idRisorsa,statoAsset,offerta,dataInserimento,dataAggiornamento,des,dec,codiceTdKit,idvlanolo,bmcLight,nomeMacroarea,codiceClli&amp;quot;&quot;/>&#xa;                    &lt;/tns1:listOfColumn>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:rootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ricercaAvanzataExportOutput&amp;quot;&quot;/>&#xa;            &lt;/tns1:rootElement>&#xa;            &lt;tns1:nameOfFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ListaAssetRaccolta&amp;quot;&quot;/>&#xa;            &lt;/tns1:nameOfFile>&#xa;            &lt;tns1:idFile>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:ID_File&quot;/>&#xa;            &lt;/tns1:idFile>&#xa;            &lt;tns1:userId>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:User_ID&quot;/>&#xa;            &lt;/tns1:userId>&#xa;            &lt;tns1:tipoProfilo>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Tipo_Profilo&quot;/>&#xa;            &lt;/tns1:tipoProfilo>&#xa;            &lt;tns1:childElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OutputDatiQuery&amp;quot;&quot;/>&#xa;            &lt;/tns1:childElement>&#xa;        &lt;/tns1:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
