                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AssetRaccolta&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:outputListaAssetRaccolta>&lt;xsl:for-each select=&quot;$Variable/tns:OutputDatiQuery&quot;>&lt;tns:ListaAssetRaccoltaOutput>&lt;xsl:if test=&quot;tns:codiceOrdineOlo&quot;>&lt;tns:codiceOrdineOao>&lt;xsl:value-of select=&quot;tns:codiceOrdineOlo&quot;/>&lt;/tns:codiceOrdineOao>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codiceOrdineTi&quot;>&lt;tns:codiceOrdineTi>&lt;xsl:value-of select=&quot;tns:codiceOrdineTi&quot;/>&lt;/tns:codiceOrdineTi>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codificaOloAgcom&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;tns:codificaOloAgcom&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:idRisorsa&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;tns:idRisorsa&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codiceTdKit&quot;>&lt;tns:codiceTdKit>&lt;xsl:value-of select=&quot;tns:codiceTdKit&quot;/>&lt;/tns:codiceTdKit>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:statoAsset&quot;>&lt;tns:statoAsset>&lt;xsl:value-of select=&quot;tns:statoAsset&quot;/>&lt;/tns:statoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:offerta&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;tns:offerta&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:idAsset&quot;>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;tns:idAsset&quot;/>&lt;/tns:idAsset>&lt;/xsl:if>&lt;/tns:ListaAssetRaccoltaOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;xsl:if test=&quot;$Variable/tns:result/tns:severity&quot;>&lt;tns:severity>&lt;xsl:value-of select=&quot;$Variable/tns:result/tns:severity&quot;/>&lt;/tns:severity>&lt;/xsl:if>&lt;xsl:if test=&quot;$Variable/tns:result/tns:code&quot;>&lt;tns:code>&lt;xsl:value-of select=&quot;$Variable/tns:result/tns:code&quot;/>&lt;/tns:code>&lt;/xsl:if>&lt;xsl:if test=&quot;$Variable/tns:result/tns:details&quot;>&lt;tns:details>&lt;xsl:value-of select=&quot;$Variable/tns:result/tns:details&quot;/>&lt;/tns:details>&lt;/xsl:if>&lt;/tns:result>&lt;/tns:outputListaAssetRaccolta>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
