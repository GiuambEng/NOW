    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/DetokenizzazioneXml"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        location="../../../../../Schemas/TracciatiOlo/Np_n.xsd" namespace=""/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        location="../../../../../Schemas/TracciatiOlo/Np_r.xsd" namespace=""/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:outputDetokenizzazioneXml"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns1:xmlString" name="ParseOrdini-input" sca-bpel:internal="true"/>
        <bpws:variable element="Richiesta" name="ParseOrdini" sca-bpel:internal="true"/>
