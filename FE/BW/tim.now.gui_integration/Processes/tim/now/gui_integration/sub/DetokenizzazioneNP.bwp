        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="ParseXmlToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToRenderXml" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenderXmlToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToParseXml" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="StartToParseXml1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ParseRichiesteToAssign1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign1ToRenderXml1" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenderXml1ToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="6796a447-67dd-4b3d-a44c-7da220070a59"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToParseXml">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToParseXml1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:lavorazione) = ('VALIDFORMALEDONORRECIPIENT','VALIDFORMALEDONATINGDONOR','VALIDTECNICADONATINGDONOR','COMESITODONORRECIPIENT','ESPLETAMENTODONORRECIPIENTDONATING','RIMODULAZIONEDAC','ESPLETAMENTOCESSAZIONE','VALIDFORMALECESSAZIONE','VALIDTECNICACESSAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:lavorazione) = ('VALIDFORMALEDONORRECIPIENT','VALIDFORMALEDONATINGDONOR','VALIDTECNICADONATINGDONOR','COMESITODONORRECIPIENT','ESPLETAMENTODONORRECIPIENTDONATING','RIMODULAZIONEDAC','ESPLETAMENTOCESSAZIONE','VALIDFORMALECESSAZIONE','VALIDTECNICACESSAZIONE')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="eb59e095-836e-4db5-b8f8-a322ea905192" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenderXmlToEnd"/>
                        <bpws:target linkName="RenderXml1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RenderXml&quot;/>&lt;xsl:param name=&quot;RenderXml1&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:outputDetokenizzazioneXml>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RenderXml)>0&quot;>&lt;tns:tracciatoDetokenizzato>&lt;xsl:value-of select=&quot;$RenderXml&quot;/>&lt;/tns:tracciatoDetokenizzato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:tracciatoDetokenizzato>&lt;xsl:value-of select=&quot;$RenderXml1&quot;/>&lt;/tns:tracciatoDetokenizzato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:outputDetokenizzazioneXml>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ParseOrdini-input" name="ParseOrdini"
                    outputVariable="ParseOrdini"
                    tibex:xpdlId="8e03f2ae-fab6-402d-99f9-e165ec285d5f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToParseXml"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ParseXmlToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tns1=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ParseXml-input&quot; match=&quot;/&quot;>&lt;tns:xmlString>&lt;xsl:value-of select=&quot;$Start/tns1:tracciatoXml&quot;/>&lt;/tns:xmlString>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.parsexml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>
                                    <value inputStyle="text"
                                    outputElementQName="Richiesta"
                                    validateOutput="true" xsi:type="palettexml:ParseXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="RenderXml-input"
                    name="RenderXml" outputVariable="RenderXml"
                    tibex:xpdlId="5654b168-ebf5-49e9-877f-f9898512b0a0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToRenderXml"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenderXmlToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Variable&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.renderxml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value inputElementQName="Richiesta"
                                    outputStyle="text" xsi:type="palettexml:RenderXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Variable"
                    name="Assign" outputVariable="Variable"
                    tibex:xpdlId="f675c8b2-ac31-4802-a445-6cf08143fc02" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseXmlToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToRenderXml"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseOrdini&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;Richiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ParseOrdini/Portin)&quot;>&#xa;                    &lt;Portin>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;CodiceOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/CodiceOrdine&quot;/>&#xa;                        &lt;/CodiceOrdine>&#xa;                        &lt;DataOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/DataOrdine&quot;/>&#xa;                        &lt;/DataOrdine>&#xa;                        &lt;DirectoryNumber>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/DirectoryNumber&quot;/>&#xa;                        &lt;/DirectoryNumber>&#xa;                        &lt;xsl:if test=&quot;$ParseOrdini/Portin/TipoLinea&quot;>&#xa;                            &lt;TipoLinea>&#xa;                                &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/TipoLinea&quot;/>&#xa;                            &lt;/TipoLinea>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseOrdini/Portin/Note&quot;>&#xa;                            &lt;Note>&#xa;                                &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/Note&quot;/>&#xa;                            &lt;/Note>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DataInvioMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/DataInvioMessaggio&quot;/>&#xa;                        &lt;/DataInvioMessaggio>&#xa;                        &lt;IdentificativoOperatoreDonor>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/IdentificativoOperatoreDonor&quot;/>&#xa;                        &lt;/IdentificativoOperatoreDonor>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:nome&quot;>&#xa;                            &lt;NomeCliente>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:nome&quot;/>&#xa;                            &lt;/NomeCliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CognomeCliente_RagioneSociale>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:cognome&quot;/>&#xa;                        &lt;/CognomeCliente_RagioneSociale>&#xa;                        &lt;TelefonoReferenteRichiedente>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:telefono&quot;/>&#xa;                        &lt;/TelefonoReferenteRichiedente>&#xa;                        &lt;EmailReferenteRichiedente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/EmailReferenteRichiedente&quot;/>&#xa;                        &lt;/EmailReferenteRichiedente>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseOrdini/Portin/Correlazioni&quot;/>&#xa;                        &lt;CodiceOpRecipient>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/CodiceOpRecipient&quot;/>&#xa;                        &lt;/CodiceOpRecipient>&#xa;                        &lt;DataAttesaConsegnaServizio>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/DataAttesaConsegnaServizio&quot;/>&#xa;                        &lt;/DataAttesaConsegnaServizio>&#xa;                        &lt;xsl:if test=&quot;$ParseOrdini/Portin/CodiceProgetto&quot;>&#xa;                            &lt;CodiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/CodiceProgetto&quot;/>&#xa;                            &lt;/CodiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseOrdini/Portin/FlagNPNumerazioniAggiuntive&quot;>&#xa;                            &lt;FlagNPNumerazioniAggiuntive>&#xa;                                &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                            &lt;/FlagNPNumerazioniAggiuntive>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CodiceSegreto>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/CodiceSegreto&quot;/>&#xa;                        &lt;/CodiceSegreto>&#xa;                        &lt;RoutingNumber>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Portin/RoutingNumber&quot;/>&#xa;                        &lt;/RoutingNumber>&#xa;                    &lt;/Portin>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseOrdini/Prenotifica_Donating)&quot;>&#xa;                    &lt;Prenotifica_Donating>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Prenotifica_Donating/TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;CodiceOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Prenotifica_Donating/CodiceOrdine&quot;/>&#xa;                        &lt;/CodiceOrdine>&#xa;                        &lt;DataOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$ParseOrdini/Prenotifica_Donating/DataOrdine&quot;/>&#xa;             