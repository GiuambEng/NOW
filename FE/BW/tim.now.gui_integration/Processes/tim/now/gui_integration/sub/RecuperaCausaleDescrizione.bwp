    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>Accumulate</variable>
            </endingVariables>
        </task>
        <task name="Iterate">
            <endingVariables>
                <variable>Start</variable>
                <variable>Mapper</variable>
                <variable>currentElement</variable>
            </endingVariables>
        </task>
        <task name="Mapper">
            <endingVariables>
                <variable>Mapper-input</variable>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery">
