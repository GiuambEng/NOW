                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/RecuperaCausaleDescrizione&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1935df08-8ea4-4d8e-8ed0-2d11c28d26b6+output&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:outputRecuperaCausaleDescrizione>&lt;xsl:for-each select=&quot;$Accumulate/tns:outputRecuperaCausaleDescrizione/tns:OutputRecuperaCausaleDescrizione&quot;>&lt;tns:OutputRecuperaCausaleDescrizione>&lt;xsl:if test=&quot;tns:idRichiestaOlo&quot;>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;tns:idRichiestaOlo&quot;/>&lt;/tns:idRichiestaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codCausNowDG&quot;>&lt;tns:codCausNowDG>&lt;xsl:value-of select=&quot;tns:codCausNowDG&quot;/>&lt;/tns:codCausNowDG>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codCausOLO&quot;>&lt;tns:codCausOLO>&lt;xsl:value-of select=&quot;tns:codCausOLO&quot;/>&lt;/tns:codCausOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:descrCausNowDG&quot;>&lt;tns:descrCausNowDG>&lt;xsl:value-of select=&quot;tns:descrCausNowDG&quot;/>&lt;/tns:descrCausNowDG>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:descrCausOLO&quot;>&lt;tns:descrCausOLO>&lt;xsl:value-of select=&quot;tns:descrCausOLO&quot;/>&lt;/tns:descrCausOLO>&lt;/xsl:if>&lt;/tns:OutputRecuperaCausaleDescrizione>&lt;/xsl:for-each>&lt;/tns:outputRecuperaCausaleDescrizione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
