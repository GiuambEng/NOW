                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ab9d9066-8a51-46ae-a4b0-a1ebdea2dabf+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/RecuperaCausaleDescrizione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($currentElement/tns1:idRichiestaOLO)&quot;>&lt;xsl:value-of select=&quot;$currentElement/tns1:idRichiestaOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AC.COD_CAUS_OLO,AC.COD_CAUS_NOW_DG,AC.DESCR_CAUS_OLO,AC.DESCR_CAUS_NOW_DG,TRACC.ID_RICH_OLO, TRACC.ID_ANAG_CAUS&#xd;&#xa;FROM RICH_ORDN_COMUNIC_TRACC TRACC &#xd;&#xa;join RICH_ORDN_COMUNIC_NOTF NOTF on TRACC.ID_NOTF = NOTF.ID_NOTF &#xd;&#xa;JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS=TRACC.ID_ANAG_CAUS&#xd;&#xa;WHERE  tracc.id_notf is not null and TRACC.ID_ANAG_CAUS is not null &#xd;&#xa;and tracc.TIMSTP_INSMTO = (select max(tracc.TIMSTP_INSMTO) &#xd;&#xa;  FROM RICH_ORDN_COMUNIC_TRACC TRACC &#xd;&#xa;  WHERE TRACC.ID_RICH_OLO = (?)) and NOTF.COD_TIPOLG_NOTF in ('KC', 'KD', 'KO', 'KR', 'RA', 'RR', 'RS', 'CO', 'KA','SC', 'SP')" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <columnMetadata
                                    columnName="COD_CAUS_OLO"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="COD_CAUS_NOW_DG"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="DESCR_CAUS_NOW_DG"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
