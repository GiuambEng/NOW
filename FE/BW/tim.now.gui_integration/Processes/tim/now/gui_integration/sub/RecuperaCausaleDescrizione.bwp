                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/RecuperaCausaleDescrizione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:outputRecuperaCausaleDescrizione>&lt;tns:OutputRecuperaCausaleDescrizione>&lt;xsl:if test=&quot;$currentElement/tns:idRichiestaOLO&quot;>&lt;tns:idRichiestaOlo>&lt;xsl:value-of select=&quot;$currentElement/tns:idRichiestaOLO&quot;/>&lt;/tns:idRichiestaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/COD_CAUS_NOW_DG&quot;>&lt;tns:codCausNowDG>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_CAUS_NOW_DG&quot;/>&lt;/tns:codCausNowDG>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/COD_CAUS_OLO&quot;>&lt;tns:codCausOLO>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:codCausOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/DESCR_CAUS_NOW_DG&quot;>&lt;tns:descrCausNowDG>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DESCR_CAUS_NOW_DG&quot;/>&lt;/tns:descrCausNowDG>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns:descrCausOLO>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:descrCausOLO>&lt;/xsl:if>&lt;/tns:OutputRecuperaCausaleDescrizione>&lt;/tns:outputRecuperaCausaleDescrizione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
