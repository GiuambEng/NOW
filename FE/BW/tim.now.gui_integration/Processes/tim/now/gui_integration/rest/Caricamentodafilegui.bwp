/pathFinale, $post.item/tns1:nomefile)&quot;/>&#xa;                            &lt;/fileName>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;fileName>&#xa;                                &lt;xsl:value-of select=&quot;concat($Path, substring($post.item/tns1:nomefile,1,3), $PathFinale/pathFinale, $post.item/tns1:nomefile)&quot;/>&#xa;                            &lt;/fileName>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ListFilesActivityConfig>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
