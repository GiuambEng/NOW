                                    <bpws:source linkName="AssignToget_News_outp_Log"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/NewsInformativeMigrazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ListaNews&quot;/>&lt;xsl:template name=&quot;newsVariable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists ($ListaNews/Record[1]/CONTENUTO) and string-length($ListaNews/Record[1]/CONTENUTO)>0&quot;>&lt;tns:ListaNewsEInfoMigOutput>&lt;xsl:for-each select=&quot;$ListaNews/Record&quot;>&lt;tns:ListaNewsInfoMigOutput>&lt;tns:CONTENUTO>&lt;xsl:value-of select=&quot;CONTENUTO&quot;/>&lt;/tns:CONTENUTO>&lt;tns:FLAG_VISIBILITA>&lt;xsl:value-of select=&quot;FLAG_VISIBILITA&quot;/>&lt;/tns:FLAG_VISIBILITA>&lt;tns:ID_NEWS>&lt;xsl:value-of select=&quot;xsd:int(ID_NEWS)&quot;/>&lt;/tns:ID_NEWS>&lt;xsl:if test=&quot;NOTE&quot;>&lt;tns:NOTE>&lt;xsl:value-of select=&quot;NOTE&quot;/>&lt;/tns:NOTE>&lt;/xsl:if>&lt;tns:OPERATORE>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/tns:OPERATORE>&lt;tns:TITOLO>&lt;xsl:value-of select=&quot;TITOLO&quot;/>&lt;/tns:TITOLO>&lt;xsl:if test=&quot;OPERATORE_ULTIMO_AGGTO&quot;>&lt;tns:OPERATORE_ULTIMA_MODIFICA>&lt;xsl:value-of select=&quot;OPERATORE_ULTIMO_AGGTO&quot;/>&lt;/tns:OPERATORE_ULTIMA_MODIFICA>&lt;/xsl:if>&lt;tns:DATE_INSERIMENTO>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_INSMTO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DATE_INSERIMENTO>&lt;tns:DATE_ULTIMA_MODIFICA>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_AGGTO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DATE_ULTIMA_MODIFICA>&lt;/tns:ListaNewsInfoMigOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:ListaNewsEInfoMigOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ListaNewsEInfoMigOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:ListaNewsEInfoMigOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
