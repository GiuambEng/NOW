    xmlns:tibprop="http://ns.tibco.com/bw/property" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>get</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="DownloadEsitiCanali_LogInput">
            <endingVariables>
                <variable>DownloadEsitiCanali_LogInput-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="DownloadEsitiCanali_LogInfo">
            <endingVariables>
                <variable>DownloadEsitiCanali_LogInfo-input</variable>
            </endingVariables>
        </task>
        <task name="DeCryptoDownload">
            <endingVariables>
                <variable>DeCryptoDownload-input</variable>
            </endingVariables>
        </task>
        <task name="DownloadEsitiCanali_LogOutput">
            <endingVariables>
                <variable>DownloadEsitiCanali_LogOutput-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="JDBCCallProcedure">
            <endingVariables>
                <variable>JDBCCallProcedure-input</variable>
                <variable>DeCryptoDownload</variable>
            </endingVariables>
        </task>
        <task name="RenderXml">
            <endingVariables>
                <variable>RenderXml-input</variable>
                <variable>JDBCCallProcedure</variable>
            </endingVariables>
        </task>
        <task name="ParseXml">
            <endingVariables>
                <variable>ParseXml-input</variable>
                <variable>RenderXml</variable>
            </endingVariables>
        </task>
        <task name="CreateFile">
            <endingVariables>
                <variable>CreateFile-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>CreateFile</variable>
            </endingVariables>
        </task>
        <task name="Renderdata">
            <endingVariables>
                <variable>Renderdata-input</variable>
            </endingVariables>
        </task>
        <task name="WriteFile">
            <endingVariables>
                <variable>WriteFile-input</variable>
                <variable>WriteFile</variable>
                <variable>Renderdata</variable>
            </endingVariables>
        </task>
        <task name="Iterate">
            <endingVariables>
                <variable>ParseXml</variable>
                <variable>currentElement</variable>
            </endingVariables>
        </task>
        <task name="Renderdata1">
            <endingVariables>
                <variable>Renderdata1-input</variable>
            </endingVariables>
        </task>
        <task name="WriteFile1">
            <endingVariables>
                <variable>WriteFile1-input</variable>
                <variable>WriteFile1</variable>
                <variable>Renderdata1</variable>
            </endingVariables>
        </task>
        <task name="ReadFile">
            <endingVariables>
                <variable>ReadFile-input</variable>
            </endingVariables>
        </task>
        <task name="Assign1">
            <endingVariables>
                <variable>ReadFile</variable>
            </endingVariables>
        </task>
        <task name="RemoveFile">
            <endingVariables>
                <variable>RemoveFile-input</variable>
                <variable>RemoveFile</variable>
            </endingVariables>
        </task>
        <task name="DownloadEsitiCanali_LogError">
            <endingVariables>
                <variable>DownloadEsitiCanali_LogError-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="RemoveFile1">
            <endingVariables>
                <variable>RemoveFile1-input</variable>
                <variable>RemoveFile1</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
