                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TOT.DESCR_OPZ_TRAFFICO_NPNG, TOT.OPZ_TRAFFICO_NPNG, APN.PREFS_NPNG, AOT.DATA_INIZIO_VAL, AOT.DATA_FINE_VAL,&#xa;AOT.ID_ASS_OPZ_TRAF_PREF_SRVZ_NPNG, AOT.ID_ANAG_PREFS_NPNG, AOT.ID_TIPOLOG_OPZ_TRAFC_NPNG&#xa;FROM ASS_OPZ_TRAF_PREF_SRVZ_NPNG AOT INNER JOIN TIPOLOG_OPZ_TRAFC_NPNG TOT&#xa;&#x9;ON AOT.ID_TIPOLOG_OPZ_TRAFC_NPNG = TOT.ID_TIPOLOG_OPZ_TRAFC_NPNG&#xa;&#x9;INNER JOIN ANAG_PREFS_NPNG APN ON APN.ID_ANAG_PREFS_NPNG = AOT.ID_ANAG_PREFS_NPNG" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="DESCR_OPZ_TRAFFICO_NPNG"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OPZ_TRAFFICO_NPNG"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PREFS_NPNG"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_INIZIO_VAL"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATA_FINE_VAL"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="ID_ASS_OPZ_TRAF_PREF_SRVZ_NPNG"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ANAG_PREFS_NPNG"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_TIPOLOG_OPZ_TRAFC_NPNG"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
