                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaOpzTrafficoNPNG&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record/OPZ_TRAFFICO_NPNG)>0&quot;>&lt;tns:outputAnagraficaOpzTrafficoNPNG>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns:listaOpzTrafficoNPNG>&lt;tns:descrOpzTraffico>&lt;xsl:value-of select=&quot;DESCR_OPZ_TRAFFICO_NPNG&quot;/>&lt;/tns:descrOpzTraffico>&lt;tns:opzTraffico>&lt;xsl:value-of select=&quot;OPZ_TRAFFICO_NPNG&quot;/>&lt;/tns:opzTraffico>&lt;tns:prefissoNPNG>&lt;xsl:value-of select=&quot;PREFS_NPNG&quot;/>&lt;/tns:prefissoNPNG>&lt;xsl:choose>&lt;xsl:when test=&quot;(current-dateTime()&amp;lt;=DATA_FINE_VAL) and (current-dateTime()>=DATA_INIZIO_VAL)&quot;>&lt;tns:flagValidita>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagValidita>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:flagValidita>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagValidita>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DATA_INIZIO_VAL&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DATA_FINE_VAL&quot;/>&lt;/tns:dataFineValidita>&lt;tns:rowId>&lt;xsl:value-of select=&quot;ID_ASS_OPZ_TRAF_PREF_SRVZ_NPNG&quot;/>&lt;/tns:rowId>&lt;/tns:listaOpzTrafficoNPNG>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputAnagraficaOpzTrafficoNPNG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputAnagraficaOpzTrafficoNPNG>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record presente.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputAnagraficaOpzTrafficoNPNG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
