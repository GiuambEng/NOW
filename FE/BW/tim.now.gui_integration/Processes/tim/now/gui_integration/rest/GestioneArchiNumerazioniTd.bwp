                                <tibex:activityExtension
                                    inputVariable="GetArchiNumTD-input"
                                    name="GetArchiNumTD"
                                    outputVariable="GetArchiNumTD"
                                    tibex:xpdlId="d911b96e-b247-436f-809b-db3b0be5d30a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToGetArchiNumTD"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GetArchiNumTDToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d911b96e-b247-436f-809b-db3b0be5d30a+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICE_ARCO,TD_MAX, TD_MIN, TD_CURRENT,(TD_MAX - NVL(TD_CURRENT,-1)) as TD_RESIDUI,&#xa;  DATA_INIZIO_VALIDITA, DATA_FINE_VALIDITA, TIMSTMP_ULTIMO_AGGNMTO,&#xa;  OPERATORE_ULTIMO_AGGNMTO, CASE TD_MAX WHEN TD_CURRENT THEN 'N' ELSE 'Y' END AS FLAG_ACTIVE&#xa;  &#xa;  FROM  ARCHI_TD A&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="CODICE_ARCO"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TD_MAX"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TD_MIN"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TD_CURRENT"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TD_RESIDUI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATA_INIZIO_VALIDITA"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATA_FINE_VALIDITA"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="TIMSTMP_ULTIMO_AGGNMTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="OPERATORE_ULTIMO_AGGNMTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_ACTIVE"
                                    dataType="1"
                                    status="OptionalElement" typeName="CHAR"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="verArchiTD"
                                    name="VarArchiTd"
                                    outputVariable="verArchiTD"
                                    tibex:xpdlId="032b19dc-fafb-4d87-ba4a-d741590c4bcc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GetArchiNumTDToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VarArchiTdTologOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1494599418401&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetArchiNumTD&quot;/>&lt;xsl:template name=&quot;verArchiTD&quot; match=&quot;/&quot;>&lt;tns:ArchiNumerazioniTDOut>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetArchiNumTD/Record[1])&quot;>&lt;xsl:for-each select=&quot;$GetArchiNumTD/Record&quot;>&lt;tns:ArchiNumerazioniTDOutObj>&lt;tns:TD_parziale>&lt;xsl:value-of select=&quot;CODICE_ARCO&quot;/>&lt;/tns:TD_parziale>&lt;tns:TD_current>&lt;xsl:value-of select=&quot;TD_CURRENT&quot;/>&lt;/tns:TD_current>&lt;tns:TD_min>&lt;xsl:value-of select=&quot;TD_MIN&quot;/>&lt;/tns:TD_min>&lt;tns:TD_max>&lt;xsl:value-of select=&quot;TD_MAX&quot;/>&lt;/tns:TD_max>&lt;tns:Inizio_validita>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_INIZIO_VALIDITA),'T')&quot;/>&lt;/tns:Inizio_validita>&lt;tns:Fine_validita>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_FINE_VALIDITA),'T')&quot;/>&lt;/tns:Fine_validita>&lt;xsl:if test=&quot;FLAG_ACTIVE&quot;>&lt;tns:Active_flag>&lt;xsl:value-of select=&quot;FLAG_ACTIVE&quot;/>&lt;/tns:Active_flag>&lt;/xsl:if>&lt;xsl:if test=&quot;OPERATORE_ULTIMO_AGGNMTO&quot;>&lt;tns:operatore>&lt;xsl:value-of select=&quot;OPERATORE_ULTIMO_AGGNMTO&quot;/>&lt;/tns:operatore>&lt;/xsl:if>&lt;/tns:ArchiNumerazioniTDOutObj>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ArchiNumerazioniTDOutObj/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:TD_residui>&lt;xsl:value-of select=&quot;xsd:int(sum($GetArchiNumTD/Record/TD_RESIDUI))&quot;/>&lt;/tns:TD_residui>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetArchiNumTD/Record[1])&quot;>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:details>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'non ci sono elementi in tabella'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ArchiNumerazioniTDOut>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="verArchiTD" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerMsg&quot;/>&lt;xsl:template name=&quot;LogIN-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Process>&lt;xsl:value-of select=&quot;&amp;quot;GestioneArchiNumerazioniTD&amp;quot;&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.GestioneArchiNumerazioniTD&amp;quot;&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;xsl:if test=&quot;$get/httpHeaders/tns:httpHeaders/GUI-SID&quot;>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns:httpHeaders/GUI-SID&quot;/>&lt;/tns1:BusinessID>&lt;/xsl:if>&lt;tns1:Payload>&lt;xsl:value-of select=&quot;'InputCreazioneNuovoOrdine get'&quot;/>&lt;/tns1:Payload>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;tns1:ActiveLoggerServices>&lt;tns1:Envelope>&lt;tns1:Identifier>&lt;tns1:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_creazioneOrdine.CreazioneNuovoOrdine&amp;quot;&quot;/>&lt;/tns1:ServiceName>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns1:Source>&lt;xsl:if test=&quot;$get/httpHeaders/tns:httpHeaders/GUI-SID&quot;>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns:httpHeaders/GUI-SID&quot;/>&lt;/tns1:BusinessID>&lt;/xsl:if>&lt;tns1:EventID>&lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns:httpHeaders/GUI-SID,$get/httpHeaders/tns:httpHeaders/GUI-TID)&quot;/>&lt;/tns1:EventID>&lt;xsl:if test=&quot;$get/httpHeaders/tns:httpHeaders/GUI-TID&quot;>&lt;tns1:CorrelationID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns:httpHeaders/GUI-TID&quot;/>&lt;/tns1:CorrelationID>&lt;/xsl:if>&lt;tns1:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;CreazioneNuovoOrdine_&amp;quot;,$get/httpHeaders/tns:httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&lt;/tns1:EventType>&lt;tns1:trackID>&lt;xsl:value-of select=&quot; concat(&amp;quot;CreazioneNuovoOrdine_&amp;quot;,$get/httpHeaders/tns:httpHeaders/GUI-SID)&quot;/>&lt;/tns1:trackID>&lt;/tns1:Identifier>&lt;tns1:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns1:track_position>&lt;tns1:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:Timestamp>&lt;/tns1:Envelope>&lt;tns1:Playload>&lt;tns1:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get/httpHeaders ))) &quot;/>&lt;/tns1:Binary>&lt;tns1:XMLString>&lt;xsl:value-of select=&quot;'' &quot;/>&lt;/tns1:XMLString>&lt;/tns1:Playload>&lt;/tns1:ActiveLoggerServices>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogIN-input"
                                    name="LogIN"
                                    tibex:xpdlId="6c4c2e2a-1773-4782-acfd-ab3486402f30"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToCallProcess1"/>
                                    </bpws:sources>
