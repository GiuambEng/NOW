f select=&quot;ABILITATO_NGA&quot;/>&#xa;                                &lt;/tns1:abilitatoNga>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:codificaOloAgcom>&#xa;                                &lt;xsl:value-of select=&quot;CODIFICA_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns1:codificaOloAgcom>&#xa;                            &lt;xsl:if test=&quot;CODICE_OLO_NUMERICO&quot;>&#xa;                                &lt;tns1:codiceOlo>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_OLO_NUMERICO&quot;/>&#xa;                                &lt;/tns1:codiceOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ID_PRIME_CONTRACTOR&quot;>&#xa;                                &lt;tns1:idPrimeContractor>&#xa;                                    &lt;xsl:value-of select=&quot;ID_PRIME_CONTRACTOR&quot;/>&#xa;                                &lt;/tns1:idPrimeContractor>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:famigliaKit>&#xa;                                &lt;xsl:value-of select=&quot;FAMIGLIA_KIT&quot;/>&#xa;                            &lt;/tns1:famigliaKit>&#xa;                        &lt;/tns1:listaKitVlan>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:outputAnagraficaKitVlan>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:outputAnagraficaKitVlan>&#xa;                    &lt;tns1:resu