                <bpws:onMessage operation="get"
                    partnerLink="anagraficakitvlan"
                    portType="ns:anagraficakitvlan"
                    tibex:xpdlId="9a9291ae-0f88-4ebc-a84b-30e6965f7600" variable="get">
                    <bpws:scope name="scope1">
