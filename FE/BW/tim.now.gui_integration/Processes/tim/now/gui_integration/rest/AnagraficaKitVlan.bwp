                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaKitVlan&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:inputservizioricercaavanzata>&#xa;            &lt;xsl:for-each select=&quot;$post.item/tns:strutturaCondition&quot;>&#xa;                &lt;tns1:strutturaCondition>&#xa;                    &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                        &lt;tns1:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                        &lt;/tns1:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:operazione&quot;>&#xa;                        &lt;tns1:operazione>&#xa;                            &lt;xsl:value-of select=&quot;tns:operazione&quot;/>&#xa;                        &lt;/tns1:operazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:valore&quot;>&#xa;                        &lt;tns1:valore>&#xa;                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                        &lt;/tns1:valore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:tipo&quot;>&#xa;                        &lt;tns1:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns:tipo&quot;/>&#xa;                        &lt;/tns1:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:indiceriga&quot;>&#xa;                &lt;tns1:indiceriga>&#xa;                    &lt;xsl:v