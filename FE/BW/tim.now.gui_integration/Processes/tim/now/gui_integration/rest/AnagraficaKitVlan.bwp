                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaKitVlan&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;Variable1&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SQLDirect/unknownResultset/row/column/name) >0&quot;>&lt;tns:AnagraficaKitVlanOutput>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&lt;tns:listaAnagraficaKitVlan>&lt;xsl:if test=&quot;not((string(column[name='ABILITATO_NGA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ABILITATO_NGA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ABILITATO_NGA']/value)&quot;>&lt;tns:abilitatoNga>&lt;xsl:value-of select=&quot;column[name='ABILITATO_NGA']/value&quot;/>&lt;/tns:abilitatoNga>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CLLI']/value)&quot;>&lt;tns:clli>&lt;xsl:value-of select=&quot;column[name='CLLI']/value&quot;/>&lt;/tns:clli>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICE_KIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICE_KIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICE_KIT']/value)&quot;>&lt;tns:codiceKit>&lt;xsl:value-of select=&quot;column[name='CODICE_KIT']/value&quot;/>&lt;/tns:codiceKit>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICE_OLO_NUMERICO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICE_OLO_NUMERICO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICE_OLO_NUMERICO']/value)&quot;>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;column[name='CODICE_OLO_NUMERICO']/value&quot;/>&lt;/tns:codiceOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICA_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICA_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICA_OLO_AGCOM']/value)&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;column[name='CODIFICA_OLO_AGCOM']/value&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DEC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DEC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DEC']/value)&quot;>&lt;tns:dec>&lt;xsl:value-of select=&quot;column[name='DEC']/value&quot;/>&lt;/tns:dec>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DEC_ATTIVAZIONE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DEC_ATTIVAZIONE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DEC_ATTIVAZIONE']/value)&quot;>&lt;tns:decAttivazione>&lt;xsl:value-of select=&quot;column[name='DEC_ATTIVAZIONE']/value&quot;/>&lt;/tns:decAttivazione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FAMIGLIA_KIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FAMIGLIA_KIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FAMIGLIA_KIT']/value)&quot;>&lt;tns:famigliaKit>&lt;xsl:value-of select=&quot;column[name='FAMIGLIA_KIT']/value&quot;/>&lt;/tns:famigliaKit>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='ID_PRIME_CONTRACTOR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_PRIME_CONTRACTOR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_PRIME_CONTRACTOR']/value)&quot;>&lt;tns:idPrimeContractor>&lt;xsl:value-of select=&quot;column[name='ID_PRIME_CONTRACTOR']/value&quot;/>&lt;/tns:idPrimeContractor>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='MODELLO_KIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='MODELLO_KIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='MODELLO_KIT']/value)&quot;>&lt;tns:modelloKit>&lt;xsl:value-of select=&quot;column[name='MODELLO_KIT']/value&quot;/>&lt;/tns:modelloKit>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO']/value)&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;column[name='STATO']/value&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;/tns:listaAnagraficaKitVlan>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:AnagraficaKitVlanOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:AnagraficaKitVlanOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:AnagraficaKitVlanOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
