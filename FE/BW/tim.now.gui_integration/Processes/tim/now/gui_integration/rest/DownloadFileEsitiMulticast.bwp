    xmlns:tibprop="http://ns.tibco.com/bw/property" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="DownloadCsvEsitiContratto_LogInfo">
            <endingVariables>
                <variable>DownloadCsvEsitiContratto_LogInfo-input</variable>
            </endingVariables>
        </task>
        <task name="DownloadCsvEsitiContratto_LogInput">
            <endingVariables>
                <variable>DownloadCsvEsitiContratto_LogInput-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="DownloadCsvEsitiContratto_LogOutput">
            <endingVariables>
                <variable>DownloadCsvEsitiContratto_LogOutput-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="RecuperaEsiti">
            <endingVariables>
                <variable>RecuperaEsiti-input</variable>
                <variable>DeCryptoDownload</variable>
            </endingVariables>
        </task>
        <task name="RenderXmlCsv">
            <endingVariables>
                <variable>RenderXmlCsv-input</variable>
                <variable>RecuperaEsiti</variable>
            </endingVariables>
        </task>
        <task name="ParseXml">
            <endingVariables>
                <variable>ParseXml-input</variable>
                <variable>RenderXmlCsv</variable>
            </endingVariables>
        </task>
        <task name="CreateFile">
            <endingVariables>
                <variable>CreateFile-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>CreateFile</variable>
            </endingVariables>
        </task>
        <task name="Renderdata">
            <endingVariables>
                <variable>Renderdata-input</variable>
            </endingVariables>
        </task>
        <task name="WriteHeader">
            <endingVariables>
                <variable>WriteHeader-input</variable>
                <variable>WriteHeader</variable>
                <variable>Renderdata</variable>
            </endingVariables>
        </task>
        <task name="Iterate">
            <endingVariables>
                <variable>ParseXml</variable>
                <variable>currentEsito</variable>
            </endingVariables>
        </task>
        <task name="RenderCsv">
            <endingVariables>
                <variable>RenderCsv-input</variable>
            </endingVariables>
        </task>
        <task name="WriteFile">
            <endingVariables>
                <variable>WriteFile-input</variable>
                <variable>WriteFile</variable>
                <variable>RenderCsv</variable>
            </endingVariables>
        </task>
        <task name="ReadFile">
            <endingVariables>
                <variable>ReadFile-input</variable>
            </endingVariables>
        </task>
        <task name="Assign1">
            <endingVariables>
                <variable>ReadFile</variable>
            </endingVariables>
        </task>
        <task name="RemoveFile">
            <endingVariables>
                <variable>RemoveFile-input</variable>
                <variable>RemoveFile</variable>
            </endingVariables>
        </task>
        <task name="DeCryptoDownload">
            <endingVariables>
                <variable>DeCryptoDownload-input</variable>
            </endingVariables>
        </task>
        <task name="DownloadCsvEsitiContratto_LogError">
            <endingVariables>
                <variable>DownloadCsvEsitiContratto_LogError-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="RemoveFile1">
            <endingVariables>
                <variable>RemoveFile1-input</variable>
                <variable>RemoveFile1</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
