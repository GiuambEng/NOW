                                    sqlStatement="SELECT OAO,DATO,TIPO_DATO,AZIONE,DATA_VALIDITA,DESCR_ERRORE&#xa;FROM STAG_MODF_CONTR_MULTICAST_FILE&#xa;WHERE ID_FILE_PROCSTO_INPUT = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

