           &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.gui_integration.DownloadCsvEsitiContratto'&amp;#xD;&amp;#xA;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;'GUI'&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&amp;#xD;&amp;#xA;&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&amp;#xD;&amp;#xA;&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,'_',$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat('DownloadCsvEsitiContratto','_',$get.httpHeaders/GUI-SID,'COMPLETED')&amp;#xD;&amp;#xA;&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('DownloadCsvEsitiContratto','_',$get.httpHeaders/GUI-SID)&amp;#xD;&amp;#xA;&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'OUT'&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&amp;#xD;&amp;#xA;&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;tns:Playload/>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
