                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT E.CONTENUTO_FILE, E.NOME_FILE, E.ID_FILE,E.ESITO, E.USERID, E.PROFILO&#xa;FROM EXPORT_LISTA E&#xa;LEFT JOIN FILE_PROCSTO F ON F.ID_FILE = E.ID_FILE&#xa;WHERE E.ID_FILE = ? AND (E.USERID = ? OR E.USERID IS NULL) AND (E.PROFILO = ? OR E.PROFILO IS NULL)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idFile"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="userId"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tipoProfilo"/>
                                    <columnMetadata
                                    columnName="CONTENUTO_FILE"
                                    dataType="2004"
                                    status="OptionalElement" typeName="BLOB"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ESITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="USERID"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROFILO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
