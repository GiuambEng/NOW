    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>get</variable>
                <variable>LoggerName</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="RecuperoDatiQuery">
            <endingVariables>
                <variable>RecuperoDatiQuery-input</variable>
                <variable>DeCryptoIdFile</variable>
                <variable>DeCryptoDownload</variable>
            </endingVariables>
        </task>
        <task name="Delete">
            <endingVariables>
                <variable>Delete-input</variable>
                <variable>Delete</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperoExportDati_InputLog_INFO">
            <endingVariables>
                <variable>get_RecuperoExportDati_InputLog_INFO-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperoExportDati_InputLog">
            <endingVariables>
                <variable>get_RecuperoExportDati_InputLog-input</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperoExportDati_out_Log">
            <endingVariables>
                <variable>get_RecuperoExportDati_out_Log-input</variable>
                <variable>RecuperoDatiQuery</variable>
            </endingVariables>
        </task>
        <task name="DeCryptoIdFile">
            <endingVariables>
                <variable>DeCryptoIdFile-input</variable>
            </endingVariables>
        </task>
        <task name="DeCryptoDownload">
            <endingVariables>
                <variable>DeCryptoDownload-input</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperoExportDati_Error_Log">
            <endingVariables>
                <variable>get_RecuperoExportDati_Error_Log-input</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
