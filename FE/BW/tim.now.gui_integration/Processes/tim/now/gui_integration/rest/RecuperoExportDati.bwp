                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cc77322f-6592-4cbd-8973-ed0c1646f5dd+input&quot; xmlns:tns2=&quot;http://www.example.org/DeCryptoParams&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoExportDati/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.example.org/DeCryptoDownload&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DeCryptoIdFile&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;DeCryptoDownload&quot;/>&lt;xsl:template name=&quot;RecuperoDatiQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(number($get/parameters/tns1:recuperoexportdatiGetParameters/tns1:idFile)),&amp;quot;NaN&amp;quot;) and $get/parameters/tns1:recuperoexportdatiGetParameters/tns1:check = 'true'&quot;>&lt;idFile>&lt;xsl:value-of select=&quot;$DeCryptoIdFile/tns2:idFileDecriptato&quot;/>&lt;/idFile>&lt;/xsl:when>&lt;xsl:when test=&quot;contains(xsd:string(number($get/parameters/tns1:recuperoexportdatiGetParameters/tns1:idFile)),&amp;quot;NaN&amp;quot;) and $get/parameters/tns1:recuperoexportdatiGetParameters/tns1:check = 'false'&quot;>&lt;idFile>&lt;xsl:value-of select=&quot;$DeCryptoDownload/tns3:idFileDecriptato&quot;/>&lt;/idFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idFile>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:recuperoexportdatiGetParameters/tns1:idFile)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperoexportdatiGetParameters/tns1:idFile&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;userId>&lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperoexportdatiGetParameters/tns1:userId&quot;/>&lt;/userId>&lt;tipoProfilo>&lt;xsl:value-of select=&quot;$get/parameters/tns1:recuperoexportdatiGetParameters/tns1:tipoProfilo&quot;/>&lt;/tipoProfilo>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
