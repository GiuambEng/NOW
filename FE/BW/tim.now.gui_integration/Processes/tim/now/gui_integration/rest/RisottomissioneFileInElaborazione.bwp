                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RisottomissioneFileInElaborazione&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/RisottomissioneFile/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RisottomissioneFile.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;esitoRisottomissioneVariable&quot;/>&#xa;    &lt;xsl:template name=&quot;esitoRisottomissioneVariable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($RisottomissioneFile.parameters/Stato)&quot;>&#xa;                &lt;tns:outputRisottomissioneFileInElaborazione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($RisottomissioneFile.parameters/Stato)='OK'&quot;>&#xa;                            &lt;tns:OutputRisottomissioneFileInElaborazione>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Il file e' stato sottomesso con successo&amp;quot;&quot;/>&#xa;                                &lt;/tns:descrizione>&#xa;                            &lt;/tns:OutputRisottomissioneFileInElaborazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:OutputRisottomissioneFileInElaborazione>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;$RisottomissioneFile.parameters/Stato&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Non e' stato possibile risottomettere il file&amp;quot;&quot;/>&#xa;                                &lt;/tns:descrizione>&#xa;                            &lt;/tns:OutputRisottomissioneFileInElaborazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputRisottomissioneFileInElaborazione>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:copy-of select=&quot;$esitoRisottomissioneVariable&quot;/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
