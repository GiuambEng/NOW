                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/RisottomissioneFileInElaborazione/parameters&quot; xmlns:tns1=&quot;http://www.example.org/DeCryptoParams&quot; xmlns:tns2=&quot;http://www.example.org/DeCryptoDownload&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;DeCryptoParam-input&quot; match=&quot;/&quot;>&lt;tns2:DeCryptoDownloadInput>&lt;tns2:idFileCriptato>&lt;xsl:value-of select=&quot;$get/parameters/tns:risottomissionefileinelaborazioneGetParameters/tns:idFile&quot;/>&lt;/tns2:idFileCriptato>&lt;/tns2:DeCryptoDownloadInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
