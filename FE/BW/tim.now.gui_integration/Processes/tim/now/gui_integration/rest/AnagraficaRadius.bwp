                                tibex:xpdlId="905c1878-83f3-4126-b043-e81d6d3d1ed8" variable="postOut-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://xmlns.example.com/20260116155043PLT&quot; xmlns:tns5=&quot;http://www.example.org/AnagraficaRadius&quot; xmlns:ns6=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tns6=&quot;http://www.example.org/CryptoParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;outputAnagraficaRadius&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParams&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($post.item/ns6:exportRequest) and (upper-case($post.item/ns6:exportRequest)='S' or upper-case($post.item/ns6:exportRequest)='Y')&quot;>&#xa;                &lt;tns5:outputAnagraficaRadius>&#xa;                    &lt;tns5:result>&#xa;                        &lt;tns5:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns5:severity>&#xa;                        &lt;tns5:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns5:code>&#xa;                    &lt;/tns5:result>&#xa;                    &lt;tns5:idExportFile>&#xa;                        &lt;xsl:value-of select=&quot;$CryptoParams/tns6:idFileCriptato&quot;/>&#xa;                    &lt;/tns5:idExportFile>&#xa;                &lt;/tns5:outputAnagraficaRadius>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:copy-of select=&quot;$outputAnagraficaRadius&quot;/>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20260116155043PLT" xmlns:tns5="http://www.example.org/AnagraficaRadius" xmlns:ns6="http://www.tim.com/NOW/rest/servizioricercaavanzata" xmlns:tns6="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="outputAnagraficaRadius"/&gt;
    &lt;xsl:param name="CryptoParams"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns3:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($post/item/ns6:inputservizioricercaavanzata/ns6:exportRequest) and (upper-case($post/item/ns6:inputservizioricercaavanzata/ns6:exportRequest)='S' or upper-case($post/item/ns6:inputservizioricercaavanzata/ns6:exportRequest)='Y')"&gt;
                        &lt;tns5:outputAnagraficaRadius&gt;
                            &lt;tns5:result&gt;
                                &lt;tns5:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns5:severity&gt;
                                &lt;tns5:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns5:code&gt;
                            &lt;/tns5:result&gt;
                            &lt;tns5:idExportFile&gt;
                                &lt;xsl:value-of select="$CryptoParams/tns6:idFileCriptato"/&gt;
                            &lt;/tns5:idExportFile&gt;
                        &lt;/tns5:outputAnagraficaRadius&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;xsl:copy-of select="$outputAnagraficaRadius"/&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns3:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
