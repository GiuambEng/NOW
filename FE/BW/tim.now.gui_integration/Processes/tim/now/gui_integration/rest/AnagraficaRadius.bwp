                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.com/namespaces/tns/1470065396641&quot; xmlns:tns2=&quot;http://xmlns.example.com/AnagraficaRadius/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;RenderXml&quot;/>&lt;xsl:template name=&quot;ExportData-input&quot; match=&quot;/&quot;>&lt;tns4:Element>&lt;tns4:xmlParam>&lt;xsl:value-of select=&quot;$RenderXml&quot;/>&lt;/tns4:xmlParam>&lt;tns4:listOfColumn>&lt;xsl:value-of select=&quot;'codiceISP,ordineOneStep,lavorazione,tecnologia,gestioneRadius,fornitoreRadius,ownership,sopensioneOrdine,dnsParentalControl,realm,piattaformaO2O,cluster,descrizioneCluster'&quot;/>&lt;/tns4:listOfColumn>&lt;tns4:rootElement>&lt;xsl:value-of select=&quot;'outputAnagraficaRadius'&quot;/>&lt;/tns4:rootElement>&lt;tns4:nameOfFile>&lt;xsl:value-of select=&quot;'ListaAnagraficheRadius'&quot;/>&lt;/tns4:nameOfFile>&lt;tns4:idFile>&lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&lt;/tns4:idFile>&lt;tns4:userId>&lt;xsl:value-of select=&quot;$post/parameters/tns2:anagraficaradiusPostParameters/tns2:userId&quot;/>&lt;/tns4:userId>&lt;tns4:tipoProfilo>&lt;xsl:value-of select=&quot;$post/parameters/tns2:anagraficaradiusPostParameters/tns2:tipoProfilo&quot;/>&lt;/tns4:tipoProfilo>&lt;tns4:childElement>&lt;xsl:value-of select=&quot;'listaAnagraficaRadius'&quot;/>&lt;/tns4:childElement>&lt;/tns4:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>"
