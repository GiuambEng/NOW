                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.example.org/AnagraficaRadius&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryRadius&quot;/>&lt;xsl:template name=&quot;outputAnagraficaRadius&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($QueryRadius/Record)=0&quot;>&lt;tns5:outputAnagraficaRadius>&lt;tns5:result>&lt;tns5:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns5:severity>&lt;tns5:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns5:code>&lt;tns5:details>&lt;xsl:value-of select=&quot;'Nessun record trovato'&quot;/>&lt;/tns5:details>&lt;/tns5:result>&lt;/tns5:outputAnagraficaRadius>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:outputAnagraficaRadius>&lt;xsl:for-each select=&quot;$QueryRadius/Record&quot;>&lt;tns5:listaAnagraficaRadius>&lt;xsl:if test=&quot;CODICE_OLO&quot;>&lt;tns5:codiceISP>&lt;xsl:value-of select=&quot;CODICE_OLO&quot;/>&lt;/tns5:codiceISP>&lt;/xsl:if>&lt;xsl:if test=&quot;ONE_STEP&quot;>&lt;tns5:ordineOneStep>&lt;xsl:value-of select=&quot;ONE_STEP&quot;/>&lt;/tns5:ordineOneStep>&lt;/xsl:if>&lt;xsl:if test=&quot;LAVORAZIONE&quot;>&lt;tns5:lavorazione>&lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&lt;/tns5:lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;TECNOLOGIA&quot;>&lt;tns5:tecnologia>&lt;xsl:value-of select=&quot;TECNOLOGIA&quot;/>&lt;/tns5:tecnologia>&lt;/xsl:if>&lt;xsl:if test=&quot;GESTIONE_RADIUS&quot;>&lt;tns5:gestioneRadius>&lt;xsl:value-of select=&quot;GESTIONE_RADIUS&quot;/>&lt;/tns5:gestioneRadius>&lt;/xsl:if>&lt;xsl:if test=&quot;FORNITORE_RADIUS&quot;>&lt;tns5:fornitoreRadius>&lt;xsl:value-of select=&quot;FORNITORE_RADIUS&quot;/>&lt;/tns5:fornitoreRadius>&lt;/xsl:if>&lt;xsl:if test=&quot;OWNERSHIP&quot;>&lt;tns5:ownership>&lt;xsl:value-of select=&quot;OWNERSHIP&quot;/>&lt;/tns5:ownership>&lt;/xsl:if>&lt;xsl:i