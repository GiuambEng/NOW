          &lt;xsl:value-of select=&quot;'listaAnagraficaRadius'&quot;/>&#xa;            &lt;/tns4:childElement>&#xa;        &lt;/tns4:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
