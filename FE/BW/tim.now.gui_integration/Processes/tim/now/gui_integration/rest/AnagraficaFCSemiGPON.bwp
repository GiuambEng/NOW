                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery2ToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1ab3b10c-6147-4f64-8a43-1a2b04787afc+input&quot; xmlns:tns5=&quot;http://xmlns.example.com/AnagraficaFCSemiGPON/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;JDBCQuery2-input&quot; match=&quot;/&quot;>&lt;tns6:jdbcQueryActivityInput/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select ga.codficaoloagcom, ga.data_fine_val_provisioning, ga.data_inizio_val_provisioning, ga.descr_tipologia_impresa,&#xd;&#xa;       ga.gstautono_presa_appuntamento, ac.cod_area_di_centr, d.ragione_sociale, d.cod_impresa&#xd;&#xa;from gstauto_ass_oloimp_area_centr GA &#xd;&#xa;INNER JOIN del321_impresa D on ga.id_impresa=d.id_impresa&#xd;&#xa;INNER JOIN del321_area_di_centr AC on ga.id_area_di_centrale=ac.id_area_di_centr" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnIndex="1"
