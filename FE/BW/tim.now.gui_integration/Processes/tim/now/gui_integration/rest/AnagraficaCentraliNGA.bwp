                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;LoggerInfo&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;AnagraficaCentraliNGA_LogOutput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;AnagraficaCentraliNGA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.AnagraficaCentraliNGA&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaCentraliNGA&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventID>&lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns1:httpHeaders/GUI-SID,$get/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&lt;/tns:EventID>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaCentraliNGA_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaCentraliNGA_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="AnagraficaCentraliNGA_LogOutput-input"
                                    name="AnagraficaCentraliNGA_LogOutput"
                                    tibex:xpdlId="50c54d71-13a9-4650-9bea-0d1a842fa3f8"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToCallProcess2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess2TogetOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;AnagraficaCentraliNGA_LogOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaCentraliNGA&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.AnagraficaCentraliNGA&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaCentraliNGA&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaCentraliNGA_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaCentraliNGA_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
