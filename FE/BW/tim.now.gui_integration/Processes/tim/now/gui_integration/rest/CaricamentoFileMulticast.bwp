                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8e19cbfa-7d52-4d3a-b9c1-278bce299df8+input&quot; xmlns:tns1=&quot;http://www.example.org/CaricamentoFileMulticast&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT NOME_FILE FROM FILE_PROCSTO WHERE NOME_FILE LIKE '&amp;quot;,substring($post1/item/tns1:inputCaricamentoFileSediCanali/tns1:nomeFile, 1, string-length($post1/item/tns1:inputCaricamentoFileSediCanali/tns1:nomeFile)-7),&amp;quot;%' AND NOME_FILE NOT LIKE '%.TAPPO' ORDER BY NOME_FILE DESC&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
