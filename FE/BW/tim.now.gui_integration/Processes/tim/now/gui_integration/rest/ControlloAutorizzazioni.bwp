                                    sqlStatement="SELECT COD_FUNZIONE, COD_PROFILO&#xa;FROM PROFILO_FUNZIONE&#xa;WHERE COD_PROFILO = ? AND COD_FUNZIONE = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

