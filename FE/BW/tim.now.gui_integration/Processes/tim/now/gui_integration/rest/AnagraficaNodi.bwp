            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+a13862bc-dd94-4012-a69d-0374e86c8d66+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="CODICE_CLLI" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="CODICE_NODO" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="DESCRIZIONE_CENTRALE" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
