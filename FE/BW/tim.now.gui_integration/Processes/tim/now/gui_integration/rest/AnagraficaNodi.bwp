    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaNodi_logInput">
            <endingVariables>
                <variable>AnagraficaNodi_logInput-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaNodi_logInfo">
            <endingVariables>
                <variable>AnagraficaNodi_logInfo-input</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaNodi_logOutput">
            <endingVariables>
                <variable>AnagraficaNodi_logOutput-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery">
            <endingVariables>
                <variable>JDBCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaNodi_logError">
            <endingVariables>
                <variable>AnagraficaNodi_logError-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
