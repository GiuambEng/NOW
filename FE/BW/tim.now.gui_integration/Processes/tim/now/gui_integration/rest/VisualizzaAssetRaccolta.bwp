&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20210728165125PLT" xmlns:tns="http://www.example.org/AssetRaccolta" xmlns:tns2="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="Variable"/&gt;
    &lt;xsl:param name="CryptIdFile"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns3:postResponse&gt;
            &lt;item&gt;
                &lt;tns:outputListaAssetRaccolta&gt;
                    &lt;xsl:copy-of select="$Variable/tns:ListaAssetRaccoltaOutput"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($post/item/tns:inputRicercaAvanzataAssetRaccolta/tns:exportRequest)&gt;0 and $post/item/tns:inputRicercaAvanzataAssetRaccolta/tns:exportRequest = 'Y'"&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:copy-of select="$Variable/tns:result"/&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns:idExportFile&gt;
                        &lt;xsl:value-of select="$CryptIdFile/tns2:idFileCriptato"/&gt;
                    &lt;/tns:idExportFile&gt;
                &lt;/tns:outputListaAssetRaccolta&gt;
            &lt;/item&gt;
        &lt;/tns3:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
