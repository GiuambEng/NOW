                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AssetRaccolta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AssetRaccoltaNOOLOGet&quot;/>&lt;xsl:param name=&quot;AssetRaccoltaOLOGet&quot;/>&lt;xsl:param name=&quot;tdKits&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AssetRaccoltaNOOLOGet/Record/IDASSET)>0&quot;>&lt;tns:outputListaAssetRaccolta>&lt;xsl:for-each select=&quot;$AssetRaccoltaNOOLOGet/Record&quot;>&lt;xsl:variable name=&quot;currIdAsset&quot; select=&quot;string(IDASSET)&quot;/>&lt;tns:ListaAssetRaccoltaOutput>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:codiceOrdineOao>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceOrdineOao>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINETI&quot;>&lt;tns:codiceOrdineTi>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:codiceOrdineTi>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;$tdKits/tns:attributi[tns:idAsset = $currIdAsset]/tns:codiceTdKit&quot;>&lt;tns:codiceTdKit>&lt;xsl:value-of select=&quot;$tdKits/tns:attributi[tns:idAsset = $currIdAsset]/tns:codiceTdKit&quot;/>&lt;/tns:codiceTdKit>&lt;/xsl:if>&lt;xsl:if test=&quot;STATOASSET&quot;>&lt;tns:statoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:statoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;/tns:ListaAssetRaccoltaOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputListaAssetRaccolta>&lt;/xsl:when>&lt;xsl:when test=&quot;count($AssetRaccoltaOLOGet/Record/IDASSET)>0&quot;>&lt;tns:outputListaAssetRaccolta>&lt;xsl:for-each select=&quot;$AssetRaccoltaOLOGet/Record&quot;>&lt;xsl:variable name=&quot;currIdAssetOloGet&quot; select=&quot;string(IDASSET)&quot;/>&lt;tns:ListaAssetRaccoltaOutput>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:codiceOrdineOao>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceOrdineOao>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINETI&quot;>&lt;tns:codiceOrdineTi>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:codiceOrdineTi>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;$tdKits/tns:attributi[tns:idAsset = $currIdAssetOloGet]/tns:codiceTdKit&quot;>&lt;tns:codiceTdKit>&lt;xsl:value-of select=&quot;$tdKits/tns:attributi[tns:idAsset = $currIdAssetOloGet]/tns:codiceTdKit&quot;/>&lt;/tns:codiceTdKit>&lt;/xsl:if>&lt;xsl:if test=&quot;STATOASSET&quot;>&lt;tns:statoAsset>&lt;xsl:value-of select=&quot;STATOASSET&quot;/>&lt;/tns:statoAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;tns:idAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:idAsset>&lt;/tns:ListaAssetRaccoltaOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputListaAssetRaccolta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputListaAssetRaccolta>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record presente in lista'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputListaAssetRaccolta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
