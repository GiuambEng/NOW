quence-format($Variable/tns2:profiloOlo/tns2:anagraficaOlo/tns2:codiceAgcom, &amp;quot;','&amp;quot;, true()), &amp;quot;') AND &amp;quot;,$RicercaAvanzata/tns3:outputcondition[1],&amp;quot; ORDER BY COLI.IDULLCO FETCH FIRST 500 ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
