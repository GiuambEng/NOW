                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaIdullco&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;postInputLogInfo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaIdullco&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaIdullco&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($post/item/tns:Input_AnagraficaIdullco_RicercaAvanzata)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InfoAnagraficaIdullco:&amp;quot;,tib:render-xml($post/item/tns:Input_AnagraficaIdullco_RicercaAvanzata, true(),true()))&quot;/>&#xa;                &lt;/tns4:Payload>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices>&#xa;                &lt;tns4:Envelope>&#xa;                    &lt;tns4:Identifier>&#xa;                        &lt;tns4:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaIdullco&amp;quot;&quot;/>&#xa;                        &lt;/tns4:ServiceName>&#xa;                        &lt;tns4:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Operation>&#xa;                        &lt;tns4:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns4:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns4:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns2:httpHeaders/GUI-SID,$post/httpHeaders/tns2:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns4:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns4:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns4:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaIdullco_&amp;quot;,$post/httpHeaders/tns2:httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;tns4:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaIdullco_&amp;quot;,$post/httpHeaders/tns2:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns4:trackID>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                &lt;/tns4:Envelope>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="postInputLogInfo-input"
                                    name="postInputLogInfo"
                                    tibex:xpdlId="09e76fc0-fbc2-479a-afd1-cd862e720417"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="postInputLogInfoToSQLDirect">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($tipoProfilo, $post/parameters/tns:anagraficaidullcoPostParameters/tns:tipoProfilo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($tipoProfilo, $post.parameters/tns:tipoProfilo)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="postInputLogInfoToEmpty_NoOLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaIdullco&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;postInputLogInfo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaIdullco&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaIdullco&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($post.item)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InfoAnagraficaIdullco:&amp;quot;,tib:render-xml($post.item, true(),true()))&quot;/>&#xa;                &lt;/tns4:Payload>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;            &lt;tns4:ActiveLoggerServices>&#xa;                &lt;tns4:Envelope>&#xa;                    &lt;tns4:Identifier>&#xa;                        &lt;tns4:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaIdullco&amp;quot;&quot;/>&#xa;                        &lt;/tns4:ServiceName>&#xa;                        &lt;tns4:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Operation>&#xa;                        &lt;tns4:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns4:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns4:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns4:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns4:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns4:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaIdullco_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;tns4:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaIdullco_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns4:trackID>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                &lt;/tns4:Envelope>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
