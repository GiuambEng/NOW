                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3aff2506-4ba7-4707-afde-124d57ab6eb1+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaIdullco/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;listaOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post/parameters/tns1:anagraficaidullcoPostParameters/tns1:codiceOloAgcom)>0 and $post/parameters/tns1:anagraficaidullcoPostParameters/tns1:codiceOloAgcom !=&amp;quot;NO-OLO&amp;quot;&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CODFC_OLO_AGCOM, NOME, &amp;quot;,&amp;quot; OPERATORE, CODFC_OLO_RETE, FLAG_OLO_ACCORPANTE &amp;quot;, &amp;#xD;&amp;#xA;&amp;quot; FROM OLO&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot; WHERE &amp;quot;, &amp;quot;CODFC_OLO_AGCOM&amp;quot;, &amp;quot;='&amp;quot;,$post/parameters/tns1:anagraficaidullcoPostParameters/tns1:codiceOloAgcom,&amp;quot;'  OR COD_OLO_ACCORPANTE = '&amp;quot;,$post/parameters/tns1:anagraficaidullcoPostParameters/tns1:codiceOloAgcom,&amp;quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$post/parameters/tns1:anagraficaidullcoPostParameters/tns1:codiceOloAgcom,&amp;quot;') ORDER BY CODFC_OLO_AGCOM&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT CODFC_OLO_AGCOM, NOME, OPERATORE, CODFC_OLO_RETE, FLAG_OLO_ACCORPANTE FROM OLO ORDER BY CODFC_OLO_AGCOM&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="listaOLO-input"
                                    name="listaOLO"
                                    outputVariable="listaOLO"
                                    tibex:xpdlId="3aff2506-4ba7-4707-afde-124d57ab6eb1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="postInputLogInfoToSQLDirect"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="listaOLOToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3aff2506-4ba7-4707-afde-124d57ab6eb1+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaIdullco/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;listaOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.parameters/tns1:codiceOloAgcom)>0 and $post.parameters/tns1:codiceOloAgcom !=&amp;quot;NO-OLO&amp;quot;&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CODFC_OLO_AGCOM, NOME, &amp;quot;,&amp;quot; OPERATORE, CODFC_OLO_RETE, FLAG_OLO_ACCORPANTE &amp;quot;, &amp;#xD;&amp;#xA;&amp;quot; FROM OLO&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot; WHERE &amp;quot;, &amp;quot;CODFC_OLO_AGCOM&amp;quot;, &amp;quot;='&amp;quot;,$post.parameters/tns1:codiceOloAgcom,&amp;quot;'  OR COD_OLO_ACCORPANTE = '&amp;quot;,$post.parameters/tns1:codiceOloAgcom,&amp;quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$post.parameters/tns1:codiceOloAgcom,&amp;quot;') ORDER BY CODFC_OLO_AGCOM&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT CODFC_OLO_AGCOM, NOME, OPERATORE, CODFC_OLO_RETE, FLAG_OLO_ACCORPANTE FROM OLO ORDER BY CODFC_OLO_AGCOM&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    timeout="10" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="MapperListaOLO-input"
                                    name="MapperListaOLO"
                                    outputVariable="MapperListaOLO"
                                    tibex:xpdlId="16e764d1-c8ff-4106-a063-61b98238fecf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="listaOLOToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperListaOLOToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;listaOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperListaOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:listaOloMapper>&#xa;            &lt;xsl:for-each select=&quot;$listaOLO/unknownResultset/row&quot;>&#xa;                &lt;tns2:listaOlo>&#xa;                    &lt;tns2:nome>&#xa;                        &lt;xsl:value-of select=&quot;column[name='NOME']/value&quot;/>&#xa;                    &lt;/tns2:nome>&#xa;                    &lt;tns2:operatore>&#xa;                        &lt;xsl:value-of select=&quot;column[name='OPERATORE']/value&quot;/>&#xa;                    &lt;/tns2:operatore>&#xa;                    &lt;tns2:codRete>&#xa;                        &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_RETE']/value&quot;/>&#xa;                    &lt;/tns2:codRete>&#xa;                    &lt;tns2:flagAccorpante>&#xa;                        &lt;xsl:value-of select=&quot;column[name='FLAG_OLO_ACCORPANTE']/value&quot;/>&#xa;                    &lt;/tns2:flagAccorpante>&#xa;                    &lt;tns2:codiceAgcom>&#xa;                        &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                    &lt;/tns2:codiceAgcom>&#xa;                &lt;/tns2:listaOlo>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:listaOloMapper>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:cliente="http://www.tim.com/NOW/cmf/cliente"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="cliente:listaOloMapper" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaIdullco/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperListaOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ListaOloPerNuovoOrdineOutput>&#xa;            &lt;tns4:profiloOlo>&#xa;                &lt;tns4:codiceAgcom>&#xa;                    &lt;xsl:value-of select=&quot;$post/parameters/tns1:anagraficaidullcoPostParameters/tns1:codiceOloAgcom&quot;/>&#xa;                &lt;/tns4:codiceAgcom>&#xa;                &lt;xsl:if test=&quot;$MapperListaOLO/tns4:listaOlo[tns4:codiceAgcom=$post/parameters/tns1:anagraficaidullcoPostParameters/tns1:codiceOloAgcom]/tns4:flagAccorpante&quot;>&#xa;                    &lt;tns4:flagAccorpante>&#xa;                        &lt;xsl:value-of select=&quot;$MapperListaOLO/tns4:listaOlo[tns4:codiceAgcom=$post/parameters/tns1:anagraficaidullcoPostParameters/tns1:codiceOloAgcom]/tns4:flagAccorpante&quot;/>&#xa;                    &lt;/tns4:flagAccorpante>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$MapperListaOLO/tns4:listaOlo&quot;>&#xa;                    &lt;tns4:anagraficaOlo>&#xa;                        &lt;tns4:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns4:nome&quot;/>&#xa;                        &lt;/tns4:nome>&#xa;                        &lt;tns4:operatore>&#xa;                            &lt;xsl:value-of select=&quot;tns4:operatore&quot;/>&#xa;                        &lt;/tns4:operatore>&#xa;                        &lt;tns4:codiceAgcom>&#xa;                            &lt;xsl:value-of select=&quot;tns4:codiceAgcom&quot;/>&#xa;                        &lt;/tns4:codiceAgcom>&#xa;                        &lt;tns4:flagAccorpante>&#xa;                            &lt;xsl:value-of select=&quot;tns4:flagAccorpante&quot;/>&#xa;                        &lt;/tns4:flagAccorpante>&#xa;                    &lt;/tns4:anagraficaOlo>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns4:profiloOlo>&#xa;        &lt;/tns4:ListaOloPerNuovoOrdineOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Variable"
                                    name="getListaOloPerOrdineOut"
                                    outputVariable="Variable"
                                    tibex:xpdlId="df662de4-634c-48f4-a28e-8e7c8a2d18f0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperListaOLOToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToEmpty1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AssignToRicercaAvanzata">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($post/item/ns2:Input_AnagraficaIdullco_RicercaAvanzata/ns2:strutturaCondition[1]/ns2:nome) >0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($post.item/ns2:strutturaCondition[1]/ns2:nome) >0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaIdullco/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperListaOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ListaOloPerNuovoOrdineOutput>&#xa;            &lt;tns4:profiloOlo>&#xa;                &lt;tns4:codiceAgcom>&#xa;                    &lt;xsl:value-of select=&quot;$post.parameters/tns1:codiceOloAgcom&quot;/>&#xa;                &lt;/tns4:codiceAgcom>&#xa;                &lt;xsl:if test=&quot;$MapperListaOLO/tns4:listaOlo[tns4:codiceAgcom=$post.parameters/tns1:codiceOloAgcom]/tns4:flagAccorpante&quot;>&#xa;                    &lt;tns4:flagAccorpante>&#xa;                        &lt;xsl:value-of select=&quot;$MapperListaOLO/tns4:listaOlo[tns4:codiceAgcom=$post.parameters/tns1:codiceOloAgcom]/tns4:flagAccorpante&quot;/>&#xa;                    &lt;/tns4:flagAccorpante>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$MapperListaOLO/tns4:listaOlo&quot;>&#xa;                    &lt;tns4:anagraficaOlo>&#xa;                        &lt;tns4:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns4:nome&quot;/>&#xa;                        &lt;/tns4:nome>&#xa;                        &lt;tns4:operatore>&#xa;                            &lt;xsl:value-of select=&quot;tns4:operatore&quot;/>&#xa;                        &lt;/tns4:operatore>&#xa;                        &lt;tns4:codiceAgcom>&#xa;                            &lt;xsl:value-of select=&quot;tns4:codiceAgcom&quot;/>&#xa;                        &lt;/tns4:codiceAgcom>&#xa;                        &lt;tns4:flagAccorpante>&#xa;                            &lt;xsl:value-of select=&quot;tns4:flagAccorpante&quot;/>&#xa;                        &lt;/tns4:flagAccorpante>&#xa;                    &lt;/tns4:anagraficaOlo>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns4:profiloOlo>&#xa;        &lt;/tns4:ListaOloPerNuovoOrdineOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
