                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaIdullco&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaIdullco/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;tipoProfilo&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;OLO&quot;/>&lt;xsl:param name=&quot;NoOLO&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;ListaIdullco&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($tipoProfilo, $post/parameters/tns1:anagraficaidullcoPostParameters/tns1:tipoProfilo) = true() and string-length(string($OLO/unknownResultset/row[1]/column[name='IDULLCO']/value)) >0&quot;>&lt;tns:Output_AnagraficaIdullco>&lt;xsl:for-each select=&quot;$OLO/unknownResultset/row&quot;>&lt;tns:listaIdullco>&lt;xsl:if test=&quot;not((string(column[name='IDULLCO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDULLCO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDULLCO']/value)&quot;>&lt;tns:IDULLCO>&lt;xsl:value-of select=&quot;column[name='IDULLCO']/value&quot;/>&lt;/tns:IDULLCO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CLLI']/value)&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;column[name='CLLI']/value&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_GAT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_GAT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_GAT']/value)&quot;>&lt;tns:CodiceGAT>&lt;xsl:value-of select=&quot;column[name='COD_GAT']/value&quot;/>&lt;/tns:CodiceGAT>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&lt;tns:CodificaOAO>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&lt;/tns:CodificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DRCP_CENTRALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DRCP_CENTRALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DRCP_CENTRALE']/value)&quot;>&lt;tns:DRCP>&lt;xsl:value-of select=&quot;column[name='DRCP_CENTRALE']/value&quot;/>&lt;/tns:DRCP>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_CENTRALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CENTRALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CENTRALE']/value)&quot;>&lt;tns:Centrale>&lt;xsl:value-of select=&quot;column[name='NOME_CENTRALE']/value&quot;/>&lt;/tns:Centrale>&lt;/xsl:if>&lt;/tns:listaIdullco>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;xsl:if test=&quot;count($OLO/unknownResultset/row)>=$MaxRows&quot;>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;LIMIT&amp;quot;&quot;/>&lt;/tns:details>&lt;/xsl:if>&lt;/tns:result>&lt;/tns:Output_AnagraficaIdullco>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($tipoProfilo, $post/parameters/tns1:anagraficaidullcoPostParameters/tns1:tipoProfilo) = false() and string-length(string($NoOLO/unknownResultset/row[1]/column[name='IDULLCO']/value)) >0&quot;>&lt;tns:Output_AnagraficaIdullco>&lt;xsl:for-each select=&quot;$NoOLO/unknownResultset/row&quot;>&lt;tns:listaIdullco>&lt;xsl:if test=&quot;not((string(column[name='IDULLCO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDULLCO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDULLCO']/value)&quot;>&lt;tns:IDULLCO>&lt;xsl:value-of select=&quot;column[name='IDULLCO']/value&quot;/>&lt;/tns:IDULLCO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CLLI']/value)&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;column[name='CLLI']/value&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_GAT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_GAT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_GAT']/value)&quot;>&lt;tns:CodiceGAT>&lt;xsl:value-of select=&quot;column[name='COD_GAT']/value&quot;/>&lt;/tns:CodiceGAT>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&lt;tns:CodificaOAO>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&lt;/tns:CodificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='DRCP_CENTRALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DRCP_CENTRALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DRCP_CENTRALE']/value)&quot;>&lt;tns:DRCP>&lt;xsl:value-of select=&quot;column[name='DRCP_CENTRALE']/value&quot;/>&lt;/tns:DRCP>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_CENTRALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CENTRALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CENTRALE']/value)&quot;>&lt;tns:Centrale>&lt;xsl:value-of select=&quot;column[name='NOME_CENTRALE']/value&quot;/>&lt;/tns:C