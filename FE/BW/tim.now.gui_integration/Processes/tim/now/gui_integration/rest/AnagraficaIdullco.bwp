                                    <bpws:links>
                                    <bpws:link
                                    name="postErrorLogToReply" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;postErrorLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaIdullco&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaIdullco&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorAnagraficaIdullco:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;            &lt;tns3:ActiveLoggerServices>&#xa;                &lt;tns3:Envelope>&#xa;                    &lt;tns3:Identifier>&#xa;                        &lt;tns3:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaIdullco&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ServiceName>&#xa;                        &lt;tns3:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Operation>&#xa;                        &lt;tns3:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns3:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns3:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns2:httpHeaders/GUI-SID,$post/httpHeaders/tns2:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns3:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns3:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns3:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaIdullco_&amp;quot;,$post/httpHeaders/tns2:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns3:EventType>&#xa;                        &lt;tns3:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaIdullco_&amp;quot;,$post/httpHeaders/tns2:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns3:trackID>&#xa;                    &lt;/tns3:Identifier>&#xa;                    &lt;tns3:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns3:track_position>&#xa;                    &lt;tns3:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns3:Timestamp>&#xa;                    &lt;tns3:ErrorLog>&#xa;                        &lt;tns3:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns3:TimeStamp>&#xa;                        &lt;tns3:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorAnagraficaIdullcoPost&amp;quot;,'SID:',$post/httpHeaders/tns2:httpHeaders/GUI-SID,'TID:',$post/httpHeaders/tns2:httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns3:Descrizione>&#xa;                        &lt;tns3:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns3:Codice>&#xa;                        &lt;tns3:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns3:track_position>&#xa;                    &lt;/tns3:ErrorLog>&#xa;                &lt;/tns3:Envelope>&#xa;            &lt;/tns3:ActiveLoggerServices>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="postErrorLog-input"
                                    name="postErrorLog"
                                    tibex:xpdlId="e038a1c2-4b26-475d-b93b-794e8b7a1280"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="postErrorLogToReply"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;postErrorLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaIdullco&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaIdullco&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorAnagraficaIdullco:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;            &lt;tns3:ActiveLoggerServices>&#xa;                &lt;tns3:Envelope>&#xa;                    &lt;tns3:Identifier>&#xa;                        &lt;tns3:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaIdullco&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ServiceName>&#xa;                        &lt;tns3:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Operation>&#xa;                        &lt;tns3:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns3:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns3:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns3:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns3:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns3:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaIdullco_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns3:EventType>&#xa;                        &lt;tns3:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaIdullco_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns3:trackID>&#xa;                    &lt;/tns3:Identifier>&#xa;                    &lt;tns3:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns3:track_position>&#xa;                    &lt;tns3:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns3:Timestamp>&#xa;                    &lt;tns3:ErrorLog>&#xa;                        &lt;tns3:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns3:TimeStamp>&#xa;                        &lt;tns3:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorAnagraficaIdullcoPost&amp;quot;,'SID:',$post.httpHeaders/GUI-SID,'TID:',$post.httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns3:Descrizione>&#xa;                        &lt;tns3:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns3:Codice>&#xa;                        &lt;tns3:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns3:track_position>&#xa;                    &lt;/tns3:ErrorLog>&#xa;                &lt;/tns3:Envelope>&#xa;            &lt;/tns3:ActiveLoggerServices>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    spawn="true"
