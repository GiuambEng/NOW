                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficheVLANVP&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record/ID_CENTRALE_GBE_CRMWS)>0&quot;>&lt;tns:outputAnagraficaCentraliGBE>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns:listaCentraliGBE>&lt;tns:codiceClli>&lt;xsl:value-of select=&quot;CODICE_CLLI&quot;/>&lt;/tns:codiceClli>&lt;tns:codiceIdbre>&lt;xsl:value-of select=&quot;CODICE_IDBRE&quot;/>&lt;/tns:codiceIdbre>&lt;tns:descrizioneClli>&lt;xsl:value-of select=&quot;DESCRIZIONE_CLLI&quot;/>&lt;/tns:descrizioneClli>&lt;tns:comune>&lt;xsl:value-of select=&quot;COMUNE&quot;/>&lt;/tns:comune>&lt;tns:distretto>&lt;xsl:value-of select=&quot;DISTRETTO&quot;/>&lt;/tns:distretto>&lt;xsl:if test=&quot;TIPOLOGIA_DSLAM&quot;>&lt;tns:tipologiaDslam>&lt;xsl:value-of select=&quot;TIPOLOGIA_DSLAM&quot;/>&lt;/tns:tipologiaDslam>&lt;/xsl:if>&lt;tns:nomeCentrale>&lt;xsl:value-of select=&quot;NOME_CENTRALE&quot;/>&lt;/tns:nomeCentrale>&lt;tns:stato>&lt;xsl:value-of select=&quot;STATO&quot;/>&lt;/tns:stato>&lt;tns:flagQNQ>&lt;xsl:value-of select=&quot;FLAG_QNQ&quot;/>&lt;/tns:flagQNQ>&lt;xsl:if test=&quot;FLAG_LONG_DISTANCE&quot;>&lt;tns:flagLongDistance>&lt;xsl:value-of select=&quot;FLAG_LONG_DISTANCE&quot;/>&lt;/tns:flagLongDistance>&lt;/xsl:if>&lt;tns:dataAttivazione>&lt;xsl:value-of select=&quot;format-date(xsd:date(DATA_ATTIVAZIONE), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:dataAttivazione>&lt;xsl:if test=&quot;FLAG_PRONTO_VENDITA&quot;>&lt;tns:flagProntoVendita>&lt;xsl:value-of select=&quot;FLAG_PRONTO_VENDITA&quot;/>&lt;/tns:flagProntoVendita>&lt;/xsl:if>&lt;/tns:listaCentraliGBE>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputAnagraficaCentraliGBE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputAnagraficaCentraliGBE>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record presente in lista.&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputAnagraficaCentraliGBE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
