                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="Assign"
                                    outputVariable="Variable"
                                    tibex:xpdlId="35e86cbb-840f-4aef-a164-06478feb969f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
