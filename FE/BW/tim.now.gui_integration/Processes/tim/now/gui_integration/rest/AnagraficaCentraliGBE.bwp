                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaCentraliGBE_LogInfo">
            <endingVariables>
                <variable>AnagraficaCentraliGBE_LogInfo-input</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery">
            <endingVariables>
                <variable>JDBCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaCentraliGBE_LogOutput">
            <endingVariables>
