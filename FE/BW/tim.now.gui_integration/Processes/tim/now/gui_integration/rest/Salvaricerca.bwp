    xmlns:tns0="http://xmlns.example.com/Salvaricerca/parameters" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>post</variable>
                <variable>get</variable>
                <variable>delete</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
            </endingVariables>
        </task>
        <task name="RenderXml">
            <endingVariables>
                <variable>RenderXml-input</variable>
            </endingVariables>
        </task>
        <task name="SalvariercaInserte">
            <endingVariables>
                <variable>SalvariercaInserte-input</variable>
                <variable>RenderXml</variable>
            </endingVariables>
        </task>
        <task name="Salvaricercapost_InputLog">
            <endingVariables>
                <variable>Salvaricercapost_InputLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="Salvaricercaost_OutputLog">
            <endingVariables>
                <variable>Salvaricercaost_OutputLog-input</variable>
                <variable>SalvariercaInserte</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="Salvaricercapost_InputLog_INFO">
            <endingVariables>
                <variable>Salvaricercapost_InputLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="post_Errore_Reply">
            <endingVariables>
                <variable>post_Errore_Reply-input</variable>
                <variable>ErrorMapper</variable>
            </endingVariables>
        </task>
        <task name="post_Salvaricercapost_Error">
