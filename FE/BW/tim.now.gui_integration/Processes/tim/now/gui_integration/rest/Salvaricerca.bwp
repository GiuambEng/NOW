<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no"
    name="tim.now.gui_integration.rest.Salvaricerca"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20160613181323"
