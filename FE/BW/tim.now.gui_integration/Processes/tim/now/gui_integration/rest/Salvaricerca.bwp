                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="ErrorMapper">
            <endingVariables>
                <variable>ErrorMapper-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="get_salvarier">
            <endingVariables>
                <variable>get_salvarier-input</variable>
            </endingVariables>
        </task>
        <task name="Empty_Mapper">
            <endingVariables>
                <variable>Empty_Mapper-input</variable>
                <variable>Empty_Mapper</variable>
            </endingVariables>
        </task>
        <task name="Iterate">
            <endingVariables>
                <variable>Mapper</variable>
                <variable>currentElement</variable>
            </endingVariables>
        </task>
        <task name="ParseXml">
            <endingVariables>
                <variable>ParseXml-input</variable>
            </endingVariables>
        </task>
        <task name="Mapper">
            <endingVariables>
                <variable>Mapper-input</variable>
                <variable>ParseXml</variable>
            </endingVariables>
        </task>
        <task name="get_Salvaricerca_InputLog">
            <endingVariables>
                <variable>get_Salvaricerca_InputLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_Salvaricerca_InputLog_INFO">
            <endingVariables>
                <variable>get_Salvaricerca_InputLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>get_salvarier</variable>
                <variable>Accumulate</variable>
            </endingVariables>
        </task>
        <task name="Salvaricercapost_OutputLog">
            <endingVariables>
                <variable>CallProcess2-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails1</variable>
            </endingVariables>
        </task>
        <task name="get_Salvaricercaget_Erro">
            <endingVariables>
                <variable>get_Salvaricercaget_Erro-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="deleteOut">
            <endingVariables>
                <variable>deleteOut-input</variable>
            </endingVariables>
        </task>
        <task name="JDBCUpdate">
            <endingVariables>
                <variable>JDBCUpdate-input</variable>
            </endingVariables>
        </task>
        <task name="deleteAssignOK">
            <endingVariables>
                <variable>JDBCUpdate</variable>
            </endingVariables>
        </task>
        <task name="SalvaRicerca_InputMsg_Log">
            <endingVariables>
                <variable>SalvaRicerca_InputMsg_Log-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="SalvaRicerca_InputMsg_Log1">
            <endingVariables>
                <variable>SalvaRicerca_InputMsg_Log1-input</variable>
            </endingVariables>
        </task>
        <task name="SalvaRicerca_OutputMsg_Log">
            <endingVariables>
                <variable>SalvaRicerca_OutputMsg_Log-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="ReplySalvaRicercaError">
