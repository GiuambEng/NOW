                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0044b7c6-d1f5-49d4-878e-10e6728be65e+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/Salvaricerca/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;get_salvarier-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;USERID>&lt;xsl:value-of select=&quot;$get/parameters/tns1:salvaricercaGetParameters/tns1:user_id&quot;/>&lt;/USERID>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns1:salvaricercaGetParameters/tns1:cod_funzione=upper-case('VLAN SVLAN')&quot;>&lt;COD_FUNZIONE>&lt;xsl:value-of select=&quot;'VLAN/SVLAN'&quot;/>&lt;/COD_FUNZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;COD_FUNZIONE>&lt;xsl:value-of select=&quot;$get/parameters/tns1:salvaricercaGetParameters/tns1:cod_funzione&quot;/>&lt;/COD_FUNZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_salvarier-input"
                                    name="get_salvarier"
                                    outputVariable="get_salvarier"
                                    tibex:xpdlId="0044b7c6-d1f5-49d4-878e-10e6728be65e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1Toget_salvarier"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="get_NoXmlRecord">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="get_Datidisponibili">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="not(empty($get_salvarier/Record/FILTRO))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[not(empty($get_salvarier/Record/FILTRO))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0044b7c6-d1f5-49d4-878e-10e6728be65e+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/Salvaricerca/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;get_salvarier-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;USERID>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:user_id&quot;/>&#xa;            &lt;/USERID>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns1:cod_funzione=upper-case('VLAN SVLAN')&quot;>&#xa;                    &lt;COD_FUNZIONE>&#xa;                        &lt;xsl:value-of select=&quot;'VLAN/SVLAN'&quot;/>&#xa;                    &lt;/COD_FUNZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COD_FUNZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:cod_funzione&quot;/>&#xa;                    &lt;/COD_FUNZIONE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT *  FROM UTENTE_FILTRO_FUNZIONE WHERE USERID=? AND COD_FUNZIONE=? &#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="USERID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_FUNZIONE"/>
                                    <columnMetadata
                                    columnName="COD_FUNZIONE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FILTRO"
                                    dataType="2005" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="NOME_FILTRO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="USERID"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Empty_Mapper-input"
                                    name="Empty_Mapper"
                                    outputVariable="Empty_Mapper"
