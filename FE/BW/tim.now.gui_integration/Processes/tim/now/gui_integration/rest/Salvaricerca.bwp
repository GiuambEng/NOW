                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($get_salvarier/Record)]]></bpws:finalCounterValue>
                                    <bpws:scope name="innerScope">
                                    <bpws:variables>
                                    <bpws:variable
                                    element="ns7:Iterate_Current_Element_Record"
                                    name="currentElement" sca-bpel:internal="true"/>
                                    </bpws:variables>
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="ParseXmlToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToParseXml" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MapperToGroupEnd" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart"
                                    tibex:group="groupStart"
