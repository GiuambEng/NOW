                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Salvaricerca&quot; xmlns:tns1=&quot;http://xmlns.example.com/Salvaricerca/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Salvaricerca_Output>&lt;tns:Salvaricerca_Output>&lt;xsl:copy-of select=&quot;$ParseXml/tns:strutturaCondition&quot;/>&lt;xsl:if test=&quot;$currentElement/DESCR&quot;>&lt;tns:DESCR>&lt;xsl:value-of select=&quot;$currentElement/DESCR&quot;/>&lt;/tns:DESCR>&lt;/xsl:if>&lt;tns:NOME_FILTRO>&lt;xsl:value-of select=&quot;$currentElement/NOME_FILTRO&quot;/>&lt;/tns:NOME_FILTRO>&lt;tns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;substring-before(string($currentElement/TIMSTP_INSMTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:TIMSTP_INSMTO>&lt;tns:USERID>&lt;xsl:value-of select=&quot;$currentElement/USERID&quot;/>&lt;/tns:USERID>&lt;tns:COD_FUNZIONE>&lt;xsl:value-of select=&quot;$currentElement/COD_FUNZIONE&quot;/>&lt;/tns:COD_FUNZIONE>&lt;/tns:Salvaricerca_Output>&lt;tns:result/>&lt;/tns:Salvaricerca_Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:Salvaricerca="http://www.tim.com/NOW/rest/Salvaricerca"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
