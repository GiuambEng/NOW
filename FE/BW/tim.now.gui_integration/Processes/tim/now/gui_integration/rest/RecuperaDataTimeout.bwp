    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>get1</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="getOut1">
            <endingVariables>
                <variable>getOut1-input</variable>
                <variable>GetTimeOutBPM</variable>
            </endingVariables>
        </task>
        <task name="GetTimeOutBPM">
            <endingVariables>
                <variable>GetTimeOutBPM-input</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperaDataTimeout_InLog">
            <endingVariables>
                <variable>get_RecuperaDataTimeout_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperaDataTimeout_InLog_INFO">
            <endingVariables>
                <variable>get_RecuperaDataTimeout_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="get_RecuperaDataTimeout_outp_Log">
            <endingVariables>
                <variable>get_RecuperaDataTimeout_outp_Log-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="ErrorLogRecuperaDataTimeoutGet">
            <endingVariables>
                <variable>ErrorLogRecuperaDataTimeoutGet-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="ReplyRecuperaDataTimeout">
            <endingVariables>
                <variable>ReplyRecuperaDataTimeout-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
