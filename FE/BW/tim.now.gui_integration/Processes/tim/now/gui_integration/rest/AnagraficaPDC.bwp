                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficheVLANVP&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record/ID_CENTRALE_PDC_CRMWS)>0&quot;>&lt;tns:outputAnagraficaPDC>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns:listaPDC>&lt;tns:codicePDC>&lt;xsl:value-of select=&quot;CODICE_PDC&quot;/>&lt;/tns:codicePDC>&lt;tns:nomeCentralePDC>&lt;xsl:value-of select=&quot;NOME_CENTRALE_PDC&quot;/>&lt;/tns:nomeCentralePDC>&lt;xsl:if test=&quot;RO_PDC&quot;>&lt;tns:roPDC>&lt;xsl:value-of select=&quot;RO_PDC&quot;/>&lt;/tns:roPDC>&lt;/xsl:if>&lt;tns:viaPDC>&lt;xsl:value-of select=&quot;VIA_PDC&quot;/>&lt;/tns:viaPDC>&lt;tns:comune>&lt;xsl:value-of select=&quot;COMUNE&quot;/>&lt;/tns:comune>&lt;tns:codiceClliPDC>&lt;xsl:value-of select=&quot;CODICE_CLLI_PDC&quot;/>&lt;/tns:codiceClliPDC>&lt;tns:descrizioneClliPDC>&lt;xsl:value-of select=&quot;DESCRIZIONE_CLLI_PDC&quot;/>&lt;/tns:descrizioneClliPDC>&lt;tns:codiceIdbre>&lt;xsl:value-of select=&quot;CODICE_IDBRE&quot;/>&lt;/tns:codiceIdbre>&lt;tns:regionePDC>&lt;xsl:value-of select=&quot;REGIONE_PDC&quot;/>&lt;/tns:regionePDC>&lt;tns:provincia>&lt;xsl:value-of select=&quot;PROVINCIA&quot;/>&lt;/tns:provincia>&lt;tns:stato>&lt;xsl:value-of select=&quot;STATO&quot;/>&lt;/tns:stato>&lt;tns:idoneitaPopPDC>&lt;xsl:value-of select=&quot;IDONEITA_POP_PDC&quot;/>&lt;/tns:idoneitaPopPDC>&lt;xsl:if test=&quot;IDONEITA_NGA_PDC&quot;>&lt;tns:idoneitaNgaPDC>&lt;xsl:value-of select=&quot;IDONEITA_NGA_PDC&quot;/>&lt;/tns:idoneitaNgaPDC>&lt;/xsl:if>&lt;tns:raccoltaTerminatingPDC>&lt;xsl:value-of select=&quot;RACCOLTA_TERM_PDC&quot;/>&lt;/tns:raccoltaTerminatingPDC>&lt;/tns:listaPDC>&lt;/xsl:for-each>&lt;