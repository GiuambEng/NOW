    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaPDC_LogInput">
            <endingVariables>
                <variable>AnagraficaPDC_LogInput-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaPDC_LogInfo">
            <endingVariables>
                <variable>AnagraficaPDC_LogInfo-input</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaPDC_LogOutput">
            <endingVariables>
                <variable>AnagraficaPDC_LogOutput-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery">
            <endingVariables>
                <variable>JDBCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="AnagraficaPDC_LogError">
            <endingVariables>
                <variable>AnagraficaPDC_LogError-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
