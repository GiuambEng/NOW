                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/CaricamentoFileDaGui&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns:outputcaricamentofiledagui>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'DUPLICATEFILE'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'FILE GIA PRESENTE'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputcaricamentofiledagui>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
