                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/CaricamentoFileDaGui&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Path&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Path, &amp;quot;/&amp;quot;,$post/item/tns1:inputcaricamentofiledagui/tns1:nomefile)&quot;/>&lt;/fileName>&lt;textContent>&lt;xsl:value-of select=&quot;tib:base64-to-string($post/item/tns1:inputcaricamentofiledagui/tns1:contenutofile)&quot;/>&lt;/textContent>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>"
