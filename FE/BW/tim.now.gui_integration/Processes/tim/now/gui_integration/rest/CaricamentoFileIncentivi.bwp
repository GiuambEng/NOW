                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1ca0ca4a-6f39-4f5a-878f-a799d72bb474+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/CaricamentoFileDaGui&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;CheckProgressivo-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT NOME_FILE FROM FILE_PROCSTO WHERE NOME_FILE LIKE '&amp;quot;,substring($post/item/tns1:inputcaricamentofiledagui/tns1:nomefile, 1, string-length($post/item/tns1:inputcaricamentofiledagui/tns1:nomefile)-7),&amp;quot;%' AND NOME_FILE NOT LIKE '%.TAPPO' ORDER BY NOME_FILE DESC&amp;quot;)&quot;/>&lt;/statement>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CheckProgressivo-input"
                                    name="CheckProgressivo"
                                    outputVariable="CheckProgressivo"
                                    tibex:xpdlId="1ca0ca4a-6f39-4f5a-878f-a799d72bb474" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckFileGiaEsistenteToSQLDirect_Progressivo"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SQLDirectToListFiles">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CheckProgressivoToAssign_ProgressivoObsoleto">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="compare($post/item/ns2:inputcaricamentofiledagui/ns2:nomefile, $CheckProgressivo/unknownResultset[1]/row[1]/column[name='NOME_FILE']/value)&lt;0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0"><![CDATA[compare($post.item/ns2:nomefile, $CheckProgressivo/unknownResultset[1]/row[1]/column[name='NOME_FILE']/value)<0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1ca0ca4a-6f39-4f5a-878f-a799d72bb474+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/CaricamentoFileDaGui&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckProgressivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT NOME_FILE FROM FILE_PROCSTO WHERE NOME_FILE LIKE '&amp;quot;,substring($post.item/tns1:nomefile, 1, string-length($post.item/tns1:nomefile)-7),&amp;quot;%' AND NOME_FILE NOT LIKE '%.TAPPO' ORDER BY NOME_FILE DESC&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
