                                    <tibex:expression
                                    expression="$CheckFileGiaEsistente/Record[1]/COUNTNOMEFILE>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CheckFileGiaEsistente/Record[1]/COUNTNOMEFILE>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CheckFileGiaEsistenteToSQLDirect_Progressivo">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CheckFileGiaEsistenteToListFiles_NoProgressivo">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CheckFileGiaEsistente/Record[1]/COUNTNOMEFILE = 0 and (contains($post/item/ns2:inputcaricamentofiledagui/ns2:nomefile, 'NOW_CLLI_OLD_INCENTIVI_OAO_SWITCHOFF') or contains($post/item/ns2:inputcaricamentofiledagui/ns2:nomefile, 'NOW_CLLI_NEW_INCENTIVI_OAO_SWITCHOFF') or contains($post/item/ns2:inputcaricamentofiledagui/ns2:nomefile, 'NOW_INCENTIVI_OAO_SWITCHOFF'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CheckFileGiaEsistente/Record[1]/COUNTNOMEFILE = 0 and (contains($post.item/ns2:nomefile, 'NOW_CLLI_OLD_INCENTIVI_OAO_SWITCHOFF') or contains($post.item/ns2:nomefile, 'NOW_CLLI_NEW_INCENTIVI_OAO_SWITCHOFF') or contains($post.item/ns2:nomefile, 'NOW_INCENTIVI_OAO_SWITCHOFF'))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f2085d6e-c60d-4fa5-ac0d-08679db90be2+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/CaricamentoFileDaGui&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckFileGiaEsistente-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;nomeFile>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:nomefile)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:nomefile&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/nomeFile>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
