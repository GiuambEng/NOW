            &lt;xsl:when test=&quot;exists($post1.item/tns1:Titolo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns1:Titolo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TITOLO>&#xa;            &lt;NOTE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1.item/tns1:Note)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns1:Note&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOTE>&#xa;            &lt;OPERATORE_ULTIMO_AGGTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1.item/tns1:OPERATORE_ULTIMO_AGGTO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns1:OPERATORE_ULTIMO_AGGTO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OPERATORE_ULTIMO_AGGTO>&#xa;            &lt;IDTPLG_MENU_HELP>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($post1.item/tns1:Id_Ambito)&quot;/>&#xa;            &lt;/IDTPLG_MENU_HELP>&#xa;            &lt;ID_HELP>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($post1.item/tns1:Id_IHelp)&quot;/>&#xa;            &lt;/ID_HELP>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLang