                                    sqlStatement="UPDATE HELP&#xa;SET CONTENUTO = ?, TIMSTP_AGGTO = ?, FLAG_VISIBILITA = ?, TITOLO = ?,&#xa;      NOTE = ?, OPERATORE_ULTIMO_AGGTO = ?, IDTPLG_MENU_HELP = ?&#xa;WHERE ID_HELP = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

