                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/IHelp&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Lista&quot;/>&lt;xsl:template name=&quot;iHelpVariable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Lista/Record)&quot;>&lt;tns:IHelpOutput>&lt;xsl:for-each select=&quot;$Lista/Record&quot;>&lt;tns:IHelpOutput>&lt;tns:Data_inserimento>&lt;xsl:value-of select=&quot;substring-before(string (TIMSTP_INSMTO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:Data_inserimento>&lt;tns:Data_aggiornamento>&lt;xsl:value-of select=&quot;substring-before(string (TIMSTP_AGGTO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:Data_aggiornamento>&lt;tns:Visibile>&lt;xsl:value-of select=&quot;FLAG_VISIBILITA&quot;/>&lt;/tns:Visibile>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/tns:Operatore>&lt;xsl:if test=&quot;NOTE&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;NOTE&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;tns:Titolo>&lt;xsl:value-of select=&quot;TITOLO&quot;/>&lt;/tns:Titolo>&lt;tns:Contenuto>&lt;xsl:value-of select=&quot;CONTENUTO&quot;/>&lt;/tns:Contenuto>&lt;tns:Id_IHelp>&lt;xsl:value-of select=&quot;xsd:int(ID_HELP)&quot;/>&lt;/tns:Id_IHelp>&lt;xsl:if test=&quot;OPERATORE_ULTIMO_AGGTO&quot;>&lt;tns:OPERATORE_ULTIMO_AGGTO>&lt;xsl:value-of select=&quot;OPERATORE_ULTIMO_AGGTO&quot;/>&lt;/tns:OPERATORE_ULTIMO_AGGTO>&lt;/xsl:if>&lt;tns:Id_Ambito>&lt;xsl:value-of select=&quot;xsd:int(IDTPLG_MENU_HELP)&quot;/>&lt;/tns:Id_Ambito>&lt;xsl:if test=&quot;DESCR_MENU_HELP&quot;>&lt;tns:Desc_Ambito>&lt;xsl:value-of select=&quot;DESCR_MENU_HELP&quot;/>&lt;/tns:Desc_Ambito>&lt;/xsl:if>&lt;/tns:IHelpOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:IHelpOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IHelpOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:IHelpOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
