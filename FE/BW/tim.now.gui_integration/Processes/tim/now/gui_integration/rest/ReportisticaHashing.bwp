                                <bpws:sources>
                                    <bpws:source linkName="WhileToIdReport">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="WhileToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$FlagCiclo = true() and count($post/item/ns1:NuovoReportInput/ns1:strutturaCondition/ns1:nome)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$FlagCiclo = true() and count($post.item/ns1:strutturaCondition/ns1:nome)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence" tibex:group="while">
                                    <bpws:assign name="GroupInit"
                                    tibex:group="groupInit"
                                    tibex:xpdlId="5268b7c4-2579-420d-b232-6a628d5ba905" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+2c0da1d1-4517-400f-af22-62d102a86904" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:while name="while" tibex:counterName="index">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index&lt;=count($post/item/ns1:NuovoReportInput/ns1:strutturaCondition/ns1:nome) and $FlagCiclo=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($post.item/ns1:strutturaCondition/ns1:nome) and $FlagCiclo=true()]]></bpws:condition>
                                    <bpws:flow name="flow7">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStartToLog" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="LogToGet_Multiple_Hash" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Get_Multiple_HashToLog1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Log1ToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Get_Multiple_HashToLog2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
