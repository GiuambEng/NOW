                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8b0b27e1-7d4f-49b7-b7b8-b824b793f10c+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.example.org/ReportisticaHashing&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagCiclo&quot;/>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;IdReport&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertReport-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagCiclo = false()&quot;>&#xa;                    &lt;filtroReport>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/filtroReport>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:tipoLista = 'DONATING' &quot;>&#xa;                    &lt;filtroReport>&#xa;                        &lt;xsl:value-of select=&quot;tib:substring-before-last(concat(if(string-length($post.item/tns2:codOrdineTi)>0) then concat(&amp;quot;CODICEORDINETI = '&amp;quot;,$post.item/tns2:codOrdineTi,&amp;quot;' AND &amp;quot;) else &amp;quot;&amp;quot;,if(string-length($post.item/tns2:nomeFileNotifica)>0) then concat(&amp;quot;NOMEFILENOTIFICA = '&amp;quot;,$post.item/tns2:nomeFileNotifica,&amp;quot;' AND &amp;quot;) else &amp;quot;&amp;quot;,if(string-length($post.item/tns2:idRisorsa)>0) then concat(&amp;quot;IDRISORSA = '&amp;quot;,$post.item/tns2:idRisorsa,&amp;quot;' AND &amp;quot;) else &amp;quot;&amp;quot;,if(string-length($post.item/tns2:codiceSessione)>0) then concat(&amp;quot;CODICESESSIONE = '&amp;quot;,$post.item/tns2:codiceSessione,&amp;quot;' AND &amp;quot;) else &amp;quot;&amp;quot;), &amp;quot;AND&amp;quot;)&quot;/>&#xa;                    &lt;/filtroReport>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;filtroReport>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RicercaAvanzata/tns1:outputcondition[1])&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RicercaAvanzata/tns1:outputcondition[1]&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/filtroReport>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagCiclo = false()&quot;>&#xa;                    &lt;idStatoElab>&#xa;                        &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                    &lt;/idStatoElab>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;idStatoElab>&#xa;                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                    &lt;/idStatoElab>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;nomeReport>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns2:nomeReport)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns2:nomeReport&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/nomeReport>&#xa;            &lt;operatore>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns2:operatore)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns2:operatore&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/operatore>&#xa;            &lt;tmstpAgg>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tmstpAgg>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:tipoLista='TUTTI'&quot;>&#xa;                    &lt;idTipoLista>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/idTipoLista>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:tipoLista='SOSPESO'&quot;>&#xa;                    &lt;idTipoLista>&#xa;                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                    &lt;/idTipoLista>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:tipoLista='ACCODATO'&quot;>&#xa;                    &lt;idTipoLista>&#xa;                        &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                    &lt;/idTipoLista>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:tipoLista='OPERASPECIALE'&quot;>&#xa;                    &lt;idTipoLista>&#xa;                        &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                    &lt;/idTipoLista>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:tipoLista='DONATING'&quot;>&#xa;                    &lt;idTipoLista>&#xa;                        &lt;xsl:value-of select=&quot;5&quot;/>&#xa;                    &lt;/idTipoLista>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;idTipoLista>&#xa;                        &lt;xsl:value-of select=&quot;6&quot;/>&#xa;                    &lt;/idTipoLista>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagCiclo = false()&quot;>&#xa;                    &lt;descrErrore>&#xa;                        &lt;xsl:value-of select=&quot;'Indisponibilità SECOLO'&quot;/>&#xa;                    &lt;/descrErrore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;descrErrore>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/descrErrore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;idReport>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IdReport/Record[1]/NEXTVAL)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IdReport/Record[1]/NEXTVAL&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idReport>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO &#xa;STORICO_RPRT_HASH &#xa;(FILTRO_REPORT,ID_STATO_ELAB_STAG,NOME_REPORT,OPERATORE,&#xa;TIMESTAMP_AGGIORNAMENTO,ID_TIPOLOGIA_REPORT,DESCRIZIONE_ERRORE,&#xa;ID_STORICO_REPORT_HASH) &#xa;VALUES &#xa;(?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="filtroReport"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="idStatoElab"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="nomeReport"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="operatore"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="tmstpAgg"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="idTipoLista"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="descrErrore"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="idReport"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
