ame&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.ListaReport&amp;quot;&amp;#x9;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ListaReport_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ListaReport_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                    &lt;tns:ErrorLog/>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RecuperaLista-input"
                                    name="RecuperaLista"
                                    outputVariable="RecuperaLista"
                                    tibex:xpdlId="0b721ceb-4e7f-4638-8542-064dec6cb444" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ListaReport_LogInfoToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperaListaToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0b721ceb-4e7f-4638-8542-064dec6cb444+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT R.NOME_REPORT,TR.TIPOLOGIA_REPORT,R.TIMESTAMP_INSERIMENTO,R.TIMESTAMP_AGGIORNAMENTO,&#xa;TSR.DESCRIZIONE_STATO_REPORT,R.DESCRIZIONE_ERRORE,R.ID_STORICO_REPORT_HASH&#xa;FROM STORICO_RPRT_HASH R INNER JOIN TIPOLOGIA_REPORT TR ON R.ID_TIPOLOGIA_REPORT = TR.ID_TIPOLOGIA_REPORT&#xa;INNER JOIN TIPOLOGIA_STATO_REPORT TSR ON R.ID_STATO_ELAB_STAG = TSR.ID_STATO_REPORT&#xa;ORDER BY R.TIMESTAMP_INSERIMENTO DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="NOME_REPORT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIA_REPORT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMESTAMP_INSERIMENTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMESTAMP_AGGIORNAMENTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE_STATO_REPORT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE_ERRORE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="ID_STORICO_REPORT_HASH"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ListaReportOutput"
                                    name="Assign1"
                                    outputVariable="ListaReportOutput"
                                    tibex:xpdlId="9ca9484d-b93d-4077-aafc-d17494330385" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RecuperaListaToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToListaReport_LogOutput"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ReportisticaHashing&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperaLista&quot;/>&lt;xsl:template name=&quot;ListaReportOutput&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperaLista/Record/ID_STORICO_REPORT_HASH)>0&quot;>&lt;tns:ListaReportOutput>&lt;xsl:for-each select=&quot;$RecuperaLista/Record&quot;>&lt;tns:outputListaReport>&lt;tns:nomeReport>&lt;xsl:value-of select=&quot;NOME_REPORT&quot;/>&lt;/tns:nomeReport>&lt;tns:tipoLista>&lt;xsl:value-of select=&quot;TIPOLOGIA_REPORT&quot;/>&lt;/tns:tipoLista>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TIMESTAMP_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;xsl:if test=&quot;TIMESTAMP_AGGIORNAMENTO&quot;>&lt;tns:dataAggiornamento>&lt;xsl:value-of select=&quot;TIMESTAMP_AGGIORNAMENTO&quot;/>&lt;/tns:dataAggiornamento>&lt;/xsl:if>&lt;tns:statoElabReport>&lt;xsl:value-of select=&quot;DESCRIZIONE_STATO_REPORT&quot;/>&lt;/tns:statoElabReport>&lt;xsl:if test=&quot;DESCRIZIONE_ERRORE&quot;>&lt;tns:dettaglioElabReport>&lt;xsl:value-of select=&quot;DESCRIZIONE_ERRORE&quot;/>&lt;/tns:dettaglioElabReport>&lt;/xsl:if>&lt;tns:idReport>&lt;xsl:value-of select=&quot;xsd:string(ID_STORICO_REPORT_HASH)&quot;/>&lt;/tns:idReport>&lt;/tns:outputListaReport>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:ListaReportOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ListaReportOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record presente in lista.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:ListaReportOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ListaReportOutput" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
