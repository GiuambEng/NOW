                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerError&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;NuovoReport_LogError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NuovoReport&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.NuovoReport&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Error_NuovoReport:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerError&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.NuovoReport&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventID>&lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns1:httpHeaders/GUI-SID,$post/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&lt;/tns:EventID>&lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;NuovoReport_&amp;quot;,$post/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;NuovoReport_&amp;quot;,$post/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;tns:ErrorLog>&lt;tns:TimeStamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TimeStamp>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;concat(&amp;quot;Error_NuovoReport&amp;quot;,'SID:',$post/httpHeaders/tns1:httpHeaders/GUI-SID,'TID:',$post/httpHeaders/tns1:httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&lt;/tns:Descrizione>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&lt;/tns:Codice>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;/tns:ErrorLog>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
