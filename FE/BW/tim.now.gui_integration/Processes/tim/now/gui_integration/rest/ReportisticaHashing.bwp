                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ReportisticaHashing&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&lt;tns1:inputservizioricercaavanzata>&lt;xsl:for-each select=&quot;$Accumulate/tns:HashingRicercaStrutturaCondition&quot;>&lt;tns1:strutturaCondition>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;tns1:nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/tns1:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:operazione&quot;>&lt;tns1:operazione>&lt;xsl:value-of select=&quot;tns:operazione&quot;/>&lt;/tns1:operazione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:valore&quot;>&lt;tns1:valore>&lt;xsl:value-of select=&quot;tns:valore&quot;/>&lt;/tns1:valore>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:tipo&quot;>&lt;tns1:tipo>&lt;xsl:value-of select=&quot;tns:tipo&quot;/>&lt;/tns1:tipo>&lt;/xsl:if>&lt;/tns1:strutturaCondition>&lt;/xsl:for-each>&lt;tns1:exportRequest>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:exportRequest>&lt;/tns1:inputservizioricercaavanzata>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
