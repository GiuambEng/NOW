                                    operation="Get_Multiple_Hash"
                                    outputVariable="Get_Multiple_Hash"
                                    partnerLink="NOW_SECOLO_HASH_PortType"
                                    portType="ns14:NOW_SECOLO_HASH_PortType" tibex:xpdlId="53999986-329a-40d8-9e6e-bf56536bb8bc">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/NOW_SECOLO_HASH/" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SECOLO_HASH/" xmlns:tns1="http://www.example.org/ReportisticaHashing" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="post"/&gt;&lt;xsl:template name="Get_Multiple_Hash-input" match="/"&gt;&lt;ns:Get_Multiple_Hash_Secolo_Request&gt;&lt;Input&gt;&lt;tns:RequestGet_Multiple_Hash_Secolo&gt;&lt;tns:Funzione&gt;&lt;xsl:value-of select="concat('RICERCA',$post/item/tns1:NuovoReportInput/tns1:tipoLista)"/&gt;&lt;/tns:Funzione&gt;&lt;tns:ChiaveRiferimento&gt;&lt;xsl:value-of select="concat($post/item/tns1:NuovoReportInput/tns1:tipoLista,'&amp;amp;',string(tib:timestamp()))"/&gt;&lt;/tns:ChiaveRiferimento&gt;&lt;xsl:if test="$post/item/tns1:NuovoReportInput/tns1:operatore"&gt;&lt;tns:Operatore&gt;&lt;xsl:value-of select="$post/item/tns1:NuovoReportInput/tns1:operatore"/&gt;&lt;/tns:Operatore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns1:NuovoReportInput/tns1:ipClient"&gt;&lt;tns:IPClient&gt;&lt;xsl:value-of select="$post/item/tns1:NuovoReportInput/tns1:ipClient"/&gt;&lt;/tns:IPClient&gt;&lt;/xsl:if&gt;&lt;tns:HashIN&gt;&lt;tns:key&gt;&lt;xsl:value-of select="'FILTRO'"/&gt;&lt;/tns:key&gt;&lt;xsl:if test="$post/item/tns1:NuovoReportInput/tns1:strutturaCondition[$index]/tns1:valore"&gt;&lt;tns:value&gt;&lt;xsl:value-of select="$post/item/tns1:NuovoReportInput/tns1:strutturaCondition[$index]/tns1:valore"/&gt;&lt;/tns:value&gt;&lt;/xsl:if&gt;&lt;/tns:HashIN&gt;&lt;tns:Bonifica&gt;&lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;&lt;/tns:Bonifica&gt;&lt;/tns:RequestGet_Multiple_Hash_Secolo&gt;&lt;/Input&gt;&lt;/ns:Get_Multiple_Hash_Secolo_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/NOW_SECOLO_HASH/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_HASH/&quot; xmlns:tns1=&quot;http://www.example.org/ReportisticaHashing&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Get_Multiple_Hash-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RequestGet_Multiple_Hash_Secolo>&#xa;            &lt;tns:Funzione>&#xa;                &lt;xsl:value-of select=&quot;concat('RICERCA',$post.item/tns1:tipoLista)&quot;/>&#xa;            &lt;/tns:Funzione>&#xa;            &lt;tns:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat($post.item/tns1:tipoLista,'&amp;amp;',string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns:ChiaveRiferimento>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:operatore&quot;>&#xa;                &lt;tns:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:operatore&quot;/>&#xa;                &lt;/tns:Operatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:ipClient&quot;>&#xa;                &lt;tns:IPClient>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:ipClient&quot;/>&#xa;                &lt;/tns:IPClient>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:HashIN>&#xa;                &lt;tns:key>&#xa;                    &lt;xsl:value-of select=&quot;'FILTRO'&quot;/>&#xa;                &lt;/tns:key>&#xa;                &lt;xsl:if test=&quot;$post.item/tns1:strutturaCondition[$index]/tns1:valore&quot;>&#xa;                    &lt;tns:value>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:strutturaCondition[$index]/tns1:valore&quot;/>&#xa;                    &lt;/tns:value>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:HashIN>&#xa;            &lt;tns:Bonifica>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;            &lt;/tns:Bonifica>&#xa;        &lt;/tns:RequestGet_Multiple_Hash_Secolo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="LogToGet_Multiple_Hash"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Get_Multiple_HashToLog1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$Get_Multiple_Hash/Output/tns1:ResponseGet_Multiple_Hash_Secolo/tns1:ESITO = 'OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Get_Multiple_Hash.Output/tns1:ESITO = 'OK']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Get_Multiple_HashToLog2">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:invoke>
                                    <bpws:extensionActivity>
