                                    tibex:group="groupStart" tibex:xpdlId="ac588503-4f8a-48ca-8879-8e718c612524">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToLog">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="contains($post/item/ns1:NuovoReportInput/ns1:strutturaCondition[$index]/ns1:nome, 'HASH')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($post.item/ns1:strutturaCondition[$index]/ns1:nome, 'HASH')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToMapper">
                                    <tibex:DesignExpression>

                                    <tibex:expression
