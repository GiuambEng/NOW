                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8b0b27e1-7d4f-49b7-b7b8-b824b793f10c+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.example.org/ReportisticaHashing&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FlagCiclo&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&lt;xsl:param name=&quot;IdReport&quot;/>&lt;xsl:template name=&quot;InsertReport-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$FlagCiclo = false()&quot;>&lt;filtroReport>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/filtroReport>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns2:NuovoReportInput/tns2:tipoLista = 'DONATING' &quot;>&lt;filtroReport>&lt;xsl:value-of select=&quot;tib:substring-before-last(concat(if(string-length($post/item/tns2:NuovoReportInput/tns2:codOrdineTi)>0) then concat(&amp;quot;CODICEORDINETI = '&amp;quot;,$post/item/tns2:NuovoReportInput/tns2:codOrdineTi,&amp;quot;' AND &amp;quot;) else &amp;quot;&amp;quot;,if(string-length($post/item/tns2:NuovoReportInput/tns2:nomeFileNotifica)>0) then concat(&amp;quot;NOMEFILENOTIFICA = '&amp;quot;,$post/item/tns2:NuovoReportInput/tns2:nomeFileNotifica,&amp;quot;' AND &amp;quot;) else &amp;quot;&amp;quot;,if(string-length($post/item/tns2:NuovoReportInput/tns2:idRisorsa)>0) then concat(&amp;quot;IDRISORSA = '&amp;quot;,$post/item/tns2:NuovoReportInput/tns2:idRisorsa,&amp;quot;' AND &amp;quot;) else &amp;quot;&amp;quot;,if(string-length($post/item/tns2:NuovoReportInput/tns2:codiceSessione)>0) then concat(&amp;quot;CODICESESSIONE = '&amp;quot;,$post/item/tns2:NuovoReportInput/tns2:codiceSessione,&amp;quot;' AND &amp;quot;) else &amp;quot;&amp;quot;), &amp;quot;AND&amp;quot;)&quot;/>&lt;/filtroReport>&lt;/xsl:when>&lt;xsl:otherwise>&lt;filtroReport>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RicercaAvanzata/tns1:outputcondition[1])&quot;>&lt;xsl:value-of select=&quot;$RicercaAvanzata/tns1:outputcondition[1]&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/filtroReport>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$FlagCiclo = false()&quot;>&lt;idStatoElab>&lt;xsl:value-of select=&quot;4&quot;/>&lt;/idStatoElab>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idStatoElab>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/idStatoElab>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;nomeReport>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns2:NuovoReportInput/tns2:nomeReport)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns2:NuovoReportInput/tns2:nomeReport&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/nomeReport>&lt;operatore>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns2:NuovoReportInput/tns2:operatore)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns2:NuovoReportInput/tns2:operatore&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/operatore>&lt;tmstpAgg>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tmstpAgg>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns2:NuovoReportInput/tns2:tipoLista='TUTTI'&quot;>&lt;idTipoLista>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/idTipoLista>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns2:NuovoReportInput/tns2:tipoLista='SOSPESO'&quot;>&lt;idTipoLista>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/idTipoLista>&lt;/xsl:when>&lt;