                                    sqlStatement="select distinct so.cod_anag_servz_opz&#xa;from &#xa;anag_servz_opzionale so INNER JOIN ass_servz_offolo_ardica soa ON so.ID_ANAG_SERVZ_OPZ = soa.ID_SERVZ_OPZ&#xa;WHERE &#xa;soa.id_area_di_cant = ? AND&#xa;soa.data_iniz_val &lt;= ? AND&#xa;soa.data_fine_val >= ? AND&#xa;soa.codfc_olo_agcom = ? AND &#xa;so.data_iniz_val &lt;= ? AND&#xa;so.data_fine_val >= ?" xsi:type="jdbcPalette:JDBCQueryActivity">

