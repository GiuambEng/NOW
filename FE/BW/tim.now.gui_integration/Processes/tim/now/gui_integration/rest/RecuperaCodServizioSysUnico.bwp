putRecuperaSysUnicoCodServizio&gt;&lt;xsl:for-each select="$GetSystemUnico/Record"&gt;&lt;tns1:systemUnico&gt;&lt;xsl:value-of select="COD_IMPRESA"/&gt;&lt;/tns1:systemUnico&gt;&lt;/xsl:for-each&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:code&gt;&lt;/tns1:result&gt;&lt;/tns1:outputRecuperaSysUnicoCodServizio&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:outputRecuperaSysUnicoCodServizio&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:code&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="&amp;quot;Nessun record presente&amp;quot;"/&gt;&lt;/tns1:details&gt;&lt;/tns1:result&gt;&lt;/tns1:outputRecuperaSysUnicoCodServizio&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/item&gt;&lt;/tns9:postResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
