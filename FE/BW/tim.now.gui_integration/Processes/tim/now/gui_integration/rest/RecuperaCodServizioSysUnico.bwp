                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="dataInizioValidita"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="dataFineValidita"/>
                                    <columnMetadata
                                    columnName="ID_AREA_DI_CANT"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
