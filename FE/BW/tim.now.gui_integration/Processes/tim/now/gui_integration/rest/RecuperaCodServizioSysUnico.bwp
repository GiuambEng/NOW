                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://xmlns.example.com/20200407115730PLT&quot; xmlns:tns1=&quot;http://www.example.org/RecuperaSystemUnico&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;GetSystemUnico&quot;/>&#xa;    &lt;xsl:param name=&quot;GetCodiceServizio&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$post.item/tns1:flagCodiceServizio = &amp;quot;Y&amp;quot; and $post.item/tns1:RU1560!='SI'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($GetCodiceServizio/Record)>0&quot;>&#xa;                        &lt;tns1:outputRecuperaSysUnicoCodServizio>&#xa;                            &lt;xsl:for-each select=&quot;$GetCodiceServizio/Record&quot;>&#xa;                                &lt;tns1:codiceServizio>&#xa;                                    &lt;xsl:value-of select=&quot;COD_ANAG_SERVZ_OPZ&quot;/>&#xa;                                &lt;/tns1:codiceServizio>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns1:severity>&#xa;                                &lt;tns1:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns1:code>&#xa;                            &lt;/tns1:result>&#xa;                        &lt;/tns1:outputRecuperaSysUnicoCodServizio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:outputRecuperaSysUnicoCodServizio>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns1:severity>&#xa;                                &lt;tns1:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns1:code>&#xa;                                &lt;tns1:details>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Nessun record presente&amp;quot;&quot;/>&#xa;                                &lt;/tns1:details>&#xa;                            &lt;/tns1:result>&#xa;                        &lt;/tns1:outputRecuperaSysUnicoCodServizio>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$post.item/tns1:RU1560='SI'&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$Variable&quot;/>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($GetSystemUnico/Record)>0&quot;>&#xa;                        &lt;tns1:outputRecuperaSysUnicoCodServizio>&#xa;                            &lt;xsl:for-each select=&quot;$GetSystemUnico/Record&quot;>&#xa;                                &lt;tns1:systemUnico>&#xa;                                    &lt;xsl:value-of select=&quot;COD_IMPRESA&quot;/>&#xa;                                &lt;/tns1:systemUnico>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns1:result>&#xa;                                &lt;tns1:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;