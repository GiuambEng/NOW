                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select distinct N.cod_topon&#xa;from &#xa;prov P inner join comune_o_localita C on P.COD_ISTAT_PROV = C.COD_ISTAT_PROV&#xa;inner join via V on C.COD_ISTAT_COMUNE = V.COD_ISTAT_COMUNE&#xa;inner join particella PA on V.COD_PARTICELLA_TOPON = PA.COD_PARTICELLA_TOPON &#xa;inner join numero_civico N on V.COD_STRADA = N.COD_STRADA&#xa;where&#xa;upper(TRIM(P.DESCR_PROV)) = upper(?) &#xa;AND upper(TRIM(C.DESCR_COMUNE))=upper(?) &#xa;AND upper(TRIM(PA.DESCR_PARTICELLA_TOPON))=upper(?) &#xa;AND upper(TRIM(V.DESCR_VIA))=upper(?)&#xa;AND upper(TRIM(N.NUMERO_CIVICO)) = upper(?)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="provincia"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="comune"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="particellaToponomastica"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="via"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="numeroCivico"/>
                                    <columnMetadata
                                    columnName="COD_TOPON"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
