                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/RecuperaSystemUnico&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryOnt&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$QueryOnt/Record[1]/CONTEGGIO=0&quot;>&lt;tns1:outputRecuperaSysUnicoCodServizio>&lt;tns1:codiceServizio>&lt;xsl:value-of select=&quot;'TLC8'&quot;/>&lt;/tns1:codiceServizio>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:code>&lt;/tns1:result>&lt;/tns1:outputRecuperaSysUnicoCodServizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:outputRecuperaSysUnicoCodServizio>&lt;tns1:codiceServizio>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:codiceServizio>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:code>&lt;tns1:details>&lt;xsl:value-of select=&quot;'Trovato Record'&quot;/>&lt;/tns1:details>&lt;/tns1:result>&lt;/tns1:outputRecuperaSysUnicoCodServizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
