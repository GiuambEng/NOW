ON so.ID_ANAG_SERVZ_OPZ = soa.ID_SERVZ_OPZ WHERE soa.id_area_di_cant = ? AND soa.data_iniz_val &amp;lt;= ? AND soa.data_fine_val >= ? AND soa.codfc_olo_agcom = ?&amp;quot;)) else concat(&amp;quot;OutputRecuperaCodServizioSysUnico:&amp;quot;,string(&amp;quot;select distinct i.cod_impresa from del321_impresa i INNER JOIN del321_ass_olo_imp_areadicant oia ON i.id_impresa = oia.id_impresa WHERE oia.id_area_di_cant = ? AND oia.data_iniz_valid_prv &amp;lt;= ? AND oia.data_fine_valid_prv >= ? AND oia.cod_olo_agcom = ?&amp;quot;))&quot;/>&lt;/tns7:Payload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns7:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns7:LoggerName>&lt;tns7:LogLevel>&lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&lt;/tns7:LogLevel>&lt;tns7:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns7:LogJMS>&lt;/tns7:GenericLogger>&lt;tns7:ActiveLoggerServices>&lt;tns7:Envelope>&lt;tns7:Identifier>&lt;tns7:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.RecuperaCodServizioSysUnico&amp;quot;&quot;/>&lt;/tns7:ServiceName>&lt;tns7:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns7:Operation>&lt;tns7:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns7:Source>&lt;xsl:if test=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-SID&quot;>&lt;tns7:BusinessID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-SID&quot;/>&lt;/tns7:BusinessID>&lt;/xsl:if>&lt;tns7:EventID>&lt;xsl:value-of select=&quot;concat(&amp;quot;SID&amp;quot;,$post/httpHeaders/tns8:httpHeaders/GUI-SID,&amp;quot;-&amp;quot;,&amp;quot;TID&amp;quot;,$post/httpHeaders/tns8:httpHeaders/GUI-TID)&quot;/>&lt;/tns7:EventID>&lt;xsl:if test=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-TID&quot;>&lt;tns7:CorrelationID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-TID&quot;/>&lt;/tns7:CorrelationID>&lt;/xsl:if>&lt;tns7:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaCodServizioSysUnico_&amp;quot;,$post/httpHeaders/tns8:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&lt;/tns7:EventType>&lt;tns7:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaCodServizioSysUnico_&amp;quot;,$post/httpHeaders/tns8:httpHeaders/GUI-SID)&quot;/>&lt;/tns7:trackID>&lt;/tns7:Identifier>&lt;tns7:track_position>&lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&lt;/tns7:track_position>&lt;tns7:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns7:Timestamp>&lt;/tns7:Envelope>&lt;/tns7:ActiveLoggerServices>&lt;/tns7:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
