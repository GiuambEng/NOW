    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>post</variable>
                <variable>get</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
            </endingVariables>
        </task>
        <task name="caricamentofilefwa_LogInput">
            <endingVariables>
                <variable>caricamentofilefwa_LogInput-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="caricamentofilefwa_LogInfo">
            <endingVariables>
                <variable>caricamentofilefwa_LogInfo-input</variable>
            </endingVariables>
        </task>
        <task name="caricamentofilefwa_LogOutput">
            <endingVariables>
                <variable>caricamentofilefwa_LogOutput-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery1">
            <endingVariables>
                <variable>JDBCQuery1-input</variable>
            </endingVariables>
        </task>
        <task name="SQLDirect">
            <endingVariables>
                <variable>SQLDirect-input</variable>
            </endingVariables>
        </task>
        <task name="ListFiles">
            <endingVariables>
                <variable>ListFiles-input</variable>
            </endingVariables>
        </task>
        <task name="WriteFile">
            <endingVariables>
                <variable>WriteFile-input</variable>
                <variable>WriteFile</variable>
            </endingVariables>
        </task>
        <task name="WriteTappo">
            <endingVariables>
                <variable>WriteTappo-input</variable>
                <variable>WriteTappo</variable>
                <variable>ReplaceCsvString</variable>
                <variable>Path</variable>
            </endingVariables>
        </task>
        <task name="Assign2">
            <endingVariables>
                <variable>JDBCQuery1</variable>
                <variable>SQLDirect</variable>
                <variable>ListFiles</variable>
            </endingVariables>
        </task>
        <task name="ReplaceCsvString">
            <endingVariables>
                <variable>ReplaceCsvString-input</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="caricamentofilefwa_LogError">
            <endingVariables>
                <variable>caricamentofilefwa_LogError-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
