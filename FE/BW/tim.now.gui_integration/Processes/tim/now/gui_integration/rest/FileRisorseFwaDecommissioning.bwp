        </task>
        <task name="visualizzafilefwa_LogOutput">
            <endingVariables>
                <variable>visualizzafilefwa_LogOutput-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery">
            <endingVariables>
                <variable>JDBCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="Assign">
            <endingVariables>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="CryptoList">
            <endingVariables>
                <variable>CryptoList-input</variable>
            </endingVariables>
        </task>
        <task name="Assign1">
            <endingVariables>
                <variable>CryptoList</variable>
            </endingVariables>
        </task>
        <task name="Reply1">
            <endingVariables>
                <variable>Reply1-input</variable>
                <variable>FaultDetails1</variable>
            </endingVariables>
        </task>
        <task name="visualizzafilefwa_LogError">
            <endingVariables>
                <variable>visualizzafilefwa_LogError-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
