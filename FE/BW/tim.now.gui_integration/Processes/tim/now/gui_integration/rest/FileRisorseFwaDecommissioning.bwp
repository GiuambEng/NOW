                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable1&quot;/>&#xa;    &lt;xsl:template name=&quot;visualizzafilefwa_LogOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaFileFwa&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.VisualizzaFileFwa&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputVisualizzaFileFwa:&amp;quot;,substring(tib:render-xml($Variable1, true(),true()),1,500),&amp;quot;.....&amp;quot;)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaFileFwa&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaFileFwa_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaFileFwa_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCQuery-input"
                                    name="JDBCQuery"
                                    outputVariable="JDBCQuery"
                                    tibex:xpdlId="a3509b5d-0d08-4d58-8875-2f50caf2be2f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="visualizzafilefwa_LogInfoToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a3509b5d-0d08-4d58-8875-2f50caf2be2f+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select fc.nome_file, cf.id_file, af.tmstmpins, af.tmstmpagg, af.numerorecord, af.operatoreinserimento,af.operatoreultimamodifica,&#xd;&#xa;       af.desc_esito&#xd;&#xa;from contenuto_file cf inner join file_procsto fc on cf.id_file=fc.id_file&#xd;&#xa;inner join file_procsto_input fci on fc.id_file=fci.id_file_procsto_input&#xd;&#xa;inner join an_file_ris_fwa_deco af on fci.id_file_procsto_input=af.id_file_procsto_input" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TMSTMPINS"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TMSTMPAGG"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="NUMERORECORD"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="OPERATOREINSERIMENTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OPERATOREULTIMAMODIFICA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESC_ESITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="VariableAppoggio"
                                    name="Assign"
                                    outputVariable="VariableAppoggio"
                                    tibex:xpdlId="692b53e3-5c09-41c9-9fb7-2e7f8b839fd4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignTovisualizzafilefwa_LogOutput"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileRisorseFwaDecommissioning&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;VariableAppoggio&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record/ID_FILE)>0&quot;>&lt;tns:VisualizzaFIleFwaOutput>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns:listaFileFwa>&lt;tns:idFile>&lt;xsl:value-of select=&quot;ID_FILE&quot;/>&lt;/tns:idFile>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMSTMPINS&quot;/>&lt;/tns:dataInserimento>&lt;xsl:if test=&quot;TMSTMPAGG&quot;>&lt;tns:dataUltimaModifica>&lt;xsl:value-of select=&quot;TMSTMPAGG&quot;/>&lt;/tns:dataUltimaModifica>&lt;/xsl:if>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;xsl:if test=&quot;NUMERORECORD&quot;>&lt;tns:numeroRecord>&lt;xsl:value-of select=&quot;NUMERORECORD&quot;/>&lt;/tns:numeroRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;OPERATOREINSERIMENTO&quot;>&lt;tns:operatoreInserimento>&lt;xsl:value-of select=&quot;OPERATOREINSERIMENTO&quot;/>&lt;/tns:operatoreInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;OPERATOREULTIMAMODIFICA&quot;>&lt;tns:operatoreUltimaModifica>&lt;xsl:value-of select=&quot;OPERATOREULTIMAMODIFICA&quot;/>&lt;/tns:operatoreUltimaModifica>&lt;/xsl:if>&lt;xsl:if test=&quot;DESC_ESITO&quot;>&lt;tns:descrizioneEsito>&lt;xsl:value-of select=&quot;DESC_ESITO&quot;/>&lt;/tns:descrizioneEsito>&lt;/xsl:if>&lt;tns:position>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:position>&lt;/tns:listaFileFwa>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:VisualizzaFIleFwaOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VisualizzaFIleFwaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun Record Trovato'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:VisualizzaFIleFwaOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariableAppoggio" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CryptoList-input"
                                    name="CryptoList"
                                    outputVariable="CryptoList"
                                    tibex:xpdlId="b024395b-0cb4-4db2-9cba-3c4c9460c412"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignTovisualizzafilefwa_LogOutput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessTovisualizzafilefwa_LogOutput"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/CryptoListParams&quot; xmlns:tns=&quot;http://www.example.org/FileRisorseFwaDecommissioning&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VariableAppoggio&quot;/>&lt;xsl:template name=&quot;CryptoList-input&quot; match=&quot;/&quot;>&lt;tns1:CryptoListParamsInput>&lt;xsl:for-each select=&quot;$VariableAppoggio/tns:listaFileFwa&quot;>&lt;tns1:listIdFile>&lt;xsl:if test=&quot;tns:idFile&quot;>&lt;tns1:idFile>&lt;xsl:value-of select=&quot;tns:idFile&quot;/>&lt;/tns1:idFile>&lt;/xsl:if>&lt;/tns1:listIdFile>&lt;/xsl:for-each>&lt;/tns1:CryptoListParamsInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_integration.sub.CryptoListParams" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable1"
                                    name="Assign1"
                                    outputVariable="Variable1"
                                    tibex:xpdlId="312cda4c-e71d-4b84-a464-6cd7eaf643e5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessTovisualizzafilefwa_LogOutput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1Tovisualizzafilefwa_LogOutput"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileRisorseFwaDecommissioning&quot; xmlns:tns1=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VariableAppoggio&quot;/>&lt;xsl:param name=&quot;CryptoList&quot;/>&lt;xsl:template name=&quot;Variable1&quot; match=&quot;/&quot;>&lt;tns:VisualizzaFIleFwaOutput>&lt;xsl:for-each select=&quot;$VariableAppoggio/tns:listaFileFwa&quot;>&lt;tns:listaFileFwa>&lt;xsl:variable name=&quot;pos&quot; select=&quot;current()/tns:position&quot;/>&lt;xsl:if test=&quot;$CryptoList/tns1:ListIdFileOutput[tns1:position=$pos]/tns1:idFileCriptato&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;$CryptoList/tns1:ListIdFileOutput[tns1:position=$pos]/tns1:idFileCriptato&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataInserimento&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;tns:dataInserimento&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataUltimaModifica&quot;>&lt;tns:dataUltimaModifica>&lt;xsl:value-of select=&quot;tns:dataUltimaModifica&quot;/>&lt;/tns:dataUltimaModifica>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nomeFile&quot;>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;tns:nomeFile&quot;/>&lt;/tns:nomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:numeroRecord&quot;>&lt;tns:numeroRecord>&lt;xsl:value-of select=&quot;tns:numeroRecord&quot;/>&lt;/tns:numeroRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:operatoreInserimento&quot;>&lt;tns:operatoreInserimento>&lt;xsl:value-of select=&quot;tns:operatoreInserimento&quot;/>&lt;/tns:operatoreInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:operatoreUltimaModifica&quot;>&lt;tns:operatoreUltimaModifica>&lt;xsl:value-of select=&quot;tns:operatoreUltimaModifica&quot;/>&lt;/tns:operatoreUltimaModifica>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:descrizioneEsito&quot;>&lt;tns:descrizioneEsito>&lt;xsl:value-of select=&quot;tns:descrizioneEsito&quot;/>&lt;/tns:descrizioneEsito>&lt;/xsl:if>&lt;/tns:listaFileFwa>&lt;/xsl:for-each>&lt;xsl:copy-of select=&quot;$VariableAppoggio/tns:result&quot;/>&lt;/tns:VisualizzaFIleFwaOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Variable1" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
