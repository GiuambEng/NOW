    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>get</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="get_DisaggregAnag_InLog">
            <endingVariables>
                <variable>get_DisaggregAnag_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_DisaggregAnag_InLog_INFO">
            <endingVariables>
                <variable>get_DisaggregAnag_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="get_DisaggregAnag_outp_Log">
            <endingVariables>
                <variable>get_DisaggregAnag_outp_Log-input</variable>
                <variable>LoggerInfo</variable>
                <variable>ListaDisaggregazioneOlo</variable>
                <variable>ListaDisaggregazioneOloVULA</variable>
                <variable>ListaDisaggregazioneNoOloVULA</variable>
                <variable>Profile</variable>
                <variable>MaxRows</variable>
            </endingVariables>
        </task>
        <task name="ListaDisaggregazioneNoOlo">
            <endingVariables>
                <variable>ListaDisaggregazioneNoOlo-input</variable>
            </endingVariables>
        </task>
        <task name="ListaDisaggregazioneOlo">
            <endingVariables>
                <variable>ListaDisaggregazioneOlo-input</variable>
            </endingVariables>
        </task>
        <task name="AssignDisaggregazione">
            <endingVariables>
                <variable>ListaDisaggregazioneNoOlo</variable>
            </endingVariables>
        </task>
        <task name="ListaDisaggregazioneOloVULA">
            <endingVariables>
                <variable>ListaDisaggregazioneOloVULA-input</variable>
            </endingVariables>
        </task>
        <task name="ListaDisaggregazioneNoOloVULA">
            <endingVariables>
                <variable>ListaDisaggregazioneNoOloVULA-input</variable>
            </endingVariables>
        </task>
        <task name="get_DisaggregAnag_ErrorLog">
            <endingVariables>
                <variable>get_DisaggregAnag_ErrorLog-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
