                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+23eacb5a-2c9f-45e3-89fd-650083f1979b+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaDisaggregazione/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaDisaggregazioneOloVULA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;codificaOloAgcom1>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/codificaOloAgcom1>&#xa;            &lt;codificaOloAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/codificaOloAgcom2>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AA.CODFC_OLO_AGCOM, AA.DATA_INIZ_VAL_PROV, AA.DATA_FINE_VAL_PROV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT_VULA, AA.DISAGZ_APPUNTAMENTO&#xa;FROM DEL348_ASS_OLO_IMP_ARDICA_VULA AA&#xa;LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA&#xa;LEFT JOIN DEL348_AREA_DI_CANTIERE_VULA AC ON AC.ID_AREA_DI_CANT_VULA = AA.ID_AREA_DI_CANT_VULA&#xa;WHERE AA.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = ?)) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = ?)))" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codificaOloAgcom1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codificaOloAgcom2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_INIZ_VAL_PROV"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATA_FINE_VAL_PROV"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="COD_IMPRESA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="RAGIONE_SOCIALE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="AREA_DI_CANT_VULA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DISAGZ_APPUNTAMENTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
