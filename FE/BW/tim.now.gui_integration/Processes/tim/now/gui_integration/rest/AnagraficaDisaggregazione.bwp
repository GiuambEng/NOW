                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns2=&quot;http://xmlns.example.com/AnagraficaDisaggregazione/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;LoggerInfo&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;ListaDisaggregazioneOlo&quot;/>&lt;xsl:param name=&quot;ListaDisaggregazioneNoOloVULA&quot;/>&lt;xsl:param name=&quot;ListaDisaggregazioneOloVULA&quot;/>&lt;xsl:template name=&quot;get_DisaggregAnag_outp_Log-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;AnagraficaDisaggregazione&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.AnagraficaDisaggregazione&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ListaDisaggregazioneOlo/Record[1]/COD_OLO_AGCOM) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;OutputSQLListaAnagraficaDisaggregazioneOLO:&amp;quot;, &amp;quot;SELECT AA.COD_OLO_AGCOM, AA.DATA_INIZ_VALID_PRV, AA.DATA_FINE_VALID_PRV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT, AA.DISAGZ_APPUNTAMENTO FROM DEL321_ASS_OLO_IMP_AREADICANT AA LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA LEFT JOIN DEL321_AREA_DI_CANT AC ON AC.ID_AREA_DI_CANT = AA.ID_AREA_DI_CANT WHERE AA.COD_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$get/parameters/tns2:anagraficadisaggregazioneGetParameters/tns2:codOloAgcom,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$get/parameters/tns2:anagraficadisaggregazioneGetParameters/tns2:codOloAgcom,&amp;quot;')))&amp;quot;)&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ListaDisaggregazioneOloVULA/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;OutputSQLListaAnagraficaDisaggregazioneOLOVULA:&amp;quot;, &amp;quot;SELECT AA.CODFC_OLO_AGCOM, AA.DATA_INIZ_VAL_PROV, AA.DATA_FINE_VAL_PROV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT_VULA, AA.DISAGZ_APPUNTAMENTO FROM DEL348_ASS_OLO_IMP_ARDICA_VULA AA LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA LEFT JOIN DEL348_AREA_DI_CANTIERE_VULA AC ON AC.ID_AREA_DI_CANT_VULA= AA.ID_AREA_DI_CANT_VULA WHERE AA.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$get/parameters/tns2:anagraficadisaggregazioneGetParameters/tns2:codOloAgcom,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$get/parameters/tns2:anagraficadisaggregazioneGetParameters/tns2:codOloAgcom,&amp;quot;')))&amp;quot;)&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ListaDisaggregazioneNoOloVULA/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;&amp;quot;OutputSQLListaAnagraficaDisaggregazioneVULA: SELECT AA.CODFC_OLO_AGCOM, AA.DATA_INIZ_VAL_PROV, AA.DATA_FINE_VAL_PROV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT_VULA, AA.DISAGZ_APPUNTAMENTO FROM DEL348_ASS_OLO_IMP_ARDICA_VULA AA LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA LEFT JOIN DEL348_AREA_DI_CANTIERE_VULA AC ON AC.ID_AREA_DI_CANT_VULA = AA.ID_AREA_DI_CANT_VULA&amp;quot;&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Payload>&lt;xsl:value-of select=&quot;&amp;quot;OutputSQLListaAnagraficaDisaggregazione: SELECT AA.COD_OLO_AGCOM, AA.DATA_INIZ_VALID_PRV, AA.DATA_FINE_VALID_PRV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT, AA.DISAGZ_APPUNTAMENTO FROM DEL321_ASS_OLO_IMP_AREADICANT AA LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA LEFT JOIN DEL321_AREA_DI_CANT AC ON AC.ID_AREA_DI_CANT = AA.ID_AREA_DI_CANT&amp;quot;&quot;/>&lt;/tns:Payload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaDisaggregazione&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventID>&lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns1:httpHeaders/GUI-SID,$get/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&lt;/tns:EventID>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaDisaggregazione_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaDisaggregazione_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
