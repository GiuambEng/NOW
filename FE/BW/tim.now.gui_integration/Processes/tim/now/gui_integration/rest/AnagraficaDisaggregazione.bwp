                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaDisaggregazione&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaDisaggregazione/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Profile&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;ListaDisaggregazioneOloVULA&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;ListaDisaggregazioneNoOloVULA&quot;/>&lt;xsl:template name=&quot;VariableDisaggregazione&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Profile, $get/parameters/tns1:anagraficadisaggregazioneGetParameters/tns1:tipoProfilo) and string-length($ListaDisaggregazioneOloVULA/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&lt;tns:Output_AnagraficaDisaggregazione>&lt;xsl:for-each select=&quot;$ListaDisaggregazioneOloVULA/Record&quot;>&lt;tns:listaDisaggregazione>&lt;tns:olo>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:olo>&lt;xsl:if test=&quot;COD_IMPRESA&quot;>&lt;tns:codiceImpresa>&lt;xsl:value-of select=&quot;COD_IMPRESA&quot;/>&lt;/tns:codiceImpresa>&lt;/xsl:if>&lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&lt;/tns:ragioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;AREA_DI_CANT_VULA&quot;>&lt;tns:areaDiCantiere>&lt;xsl:value-of select=&quot;AREA_DI_CANT_VULA&quot;/>&lt;/tns:areaDiCantiere>&lt;/xsl:if>&lt;tns:dataInizioValiditaProvisioning>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_INIZ_VAL_PROV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizioValiditaProvisioning>&lt;tns:dataFineValiditaProvisioning>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_FINE_VAL_PROV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFineValiditaProvisioning>&lt;tns:disaggregazioneAppuntamento>&lt;xsl:value-of select=&quot;DISAGZ_APPUNTAMENTO&quot;/>&lt;/tns:disaggregazioneAppuntamento>&lt;/tns:listaDisaggregazione>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($ListaDisaggregazioneOloVULA/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_AnagraficaDisaggregazione>&lt;/xsl:when>&lt;xsl:when test=&quot;not(contains($Profile, $get/parameters/tns1:anagraficadisaggregazioneGetParameters/tns1:tipoProfilo)) and string-length($ListaDisaggregazioneNoOloVULA/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&lt;tns:Output_AnagraficaDisaggregazione>&lt;xsl:for-each select=&quot;$ListaDisaggregazioneNoOloVULA/Record&quot;>&lt;tns:listaDisaggregazione>&lt;tns:olo>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:olo>&lt;xsl:if test=&quot;COD_IMPRESA&quot;>&lt;tns:codiceImpresa>&lt;xsl:value-of select=&quot;COD_IMPRESA&quot;/>&lt;/tns:codiceImpresa>&lt;/xsl:if>&lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&lt;/tns:ragioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;AREA_DI_CANT_VULA&quot;>&lt;tns:areaDiCantiere>&lt;xsl:value-of select=&quot;AREA_DI_CANT_VULA&quot;/>&lt;/tns:areaDiCantiere>&lt;/xsl:if>&lt;tns:dataInizioValiditaProvisioning>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_INIZ_VAL_PROV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizioValiditaProvisioning>&lt;tns:dataFineValiditaProvisioning>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_FINE_VAL_PROV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFineValiditaProvisioning>&lt;tns:disaggregazioneAppuntamento>&lt;xsl:value-of select=&quot;DISAGZ_APPUNTAMENTO&quot;/>&lt;/tns:disaggregazioneAppuntamento>&lt;/tns:listaDisaggregazione>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($ListaDisaggregazioneNoOloVULA/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_AnagraficaDisaggregazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Output_AnagraficaDisaggregazione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:Output_AnagraficaDisaggregazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
