                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns2=&quot;http://xmlns.example.com/AnagraficaDisaggregazione/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDisaggregazioneOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDisaggregazioneNoOloVULA&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDisaggregazioneOloVULA&quot;/>&#xa;    &lt;xsl:template name=&quot;get_DisaggregAnag_outp_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaDisaggregazione&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.AnagraficaDisaggregazione&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ListaDisaggregazioneOlo/Record[1]/COD_OLO_AGCOM) > 0&quot;>&#xa;                        &lt;tns:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputSQLListaAnagraficaDisaggregazioneOLO:&amp;quot;, &amp;quot;SELECT AA.COD_OLO_AGCOM, AA.DATA_INIZ_VALID_PRV, AA.DATA_FINE_VALID_PRV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT, AA.DISAGZ_APPUNTAMENTO FROM DEL321_ASS_OLO_IMP_AREADICANT AA LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA LEFT JOIN DEL321_AREA_DI_CANT AC ON AC.ID_AREA_DI_CANT = AA.ID_AREA_DI_CANT WHERE AA.COD_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$get.parameters/tns2:codOloAgcom,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$get.parameters/tns2:codOloAgcom,&amp;quot;')))&amp;quot;)&quot;/>&#xa;                        &lt;/tns:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ListaDisaggregazioneOloVULA/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&#xa;                        &lt;tns:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputSQLListaAnagraficaDisaggregazioneOLOVULA:&amp;quot;, &amp;quot;SELECT AA.CODFC_OLO_AGCOM, AA.DATA_INIZ_VAL_PROV, AA.DATA_FINE_VAL_PROV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT_VULA, AA.DISAGZ_APPUNTAMENTO FROM DEL348_ASS_OLO_IMP_ARDICA_VULA AA LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA LEFT JOIN DEL348_AREA_DI_CANTIERE_VULA AC ON AC.ID_AREA_DI_CANT_VULA= AA.ID_AREA_DI_CANT_VULA WHERE AA.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$get.parameters/tns2:codOloAgcom,&amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$get.parameters/tns2:codOloAgcom,&amp;quot;')))&amp;quot;)&quot;/>&#xa;                        &lt;/tns:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ListaDisaggregazioneNoOloVULA/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&#xa;                        &lt;tns:Payload>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OutputSQLListaAnagraficaDisaggregazioneVULA: SELECT AA.CODFC_OLO_AGCOM, AA.DATA_INIZ_VAL_PROV, AA.DATA_FINE_VAL_PROV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT_VULA, AA.DISAGZ_APPUNTAMENTO FROM DEL348_ASS_OLO_IMP_ARDICA_VULA AA LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA LEFT JOIN DEL348_AREA_DI_CANTIERE_VULA AC ON AC.ID_AREA_DI_CANT_VULA = AA.ID_AREA_DI_CANT_VULA&amp;quot;&quot;/>&#xa;                        &lt;/tns:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Payload>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OutputSQLListaAnagraficaDisaggregazione: SELECT AA.COD_OLO_AGCOM, AA.DATA_INIZ_VALID_PRV, AA.DATA_FINE_VALID_PRV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT, AA.DISAGZ_APPUNTAMENTO FROM DEL321_ASS_OLO_IMP_AREADICANT AA LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA LEFT JOIN DEL321_AREA_DI_CANT AC ON AC.ID_AREA_DI_CANT = AA.ID_AREA_DI_CANT&amp;quot;&quot;/>&#xa;                        &lt;/tns:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaDisaggregazione&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaDisaggregazione_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaDisaggregazione_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
