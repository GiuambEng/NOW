                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaDisaggregazione&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaDisaggregazione/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Profile&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;ListaDisaggregazioneOlo&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;ListaDisaggregazioneNoOlo&quot;/>&lt;xsl:template name=&quot;VariableDisaggregazione&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Profile, $get/parameters/tns1:anagraficadisaggregazioneGetParameters/tns1:tipoProfilo) and string-length($ListaDisaggregazioneOlo/Record[1]/COD_OLO_AGCOM) > 0&quot;>&lt;tns:Output_AnagraficaDisaggregazione>&lt;xsl:for-each select=&quot;$ListaDisaggregazioneOlo/Record&quot;>&lt;tns:listaDisaggregazione>&lt;tns:olo>&lt;xsl:value-of select=&quot;COD_OLO_AGCOM&quot;/>&lt;/tns:olo>&lt;xsl:if test=&quot;COD_IMPRESA&quot;>&lt;tns:codiceImpresa>&lt;xsl:value-of select=&quot;COD_IMPRESA&quot;/>&lt;/tns:codiceImpresa>&lt;/xsl:if>&lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&lt;/tns:ragioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;AREA_DI_CANT&quot;>&lt;tns:areaDiCantiere>&lt;xsl:value-of select=&quot;AREA_DI_CANT&quot;/>&lt;/tns:areaDiCantiere>&lt;/xsl:if>&lt;tns:dataInizioValiditaProvisioning>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_INIZ_VALID_PRV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizioValiditaProvisioning>&lt;tns:dataFineValiditaProvisioning>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_FINE_VALID_PRV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFineValiditaProvisioning>&lt;xsl:if test=&quot;DISAGZ_APPUNTAMENTO&quot;>&lt;tns:disaggregazioneAppuntamento>&lt;xsl:value-of select=&quot;DISAGZ_APPUNTAMENTO&quot;/>&lt;/tns:disaggregazioneAppuntamento>&lt;/xsl:if>&lt;/tns:listaDisaggregazione>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($ListaDisaggregazioneOlo/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_AnagraficaDisaggregazione>&lt;/xsl:when>&lt;xsl:when test=&quot;not(contains($Profile, $get/parameters/tns1:anagraficadisaggregazioneGetParameters/tns1:tipoProfilo)) and string-length($ListaDisaggregazioneNoOlo/Record[1]/COD_OLO_AGCOM) > 0&quot;>&lt;tns:Output_AnagraficaDisaggregazione>&lt;xsl:for-each select=&quot;$ListaDisaggregazioneNoOlo/Record&quot;>&lt;tns:listaDisaggregazione>&lt;tns:olo>&lt;xsl:value-of select=&quot;COD_OLO_AGCOM&quot;/>&lt;/tns:olo>&lt;xsl:if test=&quot;COD_IMPRESA&quot;>&lt;tns:codiceImpresa>&lt;xsl:value-of select=&quot;COD_IMPRESA&quot;/>&lt;/tns:codiceImpresa>&lt;/xsl:if>&lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&lt;/tns:ragioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;AREA_DI_CANT&quot;>&lt;tns:areaDiCantiere>&lt;xsl:value-of select=&quot;AREA_DI_CANT&quot;/>&lt;/tns:areaDiCantiere>&lt;/xsl:if>&lt;tns:dataInizioValiditaProvisioning>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_INIZ_VALID_PRV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizioValiditaProvisioning>&lt;tns:dataFineValiditaProvisioning>&lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_FINE_VALID_PRV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFineValiditaProvisioning>&lt;xsl:if test=&quot;DISAGZ_APPUNTAMENTO&quot;>&lt;tns:disaggregazioneAppuntamento>&lt;xsl:value-of select=&quot;DISAGZ_APPUNTAMENTO&quot;/>&lt;/tns:disaggregazioneAppuntamento>&lt;/xsl:if>&lt;/tns:listaDisaggregazione>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($ListaDisaggregazioneNoOlo/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_AnagraficaDisaggregazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Output_AnagraficaDisaggregazione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:Output_AnagraficaDisaggregazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VariableDisaggregazione"
                                    name="AssignDisaggregazione"
                                    outputVariable="VariableDisaggregazione"
                                    tibex:xpdlId="205fb09d-6069-4ba0-9fb7-685080b545ed" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery1ToAssign"/>
                                    <bpws:target linkName="JDBCQueryToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToget_DisaggregAnag_outp_Log"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaDisaggregazione&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaDisaggregazione/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Profile&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDisaggregazioneOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDisaggregazioneNoOlo&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableDisaggregazione&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($Profile, $get.parameters/tns1:tipoProfilo) and string-length($ListaDisaggregazioneOlo/Record[1]/COD_OLO_AGCOM) > 0&quot;>&#xa;                &lt;tns:Output_AnagraficaDisaggregazione>&#xa;                    &lt;xsl:for-each select=&quot;$ListaDisaggregazioneOlo/Record&quot;>&#xa;                        &lt;tns:listaDisaggregazione>&#xa;                            &lt;tns:olo>&#xa;                                &lt;xsl:value-of select=&quot;COD_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns:olo>&#xa;                            &lt;xsl:if test=&quot;COD_IMPRESA&quot;>&#xa;                                &lt;tns:codiceImpresa>&#xa;                                    &lt;xsl:value-of select=&quot;COD_IMPRESA&quot;/>&#xa;                                &lt;/tns:codiceImpresa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&#xa;                                &lt;tns:ragioneSociale>&#xa;                                    &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                                &lt;/tns:ragioneSociale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;AREA_DI_CANT&quot;>&#xa;                                &lt;tns:areaDiCantiere>&#xa;                                    &lt;xsl:value-of select=&quot;AREA_DI_CANT&quot;/>&#xa;                                &lt;/tns:areaDiCantiere>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataInizioValiditaProvisioning>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_INIZ_VALID_PRV), &amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataInizioValiditaProvisioning>&#xa;                            &lt;tns:dataFineValiditaProvisioning>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_FINE_VALID_PRV), &amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataFineValiditaProvisioning>&#xa;                            &lt;xsl:if test=&quot;DISAGZ_APPUNTAMENTO&quot;>&#xa;                                &lt;tns:disaggregazioneAppuntamento>&#xa;                                    &lt;xsl:value-of select=&quot;DISAGZ_APPUNTAMENTO&quot;/>&#xa;                                &lt;/tns:disaggregazioneAppuntamento>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:listaDisaggregazione>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($ListaDisaggregazioneOlo/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:Output_AnagraficaDisaggregazione>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not(contains($Profile, $get.parameters/tns1:tipoProfilo)) and string-length($ListaDisaggregazioneNoOlo/Record[1]/COD_OLO_AGCOM) > 0&quot;>&#xa;                &lt;tns:Output_AnagraficaDisaggregazione>&#xa;                    &lt;xsl:for-each select=&quot;$ListaDisaggregazioneNoOlo/Record&quot;>&#xa;                        &lt;tns:listaDisaggregazione>&#xa;                            &lt;tns:olo>&#xa;                                &lt;xsl:value-of select=&quot;COD_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns:olo>&#xa;                            &lt;xsl:if test=&quot;COD_IMPRESA&quot;>&#xa;                                &lt;tns:codiceImpresa>&#xa;                                    &lt;xsl:value-of select=&quot;COD_IMPRESA&quot;/>&#xa;                                &lt;/tns:codiceImpresa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&#xa;                                &lt;tns:ragioneSociale>&#xa;                                    &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                                &lt;/tns:ragioneSociale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;AREA_DI_CANT&quot;>&#xa;                                &lt;tns:areaDiCantiere>&#xa;                                    &lt;xsl:value-of select=&quot;AREA_DI_CANT&quot;/>&#xa;                                &lt;/tns:areaDiCantiere>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataInizioValiditaProvisioning>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_INIZ_VALID_PRV), &amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataInizioValiditaProvisioning>&#xa;                            &lt;tns:dataFineValiditaProvisioning>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_FINE_VALID_PRV), &amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataFineValiditaProvisioning>&#xa;                            &lt;xsl:if test=&quot;DISAGZ_APPUNTAMENTO&quot;>&#xa;                                &lt;tns:disaggregazioneAppuntamento>&#xa;                                    &lt;xsl:value-of select=&quot;DISAGZ_APPUNTAMENTO&quot;/>&#xa;                                &lt;/tns:disaggregazioneAppuntamento>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:listaDisaggregazione>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($ListaDisaggregazioneNoOlo/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:Output_AnagraficaDisaggregazione>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Output_AnagraficaDisaggregazione>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/