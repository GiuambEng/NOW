                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AA.COD_OLO_AGCOM, AA.DATA_INIZ_VALID_PRV, AA.DATA_FINE_VALID_PRV, I.COD_IMPRESA, I.RAGIONE_SOCIALE, AC.AREA_DI_CANT, AA.DISAGZ_APPUNTAMENTO&#xa;FROM DEL321_ASS_OLO_IMP_AREADICANT AA&#xa;LEFT JOIN DEL321_IMPRESA I ON I.ID_IMPRESA = AA.ID_IMPRESA&#xa;LEFT JOIN DEL321_AREA_DI_CANT AC ON AC.ID_AREA_DI_CANT = AA.ID_AREA_DI_CANT&#xa;WHERE AA.COD_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE (COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = ?)) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = ?)))"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom1"/>
                                    <columnMetadata
                                    columnName="COD_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_INIZ_VALID_PRV"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATA_FINE_VALID_PRV"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="COD_IMPRESA"
