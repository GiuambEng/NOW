    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="VisualizzaFileNotificheOut">
            <endingVariables>
                <variable>VisualizzaFileNotificheOut-input</variable>
                <variable>CryptList</variable>
            </endingVariables>
        </task>
        <task name="AssignFileProcessato">
            <endingVariables>
                <variable>ListaFileNotificheQueryOlo</variable>
                <variable>Profilo</variable>
                <variable>ListaFileNotificheQueryNoOlo</variable>
            </endingVariables>
        </task>
        <task name="get_FileNotifiche_outp_Log">
            <endingVariables>
                <variable>get_FileNotifiche_outp_Log-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="get_FileNotifiche_InLog">
            <endingVariables>
                <variable>get_FileNotifiche_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_FileNotifiche_InLog_INFO">
            <endingVariables>
                <variable>get_FileNotifiche_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="ListaFileNotificheQueryOlo">
            <endingVariables>
                <variable>ListaFileNotificheQueryOlo-input</variable>
            </endingVariables>
        </task>
        <task name="CryptList">
            <endingVariables>
                <variable>CryptList-input</variable>
            </endingVariables>
        </task>
        <task name="ListaFileNotificheQueryNoOlo">
            <endingVariables>
                <variable>ListaFileNotificheQueryNoOlo-input</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="get_FileNotifiche_ErrorLog">
            <endingVariables>
                <variable>get_FileNotifiche_ErrorLog-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
