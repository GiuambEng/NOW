                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+04e554e3-067c-4b94-992a-975284256b48+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160505180305PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaFileNotificheQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;codOrdineOlo>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/idRichiestaOLO&quot;/>&#xa;            &lt;/codOrdineOlo>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT FPO.ID_FILE_PROCSTO_OUTPUT,&#xd;&#xa;       FPO.DIMENSIONE_FILE, FPO.ESITO_INVIO, FPO.QT_RECD_TOTALI,&#xd;&#xa;       FPO.TIMSTP_CREZIONE_FILE, FPO.TIMSTP_INVIO,FP.NOME_FILE,FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE,TF.DESCR &#xd;&#xa;FROM RICH_ORDN_COMUNIC_NOTF ROCN&#xd;&#xa;JOIN BDS_1_CASEDATA_RICHIESTA RICH on (ROCN.ID_RICH_OLO=RICH.IDRICHIESTAOLO and (ROCN.CODFC_OLO_AGCOM= RICH.CODIFICAOLOAGCOM or ROCN.CODFC_OLO_AGCOM = RICH.CODIFICAOLOAGCOMRIC))&#xd;&#xa;JOIN FILE_NOTF_STANDARD FILENOT ON FILENOT.ID_NOTF=ROCN.ID_NOTF&#xd;&#xa;JOIN FILE_PROCSTO_OUTPUT FPO ON FPO.ID_FILE_PROCSTO_OUTPUT=FILENOT.ID_FILE_PROCSTO_OUTPUT&#xd;&#xa;JOIN FILE_PROCSTO FP ON FP.ID_FILE = FPO.ID_FILE_PROCSTO_OUTPUT&#xd;&#xa;JOIN TIPOLG_FILE TF ON TF.IDTPLG_FILE = FP.IDTPLG_FILE&#xd;&#xa;WHERE  ROCN.ID_RICH_OLO= ?&#xd;&#xa;ORDER BY FPO.TIMSTP_INVIO DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOrdineOlo"/>
                                    <columnMetadata
                                    columnName="ID_FILE_PROCSTO_OUTPUT"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DIMENSIONE_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ESITO_INVIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="QT_RECD_TOTALI"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREZIONE_FILE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INVIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDTPLG_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
