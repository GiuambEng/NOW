                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerInfo&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;get_FileNotifiche_outp_Log-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VisualizzaFileNotifiche&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaFileNotifiche&amp;quot;&amp;#x9;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output VisualizzaFileNotifiche : &amp;quot;,&amp;quot;SELECT TF.DESCR ,ROCN.ID_NOTF,FPO.ID_FILE_PROCSTO_OUTPUT,FPO.DIMENSIONE_FILE, FPO.ESITO_INVIO,FPO.QT_RECD_TOTALI,&amp;#xD;&amp;#xA;FPO.TIMSTP_CREZIONE_FILE, FPO.TIMSTP_INVIO, FP.NOME_FILE,FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE&amp;#xD;&amp;#xA;FROM   FILE_PROCSTO_OUTPUT FPO&amp;#xD;&amp;#xA;JOIN   FILE_PROCSTO FP ON FP.ID_FILE = FPO.ID_FILE_PROCSTO_OUTPUT&amp;#xD;&amp;#xA;JOIN RICH_ORDN_COMUNIC_NOTF ROCN ON ROCN.ID_NOTF = FPO.ID_FILE_PROCSTO_OUTPUT&amp;#xD;&amp;#xA;LEFT JOIN TIPOLG_FILE TF ON TF.IDTPLG_FILE=FP.IDTPLG_FILE&amp;#xD;&amp;#xA;WHERE  ROCN.ID_RICH_OLO= ?&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quo