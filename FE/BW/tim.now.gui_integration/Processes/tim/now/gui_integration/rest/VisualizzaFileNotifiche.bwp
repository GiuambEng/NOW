                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/visualizzaFileNotifiche&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns0=&quot;http://xmlns.example.com/20160505180305PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ListaFileNotificheQueryOlo&quot;/>&lt;xsl:param name=&quot;ListaFileNotificheQueryNoOlo&quot;/>&lt;xsl:param name=&quot;Profilo&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;fileProcessatoVariable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Profilo, $get/parameters/tns0:visualizzafilenotificheParameters/tipoProfilo) = true()&quot;>&lt;tns1:listaFileNotificheOutput>&lt;xsl:for-each select=&quot;$ListaFileNotificheQueryOlo/Record&quot;>&lt;tns1:listaFileNotifiche>&lt;xsl:if test=&quot;exists(ID_FILE_PROCSTO_OUTPUT) and string-length(string(ID_FILE_PROCSTO_OUTPUT))>0&quot;>&lt;tns1:idFileProcessatoOutput>&lt;xsl:value-of select=&quot;xsd:int(ID_FILE_PROCSTO_OUTPUT)&quot;/>&lt;/tns1:idFileProcessatoOutput>&lt;/xsl:if>&lt;tns1:tipoNotifica>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns1:tipoNotifica>&lt;tns1:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns1:nomeFile>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns1:codOloAgcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns1:codOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DIMENSIONE_FILE) and string-length(string(DIMENSIONE_FILE))>0&quot;>&lt;tns1:dimensioneFile>&lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&lt;/tns1:dimensioneFile>&lt;/xsl:if>&lt;xsl:if test=&quot;ESITO_INVIO&quot;>&lt;tns1:esitoInvio>&lt;xsl:value-of select=&quot;ESITO_INVIO&quot;/>&lt;/tns1:esitoInvio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(QT_RECD_TOTALI) and string-length(string(QT_RECD_TOTALI