                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="OnMessageStartToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="get_ProfiliVc_InLog_INFOToVCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
