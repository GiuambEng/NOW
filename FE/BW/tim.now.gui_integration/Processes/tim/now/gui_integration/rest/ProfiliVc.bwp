sl:if>&lt;xsl:if test=&quot;exists(column[name='MCR_DOWN']/value) and string-length(string(column[name='MCR_DOWN']/value))&quot;>&lt;tns:mcr_Down>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='MCR_DOWN']/value))&quot;/>&lt;/tns:mcr_Down>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='MCR_UP']/value) and string-length(string(column[name='MCR_UP']/value))&quot;>&lt;tns:mcr_Up>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='MCR_UP']/value))&quot;/>&lt;/tns:mcr_Up>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='PCR_DOWN']/value) and string-length(string(column[name='PCR_DOWN']/value))&quot;>&lt;tns:pcr_Down>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='PCR_DOWN']/value))&quot;/>&lt;/tns:pcr_Down>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='PCR_UP']/value) and string-length(string(column[name='ID_PRFL_VC']/value))&quot;>&lt;tns:pcr_Up>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='PCR_UP']/value))&quot;/>&lt;/tns:pcr_Up>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='SCR_DOWN']/value) and string-length(string(column[name='SCR_DOWN']/value))&quot;>&lt;tns:scr_Down>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='SCR_DOWN']/value))&quot;/>&lt;/tns:scr_Down>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='SCR_UP']/value) and string-length(string(column[name='SCR_UP']/value))&quot;>&lt;tns:scr_Up>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='SCR_UP']/value))&quot;/>&lt;/tns:scr_Up>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='ID_OFFERTA']/value) and string-length(string(column[name='ID_OFFERTA']/value))&quot;>&lt;tns:identificativoOfferta>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='ID_OFFERTA']/value))&quot;/>&lt;/tns:identificativoOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']