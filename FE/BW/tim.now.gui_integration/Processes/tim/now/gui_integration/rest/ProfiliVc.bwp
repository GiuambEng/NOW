                            <bpws:reply name="getOut" operation="get"
                                partnerLink="profilivc"
                                portType="ns:profilivc"
                                tibex:xpdlId="be90752f-de25-4afd-8599-6d3b8659329f" variable="getOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://xmlns.example.com/20160531132715PLT" xmlns:tns="http://www.tim.com/NOW/rest/ProfiliVc" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="VCQuery"/&gt;
    &lt;xsl:template name="getOut-input" match="/"&gt;
        &lt;tns1:getResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($VCQuery)"&gt;
                        &lt;tns:ProfiliVcOutput&gt;
                            &lt;xsl:for-each select="$VCQuery/Record"&gt;
                                &lt;tns:ProfiliVcOutput&gt;
                                    &lt;xsl:if test="exists(ID_PRFL_VC) and string-length(string(ID_PRFL_VC))"&gt;
                                        &lt;tns:identificativoProfiloVc&gt;
                                            &lt;xsl:value-of select="xsd:int(ID_PRFL_VC)"/&gt;
                                        &lt;/tns:identificativoProfiloVc&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="PROFILO"&gt;
                                        &lt;tns:profilo&gt;
                                            &lt;xsl:value-of select="PROFILO"/&gt;
                                        &lt;/tns:profilo&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:tipoProfilo&gt;
                                        &lt;xsl:value-of select="TIPOLG_PROFILO"/&gt;
                                    &lt;/tns:tipoProfilo&gt;
                                    &lt;tns:flagVendibilita&gt;
                                        &lt;xsl:value-of select="FLAG_VENDIBILITA"/&gt;
                                    &lt;/tns:flagVendibilita&gt;
                                    &lt;xsl:if test="exists(MCR_DOWN) and string-length(string(MCR_DOWN))"&gt;
                                        &lt;tns:mcr_Down&gt;
                                            &lt;xsl:value-of select="xsd:int(MCR_DOWN)"/&gt;
                                        &lt;/tns:mcr_Down&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(MCR_UP) and string-length(string(MCR_UP))"&gt;
                                        &lt;tns:mcr_Up&gt;
                                            &lt;xsl:value-of select="xsd:int(MCR_UP)"/&gt;
                                        &lt;/tns:mcr_Up&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(PCR_DOWN) and string-length(string(PCR_DOWN))"&gt;
                                        &lt;tns:pcr_Down&gt;
                                            &lt;xsl:value-of select="xsd:int(PCR_DOWN)"/&gt;
                                        &lt;/tns:pcr_Down&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(PCR_UP) and string-length(string(PCR_UP))"&gt;
                                        &lt;tns:pcr_Up&gt;
                                            &lt;xsl:value-of select="xsd:int(PCR_UP)"/&gt;
                                        &lt;/tns:pcr_Up&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(SCR_DOWN) and string-length(string(SCR_DOWN))"&gt;
                                        &lt;tns:scr_Down&gt;
                                            &lt;xsl:value-of select="xsd:int(SCR_DOWN)"/&gt;
                                        &lt;/tns:scr_Down&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(SCR_UP) and string-length(string(SCR_UP))"&gt;
                                        &lt;tns:scr_Up&gt;
                                            &lt;xsl:value-of select="xsd:int(SCR_UP)"/&gt;
                                        &lt;/tns:scr_Up&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(ID_OFFERTA) and string-length(string(ID_OFFERTA))"&gt;
                                        &lt;tns:identificativoOfferta&gt;
                                            &lt;xsl:value-of select="xsd:int(ID_OFFERTA)"/&gt;
                                        &lt;/tns:identificativoOfferta&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="OFFERTA"&gt;
                                        &lt;tns:offerta&gt;
                                            &lt;xsl:value-of select="OFFERTA"/&gt;
                                        &lt;/tns:offerta&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:ProfiliVcOutput&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:ProfiliVcOutput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:ProfiliVcOutput&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                                &lt;tns:details&gt;
                                    &lt;xsl:value-of select="'Non ci sono Profili VC'"/&gt;
                                &lt;/tns:details&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:ProfiliVcOutput&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns1:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160531132715PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/ProfiliVc&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($VCQuery)&quot;>&#xa;                &lt;tns:ProfiliVcOutput>&#xa;                    &lt;xsl:for-each select=&quot;$VCQuery/Record&quot;>&#xa;                        &lt;tns:ProfiliVcOutput>&#xa;                            &lt;xsl:if test=&quot;exists(ID_PRFL_VC) and string-length(string(ID_PRFL_VC))&quot;>&#xa;                                &lt;tns:identificativoProfiloVc>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_PRFL_VC)&quot;/>&#xa;                                &lt;/tns:identificativoProfiloVc>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;PROFILO&quot;>&#xa;                                &lt;tns:profilo>&#xa;                                    &lt;xsl:value-of select=&quot;PROFILO&quot;/>&#xa;                                &lt;/tns:profilo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:tipoProfilo>&#xa;                                &lt;xsl:value-of select=&quot;TIPOLG_PROFILO&quot;/>&#xa;                            &lt;/tns:tipoProfilo>&#xa;                            &lt;tns:flagVendibilita>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_VENDIBILITA&quot;/>&#xa;                            &lt;/tns:flagVendibilita>&#xa;                            &lt;xsl:if test=&quot;exists(MCR_DOWN) and string-length(string(MCR_DOWN))&quot;>&#xa;                                &lt;tns:mcr_Down>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(MCR_DOWN)&quot;/>&#xa;                                &lt;/tns:mcr_Down>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(MCR_UP) and string-length(string(MCR_UP))&quot;>&#xa;                                &lt;tns:mcr_Up>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(MCR_UP)&quot;/>&#xa;                                &lt;/tns:mcr_Up>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(PCR_DOWN) and string-length(string(PCR_DOWN))&quot;>&#xa;                                &lt;tns:pcr_Down>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(PCR_DOWN)&quot;/>&#xa;                                &lt;/tns:pcr_Down>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(PCR_UP) and string-length(string(PCR_UP))&quot;>&#xa;                                &lt;tns:pcr_Up>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(PCR_UP)&quot;/>&#xa;                                &lt;/tns:pcr_Up>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(SCR_DOWN) and string-length(string(SCR_DOWN))&quot;>&#xa;                                &lt;tns:scr_Down>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(SCR_DOWN)&quot;/>&#xa;                                &lt;/tns:scr_Down>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(SCR_UP) and string-length(string(SCR_UP))&quot;>&#xa;                                &lt;tns:scr_Up>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(SCR_UP)&quot;/>&#xa;                                &lt;/tns: