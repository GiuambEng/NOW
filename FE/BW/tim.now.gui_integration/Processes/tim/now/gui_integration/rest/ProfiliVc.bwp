                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a7b80a96-01af-479a-a39d-2af6fd828910+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzataConditions&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post/item/tns1:inputservizioricercaavanzata/tns1:strutturaCondition[1]/tns1:nome)=0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT O.OFFERTA, P.FLAG_VENDIBILITA, P.ID_OFFERTA,P.ID_PRFL_VC,P.MCR_DOWN,P.MCR_UP,P.PCR_DOWN,P.PCR_UP,PROFILO,P.SCR_DOWN,P.SCR_UP,P.TIPOLG_PROFILO FROM PROFILO_VC P  JOIN OFFERTA O ON P.ID_OFFERTA = O.ID_OFFERTA&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT O.OFFERTA, P.FLAG_VENDIBILITA, P.ID_OFFERTA,P.ID_PRFL_VC,P.MCR_DOWN,P.MCR_UP,P.PCR_DOWN,P.PCR_UP,PROFILO,P.SCR_DOWN,P.SCR_UP,P.TIPOLG_PROFILO FROM PROFILO_VC P  JOIN OFFERTA O ON P.ID_OFFERTA = O.ID_OFFERTA WHERE &amp;quot;, $RicercaAvanzataConditions/tns1:outputcondition[1])&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
