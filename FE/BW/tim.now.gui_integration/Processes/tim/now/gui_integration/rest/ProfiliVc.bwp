    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>get</variable>
                <variable>post</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
                <variable>VCQuery</variable>
            </endingVariables>
        </task>
        <task name="get_ProfiliVc_InLog">
            <endingVariables>
                <variable>get_ProfiliVc_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_ProfiliVc_InLog_INFO">
            <endingVariables>
                <variable>get_ProfiliVc_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="get_ProfiliVc_outp_Log">
            <endingVariables>
                <variable>get_ProfiliVc_outp_Log-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="VCQuery">
            <endingVariables>
                <variable>VCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="get_ProfiliVc_ErrorLog">
            <endingVariables>
                <variable>get_ProfiliVc_ErrorLog-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>SQLDirect</variable>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="SQLDirect">
            <endingVariables>
                <variable>SQLDirect-input</variable>
            </endingVariables>
        </task>
        <task name="RicercaAvanzataConditions">
            <endingVariables>
                <variable>RicercaAvanzataConditions-input</variable>
            </endingVariables>
        </task>
        <task name="post_ProfiliVc_InLog_INFO">
            <endingVariables>
                <variable>post_ProfiliVc_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="post_ProfiliVc_InLog">
            <endingVariables>
                <variable>post_ProfiliVc_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="post_ProfiliVc_outp_Log">
            <endingVariables>
                <variable>post_ProfiliVc_outp_Log-input</variable>
                <variable>RicercaAvanzataConditions</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery">
            <endingVariables>
                <variable>JDBCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="RenderXml">
            <endingVariables>
                <variable>RenderXml-input</variable>
            </endingVariables>
        </task>
        <task name="ExportDati">
            <endingVariables>
                <variable>ExportDati-input</variable>
                <variable>RenderXml</variable>
            </endingVariables>
        </task>
        <task name="Reply1">
            <endingVariables>
                <variable>Reply1-input</variable>
                <variable>FaultDetails1</variable>
            </endingVariables>
        </task>
        <task name="post_ProfiliVc_ErrorLog">
            <endingVariables>
                <variable>post_ProfiliVc_ErrorLog-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
