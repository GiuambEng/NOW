                                    sqlStatement="SELECT VALORE_ATTRIBUTO&#xa;FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM &#xa;WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 &#xa;&#x9;AND CAM.ID_CONTRATTO=?&#xa;&#x9;AND CAM.DT_FINE_VALIDITA>SYSDATE&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

