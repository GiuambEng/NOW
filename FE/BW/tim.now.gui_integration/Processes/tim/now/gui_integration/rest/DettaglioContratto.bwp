                            <bpws:reply name="postOut" operation="post"
                                partnerLink="comunicoinvestiti"
                                portType="ns:comunicoinvestiti1"
                                tibex:xpdlId="81f664f3-74af-445b-9157-a211f0522ac8" variable="postOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20181019171627PLT" xmlns:tns="http://www.tim.com/NOW/rest/dettaglioContratto" xmlns:tns2="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="CryptIdFile"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="ComuniCoinvestiti"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns3:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="string-length($post/item/tns:inputComuniCoinvestiti/tns:exportRequest) = 0 or upper-case($post/item/tns:inputComuniCoinvestiti/tns:exportRequest) = 'N'"&gt;
                        &lt;tns:outputComuniCoinvestiti&gt;
                            &lt;xsl:for-each select="$ComuniCoinvestiti/Record"&gt;
                                &lt;tns:listaComuniCoinvestiti&gt;
                                    &lt;tns:istatComune&gt;
                                        &lt;xsl:value-of select="COD_ISTAT_COMUNE"/&gt;
                                    &lt;/tns:istatComune&gt;
                                    &lt;tns:descrComune&gt;
                                        &lt;xsl:value-of select="DESCR_COMUNE"/&gt;
                                    &lt;/tns:descrComune&gt;
                                    &lt;tns:dataInizioCoinvestimento&gt;
                                        &lt;xsl:value-of select="DATA_INIZIO_VAL"/&gt;
                                    &lt;/tns:dataInizioCoinvestimento&gt;
                                    &lt;tns:dataFineCoinvestimento&gt;
                                        &lt;xsl:value-of select="DATA_FINE_VAL"/&gt;
                                    &lt;/tns:dataFineCoinvestimento&gt;
                                    &lt;tns:codiceContratto&gt;
                                        &lt;xsl:value-of select="COD_CONTRATTO"/&gt;
                                    &lt;/tns:codiceContratto&gt;
                                    &lt;tns:offerta&gt;
                                        &lt;xsl:value-of select="OFFERTA"/&gt;
                                    &lt;/tns:offerta&gt;
                                    &lt;xsl:if test="CODFC_OLO_AGCOM"&gt;
                                        &lt;tns:codOloAgcom&gt;
                                            &lt;xsl:value-of select="CODFC_OLO_AGCOM"/&gt;
                                        &lt;/tns:codOloAgcom&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:listaComuniCoinvestiti&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:outputComuniCoinvestiti&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:outputComuniCoinvestiti&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="$CryptIdFile/tns2:idFileCriptato"/&gt;
                            &lt;/tns:idExportFile&gt;
                        &lt;/tns:outputComuniCoinvestiti&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns3:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://xmlns.example.com/20181019171627PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettaglioContratto&quot; xmlns:tns2=&quot;http://www.example.org/CryptoParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptIdFile&quot;/>&#xa;    &lt;xsl:param name=&quot;ComuniCoinvestiti&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($post.item/tns:exportRequest) = 0 or upper-case($post.item/tns:exportRequest) = 'N'&quot;>&#xa;                &lt;tns:outputComuniCoinvestiti>&#xa;                    &lt;xsl:for-each select=&quot;$ComuniCoinvestiti/Record&quot;>&#xa;                        &lt;tns:listaComuniCoinvestiti>&#xa;                            &lt;tns:istatComune>&#xa;                                &lt;xsl:value-of select=&quot;COD_ISTAT_COMUNE&quot;/>&#xa;                            &lt;/tns:istatComune>&#xa;                            &lt;tns:descrComune>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_COMUNE&quot;/>&#xa;                            &lt;/tns:descrComune>&#xa;                            &lt;tns:dataInizioCoinvestimento>&#xa;                                &lt;xsl:value-of select=&quot;DATA_INIZIO_VAL&quot;/>&#xa;                            &lt;/tns:dataInizioCoinvestimento>&#xa;                            &lt;tns:dataFineCoinvestimento>&#xa;                                &lt;xsl:value-of select=&quot;DATA_FINE_VAL&quot;/>&#xa;                            &lt;/tns:dataFineCoinvestimento>&#xa;                            &lt;tns:codiceContratto>&#xa;                                &lt;xsl:value-of select=&quot;COD_CONTRATTO&quot;/>