            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="8c851d56-b026-431a-b721-052b98029f8c">
                <bpws:onMessage operation="get"
                    partnerLink="dettagliocontratto"
                    portType="ns:dettagliocontratto"
                    tibex:xpdlId="09845891-d8da-40ce-9099-d87794d33c0d" variable="get">
                    <bpws:scope name="scope1">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails"
                                tibex:faultNameVar="FaultName" tibex:xpdlId="91be4707-b732-4ad5-9d91-344b6f50279f">
                                <bpws:scope name="scope2">
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="get_dettaglioContratto_Error_LogToReply" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:template name=&quot;get_dettaglioContratto_Error_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DettaglioContratto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.DettaglioContratto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorDettaglioContratto:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.DettaglioContratto&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns3:httpHeaders/GUI-SID,$get/httpHeaders/tns3:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns3:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;DettaglioContratto_&amp;quot;,$get/httpHeaders/tns3:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;DettaglioContratto_&amp;quot;,$get/httpHeaders/tns3:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorDettaglioContrattoGet&amp;quot;,'SID:',$get/httpHeaders/tns3:httpHeaders/GUI-SID,'TID:',$get/httpHeaders/tns3:httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns2:track_position>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_dettaglioContratto_Error_Log-input"
                                    name="get_dettaglioContratto_Error_Log"
                                    tibex:xpdlId="356e40aa-4d18-4d4b-905e-b9dcec32b95e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="get_dettaglioContratto_Error_LogToReply"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:template name=&quot;get_dettaglioContratto_Error_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DettaglioContratto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.DettaglioContratto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorDettaglioContratto:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.DettaglioContratto&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;DettaglioContratto_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;DettaglioContratto_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorDettaglioContrattoGet&amp;quot;,'SID:',$get.httpHeaders/GUI-SID,'TID:',$get.httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns2:track_position>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
