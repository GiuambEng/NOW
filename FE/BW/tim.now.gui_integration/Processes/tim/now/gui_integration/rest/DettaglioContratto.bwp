est=&quot;$DettaglioContratto/Record[1]/FLAG_MULTICAST&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/FLAG_MULTICAST&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$RecuperaFileCsv/Record&quot;>&lt;tns:listaFileCsv>&lt;xsl:if test=&quot;NOME_FILE&quot;>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;IDFILE&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;IDFILE&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(STATO)>0 and STATO = ('OK','COMPLETATO')&quot;>&lt;tns:statoFile>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:statoFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:statoFile>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:statoFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:position>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:position>&lt;/tns:listaFileCsv>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$Bouquet/Record[1]/VALORE_ATTRIBUTO&quot;>&lt;tns:bouquet>&lt;xsl:value-of select=&quot;$Bouquet/Record[1]/VALORE_ATTRIBUTO&quot;/>&lt;/tns:bouquet>&lt;/xsl:if>&lt;tns:datiSospensioneServizio>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/FLAG_DISABILITAZIONE_SERV&quot;>&lt;tns:flagDisabil>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/FLAG_DISABILITAZIONE_SERV&quot;/>&lt;/tns:flagDisabil>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/DATA_INI_DISABILITAZIONE_SERV&quot;>&lt;tns:dataInizioDisabil>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/DATA_INI_DISABILITAZIONE_SERV&quot;/>&lt;/tns:dataInizioDisabil>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/DATA_FIN_DISABILITAZIONE_SERV&quot;>&lt;tns:dataFineDisabil>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/DATA_FIN_DISABILITAZIONE_SERV&quot;/>&lt;/tns:dataFineDisabil>&lt;/xsl:if>&lt;/tns:datiSospensioneServizio>&lt;xsl:if test=&quot;$DettaglioCon