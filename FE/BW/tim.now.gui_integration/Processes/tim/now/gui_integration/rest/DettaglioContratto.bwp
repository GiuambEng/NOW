                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettaglioContratto&quot; xmlns:tns1=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VariableAppoggio&quot;/>&lt;xsl:param name=&quot;CryptoIDs&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns:outputDettaglioContratto>&lt;xsl:for-each select=&quot;$VariableAppoggio/tns:dettaglioContratto&quot;>&lt;tns:dettaglioContratto>&lt;xsl:if test=&quot;tns:flagAbilitato&quot;>&lt;tns:flagAbilitato>&lt;xsl:value-of select=&quot;tns:flagAbilitato&quot;/>&lt;/tns:flagAbilitato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:flagFileNotify&quot;>&lt;tns:flagFileNotify>&lt;xsl:value-of select=&quot;tns:flagFileNotify&quot;/>&lt;/tns:flagFileNotify>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:flagValido&quot;>&lt;tns:flagValido>&lt;xsl:value-of select=&quot;tns:flagValido&quot;/>&lt;/tns:flagValido>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataInizioValiditaContratto&quot;>&lt;tns:dataInizioValiditaContratto>&lt;xsl:value-of select=&quot;tns:dataInizioValiditaContratto&quot;/>&lt;/tns:dataInizioValiditaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataFineValiditaContratto&quot;>&lt;tns:dataFineValiditaContratto>&lt;xsl:value-of select=&quot;tns:dataFineValiditaContratto&quot;/>&lt;/tns:dataFineValiditaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataInizioAssociazioneOffertaContratto&quot;>&lt;tns:dataInizioAssociazioneOffertaContratto>&lt;xsl:value-of select=&quot;tns:dataInizioAssociazioneOffertaContratto&quot;/>&lt;/tns:dataInizioAssociazioneOffertaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataFineAssociazioneOffertaContratto&quot;>&lt;tns:dataFineAssociazioneOffertaContratto>&lt;xsl:value-of select=&quot;tns:dataFineAssociazioneOffertaContratto&quot;/>&lt;/tns:dataFineAssociaz