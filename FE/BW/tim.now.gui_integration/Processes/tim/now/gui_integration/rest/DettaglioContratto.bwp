&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20181019171627PLT" xmlns:tns="http://www.tim.com/NOW/rest/dettaglioContratto" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
