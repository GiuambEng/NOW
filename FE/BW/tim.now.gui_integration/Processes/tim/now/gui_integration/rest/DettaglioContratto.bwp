quot;'Y'&quot;/>&lt;/tns:flagDisabil>&lt;/xsl:when>&lt;xsl:when test=&quot;tns:datiSospensioneServizio/tns:flagDisabil = 'NO'&quot;>&lt;tns:flagDisabil>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagDisabil>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns:datiSospensioneServizio/tns:dataInizioDisabil&quot;>&lt;tns:dataInizioDisabil>&lt;xsl:value-of select=&quot;tns:datiSospensioneServizio/tns:dataInizioDisabil&quot;/>&lt;/tns:dataInizioDisabil>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:datiSospensioneServizio/tns:dataFineDisabil&quot;>&lt;tns:dataFineDisabil>&lt;xsl:value-of select=&quot;tns:datiSospensioneServizio/tns:dataFineDisabil&quot;/>&lt;/tns:dataFineDisabil>&lt;/xsl:if>&lt;/tns:datiSospensioneServizio>&lt;xsl:if test=&quot;tns:emailOffertaFwa1GigaSardegna&quot;>&lt;tns:emailOffertaFwa1GigaSardegna>&lt;xsl:value-of select=&quot;tns:emailOffertaFwa1GigaSardegna&quot;/>&lt;/tns:emailOffertaFwa1GigaSardegna>&lt;/xsl:if>&lt;/tns:dettaglioContratto>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$VariableAppoggio/tns:result&quot;>&lt;tns:result>&lt;xsl:if test=&quot;tns:severity&quot;>&lt;tns:severity>&lt;xsl:value-of select=&quot;tns:severity&quot;/>&lt;/tns:severity>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:code&quot;>&lt;tns:code>&lt;xsl:value-of select=&quot;tns:code&quot;/>&lt;/tns:code>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:details&quot;>&lt;tns:details>&lt;xsl:value-of select=&quot;tns:details&quot;/>&lt;/tns:details>&lt;/xsl:if>&lt;/tns:result>&lt;/xsl:for-each>&lt;/tns:outputDettaglioContratto>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
