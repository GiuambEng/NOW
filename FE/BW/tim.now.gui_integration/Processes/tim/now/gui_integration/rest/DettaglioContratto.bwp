                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignAppoggioToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettaglioContratto&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DettaglioContratto&quot;/>&lt;xsl:param name=&quot;RecuperaFlagFWA&quot;/>&lt;xsl:param name=&quot;RecuperaFileCsv&quot;/>&lt;xsl:param name=&quot;Bouquet&quot;/>&lt;xsl:template name=&quot;VariableAppoggio&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DettaglioContratto/Record) >0&quot;>&lt;tns:outputDettaglioContratto>&lt;tns:dettaglioContratto>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/FLAG_ABILITATO&quot;>&lt;tns:flagAbilitato>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/FLAG_ABILITATO&quot;/>&lt;/tns:flagAbilitato>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/FLAG_FILE_NOTIFY&quot;>&lt;tns:flagFileNotify>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/FLAG_FILE_NOTIFY&quot;/>&lt;/tns:flagFileNotify>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/FLAG_VALIDO&quot;>&lt;tns:flagValido>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/FLAG_VALIDO&quot;/>&lt;/tns:flagValido>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/DATAINZ_VALID&quot;>&lt;tns:dataInizioValiditaContratto>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/DATAINZ_VALID&quot;/>&lt;/tns:dataInizioValiditaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/DATAFI_VALID&quot;>&lt;tns:dataFineValiditaContratto>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/DATAFI_VALID&quot;/>&lt;/tns:dataFineValiditaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/DATAINZ_ASSOCZ_VALID&quot;>&lt;tns:dataInizioAssociazioneOffertaContratto>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/DATAINZ_ASSOCZ_VALID&quot;/>&lt;/tns:dataInizioAssociazioneOffertaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/DATAFI_ASSOCZ_VALID&quot;>&lt;tns:dataFineAssociazioneOffertaContratto>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/DATAFI_ASSOCZ_VALID&quot;/>&lt;/tns:dataFineAssociazioneOffertaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/ID_CONTRATTO_OFFERTA_CATLG&quot;>&lt;tns:idContrattoOffertaCatalogo>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/ID_CONTRATTO_OFFERTA_CATLG&quot;/>&lt;/tns:idContrattoOffertaCatalogo>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/COD_CONTRATTO&quot;>&lt;tns:codiceContratto>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/COD_CONTRATTO&quot;/>&lt;/tns:codiceContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/COD_OLO&quot;>&lt;tns:codiceOloNumerico>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/COD_OLO&quot;/>&lt;/tns:codiceOloNumerico>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns:codificaOloAgcom>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/NOME_CONTRATTO&quot;>&lt;tns:nomeContratto>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/NOME_CONTRATTO&quot;/>&lt;/tns:nomeContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/DESCR&quot;>&lt;tns:tipoServizio>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/DESCR&quot;/>&lt;/tns:tipoServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/NOME_OFFERTA_CATLG&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;$DettaglioContratto/Record[1]/NOME_OFFERTA_CATLG&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioContratto/Record[1]/TIPOCONTRATTO&quot;>&lt;tns:tipoContratto>&lt;xsl:va