                               &lt;xsl:value-of select=&quot;$post/httpHeaders/tns2:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns4:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ComuniCoinvestiti_&amp;quot;,$post/httpHeaders/tns2:httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns4:EventType>&#xa;                        &lt;tns4:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ComuniCoinvestiti_&amp;quot;,$post/httpHeaders/tns2:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns4:trackID>&#xa;                    &lt;/tns4:Identifier>&#xa;                    &lt;tns4:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns4:track_position>&#xa;                    &lt;tns4:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns4:Timestamp>&#xa;                    &lt;tns4:ErrorLog/>&#xa;                &lt;/tns4:Envelope>&#xa;                &lt;tns4:Playload>&#xa;                    &lt;tns4:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($post/item/tns:inputComuniCoinvestiti )))&quot;/>&#xa;                    &lt;/tns4:Binary>&#xa;                    &lt;tns4:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($post/item/tns:inputComuniCoinvestiti)&quot;/>&#xa;                    &lt;/tns4:XMLString>&#xa;                &lt;/tns4:Playload>&#xa;            &lt;/tns4:ActiveLoggerServices>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
