                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e19a898e-df6c-47c3-a6b3-1aa66b8ee440+input&quot; xmlns:tns3=&quot;http://xmlns.example.com/DettaglioContratto/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;DettaglioContratto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idContratto>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns3:idContratto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns3:idContratto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idContratto>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT C.FLAG_ABILITATO, C.FLAG_FILE_NOTIFY, C.FLAG_VALIDO, C.DATAFI_VALID, C.DATAINZ_VALID, COC.DATAFI_ASSOCZ_VALID, COC.DATAINZ_ASSOCZ_VALID, COC.ID_CONTRATTO_OFFERTA_CATLG, &#xa;C.COD_CONTRATTO, C.COD_OLO, C.CODFC_OLO_AGCOM, C.NOME_CONTRATTO, O.NOME_OFFERTA_CATLG, FO.DESCR, SFO.DESCR AS SOTTOFAMIGLIA, TC.DESCR AS TIPOCONTRATTO,&#xa;C.DATA_INIZIO_COINV_RETE,C.DATA_FINE_COINV_RETE,C.FLAG_MULTICAST,&#xa;C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV, C.EMAIL_OFFERTAFWA1GIGASARDEGNA&#xa;FROM CONTRATTO C&#xa;LEFT JOIN CONTRATTO_OFFERTA_CATLG COC ON COC.ID_CONTRATTO = C.ID_CONTRATTO&#xa;LEFT JOIN OFFERTA O ON O.ID_OFFERTA = COC.ID_OFFERTA&#xa;LEFT JOIN FAMIG_OFFERTA FO ON FO.ID_FAMIG_OFFERTA = C.ID_FAMIG_OFFERTA&#xa;LEFT JOIN SOTTO_FAMIG_OFFERTA SFO ON SFO.ID_SOTTOFAMIG_OFFERTA = C.ID_SOTTOFAMIG_OFFERTA&#xa;LEFT JOIN TIPOLG_CONTRATTO TC ON TC.IDTPLG_CONTRATTO = C.IDTPLG_CONTRATTO&#xa;WHERE C.ID_CONTRATTO = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idContratto"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="FLAG_ABILITATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="FLAG_FILE_NOTIFY"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="FLAG_VALIDO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="4"
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="5"
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="6"
                                    columnName="DATAFI_ASSOCZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="7"
                                    columnName="DATAINZ_ASSOCZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="8"
                                    columnName="ID_CONTRATTO_OFFERTA_CATLG"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnIndex="9"
                                    columnName="COD_CONTRATTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="10"
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="11"
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="12"
                                    columnName="NOME_CONTRATTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="13"
                                    columnName="NOME_OFFERTA_CATLG"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="14"
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="15"
                                    columnName="SOTTOFAMIGLIA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="16"
                                    columnName="TIPOCONTRATTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="17"
                                    columnName="DATA_INIZIO_COINV_RETE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="18"
                                    columnName="DATA_FINE_COINV_RETE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="19"
                                    columnName="FLAG_MULTICAST"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="20"
                                    columnName="FLAG_DISABILITAZIONE_SERV"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="21"
                                    columnName="DATA_INI_DISABILITAZIONE_SERV"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="22"
                                    columnName="DATA_FIN_DISABILITAZIONE_SERV"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="23"
                                    columnName="EMAIL_OFFERTAFWA1GIGASARDEGNA"
                                    dataType="12"
