                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/dettaglioContratto&quot; xmlns:tns1=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VariableAppoggio&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns1:CryptoListParamsInput>&lt;xsl:for-each select=&quot;$VariableAppoggio/tns:dettaglioContratto/tns:listaFileCsv&quot;>&lt;tns1:listIdFile>&lt;xsl:if test=&quot;tns:idFile&quot;>&lt;tns1:idFile>&lt;xsl:value-of select=&quot;tns:idFile&quot;/>&lt;/tns1:idFile>&lt;/xsl:if>&lt;/tns1:listIdFile>&lt;/xsl:for-each>&lt;/tns1:CryptoListParamsInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
