                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaFileSediCanali&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperaListaNoOLO&quot;/>&lt;xsl:param name=&quot;RecuperaListaOLO&quot;/>&lt;xsl:param name=&quot;DatiCalcolabili&quot;/>&lt;xsl:template name=&quot;VariableAppoggio&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperaListaOLO/Record/ID_FILE)>0&quot;>&lt;tns:VisualizzaFileSediCanaliOutput>&lt;xsl:for-each select=&quot;$RecuperaListaOLO/Record&quot;>&lt;tns:outputVisualizzaFileSediCanali>&lt;xsl:variable name=&quot;currIdOLO&quot; select=&quot;ID_FILE&quot;/>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;tns:tipologiaTracciato>&lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&lt;/tns:tipologiaTracciato>&lt;tns:dataInserimentoFile>&lt;xsl:value-of select=&quot;DATAINSERIMENTO&quot;/>&lt;/tns:dataInserimentoFile>&lt;xsl:if test=&quot;$DatiCalcolabili/tns:dati[tns:idFile = xsd:string($currIdOLO)]/tns:dataUltimoAggiornamento&quot;>&lt;tns:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;$DatiCalcolabili/tns:dati[tns:idFile = xsd:string($currIdOLO)]/tns:dataUltimoAggiornamento&quot;/>&lt;/tns:dataUltimoAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;$DatiCalcolabili/tns:dati[tns:idFile = xsd:string($currIdOLO)]/tns:numOrdini&quot;>&lt;tns:numeroOrdini>&lt;xsl:value-of select=&quot;$DatiCalcolabili/tns:dati[tns:idFile = xsd:string($currIdOLO)]/tns:numOrdini&quot;/>&lt;/tns:numeroOrdini>&lt;/xsl:if>&lt;tns:statoElaborazioneFile>&lt;xsl:value-of select=&quot;STATOELABFILE&quot;/>&lt;/tns:statoElaborazioneFile>&lt;tns:idFile>&lt;xsl:value-of select=&quot;ID_FILE&quot;/>&lt;/tns:idFile>&lt;xsl:if test=&quot;CHIAVE&quot;>&lt;tns:idInterfaccia>&lt;xsl:value-of select=&quot;CHIAVE&quot;/>&lt;/tns:idInterfaccia>&lt;/xsl:if>&lt;tns:position>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:position>&lt;/tns:outputVisualizzaFileSediCanali>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:VisualizzaFileSediCanaliOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;count($RecuperaListaNoOLO/Record/ID_FILE)>0&quot;>&lt;tns:VisualizzaFileSediCanaliOutput>&lt;xsl:for-each select=&quot;$RecuperaListaNoOLO/Record&quot;>&lt;tns:outputVisualizzaFileSediCanali>&lt;xsl:variable name=&quot;currIdDG&quot; select=&quot;ID_FILE&quot;/>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;tns:tipologiaTracciato>&lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&lt;/tns:tipologiaTracciato>&lt;tns:dataInserimentoFile>&lt;xsl:value-of select=&quot;DATAINSERIMENTO&quot;/>&lt;/tns:dataInserimentoFile>&lt;xsl:if test=&quot;$DatiCalcolabili/tns:dati[tns:idFile = xsd:string($currIdDG)]/tns:dataUltimoAggiornamento&quot;>&lt;tns:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;$DatiCalcolabili/tns:dati[tns:idFile = xsd:string($currIdDG)]/tns:dataUltimoAggiornamento&quot;/>&lt;/tns:dataUltimoAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;$DatiCalcolabili/tns:dati[tns:idFile = xsd:string($currIdDG)]/tns:numOrdini&quot;>&lt;tns:numeroOrdini>&lt;xsl:value-of select=&quot;$DatiCalcolabili/tns:dati[tns:idFile = xsd:string($currIdDG)]/tns:numOrdini&quot;/>&lt;/tns:numeroOrdini>&lt;/xsl:if>&lt;tns:statoElaborazioneFile>&lt;xsl:value-of select=&quot;STATOELABFILE&quot;/>&lt;/tns:statoElaborazioneFile>&lt;tns:idFile>&lt;xsl:value-of select=&quot;ID_FILE&quot;/>&lt;/tns:idFile>&lt;xsl:if test=&quot;CHIAVE&quot;>&lt;tns:idInterfaccia>&lt;xsl:value-of select=&quot;CHIAVE&quot;/>&lt;/tns:idInterfaccia>&lt;/xsl:if>&lt;tns:position>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:position>&lt;/tns:outputVisualizzaFileSediCanali>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:VisualizzaFileSediCanaliOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VisualizzaFileSediCanaliOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record presente in lista.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:VisualizzaFileSediCanaliOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
