tion=$pos]/tns1:idFileCriptato&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:idInterfaccia&quot;>&lt;tns:idInterfaccia>&lt;xsl:value-of select=&quot;tns:idInterfaccia&quot;/>&lt;/tns:idInterfaccia>&lt;/xsl:if>&lt;/tns:outputVisualizzaFileSediCanali>&lt;/xsl:for-each>&lt;xsl:copy-of select=&quot;$VariableAppoggio/tns:result&quot;/>&lt;/tns:VisualizzaFileSediCanaliOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
