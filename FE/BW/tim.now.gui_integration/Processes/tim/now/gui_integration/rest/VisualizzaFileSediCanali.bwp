                                    <bpws:sources>
                                    <bpws:source linkName="VisualizzaFileSediCanali_OLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($Profili, $get/parameters/tns:visualizzafilesedicanaliGetParameters/tns:tipoProfilo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
