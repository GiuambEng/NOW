                                    tibex:xpdlId="ca5d21ec-0dea-466c-ac27-4abe8a369c5b" variable="Reply-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20210615151336PLT" xmlns:tns="http://www.example.org/VisualizzaFileSediCanali" version="2.0"&gt;
