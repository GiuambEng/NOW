                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a7381060-6301-4386-aa73-5d71de979947+input&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaListaNoOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaListaOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiCalcolabili-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($RecuperaListaOLO/Record/ID_FILE)>0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT MAX(LASTUPDATE) AS DATAULTIMOAGGIORNAMENTO,COUNT(*) AS NUMERO_ORDINI,IDFILEINPUT AS ID_FILE FROM BDS_1_CASEDATA_RICHIESTA WHERE IDFILEINPUT IN (&amp;quot;,tib:concat-sequence-format($RecuperaListaOLO/Record/ID_FILE, &amp;quot;,&amp;quot;, true()),&amp;quot;) GROUP BY IDFILEINPUT&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT MAX(LASTUPDATE) AS DATAULTIMOAGGIORNAMENTO,COUNT(*) AS NUMERO_ORDINI,IDFILEINPUT AS ID_FILE FROM BDS_1_CASEDATA_RICHIESTA WHERE IDFILEINPUT IN (&amp;quot;,tib:concat-sequence-format($RecuperaListaNoOLO/Record/ID_FILE, &amp;quot;,&amp;quot;, true()),&amp;quot;) GROUP BY IDFILEINPUT&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
