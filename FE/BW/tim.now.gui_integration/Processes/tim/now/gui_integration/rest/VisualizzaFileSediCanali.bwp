                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://xmlns.example.com/VisualizzaFileSediCanali/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzaFileSediCanali_LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaFileSediCanali&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaFileSediCanali&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Input_VisualizzaFileSediCanali:&amp;quot;,tib:render-xml($get/parameters/tns3:visualizzafilesedicanaliGetParameters, true(),true()))&quot;