                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CHIAVE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
