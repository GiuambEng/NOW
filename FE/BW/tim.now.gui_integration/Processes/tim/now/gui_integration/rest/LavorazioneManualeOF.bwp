o)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$get1.parameters/tns1:idRichiestaOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns0:value>&#xa;                &lt;/ns0:parameter>&#xa;                &lt;ns0:parameter>&#xa;                    &lt;ns0:name>&#xa;                        &lt;xsl:value-of select=&quot;'TipoSbloccoFBS'&quot;/>&#xa;                    &lt;/ns0:name>&#xa;                    &lt;ns0:value>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ConfermaScarto_C11M08F103&amp;quot;&quot;/>&#xa;                    &lt;/ns0:value>&#xa;                &lt;/ns0:parameter>&#xa;            &lt;/ns0:parameterMap>&#xa;        &lt;/ns0:createProcessInstanceInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
