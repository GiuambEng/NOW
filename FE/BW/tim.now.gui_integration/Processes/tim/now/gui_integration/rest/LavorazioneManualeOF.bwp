                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns8=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerError&quot;/>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;confermascartoOF_ErrorLog-input&quot; match=&quot;/&quot;>&lt;tns7:CW_BUS_MESSAGE>&lt;tns7:GenericLogger>&lt;tns7:Process>&lt;xsl:value-of select=&quot;&amp;quot;confermascartoOF&amp;quot;&quot;/>&lt;/tns7:Process>&lt;tns7:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.confermascartoOF&amp;quot;&quot;/>&lt;/tns7:Service>&lt;tns7:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns7:Operation>&lt;xsl:if test=&quot;$get1/httpHeaders/tns8:httpHeaders/GUI-SID&quot;>&lt;tns7:BusinessID>&lt;xsl:value-of select=&quot;$get1/httpHeaders/tns8:httpHeaders/GUI-SID&quot;/>&lt;/tns7:BusinessID>&lt;/xsl:if>&lt;tns7:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Error_confermascartoOF:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&lt;/tns7:Payload>&lt;tns7:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns7:LoggerName>&lt;tns7:LogLevel>&lt;xsl:value-of select=&quot;$LoggerError&quot;/>&lt;/tns7:LogLevel>&lt;tns7:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns7:LogJMS>&lt;/tns7:GenericLogger>&lt;tns7:ActiveLoggerServices>&lt;tns7:Envelope>&lt;tns7:Identifier>&lt;tns7:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.confermascartoOF&amp;quot;&quot;/>&lt;/tns7:ServiceName>&lt;tns7:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns7:Source