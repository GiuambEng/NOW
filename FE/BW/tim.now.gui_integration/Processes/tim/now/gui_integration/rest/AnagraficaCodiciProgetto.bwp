&quot;/>&lt;/tns1:codiceProgetto>&lt;tns1:servizioOpzionalePadre>&lt;xsl:value-of select=&quot;SERVZ_OPZ_PADRE&quot;/>&lt;/tns1:servizioOpzionalePadre>&lt;tns1:servizioOpzionaleAlternativo>&lt;xsl:value-of select=&quot;SERVZ_OPZ_ALTERNATIVO&quot;/>&lt;/tns1:servizioOpzionaleAlternativo>&lt;tns1:descrizioneAnagraficaServizioOpzionale>&lt;xsl:value-of select=&quot;DESCR_ANAG_SERVZ_OPZ&quot;/>&lt;/tns1:descrizioneAnagraficaServizioOpzionale>&lt;tns1:dataInizioValidita>&lt;xsl:value-of select=&quot;DATA_INIZ_VAL&quot;/>&lt;/tns1:dataInizioValidita>&lt;tns1:dataFineValidita>&lt;xsl:value-of select=&quot;DATA_FINE_VAL&quot;/>&lt;/tns1:dataFineValidita>&lt;xsl:if test=&quot;DATI_TECNICI&quot;>&lt;tns1:datiTecnici>&lt;xsl:value-of select=&quot;DATI_TECNICI&quot;/>&lt;/tns1:datiTecnici>&lt;/xsl:if>&lt;xsl:if test=&quot;VINCOLANTE_ESPLETAMENTO&quot;>&lt;tns1:vincolanteEspletamento>&lt;xsl:value-of select=&quot;VINCOLANTE_ESPLETAMENTO&quot;/>&lt;/tns1:vincolanteEspletamento>&lt;/xsl:if>&lt;/tns1:listaServiziOpzionaliAlternativi>&lt;/xsl:for-each>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:code>&lt;/tns1:result>&lt;/tns1:AnagraficaCodiciProgettoOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:AnagraficaCodiciProgettoOutput>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:code>&lt;tns1:details>&lt;xsl:value-of select=&quot;'Nessun Record Trovato'&quot;/>&lt;/tns1:details>&lt;/tns1:result>&lt;/tns1:AnagraficaCodiciProgettoOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
