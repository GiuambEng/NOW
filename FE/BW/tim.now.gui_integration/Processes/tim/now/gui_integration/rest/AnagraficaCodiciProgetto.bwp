                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerMsg&quot;/>&lt;xsl:template name=&quot;anagraficacodiciprogetto_InputLog-input&quot; match=&quot;/&quot;>&lt;tns6:CW_BUS_MESSAGE>&lt;tns6:GenericLogger>&lt;tns6:Process>&lt;xsl:value-of select=&quot;&amp;quot;VisualizzaExsternalData&amp;quot;&quot;/>&lt;/tns6:Process>&lt;tns6:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.anagraficacodiciprogetto&amp;quot;&quot;/>&lt;/tns6:Service>&lt;tns6:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns6:Operation>&lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&lt;/tns6:BusinessID>&lt;/xsl:if>&lt;tns6:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;InputVisualizzaExsternalData:&amp;quot;,&amp;quot;&amp;quot;)&quot;/>&lt;/tns6:Payload>&lt;tns6:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns6:LoggerName>&lt;tns6:LogLevel>&lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&lt;/tns6:LogLevel>&lt;tns6:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns6:LogJMS>&lt;/tns6:GenericLogger>&lt;tns6:ActiveLoggerServices>&lt;tns6:Envelope>&lt;tns6:Identifier>&lt;tns6:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaExsternalData&amp;quot;&quot;/>&lt;/tns6:ServiceName>&lt;tns6:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns6:Operation>&lt;tns6:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns6:Source>&lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&lt;tns6:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&lt;/tns6:BusinessID>&lt;/xsl:if>&lt;tns6:EventID>&lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns4:httpHeaders/GUI-SID,$get/httpHeaders/tns4:httpHeaders/GUI-TID)&quot;/>&lt;/tns6:EventID>&lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-TID&quot;>&lt;tns6:CorrelationID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-TID&quot;/>&lt;/tns6:CorrelationID>&lt;/xsl:if>&lt;tns6:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&lt;/tns6:EventType>&lt;tns6:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID)&quot;/>&lt;/tns6:trackID>&lt;/tns6:Identifier>&lt;tns6:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns6:track_position>&lt;tns6:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns6:Timestamp>&lt;/tns6:Envelope>&lt;tns6:Playload>&lt;tns6:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get/httpHeaders/tns4:httpHeaders )))&quot;/>&lt;/tns6:Binary>&lt;tns6:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($get/httpHeaders/tns4:httpHeaders)&quot;/>&lt;/tns6:XMLString>&lt;/tns6:Playload>&lt;/tns6:ActiveLoggerServices>&lt;/tns6:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
