                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20240819151614PLT" xmlns:tns1="http://www.example.org/AnagraficaCodiciProgetto" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:getResponse&gt;&lt;item&gt;&lt;tns1:AnagraficaCodiciProgettoOutput&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="'ERROR'"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/tns1:code&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/tns1:details&gt;&lt;/tns1:result&gt;&lt;/tns1:AnagraficaCodiciProgettoOutput&gt;&lt;/item&gt;&lt;/tns:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
