                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT aoa.cod_progetto,aoa.servz_opz_padre, aoa.servz_opz_alternativo, aoa.data_iniz_val, &#xa;        aoa.data_fine_val, aoa.dati_tecnici, aoa.vincolante_espletamento, ao.descr_anag_servz_opz&#xa;FROM anag_servz_opz_alternativo aoa &#xa;INNER JOIN anag_servz_opzionale ao ON &#xa;    aoa.id_anag_servz_opz_alternativo=ao.ID_ANAG_SERVZ_OPZ" xsi:type="jdbcPalette:JDBCQueryActivity">
