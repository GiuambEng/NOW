                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e571cee8-2dce-4897-9b80-e840ff49d4f3+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT aoa.cod_progetto, aoa.codifica_olo_agcom, aoa.data_inizio_val, aoa.data_fine_val, aoa.dati_tecnici, aoa.vincolante_espl, ao.descr_anag_servz_opz, ao.cod_anag_servz_opz, o.offerta&#xa;FROM anag_servz_opzionali_auto aoa &#xa;INNER JOIN anag_servz_opzionale ao ON aoa.id_anag_servz_opz=ao.id_anag_servz_opz&#xa;INNER JOIN offerta o on aoa.id_offerta=o.id_offerta&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="COD_PROGETTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="CODIFICA_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="DATA_INIZIO_VAL"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="4"
                                    columnName="DATA_FINE_VAL"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="5"
                                    columnName="DATI_TECNICI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="6"
                                    columnName="VINCOLANTE_ESPL"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="7"
                                    columnName="DESCR_ANAG_SERVZ_OPZ"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="8"
                                    columnName="COD_ANAG_SERVZ_OPZ"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="9"
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
