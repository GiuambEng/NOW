                                    columnName="DATA_INIZ_VAL"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="5"
                                    columnName="DATA_FINE_VAL"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="6"
                                    columnName="DATI_TECNICI"
