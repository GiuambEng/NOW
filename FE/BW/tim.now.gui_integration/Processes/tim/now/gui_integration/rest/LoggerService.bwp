=&quot;$post1.item/tns:IP_SERVER&quot;>&#xa;                &lt;tns1:IP_SERVER>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:IP_SERVER&quot;/>&#xa;                &lt;/tns1:IP_SERVER>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:OS_USER&quot;>&#xa;                &lt;tns1:OS_USER>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:OS_USER&quot;/>&#xa;                &lt;/tns1:OS_USER>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:PARAMETRI_OPERAZIONE&quot;>&#xa;                &lt;tns1:PARAMETRI_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:PARAMETRI_OPERAZIONE&quot;/>&#xa;                &lt;/tns1:PARAMETRI_OPERAZIONE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:SERVER_NAME&quot;>&#xa;                &lt;tns1:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:SERVER_NAME&quot;/>&#xa;                &lt;/tns1:SERVER_NAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:SESSION_ID&quot;>&#xa;                &lt;tns1:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:SESSION_ID&quot;/>&#xa;                &lt;/tns1:SESSION_ID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:TIMSTP_INSMTO&quot;>&#xa;                &lt;tns1:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:TIMSTP_INSMTO&quot;/>&#xa;                &lt;/tns1:TIMSTP_INSMTO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:TIPO_OPERAZIONE&quot;>&#xa;                &lt;tns1:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:TIPO_OPERAZIONE&quot;/>&#xa;                &lt;/tns1:TIPO_OPERAZIONE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:USERID&quot;>&#xa;                &lt;tns1:USERID>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:USERID&quot;/>&#xa;                &lt;/tns1:USERID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:TIMSTP_INIZIO&quot;>&#xa;                &lt;tns1:TIMSTP_INIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:TIMSTP_INIZIO&quot;/>&#xa;                &lt;/tns1:TIMSTP_INIZIO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:TIMSTP_FINE&quot;>&#xa;                &lt;tns1:TIMSTP_FINE>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:TIMSTP_FINE&quot;/>&#xa;                &lt;/tns1:TIMSTP_FINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:NUM_DATI_ESPORTATI&quot;>&#xa;                &lt;tns1:NUM_DATI_ESPORTATI>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:NUM_DATI_ESPORTATI&quot;/>&#xa;                &lt;/tns1:NUM_DATI_ESPORTATI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:CONTENUTO_FILE&quot;>&#xa;                &lt;tns1:CONTENUTO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:CONTENUTO_FILE&quot;/>&#xa;                &lt;/tns1:CONTENUTO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:NOME_FILE&quot;>&#xa;                &lt;tns1:NOME_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:NOME_FILE&quot;/>&#xa;                &lt;/tns1:NOME_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:ESITO&quot;>&#xa;                &lt;tns1:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:ESITO&quot;/>&#xa;                &lt;/tns1:ESITO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:LoggerInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_integration.db.LoginLogoutInsert" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/LoggerSecurityService&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post1&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input ricevuti: &amp;quot;,tib:render-xml($post1/item/tns1:loggerSecurityInput,xsd:boolean(0),xsd:boolean(1)))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Log-input" name="Log"
                                    tibex:xpdlId="fea0bb27-9c7e-448b-8d14-053151cb65c6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStart1ToLog"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogToCallProcess1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/LoggerSecurityService&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Input ricevuti: &amp;quot;,tib:render-xml($post1.item,xsd:boolean(0),xsd:boolean(1)))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
