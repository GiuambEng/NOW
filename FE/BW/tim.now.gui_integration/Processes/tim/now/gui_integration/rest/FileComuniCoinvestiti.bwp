                                    <bpws:sources>
                                    <bpws:source linkName="RicercaAvanzataToAssign7">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($post2/item/ns2:AnagraficaFileComuniInput/ns2:strutturaCondition[ns2:nome='AFC.IDFILE'])=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($post2.item/ns2:strutturaCondition[ns2:nome='AFC.IDFILE'])=0]]></bpws:transitionCondition>
