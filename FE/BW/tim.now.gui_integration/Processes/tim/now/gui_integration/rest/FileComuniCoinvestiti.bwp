                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ComuniCoinvestiti&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileComuniCoinvestiti/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoLista&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;Appoggio&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperoLista/Record/NOME_FILE)>0&quot;>&lt;tns:ListaFileComuniCoinvestitiOutput>&lt;xsl:for-each select=&quot;$RecuperoLista/Record&quot;>&lt;tns:listaFileComuniCoinvestiti>&lt;xsl:if test=&quot;$get/parameters/tns1:listafilecomunicoinvestitiGetParameters/tns1:codOloAgcom&quot;>&lt;tns:oao>&lt;xsl:value-of select=&quot;$get/parameters/tns1:listafilecomunicoinvestitiGetParameters/tns1:codOloAgcom&quot;/>&lt;/tns:oao>&lt;/xsl:if>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;tns:tipologiaTracciato>&lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&lt;/tns:tipologiaTracciato>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TIMSTP_APERTURA_FILE&quot;/>&lt;/tns:dataInserimento>&lt;xsl:if test=&quot;TIMSTP_CHIUSURA_FILE&quot;>&lt;tns:dataAggiornamento>&lt;xsl:value-of select=&quot;TIMSTP_CHIUSURA_FILE&quot;/>&lt;/tns:dataAggiornamento>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;DESCR_STATO_FILE = ('ERRORE','SCARTATO','ERRORE APERTURA FILE')&quot;>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'FILE NON LEGGIBILE'&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:when>&lt;xsl:when test=&quot;DESCR_STATO_FILE = ('APERTO','IN ELABORAZIONE')&quot;>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'IN CORSO DI ELABORAZIONE'&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:when>&lt;xsl:when test=&quot;ERRORS>0 or ESITO = 'KO'&quot;>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'ELABORAZIONE SCARTATA'&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'ELABORAZIONE COMPLETATA'&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;tns:idFile>&lt;xsl:value-of select=&quot;ID_FILE&quot;/>&lt;/tns:idFile>&lt;tns:position>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:position>&lt;/tns:listaFileComuniCoinvestiti>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:ListaFileComuniCoinvestitiOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ListaFileComuniCoinvestitiOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record in lista.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:ListaFileComuniCoinvestitiOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
