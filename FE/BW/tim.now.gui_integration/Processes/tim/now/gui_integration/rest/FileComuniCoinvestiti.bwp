                                    sqlStatement="SELECT CODICE_ISTAT_COMUNE,DESCRIZIONE_COMUNE,DATA_INIZIO_VAL,DATA_FINE_VAL,ID_STATO_ELAB_STAG,DESCRIZIONE_ERRORE,&#xa;COMUNE_COINVESTITO&#xa;FROM STAG_CATAL_OFF_COM_COINV_FILE&#xa;WHERE ID_FILE_PROCSTO_INPUT = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

