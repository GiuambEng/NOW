                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaFileComuniCoinvestiti_LogOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ListaFileComuniCoinvestiti&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.ListaFileComuniCoinvestiti&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputListaFileComuniCoinvestiti:&amp;quot;,substring(tib:render-xml($Variable, true(),true()),1,500),&amp;quot;.....&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.ListaFileComuniCoinvestiti&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ListaFileComuniCoinvestiti_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ListaFileComuniCoinvestiti_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog/>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a06d83a2-98f6-4357-83c9-61a92899b6b8+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileComuniCoinvestiti/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoLista-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idContratto>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get/parameters/tns1:listafilecomunicoinvestitiGetParameters/tns1:idContratto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get/parameters/tns1:listafilecomunicoinvestitiGetParameters/tns1:idContratto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idContratto>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoLista-input"
                                    name="RecuperoLista"
                                    outputVariable="RecuperoLista"
                                    tibex:xpdlId="a06d83a2-98f6-4357-83c9-61a92899b6b8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ListaFileComuniCoinvestiti_LogInfoToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoListaToAppoggio"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a06d83a2-98f6-4357-83c9-61a92899b6b8+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileComuniCoinvestiti/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoLista-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idContratto>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:idContratto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:idContratto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idContratto>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT FP.NOME_FILE, FP.TIMSTP_APERTURA_FILE, FP.TIMSTP_CHIUSURA_FILE, I.DESCR_INTRFC, FP.DESCR_STATO_FILE,&#xa;(SELECT COUNT(*) FROM STAG_CATAL_OFF_COM_COINV_FILE CCF WHERE CCF.ID_FILE_PROCSTO_INPUT = FP.ID_FILE &#xa;AND CCF.ID_STATO_ELAB_STAG = 3) AS ERRORS,FP.ID_FILE,FP.ESITO,O.OFFERTA &#xa;FROM FILE_PROCSTO FP INNER JOIN INTRFC I ON FP.ID_INTRFC = I.ID_INTRFC&#xa;INNER JOIN ASS_FILE_COMUNI_COINV AFC ON FP.ID_FILE = AFC.IDFILE&#xa;INNER JOIN CONTRATTO_OFFERTA_CATLG COC ON COC.ID_CONTRATTO = AFC.ID_CONTRATTO&#xa;INNER JOIN OFFERTA O ON O.ID_OFFERTA = COC.ID_OFFERTA&#xa;WHERE AFC.ID_CONTRATTO=? AND I.COD_INTRFC = 'ID372'&#xa;ORDER BY FP.ID_FILE DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idContratto"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_APERTURA_FILE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CHIUSURA_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DESCR_INTRFC"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_STATO_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ERRORS"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ESITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ComuniCoinvestiti&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileComuniCoinvestiti/parameters&quot; xmlns:tns2=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;Appoggio&quot;/>&lt;xsl:param name=&quot;CryptoListParams&quot;/>&lt;xsl:param name=&quot;FileDaElaborare&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Appoggio/tns:listaFileComuniCoinvestiti/tns:nomeFile)>0 or count($FileDaElaborare/Record/NOME_FILE)>0&quot;>&lt;tns:ListaFileComuniCoinvestitiOutput>&lt;xsl:for-each select=&quot;$Appoggio/tns:listaFileComuniCoinvestiti&quot;>&lt;tns:listaFileComuniCoinvestiti>&lt;xsl:variable name=&quot;pos&quot; select=&quot;current()/tns:position&quot;/>&lt;xsl:if test=&quot;$get/parameters/tns1:listafilecomunicoinvestitiGetParameters/tns1:codOloAgcom&quot;>&lt;tns:oao>&lt;xsl:value-of select=&quot;$get/parameters/tns1:listafilecomunicoinvestitiGetParameters/tns1:codOloAgcom&quot;/>&lt;/tns:oao>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nomeFile&quot;>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;tns:nomeFile&quot;/>&lt;/tns:nomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:tipologiaTracciato&quot;>&lt;tns:tipologiaTracciato>&lt;xsl:value-of select=&quot;tns:tipologiaTracciato&quot;/>&lt;/tns:tipologiaTracciato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataInserimento&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;tns:dataInserimento&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataAggiornamento&quot;>&lt;tns:dataAggiornamento>&lt;xsl:value-of select=&quot;tns:dataAggiornamento&quot;/>&lt;/tns:dataAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:statoElaborazione&quot;>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;tns:statoElaborazione&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:offerta&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;tns:offerta&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;$CryptoListParams/tns2:ListIdFileOutput[tns2:position=$pos]/tns2:idFileCriptato&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;$CryptoListParams/tns2:ListIdFileOutput[tns2:position=$pos]/tns2:idFileCriptato&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;/tns:listaFileComuniCoinvestiti>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$FileDaElaborare/Record&quot;>&lt;tns:listaFileComuniCoinvestiti>&lt;xsl:if test=&quot;$get/parameters/tns1:listafilecomunicoinvestitiGetParameters/tns1:codOloAgcom&quot;>&lt;tns:oao>&lt;xsl:value-of select=&quot;$get/parameters/tns1:listafilecomunicoinvestitiGetParameters/tns1:codOloAgcom&quot;/>&lt;/tns:oao>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_FILE&quot;>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;TIMESTAMP_INS&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TIMESTAMP_INS&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'DA ELABORARE'&quot;/>&lt;/tns:statoElaborazione>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/tns:listaFileComuniCoinvestiti>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:ListaFileComuniCoinvestitiOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ListaFileComuniCoinvestitiOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record in lista.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:ListaFileComuniCoinvestitiOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Variable"
                                    name="Assign"
                                    outputVariable="Variable"
                                    tibex:xpdlId="5bcf3666-9dab-4160-b2f9-83be7c99e5d5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToListaFileComuniCoinvestiti_LogOutput"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ComuniCoinvestiti&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileComuniCoinvestiti/parameters&quot; xmlns:tns2=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Appoggio&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoListParams&quot;/>&#xa;    &lt;xsl:param name=&quot;FileDaElaborare&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($Appoggio/tns:listaFileComuniCoinvestiti/tns:nomeFile)>0 or count($FileDaElaborare/Record/NOME_FILE)>0&quot;>&#xa;                &lt;tns:ListaFileComuniCoinvestitiOutput>&#xa;                    &lt;xsl:for-each select=&quot;$Appoggio/tns:listaFileComuniCoinvestiti&quot;>&#xa;                        &lt;tns:listaFileComuniCoinvestiti>&#xa;                            &lt;xsl:variable name=&quot;pos&quot; select=&quot;current()/tns:position&quot;/>&#xa;                            &lt;xsl:if test=&quot;$get.parameters/tns1:codOloAgcom&quot;>&#xa;                                &lt;tns:oao>&#xa;                                    &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOloAgcom&quot;/>&#xa;                                &lt;/tns:oao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:nomeFile&quot;>&#xa;                                &lt;tns:nomeFile>&#xa;                                    &lt;xsl:value-of select=&quot;tns:nomeFile&quot;/>&#xa;                                &lt;/tns:nomeFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:tipologiaTracciato&quot;>&#xa;                                &lt;tns:tipologiaTracciato>&#xa;                                    &lt;xsl:value-of select=&quot;tns:tipologiaTracciato&quot;/>&#xa;                                &lt;/tns:tipologiaTracciato>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:dataInserimento&quot;>&#xa;                                &lt;tns:dataInserimento>&#xa;                                    &lt;xsl:value-of select=&quot;tns:dataInserimento&quot;/>&#xa;                                &lt;/tns:dataInserimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:dataAggiornamento&quot;>&#xa;                                &lt;tns:dataAggiornamento>&#xa;                                    &lt;xsl:value-of select=&quot;tns:dataAggiornamento&quot;/>&#xa;                                &lt;/tns:dataAggiornamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:statoElaborazione&quot;>&#xa;                                &lt;tns:statoElaborazione>&#xa;                                    &lt;xsl:value-of select=&quot;tns:statoElaborazione&quot;/>&#xa;                                &lt;/tns:statoElaborazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:offerta&quot;>&#xa;                                &lt;tns:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;tns:offerta&quot;/>&#xa;                                &lt;/tns:offerta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$CryptoListParams/tns2:ListIdFileOutput[tns2:position=$pos]/tns2:idFileCriptato&quot;>&#xa;                                &lt;tns:idFile>&#xa;                                    &lt;xsl:value-of select=&quot;$CryptoListParams/tns2:ListIdFileOutput[tns2:position=$pos]/tns2:idFileCriptato&quot;/>&#xa;                                &lt;/tns:idFile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:listaFileComuniCoinvestiti>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;$FileDaElaborare/Record&quot;>&#xa;                        &lt;tns:listaFileComuniCoinvestiti>&#xa;                            &lt;xsl:if test=&quot;$get.parameters/tns1:codOloAgcom&quot;>&#xa;                                &lt;tns:oao>&#xa;                                    &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOloAgcom&quot;/>&#xa;                                &lt;/tns:oao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOME_FILE&quot;>&#xa;                                &lt;tns:nomeFile>&#xa;                                    &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                                &lt;/tns:nomeFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIMESTAMP_INS&quot;>&#xa;                                &lt;tns:dataInserimento>&#xa;                                    &lt;xsl:value-of select=&quot;TIMESTAMP_INS&quot;/>&#xa;                                &lt;/tns:dataInserimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:statoElaborazione>&#xa;                                &lt;xsl:value-of select=&quot;'DA ELABORARE'&quot;/>&#xa;                            &lt;/tns:statoElaborazione>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                        &lt;/tns:listaFileComuniCoinvestiti>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:ListaFileComuniCoinvestitiOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:ListaFileComuniCoinvestitiOutput>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun record in lista.'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:ListaFileComuniCoinvestitiOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
