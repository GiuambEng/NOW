                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="SQLDirect-input"
                                    name="SQLDirect"
                                    outputVariable="SQLDirect"
                                    tibex:xpdlId="88d00c92-13cb-4567-addd-6e94079c1181" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign6ToSQLDirect"/>
                                    <bpws:target linkName="Assign7ToSQLDirect"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SQLDirectToAssignAppoggio"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+88d00c92-13cb-4567-addd-6e94079c1181+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Condition&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat('SELECT DISTINCT AFC.NOME_FILE,AFC.COD_OLO_AGCOM, AFC.TIMESTAMP_INS, FP.TIMSTP_CHIUSURA_FILE, I.DESCR_INTRFC, FP.DESCR_STATO_FILE,(SELECT COUNT(*) FROM STAG_CATAL_OFF_COM_COINV_FILE CCF WHERE CCF.ID_FILE_PROCSTO_INPUT = FP.ID_FILE AND CCF.ID_STATO_ELAB_STAG = 3) AS ERRORS,AFC.IDFILE,FP.ESITO,C.NOME_CONTRATTO,O.OFFERTA FROM ASS_FILE_COMUNI_COINV AFC LEFT JOIN FILE_PROCSTO FP ON AFC.IDFILE = FP.ID_FILE LEFT JOIN INTRFC I ON FP.ID_INTRFC = I.ID_INTRFC INNER JOIN CONTRATTO_OFFERTA_CATLG COC ON COC.ID_CONTRATTO = AFC.ID_CONTRATTO INNER JOIN OFFERTA O ON O.ID_OFFERTA = COC.ID_OFFERTA INNER JOIN CONTRATTO C ON C.ID_CONTRATTO = COC.ID_CONTRATTO WHERE ', $Condition)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
