                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ComuniCoinvestiti&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.org/CryptoListParams&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AnagraficaOutput&quot;/>&lt;xsl:param name=&quot;CryptIds&quot;/>&lt;xsl:template name=&quot;AnagraficaOutput&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AnagraficaOutput/tns:listaFileComuniCoinvestiti/tns:nomeFile)>0&quot;>&lt;tns:ListaFileComuniCoinvestitiOutput>&lt;xsl:for-each select=&quot;$AnagraficaOutput/tns:listaFileComuniCoinvestiti&quot;>&lt;tns:listaFileComuniCoinvestiti>&lt;xsl:variable name=&quot;pos&quot; select=&quot;current()/tns:position&quot;/>&lt;xsl:if test=&quot;tns:oao&quot;>&lt;tns:oao>&lt;xsl:value-of select=&quot;tns:oao&quot;/>&lt;/tns:oao>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nomeFile&quot;>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;tns:nomeFile&quot;/>&lt;/tns:nomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataInserimento&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;tns:dataInserimento&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataAggiornamento&quot;>&lt;tns:dataAggiornamento>&lt;xsl:value-of select=&quot;tns:dataAggiornamento&quot;/>&lt;/tns:dataAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:statoElaborazione&quot;>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;tns:statoElaborazione&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:offerta&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;tns:offerta&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nomeContratto&quot;>&lt;tns:nomeContratto>&lt;xsl:value-of select=&quot;tns:nomeContratto&quot;/>&lt;/tns:nomeContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$CryptIds/tns1:ListIdFileOutput[tns1:position=$pos]/tns1:idFileCriptato&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;$CryptIds/tns1:ListIdFileOutput[tns1:position=$pos]/tns1:idFileCriptato&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;/tns:listaFileComuniCoinvestiti>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:ListaFileComuniCoinvestitiOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ListaFileComuniCoinvestitiOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record presente.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:ListaFileComuniCoinvestitiOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
