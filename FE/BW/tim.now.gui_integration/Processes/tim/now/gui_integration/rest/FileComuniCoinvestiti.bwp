                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ComuniCoinvestiti&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileComuniCoinvestiti/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoLista&quot;/>&#xa;    &lt;xsl:template name=&quot;Appoggio&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($RecuperoLista/Record/NOME_FILE)>0&quot;>&#xa;                &lt;tns:ListaFileComuniCoinvestitiOutput>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoLista/Record&quot;>&#xa;                        &lt;tns:listaFileComuniCoinvestiti>&#xa;                            &lt;xsl:if test=&quot;$get.parameters/tns1:codOloAgcom&quot;>&#xa;                                &lt;tns:oao>&#xa;                                    &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOloAgcom&quot;/>&#xa;                                &lt;/tns:oao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:nomeFile>&#xa;                                &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                            &lt;/tns:nomeFile>&#xa;                            &lt;tns:tipologiaTracciato>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&#xa;                            &lt;/tns:tipologiaTracciato>&#xa;                            &lt;tns:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;TIMSTP_APERTURA_FILE&quot;/>&#xa;                            &lt;/tns:dataInserimento>&#xa;                            &lt;xsl:if test=&quot;TIMSTP_CHIUSURA_FILE&quot;>&#xa;                                &lt;tns:dataAggiornamento>&#xa;                                    &lt;xsl:value-of select=&quot;TIMSTP_CHIUSURA_FILE&quot;/>&#xa;                                &lt;/tns:dataAggiornamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;DESCR_STATO_FILE = ('ERRORE','SCARTATO','ERRORE APERTURA FILE')&quot;>&#xa;                                    &lt;tns:statoElaborazione>&#xa;                                        &lt;xsl:value-of select=&quot;'FILE NON LEGGIBILE'&quot;/>&#xa;                                    &lt;/tns:statoElaborazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;DESCR_STATO_FILE = ('APERTO','IN ELABORAZIONE')&quot;>&#xa;                                    &lt;tns:statoElaborazione>&#xa;                                        &lt;xsl:value-of select=&quot;'IN CORSO DI ELABORAZIONE'&quot;/>&#xa;                                    &lt;/tns:statoElaborazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;ERRORS>0 or ESITO = 'KO'&quot;>&#xa;                                    &lt;tns:statoElaborazione>&#xa;                                        &lt;xsl:value-of select=&quot;'ELABORAZIONE SCARTATA'&quot;/>&#xa;                                    &lt;/tns:statoElaborazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:statoElaborazione>&#xa;                                        &lt;xsl:value-of select=&quot;'ELABORAZIONE COMPLETATA'&quot;/>&#xa;                                    &lt;/tns:statoElaborazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                            &lt;tns:idFile>&#xa;                                &lt;xsl:value-of select=&quot;ID_FILE&quot;/>&#xa;                            &lt;/tns:idFile>&#xa;                            &lt;tns:position>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/tns:position>&#xa;                        &lt;/tns:listaFileComuniCoinvestiti>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:ListaFileComuniCoinvestitiOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:ListaFileComuniCoinvestitiOutput>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun record in lista.'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:ListaFileComuniCoinvestitiOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
