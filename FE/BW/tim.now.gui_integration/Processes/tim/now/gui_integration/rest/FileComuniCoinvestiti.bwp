                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperoLista&quot;/>&#xa;    &lt;xsl:template name=&quot;CryptoListParams-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CryptoListParamsInput>&#xa;            &lt;xsl:for-each select=&quot;$RecuperoLista/Record&quot;>&#xa;                &lt;tns1:listIdFile>&#xa;                    &lt;tns1:idFile>&#xa;                        &lt;xsl:value-of select=&quot;ID_FILE&quot;/>&#xa;                    &lt;/tns1:idFile>&#xa;                &lt;/tns1:listIdFile>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:CryptoListParamsInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
