                                    inputVariable="AnagraficaOutput"
                                    name="AssignAppoggio"
                                    outputVariable="AnagraficaOutput"
                                    tibex:xpdlId="6db832bf-0240-4829-a971-169601aba0d3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SQLDirectToAssignAppoggio"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignAppoggioToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ComuniCoinvestiti&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;AnagraficaOutput&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SQLDirect/unknownResultset/row/column[name='NOME_FILE']/value) and string-length(string($SQLDirect/unknownResultset/row/column[name='NOME_FILE']/value))>0&quot;>&lt;tns:ListaFileComuniCoinvestitiOutput>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&lt;tns:listaFileComuniCoinvestiti>&lt;xsl:if test=&quot;not((string(column[name='COD_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO_AGCOM']/value)&quot;>&lt;tns:oao>&lt;xsl:value-of select=&quot;column[name='COD_OLO_AGCOM']/value&quot;/>&lt;/tns:oao>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_FILE']/value)&quot;>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;column[name='NOME_FILE']/value&quot;/>&lt;/tns:nomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIMESTAMP_INS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIMESTAMP_INS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIMESTAMP_INS']/value)&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;column[name='TIMESTAMP_INS']/value&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIMSTP_CHIUSURA_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIMSTP_CHIUSURA_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIMSTP_CHIUSURA_FILE']/value)&quot;>&lt;tns:dataAggiornamento>&lt;xsl:value-of select=&quot;column[name='TIMSTP_CHIUSURA_FILE']/value&quot;/>&lt;/tns:dataAggiornamento>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;column[name='DESCR_STATO_FILE']/value = ('APERTO','IN ELABORAZIONE')&quot;>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'IN CORSO DI ELABORAZIONE'&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:when>&lt;xsl:when test=&quot;column[name='DESCR_STATO_FILE']/value = ('ERRORE','SCARTATO','ERRORE APERTURA FILE')&quot;>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'FILE NON LEGGIBILE'&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string(column[name='DESCR_STATO_FILE']/value))=0&quot;>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'DA ELABORARE'&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:when>&lt;xsl:when test=&quot;column[name='ESITO']/value ='OK'&quot;>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'ELABORAZIONE COMPLETATA'&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:statoElaborazione>&lt;xsl:value-of select=&quot;'ELABORAZIONE SCARTATA'&quot;/>&lt;/tns:statoElaborazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']/value)&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;column[name='OFFERTA']/value&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CONTRATTO']/value)&quot;>&lt;tns:nomeContratto>&lt;xsl:value-of select=&quot;column[name='NOME_CONTRATTO']/value&quot;/>&lt;/tns:nomeContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDFILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDFILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDFILE']/value)&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;column[name='IDFILE']/value&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;tns:position>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:position>&lt;/tns:listaFileComuniCoinvestiti>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:ListaFileComuniCoinvestitiOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ListaFileComuniCoinvestitiOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record presente.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:ListaFileComuniCoinvestitiOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
