                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="donatingRicerca" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty1" tibex:xpdlId="a27f939a-ae52-4305-8d2b-7cd360b07363">
                                <bpws:targets>
                                    <bpws:target linkName="EmptyToEmpty1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty1ToricercaNonOLOQuery_nomeFile">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($get/parameters/tns:ricercaordinidonatingGetParameters/tns:nomeFileNotifica)>0 and string-length($get/parameters/tns:ricercaordinidonatingGetParameters/tns:codOrdineTI)=0 and string-length($get/parameters/tns:ricercaordinidonatingGetParameters/tns:idRisorsa)=0 and string-length($get/parameters/tns:ricercaordinidonatingGetParameters/tns:codiceSessione)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($get.parameters/tns:nomeFileNotifica)>0 and string-length($get.parameters/tns:codOrdineTI)=0 and string-length($get.parameters/tns:idRisorsa)=0 and string-length($get.parameters/tns:codiceSessione)=0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty1ToSQLDirect_NomeFileEAltri">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($get/parameters/tns:ricercaordinidonatingGetParameters/tns:nomeFileNotifica)>0 and (string-length($get/parameters/tns:ricercaordinidonatingGetParameters/tns:codOrdineTI)>0 or string-length($get/parameters/tns:ricercaordinidonatingGetParameters/tns:idRisorsa)>0 or string-length($get/parameters/tns:ricercaordinidonatingGetParameters/tns:codiceSessione)>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($get.parameters/tns:nomeFileNotifica)>0 and (string-length($get.parameters/tns:codOrdineTI)>0 or string-length($get.parameters/tns:idRisorsa)>0 or string-length($get.parameters/tns:codiceSessione)>0)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty1ToCopy_1_noOLODirect">
                                    <tibex:DesignExpression>
