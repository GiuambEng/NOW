                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cbd69769-0fb0-49f7-9e8a-1036f992502b+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/OrdiniDonating/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;tipoRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;ambito&quot;/>&#xa;    &lt;xsl:template name=&quot;richiesteCodiceSessioneOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns1:idRichiestaOLO&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$tipoRichiesta&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;$ambito&quot;/>&#xa;            &lt;/ambito>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
