                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns3=&quot;http://xmlns.example.com/OrdiniDonating/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;get_OrdiniDonating_GetLog_INFO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrdiniDonating&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.OrdiniDonating&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InfoOrdiniDonating:&amp;quot;,tib:render-xml($get/parameters/tns3:ricercaordinidonatingGetParameters, true(),true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;          