                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/OrdiniDonatingLista&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OLOQuery&quot;/>&lt;xsl:template name=&quot;donatingRicerca&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($OLOQuery/unknownResultset/row)>0&quot;>&lt;tns:outputOrdiniDonatingLista>&lt;xsl:for-each select=&quot;$OLOQuery/unknownResultset/row&quot;>&lt;tns:listaOrdiniDonatingOutput>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINETI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINETI']/value)&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;column[name='CODICEORDINETI']/value&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATORICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATORICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATORICHIESTAOLO']/value)&quot;>&lt;tns:statoOAO>&lt;xsl:value-of select=&quot;column[name='STATORICHIESTAOLO']/value&quot;/>&lt;/tns:statoOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COWCODEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COWCODEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COWCODEOLO']/value)&quot;>&lt;tns:oaoDonating>&lt;xsl:value-of select=&quot;column[name='COWCODEOLO']/value&quot;/>&lt;/tns:oaoDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='IDRICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDRICHIESTAOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDRICHIESTAOLO']/value)&quot;>&lt;tns:idRichiestaOLO>&lt;xsl:value-of select=&quot;column[name='IDRICHIESTAOLO']/value&quot;/>&lt;/tns:idRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODIFICAOLOAGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODIFICAOLOAGCOM']/value)&quot;>&lt;tns:oao>&lt;xsl:value-of select=&quot;column[name='CODIFICAOLOAGCOM']/value&quot;/>&lt;/tns:oao>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODICEORDINEOLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODICEORDINEOLO']/value)&quot;>&lt;tns:codiceOrdineOao>&lt;xsl:value-of select=&quot;column[name='CODICEORDINEOLO']/value&quot;/>&lt;/tns:codiceOrdineOao>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATORICHIESTANOW']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATORICHIESTANOW']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATORICHIESTANOW']/value)&quot;>&lt;tns:statoNow>&lt;xsl:value-of select=&quot;column[name='STATORICHIESTANOW']/value&quot;/>&lt;/tns:statoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']/value)&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;column[name='OFFERTA']/value&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_DIFFIDATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_DIFFIDATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_DIFFIDATO']/value)&quot;>&lt;tns:flagDiffidato>&lt;xsl:value-of select=&quot;column[name='FLAG_DIFFIDATO']/value&quot;/>&lt;/tns:flagDiffidato>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STRUTTURARICHIESTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STRUTTURARICHIESTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STRUTTURARICHIESTA']/value)&quot;>&lt;tns:ambitoServizioRecipient>&lt;xsl:value-of select=&quot;column[name='STRUTTURARICHIESTA']/value&quot;/>&lt;/tns:ambitoServizioRecipient>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPOLOGIAACCESSO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOLOGIAACCESSO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOLOGIAACCESSO']/value)&quot;>&lt;tns:ambitoServizioDonating>&lt;xsl:value-of select=&quot;column[name='TIPOLOGIAACCESSO']/value&quot;/>&lt;/tns:ambitoServizioDonating>&lt;/xsl:if>&lt;/tns:listaOrdiniDonatingOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputOrdiniDonatingLista>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputOrdiniDonatingLista>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputOrdiniDonatingLista>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
