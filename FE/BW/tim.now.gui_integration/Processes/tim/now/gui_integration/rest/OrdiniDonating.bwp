                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d5089a40-4ca8-4267-8a46-2b4aa627e801+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/OrdiniDonating/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;nomeFileQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;NOME_FILE>&#xa;                &lt;xsl:value-of select=&quot;upper-case(tib:trim($get/parameters/tns1:ricercaordinidonatingGetParameters/tns1:nomeFileNotifica))&quot;/>&#xa;            &lt;/NOME_FILE>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:ricercaordinidonatingGetParameters/tns1:codificaAgcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;CODFC_OLO_AGCOM2>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:ricercaordinidonatingGetParameters/tns1:codificaAgcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM2>&#xa;            &lt;CODFC_OLO_AGCOM3>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:ricercaordinidonatingGetParameters/tns1:codificaAgcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM3>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="nomeFileOLOQuery-input"
                                    name="nomeFileOLOQuery"
                                    outputVariable="nomeFileOLOQuery"
                                    tibex:xpdlId="d5089a40-4ca8-4267-8a46-2b4aa627e801" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
