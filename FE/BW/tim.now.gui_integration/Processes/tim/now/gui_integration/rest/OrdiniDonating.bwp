tns1:codificaAgcom,&amp;quot;')) oloric WHERE R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' AND (R.CODIFICAOLOAGCOMDONATING IN (oloric.CODFC_OLO_AGCOM) or R.COWCODEOLO IN (select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE&amp;#xD;&amp;#xA;where O.CODFC_OLO_AGCOM ='&amp;quot;,$get.parameters/tns1:codificaAgcom,&amp;quot;') or R.COWCODEOLO2 IN (select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE&amp;#xD;&amp;#xA;where O.CODFC_OLO_AGCOM ='&amp;quot;,$get.parameters/tns1:codificaAgcom,&amp;quot;')) AND   &amp;quot;,tib:substring-before-last($NumInputVariable, tib:trim(&amp;quot;AND&amp;quot;)),&amp;quot; FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN BDS_1_CASEDATA_ASSET A (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO, (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$get.parameters/tns1:codificaAgcom,&amp;quot;' OR COD_OLO_ACCORPANTE ='&amp;quot;,$get.parameters/tns1:codificaAgcom,&amp;quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$get.parameters/tns1:codificaAgcom,&amp;quot;')) oloric WHERE R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' AND (R.CODIFICAOLOAGCOMDONATING IN (oloric.CODFC_OLO_AGCOM) or R.COWCODEOLO IN (select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE&amp;#xD;&amp;#xA;where O.CODFC_OLO_AGCOM ='&amp;quot;,$get.parameters/tns1:codificaAgcom,&amp;quot;') or R.COWCODEOLO2 IN (select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE&amp;#xD;&amp;#xA;where O.CODFC_OLO_AGCOM ='&amp;quot;,$get.parameters/tns1:codificaAgcom,&amp;quot;')) AND   &amp;quot;,$NumInputVariable,&amp;quot; FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
