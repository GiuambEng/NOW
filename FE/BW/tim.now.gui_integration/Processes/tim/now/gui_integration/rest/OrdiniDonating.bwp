                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8f3a951f-fe4a-452d-8a6d-0b652b46a839+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/OrdiniDonating/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NumInputVariable&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;NomeFileEAltriNoOLOQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with(tib:trim($NumInputVariable), tib:trim(&amp;quot;AND&amp;quot;))&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO  FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE &amp;quot;,tib:substring-before-last($NumInputVariable, tib:trim(&amp;quot;AND&amp;quot;)),&amp;quot; INTERSECT SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO FROM FILE_PROCSTO FP  INNER JOIN FILE_NOTF_STANDARD FNS ON FP.ID_FILE=FNS.ID_FILE_PROCSTO_OUTPUT LEFT JOIN RICH_ORDN_COMUNIC_NOTF RO ON FNS.ID_NOTF=RO.ID_NOTF AND RO.IDTPLG_DESTNRIO_NOTF =(SELECT IDTPLG_DESTNRIO_NOTF FROM TIPOLG_DESTNRIO_NOTF WHERE DESCR='DONATING') JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO=RO.ID_RICH_OLO LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' AND UPPER(TRIM(FP.NOME_FILE))='&amp;quot;,upper-case(tib:trim($get/parameters/tns1:ricercaordinidonatingGetParameters/tns1:nomeFileNotifica)),&amp;quot;' FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO  FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE &amp;quot;,$NumInputVariable,&amp;quot; INTERSECT SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO FROM FILE_PROCSTO FP  INNER JOIN FILE_NOTF_STANDARD FNS ON FP.ID_FILE=FNS.ID_FILE_PROCSTO_OUTPUT LEFT JOIN RICH_ORDN_COMUNIC_NOTF RO ON FNS.ID_NOTF=RO.ID_NOTF AND RO.IDTPLG_DESTNRIO_NOTF =(SELECT IDTPLG_DESTNRIO_NOTF FROM TIPOLG_DESTNRIO_NOTF WHERE DESCR='DONATING') JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO=RO.ID_RICH_OLO LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' AND  UPPER(TRIM(FP.NOME_FILE))='&amp;quot;,upper-case(tib:trim($get/parameters/tns1:ricercaordinidonatingGetParameters/tns1:nomeFileNotifica)),&amp;quot;' FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="NomeFileEAltriNoOLOQuery-input"
                                    name="NomeFileEAltriNoOLOQuery"
                                    outputVariable="NomeFileEAltriNoOLOQuery"
                                    tibex:xpdlId="8f3a951f-fe4a-452d-8a6d-0b652b46a839" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToSQLDirect_NomeFileEAltri"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="noOLODirectToCopy_1_NomeFileEAltriOLOAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8f3a951f-fe4a-452d-8a6d-0b652b46a839+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/OrdiniDonating/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;NumInputVariable&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;NomeFileEAltriNoOLOQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with(tib:trim($NumInputVariable), tib:trim(&amp;quot;AND&amp;quot;))&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO  FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE &amp;quot;,tib:substring-before-last($NumInputVariable, tib:trim(&amp;quot;AND&amp;quot;)),&amp;quot; INTERSECT SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO FROM FILE_PROCSTO FP  INNER JOIN FILE_NOTF_STANDARD FNS ON FP.ID_FILE=FNS.ID_FILE_PROCSTO_OUTPUT LEFT JOIN RICH_ORDN_COMUNIC_NOTF RO ON FNS.ID_NOTF=RO.ID_NOTF AND RO.IDTPLG_DESTNRIO_NOTF =(SELECT IDTPLG_DESTNRIO_NOTF FROM TIPOLG_DESTNRIO_NOTF WHERE DESCR='DONATING') JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO=RO.ID_RICH_OLO LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' AND UPPER(TRIM(FP.NOME_FILE))='&amp;quot;,upper-case(tib:trim($get.parameters/tns1:nomeFileNotifica)),&amp;quot;' FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO  FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE &amp;quot;,$NumInputVariable,&amp;quot; INTERSECT SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO FROM FILE_PROCSTO FP  INNER JOIN FILE_NOTF_STANDARD FNS ON FP.ID_FILE=FNS.ID_FILE_PROCSTO_OUTPUT LEFT JOIN RICH_ORDN_COMUNIC_NOTF RO ON FNS.ID_NOTF=RO.ID_NOTF AND RO.IDTPLG_DESTNRIO_NOTF =(SELECT IDTPLG_DESTNRIO_NOTF FROM TIPOLG_DESTNRIO_NOTF WHERE DESCR='DONATING') JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO=RO.ID_RICH_OLO LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' AND  UPPER(TRIM(FP.NOME_FILE))='&amp;quot;,upper-case(tib:trim($get.parameters/tns1:nomeFileNotifica)),&amp;quot;' FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://xmlns.example.com/OrdiniDonating/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;get_OrdiniDonating_GetLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrdiniDonating&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.OrdiniDonating&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputOrdiniDonating:&amp;quot;,tib:render-xml($get/parameters/tns3:ricercaordinidonatingGetParameters, true(),true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.OrdiniDonating&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID:&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID:&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;OrdiniDonating_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;OrdiniDonating_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog/>&#xa;                &lt;/tns2:Envelope>&#xa;                &lt;tns2:Playload>&#xa;                    &lt;tns2:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get/parameters/tns3:ricercaordinidonatingGetParameters )))&quot;/>&#xa;                    &lt;/tns2:Binary>&#xa;                    &lt;tns2:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($get/parameters/tns3:ricercaordinidonatingGetParameters)&quot;/>&#xa;                    &lt;/tns2:XMLString>&#xa;                &lt;/tns2:Playload>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_OrdiniDonating_GetLog-input"
                                    name="get_OrdiniDonating_GetLog"
                                    tibex:xpdlId="80e482d5-9f4c-4242-9bd9-caec80f761b2"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="get_OrdiniDonating_GetLogToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://xmlns.example.com/OrdiniDonating/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;get_OrdiniDonating_GetLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OrdiniDonating&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.OrdiniDonating&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputOrdiniDonating:&amp;quot;,tib:render-xml($get.parameters, true(),true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.OrdiniDonating&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SID:&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;_&amp;quot;,&amp;quot;TID:&amp;quot;,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;OrdiniDonating_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;OrdiniDonating_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog/>&#xa;                &lt;/tns2:Envelope>&#xa;                &lt;tns2:Playload>&#xa;                    &lt;tns2:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get.parameters )))&quot;/>&#xa;                    &lt;/tns2:Binary>&#xa;                    &lt;tns2:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($get.parameters)&quot;/>&#xa;                    &lt;/tns2:XMLString>&#xa;                &lt;/tns2:Playload>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
