                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1c839a33-58f4-428b-8188-594c54e80625+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/OrdiniDonating/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$get1/parameters/tns1:dettaglioordinidonatingGetParameters/tns1:idRichiestaOLO&quot;/>&#xa;            &lt;/idRichiestaOLO>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="notificheQueryOLO-input"
                                    name="notificheQueryOLO"
                                    outputVariable="notificheQueryOLO"
                                    tibex:xpdlId="1c839a33-58f4-428b-8188-594c54e80625" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty5TonotificheQueryOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="notificheQueryOLOToEmpty6"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1c839a33-58f4-428b-8188-594c54e80625+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/OrdiniDonating/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns1:idRichiestaOLO&quot;/>&#xa;            &lt;/idRichiestaOLO>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select  ID_FILE_PROCSTO_OUTPUT,TIMSTP_CREAZIONE,TRACCIATO_FILE, TIMSTP_INVIO, ID_NOTF,TIPOLG_NOTF, DESCR_CAUS_OLO,  NOME_FILE, CODFC_OLO_AGCOM&#xa;from (&#xa;SELECT  FP.ID_FILE_PROCSTO_OUTPUT,   RN.TIMSTP_CREAZIONE,&#xa;RN.TRACCIATO_FILE, PO.TIMSTP_INVIO, RN.ID_NOTF,&#xa; TN.DESCR as TIPOLG_NOTF,CAU.DESCR_CAUS_OLO,P.NOME_FILE,RN.CODFC_OLO_AGCOM, dense_rank() over (partition by RN.ID_NOTF order by PO.TIMSTP_INVIO desc) as ord&#xa;FROM RICH_ORDN_COMUNIC_NOTF RN &#xa;join BDS_1_CASEDATA_RICHIESTA R on R.IDRICHIESTAOLO=RN.ID_RICH_OLO&#xa;LEFT JOIN FILE_NOTF_STANDARD FP ON  RN.ID_NOTF = FP.ID_NOTF&#xa;LEFT JOIN FILE_PROCSTO_OUTPUT PO ON FP.ID_FILE_PROCSTO_OUTPUT = PO.ID_FILE_PROCSTO_OUTPUT &#xa;LEFT JOIN TIPOLG_NOTF TN  ON  TN.COD_TIPOLG_NOTF = RN.COD_TIPOLG_NOTF AND TN.STRUTTURA_RICH = RN.STRUTTURA_RICH&#xa;LEFT JOIN ANAG_CAUS CAU ON CAU.ID_ANAG_CAUS = RN.ID_ANAG_CAUS&#xa;LEFT JOIN FILE_PROCSTO P ON P.ID_FILE = FP.ID_FILE_PROCSTO_OUTPUT&#xa;WHERE RN.ID_RICH_OLO = ? &#xa;AND RN.IDTPLG_DESTNRIO_NOTF = 3&#xa;AND ( (RN.CODFC_OLO_AGCOM= R.CODIFICAOLOAGCOMDONATING&#xa;     OR RN.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO O WHERE O.COD_OLO_ACCORPANTE = R.CODIFICAOLOAGCOMDONATING) &#xa;     OR RN.CODFC_OLO_NOW IN (SELECT COD_OLO FROM OLO O WHERE O.COD_OLO = R.CODIFICAOLONOWDONATING) )&#xa;     OR (RN.CODFC_OLO_AGCOM= R.COWCODEOLO OR RN.CODFC_OLO_AGCOM IN(select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE &#xa;     where O.CODFC_OLO_AGCOM =RN.CODFC_OLO_AGCOM) ) &#xa;     OR (RN.CODFC_OLO_AGCOM= R.COWCODEOLO2 OR RN.CODFC_OLO_AGCOM IN(select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE &#xa;     where O.CODFC_OLO_AGCOM =RN.CODFC_OLO_AGCOM) ) )&#xa;ORDER BY RN.ID_NOTF, PO.TIMSTP_INVIO&#xa;) where ord =1" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOLO"/>
                                    <columnMetadata
                                    columnName="ID_FILE_PROCSTO_OUTPUT"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TRACCIATO_FILE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INVIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="ID_NOTF"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIPOLG_NOTF"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
