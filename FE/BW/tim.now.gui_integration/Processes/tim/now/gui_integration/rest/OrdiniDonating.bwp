                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c92675b8-1a95-4df3-ace8-d721b5bf2906+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NumInputVariable&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;NoOLOQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with(tib:trim($NumInputVariable), tib:trim(&amp;quot;AND&amp;quot;))&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO  FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE &amp;quot;,tib:substring-before-last($NumInputVariable, tib:trim(&amp;quot;AND&amp;quot;)),&amp;quot; AND R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT R.STATORICHIESTAOLO,R.IDRICHIESTAOLO,R.CODIFICAOLOAGCOMDONATING,R.CODICEORDINETI,R.CODIFICAOLOAGCOM,R.CODICEORDINEOLO,R.COWCODEOLO,R.STATORICHIESTANOW,R.OFFERTA,C.FLAG_DIFFIDATO,R.STRUTTURARICHIESTA,A.TIPOLOGIAACCESSO  FROM BDS_1_CASEDATA_RICHIESTA R LEFT JOIN BDS_1_CASEDATA_ASSET A ON (A.IDRISORSA = R.CODICERISORSADONATING OR A.NUMEROFITTIZIO = R.CODICERISORSADONATING OR A.NUMEROTELEFONICO = R.CODICERISORSADONATING OR CONCAT('0', A.NUMEROFITTIZIO) = R.CODICERISORSADONATING OR SUBSTR(A.NUMEROFITTIZIO,2,LENGTH(A.NUMEROFITTIZIO)) = R.CODICERISORSADONATING) LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = A.IDCONTRATTO WHERE &amp;quot;,$NumInputVariable,&amp;quot; AND R.AMBITO='NOW' AND R.TIPORICHIESTA='ORDINE' FETCH FIRST &amp;quot;,xsd:string($MaxRows),&amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
