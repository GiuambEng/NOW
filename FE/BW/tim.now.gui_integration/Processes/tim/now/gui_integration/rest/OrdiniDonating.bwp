                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tipoRichiesta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ambito"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
