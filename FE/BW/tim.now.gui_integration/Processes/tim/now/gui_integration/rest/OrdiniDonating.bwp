            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="(contains($Profile, $get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:tipoProfilo) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:codOrdineTI, &amp;quot;'&amp;quot;)) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:nomeFileNotifica, &amp;quot;'&amp;quot;)) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:idRisorsa, &amp;quot;'&amp;quot;)) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:codiceSessione, &amp;quot;'&amp;quot;)) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:codOrdineTI, &amp;quot;%&amp;quot;))) or (not(contains($Profile, $get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:tipoProfilo)) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:codOrdineTI, &amp;quot;'&amp;quot;)) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:nomeFileNotifica, &amp;quot;'&amp;quot;)) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:idRisorsa, &amp;quot;'&amp;quot;)) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:codiceSessione, &amp;quot;'&amp;quot;)) and not(contains($get/parameters/tns2:ricercaordinidonatingGetParameters/tns2:codOrdineTI, &amp;quot;%&amp;quot;)))"&gt;
