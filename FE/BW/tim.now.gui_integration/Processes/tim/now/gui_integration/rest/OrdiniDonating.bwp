                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;r1.DATAINVIORICHIESTA, &#xa;r1.STATORICHIESTANOW, &#xa;r1.STATORICHIESTAOLO,&#xa;r1.LAVORAZIONE,&#xa;r1.IDRICHIESTAOLO,&#xa;r1.CODICEORDINEOLO,&#xa;r1.CONTENUTOXML,&#xa;r1.OPERATORE&#xa;FROM BDS_1_CASEDATA_RICHIESTA r1 &#xa;INNER JOIN BDS_1_CASEDATA_RICHIESTA r2 ON r1.CODICEORDINETITARGET= r2.CODICEORDINETI&#xa;WHERE r2.IDRICHIESTAOLO = ? AND r1.TIPORICHIESTA = ? AND r1.AMBITO = ? AND r1.LAVORAZIONE = 'RISCONTROCODICESESSIONE'&#xa;AND ( (r1.CODIFICAOLOAGCOM= r1.CODIFICAOLOAGCOMDONATING&#xa;     OR r1.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO O WHERE O.COD_OLO_ACCORPANTE = r1.CODIFICAOLOAGCOMDONATING) &#xa;     OR r1.CODIFICAOLONOW IN (SELECT COD_OLO FROM OLO O WHERE O.COD_OLO = r1.CODIFICAOLONOWDONATING) )&#xa;     OR (r1.CODIFICAOLOAGCOM= r1.COWCODEOLO OR r1.CODIFICAOLOAGCOM IN(select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE &#xa;     where O.CODFC_OLO_AGCOM =r1.CODIFICAOLOAGCOM) ) &#xa;     OR (r1.CODIFICAOLOAGCOM= r1.COWCODEOLO2 OR r1.CODIFICAOLOAGCOM IN(select COD_COW from ANAG_COW AC left JOIN OLO O ON O.CODFC_OLO_AGCOM = AC.COD_PADRE &#xa;     where O.CODFC_OLO_AGCOM =r1.CODIFICAOLOAGCOM) ) )&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

