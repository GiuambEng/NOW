                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/OrdiniDonatingLista&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;nomeFileNoOLOQuery&quot;/>&lt;xsl:template name=&quot;donatingRicerca&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($nomeFileNoOLOQuery/Record)>0&quot;>&lt;tns:outputOrdiniDonatingLista>&lt;xsl:for-each select=&quot;$nomeFileNoOLOQuery/Record&quot;>&lt;tns:listaOrdiniDonatingOutput>&lt;xsl:if test=&quot;CODICEORDINETI&quot;>&lt;tns:ordineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns:ordineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns:statoOAO>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns:statoOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;COWCODEOLO&quot;>&lt;tns:oaoDonating>&lt;xsl:value-of select=&quot;COWCODEOLO&quot;/>&lt;/tns:oaoDonating>&lt;/xsl:if>&lt;tns:idRichiestaOLO>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns:idRichiestaOLO>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:oao>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:oao>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns:codiceOrdineOao>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns:codiceOrdineOao>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&lt;tns:statoNow>&lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&lt;/tns:statoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;FLAG_DIFFIDATO&quot;>&lt;tns:flagDiffidato>&lt;xsl:value-of select=&quot;FLAG_DIFFIDATO&quot;/>&lt;/tns:flagDiffidato>&lt;/xsl:if>&lt;xsl:if test=&quot;STRUTTURARICHIESTA&quot;>&lt;tns:ambitoServizioRecipient>&lt;xsl:value-of select=&quot;STRUTTURARICHIESTA&quot;/>&lt;/tns:ambitoServizioRecipient>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOLOGIAACCESSO&quot;>&lt;tns:ambitoServizioDonating>&lt;xsl:value-of select=&quot;TIPOLOGIAACCESSO&quot;/>&lt;/tns:ambitoServizioDonating>&lt;/xsl:if>&lt;/tns:listaOrdiniDonatingOutput>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputOrdiniDonatingLista>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputOrdiniDonatingLista>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono ordini donating&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputOrdiniDonatingLista>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
