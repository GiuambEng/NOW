                &lt;/tns:outputOrdiniDonatingDettaglio&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse1&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
