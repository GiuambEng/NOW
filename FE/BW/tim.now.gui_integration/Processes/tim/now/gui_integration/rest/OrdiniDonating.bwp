                                    <bpws:reply
                                    name="Reply_OrdiniDonating_Error"
                                    operation="get"
                                    partnerLink="ricercaordinidonating"
                                    portType="ns:ricercaordinidonating"
                                    tibex:xpdlId="41a12ded-63e2-4bfd-a022-b102990e9d70" variable="Reply_OrdiniDonating_Error-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160928171850PLT" xmlns:tns="http://www.tim.com/NOW/rest/OrdiniDonatingLista" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;item&gt;
                &lt;tns:outputOrdiniDonatingLista&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;
