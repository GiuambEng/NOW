                                    <tibex:activityExtension
                                    inputVariable="Query"
                                    name="Assign2"
                                    outputVariable="Query"
                                    tibex:xpdlId="db360bfa-317e-4924-b234-0a9e35c02a6b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
