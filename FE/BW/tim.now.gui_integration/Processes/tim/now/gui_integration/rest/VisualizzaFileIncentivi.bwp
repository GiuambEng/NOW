                                    <bpws:sources>
                                    <bpws:source linkName="Assign2ToLog"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="if ($index = 1) then &quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.timstp_crezione_file AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_OUTPUT FPO ON fp.id_file=fpo.id_file_procsto_output INNER JOIN st_del_348_inc_oao_file ST ON fpo.id_file_procsto_output = st.id_file_prcso_output_oao&quot;  else if ($index = 2) then &quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.timstp_crezione_file AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_OUTPUT FPO ON fp.id_file=fpo.id_file_procsto_output INNER JOIN DEL_111_AN_INCENTIVO_OAO_FILE ST ON fpo.id_file_procsto_output = st.id_file_procsto_output_oao&quot;  else if ($index = 3) then &quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.DATA_ARRIVO AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_INPUT fpo ON fp.id_file=fpo.id_file_procsto_input INNER JOIN D111_CLLI_AN_ANAG_INC_OAOFILE ST ON fpo.id_file_procsto_input = st.id_file_procsto_input&quot;  else if ($index = 4) then &quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.DATA_ARRIVO AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_INPUT fpo ON fp.id_file=fpo.id_file_procsto_input INNER JOIN DEL_111_AN_ANAG_INC_OAO_FILE ST ON fpo.id_file_procsto_input = st.id_file_procsto_input&quot; else if ($index = 5) then &quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.DATA_ARRIVO AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_INPUT FPO ON fp.id_file=fpo.id_file_procsto_input INNER JOIN intrfc intf ON fp.id_intrfc = intf.id_intrfc where intf.cod_intrfc='ID375'&quot; else &quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM, fpo.timstp_crezione_file as DATACREAZIONE  from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file  INNER JOIN FILE_PROCSTO_OUTPUT FPO ON fp.id_file=fpo.id_file_procsto_output  INNER JOIN intrfc intf ON fp.id_intrfc = intf.id_intrfc where intf.cod_intrfc='ID375'and not exists (select 1 from DEL_111_AN_INCENTIVO_OAO_FILE ST where fpo.id_file_procsto_output = st.id_file_procsto_output_oao)&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>

                                    <value
                                    processVariable="Query" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="if ($index = 1) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.timstp_crezione_file AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_OUTPUT FPO ON fp.id_file=fpo.id_file_procsto_output INNER JOIN st_del_348_inc_oao_file ST ON fpo.id_file_procsto_output = st.id_file_prcso_output_oao where fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;'))&quot;) else if ($index = 2) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.timstp_crezione_file AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_OUTPUT FPO ON fp.id_file=fpo.id_file_procsto_output INNER JOIN DEL_111_AN_INCENTIVO_OAO_FILE ST ON fpo.id_file_procsto_output = st.id_file_procsto_output_oao where fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;'))&quot;)else if ($index = 3) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.DATA_ARRIVO AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_INPUT fpo ON fp.id_file=fpo.id_file_procsto_input INNER JOIN D111_CLLI_AN_ANAG_INC_OAOFILE ST ON fpo.id_file_procsto_input = st.id_file_procsto_input where fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;'))&quot;) else if ($index = 4) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.DATA_ARRIVO AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_INPUT fpo ON fp.id_file=fpo.id_file_procsto_input INNER JOIN DEL_111_AN_ANAG_INC_OAO_FILE ST ON fpo.id_file_procsto_input = st.id_file_procsto_input where fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;'))&quot;) else if ($index = 5) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.DATA_ARRIVO AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_INPUT FPO ON fp.id_file=fpo.id_file_procsto_input INNER JOIN intrfc intf ON fp.id_intrfc = intf.id_intrfc where intf.cod_intrfc='ID375' AND fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;'))&quot;) else concat (&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM, fpo.timstp_crezione_file as DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_OUTPUT FPO ON fp.id_file=fpo.id_file_procsto_output INNER JOIN intrfc intf ON fp.id_intrfc = intf.id_intrfc where intf.cod_intrfc='ID375' and not exists (select 1 from DEL_111_AN_INCENTIVO_OAO_FILE ST where fpo.id_file_procsto_output = st.id_file_procsto_output_oao) AND fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get/parameters/tns:visualizzafileincentiviGetParameters/tns:codOloAgcom,&quot;'))&quot;)"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="Query"
                                    name="Assign3"
                                    outputVariable="Query"
                                    tibex:xpdlId="d900a39d-ed40-4a64-95ac-7df9ad18c60b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign3ToLog1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="if ($index = 1) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.timstp_crezione_file AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_OUTPUT FPO ON fp.id_file=fpo.id_file_procsto_output INNER JOIN st_del_348_inc_oao_file ST ON fpo.id_file_procsto_output = st.id_file_prcso_output_oao where fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;'))&quot;) else if ($index = 2) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.timstp_crezione_file AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_OUTPUT FPO ON fp.id_file=fpo.id_file_procsto_output INNER JOIN DEL_111_AN_INCENTIVO_OAO_FILE ST ON fpo.id_file_procsto_output = st.id_file_procsto_output_oao where fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;'))&quot;)else if ($index = 3) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.DATA_ARRIVO AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_INPUT fpo ON fp.id_file=fpo.id_file_procsto_input INNER JOIN D111_CLLI_AN_ANAG_INC_OAOFILE ST ON fpo.id_file_procsto_input = st.id_file_procsto_input where fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;'))&quot;) else if ($index = 4) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.DATA_ARRIVO AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_INPUT fpo ON fp.id_file=fpo.id_file_procsto_input INNER JOIN DEL_111_AN_ANAG_INC_OAO_FILE ST ON fpo.id_file_procsto_input = st.id_file_procsto_input where fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;'))&quot;) else if ($index = 5) then concat(&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.DATA_ARRIVO AS DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_INPUT FPO ON fp.id_file=fpo.id_file_procsto_input INNER JOIN intrfc intf ON fp.id_intrfc = intf.id_intrfc where intf.cod_intrfc='ID375' AND fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;'))&quot;) else concat (&quot;select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM, fpo.timstp_crezione_file as DATACREAZIONE from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_OUTPUT FPO ON fp.id_file=fpo.id_file_procsto_output INNER JOIN intrfc intf ON fp.id_intrfc = intf.id_intrfc where intf.cod_intrfc='ID375' and not exists (select 1 from DEL_111_AN_INCENTIVO_OAO_FILE ST where fpo.id_file_procsto_output = st.id_file_procsto_output_oao) AND fp.codfc_olo_agcom IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO_ACCORPANTE = '&quot;,$get.parameters/tns:codOloAgcom,&quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&quot;,$get.parameters/tns:codOloAgcom,&quot;'))&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
