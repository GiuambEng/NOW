                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DettaglioFileQueryToAssign5"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bb547b11-4d36-4adf-95e9-6d877d8d57de+input&quot; xmlns:tns1=&quot;http://www.example.org/DeCryptoDownload&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DecryptIDF&quot;/>&lt;xsl:template name=&quot;DettaglioFileQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idFile>&lt;xsl:value-of select=&quot;$DecryptIDF/tns1:idFileDecriptato&quot;/>&lt;/idFile>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DCAIF.CLLI AS CLLI,DCAIF.DATA_IN AS DATAIN, DCAIF.DATA_OUT AS DATAOUT,&#xa;DCAIF.DESCRIZIONE_ERRORE AS ERRORE&#xa;FROM D111_CLLI_AN_ANAG_INC_OAOFILE DCAIF &#xa;WHERE DCAIF.ID_FILE_PROCSTO_INPUT = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idFile"/>
                                    <columnMetadata
                                    columnName="CLLI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAIN"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAOUT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ERRORE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.example.org/DeCryptoDownload&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzaFileIncentivi/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:param name=&quot;DecryptIDF&quot;/>&lt;xsl:template name=&quot;Log2-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat (&amp;quot;QUERY DETTAGLIO FILE INCENTIVI: SELECT DAAIF.ID_RISORSA AS IDRISORSA, DAAIF.CLLI AS CLLI, DAAIF.OFFERTA AS OFFERTA, DCAIF.DATA_IN AS DATAIN, DCAIF.DATA_OUT AS DATAOUT,DAAIF.DESCRIZIONE_ERRORE AS ERRORE FROM D111_CLLI_AN_ANAG_INC_OAOFILE DCAIF INNER JOIN DEL_111_AN_ANAG_INC_OAO_FILE DAAIF ON DCAIF.ID_FILE_PROCSTO_INPUT = DAAIF.ID_FILE_PROCSTO_INPUT WHERE DCAIF.ID_FILE_PROCSTO_INPUT = &amp;quot;,$DecryptIDF/tns1:idFileDecriptato, &amp;quot; ------- PER TIPOLOGIA FILE: &amp;quot;,$get1/parameters/tns2:dettagliofileincentiviGetParameters/tns2:tipologiaFile)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Log2-input"
                                    name="Log2"
                                    tibex:xpdlId="a7624870-10ac-4e80-8628-5f70a472c022" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DecryptIDFToLog2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log2ToDettaglioFileQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Log2ToDettaglioFileQery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$get1/parameters/tns:dettagliofileincentiviGetParameters/tns:tipologiaFile='File Risorse OAO Incentivo'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$get1.parameters/tns:tipologiaFile='File Risorse OAO Incentivo']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.example.org/DeCryptoDownload&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzaFileIncentivi/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DecryptIDF&quot;/>&#xa;    &lt;xsl:template name=&quot;Log2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat (&amp;quot;QUERY DETTAGLIO FILE INCENTIVI: SELECT DAAIF.ID_RISORSA AS IDRISORSA, DAAIF.CLLI AS CLLI, DAAIF.OFFERTA AS OFFERTA, DCAIF.DATA_IN AS DATAIN, DCAIF.DATA_OUT AS DATAOUT,DAAIF.DESCRIZIONE_ERRORE AS ERRORE FROM D111_CLLI_AN_ANAG_INC_OAOFILE DCAIF INNER JOIN DEL_111_AN_ANAG_INC_OAO_FILE DAAIF ON DCAIF.ID_FILE_PROCSTO_INPUT = DAAIF.ID_FILE_PROCSTO_INPUT WHERE DCAIF.ID_FILE_PROCSTO_INPUT = &amp;quot;,$DecryptIDF/tns1:idFileDecriptato, &amp;quot; ------- PER TIPOLOGIA FILE: &amp;quot;,$get1.parameters/tns2:tipologiaFile)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaFileIncentivi&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaFileIncentivi/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:param name=&quot;DettaglioFileQuery&quot;/>&lt;xsl:param name=&quot;DettaglioFileQueryIncentivoSO&quot;/>&lt;xsl:template name=&quot;DettaglioFile&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DettaglioFileQuery/Record)>0 and $get1/parameters/tns1:dettagliofileincentiviGetParameters/tns1:tipologiaFile = 'File CLLI Incentivo Switch OFF'&quot;>&lt;tns:DettaglioFileIncentiviOutput>&lt;xsl:for-each select=&quot;$DettaglioFileQuery/Record&quot;>&lt;tns:dettaglioFileIncentivi>&lt;xsl:if test=&quot;CLLI&quot;>&lt;tns:clli>&lt;xsl:value-of select=&quot;CLLI&quot;/>&lt;/tns:clli>&lt;/xsl:if>&lt;xsl:if test=&quot;DATAIN&quot;>&lt;tns:dataIn>&lt;xsl:value-of select=&quot;DATAIN&quot;/>&lt;/tns:dataIn>&lt;/xsl:if>&lt;xsl:if test=&quot;DATAOUT&quot;>&lt;tns:dataOut>&lt;xsl:value-of select=&quot;DATAOUT&quot;/>&lt;/tns:dataOut>&lt;/xsl:if>&lt;xsl:if test=&quot;ERRORE&quot;>&lt;tns:descrizioneErrore>&lt;xsl:value-of select=&quot;ERRORE&quot;/>&lt;/tns:descrizioneErrore>&lt;/xsl:if>&lt;/tns:dettaglioFileIncentivi>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:DettaglioFileIncentiviOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;count($DettaglioFileQueryIncentivoSO/Record)>0 and $get1/parameters/tns1:dettagliofileincentiviGetParameters/tns1:tipologiaFile = 'File Risorse OAO Incentivo'&quot;>&lt;tns:DettaglioFileIncentiviOutput>&lt;xsl:for-each select=&quot;$DettaglioFileQueryIncentivoSO/Record&quot;>&lt;tns:dettaglioFileIncentivi>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;CLLI&quot;>&lt;tns:clli>&lt;xsl:value-of select=&quot;CLLI&quot;/>&lt;/tns:clli>&lt;/xsl:if>&lt;xsl:if test=&quot;OFFERTA&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;ERRORE&quot;>&lt;tns:descrizioneErrore>&lt;xsl:value-of select=&quot;ERRORE&quot;/>&lt;/tns:descrizioneErrore>&lt;/xsl:if>&lt;/tns:dettaglioFileIncentivi>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:DettaglioFileIncentiviOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DettaglioFileIncentiviOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record trovato.'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:DettaglioFileIncentiviOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="DettaglioFile"
                                    name="Assign5"
                                    outputVariable="DettaglioFile"
                                    tibex:xpdlId="e66c43e8-6f11-4936-b8e9-97456d391271" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DettaglioFileQueryToAssign5"/>
                                    <bpws:target linkName="DettaglioFileQeryToAssign5"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign5ToDettaglioIncentiviGet_LogOutput"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaFileIncentivi&quot; xmlns:tns1=&quot;http://xmlns.example.com/VisualizzaFileIncentivi/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioFileQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioFileQueryIncentivoSO&quot;/>&#xa;    &lt;xsl:template name=&quot;DettaglioFile&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($DettaglioFileQuery/Record)>0 and $get1.parameters/tns1:tipologiaFile = 'File CLLI Incentivo Switch OFF'&quot;>&#xa;                &lt;tns:DettaglioFileIncentiviOutput>&#xa;                    &lt;xsl:for-each select=&quot;$DettaglioFileQuery/Record&quot;>&#xa;                        &lt;tns:dettaglioFileIncentivi>&#xa;                            &lt;xsl:if test=&quot;CLLI&quot;>&#xa;                                &lt;tns:clli>&#xa;                                    &lt;xsl:value-of select=&quot;CLLI&quot;/>&#xa;                                &lt;/tns:clli>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DATAIN&quot;>&#xa;                                &lt;tns:dataIn>&#xa;                                    &lt;xsl:value-of select=&quot;DATAIN&quot;/>&#xa;                                &lt;/tns:dataIn>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DATAOUT&quot;>&#xa;                                &lt;tns:dataOut>&#xa;                                    &lt;xsl:value-of select=&quot;DATAOUT&quot;/>&#xa;                                &lt;/tns:dataOut>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ERRORE&quot;>&#xa;                                &lt;tns:descrizioneErrore>&#xa;                                    &lt;xsl:value-of select=&quot;ERRORE&quot;/>&#xa;                                &lt;/tns:descrizioneErrore>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:dettaglioFileIncentivi>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:DettaglioFileIncentiviOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($DettaglioFileQueryIncentivoSO/Record)>0 and $get1.parameters/tns1:tipologiaFile = 'File Risorse OAO Incentivo'&quot;>&#xa;                &lt;tns:DettaglioFileIncentiviOutput>&#xa;                    &lt;xsl:for-each select=&quot;$DettaglioFileQueryIncentivoSO/Record&quot;>&#xa;                        &lt;tns:dettaglioFileIncentivi>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CLLI&quot;>&#xa;                                &lt;tns:clli>&#xa;                                    &lt;xsl:value-of select=&quot;CLLI&quot;/>&#xa;                                &lt;/tns:clli>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns:offerta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ERRORE&quot;>&#xa;                                &lt;tns:descrizioneErrore>&#xa;                                    &lt;xsl:value-of select=&quot;ERRORE&quot;/>&#xa;                                &lt;/tns:descrizioneErrore>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:dettaglioFileIncentivi>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:DettaglioFileIncentiviOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:DettaglioFileIncentiviOutput>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun record trovato.'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:DettaglioFileIncentiviOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DettaglioFile" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="DettaglioFileQueryIncentivoSO-input"
                                    name="DettaglioFileQueryIncentivoSO"
                                    outputVariable="DettaglioFileQueryIncentivoSO"
                                    tibex:xpdlId="bc5dcc4a-ea0f-4433-85a9-32a2a6b40b6b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log2ToDettaglioFileQery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DettaglioFileQeryToAssign5"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bc5dcc4a-ea0f-4433-85a9-32a2a6b40b6b+input&quot; xmlns:tns1=&quot;http://www.example.org/DeCryptoDownload&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DecryptIDF&quot;/>&lt;xsl:template name=&quot;DettaglioFileQueryIncentivoSO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idFIle>&lt;xsl:value-of select=&quot;$DecryptIDF/tns1:idFileDecriptato&quot;/>&lt;/idFIle>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DAAIF.ID_RISORSA AS IDRISORSA, DAAIF.CLLI AS CLLI, &#xa;DAAIF.OFFERTA AS OFFERTA,DAAIF.DESCRIZIONE_ERRORE AS ERRORE&#xa;FROM DEL_111_AN_ANAG_INC_OAO_FILE DAAIF &#xa;WHERE DAAIF.ID_FILE_PROCSTO_INPUT = ? "
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idFIle"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CLLI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ERRORE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
