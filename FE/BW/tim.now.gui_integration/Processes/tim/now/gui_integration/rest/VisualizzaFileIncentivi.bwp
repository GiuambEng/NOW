                                    <bpws:source linkName="AssignToVisualizzaIncentiviGet_LogOutput"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaFileIncentivi&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Accumulate/tns:VisualizzaFileIncentiviOutput/tns:listaFileIncentivi/tns:idFile)>0&quot;>&lt;tns:VisualizzaFileIncentiviOutput>&lt;xsl:for-each select=&quot;$Accumulate/tns:VisualizzaFileIncentiviOutput&quot;>&lt;xsl:for-each select=&quot;tns:listaFileIncentivi&quot;>&lt;tns:listaFileIncentivi>&lt;xsl:if test=&quot;tns:idFile&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;tns:idFile&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:nomeFile&quot;>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;tns:nomeFile&quot;/>&lt;/tns:nomeFile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:codificaOao&quot;>&lt;tns:codificaOao>&lt;xsl:value-of select=&quot;tns:codificaOao&quot;/>&lt;/tns:codificaOao>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:dataCreazioneFile&quot;>&lt;tns:dataCreazioneFile>&lt;xsl:value-of select=&quot;tns:dataCreazioneFile&quot;/>&lt;/tns:dataCreazioneFile>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:tipologiaFile&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;tns:tipologiaFile&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:if>&lt;/tns:listaFileIncentivi>&lt;/xsl:for-each>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:VisualizzaFileIncentiviOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VisualizzaFileIncentiviOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Nessun record trovato'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:VisualizzaFileIncentiviOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
