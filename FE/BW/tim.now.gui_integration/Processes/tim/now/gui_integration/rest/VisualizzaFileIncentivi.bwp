                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerError&quot;/>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:param name=&quot;FaultDetails2&quot;/>&lt;xsl:template name=&quot;CallProcess3-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.APPNODE.NAME&amp;quot;),'---',bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;))&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;DettaglioFileIncentivi&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.DettaglioFileIncentivi&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Error_DettaglioFileIncentivi:&amp;quot;,tib:render-xml($FaultDetails2, true(),true()))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerError&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.DettaglioFileIncentivi&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventID>&lt;xsl:value-of select=&quot;concat($get1/httpHeaders/tns1:httpHeaders/GUI-SID,$get1/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&lt;/tns:EventID>&lt;xsl:if test=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$get1/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;DettaglioFileIncentivi_&amp;quot;,$get1/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;DettaglioFileIncentivi_&amp;quot;,$get1/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;tns:ErrorLog>&lt;tns:TimeStamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TimeStamp>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;concat(&amp;quot;Error_DettaglioFileIncentivi_iGet&amp;quot;,'SID:',$get1/httpHeaders/tns1:httpHeaders/GUI-SID,'TID:',$get1/httpHeaders/tns1:httpHeaders/GUI-TID,'ST',$FaultDetails2/StackTrace)&quot;/>&lt;/tns:Descrizione>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$FaultDetails2/MsgCode&quot;/>&lt;/tns:Codice>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;/tns:ErrorLog>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="DettaglioIncentiviGet_LogError-input"
                                    name="DettaglioIncentiviGet_LogError"
                                    tibex:xpdlId="538fcb2c-4309-477c-acdc-3e1b6772705b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess3ToReply2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails2&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.APPNODE.NAME&amp;quot;),'---',bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;))&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DettaglioFileIncentivi&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.DettaglioFileIncentivi&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Payload>&#