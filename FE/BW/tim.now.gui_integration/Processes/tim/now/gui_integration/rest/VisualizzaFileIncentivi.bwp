                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:tns3=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns4=&quot;http://www.example.org/VisualizzaFileIncentivi&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerMsg&quot;/>&lt;xsl:template name=&quot;VisualizzaIncentiviPost_LogInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VisualizzaFileIncentivi&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaFileIncentivi&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns4:VisualizzaFileIncentiviInput)&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input_VisualizzaFileIncentivi:&amp;quot;,string($post/item/tns4:VisualizzaFileIncentiviInput))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input_VisualizzaFileIncentivi_Header:&amp;quot;,tib:render-xml($post/httpHeaders/tns1:httpHeaders, true(),true()))&quot;/>&lt;/tns:Payload>&lt;/xsl:othe