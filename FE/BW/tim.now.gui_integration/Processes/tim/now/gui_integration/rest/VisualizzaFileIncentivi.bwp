                                    tibex:xpdlId="24bbdef3-525f-4828-9802-4c06684a4863"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DettaglioIncentiviGet_LogInfoToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DecryptIDFToLog2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaFileIncentivi/parameters&quot; xmlns:tns1=&quot;http://www.example.org/DeCryptoDownload&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DeCryptoDownloadInput>&#xa;            &lt;tns1:idFileCriptato>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns:idFile&quot;/>&#xa;            &lt;/tns1:idFileCriptato>&#xa;        &lt;/tns1:DeCryptoDownloadInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
