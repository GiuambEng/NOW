                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VisualizzaFileIncentivi&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryNoOlo&quot;/>&lt;xsl:param name=&quot;QueryOlo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;VariableAppoggio&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($QueryNoOlo/Record/IDFILE) > 0&quot;>&lt;tns:VisualizzaFileIncentiviOutput>&lt;xsl:for-each select=&quot;$QueryNoOlo/Record&quot;>&lt;tns:listaFileIncentivi>&lt;tns:idFile>&lt;xsl:value-of select=&quot;IDFILE&quot;/>&lt;/tns:idFile>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOMEFILE&quot;/>&lt;/tns:nomeFile>&lt;xsl:if test=&quot;CODOLOAGCOM&quot;>&lt;tns:codificaOao>&lt;xsl:value-of select=&quot;CODOLOAGCOM&quot;/>&lt;/tns:codificaOao>&lt;/xsl:if>&lt;tns:dataCreazioneFile>&lt;xsl:value-of select=&quot;DATACREAZIONE&quot;/>&lt;/tns:dataCreazioneFile>&lt;tns:position>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:position>&lt;xsl:choose>&lt;xsl:when test=&quot;$index=1&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Esito Incentivo'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:when test=&quot;$index=2&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Esito Incentivo Switch OFF'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:when test=&quot;$index=3&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File CLLI Incentivo Switch OFF'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:when test=&quot;$index=4&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Risorse OAO Incentivo'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:when test=&quot;$index=5&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Incentivo Switch OFF'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Incentivo Switch OFF Elaborato KO'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:listaFileIncentivi>&lt;/xsl:for-each>&lt;/tns:VisualizzaFileIncentiviOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VisualizzaFileIncentiviOutput>&lt;xsl:for-each select=&quot;$QueryOlo/Record&quot;>&lt;tns:listaFileIncentivi>&lt;tns:idFile>&lt;xsl:value-of select=&quot;IDFILE&quot;/>&lt;/tns:idFile>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOMEFILE&quot;/>&lt;/tns:nomeFile>&lt;xsl:if test=&quot;CODOLOAGCOM&quot;>&lt;tns:codificaOao>&lt;xsl:value-of select=&quot;CODOLOAGCOM&quot;/>&lt;/tns:codificaOao>&lt;/xsl:if>&lt;tns:dataCreazioneFile>&lt;xsl:value-of select=&quot;DATACREAZIONE&quot;/>&lt;/tns:dataCreazioneFile>&lt;tns:position>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:position>&lt;xsl:choose>&lt;xsl:when test=&quot;$index=1&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Esito Incentivo'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:when test=&quot;$index=2&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Esito Incentivo Switch OFF'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:when test=&quot;$index=3&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File CLLI Incentivo Switch OFF'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:when test=&quot;$index=4&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Risorse OAO Incentivo'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:when test=&quot;$index=5&quot;>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Incentivo Switch OFF'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:tipologiaFile>&lt;xsl:value-of select=&quot;'File Incentivo Switch OFF Elaborato KO'&quot;/>&lt;/tns:tipologiaFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:listaFileIncentivi>&lt;/xsl:for-each>&lt;/tns:VisualizzaFileIncentiviOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

