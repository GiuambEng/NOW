                                    <value
                                    maxRows="100"
                                    overrideSQLSTMT="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select distinct(CF.ID_FILE) AS IDFILE, fp.nome_file AS NOMEFILE, fp.codfc_olo_agcom AS CODOLOAGCOM,fpo.timstp_crezione_file AS DATACREAZIONE&#xa;from CONTENUTO_FILE CF INNER JOIN FILE_PROCSTO FP ON cf.id_file=fp.id_file INNER JOIN FILE_PROCSTO_OUTPUT FPO&#xa;ON fp.id_file=fpo.id_file_procsto_output&#xa;INNER JOIN st_del_348_inc_oao_file ST ON fpo.id_file_procsto_output = st.id_file_prcso_output_oao"
