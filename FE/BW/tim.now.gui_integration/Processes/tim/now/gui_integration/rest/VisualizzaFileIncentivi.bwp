                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CryptoListParams&quot; xmlns:tns1=&quot;http://www.example.org/VisualizzaFileIncentivi&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VariableAppoggio&quot;/>&lt;xsl:template name=&quot;CryptoIdFiles-input&quot; match=&quot;/&quot;>&lt;tns:CryptoListParamsInput>&lt;xsl:for-each select=&quot;$VariableAppoggio/tns1:listaFileIncentivi&quot;>&lt;tns:listIdFile>&lt;xsl:if test=&quot;tns1:idFile&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;tns1:idFile&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;/tns:listIdFile>&lt;/xsl:for-each>&lt;/tns:CryptoListParamsInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
