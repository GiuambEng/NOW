                                    DataTypeDisplayValue="VARCHAR" ParameterName="fine2"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_TRACC"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STATO_NOW_DA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
