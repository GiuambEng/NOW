                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a7e676b3-78f3-4ab7-939d-7f73e0444b57+input&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1494424592542&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;profiloOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;GetTracciamentiDD2_NOT_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;GetTracciamentiDD2_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;visualizzaTracciato-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;cod_olo_utente1>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:codOloAgcom_utente&quot;/>&#xa;            &lt;/cod_olo_utente1>&#xa;            &lt;cod_olo_utente2>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:codOloAgcom_utente&quot;/>&#xa;            &lt;/cod_olo_utente2>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not(contains($profiloOlo,$post.item/tns1:profilo_utente))&quot;>&#xa;                    &lt;cod_olo_agcom>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($GetTracciamentiDD2_NOT_OLO/Record[CODFC_OLO_AGCOM!='']/CODFC_OLO_AGCOM)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$GetTracciamentiDD2_NOT_OLO/Record[CODFC_OLO_AGCOM!='']/CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/cod_olo_agcom>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;cod_olo_agcom>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($GetTracciamentiDD2_OLO/Record[CODFC_OLO_AGCOM!='']/CODFC_OLO_AGCOM)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$GetTracciamentiDD2_OLO/Record[CODFC_OLO_AGCOM!='']/CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/cod_olo_agcom>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count(CODFC_OLO_AGCOM) AS COUNTCODFCOLOAGCOM&#xa;from (select &#xa;codfc_olo_agcom&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ? OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM&#xa;FROM OLO&#xa;WHERE COD_OLO = (SELECT COD_OLO&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?))   ) where CODFC_OLO_AGCOM =?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_olo_utente1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_olo_utente2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_olo_agcom"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="COUNTCODFCOLOAGCOM"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
