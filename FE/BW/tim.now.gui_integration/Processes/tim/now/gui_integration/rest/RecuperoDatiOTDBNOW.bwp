                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+764becc7-b612-486c-881a-4c98bd54425b+input&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1494424592542&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;GetTracciamentiDD2_OLO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idrich>&lt;xsl:value-of select=&quot;$post/item/tns1:In_RecuperoOT_dd2/tns1:idRichiestaOlo&quot;/>&lt;/idrich>&lt;iniz>&lt;xsl:value-of select=&quot;if(contains($post/item/tns1:In_RecuperoOT_dd2/tns1:inizio_tracciamento,'.'))then substring-before($post/item/tns1:In_RecuperoOT_dd2/tns1:inizio_tracciamento,'.')else $post/item/tns1:In_RecuperoOT_dd2/tns1:inizio_tracciamento&quot;/>&lt;/iniz>&lt;fine>&lt;xsl:value-of select=&quot;if(contains($post/item/tns1:In_RecuperoOT_dd2/tns1:fine_tracciamento,'.'))then substring-before($post/item/tns1:In_RecuperoOT_dd2/tns1:fine_tracciamento,'.')else $post/item/tns1:In_RecuperoOT_dd2/tns1:fine_tracciamento&quot;/>&lt;/fine>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="GetTracciamentiDD2_OLO-input"
