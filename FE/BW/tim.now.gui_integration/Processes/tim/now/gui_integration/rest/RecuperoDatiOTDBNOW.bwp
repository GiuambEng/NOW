                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a1f1f987-dd77-401b-a862-e3deb87f6295+input&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1494424592542&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;GetTracciamentiDD2_NOT_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;idrich1>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:idRichiestaOlo&quot;/>&#xa;            &lt;/idrich1>&#xa;            &lt;ini1>&#xa;                &lt;xsl:value-of select=&quot;if(contains($post.item/tns1:inizio_tracciamento,'.'))then substring-before($post.item/tns1:inizio_tracciamento,'.')else $post.item/tns1:inizio_tracciamento&quot;/>&#xa;            &lt;/ini1>&#xa;            &lt;fine1>&#xa;                &lt;xsl:value-of select=&quot;if(contains($post.item/tns1:fine_tracciamento,'.'))then substring-before($post.item/tns1:fine_tracciamento,'.')else $post.item/tns1:fine_tracciamento&quot;/>&#xa;            &lt;/fine1>&#xa;            &lt;idrich2>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:idRichiestaOlo&quot;/>&#xa;            &lt;/idrich2>&#xa;            &lt;ini2>&#xa;                &lt;xsl:value-of select=&quot;if(contains($post.item/tns1:inizio_tracciamento,'.'))then substring-before($post.item/tns1:inizio_tracciamento,'.')else $post.item/tns1:inizio_tracciamento&quot;/>&#xa;            &lt;/ini2>&#xa;            &lt;fine2>&#xa;                &lt;xsl:value-of select=&quot;if(contains($post.item/tns1:fine_tracciamento,'.'))then substring-before($post.item/tns1:fine_tracciamento,'.')else $post.item/tns1:fine_tracciamento&quot;/>&#xa;            &lt;/fine2>&#xa;            &lt;idrich3>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns1:idRichiestaOlo&quot;/>&#xa;            &lt;/idrich3>&#xa;            &lt;ini1>&#xa;                &lt;xsl:value-of select=&quot;if(contains($post.item/tns1:inizio_tracciamento,'.'))then substring-before($post.item/tns1:inizio_tracciamento,'.')else $post.item/tns1:inizio_tracciamento&quot;/>&#xa;            &lt;/ini1>&#xa;            &lt;fine2>&#xa;                &lt;xsl:value-of select=&quot;if(contains($post.item/tns1:fine_tracciamento,'.'))then substring-before($post.item/tns1:fine_tracciamento,'.')else $post.item/tns1:fine_tracciamento&quot;/>&#xa;            &lt;/fine2>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="&#xa;SELECT  a.ID_RICH_OLO&#xa;      , a.TIMSTP_TRACC&#xa;      , a.STATO_NOW_DA&#xa;      , a.STATO_NOW_A&#xa;      , a.STATO_OLO_DA&#xa;      , a.STATO_OLO_A&#xa;      , a.DAC_DA&#xa;      , a.DAC_A&#xa;      , A.DESCR_CAUS_NOW_DG&#xa;      , A.DESCR_CAUS_OLO&#xa;      , B.CODFC_OLO_AGCOM&#xa;      , C.DESCR AS TIPOLOGIA_DESTINATARIO&#xa;      , D.DESCR AS TIPOLOGIA_NOTIFICA&#xa;      , B.TRACCIATO_FILE&#xa;  FROM (SELECT a.ID_RICH_OLO&#xa;                              , a.TIMSTP_TRACC&#xa;                              , a.STATO_NOW_DA&#xa;                              , a.STATO_NOW_A&#xa;                              , a.STATO_OLO_DA&#xa;                              , a.STATO_OLO_A&#xa;                              , a.DAC_DA&#xa;                              , a.DAC_A&#xa;                              , B.DESCR_CAUS_NOW_DG&#xa;                              , B.DESCR_CAUS_OLO&#xa;                              , A.ID_NOTF&#xa;                              , A.ID_NOTF_DONATING&#xa;                              , A.ID_NOTF_DONOR&#xa;                           FROM (SELECT ID_RICH_OLO  &#xa;                      , TIMSTP_TRACC&#xa;                      -- Numero di riga del Tracciamento in base al TMST di Inserimento&#xa;                      -- per avere una chiave univoca all'interno di una Richiesta OLO&#xa;                      , ROW_NUMBER() OVER ( PARTITION BY ID_RICH_OLO ORDER BY TIMSTP_TRACC ) AS NUM_RIG_TRACC&#xa;                      , STATO_NOW_DA&#xa;                      , STATO_NOW_A&#xa;                      , STATO_OLO_DA&#xa;                      , STATO_OLO_A&#xa;                      , DAC_DA&#xa;                      , DAC_A&#xa;                      , ID_ANAG_CAUS&#xa;                      , ID_NOTF&#xa;                      , ID_NOTF_DONATING&#xa;                      , ID_NOTF_DONOR &#xa;                   FROM RICH_ORDN_COMUNIC_TRACC&#xa;                   -- Condizione di ricerca della Richiesta OLO prelevata dalla riga del Primo LIvello&#xa;                  WHERE ID_RICH_OLO = ?) a&#xa;                                LEFT OUTER JOIN ANAG_CAUS B&#xa;                                  ON A.ID_ANAG_CAUS = B.ID_ANAG_CAUS&#xa;                           -- condizione di ricerca delle righe di Tracciamento del dettaglio prelevate dalla riga del Primo LIvello&#xa;                          WHERE a.NUM_RIG_TRACC BETWEEN ?&#xa;                                                    AND ?) a&#xa;       LEFT OUTER JOIN RICH_ORDN_COMUNIC_NOTF B&#xa;         ON A.ID_NOTF              = B.ID_NOTF&#xa;       LEFT OUTER JOIN TIPOLG_DESTNRIO_NOTF C&#xa;         ON B.IDTPLG_DESTNRIO_NOTF = C.IDTPLG_DESTNRIO_NOTF&#xa;       LEFT OUTER JOIN TIPOLG_NOTF D&#xa;         ON B.COD_TIPOLG_NOTF      = D.COD_TIPOLG_NOTF&#xa;        AND B.STRUTTURA_RICH       = D.STRUTTURA_RICH&#xa;UNION ALL  &#xa;SELECT  a.ID_RICH_OLO&#xa;      , a.TIMSTP_TRACC&#xa;      , a.STATO_NOW_DA&#xa;      , a.STATO_NOW_A&#xa;      , a.STATO_OLO_DA&#xa;      , a.STATO_OLO_A&#xa;      , a.DAC_DA&#xa;      , a.DAC_A&#xa;      , A.DESCR_CAUS_NOW_DG&#xa;      , A.DESCR_CAUS_OLO&#xa;      , B.CODFC_OLO_AGCOM&#xa;      , C.DESCR&#xa;      , D.DESCR&#xa;      , B.TRACCIATO_FILE&#xa;  FROM (SELECT a.ID_RICH_OLO&#xa;                              , a.TIMSTP_TRACC&#xa;                              , a.STATO_NOW_DA&#xa;                              , a.STATO_NOW_A&#xa;                              , a.STATO_OLO_DA&#xa;                              , a.STATO_OLO_A&#xa;                              , a.DAC_DA&#xa;                              , a.DAC_A&#xa;                              , B.DESCR_CAUS_NOW_DG&#xa;                              , B.DESCR_CAUS_OLO&#xa;                              , A.ID_NOTF&#xa;                              , A.ID_NOTF_DONATING&#xa;                              , A.ID_NOTF_DONOR&#xa;                           FROM (SELECT ID_RICH_OLO  &#xa;                      , TIMSTP_TRACC&#xa;                      -- Numero di riga del Tracciamento in base al TMST di Inserimento&#xa;                      -- per avere una chiave univoca all'interno di una Richiesta OLO&#xa;                      , ROW_NUMBER() OVER ( PARTITION BY ID_RICH_OLO ORDER BY TIMSTP_TRACC ) AS NUM_RIG_TRACC&#xa;                      , STATO_NOW_DA&#xa;                      , STATO_NOW_A&#xa;                      , STATO_OLO_DA&#xa;                      , STATO_OLO_A&#xa;                      , DAC_DA&#xa;                      , DAC_A&#xa;                      , ID_ANAG_CAUS&#xa;                      , ID_NOTF&#xa;                      , ID_NOTF_DONATING&#xa;                      , ID_NOTF_DONOR &#xa;                   FROM RICH_ORDN_COMUNIC_TRACC&#xa;                   -- Condizione di ricerca della Richiesta OLO prelevata dalla riga del Primo LIvello&#xa;                  WHERE ID_RICH_OLO = ?) a&#xa;                                LEFT OUTER JOIN ANAG_CAUS B&#xa;                                  ON A.ID_ANAG_CAUS = B.ID_ANAG_CAUS&#xa;                           -- condizione di ricerca delle righe di Tracciamento del dettaglio prelevate dalla riga del Primo LIvello&#xa;                          WHERE a.NUM_RIG_TRACC BETWEEN ?&#xa;                                                    AND ?) a&#xa;       LEFT OUTER JOIN RICH_ORDN_COMUNIC_NOTF B&#xa;         ON A.ID_NOTF_DONATING     = B.ID_NOTF&#xa;       LEFT OUTER JOIN TIPOLG_DESTNRIO_NOTF C&#xa;         ON B.IDTPLG_DESTNRIO_NOTF = C.IDTPLG_DESTNRIO_NOTF&#xa;       LEFT OUTER JOIN TIPOLG_NOTF D&#xa;         ON B.COD_TIPOLG_NOTF      = D.COD_TIPOLG_NOTF&#xa;        AND B.STRUTTURA_RICH       = D.STRUTTURA_RICH&#xa; WHERE A.ID_NOTF_DONATING IS NOT NULL&#xa;UNION ALL  &#xa;SELECT  a.ID_RICH_OLO&#xa;      , a.TIMSTP_TRACC&#xa;      , a.STATO_NOW_DA&#xa;      , a.STATO_NOW_A&#xa;      , a.STATO_OLO_DA&#xa;      , a.STATO_OLO_A&#xa;      , a.DAC_DA&#xa;      , a.DAC_A&#xa;      , A.DESCR_CAUS_NOW_DG&#xa;      , A.DESCR_CAUS_OLO&#xa;      , B.CODFC_OLO_AGCOM&#xa;      , C.DESCR&#xa;      , D.DESCR&#xa;      , B.TRACCIATO_FILE&#xa;  FROM (SELECT a.ID_RICH_OLO&#xa;                              , a.TIMSTP_TRACC&#xa;                              , a.STATO_NOW_DA&#xa;                              , a.STATO_NOW_A&#xa;                              , a.STATO_OLO_DA&#xa;                              , a.STATO_OLO_A&#xa;                              , a.DAC_DA&#xa;                              , a.DAC_A&#xa;                              , B.DESCR_CAUS_NOW_DG&#xa;                              , B.DESCR_CAUS_OLO&#xa;                              , A.ID_NOTF&#xa;                              , A.ID_NOTF_DONATING&#xa;                              , A.ID_NOTF_DONOR&#xa;                           FROM (SELECT ID_RICH_OLO  &#xa;                      , TIMSTP_TRACC&#xa;                      -- Numero di riga del Tracciamento in base al TMST di Inserimento&#xa;                      -- per avere una chiave univoca all'interno di una Richiesta OLO&#xa;                      , ROW_NUMBER() OVER ( PARTITION BY ID_RICH_OLO ORDER BY TIMSTP_TRACC ) AS NUM_RIG_TRACC&#xa;                      , STATO_NOW_DA&#xa;                      , STATO_NOW_A&#xa;                      , STATO_OLO_DA&#xa;                      , STATO_OLO_A&#xa;                      , DAC_DA&#xa;                      , DAC_A&#xa;                      , ID_ANAG_CAUS&#xa;                      , ID_NOTF&#xa;                      , ID_NOTF_DONATING&#xa;                      , ID_NOTF_DONOR &#xa;                   FROM RICH_ORDN_COMUNIC_TRACC&#xa;                   -- Condizione di ricerca della Richiesta OLO prelevata dalla riga del Primo LIvello&#xa;                  WHERE ID_RICH_OLO = ?) a&#xa;                                LEFT OUTER JOIN ANAG_CAUS B&#xa;                                  ON A.ID_ANAG_CAUS = B.ID_ANAG_CAUS&#xa;                           -- condizione di ricerca delle righe di Tracciamento del dettaglio prelevate dalla riga del Primo LIvello&#xa;                          WHERE a.NUM_RIG_TRACC BETWEEN ?&#xa;                                                    AND ?) a&#xa;       LEFT OUTER JOIN RICH_ORDN_COMUNIC_NOTF B&#xa;         ON A.ID_NOTF_DONOR        = B.ID_NOTF&#xa;       LEFT OUTER JOIN TIPOLG_DESTNRIO_NOTF C&#xa;         ON B.IDTPLG_DESTNRIO_NOTF = C.IDTPLG_DESTNRIO_NOTF&#xa;       LEFT OUTER JOIN TIPOLG_NOTF D&#xa;         ON B.COD_TIPOLG_NOTF      = D.COD_TIPOLG_NOTF&#xa;        AND B.STRUTTURA_RICH       = D.STRUTTURA_RICH&#xa; WHERE A.ID_NOTF_DONOR IS NOT NULL&#xa;ORDER BY 1,2      &#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idrich1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ini1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="fine1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idrich2"/>

                                    <PreparedParameters
