                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/RecuperoDatiOT&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://xmlns.example.com/RecuperoDatiOTDBNOW/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get2.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;get_RecuperoOTDB_InLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperoDatiOTDBNOW&amp;quot;&amp;#x9;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.RecuperoDatiOTDBNOW&amp;quot;&amp;#x9;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$get2.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get2.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Input RecuperoDatiOTDBNOW : &amp;quot;, tib:render-xml($get2.parameters/tns3:idRichiestaOlo, true(), true()))&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.RecuperoDatiOTDBNOW&amp;quot;&amp;#x9;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$get2.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get2.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get2.httpHeaders/GUI-SID, $get2.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$get2.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get2.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoDatiOTDBNOW_&amp;quot;, $get2.httpHeaders/GUI-SID, &amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoDatiOTDBNOW_&amp;quot;, $get2.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;tns:Playload>&#xa;                    &lt;tns:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get2.parameters/tns3:idRichiestaOlo)))&quot;/>&#xa;                    &lt;/tns:Binary>&#xa;                    &lt;tns:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($get2.parameters/tns3:idRichiestaOlo)&quot;/>&#xa;                    &lt;/tns:XMLString>&#xa;                &lt;/tns:Playload>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/RecuperoDatiOT&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://xmlns.example.com/RecuperoDatiOTDBNOW/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerInfo&quot;/>&lt;xsl:param name=&quot;get2&quot;/>&lt;xsl:template name=&quot;post_RecuperoOTDB_InLog_INFO-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;RecuperoDatiOTDBNOW&amp;quot;&amp;#x9;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.RecuperoDatiOTDBNOW&amp;quot;&amp;#x9;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$get2/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get2/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($get2/parameters/tns3:recuperodatiotdbnow1GetParameters/tns3:idRichiestaOlo)&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;InfoRecuperoDatiOTDBNOW : &amp;quot;, tib:render-xml($get2/parameters/tns3:recuperodatiotdbnow1GetParameters/tns3:idRichiestaOlo, true(), true()))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.RecuperoDatiOTDBNOW&amp;quot;&amp;#x9;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$get2/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get2/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventID>&lt;xsl:value-of select=&quot;concat($get2/httpHeaders/tns1:httpHeaders/GUI-SID, $get2/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&lt;/tns:EventID>&lt;xsl:if test=&quot;$get2/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$get2/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoDatiOTDBNOW_&amp;quot;, $get2/httpHeaders/tns1:httpHeaders/GUI-SID, &amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoDatiOTDBNOW_&amp;quot;, $get2/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_RecuperoOTDB_InLog_INFO-input"
                                    name="get_RecuperoOTDB_InLog_INFO"
                                    tibex:xpdlId="e4868925-8079-4a5b-b3ac-c03ded82480c"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToCallProcess2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="get_RecuperoOTDB_InLog_NOTOLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="get_RecuperoOTDB_InLog_OLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($profiloOlo,$get2/parameters/tns1:recuperodatiotdbnow1GetParameters/tns1:profilo) or $get2/parameters/tns1:recuperodatiotdbnow1GetParameters/tns1:profilo = 'CRM_OPCC'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($profiloOlo,$get2.parameters/tns1:profilo) or $get2.parameters/tns1:profilo = 'CRM_OPCC']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/RecuperoDatiOT&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://xmlns.example.com/RecuperoDatiOTDBNOW/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get2.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;post_RecuperoOTDB_InLog_INFO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperoDatiOTDBNOW&amp;quot;&amp;#x9;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.RecuperoDatiOTDBNOW&amp;quot;&amp;#x9;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$get2.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get2.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($get2.parameters/tns3:idRichiestaOlo)&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InfoRecuperoDatiOTDBNOW : &amp;quot;, tib:render-xml($get2.parameters/tns3:idRichiestaOlo, true(), true()))&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.RecuperoDatiOTDBNOW&amp;quot;&amp;#x9;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$get2.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get2.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get2.httpHeaders/GUI-SID, $get2.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$get2.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get2.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoDatiOTDBNOW_&amp;quot;, $get2.httpHeaders/GUI-SID, &amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperoDatiOTDBNOW_&amp;quot;, $get2.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b7ae613a-42bf-46da-a21d-52f74117cf3d+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoDatiOTDBNOW/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get2&quot;/>&lt;xsl:template name=&quot;RecuperoDatiOTNo-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idrich1>&lt;xsl:value-of select=&quot;$get2/parameters/tns1:recuperodatiotdbnow1GetParameters/tns1:idRichiestaOlo&quot;/>&lt;/idrich1>&lt;idrich2>&lt;xsl:value-of select=&quot;$get2/parameters/tns1:recuperodatiotdbnow1GetParameters/tns1:idRichiestaOlo&quot;/>&lt;/idrich2>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoDatiOT_NON_OLO-input"
                                    name="RecuperoDatiOT_NON_OLO"
                                    outputVariable="RecuperoDatiOT_NON_OLO"
                                    tibex:xpdlId="b7ae613a-42bf-46da-a21d-52f74117cf3d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_RecuperoOTDB_InLog_NOTOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoDatiOTNoToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b7ae613a-42bf-46da-a21d-52f74117cf3d+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoDatiOTDBNOW/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoDatiOTNo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;idrich1>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns1:idRichiestaOlo&quot;/>&#xa;            &lt;/idrich1>&#xa;            &lt;idrich2>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns1:idRichiestaOlo&quot;/>&#xa;            &lt;/idrich2>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement=" &#xa;SELECT  a.ID_RICH_OLO&#xa;      , a.CODFC_OLO_AGCOM&#xa;      , a.COD_ORDN_OLO&#xa;      , a.COD_ORDN_TI&#xa;      , a.ID_RISORSA&#xa;      , a.ID_RISORSA_NOW&#xa;      ,  a.TMST_CAMBIO_STATO_CORR&#xa;       , a.STATO_NOW_A_PREC STATO_NOW_DA&#xa;&#x9;  , a.STATO_NOW_A_CORR STATO_NOW_A&#xa;      ,a.STATO_OLO_A_PREC STATO_OLO_DA&#xa;      , a.STATO_OLO_A_CORR STATO_OLO_A&#xa;      -- Conteggio degli ID Notifica per lo Stato Corrente&#xa;      , ( SELECT COUNT ( B.ID_NOTF          ) &#xa;              +  COUNT ( B.ID_NOTF_DONATING ) &#xa;              +  COUNT ( B.ID_NOTF_DONOR    ) &#xa;            FROM ( SELECT CODFC_OLO_AGCOM&#xa;                      , COD_ORDN_OLO&#xa;                      , COD_ORDN_TI&#xa;                      , ID_RISORSA&#xa;                      , ID_RISORSA_NOW&#xa;                      , ID_RICH_OLO  &#xa;                      , TIMSTP_TRACC&#xa;                      -- Numero di riga del Tracciamento in base al TMST di Inserimento&#xa;                      -- per avere una chiave univoca all'interno di una Richiesta OLO&#xa;                      ,  ROW_NUMBER() OVER ( PARTITION BY ID_RICH_OLO &#xa;                                                 ORDER BY TIMSTP_TRACC &#xa;                                           ) AS NUM_RIG_TRACC&#xa;                      -- TIMESTAMP TRacciamento Successivo&#xa;                      , LEAD ( TIMSTP_TRACC, 1, SYSTIMESTAMP ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS TIMSTP_TRACC_SUCC&#xa;                      -- Stato NOW precedente&#xa;                      , LAG ( STATO_NOW_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_NOW_A_PREC&#xa;                      -- Stato NOW corrente&#xa;                      , STATO_NOW_A AS STATO_NOW_A_CORR&#xa;                      -- Stato NOW successivo&#xa;                      , LEAD ( STATO_NOW_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_NOW_A_SUCC&#xa;                      -- Stato OLO corrente&#xa;                      , STATO_OLO_A AS STATO_OLO_A_CORR&#xa;                      -- Stato OLO precedente&#xa;                      , LAG ( STATO_OLO_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_OLO_A_PREC&#xa;                      -- Stato OLO successivo&#xa;                      , LEAD ( STATO_OLO_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_OLO_A_SUCC&#xa;                      , ID_EVENTO_ORDN_NOW_WHLS&#xa;                      , ID_NOTF&#xa;                      , ID_NOTF_DONATING&#xa;                      , ID_NOTF_DONOR &#xa;                   FROM RICH_ORDN_COMUNIC_TRACC&#xa;                   -- Condizione di ricerca della Richiesta OLO&#xa;                  WHERE ID_RICH_OLO = ? ) B &#xa;           WHERE B.NUM_RIG_TRACC BETWEEN A.NUM_RIG_TRACC_INIZ&#xa;                                     AND A.NUM_RIG_TRACC_FINE&#xa;        ) AS NUM_NOTIFICHE&#xa;        -- Colonne tecniche per la condizione di ricerca della querey di Secondo LIvello&#xa;      , a.NUM_RIG_TRACC_INIZ&#xa;      , a.NUM_RIG_TRACC_FINE&#xa;   FROM (  SELECT ID_RICH_OLO&#xa;                , TIMSTP_TRACC&#xa;                , TIMSTP_TRACC_SUCC&#xa;                , TMST_CAMBIO_STATO_CORR&#xa;                , NUM_RIG_TRACC_INIZ&#xa;                -- Calcolo del TMST dello Stato Successivo, SYSTIMESTAMP per quello finale&#xa;                , CASE&#xa;                    WHEN TMST_CAMBIO_STATO_SUCC IS NULL&#xa;                      THEN LEAD ( TMST_CAMBIO_STATO_SUCC, 1, SYSTIMESTAMP ) &#xa;                                    OVER ( PARTITION BY ID_RICH_OLO &#xa;                                               ORDER BY TIMSTP_TRACC &#xa;                                         )&#xa;                    ELSE SYSTIMESTAMP&#xa;                  END  AS TMST_CAMBIO_STATO_SUCC&#xa;                -- Calcolo del Numero fi Riga del Tracciamento dello Stato Successivo&#xa;                , CASE&#xa;                    WHEN TMST_CAMBIO_STATO_SUCC IS NULL &#xa;                      THEN LEAD ( NUM_RIG_TRACC_FINE, 1, 0 ) &#xa;                                    OVER ( PARTITION BY ID_RICH_OLO &#xa;                                               ORDER BY TIMSTP_TRACC &#xa;                                         )&#xa;                    ELSE NUM_RIG_TRACC_FINE&#xa;                  END AS NUM_RIG_TRACC_FINE&#xa;                , STATO_NOW_A_PREC&#xa;                , STATO_NOW_A_CORR&#xa;                , STATO_NOW_A_SUCC&#xa;                , STATO_OLO_A_CORR&#xa;                ,STATO_OLO_A_PREC&#xa;                , CODFC_OLO_AGCOM&#xa;                , COD_ORDN_OLO&#xa;                , COD_ORDN_TI&#xa;                , ID_RISORSA&#xa;                , ID_RISORSA_NOW&#xa;            FROM ( SELECT ID_RICH_OLO&#xa;                        , TIMSTP_TRACC&#xa;                        , TIMSTP_TRACC_SUCC&#xa;                        , TMST_CAMBIO_STATO_CORR&#xa;                        , NUM_RIG_TRACC_INIZ&#xa;                        , TMST_CAMBIO_STATO_SUCC&#xa;                        , NUM_RIG_TRACC_FINE&#xa;                        , STATO_NOW_A_PREC&#xa;                        , STATO_NOW_A_CORR&#xa;                        , STATO_NOW_A_SUCC&#xa;                        , STATO_OLO_A_CORR&#xa;                        ,STATO_OLO_A_PREC&#xa;                        , CODFC_OLO_AGCOM&#xa;                        , COD_ORDN_OLO&#xa;                        , COD_ORDN_TI&#xa;                        , ID_RISORSA&#xa;                        , ID_RISORSA_NOW&#xa;                    FROM (  SELECT ID_RICH_OLO  &#xa;                                 , TIMSTP_TRACC&#xa;                                 , TIMSTP_TRACC_SUCC&#xa;                                 , NUM_RIG_TRACC&#xa;                                 -- TMST di cambio Stato al Corrente&#xa;                                 , CASE&#xa;                                     WHEN STATO_NOW_A_CORR &lt;> STATO_NOW_A_PREC&#xa;                                       OR STATO_NOW_A_PREC IS NULL&#xa;                                       THEN TIMSTP_TRACC &#xa;                                       ELSE NULL&#xa;                                   END AS TMST_CAMBIO_STATO_CORR&#xa;                                 -- Numero Riga del Tracciamento al cambio di Stato Corrente&#xa;                                 , CASE&#xa;                                     WHEN STATO_NOW_A_CORR &lt;> STATO_NOW_A_PREC&#xa;                                       OR STATO_NOW_A_PREC IS NULL&#xa;                                       THEN NUM_RIG_TRACC &#xa;                                       ELSE NULL&#xa;                                   END AS NUM_RIG_TRACC_INIZ&#xa;                                 -- TMST di cambio Stato al Successivo&#xa;                                 , CASE&#xa;                                     WHEN STATO_NOW_A_CORR &lt;> STATO_NOW_A_SUCC&#xa;                                       OR STATO_NOW_A_SUCC IS NULL&#xa;                                       THEN TIMSTP_TRACC_SUCC &#xa;                                       ELSE NULL&#xa;                                   END AS TMST_CAMBIO_STATO_SUCC&#xa;                                 -- Numero Riga del Tracciamento al cambio di Stato Corrente&#xa;                                 , CASE&#xa;                                     WHEN STATO_NOW_A_CORR &lt;> STATO_NOW_A_SUCC&#xa;                                       OR STATO_NOW_A_SUCC IS NULL&#xa;                                       THEN NUM_RIG_TRACC &#xa;                                       ELSE NULL&#xa;                                   END AS NUM_RIG_TRACC_FINE&#xa;                                 , STATO_NOW_A_PREC&#xa;                                 , STATO_NOW_A_CORR&#xa;                                 , STATO_NOW_A_SUCC&#xa;                                 , STATO_OLO_A_CORR&#xa;                                 ,STATO_OLO_A_PREC&#xa;                                 , ID_EVENTO_ORDN_NOW_WHLS&#xa;                                 , ID_NOTF&#xa;                                 , CODFC_OLO_AGCOM&#xa;                                 , COD_ORDN_OLO&#xa;                                 , COD_ORDN_TI&#xa;                                 , ID_RISORSA&#xa;                                 , ID_RISORSA_NOW&#xa;                              FROM ( SELECT CODFC_OLO_AGCOM&#xa;                      , COD_ORDN_OLO&#xa;                      , COD_ORDN_TI&#xa;                      , ID_RISORSA&#xa;                      , ID_RISORSA_NOW&#xa;                      , ID_RICH_OLO  &#xa;                      , TIMSTP_TRACC&#xa;                      -- Numero di riga del Tracciamento in base al TMST di Inserimento&#xa;                      -- per avere una chiave univoca all'interno di una Richiesta OLO&#xa;                      ,  ROW_NUMBER() OVER ( PARTITION BY ID_RICH_OLO &#xa;                                                 ORDER BY TIMSTP_TRACC &#xa;                                           ) AS NUM_RIG_TRACC&#xa;                      -- TIMESTAMP TRacciamento Successivo&#xa;                      , LEAD ( TIMSTP_TRACC, 1, SYSTIMESTAMP ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS TIMSTP_TRACC_SUCC&#xa;                      -- Stato NOW precedente&#xa;                      , LAG ( STATO_NOW_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_NOW_A_PREC&#xa;                      -- Stato NOW corrente&#xa;                      , STATO_NOW_A AS STATO_NOW_A_CORR&#xa;                      -- Stato NOW successivo&#xa;                      , LEAD ( STATO_NOW_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_NOW_A_SUCC&#xa;                      -- Stato OLO corrente&#xa;                      , STATO_OLO_A AS STATO_OLO_A_CORR&#xa;                      -- Stato OLO precedente&#xa;                      , LAG ( STATO_OLO_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_OLO_A_PREC&#xa;                      -- Stato OLO successivo&#xa;                      , LEAD ( STATO_OLO_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_OLO_A_SUCC&#xa;                      , ID_EVENTO_ORDN_NOW_WHLS&#xa;                      , ID_NOTF&#xa;                      , ID_NOTF_DONATING&#xa;                      , ID_NOTF_DONOR &#xa;                   FROM RICH_ORDN_COMUNIC_TRACC&#xa;                   -- Condizione di ricerca della Richiesta OLO&#xa;                  WHERE ID_RICH_OLO = ? ) BASE&#xa;                         )&#xa;                   -- Condizioni per selezionare solo le righe di inizio e fine Stato Corrente&#xa;                   WHERE TMST_CAMBIO_STATO_CORR IS NOT NULL&#xa;                      OR TMST_CAMBIO_STATO_SUCC IS NOT NULL &#xa;                 )&#xa;        ) a&#xa;  -- Condizioni per selezionare solo le righe di inizio Stato Corrente&#xa;  WHERE A.TMST_CAMBIO_STATO_CORR IS NOT NULL &#xa;ORDER BY 1,7"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

