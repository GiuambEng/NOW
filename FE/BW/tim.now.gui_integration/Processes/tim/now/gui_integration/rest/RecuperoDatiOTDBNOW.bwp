                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1494408707969&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoDatiOTDBNOW/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;profiloOlo&quot;/>&lt;xsl:param name=&quot;RecuperoDatiOT_OLO&quot;/>&lt;xsl:param name=&quot;RecuperoDatiOT_NON_OLO&quot;/>&lt;xsl:param name=&quot;get2&quot;/>&lt;xsl:template name=&quot;outTraccDGL1&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;not(contains($profiloOlo,$get2/parameters/tns1:recuperodatiotdbnow1GetParameters/tns1:profilo)) and $get2/parameters/tns1:recuperodatiotdbnow1GetParameters/tns1:profilo != 'CRM_OPCC'&quot;>&lt;tns:OutTracciamentoDGL1>&lt;xsl:for-each select=&quot;$RecuperoDatiOT_NON_OLO/Record&quot;>&lt;tns:OutTracciamentoObj>&lt;tns:timestampTracciamento>&lt;xsl:value-of select=&quot;concat(substring-before(format-dateTime( TMST_CAMBIO_STATO_CORR,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01][z]&amp;quot;),'G'),substring-after(format-dateTime( TMST_CAMBIO_STATO_CORR,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01][z]&amp;quot;),'MT'))&quot;/>&lt;/tns:timestampTracciamento>&lt;xsl:if test=&quot;STATO_NOW_DA&quot;>&lt;tns:statoNOW_DA>&lt;xsl:value-of select=&quot;STATO_NOW_DA&quot;/>&lt;/tns:statoNOW_DA>&lt;/xsl:if>&lt;tns:statoNOW_A>&lt;xsl:value-of select=&quot;STATO_NOW_A&quot;/>&lt;/tns:statoNOW_A>&lt;xsl:if test=&quot;STATO_OLO_A&quot;>&lt;tns:statoOLO_A>&lt;xsl:value-of select=&quot;STATO_OLO_A&quot;/>&lt;/tns:statoOLO_A>&lt;/xsl:if>&lt;tns:FlagNotifiche>&lt;xsl:value-of select=&quot;if(NUM_NOTIFICHE>0) then 'Y' else 'N'&quot;/>&lt;/tns:FlagNotifiche>&lt;tns:inizio_tracciamento>&lt;xsl:value-of select=&quot;NUM_RIG_TRACC_INIZ&quot;/>&lt;/tns:inizio_tracciamento>&lt;tns:fine_tracciamento>&lt;xsl:value-of select=&quot;NUM_RIG_TRACC_FINE&quot;/>&lt;/tns:fine_tracciamento>&lt;/tns:OutTracciamentoObj>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:details>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutTracciamentoDGL1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutTracciamentoDGL1>&lt;xsl:for-each select=&quot;$RecuperoDatiOT_OLO/Record&quot;>&lt;tns:OutTracciamentoObj>&lt;tns:timestampTracciamento>&lt;xsl:value-of select=&quot;concat(substring-before(format-dateTime( TMST_CAMBIO_STATO_CORR,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01][z]&amp;quot;),'G'),substring-after(format-dateTime( TMST_CAMBIO_STATO_CORR,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01][z]&amp;quot;),'MT'))&quot;/>&lt;/tns:timestampTracciamento>&lt;xsl:if test=&quot;STATO_OLO_DA&quot;>&lt;tns:statoOLO_DA>&lt;xsl:value-of select=&quot;STATO_OLO_DA&quot;/>&lt;/tns:statoOLO_DA>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_OLO_A&quot;>&lt;tns:statoOLO_A>&lt;xsl:value-of select=&quot;STATO_OLO_A&quot;/>&lt;/tns:statoOLO_A>&lt;/xsl:if>&lt;tns:FlagNotifiche>&lt;xsl:value-of select=&quot;if( NUM_NOTIFICHE>0) then 'Y' else 'N'&quot;/>&lt;/tns:FlagNotifiche>&lt;tns:inizio_tracciamento>&lt;xsl:value-of select=&quot;NUM_RIG_TRACC_INIZ&quot;/>&lt;/tns:inizio_tracciamento>&lt;tns:fine_tracciamento>&lt;xsl:value-of select=&quot;NUM_RIG_TRACC_FINE&quot;/>&lt;/tns:fine_tracciamento>&lt;/tns:OutTracciamentoObj>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:details>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutTracciamentoDGL1>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="outTraccDGL1"
                                    name="outTraccDGL1"
                                    outputVariable="outTraccDGL1"
                                    tibex:xpdlId="62f0d14b-1590-4831-bd7e-af650f00559b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RecuperoDatiOTNoToAssign"/>
                                    <bpws:target linkName="RecuperoDatiOT_OLOTooutTraccDGL1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="outTraccDGL1Topost_RecuperoOTDB_outp_Log"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1494408707969&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoDatiOTDBNOW/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;profiloOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiOT_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDatiOT_NON_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;outTraccDGL1&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;not(contains($profiloOlo,$get2.parameters/tns1:profilo)) and $get2.parameters/tns1:profilo != 'CRM_OPCC'&quot;>&#xa;                &lt;tns:OutTracciamentoDGL1>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoDatiOT_NON_OLO/Record&quot;>&#xa;                        &lt;tns:OutTracciamentoObj>&#xa;                            &lt;tns:timestampTracciamento>&#xa;                                &lt;xsl:value-of select=&quot;concat(substring-before(format-dateTime( TMST_CAMBIO_STATO_CORR,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01][z]&amp;quot;),'G'),substring-after(format-dateTime( TMST_CAMBIO_STATO_CORR,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01][z]&amp;quot;),'MT'))&quot;/>&#xa;                            &lt;/tns:timestampTracciamento>&#xa;                            &lt;xsl:if test=&quot;STATO_NOW_DA&quot;>&#xa;                                &lt;tns:statoNOW_DA>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_NOW_DA&quot;/>&#xa;                                &lt;/tns:statoNOW_DA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:statoNOW_A>&#xa;                                &lt;xsl:value-of select=&quot;STATO_NOW_A&quot;/>&#xa;                            &lt;/tns:statoNOW_A>&#xa;                            &lt;xsl:if test=&quot;STATO_OLO_A&quot;>&#xa;                                &lt;tns:statoOLO_A>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_OLO_A&quot;/>&#xa;                                &lt;/tns:statoOLO_A>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:FlagNotifiche>&#xa;                                &lt;xsl:value-of select=&quot;if(NUM_NOTIFICHE>0) then 'Y' else 'N'&quot;/>&#xa;                            &lt;/tns:FlagNotifiche>&#xa;                            &lt;tns:inizio_tracciamento>&#xa;                                &lt;xsl:value-of select=&quot;NUM_RIG_TRACC_INIZ&quot;/>&#xa;                            &lt;/tns:inizio_tracciamento>&#xa;                            &lt;tns:fine_tracciamento>&#xa;                                &lt;xsl:value-of select=&quot;NUM_RIG_TRACC_FINE&quot;/>&#xa;                            &lt;/tns:fine_tracciamento>&#xa;                        &lt;/tns:OutTracciamentoObj>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutTracciamentoDGL1>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OutTracciamentoDGL1>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoDatiOT_OLO/Record&quot;>&#xa;                        &lt;tns:OutTracciamentoObj>&#xa;                            &lt;tns:timestampTracciamento>&#xa;                                &lt;xsl:value-of select=&quot;concat(substring-before(format-dateTime( TMST_CAMBIO_STATO_CORR,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01][z]&amp;quot;),'G'),substring-after(format-dateTime( TMST_CAMBIO_STATO_CORR,&amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01][z]&amp;quot;),'MT'))&quot;/>&#xa;                            &lt;/tns:timestampTracciamento>&#xa;                            &lt;xsl:if test=&quot;STATO_OLO_DA&quot;>&#xa;                                &lt;tns:statoOLO_DA>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_OLO_DA&quot;/>&#xa;                                &lt;/tns:statoOLO_DA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATO_OLO_A&quot;>&#xa;                                &lt;tns:statoOLO_A>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_OLO_A&quot;/>&#xa;                                &lt;/tns:statoOLO_A>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:FlagNotifiche>&#xa;                                &lt;xsl:value-of select=&quot;if( NUM_NOTIFICHE>0) then 'Y' else 'N'&quot;/>&#xa;                            &lt;/tns:FlagNotifiche>&#xa;                            &lt;tns:inizio_tracciamento>&#xa;                                &lt;xsl:value-of select=&quot;NUM_RIG_TRACC_INIZ&quot;/>&#xa;                            &lt;/tns:inizio_tracciamento>&#xa;                            &lt;tns:fine_tracciamento>&#xa;                                &lt;xsl:value-of select=&quot;NUM_RIG_TRACC_FINE&quot;/>&#xa;                            &lt;/tns:fine_tracciamento>&#xa;                        &lt;/tns:OutTracciamentoObj>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutTracciamentoDGL1>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="outTraccDGL1" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a7ab8f81-16e3-48bc-8a90-f9abc1b4e7bc+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoDatiOTDBNOW/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get2&quot;/>&lt;xsl:template name=&quot;RecuperoDatiOT_OLO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idrich1>&lt;xsl:value-of select=&quot;$get2/parameters/tns1:recuperodatiotdbnow1GetParameters/tns1:idRichiestaOlo&quot;/>&lt;/idrich1>&lt;idrich2>&lt;xsl:value-of select=&quot;$get2/parameters/tns1:recuperodatiotdbnow1GetParameters/tns1:idRichiestaOlo&quot;/>&lt;/idrich2>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoDatiOT_OLO-input"
                                    name="RecuperoDatiOT_OLO"
                                    outputVariable="RecuperoDatiOT_OLO"
                                    tibex:xpdlId="a7ab8f81-16e3-48bc-8a90-f9abc1b4e7bc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_RecuperoOTDB_InLog_OLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoDatiOT_OLOTooutTraccDGL1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a7ab8f81-16e3-48bc-8a90-f9abc1b4e7bc+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/RecuperoDatiOTDBNOW/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoDatiOT_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;idrich1>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns1:idRichiestaOlo&quot;/>&#xa;            &lt;/idrich1>&#xa;            &lt;idrich2>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns1:idRichiestaOlo&quot;/>&#xa;            &lt;/idrich2>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT  a.ID_RICH_OLO&#xa;      , a.CODFC_OLO_AGCOM&#xa;      , a.COD_ORDN_OLO&#xa;      , a.COD_ORDN_TI&#xa;      , a.ID_RISORSA&#xa;      , a.ID_RISORSA_NOW&#xa;      , a.TMST_CAMBIO_STATO_CORR&#xa;      , a.STATO_OLO_A_PREC STATO_OLO_DA&#xa;      , a.STATO_OLO_A_CORR STATO_OLO_A&#xa;      -- Conteggio degli ID Notifica per lo Stato Corrente&#xa;      , ( SELECT COUNT ( B.ID_NOTF          ) &#xa;            FROM (SELECT CODFC_OLO_AGCOM&#xa;                      , COD_ORDN_OLO&#xa;                      , COD_ORDN_TI&#xa;                      , ID_RISORSA&#xa;                      , ID_RISORSA_NOW&#xa;                      , ID_RICH_OLO  &#xa;                      , TIMSTP_TRACC&#xa;                      -- Numero di riga del Tracciamento in base al TMST di Inserimento&#xa;                      -- per avere una chiave univoca all'interno di una Richiesta OLO&#xa;                      ,  ROW_NUMBER() OVER ( PARTITION BY ID_RICH_OLO &#xa;                                                 ORDER BY TIMSTP_TRACC &#xa;                                           ) AS NUM_RIG_TRACC&#xa;                      -- TIMESTAMP TRacciamento Successivo&#xa;                      , LEAD ( TIMSTP_TRACC, 1, SYSTIMESTAMP ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS TIMSTP_TRACC_SUCC&#xa;                      -- Stato NOW precedente&#xa;                      , LAG ( STATO_NOW_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_NOW_A_PREC&#xa;                      -- Stato NOW corrente&#xa;                      , STATO_NOW_A AS STATO_NOW_A_CORR&#xa;                      -- Stato NOW successivo&#xa;                      , LEAD ( STATO_NOW_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_NOW_A_SUCC&#xa;                      -- Stato OLO corrente&#xa;                      , STATO_OLO_A AS STATO_OLO_A_CORR&#xa;                      -- Stato OLO precedente&#xa;                      , LAG ( STATO_OLO_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_OLO_A_PREC&#xa;                      -- Stato OLO successivo&#xa;                      , LEAD ( STATO_OLO_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_OLO_A_SUCC&#xa;                      , ID_EVENTO_ORDN_NOW_WHLS&#xa;                      , ID_NOTF&#xa;                      , ID_NOTF_DONATING&#xa;                      , ID_NOTF_DONOR &#xa;                   FROM RICH_ORDN_COMUNIC_TRACC&#xa;                   -- Condizione di ricerca della Richiesta OLO&#xa;                  WHERE ID_RICH_OLO = ?) B &#xa;           WHERE B.NUM_RIG_TRACC BETWEEN A.NUM_RIG_TRACC_INIZ&#xa;                                     AND A.NUM_RIG_TRACC_FINE&#xa;        ) AS NUM_NOTIFICHE&#xa;        -- Colonne tecniche per la condizione di ricerca della querey di Secondo LIvello&#xa;      , a.NUM_RIG_TRACC_INIZ&#xa;      , a.NUM_RIG_TRACC_FINE&#xa;   FROM (  SELECT ID_RICH_OLO&#xa;                , TIMSTP_TRACC&#xa;                , TIMSTP_TRACC_SUCC&#xa;                , TMST_CAMBIO_STATO_CORR&#xa;                , NUM_RIG_TRACC_INIZ&#xa;                -- Calcolo del TMST dello Stato Successivo, SYSTIMESTAMP per quello finale&#xa;                , CASE&#xa;                    WHEN TMST_CAMBIO_STATO_SUCC IS NULL&#xa;                      THEN LEAD ( TMST_CAMBIO_STATO_SUCC, 1, SYSTIMESTAMP ) &#xa;                                    OVER ( PARTITION BY ID_RICH_OLO &#xa;                                               ORDER BY TIMSTP_TRACC &#xa;                                         )&#xa;                    ELSE SYSTIMESTAMP&#xa;                  END  AS TMST_CAMBIO_STATO_SUCC&#xa;                -- Calcolo del Numero fi Riga del Tracciamento dello Stato Successivo&#xa;                , CASE&#xa;                    WHEN TMST_CAMBIO_STATO_SUCC IS NULL &#xa;                      THEN LEAD ( NUM_RIG_TRACC_FINE, 1, 0 ) &#xa;                                    OVER ( PARTITION BY ID_RICH_OLO &#xa;                                               ORDER BY TIMSTP_TRACC &#xa;                                         )&#xa;                    ELSE NUM_RIG_TRACC_FINE&#xa;                  END AS NUM_RIG_TRACC_FINE&#xa;                , STATO_OLO_A_PREC&#xa;                , STATO_OLO_A_SUCC&#xa;                , STATO_OLO_A_CORR&#xa;                , CODFC_OLO_AGCOM&#xa;                , COD_ORDN_OLO&#xa;                , COD_ORDN_TI&#xa;                , ID_RISORSA&#xa;                , ID_RISORSA_NOW&#xa;            FROM ( SELECT ID_RICH_OLO&#xa;                        , TIMSTP_TRACC&#xa;                        , TIMSTP_TRACC_SUCC&#xa;                        , TMST_CAMBIO_STATO_CORR&#xa;                        , NUM_RIG_TRACC_INIZ&#xa;                        , TMST_CAMBIO_STATO_SUCC&#xa;                        , NUM_RIG_TRACC_FINE&#xa;                        , STATO_OLO_A_PREC&#xa;                        , STATO_OLO_A_SUCC&#xa;                        , STATO_OLO_A_CORR&#xa;                        , CODFC_OLO_AGCOM&#xa;                        , COD_ORDN_OLO&#xa;                        , COD_ORDN_TI&#xa;                        , ID_RISORSA&#xa;                        , ID_RISORSA_NOW&#xa;                    FROM (  SELECT ID_RICH_OLO  &#xa;                                 , TIMSTP_TRACC&#xa;                                 , TIMSTP_TRACC_SUCC&#xa;                                 , NUM_RIG_TRACC&#xa;                                 -- TMST di cambio Stato al Corrente&#xa;                                 , CASE&#xa;                                     WHEN STATO_OLO_A_CORR &lt;> STATO_OLO_A_PREC&#xa;                                       OR STATO_OLO_A_PREC IS NULL&#xa;                                       THEN TIMSTP_TRACC &#xa;                                       ELSE NULL&#xa;                                   END AS TMST_CAMBIO_STATO_CORR&#xa;                                 -- Numero Riga del Tracciamento al cambio di Stato Corrente&#xa;                                 , CASE&#xa;                                     WHEN STATO_OLO_A_CORR &lt;> STATO_OLO_A_PREC&#xa;                                       OR STATO_OLO_A_PREC IS NULL&#xa;                                       THEN NUM_RIG_TRACC &#xa;                                       ELSE NULL&#xa;                                   END AS NUM_RIG_TRACC_INIZ&#xa;                                 -- TMST di cambio Stato al Successivo&#xa;                                 , CASE&#xa;                                     WHEN STATO_OLO_A_CORR &lt;> STATO_OLO_A_SUCC&#xa;                                       OR STATO_OLO_A_SUCC IS NULL&#xa;                                       THEN TIMSTP_TRACC_SUCC &#xa;                                       ELSE NULL&#xa;                                   END AS TMST_CAMBIO_STATO_SUCC&#xa;                                 -- Numero Riga del Tracciamento al cambio di Stato Corrente&#xa;                                 , CASE&#xa;                                     WHEN STATO_OLO_A_CORR &lt;> STATO_OLO_A_SUCC&#xa;                                       OR STATO_OLO_A_SUCC IS NULL&#xa;                                       THEN NUM_RIG_TRACC &#xa;                                       ELSE NULL&#xa;                                   END AS NUM_RIG_TRACC_FINE&#xa;                                 , STATO_OLO_A_PREC&#xa;                                 , STATO_OLO_A_SUCC&#xa;                                 , STATO_OLO_A_CORR&#xa;                                 , ID_EVENTO_ORDN_NOW_WHLS&#xa;                                 , ID_NOTF&#xa;                                 , CODFC_OLO_AGCOM&#xa;                                 , COD_ORDN_OLO&#xa;                                 , COD_ORDN_TI&#xa;                                 , ID_RISORSA&#xa;                                 , ID_RISORSA_NOW&#xa;                              FROM (SELECT CODFC_OLO_AGCOM&#xa;                      , COD_ORDN_OLO&#xa;                      , COD_ORDN_TI&#xa;                      , ID_RISORSA&#xa;                      , ID_RISORSA_NOW&#xa;                      , ID_RICH_OLO  &#xa;                      , TIMSTP_TRACC&#xa;                      -- Numero di riga del Tracciamento in base al TMST di Inserimento&#xa;                      -- per avere una chiave univoca all'interno di una Richiesta OLO&#xa;                      ,  ROW_NUMBER() OVER ( PARTITION BY ID_RICH_OLO &#xa;                                                 ORDER BY TIMSTP_TRACC &#xa;                                           ) AS NUM_RIG_TRACC&#xa;                      -- TIMESTAMP TRacciamento Successivo&#xa;                      , LEAD ( TIMSTP_TRACC, 1, SYSTIMESTAMP ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS TIMSTP_TRACC_SUCC&#xa;                      -- Stato NOW precedente&#xa;                      , LAG ( STATO_NOW_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_NOW_A_PREC&#xa;                      -- Stato NOW corrente&#xa;                      , STATO_NOW_A AS STATO_NOW_A_CORR&#xa;                      -- Stato NOW successivo&#xa;                      , LEAD ( STATO_NOW_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_NOW_A_SUCC&#xa;                      -- Stato OLO corrente&#xa;                      , STATO_OLO_A AS STATO_OLO_A_CORR&#xa;                      -- Stato OLO precedente&#xa;                      , LAG ( STATO_OLO_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_OLO_A_PREC&#xa;                      -- Stato OLO successivo&#xa;                      , LEAD ( STATO_OLO_A, 1, NULL ) &#xa;                          OVER ( PARTITION BY ID_RICH_OLO &#xa;                                     ORDER BY TIMSTP_TRACC &#xa;                               ) AS STATO_OLO_A_SUCC&#xa;                      , ID_EVENTO_ORDN_NOW_WHLS&#xa;                      , ID_NOTF&#xa;                      , ID_NOTF_DONATING&#xa;                      , ID_NOTF_DONOR &#xa;                   FROM RICH_ORDN_COMUNIC_TRACC&#xa;                   -- Condizione di ricerca della Richiesta OLO&#xa;                  WHERE ID_RICH_OLO = ?)&#xa;                         )&#xa;                   -- Condizioni per selezionare solo le righe di inizio e fine Stato Corrente&#xa;                   WHERE TMST_CAMBIO_STATO_CORR IS NOT NULL&#xa;                      OR TMST_CAMBIO_STATO_SUCC IS NOT NULL &#xa;                 )&#xa;        ) a&#xa;  -- Condizioni per selezionare solo le righe di inizio Stato Corrente&#xa;  WHERE A.TMST_CAMBIO_STATO_CORR IS NOT NULL &#xa;    AND A.STATO_OLO_A_CORR       IS NOT NULL&#xa;ORDER BY 1,7&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idrich1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idrich2"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_ORDN_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_ORDN_TI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RISORSA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RISORSA_NOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TMST_CAMBIO_STATO_CORR"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STATO_OLO_DA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_OLO_A"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUM_NOTIFICHE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUM_RIG_TRACC_INIZ"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUM_RIG_TRACC_FINE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
                <bpws:onMessage operation="post"
                    partnerLink="recuperodatiotdbnowdd2"
                    portType="ns:recuperodatiotdbnowdd21"
                    tibex:xpdlId="a5068b96-4ba8-46d2-bbad-1944d63c8b74" variable="post">
                    <bpws:scope name="scope3">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails1"
                                tibex:faultNameVar="FaultName1" tibex:xpdlId="f19b71e5-b27b-404a-b989-cf7b113c66bd">
                                <bpws:scope name="scope4">
                                    <bpws:flow name="flow4">
                                    <bpws:links>
                                    <bpws:link
                                    name="post_RecuperoOTDB_ErrorLogDD2ToReply" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
