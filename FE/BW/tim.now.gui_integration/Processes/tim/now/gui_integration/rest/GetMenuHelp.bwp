                                    <bpws:sources>
                                    <bpws:source linkName="MapperToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/getMenuHelp&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;descrMenuQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperDescrMenu-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length(string($descrMenuQuery/Record[1]/IDTPLG_MENU_HELP)) > 0&quot;>&#xa;                &lt;tns:outputGetMenuHelp>&#xa;                    &lt;xsl:for-each select=&quot;$descrMenuQuery/Record&quot;>&#xa;                        &lt;tns:OutputGetMenuHelp>&#xa;                            &lt;tns:descrMenuHelp>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_MENU_HELP&quot;/>&#xa;                            &lt;/tns:descrMenuHelp>&#xa;                            &lt;tns:idTiplgMenuHelp>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(IDTPLG_MENU_HELP)&quot;/>&#xa;                            &lt;/tns:idTiplgMenuHelp>&#xa;                        &lt;/tns:OutputGetMenuHelp>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputGetMenuHelp>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputGetMenuHelp>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputGetMenuHelp>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:getMenuHelp="http://www.tim.com/NOW/rest/getMenuHelp" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="getMenuHelp:outputGetMenuHelp" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
