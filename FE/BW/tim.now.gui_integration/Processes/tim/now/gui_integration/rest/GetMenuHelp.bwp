    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
                <variable>MapperDescrMenu</variable>
            </endingVariables>
        </task>
        <task name="descrMenuQuery">
            <endingVariables>
                <variable>descrMenuQuery-input</variable>
            </endingVariables>
        </task>
        <task name="get_menuHelp_InputLog">
            <endingVariables>
                <variable>get_menuHelp_InputLog-input</variable>
            </endingVariables>
        </task>
        <task name="get_menuHelp_InputLog_INFO">
            <endingVariables>
                <variable>get_menuHelp_InputLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="get_menuHelp_OutputLog">
            <endingVariables>
                <variable>get_menuHelp_OutputLog-input</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="MapperDescrMenu">
            <endingVariables>
                <variable>MapperDescrMenu-input</variable>
                <variable>descrMenuQuery</variable>
            </endingVariables>
        </task>
        <task name="get_menuHelp_Error_Log">
            <endingVariables>
                <variable>get_menuHelp_Error_Log-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="ReplyMenuHelp">
            <endingVariables>
                <variable>ReplyMenuHelp-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
