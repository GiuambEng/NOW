;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventID>&lt;xsl:value-of select=&quot;concat(&amp;quot;SID:&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;_TID:&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&lt;/tns:EventID>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;GetMenuHelp_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;GetMenuHelp_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_menuHelp_OutputLog-input"
                                    name="get_menuHelp_OutputLog"
                                    tibex:xpdlId="6ba8f325-c764-4bea-b87c-7b185a2a73d5"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToCallProcess"/>
