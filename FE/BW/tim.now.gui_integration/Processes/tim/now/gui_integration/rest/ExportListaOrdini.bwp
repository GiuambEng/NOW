                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/exportToExcel&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;ExportToExcell-input&quot; match=&quot;/&quot;>&lt;tns1:xmlToExcel_Input>&lt;tns1:User_ID>&lt;xsl:value-of select=&quot;$post/item/tns:exportToExcel_Input/tns:User_ID&quot;/>&lt;/tns1:User_ID>&lt;tns1:ID_Richiesta>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:ID_Richiesta>&lt;tns1:COD_OLO_AGCOM>&lt;xsl:value-of select=&quot;$post/item/tns:exportToExcel_Input/tns:COD_OLO_AGCOM&quot;/>&lt;/tns1:COD_OLO_AGCOM>&lt;tns1:Tipo_Profilo>&lt;xsl:value-of select=&quot;$post/item/tns:exportToExcel_Input/tns:Tipo_Profilo&quot;/>&lt;/tns1:Tipo_Profilo>&lt;tns1:ID_File>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&lt;/tns1:ID_File>&lt;tns1:Tipo_Lista>&lt;xsl:value-of select=&quot;$post/item/tns:exportToExcel_Input/tns:Tipo_Lista&quot;/>&lt;/tns1:Tipo_Lista>&lt;tns1:xmlToExcel_RicercaAvanzata>&lt;xsl:if test=&quot;$post/item/tns:exportToExcel_Input/tns:RicercaAvanzata_xmlToExcel/tns:numerorighe&quot;>&lt;tns1:numerorighe>&lt;xsl:value-of select=&quot;$post/item/tns:exportToExcel_Input/tns:RicercaAvanzata_xmlToExcel/tns:numerorighe&quot;/>&lt;/tns1:numerorighe>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:exportToExcel_Input/tns:RicercaAvanzata_xmlToExcel/tns:indiceriga&quot;>&lt;tns1:indiceriga>&lt;xsl:value-of select=&quot;$post/item/tns:exportToExcel_Input/tns:RicercaAvanzata_xmlToExcel/tns:indiceriga&quot;/>&lt;/tns1:indiceriga>&lt;/xsl:if>&lt;xsl:if test=&quot;$post/item/tns:exportToExcel_Input/tns:RicercaAvanza