                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/exportToExcel&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/restSubprocesses/xmlToExcelOrders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;ExportToExcell-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:xmlToExcel_Input>&#xa;            &lt;tns1:User_ID>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns:User_ID&quot;/>&#xa;            &lt;/tns1:User_ID>&#xa;            &lt;tns1:ID_Richiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/tns1:ID_Richiesta>&#xa;            &lt;tns1:COD_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns:COD_OLO_AGCOM&quot;/>&#xa;            &lt;/tns1:COD_OLO_AGCOM>&#xa;            &lt;tns1:Tipo_Profilo>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns:Tipo_Profilo&quot;/>&#xa;            &lt;/tns1:Tipo_Profilo>&#xa;            &lt;tns1:ID_File>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns1:ID_File>&#xa;            &lt;tns1:Tipo_Lista>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns:Tipo_Lista&quot;/>&#xa;            &lt;/tns1:Tipo_Lista>&#xa;            &lt;tns1:xmlToExcel_RicercaAvanzata>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:RicercaAvanzata_xmlToExcel/tns:numerorighe&quot;>&#xa;                    &lt;tns1:numerorighe>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:RicercaAvanzata_xmlToExcel/tns:numerorighe&quot;/>&#xa;                    &lt;/tns1:numerorighe>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:RicercaAvanzata_xmlToExcel/tns:indiceriga&quot;>&#xa;                    &lt;tns1:indiceriga>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:RicercaAvanzata_xmlToExcel/tns:indiceriga&quot;/>&#xa;                    &lt;/tns1:indiceriga>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:RicercaAvanzata_xmlToExcel/tns:exportRequest&quot;>&#xa;                    &lt;tns1:exportRequest>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:RicercaAvanzata_xmlToExcel/tns:exportRequest&quot;/>&#xa;                    &lt;/tns1:exportRequest>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$post.item/tns:RicercaAvanzata_xmlToExcel/tns:strutturaCondition&quot;>&#xa;                    &lt;tns1:strutturaCondition>&#xa;                        &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                            &lt;tns1:nome>&#xa;                                &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                            &lt;/tns1:nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:operazione&quot;>&#xa;                            &lt;tns1:operazione>&#xa;                                &lt;xsl:value-of select=&quot;tns:operazione&quot;/>&#xa;                            &lt;/tns1:operazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:valore&quot;>&#xa;                            &lt;tns1:valore>&#xa;                                &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                            &lt;/tns1:valore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;tns:tipo&quot;>&#xa;                            &lt;tns1:tipo>&#xa;                                &lt;xsl:value-of select=&quot;tns:tipo&quot;/>&#xa;                            &lt;/tns1:tipo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:strutturaCondition>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:RicercaAvanzata_xmlToExcel/tns:idReport&quot;>&#xa;                    &lt;tns1:idReport>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:RicercaAvanzata_xmlToExcel/tns:idReport&quot;/>&#xa;                    &lt;/tns1:idReport>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:xmlToExcel_RicercaAvanzata>&#xa;        &lt;/tns1:xmlToExcel_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.ExportToExcelListaOrdineSub" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
