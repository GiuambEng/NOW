                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Localizzatore&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOscuramento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SystemLocator&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.SystemLocator&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record recuperato per oscuramento&amp;quot;, tib:render-xml($Oscuramento, true(), true()))&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Record non recuperato per oscuramento'&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat('Info Localizzatore :',string($post/item/tns:InputRestLocalizzatore))&quot;/>&#xa;                &lt;/tns5:Payload>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.SystemLocator&amp;quot;&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns6:httpHeaders/GUI-SID,$post/httpHeaders/tns6:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns5:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns5:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns5:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SystemLocator_&amp;quot;,$post/httpHeaders/tns6:httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns5:EventType>&#xa;                        &lt;tns5:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SystemLocator_&amp;quot;,$post/httpHeaders/tns6:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns5:trackID>&#xa;                    &lt;/tns5:Identifier>&#xa;                    &lt;tns5:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns5:track_position>&#xa;                    &lt;tns5:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns5:Timestamp>&#xa;                &lt;/tns5:Envelope>&#xa;            &lt;/tns5:ActiveLoggerServices>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogOscuramento-input"
                                    name="LogOscuramento"
                                    tibex:xpdlId="4e163433-d3af-4bc2-b8a0-444a4dbf47ee"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToRenderJSON">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogOscuramentoToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($Oscuramento/Record[COD_AGESP='T1PRJ0039445'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0039445']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0039445']/FLAG_OSCURMENTO='Y' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Oscuramento/Record[COD_AGESP='T1PRJ0039445'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0039445']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0039445']/FLAG_OSCURMENTO='Y' )]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Localizzatore&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOscuramento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SystemLocator&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.SystemLocator&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record recuperato per oscuramento&amp;quot;, tib:render-xml($Oscuramento, true(), true()))&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Record non recuperato per oscuramento'&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat('Info Localizzatore :',string($post.item))&quot;/>&#xa;                &lt;/tns5:Payload>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.SystemLocator&amp;quot;&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns5:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns5:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns5:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SystemLocator_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns5:EventType>&#xa;                        &lt;tns5:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SystemLocator_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns5:trackID>&#xa;                    &lt;/tns5:Identifier>&#xa;                    &lt;tns5:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns5:track_position>&#xa;                    &lt;tns5:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns5:Timestamp>&#xa;                &lt;/tns5:Envelope>&#xa;            &lt;/tns5:ActiveLoggerServices>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
