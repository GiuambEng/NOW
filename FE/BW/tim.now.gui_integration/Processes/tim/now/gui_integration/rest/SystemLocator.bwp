                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Localizzatore&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SystemLocator&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.SystemLocator&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat('Input Localizzatore :',tib:render-xml($post/item/tns:InputRestLocalizzatore), xsd:string(true()), xsd:string(true()))&quot;/>&#xa;                &lt;/tns5:Payload>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.SystemLocator&amp;quot;&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns6:httpHeaders/GUI-SID,$post/httpHeaders/tns6:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns5:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns5:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns5:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SystemLocator_&amp;quot;,$post/httpHeaders/tns6:httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns5:EventType>&#xa;                        &lt;tns5:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SystemLocator_&amp;quot;,$post/httpHeaders/tns6:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns5:trackID>&#xa;                    &lt;/tns5:Identifier>&#xa;                    &lt;tns5:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns5:track_position>&#xa;                    &lt;tns5:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns5:Timestamp>&#xa;                &lt;/tns5:Envelope>&#xa;                &lt;tns5:Playload>&#xa;                    &lt;tns5:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($post/item/tns:InputRestLocalizzatore )))&quot;/>&#xa;                    &lt;/tns5:Binary>&#xa;                    &lt;tns5:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($post/item/tns:InputRestLocalizzatore)&quot;/>&#xa;                    &lt;/tns5:XMLString>&#xa;                &lt;/tns5:Playload>&#xa;            &lt;/tns5:ActiveLoggerServices>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="post_SystemLocator_InLog-input"
                                    name="post_SystemLocator_InLog"
                                    tibex:xpdlId="e6f26795-2857-4792-9c21-1a2f0f7eaba3"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToCallProcess1"/>
