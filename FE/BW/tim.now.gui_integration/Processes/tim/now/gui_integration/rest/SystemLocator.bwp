RispostaLocalizzatore/ns011:RispostaLocalizzatore/ns011:Risposta/ns011:SistemaDiCompetenza)&quot;/>&lt;/tns:Descrizione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;concat('Risposta : ',string($GetSystem/RispostaLocalizzatore/ns011:RispostaLocalizzatore/ns011:Risposta))&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutputRestLocalizzatore>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0039445'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0039445']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0039445']/FLAG_OSCURMENTO='Y')&quot;>&lt;tns:OutputRestLocalizzatore>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Oscurato'&quot;/>&lt;/tns:Descrizione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;'Oscurato'&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutputRestLocalizzatore>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseJSON/tns1:CodiceEsito='0' and $ParseJSON/tns1:OwnerOrdine='NOW'&quot;>&lt;tns:OutputRestLocalizzatore>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;concat('Il sistema di competenza è : ',$ParseJSON/tns1:OwnerOrdine)&quot;/>&lt;/tns:Descrizione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;concat('Risposta : ',string($ParseJSON))&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutputRestLocalizzatore>&lt;/xsl:when>&lt;xsl:when test=&quot;$ParseJSON/tns1:CodiceEsito='0' and $ParseJSON/tns1:OwnerOrdine!='NOW'&quot;>&lt;tns:OutputRestLocalizzatore>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Esito>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;concat('Non è possibile proseguire con l’ordine, il Sistema di competenza è: ',$ParseJSON/tns1:OwnerOrdine)&quot;/>&lt;/tns:Descrizione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;concat('Risposta : ',string($ParseJSON))&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutputRestLocalizzatore>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputRestLocalizzatore>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Esito>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;concat('Errore : ',$ParseJSON/tns1:DescrizioneEsito)&quot;/>&lt;/tns:Descrizione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;concat('Risposta : ',string($ParseJSON))&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutputRestLocalizzatore>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
