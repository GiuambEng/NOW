                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Localizzatore&quot; xmlns:ns011=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tns1=&quot;http://www.example.org/ServizioDidisambiguazionedaWDCAPeWSDPLUS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetSystem.RispostaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseJSON&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$GetSystem.RispostaLocalizzatore/ns011:Risposta/ns011:RC !='00' and 1=0&quot;>&#xa;                &lt;tns:OutputRestLocalizzatore>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns:Esito>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;concat('Errore : ',$GetSystem.RispostaLocalizzatore/ns011:Risposta/ns011:ErrMSG)&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risposta : ',string($GetSystem.RispostaLocalizzatore/ns011:Risposta))&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputRestLocalizzatore>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($GetSystem.RispostaLocalizzatore/ns011:Risposta/ns011:SistemaDiCompetenza)!='NOW' and $GetSystem.RispostaLocalizzatore/ns011:Risposta/ns011:RC='00' and 1=0&quot;>&#xa;                        &lt;tns:OutputRestLocalizzatore>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                            &lt;/tns:Esito>&#xa;                            &lt;tns:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;concat('Non è possibile proseguire con l’ordine, il Sistema di competenza è: ' ,$GetSystem.RispostaLocalizzatore/ns011:Risposta/ns011:SistemaDiCompetenza)&quot;/>&#xa;                            &lt;/tns:Descrizione>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:code>&#xa;                                &lt;tns:details>&#xa;                                    &lt;xsl:value-of select=&quot;concat('Risposta : ',string($GetSystem.RispostaLocalizzatore/ns011:Risposta))&quot;/>&#xa;                                &lt;/tns:details>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:OutputRestLocalizzatore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0039445'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0039445']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0039445']/FLAG_OSCURMENTO='Y')&quot;>&#xa;                                &lt;tns:OutputRestLocalizzatore>&#xa;                                    &lt;tns:Esito>&#xa;                                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                    &lt;/tns:Esito>&#xa;                                    &lt;tns:Descrizione>&#xa;                                        &lt;xsl:value-of select=&quot;'Oscurato'&quot;/>&#xa;                                    &lt;/tns:Descrizione>&#xa;                                    &lt;tns:result>&#xa;                                        &lt;tns:severity>&#xa;                                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                        &lt;/tns:severity>&#xa;                                        &lt;tns:code>&#xa;                                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                        &lt;/tns:code>&#xa;                                        &lt;tns:details>&#xa;                                            &lt;xsl:value-of select=&quot;'Oscurato'&quot;/>&#xa;                                        &lt;/tns:details>&#xa;                                    &lt;/tns:result>&#xa;                                &lt;/tns:OutputRestLocalizzatore>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$ParseJSON/tns1:CodiceEsito='0' and $ParseJSON/tns1:OwnerOrdine='NOW'&quot;>&#xa;                                &lt;tns:OutputRestLocalizzatore>&#xa;                                    &lt;tns:Esito>&#xa;                                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                    &lt;/tns:Esito>&#xa;                                    &lt;tns:Descrizione>&#xa;                                        &lt;xsl:value-of select=&quot;concat('Il sistema di competenza è : ',$ParseJSON/tns1:OwnerOrdine)&quot;/>&#xa;                                    &lt;/tns:Descrizione>&#xa;                                    &lt;tns:result>&#xa;                                        &lt;tns:severity>&#xa;                                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                        &lt;/tns:severity>&#xa;                                        &lt;tns:code>&#xa;                                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                        &lt;/tns:code>&#xa;                                        &lt;tns:details>&#xa;                                            &lt;xsl:value-of select=&quot;concat('Risposta : ',string($ParseJSON))&quot;/>&#xa;                                        &lt;/tns:details>&#xa;                                    &lt;/tns:result>&#xa;                                &lt;/tns:OutputRestLocalizzatore>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$ParseJSON/tns1:CodiceEsito='0' and $ParseJSON/tns1:OwnerOrdine!='NOW'&quot;>&#xa;                                &lt;tns:OutputRestLocalizzatore>&#xa;                                    &lt;tns:Esito>&#xa;                                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                    &lt;/tns:Esito>&#xa;                                    &lt;tns:Descrizione>&#xa;                                        &lt;xsl:value-of select=&quot;concat('Non è possibile proseguire con l’ordine, il Sistema di competenza è: ',$ParseJSON/tns1:OwnerOrdine)&quot;/>&#xa;                                    &lt;/tns:Descrizione>&#xa;                                    &lt;tns:result>&#xa;                                        &lt;tns:severity>&#xa;                                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                        &lt;/tns:severity>&#xa;                                        &lt;tns:code>&#xa;                                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                        &lt;/tns:code>&#xa;                                        &lt;tns:details>&#xa;                                            &lt;xsl:value-of select=&quot;concat('Risposta : ',string($ParseJSON))&quot;/>&#xa;                                        &lt;/tns:details>&#xa;                                    &lt;/tns:result>&#xa;                                &lt;/tns:OutputRestLocalizzatore>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:OutputRestLocalizzatore>&#xa;                                    &lt;tns:Esito>&#xa;                                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                    &lt;/tns:Esito>&#xa;                                    &lt;tns:Descrizione>&#xa;                                        &lt;xsl:value-of select=&quot;concat('Errore : ',$ParseJSON/tns1:DescrizioneEsito)&quot;/>&#xa;                                    &lt;/tns:Descrizione>&#xa;                                    &lt;tns:result>&#xa;                                        &lt;tns:severity>&#xa;                                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                                        &lt;/tns:severity>&#xa;                                        &lt;tns:code>&#xa;                                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                        &lt;/tns:code>&#xa;                                        &lt;tns:details>&#xa;                                            &lt;xsl:value-of select=&quot;concat('Risposta : ',string($ParseJSON))&quot;/>&#xa;                                        &lt;/tns:details>&#xa;                                    &lt;/tns:result>&#xa;                                &lt;/tns:OutputRestLocalizzatore>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
