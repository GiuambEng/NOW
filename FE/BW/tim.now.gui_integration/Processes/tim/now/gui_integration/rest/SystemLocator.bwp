PROFILE FLAT'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPSpecialProfileFlat'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP SPECIAL PROFILE LITE'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPSpecialProfileLite'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULL LINEA ATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULLLineaAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='WLR LINEA NON ATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'WLRLineaNonAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='WLR LINEA ATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'WLRLineaAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULL LINEA ATTIVA NP'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULLLineaAttivaNP'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULL DATI LINEA ATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULLDatiLineaAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULL DATI LINEA ATTIVA NP'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULLDatiLineaAttivaNP'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='VULL'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'Vull'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='VULL LINEA NON ATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VULLLineaNonAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SHA SENZA MANODOPERA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SHASenzaManoDopera'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SHA CON MANODOPERA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SHAConManoDopera'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SLU LINEA ATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SLULineaAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SLU LINEA ATTIVA NP'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SLULineaAttivaNP'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='BITSTREAM ATM SIMMETRICO FLAT'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoFlat'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='BITSTREAM ATM SIMMETRICO HL'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoHL'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='BITSTREAM GBE SIMMETRICO FLAT'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamGBESimmetricoFlat'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP NGA FTTCAB'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;&amp;quot;EasyIPUBBFTTCAB&amp;quot;&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP NGA FTTH'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;&amp;quot;EasyIPUBBFTTH&amp;quot;&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='NP'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'NP'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;$post/item/tns:InputRestLocalizzatore/tns:Servizio&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Servizio"
                                    name="TrascodificaOfferta"
                                    outputVariable="Servizio"
                                    tibex:xpdlId="aee1d5e4-e67c-4684-944a-35c75e1ff714" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RecuperoCodOloToTrascodificaOfferta"/>
                                    <bpws:target linkName="JDBCQueryToTrascodificaOfferta"/>
                                    <bpws:target linkName="JDBCQueryToTrascodificaOfferta1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="TrascodificaOffertaToGetSystem"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Localizzatore&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;CessazioneWLR&quot;/>&#xa;    &lt;xsl:template name=&quot;Servizio&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;upper-case($post.item/tns:Lavorazione)='CESSAZIONE'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio) = (&amp;quot;WLR LINEA NON ATTIVA&amp;quot;,&amp;quot;WLRLINEANONATTIVA&amp;quot;) or $CessazioneWLR/Record[OFFERTA = &amp;quot;WLRLINEANONATTIVA&amp;quot;]/IDOFFERTA = 22&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'CessazioneWLRLineaNonAttiva'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM NGA FTTCAB','BITSTREAMNGAFTTCAB')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamNGAFTTCAB'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM NGA FTTH','BITSTREAMNGAFTTH')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamNGAFTTH'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('VULA FTTCAB','VULAFTTCAB')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VULAFTTCAB'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('VULA FTTH','VULAFTTH')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('WLR LINEA ATTIVA','WLRLINEAATTIVA') or $CessazioneWLR/Record[OFFERTA = 'WLRLINEAATTIVA']/IDOFFERTA = 25&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'CessazioneWLRLineaAttiva'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO FLAT','BITSTREAMATMASIMMETRICOFLAT')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM ATM SIMMETRICO FLAT','BITSTREAMATMSIMMETRICOFLAT')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO HL','BITSTREAMATMASIMMETRICOHL')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoHL'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM ATM SIMMETRICO HL','BITSTREAMATMSIMMETRICOHL')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoHL'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO LITE','BITSTREAMATMASIMMETRICOLITE')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoLite'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM GBE ASIMMETRICO FLAT','BITSTREAMGBEASIMMETRICOFLAT')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamGBEAsimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM GBE SIMMETRICO FLAT','BITSTREAMGBESIMMETRICOFLAT')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamGBESimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('EASYIP BASE PLUS FLAT','EASYIPBASEPLUSFLAT')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPBasePlusFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('EASYIP BASE PLUS LITE','EASYIPBASEPLUSLITE')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPBasePlusLite'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('EASYIP SPECIAL PROFILE FLAT','EASYIPSPECIALPROFILEFLAT')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPSpecialProfileFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('EASYIP SPECIAL PROFILE LITE','EASYIPSPECIALPROFILELITE')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPSpecialProfileLite'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP NGA FTTCAB' or upper-case($post.item/tns:Servizio)='EASYIPNGAFTTCAB'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP NGA FTTH' or upper-case($post.item/tns:Servizio)='EASYIPNGAFTTH'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='VULL'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'Vull'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('ULL LINEA NON ATTIVA','ULLLINEANONATTIVA') or upper-case($post.item/tns:Servizio)=('ULL LINEA ATTIVA','ULLLINEAATTIVA')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'ULL'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('ULL LINEA ATTIVA NP','ULLLINEAATTIVANP')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'ULL-NP'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='SHA' or upper-case($post.item/tns:Servizio)='SHA CON MANODOPERA' or upper-case($post.item/tns:Servizio)='SHA SENZA MANODOPERA' or  upper-case($post.item/tns:Servizio)='SHARED ACCESS' or upper-case($post.item/tns:Servizio)='SHACONMANODOPERA' or upper-case($post.item/tns:Servizio)='SHASENZAMANODOPERA' or  upper-case($post.item/tns:Servizio)='SHAREDACCESS'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'SharedAccess'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='ULL DATI LINEA NON ATTIVA' or upper-case($post.item/tns:Servizio)='ULL DATI LINEA ATTIVA' or upper-case($post.item/tns:Servizio)='ULLDATILINEANONATTIVA' or upper-case($post.item/tns:Servizio)='ULLDATILINEAATTIVA'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'ULLDati'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('ULL DATI LINEA ATTIVA NP','ULLDATILINEAATTIVANP')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'ULLDati-NP'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='SLU LINEA NON ATTIVA' or upper-case($post.item/tns:Servizio)='SLU LINEA ATTIVA' or upper-case($post.item/tns:Servizio)='SLULINEANONATTIVA' or upper-case($post.item/tns:Servizio)='SLULINEAATTIVA'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'SLU'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('SLU LINEA ATTIVA NP','SLULINEAATTIVANP')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'SLU-NP'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:Servizio&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;upper-case($post.item/tns:Lavorazione)='MIGRAZIONE'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('ULL','ULL LINEA NON ATTIVA','ULL LINEA ATTIVA','ULL LINEA ATTIVA NP')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'Ull'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('ULLDATI','ULL DATI LINEA NON ATTIVA','ULL DATI LINEA ATTIVA','ULL DATI LINEA ATTIVA NP')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'UllDati'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('SLU','SLU LINEA NON ATTIVA','SLU LINEA ATTIVA','SLU LINEA ATTIVA NP')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'SLU'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('SHA CON MANODOPERA','SHA SENZA MANODOPERA','SHARED ACCESS')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'SharedAccess'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('VULL','VULL LINEA NON ATTIVA')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'Vull'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('WLR','WLR LINEA ATTIVA','WLR LINEA NON ATTIVA')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'WLR'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM NGA FTTCAB'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamNGAFTTCAB'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM NGA FTTH'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamNGAFTTH'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='VULA FTTCAB'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VULAFTTCAB'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='VULA FTTH'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM ASIMMETRICO FLAT'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM SIMMETRICO FLAT'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM ASIMMETRICO HL'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoHL'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM SIMMETRICO HL'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoHL'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM ASIMMETRICO LITE'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoLite'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM GBE ASIMMETRICO FLAT'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamGBEAsimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM GBE SIMMETRICO FLAT'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamGBESimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP BASE PLUS FLAT'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPBasePlusFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP BASE PLUS LITE'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPBasePlusLite'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP SPECIAL PROFILE FLAT'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPSpecialProfileFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP SPECIAL PROFILE LITE'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPSpecialProfileLite'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP NGA FTTCAB'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP NGA FTTH'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:Servizio&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;upper-case($post.item/tns:Lavorazione)='VARIAZIONE'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO FLAT') or upper-case($post.item/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO HL') or upper-case($post.item/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO LITE')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimm'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM ATM SIMMETRICO FLAT') or upper-case($post.item/tns:Servizio)=('BITSTREAM ATM SIMMETRICO HL')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMSimm'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM GBE ASIMMETRICO FLAT')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamGBEAsimm'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('BITSTREAM GBE SIMMETRICO FLAT')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamGBESimm'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('SLU','SLU LINEA NON ATTIVA','SLU LINEA ATTIVA','SLU LINEA ATTIVA NP')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VariazioneSLU'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('ULL','ULL LINEA NON ATTIVA','ULL LINEA ATTIVA','ULL LINEA ATTIVA NP','ULL DATI LINEA ATTIVA NP','ULL DATI','ULL DATI LINEA NON ATTIVA','ULL DATI LINEA ATTIVA')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VariazioneULL'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('WLR','WLR LINEA NON ATTIVA','WLR LINEA ATTIVA')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VariazioneWLR'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM NGA FTTCAB'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamNGAFTTCAB'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM NGA FTTH'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamNGAFTTH'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='VULA FTTCAB'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VULAFTTCAB'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='VULA FTTH'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('EASYIP BASE PLUS FLAT','EASYIP BASE PLUS LITE')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPBasePlus'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('EASYIP SPECIAL PROFILE FLAT','EASYIP SPECIAL PROFILE LITE')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPSpecialProfile'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP NGA FTTCAB' or upper-case($post.item/tns:Servizio)='EASYIPNGAFTTCAB'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;EasyIPUBBFTTCAB&amp;quot;&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP NGA FTTH' or upper-case($post.item/tns:Servizio)='EASYIPNGAFTTH'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;EasyIPUBBFTTH&amp;quot;&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)=('SHA SENZA MANODOPERA','SHA CON MANODOPERA')&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VariazioneULL'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:Servizio&quot;/>&#xa;      