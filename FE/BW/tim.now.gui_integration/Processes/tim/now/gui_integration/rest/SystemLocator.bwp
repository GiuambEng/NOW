                            <bpws:invoke inputVariable="GetSystem-input"
                                name="GetSystem" operation="GetSystem"
                                outputVariable="GetSystem"
                                partnerLink="SystemLocatorPortType"
                                portType="ns1:SystemLocatorPortType" tibex:xpdlId="9973c141-a9b1-4ca0-acb9-9531cc446b4a">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/rest/Localizzatore" xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/SystemLocator/" xmlns:ns011="http://www.tim.com/NOW/xsd/SystemLocatorInterface/" version="2.0"&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="RecuperoCodOlo"/&gt;
    &lt;xsl:param name="Servizio"/&gt;
    &lt;xsl:param name="GetCodIstat"/&gt;
    &lt;xsl:template name="GetSystem-input" match="/"&gt;
        &lt;ns:GetSystemRequest&gt;
            &lt;RichiestaLocalizzatore&gt;
                &lt;ns011:RichiestaLocalizzatore&gt;
                    &lt;ns011:Testata&gt;
                        &lt;ns011:Transaction_id&gt;
                            &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:Transaction_Id"/&gt;
                        &lt;/ns011:Transaction_id&gt;
                        &lt;ns011:Transaction_date&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns011:Transaction_date&gt;
                        &lt;ns011:Sistema_origine&gt;
                            &lt;xsl:value-of select="&amp;quot;NOWDISAMB&amp;quot;"/&gt;
                        &lt;/ns011:Sistema_origine&gt;
                    &lt;/ns011:Testata&gt;
                    &lt;ns011:Richiesta&gt;
                        &lt;ns011:DataRichiesta&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns011:DataRichiesta&gt;
                        &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:CodiceOLO"&gt;
                            &lt;ns011:CodiceOLO&gt;
                                &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:CodiceOLO"/&gt;
                            &lt;/ns011:CodiceOLO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$RecuperoCodOlo/Record[1]/COD_OLO"&gt;
                            &lt;ns011:CodiceISP&gt;
                                &lt;xsl:value-of select="$RecuperoCodOlo/Record[1]/COD_OLO"/&gt;
                            &lt;/ns011:CodiceISP&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($GetCodIstat/Record[FLAG_COMUNE = 'S']/COD_ISTAT_COMUNE) and string-length($GetCodIstat/Record[FLAG_COMUNE = 'S']/COD_ISTAT_COMUNE)&gt;0"&gt;
                                &lt;xsl:if test="$GetCodIstat/Record[FLAG_COMUNE = 'S']/COD_ISTAT_COMUNE"&gt;
                                    &lt;ns011:CodiceComune&gt;
                                        &lt;xsl:value-of select="$GetCodIstat/Record[FLAG_COMUNE = 'S']/COD_ISTAT_COMUNE"/&gt;
                                    &lt;/ns011:CodiceComune&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;ns011:CodiceComune&gt;
                                    &lt;xsl:value-of select="substring(($post/item/tns:InputRestLocalizzatore/tns:CodiceComune), (string-length($post/item/tns:InputRestLocalizzatore/tns:CodiceComune) -5), 6)"/&gt;
                                &lt;/ns011:CodiceComune&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;ns011:Servizio&gt;
                            &lt;xsl:value-of select="$Servizio"/&gt;
                        &lt;/ns011:Servizio&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="upper-case($post/item/tns:InputRestLocalizzatore/tns:Lavorazione)='ATTIVAZIONE'"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="$post/item/tns:InputRestLocalizzatore/tns:tipoLinea='LineaNonFonia' and $post/item/tns:InputRestLocalizzatore/tns:Servizio=('BITSTREAMATMASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMGBEASIMMETRICOFLAT', 'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH')"&gt;
                                        &lt;ns011:FlagNaked&gt;
                                            &lt;xsl:value-of select="&amp;quot;S&amp;quot;"/&gt;
                                        &lt;/ns011:FlagNaked&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:when test="$post/item/tns:InputRestLocalizzatore/tns:tipoLinea!='LineaNonFonia' and $post/item/tns:InputRestLocalizzatore/tns:Servizio=('BITSTREAMATMASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMGBEASIMMETRICOFLAT', 'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH')"&gt;
                                        &lt;ns011:FlagNaked&gt;
                                            &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                                        &lt;/ns011:FlagNaked&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;ns011:FlagNaked&gt;
                                            &lt;xsl:value-of select="&amp;quot;&amp;quot;"/&gt;
                                        &lt;/ns011:FlagNaked&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;ns011:FlagNaked&gt;
                                    &lt;xsl:value-of select="&amp;quot;&amp;quot;"/&gt;
                                &lt;/ns011:FlagNaked&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:Lavorazione"&gt;
                            &lt;ns011:Richiesta&gt;
                                &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:Lavorazione"/&gt;
                            &lt;/ns011:Richiesta&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:sottolavorazione"&gt;
                            &lt;ns011:Sottolavorazione&gt;
                                &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:sottolavorazione"/&gt;
                            &lt;/ns011:Sottolavorazione&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:Lavorazione !='INTERRUZIONEMIGRAZIONE'"&gt;
                            &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:CodiceOrdineRiferimentoTI"&gt;
                                &lt;ns011:CodiceOrdineRiferimentoTI&gt;
                                    &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:CodiceOrdineRiferimentoTI"/&gt;
                                &lt;/ns011:CodiceOrdineRiferimentoTI&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$post/item/tns:InputRestLocalizzatore/tns:Lavorazione = 'INTERRUZIONEMIGRAZIONE'"&gt;
                                &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:CodiceOrdineRiferimentoTI"&gt;
                                    &lt;ns011:CodiceOrdineRiferimentoOLO&gt;
                                        &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:CodiceOrdineRiferimentoTI"/&gt;
                                    &lt;/ns011:CodiceOrdineRiferimentoOLO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:CodiceOrdineOlo"&gt;
                                    &lt;ns011:CodiceOrdineRiferimentoOLO&gt;
                                        &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:CodiceOrdineOlo"/&gt;
                                    &lt;/ns011:CodiceOrdineRiferimentoOLO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:IdRisorsa"&gt;
                            &lt;ns011:IdRisorsa&gt;
                                &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:IdRisorsa"/&gt;
                            &lt;/ns011:IdRisorsa&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="upper-case($post/item/tns:InputRestLocalizzatore/tns:Lavorazione)='CESSAZIONE' and $post/item/tns:InputRestLocalizzatore/tns:rientro='SI'"&gt;
                            &lt;ns011:Rientro_TI&gt;
                                &lt;xsl:value-of select="&amp;quot;1&amp;quot;"/&gt;
                            &lt;/ns011:Rientro_TI&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:IdRisorsa2"&gt;
                            &lt;ns011:IdRisorsa2&gt;
                                &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:IdRisorsa2"/&gt;
                            &lt;/ns011:IdRisorsa2&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$post/item/tns:InputRestLocalizzatore/tns:tipoLinea = ('POTS', 'ISDN') and (contains($post/item/tns:InputRestLocalizzatore/tns:Servizio, &amp;quot;BITSTREAM&amp;quot;) or contains($post/item/tns:InputRestLocalizzatore/tns:Servizio, &amp;quot;EASYIP&amp;quot;) or contains($post/item/tns:InputRestLocalizzatore/tns:Servizio, &amp;quot;VULA&amp;quot;))"&gt;
                                &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:numeroLinea"&gt;
                                    &lt;ns011:Telefonico&gt;
                                        &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:numeroLinea"/&gt;
                                    &lt;/ns011:Telefonico&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:DN"&gt;
                                    &lt;ns011:Telefonico&gt;
                                        &lt;xsl:value-of select="$post/item/tns:InputRestLocalizzatore/tns:DN"/&gt;
                                    &lt;/ns011:Telefonico&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;ns011:DNAggiuntivi&gt;
                            &lt;xsl:for-each select="$post/item/tns:InputRestLocalizzatore/tns:DNAggiuntivi"&gt;
                                &lt;ns011:DN&gt;
                                    &lt;xsl:value-of select="."/&gt;
                                &lt;/ns011:DN&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/ns011:DNAggiuntivi&gt;
                        &lt;xsl:if test="$post/item/tns:InputRestLocalizzatore/tns:tipologiaAccesso = ('9','11') and $post/item/tns:InputRestLocalizzatore/tns:CodiceOLO !=&amp;quot;TLC&amp;quot;"&gt;
                            &lt;ns011:CodiceCambioTipologia&gt;
                                &lt;xsl:value-of select="&amp;quot;CRMWS&amp;quot;"/&gt;
                            &lt;/ns011:CodiceCambioTipologia&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns011:Richiesta&gt;
                &lt;/ns011:RichiestaLocalizzatore&gt;
            &lt;/RichiestaLocalizzatore&gt;
        &lt;/ns:GetSystemRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Localizzatore&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/abstract/SystemLocator/&quot; xmlns:ns011=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoCodOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;Servizio&quot;/>&#xa;    &lt;xsl:param name=&quot;GetCodIstat&quot;/>&#xa;    &lt;xsl:template name=&quot;GetSystem-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns011:RichiestaLocalizzatore>&#xa;            &lt;ns011:Testata>&#xa;                &lt;ns011:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:Transaction_Id&quot;/>&#xa;                &lt;/ns011:Transaction_id>&#xa;                &lt;ns011:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns011:Transaction_date>&#xa;                &lt;ns011:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOWDISAMB&amp;quot;&quot;/>&#xa;                &lt;/ns011:Sistema_origine>&#xa;            &lt;/ns011:Testata>&#xa;            &lt;ns011:Richiesta>&#xa;                &lt;ns011:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns011:DataRichiesta>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:CodiceOLO&quot;>&#xa;                    &lt;ns011:CodiceOLO>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:CodiceOLO&quot;/>&#xa;                    &lt;/ns011:CodiceOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RecuperoCodOlo/Record[1]/COD_OLO&quot;>&#xa;                    &lt;ns011:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoCodOlo/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns011:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GetCodIstat/Record[FLAG_COMUNE = 'S']/COD_ISTAT_COMUNE) and string-length($GetCodIstat/Record[FLAG_COMUNE = 'S']/COD_ISTAT_COMUNE)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$GetCodIstat/Record[FLAG_COMUNE = 'S']/COD_ISTAT_COMUNE&quot;>&#xa;                            &lt;ns011:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;$GetCodIstat/Record[FLAG_COMUNE = 'S']/COD_ISTAT_COMUNE&quot;/>&#xa;                            &lt;/ns011:CodiceComune>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns011:CodiceComune>&#xa;                            &lt;xsl:value-of select=&quot;substring(($post.item/tns:CodiceComune), (string-length($post.item/tns:CodiceComune) -5), 6)&quot;/>&#xa;                        &lt;/ns011:CodiceComune>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns011:Servizio>&#xa;                    &lt;xsl:value-of select=&quot;$Servizio&quot;/>&#xa;                &lt;/ns011:Servizio>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Lavorazione)='ATTIVAZIONE'&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$post.item/tns:tipoLinea='LineaNonFonia' and $post.item/tns:Servizio=('BITSTREAMATMASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMGBEASIMMETRICOFLAT', 'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH')&quot;>&#xa;                                &lt;ns011:FlagNaked>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                                &lt;/ns011:FlagNaked>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$post.item/tns:tipoLinea!='LineaNonFonia' and $post.item/tns:Servizio=('BITSTREAMATMASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMGBEASIMMETRICOFLAT', 'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE','BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH')&quot;>&#xa;                                &lt;ns011:FlagNaked>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                &lt;/ns011:FlagNaked>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns011:FlagNaked>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/ns011:FlagNaked>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns011:FlagNaked>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/ns011:FlagNaked>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:Lavorazione&quot;>&#xa;                    &lt;ns011:Richiesta>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:Lavorazione&quot;/>&#xa;                    &lt;/ns011:Richiesta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:sottolavorazione&quot;>&#xa;                    &lt;ns011:Sottolavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:sottolavorazione&quot;/>&#xa;                    &lt;/ns011:Sottolavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:Lavorazione !='INTERRUZIONEMIGRAZIONE'&quot;>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:CodiceOrdineRiferimentoTI&quot;>&#xa;                        &lt;ns011:CodiceOrdineRiferimentoTI>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:CodiceOrdineRiferimentoTI&quot;/>&#xa;                        &lt;/ns011:CodiceOrdineRiferimentoTI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$post.item/tns:Lavorazione = 'INTERRUZIONEMIGRAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$post.item/tns:CodiceOrdineRiferimentoTI&quot;>&#xa;                            &lt;ns011:CodiceOrdineRiferimentoOLO>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:CodiceOrdineRiferimentoTI&quot;/>&#xa;                            &lt;/ns011:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$post.item/tns:CodiceOrdineOlo&quot;>&#xa;                            &lt;ns011:CodiceOrdineRiferimentoOLO>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:CodiceOrdineOlo&quot;/>&#xa;                            &lt;/ns011:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:IdRisorsa&quot;>&#xa;                    &lt;ns011:IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:IdRisorsa&quot;/>&#xa;                    &lt;/ns011:IdRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;upper-case($post.item/tns:Lavorazione)='CESSAZIONE' and $post.item/tns:rientro='SI'&quot;>&#xa;                    &lt;ns011:Rientro_TI>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/ns011:Rientro_TI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:IdRisorsa2&quot;>&#xa;                    &lt;ns011:IdRisorsa2>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns:IdRisorsa2&quot;/>&#xa;                    &lt;/ns011:IdRisorsa2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$post.item/tns:tipoLinea = ('POTS', 'ISDN') and (contains($post.item/tns:Servizio, &amp;quot;BITSTREAM&amp;quot;) or contains($post.item/tns:Servizio, &amp;quot;EASYIP&amp;quot;) or contains($post.item/tns:Servizio, &amp;quot;VULA&amp;quot;))&quot;>&#xa;                        &lt;xsl:if test=&quot;$post.item/tns:numeroLinea&quot;>&#xa;                            &lt;ns011:Telefonico>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:numeroLinea&quot;/>&#xa;                            &lt;/ns011:Telefonico>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$post.item/tns:DN&quot;>&#xa;                            &lt;ns011:Telefonico>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns:DN&quot;/>&#xa;                            &lt;/ns011:Telefonico>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns011:DNAggiuntivi>&#xa;                    &lt;xsl:for-each select=&quot;$post.item/tns:DNAggiuntivi&quot;>&#xa;                        &lt;ns011:DN>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns011:DN>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/ns011:DNAggiuntivi>&#xa;                &lt;xsl:if test=&quot;$post.item/tns:tipologiaAccesso = ('9','11') and $post.item/tns:CodiceOLO !=&amp;quot;TLC&amp;quot;&quot;>&#xa;                    &lt;ns011:CodiceCambioTipologia>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                    &lt;/ns011:CodiceCambioTipologia>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns011:Richiesta>&#xa;        &lt;/ns011:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="TrascodificaOffertaToGetSystem"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="GetSystemToAssign"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/Localizzatore&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;CessazioneWLR&quot;/>&lt;xsl:template name=&quot;Servizio&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Lavorazione)='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio) = (&amp;quot;WLR LINEA NON ATTIVA&amp;quot;,&amp;quot;WLRLINEANONATTIVA&amp;quot;) or $CessazioneWLR/Record[OFFERTA = &amp;quot;WLRLINEANONATTIVA&amp;quot;]/IDOFFERTA = 22&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'CessazioneWLRLineaNonAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM NGA FTTCAB','BITSTREAMNGAFTTCAB')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamNGAFTTCAB'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM NGA FTTH','BITSTREAMNGAFTTH')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamNGAFTTH'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('VULA FTTCAB','VULAFTTCAB')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VULAFTTCAB'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('VULA FTTH','VULAFTTH')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('WLR LINEA ATTIVA','WLRLINEAATTIVA') or $CessazioneWLR/Record[OFFERTA = 'WLRLINEAATTIVA']/IDOFFERTA = 25&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'CessazioneWLRLineaAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO FLAT','BITSTREAMATMASIMMETRICOFLAT')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoFlat'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM SIMMETRICO FLAT','BITSTREAMATMSIMMETRICOFLAT')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoFlat'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO HL','BITSTREAMATMASIMMETRICOHL')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoHL'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM SIMMETRICO HL','BITSTREAMATMSIMMETRICOHL')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoHL'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO LITE','BITSTREAMATMASIMMETRICOLITE')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoLite'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM GBE ASIMMETRICO FLAT','BITSTREAMGBEASIMMETRICOFLAT')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'Bitstream