                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerInfo&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:template name=&quot;get_SystemLocator_out_Log-input&quot; match=&quot;/&quot;>&lt;tns5:CW_BUS_MESSAGE>&lt;tns5:GenericLogger>&lt;tns5:Process>&lt;xsl:value-of select=&quot;&amp;quot;SystemLocator&amp;quot;&quot;/>&lt;/tns5:Process>&lt;tns5:Service>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.SystemLocator&amp;quot;&quot;/>&lt;/tns5:Service>&lt;tns5:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns5:Operation>&lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;>&lt;tns5:BusinessID>&lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;/>&lt;/tns5:BusinessID>&lt;/xsl:if>&lt;tns5:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output ParseJSON : &amp;quot; ,string($ParseJSON))&quot;/>&lt;/tns5:Payload>&lt;tns5:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns5:LoggerName>&lt;tns5:LogLevel>&lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&lt;/tns5:LogLevel>&lt;tns5:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns5:LogJMS>&lt;/tns5:GenericLogger>&lt;tns5:ActiveLoggerServices>&lt;tns5:Envelope>&lt;tns5:Identifier>&lt;tns5:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.SystemLocator&amp;quot;&quot;/>&lt;/tns5:ServiceName>&lt;tns5:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns5:Operation>&lt;tns5:Source>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/tns5:Source>&lt;xsl