        &lt;xsl:value-of select=&quot;'Vull'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='VULL LINEA NON ATTIVA'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VULLLineaNonAttiva'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='SHA SENZA MANODOPERA'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'SHASenzaManoDopera'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='SHA CON MANODOPERA'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'SHAConManoDopera'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='SLU LINEA ATTIVA'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'SLULineaAttiva'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='SLU LINEA ATTIVA NP'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'SLULineaAttivaNP'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM SIMMETRICO FLAT'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM SIMMETRICO HL'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMSimmetricoHL'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM GBE SIMMETRICO FLAT'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamGBESimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP NGA FTTCAB'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;EasyIPUBBFTTCAB&amp;quot;&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='EASYIP NGA FTTH'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;EasyIPUBBFTTH&amp;quot;&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='NP'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'NP'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:Servizio&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
