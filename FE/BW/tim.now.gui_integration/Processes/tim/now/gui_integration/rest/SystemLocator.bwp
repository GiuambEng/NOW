             &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='VULA FTTCAB'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VULAFTTCAB'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='VULA FTTH'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM ASIMMETRICO FLAT'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoFlat'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM ASIMMETRICO HL'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoHL'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM ATM ASIMMETRICO LITE'&quot;>&#xa;                        &lt;tns:TrascodificaOfferta>&#xa;                            &lt;xsl:value-of select=&quot;'BitstreamATMAsimmetricoLite'&quot;/>&#xa;                        &lt;/tns:TrascodificaOfferta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($post.item/tns:Servizio)='BITSTREAM GBE ASIMMETRICO FLAT'&quot;>&#xa;                        &lt;tns:Tr