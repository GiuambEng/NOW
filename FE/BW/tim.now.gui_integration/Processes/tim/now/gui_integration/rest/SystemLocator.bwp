tns:Servizio)='EASYIP BASE PLUS FLAT'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPBasePlusFlat'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP BASE PLUS LITE'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPBasePlusLite'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP SPECIAL PROFILE FLAT'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPSpecialProfileFlat'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP SPECIAL PROFILE LITE'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPSpecialProfileLite'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP NGA FTTCAB'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP NGA FTTH'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;$post/item/tns:InputRestLocalizzatore/tns:Servizio&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Lavorazione)='VARIAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO FLAT') or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO HL') or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM ASIMMETRICO LITE')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamATMAsimm'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM SIMMETRICO FLAT') or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM ATM SIMMETRICO HL')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamATMSimm'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM GBE ASIMMETRICO FLAT')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamGBEAsimm'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('BITSTREAM GBE SIMMETRICO FLAT')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamGBESimm'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('SLU','SLU LINEA NON ATTIVA','SLU LINEA ATTIVA','SLU LINEA ATTIVA NP')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VariazioneSLU'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('ULL','ULL LINEA NON ATTIVA','ULL LINEA ATTIVA','ULL LINEA ATTIVA NP','ULL DATI LINEA ATTIVA NP','ULL DATI','ULL DATI LINEA NON ATTIVA','ULL DATI LINEA ATTIVA')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VariazioneULL'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('WLR','WLR LINEA NON ATTIVA','WLR LINEA ATTIVA')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VariazioneWLR'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='BITSTREAM NGA FTTCAB'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamNGAFTTCAB'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='BITSTREAM NGA FTTH'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamNGAFTTH'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='VULA FTTCAB'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VULAFTTCAB'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='VULA FTTH'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('EASYIP BASE PLUS FLAT','EASYIP BASE PLUS LITE')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPBasePlus'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('EASYIP SPECIAL PROFILE FLAT','EASYIP SPECIAL PROFILE LITE')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPSpecialProfile'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP NGA FTTCAB' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIPNGAFTTCAB'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;&amp;quot;EasyIPUBBFTTCAB&amp;quot;&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIP NGA FTTH' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='EASYIPNGAFTTH'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;&amp;quot;EasyIPUBBFTTH&amp;quot;&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('SHA SENZA MANODOPERA','SHA CON MANODOPERA')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VariazioneULL'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;$post/item/tns:InputRestLocalizzatore/tns:Servizio&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULL LINEA NON ATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULLLineaNonAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULL DATI LINEA NON ATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULLDatiLineaNonAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SLU LINEA NON ATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SLULineaNonAttiva'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='BITSTREAM NGA FTTCAB'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamNGAFTTCAB'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='BITSTREAM NGA FTTH'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamNGAFTTH'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='VULA FTTCAB