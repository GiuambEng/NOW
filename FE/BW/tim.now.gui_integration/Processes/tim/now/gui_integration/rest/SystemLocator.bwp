rascodificaOfferta>&lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='VULL'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'Vull'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('ULL LINEA NON ATTIVA','ULLLINEANONATTIVA') or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('ULL LINEA ATTIVA','ULLLINEAATTIVA')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULL'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('ULL LINEA ATTIVA NP','ULLLINEAATTIVANP')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULL-NP'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SHA' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SHA CON MANODOPERA' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SHA SENZA MANODOPERA' or  upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SHARED ACCESS' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SHACONMANODOPERA' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SHASENZAMANODOPERA' or  upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SHAREDACCESS'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SharedAccess'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULL DATI LINEA NON ATTIVA' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULL DATI LINEA ATTIVA' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULLDATILINEANONATTIVA' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='ULLDATILINEAATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULLDati'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('ULL DATI LINEA ATTIVA NP','ULLDATILINEAATTIVANP')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'ULLDati-NP'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SLU LINEA NON ATTIVA' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SLU LINEA ATTIVA' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SLULINEANONATTIVA' or upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='SLULINEAATTIVA'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SLU'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('SLU LINEA ATTIVA NP','SLULINEAATTIVANP')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SLU-NP'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;$post/item/tns:InputRestLocalizzatore/tns:Servizio&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Lavorazione)='MIGRAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('ULL','ULL LINEA NON ATTIVA','ULL LINEA ATTIVA','ULL LINEA ATTIVA NP')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'Ull'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('ULLDATI','ULL DATI LINEA NON ATTIVA','ULL DATI LINEA ATTIVA','ULL DATI LINEA ATTIVA NP')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'UllDati'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('SLU','SLU LINEA NON ATTIVA','SLU LINEA ATTIVA','SLU LINEA ATTIVA NP')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SLU'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('SHA CON MANODOPERA','SHA SENZA MANODOPERA','SHARED ACCESS')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'SharedAccess'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('VULL','VULL LINEA NON ATTIVA')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'Vull'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)=('WLR','WLR LINEA ATTIVA','WLR LINEA NON ATTIVA')&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'WLR'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='BITSTREAM NGA FTTCAB'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamNGAFTTCAB'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='BITSTREAM NGA FTTH'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'BitstreamNGAFTTH'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='VULA FTTCAB'&quot;>&lt;tns:TrascodificaOfferta>&lt;xsl:value-of select=&quot;'VULAFTTCAB'&quot;/>&lt;/tns:TrascodificaOfferta>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($post/item/tns:InputRestLocalizzatore/tns:Servizio)='VULA FTTH'&quot;>&lt;tns:TrascodificaOffert