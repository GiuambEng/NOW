                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RecuperoFileDownloadOlo-input"
                                    name="RecuperoFileDownloadOlo"
                                    outputVariable="RecuperoFileDownloadOlo"
                                    tibex:xpdlId="4d1575da-708a-457b-aae1-f17e9d9b928f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToRecuperoFileDownloadOlo"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoFileDownloadOloToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4d1575da-708a-457b-aae1-f17e9d9b928f+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/DeCryptoDownload&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DeCryptoDownload&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoAgcom&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoFileDownload-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;idFile>&#xa;                &lt;xsl:value-of select=&quot;$DeCryptoDownload/tns1:idFileDecriptato&quot;/>&#xa;            &lt;/idFile>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperoAgcom/Record[1]/CODFC_OLO_AGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoAgcom/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperoAgcom/Record[1]/CODFC_OLO_AGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoAgcom/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom1>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CF.CONTENUTO_FILE, CF.ID_CONTENUTO_FILE, CF.ID_FILE, FP.NOME_FILE&#xa;  FROM CONTENUTO_FILE CF&#xa;  JOIN FILE_PROCSTO FP ON FP.ID_FILE = CF.ID_FILE&#xa;  WHERE CF.ID_FILE IN ?&#xa;  AND FP.CODFC_OLO_AGCOM IN ( SELECT CODFC_OLO_AGCOM&#xa;    FROM OLO&#xa;    WHERE CODFC_OLO_AGCOM IN &#xa;    (SELECT CODFC_OLO_AGCOM&#xa;    FROM OLO&#xa;    WHERE COD_OLO = (SELECT COD_OLO&#xa;                     FROM OLO&#xa;                     WHERE CODFC_OLO_AGCOM = ?)) &#xa;OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM&#xa;                          FROM OLO&#xa;                          WHERE COD_OLO = (SELECT COD_OLO&#xa;                                           FROM OLO&#xa;                                           WHERE CODFC_OLO_AGCOM = ?)))&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idFile"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom1"/>
                                    <columnMetadata
                                    columnName="CONTENUTO_FILE"
                                    dataType="2004" typeName="BLOB"/>
                                    <columnMetadata
                                    columnName="ID_CONTENUTO_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160512102605PLT/ConceptSchema&quot; xmlns:tns1=&quot;http://www.example.org/DeCryptoDownload&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;DeCryptoDownload-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DeCryptoDownloadInput>&#xa;            &lt;tns1:idFileCriptato>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns2:downloadGetParameters/idFile&quot;/>&#xa;            &lt;/tns1:idFileCriptato>&#xa;        &lt;/tns1:DeCryptoDownloadInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="DeCryptoDownload-input"
                                    name="DeCryptoDownload"
                                    outputVariable="DeCryptoDownload"
                                    tibex:xpdlId="56fb4051-629d-4746-83b4-05bcfeab0529"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToDeCryptoDownload1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DeCryptoDownloadToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$SecoloOscurato/Record[1]/COUNT = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
