                                    sqlStatement="SELECT COUNT(*)&#xa;  FROM OSCURAMENTO_AGESP&#xa;  WHERE COD_AGESP = 'R58-20-1339' AND FLAG_OSCURMENTO = '1'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
