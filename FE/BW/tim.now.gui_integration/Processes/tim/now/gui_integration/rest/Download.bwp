                                portType="ns11:NOW_SECOLOPortType" tibex:xpdlId="5c41fc56-885e-4677-87a3-bd30ca02a73e">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tibco.com/NOW_SECOLO/" xmlns:tns2="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://xmlns.example.com/20160512102605PLT/ConceptSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="RecuperaTokenFile"/&gt;
    &lt;xsl:param name="get"/&gt;
    &lt;xsl:template name="Decode_token_NOWSecolo-input" match="/"&gt;
        &lt;tns3:Decode_token_NOWSecoloRequest&gt;
            &lt;Input&gt;
                &lt;tns2:RequestDecode_token&gt;
                    &lt;tns2:CodificaOLOAGCOM&gt;
                        &lt;xsl:value-of select="'XXX'"/&gt;
                    &lt;/tns2:CodificaOLOAGCOM&gt;
                    &lt;tns2:CodiceOrdineOLO&gt;
                        &lt;xsl:value-of select="'INSERTFILE'"/&gt;
                    &lt;/tns2:CodiceOrdineOLO&gt;
                    &lt;tns2:Funzione&gt;
                        &lt;xsl:value-of select="'DOWNGUIF'"/&gt;
                    &lt;/tns2:Funzione&gt;
                    &lt;tns2:ChiaveRiferimento&gt;
                        &lt;xsl:value-of select="xsd:string(tib:timestamp())"/&gt;
                    &lt;/tns2:ChiaveRiferimento&gt;
                    &lt;xsl:if test="$get/parameters/tns1:downloadGetParameters/userId"&gt;
                        &lt;tns2:Operatore&gt;
                            &lt;xsl:value-of select="$get/parameters/tns1:downloadGetParameters/userId"/&gt;
                        &lt;/tns2:Operatore&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$get/parameters/tns1:downloadGetParameters/ip"&gt;
                        &lt;tns2:IPClient&gt;
                            &lt;xsl:value-of select="$get/parameters/tns1:downloadGetParameters/ip"/&gt;
                        &lt;/tns2:IPClient&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$RecuperaTokenFile/Record[1]/TOKEN_FILE"&gt;
                        &lt;tns2:Token&gt;
                            &lt;xsl:value-of select="$RecuperaTokenFile/Record[1]/TOKEN_FILE"/&gt;
                        &lt;/tns2:Token&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns2:RequestDecode_token&gt;
            &lt;/Input&gt;
        &lt;/tns3:Decode_token_NOWSecoloRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/NOW_SECOLO/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160512102605PLT/ConceptSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaTokenFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Decode_token_NOWSecolo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RequestDecode_token>&#xa;            &lt;tns2:CodificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;'XXX'&quot;/>&#xa;            &lt;/tns2:CodificaOLOAGCOM>&#xa;            &lt;tns2:CodiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;'INSERTFILE'&quot;/>&#xa;            &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;tns2:Funzione>&#xa;                &lt;xsl:value-of select=&quot;'DOWNGUIF'&quot;/>&#xa;            &lt;/tns2:Funzione>&#xa;            &lt;tns2:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;xsd:string(tib:timestamp())&quot;/>&#xa;            &lt;/tns2:ChiaveRiferimento>&#xa;            &lt;xsl:if test=&quot;$get.parameters/userId&quot;>&#xa;                &lt;tns2:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$get.parameters/userId&quot;/>&#xa;                &lt;/tns2:Operatore>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$get.parameters/ip&quot;>&#xa;                &lt;tns2:IPClient>&#xa;                    &lt;xsl:value-of select=&quot;$get.parameters/ip&quot;/>&#xa;                &lt;/tns2:IPClient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperaTokenFile/Record[1]/TOKEN_FILE&quot;>&#xa;                &lt;tns2:Token>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperaTokenFile/Record[1]/TOKEN_FILE&quot;/>&#xa;                &lt;/tns2:Token>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:RequestDecode_token>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
