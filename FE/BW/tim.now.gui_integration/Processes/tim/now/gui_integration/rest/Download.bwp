    xmlns:ns17="http://www.tibco.com/namespaces/tnt/plugins/jdbc+e91e57d4-2ced-47d2-844d-d81258c13621+output"
    xmlns:ns2="http://www.example.org/DeCryptoDownload"
    xmlns:ns3="http://www.tim.com/NOW/cmf/GenericLogger"
    xmlns:ns4="http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions"
    xmlns:ns5="http://www.tibco.com/namespaces/tnt/plugins/jdbc+4d1575da-708a-457b-aae1-f17e9d9b928f+input"
