                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select U.COD_PROFILO, U.USERID, PC.CODFC_OLO_AGCOM&#xa;from UTENTE U&#xa;LEFT JOIN PORTAFOGLIO_CLIENTE PC ON U.USERID = PC.USERID&#xa;WHERE UPPER(U.USERID) = UPPER(?)&#xa;AND U.COD_PROFILO = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

