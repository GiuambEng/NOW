                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/VisualizzazioneExternalData&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;listaeventiof&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record)>0 or count($JDBCQuery1/Record)>0&quot;>&lt;tns3:outputEventiOpenFiber>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns3:outputEventiOF>&lt;tns3:verso>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns3:verso>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns3:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns3:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;IDTRANSAZIONE&quot;>&lt;tns3:idTransazione>&lt;xsl:value-of select=&quot;IDTRANSAZIONE&quot;/>&lt;/tns3:idTransazione>&lt;/xsl:if>&lt;tns3:timestampRichiesta>&lt;xsl:value-of select=&quot;TIMESTAMPRICHIESTA&quot;/>&lt;/tns3:timestampRichiesta>&lt;xsl:if test=&quot;CODICEORDINEOLOOF&quot;>&lt;tns3:codOrdineOloOF>&lt;xsl:value-of select=&quot;CODICEORDINEOLOOF&quot;/>&lt;/tns3:codOrdineOloOF>&lt;/xsl:if>&lt;tns3:statoStaging>&lt;xsl:value-of select=&quot;ID_STATO_ELAB_STAG&quot;/>&lt;/tns3:statoStaging>&lt;tns3:richiestaXml>&lt;xsl:value-of select=&quot;CONTENUTO_REQUEST&quot;/>&lt;/tns3:richiestaXml>&lt;xsl:if test=&quot;CONTENUTO_RESPONSE&quot;>&lt;tns3:rispostaXml>&lt;xsl:value-of select=&quot;CONTENUTO_RESPONSE&quot;/>&lt;/tns3:rispostaXml>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRIZIONEERRORE&quot;>&lt;tns3:descrizioneErrore>&lt;xsl:value-of select=&quot;DESCRIZIONEERRORE&quot;/>&lt;/tns3:descrizioneErrore>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&lt;tns3:codOrdineOlo>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns3:codOrdineOlo>&lt;/xsl:if>&lt;/tns3:outputEventiOF>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$JDBCQuery1/Record&quot;>&lt;tns3:outputEventiOF>&lt;tns3:verso>&lt;xsl:value-of select=&quot;'OUT'&quot;/>&lt;/tns3:verso>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns3:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns3:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;IDTRANSAZIONE&quot;>&lt;tns3:idTransazione>&lt;xsl:value-of select=&quot;IDTRANSAZIONE&quot;/>&lt;/tns3:idTransazione>&lt;/xsl:if>&lt;tns3:timestampRichiesta>&lt;xsl:value-of select=&quot;TIMESTAMPRICHIESTA&quot;/>&lt;/tns3:timestampRichiesta>&lt;xsl:if test=&quot;CODICEORDINEOLOOF&quot;>&lt;tns3:codOrdineOloOF>&lt;xsl:value-of select=&quot;CODICEORDINEOLOOF&quot;/>&lt;/tns3:codOrdineOloOF>&lt;/xsl:if>&lt;tns3:statoStaging>&lt;xsl:value-of select=&quot;ID_STATO_ELAB_STAG&quot;/>&lt;/tns3:statoStaging>&lt;tns3:richiestaXml>&lt;xsl:value-of select=&quot;CONTENUTO_REQUEST&quot;/>&lt;/tns3:richiestaXml>&lt;xsl:if test=&quot;CONTENUTO_RESPONSE&quot;>&lt;tns3:rispostaXml>&lt;xsl:value-of select=&quot;CONTENUTO_RESPONSE&quot;/>&lt;/tns3:rispostaXml>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRIZIONEERRORE&quot;>&lt;tns3:descrizioneErrore>&lt;xsl:value-of select=&quot;DESCRIZIONEERRORE&quot;/>&lt;/tns3:descrizioneErrore>&lt;/xsl:if>&lt;/tns3:outputEventiOF>&lt;/xsl:for-each>&lt;tns3:result>&lt;tns3:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns3:severity>&lt;tns3:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns3:code>&lt;/tns3:result>&lt;/tns3:outputEventiOpenFiber>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns3:outputEventiOpenFiber>&lt;tns3:result>&lt;tns3:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns3:severity>&lt;tns3:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns3:code>&lt;tns3:details>&lt;xsl:value-of select=&quot;'Nessun Record Trovato'&quot;/>&lt;/tns3:details>&lt;/tns3:result>&lt;/tns3:outputEventiOpenFiber>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
