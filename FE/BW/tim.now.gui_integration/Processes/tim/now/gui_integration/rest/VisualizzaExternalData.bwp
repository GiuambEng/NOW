s4:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns6:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get2/httpHeaders/tns4:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:EventType>&#xa;                        &lt;tns6:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get2/httpHeaders/tns4:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns6:trackID>&#xa;                    &lt;/tns6:Identifier>&#xa;                    &lt;tns6:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns6:track_position>&#xa;                    &lt;tns6:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns6:Timestamp>&#xa;                    &lt;tns6:ErrorLog/>&#xa;                &lt;/tns6:Envelope>&#xa;            &lt;/tns6:ActiveLoggerServices>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
