                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+26375a10-9603-4170-bbd6-dd70cff1727a+input&quot; xmlns:tns5=&quot;http://xmlns.example.com/VisualizzaExternalData/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Eventodtu-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;idrichiestaolo>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns5:idrichiestaolo&quot;/>&#xa;            &lt;/idrichiestaolo>&#xa;            &lt;idRichiestaOlo1>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns5:idrichiestaolo&quot;/>&#xa;            &lt;/idRichiestaOlo1>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement=" SELECT &#xa;  ED.ID_EVENTO_ORDN_NOW_WHLS AS ID_EVENTO_ORDN_NOW_WHLS_DTU ,&#xa;  ED.ID_RICH_DTU AS ID_RICH_DTU_D,&#xa;  ED.PROGRS_EVENTO_DTU,&#xa;  ED.DATA_INVIO_NOTF_XML_DA_DTU, &#xa;  TSED.STATO_EVENTO_DTU_GUI,&#xa;  EW.IDTPLG_EVENTO,TE.DESCR_EVENTO&#xa;    FROM&#xa;       EVENTO_ORDN_NOW_WHLS EW &#xa;       INNER JOIN EVENTO_DTU ED ON EW.ID_EVENTO_ORDN_NOW_WHLS = ED.ID_EVENTO_ORDN_NOW_WHLS AND EW.ID_RICH_OLO = ED.ID_RICH_OLO&#xa;       LEFT JOIN TIPOLG_EVENTO TE ON EW.IDTPLG_EVENTO = TE.IDTPLG_EVENTO&#xa;       LEFT JOIN TIPOLG_STATO_EVENTO_DTU TSED ON  ED.IDTPLG_STATO_EVENTO_DTU = TSED.IDTPLG_STATO_EVENTO_DTU&#xa;       LEFT JOIN SISTEMA SI ON EW.ID_SISTEMA_DESTNRIO=SI.ID_SISTEMA OR EW.ID_SISTEMA_MITTENTE=SI.ID_SISTEMA&#xa;  WHERE EW.ID_RICH_OLO = ? and ED.ID_RICH_OLO = ? AND SI.DESCR_SISTEMA_NOME_SISTEMA='DTU'&#xa;  ORDER BY ED.DATA_INVIO_NOTF_XML_DA_DTU DESC&#xa; " xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idrichiestaolo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo1"/>
                                    <columnMetadata
                                    columnName="ID_EVENTO_ORDN_NOW_WHLS_DTU"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_RICH_DTU_D"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROGRS_EVENTO_DTU"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATA_INVIO_NOTF_XML_DA_DTU"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STATO_EVENTO_DTU_GUI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDTPLG_EVENTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_EVENTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
