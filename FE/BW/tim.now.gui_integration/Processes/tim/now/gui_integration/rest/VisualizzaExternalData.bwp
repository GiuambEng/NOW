                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT JIN.TIMSTP_RICH,JIN.ID_ORDINE_COMPOSTO,JIN.ID_RICH_JPUB_RISPOSTE,JIN.CONTENUTO_REQUEST,JIN.FLAG_CONSUNTIVO,TS.DESCR&#xd;&#xa;FROM  STAG_JPUB_IN JIN&#xd;&#xa;LEFT JOIN TIPOLG_STATO_ELAB_STAG TS ON JIN.ID_STATO_ELAB_STAG =TS.ID_STATO_ELAB_STAG&#xd;&#xa;WHERE JIN.COD_ID_ORDN=?&#xd;&#xa;ORDER BY JIN.TIMSTP_RICH DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idrichiestaolo"/>
                                    <columnMetadata
                                    columnName="TIMSTP_RICH"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="ID_ORDINE_COMPOSTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RICH_JPUB_RISPOSTE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CONTENUTO_REQUEST"
                                    dataType="2005" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="FLAG_CONSUNTIVO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
