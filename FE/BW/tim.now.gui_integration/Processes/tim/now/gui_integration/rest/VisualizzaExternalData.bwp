                                    expression="contains($get3/parameters/tns:visualizzaexternaldata-dbcfxGetParameters/tns:tipoProfilo, $CRM_DG) or contains($get3/parameters/tns:visualizzaexternaldata-dbcfxGetParameters/tns:tipoProfilo, $CRM_PPS) or contains($get3/parameters/tns:visualizzaexternaldata-dbcfxGetParameters/tns:tipoProfilo, $CRM_MKTG) or contains($get3/parameters/tns:visualizzaexternaldata-dbcfxGetParameters/tns:tipoProfilo, $CRM_GA)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($get3.parameters/tns:tipoProfilo, $CRM_DG) or contains($get3.parameters/tns:tipoProfilo, $CRM_PPS) or contains($get3.parameters/tns:tipoProfilo, $CRM_MKTG) or contains($get3.parameters/tns:tipoProfilo, $CRM_GA)]]></bpws:transitionCondition>
