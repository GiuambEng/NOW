                                    <bpws:source linkName="ListaeventijpubAToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/VisualizzazioneExternalData&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://xmlns.example.com/VisualizzaExternalData/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_DG&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_PPS&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_GA&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_MKTG&quot;/>&#xa;    &lt;xsl:param name=&quot;JPUBQueryOUT&quot;/>&#xa;    &lt;xsl:param name=&quot;JPUBQueryIN&quot;/>&#xa;    &lt;xsl:template name=&quot;listaeventijpub&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($JPUBQueryIN/Record[1]/CONTENUTO_REQUEST)>0 or string-length($JPUBQueryOUT/Record[1]/CONTENUTO_REQUEST)>0&quot;>&#xa;                &lt;tns3:outputeventijpubrest>&#xa;                    &lt;xsl:for-each select=&quot;$JPUBQueryIN/Record&quot;>&#xa;                        &lt;tns3:outputeventijpub>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_RICH), &amp;quot;.&amp;quot;) and exists(TIMSTP_RICH) and string-length(xsd:string(TIMSTP_RICH))>0&quot;>&#xa;                                    &lt;tns3:dataRichiesta>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_RICH), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_RICH), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns3:dataRichiesta>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns3:dataRichiesta>&#xa;                                        &lt;xsl:value-of select=&quot;TIMSTP_RICH&quot;/>&#xa;                                    &lt;/tns3:dataRichiesta>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns3:verso>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                            &lt;/tns3:verso>&#xa;                            &lt;xsl:if test=&quot;ID_ORDINE_COMPOSTO&quot;>&#xa;                                &lt;tns3:identificativoOrdineComposto>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ORDINE_COMPOSTO&quot;/>&#xa;                                &lt;/tns3:identificativoOrdineComposto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(ID_RICH_JPUB_RISPOSTE)&quot;>&#xa;                                &lt;tns3:identificativoRichiestaJpub>&#xa;                                    &lt;xsl:value-of select=&quot;string(ID_RICH_JPUB_RISPOSTE)&quot;/>&#xa;                                &lt;/tns3:identificativoRichiestaJpub>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR&quot;>&#xa;                                &lt;tns3:statoElaborazioneStaging>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                                &lt;/tns3:statoElaborazioneStaging>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns3:contenutoXML>&#xa;                                &lt;xsl:value-of select=&quot;CONTENUTO_REQUEST&quot;/>&#xa;                            &lt;/tns3:contenutoXML>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_CONSUNTIVO='0'&quot;>&#xa;                                    &lt;tns3:flagConsuntivo>&#xa;                                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                    &lt;/tns3:flagConsuntivo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;FLAG_CONSUNTIVO='1'&quot;>&#xa;                                    &lt;tns3:flagConsuntivo>&#xa;                                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                    &lt;/tns3:flagConsuntivo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns3:flagConsuntivo>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_CONSUNTIVO&quot;/>&#xa;                                    &lt;/tns3:flagConsuntivo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns3:outputeventijpub>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;$JPUBQueryOUT/Record&quot;>&#xa;                        &lt;tns3:outputeventijpub>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_RICH), &amp;quot;.&amp;quot;) and exists(TIMSTP_RICH) and string-length(xsd:string(TIMSTP_RICH))>0&quot;>&#xa;                                    &lt;tns3:dataRichiesta>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_RICH), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_RICH), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns3:dataRichiesta>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns3:dataRichiesta>&#xa;                                        &lt;xsl:value-of select=&quot;TIMSTP_RICH&quot;/>&#xa;                                    &lt;/tns3:dataRichiesta>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns3:verso>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                            &lt;/tns3:verso>&#xa;                            &lt;xsl:if test=&quot;ID_ORDINE_COMPOSTO&quot;>&#xa;                                &lt;tns3:identificativoOrdineComposto>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ORDINE_COMPOSTO&quot;/>&#xa;                                &lt;/tns3:identificativoOrdineComposto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(ID_RICH_JPUB_RICH)&quot;>&#xa;                                &lt;tns3:identificativoRichiestaJpub>&#xa;                                    &lt;xsl:value-of select=&quot;string(ID_RICH_JPUB_RICH)&quot;/>&#xa;                                &lt;/tns3:identificativoRichiestaJpub>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR&quot;>&#xa;                                &lt;tns3:statoElaborazioneStaging>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                                &lt;/tns3:statoElaborazioneStaging>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns3:contenutoXML>&#xa;                                &lt;xsl:value-of select=&quot;CONTENUTO_REQUEST&quot;/>&#xa;                            &lt;/tns3:contenutoXML>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_CONSUNTIVO='0'&quot;>&#xa;                                    &lt;tns3:flagConsuntivo>&#xa;                                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                    &lt;/tns3:flagConsuntivo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;FLAG_CONSUNTIVO='1'&quot;>&#xa;                                    &lt;tns3:flagConsuntivo>&#xa;                                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                    &lt;/tns3:flagConsuntivo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns3:flagConsuntivo>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_CONSUNTIVO&quot;/>&#xa;                                    &lt;/tns3:flagConsuntivo>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns3:outputeventijpub>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputeventijpubrest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(contains($get1.parameters/tns5:tipoprofilo, $CRM_DG)  or contains($get1.parameters/tns5:tipoprofilo, $CRM_PPS) or  contains($get1.parameters/tns5:tipoprofilo, $CRM_GA ) or  contains($get1.parameters/tns5:tipoprofilo, $CRM_MKTG))=false()&quot;>&#xa;                &lt;tns3:outputeventijpubrest>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                        &lt;tns3:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PROFILO NON VALIDO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:details>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputeventijpubrest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:outputeventijpubrest>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                        &lt;tns3:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NO RECORD LISTA EVENTI JPUB&amp;quot;&quot;/>&#xa;                        &lt;/tns3:details>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputeventijpubrest>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
