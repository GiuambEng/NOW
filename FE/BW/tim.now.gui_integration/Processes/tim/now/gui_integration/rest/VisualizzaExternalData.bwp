lue-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:EventType>&#xa;                        &lt;tns6:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns6:trackID>&#xa;                    &lt;/tns6:Identifier>&#xa;                    &lt;tns6:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns6:track_position>&#xa;                    &lt;tns6:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns6:Timestamp>&#xa;                    &lt;tns6:ErrorLog>&#xa;                        &lt;tns6:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns6:TimeStamp>&#xa;                        &lt;tns6:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorEventiDtu&amp;quot;,'SID:',$get/httpHeaders/tns4:httpHeaders/GUI-SID,'TID:',$get/httpHeaders/tns4:httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns6:Descrizione>&#xa;                        &lt;tns6:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns6:Codice>&#xa;                        &lt;tns6:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns6:track_position>&#xa;                    &lt;/tns6:ErrorLog>&#xa;                &lt;/tns6:Envelope>&#xa;            &lt;/tns6:ActiveLoggerServices>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;