                                    <bpws:source linkName="get_eventidtu_InputLog_INFOToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($get/parameters/tns:visualizzaexternaldata-eventidtuGetParameters/tns:tipoprofilo, $CRM_DG)  or contains($get/parameters/tns:visualizzaexternaldata-eventidtuGetParameters/tns:tipoprofilo, $CRM_PPS) or  contains($get/parameters/tns:visualizzaexternaldata-eventidtuGetParameters/tns:tipoprofilo, $CRM_GA ) or  contains($get/parameters/tns:visualizzaexternaldata-eventidtuGetParameters/tns:tipoprofilo, $CRM_MKTG)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($get.parameters/tns:tipoprofilo, $CRM_DG)  or contains($get.parameters/tns:tipoprofilo, $CRM_PPS) or  contains($get.parameters/tns:tipoprofilo, $CRM_GA ) or  contains($get.parameters/tns:tipoprofilo, $CRM_MKTG)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
