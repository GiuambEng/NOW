                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT DVC.VALORE AS NUMEROAGGIUNTIVO, DVC1.VALORE AS DIREZIONALITA, DVC.PROGRS_TIPOLG_DATO&#xa;FROM DATI_VERIFICA_CTRLI DVC&#xa;JOIN DATI_VERIFICA_CTRLI DVC1 ON DVC1.ID_RICH_OLO = DVC.ID_RICH_OLO AND DVC1.TIPOLG_DATO = DVC.TIPOLG_DATO&#xa;WHERE DVC.ID_RICH_OLO = ? AND DVC.TIPOLG_DATO = '20' AND DVC.NOME = 'DN' AND DVC1.NOME = 'DIREZIONALITA'&#xa;ORDER BY DVC.PROGRS_TIPOLG_DATO&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>
                                    <columnMetadata
                                    columnName="NUMEROAGGIUNTIVO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DIREZIONALITA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROGRS_TIPOLG_DATO"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/VisualizzazioneExternalData&quot; xmlns:tns5=&quot;http://xmlns.example.com/VisualizzaExternalData/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperoAggiuntiviDbcfx&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_DG&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_PPS&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_MKTG&quot;/>&#xa;    &lt;xsl:param name=&quot;get3&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_GA&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiuntiviDbcfx&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($RecuperoAggiuntiviDbcfx/Record) >0&quot;>&#xa;                &lt;tns3:outputAggiuntiviDbcfx>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoAggiuntiviDbcfx/Record&quot;>&#xa;                        &lt;tns3:outputAggDbcfx>&#xa;                            &lt;tns3:numeroAggiuntivo>&#xa;                                &lt;xsl:value-of select=&quot;NUMEROAGGIUNTIVO&quot;/>&#xa;                            &lt;/tns3:numeroAggiuntivo>&#xa;                            &lt;tns3:direzionalita>&#xa;                                &lt;xsl:value-of select=&quot;DIREZIONALITA&quot;/>&#xa;                            &lt;/tns3:direzionalita>&#xa;                        &lt;/tns3:outputAggDbcfx>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputAggiuntiviDbcfx>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(contains($get3/parameters/tns5:visualizzaexternaldata-dbcfxGetParameters/tns5:tipoProfilo, $CRM_DG) = false()) and (contains($get3/parameters/tns5:visualizzaexternaldata-dbcfxGetParameters/tns5:tipoProfilo, $CRM_PPS) = false()) and (contains($get3/parameters/tns5:visualizzaexternaldata-dbcfxGetParameters/tns5:tipoProfilo, $CRM_MKTG) = false()) and (contains($get3/parameters/tns5:visualizzaexternaldata-dbcfxGetParameters/tns5:tipoProfilo, $CRM_GA) = false())&quot;>&#xa;                &lt;tns3:outputAggiuntiviDbcfx>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                        &lt;tns3:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Profilo non abilitato&amp;quot;&quot;/>&#xa;                        &lt;/tns3:details>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputAggiuntiviDbcfx>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:outputAggiuntiviDbcfx>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                        &lt;tns3:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun Aggiuntivo DBCFX trovato&amp;quot;&quot;/>&#xa;                        &lt;/tns3:details>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputAggiuntiviDbcfx>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
