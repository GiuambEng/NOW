get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns6:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:EventType>&#xa;                        &lt;tns6:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns6:trackID>&#xa;                    &lt;/tns6:Identifier>&#xa;                    &lt;tns6:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns6:track_position>&#xa;                    &lt;tns6:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns6:Timestamp>&#xa;                &lt;/tns6:Envelope>&#xa;                &lt;tns6:Playload>&#xa;                    &lt;tns6:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($get.parameters )))&quot;/>&#xa;                    &lt;/tns6:Binary>&#xa;                    &lt;tns6:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($get.parameters)&quot;/>&#xa;                    &lt;/tns6:XMLString>&#xa;                &lt;/tns6:Playload>&#xa;            &lt;/tns6:ActiveLoggerServices>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
