                                    <bpws:source linkName="AssignToget_listaDbcfx_outLog"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/VisualizzazioneExternalData&quot; xmlns:tns5=&quot;http://xmlns.example.com/VisualizzaExternalData/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoAggiuntiviDbcfx&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_DG&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_PPS&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_MKTG&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_GA&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiuntiviDbcfx&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($RecuperoAggiuntiviDbcfx/Record) >0&quot;>&#xa;                &lt;tns3:outputAggiuntiviDbcfx>&#xa;                    &lt;xsl:for-each select=&quot;$RecuperoAggiuntiviDbcfx/Record&quot;>&#xa;                        &lt;tns3:outputAggDbcfx>&#xa;                            &lt;tns3:numeroAggiuntivo>&#xa;                                &lt;xsl:value-of select=&quot;NUMEROAGGIUNTIVO&quot;/>&#xa;                            &lt;/tns3:numeroAggiuntivo>&#xa;                            &lt;tns3:direzionalita>&#xa;                                &lt;xsl:value-of select=&quot;DIREZIONALITA&quot;/>&#xa;                            &lt;/tns3:direzionalita>&#xa;                        &lt;/tns3:outputAggDbcfx>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputAggiuntiviDbcfx>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(contains($get3.parameters/tns5:tipoProfilo, $CRM_DG) = false()) and (contains($get3.parameters/tns5:tipoProfilo, $CRM_PPS) = false()) and (contains($get3.parameters/tns5:tipoProfilo, $CRM_MKTG) = false()) and (contains($get3.parameters/tns5:tipoProfilo, $CRM_GA) = false())&quot;>&#xa;                &lt;tns3:outputAggiuntiviDbcfx>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                        &lt;tns3:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Profilo non abilitato&amp;quot;&quot;/>&#xa;                        &lt;/tns3:details>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputAggiuntiviDbcfx>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:outputAggiuntiviDbcfx>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                        &lt;tns3:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun Aggiuntivo DBCFX trovato&amp;quot;&quot;/>&#xa;                        &lt;/tns3:details>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputAggiuntiviDbcfx>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
