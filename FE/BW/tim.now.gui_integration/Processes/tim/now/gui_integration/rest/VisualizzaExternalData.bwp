                                    sqlStatement="SELECT idrisorsa, idtransazione, timestamprichiesta, codiceordineoloof, codiceordineolo, id_stato_elab_stag, contenuto_request, contenuto_response, descrizioneerrore&#xa;FROM ANALITICO_OF_IN&#xa;WHERE idrichiestaolo=?&#xa;ORDER BY timestamprichiesta desc&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

