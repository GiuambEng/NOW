                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT JOUT.TIMSTP_RICH,JOUT.ID_ORDINE_COMPOSTO,JOUT.ID_RICH_JPUB_RICH,JOUT.CONTENUTO_REQUEST,JOUT.FLAG_CONSUNTIVO,TS.DESCR&#xd;&#xa;FROM  STAG_JPUB_OUT JOUT&#xd;&#xa;LEFT JOIN TIPOLG_STATO_ELAB_STAG TS ON JOUT.ID_STATO_ELAB_STAG =TS.ID_STATO_ELAB_STAG&#xd;&#xa;WHERE JOUT.COD_ID_ORDN=?&#xd;&#xa;ORDER BY JOUT.TIMSTP_RICH DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

