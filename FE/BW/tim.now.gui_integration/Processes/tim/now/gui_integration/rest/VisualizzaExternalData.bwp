                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;listaeventidtu&quot;/>&#xa;    &lt;xsl:template name=&quot;get_eventidtu_outLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaExsternalData&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaExsternalData&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputVisualizzaExsternalData:&amp;quot;,tib:render-xml($listaeventidtu))&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &