                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;get1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:template name=&quot;get_eventijpub_Error_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaExsternalData&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaExsternalData&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$get1/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get1/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Erroreventijpub:&amp;quot;,tib:render-xml($FaultDetails1, true(),true()))&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;            &lt;tns6:ActiveLoggerServices>&#xa;                &lt;tns6:Envelope>&#xa;                    &lt;tns6:Identifier>&#xa;                        &lt;tns6:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaExsternalData&amp;quot;&quot;/>&#xa;                        &lt;/tns6:ServiceName>&#xa;                        &lt;tns6:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Operation>&#xa;                        &lt;tns6:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Source>&#xa;                        &lt;xsl:if test=&quot;$get1/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns6:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get1/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns6:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get1/httpHeaders/tns4:httpHeaders/GUI-SID,$get1/httpHeaders/tns4:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns6:EventID>&#xa;                        &lt;xsl:if test=&quot;$get1/httpHeaders/tns4:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns6:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get1/httpHeaders/tns4:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns6:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get1/httpHeaders/tns4:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:EventType>&#xa;                        &lt;tns6:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaExsternalData_&amp;quot;,$get1/httpHeaders/tns4:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns6:trackID>&#xa;                    &lt;/tns6:Identifier>&#xa;                    &lt;tns6:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns6:track_position>&#xa;                    &lt;tns6:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns6:Timestamp>&#xa;                    &lt;tns6:ErrorLog>&#xa;                        &lt;tns6:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns6:TimeStamp>&#xa;                        &lt;tns6:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorEventiJpub&amp;quot;,'SID:',$get1/httpHeaders/tns4:httpHeaders/GUI-SID,'TID:',$get1/httpHeaders/tns4:httpHeaders/GUI-TID,'ST',$FaultDetails1/StackTrace)&quot;/>&#xa;                        &lt;/tns6:Descrizione>&#xa;                        &lt;tns6:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&#xa;                        &lt;/tns6:Codice>&#xa;                        &lt;tns6:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns6:track_position>&#xa;                    &lt;/tns6:ErrorLog>&#xa;                &lt;/tns6:Envelope>&#xa;            &lt;/tns6:ActiveLoggerServices>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
