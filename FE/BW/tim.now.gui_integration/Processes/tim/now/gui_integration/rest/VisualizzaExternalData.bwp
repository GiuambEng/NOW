                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+193f8f97-b548-457b-8fac-0a26cba11ec6+input&quot; xmlns:tns5=&quot;http://xmlns.example.com/VisualizzaExternalData/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;DTUQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;id_evento_ordn_now_whls>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns5:ideventoordnowhlsdtu&quot;/>&#xa;            &lt;/id_evento_ordn_now_whls>&#xa;            &lt;progressivoEventoDtu>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns5:progressivoEventoDtu&quot;/>&#xa;            &lt;/progressivoEventoDtu>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns5:idRichiestaOlo&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
