                                    <bpws:source linkName="JDBCQueryToDettaglioDtuNoRecordAssign_dettaglioNonTrovato">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($DTUQuery/Record[1]/ID_RICH_OLO)=0 and count($DTUQuery/Record)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($DTUQuery/Record[1]/ID_RICH_OLO)=0 and count($DTUQuery/Record)=0]]></bpws:transitionCondition>
                                    </bpws:source>
