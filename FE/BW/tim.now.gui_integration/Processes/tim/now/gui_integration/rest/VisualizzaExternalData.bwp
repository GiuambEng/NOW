                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20160530110324PLT" xmlns:tns3="http://www.tim.com/NOW/rest/VisualizzazioneExternalData" version="2.0"&gt;
    &lt;xsl:param name="listaeventidtu"/&gt;
    &lt;xsl:template name="getOut-input" match="/"&gt;
        &lt;tns:getResponse&gt;
            &lt;item&gt;
                &lt;tns3:outputeventidturest&gt;
                    &lt;xsl:copy-of select="$listaeventidtu/tns3:outeventidtujpub"/&gt;
                    &lt;xsl:copy-of select="$listaeventidtu/tns3:result"/&gt;
                &lt;/tns3:outputeventidturest&gt;
            &lt;/item&gt;
        &lt;/tns:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20160530110324PLT&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/VisualizzazioneExternalData&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;listaeventidtu&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:outputeventidturest>&#xa;            &lt;xsl:copy-of select=&quot;$listaeventidtu/tns3:outeventidtujpub&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$listaeventidtu/tns3:result&quot;/>&#xa;        &lt;/tns3:outputeventidturest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess2TogetOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/rest/VisualizzazioneExternalData&quot; xmlns:tns5=&quot;http://xmlns.example.com/VisualizzaExternalData/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRM_DG&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_PPS&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_GA&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_MKTG&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;Eventodtu&quot;/>&#xa;    &lt;xsl:template name=&quot;listaeventidtu&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($Eventodtu/Record) > 0&quot;>&#xa;                &lt;tns3:outputeventidturest>&#xa;                    &lt;xsl:for-each select=&quot;$Eventodtu/Record&quot;>&#xa;                        &lt;tns3:outeventidtujpub>&#xa;                            &lt;tns3:identificativoEventoOrdineNowWholesale>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ID_EVENTO_ORDN_NOW_WHLS_DTU)&quot;/>&#xa;                            &lt;/tns3:identificativoEventoOrdineNowWholesale>&#xa;                            &lt;tns3:progressivoEventoDtu>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(PROGRS_EVENTO_DTU)&quot;/>&#xa;                            &lt;/tns3:progressivoEventoDtu>&#xa;                            &lt;tns3:identificativoRichiestaDtu>&#xa;                                &lt;xsl:value-of select=&quot;ID_RICH_DTU_D&quot;/>&#xa;                            &lt;/tns3:identificativoRichiestaDtu>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(DATA_INVIO_NOTF_XML_DA_DTU), &amp;quot;.&amp;quot;) and exists(DATA_INVIO_NOTF_XML_DA_DTU) and string-length(xsd:string(DATA_INVIO_NOTF_XML_DA_DTU))>0&quot;>&#xa;                                    &lt;tns3:dataNotificaDaDtu>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATA_INVIO_NOTF_XML_DA_DTU), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATA_INVIO_NOTF_XML_DA_DTU), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns3:dataNotificaDaDtu>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;DATA_INVIO_NOTF_XML_DA_DTU&quot;>&#xa;                                        &lt;tns3:dataNotificaDaDtu>&#xa;                                            &lt;xsl:value-of select=&quot;DATA_INVIO_NOTF_XML_DA_DTU&quot;/>&#xa;                                        &lt;/tns3:dataNotificaDaDtu>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;STATO_EVENTO_DTU_GUI&quot;>&#xa;                                &lt;tns3:statoEventoDaDtu>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_EVENTO_DTU_GUI&quot;/>&#xa;                                &lt;/tns3:statoEventoDaDtu>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR_EVENTO&quot;>&#xa;                                &lt;tns3:notificaDtu>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_EVENTO&quot;/>&#xa;                                &lt;/tns3:notificaDtu>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns3:outeventidtujpub>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                        &lt;tns3:details>&#xa;                            &lt;xsl:value-of select=&quot;'RECORD LISTA EVENTI DTU'&quot;/>&#xa;                        &lt;/tns3:details>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputeventidturest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(contains($get/parameters/tns5:visualizzaexternaldata-eventidtuGetParameters/tns5:tipoprofilo, $CRM_DG)  or contains($get/parameters/tns5:visualizzaexternaldata-eventidtuGetParameters/tns5:tipoprofilo, $CRM_PPS) or  contains($get/parameters/tns5:visualizzaexternaldata-eventidtuGetParameters/tns5:tipoprofilo, $CRM_GA ) or  contains($get/parameters/tns5:visualizzaexternaldata-eventidtuGetParameters/tns5:tipoprofilo, $CRM_MKTG))=false()&quot;>&#xa;                &lt;tns3:outputeventidturest>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns3:severity>&#xa;                        &lt;tns3:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns3:code>&#xa;                        &lt;tns3:details>&#xa;                            &lt;xsl:value-of select=&quot;' PROFILO NON VALIDO  '&quot;/>&#xa;                        &lt;/tns3:details>&#xa;                    &lt;/tns3:result>&#xa;                &lt;/tns3:outputeventidturest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:outputeventidturest>&#xa;                    &lt;tns3:result>&#xa;                        &lt;tns3:severity>&#xa;  