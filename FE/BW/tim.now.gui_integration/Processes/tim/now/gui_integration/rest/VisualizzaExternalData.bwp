                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT E.COD_IMPIANTO,E.COD_INDIRIZZO,E.COD_ISTAT_COMUNE,E.COMPLESSO,E.COMUNE,E.COPPIA,E.DAC,E.DATA_APPUNTAMENTO,E.DATA_ASU,E.DATA_CHIUSURA,E.DATA_ESITO,E.&#xa;DATA_INVIO_RICH,E.DATA_PERMUTA_ARMADIO,E.DATA_TELEFONATA,E.DES,E.DESC_PROV,E.DESCR_ERRORE,E.DESTINAZIONE_D_USO,E.DISTR,E.DLCI_UTENTE,E.DPNR,E.DPS,E.ESITO,E.&#xa;FASCIA_ORARIA,E.ID_ARL_TI,E.ID_ODR,E.ID_VLAN,E.IDARLOLO,E.ID_RICH_OLO,E.IDSLUCO,E.IDULLPA,E.IMPRESA,E.INDICATORE_DI_ASSRCE,E.INDICATORE_DI_SCAFFALE,E.&#xa;INDIRIZZO_IP_1,E. INDIRIZZO_IP_2,E.INDIRIZZO_IP_3,E.INDIRIZZO_IP_4,E.INTERMEDIATE_AGENT,E.INTERNO,E.ISTAT_PROV,E.ISTAT_VIA,E.LOCALITA,E.LUNGHEZZA_CODA,E.&#xa;MARGINE_DI_RUMORE_DOWN,E.MARGINE_DI_RUMORE_UP,E.MODEM_RETE_TI,E.MODEM_SEDE_CLIENTE,E.MONTANTE_1,E.MONTANTE_2,E.NODO_1,E.NODO_2,E.NOTE_PER_OLO,E.NUMERO_COPPIE_RAME,&#xa;E.ORA_APPUNTAMENTO,E.ORA_DES,E.ORA_TELEFONATA,E.PAGLIETTA_1_1,E.PAGLIETTA_1_2,E.PAGLIETTA_2_1,E.PAGLIETTA_2_2,E.PARTICELLA_TOPON,E.PERMUTA_ARMADIO,E.PIANO,&#xa;E.POSIZIONE_ARL_OLO_1,E.POSIZIONE_ARL_OLO_2,E.POSIZIONE_ARL_TI_1,E.POSIZIONE_ARL_TI_2,E.POSIZIONE_CODA,E.POSIZIONE_PERMUTATORE_1,E.POSIZIONE_PERMUTATORE_2,&#xa;E.PROGRS_RIF,E.RDAC,E.RIPARTITORE,E.SCALA,E.TECNOLOGIA,E.TEL_AGGIUNTIVO_1,E.TEL_AGGIUNTIVO_2,E.TEL_AGGIUNTIVO_3,E.TEL_AGGIUNTIVO_4,E.TEL_AGGIUNTIVO_5,&#xa;E.TEL_AGGIUNTIVO_6,E.TEL_AGGIUNTIVO_7,E.TIPO_CESSAZIONE,E.TIPO_CLC,E.TRANSACTION_ID,E.USERVLAN,E.UTR,E.VCI_SP,E.VCI_UTENTE,E.VELOCITA_AGGANCIO_DOWN,E.VELOCITA_AGGANCIO_UP,&#xa;E.VIA,E.VPI_RETE,E.VPI_SP,E.VPI_UTENTE,ENA.NUMERO_AGGIUNTIVO,ENA.NUMERO_AGGIUNTIVO_ACCS,ENA.NUM_AGGNTV_DIREZTA,ENA.PROGRS_NUMERO_AGGIUNTIVO,ENA.STATO_NUM_AGGTVO&#xa;FROM EVENTO_DTU E&#xa;LEFT JOIN EVENTO_DTU_NUM_AGGTVO ENA ON ENA.ID_EVENTO_ORDN_NOW_WHLS=E.ID_EVENTO_ORDN_NOW_WHLS AND ENA.ID_RICH_OLO = E.ID_RICH_OLO&#xa;WHERE E.ID_EVENTO_ORDN_NOW_WHLS=? AND E.PROGRS_EVENTO_DTU = ? AND E.ID_RICH_OLO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

