                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+da1782d9-9e94-4c7d-8975-0e3eaa8c2899+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/rest.FAQ&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;Aggiungi&quot;/>&lt;xsl:template name=&quot;Aggiungi_FAQ-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_FAQ>&lt;xsl:value-of select=&quot;xsd:int($Aggiungi/Record[1]/NEXTVAL)&quot;/>&lt;/ID_FAQ>&lt;ANSWER>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:FAQ_Input/tns1:Risposta)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:FAQ_Input/tns1:Risposta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ANSWER>&lt;FLAG_VISIBILITA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:FAQ_Input/tns1:Visibile)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:FAQ_Input/tns1:Visibile&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FLAG_VISIBILITA>&lt;NOTE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:FAQ_Input/tns1:Note)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:FAQ_Input/tns1:Note&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOTE>&lt;OPERATORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:FAQ_Input/tns1:Operatore)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:FAQ_Input/tns1:Operatore&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OPERATORE>&lt;QUESTION>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:FAQ_Input/tns1:Domanda)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:FAQ_Input/tns1:Domanda&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/QUESTION>&lt;TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_AGGTO>&lt;TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_INSMTO>&lt;OPERATORE_ULTIMO_AGGTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:FAQ_Input/tns1:OPERATORE_ULTIMO_AGGTO)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:FAQ_Input/tns1:OPERATORE_ULTIMO_AGGTO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OPERATORE_ULTIMO_AGGTO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Aggiungi_FAQ-input"
