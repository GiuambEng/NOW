                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/rest.FAQ&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Aggiungi_FAQ&quot;/>&lt;xsl:template name=&quot;listaFAQVariable&quot; match=&quot;/&quot;>&lt;tns:FAQ_Output>&lt;xsl:choose>&lt;xsl:when test=&quot;$Aggiungi_FAQ/noOfUpdates>0&quot;>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Inserimento non andato a buon fine&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:FAQ_Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
