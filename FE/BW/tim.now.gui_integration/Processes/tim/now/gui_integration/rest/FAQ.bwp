                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/rest.FAQ&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Lista_FAQ&quot;/>&lt;xsl:template name=&quot;listaFAQVariable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Lista_FAQ/Record/ID_FAQ)&quot;>&lt;tns:FAQ_Output>&lt;xsl:for-each select=&quot;$Lista_FAQ/Record&quot;>&lt;tns:FAQ_Output>&lt;xsl:if test=&quot;QUESTION&quot;>&lt;tns:Domanda>&lt;xsl:value-of select=&quot;QUESTION&quot;/>&lt;/tns:Domanda>&lt;/xsl:if>&lt;tns:Risposta>&lt;xsl:value-of select=&quot;ANSWER&quot;/>&lt;/tns:Risposta>&lt;xsl:if test=&quot;NOTE&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;NOTE&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/tns:Operatore>&lt;tns:Visibile>&lt;xsl:value-of select=&quot;FLAG_VISIBILITA&quot;/>&lt;/tns:Visibile>&lt;tns:Data_aggiornamento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_AGGTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:Data_aggiornamento>&lt;tns:Data_inserimento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_INSMTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:Data_inserimento>&lt;tns:ID_FAQ>&lt;xsl:value-of select=&quot;xsd:int(ID_FAQ)&quot;/>&lt;/tns:ID_FAQ>&lt;xsl:if test=&quot;OPERATORE_ULTIMO_AGGTO&quot;>&lt;tns:OPERATORE_ULTIMO_AGGTO>&lt;xsl:value-of select=&quot;OPERATORE_ULTIMO_AGGTO&quot;/>&lt;/tns:OPERATORE_ULTIMO_AGGTO>&lt;/xsl:if>&lt;/tns:FAQ_Output>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:FAQ_Output>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FAQ_Ou