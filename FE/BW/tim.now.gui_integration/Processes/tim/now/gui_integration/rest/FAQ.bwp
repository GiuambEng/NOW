                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/rest.FAQ&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post2.item&quot;/>&#xa;    &lt;xsl:param name=&quot;modifica_FAQ&quot;/>&#xa;    &lt;xsl:template name=&quot;listaFAQVariable&quot; match=&quot;/&quot;>&#xa;        &lt;tns:FAQ_Output>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$modifica_FAQ/noOfUpdates>0&quot;>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Non è stato aggiornato il record con id=&amp;quot;,string($post2.item/tns:ID_FAQ))&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:FAQ_Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="listaFAQVariable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
