                &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOTE>&#xa;            &lt;QUESTION>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($put.item/tns1:Domanda)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$put.item/tns1:Domanda&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/QUESTION>&#xa;            &lt;OPERATORE_ULTIMO_AGGTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($put.item/tns1:OPERATORE_ULTIMO_AGGTO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$put.item/tns1:OPERATORE_ULTIMO_AGGTO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OPERATORE_ULTIMO_AGGTO>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;ID_FAQ>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($put.item/tns1:ID_FAQ)&quot;/>&#xa;            &lt;/ID_FAQ>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
