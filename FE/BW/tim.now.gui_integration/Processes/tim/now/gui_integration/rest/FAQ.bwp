                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+eb6e50fa-7f88-4503-9f6e-568a139022b3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/rest.FAQ&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;put&quot;/>&lt;xsl:template name=&quot;Modifica_FAQ-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ANSWER>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($put/item/tns1:FAQ_Input/tns1:Risposta)&quot;>&lt;xsl:value-of select=&quot;$put/item/tns1:FAQ_Input/tns1:Risposta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ANSWER>&lt;FLAG_VISIBILITA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($put/item/tns1:FAQ_Input/tns1:Visibile)&quot;>&lt;xsl:value-of select=&quot;$put/item/tns1:FAQ_Input/tns1:Visibile&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FLAG_VISIBILITA>&lt;NOTE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($put/item/tns1:FAQ_Input/tns1:Note)&quot;>&lt;xsl:value-of select=&quot;$put/item/tns1:FAQ_Input/tns1:Note&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOTE>&lt;QUESTION>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($put/item/tns1:FAQ_Input/tns1:Domanda)&quot;>&lt;xsl:value-of select=&quot;$put/item/tns1:FAQ_Input/tns1:Domanda&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/QUESTION>&lt;OPERATORE_ULTIMO_AGGTO>&lt;xsl:choose>&lt;