                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ParseXml/ns12:comuni)]]></bpws:finalCounterValue>
                                    <bpws:scope name="innerScope">
