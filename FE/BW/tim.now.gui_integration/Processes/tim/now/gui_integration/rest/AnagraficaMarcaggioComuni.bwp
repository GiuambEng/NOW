                                    <bpws:source linkName="postInputLogInfoToRicercaAvanzata_RicercaAvanzata">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($post/item/tns:AnagraficaMarcaggioComuniInput/tns:strutturaCondition[1]/tns:nome)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
