                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/CSVMarcaggioComuniSchema&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/activity/render/xsd/+37224824-ff3f-43ca-86bf-91bcb2164ee2+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentComune&quot;/>&lt;xsl:template name=&quot;RenderdataCSV-input&quot; match=&quot;/&quot;>&lt;tns4:Rows>&lt;tns3:comuneSchema>&lt;xsl:if test=&quot;$currentComune/tns3:codiceIstatComune&quot;>&lt;tns3:codiceIstatComune>&lt;xsl:value-of select=&quot;$currentComune/tns3:codiceIstatComune&quot;/>&lt;/tns3:codiceIstatComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentComune/tns3:tipologiaClusterComune&quot;>&lt;tns3:tipologiaClusterComune>&lt;xsl:value-of select=&quot;$currentComune/tns3:tipologiaClusterComune&quot;/>&lt;/tns3:tipologiaClusterComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentComune/tns3:versioning&quot;>&lt;tns3:versioning>&lt;xsl:value-of select=&quot;$currentComune/tns3:versioning&quot;/>&lt;/tns3:versioning>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentComune/tns3:codicePricing&quot;>&lt;tns3:codicePricing>&lt;xsl:value-of select=&quot;$currentComune/tns3:codicePricing&quot;/>&lt;/tns3:codicePricing>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentComune/tns3:dataInizioValidita&quot;>&lt;tns3:dataInizioValidita>&lt;xsl:value-of select=&quot;$currentComune/tns3:dataInizioValidita&quot;/>&lt;/tns3:dataInizioValidita>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentComune/tns3:dataFineValidita&quot;>&lt;tns3:dataFineValidita>&lt;xsl:value-of select=&quot;$currentComune/tns3:dataFineValidita&quot;/>&lt;/tns3:dataFineValidita>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentComune/tns3:descrizioneComune&quot;>&lt;tns3:descrizioneComune>&lt;xsl:value-of select=&quot;$currentComune/tns3:descrizioneComune&quot;/>&lt;/tns3:descrizioneComune>&lt;/xsl:if>&lt;xsl:if tes