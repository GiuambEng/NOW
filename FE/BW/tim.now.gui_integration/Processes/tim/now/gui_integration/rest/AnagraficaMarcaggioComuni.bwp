                                    tibex:xpdlId="402615e4-0d34-4543-938b-5b1e3040621c" variable="post_Errore_Reply-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns9="http://xmlns.example.com/20200310162519PLT" xmlns:tns="http://www.example.org/AnagraficaMarcaggioComuni" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="post_Errore_Reply-input" match="/"&gt;
        &lt;tns9:postResponse&gt;
            &lt;item&gt;
                &lt;tns:AnagraficaMarcaggioComuniOutput&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
