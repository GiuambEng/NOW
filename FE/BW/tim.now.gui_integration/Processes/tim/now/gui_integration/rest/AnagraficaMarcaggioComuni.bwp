                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fe11c217-2b6f-4dfe-81e1-d2a1404eb411+input&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaMarcaggioComuni&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns6:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length($post/item/tns:AnagraficaMarcaggioComuniInput/tns:strutturaCondition[1]/tns:nome)=0) and (upper-case($post/item/tns:AnagraficaMarcaggioComuniInput/tns:exportRequest)!='Y')&quot;>&lt;statement>&lt;xsl:value-of select=&quot;&amp;quot;select acc.codiceistatcomune,acc.tipologiaclustercomune,acc.descrizionecomune,o.offerta,acc.datainizioliberalizzazione,acc.datafineliberalizzazione,acc.datainiziomarcaggiopregresso,apc.codicepricing,apc.datainiziovaliditapricing,apc.datafinevaliditapricing,acc.versioning from anagrafica_cluster_comune acc inner join associa_pricing_cluste_comune apcc on acc.identificativoclustercomune = apcc.identificativoclustercomune inner join anagrafica_pricing_comune apc on apcc.identificativopricingcomune = apc.identificativopricingcomune inner join offerta o on acc.identificativoofferta = o.id_offerta&amp;quot;&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:when test=&quot;(string-length($post/item/tns:AnagraficaMarcaggioComuniInput/tns:strutturaCondition[1]/tns:nome)=0) and (upper-case($post/item/tns:AnagraficaMarcaggioComuniInput/tns:exportRequest)='Y')&quot;>&lt;statement>&lt;xsl:value-of select=&quot;&amp;quot;select acc.codiceistatcomune,acc.tipologiaclustercomune,acc.descrizionecomune,o.offerta,acc.datainizioliberalizzazione,acc.datafineliberalizzazione,acc.datainiziomarcaggiopregresso,acc.versioning,apc.codicepricing,apcc.datainiziovaliditaassociazione as DATAINIZIOVALIDITAPRICING,apcc.datafinevaliditaassociazione as DATAFINEVALIDITAPRICING from anagrafica_cluster_comune acc inner join associa_pricing_cluste_comune apcc on acc.identificativoclustercomune = apcc.identificativoclustercomune inner join anagrafica_pricing_comune apc on apcc.identificativopricingcomune = apc.identificativopricingcomune inner join offerta o on acc.identificativoofferta = o.id_offerta&amp;quot;&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:when test=&quot;(string-length($post/item/tns:AnagraficaMarcaggioComuniInput/tns:strutturaCondition[1]/tns:nome)=0) and (upper-case($post/item/tns:AnagraficaMarcaggioComuniInput/tns:exportRequest)='Y')&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;select acc.codiceistatcomune,acc.tipologiaclustercomune,acc.descrizionecomune,o.offerta,acc.datainizioliberalizzazione,acc.datafineliberalizzazione,acc.datainiziomarcaggiopregresso,apc.codicepricing,apc.datainiziovaliditapricing,apc.datafinevaliditapricing,acc.versioning from anagrafica_cluster_comune acc inner join associa_pricing_cluste_comune apcc on acc.identificativoclustercomune = apcc.identificativoclustercomune inner join anagrafica_pricing_comune apc on apcc.identificativopricingcomune = apc.identificativopricingcomune inner join offerta o on acc.identificativoofferta = o.id_offerta WHERE &amp;quot;, $RicercaAvanzata/tns7:outputcondition[1])&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;select acc.codiceistatcomune,acc.tipologiaclustercomune,acc.descrizionecomune,o.offerta,acc.datainizioliberalizzazione,acc.datafineliberalizzazione,acc.datainiziomarcaggiopregresso,acc.versioning,apc.codicepricing,apcc.datainiziovaliditaassociazione as DATAINIZIOVALIDITAPRICING,apcc.datafinevaliditaassociazione as DATAFINEVALIDITAPRICING from anagrafica_cluster_comune acc inner join associa_pricing_cluste_comune apcc on acc.identificativoclustercomune = apcc.identificativoclustercomune inner join anagrafica_pricing_comune apc on apcc.identificativopricingcomune = apc.identificativopricingcomune inner join offerta o on acc.identificativoofferta = o.id_offerta WHERE &amp;quot;, $RicercaAvanzata/tns7:outputcondition[1])&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns6:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
