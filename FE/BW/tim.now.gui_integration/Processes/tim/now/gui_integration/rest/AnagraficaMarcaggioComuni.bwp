                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+08df5184-c1ed-4029-ae4e-a2fe312b2917+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns8=&quot;http://xmlns.example.com/AnagraficaMarcaggioComuni/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;getIdFile&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateFile&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFile&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:jdbcUpdateActivityInput>&#xa;            &lt;idFile>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($getIdFile/Record[1]/NEXTVAL)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$getIdFile/Record[1]/NEXTVAL&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idFile>&#xa;            &lt;nomeFile>&#xa;                &lt;xsl:value-of select=&quot;$CreateFile/fileInfo/fileName&quot;/>&#xa;            &lt;/nomeFile>&#xa;            &lt;contenutoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:base64Binary($ReadFile/fileContent/binaryContent)&quot;/>&#xa;            &lt;/contenutoFile>&#xa;            &lt;esito>&#xa;                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;            &lt;/esito>&#xa;            &lt;userId>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/parameters/tns8:anagraficamarcaggiocomuniPostParameters/tns8:userId)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/parameters/tns8:anagraficamarcaggiocomuniPostParameters/tns8:userId&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/userId>&#xa;            &lt;profilo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/parameters/tns8:anagraficamarcaggiocomuniPostParameters/tns8:tipoProfilo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/parameters/tns8:anagraficamarcaggiocomuniPostParameters/tns8:tipoProfilo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/profilo>&#xa;        &lt;/tns10:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCUpdate-input"
                                    name="JDBCUpdate"
                                    outputVariable="JDBCUpdate"
                                    tibex:xpdlId="08df5184-c1ed-4029-ae4e-a2fe312b2917" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
