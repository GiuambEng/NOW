                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns9=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;post_AnagComuni_Error_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaMarcaggioComuni&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaMarcaggioComuni&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns10:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns10:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns10:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorAnagraficaMarcaggioComuni:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&#xa;                &lt;/tns10:Payload>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;            &lt;tns10:ActiveLoggerServices>&#xa;                &lt;tns10:Envelope>&#xa;                    &lt;tns10:Identifier>&#xa;                        &lt;tns10:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaMarcaggioComuni&amp;quot;&quot;/>&#xa;                        &lt;/tns10:ServiceName>&#xa;                        &lt;tns10:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Operation>&#xa;                        &lt;tns10:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns10:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns10:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns10:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns10:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns10:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns10:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns10:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaMarcaggioComuni_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns10:EventType>&#xa;                        &lt;tns10:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaMarcaggioComuni_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns10:trackID>&#xa;                    &lt;/tns10:Identifier>&#xa;                    &lt;tns10:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns10:track_position>&#xa;                    &lt;tns10:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns10:Timestamp>&#xa;                    &lt;tns10:ErrorLog>&#xa;                        &lt;tns10:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns10:TimeStamp>&#xa;                        &lt;tns10:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorAnagraficaMarcaggioComuni&amp;quot;,'SID:',$post.httpHeaders/GUI-SID,'TID:',$post.httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns10:Descrizione>&#xa;                        &lt;tns10:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns10:Codice>&#xa;                        &lt;tns10:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns10:track_position>&#xa;                    &lt;/tns10:ErrorLog>&#xa;                &lt;/tns10:Envelope>&#xa;            &lt;/tns10:ActiveLoggerServices>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
