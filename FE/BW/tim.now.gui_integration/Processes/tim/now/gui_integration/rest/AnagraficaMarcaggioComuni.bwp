                                    </bpws:links>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns9=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;post_AnagComuni_Error_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaMarcaggioComuni&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaMarcaggioComuni&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns9:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns10:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns9:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns10:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns10:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorAnagraficaMarcaggioComuni:&amp;quot;,tib:render-xml($FaultDetails, true(),true()))&quot;/>&#xa;                &lt;/tns10:Payload>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:va