comune,acc.tipologiaclustercomune,acc.descrizionecomune,o.offerta,acc.datainizioliberalizzazione,acc.datafineliberalizzazione,acc.datainiziomarcaggiopregresso,acc.versioning,apc.codicepricing,apcc.datainiziovaliditaassociazione as DATAINIZIOVALIDITAPRICING,apcc.datafinevaliditaassociazione as DATAFINEVALIDITAPRICING from anagrafica_cluster_comune acc inner join associa_pricing_cluste_comune apcc on acc.identificativoclustercomune = apcc.identificativoclustercomune inner join anagrafica_pricing_comune apc on apcc.identificativopricingcomune = apc.identificativopricingcomune inner join offerta o on acc.identificativoofferta = o.id_offerta&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(string-length($post.item/tns:strutturaCondition[1]/tns:nome)=0) and (upper-case($post.item/tns:exportRequest)='Y')&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;select acc.codiceistatcomune,acc.tipologiaclustercomune,acc.descrizionecomune,o.offerta,acc.datainizioliberalizzazione,acc.datafineliberalizzazione,acc.datainiziomarcaggiopregresso,apc.codicepricing,apc.datainiziovaliditapricing,apc.datafinevaliditapricing,acc.versioning from anagrafica_cluster_comune acc inner join associa_pricing_cluste_comune apcc on acc.identificativoclustercomune = apcc.identificativoclustercomune inner join anagrafica_pricing_comune apc on apcc.identificativopricingcomune = apc.identificativopricingcomune inner join offerta o on acc.identificativoofferta = o.id_offerta WHERE &amp;quot;, $RicercaAvanzata/tns7:outputcondition[1])&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;select acc.codiceistatcomune,acc.tipologiaclustercomune,acc.descrizionecomune,o.offerta,acc.datainizioliberalizzazione,acc.datafineliberalizzazione,acc.datainiziomarcaggiopregresso,acc.versioning,apc.codicepricing,apcc.datainiziovaliditaassociazione as DATAINIZIOVALIDITAPRICING,apcc.datafinevaliditaassociazione as DATAFINEVALIDITAPRICING from anagrafica_cluster_comune acc inner join associa_pricing_cluste_comune apcc on acc.identificativoclustercomune = apcc.identificativoclustercomune inner join anagrafica_pricing_comune apc on apcc.identificativopricingcomune = apc.identificativopricingcomune inner join offerta o on acc.identificativoofferta = o.id_offerta WHERE &amp;quot;, $RicercaAvanzata/tns7:outputcondition[1])&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns6:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
