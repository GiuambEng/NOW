      &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;            &lt;tns10:ActiveLoggerServices>&#xa;                &lt;tns10:Envelope>&#xa;                    &lt;tns10:Identifier>&#xa;                        &lt;tns10:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaMarcaggioComuni&amp;quot;&quot;/>&#xa;                        &lt;/tns10:ServiceName>&#xa;                        &lt;tns10:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Operation>&#xa;                        &lt;tns10:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns10:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns10:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns10:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns10:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns10:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns10:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns10:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaMarcaggioComuni_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns10:EventType>&#xa;                        &lt;tns10:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaMarcaggioComuni_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns10:trackID>&#xa;                    &lt;/tns10:Identifier>&#xa;                    &lt;tns10:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns10:track_position>&#xa;                    &lt;tns10:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns10:Timestamp>&#xa;                    &lt;tns10:ErrorLog/>&#xa;                &lt;/tns10:Envelope>&#xa;            &lt;/tns10:ActiveLoggerServices>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
