      &lt;xsl:value-of select=&quot;$post/httpHeaders/tns9:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns10:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns10:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaMarcaggioComuni_&amp;quot;,$post/httpHeaders/tns9:httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns10:EventType>&#xa;                        &lt;tns10:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaMarcaggioComuni_&amp;quot;,$post/httpHeaders/tns9:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns10:trackID>&#xa;                    &lt;/tns10:Identifier>&#xa;                    &lt;tns10:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns10:track_position>&#xa;                    &lt;tns10:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns10:Timestamp>&#xa;                    &lt;tns10:ErrorLog>&#xa;                        &lt;tns10:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns10:TimeStamp>&#xa;                        &lt;tns10:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorAnagraficaMarcaggioComuni&amp;quot;,'SID:',$post/httpHeaders/tns9:httpHeaders/GUI-SID,'TID:',$post/httpHeaders/tns9:httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns10:Descrizione>&#xa;                        &lt;tns10:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns10:Codice>&#xa;                        &lt;tns10:track_position>&#xa;        