                                tibex:xpdlId="1936d930-b5af-437d-8031-d407a2c75b80" variable="postOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns10="http://xmlns.example.com/20200310162519PLT" xmlns:tns="http://www.example.org/AnagraficaMarcaggioComuni" xmlns:tns9="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="Variable"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="CryptoParams"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns10:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="(upper-case($post/item/tns:AnagraficaMarcaggioComuniInput/tns:exportRequest)=&amp;quot;N&amp;quot;) or (string-length($post/item/tns:AnagraficaMarcaggioComuniInput/tns:exportRequest)=0)"&gt;
                        &lt;tns:AnagraficaMarcaggioComuniOutput&gt;
                            &lt;xsl:copy-of select="$Variable/tns:listaAnagraficaMarcaggioComuni"/&gt;
                            &lt;xsl:copy-of select="$Variable/tns:result"/&gt;
                            &lt;xsl:if test="$Variable/tns:idExportFile"&gt;
                                &lt;tns:idExportFile&gt;
                                    &lt;xsl:value-of select="$Variable/tns:idExportFile"/&gt;
                                &lt;/tns:idExportFile&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:AnagraficaMarcaggioComuniOutput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:AnagraficaMarcaggioComuniOutput&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="$CryptoParams/tns9:idFileCriptato"/&gt;
                            &lt;/tns:idExportFile&gt;
                        &lt;/tns:AnagraficaMarcaggioComuniOutput&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns10:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://xmlns.example.com/20200310162519PLT&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaMarcaggioComuni&quot; xmlns:tns9=&quot;http://www.example.org/CryptoParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParams&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(upper-case($post.item/tns:exportRequest)=&amp;quot;N&amp;quot;) or (string-length($post.item/tns:exportRequest)=0)&quot;>&#xa;                &lt;tns:AnagraficaMarcaggioComuniOutput>&#xa;                    &lt;xsl:copy-of select=&quot;$Variable/tns:listaAnagraficaMarcaggioComuni&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$Variable/tns:result&quot;/>&#xa;                    &lt;xsl:if test=&quot;$Variable/tns:idExportFile&quot;>&#xa;                        &lt;tns:idExportFile>&#xa;                            &lt;xsl:value-of select=&quot;$Variable/tns:idExportFile&quot;/>&#xa;                        &lt;/tns:idExportFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:AnagraficaMarcaggioComuniOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:AnagraficaMarcaggioComuniOutput>&#xa;                    &lt;tns:idExportFile>&#xa;                        &lt;xsl:value-of select=&quot;$CryptoParams/tns9:idFileCriptato&quot;/>&#xa;                    &lt;/tns:idExportFile>&#xa;                &lt;/tns:AnagraficaMarcaggioComuniOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
