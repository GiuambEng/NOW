                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AnagraficaMarcaggioComuni&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:inputservizioricercaavanzata>&#xa;            &lt;xsl:for-each select=&quot;$post/item/tns:AnagraficaMarcaggioComuniInput/tns:strutturaCondition&quot;>&#xa;                &lt;tns7:strutturaCondition>&#xa;                    &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                        &lt;tns7:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                        &lt;/tns7:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:operazione&quot;>&#xa;                        &lt;tns7:operazione>&#xa;                            &lt;xsl:value-of select=&quot;tns:operazione&quot;/>&#xa;                        &lt;/tns7:operazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:valore&quot;>&#xa;                        &lt;tns7:valore>&#xa;                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                        &lt;/tns7:valore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:tipo&quot;>&#xa;                        &lt;tns7:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns:tipo&quot;/>&#xa;                        &lt;/tns7:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns7:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$post/item/tns:AnagraficaMarcaggioComuniInput/tns:indiceriga&quot;>&#xa;                &lt;tns7:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns:AnagraficaMarcaggioComuniInput/tns:indiceriga&quot;/>&#xa;                &lt;/tns7:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post/item/tns:AnagraficaMarcaggioComuniInput/tns:numerorighe&quot;>&#xa;                &lt;tns7:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns:AnagraficaMarcaggioComuniInput/tns:numerorighe&quot;/>&#xa;                &lt;/tns7:numerorighe>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns7:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
