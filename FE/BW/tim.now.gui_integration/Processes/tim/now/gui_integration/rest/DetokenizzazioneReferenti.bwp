                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/NOW_SECOLO/&quot; xmlns:tns1=&quot;http://www.example.org/Detokenizzazione&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Decode_token_NOWSecolo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RequestDecode_token>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:codOloAgcom&quot;>&#xa;                &lt;tns2:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:codOloAgcom&quot;/>&#xa;                &lt;/tns2:CodificaOLOAGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns1:codOrdineOlo&quot;>&#xa;                &lt;tns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns1:codOrdineOlo&quot;/>&#xa;                &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:flagAsset) and $post.item/tns1:flagAsset = 'Y'&quot;>&#xa;                    &lt;tns2:Funzione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VISGUIA&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Funzione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($post.item/tns1:tokenReferenti[$index]/tns1:tokenCF) and string-length($post.item/tns1:tokenReferenti[$index]/tns1:tokenCF)>0&quot;>&#xa;                    &lt;tns2:Funzione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VISGUIC&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Funzione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns1:referenteContattato = 'Y'&quot;>&#xa;                    &lt;tns2:Funzione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VISGUIORC&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Funzione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Funzione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VISGUIO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Funzione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat($post.item/tns1:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns2:ChiaveRiferimento>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:operatore)=0&quot;>&#xa;                    &lt;tns2:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:Operatore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:operatore&quot;>&#xa;                        &lt;tns2:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:operatore&quot;/>&#xa;                        &lt;/tns2:Operatore>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:IPClient)=0&quot;>&#xa;                    &lt;tns2:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:IPClient>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:IPClient&quot;>&#xa;                        &lt;tns2:IPClient>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:IPClient&quot;/>&#xa;                        &lt;/tns2:IPClient>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:tokenReferenti[$index]/tns1:tokenFisso)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:tokenReferenti[$index]/tns1:tokenFisso&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:tokenReferenti[$index]/tns1:tokenFisso&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:tokenReferenti[$index]/tns1:tokenCF)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:tokenReferenti[$index]/tns1:tokenCF&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:tokenReferenti[$index]/tns1:tokenCF&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns1:tokenReferenti[$index]/tns1:tokenMobile&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns1:tokenReferenti[$index]/tns1:tokenMobile&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:RequestDecode_token>&#xa;    &lt;/xsl:templat