&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/NOW_SECOLO/" xmlns:tns1="http://www.example.org/Detokenizzazione" xmlns:tns2="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="post"/&gt;&lt;xsl:template name="Decode_token_NOWSecolo-input" match="/"&gt;&lt;tns:Decode_token_NOWSecoloRequest&gt;&lt;Input&gt;&lt;tns2:RequestDecode_token&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:codOloAgcom"&gt;&lt;tns2:CodificaOLOAGCOM&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:codOloAgcom"/&gt;&lt;/tns2:CodificaOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo"&gt;&lt;tns2:CodiceOrdineOLO&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo"/&gt;&lt;/tns2:CodiceOrdineOLO&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($post/item/tns1:inputTokenizzazione/tns1:flagAsset) and $post/item/tns1:inputTokenizzazione/tns1:flagAsset = 'Y'"&gt;&lt;tns2:Funzione&gt;&lt;xsl:value-of select="&amp;quot;VISGUIA&amp;quot;"/&gt;&lt;/tns2:Funzione&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($post/item/tns1:inputTokenizzazione/tns1:tokenReferenti[$index]/tns1:tokenCF) and string-length($post/item/tns1:inputTokenizzazione/tns1:tokenReferenti[$index]/tns1:tokenCF)&gt;0"&gt;&lt;tns2:Funzione&gt;&lt;xsl:value-of select="&amp;quot;VISGUIC&amp;quot;"/&gt;&lt;/tns2:Funzione&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$post/item/tns1:inputTokenizzazione/tns1:referenteContattato = 'Y'"&gt;&lt;tns2:Funzione&gt;&lt;xsl:value-of select="&amp;quot;VISGUIORC&amp;quot;"/&gt;&lt;/tns2:Funzione&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:Funzione&gt;&lt;xsl:value-of select="&amp;quot;VISGUIO&amp;quot;"/&gt;&lt;/tns2:Funzione&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns2:ChiaveRiferimento&gt;&lt;xsl:value-of select="concat($post/item/tns1:inputTokenizzazione/tns1:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))"/&gt;&lt;/tns2:ChiaveRiferimento&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($post/item/tns1:inputTokenizzazione/tns1:operatore)=0"&gt;&lt;tns2:Operatore&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns2:Operatore&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:operatore"&gt;&lt;tns2:Operatore&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:operatore"/&gt;&lt;/tns2:Operatore&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($post/item/tns1:inputTokenizzazione/tns1:IPClient)=0"&gt;&lt;tns2:IPClient&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns2:IPClient&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:IPClient"&gt;&lt;tns2:IPClient&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:IPClient"/&gt;&lt;/tns2:IPClient&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($post/item/tns1:inputTokenizzazione/tns1:tokenReferenti[$index]/tns1:tokenFisso)&gt;0"&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:tokenReferenti[$index]/tns1:tokenFisso"&gt;&lt;tns2:Token&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:tokenReferenti[$index]/tns1:tokenFisso"/&gt;&lt;/tns2:Token&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($post/item/tns1:inputTokenizzazione/tns1:tokenReferenti[$index]/tns1:tokenCF)&gt;0"&gt;&lt;xsl:if test="$post/item/tns1:inputTokenizzazione/tns1:tokenReferenti[$index]/tns1:tokenCF"&gt;&lt;tns2:Token&gt;&lt;xsl:value-of select="$post/item/tns1:inputTokenizzazione/tns1:tokenReferenti[$index]/tns1:tokenCF"/&gt;&lt;/tns2:Token&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$pos