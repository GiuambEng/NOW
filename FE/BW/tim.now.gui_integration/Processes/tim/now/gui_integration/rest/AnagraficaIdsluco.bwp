    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="ede9c598-a502-484b-95e4-36ea3aabb2b9">
                <bpws:onMessage operation="post"
                    partnerLink="anagraficaidsluco"
                    portType="ns:anagraficaidsluco"
                    tibex:xpdlId="53149e58-bb13-4e21-b036-542e6df39c83" variable="post">
                    <bpws:scope name="scope1">
