                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+736de18b-ff04-4881-a9e0-d00adee758a2+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/AnagraficaIdsluco/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.parameters/tns1:codiceOloAgcom)>0 and $post.parameters/tns1:codiceOloAgcom !=&amp;quot;NO-OLO&amp;quot;&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT CODFC_OLO_AGCOM, NOME, &amp;quot;,&amp;quot; OPERATORE, CODFC_OLO_RETE, FLAG_OLO_ACCORPANTE &amp;quot;, &amp;#xD;&amp;#xA;&amp;quot; FROM OLO&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot; WHERE &amp;quot;, &amp;quot;CODFC_OLO_AGCOM&amp;quot;, &amp;quot;='&amp;quot;,$post.parameters/tns1:codiceOloAgcom,&amp;quot;'  OR COD_OLO_ACCORPANTE = '&amp;quot;,$post.parameters/tns1:codiceOloAgcom,&amp;quot;' OR COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;,$post.parameters/tns1:codiceOloAgcom,&amp;quot;') ORDER BY CODFC_OLO_AGCOM&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT CODFC_OLO_AGCOM, NOME, OPERATORE, CODFC_OLO_RETE, FLAG_OLO_ACCORPANTE FROM OLO ORDER BY CODFC_OLO_AGCOM&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
