                                    inputVariable="Variable"
                                    name="Copy_1_Assign"
                                    outputVariable="Variable"
                                    tibex:xpdlId="8282f28a-a34d-47cb-843f-132ca7f09044" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
