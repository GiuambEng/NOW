                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT&#xd;&#xa;       ANA.NUMERO_RECORD,&#xd;&#xa;       ANA.CLLI,&#xd;&#xa;       ANA.DISTRETTO_TELEFONO,&#xd;&#xa;       NVL(ACQ.CODICE_ORDINE_OLO, 'NON TROVATO') CODICE_ORDINE_OLO,&#xd;&#xa;       ANA.DESCRIZIONE_ERRORE,&#xd;&#xa;       ANA.TMSTP_INSMTO,&#xd;&#xa;       ANA.CONTENUTO_RCD&#xd;&#xa;FROM ANALITICO_MIGRAZIONI_ULLSLU ANA&#xd;&#xa;LEFT JOIN ACQUISIZIONE_RICHIESTE ACQ&#xd;&#xa;       ON ANA.ID_FILE_PROCSO_INPUT = ACQ.ID_FILE&#xd;&#xa;      AND ACQ.CONTENUTO_XML_OLO LIKE '%' || ANA.DISTRETTO_TELEFONO || '%'&#xd;&#xa;WHERE ANA.ID_FILE_PROCSO_INPUT =?&#xd;&#xa;  AND ANA.ID_STATO_ELAB_STAG = 6" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="procso"/>

                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="NUMERO_RECORD"
                                    dataType="4"
                                    status="OptionalElement" typeName="number"/>

                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="CLLI"
                                    dataType="12"
                                    status="OptionalElement" typeName="nvarchar2"/>

                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="DISTRETTO_TELEFONO"
                                    dataType="12"
                                    status="OptionalElement" typeName="nvarchar2"/>

                                    <columnMetadata
                                    columnIndex="4"
                                    columnName="CODICE_ORDINE_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="varchar2"/>

                                    <columnMetadata
                                    columnIndex="5"
                                    columnName="DESCRIZIONE_ERRORE"
                                    dataType="12"
                                    status="OptionalElement" typeName="varchar2"/>

                                    <columnMetadata
                                    columnIndex="6"
                                    columnName="TMSTP_INSMTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="timestamp"/>

                                    <columnMetadata
                                    columnIndex="7"
                                    columnName="CONTENUTO_RCD"
                                    dataType="12"
                                    status="OptionalElement" typeName="varchar2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
