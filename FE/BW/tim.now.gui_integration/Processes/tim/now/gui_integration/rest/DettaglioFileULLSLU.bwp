                                    <bpws:source linkName="Copy_1_AssignToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/DettaglioFileULLSLU&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;VerificaStatoFile&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns3:DettaglioFileULLSLUOutput>&lt;xsl:for-each select=&quot;$Variable/tns3:listacampi&quot;>&lt;tns3:listacampi>&lt;xsl:if test=&quot;tns3:numeroRecord&quot;>&lt;tns3:numeroRecord>&lt;xsl:value-of select=&quot;tns3:numeroRecord&quot;/>&lt;/tns3:numeroRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:clli&quot;>&lt;tns3:clli>&lt;xsl:value-of select=&quot;tns3:clli&quot;/>&lt;/tns3:clli>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:distrettoTelefono&quot;>&lt;tns3:distrettoTelefono>&lt;xsl:value-of select=&quot;tns3:distrettoTelefono&quot;/>&lt;/tns3:distrettoTelefono>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:codiceOrdineOLO&quot;>&lt;tns3:codiceOrdineOLO>&lt;xsl:value-of select=&quot;tns3:codiceOrdineOLO&quot;/>&lt;/tns3:codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:stato&quot;>&lt;tns3:stato>&lt;xsl:value-of select=&quot;tns3:stato&quot;/>&lt;/tns3:stato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:descrizioneErrore&quot;>&lt;tns3:descrizioneErrore>&lt;xsl:value-of select=&quot;tns3:descrizioneErrore&quot;/>&lt;/tns3:descrizioneErrore>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:dataInizioElab&quot;>&lt;tns3:dataInizioElab>&lt;xsl:value-of select=&quot;tns3:dataInizioElab&quot;/>&lt;/tns3:dataInizioElab>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:contenutoRecord&quot;>&lt;tns3:contenutoRecord>&lt;xsl:value-of select=&quot;tns3:contenutoRecord&quot;/>&lt;/tns3:contenutoRecord>&lt;/xsl:if>&lt;/tns3:listacampi>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$VerificaStatoFile/Record[$index]/ID_STATO_ELAB_STAG!=6&quot;>&lt;xsl:for-each select=&quot;$JDBCQuery/Record&quot;>&lt;tns3:listacampi>&lt;xsl:if test=&quot;NUMERO_RECORD&quot;>&lt;tns3:numeroRecord>&lt;xsl:value-of select=&quot;NUMERO_RECORD&quot;/>&lt;/tns3:numeroRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;CLLI&quot;>&lt;tns3:clli>&lt;xsl:value-of select=&quot;CLLI&quot;/>&lt;/tns3:clli>&lt;/xsl:if>&lt;xsl:if test=&quot;DISTRETTO_TELEFONO&quot;>&lt;tns3:distrettoTelefono>&lt;xsl:value-of select=&quot;DISTRETTO_TELEFONO&quot;/>&lt;/tns3:distrettoTelefono>&lt;/xsl:if>&lt;tns3:stato>&lt;xsl:value-of select=&quot;'KO ELABORAZIONE RECORD'&quot;/>&lt;/tns3:stato>&lt;xsl:if test=&quot;DESCRIZIONE_ERRORE&quot;>&lt;tns3:descrizioneErrore>&lt;xsl:value-of select=&quot;DESCRIZIONE_ERRORE&quot;/>&lt;/tns3:descrizioneErrore>&lt;/xsl:if>&lt;xsl:if test=&quot;TMSTP_INSMTO&quot;>&lt;tns3:dataInizioElab>&lt;xsl:value-of select=&quot;TMSTP_INSMTO&quot;/>&lt;/tns3:dataInizioElab>&lt;/xsl:if>&lt;xsl:if test=&quot;CONTENUTO_RCD&quot;>&lt;tns3:contenutoRecord>&lt;xsl:value-of select=&quot;CONTENUTO_RCD&quot;/>&lt;/tns3:contenutoRecord>&lt;/xsl:if>&lt;/tns3:listacampi>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaStatoFile/Record[$index]/ID_STATO_ELAB_STAG=6&quot;>&lt;xsl:for-each select=&quot;$JDBCQuery1/Record&quot;>&lt;tns3:listacampi>&lt;xsl:if test=&quot;NUMERO_RECORD&quot;>&lt;tns3:numeroRecord>&lt;xsl:value-of select=&quot;NUMERO_RECORD&quot;/>&lt;/tns3:numeroRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;CLLI&quot;>&lt;tns3:clli>&lt;xsl:value-of select=&quot;CLLI&quot;/>&lt;/tns3:clli>&lt;/xsl:if>&lt;xsl:if test=&quot;DISTRETTO_TELEFONO&quot;>&lt;tns3:distrettoTelefono>&lt;xsl:value-of select=&quot;DISTRETTO_TELEFONO&quot;/>&lt;/tns3:distrettoTelefono>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICE_ORDINE_OLO&quot;>&lt;tns3:codiceOrdineOLO>&lt;xsl:value-of select=&quot;CODICE_ORDINE_OLO&quot;/>&lt;/tns3:codiceOrdineOLO>&lt;/xsl:if>&lt;tns3:stato>&lt;xsl:value-of select=&quot;'OK ELABORAZIONE RECORD'&quot;/>&lt;/tns3:stato>&lt;xsl:if test=&quot;DESCRIZIONE_ERRORE&quot;>&lt;tns3:descrizioneErrore>&lt;xsl:value-of select=&quot;DESCRIZIONE_ERRORE&quot;/>&lt;/tns3:descrizioneErrore>&lt;/xsl:if>&lt;xsl:if test=&quot;TMSTP_INSMTO&quot;>&lt;tns3:dataInizioElab>&lt;xsl:value-of select=&quot;TMSTP_INSMTO&quot;/>&lt;/tns3:dataInizioElab>&lt;/xsl:if>&lt;xsl:if test=&quot;CONTENUTO_RCD&quot;>&lt;tns3:contenutoRecord>&lt;xsl:value-of select=&quot;CONTENUTO_RCD&quot;/>&lt;/tns3:contenutoRecord>&lt;/xsl:if>&lt;/tns3:listacampi>&lt;/xsl:for-each>&lt;/xsl:if>&lt;tns3:result>&lt;tns3:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns3:severity>&lt;tns3:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns3:code>&lt;/tns3:result>&lt;/tns3:DettaglioFileULLSLUOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
