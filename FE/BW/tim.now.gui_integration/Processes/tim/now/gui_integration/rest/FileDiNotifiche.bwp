                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign_FileDiNotificheNoRicAvanzataToEmpty1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Profilo&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;fileDiNotificheNonOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;fileDiNotificheOlo&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($Profilo, $post.parameters/tns1:tipoProfilo) = true() and string-length($fileDiNotificheOlo/Record[1]/NOME_FILE)>0&quot;>&#xa;                &lt;tns:fileDiNotificheOutput>&#xa;                    &lt;xsl:for-each select=&quot;$fileDiNotificheOlo/Record[(QT_RECD_TOTALI != 0 and COD_INTRFC != ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH')) or (COD_INTRFC = ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH'))]&quot;>&#xa;                        &lt;tns:listaFileNotifiche>&#xa;                            &lt;xsl:if test=&quot;DESCR&quot;>&#xa;                                &lt;tns:tipoNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                                &lt;/tns:tipoNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:nomeFile>&#xa;                                &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                            &lt;/tns:nomeFile>&#xa;                            &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                &lt;tns:codOloAgcom>&#xa;                                    &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                &lt;/tns:codOloAgcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DIMENSIONE_FILE)&quot;>&#xa;                                &lt;tns:dimensioneFile>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&#xa;                                &lt;/tns:dimensioneFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ESITO_INVIO&quot;>&#xa;                                &lt;tns:esitoInvio>&#xa;                                    &lt;xsl:value-of select=&quot;ESITO_INVIO&quot;/>&#xa;                                &lt;/tns:esitoInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(QT_RECD_TOTALI)&quot;>&#xa;                                &lt;tns:quantitaRecordTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(QT_RECD_TOTALI)&quot;/>&#xa;                                &lt;/tns:quantitaRecordTotali>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREZIONE_FILE) and string-length(string(TIMSTP_CREZIONE_FILE))>0&quot;>&#xa;                                    &lt;tns:timestampCreazioneFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:timestampCreazioneFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;TIMSTP_CREZIONE_FILE&quot;>&#xa;                                        &lt;tns:timestampCreazioneFile>&#xa;                                            &lt;xsl:value-of select=&quot;TIMSTP_CREZIONE_FILE&quot;/>&#xa;                                        &lt;/tns:timestampCreazioneFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(string(TIMSTP_INVIO))>0&quot;>&#xa;                                    &lt;tns:timestampInvio>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:timestampInvio>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&#xa;                                        &lt;tns:timestampInvio>&#xa;                                            &lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&#xa;                                        &lt;/tns:timestampInvio>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists(ID_FILE)&quot;>&#xa;                                &lt;tns:idFile>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_FILE)&quot;/>&#xa;                                &lt;/tns:idFile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:listaFileNotifiche>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($fileDiNotificheOlo/Record)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:fileDiNotificheOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;contains($Profilo, $post.parameters/tns1:tipoProfilo) = false() and string-length($fileDiNotificheNonOlo/Record[1]/NOME_FILE)>0&quot;>&#xa;                &lt;tns:fileDiNotificheOutput>&#xa;                    &lt;xsl:for-each select=&quot;$fileDiNotificheNonOlo/Record&quot;>&#xa;                        &lt;tns:listaFileNotifiche>&#xa;                            &lt;xsl:if test=&quot;DESCR&quot;>&#xa;                                &lt;tns:tipoNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                                &lt;/tns:tipoNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:nomeFile>&#xa;                                &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                            &lt;/tns:nomeFile>&#xa;                            &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                &lt;tns:codOloAgcom>&#xa;                                    &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                &lt;/tns:codOloAgcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DIMENSIONE_FILE)&quot;>&#xa;                                &lt;tns:dimensioneFile>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&#xa;                                &lt;/tns:dimensioneFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ESITO_INVIO&quot;>&#xa;                                &lt;tns:esitoInvio>&#xa;                                    &lt;xsl:value-of select=&quot;ESITO_INVIO&quot;/>&#xa;                                &lt;/tns:esitoInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(QT_RECD_TOTALI)&quot;>&#xa;                                &lt;tns:quantitaRecordTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(QT_RECD_TOTALI))&quot;/>&#xa;                                &lt;/tns:quantitaRecordTotali>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREZIONE_FILE) and string-length(string(TIMSTP_CREZIONE_FILE))>0&quot;>&#xa;                                    &lt;tns:timestampCreazioneFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:timestampCreazioneFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;TIMSTP_CREZIONE_FILE&quot;>&#xa;                                        &lt;tns:timestampCreazioneFile>&#xa;                                            &lt;xsl:value-of select=&quot;TIMSTP_CREZIONE_FILE&quot;/>&#xa;                                        &lt;/tns:timestampCreazioneFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(string(TIMSTP_INVIO))>0&quot;>&#xa;                                    &lt;tns:timestampInvio>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:timestampInvio>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&#xa;                                        &lt;tns:timestampInvio>&#xa;                                            &lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&#xa;                                        &lt;/tns:timestampInvio>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists(ID_FILE)&quot;>&#xa;                                &lt;tns:idFile>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_FILE)&quot;/>&#xa;                                &lt;/tns:idFile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:listaFileNotifiche>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if (count($fileDiNotificheNonOlo/Record)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:fileDiNotificheOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:fileDiNotificheOutput>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi corrispondenti ai criteri di ricerca&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:fileDiNotificheOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty1" tibex:xpdlId="be53fb8d-6c21-4dcf-bcbf-7ac30320d612">
                                <bpws:targets>
                                    <bpws:target linkName="Assign_FileDiNotificheNoRicAvanzataToEmpty1"/>
                                    <bpws:target linkName="Assign_FileDiNotificheRicAvanzataToEmpty1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty1ToJDBCQueryExport">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($post/item/ns4:Salvaricerca_Input/ns4:exportRequest) and (upper-case($post/item/ns4:Salvaricerca_Input/ns4:exportRequest) = &quot;S&quot; or upper-case($post/item/ns4:Salvaricerca_Input/ns4:exportRequest) = &quot;Y&quot;) and (exists($FileDiNotificheOloQuery) or exists($FileDiNotificheNonOlo_Query) or exists($fileDiNotificheNonOlo) or exists($fileDiNotificheOlo))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($post.item/ns4:exportRequest) and (upper-case($post.item/ns4:exportRequest) = "S" or upper-case($post.item/ns4:exportRequest) = "Y") and (exists($FileDiNotificheOloQuery) or exists($FileDiNotificheNonOlo_Query) or exists($fileDiNotificheNonOlo) or exists($fileDiNotificheOlo))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty1ToCallProcess1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CryptoParams-input"
                                    name="CryptoParams"
                                    outputVariable="CryptoParams"
                                    tibex:xpdlId="602e77be-4f38-4d59-8593-80f7f7ff280d"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ExportDatiToCryptoParams"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CryptoParamsTopost_fileNotificheOutput_LogInfo"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/CryptoParams&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryExport&quot;/>&#xa;    &lt;xsl:template name=&quot;CryptoParams-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CryptoParamsInput>&#xa;            &lt;tns2:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JDBCQueryExport/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns2:idFile>&#xa;        &lt;/tns2:CryptoParamsInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_integration.sub.CryptoParams" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CryptoList-input"
                                    name="CryptoList"
                                    outputVariable="CryptoList"
                                    tibex:xpdlId="8c100a84-e88a-484f-b38b-016677ab3e99"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1Topost_fileNotificheOutput_LogInfo"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; xmlns:tns2=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;CryptoList-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CryptoListParamsInput>&#xa;            &lt;xsl:for-each select=&quot;$Variable/tns:listaFileNotifiche&quot;>&#xa;                &lt;tns2:listIdFile>&#xa;                    &lt;xsl:if test=&quot;tns:idFile&quot;>&#xa;                        &lt;tns2:idFile>&#xa;                            &lt;xsl:value-of select=&quot;tns:idFile&quot;/>&#xa;                        &lt;/tns2:idFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:listIdFile>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:CryptoListParamsInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_integration.sub.CryptoListParams" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
