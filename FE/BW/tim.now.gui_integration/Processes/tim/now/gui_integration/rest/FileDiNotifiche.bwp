                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Profilo&quot;/>&#xa;    &lt;xsl:param name=&quot;FileDiNotificheOloQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;FileDiNotificheNonOlo_Query&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($Profilo, $post.parameters/tns1:tipoProfilo) = true() and string-length(string($FileDiNotificheOloQuery/unknownResultset[1]/row[1]/column[name='NOME_FILE']/value))>0&quot;>&#xa;                &lt;tns:fileDiNotificheOutput>&#xa;                    &lt;xsl:for-each select=&quot;$FileDiNotificheOloQuery/unknownResultset/row[(column[name='QT_RECD_TOTALI']/value != 0 and column[name='COD_INTRFC']/value != ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH')) or (column[name='COD_INTRFC']/value =