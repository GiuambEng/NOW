                                    tibex:xpdlId="4170c783-ced8-4c99-9d4f-0500f8c29dc1" variable="Reply-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160512123101PLT" xmlns:tns="http://www.tim.com/NOW/rest/fileDiNotifiche" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;item&gt;
                &lt;tns:fileDiNotificheOutput&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;
                        &lt;/tns:severity&gt;
                        &lt;xsl:if test="$FaultDetails/MsgCode"&gt;
                            &lt;tns:code&gt;
                                &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                            &lt;/tns:code&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$FaultDetails/Msg"&gt;
                            &lt;tns:details&gt;
                                &lt;xsl:value-of select="$FaultDetails/Msg"/&gt;
                            &lt;/tns:details&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:fileDiNotificheOutput&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160512123101PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:fileDiNotificheOutput>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;xsl:if test=&quot;$FaultDetails/MsgCode&quot;>&#xa;                    &lt;tns:code>&#xa;                        &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                    &lt;/tns:code>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$FaultDetails/Msg&quot;>&#xa;                    &lt;tns:details>&#xa;                        &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                    &lt;/tns:details>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:fileDiNotificheOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
