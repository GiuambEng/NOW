                                <bpws:link
                                    name="Copy_1_FileDiNotificheOloQueryToCallProcess3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToCallProcess1"
                                    tibex:label="noExport" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="FileDiNotificheOloQueryToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty1ToJDBCQueryExport"
                                    tibex:label="Export" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCQueryExportToRenderXml" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RenderXmlToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ExportDatiToCryptoParams" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="post_fileNotifiche_noRicercaAvanzata"
                                    tibex:label="noRicercaAvanzata" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="EmptyToCopy_1_OLO"
                                    tibex:label="OLO" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="EmptyToCopy_1_FileDiNotificheNonOlo" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="fileDiNotificheOloToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="fileDiNotificheNonOloToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Assign_FileDiNotificheNoRicAvanzataToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Assign_FileDiNotificheRicAvanzataToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CryptoParamsTopost_fileNotificheOutput_LogInfo" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess1Topost_fileNotificheOutput_LogInfo" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="OnMessageStart1"
                                tibex:constructor="onMessageStart" tibex:xpdlId="67bf3226-5ed2-4d57-9b6e-1a461d520520">
                                <bpws:sources>
                                    <bpws:source linkName="OnMessageStart1ToCallProcess1"/>
