                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT TF.DESCR,FPO.DIMENSIONE_FILE, FPO.ESITO_INVIO, FPO.QT_RECD_TOTALI,&#xa;       FPO.TIMSTP_CREZIONE_FILE, FPO.TIMSTP_INVIO, FP.NOME_FILE,&#xa;       FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE, FP.ID_FILE, I.COD_INTRFC &#xa;FROM FILE_PROCSTO FP&#xa;LEFT JOIN FILE_PROCSTO_OUTPUT FPO ON FP.ID_FILE = FPO.ID_FILE_PROCSTO_OUTPUT&#xa;LEFT JOIN INTRFC I ON I.ID_INTRFC = FP.ID_INTRFC&#xa;LEFT JOIN TIPOLG_FILE TF ON TF.IDTPLG_FILE=FP.IDTPLG_FILE&#xa;WHERE FP.VERSO_DEL_FILE = 'OUTPUT' AND FP.CODFC_OLO_AGCOM is not NULL &#xa;AND (FPO.QT_RECD_TOTALI != 0 and I.COD_INTRFC NOT IN ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH')) or (I.COD_INTRFC IN ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH'))&#xa;ORDER BY FPO.TIMSTP_INVIO DESC, FPO.QT_RECD_TOTALI DESC&#xa;FETCH FIRST 500 ROWS ONLY" xsi:type="jdbcPalette:JDBCQueryActivity">
