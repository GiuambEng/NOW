                                    tibex:label="NonOlo" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="JDBCQueryToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQuery1ToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
