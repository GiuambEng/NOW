                                tibex:constructor="onMessageEnd" tibex:xpdlId="2208a8b2-c6d5-4720-a645-064672755e59"/>
                            <bpws:reply name="getOut" operation="get"
                                partnerLink="filedinotifiche"
                                portType="ns:filedinotifiche"
                                tibex:xpdlId="7b263033-f9f2-4ac1-8cab-95f6ace348e4" variable="getOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160512123101PLT" xmlns:tns="http://www.tim.com/NOW/rest/fileDiNotifiche" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="Variable"/&gt;
    &lt;xsl:param name="VariableAssign1"/&gt;
    &lt;xsl:template name="getOut-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;item&gt;
                &lt;tns:fileDiNotificheOutput&gt;
                    &lt;xsl:for-each select="$Variable/tns:listaFileNotifiche"&gt;
                        &lt;tns:listaFileNotifiche&gt;
                            &lt;xsl:variable name="currentPosition" select="current()/tns:posizione"/&gt;
                            &lt;xsl:if test="tns:tipoNotifica"&gt;
                                &lt;tns:tipoNotifica&gt;
                                    &lt;xsl:value-of select="tns:tipoNotifica"/&gt;
                                &lt;/tns:tipoNotifica&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:nomeFile"&gt;
                                &lt;tns:nomeFile&gt;
                                    &lt;xsl:value-of select="tns:nomeFile"/&gt;
                                &lt;/tns:nomeFile&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:codOloAgcom"&gt;
                                &lt;tns:codOloAgcom&gt;
                                    &lt;xsl:value-of select="tns:codOloAgcom"/&gt;
                                &lt;/tns:codOloAgcom&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:dimensioneFile"&gt;
                                &lt;tns:dimensioneFile&gt;
                                    &lt;xsl:value-of select="tns:dimensioneFile"/&gt;
                                &lt;/tns:dimensioneFile&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:esitoInvio"&gt;
                                &lt;tns:esitoInvio&gt;
                                    &lt;xsl:value-of select="tns:esitoInvio"/&gt;
                                &lt;/tns:esitoInvio&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:quantitaRecordTotali"&gt;
                                &lt;tns:quantitaRecordTotali&gt;
                                    &lt;xsl:value-of select="tns:quantitaRecordTotali"/&gt;
                                &lt;/tns:quantitaRecordTotali&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:timestampCreazioneFile"&gt;
                                &lt;tns:timestampCreazioneFile&gt;
                                    &lt;xsl:value-of select="tns:timestampCreazioneFile"/&gt;
                                &lt;/tns:timestampCreazioneFile&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:timestampInvio"&gt;
                                &lt;tns:timestampInvio&gt;
                                    &lt;xsl:value-of select="tns:timestampInvio"/&gt;
                                &lt;/tns:timestampInvio&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$VariableAssign1/tns:listaFileNotifiche[tns:posizione = $currentPosition]/tns:idFile"&gt;
                                &lt;tns:idFile&gt;
                                    &lt;xsl:value-of select="$VariableAssign1/tns:listaFileNotifiche[tns:posizione = $currentPosition]/tns:idFile"/&gt;
                                &lt;/tns:idFile&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:listaFileNotifiche&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:if test="$Variable/tns:idExportFile"&gt;
                        &lt;tns:idExportFile&gt;
                            &lt;xsl:value-of select="$Variable/tns:idExportFile"/&gt;
                        &lt;/tns:idExportFile&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:copy-of select="$Variable/tns:result"/&gt;
                &lt;/tns:fileDiNotificheOutput&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160512123101PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;VariableAssign1&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:fileDiNotificheOutput>&#xa;            &lt;xsl:for-each select=&quot;$Variable/tns:listaFileNotifiche&quot;>&#xa;                &lt;tns:listaFileNotifiche>&#xa;                    &lt;xsl:variable name=&quot;currentPosition&quot; select=&quot;current()/tns:posizione&quot;/>&#xa;                    &lt;xsl:if test=&quot;tns:tipoNotifica&quot;>&#xa;                        &lt;tns:tipoNotifica>&#xa;                            &lt;xsl:value-of select=&quot;tns:tipoNotifica&quot;/>&#xa;                        &lt;/tns:tipoNotifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:nomeFile&quot;>&#xa;                        &lt;tns:nomeFile>&#xa;                            &lt;xsl:value-of select=&quot;tns:nomeFile&quot;/>&#xa;                        &lt;/tns:nomeFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:codOloAgcom&quot;>&#xa;                        &lt;tns:codOloAgcom>&#xa;                            &lt;xsl:value-of select=&quot;tns:codOloAgcom&quot;/>&#xa;                        &lt;/tns:codOloAgcom>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:dimensioneFile&quot;>&#xa;                        &lt;tns:dimensioneFile>&#xa;                            &lt;xsl:value-of select=&quot;tns:dimensioneFile&quot;/>&#xa;                        &lt;/tns:dimensioneFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:esitoInvio&quot;>&#xa;                        &lt;tns:esitoInvio>&#xa;                            &lt;xsl:value-of select=&quot;tns:esitoInvio&quot;/>&#xa;                        &lt;/tns:esitoInvio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:quantitaRecordTotali&quot;>&#xa;                        &lt;tns:quantitaRecordTotali>&#xa;                            &lt;xsl:value-of select=&quot;tns:quantitaRecordTotali&quot;/>&#xa;                        &lt;/tns:quantitaRecordTotali>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:timestampCreazioneFile&quot;>&#xa;                        &lt;tns:timestampCreazioneFile>&#xa;                            &lt;xsl:value-of select=&quot;tns:timestampCreazioneFile&quot;/>&#xa;                        &lt;/tns:timestampCreazioneFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:timestampInvio&quot;>&#xa;                        &lt;tns:timestampInvio>&#xa;                            &lt;xsl:value-of select=&quot;tns:timestampInvio&quot;/>&#xa;                        &lt;/tns:timestampInvio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$VariableAssign1/tns:listaFileNotifiche[tns:posizione = $currentPosition]/tns:idFile&quot;>&#xa;                        &lt;tns:idFile>&#xa;                            &lt;xsl:value-of select=&quot;$VariableAssign1/tns:listaFileNotifiche[tns:posizione = $currentPosition]/tns:idFile&quot;/>&#xa;                        &lt;/tns:idFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:listaFileNotifiche>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$Variable/tns:idExportFile&quot;>&#xa;                &lt;tns:idExportFile>&#xa;                    &lt;xsl:value-of select=&quot;$Variable/tns:idExportFile&quot;/>&#xa;                &lt;/tns:idExportFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:copy-of select=&quot;$Variable/tns:result&quot;/>&#xa;        &lt;/tns:fileDiNotificheOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessTogetOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;get_FileNotifiche_InLog_INFO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Info File Di Notifiche:&amp;quot;,string($get/parameters/tns1:filedinotificheGetParameters))&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;            &lt;tns6:ActiveLoggerServices>&#xa;                &lt;tns6:Envelope>&#xa;                    &lt;tns6:Identifier>&#xa;                        &lt;tns6:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.FileDiNotifiche&amp;quot;&quot;/>&#xa;                        &lt;/tns6:ServiceName>&#xa;                        &lt;tns6:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Operation>&#xa;                        &lt;tns6:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns6:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns6:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns5:httpHeaders/GUI-SID,$get/httpHeaders/tns5:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns6:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns6:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns6:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;FileDiNotifiche_&amp;quot;,$get/httpHeaders/tns5:httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:EventType>&#xa;                        &lt;tns6:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;FileDiNotifiche_&amp;quot;,$get/httpHeaders/tns5:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns6:trackID>&#xa;                    &lt;/tns6:Identifier>&#xa;                    &lt;tns6:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns6:track_position>&#xa;                    &lt;tns6:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns6:Timestamp>&#xa;                &lt;/tns6:Envelope>&#xa;            &lt;/tns6:ActiveLoggerServices>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_FileNotifiche_InLog_INFO-input"
                                    name="get_FileNotifiche_InLog_INFO"
                                    tibex:xpdlId="2c153104-e334-46d9-8622-1a7b8a50b5f4"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="get_FileNotifiche_InLog_OLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($Profilo, $get/parameters/tns3:filedinotificheGetParameters/tns3:tipoProfilo)=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($Profilo, $get.parameters/tns3:tipoProfilo)=true()]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="get_FileNotifiche_InLog_NonOlo">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;get_FileNotifiche_InLog_INFO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Info File Di Notifiche:&amp;quot;,string($get.parameters))&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;            &lt;tns6:ActiveLoggerServices>&#xa;                &lt;tns6:Envelope>&#xa;                    &lt;tns6:Identifier>&#xa;                        &lt;tns6:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.FileDiNotifiche&amp;quot;&quot;/>&#xa;                        &lt;/tns6:ServiceName>&#xa;                        &lt;tns6:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Operation>&#xa;                        &lt;tns6:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns6:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns6:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns6:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns6:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns6:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;FileDiNotifiche_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:EventType>&#xa;                        &lt;tns6:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;FileDiNotifiche_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns6:trackID>&#xa;                    &lt;/tns6:Identifier>&#xa;                    &lt;tns6:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns6:track_position>&#xa;                    &lt;tns6:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns6:Timestamp>&#xa;                &lt;/tns6:Envelope>&#xa;            &lt;/tns6:ActiveLoggerServices>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;get_FileNotifiche_InLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Input File Di Notifiche:&amp;quot;,tib:render-xml($get/parameters/tns1:filedinotificheGetParameters, true(),true()))&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;            &lt;tns6:ActiveLoggerServices>&#xa;                &lt;tns6:Envelope>&#xa;                    &lt;tns6:Identifier>&#xa;                        &lt;tns6:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.FileDiNotifiche&amp;quot;&quot;/>&#xa;                        &lt;/tns6:ServiceName>&#xa;                        &lt;tns6:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Operation>&#xa;                        &lt;tns6:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns6:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns6:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns5:httpHeaders/GUI-SID,$get/httpHeaders/tns5:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns6:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns5:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns6:CorrelationID>&#xa