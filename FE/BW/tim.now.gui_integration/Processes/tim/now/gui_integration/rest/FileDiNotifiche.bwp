                            </bpws:empty>
                            <bpws:empty name="OnMessageEnd1"
                                tibex:constructor="onMessageEnd" tibex:xpdlId="b11f09e9-d13d-4c83-9f77-8149553b6f64"/>
                            <bpws:reply name="postOut" operation="post"
                                partnerLink="filedinotifiche"
                                portType="ns:filedinotifiche"
                                tibex:xpdlId="9c2357be-0b32-4c06-957a-9746fd5ca7b6" variable="postOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://xmlns.example.com/20160512123101PLT" xmlns:tns="http://www.tim.com/NOW/rest/fileDiNotifiche" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.example.org/CryptoParams" xmlns:tns5="http://www.example.org/CryptoListParams" version="2.0"&gt;
    &lt;xsl:param name="FileDiNotificheOloQuery"/&gt;
    &lt;xsl:param name="FileDiNotificheNonOlo_Query"/&gt;
    &lt;xsl:param name="fileDiNotificheNonOlo"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="fileDiNotificheOlo"/&gt;
    &lt;xsl:param name="CryptoParams"/&gt;
    &lt;xsl:param name="Variable"/&gt;
    &lt;xsl:param name="CryptoList"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns6:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($post/item/tns:Salvaricerca_Input/tns:exportRequest) and (upper-case($post/item/tns:Salvaricerca_Input/tns:exportRequest) = &amp;quot;S&amp;quot; or upper-case($post/item/tns:Salvaricerca_Input/tns:exportRequest) = &amp;quot;Y&amp;quot;) and (exists($FileDiNotificheOloQuery) or exists($FileDiNotificheNonOlo_Query) or exists($fileDiNotificheNonOlo) or exists($fileDiNotificheOlo))"&gt;
                        &lt;tns:fileDiNotificheOutput&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="$CryptoParams/tns2:idFileCriptato"/&gt;
                            &lt;/tns:idExportFile&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:fileDiNotificheOutput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:fileDiNotificheOutput&gt;
                            &lt;xsl:for-each select="$Variable/tns:listaFileNotifiche"&gt;
                                &lt;tns:listaFileNotifiche&gt;
                                    &lt;xsl:variable name="currPosition" select="current()/tns:posizione"/&gt;
                                    &lt;xsl:if test="tns:tipoNotifica"&gt;
                                        &lt;tns:tipoNotifica&gt;
                                            &lt;xsl:value-of select="tns:tipoNotifica"/&gt;
                                        &lt;/tns:tipoNotifica&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:nomeFile"&gt;
                                        &lt;tns:nomeFile&gt;
                                            &lt;xsl:value-of select="tns:nomeFile"/&gt;
                                        &lt;/tns:nomeFile&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:codOloAgcom"&gt;
                                        &lt;tns:codOloAgcom&gt;
                                            &lt;xsl:value-of select="tns:codOloAgcom"/&gt;
                                        &lt;/tns:codOloAgcom&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:dimensioneFile"&gt;
                                        &lt;tns:dimensioneFile&gt;
                                            &lt;xsl:value-of select="tns:dimensioneFile"/&gt;
                                        &lt;/tns:dimensioneFile&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:esitoInvio"&gt;
                                        &lt;tns:esitoInvio&gt;
                                            &lt;xsl:value-of select="tns:esitoInvio"/&gt;
                                        &lt;/tns:esitoInvio&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:quantitaRecordTotali"&gt;
                                        &lt;tns:quantitaRecordTotali&gt;
                                            &lt;xsl:value-of select="tns:quantitaRecordTotali"/&gt;
                                        &lt;/tns:quantitaRecordTotali&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:timestampCreazioneFile"&gt;
                                        &lt;tns:timestampCreazioneFile&gt;
                                            &lt;xsl:value-of select="tns:timestampCreazioneFile"/&gt;
                                        &lt;/tns:timestampCreazioneFile&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:timestampInvio"&gt;
                                        &lt;tns:timestampInvio&gt;
                                            &lt;xsl:value-of select="tns:timestampInvio"/&gt;
                                        &lt;/tns:timestampInvio&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$CryptoList/tns5:ListIdFileOutput[tns5:position = $currPosition]/tns5:idFileCriptato"&gt;
                                        &lt;tns:idFile&gt;
                                            &lt;xsl:value-of select="$CryptoList/tns5:ListIdFileOutput[tns5:position = $currPosition]/tns5:idFileCriptato"/&gt;
                                        &lt;/tns:idFile&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:listaFileNotifiche&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;xsl:if test="$Variable/tns:idExportFile"&gt;
                                &lt;tns:idExportFile&gt;
                                    &lt;xsl:value-of select="$Variable/tns:idExportFile"/&gt;
                                &lt;/tns:idExportFile&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:copy-of select="$Variable/tns:result"/&gt;
                        &lt;/tns:fileDiNotificheOutput&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns6:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://xmlns.example.com/20160512123101PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/CryptoParams&quot; xmlns:tns5=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;FileDiNotificheOloQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;FileDiNotificheNonOlo_Query&quot;/>&#xa;    &lt;xsl:param name=&quot;fileDiNotificheNonOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;fileDiNotificheOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParams&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoList&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($post.item/tns:exportRequest) and (upper-case($post.item/tns:exportRequest) = &amp;quot;S&amp;quot; or upper-case($post.item/tns:exportRequest) = &amp;quot;Y&amp;quot;) and (exists($FileDiNotificheOloQuery) or exists($FileDiNotificheNonOlo_Query) or exists($fileDiNotificheNonOlo) or exists($fileDiNotificheOlo))&quot;>&#xa;                &lt;tns:fileDiNotificheOutput>&#xa;                    &lt;tns:idExportFile>&#xa;                        &lt;xsl:value-of select=&quot;$CryptoParams/tns2:idFileCriptato&quot;/>&#xa;                    &lt;/tns:idExportFile>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:fileDiNotificheOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:fileDiNotificheOutput>&#xa;                    &lt;xsl:for-each select=&quot;$Variable/tns:listaFileNotifiche&quot;>&#xa;                        &lt;tns:listaFileNotifiche>&#xa;                            &lt;xsl:variable name=&quot;currPosition&quot; select=&quot;current()/tns:posizione&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns:tipoNotifica&quot;>&#xa;                                &lt;tns:tipoNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;tns:tipoNotifica&quot;/>&#xa;                                &lt;/tns:tipoNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:nomeFile&quot;>&#xa;                                &lt;tns:nomeFile>&#xa;                                    &lt;xsl:value-of select=&quot;tns:nomeFile&quot;/>&#xa;                                &lt;/tns:nomeFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:codOloAgcom&quot;>&#xa;                                &lt;tns:codOloAgcom>&#xa;                                    &lt;xsl:value-of select=&quot;tns:codOloAgcom&quot;/>&#xa;                                &lt;/tns:codOloAgcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:dimensioneFile&quot;>&#xa;                                &lt;tns:dimensioneFile>&#xa;                                    &lt;xsl:value-of select=&quot;tns:dimensioneFile&quot;/>&#xa;                                &lt;/tns:dimensioneFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:esitoInvio&quot;>&#xa;                                &lt;tns:esitoInvio>&#xa;                                    &lt;xsl:value-of select=&quot;tns:esitoInvio&quot;/>&#xa;                                &lt;/tns:esitoInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:quantitaRecordTotali&quot;>&#xa;                                &lt;tns:quantitaRecordTotali>&#xa;                                    &lt;xsl:value-of select=&quot;tns:quantitaRecordTotali&quot;/>&#xa;                                &lt;/tns:quantitaRecordTotali>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:timestampCreazioneFile&quot;>&#xa;                                &lt;tns:timestampCreazioneFile>&#xa;                                    &lt;xsl:value-of select=&quot;tns:timestampCreazioneFile&quot;/>&#xa;                                &lt;/tns:timestampCreazioneFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:timestampInvio&quot;>&#xa;                                &lt;tns:timestampInvio>&#xa;                                    &lt;xsl:value-of select=&quot;tns:timestampInvio&quot;/>&#xa;                                &lt;/tns:timestampInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$CryptoList/tns5:ListIdFileOutput[tns5:position = $currPosition]/tns5:idFileCriptato&quot;>&#xa;                                &lt;tns:idFile>&#xa;                                    &lt;xsl:value-of select=&quot;$CryptoList/tns5:ListIdFileOutput[tns5:position = $currPosition]/tns5:idFileCriptato&quot;/>&#xa;                                &lt;/tns:idFile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:listaFileNotifiche>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;$Variable/tns:idExportFile&quot;>&#xa;                        &lt;tns:idExportFile>&#xa;                            &lt;xsl:value-of select=&quot;$Variable/tns:idExportFile&quot;/>&#xa;                        &lt;/tns:idExportFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;$Variable/tns:result&quot;/>&#xa;                &lt;/tns:fileDiNotificheOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess3TopostOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns6=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;post_fileNotifiche_LogInfo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InputFileDiNotifiche:&amp;quot;,tib:render-xml($post/parameters/tns1:filedinotifichePostParameters, true(),true()))&quot;/>&#xa;                &lt;/tns5:Payload>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaContratti&amp;quot;&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns6:httpHeaders/GUI-SID,$post/httpHeaders/tns6:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns5:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns5:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns6:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns5:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;FileDiNotifiche&amp;quot;,$post/httpHeaders/tns6:httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns5:EventType>&#xa;                        &lt;tns5:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;FileDiNotifiche_&amp;quot;,$post/httpHeaders/tns6:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns5:trackID>&#xa;                    &lt;/tns5:Identifier>&#xa;                    &lt;tns5:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns5:track_position>&#xa;                    &lt;tns5:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns5:Timestamp>&#xa;                    &lt;tns5:ErrorLog/>&#xa;                &lt;/tns5:Envelope>&#xa;                &lt;tns5:Playload>&#xa;                    &lt;tns5:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($post/parameters/tns1:filedinotifichePostParameters )))&quot;/>&#xa;                    &lt;/tns5:Binary>&#xa;                    &lt;tns5:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($post/parameters/tns1:filedinotifichePostParameters)&quot;/>&#xa;                    &lt;/tns5:XMLString>&#xa;                &lt;/tns5:Playload>&#xa;            &lt;/tns5:ActiveLoggerServices>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="post_fileNotifiche_LogInfo-input"
                                    name="post_fileNotifiche_LogInfo"
