            &lt;tns:listaFileNotifiche>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR']/value)&quot;>&#xa;                                &lt;tns:tipoNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='DESCR']/value&quot;/>&#xa;                                &lt;/tns:tipoNotifica>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_FILE']/value)&quot;>&#xa;                                &lt;tns:nomeFile>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='NOME_FILE']/value&quot;/>&#xa;                                &lt;/tns:nomeFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&#xa;                                &lt;tns:codOloAgcom>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                                &lt;/tns:codOloAgcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DIMENSIONE_FILE']/value)&quot;>&#xa;                                &lt;tns:dimensioneFile>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='DIMENSIONE_FILE']/value))&quot;/>&#xa;                                &lt;/tns:dimensioneFile>&#