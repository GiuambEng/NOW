                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Profilo&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;fileDiNotificheNonOlo&quot;/>&lt;xsl:param name=&quot;fileDiNotificheOlo&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Profilo, $post/parameters/tns1:filedinotifichePostParameters/tns1:tipoProfilo) = true() and string-length($fileDiNotificheOlo/Record[1]/NOME_FILE)>0&quot;>&lt;tns:fileDiNotificheOutput>&lt;xsl:for-each select=&quot;$fileDiNotificheOlo/Record[(QT_RECD_TOTALI != 0 and COD_INTRFC != ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH')) or (COD_INTRFC = ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH'))]&quot;>&lt;tns:listaFileNotifiche>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:tipoNotifica>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:tipoNotifica>&lt;/xsl:if>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codOloAgcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DIMENSIONE_FILE)&quot;>&lt;tns:dimensioneFile>&lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&lt;/tns:dimensioneFile>&lt;/xsl:if>&lt;xsl:if test=&quot;ESITO_INVIO&quot;>&lt;tns:esitoInvio>&lt;xsl:value-of select=&quot;ESITO_INVIO&quot;/>&lt;/tns:esitoInvio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(QT_RECD_TOTALI)&quot;>&lt;tns:quantitaRecordTotali>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_TOTALI)&quot;/>&lt;/tns:quantitaRecordTotali>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREZIONE_FILE) and string-length(string(TIMSTP_CREZIONE_FILE))>0&quot;>&lt;tns:timestampCreazioneFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:timestampCreazioneFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_CREZIONE_FILE&quot;>&lt;tns:timestampCreazioneFile>&lt;xsl:value-of select=&quot;TIMSTP_CREZIONE_FILE&quot;/>&lt;/tns:timestampCreazioneFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(string(TIMSTP_INVIO))>0&quot;>&lt;tns:timestampInvio>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:timestampInvio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns:timestampInvio>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns:timestampInvio>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(ID_FILE)&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;xsd:int(ID_FILE)&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;/tns:listaFileNotifiche>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($fileDiNotificheOlo/Record)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:fileDiNotificheOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($Profilo, $post/parameters/tns1:filedinotifichePostParameters/tns1:tipoProfilo) = false() and string-length($fileDiNotificheNonOlo/Record[1]/NOME_FILE)>0&quot;>&lt;tns:fileDiNotificheOutput>&lt;xsl:for-each select=&quot;$fileDiNotificheNonOlo/Record&quot;>&lt;tns:listaFileNotifiche>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:tipoNotifica>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:tipoNotifica>&lt;/xsl:if>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codOloAgcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DIMENSIONE_FILE)&quot;>&lt;tns:dimensioneFile>&lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&lt;/tns:dimensioneFile>&lt;/xsl:if>&lt;xsl:if test=&quot;ESITO_INVIO&quot;>&lt;tns:esitoInvio>&lt;xsl:value-of select=&quot;ESITO_INVIO&quot;/>&lt;/tns:esitoInvio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(QT_RECD_TOTALI)&quot;>&lt;tns:quantitaRecordTotali>&lt;xsl:value-of select=&quot;xsd:int(string(QT_RECD_TOTALI))&quot;/>&lt;/tns:quantitaRecordTotali>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREZIONE_FILE) and string-length(string(TIMSTP_CREZIONE_FILE))>0&quot;>&lt;tns:timestampCreazioneFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:timestampCreazioneFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_CREZIONE_FILE&quot;>&lt;tns:timestampCreazioneFile>&lt;xsl:value-of select=&quot;TIMSTP_CREZIONE_FILE&quot;/>&lt;/tns:timestampCreazioneFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(string(TIMSTP_INVIO))>0&quot;>&lt;tns:timestampInvio>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:timestampInvio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns:timestampInvio>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns:timestampInvio>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(ID_FILE)&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;xsd:int(ID_FILE)&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;/tns:listaFileNotifiche>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if (count($fileDiNotificheNonOlo/Record)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:fileDiNotificheOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:fileDiNotificheOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi corrispondenti ai criteri di ricerca&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:fileDiNotificheOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
