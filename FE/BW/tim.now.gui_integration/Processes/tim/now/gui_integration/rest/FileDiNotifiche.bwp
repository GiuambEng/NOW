                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;post_fileNotificheOutput_LogInfo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.FileDiNotifiche&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputFileDiNotifiche:&amp;quot;,substring(tib:render-xml($Variable, true(),true()),1,500),&amp;quot;.....&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.FileDiNotifiche&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;FileDiNotifiche_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;FileDiNotifiche_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog/>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:inputservizioricercaavanzata>&#xa;            &lt;xsl:for-each select=&quot;$post/item/tns:Salvaricerca_Input/tns:strutturaCondition&quot;>&#xa;                &lt;tns4:strutturaCondition>&#xa;                    &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                        &lt;tns4:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                        &lt;/tns4:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:operazione&quot;>&#xa;                        &lt;tns4:operazione>&#xa;                            &lt;xsl:value-of select=&quot;tns:operazione&quot;/>&#xa;                        &lt;/tns4:operazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:valore&quot;>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:tipo&quot;>&#xa;                        &lt;tns4:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns:tipo&quot;/>&#xa;                        &lt;/tns4:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$post/item/tns:Salvaricerca_Input/tns:indiceriga&quot;>&#xa;                &lt;tns4:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns:Salvaricerca_Input/tns:indiceriga&quot;/>&#xa;                &lt;/tns4:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post/item/tns:Salvaricerca_Input/tns:numerorighe&quot;>&#xa;                &lt;tns4:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns:Salvaricerca_Input/tns:numerorighe&quot;/>&#xa;                &lt;/tns4:numerorighe>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post/item/tns:Salvaricerca_Input/tns:exportRequest&quot;>&#xa;                &lt;tns4:exportRequest>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns:Salvaricerca_Input/tns:exportRequest&quot;/>&#xa;                &lt;/tns4:exportRequest>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RicercaAvanzata-input"
                                    name="RicercaAvanzata"
                                    outputVariable="RicercaAvanzata"
                                    tibex:xpdlId="34178870-f481-4669-bf57-068e1d6bd1b0"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="post_fileNotifiche_RicercaAvanzata"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RicercaAvanzataToFileDiNotificheOloQuery_OLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($Profilo, $post/parameters/tns3:filedinotifichePostParameters/tns3:tipoProfilo)=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($Profilo, $post.parameters/tns3:tipoProfilo)=true()]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="RicercaAvanzataToCopy_1_NOOLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:inputservizioricercaavanzata>&#xa;            &lt;xsl:for-each select=&quot;$post.item/tns:strutturaCondition&quot;>&#xa;                &lt;tns4:strutturaCondition>&#xa;                    &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                        &lt;tns4:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                        &lt;/tns4:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:operazione&quot;>&#xa;                        &lt;tns4:operazione>&#xa;                            &lt;xsl:value-of select=&quot;tns:operazione&quot;/>&#xa;                        &lt;/tns4:operazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:valore&quot;>&#xa;                        &lt;tns4:valore>&#xa;                            &lt;xsl:value-of select=&quot;tns:valore&quot;/>&#xa;                        &lt;/tns4:valore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:tipo&quot;>&#xa;                        &lt;tns4:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns:tipo&quot;/>&#xa;                        &lt;/tns4:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:indiceriga&quot;>&#xa;                &lt;tns4:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:indiceriga&quot;/>&#xa;                &lt;/tns4:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:numerorighe&quot;>&#xa;                &lt;tns4:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:numerorighe&quot;/>&#xa;                &lt;/tns4:numerorighe>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:exportRequest&quot;>&#xa;                &lt;tns4:exportRequest>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:exportRequest&quot;/>&#xa;                &lt;/tns4:exportRequest>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_integration.sub.RicercaAvanzataConditions" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cdbc5953-c5b7-425d-8cbe-13b67a94403e+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&lt;xsl:template name=&quot;FileDiNotificheOloQuery-input&quot; match=&quot;/&quot;>&lt;tns3:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT  TF.DESCR,FPO.DIMENSIONE_FILE, FPO.ESITO_INVIO, FPO.QT_RECD_TOTALI, FPO.TIMSTP_CREZIONE_FILE, FPO.TIMSTP_INVIO, FP.NOME_FILE, FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE ,FP.ID_FILE, I.COD_INTRFC FROM   FILE_PROCSTO FP LEFT JOIN  FILE_PROCSTO_OUTPUT FPO ON FP.ID_FILE = FPO.ID_FILE_PROCSTO_OUTPUT LEFT JOIN INTRFC I ON I.ID_INTRFC = FP.ID_INTRFC LEFT JOIN TIPOLG_FILE TF ON TF.IDTPLG_FILE=FP.IDTPLG_FILE WHERE  FP.VERSO_DEL_FILE = 'OUTPUT' AND I.ID_INTRFC NOT IN (341,299,275,272,269,268,191,190,189) AND FP.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;, $post/parameters/tns1:filedinotifichePostParameters/tns1:codOloAgcom, &amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;, $post/parameters/tns1:filedinotifichePostParameters/tns1:codOloAgcom, &amp;quot;'))) AND &amp;quot;,$RicercaAvanzata/tns4:outputcondition[1], &amp;quot; ORDER BY FPO.TIMSTP_INVIO DESC, FPO.QT_RECD_TOTALI FETCH FIRST &amp;quot;, xsd:string($MaxRows), &amp;quot; ROWS ONLY&amp;quot;)&quot;/>&lt;/statement>&lt;/tns3:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="FileDiNotificheOloQuery-input"
                                    name="FileDiNotificheOloQuery"
                                    outputVariable="FileDiNotificheOloQuery"
                                    tibex:xpdlId="cdbc5953-c5b7-425d-8cbe-13b67a94403e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RicercaAvanzataToFileDiNotificheOloQuery_OLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="FileDiNotificheOloQueryToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cdbc5953-c5b7-425d-8cbe-13b67a94403e+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:template name=&quot;FileDiNotificheOloQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT  TF.DESCR,FPO.DIMENSIONE_FILE, FPO.ESITO_INVIO, FPO.QT_RECD_TOTALI, FPO.TIMSTP_CREZIONE_FILE, FPO.TIMSTP_INVIO, FP.NOME_FILE, FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE ,FP.ID_FILE, I.COD_INTRFC FROM   FILE_PROCSTO FP LEFT JOIN  FILE_PROCSTO_OUTPUT FPO ON FP.ID_FILE = FPO.ID_FILE_PROCSTO_OUTPUT LEFT JOIN INTRFC I ON I.ID_INTRFC = FP.ID_INTRFC LEFT JOIN TIPOLG_FILE TF ON TF.IDTPLG_FILE=FP.IDTPLG_FILE WHERE  FP.VERSO_DEL_FILE = 'OUTPUT' AND I.ID_INTRFC NOT IN (341,299,275,272,269,268,191,190,189) AND FP.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;, $post.parameters/tns1:codOloAgcom, &amp;quot;')) OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM = '&amp;quot;, $post.parameters/tns1:codOloAgcom, &amp;quot;'))) AND &amp;quot;,$RicercaAvanzata/tns4:outputcondition[1], &amp;quot; ORDER BY FPO.TIMSTP_INVIO DESC, FPO.QT_RECD_TOTALI FETCH FIRST &amp;quot;, xsd:string($MaxRows), &amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns3:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="FileDiNotificheNonOlo_Query-input"
                                    name="FileDiNotificheNonOlo_Query"
                                    outputVariable="FileDiNotificheNonOlo_Query"
                                    tibex:xpdlId="47263f63-c4e6-41e4-b35b-4a0d02aa1ba2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RicercaAvanzataToCopy_1_NOOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Copy_1_FileDiNotificheOloQueryToCallProcess3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+47263f63-c4e6-41e4-b35b-4a0d02aa1ba2+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:template name=&quot;FileDiNotificheNonOlo_Query-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT  TF.DESCR,FPO.DIMENSIONE_FILE, FPO.ESITO_INVIO, FPO.QT_RECD_TOTALI, FPO.TIMSTP_CREZIONE_FILE, FPO.TIMSTP_INVIO, FP.NOME_FILE, FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE ,FP.ID_FILE, I.COD_INTRFC FROM   FILE_PROCSTO FP LEFT JOIN  FILE_PROCSTO_OUTPUT FPO ON FP.ID_FILE = FPO.ID_FILE_PROCSTO_OUTPUT LEFT JOIN INTRFC I ON I.ID_INTRFC = FP.ID_INTRFC LEFT JOIN TIPOLG_FILE TF ON TF.IDTPLG_FILE=FP.IDTPLG_FILE WHERE  FP.VERSO_DEL_FILE = 'OUTPUT' AND &amp;quot;,$RicercaAvanzata/tns4:outputcondition[1], &amp;quot; AND FP.CODFC_OLO_AGCOM is not NULL ORDER BY FPO.TIMSTP_INVIO DESC, FPO.QT_RECD_TOTALI DESC FETCH FIRST &amp;quot;, xsd:string($MaxRows), &amp;quot; ROWS ONLY&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
