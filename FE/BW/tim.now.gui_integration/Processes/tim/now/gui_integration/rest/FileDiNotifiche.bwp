                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8d8a6193-5ae6-412e-afce-e4eeeb315a09+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;FileDiNotificheOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:filedinotificheGetParameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:filedinotificheGetParameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="FileDiNotificheOlo-input"
                                    name="FileDiNotificheOlo"
                                    outputVariable="FileDiNotificheOlo"
                                    tibex:xpdlId="8d8a6193-5ae6-412e-afce-e4eeeb315a09" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_FileNotifiche_InLog_OLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8d8a6193-5ae6-412e-afce-e4eeeb315a09+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://xmlns.example.com/FileDiNotifiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;FileDiNotificheOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT  TF.DESCR,FPO.DIMENSIONE_FILE, FPO.ESITO_INVIO, FPO.QT_RECD_TOTALI, FPO.TIMSTP_CREZIONE_FILE, FPO.TIMSTP_INVIO, &#xa;FP.NOME_FILE, FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE, FP.ID_FILE, I.COD_INTRFC  &#xa;FROM FILE_PROCSTO FP &#xa;LEFT JOIN FILE_PROCSTO_OUTPUT FPO ON FP.ID_FILE = FPO.ID_FILE_PROCSTO_OUTPUT &#xa;LEFT JOIN INTRFC I ON I.ID_INTRFC = FP.ID_INTRFC&#xa;LEFT JOIN TIPOLG_FILE TF ON TF.IDTPLG_FILE=FP.IDTPLG_FILE&#xa;WHERE FP.VERSO_DEL_FILE = 'OUTPUT' AND I.ID_INTRFC NOT IN (341,299,275,272,269,268,191,190,189)&#xa;AND FP.CODFC_OLO_AGCOM &#xa;IN (SELECT CODFC_OLO_AGCOM&#xa;    FROM OLO&#xa;    WHERE CODFC_OLO_AGCOM IN &#xa;    (SELECT CODFC_OLO_AGCOM&#xa;    FROM OLO&#xa;    WHERE COD_OLO = (SELECT COD_OLO&#xa;                     FROM OLO&#xa;                     WHERE CODFC_OLO_AGCOM = ?)) &#xa;OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM&#xa;                          FROM OLO&#xa;                          WHERE COD_OLO = (SELECT COD_OLO&#xa;                                           FROM OLO&#xa;                                           WHERE CODFC_OLO_AGCOM = ?)))&#xa;ORDER BY FPO.TIMSTP_INVIO DESC, FPO.QT_RECD_TOTALI DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DIMENSIONE_FILE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ESITO_INVIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="QT_RECD_TOTALI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREZIONE_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INVIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDTPLG_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_INTRFC"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="FileDiNotificheNonOlo-input"
                                    name="FileDiNotificheNonOlo"
                                    outputVariable="FileDiNotificheNonOlo"
                                    tibex:xpdlId="979903df-966c-4d9f-8907-46207688dca2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_FileNotifiche_InLog_NonOlo"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+979903df-966c-4d9f-8907-46207688dca2+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT TF.DESCR,FPO.DIMENSIONE_FILE, FPO.ESITO_INVIO, FPO.QT_RECD_TOTALI,&#xa;       FPO.TIMSTP_CREZIONE_FILE, FPO.TIMSTP_INVIO, FP.NOME_FILE,&#xa;       FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE, FP.ID_FILE, I.COD_INTRFC&#xa;FROM FILE_PROCSTO FP&#xa;LEFT JOIN FILE_PROCSTO_OUTPUT FPO ON FP.ID_FILE = FPO.ID_FILE_PROCSTO_OUTPUT&#xa;LEFT JOIN INTRFC I ON I.ID_INTRFC = FP.ID_INTRFC&#xa;LEFT JOIN TIPOLG_FILE TF ON TF.IDTPLG_FILE=FP.IDTPLG_FILE&#xa;WHERE FP.VERSO_DEL_FILE = 'OUTPUT' AND FP.CODFC_OLO_AGCOM is not NULL&#xa;AND (FPO.QT_RECD_TOTALI != 0 and I.COD_INTRFC NOT IN ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','NOTIFICA_REG_NPNG_GIORNALIERA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH')) or (I.COD_INTRFC IN ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','NOTIFICA_REG_NPNG_GIORNALIERA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH'))&#xa;ORDER BY FPO.TIMSTP_INVIO DESC, FPO.QT_RECD_TOTALI DESC&#xa;FETCH FIRST 500 ROWS ONLY" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DIMENSIONE_FILE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ESITO_INVIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="QT_RECD_TOTALI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREZIONE_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INVIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDTPLG_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_INTRFC"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="FileDiNotifiche"
                                    outputVariable="Variable"
                                    tibex:xpdlId="44ff18f1-417e-4955-a33d-ed617b72e1c9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToAssign"/>
                                    <bpws:target linkName="JDBCQuery1ToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="FileDiNotificheToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/fileDiNotifiche&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FileDiNotificheNonOlo&quot;/>&lt;xsl:param name=&quot;FileDiNotificheOlo&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($FileDiNotificheOlo/Record)>0&quot;>&lt;tns:fileDiNotificheOutput>&lt;xsl:for-each select=&quot;$FileDiNotificheOlo/Record[(QT_RECD_TOTALI != 0 and COD_INTRFC != ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH')) or (COD_INTRFC = ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH'))]&quot;>&lt;tns:listaFileNotifiche>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:tipoNotifica>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:tipoNotifica>&lt;/xsl:if>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codOloAgcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DIMENSIONE_FILE)&quot;>&lt;tns:dimensioneFile>&lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&lt;/tns:dimensioneFile>&lt;/xsl:if>&lt;xsl:if test=&quot;ESITO_INVIO&quot;>&lt;tns:esitoInvio>&lt;xsl:value-of select=&quot;ESITO_INVIO&quot;/>&lt;/tns:esitoInvio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(QT_RECD_TOTALI)&quot;>&lt;tns:quantitaRecordTotali>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_TOTALI)&quot;/>&lt;/tns:quantitaRecordTotali>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREZIONE_FILE) and string-length(xsd:string(TIMSTP_CREZIONE_FILE))>0&quot;>&lt;tns:timestampCreazioneFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:timestampCreazioneFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_CREZIONE_FILE&quot;>&lt;tns:timestampCreazioneFile>&lt;xsl:value-of select=&quot;TIMSTP_CREZIONE_FILE&quot;/>&lt;/tns:timestampCreazioneFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns:timestampInvio>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:timestampInvio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns:timestampInvio>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns:timestampInvio>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(ID_FILE)&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;xsd:int(ID_FILE)&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;tns:filtroIdFile>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:filtroIdFile>&lt;tns:posizione>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:posizione>&lt;/tns:listaFileNotifiche>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($FileDiNotificheOlo/Record)>=$MaxRows) then 'LIMIT' else 'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:fileDiNotificheOutput>&lt;/xsl:when>&lt;xsl:when test=&quot;count($FileDiNotificheNonOlo/Record)>0&quot;>&lt;tns:fileDiNotificheOutput>&lt;xsl:for-each select=&quot;$FileDiNotificheNonOlo/Record&quot;>&lt;tns:listaFileNotifiche>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:tipoNotifica>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:tipoNotifica>&lt;/xsl:if>&lt;tns:nomeFile>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:nomeFile>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codOloAgcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DIMENSIONE_FILE)&quot;>&lt;tns:dimensioneFile>&lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&lt;/tns:dimensioneFile>&lt;/xsl:if>&lt;xsl:if test=&quot;ESITO_INVIO&quot;>&lt;tns:esitoInvio>&lt;xsl:value-of select=&quot;ESITO_INVIO&quot;/>&lt;/tns:esitoInvio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(QT_RECD_TOTALI)&quot;>&lt;tns:quantitaRecordTotali>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_TOTALI)&quot;/>&lt;/tns:quantitaRecordTotali>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CREZIONE_FILE) and string-length(xsd:string(TIMSTP_CREZIONE_FILE))>0&quot;>&lt;tns:timestampCreazioneFile>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CREZIONE_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:timestampCreazioneFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_CREZIONE_FILE&quot;>&lt;tns:timestampCreazioneFile>&lt;xsl:value-of select=&quot;TIMSTP_CREZIONE_FILE&quot;/>&lt;/tns:timestampCreazioneFile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;) and exists(TIMSTP_INVIO) and string-length(xsd:string(TIMSTP_INVIO))>0&quot;>&lt;tns:timestampInvio>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_INVIO), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_INVIO), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:timestampInvio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_INVIO&quot;>&lt;tns:timestampInvio>&lt;xsl:value-of select=&quot;TIMSTP_INVIO&quot;/>&lt;/tns:timestampInvio>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(ID_FILE)&quot;>&lt;tns:idFile>&lt;xsl:value-of select=&quot;xsd:int(ID_FILE)&quot;/>&lt;/tns:idFile>&lt;/xsl:if>&lt;tns:filtroIdFile>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:filtroIdFile>&lt;tns:posizione>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:posizione>&lt;/tns:listaFileNotifiche>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($FileDiNotificheNonOlo/Record)>=$MaxRows) then 'LIMIT' else 'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:fileDiNotificheOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:fileDiNotificheOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono file di notifiche&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:fileDiNotificheOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
