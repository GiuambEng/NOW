'CODFC_OLO_AGCOM']/value)&quot;>&#xa;                                &lt;tns:codOloAgcom>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                                &lt;/tns:codOloAgcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DIMENSIONE_FILE']/value)&quot;>&#xa;                                &lt;tns:dimensioneFile>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='DIMENSIONE_FILE']/value))&quot;/>&#xa;                                &lt;/tns:dimensioneFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='ESITO_INVIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ESITO_INVIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ESITO_INVIO']/value)&quot;>&#xa;                                &lt;tns:esitoInvio>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='ESITO_INVIO']/value&quot;/>&#xa;                                &lt;/tns:esitoInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='QT_RECD_TOTALI']/value)&quot;>&#xa;                                &lt;tns:quantitaRecordTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='QT_RECD_TOTALI']/value))&quot;/>&#xa;                                &lt;/tns:quantitaRecordTotali>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(string(column[name='TIMSTP_CREZIONE_FILE']/value), &amp;quot;.&amp;quot;) and exists(column[name='TIMSTP_CREZIONE_FILE']/value) and string-length(string(column[name='TIMSTP_CREZIONE_FILE']/value))>0&quot;>&#xa;                                    &lt;tns:timestampCreazioneFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='TIMSTP_CREZIONE_FILE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='TIMSTP_CREZIONE_FILE']/value), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:timestampCreazioneFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;not((string(column[name='TIMSTP_CREZIONE_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIMSTP_CREZIONE_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIMSTP_CREZIONE_FILE']/value)&quot;>&#xa;                                        &lt;tns:timestampCreazioneFile>&#xa;                                            &lt;xsl:value-of select=&quot;column[name='TIMSTP_CREZIONE_FILE']/value&quot;/>&#xa;                                        &lt;/tns:timestampCreazioneFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(string(column[name='TIMSTP_INVIO']/value), &amp;quot;.&amp;quot;) and exists(column[name='TIMSTP_INVIO']/value) and string-length(string(column[name='TIMSTP_INVIO']/value))>0&quot;>&#xa;                                    &lt;tns:timestampInvio>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='TIMSTP_INVIO']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='TIMSTP_INVIO']/value), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:timestampInvio>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;not((string(column[name='TIMSTP_INVIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIMSTP_INVIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIMSTP_INVIO']/value)&quot;>&#xa;                                        &lt;tns:timestampInvio>&#xa;                                            &lt;xsl:value-of select=&quot;column[name='TIMSTP_INVIO']/value&quot;/>&#xa;                                        &lt;/tns:timestampInvio>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='ID_FILE']/value)&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='ID_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_FILE']/value)&quot;>&#xa;                                    &lt;tns:idFile>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='ID_FILE']/value&quot;/>&#xa;                                    &lt;/tns:idFile>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:posizione>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/tns:posizione>&#xa;                        &lt;/tns:listaFileNotifiche>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($FileDiNotificheOloQuery/unknownResultset/row)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;xsl:if test=&quot;count($FileDiNotificheNonOlo_Query/unknownResultset/row[(column[name='QT_RECD_TOTALI']/value != 0 and column[name='COD_INTRFC']/value != ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH')) or (column[name='COD_INTRFC']/value = ('FILE_NOTIFICA_N_NP_BATCH','FILE_NOTIFICA_NGA_BATCH','FILE_NOTIFICA_R_NP_BATCH','FILE_NOTIFICA_REG_BATCH','FILE_NOTIFICA_XDSL_BATCH','NOTIFICA_ACQ_NGA_GIORNALIERA_BATCH','NOTIFICA_ACQ_NGA_ORARIA_BATCH','NOTIFICA_ACQ_XDSL_GIORNALIERA_BATCH','NOTIFICA_ACQ_XDSL_ORARIA_BATCH','NOTIFICA_N_NP_BATCH','NOTIFICA_NGA_GIORNALIERA_BATCH','NOTIFICA_NGA_ORARIA_BATCH','NOTIFICA_R_NP_BATCH','NOTIFICA_REG_CPS_GIORNALIERA_BATCH','NOTIFICA_REG_CPS_ORARIA_BATCH','NOTIFICA_REG_GIORNALIERA_BATCH','NOTIFICA_REG_MIG_GIORNALIERO_BATCH','NOTIFICA_REG_MIG_ORARIO_BATCH','NOTIFICA_REG_ORARIA_BATCH','NOTIFICA_XDSL_GIORNALIERA_BATCH','NOTIFICA_XDSL_ORARIA_BATCH'))]) = 0&quot;>&#xa;                            &lt;tns:details>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi corrispondenti ai criteri di ricerca&amp;quot;&quot;/>&#xa;                      