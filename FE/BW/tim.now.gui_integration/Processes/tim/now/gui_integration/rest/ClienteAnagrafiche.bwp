    &lt;xsl:param name="CryptoParams"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns5:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="upper-case($post/item/ns4:inputservizioricercaavanzata/ns4:exportRequest)='Y'"&gt;
                        &lt;tns:OutputDettaglioClienteAnagraficheRest&gt;
