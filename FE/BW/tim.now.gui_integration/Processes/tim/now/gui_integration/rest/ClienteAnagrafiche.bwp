                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://xmlns.example.com/20160512111449PLT" version="2.0"&gt;
    &lt;xsl:param name="VariableListaClienteAnagrafiche"/&gt;
    &lt;xsl:template name="getOut-input" match="/"&gt;
        &lt;tns1:getResponse&gt;
            &lt;item&gt;
                &lt;xsl:copy-of select="$VariableListaClienteAnagrafiche"/&gt;
            &lt;/item&gt;
        &lt;/tns1:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160512111449PLT&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VariableListaClienteAnagrafiche&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$VariableListaClienteAnagrafiche&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess3TogetOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ClienteAnagraficheRest&quot; xmlns:tns3=&quot;http://xmlns.example.com/ClienteAnagrafiche/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Profile&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;ListaClienteOLO&quot;/>&lt;xsl:param name=&quot;ListaClienteNoOLO&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;VariableListaClienteAnagrafiche&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Profile, $get/parameters/tns3:clienteanagraficheGetParameters/tns3:tipoProfilo) and string-length($ListaClienteOLO/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&lt;tns:OutputDettaglioClienteAnagraficheRest>&lt;xsl:for-each select=&quot;$ListaClienteOLO/Record&quot;>&lt;tns:OutputDettaglioClienteAnagraficheRest>&lt;tns:nome>&lt;xsl:value-of select=&quot;NOME&quot;/>&lt;/tns:nome>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&lt;/tns:ragioneSociale>&lt;xsl:if test=&quot;INDIRIZZO_EMAIL&quot;>&lt;tns:indirizzoEmail>&lt;xsl:value-of select=&quot;INDIRIZZO_EMAIL&quot;/>&lt;/tns:indirizzoEmail>&lt;/xsl:if>&lt;tns:partitaIva>&lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&lt;/tns:partitaIva>&lt;tns:flagSanMarino>&lt;xsl:value-of select=&quot;FLAG_SAN_MARINO&quot;/>&lt;/tns:flagSanMarino>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:codiceOlo>&lt;tns:codificaAgcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codificaAgcom>&lt;xsl:if test=&quot;CODFC_OLO_RETE&quot;>&lt;tns:codificaOloRete>&lt;xsl:value-of select=&quot;CODFC_OLO_RETE&quot;/>&lt;/tns:codificaOloRete>&lt;/xsl:if>&lt;xsl:if test=&quot;IDTPLG_OLO&quot;>&lt;tns:tipologiaOlo>&lt;xsl:value-of select=&quot;IDTPLG_OLO&quot;/>&lt;/tns:tipologiaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_OLO_ACCORPANTE&quot;>&lt;tns:nomeAccorpante>&lt;xsl:value-of select=&quot;COD_OLO_ACCORPANTE&quot;/>&lt;/tns:nomeAccorpante>&lt;/xsl:if>&lt;tns:moroso>&lt;xsl:value-of select=&quot;MOROSO&quot;/>&lt;/tns:moroso>&lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&lt;tns:flagOloAccorpante>&lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&lt;/tns:flagOloAccorpante>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATA_ACCORPTO) and string-length(string(DATA_ACCORPTO))>0&quot;>&lt;tns:dataAccorpamento>&lt;xsl:value-of select=&quot;substring-before( string (DATA_ACCORPTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataAccorpamento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATA_AGGTO) and string-length(string(DATA_AGGTO))>0&quot;>&lt;tns:DataUltimoAggiornamento>&lt;xsl:value-of select=&quot;substring-before( string (DATA_AGGTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DataUltimoAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_ACCORPTO&quot;>&lt;tns:statoAccorpamento>&lt;xsl:value-of select=&quot;STATO_ACCORPTO&quot;/>&lt;/tns:statoAccorpamento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_INSMTO) and string-length(string(TIMSTP_INSMTO))>0&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;substring-before( string (TIMSTP_INSMTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;tns:operatore>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/tns:operatore>&lt;/tns:OutputDettaglioClienteAnagraficheRest>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($ListaClienteOLO/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:OutputDettaglioClienteAnagraficheRest>&lt;/xsl:when>&lt;xsl:when test=&quot;not(contains($Profile, $get/parameters/tns3:clienteanagraficheGetParameters/tns3:tipoProfilo)) and string-length($ListaClienteNoOLO/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&lt;tns:OutputDettaglioClienteAnagraficheRest>&lt;xsl:for-each select=&quot;$ListaClienteNoOLO/Record&quot;>&lt;tns:OutputDettaglioClienteAnagraficheRest>&lt;tns:nome>&lt;xsl:value-of select=&quot;NOME&quot;/>&lt;/tns:nome>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&lt;/tns:ragioneSociale>&lt;xsl:if test=&quot;INDIRIZZO_EMAIL&quot;>&lt;tns:indirizzoEmail>&lt;xsl:value-of select=&quot;INDIRIZZO_EMAIL&quot;/>&lt;/tns:indirizzoEmail>&lt;/xsl:if>&lt;tns:partitaIva>&lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&lt;/tns:partitaIva>&lt;tns:flagSanMarino>&lt;xsl:value-of select=&quot;FLAG_SAN_MARINO&quot;/>&lt;/tns:flagSanMarino>&lt;tns:codiceOlo>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:codiceOlo>&lt;tns:codificaAgcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codificaAgcom>&lt;xsl:if test=&quot;CODFC_OLO_RETE&quot;>&lt;tns:codificaOloRete>&lt;xsl:value-of select=&quot;CODFC_OLO_RETE&quot;/>&lt;/tns:codificaOloRete>&lt;/xsl:if>&lt;xsl:if test=&quot;IDTPLG_OLO&quot;>&lt;tns:tipologiaOlo>&lt;xsl:value-of select=&quot;IDTPLG_OLO&quot;/>&lt;/tns:tipologiaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_OLO_ACCORPANTE&quot;>&lt;tns:nomeAccorpante>&lt;xsl:value-of select=&quot;COD_OLO_ACCORPANTE&quot;/>&lt;/tns:nomeAccorpante>&lt;/xsl:if>&lt;tns:moroso>&lt;xsl:value-of select=&quot;MOROSO&quot;/>&lt;/tns:moroso>&lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&lt;tns:flagOloAccorpante>&lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&lt;/tns:flagOloAccorpante>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATA_ACCORPTO) and string-length(string(DATA_ACCORPTO))>0&quot;>&lt;tns:dataAccorpamento>&lt;xsl:value-of select=&quot;substring-before( string (DATA_ACCORPTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataAccorpamento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATA_AGGTO) and string-length(string(DATA_AGGTO))>0&quot;>&lt;tns:DataUltimoAggiornamento>&lt;xsl:value-of select=&quot;substring-before( string (DATA_AGGTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DataUltimoAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_ACCORPTO&quot;>&lt;tns:statoAccorpamento>&lt;xsl:value-of select=&quot;STATO_ACCORPTO&quot;/>&lt;/tns:statoAccorpamento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_INSMTO) and string-length(string(TIMSTP_INSMTO))>0&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;substring-before( string (TIMSTP_INSMTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;tns:operatore>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/tns:operatore>&lt;/tns:OutputDettaglioClienteAnagraficheRest>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($ListaClienteNoOLO/Record)&amp;lt;$MaxRows) then 'OK' else  'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:OutputDettaglioClienteAnagraficheRest>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputDettaglioClienteAnagraficheRest>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:OutputDettaglioClienteAnagraficheRest>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
