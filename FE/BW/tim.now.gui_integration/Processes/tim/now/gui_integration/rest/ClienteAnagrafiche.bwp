    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>post</variable>
                <variable>LoggerName</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
            </endingVariables>
        </task>
        <task name="ListaClienteAnagrafiche">
            <endingVariables>
                <variable>Profile</variable>
                <variable>MaxRows</variable>
                <variable>ListaClienteNoOLO</variable>
            </endingVariables>
        </task>
        <task name="get_ClienteAnag_InLog_INFO">
            <endingVariables>
                <variable>get_ClienteAnag_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="get_ClienteAnag_InLog">
            <endingVariables>
                <variable>get_ClienteAnag_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="get_ClienteAnag_outp_Log">
            <endingVariables>
                <variable>get_ClienteAnag_outp_Log-input</variable>
                <variable>LoggerInfo</variable>
                <variable>ListaClienteOLO</variable>
            </endingVariables>
        </task>
        <task name="ListaClienteOLO">
