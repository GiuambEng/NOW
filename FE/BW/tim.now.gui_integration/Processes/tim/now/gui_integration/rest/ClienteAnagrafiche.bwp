                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns3=&quot;http://xmlns.example.com/ClienteAnagrafiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;Profile&quot;/>&#xa;    &lt;xsl:template name=&quot;post_ClienteAnag_outp_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ClienteAnagrafiche&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.ClienteAnagrafiche&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($Profile,$post/parameters/tns3:clienteanagrafichePostParameters/tns3:tipoProfilo)&quot;>&#xa;                        &lt;tns4:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot; Profilo=TipoProfilo:&amp;quot;, &amp;quot; SELECT R.COD_ORDN_OLO_PADRE,O.COD_OLO, O.COD_OLO_ACCORPANTE ,O.CODFC_OLO_AGCOM, O.CODFC_OLO_RETE,O.DATA_ACCORPTO,O.DATA_AGGTO, O.FLAG_OLO_ACCORPANTE , O.FLAG_OLO_TRANSITORIO, O.FLAG_SAN_MARINO,T.DESCR IDTPLG_OLO, O.INDIRIZZO_EMAIL,O.MOROSO,O.NOME,O.OPERATORE, O.PARTITA_IVA,O.RAGIONE_SOCIALE,O.STATO_ACCORPTO, O.TIMSTP_INSMTO FROM OLO O  LEFT JOIN RICH_OLO_STORICO R ON O.CODFC_OLO_AGCOM=R.CODFC_OLO_AGCOM&amp;quot;, &amp;#xD;&amp;#xA;&amp;quot;LEFT JOIN TIPOLG_OLO T ON O.IDTPLG_OLO=T.IDTPLG_OLO&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot;WHERE O.CODFC_OLO_AGCOM=codOloAgcom, OR O.COD_OLO_ACCORPANTE=codOloAgcom AND outputcondition[1] &amp;quot;)&quot;/>&#xa;                        &lt;/tns4:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Payload>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OutputLogSQLClienteAnagrafiche: SELECT R.COD_ORDN_OLO_PADRE, O.COD_OLO,O.COD_OLO_ACCORPANTE, O.CODFC_OLO_AGCOM, O.CODFC_OLO_RETE, O.DATA_ACCORPTO, O.DATA_AGGTO, O.FLAG_OLO_ACCORPANTE, O.FLAG_OLO_TRANSITORIO, O.FLAG_SAN_MARINO, T.DESCR IDTPLG_OLO, O.INDIRIZZO_EMAIL, O.MOROSO, O.NOME, O.OPERATORE, O.PARTITA_IVA, O.RAGIONE_SOCIALE, O.STATO_ACCORPTO, O.TIMSTP_INSMTO  FROM OLO O LEFT JOIN RICH_OLO_STORICO R ON O.CODFC_OLO_AGCOM=R.CODFC_OLO_AGCOM  LEFT JOIN TIPOLG_OLO T ON O.IDTPLG_OLO = T.IDTPLG_OLO  WHERE O.CODFC_OLO_AGCOM = codOloAgcom,  OR O.COD_OLO_ACCORPANTE = codOloAgcom&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                  