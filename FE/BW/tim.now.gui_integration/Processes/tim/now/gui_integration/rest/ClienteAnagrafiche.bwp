                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns3=&quot;http://xmlns.example.com/ClienteAnagrafiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaClienteOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;get_ClienteAnag_outp_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ClienteAnagrafiche&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.rest.ClienteAnagrafiche&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ListaClienteOLO/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&#xa;                        &lt;tns2:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputSQLListaClienteAnagraficheOLO:&amp;quot;, &amp;quot;SELECT FLAG_OLO_ACCORPANTE FROM OLO WHERE CODFC_OLO_AGCOM ='&amp;quot;,$get/parameters/tns3:clienteanagraficheGetParameters/tns3:codOloAgcom,&amp;quot;'&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Payload>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OutputSQLListaClienteAnagrafiche: SELECT R.COD_ORDN_OLO_PADRE, O.COD_OLO ,O.COD_OLO_ACCORPANTE, &amp;#xD;&amp;#xA;O.CODFC_OLO_AGCOM, O.CODFC_OLO_RETE, O.DATA_ACCORPTO, O.DATA_AGGTO, O.FLAG_OLO_ACCORPANTE, O.FLAG_OLO_TRANSITORIO, &amp;#xD;&amp;#xA;O.FLAG_SAN_MARINO, T.DESCR IDTPLG_OLO, O.INDIRIZZO_EMAIL, O.MOROSO, O.NOME, O.OPERATORE, O.PARTITA_IVA, O.RAGIONE_SOCIALE, &amp;#xD;&amp;#xA;O.STATO_ACCORPTO, O.TIMSTP_INSMTO &amp;#xD;&amp;#xA;FROM OLO O LEFT JOIN RICH_OLO_STORICO R ON O.CODFC_OLO_AGCOM = R.CODFC_OLO_AGCOM &amp;#xD;&amp;#xA;LEFT JOIN TIPOLG_OLO T ON O.IDTPLG_OLO = T.IDTPLG_OLO WHERE O.CODFC_OLO_AGCOM OR O.COD_OLO_ACCORPANTE&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.ClienteAnagrafiche&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns1:httpHeaders/GUI-SID,$get/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ClienteAnagrafiche_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ClienteAnagrafiche_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
