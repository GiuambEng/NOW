                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ClienteAnagraficheRest&quot; xmlns:tns3=&quot;http://xmlns.example.com/ClienteAnagrafiche/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns4=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;getListaClienteAnagraficheRicercaAvanzata&quot;/>&lt;xsl:param name=&quot;Profile&quot;/>&lt;xsl:param name=&quot;JDBCnoOLOquery&quot;/>&lt;xsl:param name=&quot;JDBCOLOquery&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;VariableListaClienteAnagrafiche&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($getListaClienteAnagraficheRicercaAvanzata/unknownResultset/row[1]/column[name='COD_OLO']/value))!=0 and string-length($post/item/ns4:inputservizioricercaavanzata/ns4:strutturaCondition[1]/ns4:nome)!=0&quot;>&lt;tns:OutputDettaglioClienteAnagraficheRest>&lt;xsl:for-each select=&quot;$getListaClienteAnagraficheRicercaAvanzata/unknownResultset/row&quot;>&lt;tns:OutputDettaglioClienteAnagraficheRest>&lt;xsl:if test=&quot;not((string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME']/value)&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;column[name='NOME']/value&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='RAGIONE_SOCIALE']/value)&quot;>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;column[name='RAGIONE_SOCIALE']/value&quot;/>&lt;/