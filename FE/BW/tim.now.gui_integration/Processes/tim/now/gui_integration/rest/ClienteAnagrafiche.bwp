                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://xmlns.example.com/20160512111449PLT" xmlns:tns="http://www.tim.com/NOW/xsd/ClienteAnagraficheRest" xmlns:ns4="http://www.tim.com/NOW/rest/servizioricercaavanzata" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns4="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="VariableListaClienteAnagrafiche"/&gt;
