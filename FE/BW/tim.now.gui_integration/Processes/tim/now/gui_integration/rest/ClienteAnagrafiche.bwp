                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="get_ClienteAnag_ErrorLog">
            <endingVariables>
                <variable>get_ClienteAnag_ErrorLog-input</variable>
                <variable>LoggerError</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>CryptoParams</variable>
            </endingVariables>
        </task>
        <task name="RicercaAvanzata">
            <endingVariables>
                <variable>RicercaAvanzata-input</variable>
            </endingVariables>
        </task>
        <task name="getListaClienteAnagraficheRicercaAvanzata">
            <endingVariables>
                <variable>getListaClienteAnagraficheRicercaAvanzata-input</variable>
                <variable>RicercaAvanzata</variable>
            </endingVariables>
        </task>
        <task name="ListaClienteAnagraficheRicercaAvanzata">
            <endingVariables>
                <variable>getListaClienteAnagraficheRicercaAvanzata</variable>
                <variable>MaxRows</variable>
                <variable>JDBCOLOquery</variable>
                <variable>JDBCnoOLOquery</variable>
            </endingVariables>
        </task>
        <task name="post_ClienteAnag_InLog">
            <endingVariables>
                <variable>post_ClienteAnag_InLog-input</variable>
                <variable>LoggerMsg</variable>
            </endingVariables>
        </task>
        <task name="post_ClienteAnag_InLog_INFO">
            <endingVariables>
                <variable>post_ClienteAnag_InLog_INFO-input</variable>
            </endingVariables>
        </task>
        <task name="post_ClienteAnag_outp_Log">
            <endingVariables>
                <variable>post_ClienteAnag_outp_Log-input</variable>
                <variable>Profile</variable>
                <variable>LoggerInfo</variable>
            </endingVariables>
        </task>
        <task name="JDBCQuery">
            <endingVariables>
                <variable>JDBCQuery-input</variable>
            </endingVariables>
        </task>
        <task name="RenderXml">
            <endingVariables>
                <variable>RenderXml-input</variable>
            </endingVariables>
        </task>
        <task name="ExportData">
            <endingVariables>
                <variable>ExportData-input</variable>
                <variable>RenderXml</variable>
