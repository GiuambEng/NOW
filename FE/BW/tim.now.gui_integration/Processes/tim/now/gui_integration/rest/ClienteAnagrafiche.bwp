ilo&quot;/>&#xa;            &lt;/tns2:tipoProfilo>&#xa;            &lt;tns2:childElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;outputListaClienteAnagraficheRest&amp;quot;&quot;/>&#xa;            &lt;/tns2:childElement>&#xa;        &lt;/tns2:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
