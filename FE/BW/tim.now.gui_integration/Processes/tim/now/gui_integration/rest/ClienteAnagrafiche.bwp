CCORPTO ,O.DATA_AGGTO ,O.FLAG_OLO_ACCORPANTE ,O.FLAG_OLO_TRANSITORIO ,O.FLAG_SAN_MARINO ,T.DESCR IDTPLG_OLO ,O.INDIRIZZO_EMAIL ,O.MOROSO ,O.NOME ,O.OPERATORE ,O.PARTITA_IVA,O.RAGIONE_SOCIALE,O.STATO_ACCORPTO,O.TIMSTP_INSMTO FROM OLO O LEFT JOIN TIPOLG_OLO T ON O.IDTPLG_OLO = T.IDTPLG_OLO WHERE &amp;quot;, $RicercaAvanzata/ns4:outputcondition[1])&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
