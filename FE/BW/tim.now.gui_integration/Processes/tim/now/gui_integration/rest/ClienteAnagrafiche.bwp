            </endingVariables>
        </task>
        <task name="JDBCnoOLOquery">
            <endingVariables>
                <variable>JDBCnoOLOquery-input</variable>
            </endingVariables>
        </task>
        <task name="CryptoParams">
            <endingVariables>
                <variable>CryptoParams-input</variable>
                <variable>JDBCQuery</variable>
            </endingVariables>
        </task>
        <task name="Reply">
            <endingVariables>
                <variable>Reply-input</variable>
                <variable>FaultDetails1</variable>
