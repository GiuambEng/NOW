                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ac6870f2-7314-42b9-80f4-b6305d8bd31f+input&quot; xmlns:tns3=&quot;http://xmlns.example.com/ClienteAnagrafiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codOLOAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns3:codOloAgcom&quot;/>&#xa;            &lt;/codOLOAgcom>&#xa;            &lt;codOLOAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns3:codOloAgcom&quot;/>&#xa;            &lt;/codOLOAgcom2>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
