                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ClienteAnagraficheRest&quot; xmlns:tns3=&quot;http://xmlns.example.com/ClienteAnagrafiche/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns4=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;getListaClienteAnagraficheRicercaAvanzata&quot;/>&#xa;    &lt;xsl:param name=&quot;Profile&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCnoOLOquery&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCOLOquery&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableListaClienteAnagrafiche&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length(string($getListaClienteAnagraficheRicercaAvanzata/unknownResultset/row[1]/column[name='COD_OLO']/value))!=0 and string-length($post.item/ns4:strutturaCondition[1]/ns4:nome)!=0&quot;>&#xa;                &lt;tns:OutputDettaglioClienteAnagraficheRest>&#xa;                    &lt;xsl:for-each select=&quot;$getListaClienteAnagraficheRicercaAvanzata/unknownResultset/row&quot;>&#xa;                        &lt;tns:OutputDettaglioClienteAnagraficheRest>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME']/value)&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='NOME']/value&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='RAGIONE_SOCIALE']/value)&quot;>&#xa;                                &lt;tns:ragioneSociale>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='RAGIONE_SOCIALE']/value&quot;/>&#xa;                                &lt;/tns:ragioneSociale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='INDIRIZZO_EMAIL']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='INDIRIZZO_EMAIL']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='INDIRIZZO_EMAIL']/value)&quot;>&#xa;                                &lt;tns:indirizzoEmail>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='INDIRIZZO_EMAIL']/value&quot;/>&#xa;                                &lt;/tns:indirizzoEmail>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='PARTITA_IVA']/value)&quot;>&#xa;                                &lt;tns:partitaIva>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='PARTITA_IVA']/value&quot;/>&#xa;                                &lt;/tns:partitaIva>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_SAN_MARINO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_SAN_MARINO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_SAN_MARINO']/value)&quot;>&#xa;                                &lt;tns:flagSanMarino>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_SAN_MARINO']/value&quot;/>&#xa;                                &lt;/tns:flagSanMarino>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO']/value)&quot;>&#xa;                                &lt;tns:codiceOlo>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='COD_OLO']/value&quot;/>&#xa;                                &lt;/tns:codiceOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&#xa;                                &lt;tns:codificaAgcom>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                                &lt;/tns:codificaAgcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_RETE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_RETE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_RETE']/value)&quot;>&#xa;                                &lt;tns:codificaOloRete>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_RETE']/value&quot;/>&#xa;                                &lt;/tns:codificaOloRete>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='IDTPLG_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDTPLG_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDTPLG_OLO']/value)&quot;>&#xa;                                &lt;tns:tipologiaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='IDTPLG_OLO']/value&quot;/>&#xa;                                &lt;/tns:tipologiaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='COD_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO_ACCORPANTE']/value)&quot;>&#xa;                                &lt;tns:nomeAccorpante>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='COD_OLO_ACCORPANTE']/value&quot;/>&#xa;                                &lt;/tns:nomeAccorpante>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='MOROSO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='MOROSO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='MOROSO']/value)&quot;>&#xa;                                &lt;tns:moroso>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='MOROSO']/value&quot;/>&#xa;                                &lt;/tns:moroso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_OLO_ACCORPANTE']/value)&quot;>&#xa;                                &lt;tns:flagOloAccorpante>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_OLO_ACCORPANTE']/value&quot;/>&#xa;                                &lt;/tns:flagOloAccorpante>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name= 'DATA_ACCORPTO']/value)&quot;>&#xa;                                &lt;tns:dataAccorpamento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string (column[name= 'DATA_ACCORPTO']/value ),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataAccorpamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DATA_AGGTO']/value)&quot;>&#xa;                                &lt;tns:DataUltimoAggiornamento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_AGGTO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:DataUltimoAggiornamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='STATO_ACCORPTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO_ACCORPTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO_ACCORPTO']/value)&quot;>&#xa;                                &lt;tns:statoAccorpamento>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='STATO_ACCORPTO']/value&quot;/>&#xa;                                &lt;/tns:statoAccorpamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='TIMSTP_INSMTO']/value)&quot;>&#xa;                                &lt;tns:dataInserimento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_INSMTO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataInserimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OPERATORE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OPERATORE']/value)&quot;>&#xa;                                &lt;tns:operatore>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='OPERATORE']/value&quot;/>&#xa;                                &lt;/tns:operatore>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:OutputDettaglioClienteAnagraficheRest>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($getListaClienteAnagraficheRicercaAvanzata/unknownResultset/row)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputDettaglioClienteAnagraficheRest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;contains($Profile, $post.parameters/tns3:tipoProfilo) and string-length($post.item/ns4:strutturaCondition[1]/ns4:nome)=0 and string-length($JDBCOLOquery/Record[1]/COD_OLO)>0&quot;>&#xa;                &lt;tns:OutputDettaglioClienteAnagraficheRest>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCOLOquery/Record&quot;>&#xa;                        &lt;tns:OutputDettaglioClienteAnagraficheRest>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                            &lt;tns:ragioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                            &lt;/tns:ragioneSociale>&#xa;                            &lt;xsl:if test=&quot;INDIRIZZO_EMAIL&quot;>&#xa;                                &lt;tns:indirizzoEmail>&#xa;                                    &lt;xsl:value-of select=&quot;INDIRIZZO_EMAIL&quot;/>&#xa;                                &lt;/tns:indirizzoEmail>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:partitaIva>&#xa;                                &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&#xa;                            &lt;/tns:partitaIva>&#xa;                            &lt;tns:flagSanMarino>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_SAN_MARINO&quot;/>&#xa;                            &lt;/tns:flagSanMarino>&#xa;                            &lt;tns:codiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                            &lt;/tns:codiceOlo>&#xa;                            &lt;tns:codificaAgcom>&#xa;                                &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns:codificaAgcom>&#xa;                            &lt;xsl:if test=&quot;CODFC_OLO_RETE&quot;>&#xa;                                &lt;tns:codificaOloRete>&#xa;                                    &lt;xsl:value-of select=&quot;CODFC_OLO_RETE&quot;/>&#xa;                                &lt;/tns:codificaOloRete>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDTPLG_OLO&quot;>&#xa;                                &lt;tns:tipologiaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;IDTPLG_OLO&quot;/>&#xa;                                &lt;/tns:tipologiaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COD_OLO_ACCORPANTE&quot;>&#xa;                                &lt;tns:nomeAccorpante>&#xa;                                    &lt;xsl:value-of select=&quot;COD_OLO_ACCORPANTE&quot;/>&#xa;                                &lt;/tns:nomeAccorpante>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:moroso>&#xa;                                &lt;xsl:value-of select=&quot;MOROSO&quot;/>&#xa;                            &lt;/tns:moroso>&#xa;                            &lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&#xa;                                &lt;tns:flagOloAccorpante>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&#xa;                                &lt;/tns:flagOloAccorpante>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DATA_ACCORPTO) and string-length( string(DATA_ACCORPTO))>0&quot;>&#xa;                                &lt;tns:dataAccorpamento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(DATA_ACCORPTO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataAccorpamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DATA_AGGTO) and string-length(string(DATA_AGGTO))>0&quot;>&#xa;                                &lt;tns:DataUltimoAggiornamento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(DATA_AGGTO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:DataUltimoAggiornamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATO_ACCORPTO&quot;>&#xa;                                &lt;tns:statoAccorpamento>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_ACCORPTO&quot;/>&#xa;                                &lt;/tns:statoAccorpamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(TIMSTP_INSMTO) and string-length( string(TIMSTP_INSMTO))>0&quot;>&#xa;                                &lt;tns:dataInserimento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_INSMTO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataInserimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:operatore>&#xa;                                &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                            &lt;/tns:operatore>&#xa;                        &lt;/tns:OutputDettaglioClienteAnagraficheRest>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($JDBCOLOquery/Record)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputDettaglioClienteAnagraficheRest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not(contains($Profile, $post.parameters/tns3:tipoProfilo)) and string-length($post.item/ns4:strutturaCondition[1]/ns4:nome)=0 and string-length($JDBCnoOLOquery/Record[1]/COD_OLO)>0&quot;>&#xa;                &lt;tns:OutputDettaglioClienteAnagraficheRest>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCnoOLOquery/Record&quot;>&#xa;                        &lt;tns:OutputDettaglioClienteAnagraficheRest>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                            &lt;tns:ragioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                            &lt;/tns:ragioneSociale>&#xa;                            &lt;xsl:if test=&quot;INDIRIZZO_EMAIL&quot;>&#xa;                                &lt;tns:indirizzoEmail>&#xa;                                    &lt;xsl:value-of select=&quot;INDIRIZZO_EMAIL&quot;/>&#xa;                                &lt;/tns:indirizzoEmail>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:partitaIva>&#xa;                                &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&#xa;                            &lt;/tns:partitaIva>&#xa;                            &lt;tns:flagSanMarino>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_SAN_MARINO&quot;/>&#xa;                            &lt;/tns:flagSanMarino>&#xa;                            &lt;tns:codiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                            &lt;/tns:codiceOlo>&#xa;                            &lt;tns:codificaAgcom>&#xa;                                &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns:codificaAgcom>&#xa;                            &lt;xsl:if test=&quot;CODFC_OLO_RETE&quot;>&#xa;                                &lt;tns:codificaOloRete>&#xa;                                    &lt;xsl:value-of select=&quot;CODFC_OLO_RETE&quot;/>&#xa;                                &lt;/tns:codificaOloRete>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDTPLG_OLO&quot;>&#xa;                                &lt;tns:tipologiaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;IDTPLG_OLO&quot;/>&#xa;                                &lt;/tns:tipologiaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COD_OLO_ACCORPANTE&quot;>&#xa;                                &lt;tns:nomeAccorpante>&#xa;                                    &lt;xsl:value-of select=&quot;COD_OLO_ACCORPANTE&quot;/>&#xa;                                &lt;/tns:nomeAccorpante>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:moroso>&#xa;                                &lt;xsl:value-of select=&quot;MOROSO&quot;/>&#xa;                            &lt;/tns:moroso>&#xa;                            &lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&#xa;                                &lt;tns:flagOloAccorpante>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&#xa;                                &lt;/tns:flagOloAccorpante>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DATA_ACCORPTO) and string-length( string(DATA_ACCORPTO))>0&quot;>&#xa;                                &lt;tns:dataAccorpamento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(DATA_ACCORPTO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataAccorpamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DATA_AGGTO) and string-length(string(DATA_AGGTO))>0&quot;>&#xa;                                &lt;tns:DataUltimoAggiornamento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(DATA_AGGTO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:DataUltimoAggiornamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATO_ACCORPTO&quot;>&#xa;                                &lt;tns:statoAccorpamento>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_ACCORPTO&quot;/>&#xa;                                &lt;/tns:statoAccorpamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(TIMSTP_INSMTO) and string-length( string(TIMSTP_INSMTO))>0&quot;>&#xa;                                &lt;tns:dataInserimento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_INSMTO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataInserimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:operatore>&#xa;                                &lt;xsl:value-of select=&quot;OPERATORE&quot;/>&#xa;                            &lt;/tns:operatore>&#xa;                        &lt;/tns:OutputDettaglioClienteAnagraficheRest>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($JDBCnoOLOquery/Record)>=$MaxRows) then 'LIMIT' else &amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputDettaglioClienteAnagraficheRest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:OutputDettaglioClienteAnagraficheRest>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:OutputDettaglioClienteAnagraficheRest>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VariableListaClienteAnagrafiche" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
