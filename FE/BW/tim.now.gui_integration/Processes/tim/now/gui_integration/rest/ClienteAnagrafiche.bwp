uot; SELECT R.COD_ORDN_OLO_PADRE,O.COD_OLO, O.COD_OLO_ACCORPANTE ,O.CODFC_OLO_AGCOM, O.CODFC_OLO_RETE,O.DATA_ACCORPTO,O.DATA_AGGTO, O.FLAG_OLO_ACCORPANTE , O.FLAG_OLO_TRANSITORIO, O.FLAG_SAN_MARINO,T.DESCR IDTPLG_OLO, O.INDIRIZZO_EMAIL,O.MOROSO,O.NOME,O.OPERATORE, O.PARTITA_IVA,O.RAGIONE_SOCIALE,O.STATO_ACCORPTO, O.TIMSTP_INSMTO FROM OLO O  LEFT JOIN RICH_OLO_STORICO R ON O.CODFC_OLO_AGCOM=R.CODFC_OLO_AGCOM&amp;quot;, &amp;#xD;&amp;#xA;&amp;quot;LEFT JOIN TIPOLG_OLO T ON O.IDTPLG_OLO=T.IDTPLG_OLO&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot;WHERE O.CODFC_OLO_AGCOM=codOloAgcom, OR O.COD_OLO_ACCORPANTE=codOloAgcom AND outputcondition[1] &amp;quot;)&quot;/>&#xa;                        &lt;/tns4:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Payload>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OutputLogSQLClienteAnagrafiche: SELECT R.COD_ORDN_OLO_PADRE, O.COD_OLO,O.COD_OLO_ACCORPANTE, O.CODFC_OLO_AGCOM, O.CODFC_OLO_RETE, O.DATA_ACCORPTO, O.DATA_AGGTO, O.FLAG_OLO_ACCORPANTE, O.FLAG_OLO_TRANSITORIO, O.FLAG_SAN_MARINO, T.DESCR IDTPLG_OLO, O.INDIRIZZO_EMAIL, O.MOROSO, O.NOME, O.OPERATORE, O.PARTITA_IVA, O.RAGIONE_SOCIALE, O.STATO_ACCORPTO, O.TIMSTP_INSMTO  FROM OLO O LEFT JOIN RICH_OLO_STORICO R ON O.CODFC_OLO_AGCOM=R.CODFC_OLO_AGCOM  LEFT JOIN TIPOLG_OLO T ON O.IDTPLG_OLO = T.IDTPLG_OLO  WHERE O.CODFC_OLO_AGCOM = codOloAgcom,  OR O.COD_OLO_ACCORPANTE = codOloAgcom&amp;quot;&quot;/>&#xa;                        &lt;/tns4:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &