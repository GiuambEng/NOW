                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e4a5a69c-ec64-4b92-a0cf-8824c5fd0b14+input&quot; xmlns:tns3=&quot;http://xmlns.example.com/ClienteAnagrafiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;Copy_1_JDBCOLOQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codOLOAgcom>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns3:clienteanagrafichePostParameters/tns3:codOloAgcom&quot;/>&#xa;            &lt;/codOLOAgcom>&#xa;            &lt;codOLOAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns3:clienteanagrafichePostParameters/tns3:codOloAgcom&quot;/>&#xa;            &lt;/codOLOAgcom2>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCOLOquery-input"
                                    name="JDBCOLOquery"
                                    outputVariable="JDBCOLOquery"
                                    tibex:xpdlId="e4a5a69c-ec64-4b92-a0cf-8824c5fd0b14" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToCopy_1_OLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Copy_1_JDBCOLOQueryToListaClienteAnagraficheRicercaAvanzata"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e4a5a69c-ec64-4b92-a0cf-8824c5fd0b14+input&quot; xmlns:tns3=&quot;http://xmlns.example.com/ClienteAnagrafiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Copy_1_JDBCOLOQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codOLOAgcom>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns3:codOloAgcom&quot;/>&#xa;            &lt;/codOLOAgcom>&#xa;            &lt;codOLOAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns3:codOloAgcom&quot;/>&#xa;            &lt;/codOLOAgcom2>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut1"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT O.COD_OLO ,O.COD_OLO_ACCORPANTE ,O.CODFC_OLO_AGCOM ,O.CODFC_OLO_RETE ,O.DATA_ACCORPTO ,O.DATA_AGGTO ,O.FLAG_OLO_ACCORPANTE ,O.FLAG_OLO_TRANSITORIO ,O.FLAG_SAN_MARINO ,T.DESCR IDTPLG_OLO ,O.INDIRIZZO_EMAIL ,O.MOROSO ,O.NOME ,O.OPERATORE ,O.PARTITA_IVA,O.RAGIONE_SOCIALE,O.STATO_ACCORPTO,O.TIMSTP_INSMTO &#xa;FROM OLO O &#xa;LEFT JOIN  TIPOLG_OLO T  ON  O.IDTPLG_OLO = T.IDTPLG_OLO &#xa;WHERE O.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM&#xa;FROM OLO&#xa;WHERE COD_OLO = (SELECT COD_OLO&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?))  OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM&#xa;FROM OLO&#xa;WHERE COD_OLO = (SELECT COD_OLO&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?)) ORDER BY CODFC_OLO_AGCOM" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOLOAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOLOAgcom2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO_ACCORPANTE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_RETE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_ACCORPTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATA_AGGTO"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="FLAG_OLO_ACCORPANTE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_OLO_TRANSITORIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_SAN_MARINO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDTPLG_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="INDIRIZZO_EMAIL"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="MOROSO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PARTITA_IVA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="RAGIONE_SOCIALE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_ACCORPTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
