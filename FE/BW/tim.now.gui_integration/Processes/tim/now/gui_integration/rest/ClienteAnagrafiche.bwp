            </endingVariables>
        </task>
        <task name="ListaClienteNoOLO">
            <endingVariables>
                <variable>ListaClienteNoOLO-input</variable>
            </endingVariables>
        </task>
        <task name="ClienteAnagraficheErrorReply">
            <endingVariables>
