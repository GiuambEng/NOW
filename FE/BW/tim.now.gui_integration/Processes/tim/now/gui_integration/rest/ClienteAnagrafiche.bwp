                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ClienteAnagraficheRest&quot; xmlns:tns3=&quot;http://xmlns.example.com/ClienteAnagrafiche/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Profile&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaClienteOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaClienteNoOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;VariableListaClienteAnagrafiche&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($Profile, $get.parameters/tns3:tipoProfilo) and string-length($ListaClienteOLO/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&#xa;                &lt;tns:OutputDettaglioClienteAnagraficheRest>&#xa;                    &lt;xsl:for-each select=&quot;$ListaClienteOLO/Record&quot;>&#xa;                        &lt;tns:OutputDettaglioClienteAnagraficheRest>&#xa;                            &lt;tns:nome>&#xa;                                &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                            &lt;/tns:nome>&#xa;                            &lt;tns:ragioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                            &lt;/tns:ragioneSociale>&#xa;                            &lt;xsl:if test=&quot;INDIRIZZO_EMAIL&quot;>&#xa;                                &lt;tns:indirizzoEmail>&#xa;                                    &lt;xsl:value-of select=&quot;INDIRIZZO_EMAIL&quot;/>&#xa;                                &lt;/tns:indirizzoEmail>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:partitaIva>&#xa;                                &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;