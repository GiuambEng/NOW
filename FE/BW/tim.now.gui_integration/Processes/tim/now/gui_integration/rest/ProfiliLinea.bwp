                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1470065396641&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;ExportData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Element>&#xa;            &lt;tns1:xmlParam>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns1:xmlParam>&#xa;            &lt;tns1:listOfColumn>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;idProfiloTecnicoLinea,profiloTecnicoLinea,idOfferta,offerta,flagVendibilita,maxVCxCF,profiloCommercialeDown,profiloCommercialeUp,velocitaAggancioDownMax,velocitaAggancioDownMin,velocitaAggancioUpMax,velocitaAggancioUpMin,bandaNetta,codiceModem,modem,modelloAccesso,protocollo,tecnologiaOlo,idProfiloBMD&amp;quot;&quot;/>&#xa;            &lt;/tns1:listOfColumn>&#xa;            &lt;tns1:rootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ProfiliLineaOutput&amp;quot;&quot;/>&#xa;            &lt;/tns1:rootElement>&#xa;            &lt;tns1:nameOfFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ListaProfiliLinea&amp;quot;&quot;/>&#xa;            &lt;/tns1:nameOfFile>&#xa;            &lt;tns1:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns1:idFile>&#xa;            &lt;tns1:userId>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;defaultUser&amp;quot;&quot;/>&#xa;            &lt;/tns1:userId>&#xa;            &lt;tns1:childElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;profiliLineaOutput&amp;quot;&quot;/>&#xa;            &lt;/tns1:childElement>&#xa;        &lt;/tns1:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
