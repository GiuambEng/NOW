ANCIO_UP_MIN FROM PROFILO_TCNC_LINEA P JOIN OFFERTA O ON P.ID_OFFERTA = O.ID_OFFERTA WHERE &amp;quot;, $ricercaAvanzataConditions/tns1:outputcondition[1])&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
