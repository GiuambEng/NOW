                                    <bpws:sources>
                                    <bpws:source linkName="AssignToEmpty"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/ProfiliLinea&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;tns:ProfiliLineaOutput>&lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&lt;tns:profiliLineaOutput>&lt;xsl:if test=&quot;exists(column[name='ID_PRFL_TCNC_LN']/value)&quot;>&lt;tns:idProfiloTecnicoLinea>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='ID_PRFL_TCNC_LN']/value))&quot;/>&lt;/tns:idProfiloTecnicoLinea>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='PROFILO_TCNC_LINEA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='PROFILO_TCNC_LINEA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='PROFILO_TCNC_LINEA']/value)&quot;>&lt;tns:profiloTecnicoLinea>&lt;xsl:value-of select=&quot;column[name='PROFILO_TCNC_LINEA']/value&quot;/>&lt;/tns:profiloTecnicoLinea>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='ID_OFFERTA']/value)&quot;>&lt;tns:idOfferta>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='ID_OFFERTA']/value))&quot;/>&lt;/tns:idOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='OFFERTA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='OFFERTA']/value)&quot;>&lt;tns:offerta>&lt;xsl:value-of select=&quot;column[name='OFFERTA']/value&quot;/>&lt;/tns:offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_VENDIBILITA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_VENDIBILITA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_VENDIBILITA']/value)&quot;>&lt;tns:flagVendibilita>&lt;xsl:value-of select=&quot;column[name='FLAG_VENDIBILITA']/value&quot;/>&lt;/tns:flagVendibilita>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='MAX_VC_X_CF']/value)&quot;>&lt;tns:maxVCxCF>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='MAX_VC_X_CF']/value))&quot;/>&lt;/tns:maxVCxCF>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='PROFILO_COMMERCIALE_DOWN']/value)&quot;>&lt;tns:profiloCommercialeDown>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='PROFILO_COMMERCIALE_DOWN']/value))&quot;/>&lt;/tns:profiloCommercialeDown>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='PROFILO_COMMERCIALE_UP']/value)&quot;>&lt;tns:profiloCommercialeUp>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='PROFILO_COMMERCIALE_UP']/value))&quot;/>&lt;/tns:profiloCommercialeUp>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='VELOCITA_AGGANCIO_DOWN_MAX']/value)&quot;>&lt;tns:velocitaAggancioDownMax>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='VELOCITA_AGGANCIO_DOWN_MAX']/value))&quot;/>&lt;/tns:velocitaAggancioDownMax>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='VELOCITA_AGGANCIO_DOWN_MIN']/value)&quot;>&lt;tns:velocitaAggancioDownMin>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='VELOCITA_AGGANCIO_DOWN_MIN']/value))&quot;/>&lt;/tns:velocitaAggancioDownMin>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='VELOCITA_AGGANCIO_UP_MAX']/value)&quot;>&lt;tns:velocitaAggancioUpMax>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='VELOCITA_AGGANCIO_UP_MAX']/value))&quot;/>&lt;/tns:velocitaAggancioUpMax>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='VELOCITA_AGGANCIO_UP_MIN']/value)&quot;>&lt;tns:velocitaAggancioUpMin>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='VELOCITA_AGGANCIO_UP_MIN']/value))&quot;/>&lt;/tns:velocitaAggancioUpMin>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='BANDA_NETTA']/value)&qu