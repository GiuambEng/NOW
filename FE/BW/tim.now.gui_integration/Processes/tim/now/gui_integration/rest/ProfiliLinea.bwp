                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerError&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;get_ProfiliLinea_Error_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ProfiliLinea&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.ProfiliLinea&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ProfiliLineaErrorLog&amp;quot;, tib:render-xml($FaultDetails, true(), true()))&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.ProfiliLinea&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns2:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns2:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ProfiliLinea_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ProfiliLinea_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorProfililineaGet&amp;quot;,'SID:',$get.httpHeaders/GUI-SID,'TID:',$get.httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns2:track_position>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:reply name="Reply1"
                                    operation="get"
                                    partnerLink="profililinea"
                                    portType="ns:profililinea"
                                    tibex:xpdlId="f411ab3e-4833-495d-a482-5c83e3717c75" variable="Reply1-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160524165515PLT" xmlns:tns="http://www.tim.com/NOW/rest/ProfiliLinea" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="Reply1-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;item&gt;
                &lt;tns:ProfiliLineaOutput&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;
                        &lt;/tns:severity&gt;
                        &lt;tns:code&gt;
                            &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                        &lt;/tns:code&gt;
                        &lt;tns:details&gt;
                            &lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;
                        &lt;/tns:details&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:ProfiliLineaOutput&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160524165515PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/ProfiliLinea&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ProfiliLineaOutput>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/tns:code>&#xa;                &lt;tns:details>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                &lt;/tns:details>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:ProfiliLineaOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess7ToReply1"/>
                                    </bpws:targets>
                                    </bpws:reply>
                                    </bpws:flow>
                                </bpws:scope>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="OnMessageStartToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="get_ProfiliLinea_IngetLog_INFOToProfLineaQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ProfLineaQueryToget_ProfiliLinea_out_Log" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess2ToProfiliLineaOut" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="OnMessageStart"
                                tibex:constructor="onMessageStart" tibex:xpdlId="45a469c1-06ac-49ed-9232-9de313c5b9a2">
                                <bpws:sources>
                                    <bpws:source linkName="OnMessageStartToCallProcess"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="OnMessageEnd"
                                tibex:constructor="onMessageEnd" tibex:xpdlId="a949b528-2b86-477d-86a4-6f6f313f5b63"/>
                            <bpws:reply name="ProfiliLineaOut"
                                operation="get"
                                partnerLink="profililinea"
                                portType="ns:profililinea"
                                tibex:xpdlId="cb01ac7c-5c74-42f2-926d-90c758292417" variable="ProfiliLineaOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20160524165515PLT" xmlns:tns="http://www.tim.com/NOW/rest/ProfiliLinea" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="ProfLineaQuery"/&gt;
    &lt;xsl:template name="ProfiliLineaOut-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($ProfLineaQuery/Record)"&gt;
                        &lt;tns:ProfiliLineaOutput&gt;
                            &lt;xsl:for-each select="$ProfLineaQuery/Record"&gt;
                                &lt;tns:profiliLineaOutput&gt;
                                    &lt;xsl:if test="exists(ID_PRFL_TCNC_LN) and string-length(xsd:string(ID_PRFL_TCNC_LN))"&gt;
                                        &lt;tns:idProfiloTecnicoLinea&gt;
                                            &lt;xsl:value-of select="xsd:int(ID_PRFL_TCNC_LN)"/&gt;
                                        &lt;/tns:idProfiloTecnicoLinea&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:profiloTecnicoLinea&gt;
                                        &lt;xsl:value-of select="PROFILO_TCNC_LINEA"/&gt;
                                    &lt;/tns:profiloTecnicoLinea&gt;
                                    &lt;xsl:if test="exists(ID_OFFERTA) and string-length(xsd:string(ID_OFFERTA))"&gt;
                                        &lt;tns:idOfferta&gt;
                                            &lt;xsl:value-of select="xsd:int(ID_OFFERTA)"/&gt;
                                        &lt;/tns:idOfferta&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:offerta&gt;
                                        &lt;xsl:value-of select="OFFERTA"/&gt;
                                    &lt;/tns:offerta&gt;
                                    &lt;tns:flagVendibilita&gt;
                                        &lt;xsl:value-of select="FLAG_VENDIBILITA"/&gt;
                                    &lt;/tns:flagVendibilita&gt;
                                    &lt;xsl:if test="exists(MAX_VC_X_CF) and string-length(xsd:string(MAX_VC_X_CF))"&gt;
                                        &lt;tns:maxVCxCF&gt;
                                            &lt;xsl:value-of select="xsd:int(MAX_VC_X_CF)"/&gt;
                                        &lt;/tns:maxVCxCF&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(PROFILO_COMMERCIALE_DOWN) and string-length(xsd:string(PROFILO_COMMERCIALE_DOWN))"&gt;
                                        &lt;tns:profiloCommercialeDown&gt;
                                            &lt;xsl:value-of select="xsd:int(PROFILO_COMMERCIALE_DOWN)"/&gt;
                                        &lt;/tns:profiloCommercialeDown&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(PROFILO_COMMERCIALE_UP) and string-length(xsd:string(PROFILO_COMMERCIALE_UP))"&gt;
                                        &lt;tns:profiloCommercialeUp&gt;
                                            &lt;xsl:value-of select="xsd:int(PROFILO_COMMERCIALE_UP)"/&gt;
                                        &lt;/tns:profiloCommercialeUp&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(VELOCITA_AGGANCIO_DOWN_MAX) and string-length(xsd:string(VELOCITA_AGGANCIO_DOWN_MAX))"&gt;
                                        &lt;tns:velocitaAggancioDownMax&gt;
                                            &lt;xsl:value-of select="xsd:int(VELOCITA_AGGANCIO_DOWN_MAX)"/&gt;
                                        &lt;/tns:velocitaAggancioDownMax&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(VELOCITA_AGGANCIO_DOWN_MIN) and string-length(xsd:string(VELOCITA_AGGANCIO_DOWN_MIN))"&gt;
                                        &lt;tns:velocitaAggancioDownMin&gt;
                                            &lt;xsl:value-of select="xsd:int(VELOCITA_AGGANCIO_DOWN_MIN)"/&gt;
                                        &lt;/tns:velocitaAggancioDownMin&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(VELOCITA_AGGANCIO_UP_MAX) and string-length(xsd:string(VELOCITA_AGGANCIO_UP_MAX))"&gt;
                                        &lt;tns:velocitaAggancioUpMax&gt;
                                            &lt;xsl:value-of select="xsd:int(VELOCITA_AGGANCIO_UP_MAX)"/&gt;
                                        &lt;/tns:velocitaAggancioUpMax&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="exists(VELOCITA_AGGANCIO_UP_MIN) and string-length(xsd:string(VELOCITA_AGGANCIO_UP_MIN))"&gt;
                                        &lt;tns:velocitaAggancioUpMin&gt;
                                            &lt;xsl:value-of select="xsd:int(VELOCITA_AGGANCIO_UP_MIN)"/&gt;
                                        &lt;/tns:velocitaAggancioUpMin&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:bandaNetta&gt;
                                        &lt;xsl:value-of select="xsd:int(BANDA_NETTA)"/&gt;
                                    &lt;/tns:bandaNetta&gt;
                                    &lt;xsl:if test="COD_MODEM"&gt;
                                        &lt;tns:codiceModem&gt;
                                            &lt;xsl:value-of select="COD_MODEM"/&gt;
                                        &lt;/tns:codiceModem&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="MODEM"&gt;
                                        &lt;tns:modem&gt;
                                            &lt;xsl:value-of select="MODEM"/&gt;
                                        &lt;/tns:modem&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="MODELLO_ACCS"&gt;
                                        &lt;tns:modelloAccesso&gt;
                                            &lt;xsl:value-of select="MODELLO_ACCS"/&gt;
                                        &lt;/tns:modelloAccesso&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="PROTOCOLLO"&gt;
                                        &lt;tns:protocollo&gt;
                                            &lt;xsl:value-of select="PROTOCOLLO"/&gt;
                                        &lt;/tns:protocollo&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="TECNOLOGIA_OLO"&gt;
                                        &lt;tns:tecnologiaOlo&gt;
                                            &lt;xsl:value-of select="TECNOLOGIA_OLO"/&gt;
                                        &lt;/tns:tecnologiaOlo&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;tns:tipoModulazione&gt;
                                        &lt;xsl:value-of select="TIPO_MODULAZIONE"/&gt;
                                    &lt;/tns:tipoModulazione&gt;
                                    &lt;xsl:if test="exists(ID_PROFILO_BMD) and string-length(xsd:string(ID_PROFILO_BMD))"&gt;
                                        &lt;tns:idProfiloBMD&gt;
                                            &lt;xsl:value-of select="xsd:int(ID_PROFILO_BMD)"/&gt;
                                        &lt;/tns:idProfiloBMD&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:profiliLineaOutput&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:ProfiliLineaOutput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:ProfiliLineaOutput&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                                &lt;tns:details&gt;
                                    &lt;xsl:value-of select="'NON CI SONO RECORD'"/&gt;
                                &lt;/tns:details&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:ProfiliLineaOutput&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20160524165515PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/ProfiliLinea&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProfLineaQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;ProfiliLineaOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($ProfLineaQuery/Record)&quot;>&#xa;                &lt;tns:ProfiliLineaOutput>&#xa;                    &lt;xsl:for-each select=&quot;$ProfLineaQuery/Record&quot;>&#xa;                        &lt;tns:profiliLineaOutput>&#xa;                            &lt;xsl:if test=&quot;exists(ID_PRFL_TCNC_LN) and string-length(xsd:string(ID_PRFL_TCNC_LN))&quot;>&#xa;                                &lt;tns:idProfiloTecnicoLinea>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_PRFL_TCNC_LN)&quot;/>&#xa;                                &lt;/tns:idProfiloTecnicoLinea>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:profiloTecnicoLinea>&#xa;                                &lt;xsl:value-of select=&quot;PROFILO_TCNC_LINEA&quot;/>&#xa;                            &lt;/tns:profiloTecnicoLinea>&#xa;                            &lt;xsl:if test=&quot;exists(ID_OFFERTA) and string-length(xsd:string(ID_OFFERTA))&quot;>&#xa;                                &lt;tns:idOfferta>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_OFFERTA)&quot;/>&#xa;                                &lt;/tns:idOfferta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:offerta>&#xa;                                &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                            &lt;/tns:offerta>&#xa;                            &lt;tns:flagVendibilita>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_VENDIBILITA&quot;/>&#xa;                            &lt;/tns:flagVendibilita>&#xa;                            &lt;xsl:if test=&quot;exists(MAX_VC_X_CF) and string-length(xsd:string(MAX_VC_X_CF))&quot;>&#xa;                                &lt;tns:maxVCxCF>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(MAX_VC_X_CF)&quot;/>&#xa;                                &lt;/tns:maxVCxCF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(PROFILO_COMMERCIALE_DOWN) and string-length(xsd:string(PROFILO_COMMERCIALE_DOWN))&quot;>&#xa;                                &lt;tns:profiloCommercialeDown>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(PROFILO_COMMERCIALE_DOWN)&quot;/>&#xa;                                &lt;/tns:profiloCommercialeDown>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(PROFILO_COMMERCIALE_UP) and string-length(xsd:string(PROFILO_COMMERCIALE_UP))&quot;>&#xa;                                &lt;tns:profiloCommercialeUp>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(PROFILO_COMMERCIALE_UP)&quot;/>&#xa;                                &lt;/tns:profiloCommercialeUp>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(VELOCITA_AGGANCIO_DOWN_MAX) and string-length(xsd:string(VELOCITA_AGGANCIO_DOWN_MAX))&quot;>&#xa;                                &lt;tns:velocitaAggancioDownMax>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(VELOCITA_AGGANCIO_DOWN_MAX)&quot;/>&#xa;                                &lt;/tns:velocitaAggancioDownMax>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(VELOCITA_AGGANCIO_DOWN_MIN) and string-length(xsd:string(VELOCITA_AGGANCIO_DOWN_MIN))&quot;>&#xa;                                &lt;tns:velocitaAggancioDownMin>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(VELOCITA_AGGANCIO_DOWN_MIN)&quot;/>&#xa;                                &lt;/tns:velocitaAggancioDownMin>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(VELOCITA_AGGANCIO_UP_MAX) and string-length(xsd:string(VELOCITA_AGGANCIO_UP_MAX))&quot;>&#xa;                                &lt;tns:velocitaAggancioUpMax>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(VELOCITA_AGGANCIO_UP_MAX)&quot;/>&#xa;                                &lt;/tns:velocitaAggancioUpMax>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(VELOCITA_AGGANCIO_UP_MIN) and string-length(xsd:string(VELOCITA_AGGANCIO_UP_MIN))&quot;>&#xa;                                &lt;tns:velocitaAggancioUpMin>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(VELOCITA_AGGANCIO_UP_MIN)&quot;/>&#xa;                                &lt;/tns:velocitaAggancioUpMin>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:bandaNetta>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(BANDA_NETTA)&quot;/>&#xa;                            &lt;/tns:bandaNetta>&#xa;                            &lt;xsl:if test=&quot;COD_MODEM&quot;>&#xa;                                &lt;tns:codiceModem>&#xa;                                    &lt;xsl:value-of select=&quot;COD_MODEM&quot;/>&#xa;                                &lt;/tns:codiceModem>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;MODEM&quot;>&#xa;                                &lt;tns:modem>&#xa;                                    &lt;xsl:value-of select=&quot;MODEM&quot;/>&#xa;                                &lt;/tns:modem>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;MODELLO_ACCS&quot;>&#xa;                                &lt;tns:modelloAccesso>&#xa;                                    &lt;xsl:value-of select=&quot;MODELLO_ACCS&quot;/>&#xa;                                &lt;/tns:modelloAccesso>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;PROTOCOLLO&quot;>&#xa;                                &lt;tns:protocollo>&#xa;                                    &lt;xsl:value-of select=&quot;PROTOCOLLO&quot;/>&#xa;                                &lt;/tns:protocollo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TECNOLOGIA_OLO&quot;>&#xa;                                &lt;tns:tecnologiaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;TECNOLOGIA_OLO&quot;/>&#xa;                                &lt;/tns:tecnologiaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:tipoModulazione>&#xa;                                &lt;xsl:value-of select=&quot;TIPO_MODULAZIONE&quot;/>&#xa;                            &lt;/tns:tipoModulazione>&#xa;                            &lt;xsl:if test=&quot;exists(ID_PROFILO_BMD) and string-length(xsd:string(ID_PROFILO_BMD))&quot;>&#xa;                                &lt;tns:idProfiloBMD>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_PROFILO_BMD)&quot;/>&#xa;                                &lt;/tns:idProfiloBMD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:profiliLineaOutput>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;            