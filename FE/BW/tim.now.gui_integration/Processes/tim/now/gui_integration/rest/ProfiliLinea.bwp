                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+90d0b2ae-6082-45e3-85ed-4ad4fc005a9a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ricercaAvanzataConditions&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post/item/tns1:inputservizioricercaavanzata/tns1:strutturaCondition[1]/tns1:nome)=0&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SELECT O.OFFERTA, P.BANDA_NETTA,P.COD_MODEM, P.FLAG_VENDIBILITA, P.ID_OFFERTA, P.ID_PROFILO_BMD, P.ID_PRFL_TCNC_LN, P.MAX_VC_X_CF, P.MODELLO_ACCS, P.MODEM, P.PROFILO_COMMERCIALE_DOWN, P.PROFILO_COMMERCIALE_UP, P.PROFILO_TCNC_LINEA, P.PROTOCOLLO, P.TECNOLOGIA_OLO, P.TIPO_MODULAZIONE,P.VELOCITA_AGGANCIO_DOWN_MAX, P.VELOCITA_AGGANCIO_DOWN_MIN, P.VELOCITA_AGGANCIO_UP_MAX, P.VELOCITA_AGGANCIO_UP_MIN FROM PROFILO_TCNC_LINEA P JOIN OFFERTA O ON P.ID_OFFERTA = O.ID_OFFERTA&amp;quot;&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT O.OFFERTA, P.BANDA_NETTA,P.COD_MODEM, P.FLAG_VENDIBILITA, P.ID_OFFERTA, P.ID_PROFILO_BMD, P.ID_PRFL_TCNC_LN, P.MAX_VC_X_CF, P.MODELLO_ACCS, P.MODEM, P.PROFILO_COMMERCIALE_DOWN, P.PROFILO_COMMERCIALE_UP, P.PROFILO_TCNC_LINEA, P.PROTOCOLLO, P.TECNOLOGIA_OLO, P.TIPO_MODULAZIONE,P.VELOCITA_AGGANCIO_DOWN_MAX, P.VELOCITA_AGGANCIO_DOWN_MIN, P.VELOCITA_AGGANCIO_UP_MAX, P.VELOCITA_AGGANCIO_UP_MIN FROM PROFILO_TCNC_LINEA P JOIN OFFERTA O ON P.ID_OFFERTA = O.ID_OFFERTA WHERE &amp;quot;, $ricercaAvanzataConditions/tns1:outputcondition[1])&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
