                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/semforo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LISTAATTRIBUTI&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;tns:listaattributirecuperati>&lt;xsl:for-each select=&quot;$LISTAATTRIBUTI/tns:lista&quot;>&lt;tns:lista>&lt;xsl:if test=&quot;tns:NOMEFILE&quot;>&lt;tns:NOMEFILE>&lt;xsl:value-of select=&quot;tns:NOMEFILE&quot;/>&lt;/tns:NOMEFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DIMENSIONEFILE&quot;>&lt;tns:DIMENSIONEFILE>&lt;xsl:value-of select=&quot;tns:DIMENSIONEFILE&quot;/>&lt;/tns:DIMENSIONEFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:IDENTIFICATIVOCAUSALESCARTO&quot;>&lt;tns:IDENTIFICATIVOCAUSALESCARTO>&lt;xsl:value-of select=&quot;tns:IDENTIFICATIVOCAUSALESCARTO&quot;/>&lt;/tns:IDENTIFICATIVOCAUSALESCARTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:QUANTITARECORDKO&quot;>&lt;tns:QUANTITARECORDKO>&lt;xsl:value-of select=&quot;tns:QUANTITARECORDKO&quot;/>&lt;/tns:QUANTITARECORDKO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:QUANTITARECORDNOW&quot;>&lt;tns:QUANTITARECORDNOW>&lt;xsl:value-of select=&quot;tns:QUANTITARECORDNOW&quot;/>&lt;/tns:QUANTITARECORDNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:QUANTITARECORDOK&quot;>&lt;tns:QUANTITARECORDOK>&lt;xsl:value-of select=&quot;tns:QUANTITARECORDOK&quot;/>&lt;/tns:QUANTITARECORDOK>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:QUANTITARECORDTOTALI&quot;>&lt;tns:QUANTITARECORDTOTALI>&lt;xsl:value-of select=&quot;tns:QUANTITARECORDTOTALI&quot;/>&lt;/tns:QUANTITARECORDTOTALI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:IDINTERFACCIA&quot;>&lt;tns:IDINTERFACCIA>&lt;xsl:value-of select=&quot;tns:IDINTERFACCIA&quot;/>&lt;/tns:IDINTERFACCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:IDESECPROCFILE&quot;>&lt;tns:IDESECPROCFILE>&lt;xsl:value-of select=&quot;tns:IDESECPROCFILE&quot;/>&lt;/tns:IDESECPROCFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ESITO&quot;>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;tns:ESITO&quot;/>&lt;/tns:ESITO>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(tns:APERTURAFILE)&quot;>&lt;tns:APERTURAFILE>&lt;xsl:value-of select=&quot;format-dateTime(xsd:dateTime(tns:APERTURAFILE), &amp;quot;[Y0001]-[M01]-[D01]  [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:APERTURAFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(tns:CHIUSURAFILE)&quot;>&lt;tns:CHIUSURAFILE>&lt;xsl:value-of select=&quot;substring-before(concat(substring-before(tns:CHIUSURAFILE, &amp;quot;T&amp;quot;), &amp;quot;  &amp;quot;,substring-after(tns:CHIUSURAFILE, &amp;quot;T&amp;quot;)), &amp;quot;+&amp;quot;)&quot;/>&lt;/tns:CHIUSURAFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CODOLOAGCOM&quot;>&lt;tns:CODOLOAGCOM>&lt;xsl:value-of select=&quot;tns:CODOLOAGCOM&quot;/>&lt;/tns:CODOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DESCRSTATOACQUISIZIONE&quot;>&lt;tns:DESCRSTATOACQUISIZIONE>&lt;xsl:value-of select=&quot;tns:DESCRSTATOACQUISIZIONE&quot;/>&lt;/tns:DESCRSTATOACQUISIZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(tns:DATAFILE) and string-length(tns:DATAFILE)>0&quot;>&lt;tns:DATAFILE>&lt;xsl:value-of select=&quot;substring-before(tns:DATAFILE, 'T')&quot;/>&lt;/tns:DATAFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:IDFILE&quot;>&lt;tns:IDFILE>&lt;xsl:value-of select=&quot;tns:IDFILE&quot;/>&lt;/tns:IDFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:SEMAFORO&quot;>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;tns:SEMAFORO&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DATA_ARRIVO&quot;>&lt;tns:DATA_ARRIVO>&lt;xsl:value-of select=&quot;tns:DATA_ARRIVO&quot;/>&lt;/tns:DATA_ARRIVO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TOT_ORDINI_CRMWS&quot;>&lt;tns:TOT_ORDINI_CRMWS>&lt;xsl:value-of select=&quot;tns:TOT_ORDINI_CRMWS&quot;/>&lt;/tns:TOT_ORDINI_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ID_TIPOLOGIA_FILE&quot;>&lt;tns:ID_TIPOLOGIA_FILE>&lt;xsl:value-of select=&quot;tns:ID_TIPOLOGIA_FILE&quot;/>&lt;/tns:ID_TIPOLOGIA_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:FLAG_RISOTTOMETTI&quot;>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;tns:FLAG_RISOTTOMETTI&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:if>&lt;/tns:lista>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$LISTAATTRIBUTI/tns:idExportFile&quot;>&lt;tns:idExportFile>&lt;xsl:value-of select=&quot;$LISTAATTRIBUTI/tns:idExportFile&quot;/>&lt;/tns:idExportFile>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$LISTAATTRIBUTI/tns:result&quot;/>&lt;/tns:listaattributirecuperati>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
