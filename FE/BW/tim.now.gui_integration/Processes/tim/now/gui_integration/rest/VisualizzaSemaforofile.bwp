                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_KO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATA_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="ESITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_ESEC_PROCSO_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATA_ARRIVO"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="IDTPLG_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_SCARTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_INTRFC"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_APERTURA_FILE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CHIUSURA_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="ID_INTRFC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDFILES"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATAAGGIORNAMENTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
