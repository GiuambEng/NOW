                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2492c175-e266-4bb7-8926-9c9f13463972+input&quot; xmlns:tns3=&quot;http://xmlns.example.com/visualizzasemaforofile/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;QueryFileOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns3:visualizzasemaforofilePostParameters/tns3:codoloagcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;COD_OLO_ACCORPANTE>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns3:visualizzasemaforofilePostParameters/tns3:codoloagcom&quot;/>&#xa;            &lt;/COD_OLO_ACCORPANTE>&#xa;            &lt;CODFC_OLO_AGCOM2>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns3:visualizzasemaforofilePostParameters/tns3:codoloagcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM2>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="QueryFileOlo-input"
                                    name="QueryFileOlo"
                                    outputVariable="QueryFileOlo"
                                    tibex:xpdlId="2492c175-e266-4bb7-8926-9c9f13463972" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToCopy_1_OLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="QueryFileOloToCopy_2_AssignDettaglio"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2492c175-e266-4bb7-8926-9c9f13463972+input&quot; xmlns:tns3=&quot;http://xmlns.example.com/visualizzasemaforofile/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;QueryFileOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns3:codoloagcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;COD_OLO_ACCORPANTE>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns3:codoloagcom&quot;/>&#xa;            &lt;/COD_OLO_ACCORPANTE>&#xa;            &lt;CODFC_OLO_AGCOM2>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns3:codoloagcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM2>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT /*+ full(FP) parallel(FP,10) */ FPO.DIMENSIONE_FILE, FPO.QT_RECD_TOTALI,FP.NOME_FILE,FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE AS TIPOLOGIA, &#xa;TP.DESCR, TP.IDTPLG_FILE AS TIPOLOGICO,FPO.QT_RECD_NOW, FPO.QT_RECD_OK, FPO.QT_RECD_KO,FP.DATA_FILE,FP.ESITO,&#xa;FP.ID_ESEC_PROCSO_FILE,FPO.DATA_ARRIVO,FP.IDTPLG_FILE,CSF.DESCR_CAUS_SCARTO,FP.TIMSTP_APERTURA_FILE,&#xa;FP.TIMSTP_CHIUSURA_FILE,FP.ID_INTRFC, NT.DESCR_INTRFC,FP.ID_FILE AS IDFILES, FP.ID_ESEC_PROCSO_FILE AS DATAAGGIORNAMENTO,&#xa;FP.DESCR_STATO_FILE,EPF.ID_PROCSO_FILE, (FPO.QT_RECD_TOTALI-FPO.QT_RECD_NOW) AS TOT_ORD_CRMWS,FP.TIMSTP_RISTTMISS&#xa;FROM   FILE_PROCSTO_INPUT FPO &#xa;INNER JOIN FILE_PROCSTO FP ON FPO.ID_FILE_PROCSTO_INPUT=FP.ID_FILE &#xa;INNER JOIN INTRFC NT ON NT.ID_INTRFC = FP.ID_INTRFC&#xa;LEFT JOIN ESEC_PROCSO_FILE EPF ON FP.ID_ESEC_PROCSO_FILE=EPF.ID_ESEC_PROCSO_FILE &#xa;INNER JOIN TIPOLG_FILE TP ON TP.IDTPLG_FILE=FP.IDTPLG_FILE &#xa;LEFT JOIN CAUS_SCARTO_FILE CSF ON CSF.ID_CAUS_SCARTO = FPO.ID_CAUS_SCARTO  &#xa;WHERE  (FP.CODFC_OLO_AGCOM in (SELECT CODFC_OLO_AGCOM FROM OLO&#xa;  WHERE  CODFC_OLO_AGCOM = ? OR COD_OLO_ACCORPANTE = ?) OR &#xa;  FP.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO IN (SELECT COD_OLO FROM OLO WHERE CODFC_OLO_AGCOM=?)))  AND FP.VERSO_DEL_FILE = 'INPUT' &#xa;AND FP.CODFC_OLO_AGCOM IS NOT NULL AND (TP.DESCR='XML') -- or (TP.DESCR='CSV' and NT.ID_INTRFC = 272))&#xa;AND NT.ID_INTRFC NOT IN (341,299,275,272,269,268,191,190,189) -- &lt;> 341&#xa;ORDER BY  FP.DATA_FILE desc , FP.timstp_apertura_file   desc " xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO_ACCORPANTE"/>

                                    <PreparedParameters
