p;quot;&quot;/>&#xa;                                    &lt;/tns:QUANTITARECORDOK>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(QT_RECD_TOTALI))>0&quot;>&#xa;                                &lt;tns:QUANTITARECORDTOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(QT_RECD_TOTALI)&quot;/>&#xa;                                &lt;/tns:QUANTITARECORDTOTALI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(DESCR_INTRFC)>0&quot;>&#xa;                                &lt;tns:IDINTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&#xa;                                &lt;/tns:IDINTERFACCIA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(ID_PROCSO_FILE))>0&quot;>&#xa;                                &lt;tns:IDESECPROCFILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_PROCSO_FILE)&quot;/>&#xa;                                &lt;/tns:IDESECPROCFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ESITO&quot;>&#xa;                                &lt;tns:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;ESITO&quot;/>&#xa;                                &lt;/tns:ESITO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_APERTURA_FILE)&quot;>&#xa;                                    &lt;tns:APERTURAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_APERTURA_FILE), &