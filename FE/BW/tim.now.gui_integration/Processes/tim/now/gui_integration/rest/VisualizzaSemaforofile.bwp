t;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                &lt;/tns:CODOLOAGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:DESCRSTATOACQUISIZIONE>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&#xa;                            &lt;/tns:DESCRSTATOACQUISIZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(DATA_FILE), &amp;quot;.&amp;quot;) and exists(DATA_FILE)&quot;>&#xa;                                    &lt;tns:DATAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATA_FILE), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:DATAFILE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;DATA_FILE&quot;>&#xa;                                        &lt;tns:DATAFILE>&#xa;                                            &lt;xsl:value-of select=&quot;DATA_FILE&quot;/>&#xa;                                        &lt;/tns:DATAFILE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(IDFILES))>0&quot;>&#xa;                                &lt;tns:IDFILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(IDFILES)&quot;/>&#xa;                                &lt;/tns:IDFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(DESCR_CAUS_SCARTO)>0 or DESCR_STATO_FILE='SCADUTO'&quot;>&#xa;                                    &lt;tns:SEMAFORO>&#xa;                                        &lt;xsl:value-of select=&quot;'ROSSO'&quot;/>&#xa;                                    &lt;/tns:SEMAFORO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;DESCR_STATO_FILE='ELABORATO'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;xsd:int(QT_RECD_NOW)=0&quot;>&#xa;                                            &lt;tns:SEMAFORO>&#xa;                                                &lt;xsl:value-of select=&quot;'GRIGIO'&quot;/>&#xa;                                            &lt;/tns:SEMAFORO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:SEMAFORO>&#xa;                                                &lt;xsl:value-of select=&quot;'VERDE'&quot;/>&#xa;                                            &lt;/tns:SEMAFORO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:SEMAFORO>&#xa;                                        &lt;xsl:value-of select=&quot;'GIALLO'&quot;/>&#xa;                                    &lt;/tns:SEMAFORO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:DATA_ARRIVO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DATA_ARRIVO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DATA_ARRIVO>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(TOT_ORD_CRMWS))>0&quot;>&#xa;                                &lt;tns:TOT_ORDINI_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(TOT_ORD_CRMWS)&quot;/>&#xa;                                &lt;/tns:TOT_ORDINI_CRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(DESCR)>0&quot;>&#xa;                                &lt;tns:ID_TIPOLOGIA_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                                &lt;/tns:ID_TIPOLOGIA_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists(TIMSTP_RISTTMISS) and string-length( string (TIMSTP_RISTTMISS))>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;DESCR_STATO_FILE='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_APERTURA_FILE,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_RISTTMISS,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&quot;>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;DESCR_STATO_FILE='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_APERTURA_FILE,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) &quot;>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:posizione>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/tns:posizione>&#xa;                        &lt;/tns:lista>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($JDBCQueryFileOlo/Record)>=$MaxRows) then 'LIMIT' else 'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:listaattributirecuperati>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:listaattributirecuperati>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCQueryFileNoOlo/Record&quot;>&#xa;                        &lt;tns:lista>&#xa;                            &lt;tns:NOMEFILE>&#xa;                                &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                            &lt;/tns:NOMEFILE>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(DIMENSIONE_FILE))>0&quot;>&#xa;                                &lt;tns:DIMENSIONEFILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&#xa;                                &lt;/tns:DIMENSIONEFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR_CAUS_SCARTO&quot;>&#xa;                                &lt;tns:IDENTIFICATIVOCAUSALESCARTO>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_CAUS_SCARTO&quot;/>&#xa;                                &lt;/tns:IDENTIFICATIVOCAUSALESCARTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(xsd:string(QT_RECD_KO))>0&quot;>&#xa;                                    &lt;tns:QUANTITARECORDKO>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_RECD_KO)&quot;/>&#xa;                                    &lt;/tns:QUANTITARECORDKO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:QUANTITARECORDKO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;N.D.&amp;quot;&quot;/>&#xa;                                    &lt;/tns:QUANTITARECORDKO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(QT_RECD_NOW))>0&quot;>&#xa;                                &lt;tns:QUANTITARECORDNOW>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(QT_RECD_NOW)&quot;/>&#xa;                                &lt;/tns:QUANTITARECORDNOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(xsd:string(QT_RECD_OK))>0&quot;>&#xa;                                    &lt;tns:QUANTITARECORDOK>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(QT_RECD_OK)&quot;/>&#xa;                                    &lt;/tns:QUANTITARECORDOK>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:QUANTITARECORDOK>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;N.D.&amp;quot;&quot;/>&#xa;                                    &lt;/tns:QUANTITARECORDOK>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(QT_RECD_TOTALI))>0&quot;>&#xa;                                &lt;tns:QUANTITARECORDTOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(QT_RECD_TOTALI)&quot;/>&#xa;                                &lt;/tns:QUANTITARECORDTOTALI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(DESCR_INTRFC)>0&quot;>&#xa;                                &lt;tns:IDINTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&#xa;                                &lt;/tns:IDINTERFACCIA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(ID_PROCSO_FILE))>0&quot;>&#xa;                                &lt;tns:IDESECPROCFILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(ID_PROCSO_FILE)&quot;/>&#xa;                                &lt;/tns:IDESECPROCFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ESITO&quot;>&#xa;                                &lt;tns:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;ESITO&quot;/>&#xa;                                &lt;/tns:ESITO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_APERTURA_FILE)&quot;>&#xa;                                    &lt;tns:APERTURAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:APERTURAFILE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:APERTURAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;TIMSTP_APERTURA_FILE&quot;/>&#xa;                                    &lt;/tns:APERTURAFILE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CHIUSURA_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CHIUSURA_FILE)&quot;>&#xa;                                    &lt;tns:CHIUSURAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CHIUSURA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CHIUSURA_FILE), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:CHIUSURAFILE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;TIMSTP_CHIUSURA_FILE&quot;>&#xa;                                        &lt;tns:CHIUSURAFILE>&#xa;                                            &lt;xsl:value-of select=&quot;TIMSTP_CHIUSURA_FILE&quot;/>&#xa;                                        &lt;/tns:CHIUSURAFILE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                &lt;tns:CODOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                &lt;/tns:CODOLOAGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:DESCRSTATOACQUISIZIONE>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&#xa;                            &lt;/tns:DESCRSTATOACQUISIZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(xsd:string(DATA_FILE), &amp;quot;.&amp;quot;) and exists(DATA_FILE)&quot;>&#xa;                                    &lt;tns:DATAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATA_FILE), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:DATAFILE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;DATA_FILE&quot;>&#xa;                                        &lt;tns:DATAFILE>&#xa;                                            &lt;xsl:value-of select=&quot;DATA_FILE&quot;/>&#xa;                                        &lt;/tns:DATAFILE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(IDFILES))>0&quot;>&#xa;                                &lt;tns:IDFILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(IDFILES)&quot;/>&#xa;                                &lt;/tns:IDFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(DESCR_CAUS_SCARTO)>0 or DESCR_STATO_FILE='SCADUTO'&quot;>&#xa;                                    &lt;tns:SEMAFORO>&#xa;                                        &lt;xsl:value-of select=&quot;'ROSSO'&quot;/>&#xa;                                    &lt;/tns:SEMAFORO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;DESCR_STATO_FILE='ELABORATO'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;xsd:int(QT_RECD_NOW)=0&quot;>&#xa;                                            &lt;tns:SEMAFORO>&#xa;                                                &lt;xsl:value-of select=&quot;'GRIGIO'&quot;/>&#xa;                                            &lt;/tns:SEMAFORO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:SEMAFORO>&#xa;                                                &lt;xsl:value-of select=&quot;'VERDE'&quot;/>&#xa;                                            &lt;/tns:SEMAFORO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:SEMAFORO>&#xa;                                        &lt;xsl:value-of select=&quot;'GIALLO'&quot;/>&#xa;                                    &lt;/tns:SEMAFORO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:DATA_ARRIVO>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DATA_ARRIVO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DATA_ARRIVO>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(TOT_ORD_CRMWS))>0&quot;>&#xa;                                &lt;tns:TOT_ORDINI_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(TOT_ORD_CRMWS)&quot;/>&#xa;                                &lt;/tns:TOT_ORDINI_CRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(DESCR)>0&quot;>&#xa;                                &lt;tns:ID_TIPOLOGIA_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                                &lt;/tns:ID_TIPOLOGIA_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists(TIMSTP_RISTTMISS) and string-length( string (TIMSTP_RISTTMISS))>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;DESCR_STATO_FILE='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_APERTURA_FILE,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_RISTTMISS,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&quot;>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;DESCR_STATO_FILE='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_APERTURA_FILE,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) &quot;>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:posizione>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/tns:posizione>&#xa;                        &lt;/tns:lista>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($JDBCQueryFileNoOlo/Record)>=$MaxRows) then 'LIMIT' else 'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:listaattributirecuperati>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
