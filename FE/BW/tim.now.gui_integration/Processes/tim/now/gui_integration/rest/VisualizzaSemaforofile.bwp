                            <bpws:reply name="postOut" operation="post"
                                partnerLink="visualizzasemaforofile"
                                portType="ns0:visualizzasemaforofile"
                                tibex:xpdlId="582f8b38-6570-4ac5-99bc-70b8bdb8c1c4" variable="postOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://xmlns.example.com/20160511185829PLT" xmlns:tns="http://www.tim.com/NOW/rest/semforo" xmlns:tns1="http://www.tim.com/NOW/rest/servizioricercaavanzata" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns6="http://www.example.org/CryptoParams" xmlns:tns5="http://www.example.org/CryptoListParams" version="2.0"&gt;
    &lt;xsl:param name="SQLDirectOLO"/&gt;
    &lt;xsl:param name="SQLDirectNoOLO"/&gt;
    &lt;xsl:param name="QueryFileOlo"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="QueryFileNoOlo"/&gt;
    &lt;xsl:param name="CryptoParams"/&gt;
    &lt;xsl:param name="LISTAATTRIBUTI"/&gt;
    &lt;xsl:param name="CryptoList"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns4:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($post/item/tns1:inputservizioricercaavanzata/tns1:exportRequest) and (upper-case($post/item/tns1:inputservizioricercaavanzata/tns1:exportRequest) = &amp;quot;S&amp;quot; or upper-case($post/item/tns1:inputservizioricercaavanzata/tns1:exportRequest) = &amp;quot;Y&amp;quot;) and (exists($QueryFileNoOlo) or exists($QueryFileOlo) or exists($SQLDirectOLO) or exists ($SQLDirectNoOLO))"&gt;
                        &lt;tns:listaattributirecuperati&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="$CryptoParams/tns6:idFileCriptato"/&gt;
                            &lt;/tns:idExportFile&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                        &lt;/tns:listaattributirecuperati&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:listaattributirecuperati&gt;
                            &lt;xsl:for-each select="$LISTAATTRIBUTI/tns:lista"&gt;
                                &lt;tns:lista&gt;
                                    &lt;xsl:variable name="currentPosition" select="current()/tns:posizione"/&gt;
                                    &lt;xsl:if test="tns:NOMEFILE"&gt;
                                        &lt;tns:NOMEFILE&gt;
                                            &lt;xsl:value-of select="tns:NOMEFILE"/&gt;
                                        &lt;/tns:NOMEFILE&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:DIMENSIONEFILE"&gt;
                                        &lt;tns:DIMENSIONEFILE&gt;
                                            &lt;xsl:value-of select="tns:DIMENSIONEFILE"/&gt;
                                        &lt;/tns:DIMENSIONEFILE&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:IDENTIFICATIVOCAUSALESCARTO"&gt;
                                        &lt;tns:IDENTIFICATIVOCAUSALESCARTO&gt;
                                            &lt;xsl:value-of select="tns:IDENTIFICATIVOCAUSALESCARTO"/&gt;
                                        &lt;/tns:IDENTIFICATIVOCAUSALESCARTO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:QUANTITARECORDKO"&gt;
                                        &lt;tns:QUANTITARECORDKO&gt;
                                            &lt;xsl:value-of select="tns:QUANTITARECORDKO"/&gt;
                                        &lt;/tns:QUANTITARECORDKO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:QUANTITARECORDNOW"&gt;
                                        &lt;tns:QUANTITARECORDNOW&gt;
                                            &lt;xsl:value-of select="tns:QUANTITARECORDNOW"/&gt;
                                        &lt;/tns:QUANTITARECORDNOW&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:QUANTITARECORDOK"&gt;
                                        &lt;tns:QUANTITARECORDOK&gt;
                                            &lt;xsl:value-of select="tns:QUANTITARECORDOK"/&gt;
                                        &lt;/tns:QUANTITARECORDOK&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:QUANTITARECORDTOTALI"&gt;
                                        &lt;tns:QUANTITARECORDTOTALI&gt;
                                            &lt;xsl:value-of select="tns:QUANTITARECORDTOTALI"/&gt;
                                        &lt;/tns:QUANTITARECORDTOTALI&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:IDINTERFACCIA"&gt;
                                        &lt;tns:IDINTERFACCIA&gt;
                                            &lt;xsl:value-of select="tns:IDINTERFACCIA"/&gt;
                                        &lt;/tns:IDINTERFACCIA&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:IDESECPROCFILE"&gt;
                                        &lt;tns:IDESECPROCFILE&gt;
                                            &lt;xsl:value-of select="tns:IDESECPROCFILE"/&gt;
                                        &lt;/tns:IDESECPROCFILE&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:ESITO"&gt;
                                        &lt;tns:ESITO&gt;
                                            &lt;xsl:value-of select="tns:ESITO"/&gt;
                                        &lt;/tns:ESITO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:APERTURAFILE"&gt;
                                        &lt;tns:APERTURAFILE&gt;
                                            &lt;xsl:value-of select="tns:APERTURAFILE"/&gt;
                                        &lt;/tns:APERTURAFILE&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:CHIUSURAFILE"&gt;
                                        &lt;tns:CHIUSURAFILE&gt;
                                            &lt;xsl:value-of select="tns:CHIUSURAFILE"/&gt;
                                        &lt;/tns:CHIUSURAFILE&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:CODOLOAGCOM"&gt;
                                        &lt;tns:CODOLOAGCOM&gt;
                                            &lt;xsl:value-of select="tns:CODOLOAGCOM"/&gt;
                                        &lt;/tns:CODOLOAGCOM&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:DESCRSTATOACQUISIZIONE"&gt;
                                        &lt;tns:DESCRSTATOACQUISIZIONE&gt;
                                            &lt;xsl:value-of select="tns:DESCRSTATOACQUISIZIONE"/&gt;
                                        &lt;/tns:DESCRSTATOACQUISIZIONE&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:DATAFILE"&gt;
                                        &lt;tns:DATAFILE&gt;
                                            &lt;xsl:value-of select="tns:DATAFILE"/&gt;
                                        &lt;/tns:DATAFILE&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="$CryptoList/tns5:ListIdFileOutput[tns5:position = $currentPosition]/tns5:idFileCriptato"&gt;
                                        &lt;tns:IDFILE&gt;
                                            &lt;xsl:value-of select="$CryptoList/tns5:ListIdFileOutput[tns5:position = $currentPosition]/tns5:idFileCriptato"/&gt;
                                        &lt;/tns:IDFILE&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:SEMAFORO"&gt;
                                        &lt;tns:SEMAFORO&gt;
                                            &lt;xsl:value-of select="tns:SEMAFORO"/&gt;
                                        &lt;/tns:SEMAFORO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:DATA_ARRIVO"&gt;
                                        &lt;tns:DATA_ARRIVO&gt;
                                            &lt;xsl:value-of select="tns:DATA_ARRIVO"/&gt;
                                        &lt;/tns:DATA_ARRIVO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:TOT_ORDINI_CRMWS"&gt;
                                        &lt;tns:TOT_ORDINI_CRMWS&gt;
                                            &lt;xsl:value-of select="tns:TOT_ORDINI_CRMWS"/&gt;
                                        &lt;/tns:TOT_ORDINI_CRMWS&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:ID_TIPOLOGIA_FILE"&gt;
                                        &lt;tns:ID_TIPOLOGIA_FILE&gt;
                                            &lt;xsl:value-of select="tns:ID_TIPOLOGIA_FILE"/&gt;
                                        &lt;/tns:ID_TIPOLOGIA_FILE&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="tns:FLAG_RISOTTOMETTI"&gt;
                                        &lt;tns:FLAG_RISOTTOMETTI&gt;
                                            &lt;xsl:value-of select="tns:FLAG_RISOTTOMETTI"/&gt;
                                        &lt;/tns:FLAG_RISOTTOMETTI&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:lista&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;xsl:if test="$LISTAATTRIBUTI/tns:idExportFile"&gt;
                                &lt;tns:idExportFile&gt;
                                    &lt;xsl:value-of select="$LISTAATTRIBUTI/tns:idExportFile"/&gt;
                                &lt;/tns:idExportFile&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:copy-of select="$LISTAATTRIBUTI/tns:result"/&gt;
                        &lt;/tns:listaattributirecuperati&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns4:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://xmlns.example.com/20160511185829PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/semforo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.example.org/CryptoParams&quot; xmlns:tns5=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirectOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirectNoOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryFileOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryFileNoOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParams&quot;/>&#xa;    &lt;xsl:param name=&quot;LISTAATTRIBUTI&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoList&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($post.item/tns1:exportRequest) and (upper-case($post.item/tns1:exportRequest) = &amp;quot;S&amp;quot; or upper-case($post.item/tns1:exportRequest) = &amp;quot;Y&amp;quot;) and (exists($QueryFileNoOlo) or exists($QueryFileOlo) or exists($SQLDirectOLO) or exists ($SQLDirectNoOLO))&quot;>&#xa;                &lt;tns:listaattributirecuperati>&#xa;                    &lt;tns:idExportFile>&#xa;                        &lt;xsl:value-of select=&quot;$CryptoParams/tns6:idFileCriptato&quot;/>&#xa;                    &lt;/tns:idExportFile>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:listaattributirecuperati>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:listaattributirecuperati>&#xa;                    &lt;xsl:for-each select=&quot;$LISTAATTRIBUTI/tns:lista&quot;>&#xa;                        &lt;tns:lista>&#xa;                            &lt;xsl:variable name=&quot;currentPosition&quot; select=&quot;current()/tns:posizione&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns:NOMEFILE&quot;>&#xa;                                &lt;tns:NOMEFILE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:NOMEFILE&quot;/>&#xa;                                &lt;/tns:NOMEFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:DIMENSIONEFILE&quot;>&#xa;                                &lt;tns:DIMENSIONEFILE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DIMENSIONEFILE&quot;/>&#xa;                                &lt;/tns:DIMENSIONEFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:IDENTIFICATIVOCAUSALESCARTO&quot;>&#xa;                                &lt;tns:IDENTIFICATIVOCAUSALESCARTO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDENTIFICATIVOCAUSALESCARTO&quot;/>&#xa;                                &lt;/tns:IDENTIFICATIVOCAUSALESCARTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:QUANTITARECORDKO&quot;>&#xa;                                &lt;tns:QUANTITARECORDKO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:QUANTITARECORDKO&quot;/>&#xa;                                &lt;/tns:QUANTITARECORDKO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:QUANTITARECORDNOW&quot;>&#xa;                                &lt;tns:QUANTITARECORDNOW>&#xa;                                    &lt;xsl:value-of select=&quot;tns:QUANTITARECORDNOW&quot;/>&#xa;                                &lt;/tns:QUANTITARECORDNOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:QUANTITARECORDOK&quot;>&#xa;                                &lt;tns:QUANTITARECORDOK>&#xa;                                    &lt;xsl:value-of select=&quot;tns:QUANTITARECORDOK&quot;/>&#xa;                                &lt;/tns:QUANTITARECORDOK>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:QUANTITARECORDTOTALI&quot;>&#xa;                                &lt;tns:QUANTITARECORDTOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;tns:QUANTITARECORDTOTALI&quot;/>&#xa;                                &lt;/tns:QUANTITARECORDTOTALI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:IDINTERFACCIA&quot;>&#xa;                                &lt;tns:IDINTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDINTERFACCIA&quot;/>&#xa;                                &lt;/tns:IDINTERFACCIA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:IDESECPROCFILE&quot;>&#xa;                                &lt;tns:IDESECPROCFILE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDESECPROCFILE&quot;/>&#xa;                                &lt;/tns:IDESECPROCFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:ESITO&quot;>&#xa;                                &lt;tns:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ESITO&quot;/>&#xa;                                &lt;/tns:ESITO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:APERTURAFILE&quot;>&#xa;                                &lt;tns:APERTURAFILE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:APERTURAFILE&quot;/>&#xa;                                &lt;/tns:APERTURAFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:CHIUSURAFILE&quot;>&#xa;                                &lt;tns:CHIUSURAFILE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:CHIUSURAFILE&quot;/>&#xa;                                &lt;/tns:CHIUSURAFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:CODOLOAGCOM&quot;>&#xa;                                &lt;tns:CODOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns:CODOLOAGCOM&quot;/>&#xa;                                &lt;/tns:CODOLOAGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:DESCRSTATOACQUISIZIONE&quot;>&#xa;                                &lt;tns:DESCRSTATOACQUISIZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DESCRSTATOACQUISIZIONE&quot;/>&#xa;                                &lt;/tns:DESCRSTATOACQUISIZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:DATAFILE&quot;>&#xa;                                &lt;tns:DATAFILE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DATAFILE&quot;/>&#xa;                                &lt;/tns:DATAFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$CryptoList/tns5:ListIdFileOutput[tns5:position = $currentPosition]/tns5:idFileCriptato&quot;>&#xa;                                &lt;tns:IDFILE>&#xa;                                    &lt;xsl:value-of select=&quot;$CryptoList/tns5:ListIdFileOutput[tns5:position = $currentPosition]/tns5:idFileCriptato&quot;/>&#xa;                                &lt;/tns:IDFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:SEMAFORO&quot;>&#xa;                                &lt;tns:SEMAFORO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:SEMAFORO&quot;/>&#xa;                                &lt;/tns:SEMAFORO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:DATA_ARRIVO&quot;>&#xa;                                &lt;tns:DATA_ARRIVO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DATA_ARRIVO&quot;/>&#xa;                                &lt;/tns:DATA_ARRIVO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:TOT_ORDINI_CRMWS&quot;>&#xa;                                &lt;tns:TOT_ORDINI_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;tns:TOT_ORDINI_CRMWS&quot;/>&#xa;                                &lt;/tns:TOT_ORDINI_CRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:ID_TIPOLOGIA_FILE&quot;>&#xa;                                &lt;tns:ID_TIPOLOGIA_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ID_TIPOLOGIA_FILE&quot;/>&#xa;                                &lt;/tns:ID_TIPOLOGIA_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:FLAG_RISOTTOMETTI&quot;>&#xa;                                &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                    &lt;xsl:value-of select=&quot;tns:FLAG_RISOTTOMETTI&quot;/>&#xa;                                &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:lista>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;$LISTAATTRIBUTI/tns:idExportFile&quot;>&#xa;                        &lt;tns:idExportFile>&#xa;                            &lt;xsl:value-of select=&quot;$LISTAATTRIBUTI/tns:idExportFile&quot;/>&#xa;                        &lt;/tns:idExportFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;$LISTAATTRIBUTI/tns:result&quot;/>&#xa;                &lt;/tns:listaattributirecuperati>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
