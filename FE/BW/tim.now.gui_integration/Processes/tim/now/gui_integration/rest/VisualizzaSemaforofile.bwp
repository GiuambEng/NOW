                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ecdaec9e-a146-4af4-b61a-c567d6e962f8+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;QueryFileNoOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT /*+ full(FP) parallel(FP,10) */ FPO.DIMENSIONE_FILE, FPO.QT_RECD_TOTALI,FP.NOME_FILE,&#xd;&#xa;FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE AS TIPOLOGIA, &#xd;&#xa;TP.DESCR, TP.IDTPLG_FILE AS TIPOLOGICO,FPO.QT_RECD_NOW,  &#xd;&#xa;FPO.QT_RECD_OK, FPO.QT_RECD_KO, FP.DATA_FILE,FP.ESITO, &#xd;&#xa;FP.ID_ESEC_PROCSO_FILE, FPO.DATA_ARRIVO,FP.IDTPLG_FILE,&#xd;&#xa;CSF.DESCR_CAUS_SCARTO,NT.DESCR_INTRFC,FP.TIMSTP_APERTURA_FILE, FP.TIMSTP_CHIUSURA_FILE,&#xd;&#xa; FP.ID_INTRFC, FP.ID_FILE AS IDFILES, FP.ID_ESEC_PROCSO_FILE AS DATAAGGIORNAMENTO, &#xd;&#xa; FP.DESCR_STATO_FILE, EPF.ID_PROCSO_FILE, (FPO.QT_RECD_TOTALI-FPO.QT_RECD_NOW) AS TOT_ORD_CRMWS,FP.TIMSTP_RISTTMISS&#xd;&#xa; FROM   FILE_PROCSTO_INPUT FPO &#xd;&#xa; INNER JOIN FILE_PROCSTO FP ON FPO.ID_FILE_PROCSTO_INPUT=FP.ID_FILE &#xd;&#xa;  LEFT JOIN ESEC_PROCSO_FILE EPF ON FP.ID_ESEC_PROCSO_FILE=EPF.ID_ESEC_PROCSO_FILE &#xd;&#xa;  INNER JOIN TIPOLG_FILE TP ON TP.IDTPLG_FILE=FP.IDTPLG_FILE &#xd;&#xa;  INNER JOIN INTRFC NT ON NT.ID_INTRFC = FP.ID_INTRFC&#xd;&#xa;  LEFT JOIN CAUS_SCARTO_FILE CSF ON CSF.ID_CAUS_SCARTO = FPO.ID_CAUS_SCARTO  &#xd;&#xa;  WHERE  FP.VERSO_DEL_FILE = 'INPUT' AND FP.CODFC_OLO_AGCOM IS NOT NULL AND (TP.DESCR='XML' or (TP.DESCR='CSV' and NT.ID_INTRFC = 272))&#xd;&#xa;AND NT.ID_INTRFC &lt;> 341&#xd;&#xa;  ORDER BY FP.DATA_FILE desc , FP.timstp_apertura_file   desc " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="DIMENSIONE_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_TOTALI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
