mn[name='TIMSTP_RISTTMISS']/value)) and string-length(string(column[name='TIMSTP_RISTTMISS']/value))>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string(column[name='DESCR_STATO_FILE']/value)='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(xsd:dateTime(string(column[name='TIMSTP_APERTURA_FILE']/value)),0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) and (tib:compare-dateTime(tib:add-to-dateTime(xsd:dateTime(string(column[name='TIMSTP_RISTTMISS']/value)),0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&amp;#xD;&amp;#xA;&quot;>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string(column[name='DESCR_STATO_FILE']/value)='IN ELABORAZIONE'  and (tib:compare-dateTime(tib:add-to-dateTime(xsd:dateTime(string(column[name='TIMSTP_APERTURA_FILE']/value)),0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&amp;#xD;&amp;#xA;&quot;>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:posizione>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:posizione>&lt;/tns:lista>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($SQLDirectNoOLO/unknownResultset[1]/row)>=$MaxRows) then 'LIMIT' else 'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:listaattributirecuperati>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
