                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/semforo&quot; xmlns:tns3=&quot;http://xmlns.example.com/visualizzasemaforofile/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Profilo&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryFileOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryFileNoOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;timestamprisottomissione&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;LISTAATTRIBUTI&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($Profilo,$get.parameters/tns3:tipoprofilo)&quot;>&#xa;                &lt;tns:listaattributirecuperati>&#xa;                    &lt;xsl:for-each select=&quot;$JDBCQueryFileOlo/Record&quot;>&#xa;                        &lt;tns:lista>&#xa;                            &lt;tns:NOMEFILE>&#xa;                                &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                            &lt;/tns:NOMEFILE>&#xa;                            &lt;xsl:if test=&quot;string-length(xsd:string(DIMENSIONE_FILE))>0&quot;>&#xa;                                &lt;tns:DIMENSIONEFILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&#xa;                                &lt;/tns:DIMENSIONEFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR_CAUS_SCARTO&quot;>&#xa;                                &lt;tns:IDENTIFICATIVOCAUSALESCARTO>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_CAUS_S