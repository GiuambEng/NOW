E']/value))>0&quot;>&lt;tns:IDESECPROCFILE>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='ID_PROCSO_FILE']/value))&quot;/>&lt;/tns:IDESECPROCFILE>&lt;/xsl:if>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;string(column[name='ESITO']/value)&quot;/>&lt;/tns:ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name='TIMSTP_APERTURA_FILE']/value), &amp;quot;.&amp;quot;) and exists(column[name='TIMSTP_APERTURA_FILE']/value) and string-length(string(column[name='TIMSTP_APERTURA_FILE']/value))>0&quot;>&lt;tns:APERTURAFILE>&lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='TIMSTP_APERTURA_FILE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='TIMSTP_APERTURA_FILE']/value), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:APERTURAFILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:APERTURAFILE>&lt;xsl:value-of select=&quot;string(column[name='TIMSTP_APERTURA_FILE']/value)&quot;/>&lt;/tns:APERTURAFILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name='TIMSTP_CHIUSURA_FILE']/value), &amp;quot;.&amp;quot;) and exists(column[name='TIMSTP_CHIUSURA_FILE']/value) and string-length(string(column[name='TIMSTP_CHIUSURA_FILE']/value))>0&quot;>&lt;tns:CHIUSURAFILE>&lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='TIMSTP_CHIUSURA_FILE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='TIMSTP_CHIUSURA_FILE']/value), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:CHIUSURAFILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CHIUSURAFILE>&lt;xsl:value-of select=&quot;string(column[name='TIMSTP_CHIUSURA_FILE']/value)&quot;/>&lt;/tns:CHIUSURAFILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CODOLOAGCOM>&lt;xsl:value-of select=&quot;string(column[name='CODFC_OLO_AGCOM']/value)&quot;/>&lt;/tns:CODOLOAGCOM>&lt;tns:DESCRSTATOACQUISIZIONE>&lt;xsl:value-of select=&quot;string(column[name='DESCR_STATO_FILE']/value)&quot;/>&lt;/tns:DESCRSTATOACQUISIZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name='DATA_FILE']/value), &amp;quot;.&amp;quot;) and exists(column[name='DATA_FILE']/value) and string-length(string(column[name='DATA_FILE']/value))>0&quot;>&lt;tns:DATAFILE>&lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='DATA_FILE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='DATA_FILE']/value), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:DATAFILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DATAFILE>&lt;xsl:value-of select=&quot;string(column[name='DATA_FILE']/value)&quot;/>&lt;/tns:DATAFILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(string(column[name='IDFILES']/value))>0&quot;>&lt;tns:IDFILE>&lt;xsl:value-of select=&quot;xsd:int(string(column[name='IDFILES']/value))&quot;/>&lt;/tns:IDFILE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string(column[name='DESCR_CAUS_SCARTO']/value))>0 or string(column[name='DESCR_STATO_FILE']/value)='SCADUTO'&quot;>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'ROSSO'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:when>&lt;xsl:when test=&quot;string(column[name='DESCR_STATO_FILE']/value)='ELABORATO'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(string(column[name='QT_RECD_NOW']/value))=0&quot;>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'GRIGIO'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'VERDE'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'GIALLO'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(string(column[name='DATA_ARRIVO']/value)) and string-length(string(column[name='DATA_ARRIVO']/value))>0&quot;>&lt;tns:DATA_ARRIVO>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_ARRIVO']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/t