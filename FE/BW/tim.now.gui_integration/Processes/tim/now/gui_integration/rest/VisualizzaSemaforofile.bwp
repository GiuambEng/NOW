                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:IDESECPROCFILE"&gt;
                                &lt;tns:IDESECPROCFILE&gt;
                                    &lt;xsl:value-of select="tns:IDESECPROCFILE"/&gt;
                                &lt;/tns:IDESECPROCFILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:ESITO"&gt;
                                &lt;tns:ESITO&gt;
                                    &lt;xsl:value-of select="tns:ESITO"/&gt;
                                &lt;/tns:ESITO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:APERTURAFILE"&gt;
                                &lt;tns:APERTURAFILE&gt;
                                    &lt;xsl:value-of select="tns:APERTURAFILE"/&gt;
                                &lt;/tns:APERTURAFILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:CHIUSURAFILE"&gt;
                                &lt;tns:CHIUSURAFILE&gt;
                                    &lt;xsl:value-of select="tns:CHIUSURAFILE"/&gt;
                                &lt;/tns:CHIUSURAFILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:CODOLOAGCOM"&gt;
                                &lt;tns:CODOLOAGCOM&gt;
                                    &lt;xsl:value-of select="tns:CODOLOAGCOM"/&gt;
                                &lt;/tns:CODOLOAGCOM&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:DESCRSTATOACQUISIZIONE"&gt;
                                &lt;tns:DESCRSTATOACQUISIZIONE&gt;
                                    &lt;xsl:value-of select="tns:DESCRSTATOACQUISIZIONE"/&gt;
                                &lt;/tns:DESCRSTATOACQUISIZIONE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:DATAFILE"&gt;
                                &lt;tns:DATAFILE&gt;
                                    &lt;xsl:value-of select="tns:DATAFILE"/&gt;
                                &lt;/tns:DATAFILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$CryptList/tns5:ListIdFileOutput[tns5:position = $currentPosition]/tns5:idFileCriptato"&gt;
                                &lt;tns:IDFILE&gt;
                                    &lt;xsl:value-of select="$CryptList/tns5:ListIdFileOutput[tns5:position = $currentPosition]/tns5:idFileCriptato"/&gt;
                                &lt;/tns:IDFILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:SEMAFORO"&gt;
                                &lt;tns:SEMAFORO&gt;
                                    &lt;xsl:value-of select="tns:SEMAFORO"/&gt;
                                &lt;/tns:SEMAFORO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:DATA_ARRIVO"&gt;
                                &lt;tns:DATA_ARRIVO&gt;
                                    &lt;xsl:value-of select="tns:DATA_ARRIVO"/&gt;
                                &lt;/tns:DATA_ARRIVO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:TOT_ORDINI_CRMWS"&gt;
                                &lt;tns:TOT_ORDINI_CRMWS&gt;
                                    &lt;xsl:value-of select="tns:TOT_ORDINI_CRMWS"/&gt;
                                &lt;/tns:TOT_ORDINI_CRMWS&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:ID_TIPOLOGIA_FILE"&gt;
                                &lt;tns:ID_TIPOLOGIA_FILE&gt;
                                    &lt;xsl:value-of select="tns:ID_TIPOLOGIA_FILE"/&gt;
                                &lt;/tns:ID_TIPOLOGIA_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:FLAG_RISOTTOMETTI"&gt;
                                &lt;tns:FLAG_RISOTTOMETTI&gt;
                                    &lt;xsl:value-of select="tns:FLAG_RISOTTOMETTI"/&gt;
                                &lt;/tns:FLAG_RISOTTOMETTI&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:lista&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:if test="$LISTAATTRIBUTI/tns:idExportFile"&gt;
                        &lt;tns:idExportFile&gt;
                            &lt;xsl:value-of select="$LISTAATTRIBUTI/tns:idExportFile"/&gt;
                        &lt;/tns:idExportFile&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:copy-of select="$LISTAATTRIBUTI/tns:result"/&gt;
                &lt;/tns:listaattributirecuperati&gt;
            &lt;/item&gt;
        &lt;/tns4:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://xmlns.example.com/20160511185829PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/semforo&quot; xmlns:tns5=&quot;http://www.example.org/CryptoListParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LISTAATTRIBUTI&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptList&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:listaattributirecuperati>&#xa;            &lt;xsl:for-each select=&quot;$LISTAATTRIBUTI/tns:lista&quot;>&#xa;                &lt;tns:lista>&#xa;                    &lt;xsl:variable name=&quot;currentPosition&quot; select=&quot;current()/tns:posizione&quot;/>&#xa;                    &lt;xsl:if test=&quot;tns:NOMEFILE&quot;>&#xa;                        &lt;tns:NOMEFILE>&#xa;                            &lt;xsl:value-of select=&quot;tns:NOMEFILE&quot;/>&#xa;                        &lt;/tns:NOMEFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DIMENSIONEFILE&quot;>&#xa;                        &lt;tns:DIMENSIONEFILE>&#xa;                            &lt;xsl:value-of select=&quot;tns:DIMENSIONEFILE&quot;/>&#xa;                        &lt;/tns:DIMENSIONEFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:IDENTIFICATIVOCAUSALESCARTO&quot;>&#xa;                        &lt;tns:IDENTIFICATIVOCAUSALESCARTO>&#xa;                            &lt;xsl:value-of select=&quot;tns:IDENTIFICATIVOCAUSALESCARTO&quot;/>&#xa;                        &lt;/tns:IDENTIFICATIVOCAUSALESCARTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:QUANTITARECORDKO&quot;>&#xa;                        &lt;tns:QUANTITARECORDKO>&#xa;                            &lt;xsl:value-of select=&quot;tns:QUANTITARECORDKO&quot;/>&#xa;                        &lt;/tns:QUANTITARECORDKO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:QUANTITARECORDNOW&quot;>&#xa;                        &lt;tns:QUANTITARECORDNOW>&#xa;                            &lt;xsl:value-of select=&quot;tns:QUANTITARECORDNOW&quot;/>&#xa;                        &lt;/tns:QUANTITARECORDNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:QUANTITARECORDOK&quot;>&#xa;                        &lt;tns:QUANTITARECORDOK>&#xa;                            &lt;xsl:value-of select=&quot;tns:QUANTITARECORDOK&quot;/>&#xa;                        &lt;/tns:QUANTITARECORDOK>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:QUANTITARECORDTOTALI&quot;>&#xa;                        &lt;tns:QUANTITARECORDTOTALI>&#xa;                            &lt;xsl:value-of select=&quot;tns:QUANTITARECORDTOTALI&quot;/>&#xa;                        &lt;/tns:QUANTITARECORDTOTALI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:IDINTERFACCIA&quot;>&#xa;                        &lt;tns:IDINTERFACCIA>&#xa;                            &lt;xsl:value-of select=&quot;tns:IDINTERFACCIA&quot;/>&#xa;                        &lt;/tns:IDINTERFACCIA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:IDESECPROCFILE&quot;>&#xa;                        &lt;tns:IDESECPROCFILE>&#xa;                            &lt;xsl:value-of select=&quot;tns:IDESECPROCFILE&quot;/>&#xa;                        &lt;/tns:IDESECPROCFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:ESITO&quot;>&#xa;                        &lt;tns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;tns:ESITO&quot;/>&#xa;                        &lt;/tns:ESITO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:APERTURAFILE&quot;>&#xa;                        &lt;tns:APERTURAFILE>&#xa;                            &lt;xsl:value-of select=&quot;tns:APERTURAFILE&quot;/>&#xa;                        &lt;/tns:APERTURAFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:CHIUSURAFILE&quot;>&#xa;                        &lt;tns:CHIUSURAFILE>&#xa;                            &lt;xsl:value-of select=&quot;tns:CHIUSURAFILE&quot;/>&#xa;                        &lt;/tns:CHIUSURAFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:CODOLOAGCOM&quot;>&#xa;                        &lt;tns:CODOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;tns:CODOLOAGCOM&quot;/>&#xa;                        &lt;/tns:CODOLOAGCOM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DESCRSTATOACQUISIZIONE&quot;>&#xa;                        &lt;tns:DESCRSTATOACQUISIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;tns:DESCRSTATOACQUISIZIONE&quot;/>&#xa;                        &lt;/tns:DESCRSTATOACQUISIZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DATAFILE&quot;>&#xa;                        &lt;tns:DATAFILE>&#xa;                            &lt;xsl:value-of select=&quot;tns:DATAFILE&quot;/>&#xa;                        &lt;/tns:DATAFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CryptList/tns5:ListIdFileOutput[tns5:position = $currentPosition]/tns5:idFileCriptato&quot;>&#xa;                        &lt;tns:IDFILE>&#xa;                            &lt;xsl:value-of select=&quot;$CryptList/tns5:ListIdFileOutput[tns5:position = $currentPosition]/tns5:idFileCriptato&quot;/>&#xa;                        &lt;/tns:IDFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:SEMAFORO&quot;>&#xa;                        &lt;tns:SEMAFORO>&#xa;                            &lt;xsl:value-of select=&quot;tns:SEMAFORO&quot;/>&#xa;                        &lt;/tns:SEMAFORO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DATA_ARRIVO&quot;>&#xa;                        &lt;tns:DATA_ARRIVO>&#xa;                            &lt;xsl:value-of select=&quot;tns:DATA_ARRIVO&quot;/>&#xa;                        &lt;/tns:DATA_ARRIVO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:TOT_ORDINI_CRMWS&quot;>&#xa;                        &lt;tns:TOT_ORDINI_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;tns:TOT_ORDINI_CRMWS&quot;/>&#xa;                        &lt;/tns:TOT_ORDINI_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:ID_TIPOLOGIA_FILE&quot;>&#xa;                        &lt;tns:ID_TIPOLOGIA_FILE>&#xa;                            &lt;xsl:value-of select=&quot;tns:ID_TIPOLOGIA_FILE&quot;/>&#xa;                        &lt;/tns:ID_TIPOLOGIA_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:FLAG_RISOTTOMETTI&quot;>&#xa;                        &lt;tns:FLAG_RISOTTOMETTI>&#xa;                            &lt;xsl:value-of select=&quot;tns:FLAG_RISOTTOMETTI&quot;/>&#xa;                        &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:lista>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$LISTAATTRIBUTI/tns:idExportFile&quot;>&#xa;                &lt;tns:idExportFile>&#xa;                    &lt;xsl:value-of select=&quot;$LISTAATTRIBUTI/tns:idExportFile&quot;/>&#xa;                &lt;/tns:idExportFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:copy-of select=&quot;$LISTAATTRIBUTI/tns:result&quot;/>&#xa;        &lt;/tns:listaattributirecuperati>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess2TogetOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/semforo&quot; xmlns:tns3=&quot;http://xmlns.example.com/visualizzasemaforofile/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Profilo&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;JDBCQueryFileOlo&quot;/>&lt;xsl:param name=&quot;JDBCQueryFileNoOlo&quot;/>&lt;xsl:param name=&quot;timestamprisottomissione&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;LISTAATTRIBUTI&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Profilo,$get/parameters/tns3:visualizzasemaforofileGetParameters/tns3:tipoprofilo)&quot;>&lt;tns:listaattributirecuperati>&lt;xsl:for-each select=&quot;$JDBCQueryFileOlo/Record&quot;>&lt;tns:lista>&lt;tns:NOMEFILE>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:NOMEFILE>&lt;xsl:if test=&quot;string-length(xsd:string(DIMENSIONE_FILE))>0&quot;>&lt;tns:DIMENSIONEFILE>&lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&lt;/tns:DIMENSIONEFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_SCARTO&quot;>&lt;tns:IDENTIFICATIVOCAUSALESCARTO>&lt;xsl:value-of select=&quot;DESCR_CAUS_SCARTO&quot;/>&lt;/tns:IDENTIFICATIVOCAUSALESCARTO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string(QT_RECD_KO))>0&quot;>&lt;tns:QUANTITARECORDKO>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_KO)&quot;/>&lt;/tns:QUANTITARECORDKO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:QUANTITARECORDKO>&lt;xsl:value-of select=&quot;&amp;quot;N.D.&amp;quot;&quot;/>&lt;/tns:QUANTITARECORDKO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(xsd:string(QT_RECD_NOW))>0&quot;>&lt;tns:QUANTITARECORDNOW>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_NOW)&quot;/>&lt;/tns:QUANTITARECORDNOW>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string(QT_RECD_OK))>0&quot;>&lt;tns:QUANTITARECORDOK>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_OK)&quot;/>&lt;/tns:QUANTITARECORDOK>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:QUANTITARECORDOK>&lt;xsl:value-of select=&quot;&amp;quot;N.D.&amp;quot;&quot;/>&lt;/tns:QUANTITARECORDOK>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(xsd:string(QT_RECD_TOTALI))>0&quot;>&lt;tns:QUANTITARECORDTOTALI>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_TOTALI)&quot;/>&lt;/tns:QUANTITARECORDTOTALI>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(DESCR_INTRFC)>0&quot;>&lt;tns:IDINTERFACCIA>&lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&lt;/tns:IDINTERFACCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(xsd:string(ID_PROCSO_FILE))>0&quot;>&lt;tns:IDESECPROCFILE>&lt;xsl:value-of select=&quot;xsd:int(ID_PROCSO_FILE)&quot;/>&lt;/tns:IDESECPROCFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;ESITO&quot;>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;ESITO&quot;/>&lt;/tns:ESITO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_APERTURA_FILE)&quot;>&lt;tns:APERTURAFILE>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:APERTURAFILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:APERTURAFILE>&lt;xsl:value-of select=&quot;TIMSTP_APERTURA_FILE&quot;/>&lt;/tns:APERTURAFILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CHIUSURA_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CHIUSURA_FILE)&quot;>&lt;tns:CHIUSURAFILE>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CHIUSURA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CHIUSURA_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:CHIUSURAFILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_CHIUSURA_FILE&quot;>&lt;tns:CHIUSURAFILE>&lt;xsl:value-of select=&quot;TIMSTP_CHIUSURA_FILE&quot;/>&lt;/tns:CHIUSURAFILE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:CODOLOAGCOM>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:CODOLOAGCOM>&lt;/xsl:if>&lt;tns:DESCRSTATOACQUISIZIONE>&lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&lt;/tns:DESCRSTATOACQUISIZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(DATA_FILE), &amp;quot;.&amp;quot;) and exists(DATA_FILE)&quot;>&lt;tns:DATAFILE>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATA_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:DATAFILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DATA_FILE&quot;>&lt;tns:DATAFILE>&lt;xsl:value-of select=&quot;DATA_FILE&quot;/>&lt;/tns:DATAFILE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(xsd:string(IDFILES))>0&quot;>&lt;tns:IDFILE>&lt;xsl:value-of select=&quot;xsd:int(IDFILES)&quot;/>&lt;/tns:IDFILE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(DESCR_CAUS_SCARTO)>0 or DESCR_STATO_FILE='SCADUTO'&quot;>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'ROSSO'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:when>&lt;xsl:when test=&quot;DESCR_STATO_FILE='ELABORATO'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(QT_RECD_NOW)=0&quot;>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'GRIGIO'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'VERDE'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'GIALLO'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DATA_ARRIVO>&lt;xsl:value-of select=&quot;substring-before(string(DATA_ARRIVO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DATA_ARRIVO>&lt;xsl:if test=&quot;string-length(xsd:string(TOT_ORD_CRMWS))>0&quot;>&lt;tns:TOT_ORDINI_CRMWS>&lt;xsl:value-of select=&quot;xsd:int(TOT_ORD_CRMWS)&quot;/>&lt;/tns:TOT_ORDINI_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(DESCR)>0&quot;>&lt;tns:ID_TIPOLOGIA_FILE>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:ID_TIPOLOGIA_FILE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(TIMSTP_RISTTMISS) and string-length( string (TIMSTP_RISTTMISS))>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;DESCR_STATO_FILE='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_APERTURA_FILE,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_RISTTMISS,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&quot;>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;DESCR_STATO_FILE='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_APERTURA_FILE,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) &quot;>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:posizione>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:posizione>&lt;/tns:lista>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&l