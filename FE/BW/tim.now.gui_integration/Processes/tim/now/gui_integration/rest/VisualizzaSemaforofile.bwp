                           &lt;tns:DATAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='DATA_FILE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='DATA_FILE']/value), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:DATAFILE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DATAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;string(column[name='DATA_FILE']/value)&quot;/>&#xa;                                    &lt;/tns:DATAFILE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='IDFILES']/value))>0&quot;>&#xa;                                &lt;tns:IDFILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='IDFILES']/value))&quot;/>&#xa;                                &lt;/tns:IDFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(string(column[name='DESCR_CAUS_SCARTO']/value))>0 or string(column[name='DESCR_STATO_FILE']/value)='SCADUTO'&quot;>&#xa;                                    &lt;tns:SEMAFORO>&#xa;                                        &lt;xsl:value-of select=&quot;'ROSSO'&quot;/>&#xa;                                    &lt;/tns:SEMAFORO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string(column[name='DESCR_STATO_FILE']/value)='ELABORATO'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;xsd:int(string(column[name='QT_RECD_NOW']/value))=0&quot;>&#xa;                                            &lt;tns:SEMAFORO>&#xa;                                                &lt;xsl:value-of select=&quot;'GRIGIO'&quot;/>&#xa;                                            &lt;/tns:SEMAFORO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:SEMAFORO>&#xa;                                                &lt;xsl:value-of select=&quot;'VERDE'&quot;/>&#xa;                                            &lt;/tns:SEMAFORO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:SEMAFORO>&#xa;                                        &lt;xsl:value-of select=&quot;'GIALLO'&quot;/>&#xa;                                    &lt;/tns:SEMAFORO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists(string(column[name='DATA_ARRIVO']/value)) and string-length(string(column[name='DATA_ARRIVO']/value))>0&quot;>&#xa;                                &lt;tns:DATA_ARRIVO>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_ARRIVO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:DATA_ARRIVO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='TOT_ORD_CRMWS']/value))>0&quot;>&#xa;                                &lt;tns:TOT_ORDINI_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='TOT_ORD_CRMWS']/value))&quot;/>&#xa;                                &lt;/tns:TOT_ORDINI_CRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='DESCR']/value))>0&quot;>&#xa;                                &lt;tns:ID_TIPOLOGIA_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;string(column[name='DESCR']/value)&quot;/>&#xa;                                &lt;/tns:ID_TIPOLOGIA_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists(string(column[name='TIMSTP_RISTTMISS']/value)) and string-length(string(column[name='TIMSTP_RISTTMISS']/value))>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string(column[name='DESCR_STATO_FILE']/value)='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(xsd:dateTime(string(column[name='TIMSTP_APERTURA_FILE']/value)),0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) and (tib:compare-dateTime(tib:add-to-dateTime(xsd:dateTime(string(column[name='TIMSTP_RISTTMISS']/value)),0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&amp;#xD;&amp;#xA;&quot;>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string(column[name='DESCR_STATO_FILE']/value)='IN ELABORAZIONE'  and (tib:compare-dateTime(tib:add-to-dateTime(xsd:dateTime(string(column[name='TIMSTP_APERTURA_FILE']/value)),0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&amp;#xD;&amp;#xA;&quot;>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:posizione>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/tns:posizione>&#xa;                        &lt;/tns:lista>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($SQLDirectOLO/unknownResultset[1]/row)>=$MaxRows) then 'LIMIT' else 'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:listaattributirecuperati>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:listaattributirecuperati>&#xa;                    &lt;xsl:for-each select=&quot;$SQLDirectNoOLO/unknownResultset[1]/row&quot;>&#xa;                        &lt;tns:lista>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_FILE']/value)&quot;>&#xa;                                &lt;tns:NOMEFILE>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='NOME_FILE']/value&quot;/>&#xa;                                &lt;/tns:NOMEFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='DIMENSIONE_FILE']/value))>0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='DIMENSIONE_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DIMENSIONE_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DIMENSIONE_FILE']/value)&quot;>&#xa;                                    &lt;tns:DIMENSIONEFILE>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='DIMENSIONE_FILE']/value&quot;/>&#xa;                                    &lt;/tns:DIMENSIONEFILE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='DESCR_CAUS_SCARTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_CAUS_SCARTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_CAUS_SCARTO']/value)&quot;>&#xa;                                &lt;tns:IDENTIFICATIVOCAUSALESCARTO>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='DESCR_CAUS_SCARTO']/value&quot;/>&#xa;                                &lt;/tns:IDENTIFICATIVOCAUSALESCARTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(string(column[name='QT_RECD_KO']/value))>0&quot;>&#xa;                                    &lt;tns:QUANTITARECORDKO>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(string(column[name='QT_RECD_KO']/value))&quot;/>&#xa;                                    &lt;/tns:QUANTITARECORDKO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:QUANTITARECORDKO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;N.D.&amp;quot;&quot;/>&#xa;                                    &lt;/tns:QUANTITARECORDKO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='QT_RECD_NOW']/value))>0&quot;>&#xa;                                &lt;tns:QUANTITARECORDNOW>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='QT_RECD_NOW']/value))&quot;/>&#xa;                                &lt;/tns:QUANTITARECORDNOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(string(column[name='QT_RECD_OK']/value))>0&quot;>&#xa;                                    &lt;tns:QUANTITARECORDOK>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(string(column[name='QT_RECD_OK']/value))&quot;/>&#xa;                                    &lt;/tns:QUANTITARECORDOK>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:QUANTITARECORDOK>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;N.D.&amp;quot;&quot;/>&#xa;                                    &lt;/tns:QUANTITARECORDOK>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='QT_RECD_TOTALI']/value))>0&quot;>&#xa;                                &lt;tns:QUANTITARECORDTOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='QT_RECD_TOTALI']/value))&quot;/>&#xa;                                &lt;/tns:QUANTITARECORDTOTALI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='DESCR_INTRFC']/value))>0&quot;>&#xa;                                &lt;tns:IDINTERFACCIA>&#xa;                                    &lt;xsl:value-of select=&quot;string(column[name='DESCR_INTRFC']/value)&quot;/>&#xa;                                &lt;/tns:IDINTERFACCIA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='ID_PROCSO_FILE']/value))>0&quot;>&#xa;                                &lt;tns:IDESECPROCFILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='ID_PROCSO_FILE']/value))&quot;/>&#xa;                                &lt;/tns:IDESECPROCFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:ESITO>&#xa;                                &lt;xsl:value-of select=&quot;string(column[name='ESITO']/value)&quot;/>&#xa;                            &lt;/tns:ESITO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(string(column[name='TIMSTP_APERTURA_FILE']/value), &amp;quot;.&amp;quot;) and exists(column[name='TIMSTP_APERTURA_FILE']/value) and string-length(string(column[name='TIMSTP_APERTURA_FILE']/value))>0&quot;>&#xa;                                    &lt;tns:APERTURAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='TIMSTP_APERTURA_FILE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='TIMSTP_APERTURA_FILE']/value), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:APERTURAFILE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:APERTURAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;string(column[name='TIMSTP_APERTURA_FILE']/value)&quot;/>&#xa;                                    &lt;/tns:APERTURAFILE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(string(column[name='TIMSTP_CHIUSURA_FILE']/value), &amp;quot;.&amp;quot;) and exists(column[name='TIMSTP_CHIUSURA_FILE']/value) and string-length(string(column[name='TIMSTP_CHIUSURA_FILE']/value))>0&quot;>&#xa;                                    &lt;tns:CHIUSURAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='TIMSTP_CHIUSURA_FILE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='TIMSTP_CHIUSURA_FILE']/value), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:CHIUSURAFILE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:CHIUSURAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;string(column[name='TIMSTP_CHIUSURA_FILE']/value)&quot;/>&#xa;                                    &lt;/tns:CHIUSURAFILE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:CODOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;string(column[name='CODFC_OLO_AGCOM']/value)&quot;/>&#xa;                            &lt;/tns:CODOLOAGCOM>&#xa;                            &lt;tns:DESCRSTATOACQUISIZIONE>&#xa;                                &lt;xsl:value-of select=&quot;string(column[name='DESCR_STATO_FILE']/value)&quot;/>&#xa;                            &lt;/tns:DESCRSTATOACQUISIZIONE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(string(column[name='DATA_FILE']/value), &amp;quot;.&amp;quot;) and exists(column[name='DATA_FILE']/value) and string-length(string(column[name='DATA_FILE']/value))>0&quot;>&#xa;                                    &lt;tns:DATAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(string(column[name='DATA_FILE']/value), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(string(column[name='DATA_FILE']/value), &amp;quot;+&amp;quot;))&quot;/>&#xa;                                    &lt;/tns:DATAFILE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DATAFILE>&#xa;                                        &lt;xsl:value-of select=&quot;string(column[name='DATA_FILE']/value)&quot;/>&#xa;                                    &lt;/tns:DATAFILE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='IDFILES']/value))>0&quot;>&#xa;                                &lt;tns:IDFILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='IDFILES']/value))&quot;/>&#xa;                                &lt;/tns:IDFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(string(column[name='DESCR_CAUS_SCARTO']/value))>0 or string(column[name='DESCR_STATO_FILE']/value)='SCADUTO'&quot;>&#xa;                                    &lt;tns:SEMAFORO>&#xa;                                        &lt;xsl:value-of select=&quot;'ROSSO'&quot;/>&#xa;                                    &lt;/tns:SEMAFORO>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string(column[name='DESCR_STATO_FILE']/value)='ELABORATO'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;xsd:int(string(column[name='QT_RECD_NOW']/value))=0&quot;>&#xa;                                            &lt;tns:SEMAFORO>&#xa;                                                &lt;xsl:value-of select=&quot;'GRIGIO'&quot;/>&#xa;                                            &lt;/tns:SEMAFORO>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:SEMAFORO>&#xa;                                                &lt;xsl:value-of select=&quot;'VERDE'&quot;/>&#xa;                                            &lt;/tns:SEMAFORO>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:SEMAFORO>&#xa;                                        &lt;xsl:value-of select=&quot;'GIALLO'&quot;/>&#xa;                                    &lt;/tns:SEMAFORO>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists(string(column[name='DATA_ARRIVO']/value)) and string-length(string(column[name='DATA_ARRIVO']/value))>0&quot;>&#xa;                                &lt;tns:DATA_ARRIVO>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_ARRIVO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:DATA_ARRIVO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='TOT_ORD_CRMWS']/value))>0&quot;>&#xa;                                &lt;tns:TOT_ORDINI_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name='TOT_ORD_CRMWS']/value))>0&quot;/>&#xa;                                &lt;/tns:TOT_ORDINI_CRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='DESCR']/value))>0&quot;>&#xa;                                &lt;tns:ID_TIPOLOGIA_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;string(column[name='DESCR']/value)&quot;/>&#xa;                                &lt;/tns:ID_TIPOLOGIA_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists(string(column[name='TIMSTP_RISTTMISS']/value)) and string-length(string(column[name='TIMSTP_RISTTMISS']/value))>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string(column[name='DESCR_STATO_FILE']/value)='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(xsd:dateTime(string(column[name='TIMSTP_APERTURA_FILE']/value)),0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) and (tib:compare-dateTime(tib:add-to-dateTime(xsd:dateTime(string(column[name='TIMSTP_RISTTMISS']/value)),0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&amp;#xD;&amp;#xA;&quot;>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string(column[name='DESCR_STATO_FILE']/value)='IN ELABORAZIONE'  and (tib:compare-dateTime(tib:add-to-dateTime(xsd:dateTime(string(column[name='TIMSTP_APERTURA_FILE']/value)),0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&amp;#xD;&amp;#xA;&quot;>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:FLAG_RISOTTOMETTI>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:FLAG_RISOTTOMETTI>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:posizione>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/tns:posizione>&#xa;                        &lt;/tns:lista>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;if(count($SQLDirectNoOLO/unknownResultset[1]/row)>=$MaxRows) then 'LIMIT' else 'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:listaattributirecuperati>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
