                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/semforo&quot; xmlns:tns3=&quot;http://xmlns.example.com/visualizzasemaforofile/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Profilo&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;SQLDirectOLO&quot;/>&lt;xsl:param name=&quot;SQLDirectNoOLO&quot;/>&lt;xsl:param name=&quot;timestamprisottomissione&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;LISTAATTRIBUTI&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Profilo,$post/parameters/tns3:visualizzasemaforofilePostParameters/tns3:tipoprofilo)&quot;>&lt;tns:listaattributirecuperati>&lt;xsl:for-each select=&quot;$SQLDirectOLO/unknownResultset[1]/row&quot;>&lt;tns:lista>&lt;xsl:if test=&quot;not((string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_FILE']/value)&quot;>&lt;tns:NOMEFILE>&lt;xsl:value-of select=&quot;column[name='NOME_FILE']/value&quot;/>&lt;/tns:NOMEFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string(column[name='DIMENSIONE_FILE']/value))>0&quot;>&lt;xsl:if test=&quot;not((string(column[name='DIMENSIONE_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DIMENSIONE_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DIMENSIONE_FILE']/value)&quot;>&lt;tns:DIMENSIONEFILE>&lt;xsl:value-of select=&quot;column[name='DIMENSIONE_FILE']/value&quot;/>&lt;/tns:DIMENSIONEFILE>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string