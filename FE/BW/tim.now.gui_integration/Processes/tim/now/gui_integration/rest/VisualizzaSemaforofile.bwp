                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.com/namespaces/tns/1470065396641&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://xmlns.example.com/visualizzasemaforofile/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryExport&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;ExportDati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Element>&#xa;            &lt;tns4:xmlParam>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml&quot;/>&#xa;            &lt;/tns4:xmlParam>&#xa;            &lt;tns4:listOfColumn>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOMEFILE,DIMENSIONEFILE,IDENTIFICATIVOCAUSALESCARTO,QUANTITARECORDKO,QUANTITARECORDNOW,QUANTITARECORDOK,QUANTITARECORDTOTALI,IDINTERFACCIA,ESITO,APERTURAFILE,CHIUSURAFILE,CODOLOAGCOM,DESCRSTATOACQUISIZIONE,DATAFILE,SEMAFORO,DATA_ARRIVO,TOT_ORDINI_CRMWS,ID_TIPOLOGIA_FILE&amp;quot;&quot;/>&#xa;            &lt;/tns4:listOfColumn>&#xa;            &lt;tns4:rootElement>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;listaattributirecuperati&amp;quot;&quot;/>&#xa;            &lt;/tns4:rootElement>&#xa;            &lt;tns4:nameOfFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ListaSemaforoFile&amp;quot;&quot;/>&#xa;            &lt;/tns4:nameOfFile>&#xa;            &lt;tns4:idFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($JDBCQueryExport/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns4:idFile>&#xa;            &lt;tns4:userId>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns3:visualizzasemaforofilePostParameters/tns3:userId&quot;/>&#xa;            &lt;/tns4:userId>&#xa;            &lt