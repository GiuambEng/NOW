                                &lt;tns:IDENTIFICATIVOCAUSALESCARTO&gt;
                                    &lt;xsl:value-of select="tns:IDENTIFICATIVOCAUSALESCARTO"/&gt;
                                &lt;/tns:IDENTIFICATIVOCAUSALESCARTO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:QUANTITARECORDKO"&gt;
                                &lt;tns:QUANTITARECORDKO&gt;
                                    &lt;xsl:value-of select="tns:QUANTITARECORDKO"/&gt;
                                &lt;/tns:QUANTITARECORDKO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:QUANTITARECORDNOW"&gt;
                                &lt;tns:QUANTITARECORDNOW&gt;
                                    &lt;xsl:value-of select="tns:QUANTITARECORDNOW"/&gt;
                                &lt;/tns:QUANTITARECORDNOW&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:QUANTITARECORDOK"&gt;
                                &lt;tns:QUANTITARECORDOK&gt;
                                    &lt;xsl:value-of select="tns:QUANTITARECORDOK"/&gt;
                                &lt;/tns:QUANTITARECORDOK&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:QUANTITARECORDTOTALI"&gt;
                                &lt;tns:QUANTITARECORDTOTALI&gt;
                                    &lt;xsl:value-of select="tns:QUANTITARECORDTOTALI"/&gt;
                                &lt;/tns:QUANTITARECORDTOTALI&gt;
