                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/semforo&quot; xmlns:tns3=&quot;http://xmlns.example.com/visualizzasemaforofile/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Profilo&quot;/>&lt;xsl:param name=&quot;QueryFileOlo&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;QueryFileNoOlo&quot;/>&lt;xsl:param name=&quot;timestamprisottomissione&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:template name=&quot;LISTAATTRIBUTI&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Profilo,$post/parameters/tns3:visualizzasemaforofilePostParameters/tns3:tipoprofilo)&quot;>&lt;tns:listaattributirecuperati>&lt;xsl:for-each select=&quot;$QueryFileOlo/Record&quot;>&lt;tns:lista>&lt;tns:NOMEFILE>&lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&lt;/tns:NOMEFILE>&lt;xsl:if test=&quot;string-length(xsd:string(DIMENSIONE_FILE))>0&quot;>&lt;tns:DIMENSIONEFILE>&lt;xsl:value-of select=&quot;xsd:int(DIMENSIONE_FILE)&quot;/>&lt;/tns:DIMENSIONEFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_CAUS_SCARTO&quot;>&lt;tns:IDENTIFICATIVOCAUSALESCARTO>&lt;xsl:value-of select=&quot;DESCR_CAUS_SCARTO&quot;/>&lt;/tns:IDENTIFICATIVOCAUSALESCARTO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string(QT_RECD_KO))>0&quot;>&lt;tns:QUANTITARECORDKO>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_KO)&quot;/>&lt;/tns:QUANTITARECORDKO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:QUANTITARECORDKO>&lt;xsl:value-of select=&quot;&amp;quot;N.D.&amp;quot;&quot;/>&lt;/tns:QUANTITARECORDKO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(xsd:string(QT_RECD_NOW))>0&quot;>&lt;tns:QUANTITARECORDNOW>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_NOW)&quot;/>&lt;/tns:QUANTITARECORDNOW>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string(QT_RECD_OK))>0&quot;>&lt;tns:QUANTITARECORDOK>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_OK)&quot;/>&lt;/tns:QUANTITARECORDOK>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:QUANTITARECORDOK>&lt;xsl:value-of select=&quot;&amp;quot;N.D.&amp;quot;&quot;/>&lt;/tns:QUANTITARECORDOK>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(xsd:string(QT_RECD_TOTALI))>0&quot;>&lt;tns:QUANTITARECORDTOTALI>&lt;xsl:value-of select=&quot;xsd:int(QT_RECD_TOTALI)&quot;/>&lt;/tns:QUANTITARECORDTOTALI>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(DESCR_INTRFC)>0&quot;>&lt;tns:IDINTERFACCIA>&lt;xsl:value-of select=&quot;DESCR_INTRFC&quot;/>&lt;/tns:IDINTERFACCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(xsd:string(ID_PROCSO_FILE))>0&quot;>&lt;tns:IDESECPROCFILE>&lt;xsl:value-of select=&quot;xsd:int(ID_PROCSO_FILE)&quot;/>&lt;/tns:IDESECPROCFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;ESITO&quot;>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;ESITO&quot;/>&lt;/tns:ESITO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_APERTURA_FILE)&quot;>&lt;tns:APERTURAFILE>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_APERTURA_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:APERTURAFILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:APERTURAFILE>&lt;xsl:value-of select=&quot;TIMSTP_APERTURA_FILE&quot;/>&lt;/tns:APERTURAFILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(TIMSTP_CHIUSURA_FILE), &amp;quot;.&amp;quot;) and exists(TIMSTP_CHIUSURA_FILE)&quot;>&lt;tns:CHIUSURAFILE>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(TIMSTP_CHIUSURA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(TIMSTP_CHIUSURA_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:CHIUSURAFILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;TIMSTP_CHIUSURA_FILE&quot;>&lt;tns:CHIUSURAFILE>&lt;xsl:value-of select=&quot;TIMSTP_CHIUSURA_FILE&quot;/>&lt;/tns:CHIUSURAFILE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:CODOLOAGCOM>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:CODOLOAGCOM>&lt;/xsl:if>&lt;tns:DESCRSTATOACQUISIZIONE>&lt;xsl:value-of select=&quot;DESCR_STATO_FILE&quot;/>&lt;/tns:DESCRSTATOACQUISIZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string(DATA_FILE), &amp;quot;.&amp;quot;) and exists(DATA_FILE)&quot;>&lt;tns:DATAFILE>&lt;xsl:value-of select=&quot;concat(substring-before(xsd:string(DATA_FILE), &amp;quot;.&amp;quot;), &amp;quot;+&amp;quot;, substring-after(xsd:string(DATA_FILE), &amp;quot;+&amp;quot;))&quot;/>&lt;/tns:DATAFILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DATA_FILE&quot;>&lt;tns:DATAFILE>&lt;xsl:value-of select=&quot;DATA_FILE&quot;/>&lt;/tns:DATAFILE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(xsd:string(IDFILES))>0&quot;>&lt;tns:IDFILE>&lt;xsl:value-of select=&quot;xsd:int(IDFILES)&quot;/>&lt;/tns:IDFILE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(DESCR_CAUS_SCARTO)>0 or DESCR_STATO_FILE='SCADUTO'&quot;>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'ROSSO'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:when>&lt;xsl:when test=&quot;DESCR_STATO_FILE='ELABORATO'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(QT_RECD_NOW)=0&quot;>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'GRIGIO'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'VERDE'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SEMAFORO>&lt;xsl:value-of select=&quot;'GIALLO'&quot;/>&lt;/tns:SEMAFORO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DATA_ARRIVO>&lt;xsl:value-of select=&quot;substring-before(string(DATA_ARRIVO),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:DATA_ARRIVO>&lt;xsl:if test=&quot;string-length(xsd:string(TOT_ORD_CRMWS))>0&quot;>&lt;tns:TOT_ORDINI_CRMWS>&lt;xsl:value-of select=&quot;xsd:int(TOT_ORD_CRMWS)&quot;/>&lt;/tns:TOT_ORDINI_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(DESCR)>0&quot;>&lt;tns:ID_TIPOLOGIA_FILE>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:ID_TIPOLOGIA_FILE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(TIMSTP_RISTTMISS) and string-length( string (TIMSTP_RISTTMISS))>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;DESCR_STATO_FILE='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_APERTURA_FILE,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_RISTTMISS,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1)&quot;>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;DESCR_STATO_FILE='IN ELABORAZIONE' and (tib:compare-dateTime(tib:add-to-dateTime(TIMSTP_APERTURA_FILE,0, 0, 0, $timestamprisottomissione, 0, 0),current-dateTime())=-1) &quot;>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FLAG_RISOTTOMETTI>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:FLAG_RISOTTOMETTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:lista>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($QueryFileOlo/Record)>=$MaxRows) th