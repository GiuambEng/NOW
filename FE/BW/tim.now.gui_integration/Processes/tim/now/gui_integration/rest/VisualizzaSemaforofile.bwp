                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/semforo&quot; xmlns:tns3=&quot;http://xmlns.example.com/visualizzasemaforofile/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Profilo&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirectOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;SQLDirectNoOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;timestamprisottomissione&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:template name=&quot;LISTAATTRIBUTI&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($Profilo,$post.parameters/tns3:tipoprofilo)&quot;>&#xa;                &lt;tns:listaattributirecuperati>&#xa;                    &lt;xsl:for-each select=&quot;$SQLDirectOLO/unknownResultset[1]/row&quot;>&#xa;                        &lt;tns:lista>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_FILE']/value)&quot;>&#xa;                                &lt;tns:NOMEFILE>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='NOME_FILE']/value&quot;/>&#xa;                                &lt;/tns:NOMEFILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='DIMENSIONE_FILE']/value))>0&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string(colu