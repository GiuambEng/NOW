                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DT_FINE_VALIDITA"
                                    dataType="93" typeName="DATE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
