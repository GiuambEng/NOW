                                    <bpws:source linkName="InvokeToCallProcess_ricercaAvanzata">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($post/item/ns5:inputservizioricercaavanzata/ns5:strutturaCondition[1]/ns5:nome)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($post.item/ns5:strutturaCondition[1]/ns5:nome)>0]]></bpws:transitionCondition>
