                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputservizioricercaavanzata>&#xa;            &lt;xsl:for-each select=&quot;$post/item/tns2:inputservizioricercaavanzata/tns2:strutturaCondition&quot;>&#xa;                &lt;tns2:strutturaCondition>&#xa;                    &lt;xsl:if test=&quot;tns2:nome&quot;>&#xa;                        &lt;tns2:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns2:nome&quot;/>&#xa;                        &lt;/tns2:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;tns2:nome = (&amp;quot;PROFILO1&amp;quot;,&amp;quot;PROFILO2&amp;quot;,&amp;quot;PROFILO3&amp;quot;) and tns2:valore = 'N' and tns2:operazione = '='&quot;>&#xa;                            &lt;tns2:operazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ISNULL&amp;quot;&quot;/>&#xa;                            &lt;/tns2:operazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;tns2:operazione&quot;>&#xa;                                &lt;tns2:operazione>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:operazione&quot;/>&#xa;                                &lt;/tns2:operazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;tns2:nome = &amp;quot;PROFILO1&amp;quot; and tns2:valore = 'Y'&quot;>&#xa;                            &lt;tns2:valore>&#xa;                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                            &lt;/tns2:valore>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;tns2:nome = &amp;quot;PROFILO2&amp;quot; and tns2:valore = 'Y'&quot;>&#xa;                            &lt;tns2:valore>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns2:valore>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;tns2:nome = &amp;quot;PROFILO3&amp;quot; and tns2:valore = 'Y'&quot;>&#xa;                            &lt;tns2:valore>&#xa;                                &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                            &lt;/tns2:valore>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;tns2:valore&quot;>&#xa;                                &lt;tns2:valore>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:valore&quot;/>&#xa;                                &lt;/tns2:valore>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;tns2:tipo&quot;>&#xa;                        &lt;tns2:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns2:tipo&quot;/>&#xa;                        &lt;/tns2:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$post/item/tns2:inputservizioricercaavanzata/tns2:indiceriga&quot;>&#xa;                &lt;tns2:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns2:inputservizioricercaavanzata/tns2:indiceriga&quot;/>&#xa;                &lt;/tns2:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post/item/tns2:inputservizioricercaavanzata/tns2:numerorighe&quot;>&#xa;                &lt;tns2:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$post/item/tns2:inputservizioricercaavanzata/tns2:numerorighe&quot;/>&#xa;                &lt;/tns2:numerorighe>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RicercaAvanzata-input"
                                    name="RicercaAvanzata"
