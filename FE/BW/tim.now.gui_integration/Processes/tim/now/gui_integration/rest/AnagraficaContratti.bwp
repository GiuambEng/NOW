                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contratto&quot; xmlns:tns4=&quot;http://xmlns.example.com/AnagraficaContratti/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;tipoProfilo&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;ListaContrattiOlo&quot;/>&lt;xsl:param name=&quot;ListaContrattiDG&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;ListaContrattiNonOloNonDG&quot;/>&lt;xsl:param name=&quot;IpSessione&quot;/>&lt;xsl:template name=&quot;ListaVariable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ListaContrattiOlo/Record[1]/COD_CONTRATTO) > 0 or string-length($ListaContrattiDG/Record[1]/COD_CONTRATTO) > 0 or&amp;#xD;&amp;#xA;string-length($ListaContrattiNonOloNonDG/Record[1]/COD_CONTRATTO) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($tipoProfilo, $get/parameters/tns4:anagraficacontrattiGetParameters/tns4:tipoProfilo) = true()&quot;>&lt;tns:outputListaContratti>&lt;xsl:for-each select=&quot;$ListaContrattiOlo/Record&quot;>&lt;tns:contratto>&lt;xsl:variable name=&quot;currId&quot; select=&quot;string(ID_CONTRATTO)&quot;/>&lt;xsl:if test=&quot;exists(ID_CONTRATTO)&quot;>&lt;tns:idContratto>&lt;xsl:value-of select=&quot;xsd:int(ID_CONTRATTO)&quot;/>&lt;/tns:idContratto>&lt;/xsl:if>&lt;tns:codiceContratto>&lt;xsl:value-of select=&quot;COD_CONTRATTO&quot;/>&lt;/tns:codiceContratto>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_CONTRATTO&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;NOME_CONTRATTO&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPO&quot;>&lt;tns:tipo>&lt;xsl:value-of select=&quot;TIPO&quot;/>&lt;/tns:tipo>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOSERVDESCR&quot;>&lt;tns:idTipoServizio>&lt;xsl:value-of select=&quot;TIPOSERVDESCR&quot;/>&lt;/tns:idTipoServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRSTATOCONTR&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;DESCRSTATOCONTR&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:tipoProdotti>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:tipoProdotti>&lt;/xsl:if>&lt;tns:flagNPD>&lt;xsl:value-of select=&quot;FLAG_NPD&quot;/>&lt;/tns:flagNPD>&lt;xsl:if test=&quot;FLAG_ABILITATO&quot;>&lt;tns:flagAbilitato>&lt;xsl:value-of select=&quot;FLAG_ABILITATO&quot;/>&lt;/tns:flagAbilitato>&lt;/xsl:if>&lt;tns:flagValido>&lt;xsl:value-of select=&quot;FLAG_VALIDO&quot;/>&lt;/tns:flagValido>&lt;xsl:if test=&quot;FLAG_STANDARD&quot;>&lt;tns:flagStandard>&lt;xsl:value-of select=&quot;FLAG_STANDARD&quot;/>&lt;/tns:flagStandard>&lt;/xsl:if>&lt;tns:flagFileNotify>&lt;xsl:value-of select=&quot;FLAG_FILE_NOTIFY&quot;/>&lt;/tns:flagFileNotify>&lt;tns:flagDiffidato>&lt;xsl:value-of select=&quot;FLAG_DIFFIDATO&quot;/>&lt;/tns:flagDiffidato>&lt;tns:flagAnfibio>&lt;xsl:value-of select=&quot;FLAG_ANFIBIO&quot;/>&lt;/tns:flagAnfibio>&lt;xsl:if test=&quot;exists(ID_COD_CONTRATTO_PADRE)&quot;>&lt;tns:idContrattoPadre>&lt;xsl:value-of select=&quot;xsd:int(ID_COD_CONTRATTO_PADRE)&quot;/>&lt;/tns:idContrattoPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_STANDARD&quot;>&lt;tns:statoStandard>&lt;xsl:value-of select=&quot;STATO_STANDARD&quot;/>&lt;/tns:statoStandard>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_AGGTO)&quot;>&lt;tns:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_AGGTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataUltimoAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_INSMTO)&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_INSMTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;ID_CONTRATTO_CRMWS&quot;>&lt;tns:identificativoContrattoCRMW>&lt;xsl:value-of select=&quot;ID_CONTRATTO_CRMWS&quot;/>&lt;/tns:identificativoContrattoCRMW>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_STANDARD&quot;>&lt;tns:nomeStandard>&lt;xsl:value-of select=&quot;NOME_STANDARD&quot;/>&lt;/tns:nomeStandard>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATAINZ_VALID)&quot;>&lt;tns:dataInizio>&lt;xsl:value-of select=&quot;substring-before(string(DATAINZ_VALID), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATAFI_VALID)&quot;>&lt;tns:dataFine>&lt;xsl:value-of select=&quot;substring-before(string(DATAFI_VALID), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFine>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(IDTPLG_CONTRATTO)&quot;>&lt;tns:identificativoTipologiaContratto>&lt;xsl:value-of select=&quot;xsd:int(IDTPLG_CONTRATTO)&quot;/>&lt;/tns:identificativoTipologiaContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRTIPCONTR&quot;>&lt;tns:tipoContratto>&lt;xsl:value-of select=&quot;DESCRTIPCONTR&quot;/>&lt;/tns:tipoContratto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;xsd:int(ID_SISTEMA) = 15&quot;>&lt;tns:idSistemaCompetente>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:idSistemaCompetente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:idSistemaCompetente>&lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&lt;/tns:idSistemaCompetente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:oao>&lt;xsl:if test=&quot;NOME&quot;>&lt;tns:olo>&lt;xsl:value-of select=&quot;NOME&quot;/>&lt;/tns:olo>&lt;/xsl:if>&lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&lt;tns:ragioneSociale>&lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&lt;/tns:ragioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;PARTITA_IVA&quot;>&lt;tns:partitaIva>&lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&lt;/tns:partitaIva>&lt;/xsl:if>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codiceOloAgcom>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codiceOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_OLO&quot;>&lt;tns:codiceOloNumerico>&lt;xsl:value-of select=&quot;COD_OLO&quot;/>&lt;/tns:codiceOloNumerico>&lt;/xsl:if>&lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&lt;tns:flagAccorpante>&lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&lt;/tns:flagAccorpante>&lt;/xsl:if>&lt;/tns:oao>&lt;xsl:if test=&quot;DESCR='FWA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;not(empty(PROFILO1))&quot;>&lt;tns:contrattoFwaInfratel>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:contrattoFwaInfratel>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:contrattoFwaInfratel>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:contrattoFwaInfratel>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR='FWA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;not(empty(PROFILO2))&quot;>&lt;tns:contrattoFwaPlus>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:contrattoFwaPlus>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:contrattoFwaPlus>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:contrattoFwaPlus>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR='FWA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;not(empty(PROFILO3))&quot;>&lt;tns:contrattoFwaDecommissioning>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:contrattoFwaDecommissioning>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:contrattoFwaDecommissioning>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:contrattoFwaDecommissioning>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATA_INIZIO_COINV_RETE)&quot;>&lt;tns:dataInizioCoinvestimento>&lt;xsl:value-of select=&quot;substring-before(string(DATA_INIZIO_COINV_RETE), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizioCoinvestimento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATA_FINE_COINV_RETE)&quot;>&lt;tns:dataFineCoinvestimento>&lt;xsl:value-of select=&quot;substring-before(string(DATA_FINE_COINV_RETE), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFineCoinvestimento>&lt;/xsl:if>&lt;xsl:if test=&quot;BOUQUET&quot;>&lt;tns:bouquet>&lt;xsl:value-of select=&quot;BOUQUET&quot;/>&lt;/tns:bouquet>&lt;/xsl:if>&lt;tns:datiMulticast>&lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 2]&quot;>&lt;tns:datiIpSessione>&lt;tns:ipSessione>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:ipSessione>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiIpSessione>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 3]&quot;>&lt;tns:datiIpMulticast>&lt;tns:ipMulticast>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:ipMulticast>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiIpMulticast>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 4]&quot;>&lt;tns:datiIpSorgente>&lt;tns:ipSorgente>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:ipSorgente>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiIpSorgente>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 1]&quot;>&lt;tns:datiAsNumber>&lt;tns:asNumber>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:asNumber>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiAsNumber>&lt;/xsl:for-each>&lt;/tns:datiMulticast>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'SI'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'NO'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(FLAG_DISABILITAZIONE_SERV)>0&quot;>&lt;tns:datiSospensioneServizio>&lt;xsl:if test=&quot;exists(DATA_INI_DISABILITAZIONE_SERV)&quot;>&lt;tns:dataInizioDisabil>&lt;xsl:value-of select=&quot;substring-before(string(DATA_INI_DISABILITAZIONE_SERV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizioDisabil>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATA_FIN_DISABILITAZIONE_SERV)&quot;>&lt;tns:dataFineDisabil>&lt;xsl:value-of select=&quot;substring-before(string(DATA_FIN_DISABILITAZIONE_SERV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFineDisabil>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;FLAG_DISABILITAZIONE_SERV = 'SI'&quot;>&lt;tns:flagDisabil>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagDisabil>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:flagDisabil>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagDisabil>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:datiSospensioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;EMAIL_OFFERTAFWA1GIGASARDEGNA&quot;>&lt;tns:emailOffertaFwa1GigaSardegna>&lt;xsl:value-of select=&quot;EMAIL_OFFERTAFWA1GIGASARDEGNA&quot;/>&lt;/tns:emailOffertaFwa1GigaSardegna>&lt;/xsl:if>&lt;/tns:contratto>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if(count($ListaContrattiOlo/Record)&amp;lt;$MaxRows) then 'OK' else 'LIMIT'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputListaContratti>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($get/parameters/tns4:anagraficacontrattiGetParameters/tns4:tipoProfilo,'DG') = true()&quot;>&lt;tns:outputListaContratti>&lt;xsl:for-each select=&quot;$ListaContrattiDG/Record&quot;>&lt;tns:contratto>&lt;xsl:variable name=&quot;currIdDG&quot; select=&quot;ID_CONTRATTO&quot;/>&lt;xsl:if test=&quot;exists(ID_CONTRATTO)&quot;>&lt;tns:idContratto>&lt;xsl:value-of select=&quot;xsd:int(ID_CONTRATTO)&quot;/>&lt;/tns:idContratto>&lt;/xsl:if>&lt;tns:codiceContratto>&lt;xsl:value-of select=&quot;COD_CONTRATTO&quot;/>&lt;/tns:codiceContratto>&lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_CONTRATTO&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;NOME_CONTRATTO&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPO&quot;>&lt;tns:tipo>&lt;xsl:value-of select=&quot;TIPO&quot;/>&lt;/tns:tipo>&lt;/xsl:if>&lt;xsl:if test=&quot;TIPOSERVDESCR&quot;>&lt;tns:idTipoServizio>&lt;xsl:value-of select=&quot;TIPOSERVDESCR&quot;/>&lt;/tns:idTipoServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRSTATOCONTR&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;DESCRSTATOCONTR&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns:tipoProdotti>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns:tipoProdotti>&lt;/xsl:if>&lt;tns:flagNPD>&lt;xsl:value-of select=&quot;FLAG_NPD&quot;/>&lt;/tns:flagNPD>&lt;xsl:if test=&quot;FLAG_ABILITATO&quot;>&lt;tns:flagAbilitato>&lt;xsl:value-of select=&quot;FLAG_ABILITATO&quot;/>&lt;/tns:flagAbilitato>&lt;/xsl:if>&lt;tns:flagValido>&lt;xsl:value-of select=&quot;FLAG_VALIDO&quot;/>&lt;/tns:flagValido>&lt;xsl:if test=&quot;FLAG_STANDARD&quot;>&lt;tns:flagStandard>&lt;xsl:value-of select=&quot;FLAG_STANDARD&quot;/>&lt;/tns:flagStandard>&lt;/xsl:if>&lt;tns:flagFileNotify>&lt;xsl:value-of select=&quot;FLAG_FILE_NOTIFY&quot;/>&lt;/tns:flagFileNotify>&lt;tns:flagDiffidato>&lt;xsl:value-of select=&quot;FLAG_DIFFIDATO&quot;/>&lt;/tns:flagDiffidato>&lt;tns:flagAnfibio>&lt;xsl:value-of select=&quot;FLAG_ANFIBIO&quot;/>&lt;/tns:flagAnfibio>&lt;xsl:if test=&quot;exists(ID_COD_CONTRATTO_PADRE)&quot;>&lt;tns:idContrattoPadre>&lt;xsl:value-of select=&quot;xsd:int(ID_COD_CONTRATTO_PADRE)&quot;/>&lt;/tns:idContrattoPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_STANDARD&quot;>&lt;tns:statoStandard>&lt;xsl:value-of select=&quot;STATO_STANDARD&quot;/>&lt;/tns:statoStandard>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_AGGTO)&quot;>&lt;tns:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_AGGTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataUltimoAggiornamento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(TIMSTP_INSMTO)&quot;>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_INSMTO), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInserimento>&lt;/xsl:if>&lt;xsl:if test=&quot;ID_CONTRATTO_CRMWS&quot;>&lt;tns:identificativoContrattoCRMW>&lt;xsl:value-of select=&quot;ID_CONTRATTO_CRMWS&quot;/>&lt;/tns:identificativoContrattoCRMW>&lt;/xsl:if>&lt;xsl:if test=&quot;NOME_STANDARD&quot;>&lt;tns:nomeStandard>&lt;xsl:value-of select=&quot;NOME_STANDARD&quot;/>&lt;/tns:nomeStandard>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATAINZ_VALID)&quot;>&lt;tns:dataInizio>&lt;xsl:value-of select=&quot;substring-before(string(DATAINZ_VALID), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizio>&lt;/xsl:if>&lt;xsl:if test=&quot;exi