W.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO1,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 2 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO2,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 3 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO3,C.DATA_FINE_COINV_RETE,C.DATA_INIZIO_COINV_RETE,(SELECT DISTINCT VALORE_ATTRIBUTO FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 AND CAM.ID_CONTRATTO=C.ID_CONTRATTO AND CAM.DT_FINE_VALIDITA>SYSDATE) AS BOUQUET,C.FLAG_MULTICAST,C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV from CONTRATTO C LEFT JOIN TIPOLG_CONTRATTO ON C.IDTPLG_CONTRATTO = TIPOLG_CONTRATTO.IDTPLG_CONTRATTO LEFT JOIN SOTTO_FAMIG_OFFERTA ON C.ID_SOTTOFAMIG_OFFERTA = SOTTO_FAMIG_OFFERTA.ID_SOTTOFAMIG_OFFERTA LEFT JOIN TIPOLG_STATO_CONTRATTO ON C.ID_STATO_CONTRATTO = TIPOLG_STATO_CONTRATTO.ID_STATO_CONTRATTO LEFT JOIN FAMIG_OFFERTA ON C.ID_FAMIG_OFFERTA = FAMIG_OFFERTA.ID_FAMIG_OFFERTA LEFT JOIN OLO O ON C.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM WHERE C.ID_SOTTOFAMIG_OFFERTA NOT IN (SELECT ID_SOTTOFAMIG_OFFERTA FROM SOTTO_FAMIG_OFFERTA WHERE DESCR = 'IAV') AND C.CODFC_OLO_AGCOM IN ('&amp;quot;, tib:concat-sequence-format($post_ListaOloInvoke.output/tns1:profiloOlo/tns1:anagraficaOlo/tns1:codiceAgcom, &amp;quot;','&amp;quot;, true()), &amp;quot;'))   &amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT * FROM (SELECT C.COD_CONTRATTO, C.ID_CONTRATTO, C.NOME_CONTRATTO, C.TIPO, C.ID_STATO_CONTRATTO, C.ID_FAMIG_OFFERTA, C.ID_SOTTOFAMIG_OFFERTA, C.FLAG_ANFIBIO, C.FLAG_ABILITATO, C.FLAG_DIFFIDATO, C.FLAG_STANDARD, C.FLAG_VALIDO, C.FLAG_NPD, C.DATAINZ_VALID, C.DATAFI_VALID, C.IDTPLG_CONTRATTO, C.ID_CONTRATTO_CRMWS, C.NOME_STANDARD, C.OPERATORE, C.STATO_STANDARD, C.ID_COD_CONTRATTO_PADRE, C.FLAG_FILE_NOTIFY, C.TIMSTP_AGGTO, C.TIMSTP_INSMTO, C.EMAIL_OFFERTAFWA1GIGASARDEGNA, TIPOLG_CONTRATTO.DESCR AS DESCRTIPCONTR, TIPOLG_STATO_CONTRATTO.DESCRIPTION AS DESCRSTATOCONTR, SOTTO_FAMIG_OFFERTA.DESCR AS DESCR, FAMIG_OFFERTA.DESCR AS  TIPOSERVDESCR, O.NOME, O.RAGIONE_SOCIALE, O.PARTITA_IVA, O.CODFC_OLO_AGCOM, O.COD_OLO, O.FLAG_OLO_ACCORPANTE, C.ID_SISTEMA, (SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 1 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO1,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 2 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO2,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 3 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO3,C.DATA_FINE_COINV_RETE,C.DATA_INIZIO_COINV_RETE,(SELECT DISTINCT VALORE_ATTRIBUTO FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 AND CAM.ID_CONTRATTO=C.ID_CONTRATTO AND CAM.DT_FINE_VALIDITA>SYSDATE) AS BOUQUET,C.FLAG_MULTICAST,C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV from CONTRATTO C LEFT JOIN TIPOLG_CONTRATTO ON C.IDTPLG_CONTRATTO = TIPOLG_CONTRATTO.IDTPLG_CONTRATTO LEFT JOIN SOTTO_FAMIG_OFFERTA ON C.ID_SOTTOFAMIG_OFFERTA = SOTTO_FAMIG_OFFERTA.ID_SOTTOFAMIG_OFFERTA LEFT JOIN TIPOLG_STATO_CONTRATTO ON C.ID_STATO_CONTRATTO = TIPOLG_STATO_CONTRATTO.ID_STATO_CONTRATTO LEFT JOIN FAMIG_OFFERTA ON C.ID_FAMIG_OFFERTA = FAMIG_OFFERTA.ID_FAMIG_OFFERTA LEFT JOIN OLO O ON C.C