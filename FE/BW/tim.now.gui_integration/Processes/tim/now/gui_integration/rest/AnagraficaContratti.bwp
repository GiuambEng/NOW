                                tibex:xpdlId="4b55c802-73e6-4f81-ae2b-979ebf656dae" variable="postOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://xmlns.example.com/20160510140109PLT" xmlns:tns="http://www.tim.com/NOW/rest/contratto" xmlns:tns2="http://www.tim.com/NOW/rest/servizioricercaavanzata" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns7="http://www.example.org/CryptoParams" version="2.0"&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="ListaVariable"/&gt;
    &lt;xsl:param name="CryptoParams"/&gt;
    &lt;xsl:template name="postOut-input" match="/"&gt;
        &lt;tns6:postResponse&gt;
            &lt;item&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($post/item/tns2:inputservizioricercaavanzata/tns2:exportRequest) and (upper-case($post/item/tns2:inputservizioricercaavanzata/tns2:exportRequest)='S' or upper-case($post/item/tns2:inputservizioricercaavanzata/tns2:exportRequest)='Y') and exists($ListaVariable/tns:contratto[1])"&gt;
                        &lt;tns:outputListaContratti&gt;
                            &lt;tns:result&gt;
                                &lt;tns:severity&gt;
                                    &lt;xsl:value-of select="'INFO'"/&gt;
                                &lt;/tns:severity&gt;
                                &lt;tns:code&gt;
                                    &lt;xsl:value-of select="'OK'"/&gt;
                                &lt;/tns:code&gt;
                            &lt;/tns:result&gt;
                            &lt;tns:idExportFile&gt;
                                &lt;xsl:value-of select="$CryptoParams/tns7:idFileCriptato"/&gt;
                            &lt;/tns:idExportFile&gt;
                        &lt;/tns:outputListaContratti&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:outputListaContratti&gt;
                            &lt;xsl:copy-of select="$ListaVariable/tns:contratto"/&gt;
                            &lt;xsl:copy-of select="$ListaVariable/tns:result"/&gt;
                            &lt;xsl:if test="$ListaVariable/tns:idExportFile"&gt;
                                &lt;tns:idExportFile&gt;
                                    &lt;xsl:value-of select="$ListaVariable/tns:idExportFile"/&gt;
                                &lt;/tns:idExportFile&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:outputListaContratti&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/item&gt;
        &lt;/tns6:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://xmlns.example.com/20160510140109PLT&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contratto&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.example.org/CryptoParams&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaVariable&quot;/>&#xa;    &lt;xsl:param name=&quot;CryptoParams&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($post.item/tns2:exportRequest) and (upper-case($post.item/tns2:exportRequest)='S' or upper-case($post.item/tns2:exportRequest)='Y') and exists($ListaVariable/tns:contratto[1])&quot;>&#xa;                &lt;tns:outputListaContratti>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                    &lt;tns:idExportFile>&#xa;                        &lt;xsl:value-of select=&quot;$CryptoParams/tns7:idFileCriptato&quot;/>&#xa;                    &lt;/tns:idExportFile>&#xa;                &lt;/tns:outputListaContratti>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputListaContratti>&#xa;                    &lt;xsl:copy-of select=&quot;$ListaVariable/tns:contratto&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$ListaVariable/tns:result&quot;/>&#xa;                    &lt;xsl:if test=&quot;$ListaVariable/tns:idExportFile&quot;>&#xa;                        &lt;tns:idExportFile>&#xa;                            &lt;xsl:value-of select=&quot;$ListaVariable/tns:idExportFile&quot;/>&#xa;                        &lt;/tns:idExportFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:outputListaContratti>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
