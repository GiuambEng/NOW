&lt;xsl:when test=&quot;not(empty(column[name='PROFILO2']/value))&quot;>&lt;tns:contrattoFwaPlus>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:contrattoFwaPlus>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:contrattoFwaPlus>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:contrattoFwaPlus>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;column[name='DESCR']/value = 'FWA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;not(empty(column[name='PROFILO3']/value))&quot;>&lt;tns:contrattoFwaDecommissioning>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:contrattoFwaDecommissioning>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:contrattoFwaDecommissioning>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:contrattoFwaDecommissioning>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='DATA_INIZIO_COINV_RETE']/value)&quot;>&lt;tns:dataInizioCoinvestimento>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_INIZIO_COINV_RETE']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizioCoinvestimento>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='DATA_FINE_COINV_RETE']/value)&quot;>&lt;tns:dataFineCoinvestimento>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_FINE_COINV_RETE']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFineCoinvestimento>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='BOUQUET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='BOUQUET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='BOUQUET']/value)&quot;>&lt;tns:bouquet>&lt;xsl:value-of select=&quot;column[name='BOUQUET']/value&quot;/>&lt;/tns:bouquet>&lt;/xsl:if>&lt;tns:datiMulticast>&lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currIdDG and ID_TIPOLOG_CONTR_ATTR_MULTI = 2]&quot;>&lt;tns:datiIpSessione>&lt;tns:ipSessione>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:ipSessione>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiIpSessione>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currIdDG and ID_TIPOLOG_CONTR_ATTR_MULTI = 3]&quot;>&lt;tns:datiIpMulticast>&lt;tns:ipMulticast>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:ipMulticast>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiIpMulticast>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currIdDG and ID_TIPOLOG_CONTR_ATTR_MULTI = 4]&quot;>&lt;tns:datiIpSorgente>&lt;tns:ipSorgente>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:ipSorgente>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiIpSorgente>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currIdDG and ID_TIPOLOG_CONTR_ATTR_MULTI = 1]&quot;>&lt;tns:datiAsNumber>&lt;tns:asNumber>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:asNumber>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiAsNumber>&lt;/xsl:for-each>&lt;/tns:datiMulticast>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string(column[name='FLAG_MULTICAST']/value))>0 and column[name='FLAG_MULTICAST']/value = 'SI'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(string(column[name='FLAG_MULTICAST']/value))>0 and column[name='FLAG_MULTICAST']/value = 'NO'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(string(column[name='FLAG_DISABILITAZIONE_SERV']/value))&quot;>&lt;tns:datiSospensioneServizio>&lt;xsl:if test=&quot;exists(column[name='DATA_INI_DISABILITAZIONE_SERV']/value)&quot;>&lt;tns:dataInizioDisabil>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_INI_DISABILITAZIONE_SERV']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizioDisabil>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='DATA_FIN_DISABILITAZIONE_SERV']/value)&quot;>&lt;tns:dataFineDisabil>&lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_FIN_DISABILITAZIONE_SERV']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFineDisabil>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;column[name='FLAG_DISABILITAZIONE_SERV']/value = 'SI'&quot;>&lt;tns:flagDisabil>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagDisabil>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:flagDisabil>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagDisabil>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:datiSospensioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value)&quot;>&lt;tns:emailOffertaFwa1GigaSardegna>&lt;xsl:value-of select=&quot;column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value&quot;/>&lt;/tns:emailOffertaFwa1GigaSardegna>&lt;/xsl:if>&lt;/tns:contratto>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;xsl:if test=&quot;count($NON_OLO/unknownResultset/row)>=$MaxRows&quot;>&lt;tns:details>&lt;xsl:value-of select=&quot;'LIMIT'&quot;/>&lt;/tns:details>&lt;/xsl:if>&lt;/tns:result>&lt;/tns:outputListaContratti>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputListaContratti>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi corrispondenti ai criteri di ricerca&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputListaContratti>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ListaVariable"
                                    name="post_ListaContratti"
                                    outputVariable="ListaVariable"
                                    tibex:xpdlId="ff5f4c43-3fb6-4756-bc4c-3968ac735d10" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryTopost_ListaContratti"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="post_Export">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($post/item/ns5:inputservizioricercaavanzata/ns5:exportRequest= &quot;Y&quot; or $post/item/ns5:inputservizioricercaavanzata/ns5:exportRequest= &quot;S&quot; )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($post.item/ns5:exportRequest= "Y" or $post.item/ns5:exportRequest= "S" )]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="post_ListaContrattiTopost_AnagContratti_out_NoExport">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contratto&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://xmlns.example.com/AnagraficaContratti/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;tipoProfilo&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;NON_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaDatiIpMulticastPost&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaVariable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($tipoProfilo, $post.parameters/tns4:tipoProfilo) = true() and string-length(string($OLO/unknownResultset/row[1]/column[name='COD_CONTRATTO']/value))>0&quot;>&#xa;                &lt;tns:outputListaContratti>&#xa;                    &lt;xsl:for-each select=&quot;$OLO/unknownResultset/row&quot;>&#xa;                        &lt;tns:contratto>&#xa;                            &lt;xsl:variable name=&quot;currId&quot; select=&quot;string(column[name='ID_CONTRATTO']/value)&quot;/>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='ID_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_CONTRATTO']/value)&quot;>&#xa;                                &lt;tns:idContratto>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='ID_CONTRATTO']/value&quot;/>&#xa;                                &lt;/tns:idContratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_CONTRATTO']/value)&quot;>&#xa;                                &lt;tns:codiceContratto>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='COD_CONTRATTO']/value&quot;/>&#xa;                                &lt;/tns:codiceContratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&#xa;                                &lt;tns:codificaOAO>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                                &lt;/tns:codificaOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CONTRATTO']/value)&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='NOME_CONTRATTO']/value&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='TIPO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPO']/value)&quot;>&#xa;                                &lt;tns:tipo>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='TIPO']/value&quot;/>&#xa;                                &lt;/tns:tipo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='TIPOSERVDESCR']/value)&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='TIPOSERVDESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOSERVDESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOSERVDESCR']/value)&quot;>&#xa;                                    &lt;tns:idTipoServizio>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='TIPOSERVDESCR']/value&quot;/>&#xa;                                    &lt;/tns:idTipoServizio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='ID_STATO_CONTRATTO']/value)&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='DESCRSTATOCONTR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCRSTATOCONTR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCRSTATOCONTR']/value)&quot;>&#xa;                                    &lt;tns:stato>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='DESCRSTATOCONTR']/value&quot;/>&#xa;                                    &lt;/tns:stato>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='ID_SOTTOFAMIG_OFFERTA']/value)&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR']/value)&quot;>&#xa;                                    &lt;tns:tipoProdotti>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='DESCR']/value&quot;/>&#xa;                                    &lt;/tns:tipoProdotti>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_NPD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_NPD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_NPD']/value)&quot;>&#xa;                                &lt;tns:flagNPD>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_NPD']/value&quot;/>&#xa;                                &lt;/tns:flagNPD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_ABILITATO']/value)&quot;>&#xa;                                &lt;tns:flagAbilitato>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_ABILITATO']/value&quot;/>&#xa;                                &lt;/tns:flagAbilitato>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_VALIDO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_VALIDO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_VALIDO']/value)&quot;>&#xa;                                &lt;tns:flagValido>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_VALIDO']/value&quot;/>&#xa;                                &lt;/tns:flagValido>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_STANDARD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_STANDARD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_STANDARD']/value)&quot;>&#xa;                                &lt;tns:flagStandard>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_STANDARD']/value&quot;/>&#xa;                                &lt;/tns:flagStandard>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_FILE_NOTIFY']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_FILE_NOTIFY']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_FILE_NOTIFY']/value)&quot;>&#xa;                                &lt;tns:flagFileNotify>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_FILE_NOTIFY']/value&quot;/>&#xa;                                &lt;/tns:flagFileNotify>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_DIFFIDATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_DIFFIDATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_DIFFIDATO']/value)&quot;>&#xa;                                &lt;tns:flagDiffidato>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_DIFFIDATO']/value&quot;/>&#xa;                                &lt;/tns:flagDiffidato>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_ABILITATO']/value)&quot;>&#xa;                                &lt;tns:flagAnfibio>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_ABILITATO']/value&quot;/>&#xa;                                &lt;/tns:flagAnfibio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name= 'ID_COD_CONTRATTO_PADRE']/value)&quot;>&#xa;                                &lt;tns:idContrattoPadre>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name= 'ID_COD_CONTRATTO_PADRE']/value))&quot;/>&#xa;                                &lt;/tns:idContrattoPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='STATO_STANDARD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO_STANDARD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO_STANDARD']/value)&quot;>&#xa;                                &lt;tns:statoStandard>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='STATO_STANDARD']/value&quot;/>&#xa;                                &lt;/tns:statoStandard>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataUltimoAggiornamento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_AGGTO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataUltimoAggiornamento>&#xa;                            &lt;tns:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_INSMTO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataInserimento>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='ID_CONTRATTO_CRMWS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_CONTRATTO_CRMWS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_CONTRATTO_CRMWS']/value)&quot;>&#xa;                                &lt;tns:identificativoContrattoCRMW>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='ID_CONTRATTO_CRMWS']/value&quot;/>&#xa;                                &lt;/tns:identificativoContrattoCRMW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='NOME_STANDARD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_STANDARD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_STANDARD']/value)&quot;>&#xa;                                &lt;tns:nomeStandard>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='NOME_STANDARD']/value&quot;/>&#xa;                                &lt;/tns:nomeStandard>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DATAINZ_VALID']/value)&quot;>&#xa;                                &lt;tns:dataInizio>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATAINZ_VALID']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataInizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DATAFI_VALID']/value)&quot;>&#xa;                                &lt;tns:dataFine>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATAFI_VALID']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataFine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name= 'IDTPLG_CONTRATTO']/value)&quot;>&#xa;                                &lt;tns:identificativoTipologiaContratto>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name= 'IDTPLG_CONTRATTO']/value))&quot;/>&#xa;                                &lt;/tns:identificativoTipologiaContratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR']/value)&quot;>&#xa;                                &lt;tns:tipoContratto>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='DESCR']/value&quot;/>&#xa;                                &lt;/tns:tipoContratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;column[name='ID_SISTEMA']/value = '15'&quot;>&#xa;                                    &lt;tns:idSistemaCompetente>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                                    &lt;/tns:idSistemaCompetente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:idSistemaCompetente>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                                    &lt;/tns:idSistemaCompetente>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:oao>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME']/value)&quot;>&#xa;                                    &lt;tns:olo>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='NOME']/value&quot;/>&#xa;                                    &lt;/tns:olo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='RAGIONE_SOCIALE']/value)&quot;>&#xa;                                    &lt;tns:ragioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='RAGIONE_SOCIALE']/value&quot;/>&#xa;                                    &lt;/tns:ragioneSociale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='PARTITA_IVA']/value)&quot;>&#xa;                                    &lt;tns:partitaIva>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='PARTITA_IVA']/value&quot;/>&#xa;                                    &lt;/tns:partitaIva>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&#xa;                                    &lt;tns:codiceOloAgcom>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                                    &lt;/tns:codiceOloAgcom>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO']/value)&quot;>&#xa;                                    &lt;tns:codiceOloNumerico>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='COD_OLO']/value&quot;/>&#xa;                                    &lt;/tns:codiceOloNumerico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_OLO_ACCORPANTE']/value)&quot;>&#xa;                                    &lt;tns:flagAccorpante>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='FLAG_OLO_ACCORPANTE']/value&quot;/>&#xa;                                    &lt;/tns:flagAccorpante>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:oao>&#xa;                            &lt;xsl:if test=&quot;column[name='DESCR']/value = 'FWA'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;not(empty(column[name='PROFILO1']/value))&quot;>&#xa;                                        &lt;tns:contrattoFwaInfratel>&#xa;                                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaInfratel>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:contrattoFwaInfratel>&#xa;                                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaInfratel>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;column[name='DESCR']/value = 'FWA'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;not(empty(column[name='PROFILO2']/value))&quot;>&#xa;                                        &lt;tns:contrattoFwaPlus>&#xa;                                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaPlus>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:contrattoFwaPlus>&#xa;                                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaPlus>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;column[name='DESCR']/value = 'FWA'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;not(empty(column[name='PROFILO3']/value))&quot;>&#xa;                                        &lt;tns:contrattoFwaDecommissioning>&#xa;                                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaDecommissioning>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:contrattoFwaDecommissioning>&#xa;                                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaDecommissioning>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DATA_INIZIO_COINV_RETE']/value)&quot;>&#xa;                                &lt;tns:dataInizioCoinvestimento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_INIZIO_COINV_RETE']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataInizioCoinvestimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DATA_FINE_COINV_RETE']/value)&quot;>&#xa;                                &lt;tns:dataFineCoinvestimento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_FINE_COINV_RETE']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataFineCoinvestimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='BOUQUET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='BOUQUET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='BOUQUET']/value)&quot;>&#xa;                                &lt;tns:bouquet>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='BOUQUET']/value&quot;/>&#xa;                                &lt;/tns:bouquet>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:datiMulticast>&#xa;                                &lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 2]&quot;>&#xa;                                    &lt;tns:datiIpSessione>&#xa;                                        &lt;tns:ipSessione>&#xa;                                            &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                        &lt;/tns:ipSessione>&#xa;                                        &lt;tns:dataInizioValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataInizioValidita>&#xa;                                        &lt;tns:dataFineValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataFineValidita>&#xa;                                        &lt;tns:dataInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                        &lt;/tns:dataInserimento>&#xa;                                    &lt;/tns:datiIpSessione>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 3]&quot;>&#xa;                                    &lt;tns:datiIpMulticast>&#xa;                                        &lt;tns:ipMulticast>&#xa;                                            &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                        &lt;/tns:ipMulticast>&#xa;                                        &lt;tns:dataInizioValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataInizioValidita>&#xa;                                        &lt;tns:dataFineValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataFineValidita>&#xa;                                        &lt;tns:dataInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                        &lt;/tns:dataInserimento>&#xa;                                    &lt;/tns:datiIpMulticast>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 4]&quot;>&#xa;                                    &lt;tns:datiIpSorgente>&#xa;                                        &lt;tns:ipSorgente>&#xa;                                            &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                        &lt;/tns:ipSorgente>&#xa;                                        &lt;tns:dataInizioValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataInizioValidita>&#xa;                                        &lt;tns:dataFineValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataFineValidita>&#xa;                                        &lt;tns:dataInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                        &lt;/tns:dataInserimento>&#xa;                                    &lt;/tns:datiIpSorgente>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 1]&quot;>&#xa;                                    &lt;tns:datiAsNumber>&#xa;                                        &lt;tns:asNumber>&#xa;                                            &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                        &lt;/tns:asNumber>&#xa;                                        &lt;tns:dataInizioValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataInizioValidita>&#xa;                                        &lt;tns:dataFineValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataFineValidita>&#xa;                                        &lt;tns:dataInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                        &lt;/tns:dataInserimento>&#xa;                                    &lt;/tns:datiAsNumber>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/tns:datiMulticast>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(string(column[name='FLAG_MULTICAST']/value))>0 and column[name='FLAG_MULTICAST']/value = 'SI'&quot;>&#xa;                                    &lt;tns:flagMulticast>&#xa;                                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                    &lt;/tns:flagMulticast>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length(string(column[name='FLAG_MULTICAST']/value))>0 and column[name='FLAG_MULTICAST']/value = 'NO'&quot;>&#xa;                                    &lt;xsl:if test=&quot;not((string(column[name='FLAG_MULTICAST']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_MULTICAST']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_MULTICAST']/value)&quot;>&#xa;                                        &lt;tns:flagMulticast>&#xa;                                            &lt;xsl:value-of select=&quot;column[name='FLAG_MULTICAST']/value&quot;/>&#xa;                                        &lt;/tns:flagMulticast>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='FLAG_DISABILITAZIONE_SERV']/value))>0&quot;>&#xa;                                &lt;tns:datiSospensioneServizio>&#xa;                                    &lt;xsl:if test=&quot;exists(column[name= 'DATA_INI_DISABILITAZIONE_SERV']/value)&quot;>&#xa;                                        &lt;tns:dataInizioDisabil>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_INI_DISABILITAZIONE_SERV']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataInizioDisabil>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(column[name= 'DATA_FIN_DISABILITAZIONE_SERV']/value)&quot;>&#xa;                                        &lt;tns:dataFineDisabil>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_FIN_DISABILITAZIONE_SERV']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataFineDisabil>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;column[name='FLAG_DISABILITAZIONE_SERV']/value = 'SI'&quot;>&#xa;                                            &lt;tns:flagDisabil>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:flagDisabil>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:flagDisabil>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:flagDisabil>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns:datiSospensioneServizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value)&quot;>&#xa;                                &lt;tns:emailOffertaFwa1GigaSardegna>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value&quot;/>&#xa;                                &lt;/tns:emailOffertaFwa1GigaSardegna>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:contratto>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;xsl:if test=&quot;count($OLO/unknownResultset/row)>=$MaxRows&quot;>&#xa;                            &lt;tns:details>&#xa;                                &lt;xsl:value-of select=&quot;'LIMIT'&quot;/>&#xa;                            &lt;/tns:details>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputListaContratti>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;contains($tipoProfilo, $post.parameters/tns4:tipoProfilo) = false() and string-length(string($NON_OLO/unknownResultset/row[1]/column[name='COD_CONTRATTO']/value))>0&quot;>&#xa;                &lt;tns:outputListaContratti>&#xa;                    &lt;xsl:for-each select=&quot;$NON_OLO/unknownResultset/row&quot;>&#xa;                        &lt;tns:contratto>&#xa;                            &lt;xsl:variable name=&quot;currIdDG&quot; select=&quot;string(column[name='ID_CONTRATTO']/value)&quot;/>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='ID_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_CONTRATTO']/value)&quot;>&#xa;                                &lt;tns:idContratto>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='ID_CONTRATTO']/value&quot;/>&#xa;                                &lt;/tns:idContratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_CONTRATTO']/value)&quot;>&#xa;                                &lt;tns:codiceContratto>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='COD_CONTRATTO']/value&quot;/>&#xa;                                &lt;/tns:codiceContratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&#xa;                                &lt;tns:codificaOAO>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                                &lt;/tns:codificaOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CONTRATTO']/value)&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='NOME_CONTRATTO']/value&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='TIPO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPO']/value)&quot;>&#xa;                                &lt;tns:tipo>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='TIPO']/value&quot;/>&#xa;                                &lt;/tns:tipo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='TIPOSERVDESCR']/value)&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='TIPOSERVDESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOSERVDESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOSERVDESCR']/value)&quot;>&#xa;                                    &lt;tns:idTipoServizio>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='TIPOSERVDESCR']/value&quot;/>&#xa;                                    &lt;/tns:idTipoServizio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='ID_STATO_CONTRATTO']/value)&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='DESCRSTATOCONTR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCRSTATOCONTR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCRSTATOCONTR']/value)&quot;>&#xa;                                    &lt;tns:stato>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='DESCRSTATOCONTR']/value&quot;/>&#xa;                                    &lt;/tns:stato>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='ID_SOTTOFAMIG_OFFERTA']/value)&quot;>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR']/value)&quot;>&#xa;                                    &lt;tns:tipoProdotti>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='DESCR']/value&quot;/>&#xa;                                    &lt;/tns:tipoProdotti>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_NPD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_NPD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_NPD']/value)&quot;>&#xa;                                &lt;tns:flagNPD>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_NPD']/value&quot;/>&#xa;                                &lt;/tns:flagNPD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_ABILITATO']/value)&quot;>&#xa;                                &lt;tns:flagAbilitato>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_ABILITATO']/value&quot;/>&#xa;                                &lt;/tns:flagAbilitato>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_VALIDO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_VALIDO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_VALIDO']/value)&quot;>&#xa;                                &lt;tns:flagValido>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_VALIDO']/value&quot;/>&#xa;                                &lt;/tns:flagValido>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_STANDARD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_STANDARD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_STANDARD']/value)&quot;>&#xa;                                &lt;tns:flagStandard>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_STANDARD']/value&quot;/>&#xa;                                &lt;/tns:flagStandard>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_FILE_NOTIFY']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_FILE_NOTIFY']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_FILE_NOTIFY']/value)&quot;>&#xa;                                &lt;tns:flagFileNotify>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_FILE_NOTIFY']/value&quot;/>&#xa;                                &lt;/tns:flagFileNotify>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_DIFFIDATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_DIFFIDATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_DIFFIDATO']/value)&quot;>&#xa;                                &lt;tns:flagDiffidato>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_DIFFIDATO']/value&quot;/>&#xa;                                &lt;/tns:flagDiffidato>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_ABILITATO']/value)&quot;>&#xa;                                &lt;tns:flagAnfibio>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='FLAG_ABILITATO']/value&quot;/>&#xa;                                &lt;/tns:flagAnfibio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name= 'ID_COD_CONTRATTO_PADRE']/value)&quot;>&#xa;                                &lt;tns:idContrattoPadre>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name= 'ID_COD_CONTRATTO_PADRE']/value))&quot;/>&#xa;                                &lt;/tns:idContrattoPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='STATO_STANDARD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO_STANDARD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO_STANDARD']/value)&quot;>&#xa;                                &lt;tns:statoStandard>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='STATO_STANDARD']/value&quot;/>&#xa;                                &lt;/tns:statoStandard>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:dataUltimoAggiornamento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_AGGTO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataUltimoAggiornamento>&#xa;                            &lt;tns:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_INSMTO']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns:dataInserimento>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='ID_CONTRATTO_CRMWS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_CONTRATTO_CRMWS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_CONTRATTO_CRMWS']/value)&quot;>&#xa;                                &lt;tns:identificativoContrattoCRMW>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='ID_CONTRATTO_CRMWS']/value&quot;/>&#xa;                                &lt;/tns:identificativoContrattoCRMW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='NOME_STANDARD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_STANDARD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_STANDARD']/value)&quot;>&#xa;                                &lt;tns:nomeStandard>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='NOME_STANDARD']/value&quot;/>&#xa;                                &lt;/tns:nomeStandard>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DATAINZ_VALID']/value)&quot;>&#xa;                                &lt;tns:dataInizio>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATAINZ_VALID']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataInizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DATAFI_VALID']/value)&quot;>&#xa;                                &lt;tns:dataFine>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATAFI_VALID']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataFine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name= 'IDTPLG_CONTRATTO']/value)&quot;>&#xa;                                &lt;tns:identificativoTipologiaContratto>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(string(column[name= 'IDTPLG_CONTRATTO']/value))&quot;/>&#xa;                                &lt;/tns:identificativoTipologiaContratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR']/value)&quot;>&#xa;                                &lt;tns:tipoContratto>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='DESCR']/value&quot;/>&#xa;                                &lt;/tns:tipoContratto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;column[name='ID_SISTEMA']/value = '15'&quot;>&#xa;                                    &lt;tns:idSistemaCompetente>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                                    &lt;/tns:idSistemaCompetente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:idSistemaCompetente>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                                    &lt;/tns:idSistemaCompetente>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:oao>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME']/value)&quot;>&#xa;                                    &lt;tns:olo>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='NOME']/value&quot;/>&#xa;                                    &lt;/tns:olo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='RAGIONE_SOCIALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='RAGIONE_SOCIALE']/value)&quot;>&#xa;                                    &lt;tns:ragioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='RAGIONE_SOCIALE']/value&quot;/>&#xa;                                    &lt;/tns:ragioneSociale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='PARTITA_IVA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='PARTITA_IVA']/value)&quot;>&#xa;                                    &lt;tns:partitaIva>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='PARTITA_IVA']/value&quot;/>&#xa;                                    &lt;/tns:partitaIva>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&#xa;                                    &lt;tns:codiceOloAgcom>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                                    &lt;/tns:codiceOloAgcom>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_OLO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_OLO']/value)&quot;>&#xa;                                    &lt;tns:codiceOloNumerico>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='COD_OLO']/value&quot;/>&#xa;                                    &lt;/tns:codiceOloNumerico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;not((string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_OLO_ACCORPANTE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_OLO_ACCORPANTE']/value)&quot;>&#xa;                                    &lt;tns:flagAccorpante>&#xa;                                        &lt;xsl:value-of select=&quot;column[name='FLAG_OLO_ACCORPANTE']/value&quot;/>&#xa;                                    &lt;/tns:flagAccorpante>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:oao>&#xa;                            &lt;xsl:if test=&quot;column[name='DESCR']/value = 'FWA'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;not(empty(column[name='PROFILO1']/value))&quot;>&#xa;                                        &lt;tns:contrattoFwaInfratel>&#xa;                                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaInfratel>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:contrattoFwaInfratel>&#xa;                                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaInfratel>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;column[name='DESCR']/value = 'FWA'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;not(empty(column[name='PROFILO2']/value))&quot;>&#xa;                                        &lt;tns:contrattoFwaPlus>&#xa;                                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaPlus>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:contrattoFwaPlus>&#xa;                                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaPlus>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;column[name='DESCR']/value = 'FWA'&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;not(empty(column[name='PROFILO3']/value))&quot;>&#xa;                                        &lt;tns:contrattoFwaDecommissioning>&#xa;                                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaDecommissioning>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:contrattoFwaDecommissioning>&#xa;                                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                        &lt;/tns:contrattoFwaDecommissioning>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DATA_INIZIO_COINV_RETE']/value)&quot;>&#xa;                                &lt;tns:dataInizioCoinvestimento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_INIZIO_COINV_RETE']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataInizioCoinvestimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(column[name='DATA_FINE_COINV_RETE']/value)&quot;>&#xa;                                &lt;tns:dataFineCoinvestimento>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_FINE_COINV_RETE']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns:dataFineCoinvestimento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='BOUQUET']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='BOUQUET']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='BOUQUET']/value)&quot;>&#xa;                                &lt;tns:bouquet>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='BOUQUET']/value&quot;/>&#xa;                                &lt;/tns:bouquet>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:datiMulticast>&#xa;                                &lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currIdDG and ID_TIPOLOG_CONTR_ATTR_MULTI = 2]&quot;>&#xa;                                    &lt;tns:datiIpSessione>&#xa;                                        &lt;tns:ipSessione>&#xa;                                            &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                        &lt;/tns:ipSessione>&#xa;                                        &lt;tns:dataInizioValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataInizioValidita>&#xa;                                        &lt;tns:dataFineValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataFineValidita>&#xa;                                        &lt;tns:dataInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                        &lt;/tns:dataInserimento>&#xa;                                    &lt;/tns:datiIpSessione>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currIdDG and ID_TIPOLOG_CONTR_ATTR_MULTI = 3]&quot;>&#xa;                                    &lt;tns:datiIpMulticast>&#xa;                                        &lt;tns:ipMulticast>&#xa;                                            &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                        &lt;/tns:ipMulticast>&#xa;                                        &lt;tns:dataInizioValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataInizioValidita>&#xa;                                        &lt;tns:dataFineValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataFineValidita>&#xa;                                        &lt;tns:dataInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                        &lt;/tns:dataInserimento>&#xa;                                    &lt;/tns:datiIpMulticast>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currIdDG and ID_TIPOLOG_CONTR_ATTR_MULTI = 4]&quot;>&#xa;                                    &lt;tns:datiIpSorgente>&#xa;                                        &lt;tns:ipSorgente>&#xa;                                            &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                        &lt;/tns:ipSorgente>&#xa;                                        &lt;tns:dataInizioValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataInizioValidita>&#xa;                                        &lt;tns:dataFineValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataFineValidita>&#xa;                                        &lt;tns:dataInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                        &lt;/tns:dataInserimento>&#xa;                                    &lt;/tns:datiIpSorgente>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;$RecuperaDatiIpMulticastPost/Record[xsd:string(ID_CONTRATTO) = $currIdDG and ID_TIPOLOG_CONTR_ATTR_MULTI = 1]&quot;>&#xa;                                    &lt;tns:datiAsNumber>&#xa;                                        &lt;tns:asNumber>&#xa;                                            &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                        &lt;/tns:asNumber>&#xa;                                        &lt;tns:dataInizioValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataInizioValidita>&#xa;                                        &lt;tns:dataFineValidita>&#xa;                                            &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                        &lt;/tns:dataFineValidita>&#xa;                                        &lt;tns:dataInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                        &lt;/tns:dataInserimento>&#xa;                                    &lt;/tns:datiAsNumber>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/tns:datiMulticast>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(string(column[name='FLAG_MULTICAST']/value))>0 and column[name='FLAG_MULTICAST']/value = 'SI'&quot;>&#xa;                                    &lt;tns:flagMulticast>&#xa;                                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                    &lt;/tns:flagMulticast>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length(string(column[name='FLAG_MULTICAST']/value))>0 and column[name='FLAG_MULTICAST']/value = 'NO'&quot;>&#xa;                                    &lt;tns:flagMulticast>&#xa;                                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                    &lt;/tns:flagMulticast>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(string(column[name='FLAG_DISABILITAZIONE_SERV']/value))&quot;>&#xa;                                &lt;tns:datiSospensioneServizio>&#xa;                                    &lt;xsl:if test=&quot;exists(column[name='DATA_INI_DISABILITAZIONE_SERV']/value)&quot;>&#xa;                                        &lt;tns:dataInizioDisabil>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_INI_DISABILITAZIONE_SERV']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataInizioDisabil>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(column[name='DATA_FIN_DISABILITAZIONE_SERV']/value)&quot;>&#xa;                                        &lt;tns:dataFineDisabil>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(column[name='DATA_FIN_DISABILITAZIONE_SERV']/value),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataFineDisabil>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;column[name='FLAG_DISABILITAZIONE_SERV']/value = 'SI'&quot;>&#xa;                                            &lt;tns:flagDisabil>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:flagDisabil>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:flagDisabil>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:flagDisabil>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns:datiSospensioneServizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value)&quot;>&#xa;                                &lt;tns:emailOffertaFwa1GigaSardegna>&#xa;                                    &lt;xsl:value-of select=&quot;column[name='EMAIL_OFFERTAFWA1GIGASARDEGNA']/value&quot;/>&#xa;                                &lt;/tns:emailOffertaFwa1GigaSardegna>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:contratto>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;xsl:if test=&quot;count($NON_OLO/unknownResultset/row)>=$MaxRows&quot;>&#xa;                            &lt;tns:details>&#xa;                                &lt;xsl:value-of select=&quot;'LIMIT'&quot;/>&#xa;                            &lt;/tns:details>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputListaContratti>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputListaContratti>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi corrispondenti ai criteri di ricerca&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputListaContratti>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
