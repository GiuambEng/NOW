                                    <columnMetadata
                                    columnIndex="21"
                                    columnName="ID_COD_CONTRATTO_PADRE"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnIndex="22"
                                    columnName="FLAG_FILE_NOTIFY"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
