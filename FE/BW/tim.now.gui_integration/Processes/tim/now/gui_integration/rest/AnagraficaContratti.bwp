                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT VALORE_ATTRIBUTO,ID_CONTRATTO,ID_TIPOLOG_CONTR_ATTR_MULTI,&#xa;TMS_INSERIMENTO,DT_INIZIO_VALIDITA,DT_FINE_VALIDITA&#xa;FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM &#xa;WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI IN (1,2,3,4)" xsi:type="jdbcPalette:JDBCQueryActivity">
