                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contratto&quot; xmlns:tns4=&quot;http://xmlns.example.com/AnagraficaContratti/parameters&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;tipoProfilo&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaContrattiOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaContrattiDG&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaContrattiNonOloNonDG&quot;/>&#xa;    &lt;xsl:param name=&quot;IpSessione&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaVariable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($ListaContrattiOlo/Record[1]/COD_CONTRATTO) > 0 or string-length($ListaContrattiDG/Record[1]/COD_CONTRATTO) > 0 or&amp;#xD;&amp;#xA;string-length($ListaContrattiNonOloNonDG/Record[1]/COD_CONTRATTO) > 0&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($tipoProfilo, $get.parameters/tns4:tipoProfilo) = true()&quot;>&#xa;                        &lt;tns:outputListaContratti>&#xa;                            &lt;xsl:for-each select=&quot;$ListaContrattiOlo/Record&quot;>&#xa;                                &lt;tns:contratto>&#xa;                                    &lt;xsl:variable name=&quot;currId&quot; select=&quot;string(ID_CONTRATTO)&quot;/>&#xa;                                    &lt;xsl:if test=&quot;exists(ID_CONTRATTO)&quot;>&#xa;                                        &lt;tns:idContratto>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(ID_CONTRATTO)&quot;/>&#xa;                                        &lt;/tns:idContratto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns:codiceContratto>&#xa;                                        &lt;xsl:value-of select=&quot;COD_CONTRATTO&quot;/>&#xa;                                    &lt;/tns:codiceContratto>&#xa;                                    &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                        &lt;tns:codificaOAO>&#xa;                                            &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                        &lt;/tns:codificaOAO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;NOME_CONTRATTO&quot;>&#xa;                                        &lt;tns:nome>&#xa;                                            &lt;xsl:value-of select=&quot;NOME_CONTRATTO&quot;/>&#xa;                                        &lt;/tns:nome>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TIPO&quot;>&#xa;                                        &lt;tns:tipo>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO&quot;/>&#xa;                                        &lt;/tns:tipo>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TIPOSERVDESCR&quot;>&#xa;                                        &lt;tns:idTipoServizio>&#xa;                                            &lt;xsl:value-of select=&quot;TIPOSERVDESCR&quot;/>&#xa;                                        &lt;/tns:idTipoServizio>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DESCRSTATOCONTR&quot;>&#xa;                                        &lt;tns:stato>&#xa;                                            &lt;xsl:value-of select=&quot;DESCRSTATOCONTR&quot;/>&#xa;                                        &lt;/tns:stato>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DESCR&quot;>&#xa;                                        &lt;tns:tipoProdotti>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                                        &lt;/tns:tipoProdotti>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns:flagNPD>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_NPD&quot;/>&#xa;                                    &lt;/tns:flagNPD>&#xa;                                    &lt;xsl:if test=&quot;FLAG_ABILITATO&quot;>&#xa;                                        &lt;tns:flagAbilitato>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_ABILITATO&quot;/>&#xa;                                        &lt;/tns:flagAbilitato>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns:flagValido>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_VALIDO&quot;/>&#xa;                                    &lt;/tns:flagValido>&#xa;                                    &lt;xsl:if test=&quot;FLAG_STANDARD&quot;>&#xa;                                        &lt;tns:flagStandard>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_STANDARD&quot;/>&#xa;                                        &lt;/tns:flagStandard>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns:flagFileNotify>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_FILE_NOTIFY&quot;/>&#xa;                                    &lt;/tns:flagFileNotify>&#xa;                                    &lt;tns:flagDiffidato>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_DIFFIDATO&quot;/>&#xa;                                    &lt;/tns:flagDiffidato>&#xa;                                    &lt;tns:flagAnfibio>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_ANFIBIO&quot;/>&#xa;                                    &lt;/tns:flagAnfibio>&#xa;                                    &lt;xsl:if test=&quot;exists(ID_COD_CONTRATTO_PADRE)&quot;>&#xa;                                        &lt;tns:idContrattoPadre>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(ID_COD_CONTRATTO_PADRE)&quot;/>&#xa;                                        &lt;/tns:idContrattoPadre>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;STATO_STANDARD&quot;>&#xa;                                        &lt;tns:statoStandard>&#xa;                                            &lt;xsl:value-of select=&quot;STATO_STANDARD&quot;/>&#xa;                                        &lt;/tns:statoStandard>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(TIMSTP_AGGTO)&quot;>&#xa;                                        &lt;tns:dataUltimoAggiornamento>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_AGGTO), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataUltimoAggiornamento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(TIMSTP_INSMTO)&quot;>&#xa;                                        &lt;tns:dataInserimento>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(TIMSTP_INSMTO), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataInserimento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;ID_CONTRATTO_CRMWS&quot;>&#xa;                                        &lt;tns:identificativoContrattoCRMW>&#xa;                                            &lt;xsl:value-of select=&quot;ID_CONTRATTO_CRMWS&quot;/>&#xa;                                        &lt;/tns:identificativoContrattoCRMW>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;NOME_STANDARD&quot;>&#xa;                                        &lt;tns:nomeStandard>&#xa;                                            &lt;xsl:value-of select=&quot;NOME_STANDARD&quot;/>&#xa;                                        &lt;/tns:nomeStandard>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(DATAINZ_VALID)&quot;>&#xa;                                        &lt;tns:dataInizio>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(DATAINZ_VALID), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataInizio>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(DATAFI_VALID)&quot;>&#xa;                                        &lt;tns:dataFine>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(DATAFI_VALID), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataFine>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(IDTPLG_CONTRATTO)&quot;>&#xa;                                        &lt;tns:identificativoTipologiaContratto>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(IDTPLG_CONTRATTO)&quot;/>&#xa;                                        &lt;/tns:identificativoTipologiaContratto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DESCRTIPCONTR&quot;>&#xa;                                        &lt;tns:tipoContratto>&#xa;                                            &lt;xsl:value-of select=&quot;DESCRTIPCONTR&quot;/>&#xa;                                        &lt;/tns:tipoContratto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;xsd:int(ID_SISTEMA) = 15&quot;>&#xa;                                            &lt;tns:idSistemaCompetente>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                                            &lt;/tns:idSistemaCompetente>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:idSistemaCompetente>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                                            &lt;/tns:idSistemaCompetente>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;tns:oao>&#xa;                                        &lt;xsl:if test=&quot;NOME&quot;>&#xa;                                            &lt;tns:olo>&#xa;                                                &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                                            &lt;/tns:olo>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&#xa;                                            &lt;tns:ragioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                                            &lt;/tns:ragioneSociale>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;PARTITA_IVA&quot;>&#xa;                                            &lt;tns:partitaIva>&#xa;                                                &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&#xa;                                            &lt;/tns:partitaIva>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                            &lt;tns:codiceOloAgcom>&#xa;                                                &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                            &lt;/tns:codiceOloAgcom>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;COD_OLO&quot;>&#xa;                                            &lt;tns:codiceOloNumerico>&#xa;                                                &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                                            &lt;/tns:codiceOloNumerico>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&#xa;                                            &lt;tns:flagAccorpante>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&#xa;                                            &lt;/tns:flagAccorpante>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns:oao>&#xa;                                    &lt;xsl:if test=&quot;DESCR='FWA'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;not(empty(PROFILO1))&quot;>&#xa;                                                &lt;tns:contrattoFwaInfratel>&#xa;                                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaInfratel>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns:contrattoFwaInfratel>&#xa;                                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaInfratel>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DESCR='FWA'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;not(empty(PROFILO2))&quot;>&#xa;                                                &lt;tns:contrattoFwaPlus>&#xa;                                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaPlus>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns:contrattoFwaPlus>&#xa;                                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaPlus>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DESCR='FWA'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;not(empty(PROFILO3))&quot;>&#xa;                                                &lt;tns:contrattoFwaDecommissioning>&#xa;                                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaDecommissioning>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns:contrattoFwaDecommissioning>&#xa;                                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaDecommissioning>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(DATA_INIZIO_COINV_RETE)&quot;>&#xa;                                        &lt;tns:dataInizioCoinvestimento>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(DATA_INIZIO_COINV_RETE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataInizioCoinvestimento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(DATA_FINE_COINV_RETE)&quot;>&#xa;                                        &lt;tns:dataFineCoinvestimento>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(DATA_FINE_COINV_RETE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataFineCoinvestimento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;BOUQUET&quot;>&#xa;                                        &lt;tns:bouquet>&#xa;                                            &lt;xsl:value-of select=&quot;BOUQUET&quot;/>&#xa;                                        &lt;/tns:bouquet>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns:datiMulticast>&#xa;                                        &lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 2]&quot;>&#xa;                                            &lt;tns:datiIpSessione>&#xa;                                                &lt;tns:ipSessione>&#xa;                                                    &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                                &lt;/tns:ipSessione>&#xa;                                                &lt;tns:dataInizioValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataInizioValidita>&#xa;                                                &lt;tns:dataFineValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataFineValidita>&#xa;                                                &lt;tns:dataInserimento>&#xa;                                                    &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                                &lt;/tns:dataInserimento>&#xa;                                            &lt;/tns:datiIpSessione>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 3]&quot;>&#xa;                                            &lt;tns:datiIpMulticast>&#xa;                                                &lt;tns:ipMulticast>&#xa;                                                    &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                                &lt;/tns:ipMulticast>&#xa;                                                &lt;tns:dataInizioValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataInizioValidita>&#xa;                                                &lt;tns:dataFineValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataFineValidita>&#xa;                                                &lt;tns:dataInserimento>&#xa;                                                    &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                                &lt;/tns:dataInserimento>&#xa;                                            &lt;/tns:datiIpMulticast>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 4]&quot;>&#xa;                                            &lt;tns:datiIpSorgente>&#xa;                                                &lt;tns:ipSorgente>&#xa;                                                    &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                                &lt;/tns:ipSorgente>&#xa;                                                &lt;tns:dataInizioValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataInizioValidita>&#xa;                                                &lt;tns:dataFineValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataFineValidita>&#xa;                                                &lt;tns:dataInserimento>&#xa;                                                    &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                                &lt;/tns:dataInserimento>&#xa;                                            &lt;/tns:datiIpSorgente>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currId and ID_TIPOLOG_CONTR_ATTR_MULTI = 1]&quot;>&#xa;                                            &lt;tns:datiAsNumber>&#xa;                                                &lt;tns:asNumber>&#xa;                                                    &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                                &lt;/tns:asNumber>&#xa;                                                &lt;tns:dataInizioValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataInizioValidita>&#xa;                                                &lt;tns:dataFineValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataFineValidita>&#xa;                                                &lt;tns:dataInserimento>&#xa;                                                    &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                                &lt;/tns:dataInserimento>&#xa;                                            &lt;/tns:datiAsNumber>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/tns:datiMulticast>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'SI'&quot;>&#xa;                                            &lt;tns:flagMulticast>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:flagMulticast>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'NO'&quot;>&#xa;                                            &lt;tns:flagMulticast>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:flagMulticast>&#xa;                                        &lt;/xsl:when>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;string-length(FLAG_DISABILITAZIONE_SERV)>0&quot;>&#xa;                                        &lt;tns:datiSospensioneServizio>&#xa;                                            &lt;xsl:if test=&quot;exists(DATA_INI_DISABILITAZIONE_SERV)&quot;>&#xa;                                                &lt;tns:dataInizioDisabil>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before(string(DATA_INI_DISABILITAZIONE_SERV), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                                &lt;/tns:dataInizioDisabil>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;exists(DATA_FIN_DISABILITAZIONE_SERV)&quot;>&#xa;                                                &lt;tns:dataFineDisabil>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before(string(DATA_FIN_DISABILITAZIONE_SERV), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                                &lt;/tns:dataFineDisabil>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;FLAG_DISABILITAZIONE_SERV = 'SI'&quot;>&#xa;                                                    &lt;tns:flagDisabil>&#xa;                                                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                    &lt;/tns:flagDisabil>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns:flagDisabil>&#xa;                                                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                                    &lt;/tns:flagDisabil>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/tns:datiSospensioneServizio>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;EMAIL_OFFERTAFWA1GIGASARDEGNA&quot;>&#xa;                                        &lt;tns:emailOffertaFwa1GigaSardegna>&#xa;                                            &lt;xsl:value-of select=&quot;EMAIL_OFFERTAFWA1GIGASARDEGNA&quot;/>&#xa;                                        &lt;/tns:emailOffertaFwa1GigaSardegna>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns:contratto>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns:result>&#xa;                                &lt;