ntr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 1 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO1,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 2 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO2,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 3 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO3,C.DATA_FINE_COINV_RETE,C.DATA_INIZIO_COINV_RETE,(SELECT DISTINCT VALORE_ATTRIBUTO FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 AND CAM.ID_CONTRATTO=C.ID_CONTRATTO AND CAM.DT_FINE_VALIDITA>SYSDATE) AS BOUQUET,C.FLAG_MULTICAST,C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV from CONTRATTO C LEFT JOIN TIPOLG_CONTRATTO ON C.IDTPLG_CONTRATTO = TIPOLG_CONTRATTO.IDTPLG_CONTRATTO LEFT JOIN SOTTO_FAMIG_OFFERTA ON C.ID_SOTTOFAMIG_OFFERTA = SOTTO_FAMIG_OFFERTA.ID_SOTTOFAMIG_OFFERTA LEFT JOIN TIPOLG_STATO_CONTRATTO ON C.ID_STATO_CONTRATTO = TIPOLG_STATO_CONTRATTO.ID_STATO_CONTRATTO LEFT JOIN FAMIG_OFFERTA ON C.ID_FAMIG_OFFERTA = FAMIG_OFFERTA.ID_FAMIG_OFFERTA LEFT JOIN OLO O ON C.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM &amp;quot;&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;SELECT C.COD_CONTRATTO, C.ID_CONTRATTO, C.NOME_CONTRATTO, C.TIPO, C.ID_STATO_CONTRATTO, C.ID_FAMIG_OFFERTA, C.ID_SOTTOFAMIG_OFFERTA, C.FLAG_ANFIBIO, C.FLAG_ABILITATO, C.FLAG_DIFFIDATO, C.FLAG_STANDARD, C.FLAG_VALIDO, C.FLAG_NPD, C.DATAINZ_VALID, C.DATAFI_VALID, C.IDTPLG_CONTRATTO, C.ID_CONTRATTO_CRMWS, C.NOME_STANDARD, C.OPERATORE, C.STATO_STANDARD, C.ID_COD_CONTRATTO_PADRE, C.FLAG_FILE_NOTIFY, C.TIMSTP_AGGTO, C.TIMSTP_INSMTO, C.EMAIL_OFFERTAFWA1GIGASARDEGNA, TIPOLG_CONTRATTO.DESCR AS DESCRTIPCONTR, TIPOLG_STATO_CONTRATTO.DESCRIPTION AS DESCRSTATOCONTR, SOTTO_FAMIG_OFFERTA.DESCR AS DESCR, FAMIG_OFFERTA.DESCR AS TIPOSERVDESCR, O.NOME, O.RAGIONE_SOCIALE, O.PARTITA_IVA, O.CODFC_OLO_AGCOM, O.COD_OLO, O.FLAG_OLO_ACCORPANTE, C.ID_SISTEMA, (SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 1 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO1,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 2 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO2,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 3 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO3,C.DATA_FINE_COINV_RETE,C.DATA_INIZIO_COINV_RETE,(SELECT DISTINCT VALORE_ATTRIBUTO FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 AND CAM.ID_CONTRATTO=C.ID_CONTRATTO AND CAM.DT_FINE_VALIDITA>SYSDATE) AS BOUQUET,C.FLAG_MULTICAST,C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV from CONTRATTO C LEFT JOIN TIPOLG_CONTRATTO ON C.IDTPLG_CONTRATTO = TIPOLG_CONTRATTO.IDTPLG_CONTRATTO LEFT JOIN SOTTO_FAMIG_OFFERTA ON C.ID_SOTTOFAMIG_OFFERTA = SOTTO_FAMIG_OFFERTA.ID_SOTTOFAMIG_OFFERTA LEFT JOIN TIPOLG_STATO_CONTRATTO ON C.ID_STATO_CONTRATTO = TIPOLG_STATO_CONTRATTO.ID_STATO_CONTRATTO LEFT JOIN FAMIG_OFFERTA ON C.ID_FAMIG_OFFERTA = FAMIG_OFFERTA.ID_FAMIG_OFFERTA LEFT JOIN OLO O ON C.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM WHERE C.ID_SOTTOFAMIG_OFFERTA NOT IN (SELECT ID_SOTTOFAMIG_OFFERTA FROM SOTTO_FAMIG_OFFERTA WHERE DESCR = 'IAV')&amp;quot;&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($post.parameters/tns4:tipoProfilo,'DG')=true()&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT * FROM (SELECT C.COD_CONTRATTO,C.ID_CONTRATTO,C.NOME_CONTRATTO,C.TIPO,C.ID_STATO_CONTRATTO,C.ID_FAMIG_OFFERTA,C.ID_SOTTOFAMIG_OFFERTA,C.FLAG_ANFIBIO,C.FLAG_ABILITATO,C.FLAG_DIFFIDATO,C.FLAG_STANDARD,C.FLAG_VALIDO,FLAG_NPD,C.DATAINZ_VALID,C.DATAFI_VALID,C.IDTPLG_CONTRATTO,C.ID_CONTRATTO_CRMWS,C.NOME_STANDARD,C.OPERATORE,C.STATO_STANDARD,C.ID_COD_CONTRATTO_PADRE,C.FLAG_FILE_NOTIFY,C.TIMSTP_AGGTO,C.TIMSTP_INSMTO, C.EMAIL_OFFERTAFWA1GIGASARDEGNA, TIPOLG_CONTRATTO.DESCR AS DESCRTIPCONTR,TIPOLG_STATO_CONTRATTO.DESCRIPTION AS DESCRSTATOCONTR,SOTTO_FAMIG_OFFERTA.DESCR AS DESCR,FAMIG_OFFERTA.DESCR AS  TIPOSERVDESCR ,O.NOME, O.RAGIONE_SOCIALE,O.PARTITA_IVA,O.CODFC_OLO_AGCOM,O.COD_OLO, O.FLAG_OLO_ACCORPANTE, C.ID_SISTEMA, (SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 1 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO1,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 2 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO2,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 3 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO3,C.DATA_FINE_COINV_RETE,C.DATA_INIZIO_COINV_RETE,(SELECT DISTINCT VALORE_ATTRIBUTO FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 AND CAM.ID_CONTRATTO=C.ID_CONTRATTO AND CAM.DT_FINE_VALIDITA>SYSDATE) AS BOUQUET,C.FLAG_MULTICAST,C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV from CONTRATTO C LEFT JOIN TIPOLG_CONTRATTO  ON C.IDTPLG_CONTRATTO = TIPOLG_CONTRATTO.IDTPLG_CONTRATTO LEFT JOIN SOTTO_FAMIG_OFFERTA ON C.ID_SOTTOFAMIG_OFFERTA = SOTTO_FAMIG_OFFERTA.ID_SOTTOFAMIG_OFFERTA LEFT JOIN TIPOLG_STATO_CONTRATTO ON C.ID_STATO_CONTRATTO = TIPOLG_STATO_CONTRATTO.ID_STATO_CONTRATTO LEFT JOIN FAMIG_OFFERTA ON C.ID_FAMIG_OFFERTA = FAMIG_OFFERTA.ID_FAMIG_OFFERTA LEFT JOIN OLO O ON C.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM) WHERE &amp;quot;, $RicercaAvanzata/tns2:outputcondition[1])&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT * FROM (SELECT C.COD_CONTRATTO,C.ID_CONTRATTO,C.NOME_CONTRATTO,C.TIPO,C.ID_STATO_CONTRATTO,C.ID_FAMIG_OFFERTA,C.ID_SOTTOFAMIG_OFFERTA,C.FLAG_ANFIBIO,C.FLAG_ABILITATO,C.FLAG_DIFFIDATO,C.FLAG_STANDARD,C.FLAG_VALIDO,FLAG_NPD,C.DATAINZ_VALID,C.DATAFI_VALID,C.IDTPLG_CONTRATTO,C.ID_CONTRATTO_CRMWS,C.NOME_STANDARD,C.OPERATORE,C.STATO_STANDARD,C.ID_COD_CONTRATTO_PADRE,C.FLAG_FILE_NOTIFY,C.TIMSTP_AGGTO,C.TIMSTP_INSMTO, C.EMAIL_OFFERTAFWA1GIGASARDEGNA, TIPOLG_CONTRATTO.DESCR AS DESCRTIPCONTR,TIPOLG_STATO_CONTRATTO.DESCRIPTION AS DESCRSTATOCONTR,SOTTO_FAMIG_OFFERTA.DESCR AS DESCR,FAMIG_OFFERTA.DESCR AS  TIPOSERVDESCR ,O.NOME, O.RAGIONE_SOCIALE,O.PARTITA_IVA,O.CODFC_OLO_AGCOM,O.COD_OLO, O.FLAG_OLO_ACCORPANTE, C.ID_SISTEMA, (SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 1 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO1,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 2 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO2,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 3 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO3,C.DATA_FINE_COINV_RETE,C.DATA_INIZIO_COINV_RETE,(SELECT DISTINCT VALORE_ATTRIBUTO FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 AND CAM.ID_CONTRATTO=C.ID_CONTRATTO AND CAM.DT_FINE_VALIDITA>SYSDATE) AS BOUQUET,C.FLAG_MULTICAST,C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV from CONTRATTO C LEFT JOIN TIPOLG_CONTRATTO  ON C.IDTPLG_CONTRATTO = TIPOLG_CONTRATTO.IDTPLG_CONTRATTO LEFT JOIN SOTTO_FAMIG_OFFERTA ON C.ID_SOTTOFAMIG_OFFERTA = SOTTO_FAMIG_OFFERTA.ID_SOTTOFAMIG_OFFERTA LEFT JOIN TIPOLG_STATO_CONTRATTO ON C.ID_STATO_CONTRATTO = TIPOLG_STATO_CONTRATTO.ID_STATO_CONTRATTO LEFT JOIN FAMIG_OFFERTA ON C.ID_FAMIG_OFFERTA = FAMIG_OFFERTA.ID_FAMIG_OFFERTA LEFT JOIN OLO O ON C.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM WHERE C.ID_SOTTOFAMIG_OFFERTA NOT IN (SELECT ID_SOTTOFAMIG_OFFERTA FROM SOTTO_FAMIG_OFFERTA WHERE DESCR = 'IAV')) WHERE &amp;quot;, $RicercaAvanzata/tns2:outputcondition[1])&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns5:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/contratto&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://xmlns.example.com/AnagraficaContratti/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;tipoProfilo&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;OLO&quot;/>&lt;xsl:param name=&quot;NON_OLO&quot;/>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;RecuperaDatiIpMulticastPost&quot;/>&lt;xsl:template name=&quot;ListaVariable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($tipoProfilo, $post/parameters/tns4:anagraficacontrattiPostParameters/tns4:tipoProfilo) = true() and string-length(string($OLO/unknownResultset/row[1]/column[name='COD_CONTRATTO']/value))>0&quot;>&lt;tns:outputListaContratti>&lt;xsl:for-each select=&quot;$OLO/unknownResultset/row&quot;>&lt;tns:contratto>&lt;xsl:variable name=&quot;currId&quot; select=&quot;string(column[name='ID_CONTRATTO']/value)&quot;/>&lt;xsl:if test=&quot;not((string(column[name='ID_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_CONTRATTO']/value)&quot;>&lt;tns:idContratto>&lt;xsl:value-of select=&quot;column[name='ID_CONTRATTO']/value&quot;/>&lt;/tns:idContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_CONTRATTO']/value)&quot;>&lt;tns:codiceContratto>&lt;xsl:value-of select=&quot;column[name='COD_CONTRATTO']/value&quot;/>&lt;/tns:codiceContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)&quot;>&lt;tns:codificaOAO>&lt;xsl:value-of select=&quot;column[name='CODFC_OLO_AGCOM']/value&quot;/>&lt;/tns:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_CONTRATTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_CONTRATTO']/value)&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;column[name='NOME_CONTRATTO']/value&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='TIPO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPO']/value)&quot;>&lt;tns:tipo>&lt;xsl:value-of select=&quot;column[name='TIPO']/value&quot;/>&lt;/tns:tipo>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='TIPOSERVDESCR']/value)&quot;>&lt;xsl:if test=&quot;not((string(column[name='TIPOSERVDESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIPOSERVDESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIPOSERVDESCR']/value)&quot;>&lt;tns:idTipoServizio>&lt;xsl:value-of select=&quot;column[name='TIPOSERVDESCR']/value&quot;/>&lt;/tns:idTipoServizio>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='ID_STATO_CONTRATTO']/value)&quot;>&lt;xsl:if test=&quot;not((string(column[name='DESCRSTATOCONTR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCRSTATOCONTR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCRSTATOCONTR']/value)&quot;>&lt;tns:stato>&lt;xsl:value-of select=&quot;column[name='DESCRSTATOCONTR']/value&quot;/>&lt;/tns:stato>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name='ID_SOTTOFAMIG_OFFERTA']/value)&quot;>&lt;xsl:if test=&quot;not((string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR']/value)&quot;>&lt;tns:tipoProdotti>&lt;xsl:value-of select=&quot;column[name='DESCR']/value&quot;/>&lt;/tns:tipoProdotti>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_NPD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_NPD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_NPD']/value)&quot;>&lt;tns:flagNPD>&lt;xsl:value-of select=&quot;column[name='FLAG_NPD']/value&quot;/>&lt;/tns:flagNPD>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_ABILITATO']/value)&quot;>&lt;tns:flagAbilitato>&lt;xsl:value-of select=&quot;column[name='FLAG_ABILITATO']/value&quot;/>&lt;/tns:flagAbilitato>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_VALIDO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_VALIDO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_VALIDO']/value)&quot;>&lt;tns:flagValido>&lt;xsl:value-of select=&quot;column[name='FLAG_VALIDO']/value&quot;/>&lt;/tns:flagValido>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_STANDARD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_STANDARD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_STANDARD']/value)&quot;>&lt;tns:flagStandard>&lt;xsl:value-of select=&quot;column[name='FLAG_STANDARD']/value&quot;/>&lt;/tns:flagStandard>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_FILE_NOTIFY']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_FILE_NOTIFY']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_FILE_NOTIFY']/value)&quot;>&lt;tns:flagFileNotify>&lt;xsl:value-of select=&quot;column[name='FLAG_FILE_NOTIFY']/value&quot;/>&lt;/tns:flagFileNotify>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_DIFFIDATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_DIFFIDATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_DIFFIDATO']/value)&quot;>&lt;tns:flagDiffidato>&lt;xsl:value-of select=&quot;column[name='FLAG_DIFFIDATO']/value&quot;/>&lt;/tns:flagDiffidato>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='FLAG_ABILITATO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='FLAG_ABILITATO']/value)&quot;>&lt;tns:flagAnfibio>&lt;xsl:value-of select=&quot;column[name='FLAG_ABILITATO']/value&quot;/>&lt;/tns:flagAnfibio>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(column[name= 'ID_COD_CONTRATTO_PADRE']/value)&quot;>&lt;tns:idContrattoPadre>&lt;xsl:value-of select=&quot;xsd:int(string(column[name= 'ID_COD_CONTRATTO_PADRE']/value))&quot;/>&lt;/tns:idContrattoPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(column[name='STATO_STANDARD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='STATO_STANDARD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='STATO_STANDARD']/value)&quot;>&lt;tns:statoStandard>&lt;xsl:value-of select=&quot;column[name='STATO_STANDARD']/value&quot;/>&lt;/tns:statoStandard>&lt;/xsl:if>&lt;tns:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_AGGTO']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataUltimoAggiornamento>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;substring-before(string(column[name='TIMSTP_INSMTO']/value),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInserimento>&lt;xsl:if test=&quot;not((string(column[name='ID_CONTRATTO_CRMWS']/value/@xsi:ni