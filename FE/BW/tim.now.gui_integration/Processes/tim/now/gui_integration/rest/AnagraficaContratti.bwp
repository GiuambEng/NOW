&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiIpMulticast>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currIdNoOLODG and ID_TIPOLOG_CONTR_ATTR_MULTI = 4]&quot;>&lt;tns:datiIpSorgente>&lt;tns:ipSorgente>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:ipSorgente>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiIpSorgente>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currIdNoOLODG and ID_TIPOLOG_CONTR_ATTR_MULTI = 1]&quot;>&lt;tns:datiAsNumber>&lt;tns:asNumber>&lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&lt;/tns:asNumber>&lt;tns:dataInizioValidita>&lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&lt;/tns:dataInizioValidita>&lt;tns:dataFineValidita>&lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&lt;/tns:dataFineValidita>&lt;tns:dataInserimento>&lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&lt;/tns:dataInserimento>&lt;/tns:datiAsNumber>&lt;/xsl:for-each>&lt;/tns:datiMulticast>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'SI'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'NO'&quot;>&lt;tns:flagMulticast>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagMulticast>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(FLAG_DISABILITAZIONE_SERV)>0&quot;>&lt;tns:datiSospensioneServizio>&lt;xsl:if test=&quot;exists(DATA_INI_DISABILITAZIONE_SERV)&quot;>&lt;tns:dataInizioDisabil>&lt;xsl:value-of select=&quot;substring-before(string(DATA_INI_DISABILITAZIONE_SERV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataInizioDisabil>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATA_FIN_DISABILITAZIONE_SERV)&quot;>&lt;tns:dataFineDisabil>&lt;xsl:value-of select=&quot;substring-before(string(DATA_FIN_DISABILITAZIONE_SERV), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns:dataFineDisabil>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;FLAG_DISABILITAZIONE_SERV='SI'&quot;>&lt;tns:flagDisabil>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns:flagDisabil>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:flagDisabil>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:flagDisabil>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:datiSospensioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;EMAIL_OFFERTAFWA1GIGASARDEGNA&quot;>&lt;tns:emailOffertaFwa1GigaSardegna>&lt;xsl:value-of select=&quot;EMAIL_OFFERTAFWA1GIGASARDEGNA&quot;/>&lt;/tns:emailOffertaFwa1GigaSardegna>&lt;/xsl:if>&lt;/tns:contratto>&lt;/xsl:for-each>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;if (count($ListaContrattiNonOloNonDG/Record) &amp;lt; $MaxRows) then &amp;quot;OK&amp;quot; else &amp;quot;LIMIT&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputListaContratti>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputListaContratti>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:details>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi corrispondenti ai criteri di ricerca&amp;quot;&quot;/>&lt;/tns:details>&lt;/tns:result>&lt;/tns:outputListaContratti>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
