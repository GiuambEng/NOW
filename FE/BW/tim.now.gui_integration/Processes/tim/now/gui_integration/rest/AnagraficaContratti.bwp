                                    columnName="TIMSTP_AGGTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnIndex="24"
                                    columnName="EMAIL_OFFERTAFWA1GIGASARDEGNA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="25"
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnIndex="26"
                                    columnName="DESCRTIPCONTR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="27"
                                    columnName="DESCRSTATOCONTR"
                                    dataType="12"
