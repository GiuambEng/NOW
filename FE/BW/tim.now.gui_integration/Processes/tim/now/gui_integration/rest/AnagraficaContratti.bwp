                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_TIPOLOG_CONTR_ATTR_MULTI"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TMS_INSERIMENTO"
