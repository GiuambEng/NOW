                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+83346aca-8e57-48c6-9fd5-a9221e24c893+input&quot; xmlns:tns4=&quot;http://xmlns.example.com/AnagraficaContratti/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaContrattiOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns4:anagraficacontrattiGetParameters/tns4:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns4:anagraficacontrattiGetParameters/tns4:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ListaContrattiOlo-input"
                                    name="ListaContrattiOlo"
                                    outputVariable="ListaContrattiOlo"
                                    tibex:xpdlId="83346aca-8e57-48c6-9fd5-a9221e24c893" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="get_AnagContratti_IngetLog_INFOToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ListaContrattiOloToRecuperaDatiIpMulticast"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+83346aca-8e57-48c6-9fd5-a9221e24c893+input&quot; xmlns:tns4=&quot;http://xmlns.example.com/AnagraficaContratti/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaContrattiOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns4:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns4:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom2>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT C.COD_CONTRATTO,C.ID_CONTRATTO,C.NOME_CONTRATTO,C.TIPO,C.ID_STATO_CONTRATTO,C.ID_FAMIG_OFFERTA,C.ID_SOTTOFAMIG_OFFERTA,C.FLAG_ANFIBIO,&#xa;C.FLAG_ABILITATO,C.FLAG_DIFFIDATO,C.FLAG_STANDARD,C.FLAG_VALIDO,FLAG_NPD,C.DATAINZ_VALID,C.DATAFI_VALID,C.IDTPLG_CONTRATTO,C.ID_CONTRATTO_CRMWS,&#xa;C.NOME_STANDARD,C.OPERATORE,C.STATO_STANDARD,C.ID_COD_CONTRATTO_PADRE,C.FLAG_FILE_NOTIFY,C.TIMSTP_AGGTO,C.EMAIL_OFFERTAFWA1GIGASARDEGNA,C.TIMSTP_INSMTO,&#xa;TIPOLG_CONTRATTO.DESCR AS DESCRTIPCONTR,TIPOLG_STATO_CONTRATTO.DESCRIPTION AS DESCRSTATOCONTR,SOTTO_FAMIG_OFFERTA.DESCR AS DESCR,&#xa;FAMIG_OFFERTA.DESCR AS  TIPOSERVDESCR , O.NOME, O.RAGIONE_SOCIALE, O.PARTITA_IVA, O.CODFC_OLO_AGCOM,O.COD_OLO, O.FLAG_OLO_ACCORPANTE, C.ID_SISTEMA,&#xa;(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 1 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND&#xa;TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO1,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 2 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND&#xa;TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO2,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 3 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND&#xa;TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO3,C.DATA_FINE_COINV_RETE,C.DATA_INIZIO_COINV_RETE,&#xa;(SELECT DISTINCT VALORE_ATTRIBUTO FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 AND CAM.ID_CONTRATTO=C.ID_CONTRATTO AND CAM.DT_FINE_VALIDITA>SYSDATE) AS BOUQUET,&#xa;C.FLAG_MULTICAST,C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV&#xa;from CONTRATTO C &#xa;LEFT JOIN TIPOLG_CONTRATTO  ON C.IDTPLG_CONTRATTO = TIPOLG_CONTRATTO.IDTPLG_CONTRATTO &#xa;LEFT JOIN SOTTO_FAMIG_OFFERTA ON C.ID_SOTTOFAMIG_OFFERTA = SOTTO_FAMIG_OFFERTA.ID_SOTTOFAMIG_OFFERTA&#xa;LEFT JOIN TIPOLG_STATO_CONTRATTO ON C.ID_STATO_CONTRATTO = TIPOLG_STATO_CONTRATTO.ID_STATO_CONTRATTO &#xa;LEFT JOIN FAMIG_OFFERTA ON C.ID_FAMIG_OFFERTA = FAMIG_OFFERTA.ID_FAMIG_OFFERTA&#xa;LEFT JOIN OLO O ON C.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM&#xa;WHERE C.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM OLO&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE (COD_OLO = (SELECT COD_OLO&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM OLO&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE CODFC_OLO_AGCOM = ?)) &#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM OLO&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE COD_OLO = (SELECT COD_OLO&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM OLO&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE CODFC_OLO_AGCOM = ?)))&#xa;AND C.ID_SOTTOFAMIG_OFFERTA NOT IN (SELECT ID_SOTTOFAMIG_OFFERTA &#xa;                              FROM SOTTO_FAMIG_OFFERTA &#xa;                              WHERE DESCR ='IAV')&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  " xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom2"/>
