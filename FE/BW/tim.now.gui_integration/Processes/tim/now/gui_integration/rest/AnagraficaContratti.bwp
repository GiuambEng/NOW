                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://xmlns.example.com/20160510140109PLT" xmlns:tns="http://www.tim.com/NOW/rest/contratto" version="2.0"&gt;
    &lt;xsl:param name="ListaVariable"/&gt;
    &lt;xsl:template name="ListaAnagraficaContrattiOut-input" match="/"&gt;
