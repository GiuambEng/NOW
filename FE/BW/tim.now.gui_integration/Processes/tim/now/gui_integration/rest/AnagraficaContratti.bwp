                                    <bpws:target linkName="InvokeToCallProcess_ricercaAvanzata"/>
                                    <bpws:target linkName="Empty2ToRicercaAvanzata_ricercaAvanzataNoOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RicercaAvanzataToEmpty1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;RicercaAvanzata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:inputservizioricercaavanzata>&#xa;            &lt;xsl:for-each select=&quot;$post.item/tns2:strutturaCondition&quot;>&#xa;                &lt;tns2:strutturaCondition>&#xa;                    &lt;xsl:if test=&quot;tns2:nome&quot;>&#xa;                        &lt;tns2:nome>&#xa;                            &lt;xsl:value-of select=&quot;tns2:nome&quot;/>&#xa;                        &lt;/tns2:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;tns2:nome = (&amp;quot;PROFILO1&amp;quot;,&amp;quot;PROFILO2&amp;quot;,&amp;quot;PROFILO3&amp;quot;) and tns2:valore = 'N' and tns2:operazione = '='&quot;>&#xa;                            &lt;tns2:operazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ISNULL&amp;quot;&quot;/>&#xa;                            &lt;/tns2:operazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;tns2:operazione&quot;>&#xa;                                &lt;tns2:operazione>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:operazione&quot;/>&#xa;                                &lt;/tns2:operazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;tns2:nome = &amp;quot;PROFILO1&amp;quot; and tns2:valore = 'Y'&quot;>&#xa;                            &lt;tns2:valore>&#xa;                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                            &lt;/tns2:valore>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;tns2:nome = &amp;quot;PROFILO2&amp;quot; and tns2:valore = 'Y'&quot;>&#xa;                            &lt;tns2:valore>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns2:valore>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;tns2:nome = &amp;quot;PROFILO3&amp;quot; and tns2:valore = 'Y'&quot;>&#xa;                            &lt;tns2:valore>&#xa;                                &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                            &lt;/tns2:valore>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;tns2:valore&quot;>&#xa;                                &lt;tns2:valore>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:valore&quot;/>&#xa;                                &lt;/tns2:valore>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;tns2:tipo&quot;>&#xa;                        &lt;tns2:tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns2:tipo&quot;/>&#xa;                        &lt;/tns2:tipo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:strutturaCondition>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$post.item/tns2:indiceriga&quot;>&#xa;                &lt;tns2:indiceriga>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns2:indiceriga&quot;/>&#xa;                &lt;/tns2:indiceriga>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns2:numerorighe&quot;>&#xa;                &lt;tns2:numerorighe>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns2:numerorighe&quot;/>&#xa;                &lt;/tns2:numerorighe>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:inputservizioricercaavanzata>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_integration.sub.RicercaAvanzataConditions" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+198dca8a-6e36-4f96-af9f-e236fa020766+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post_ListaOloInvoke&quot;/>&lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;OLO-input&quot; match=&quot;/&quot;>&lt;tns3:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($post/item/tns2:inputservizioricercaavanzata/tns2:strutturaCondition[1]/tns2:nome)=0&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT * FROM (SELECT C.COD_CONTRATTO, C.ID_CONTRATTO, C.NOME_CONTRATTO, C.TIPO, C.ID_STATO_CONTRATTO, C.ID_FAMIG_OFFERTA, C.ID_SOTTOFAMIG_OFFERTA, C.FLAG_ANFIBIO, C.FLAG_ABILITATO, C.FLAG_DIFFIDATO, C.FLAG_STANDARD, C.FLAG_VALIDO, C.FLAG_NPD, C.DATAINZ_VALID, C.DATAFI_VALID, C.IDTPLG_CONTRATTO, C.ID_CONTRATTO_CRMWS, C.NOME_STANDARD, C.OPERATORE, C.STATO_STANDARD, C.ID_COD_CONTRATTO_PADRE, C.FLAG_FILE_NOTIFY, C.TIMSTP_AGGTO, C.TIMSTP_INSMTO, C.EMAIL_OFFERTAFWA1GIGASARDEGNA, TIPOLG_CONTRATTO.DESCR AS DESCRTIPCONTR, TIPOLG_STATO_CONTRATTO.DESCRIPTION AS DESCRSTATOCONTR, SOTTO_FAMIG_OFFERTA.DESCR AS DESCR, FAMIG_OFFERTA.DESCR AS TIPOSERVDESCR, O.NOME, O.RAGIONE_SOCIALE, O.PARTITA_IVA, O.CODFC_OLO_AGCOM, O.COD_OLO, O.FLAG_OLO_ACCORPANTE, C.ID_SISTEMA, (SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 1 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO1,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 2 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO2,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 3 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO3,C.DATA_FINE_COINV_RETE,C.DATA_INIZIO_COINV_RETE,(SELECT DISTINCT VALORE_ATTRIBUTO FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 AND CAM.ID_CONTRATTO=C.ID_CONTRATTO AND CAM.DT_FINE_VALIDITA>SYSDATE) AS BOUQUET,C.FLAG_MULTICAST,C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV from CONTRATTO C LEFT JOIN TIPOLG_CONTRATTO ON C.IDTPLG_CONTRATTO = TIPOLG_CONTRATTO.IDTPLG_CONTRATTO LEFT JOIN SOTTO_FAMIG_OFFERTA ON C.ID_SOTTOFAMIG_OFFERTA = SOTTO_FAMIG_OFFERTA.ID_SOTTOFAMIG_OFFERTA LEFT JOIN TIPOLG_STATO_CONTRATTO ON C.ID_STATO_CONTRATTO = TIPOLG_STATO_CONTRATTO.ID_STATO_CONTRATTO LEFT JOIN FAMIG_OFFERTA ON C.ID_FAMIG_OFFERTA = FAMIG_OFFERTA.ID_FAMIG_OFFERTA LEFT JOIN OLO O ON C.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM WHERE C.ID_SOTTOFAMIG_OFFERTA NOT IN (SELECT ID_SOTTOFAMIG_OFFERTA FROM SOTTO_FAMIG_OFFERTA WHERE DESCR = 'IAV') AND C.CODFC_OLO_AGCOM IN ('&amp;quot;, tib:concat-sequence-format($post_ListaOloInvoke/output/tns1:ListaOloPerNuovoOrdineOutput/tns1:profiloOlo/tns1:anagraficaOlo/tns1:codiceAgcom, &amp;quot;','&amp;quot;, true()), &amp;quot;'))   &amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT * FROM (SELECT C.COD_CONTRATTO, C.ID_CONTRATTO, C.NOME_CONTRATTO, C.TIPO, C.ID_STATO_CONTRATTO, C.ID_FAMIG_OFFERTA, C.ID_SOTTOFAMIG_OFFERTA, C.FLAG_ANFIBIO, C.FLAG_ABILITATO, C.FLAG_DIFFIDATO, C.FLAG_STANDARD, C.FLAG_VALIDO, C.FLAG_NPD, C.DATAINZ_VALID, C.DATAFI_VALID, C.IDTPLG_CONTRATTO, C.ID_CONTRATTO_CRMWS, C.NOME_STANDARD, C.OPERATORE, C.STATO_STANDARD, C.ID_COD_CONTRATTO_PADRE, C.FLAG_FILE_NOTIFY, C.TIMSTP_AGGTO, C.TIMSTP_INSMTO, C.EMAIL_OFFERTAFWA1GIGASARDEGNA, TIPOLG_CONTRATTO.DESCR AS DESCRTIPCONTR, TIPOLG_STATO_CONTRATTO.DESCRIPTION AS DESCRSTATOCONTR, SOTTO_FAMIG_OFFERTA.DESCR AS DESCR, FAMIG_OFFERTA.DESCR AS  TIPOSERVDESCR, O.NOME, O.RAGIONE_SOCIALE, O.PARTITA_IVA, O.CODFC_OLO_AGCOM, O.COD_OLO, O.FLAG_OLO_ACCORPANTE, C.ID_SISTEMA, (SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 1 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO1,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 2 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO2,(SELECT DISTINCT ID_TIPOLOG_CONTR_FWA FROM ass_contr_tipolog_contr_fwa AFW WHERE AFW.ID_TIPOLOG_CONTR_FWA = 3 AND AFW.ID_CONTRATTO=C.ID_CONTRATTO AND TRUNC(AFW.DATA_FINE_VALIDITA)=TRUNC(C.DATAFI_VALID)) AS PROFILO3,C.DATA_FINE_COINV_RETE,C.DATA_INIZIO_COINV_RETE,(SELECT DISTINCT VALORE_ATTRIBUTO FROM CONTRATTO_ATTRIBUTO_MULTICAST CAM WHERE CAM.ID_TIPOLOG_CONTR_ATTR_MULTI = 5 AND CAM.ID_CONTRATTO=C.ID_CONTRATTO AND CAM.DT_FINE_VALIDITA>SYSDATE) AS BOUQUET,C.FLAG_MULTICAST,C.FLAG_DISABILITAZIONE_SERV,C.DATA_INI_DISABILITAZIONE_SERV,C.DATA_FIN_DISABILITAZIONE_SERV from CONTRATTO C LEFT JOIN TIPOLG_CONTRATTO ON C.IDTPLG_CONTRATTO = TIPOLG_CONTRATTO.IDTPLG_CONTRATTO LEFT JOIN SOTTO_FAMIG_OFFERTA ON C.ID_SOTTOFAMIG_OFFERTA = SOTTO_FAMIG_OFFERTA.ID_SOTTOFAMIG_OFFERTA LEFT JOIN TIPOLG_STATO_CONTRATTO ON C.ID_STATO_CONTRATTO = TIPOLG_STATO_CONTRATTO.ID_STATO_CONTRATTO LEFT JOIN FAMIG_OFFERTA ON C.ID_FAMIG_OFFERTA = FAMIG_OFFERTA.ID_FAMIG_OFFERTA LEFT JOIN OLO O ON C.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM WHERE C.ID_SOTTOFAMIG_OFFERTA NOT IN (SELECT ID_SOTTOFAMIG_OFFERTA FROM SOTTO_FAMIG_OFFERTA WHERE DESCR = 'IAV') AND C.CODFC_OLO_AGCOM IN ('&amp;quot;, tib:concat-sequence-format($post_ListaOloInvoke/output/tns1:ListaOloPerNuovoOrdineOutput/tns1:profiloOlo/tns1:anagraficaOlo/tns1:codiceAgcom, &amp;quot;','&amp;quot;, true()), &amp;quot;')) WHERE &amp;quot;, $RicercaAvanzata/tns2:outputcondition[1])&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns3:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
