&quot;substring-before(string(DATAFI_VALID), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataFine>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(IDTPLG_CONTRATTO)&quot;>&#xa;                                        &lt;tns:identificativoTipologiaContratto>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(IDTPLG_CONTRATTO)&quot;/>&#xa;                                        &lt;/tns:identificativoTipologiaContratto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DESCRTIPCONTR&quot;>&#xa;                                        &lt;tns:tipoContratto>&#xa;                                            &lt;xsl:value-of select=&quot;DESCRTIPCONTR&quot;/>&#xa;                                        &lt;/tns:tipoContratto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;xsd:int(ID_SISTEMA)=15&quot;>&#xa;                                            &lt;tns:idSistemaCompetente>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                                            &lt;/tns:idSistemaCompetente>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:idSistemaCompetente>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                                            &lt;/tns:idSistemaCompetente>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;tns:oao>&#xa;                                        &lt;xsl:if test=&quot;NOME&quot;>&#xa;                                            &lt;tns:olo>&#xa;                                                &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                                            &lt;/tns:olo>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&#xa;                                            &lt;tns:ragioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                                            &lt;/tns:ragioneSociale>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;PARTITA_IVA&quot;>&#xa;                                            &lt;tns:partitaIva>&#xa;                                                &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&#xa;                                            &lt;/tns:partitaIva>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                                            &lt;tns:codiceOloAgcom>&#xa;                                                &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                                            &lt;/tns:codiceOloAgcom>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;COD_OLO&quot;>&#xa;                                            &lt;tns:codiceOloNumerico>&#xa;                                                &lt;xsl:value-of select=&quot;COD_OLO&quot;/>&#xa;                                            &lt;/tns:codiceOloNumerico>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;FLAG_OLO_ACCORPANTE&quot;>&#xa;                                            &lt;tns:flagAccorpante>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_OLO_ACCORPANTE&quot;/>&#xa;                                            &lt;/tns:flagAccorpante>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns:oao>&#xa;                                    &lt;xsl:if test=&quot;DESCR='FWA'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;not(empty(PROFILO1))&quot;>&#xa;                                                &lt;tns:contrattoFwaInfratel>&#xa;                                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaInfratel>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns:contrattoFwaInfratel>&#xa;                                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaInfratel>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DESCR='FWA'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;not(empty(PROFILO2))&quot;>&#xa;                                                &lt;tns:contrattoFwaPlus>&#xa;                                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaPlus>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns:contrattoFwaPlus>&#xa;                                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaPlus>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;DESCR='FWA'&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;not(empty(PROFILO3))&quot;>&#xa;                                                &lt;tns:contrattoFwaDecommissioning>&#xa;                                                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaDecommissioning>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns:contrattoFwaDecommissioning>&#xa;                                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                                &lt;/tns:contrattoFwaDecommissioning>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(DATA_INIZIO_COINV_RETE)&quot;>&#xa;                                        &lt;tns:dataInizioCoinvestimento>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(DATA_INIZIO_COINV_RETE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataInizioCoinvestimento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;exists(DATA_FINE_COINV_RETE)&quot;>&#xa;                                        &lt;tns:dataFineCoinvestimento>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(DATA_FINE_COINV_RETE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns:dataFineCoinvestimento>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;BOUQUET&quot;>&#xa;                                        &lt;tns:bouquet>&#xa;                                            &lt;xsl:value-of select=&quot;BOUQUET&quot;/>&#xa;                                        &lt;/tns:bouquet>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns:datiMulticast>&#xa;                                        &lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currIdNoOLODG and ID_TIPOLOG_CONTR_ATTR_MULTI = 2]&quot;>&#xa;                                            &lt;tns:datiIpSessione>&#xa;                                                &lt;tns:ipSessione>&#xa;                                                    &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                                &lt;/tns:ipSessione>&#xa;                                                &lt;tns:dataInizioValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataInizioValidita>&#xa;                                                &lt;tns:dataFineValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataFineValidita>&#xa;                                                &lt;tns:dataInserimento>&#xa;                                                    &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                                &lt;/tns:dataInserimento>&#xa;                                            &lt;/tns:datiIpSessione>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currIdNoOLODG and ID_TIPOLOG_CONTR_ATTR_MULTI = 3]&quot;>&#xa;                                            &lt;tns:datiIpMulticast>&#xa;                                                &lt;tns:ipMulticast>&#xa;                                                    &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                                &lt;/tns:ipMulticast>&#xa;                                                &lt;tns:dataInizioValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataInizioValidita>&#xa;                                                &lt;tns:dataFineValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataFineValidita>&#xa;                                                &lt;tns:dataInserimento>&#xa;                                                    &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                                &lt;/tns:dataInserimento>&#xa;                                            &lt;/tns:datiIpMulticast>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currIdNoOLODG and ID_TIPOLOG_CONTR_ATTR_MULTI = 4]&quot;>&#xa;                                            &lt;tns:datiIpSorgente>&#xa;                                                &lt;tns:ipSorgente>&#xa;                                                    &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                                &lt;/tns:ipSorgente>&#xa;                                                &lt;tns:dataInizioValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataInizioValidita>&#xa;                                                &lt;tns:dataFineValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataFineValidita>&#xa;                                                &lt;tns:dataInserimento>&#xa;                                                    &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                                &lt;/tns:dataInserimento>&#xa;                                            &lt;/tns:datiIpSorgente>&#xa;                                        &lt;/xsl:for-each>&#xa;                                        &lt;xsl:for-each select=&quot;$IpSessione/Record[string(ID_CONTRATTO) = $currIdNoOLODG and ID_TIPOLOG_CONTR_ATTR_MULTI = 1]&quot;>&#xa;                                            &lt;tns:datiAsNumber>&#xa;                                                &lt;tns:asNumber>&#xa;                                                    &lt;xsl:value-of select=&quot;VALORE_ATTRIBUTO&quot;/>&#xa;                                                &lt;/tns:asNumber>&#xa;                                                &lt;tns:dataInizioValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_INIZIO_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataInizioValidita>&#xa;                                                &lt;tns:dataFineValidita>&#xa;                                                    &lt;xsl:value-of select=&quot;DT_FINE_VALIDITA&quot;/>&#xa;                                                &lt;/tns:dataFineValidita>&#xa;                                                &lt;tns:dataInserimento>&#xa;                                                    &lt;xsl:value-of select=&quot;TMS_INSERIMENTO&quot;/>&#xa;                                                &lt;/tns:dataInserimento>&#xa;                                            &lt;/tns:datiAsNumber>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/tns:datiMulticast>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'SI'&quot;>&#xa;                                            &lt;tns:flagMulticast>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns:flagMulticast>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length(FLAG_MULTICAST)>0 and FLAG_MULTICAST = 'NO'&quot;>&#xa;                                            &lt;tns:flagMulticast>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns:flagMulticast>&#xa;                                        &lt;/xsl:when>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;string-length(FLAG_DISABILITAZIONE_SERV)>0&quot;>&#xa;                                        &lt;tns:datiSospensioneServizio>&#xa;                                            &lt;xsl:if test=&quot;exists(DATA_INI_DISABILITAZIONE_SERV)&quot;>&#xa;                                                &lt;tns:dataInizioDisabil>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before(string(DATA_INI_DISABILITAZIONE_SERV), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                                &lt;/tns:dataInizioDisabil>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;exists(DATA_FIN_DISABILITAZIONE_SERV)&quot;>&#xa;                                                &lt;tns:dataFineDisabil>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before(string(DATA_FIN_DISABILITAZIONE_SERV), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                                &lt;/tns:dataFineDisabil>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;FLAG_DISABILITAZIONE_SERV='SI'&quot;>&#xa;                                                    &lt;tns:flagDisabil>&#xa;                                                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                                    &lt;/tns:flagDisabil>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns:flagDisabil>&#xa;                                                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                                    &lt;/tns:flagDisabil>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/tns:datiSospensioneServizio>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;EMAIL_OFFERTAFWA1GIGASARDEGNA&quot;>&#xa;                                        &lt;tns:emailOffertaFwa1GigaSardegna>&#xa;                                            &lt;xsl:value-of select=&quot;EMAIL_OFFERTAFWA1GIGASARDEGNA&quot;/>&#xa;                                        &lt;/tns:emailOffertaFwa1GigaSardegna>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns:contratto>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;if (count($ListaContrattiNonOloNonDG/Record) &amp;lt; $MaxRows) then &amp;quot;OK&amp;quot; else &amp;quot;LIMIT&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputListaContratti>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:outputListaContratti>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                        &lt;tns:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono elementi corrispondenti ai criteri di ricerca&amp;quot;&quot;/>&#xa;                        &lt;/tns:details>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputListaContratti>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ListaVariable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns7=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns4=&quot;http://xmlns.example.com/AnagraficaContratti/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;get_AnagContratti_IngetLog_INFO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaContratti&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaContratti&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$get/httpHeaders/tns7:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get/httpHeaders/tns7:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InfoAnagraficaContratti:&amp;quot;,tib:render-xml($get/parameters/tns4:anagraficacontrattiGetParameters, true(),true()))&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns6:LoggerName>&#xa;                &lt;tns6:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns6:LogLevel>&#xa;                &lt;tns6:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns6:LogJMS>&#xa;            &lt;/tns6:GenericLogger>&#xa;            &lt;tns6:ActiveLoggerServices>&#xa;                &lt;tns6:Envelope>&#xa;                    &lt;tns6:Identifier>&#xa;                        &lt;tns6:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaContratti&amp;quot;&quot;/>&#xa;                        &lt;/tns6:ServiceName>&#xa;                        &lt;tns6:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Operation>&#xa;                        &lt;tns6:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns6:Source>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns7:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns6:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns7:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns6:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns7:httpHeaders/GUI-SID,$get/httpHeaders/tns7:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns6:EventID>&#xa;                        &lt;xsl:if test=&quot;$get/httpHeaders/tns7:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns6:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get/httpHeaders/tns7:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns6:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaContratti_&amp;quot;,$get/httpHeaders/tns7:httpHeaders/GUI-SID,&amp;quot;SUB-PROCESS&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:EventType>&#xa;                        &lt;tns6:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;AnagraficaContratti_&amp;quot;,$get/httpHeaders/tns7:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns6:trackID>&#xa;                    &lt;/tns6:Identifier>&#xa;                    &lt;tns6:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns6:track_position>&#xa;                    &lt;tns6:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns6:Timestamp>&#xa;                    &lt;tns6:ErrorLog/>&#xa;                &lt;/tns6:Envelope>&#xa;            &lt;/tns6:ActiveLoggerServices>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="get_AnagContratti_IngetLog_INFO-input"
                                    name="get_AnagContratti_IngetLog_INFO"
                                    tibex:xpdlId="5fbaa268-951d-4c7b-bb97-3aa35ffc017a"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="get_AnagContratti_IngetLog_INFOToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($tipoProfilo,$get/parameters/tns2:anagraficacontrattiGetParameters/tns2:tipoProfilo)=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($tipoProfilo,$get.parameters/tns2:tipoProfilo)=true()]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="get_AnagContratti_IngetLog_DG">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($get/parameters/tns2:anagraficacontrattiGetParameters/tns2:tipoProfilo,'DG')=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($get.parameters/tns2:tipoProfilo,'DG')=true()]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="get_AnagContratti_IngetLog_NonOlo-NonDg">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns7=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns4=&quot;http://xmlns.example.com/AnagraficaContratti/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;get_AnagContratti_IngetLog_INFO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CW_BUS_MESSAGE>&#xa;            &lt;tns6:GenericLogger>&#xa;                &lt;tns6:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AnagraficaContratti&amp;quot;&quot;/>&#xa;                &lt;/tns6:Process>&#xa;                &lt;tns6:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.AnagraficaContratti&amp;quot;&quot;/>&#xa;                &lt;/tns6:Service>&#xa;                &lt;tns6:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns6:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns6:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns6:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;InfoAnagraficaContratti:&amp;quot;,tib:render-xml($get.parameters, true(),true()))&quot;/>&#xa;                &lt;/tns6:Payload>&#xa;                &lt;tns6:LoggerName>&#xa;