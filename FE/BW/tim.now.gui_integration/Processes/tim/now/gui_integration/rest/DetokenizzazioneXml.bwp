                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RIC.NOME, RIC.PROGRS_TIPOLG_DATO_RICH, RIC.VALORE, TIP.DESCR&#xa;FROM RICH_OLO_DETT RIC LEFT JOIN TIPOLG_DATO_RICH TIP ON RIC.IDTPLG_DATO_RICH = TIP.IDTPLG_DATO_RICH &#xa;WHERE ID_RICH_OLO = ? AND TIP.DESCR IN ('DATI CLIENTE','REFERENTE')" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichOlo"/>
                                    <columnMetadata
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROGRS_TIPOLG_DATO_RICH"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="VALORE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
