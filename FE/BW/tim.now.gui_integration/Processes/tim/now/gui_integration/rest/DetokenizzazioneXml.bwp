;                                                                    &lt;xsl:otherwise>&#xa;                                                                        &lt;ns1:PIVA>&#xa;                                                                            &lt;xsl:value-of select=&quot;$ClienteFinale/tns:PIVA&quot;/>&#xa;                                                                        &lt;/ns1:PIVA>&#xa;                                                                    &lt;/xsl:otherwise>&#xa;                                                                &lt;/xsl:choose>&#xa;                                                            &lt;/ns1:ClienteFinale>&#xa;                                                        &lt;/xsl:for-each>&#xa;                                                        &lt;xsl:for-each select=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoLite/ns1:Accesso/ns1:LineaISDN/ns1:Modem&quot;>&#xa;                                                            &lt;ns1:Modem>&#xa;                                                                &lt;ns1:Interfaccia>&#xa;                                                                    &lt;xsl:value-of select=&quot;ns1:Interfaccia&quot;/>&#xa;                                                                &lt;/ns1:Interfaccia>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Codice&quot;>&#xa;                                                                    &lt;ns1:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:Codice&quot;/>&#xa;                                                                    &lt;/ns1:Codice>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/ns1:Modem>&#xa;                                                        &lt;/xsl:for-each>&#xa