                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ReferentiPvm&quot;/>&lt;xsl:template name=&quot;Progressivi&quot; match=&quot;/&quot;>&lt;tns:progressivi>&lt;xsl:for-each-group select=&quot;$ReferentiPvm/Record[DESCR='REFERENTE']&quot; group-by=&quot;PROGRS_TIPOLG_DATO_RICH&quot;>&lt;tns:progressivo>&lt;xsl:value-of select=&quot;xsd:int(PROGRS_TIPOLG_DATO_RICH)&quot;/>&lt;/tns:progressivo>&lt;/xsl:for-each-group>&lt;/tns:progressivi>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
