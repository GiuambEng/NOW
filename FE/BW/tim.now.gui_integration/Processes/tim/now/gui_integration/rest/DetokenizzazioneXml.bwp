eReferente>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:telefono&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;tns:telefono&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:mobile&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;tns:mobile&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:email&quot;>&lt;EmailReferente>&lt;xsl:value-of select=&quot;tns:email&quot;/>&lt;/EmailReferente>&lt;/xsl:if>&lt;/Referente>&lt;/xsl:for-each>&lt;xsl:if test=&quot;Ordine/Attivazione/WLRLineaAttiva/CampoServizioIT&quot;>&lt;CampoServizioIT>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/CampoServizioIT&quot;/>&lt;/CampoServizioIT>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/WLRLineaAttiva/ClirPermanente&quot;>&lt;ClirPermanente>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/ClirPermanente&quot;/>&lt;/ClirPermanente>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/WLRLineaAttiva/FlagMantenimentoSTS&quot;>&lt;FlagMantenimentoSTS>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/FlagMantenimentoSTS&quot;/>&lt;/FlagMantenimentoSTS>&lt;/xsl:if>&lt;/WLRLineaAttiva>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/WLRLineaNonAttiva)&quot;>&lt;WLRLineaNonAttiva>&lt;xsl:for-each select=&quot;Ordine/Attivazione/WLRLineaNonAttiva/DatiCliente&quot;>&lt;DatiCliente>&lt;CognomeRagSoc>&lt;xsl:value-of select=&quot;$ClienteFinale/tns:cognome&quot;/>&lt;/CognomeRagSoc>&lt;xsl:if test=&quot;$ClienteFinale/tns:nome&quot;>&lt;Nome>&lt;xsl:value-of select=&quot;$ClienteFinale/tns:nome&quot;/>&lt;/Nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(CF)>0&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$ClienteFinale/tns:CF&quot;/>&lt;/CF>&lt;/xsl:when>&lt;xsl:otherwise>&lt;PIVA>&lt;xsl:value-of select=&quot;$ClienteFinale/tns:PI