                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;XmlRegolatorio&quot;/>&lt;xsl:param name=&quot;ClienteFinale&quot;/>&lt;xsl:param name=&quot;ListaReferenti&quot;/>&lt;xsl:template name=&quot;Regolatorio&quot; match=&quot;/&quot;>&lt;xsl:for-each select=&quot;$XmlRegolatorio&quot;>&lt;Richiesta>&lt;Testata>&lt;CodiceOlo>&lt;xsl:value-of select=&quot;Testata/CodiceOlo&quot;/>&lt;/CodiceOlo>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOlo&quot;/>&lt;/CodiceOrdineOlo>&lt;xsl:if test=&quot;Testata/CodiceOrdineOloPadre&quot;>&lt;CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOloPadre&quot;/>&lt;/CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;Testata/CodiceProgetto&quot;>&lt;CodiceProgetto>&lt;xsl:value-of select=&quot;Testata/CodiceProgetto&quot;/>&lt;/CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;Testata/Note&quot;>&lt;Note>&lt;xsl:value-of select=&quot;Testata/Note&quot;/>&lt;/Note>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(Testata/Correlazioni/IdentificativoCorrelazioni)&quot;>&lt;Correlazioni>&lt;IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;Testata/Correlazioni/IdentificativoCorrelazioni&quot;/>&lt;/IdentificativoCorrelazioni>&lt;TotRichieste>&lt;xsl:value-of select=&quot;Testata/Correlazioni/TotRichieste&quot;/>&lt;/TotRichieste>&lt;xsl:if test=&quot;Testata/Correlazioni/TipoPacchetto&quot;>&lt;TipoPacchetto>&lt;xsl:value-of select=&quot;Testata/Correlazioni/TipoPacchetto&quot;/>&lt;/TipoPacchetto>&lt;/xsl:if>&lt;/Correlazioni>&lt;/xsl:if>&lt;xsl:if test=&quot;Testata/ReferentiOAOProgettiSpeciali&quot;>&lt;ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;Testata/ReferentiOAOProgettiSpeciali&quot;/>&lt;/ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;/Testata>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Ordine/Attivazione)&quot;>&lt;Ordine>&lt;Attivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/WLRLineaAttiva)&quot;>&lt;WLRLineaAttiva>&lt;DN>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/DN&quot;/>&lt;/DN>&lt;FlagMantenimentoProdotti>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/FlagMantenimentoProdotti&quot;/>&lt;/FlagMantenimentoProdotti>&lt;DataSottoscrizioneContratto>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/DataSottoscrizioneContratto&quot;/>&lt;/DataSottoscrizioneContratto>&lt;xsl:if test=&quot;Ordine/Attivazione/WLRLineaAttiva/DataDAC&quot;>&lt;DataDAC>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/DataDAC&quot;/>&lt;/DataDAC>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/WLRLineaAttiva/FlagAggiuntivi&quot;>&lt;FlagAggiuntivi>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/FlagAggiuntivi&quot;/>&lt;/FlagAggiuntivi>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/WLRLineaAttiva/BorchiaNT1Plus&quot;>&lt;BorchiaNT1Plus>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/BorchiaNT1Plus&quot;/>&lt;/BorchiaNT1Plus>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/WLRLineaAttiva/CodiceQualita&quot;>&lt;CodiceQualita>&lt;xsl:value-of select=&quot;Ordine/Attivazione/WLRLineaAttiva/CodiceQualita&quot;/>&lt;/CodiceQualita>&lt;/xsl:if>&lt;xsl:for-each select=&quot;Ordine/Attivazione/WLRLineaAttiva/DatiCliente&quot;>&lt;DatiCliente>&lt;CognomeRagSoc>&lt;xsl:value-of select=&quot;$ClienteFinale/tns:cognome&quot;/>&lt;/CognomeRagSoc>&lt;xsl:if test=&quot;$ClienteFinale/tns:nome&quot;>&lt;Nome>&lt;xsl:value-of select=&quot;$ClienteFinale/tns:nome&quot;/>&lt;/Nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(CF)&quot;>&lt;xsl:if test=&quot;$ClienteFinale/tns:CF&quot;>&lt;CF>&lt;xsl:value-of selec