                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;XmlFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderXml3-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:Richiesta>&#xa;            &lt;xsl:copy-of select=&quot;$XmlFWA/ns1:Testata&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$XmlFWA/ns1:TipoRichiesta&quot;/>&#xa;        &lt;/ns1:Richiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.renderxml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:order="http://fwa.telecomitalia.it/crm/fwa/order"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="order:Richiesta"
                                    outputStyle="text" xsi:type="palettexml:RenderXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+60989946-79d7-4d01-afdc-bd607edc8e0b+input&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:template name=&quot;ReferentiOrdine-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codOrdineOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1/item/tns:inputDetokenizzaXml/tns:codOrdineOlo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:codOrdineOlo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOrdineOlo>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($post1/item/tns:inputDetokenizzaXml/tns:lavorazione) = ('ATTIVAZIONE','VARIAZIONE','MIGRAZIONE','CESSAZIONE')&quot;>&#xa;                    &lt;tipoReferente>&#xa;                        &lt;xsl:value-of select=&quot;'REFERENTE'&quot;/>&#xa;                    &lt;/tipoReferente>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post1/item/tns:inputDetokenizzaXml/tns:lavorazione) = 'RIMODULAZIONEDAD'&quot;>&#xa;                    &lt;tipoReferente>&#xa;                        &lt;xsl:value-of select=&quot;'REFERENTERIMODULAZIONEAPPUNTAMENTO'&quot;/>&#xa;                    &lt;/tipoReferente>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipoReferente>&#xa;                        &lt;xsl:value-of select=&quot;'REFERENTEPERINTERRUZIONESOSPENSIONE'&quot;/>&#xa;                    &lt;/tipoReferente>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ReferentiOrdine-input"
                                    name="ReferentiOrdine"
                                    outputVariable="ReferentiOrdine"
                                    tibex:xpdlId="60989946-79d7-4d01-afdc-bd607edc8e0b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DetokenizzaXml_LogInfoToReferentiOrdine"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ReferentiOrdineToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($ReferentiOrdine/Record/PROGRESSIVOREFERENTE)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($ReferentiOrdine/Record/PROGRESSIVOREFERENTE)=0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="ReferentiOrdineToAssign9">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+60989946-79d7-4d01-afdc-bd607edc8e0b+input&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:template name=&quot;ReferentiOrdine-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;codOrdineOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1.item/tns:codOrdineOlo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns:codOrdineOlo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOrdineOlo>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($post1.item/tns:lavorazione) = ('ATTIVAZIONE','VARIAZIONE','MIGRAZIONE','CESSAZIONE')&quot;>&#xa;                    &lt;tipoReferente>&#xa;                        &lt;xsl:value-of select=&quot;'REFERENTE'&quot;/>&#xa;                    &lt;/tipoReferente>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($post1.item/tns:lavorazione) = 'RIMODULAZIONEDAD'&quot;>&#xa;                    &lt;tipoReferente>&#xa;                        &lt;xsl:value-of select=&quot;'REFERENTERIMODULAZIONEAPPUNTAMENTO'&quot;/>&#xa;                    &lt;/tipoReferente>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipoReferente>&#xa;                        &lt;xsl:value-of select=&quot;'REFERENTEPERINTERRUZIONESOSPENSIONE'&quot;/>&#xa;                    &lt;/tipoReferente>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;  RE.PROGRESSIVOREFERENTE, RE.QUALIFICAREFERENTE, RE.COGNOMEREFERENTE,&#xa;  RE.NOMEREFERENTE, RE.TELEFONOFISSOREFERENTE, RE.TELEFONOMOBILEREFERENTE,&#xa;  RE.CREATED, RE.LASTUPDATE, RE.TIPOREFERENTEORDINE, RE.EMAILREFERENTE,RE.REFOAOPROGETTISPECIALI&#xa;  FROM&#xa;       BDS_1_CASEDATA_ORDINE O LEFT JOIN BDS_1_CASEDATA_REFERENTE RE ON RE.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;WHERE O.CODICEORDINEOLO = ? &#xa;AND RE.TIPOREFERENTEORDINE = ?&#xa;AND RE.PROGRESSIVOREFERENTE &lt;>0&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOrdineOlo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tipoReferente"/>
                                    <columnMetadata
                                    columnName="PROGRESSIVOREFERENTE"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QUALIFICAREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="COGNOMEREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TELEFONOFISSOREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TELEFONOMOBILEREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="LASTUPDATE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIPOREFERENTEORDINE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="EMAILREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="REFOAOPROGETTISPECIALI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:scope name="Iterate"
                                tibex:group="iterate" tibex:xpdlId="e9b97d46-f2d8-4369-acd9-3ce4442d783b">
                                <bpws:targets>
                                    <bpws:target linkName="Assign9ToIterate"/>
                                    <bpws:target linkName="Assign11ToIterate"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="IterateToAssign2"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable
                                    name="indiceReferenti"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence1" tibex:group="iterate">
                                    <bpws:assign name="GroupInit1"
                                    tibex:group="groupInit"
                                    tibex:xpdlId="3260d58b-3149-4143-8b21-51e144972ffe" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+e69eefb4-2588-4e17-9d6e-82ee381e4d35" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:forEach counterName="index1"
                                    name="iterate" parallel="no" tibex:group="iterate">
                                    <tibex:DesignExpression name="variableList">
                                    <tibex:expression
                                    expression="$ListaReferentiCiclo/ns2:datiSensibili" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListaReferentiCiclo/ns2:datiSensibili)]]></bpws:finalCounterValue>
                                    <bpws:scope name="innerScope">
                                    <bpws:variables>
                                    <bpws:variable
                                    element="ns2:Iterate_Current_Element_datiSensibili"
                                    name="currentElement" sca-bpel:internal="true"/>
                                    </bpws:variables>
                                    <bpws:flow name="flow7">
                                    <bpws:links>
                                    <bpws:link
                                    name="MapperToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogToDetokenizzaReferente" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="DetokenizzaReferenteToLog1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Log1ToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1ToEmpty6" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Empty6ToLog" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Empty6ToMapper" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart1"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="cd753390-1b04-48c5-841d-fbcdfece5dc9" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToEmpty6"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListaReferentiCiclo/ns2:datiSensibili)[number($index1)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="e69eefb4-2588-4e17-9d6e-82ee381e4d35" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGroupEnd1"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>

                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;DetokenizzaReferente&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;starts-with($currentElement/tns:telefono, 'kk') or starts-with($currentElement/tns:telefono, 'dk') or starts-with($currentElement/tns:mobile, 'kk') or starts-with($currentElement/tns:mobile, 'dk') and $DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:ESITO !='KO'&quot;>&#xa;                &lt;tns:referente>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:qualifica&quot;>&#xa;                        &lt;tns:qualifica>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:qualifica&quot;/>&#xa;                        &lt;/tns:qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:Nome)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:Nome&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:Nome&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$currentElement/tns:nome&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/tns:nome&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:CognomeRagioneSociale)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:CognomeRagioneSociale&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$currentElement/tns:cognome&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/tns:cognome&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:N_Recap_Cliente)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:N_Recap_Cliente&quot;>&#xa;                                &lt;tns:telefono>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:N_Recap_Cliente&quot;/>&#xa;                                &lt;/tns:telefono>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$currentElement/tns:telefono&quot;>&#xa;                                &lt;tns:telefono>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/tns:telefono&quot;/>&#xa;                                &lt;/tns:telefono>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:N_Recap_Cliente_ALT)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:N_Recap_Cliente_ALT&quot;>&#xa;                                &lt;tns:mobile>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:N_Recap_Cliente_ALT&quot;/>&#xa;                                &lt;/tns:mobile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$currentElement/tns:mobile&quot;>&#xa;                                &lt;tns:mobile>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/tns:mobile&quot;/>&#xa;                                &lt;/tns:mobile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:email&quot;>&#xa;                        &lt;tns:email>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:email&quot;/>&#xa;                        &lt;/tns:email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:referente>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:referente>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:qualifica&quot;>&#xa;                        &lt;tns:qualifica>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:qualifica&quot;/>&#xa;                        &lt;/tns:qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:nome&quot;>&#xa;                        &lt;tns:nome>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:nome&quot;/>&#xa;                        &lt;/tns:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:cognome&quot;>&#xa;                        &lt;tns:cognome>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:cognome&quot;/>&#xa;                        &lt;/tns:cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:telefono&quot;>&#xa;                        &lt;tns:telefono>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:telefono&quot;/>&#xa;                        &lt;/tns:telefono>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:mobile&quot;>&#xa;                        &lt;tns:mobile>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:mobile&quot;/>&#xa;                        &lt;/tns:mobile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:email&quot;>&#xa;                        &lt;tns:email>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:email&quot;/>&#xa;                        &lt;/tns:email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:referente>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="dc0070b1-e5ec-4de4-8b39-bfa91fa003f2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log1ToMapper"/>
                                    <bpws:target linkName="Empty6ToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetokenizzaReferente.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;starts-with($currentElement/tns:telefono, 'kk') or starts-with($currentElement/tns:telefono, 'dk') or starts-with($currentElement/tns:mobile, 'kk') or starts-with($currentElement/tns:mobile, 'dk') and $DetokenizzaReferente.Output/tns2:ESITO !='KO'&quot;>&#xa;                &lt;tns:referente>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:qualifica&quot;>&#xa;                        &lt;tns:qualifica>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:qualifica&quot;/>&#xa;                        &lt;/tns:qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($DetokenizzaReferente.Output/tns2:Nome)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaReferente.Output/tns2:Nome&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaReferente.Output/tns2:Nome&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$currentElement/tns:nome&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/tns:nome&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($DetokenizzaReferente.Output/tns2:CognomeRagioneSociale)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaReferente.Output/tns2:CognomeRagioneSociale&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaReferente.Output/tns2:CognomeRagioneSociale&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$currentElement/tns:cognome&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/tns:cognome&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($DetokenizzaReferente.Output/tns2:N_Recap_Cliente)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaReferente.Output/tns2:N_Recap_Cliente&quot;>&#xa;                                &lt;tns:telefono>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaReferente.Output/tns2:N_Recap_Cliente&quot;/>&#xa;                                &lt;/tns:telefono>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$currentElement/tns:telefono&quot;>&#xa;                                &lt;tns:telefono>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/tns:telefono&quot;/>&#xa;                                &lt;/tns:telefono>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($DetokenizzaReferente.Output/tns2:N_Recap_Cliente_ALT)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$DetokenizzaReferente.Output/tns2:N_Recap_Cliente_ALT&quot;>&#xa;                                &lt;tns:mobile>&#xa;                                    &lt;xsl:value-of select=&quot;$DetokenizzaReferente.Output/tns2:N_Recap_Cliente_ALT&quot;/>&#xa;                                &lt;/tns:mobile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$currentElement/tns:mobile&quot;>&#xa;                                &lt;tns:mobile>&#xa;                                    &lt;xsl:value-of select=&quot;$currentElement/tns:mobile&quot;/>&#xa;                                &lt;/tns:mobile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:email&quot;>&#xa;                        &lt;tns:email>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:email&quot;/>&#xa;                        &lt;/tns:email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:referente>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:referente>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:progressivo&quot;>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:progressivo&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:qualifica&quot;>&#xa;                        &lt;tns:qualifica>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:qualifica&quot;/>&#xa;                        &lt;/tns:qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:nome&quot;>&#xa;                        &lt;tns:nome>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:nome&quot;/>&#xa;                        &lt;/tns:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:cognome&quot;>&#xa;                        &lt;tns:cognome>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:cognome&quot;/>&#xa;                        &lt;/tns:cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:telefono&quot;>&#xa;                        &lt;tns:telefono>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:telefono&quot;/>&#xa;                        &lt;/tns:telefono>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:mobile&quot;>&#xa;                        &lt;tns:mobile>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:mobile&quot;/>&#xa;                        &lt;/tns:mobile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:email&quot;>&#xa;                        &lt;tns:email>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:email&quot;/>&#xa;                        &lt;/tns:email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:referente>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:DetokenizzazioneXml="http://www.example.org/DetokenizzazioneXml"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>

                                    <value
                                    inputQName="DetokenizzazioneXml:referente" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:invoke
                                    inputVariable="DetokenizzaReferente-input"
                                    name="DetokenizzaReferente"
                                    operation="Decode_token_NOWSecolo"
                                    outputVariable="DetokenizzaReferente"
                                    partnerLink="NOW_SECOLOPortType"
                                    portType="ns3:NOW_SECOLOPortType" tibex:xpdlId="ac16de57-9b3f-4204-822b-cba30e4e1977">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/NOW_SECOLO/" xmlns:tns2="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/DetokenizzazioneXml" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="currentElement"/&gt;
    &lt;xsl:param name="post1"/&gt;
    &lt;xsl:template name="DetokenizzaReferente-input" match="/"&gt;
        &lt;ns:Decode_token_NOWSecoloRequest&gt;
            &lt;Input&gt;
                &lt;tns2:RequestDecode_token&gt;
                    &lt;xsl:if test="$post1/item/tns:inputDetokenizzaXml/tns:codOloAgcom"&gt;
                        &lt;tns2:CodificaOLOAGCOM&gt;
                            &lt;xsl:value-of select="$post1/item/tns:inputDetokenizzaXml/tns:codOloAgcom"/&gt;
                        &lt;/tns2:CodificaOLOAGCOM&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$post1/item/tns:inputDetokenizzaXml/tns:codOrdineOlo"&gt;
                        &lt;tns2:CodiceOrdineOLO&gt;
                            &lt;xsl:value-of select="$post1/item/tns:inputDetokenizzaXml/tns:codOrdineOlo"/&gt;
                        &lt;/tns2:CodiceOrdineOLO&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns2:Funzione&gt;
                        &lt;xsl:value-of select="'VISGUIO'"/&gt;
                    &lt;/tns2:Funzione&gt;
                    &lt;tns2:ChiaveRiferimento&gt;
                        &lt;xsl:value-of select="concat($post1/item/tns:inputDetokenizzaXml/tns:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))"/&gt;
                    &lt;/tns2:ChiaveRiferimento&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($post1/item/tns:inputDetokenizzaXml/tns:operatore) = 0"&gt;
                            &lt;tns2:Operatore&gt;
                                &lt;xsl:value-of select="''"/&gt;
                            &lt;/tns2:Operatore&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$post1/item/tns:inputDetokenizzaXml/tns:operatore"&gt;
                                &lt;tns2:Operatore&gt;
                                    &lt;xsl:value-of select="$post1/item/tns:inputDetokenizzaXml/tns:operatore"/&gt;
                                &lt;/tns2:Operatore&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($post1/item/tns:inputDetokenizzaXml/tns:IPClient) = 0"&gt;
                            &lt;tns2:IPClient&gt;
                                &lt;xsl:value-of select="''"/&gt;
                            &lt;/tns2:IPClient&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$post1/item/tns:inputDetokenizzaXml/tns:IPClient"&gt;
                                &lt;tns2:IPClient&gt;
                                    &lt;xsl:value-of select="$post1/item/tns:inputDetokenizzaXml/tns:IPClient"/&gt;
                                &lt;/tns2:IPClient&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="starts-with($currentElement/tns:telefono, 'kk') or starts-with($currentElement/tns:telefono, 'dk')"&gt;
                            &lt;xsl:if test="$currentElement/tns:telefono"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$currentElement/tns:telefono"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$currentElement/tns:mobile"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$currentElement/tns:mobile"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns2:RequestDecode_token&gt;
            &lt;/Input&gt;
        &lt;/ns:Decode_token_NOWSecoloRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/NOW_SECOLO/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;DetokenizzaReferente-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RequestDecode_token>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:codOloAgcom&quot;>&#xa;                &lt;tns2:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:codOloAgcom&quot;/>&#xa;                &lt;/tns2:CodificaOLOAGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:codOrdineOlo&quot;>&#xa;                &lt;tns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:codOrdineOlo&quot;/>&#xa;                &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:Funzione>&#xa;                &lt;xsl:value-of select=&quot;'VISGUIO'&quot;/>&#xa;            &lt;/tns2:Funzione>&#xa;            &lt;tns2:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat($post1.item/tns:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns2:ChiaveRiferimento>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post1.item/tns:operatore) = 0&quot;>&#xa;                    &lt;tns2:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:Operatore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:operatore&quot;>&#xa;                        &lt;tns2:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                        &lt;/tns2:Operatore>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post1.item/tns:IPClient) = 0&quot;>&#xa;                    &lt;tns2:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:IPClient>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:IPClient&quot;>&#xa;                        &lt;tns2:IPClient>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:IPClient&quot;/>&#xa;                        &lt;/tns2:IPClient>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($currentElement/tns:telefono, 'kk') or starts-with($currentElement/tns:telefono, 'dk')&quot;>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:telefono&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:telefono&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$currentElement/tns:mobile&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$currentElement/tns:mobile&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:RequestDecode_token>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="LogToDetokenizzaReferente"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DetokenizzaReferenteToLog1"/>
                                    </bpws:sources>
                                    </bpws:invoke>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="Log-input"
                                    name="Log"
                                    tibex:xpdlId="47f0d310-3cc8-4d54-96c6-5f78da87b915" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty6ToLog"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogToDetokenizzaReferente"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($currentElement/tns:telefono, 'kk') or starts-with($currentElement/tns:telefono, 'dk')&quot;>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;concat('Detokenizzazione XML per Token: ',$currentElement/tns:telefono)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;concat('Detokenizzazione XML per Token: ',$currentElement/tns:mobile)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>

                                    <value
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;DetokenizzaReferente&quot;/>&#xa;    &lt;xsl:template name=&quot;Log1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($currentElement/tns:telefono, 'kk') or starts-with($currentElement/tns:telefono, 'dk')&quot;>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;concat('Token: ',$currentElement/tns:telefono,'. Detokenizzato in ',$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:N_Recap_Cliente)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;concat('Token: ',$currentElement/tns:telefono,'. Detokenizzato in ',$DetokenizzaReferente/Output/tns2:ResponseDecode_token/tns2:N_Recap_Cliente_ALT)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Log1-input"
                                    name="Log1"
                                    tibex:xpdlId="23456657-d90e-40f7-9065-269a5924916a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DetokenizzaReferenteToLog1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log1ToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetokenizzaReferente.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;Log1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($currentElement/tns:telefono, 'kk') or starts-with($currentElement/tns:telefono, 'dk')&quot;>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;concat('Token: ',$currentElement/tns:telefono,'. Detokenizzato in ',$DetokenizzaReferente.Output/tns2:N_Recap_Cliente)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;concat('Token: ',$currentElement/tns:telefono,'. Detokenizzato in ',$DetokenizzaReferente.Output/tns2:N_Recap_Cliente_ALT)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>

                                    <value
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:empty
                                    name="Empty6" tibex:xpdlId="7a6575aa-4585-45b3-8e77-4808e9ba8c9b">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToEmpty6"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Empty6ToLog">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$post1/item/ns2:inputDetokenizzaXml/ns2:flagDetok = 'Y' and (starts-with($currentElement/ns2:telefono, 'kk') or starts-with($currentElement/ns2:telefono, 'dk') or starts-with($currentElement/ns2:mobile, 'kk') or starts-with($currentElement/ns2:mobile, 'dk') and $currentElement/ns2:qualifica != 'O')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$post1.item/ns2:flagDetok = 'Y' and (starts-with($currentElement/ns2:telefono, 'kk') or starts-with($currentElement/ns2:telefono, 'dk') or starts-with($currentElement/ns2:mobile, 'kk') or starts-with($currentElement/ns2:mobile, 'dk') and $currentElement/ns2:qualifica != 'O')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty6ToMapper">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:forEach>
                                </bpws:sequence>
                            </bpws:scope>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post1&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;ListaReferentiCiclo&quot;/>&lt;xsl:template name=&quot;ListaReferenti&quot; match=&quot;/&quot;>&lt;tns:listaReferente>&lt;xsl:for-each select=&quot;$ListaReferentiCiclo/tns:datiSensibili&quot;>&lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;xsd:int(tns:progressivo)&quot;/>&lt;tns:datiSensibili>&lt;xsl:if test=&quot;tns:progressivo&quot;>&lt;tns:progressivo>&lt;xsl:value-of select=&quot;tns:progressivo&quot;/>&lt;/tns:progressivo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:qualifica&quot;>&lt;tns:qualifica>&lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:qualifica&quot;/>&lt;/tns:qualifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($post1/item/tns:inputDetokenizzaXml/tns:flagDetok)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagDetok = 'Y'&quot;>&lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia)>0 and string-length(tns:nome)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia = 'Y' and tns:qualifica != 'O' and not(starts-with(tns:nome, 'dk') or starts-with(tns:nome, 'kk')) &quot;>&lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns:nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;tns:nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($post1/item/tns:inputDetokenizzaXml/tns:flagDetok)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagDetok = 'Y'&quot;>&lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:cognome&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:cognome&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia = 'Y' and tns:qualifica != 'O'  and not(starts-with(tns:cognome, 'dk') or starts-with(tns:cognome, 'kk')) &quot;>&lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns:cognome&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;tns:cognome&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($post1/item/tns:inputDetokenizzaXml/tns:flagDetok)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagDetok = 'Y'&quot;>&lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:telefono&quot;>&lt;tns:telefono>&lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:telefono&quot;/>&lt;/tns:telefono>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia)>0 and string-length(tns:telefono)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia = 'Y' and tns:qualifica != 'O' and not(starts-with(tns:telefono, 'dk') or starts-with(tns:telefono, 'kk')) &quot;>&lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&lt;tns:telefono>&lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&lt;/tns:telefono>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns:telefono&quot;>&lt;tns:telefono>&lt;xsl:value-of select=&quot;tns:telefono&quot;/>&lt;/tns:telefono>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($post1/item/tns:inputDetokenizzaXml/tns:flagDetok)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagDetok = 'Y'&quot;>&lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:mobile&quot;>&lt;tns:mobile>&lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:mobile&quot;/>&lt;/tns:mobile>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia)>0 and string-length(tns:mobile)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia = 'Y' and tns:qualifica != 'O' and not(starts-with(tns:mobile, 'dk') or starts-with(tns:mobile, 'kk')) &quot;>&lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&lt;tns:mobile>&lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&lt;/tns:mobile>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns:mobile&quot;>&lt;tns:mobile>&lt;xsl:value-of select=&quot;tns:mobile&quot;/>&lt;/tns:mobile>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:email&quot;>&lt;tns:email>&lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:email&quot;/>&lt;/tns:email>&lt;/xsl:if>&lt;/tns:datiSensibili>&lt;/xsl:for-each>&lt;/tns:listaReferente>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ListaReferenti"
                                    name="RefTracciato"
                                    outputVariable="ListaReferenti"
                                    tibex:xpdlId="20cdf163-a721-4823-b00f-83d5fff0cde1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="IterateToAssign2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RefTracciatoToJDBCQuery_Ordini">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($post1/item/ns2:inputDetokenizzaXml/ns2:lavorazione) = ('ATTIVAZIONE','VARIAZIONE','MIGRAZIONE','CESSAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($post1.item/ns2:lavorazione) = ('ATTIVAZIONE','VARIAZIONE','MIGRAZIONE','CESSAZIONE')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="RefTracciatoToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaReferentiCiclo&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaReferenti&quot; match=&quot;/&quot;>&#xa;        &lt;tns:listaReferente>&#xa;            &lt;xsl:for-each select=&quot;$ListaReferentiCiclo/tns:datiSensibili&quot;>&#xa;                &lt;xsl:variable name=&quot;currProgressivo&quot; select=&quot;xsd:int(tns:progressivo)&quot;/>&#xa;                &lt;tns:datiSensibili>&#xa;                    &lt;xsl:if test=&quot;tns:progressivo&quot;>&#xa;                        &lt;tns:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;tns:progressivo&quot;/>&#xa;                        &lt;/tns:progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:qualifica&quot;>&#xa;                        &lt;tns:qualifica>&#xa;                            &lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:qualifica&quot;/>&#xa;                        &lt;/tns:qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($post1.item/tns:flagDetok)>0 and $post1.item/tns:flagDetok = 'Y'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:nome&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:nome&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($post1.item/tns:flagTokFittizia)>0 and string-length(tns:nome)>0 and $post1.item/tns:flagTokFittizia = 'Y' and tns:qualifica != 'O' and not(starts-with(tns:nome, 'dk') or starts-with(tns:nome, 'kk')) &quot;>&#xa;                            &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;tns:nome&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;tns:nome&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($post1.item/tns:flagDetok)>0 and $post1.item/tns:flagDetok = 'Y'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:cognome&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:cognome&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($post1.item/tns:flagTokFittizia)>0 and $post1.item/tns:flagTokFittizia = 'Y' and tns:qualifica != 'O'  and not(starts-with(tns:cognome, 'dk') or starts-with(tns:cognome, 'kk')) &quot;>&#xa;                            &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;tns:cognome&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;tns:cognome&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($post1.item/tns:flagDetok)>0 and $post1.item/tns:flagDetok = 'Y'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:telefono&quot;>&#xa;                                &lt;tns:telefono>&#xa;                                    &lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:telefono&quot;/>&#xa;                                &lt;/tns:telefono>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($post1.item/tns:flagTokFittizia)>0 and string-length(tns:telefono)>0 and $post1.item/tns:flagTokFittizia = 'Y' and tns:qualifica != 'O' and not(starts-with(tns:telefono, 'dk') or starts-with(tns:telefono, 'kk')) &quot;>&#xa;                            &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                                &lt;tns:telefono>&#xa;                                    &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                                &lt;/tns:telefono>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;tns:telefono&quot;>&#xa;                                &lt;tns:telefono>&#xa;                                    &lt;xsl:value-of select=&quot;tns:telefono&quot;/>&#xa;                                &lt;/tns:telefono>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($post1.item/tns:flagDetok)>0 and $post1.item/tns:flagDetok = 'Y'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:mobile&quot;>&#xa;                                &lt;tns:mobile>&#xa;                                    &lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:mobile&quot;/>&#xa;                                &lt;/tns:mobile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($post1.item/tns:flagTokFittizia)>0 and string-length(tns:mobile)>0 and $post1.item/tns:flagTokFittizia = 'Y' and tns:qualifica != 'O' and not(starts-with(tns:mobile, 'dk') or starts-with(tns:mobile, 'kk')) &quot;>&#xa;                            &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                                &lt;tns:mobile>&#xa;                                    &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                                &lt;/tns:mobile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;tns:mobile&quot;>&#xa;                                &lt;tns:mobile>&#xa;                                    &lt;xsl:value-of select=&quot;tns:mobile&quot;/>&#xa;                                &lt;/tns:mobile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:email&quot;>&#xa;                        &lt;tns:email>&#xa;                            &lt;xsl:value-of select=&quot;$Accumulate/tns:referente[xsd:int(tns:progressivo) = $currProgressivo]/tns:email&quot;/>&#xa;                        &lt;/tns:email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:datiSensibili>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:listaReferente>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ListaReferenti" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="DetokenizzaCF-input"
                                name="DetokenizzaCF"
                                operation="Decode_token_NOWSecolo"
                                outputVariable="DetokenizzaCF"
                                partnerLink="NOW_SECOLOPortType"
                                portType="ns3:NOW_SECOLOPortType" tibex:xpdlId="a42a88f1-2082-4937-b04a-661fad837e5a">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.example.org/DetokenizzazioneXml" xmlns:ns="http://www.tibco.com/NOW_SECOLO/" xmlns:tns2="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="post1"/&gt;
    &lt;xsl:param name="DatiCF"/&gt;
    &lt;xsl:param name="ReferentiPvm"/&gt;
    &lt;xsl:template name="DetokenizzaCF-input" match="/"&gt;
        &lt;ns:Decode_token_NOWSecoloRequest&gt;
            &lt;Input&gt;
                &lt;tns2:RequestDecode_token&gt;
                    &lt;xsl:if test="$post1/item/tns:inputDetokenizzaXml/tns:codOloAgcom"&gt;
                        &lt;tns2:CodificaOLOAGCOM&gt;
                            &lt;xsl:value-of select="$post1/item/tns:inputDetokenizzaXml/tns:codOloAgcom"/&gt;
                        &lt;/tns2:CodificaOLOAGCOM&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$post1/item/tns:inputDetokenizzaXml/tns:codOrdineOlo"&gt;
                        &lt;tns2:CodiceOrdineOLO&gt;
                            &lt;xsl:value-of select="$post1/item/tns:inputDetokenizzaXml/tns:codOrdineOlo"/&gt;
                        &lt;/tns2:CodiceOrdineOLO&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns2:Funzione&gt;
                        &lt;xsl:value-of select="'VISGUIO'"/&gt;
                    &lt;/tns2:Funzione&gt;
                    &lt;tns2:ChiaveRiferimento&gt;
                        &lt;xsl:value-of select="concat($post1/item/tns:inputDetokenizzaXml/tns:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))"/&gt;
                    &lt;/tns2:ChiaveRiferimento&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($post1/item/tns:inputDetokenizzaXml/tns:operatore) = 0"&gt;
                            &lt;tns2:Operatore&gt;
                                &lt;xsl:value-of select="''"/&gt;
                            &lt;/tns2:Operatore&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$post1/item/tns:inputDetokenizzaXml/tns:operatore"&gt;
                                &lt;tns2:Operatore&gt;
                                    &lt;xsl:value-of select="$post1/item/tns:inputDetokenizzaXml/tns:operatore"/&gt;
                                &lt;/tns2:Operatore&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($post1/item/tns:inputDetokenizzaXml/tns:IPClient) = 0"&gt;
                            &lt;tns2:IPClient&gt;
                                &lt;xsl:value-of select="''"/&gt;
                            &lt;/tns2:IPClient&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$post1/item/tns:inputDetokenizzaXml/tns:IPClient"&gt;
                                &lt;tns2:IPClient&gt;
                                    &lt;xsl:value-of select="$post1/item/tns:inputDetokenizzaXml/tns:IPClient"/&gt;
                                &lt;/tns2:IPClient&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($DatiCF/Record/COGNOMERAGIONESOCIALE)&gt;0"&gt;
                            &lt;xsl:if test="$DatiCF/Record[1]/COGNOMERAGIONESOCIALE"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$DatiCF/Record[1]/COGNOMERAGIONESOCIALE"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns2:RequestDecode_token&gt;
            &lt;/Input&gt;
        &lt;/ns:Decode_token_NOWSecoloRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:ns=&quot;http://www.tibco.com/NOW_SECOLO/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiCF&quot;/>&#xa;    &lt;xsl:param name=&quot;ReferentiPvm&quot;/>&#xa;    &lt;xsl:template name=&quot;DetokenizzaCF-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RequestDecode_token>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:codOloAgcom&quot;>&#xa;                &lt;tns2:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:codOloAgcom&quot;/>&#xa;                &lt;/tns2:CodificaOLOAGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns:codOrdineOlo&quot;>&#xa;                &lt;tns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns:codOrdineOlo&quot;/>&#xa;                &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:Funzione>&#xa;                &lt;xsl:value-of select=&quot;'VISGUIO'&quot;/>&#xa;            &lt;/tns2:Funzione>&#xa;            &lt;tns2:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat($post1.item/tns:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns2:ChiaveRiferimento>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post1.item/tns:operatore) = 0&quot;>&#xa;                    &lt;tns2:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:Operatore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:operatore&quot;>&#xa;                        &lt;tns2:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:operatore&quot;/>&#xa;                        &lt;/tns2:Operatore>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post1.item/tns:IPClient) = 0&quot;>&#xa;                    &lt;tns2:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns2:IPClient>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:IPClient&quot;>&#xa;                        &lt;tns2:IPClient>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:IPClient&quot;/>&#xa;                        &lt;/tns2:IPClient>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DatiCF/Record/COGNOMERAGIONESOCIALE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$DatiCF/Record[1]/COGNOMERAGIONESOCIALE&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$DatiCF/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:RequestDecode_token>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="TracciatoXmlToDetokenizzaCF"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeToCFTracciato"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:param name=&quot;DetokenizzaCF&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiCF&quot;/>&#xa;    &lt;xsl:param name=&quot;ReferentiPvm&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoXml&quot;/>&#xa;    &lt;xsl:template name=&quot;ClienteFinale&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($post1/item/tns:inputDetokenizzaXml/tns:flagDetok)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagDetok = 'Y' and $DetokenizzaCF/Output/tns2:ResponseDecode_token/tns2:ESITO !='KO'&quot;>&#xa;                &lt;tns:clienteFinale>&#xa;                    &lt;xsl:if test=&quot;$DetokenizzaCF/Output/tns2:ResponseDecode_token/tns2:Nome&quot;>&#xa;                        &lt;tns:nome>&#xa;                            &lt;xsl:value-of select=&quot;$DetokenizzaCF/Output/tns2:ResponseDecode_token/tns2:Nome&quot;/>&#xa;                        &lt;/tns:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DetokenizzaCF/Output/tns2:ResponseDecode_token/tns2:CognomeRagioneSociale&quot;>&#xa;                        &lt;tns:cognome>&#xa;                            &lt;xsl:value-of select=&quot;$DetokenizzaCF/Output/tns2:ResponseDecode_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/tns:cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DetokenizzaCF/Output/tns2:ResponseDecode_token/tns2:CodiceFiscale&quot;>&#xa;                        &lt;tns:CF>&#xa;                            &lt;xsl:value-of select=&quot;$DetokenizzaCF/Output/tns2:ResponseDecode_token/tns2:CodiceFiscale&quot;/>&#xa;                        &lt;/tns:CF>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DetokenizzaCF/Output/tns2:ResponseDecode_token/tns2:PIVA&quot;>&#xa;                        &lt;tns:PIVA>&#xa;                            &lt;xsl:value-of select=&quot;$DetokenizzaCF/Output/tns2:ResponseDecode_token/tns2:PIVA&quot;/>&#xa;                        &lt;/tns:PIVA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:clienteFinale>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($DatiCF/Record/COGNOMERAGIONESOCIALE)>0 and string-length($post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia = 'Y' and not(starts-with($DatiCF/Record[1]/COGNOMERAGIONESOCIALE, 'dk'))&quot;>&#xa;                &lt;tns:clienteFinale>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&#xa;                        &lt;tns:nome>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&#xa;                        &lt;/tns:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&#xa;                        &lt;tns:cognome>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&#xa;                        &lt;/tns:cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&#xa;                        &lt;tns:CF>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&#xa;                        &lt;/tns:CF>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&#xa;                        &lt;tns:PIVA>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&#xa;                        &lt;/tns:PIVA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:clienteFinale>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($DatiCF/Record/COGNOMERAGIONESOCIALE)=0 and string-length($post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia)>0 and $post1/item/tns:inputDetokenizzaXml/tns:flagTokFittizia = 'Y' and not(starts-with($ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE, 'dk'))&quot;>&#xa;                &lt;tns:clienteFinale>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&#xa;                        &lt;tns:nome>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&#xa;                        &lt;/tns:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&#xa;                        &lt;tns:cognome>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&#xa;                        &lt;/tns:cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&#xa;                        &lt;tns:CF>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&#xa;                        &lt;/tns:CF>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;>&#xa;                        &lt;tns:PIVA>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns:inputDetokenizzaXml/tns:pattern&quot;/>&#xa;                        &lt;/tns:PIVA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:clienteFinale>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($DatiCF/Record/COGNOMERAGIONESOCIALE)>0&quot;>&#xa;                        &lt;tns:clienteFinale>&#xa;                            &lt;xsl:if test=&quot;$DatiCF/Record[1]/NOME&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;$DatiCF/Record[1]/NOME&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$DatiCF/Record[1]/COGNOMERAGIONESOCIALE&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$DatiCF/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$DatiCF/Record[1]/CF&quot;>&#xa;                                &lt;tns:CF>&#xa;                                    &lt;xsl:value-of select=&quot;$DatiCF/Record[1]/CF&quot;/>&#xa;                                &lt;/tns:CF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$DatiCF/Record[1]/PIVA&quot;>&#xa;                                &lt;tns:PIVA>&#xa;                                    &lt;xsl:value-of select=&quot;$DatiCF/Record[1]/PIVA&quot;/>&#xa;                                &lt;/tns:PIVA>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:clienteFinale>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:clienteFinale>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE,'dk')&quot;>&#xa;                                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;>&#xa;                                        &lt;tns:nome>&#xa;                                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;/>&#xa;                                        &lt;/tns:nome>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='NOMEREFERENTE' and DESCR='DATI CLIENTE']/VALORE&quot;>&#xa;                                        &lt;tns:nome>&#xa;                                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='NOMEREFERENTE' and DESCR='DATI CLIENTE']/VALORE&quot;/>&#xa;                                        &lt;/tns:nome>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE,'dk')&quot;>&#xa;                                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;>&#xa;                                        &lt;tns:CF>&#xa;                                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;/>&#xa;                                        &lt;/tns:CF>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='CF' and DESCR='DATI CLIENTE']/VALORE&quot;>&#xa;                                        &lt;tns:CF>&#xa;                                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='CF' and DESCR='DATI CLIENTE']/VALORE&quot;/>&#xa;                                        &lt;/tns:CF>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE,'dk')&quot;>&#xa;                                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;>&#xa;                                        &lt;tns:PIVA>&#xa;                                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;/>&#xa;                                        &lt;/tns:PIVA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($TracciatoXml/Record[1]/CONTENUTO_XML_OLO)>1&quot;>&#xa;                                            &lt;tns:PIVA>&#xa;                                                &lt;xsl:value-of select=&quot;substring-before(substring-after($TracciatoXml/Record[1]/CONTENUTO_XML_OLO, 'PIVA>'),'&amp;lt;')&quot;/>&#xa;                                            &lt;/tns:PIVA>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:PIVA>&#xa;                                                &lt;xsl:value-of select=&quot;substring-before(substring-after($TracciatoXml/Record[1]/CONTENUTOXML, 'PIVA>'),'&amp;lt;')&quot;/>&#xa;                                            &lt;/tns:PIVA>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns:clienteFinale>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
