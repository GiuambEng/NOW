                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ReferentiOrdine&quot;/>&lt;xsl:param name=&quot;post1&quot;/>&lt;xsl:param name=&quot;ExtractRefRichiesta&quot;/>&lt;xsl:template name=&quot;ListaReferentiCiclo&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$post1/item/tns:inputDetokenizzaXml/tns:lavorazione = ('RIMODULAZIONEDAD','INTERRUZIONESOSPENSIONE')&quot;>&lt;tns:listaReferente>&lt;tns:datiSensibili>&lt;xsl:if test=&quot;$ExtractRefRichiesta/tns:progressivo&quot;>&lt;tns:progressivo>&lt;xsl:value-of select=&quot;$ExtractRefRichiesta/tns:progressivo&quot;/>&lt;/tns:progressivo>&lt;/xsl:if>&lt;xsl:if test=&quot;$ExtractRefRichiesta/tns:qualifica&quot;>&lt;tns:qualifica>&lt;xsl:value-of select=&quot;$ExtractRefRichiesta/tns:qualifica&quot;/>&lt;/tns:qualifica>&lt;/xsl:if>&lt;xsl:if test=&quot;$ExtractRefRichiesta/tns:nome&quot;>&lt;tns:nome>&lt;xsl:value-of select=&quot;$ExtractRefRichiesta/tns:nome&quot;/>&lt;/tns:nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$ExtractRefRichiesta/tns:cognome&quot;>&lt;tns:cognome>&lt;xsl:value-of select=&quot;$ExtractRefRichiesta/tns:cognome&quot;/>&lt;/tns:cognome>&lt;/xsl:if>&lt;xsl:if test=&quot;$ExtractRefRichiesta/tns:telefono&quot;>&lt;tns:telefono>&lt;xsl:value-of select=&quot;$ExtractRefRichiesta/tns:telefono&quot;/>&lt;/tns:telefono>&lt;/xsl:if>&lt;xsl:if test=&quot;$ExtractRefRichiesta/tns:mobile&quot;>&lt;tns:mobile>&lt;xsl:value-of select=&quot;$ExtractRefRichiesta/tns:mobile&quot;/>&lt;/tns:mobile>&lt;/xsl:if>&lt;xsl:if test=&quot;$ExtractRefRichiesta/tns:email&quot;>&lt;tns:email>&lt;xsl:value-of select=&quot;$ExtractRefRichiesta/tns:email&quot;/>&lt;/tns:email>&lt;/xsl:if>&lt;/tns:datiSensibili>&lt;/tns:listaReferente>&lt;/xsl:when>&lt;xsl:when test=&