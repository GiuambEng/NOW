               &lt;xsl:if test=&quot;ns1:NomeReferente&quot;>&#xa;                                                                    &lt;ns1:NomeReferente>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:NomeReferente&quot;/>&#xa;                                                                    &lt;/ns1:NomeReferente>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:TelefonoFissoReferente&quot;>&#xa;                                                                    &lt;ns1:TelefonoFissoReferente>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:TelefonoFissoReferente&quot;/>&#xa;                                                                    &lt;/ns1:TelefonoFissoReferente>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:TelefonoMobileReferente&quot;>&#xa;                                                                    &lt;ns1:TelefonoMobileReferente>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:TelefonoMobileReferente&quot;/>&#xa;                                                                    &lt;/ns1:TelefonoMobileReferente>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/ns1:ReferenteOLOperProblematicheOn-field>&#xa;                                                        &lt;/xsl:for-each>&#xa;                                                        &lt;xsl:if test=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:GestioneProdotto&quot;>&#xa;                                                            &lt;ns1:GestioneProdotto>&#xa;                                                                &lt;xsl:value-of select=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:GestioneProdotto&quot;/>&#xa;                                                            &lt;/ns1:GestioneProdotto>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns1:LineaPOTS>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;exists($XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaISDN)&quot;>&#xa;                                                    &lt;ns1:LineaISDN>&#xa;                                                        &lt;xsl:for-each select=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaISDN/ns1:DatiSede&quot;>&#xa;                                                            &lt;ns1:DatiSede>&#xa;                                                                &lt;xsl:if test=&quot;ns1:ParticellaToponomastica&quot;>&#xa;                                                                    &lt;ns1:ParticellaToponomastica>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:ParticellaToponomastica&quot;/>&#xa;                                                                    &lt;/ns1:ParticellaToponomastica>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Via&quot;>&#xa;                                                                    &lt;ns1:Via>&#xa;                                                                        &lt;xsl:v