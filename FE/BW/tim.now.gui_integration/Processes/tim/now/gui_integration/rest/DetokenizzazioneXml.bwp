                                    tibex:xpdlId="88611270-779f-47cf-8346-f14c591ffcf0" variable="Reply1-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20201202172736PLT" xmlns:tns="http://www.example.org/DetokenizzazioneXml" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails1"/&gt;
    &lt;xsl:template name="Reply1-input" match="/"&gt;
        &lt;tns2:postResponse&gt;
            &lt;item&gt;
                &lt;tns:outputDetokenizzazioneXml&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
                            &lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;
                        &lt;/tns:severity&gt;
                        &lt;tns:code&gt;
                            &lt;xsl:value-of select="$FaultDetails1/MsgCode"/&gt;
                        &lt;/tns:code&gt;
                        &lt;tns:details&gt;
                            &lt;xsl:value-of select="$FaultDetails1/Msg"/&gt;
                        &lt;/tns:details&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:outputDetokenizzazioneXml&gt;
            &lt;/item&gt;
        &lt;/tns2:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20201202172736PLT&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:outputDetokenizzazioneXml>&#xa;            &lt;tns:result>&#xa;                &lt;tns:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                &lt;/tns:severity>&#xa;                &lt;tns:code>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&#xa;                &lt;/tns:code>&#xa;                &lt;tns:details>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails1/Msg&quot;/>&#xa;                &lt;/tns:details>&#xa;            &lt;/tns:result>&#xa;        &lt;/tns:outputDetokenizzazioneXml>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
