t;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:tokenReferenti[$index]/tns:cognome&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($referenteDesospensione/tns:tokenFisso)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$referenteDesospensione/tns:tokenFisso&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$referenteDesospensione/tns:tokenFisso&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($referenteDesospensione/tns:tokenMobile)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$referenteDesospensione/tns:tokenMobile&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$referenteDesospensione/tns:tokenMobile&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($referenteDesospensione/tns:cognome)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$referenteDesospensione/tns:cognome&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$referenteDesospensione/tns:cognome&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:tokenReferenti[$index]/tns:tokenMobile&quot;>&#xa;                        &lt;tns2:Token>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:tokenReferenti[$index]/tns:tokenMobile&quot;/>&#xa;                        &lt;/tns2:Token>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:RequestDecode_token>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
