                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ClienteFinale&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaReferenti&quot;/>&#xa;    &lt;xsl:param name=&quot;XmlXSDL&quot;/>&#xa;    &lt;xsl:template name=&quot;XDSL&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:Richiesta>&#xa;            &lt;xsl:copy-of select=&quot;$XmlXSDL/ns1:Testata&quot;/>&#xa;            &lt;ns1:TipoRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione)&quot;>&#xa;                        &lt;ns1:Attivazione>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat)&quot;>&#xa;                                    &lt;ns1:BitstreamATMAsimmetricoFlat>&#xa;                                        &lt;ns1:Accesso>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS)&quot;>&#xa;                                                    &lt;ns1:LineaPOTS>&#xa;                                                        &lt;xsl:for-each select=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:DatiSede&quot;>&#xa;                                                            &lt;ns1:DatiSede>&#xa;                                                                &lt;xsl:if test=&quot;ns1:ParticellaToponomastica&quot;>&#xa;                                                                    &lt;ns1:ParticellaToponomastica>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:ParticellaToponomastica&quot;/>&#xa;                                                                    &lt;/ns1:ParticellaToponomastica>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Via&quot;>&#xa;                                                                    &lt;ns1:Via>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:Via&quot;/>&#xa;                                                                    &lt;/ns1:Via>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Civico&quot;>&#xa;                                                                    &lt;ns1:Civico>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:Civico&quot;/>&#xa;                                                                    &lt;/ns1:Civico>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Localita&quot;>&#xa;                                                                    &lt;ns1:Localita>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:Localita&quot;/>&#xa;                                                                    &lt;/ns1:Localita>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:CAP&quot;>&#xa;                                                                    &lt;ns1:CAP>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:CAP&quot;/>&#xa;                                                                    &lt;/ns1:CAP>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Complesso&quot;>&#xa;                                                                    &lt;ns1:Complesso>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:Complesso&quot;/>&#xa;                                                                    &lt;/ns1:Complesso>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Scala&quot;>&#xa;                                                                    &lt;ns1:Scala>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:Scala&quot;/>&#xa;                                                                    &lt;/ns1:Scala>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Piano&quot;>&#xa;                                                                    &lt;ns1:Piano>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:Piano&quot;/>&#xa;                                                                    &lt;/ns1:Piano>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Interno&quot;>&#xa;                                                                    &lt;ns1:Interno>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:Interno&quot;/>&#xa;                                                                    &lt;/ns1:Interno>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/ns1:DatiSede>&#xa;                                                        &lt;/xsl:for-each>&#xa;                                                        &lt;xsl:for-each select=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:ClienteFinale&quot;>&#xa;                                                            &lt;ns1:ClienteFinale>&#xa;                                                                &lt;ns1:CognomeRagSoc>&#xa;                                                                    &lt;xsl:value-of select=&quot;$ClienteFinale/tns:cognome&quot;/>&#xa;                                                                &lt;/ns1:CognomeRagSoc>&#xa;                                                                &lt;xsl:if test=&quot;$ClienteFinale/tns:nome&quot;>&#xa;                                                                    &lt;ns1:Nome>&#xa;                                                                        &lt;xsl:value-of select=&quot;$ClienteFinale/tns:nome&quot;/>&#xa;                                                                    &lt;/ns1:Nome>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;xsl:choose>&#xa;                                                                    &lt;xsl:when test=&quot;exists(ns1:CF)&quot;>&#xa;                                                                        &lt;ns1:CF>&#xa;                                                                            &lt;xsl:value-of select=&quot;$ClienteFinale/tns:CF&quot;/>&#xa;                                                                        &lt;/ns1:CF>&#xa;                                                                    &lt;/xsl:when>&#xa;                                                                    &lt;xsl:otherwise>&#xa;                                                                        &lt;ns1:PIVA>&#xa;                                                                            &lt;xsl:value-of select=&quot;$ClienteFinale/tns:PIVA&quot;/>&#xa;                                                                        &lt;/ns1:PIVA>&#xa;                                                                    &lt;/xsl:otherwise>&#xa;                                                                &lt;/xsl:choose>&#xa;                                                            &lt;/ns1:ClienteFinale>&#xa;                                                        &lt;/xsl:for-each>&#xa;                                                        &lt;xsl:for-each select=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:Modem&quot;>&#xa;                                                            &lt;ns1:Modem>&#xa;                                                                &lt;ns1:Interfaccia>&#xa;                                                                    &lt;xsl:value-of select=&quot;ns1:Interfaccia&quot;/>&#xa;                                                                &lt;/ns1:Interfaccia>&#xa;                                                                &lt;xsl:if test=&quot;ns1:Codice&quot;>&#xa;                                                                    &lt;ns1:Codice>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns1:Codice&quot;/>&#xa;                                                                    &lt;/ns1:Codice>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/ns1:Modem>&#xa;                                                        &lt;/xsl:for-each>&#xa;                                                        &lt;xsl:if test=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:SlaProvisioning&quot;>&#xa;                                                            &lt;ns1:SlaProvisioning>&#xa;                                                                &lt;xsl:value-of select=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:SlaProvisioning&quot;/>&#xa;                                                            &lt;/ns1:SlaProvisioning>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;ns1:SlaAssurance>&#xa;                                                            &lt;xsl:value-of select=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:SlaAssurance&quot;/>&#xa;                                                        &lt;/ns1:SlaAssurance>&#xa;                                                        &lt;xsl:if test=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:CodiceQualita&quot;>&#xa;                                                            &lt;ns1:CodiceQualita>&#xa;                                                                &lt;xsl:value-of select=&quot;$XmlXSDL/ns1:TipoRichiesta/ns1:Attivazione/ns1:BitstreamATMAsimmetricoFlat/ns1:Accesso/ns1:LineaPOTS/ns1:CodiceQualita&quot;/>&#xa;                                                            &lt;/ns1:CodiceQualita>&#xa;                                                        &lt;/