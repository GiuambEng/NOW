                        &lt;/tns:severity&gt;
                        &lt;tns:code&gt;
                            &lt;xsl:value-of select="'OK'"/&gt;
                        &lt;/tns:code&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:outputDetokenizzazioneXml&gt;
            &lt;/item&gt;
        &lt;/tns2:postResponse1&gt;
    &lt;/xsl:template&gt;
