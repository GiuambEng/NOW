                                    <bpws:while name="while" tibex:counterName="index">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(($index&lt;=count($post/item/ns2:inputDetokenizzazioneXml/ns2:tokenReferenti/ns2:id)) and ($esitoOk = true())) or ($boolRichiesta = true())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(($index<=count($post.item/ns2:tokenReferenti/ns2:id)) and ($esitoOk = true())) or ($boolRichiesta = true())]]></bpws:condition>
                                    <bpws:flow name="flow3">
