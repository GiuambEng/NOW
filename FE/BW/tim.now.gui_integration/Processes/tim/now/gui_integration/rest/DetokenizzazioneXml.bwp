                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tibco.com/NOW_SECOLO/" xmlns:tns="http://www.example.org/DetokenizzazioneXml" xmlns:tns2="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="referenteDesospensione"/&gt;
    &lt;xsl:template name="Decode_token_NOWSecolo-input" match="/"&gt;
        &lt;tns3:Decode_token_NOWSecoloRequest&gt;
            &lt;Input&gt;
                &lt;tns2:RequestDecode_token&gt;
                    &lt;xsl:if test="$post/item/tns:inputDetokenizzazioneXml/tns:codOloAgcom"&gt;
                        &lt;tns2:CodificaOLOAGCOM&gt;
                            &lt;xsl:value-of select="$post/item/tns:inputDetokenizzazioneXml/tns:codOloAgcom"/&gt;
                        &lt;/tns2:CodificaOLOAGCOM&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$post/item/tns:inputDetokenizzazioneXml/tns:codOrdineOlo"&gt;
                        &lt;tns2:CodiceOrdineOLO&gt;
                            &lt;xsl:value-of select="$post/item/tns:inputDetokenizzazioneXml/tns:codOrdineOlo"/&gt;
                        &lt;/tns2:CodiceOrdineOLO&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns2:Funzione&gt;
                        &lt;xsl:value-of select="&amp;quot;VISGUIO&amp;quot;"/&gt;
                    &lt;/tns2:Funzione&gt;
                    &lt;tns2:ChiaveRiferimento&gt;
                        &lt;xsl:value-of select="concat($post/item/tns:inputDetokenizzazioneXml/tns:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))"/&gt;
                    &lt;/tns2:ChiaveRiferimento&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($post/item/tns:inputDetokenizzazioneXml/tns:operatore) = 0"&gt;
                            &lt;tns2:Operatore&gt;
                                &lt;xsl:value-of select="''"/&gt;
                            &lt;/tns2:Operatore&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$post/item/tns:inputDetokenizzazioneXml/tns:operatore"&gt;
                                &lt;tns2:Operatore&gt;
                                    &lt;xsl:value-of select="$post/item/tns:inputDetokenizzazioneXml/tns:operatore"/&gt;
                                &lt;/tns2:Operatore&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($post/item/tns:inputDetokenizzazioneXml/tns:IPClient) = 0"&gt;
                            &lt;tns2:IPClient&gt;
                                &lt;xsl:value-of select="''"/&gt;
                            &lt;/tns2:IPClient&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$post/item/tns:inputDetokenizzazioneXml/tns:IPClient"&gt;
                                &lt;tns2:IPClient&gt;
                                    &lt;xsl:value-of select="$post/item/tns:inputDetokenizzazioneXml/tns:IPClient"/&gt;
                                &lt;/tns2:IPClient&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($post/item/tns:inputDetokenizzazioneXml/tns:tokenReferenti[$index]/tns:tokenFisso)&gt;0"&gt;
                            &lt;xsl:if test="$post/item/tns:inputDetokenizzazioneXml/tns:tokenReferenti[$index]/tns:tokenFisso"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$post/item/tns:inputDetokenizzazioneXml/tns:tokenReferenti[$index]/tns:tokenFisso"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="string-length($post/item/tns:inputDetokenizzazioneXml/tns:tokenReferenti[$index]/tns:cognome)&gt;0"&gt;
                            &lt;xsl:if test="$post/item/tns:inputDetokenizzazioneXml/tns:tokenReferenti[$index]/tns:cognome"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$post/item/tns:inputDetokenizzazioneXml/tns:tokenReferenti[$index]/tns:cognome"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="string-length($referenteDesospensione/tns:tokenFisso)&gt;0"&gt;
                            &lt;xsl:if test="$referenteDesospensione/tns:tokenFisso"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$referenteDesospensione/tns:tokenFisso"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="string-length($referenteDesospensione/tns:tokenMobile)&gt;0"&gt;
                            &lt;xsl:if test="$referenteDesospensione/tns:tokenMobile"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$referenteDesospensione/tns:tokenMobile"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="string-length($referenteDesospensione/tns:cognome)&gt;0"&gt;
                            &lt;xsl:if test="$referenteDesospensione/tns:cognome"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$referenteDesospensione/tns:cognome"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$post/item/tns:inputDetokenizzazioneXml/tns:tokenReferenti[$index]/tns:tokenMobile"&gt;
                                &lt;tns2:Token&gt;
                                    &lt;xsl:value-of select="$post/item/tns:inputDetokenizzazioneXml/tns:tokenReferenti[$index]/tns:tokenMobile"/&gt;
                                &lt;/tns2:Token&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns2:RequestDecode_token&gt;
            &lt;/Input&gt;
        &lt;/tns3:Decode_token_NOWSecoloRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/NOW_SECOLO/&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;referenteDesospensione&quot;/>&#xa;    &lt;xsl:template name=&quot;Decode_token_NOWSecolo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RequestDecode_token>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codOloAgcom&quot;>&#xa;                &lt;tns2:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codOloAgcom&quot;/>&#xa;                &lt;/tns2:CodificaOLOAGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns:codOrdineOlo&quot;>&#xa;                &lt;tns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns:codOrdineOlo&quot;/>&#xa;                &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:Funzione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VISGUIO&amp;quot;&quot;/>&#xa;            &lt;/tns2:Funzione>&#xa;            &lt;tns2:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat($post.item/tns:codOrdineOlo,'&amp;amp;',xsd:string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns2:ChiaveRiferimento>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns:operatore) = 0&quot;>&#xa;                    &lt;tns2:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;''