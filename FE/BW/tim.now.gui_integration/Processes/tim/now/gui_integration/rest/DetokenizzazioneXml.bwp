                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/DetokenizzazioneXml&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:param name=&quot;DetokenizzaCF.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiCF&quot;/>&#xa;    &lt;xsl:param name=&quot;ReferentiPvm&quot;/>&#xa;    &lt;xsl:param name=&quot;TracciatoXml&quot;/>&#xa;    &lt;xsl:template name=&quot;ClienteFinale&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($post1.item/tns:flagDetok)>0 and $post1.item/tns:flagDetok = 'Y' and $DetokenizzaCF.Output/tns2:ESITO !='KO'&quot;>&#xa;                &lt;tns:clienteFinale>&#xa;                    &lt;xsl:if test=&quot;$DetokenizzaCF.Output/tns2:Nome&quot;>&#xa;                        &lt;tns:nome>&#xa;                            &lt;xsl:value-of select=&quot;$DetokenizzaCF.Output/tns2:Nome&quot;/>&#xa;                        &lt;/tns:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DetokenizzaCF.Output/tns2:CognomeRagioneSociale&quot;>&#xa;                        &lt;tns:cognome>&#xa;                            &lt;xsl:value-of select=&quot;$DetokenizzaCF.Output/tns2:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/tns:cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DetokenizzaCF.Output/tns2:CodiceFiscale&quot;>&#xa;                        &lt;tns:CF>&#xa;                            &lt;xsl:value-of select=&quot;$DetokenizzaCF.Output/tns2:CodiceFiscale&quot;/>&#xa;                        &lt;/tns:CF>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DetokenizzaCF.Output/tns2:PIVA&quot;>&#xa;                        &lt;tns:PIVA>&#xa;                            &lt;xsl:value-of select=&quot;$DetokenizzaCF.Output/tns2:PIVA&quot;/>&#xa;                        &lt;/tns:PIVA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:clienteFinale>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($DatiCF/Record/COGNOMERAGIONESOCIALE)>0 and string-length($post1.item/tns:flagTokFittizia)>0 and $post1.item/tns:flagTokFittizia = 'Y' and not(starts-with($DatiCF/Record[1]/COGNOMERAGIONESOCIALE, 'dk'))&quot;>&#xa;                &lt;tns:clienteFinale>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                        &lt;tns:nome>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                        &lt;/tns:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                        &lt;tns:cognome>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                        &lt;/tns:cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                        &lt;tns:CF>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                        &lt;/tns:CF>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                        &lt;tns:PIVA>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                        &lt;/tns:PIVA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:clienteFinale>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($DatiCF/Record/COGNOMERAGIONESOCIALE)=0 and string-length($post1.item/tns:flagTokFittizia)>0 and $post1.item/tns:flagTokFittizia = 'Y' and not(starts-with($ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE, 'dk'))&quot;>&#xa;                &lt;tns:clienteFinale>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                        &lt;tns:nome>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                        &lt;/tns:nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                        &lt;tns:cognome>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                        &lt;/tns:cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                        &lt;tns:CF>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                        &lt;/tns:CF>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns:pattern&quot;>&#xa;                        &lt;tns:PIVA>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns:pattern&quot;/>&#xa;                        &lt;/tns:PIVA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:clienteFinale>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($DatiCF/Record/COGNOMERAGIONESOCIALE)>0&quot;>&#xa;                        &lt;tns:clienteFinale>&#xa;                            &lt;xsl:if test=&quot;$DatiCF/Record[1]/NOME&quot;>&#xa;                                &lt;tns:nome>&#xa;                                    &lt;xsl:value-of select=&quot;$DatiCF/Record[1]/NOME&quot;/>&#xa;                                &lt;/tns:nome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$DatiCF/Record[1]/COGNOMERAGIONESOCIALE&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$DatiCF/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$DatiCF/Record[1]/CF&quot;>&#xa;                                &lt;tns:CF>&#xa;                                    &lt;xsl:value-of select=&quot;$DatiCF/Record[1]/CF&quot;/>&#xa;                                &lt;/tns:CF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$DatiCF/Record[1]/PIVA&quot;>&#xa;                                &lt;tns:PIVA>&#xa;                                    &lt;xsl:value-of select=&quot;$DatiCF/Record[1]/PIVA&quot;/>&#xa;                                &lt;/tns:PIVA>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:clienteFinale>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:clienteFinale>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE,'dk')&quot;>&#xa;                                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;>&#xa;                                        &lt;tns:nome>&#xa;                                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;/>&#xa;                                        &lt;/tns:nome>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='NOMEREFERENTE' and DESCR='DATI CLIENTE']/VALORE&quot;>&#xa;                                        &lt;tns:nome>&#xa;                                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='NOMEREFERENTE' and DESCR='DATI CLIENTE']/VALORE&quot;/>&#xa;                                        &lt;/tns:nome>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;>&#xa;                                &lt;tns:cognome>&#xa;                                    &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;/>&#xa;                                &lt;/tns:cognome>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;starts-with($ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE,'dk')&quot;>&#xa;                                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;>&#xa;                                        &lt;tns:CF>&#xa;                                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='COGNOMERAGSOC']/VALORE&quot;/>&#xa;                                        &lt;/tns:CF>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$ReferentiPvm/Record[NOME='CF' and DESCR='DATI CLIENTE']/VALORE&quot;>&#xa;                                        &lt;tns:CF>&#xa;                                            &lt;xsl:value-of select=&quot;$ReferentiPvm/Record[NOME='CF' and DESCR='DATI CLIENTE']/VALORE&quot;/>&#xa;                                        &lt;/tns:CF>&#xa;                                    &l