                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns20=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8d4ed130-3c3d-41e6-82a8-dea84273e9fe+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160421153118PLT/ConceptSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:param name=&quot;RecuperoCodOrdTIScartato&quot;/>&lt;xsl:template name=&quot;RecuperoSedeCliente-input&quot; match=&quot;/&quot;>&lt;tns20:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$get1/parameters/tns1:VisualizzaOrdini-DataOrdiniGetParameters/Campo='CODICEORDINETI'&quot;>&lt;CodOrdine>&lt;xsl:value-of select=&quot;$get1/parameters/tns1:VisualizzaOrdini-DataOrdiniGetParameters/Valore&quot;/>&lt;/CodOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CodOrdine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperoCodOrdTIScartato/Record[1]/CODICEORDINETI)&quot;>&lt;xsl:value-of select=&quot;$RecuperoCodOrdTIScartato/Record[1]/CODICEORDINETI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodOrdine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns20:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
