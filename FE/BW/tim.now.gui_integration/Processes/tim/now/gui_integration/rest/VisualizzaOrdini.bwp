                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$GetIdOfferta/Record[1]/IDOFFERTA=('7','41','11','12','13','14','17','18','44','45','15','16')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0"><![CDATA[$GetIdOfferta/Record[1]/IDOFFERTA=('7','41','11','12','13','14','17','18','44','45','15','16')]]></bpws:transitionCondition>
                                    </bpws:source>
