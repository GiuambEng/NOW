                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns21=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+18b59ff1-f83f-4346-bcf6-1b44e80a0047+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160421153118PLT/ConceptSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:template name=&quot;DettOrdine-input&quot; match=&quot;/&quot;>&lt;tns21:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$get1/parameters/tns1:VisualizzaOrdini-DataOrdiniGetParameters/Valore&quot;/>&lt;/IDRICHIESTAOLO>&lt;/tns21:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="DettOrdine-input"
                                    name="DettOrdine"
                                    outputVariable="DettOrdine"
                                    tibex:xpdlId="18b59ff1-f83f-4346-bcf6-1b44e80a0047" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToJDBCQuery"/>
