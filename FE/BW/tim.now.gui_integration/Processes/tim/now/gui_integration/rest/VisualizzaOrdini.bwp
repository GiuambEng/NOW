                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MaxRows&quot;/>&lt;xsl:param name=&quot;SPListaOrdini&quot;/>&lt;xsl:template name=&quot;listaOutput&quot; match=&quot;/&quot;>&lt;tns2:OutputOrdersListNoOlo>&lt;xsl:for-each select=&quot;$SPListaOrdini/outputSet/RESULTSET/APPUSER.LISTAORDINI&quot;>&lt;tns2:OutputListaOrdiniNoOLO>&lt;xsl:if test=&quot;not((string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINEOLO)&quot;>&lt;tns2:codiceordineolo>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns2:codiceordineolo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODIFICAOLONOW/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLONOW/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLONOW)&quot;>&lt;tns2:cod_olo_now>&lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&lt;/tns2:cod_olo_now>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(COD_CAUS_OLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(COD_CAUS_OLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(COD_CAUS_OLO)&quot;>&lt;tns2:cod_causal_olo>&lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&lt;/tns2:cod_causal_olo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(TIPORICHIESTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(TIPORICHIESTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(TIPORICHIESTA)&quot;>&lt;tns2:tipoRichiesta>&lt;xsl:value-of select=&quot;TIPORICHIESTA&quot;/>&lt;/tns2:tipoRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODICEORDINETI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINETI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINETI)&quot;>&lt;tns2:codiceordineti>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns2:codiceordineti>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLOAGCOM)&quot;>&lt;tns2:codfc_olo_agcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns2:codfc_olo_agcom>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CANALERICHIESTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CANALERICHIESTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CANALERICHIESTA)&quot;>&lt;tns2:canalerichiesta>&lt;xsl:value-of select=&quot;CANALERICHIESTA&quot;/>&lt;/tns2:canalerichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(STATO_RICH_OLO_GUI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATO_RICH_OLO_GUI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATO_RICH_OLO_GUI)&quot;>&lt;tns2:statorichiesteolo>&lt;xsl:value-of select=&quot;STATO_RICH_OLO_GUI&quot;/>&lt;/tns2:statorichiesteolo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(STATO_RICH_NOW_GUI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATO_RICH_NOW_GUI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATO_RICH_NOW_GUI)&quot;>&lt;tns2:statorichiestanow>&lt;xsl:value-of select=&quot;STATO_RICH_NOW_GUI&quot;/>&lt;/tns2:statorichiestanow>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDRICHIESTAOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRICHIESTAOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRICHIESTAOLO)&quot;>&lt;tns2:idRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns2:idRichiestaOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(FLAGOPERESPECIALI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(FLAGOPERESPECIALI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(FLAGOPERESPECIALI)&quot;>&lt;tns2:flagOpereSpeciali>&lt;xsl:value-of select=&quot;FLAGOPERESPECIALI&quot;/>&lt;/tns2:flagOpereSpeciali>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDOFFERTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDOFFERTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDOFFERTA)&quot;>&lt;tns2:idOfferta>&lt;xsl:value-of select=&quot;IDOFFERTA&quot;/>&lt;/tns2:idOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(DATAINVIORICHIESTA) and string-length( string(DATAINVIORICHIESTA))>0&quot;>&lt;tns2:dataInvio>&lt;xsl:value-of select=&quot;substring-before( string(DATAINVIORICHIESTA),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns2:dataInvio>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDRISORSA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSA)&quot;>&lt;tns2:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns2:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(LAVORAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(LAVORAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(LAVORAZIONE)&quot;>&lt;tns2:tipoLavorazione>&lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&lt;/tns2:tipoLavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(OFFERTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(OFFERTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(OFFERTA)&quot;>&lt;tns2:offerta>&lt;xsl:value-of select=&quot;OFFERTA&quot;/>&lt;/tns2:offerta>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(FLAGATTESADESOSPOLO) = 0&quot;>&lt;tns2:inAttesaDesospensioneDaOao>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/tns2:inAttesaDesospensioneDaOao>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string(FLAGATTESADESOSPOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(FLAGATTESADESOSPOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(FLAGATTESADESOSPOLO)&quot;>&lt;tns2:inAttesaDesospensioneDaOao>&lt;xsl:value-of select=&quot;FLAGATTESADESOSPOLO&quot;/>&lt;/tns2:inAttesaDesospensioneDaOao>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:OutputListaOrdiniNoOLO>&lt;/xsl:for-each>&lt;tns2:result>&lt;tns2:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns2:severity>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SPListaOrdini/outputSet/RESULTSET/APPUSER.LISTAORDINI)&amp;lt;$MaxRows&quot;>&lt;tns2:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns2:code>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:code>&lt;xsl:value-of select=&quot;&amp;quot;LIMIT&amp;quot;&quot;/>&lt;/tns2:code>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:result>&lt;/tns2:OutputOrdersListNoOlo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
