   LEFT OUTER JOIN BDS_1_CASEDATA_DETTAGLIOORDINE DO ON DO.BDS_ID = ADO.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID WHERE DO.BDS_ID=',string($DettaglioOrdine/Record[1]/BDS_ID))&quot;/>&#xa;                        &lt;/tns7:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:Payload>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Output_VisualizzaOrdini:NessunElementoQueryRecAttribDettaglio&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;            &lt;tns7:ActiveLoggerServices>&#xa;                &lt;tns7:Envelope>&#xa;                    &lt;tns7:Identifier>&#xa;                        &lt;tns7:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                        &lt;/tns7:ServiceName>&#xa;                        &lt;tns7:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Operation>&#xa;                        &lt;tns7:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Source>&#xa;                        &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns7:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns7:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get1.httpHeaders/GUI-SID,$get1.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns7:EventID>&#xa;                        &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns7:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns7:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$get1.httpHeaders/GUI-SID,&amp;quot;COMPLETE&amp;quot;)&quot;/>&#xa;                        &lt;/tns7:EventType>&#xa;                        &lt;tns7:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$get1.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns7:trackID>&#xa;                    &lt;/tns7:Identifier>&#xa;                    &lt;tns7:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns7:track_position>&#xa;                    &lt;tns7:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns7:Timestamp>&#xa;                    &lt;tns7:ErrorLog>&#xa;                        &lt;tns7:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns7:TimeStamp>&#xa;                    &lt;/tns7:ErrorLog>&#xa;                &lt;/tns7:Envelope>&#xa;            &lt;/tns7:ActiveLoggerServices>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
