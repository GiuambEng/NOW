                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tim.com/NOW/rest/preventivo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaPreventivoAltreOfferte&quot;/>&#xa;    &lt;xsl:template name=&quot;lista_Preventivo&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($ListaPreventivoAltreOfferte/Record)>0&quot;>&#xa;                &lt;tns26:Output_Preventivo>&#xa;                    &lt;xsl:for-each select=&quot;$ListaPreventivoAltreOfferte/Record&quot;>&#xa;                        &lt;tns26:Lista_Output_Preventivo>&#xa;                            &lt;tns26:dataAccettazioneOao>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_ACCETTAZIONE_OLO),'T')&quot;/>&#xa;                            &lt;/tns26:dataAccettazioneOao>&#xa;                            &lt;tns26:dataPreventivo>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_PREVENTIVO_FORNITA_DA_DTU),'T')&quot;/>&#xa;                            &lt;/tns26:dataPreventivo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_CONTRIBUTO_CLIENTE = &amp;quot;SI&amp;quot;&quot;>&#xa;                                    &lt;tns26:contributoCliente>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:contributoCliente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:contributoCliente>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_CONTRIBUTO_CLIENTE&quot;/>&#xa;                                    &lt;/tns26:contributoCliente>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_OLTRE_PERIMETRO_ABITATO = &amp;quot;SI&amp;quot;&quot;>&#xa;                                    &lt;tns26:opa>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:opa>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:opa>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_OLTRE_PERIMETRO_ABITATO&quot;/>&#xa;                                    &lt;/tns26:opa>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_PERMESSI = &amp;quot;SI&amp;quot;&quot;>&#xa;                                    &lt;tns26:permessi>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:permessi>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:permessi>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_PERMESSI&quot;/>&#xa;                                    &lt;/tns26:permessi>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_TIMEOUT_ACCETTAZIONE =&amp;quot;SI&amp;quot;&quot;>&#xa;                  