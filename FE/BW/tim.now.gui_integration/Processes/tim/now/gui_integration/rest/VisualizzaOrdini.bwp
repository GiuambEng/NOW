                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RD.VALORE AS NUMEROTELEFONICOAGGIUNTIVO&#xa;FROM RICH_OLO_DETT RD&#xa;LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = RD. ID_RICH_OLO &#xa;WHERE ((RD.NOME = 'NUMEROTELEFONICO' and RD.IDTPLG_DATO_RICH IN (15,33)) or (RD.NOME = 'DNAGGIUNTIVO' and RD.IDTPLG_DATO_RICH = 22) or (RD.NOME = 'AGGIUNTIVIISDN' and RD.IDTPLG_DATO_RICH = 1))&#xa;AND R.CODICEORDINETI = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

