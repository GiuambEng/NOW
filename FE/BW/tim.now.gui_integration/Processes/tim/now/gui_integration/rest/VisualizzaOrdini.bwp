                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160421153118PLT/ConceptSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OrdiniData&quot;/>&lt;xsl:param name=&quot;Servizio&quot;/>&lt;xsl:param name=&quot;Referenti&quot;/>&lt;xsl:param name=&quot;DettaglioOrdine&quot;/>&lt;xsl:param name=&quot;RecuperoSedeCliente&quot;/>&lt;xsl:param name=&quot;RecuperoAttributiDettaglioOrdini&quot;/>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:param name=&quot;Profilo&quot;/>&lt;xsl:param name=&quot;NumTelefAgg&quot;/>&lt;xsl:param name=&quot;RecuperoOpRete&quot;/>&lt;xsl:param name=&quot;AnagCausLavManOF&quot;/>&lt;xsl:template name=&quot;ordinidataoutput&quot; match=&quot;/&quot;>&lt;tns2:OutputOrdersData>&lt;xsl:for-each select=&quot;$OrdiniData/Record[1]&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($get1/parameters/tns1:VisualizzaOrdini-DataOrdiniGetParameters/Valore)>0&quot;>&lt;tns2:OutputDatiOrdine>&lt;xsl:variable name=&quot;currOfferta&quot; select=&quot;IDOFFERTA&quot;/>&lt;xsl:if test=&quot;CODICEORDINETI&quot;>&lt;tns2:codiceOrdineTI>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns2:codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns2:codificaOloAgcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns2:codificaOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&lt;tns2:codiceOloNow>&lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&lt;/tns2:codiceOloNow>&lt;/xsl:if>&lt;tns2:idrichiestaolo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns2:idrichiestaolo>&lt;xsl:for-each select=&quot;$Servizio/parametersOutputService/tns3:OutputOrdersService/tns3:OutputServizi&quot;>&lt;tns2:servizi>&lt;xsl:for-each select=&quot;tns3:customizzazione/tns3:OutputVisualizzaCustomizzazione[tns3:AttributoCustomizzazione !='DESCR_BMD']&quot;>&lt;xsl:if test=&quot;tns3:AttributoCustomizzazione !='DATARESTITUZIONEPRODOTTI' or (tns3:AttributoCustomizzazione = 'DATARESTITUZIONEPRODOTTI' and tns3:ValoreCustomizzazione !='01-01-1900')&quot;>&lt;tns2:customizzazione>&lt;xsl:if test=&quot;tns3:AttributoCustomizzazione&quot;>&lt;tns2:AttributoCustomizzazione>&lt;xsl:value-of select=&quot;tns3:AttributoCustomizzazione&quot;/>&lt;/tns2:AttributoCustomizzazione>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;tns3:AttributoCustomizzazione = 'PROFILOBMD'&quot;>&lt;xsl:if test=&quot;current()/..[1]/tns3:OutputVisualizzaCustomizzazione[tns3:AttributoCustomizzazione='DESCR_BMD']/tns3:ValoreCustomizzazione&quot;>&lt;tns2:ValoreCustomizzazione>&lt;xsl:value-of select=&quot;current()/..[1]/tns3:OutputVisualizzaCustomizzazione[tns3:AttributoCustomizzazione='DESCR_BMD']/tns3:ValoreCustomizzazione&quot;/>&lt;/tns2:ValoreCustomizzazione>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;tns3:AttributoCustomizzazione = 'TIPOOFFERTA' and $currOfferta=(70,71,72,73)&quot;>&lt;tns2:ValoreCustomizzazione>&lt;xsl:value-of select=&quot;'MULTICAST'&quot;/>&lt;/tns2:ValoreCustomizzazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns3:ValoreCustomizzazione&quot;>&lt;tns2:ValoreCustomizzazione>&lt;xsl:value-of select=&quot;tns3:ValoreCustomizzazione&quot;/>&lt;/tns2:ValoreCustomizzazione>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns3:ValoreOldCustomizzazione&quot;>&lt;tns2:ValoreOldCustomizzazione>&lt;xsl:value-of select=&quot;tns3:ValoreOldCustomizzazione&quot;/>&lt;/tns2:ValoreOldCustomizzazione>&lt;/xsl:if>&lt;/tns2:customizzazione>&lt;/xsl:if>&lt;/xsl:for-each>&lt;xsl:if test=&quot;tns3:Prodotto&quot;>&lt;tns2:Prodotto>&lt;xsl:value-of select=&quot;tns3:Prodotto&quot;/>&lt;/tns2:Prodotto>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:Azione&quot;>&lt;tns2:Azione>&lt;xsl:value-of select=&quot;tns3:Azione&quot;/>&lt;/tns2:Azione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CodiceTI&quot;>&lt;tns2:CodiceTI>&lt;xsl:value-of select=&quot;tns3:CodiceTI&quot;/>&lt;/tns2:CodiceTI>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(tns3:DAC)>0&quot;>&lt;tns2:DAC>&lt;xsl:value-of select=&quot;substring-before(string(tns3:DAC), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns2:DAC>&lt;/xsl:if>&lt;/tns2:servizi>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$Referenti/Record[TIPOREFERENTEORDINE !='REFERENTEOAOPROGETTISPECIALI']&quot;>&lt;tns2:referenti>&lt;xsl:if test=&quot;NOMEREFERENTE&quot;>&lt;tns2:Nome>&lt;xsl:value-of select=&quot;NOMEREFERENTE&quot;/>&lt;/tns2:Nome>&lt;/xsl:if>&lt;xsl:if test=&quot;COGNOMEREFERENTE&quot;>&lt;tns2:Cognome>&lt;xsl:value-of select=&quot;COGNOMEREFERENTE&quot;/>&lt;/tns2:Cognome>&lt;/xsl:if>&lt;xsl:if test=&quot;TELEFONOFISSOREFERENTE&quot;>&lt;tns2:Telefono>&lt;xsl:value-of select=&quot;TELEFONOFISSOREFERENTE&quot;/>&lt;/tns2:Telefono>&lt;/xsl:if>&lt;xsl:if test=&quot;TELEFONOMOBILEREFERENTE&quot;>&lt;tns2:Cellulare>&lt;xsl:value-of select=&quot;TELEFONOMOBILEREFERENTE&quot;/>&lt;/tns2:Cellulare>&lt;/xsl:if>&lt;xsl:if test=&quot;QUALIFICAREFERENTE&quot;>&lt;tns2:Qualifica>&lt;xsl:value-of select=&quot;QUALIFICAREFERENTE&quot;/>&lt;/tns2:Qualifica>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;TIPOREFERENTEORDINE = 'REFERENTEONFIELD'&quot;>&lt;tns2:onfield>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns2:onfield>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:onfield>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns2:onfield>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;PROGRESSIVOREFERENTE&quot;>&lt;tns2:progressivo>&lt;xsl:value-of select=&quot;PROGRESSIVOREFERENTE&quot;/>&lt;/tns2:progressivo>&lt;/xsl:if>&lt;tns2:dataUltimoAggiornamento>&lt;xsl:value-of select=&quot;substring-before(string(LASTUPDATE), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns2:dataUltimoAggiornamento>&lt;tns2:dataInserimento>&lt;xsl:value-of select=&quot;substring-before(string(CREATED),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns2:dataInserimento>&lt;xsl:if test=&quot;EMAILREFERENTE&quot;>&lt;tns2:email>&lt;xsl:value-of select=&quot;EMAILREFERENTE&quot;/>&lt;/tns2:email>&lt;/xsl:if>&lt;/tns2:referenti>&lt;/xsl:for-each>&lt;tns2:dettaglioordine>&lt;xsl:if test=&quot;$Profilo!=&amp;quot;CRM_OLO&amp;quot;&quot;>&lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/COD_CAUS_NOW_DG&quot;>&lt;tns2:CodiceCausaleNOW>&lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/COD_CAUS_NOW_DG&quot;/>&lt;/tns2:CodiceCausaleNOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/COD_CAUS_OLO&quot;>&lt;tns2:CodiceCausaleOLO>&lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns2:CodiceCausaleOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns2:DescrizioneCausaleOLO>&lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns2:DescrizioneCausaleOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Profilo!=&amp;quot;CRM_OLO&amp;quot;&quot;>&lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/DESCR_CAUS_NOW_DG&quot;>&lt;tns2:DescrizioneCausaleNOW>&lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/DESCR_CAUS_NOW_DG&quot;/>&lt;/tns2:DescrizioneCausaleNOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/TIPOLG_SOTTO_LAVRZ_GUI&quot;>&lt;tns2:Sottolavorazione>&lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/TIPOLG_SOTTO_LAVRZ_GUI&quot;/>&lt;/tns2:Sottolavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/TIPOLG_LAVRZ_GUI&quot;>&lt;tns2:TipoLavorazione>&lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/TIPOLG_LAVRZ_GUI&quot;/>&lt;/tns2:TipoLavorazione>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($DettaglioOrdine/Record/TIPOPACCHETTOORDINE) and string-length($DettaglioOrdine/Record[1]/TIPOPACCHETTO