                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2c02f09d-82c9-41ed-97d0-e909a856c3b0+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;GetIdOfferta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns26:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get3.parameters/tns:id_rich_olo&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns26:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select idofferta &#xa;from bds_1_casedata_richiesta&#xa;where idrichiestaolo = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>
                                    <columnMetadata
                                    columnName="IDOFFERTA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+012176c2-f772-41f7-9e31-7ebae7f814e8+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaConsuntivoAltreOfferte-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns26:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get3/parameters/tns:visualizzaordini-consuntivo1GetParameters/tns:id_rich_olo&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns26:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ListaConsuntivoAltreOfferte-input"
                                    name="ListaConsuntivoAltreOfferte"
                                    outputVariable="ListaConsuntivoAltreOfferte"
                                    tibex:xpdlId="012176c2-f772-41f7-9e31-7ebae7f814e8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GetIdOffertaToListaConsuntivoAltreOfferte"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ListaConsuntivoAltreOfferteToListaConsuntivi"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+012176c2-f772-41f7-9e31-7ebae7f814e8+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaConsuntivoAltreOfferte-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns26:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get3.parameters/tns:id_rich_olo&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns26:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT C.FLAG_CONTRIBUTO_CLIENTE, C.FLAG_OLTRE_PERIMETRO_ABITATO, C.FLAG_PERMESSI, C.IMPORTO_TOT, C.NOTE_PREVENTIVO, &#xa;C.NUMERO_GIORNI_PREVISTO, C.TIMSTP_INSMTO, DC.IMPORTO_ARTICOLO, DC.QTA_ARTICOLO, T.DESCR_ARTICOLO_GUI&#xa;FROM CONSUNTIVO C&#xa;LEFT JOIN DETT_CONSUNTIVO DC ON C.ID_CONSUNTIVO = DC.ID_CONSUNTIVO&#xa;LEFT JOIN TRASCODFC_ARTICOLI_DTU_JPUB T ON DC.COD_ARTICOLO_JPUB = T.COD_ARTICOLO_JPUB&#xa;WHERE ID_RICH_OLO = ?&#xa;AND DC.ID_DETT_CONSUNTIVO = (SELECT MAX(DC.ID_DETT_CONSUNTIVO) FROM DETT_CONSUNTIVO&#xa;WHERE DC.ID_CONSUNTIVO = C.ID_CONSUNTIVO)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>
                                    <columnMetadata
                                    columnName="FLAG_CONTRIBUTO_CLIENTE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_OLTRE_PERIMETRO_ABITATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_PERMESSI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IMPORTO_TOT"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOTE_PREVENTIVO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMERO_GIORNI_PREVISTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IMPORTO_ARTICOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QTA_ARTICOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_ARTICOLO_GUI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="lista_Consuntivo"
                                    name="ListaConsuntivi"
                                    outputVariable="lista_Consuntivo"
                                    tibex:xpdlId="be1800a7-c1a8-4ead-8144-be550d7dd799" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ListaConsuntivoAltreOfferteToListaConsuntivi"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ListaConsuntiviToget_Consuntivo_Output_LogINFO"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tim.com/NOW/rest/consuntivo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaConsuntivoAltreOfferte&quot;/>&#xa;    &lt;xsl:template name=&quot;lista_Consuntivo&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($ListaConsuntivoAltreOfferte/Record)>0&quot;>&#xa;                &lt;tns26:Output_consuntivo>&#xa;                    &lt;xsl:for-each select=&quot;$ListaConsuntivoAltreOfferte/Record&quot;>&#xa;                        &lt;tns26:Lista_Output_consuntivo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_CONTRIBUTO_CLIENTE = &amp;quot;SI&amp;quot;&quot;>&#xa;                                    &lt;tns26:flagContributoCliente>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:flagContributoCliente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:flagContributoCliente>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_CONTRIBUTO_CLIENTE&quot;/>&#xa;                                    &lt;/tns26:flagContributoCliente>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_OLTRE_PERIMETRO_ABITATO = &amp;quot;SI&amp;quot;&quot;>&#xa;                                    &lt;tns26:opa>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:opa>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:opa>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_OLTRE_PERIMETRO_ABITATO&quot;/>&#xa;                                    &lt;/tns26:opa>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_PERMESSI = &amp;quot;SI&amp;quot;&quot;>&#xa;                                    &lt;tns26:permessi>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:permessi>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:permessi>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_PERMESSI&quot;/>&#xa;                                    &lt;/tns26:permessi>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists(IMPORTO_TOT)&quot;>&#xa;                                &lt;tns26:importoTotale>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(IMPORTO_TOT)&quot;/>&#xa;                                &lt;/tns26:importoTotale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOTE_PREVENTIVO&quot;>&#xa;                                &lt;tns26:note>&#xa;                                    &lt;xsl:value-of select=&quot;NOTE_PREVENTIVO&quot;/>&#xa;                                &lt;/tns26:note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(NUMERO_GIORNI_PREVISTO)&quot;>&#xa;                                &lt;tns26:numGiorniPrevisto>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(NUMERO_GIORNI_PREVISTO)&quot;/>&#xa;                                &lt;/tns26:numGiorniPrevisto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns26:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(TIMSTP_INSMTO),'T')&quot;/>&#xa;                            &lt;/tns26:dataInserimento>&#xa;                            &lt;xsl:if test=&quot;DESCR_ARTICOLO_GUI&quot;>&#xa;                                &lt;tns26:descrizioneArticolo>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_ARTICOLO_GUI&quot;/>&#xa;                                &lt;/tns26:descrizioneArticolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(QTA_ARTICOLO)&quot;>&#xa;                                &lt;tns26:importoArticolo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns26:importoArticolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(QTA_ARTICOLO)&quot;>&#xa;                                &lt;tns26:quantitaArticolo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/tns26:quantitaArticolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns26:prezziEspostiIn>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;€&amp;quot;&quot;/>&#xa;                            &lt;/tns26:prezziEspostiIn>&#xa;                        &lt;/tns26:Lista_Output_consuntivo>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns26:result>&#xa;                        &lt;tns26:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns26:severity>&#xa;                        &lt;tns26:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns26:code>&#xa;                    &lt;/tns26:result>&#xa;                &lt;/tns26:Output_consuntivo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns26:Output_consuntivo>&#xa;                    &lt;tns26:result>&#xa;                        &lt;tns26:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns26:severity>&#xa;                        &lt;tns26:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns26:code>&#xa;                        &lt;tns26:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;No record&amp;quot;&quot;/>&#xa;                        &lt;/tns26:details>&#xa;                    &lt;/tns26:result>&#xa;                &lt;/tns26:Output_consuntivo>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="lista_Consuntivo" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
