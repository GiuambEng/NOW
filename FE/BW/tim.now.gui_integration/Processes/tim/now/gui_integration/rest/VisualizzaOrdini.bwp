select=&quot;concat(current()/PARTICELLATOPONOMASTICA, ' ',current()/VIA, ' - Int. ' ,current()/INTERNO)&quot;/>&#xa;                                                                &lt;/tns2:indirizzo>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;tns2:indirizzo>&#xa;                                                                    &lt;xsl:value-of select=&quot;concat(current()/PARTICELLATOPONOMASTICA, ' ',current()/VIA)&quot;/>&#xa;                                                                &lt;/tns2:indirizzo>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                        &lt;xsl:if test=&quot;PIANO&quot;>&#xa;                                                            &lt;tns2:piano>&#xa;                                                                &lt;xsl:value-of select=&quot;PIANO&quot;/>&#xa;                                                            &lt;/tns2:piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;PROVINCIA&quot;>&#xa;                                                            &lt;tns2:provincia>&#xa;                                                                &lt;xsl:value-of select=&quot;PROVINCIA&quot;/>&#xa;                                                            &lt;/tns2:provincia>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;SCALA&quot;>&#xa;                                                            &lt;tns2:scala>&#xa;                                                                &lt;xsl:value-of select=&quot;SCALA&quot;/>&#xa;                                                            &lt;/tns2:scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;COMPLESSO&quot;>&#xa;                                                            &lt;tns2:complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;COMPLESSO&quot;/>&#xa;                                                            &lt;/tns2:complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;CAP&quot;>&#xa;                                                            &lt;tns2:cap>&#xa;                                                                &lt;xsl:value-of select=&quot;CAP&quot;/>&#xa;                                                            &lt;/tns2:cap>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;LOCALITA&quot;>&#xa;                                                            &lt;tns2:localita>&#xa;                                                                &lt;xsl:value-of select=&quot;LOCALITA&quot;/>&#xa;                                                            &lt;/tns2:localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;CODICEISTATCOMUNE&quot;>&#xa;                                                            &lt;tns2:codiceIstatcomune>&#xa;                                                                &lt;xsl:value-of select=&quot;CODICEISTATCOMUNE&quot;/>&#xa;                                                            &lt;/tns2:codiceIstatcomune>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;COMUNE&quot;>&#xa;                                                            &lt;tns2:comune>&#xa;                                                                &lt;xsl:value-of select=&quot;COMUNE&quot;/>&#xa;                                                            &lt;/tns2:comune>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;CODICEISTATPROVINCIA&quot;>&#xa;                                                            &lt;tns2:codiceIstatProvincia>&#xa;                                                                &lt;xsl:value-of select=&quot;CODICEISTATPROVINCIA&quot;/>&#xa;                                                            &lt;/tns2:codiceIstatProvincia>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;TIPOLOGIASEDE&quot;>&#xa;                                                            &lt;tns2:tipologiaSede>&#xa;                                                                &lt;xsl:value-of select=&quot;TIPOLOGIASEDE&quot;/>&#xa;                                                            &lt;/tns2:tipologiaSede>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/tns2:sedeClienteFinale>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns2:sedeClienteFinale>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length(CIVICO) >0 and string-length(INTERNO) >0&quot;>&#xa;                                                        &lt;tns2:indirizzo>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(current()/PARTICELLATOPONOMASTICA, ' ',current()/VIA, ', ',current()/CIVICO, ' - Int. ' ,current()/INTERNO)&quot;/>&#xa;                                                        &lt;/tns2:indirizzo>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;string-length(CIVICO) >0 and string-length(INTERNO) =0&quot;>&#xa;                                                        &lt;tns2:indirizzo>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(current()/PARTICELLATOPONOMASTICA, ' ',current()/VIA, ', ',current()/CIVICO)&quot;/>&#xa;                                                        &lt;/tns2:indirizzo>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;string-length(CIVICO) =0 and string-length(INTERNO) >0&quot;>&#xa;                                                        &lt;tns2:indirizzo>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(current()/PARTICELLATOPONOMASTICA, ' ',current()/VIA, ' - Int. ' ,current()/INTERNO)&quot;/>&#xa;                                                        &lt;/tns2:indirizzo>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;tns2:indirizzo>&#xa;                                                            &lt;xsl:value-of select=&quot;concat(current()/PARTICELLATOPONOMASTICA, ' ',current()/VIA)&quot;/>&#xa;        