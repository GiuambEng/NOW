                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tim.com/NOW/rest/consuntivo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaConsuntivo&quot;/>&#xa;    &lt;xsl:template name=&quot;lista_Consuntivo&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($ListaConsuntivo/Record) > 0&quot;>&#xa;                &lt;tns26:Output_consuntivo>&#xa;                    &lt;xsl:for-each select=&quot;$ListaConsuntivo/Record&quot;>&#xa;                        &lt;tns26:Lista_Output_consuntivo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_CONTRIBUTO_CLIENTE = 'SI'&quot;>&#xa;                                    &lt;tns26:flagContributoCliente>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:flagContributoCliente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:flagContributoCliente>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_CONTRIBUTO_CLIENTE&quot;/>&#xa;                                    &lt;/tns26:flagContributoCliente>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_OLTRE_PERIMETRO_ABITATO = 'SI'&quot;>&#xa;                                    &lt;tns26:opa>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:opa>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:opa>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_OLTRE_PERIMETRO_ABITATO&quot;/>&#xa;                                    &lt;/tns26:opa>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_PERMESSI = 'SI'&quot;>&#xa;                                    &lt;tns26:permessi>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:permessi>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:permessi>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_PERMESSI&quot;/>&#xa;                                    &lt;/tns26:permessi>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists(IMPORTO_TOT)&quot;>&#xa;                                &lt;tns26:importoTotale>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(IMPORTO_TOT)&quot;/>&#xa;                                &lt;/tns26:importoTotale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOTE_PREVENTIVO&quot;>&#xa;                                &lt;tns26:note>&#xa;                                    &lt;xsl:value-of select=&quot;NOTE_PREVENTIVO&quot;/>&#xa;                                &lt;/tns26:note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(NUMERO_GIORNI_PREVISTO)&quot;>&#xa;                                &lt;tns26:numGiorniPrevisto>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(NUMERO_GIORNI_PREVISTO)&quot;/>&#xa;                                &lt;/tns26:numGiorniPrevisto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns26:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(TIMSTP_INSMTO),'T')&quot;/>&#xa;                            &lt;/tns26:dataInserimento>&#xa;                            &lt;tns26:prezziEspostiIn>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;€&amp;quot;&quot;/>&#xa;                            &lt;/tns26:prezziEspostiIn>&#xa;                        &lt;/tns26:Lista_Output_consuntivo>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns26:result>&#xa;                        &lt;tns26:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns26:severity>&#xa;                        &lt;tns26:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns26:code>&#xa;                    &lt;/tns26:result>&#xa;                &lt;/tns26:Output_consuntivo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns26:Output_consuntivo>&#xa;                    &lt;tns26:result>&#xa;                        &lt;tns26:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns26:severity>&#xa;                        &lt;tns26:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns26:code>&#xa;                        &lt;tns26:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;No Record&amp;quot;&quot;/>&#xa;                        &lt;/tns26:details>&#xa;                    &lt;/tns26:result>&#xa;                &lt;/tns26:Output_consuntivo>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
