                                    <bpws:sources>
                                    <bpws:source linkName="DettOrdineToJDBCQuery"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns21=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+18b59ff1-f83f-4346-bcf6-1b44e80a0047+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160421153118PLT/ConceptSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;DettOrdine-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns21:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/Valore&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;        &lt;/tns21:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RIC.NOME, RIC.PROGRS_TIPOLG_DATO_RICH, RIC.VALORE, TIP.DESCR&#xd;&#xa;FROM RICH_OLO_DETT RIC LEFT JOIN TIPOLG_DATO_RICH TIP ON RIC.IDTPLG_DATO_RICH = TIP.IDTPLG_DATO_RICH &#xd;&#xa;WHERE ID_RICH_OLO = ?&#xd;&#xa;ORDER BY RIC.IDTPLG_DATO_RICH, RIC.PROGRS_TIPOLG_DATO_RICH" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <columnMetadata
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROGRS_TIPOLG_DATO_RICH"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="VALORE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160421153118PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DettOrdine&quot;/>&lt;xsl:param name=&quot;get1&quot;/>&lt;xsl:param name=&quot;OrdiniDataIdTichiestaOlo&quot;/>&lt;xsl:param name=&quot;RecNumTelAgg&quot;/>&lt;xsl:param name=&quot;RecuperoAttributi&quot;/>&lt;xsl:template name=&quot;ordinidataoutput&quot; match=&quot;/&quot;>&lt;tns2:OutputOrdersData>&lt;tns2:OutputDatiOrdine>&lt;tns2:idrichiestaolo>&lt;xsl:value-of select=&quot;$get1/parameters/tns1:VisualizzaOrdini-DataOrdiniGetParameters/Valore&quot;/>&lt;/tns2:idrichiestaolo>&lt;xsl:for-each select=&quot;$DettOrdine/Record&quot;>&lt;tns2:codiceordineTInonvalorizzato>&lt;tns2:nome>&lt;xsl:value-of select=&quot;NOME&quot;/>&lt;/tns2:nome>&lt;tns2:progressivo>&lt;xsl:value-of select=&quot;string(xsd:int(PROGRS_TIPOLG_DATO_RICH))&quot;/>&lt;/tns2:progressivo>&lt;xsl:if test=&quot;DESCR&quot;>&lt;tns2:tipologiadatorichiesta>&lt;xsl:value-of select=&quot;DESCR&quot;/>&lt;/tns2:tipologiadatorichiesta>&lt;/xsl:if>&lt;tns2:richiestadettagliovalore>&lt;xsl:value-of select=&quot;VALORE&quot;/>&lt;/tns2:richiestadettagliovalore>&lt;/tns2:codiceordineTInonvalorizzato>&lt;/xsl:for-each>&lt;tns2:richiesta>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEORDINEOLO&quot;>&lt;tns2:codiceOrdineOLO>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEORDINEOLO&quot;/>&lt;/tns2:codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODIFICAOLOAGCOM&quot;>&lt;tns2:codificaOAO>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODIFICAOLOAGCOM&quot;/>&lt;/tns2:codificaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODIFICAOLONOW&quot;>&lt;tns2:codiceOAO>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODIFICAOLONOW&quot;/>&lt;/tns2:codiceOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CANALERICHIESTA&quot;>&lt;tns2:canale>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CANALERICHIESTA&quot;/>&lt;/tns2:canale>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/LAVORAZIONE&quot;>&lt;tns2:tipoLavorazione>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/LAVORAZIONE&quot;/>&lt;/tns2:tipoLavorazione>&lt;/xsl:if>&lt;tns2:dataInvio>&lt;xsl:value-of select=&quot;substring-before(string($OrdiniDataIdTichiestaOlo/Record[1]/DATAINVIORICHIESTA), &amp;quot;T&amp;quot;)&quot;/>&lt;/tns2:dataInvio>&lt;tns2:dataInserimento>&lt;xsl:value-of select=&quot;substring-before(string($OrdiniDataIdTichiestaOlo/Record[1]/CREATED),'T')&quot;/>&lt;/tns2:dataInserimento>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string($OrdiniDataIdTichiestaOlo/Record[1]/LASTUPDATE), &amp;quot;.&amp;quot;)&quot;>&lt;tns2:dataAggiornamento>&lt;xsl:value-of select=&quot;concat(substring-before(string($OrdiniDataIdTichiestaOlo/Record[1]/LASTUPDATE),'.'), '+',substring-after(string($OrdiniDataIdTichiestaOlo/Record[1]/LASTUPDATE), '+'))&quot;/>&lt;/tns2:dataAggiornamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:dataAggiornamento>&lt;xsl:value-of select=&quot;string($OrdiniDataIdTichiestaOlo/Record[1]/LASTUPDATE)&quot;/>&lt;/tns2:dataAggiornamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_NOW_GUI&quot;>&lt;tns2:statoNow>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_NOW_GUI&quot;/>&lt;/tns2:statoNow>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI&quot;>&lt;tns2:statoOao>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI&quot;/>&lt;/tns2:statoOao>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/COD_CAUS_NOW_DG&quot;>&lt;tns2:codiceCausaleNow>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/COD_CAUS_NOW_DG&quot;/>&lt;/tns2:codiceCausaleNow>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/COD_CAUS_OLO&quot;>&lt;tns2:codiceCausaleOao>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns2:codiceCausaleOao>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns2:causaleOao>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns2:causaleOao>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DESCR_CAUS_NOW_DG&quot;>&lt;tns2:causaleNow>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DESCR_CAUS_NOW_DG&quot;/>&lt;/tns2:causaleNow>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDRISORSA&quot;>&lt;tns2:idRisorsa>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDRISORSA&quot;/>&lt;/tns2:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEORDINEOLOPADRE&quot;>&lt;tns2:codiceOrdineOaoPadre>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEORDINEOLOPADRE&quot;/>&lt;/tns2:codiceOrdineOaoPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEPROGETTO&quot;>&lt;tns2:codiceProgetto>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEPROGETTO&quot;/>&lt;/tns2:codiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/NOTE&quot;>&lt;tns2:note>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/NOTE&quot;/>&lt;/tns2:note>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/NOME_FILE&quot;>&lt;tns2:nomeFile>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/NOME_FILE&quot;/>&lt;/tns2:nomeFile>&lt;/xsl:if>&lt;/tns2:richiesta>&lt;xsl:for-each select=&quot;$RecuperoAttributi/Record&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;NOMEATTRIBUTO = 'DATARESTITUZIONEPRODOTTI' and VALOREATTRIBUTO !='01-01-1900'&quot;>&lt;tns2:attributiDettaglioOrdine>&lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&lt;tns2:nomeAttributo>&lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&lt;/tns2:nomeAttributo>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA = (70,71,72,73) and NOMEATTRIBUTO = 'TIPOOFFERTA'&quot;>&lt;tns2:valoreAttributo>&lt;xsl:value-of select=&quot;'MULTICAST'&quot;/>&lt;/tns2:valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&lt;tns2:valoreAttributo>&lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&lt;/tns2:valoreAttributo>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:attributiDettaglioOrdine>&lt;/xsl:when>&lt;xsl:when test=&quot;NOMEATTRIBUTO !='DATARESTITUZIONEPRODOTTI'&quot;>&lt;tns2:attributiDettaglioOrdine>&lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&lt;tns2:nomeAttributo>&lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&lt;/tns2:nomeAttributo>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA = (70,71,72,73) and NOMEATTRIBUTO = 'TIPOOFFERTA'&quot;>&lt;tns2:valoreAttributo>&lt;xsl:value-of select=&quot;'MULTICAST'&quot;/>&lt;/tns2:valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&lt;tns2:valoreAttributo>&lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&lt;/tns2:valoreAttributo>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:attributiDettaglioOrdine>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_NOW_GUI&quot;>&lt;tns2:statoRichiestaNow>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_NOW_GUI&quot;/>&lt;/tns2:statoRichiestaNow>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;($OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA = (72,73)) and ($OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI = 'INVIATO A DELIVERY')&quot;>&lt;tns2:statoRichiestaOlo>&lt;xsl:value-of select=&quot;'IN DELIVERY'&quot;/>&lt;/tns2:statoRichiestaOlo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI&quot;>&lt;tns2:statoRichiestaOlo>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI&quot;/>&lt;/tns2:statoRichiestaOlo>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/FLAGNAKED&quot;>&lt;tns2:flagNaked>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/FLAGNAKED&quot;/>&lt;/tns2:flagNaked>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($OrdiniDataIdTichiestaOlo/Record/IDOFFERTA)&quot;>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA&quot;>&lt;tns2:idOfferta>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA&quot;/>&lt;/tns2:idOfferta>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$RecNumTelAgg/Record&quot;>&lt;tns2:numeroTelefonicoAggiuntivo>&lt;xsl:value-of select=&quot;NUMEROTELEFONICOAGGIUNTIVO&quot;/>&lt;/tns2:numeroTelefonicoAggiuntivo>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DISAGGREGATO&quot;>&lt;tns2:disaggregato>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DISAGGREGATO&quot;/>&lt;/tns2:disaggregato>&lt;/xsl:if>&lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/EXDISAGGREGATO&quot;>&lt;tns2:exDisaggregato>&lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/EXDISAGGREGATO&quot;/>&lt;/tns2:exDisaggregato>&lt;/xsl:if>&lt;/tns2:OutputDatiOrdine>&lt;tns2:result>&lt;tns2:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns2:severity>&lt;tns2:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:code>&lt;/tns2:result>&lt;/tns2:OutputOrdersData>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ordinidataoutput"
                                    name="Assign2"
                                    outputVariable="ordinidataoutput"
                                    tibex:xpdlId="e1db3c8f-3d12-468f-a1e2-817df6f47e11" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToAssign2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign2ToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160421153118PLT/ConceptSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DettOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;OrdiniDataIdTichiestaOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;RecNumTelAgg&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoAttributi&quot;/>&#xa;    &lt;xsl:template name=&quot;ordinidataoutput&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:OutputOrdersData>&#xa;            &lt;tns2:OutputDatiOrdine>&#xa;                &lt;tns2:idrichiestaolo>&#xa;                    &lt;xsl:value-of select=&quot;$get1.parameters/Valore&quot;/>&#xa;                &lt;/tns2:idrichiestaolo>&#xa;                &lt;xsl:for-each select=&quot;$DettOrdine/Record&quot;>&#xa;                    &lt;tns2:codiceordineTInonvalorizzato>&#xa;                        &lt;tns2:nome>&#xa;                            &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                        &lt;/tns2:nome>&#xa;                        &lt;tns2:progressivo>&#xa;                            &lt;xsl:value-of select=&quot;string(xsd:int(PROGRS_TIPOLG_DATO_RICH))&quot;/>&#xa;                        &lt;/tns2:progressivo>&#xa;                        &lt;xsl:if test=&quot;DESCR&quot;>&#xa;                            &lt;tns2:tipologiadatorichiesta>&#xa;                                &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                            &lt;/tns2:tipologiadatorichiesta>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:richiestadettagliovalore>&#xa;                            &lt;xsl:value-of select=&quot;VALORE&quot;/>&#xa;                        &lt;/tns2:richiestadettagliovalore>&#xa;                    &lt;/tns2:codiceordineTInonvalorizzato>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;tns2:richiesta>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEORDINEOLO&quot;>&#xa;                        &lt;tns2:codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                        &lt;/tns2:codiceOrdineOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODIFICAOLOAGCOM&quot;>&#xa;                        &lt;tns2:codificaOAO>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                        &lt;/tns2:codificaOAO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODIFICAOLONOW&quot;>&#xa;                        &lt;tns2:codiceOAO>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODIFICAOLONOW&quot;/>&#xa;                        &lt;/tns2:codiceOAO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CANALERICHIESTA&quot;>&#xa;                        &lt;tns2:canale>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CANALERICHIESTA&quot;/>&#xa;                        &lt;/tns2:canale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/LAVORAZIONE&quot;>&#xa;                        &lt;tns2:tipoLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/LAVORAZIONE&quot;/>&#xa;                        &lt;/tns2:tipoLavorazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:dataInvio>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(string($OrdiniDataIdTichiestaOlo/Record[1]/DATAINVIORICHIESTA), &amp;quot;T&amp;quot;)&quot;/>&#xa;                    &lt;/tns2:dataInvio>&#xa;                    &lt;tns2:dataInserimento>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(string($OrdiniDataIdTichiestaOlo/Record[1]/CREATED),'T')&quot;/>&#xa;                    &lt;/tns2:dataInserimento>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(string($OrdiniDataIdTichiestaOlo/Record[1]/LASTUPDATE), &amp;quot;.&amp;quot;)&quot;>&#xa;                            &lt;tns2:dataAggiornamento>&#xa;                                &lt;xsl:value-of select=&quot;concat(substring-before(string($OrdiniDataIdTichiestaOlo/Record[1]/LASTUPDATE),'.'), '+',substring-after(string($OrdiniDataIdTichiestaOlo/Record[1]/LASTUPDATE), '+'))&quot;/>&#xa;                            &lt;/tns2:dataAggiornamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:dataAggiornamento>&#xa;                                &lt;xsl:value-of select=&quot;string($OrdiniDataIdTichiestaOlo/Record[1]/LASTUPDATE)&quot;/>&#xa;                            &lt;/tns2:dataAggiornamento>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_NOW_GUI&quot;>&#xa;                        &lt;tns2:statoNow>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_NOW_GUI&quot;/>&#xa;                        &lt;/tns2:statoNow>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI&quot;>&#xa;                        &lt;tns2:statoOao>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI&quot;/>&#xa;                        &lt;/tns2:statoOao>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/COD_CAUS_NOW_DG&quot;>&#xa;                        &lt;tns2:codiceCausaleNow>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/COD_CAUS_NOW_DG&quot;/>&#xa;                        &lt;/tns2:codiceCausaleNow>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/COD_CAUS_OLO&quot;>&#xa;                        &lt;tns2:codiceCausaleOao>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                        &lt;/tns2:codiceCausaleOao>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DESCR_CAUS_OLO&quot;>&#xa;                        &lt;tns2:causaleOao>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                        &lt;/tns2:causaleOao>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DESCR_CAUS_NOW_DG&quot;>&#xa;                        &lt;tns2:causaleNow>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DESCR_CAUS_NOW_DG&quot;/>&#xa;                        &lt;/tns2:causaleNow>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDRISORSA&quot;>&#xa;                        &lt;tns2:idRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDRISORSA&quot;/>&#xa;                        &lt;/tns2:idRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEORDINEOLOPADRE&quot;>&#xa;                        &lt;tns2:codiceOrdineOaoPadre>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEORDINEOLOPADRE&quot;/>&#xa;                        &lt;/tns2:codiceOrdineOaoPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEPROGETTO&quot;>&#xa;                        &lt;tns2:codiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/CODICEPROGETTO&quot;/>&#xa;                        &lt;/tns2:codiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/NOTE&quot;>&#xa;                        &lt;tns2:note>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/NOTE&quot;/>&#xa;                        &lt;/tns2:note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/NOME_FILE&quot;>&#xa;                        &lt;tns2:nomeFile>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/NOME_FILE&quot;/>&#xa;                        &lt;/tns2:nomeFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:richiesta>&#xa;                &lt;xsl:for-each select=&quot;$RecuperoAttributi/Record&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;NOMEATTRIBUTO = 'DATARESTITUZIONEPRODOTTI' and VALOREATTRIBUTO !='01-01-1900'&quot;>&#xa;                            &lt;tns2:attributiDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&#xa;                                    &lt;tns2:nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&#xa;                                    &lt;/tns2:nomeAttributo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA = (70,71,72,73) and NOMEATTRIBUTO = 'TIPOOFFERTA'&quot;>&#xa;                                        &lt;tns2:valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;'MULTICAST'&quot;/>&#xa;                                        &lt;/tns2:valoreAttributo>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&#xa;                                            &lt;tns2:valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&#xa;                                            &lt;/tns2:valoreAttributo>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns2:attributiDettaglioOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;NOMEATTRIBUTO !='DATARESTITUZIONEPRODOTTI'&quot;>&#xa;                            &lt;tns2:attributiDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&#xa;                                    &lt;tns2:nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&#xa;                                    &lt;/tns2:nomeAttributo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA = (70,71,72,73) and NOMEATTRIBUTO = 'TIPOOFFERTA'&quot;>&#xa;                                        &lt;tns2:valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;'MULTICAST'&quot;/>&#xa;                                        &lt;/tns2:valoreAttributo>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&#xa;                                            &lt;tns2:valoreAttributo>&#xa;                                                &lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&#xa;                                            &lt;/tns2:valoreAttributo>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns2:attributiDettaglioOrdine>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_NOW_GUI&quot;>&#xa;                    &lt;tns2:statoRichiestaNow>&#xa;                        &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_NOW_GUI&quot;/>&#xa;                    &lt;/tns2:statoRichiestaNow>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA = (72,73)) and ($OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI = 'INVIATO A DELIVERY')&quot;>&#xa;                        &lt;tns2:statoRichiestaOlo>&#xa;                            &lt;xsl:value-of select=&quot;'IN DELIVERY'&quot;/>&#xa;                        &lt;/tns2:statoRichiestaOlo>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI&quot;>&#xa;                            &lt;tns2:statoRichiestaOlo>&#xa;                                &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/STATO_RICH_OLO_GUI&quot;/>&#xa;                            &lt;/tns2:statoRichiestaOlo>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/FLAGNAKED&quot;>&#xa;                    &lt;tns2:flagNaked>&#xa;                        &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/FLAGNAKED&quot;/>&#xa;                    &lt;/tns2:flagNaked>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($OrdiniDataIdTichiestaOlo/Record/IDOFFERTA)&quot;>&#xa;                    &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA&quot;>&#xa;                        &lt;tns2:idOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/IDOFFERTA&quot;/>&#xa;                        &lt;/tns2:idOfferta>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$RecNumTelAgg/Record&quot;>&#xa;                    &lt;tns2:numeroTelefonicoAggiuntivo>&#xa;                        &lt;xsl:value-of select=&quot;NUMEROTELEFONICOAGGIUNTIVO&quot;/>&#xa;                    &lt;/tns2:numeroTelefonicoAggiuntivo>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DISAGGREGATO&quot;>&#xa;                    &lt;tns2:disaggregato>&#xa;                        &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/DISAGGREGATO&quot;/>&#xa;                    &lt;/tns2:disaggregato>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/EXDISAGGREGATO&quot;>&#xa;                    &lt;tns2:exDisaggregato>&#xa;                        &lt;xsl:value-of select=&quot;$OrdiniDataIdTichiestaOlo/Record[1]/EXDISAGGREGATO&quot;/>&#xa;                    &lt;/tns2:exDisaggregato>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:OutputDatiOrdine>&#xa;            &lt;tns2:result>&#xa;                &lt;tns2:severity>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/tns2:severity>&#xa;                &lt;tns2:code>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns2:code>&#xa;            &lt;/tns2:result>&#xa;        &lt;/tns2:OutputOrdersData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
