                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns8=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;getPreventivo_LogMsg-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;xsl:if test=&quot;$get2.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns7:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get2.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns7:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;            &lt;tns7:ActiveLoggerServices>&#xa;                &lt;tns7:Envelope>&#xa;                    &lt;tns7:Identifier>&#xa;                        &lt;tns7:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                        &lt;/tns7:ServiceName>&#xa;                        &lt;tns7:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Source>&#xa;                        &lt;xsl:if test=&quot;$get2.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns7:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get2.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns7:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get2.httpHeaders/GUI-SID,$get2.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns7:EventID>&#xa;                        &lt;xsl:if test=&quot;$get2.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns7:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get2.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns7:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$get2.httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns7:EventType>&#xa;                        &lt;tns7:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$get2.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns7:trackID>&#xa;                    &lt;/tns7:Identifier>&#xa;                    &lt;tns7:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns7:track_position>&#xa;                    &lt;tns7:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns7:Timestamp>&#xa;                &lt;/tns7:Envelope>&#xa;            &lt;/tns7:ActiveLoggerServices>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_integration.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6f6b0e66-0f44-4b09-9067-0d7c4c614fc9+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaPreventivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns26:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get2/parameters/tns:visualizzaordini-preventivoGetParameters/tns:id_rich_olo&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns26:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ListaPreventivo-input"
                                    name="ListaPreventivo"
                                    outputVariable="ListaPreventivo"
                                    tibex:xpdlId="6f6b0e66-0f44-4b09-9067-0d7c4c614fc9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GetIdOffertToListaPreventivo_OfferteDati"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6f6b0e66-0f44-4b09-9067-0d7c4c614fc9+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get2.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaPreventivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns26:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get2.parameters/tns:id_rich_olo&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns26:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT P.DATA_ACCETTAZIONE_OLO, P.DATA_PREVENTIVO_FORNITA_DA_DTU, P.FLAG_CONTRIBUTO_CLIENTE, P.FLAG_OLTRE_PERIMETRO_ABITATO,&#xa;P.FLAG_PERMESSI, P.FLAG_TIMEOUT_ACCETTAZIONE, P.IMPORTO_TOT, P.NOTE_PREVENTIVO, P.NUMERO_GIORNI_PREVISTO, P.STATO_PREVENTIVO, &#xa;P.TIMSTP_AGGTO, P.TIMSTP_INSMTO, P.TIMSTP_TIMEOUT_ACCETTAZIONE&#xa;FROM PREVENTIVO P&#xa;LEFT JOIN DETT_PREVENTIVO DP ON P.ID_PREVENTIVO = DP.ID_PREVENTIVO&#xa;LEFT JOIN STAG_JPUB_VLRZ_PRVCNS_NOFL SJ ON P.ID_PREVENTIVO = SJ.ID_PREVENTIVO &#xa;LEFT JOIN TRASCODFC_ARTICOLI_DTU_JPUB T ON DP.COD_ARTICOLO_JPUB = T.COD_ARTICOLO_JPUB&#xa;WHERE P.ID_RICH_OLO = ?&#xa;AND P.STATO_PREVENTIVO &lt;> 'CHIUSO'&#xa;AND P.STATO_PREVENTIVO &lt;> 'INLAVORAZIONE'&#xa;AND  DP.ID_DETT_PREVENTIVO = (SELECT MAX(ID_DETT_PREVENTIVO)&#xa;FROM DETT_PREVENTIVO&#xa;WHERE ID_PREVENTIVO = P.ID_PREVENTIVO)&#xa;AND SJ.DESCR_ERRORE is NULL&#xa;ORDER BY P.TIMSTP_AGGTO, P.TIMSTP_INSMTO" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>
                                    <columnMetadata
                                    columnName="DATA_ACCETTAZIONE_OLO"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATA_PREVENTIVO_FORNITA_DA_DTU"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="FLAG_CONTRIBUTO_CLIENTE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_OLTRE_PERIMETRO_ABITATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_PERMESSI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_TIMEOUT_ACCETTAZIONE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IMPORTO_TOT"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOTE_PREVENTIVO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMERO_GIORNI_PREVISTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STATO_PREVENTIVO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_AGGTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIMSTP_TIMEOUT_ACCETTAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="lista_Preventivo"
                                    name="Lista_Preventivo"
                                    outputVariable="lista_Preventivo"
                                    tibex:xpdlId="61ab2d99-2685-45db-9929-470aebf46004" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery1ToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tim.com/NOW/rest/preventivo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaPreventivo&quot;/>&#xa;    &lt;xsl:template name=&quot;lista_Preventivo&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($ListaPreventivo/Record) > 0&quot;>&#xa;                &lt;tns26:Output_Preventivo>&#xa;                    &lt;xsl:for-each select=&quot;$ListaPreventivo/Record&quot;>&#xa;                        &lt;tns26:Lista_Output_Preventivo>&#xa;                            &lt;tns26:dataAccettazioneOao>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_ACCETTAZIONE_OLO),'T')&quot;/>&#xa;                            &lt;/tns26:dataAccettazioneOao>&#xa;                            &lt;tns26:dataPreventivo>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(DATA_PREVENTIVO_FORNITA_DA_DTU),'T')&quot;/>&#xa;                            &lt;/tns26:dataPreventivo>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_CONTRIBUTO_CLIENTE = 'SI'&quot;>&#xa;                                    &lt;tns26:contributoCliente>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:contributoCliente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:contributoCliente>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_CONTRIBUTO_CLIENTE&quot;/>&#xa;                                    &lt;/tns26:contributoCliente>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_OLTRE_PERIMETRO_ABITATO = 'SI'&quot;>&#xa;                                    &lt;tns26:opa>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:opa>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:opa>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_OLTRE_PERIMETRO_ABITATO&quot;/>&#xa;                                    &lt;/tns26:opa>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_PERMESSI = 'SI'&quot;>&#xa;                                    &lt;tns26:permessi>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:permessi>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:permessi>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_PERMESSI&quot;/>&#xa;                                    &lt;/tns26:permessi>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLAG_TIMEOUT_ACCETTAZIONE = 'SI'&quot;>&#xa;                                    &lt;tns26:timeoutAccettazione>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns26:timeoutAccettazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns26:timeoutAccettazione>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_TIMEOUT_ACCETTAZIONE&quot;/>&#xa;                                    &lt;/tns26:timeoutAccettazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists(IMPORTO_TOT)&quot;>&#xa;                                &lt;tns26:importoTotale>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(IMPORTO_TOT)&quot;/>&#xa;                                &lt;/tns26:importoTotale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOTE_PREVENTIVO&quot;>&#xa;                                &lt;tns26:note>&#xa;                                    &lt;xsl:value-of select=&quot;NOTE_PREVENTIVO&quot;/>&#xa;                                &lt;/tns26:note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(NUMERO_GIORNI_PREVISTO)&quot;>&#xa;                                &lt;tns26:numGiorniPrevisto>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(NUMERO_GIORNI_PREVISTO)&quot;/>&#xa;                                &lt;/tns26:numGiorniPrevisto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns26:stato>&#xa;                                &lt;xsl:value-of select=&quot;STATO_PREVENTIVO&quot;/>&#xa;                            &lt;/tns26:stato>&#xa;                            &lt;tns26:dataUltimaModifica>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(TIMSTP_AGGTO),'T')&quot;/>&#xa;                            &lt;/tns26:dataUltimaModifica>&#xa;                            &lt;tns26:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(TIMSTP_INSMTO),'T')&quot;/>&#xa;                            &lt;/tns26:dataInserimento>&#xa;                            &lt;tns26:dataTimeoutAccettazione>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(TIMSTP_TIMEOUT_ACCETTAZIONE),'T')&quot;/>&#xa;                            &lt;/tns26:dataTimeoutAccettazione>&#xa;                            &lt;tns26:prezziEspostiIn>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;€&amp;quot;&quot;/>&#xa;                            &lt;/tns26:prezziEspostiIn>&#xa;                        &lt;/tns26:Lista_Output_Preventivo>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns26:result>&#xa;                        &lt;tns26:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns26:severity>&#xa;                        &lt;tns26:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns26:code>&#xa;                    &lt;/tns26:result>&#xa;                &lt;/tns26:Output_Preventivo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns26:Output_Preventivo>&#xa;                    &lt;tns26:result>&#xa;                        &lt;tns26:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns26:severity>&#xa;                        &lt;tns26:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns26:code>&#xa;                        &lt;tns26:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;No Record&amp;quot;&quot;/>&#xa;                        &lt;/tns26:details>&#xa;                    &lt;/tns26:result>&#xa;                &lt;/tns26:Output_Preventivo>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="lista_Preventivo" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns8=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns26=&quot;http://www.tim.com/NOW/rest/consuntivo&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;lista_Consuntivo&quot;/>&#xa;    &lt;xsl:param name=&quot;get2&quot;/>&#xa;    &lt;xsl:template name=&quot;getPreventivoOutput_LogInfo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;xsl:if test=&quot;$get2/httpHeaders/tns8:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns7:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get2/httpHeaders/tns8:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns7:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($lista_Consuntivo/tns26:Lista_Output_consuntivo[1])&quot;>&#xa;                        &lt;tns7:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Output_V