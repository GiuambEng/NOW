                                    tibex:xpdlId="b04494d3-44fe-4eb8-9a47-4ac04a256c6a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCCallProcedureToListaOrdini_Assign"/>
                                    <bpws:target linkName="JDBCQueryToListaOrdiniAVANZ"/>
                                    <bpws:target linkName="SPListaOrdiniOFAVANZToListaOrdiniAVANZ"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ListaOrdini_AssignToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SPListaOrdiniAVANZ&quot;/>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;CRM_OPCC&quot;/>&#xa;    &lt;xsl:param name=&quot;SPListaOrdiniOFAVANZ&quot;/>&#xa;    &lt;xsl:template name=&quot;listaOutput&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$post.parameters/tns:tipoProfilo = 'CRM_OPCC'&quot;>&#xa;                &lt;tns2:OutputOrdersListNoOlo>&#xa;                    &lt;xsl:for-each select=&quot;$CRM_OPCC/Record&quot;>&#xa;                        &lt;tns2:OutputListaOrdiniNoOLO>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                &lt;tns2:codiceordineolo>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns2:codiceordineolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&#xa;                                &lt;tns2:cod_olo_now>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&#xa;                                &lt;/tns2:cod_olo_now>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;COD_CAUS_OLO&quot;>&#xa;                                &lt;tns2:cod_causal_olo>&#xa;                                    &lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&#xa;                                &lt;/tns2:cod_causal_olo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPORICHIESTA&quot;>&#xa;                                &lt;tns2:tipoRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;TIPORICHIESTA&quot;/>&#xa;                                &lt;/tns2:tipoRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                                &lt;tns2:codiceordineti>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns2:codiceordineti>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns2:codfc_olo_agcom>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns2:codfc_olo_agcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CANALERICHIESTA&quot;>&#xa;                                &lt;tns2:canalerichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;CANALERICHIESTA&quot;/>&#xa;                                &lt;/tns2:canalerichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATO_RICH_OLO_GUI&quot;>&#xa;                                &lt;tns2:statorichiesteolo>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_RICH_OLO_GUI&quot;/>&#xa;                                &lt;/tns2:statorichiesteolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATO_RICH_NOW_GUI&quot;>&#xa;                                &lt;tns2:statorichiestanow>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_RICH_NOW_GUI&quot;/>&#xa;                                &lt;/tns2:statorichiestanow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns2:idRichiestaOlo>&#xa;                                &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                            &lt;/tns2:idRichiestaOlo>&#xa;                            &lt;xsl:if test=&quot;FLAGOPERESPECIALI&quot;>&#xa;                                &lt;tns2:flagOpereSpeciali>&#xa;                                    &lt;xsl:value-of select=&quot;FLAGOPERESPECIALI&quot;/>&#xa;                                &lt;/tns2:flagOpereSpeciali>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDOFFERTA&quot;>&#xa;                                &lt;tns2:idOfferta>&#xa;                                    &lt;xsl:value-of select=&quot;IDOFFERTA&quot;/>&#xa;                                &lt;/tns2:idOfferta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DATAINVIORICHIESTA) and string-length( string(DATAINVIORICHIESTA))>0&quot;>&#xa;                                &lt;tns2:dataInvio>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before( string(DATAINVIORICHIESTA),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:dataInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns2:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns2:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;LAVORAZIONE&quot;>&#xa;                                &lt;tns2:tipoLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&#xa;                                &lt;/tns2:tipoLavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                                &lt;tns2:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns2:offerta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(FLAGATTESADESOSPOLO)=0&quot;>&#xa;                                    &lt;tns2:inAttesaDesospensioneDaOao>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                    &lt;/tns2:inAttesaDesospensioneDaOao>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;FLAGATTESADESOSPOLO&quot;>&#xa;                                        &lt;tns2:inAttesaDesospensioneDaOao>&#xa;                                            &lt;xsl:value-of select=&quot;FLAGATTESADESOSPOLO&quot;/>&#xa;                                        &lt;/tns2:inAttesaDesospensioneDaOao>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns2:OutputListaOrdiniNoOLO>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns2:result>&#xa;                        &lt;tns2:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns2:severity>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($SPListaOrdiniAVANZ/outputSet/RESULTSET/APPUSER.LISTAORDINI)&amp;lt;$MaxRows&quot;>&#xa;                                &lt;tns2:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns2:code>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:code>&#xa;                                    &lt;xsl:value-of select=&quot;'LIMIT'&quot;/>&#xa;                                &lt;/tns2:code>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:result>&#xa;                &lt;/tns2:OutputOrdersListNoOlo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$post.parameters/tns:tipoLista='FIBERSTREAM'&quot;>&#xa;                &lt;tns2:OutputOrdersListNoOlo>&#xa;                    &lt;xsl:for-each select=&quot;$SPListaOrdiniOFAVANZ/outputSet/RESULTSET/APPUSER.LISTAORDINI_OPENFIBER&quot;>&#xa;                        &lt;tns2:OutputListaOrdiniNoOLO>&#xa;                            &lt;xsl:if test=&quot;not((string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINEOLO)&quot;>&#xa;                                &lt;tns2:codiceordineolo>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns2:codiceordineolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(CODIFICAOLONOW/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLONOW/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLONOW)&quot;>&#xa;                                &lt;tns2:cod_olo_now>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&#xa;                                &lt;/tns2:cod_olo_now>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(COD_CAUS_OLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(COD_CAUS_OLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(COD_CAUS_OLO)&quot;>&#xa;                                &lt;tns2:cod_causal_olo>&#xa;                                    &lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&#xa;                                &lt;/tns2:cod_causal_olo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(TIPORICHIESTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(TIPORICHIESTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(TIPORICHIESTA)&quot;>&#xa;                                &lt;tns2:tipoRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;TIPORICHIESTA&quot;/>&#xa;                                &lt;/tns2:tipoRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(CODICEORDINETI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINETI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINETI)&quot;>&#xa;                                &lt;tns2:codiceordineti>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns2:codiceordineti>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLOAGCOM)&quot;>&#xa;                                &lt;tns2:codfc_olo_agcom>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns2:codfc_olo_agcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(CANALERICHIESTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CANALERICHIESTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CANALERICHIESTA)&quot;>&#xa;                                &lt;tns2:canalerichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;CANALERICHIESTA&quot;/>&#xa;                                &lt;/tns2:canalerichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(STATO_RICH_OLO_GUI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATO_RICH_OLO_GUI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATO_RICH_OLO_GUI)&quot;>&#xa;                                &lt;tns2:statorichiesteolo>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_RICH_OLO_GUI&quot;/>&#xa;                                &lt;/tns2:statorichiesteolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(STATO_RICH_NOW_GUI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATO_RICH_NOW_GUI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATO_RICH_NOW_GUI)&quot;>&#xa;                                &lt;tns2:statorichiestanow>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_RICH_NOW_GUI&quot;/>&#xa;                                &lt;/tns2:statorichiestanow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(IDRICHIESTAOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRICHIESTAOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRICHIESTAOLO)&quot;>&#xa;                                &lt;tns2:idRichiestaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                                &lt;/tns2:idRichiestaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(FLAGOPERESPECIALI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(FLAGOPERESPECIALI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(FLAGOPERESPECIALI)&quot;>&#xa;                                &lt;tns2:flagOpereSpeciali>&#xa;                                    &lt;xsl:value-of select=&quot;FLAGOPERESPECIALI&quot;/>&#xa;                                &lt;/tns2:flagOpereSpeciali>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(IDOFFERTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDOFFERTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDOFFERTA)&quot;>&#xa;                                &lt;tns2:idOfferta>&#xa;                                    &lt;xsl:value-of select=&quot;IDOFFERTA&quot;/>&#xa;                                &lt;/tns2:idOfferta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DATAINVIORICHIESTA) and string-length( string(DATAINVIORICHIESTA))>0&quot;>&#xa;                                &lt;tns2:dataInvio>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before( string(DATAINVIORICHIESTA),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:dataInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(IDRISORSA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSA)&quot;>&#xa;                                &lt;tns2:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns2:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(LAVORAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(LAVORAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(LAVORAZIONE)&quot;>&#xa;                                &lt;tns2:tipoLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&#xa;                                &lt;/tns2:tipoLavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(OFFERTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(OFFERTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(OFFERTA)&quot;>&#xa;                                &lt;tns2:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns2:offerta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(FLAGATTESADESOSPOLO)=0&quot;>&#xa;                                    &lt;tns2:inAttesaDesospensioneDaOao>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                    &lt;/tns2:inAttesaDesospensioneDaOao>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;not((string(FLAGATTESADESOSPOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(FLAGATTESADESOSPOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(FLAGATTESADESOSPOLO)&quot;>&#xa;                                        &lt;tns2:inAttesaDesospensioneDaOao>&#xa;                                            &lt;xsl:value-of select=&quot;FLAGATTESADESOSPOLO&quot;/>&#xa;                                        &lt;/tns2:inAttesaDesospensioneDaOao>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;not((string(CODICEORDINEOPENFIBER/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINEOPENFIBER/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINEOPENFIBER)&quot;>&#xa;                                &lt;tns2:codOrdineOF>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOPENFIBER&quot;/>&#xa;                                &lt;/tns2:codOrdineOF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(IDRISORSAOPENFIBER/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSAOPENFIBER/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSAOPENFIBER)&quot;>&#xa;                                &lt;tns2:idRisorsaOF>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSAOPENFIBER&quot;/>&#xa;                                &lt;/tns2:idRisorsaOF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(STATORICHIESTAOF/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATORICHIESTAOF/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATORICHIESTAOF)&quot;>&#xa;                                &lt;tns2:statoOF>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTAOF&quot;/>&#xa;                                &lt;/tns2:statoOF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(NOTEFIBERSTREAM/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(NOTEFIBERSTREAM/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(NOTEFIBERSTREAM)&quot;>&#xa;                                &lt;tns2:noteFiberstream>&#xa;                                    &lt;xsl:value-of select=&quot;NOTEFIBERSTREAM&quot;/>&#xa;                                &lt;/tns2:noteFiberstream>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(SOTTOLAVORAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(SOTTOLAVORAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(SOTTOLAVORAZIONE)&quot;>&#xa;                                &lt;tns2:sottolavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;SOTTOLAVORAZIONE&quot;/>&#xa;                                &lt;/tns2:sottolavorazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns2:OutputListaOrdiniNoOLO>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns2:result>&#xa;                        &lt;tns2:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns2:severity>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($SPListaOrdiniAVANZ/outputSet/RESULTSET/APPUSER.LISTAORDINI)&amp;lt;$MaxRows&quot;>&#xa;                                &lt;tns2:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns2:code>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:code>&#xa;                                    &lt;xsl:value-of select=&quot;'LIMIT'&quot;/>&#xa;                                &lt;/tns2:code>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:result>&#xa;                &lt;/tns2:OutputOrdersListNoOlo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:OutputOrdersListNoOlo>&#xa;                    &lt;xsl:for-each select=&quot;$SPListaOrdiniAVANZ/outputSet/RESULTSET/APPUSER.LISTAORDINI&quot;>&#xa;                        &lt;tns2:OutputListaOrdiniNoOLO>&#xa;                            &lt;xsl:if test=&quot;not((string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINEOLO)&quot;>&#xa;                                &lt;tns2:codiceordineolo>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns2:codiceordineolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(CODIFICAOLONOW/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLONOW/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLONOW)&quot;>&#xa;                                &lt;tns2:cod_olo_now>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&#xa;                                &lt;/tns2:cod_olo_now>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(COD_CAUS_OLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(COD_CAUS_OLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(COD_CAUS_OLO)&quot;>&#xa;                                &lt;tns2:cod_causal_olo>&#xa;                                    &lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&#xa;                                &lt;/tns2:cod_causal_olo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(TIPORICHIESTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(TIPORICHIESTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(TIPORICHIESTA)&quot;>&#xa;                                &lt;tns2:tipoRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;TIPORICHIESTA&quot;/>&#xa;                                &lt;/tns2:tipoRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(CODICEORDINETI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINETI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINETI)&quot;>&#xa;                                &lt;tns2:codiceordineti>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns2:codiceordineti>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLOAGCOM)&quot;>&#xa;                                &lt;tns2:codfc_olo_agcom>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns2:codfc_olo_agcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(CANALERICHIESTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CANALERICHIESTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CANALERICHIESTA)&quot;>&#xa;                                &lt;tns2:canalerichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;CANALERICHIESTA&quot;/>&#xa;                                &lt;/tns2:canalerichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(STATO_RICH_OLO_GUI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATO_RICH_OLO_GUI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATO_RICH_OLO_GUI)&quot;>&#xa;                                &lt;tns2:statorichiesteolo>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_RICH_OLO_GUI&quot;/>&#xa;                                &lt;/tns2:statorichiesteolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(STATO_RICH_NOW_GUI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATO_RICH_NOW_GUI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATO_RICH_NOW_GUI)&quot;>&#xa;                                &lt;tns2:statorichiestanow>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_RICH_NOW_GUI&quot;/>&#xa;                                &lt;/tns2:statorichiestanow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(IDRICHIESTAOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRICHIESTAOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRICHIESTAOLO)&quot;>&#xa;                                &lt;tns2:idRichiestaOlo>&#xa;                                    &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                                &lt;/tns2:idRichiestaOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(FLAGOPERESPECIALI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(FLAGOPERESPECIALI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(FLAGOPERESPECIALI)&quot;>&#xa;                                &lt;tns2:flagOpereSpeciali>&#xa;                                    &lt;xsl:value-of select=&quot;FLAGOPERESPECIALI&quot;/>&#xa;                                &lt;/tns2:flagOpereSpeciali>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(IDOFFERTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDOFFERTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDOFFERTA)&quot;>&#xa;                                &lt;tns2:idOfferta>&#xa;                                    &lt;xsl:value-of select=&quot;IDOFFERTA&quot;/>&#xa;                                &lt;/tns2:idOfferta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(DATAINVIORICHIESTA) and string-length( string(DATAINVIORICHIESTA))>0&quot;>&#xa;                                &lt;tns2:dataInvio>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before( string(DATAINVIORICHIESTA),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:dataInvio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(IDRISORSA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSA)&quot;>&#xa;                                &lt;tns2:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns2:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(LAVORAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(LAVORAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(LAVORAZIONE)&quot;>&#xa;                                &lt;tns2:tipoLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&#xa;                                &lt;/tns2:tipoLavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;not((string(OFFERTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(OFFERTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(OFFERTA)&quot;>&#xa;                                &lt;tns2:offerta>&#xa;                                    &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                                &lt;/tns2:offerta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(FLAGATTESADESOSPOLO) =0&quot;>&#xa;                                    &lt;tns2:inAttesaDesospensioneDaOao>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                    &lt;/tns2:inAttesaDesospensioneDaOao>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;not((string(FLAGATTESADESOSPOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(FLAGATTESADESOSPOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(FLAGATTESADESOSPOLO)&quot;>&#xa;                                        &lt;tns2:inAttesaDesospensioneDaOao>&#xa;                                            &lt;xsl:value-of select=&quot;FLAGATTESADESOSPOLO&quot;/>&#xa;                                        &lt;/tns2:inAttesaDesospensioneDaOao>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns2:OutputListaOrdiniNoOLO>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns2:result>&#xa;                        &lt;tns2:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns2:severity>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($SPListaOrdiniAVANZ/outputSet/RESULTSET/APPUSER.LISTAORDINI)&amp;lt;$MaxRows&quot;>&#xa;                                &lt;tns2:code>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns2:code>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:code>&#xa;                                    &lt;xsl:value-of select=&quot;'LIMIT'&quot;/>&#xa;                                &lt;/tns2:code>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:result>&#xa;                &lt;/tns2:OutputOrdersListNoOlo>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="listaOutput" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns8=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;post_datiordini_InputLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;xsl:if test=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns7:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns7:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns2:InputOrderServizioricercaAvannzata)&quot;>&#xa;                        &lt;tns7:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Input_VisualizzaOrdini:&amp;quot;,string($post/item/tns2:InputOrderServizioricercaAvannzata), string($post/parameters/tns:visualizzaordiniPostParameters))&quot;/>&#xa;                        &lt;/tns7:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Input_VisualizzaOrdini_Header:&amp;quot;,tib:render-xml($post/httpHeaders/tns8:httpHeaders, true(),true()))&quot;/>&#xa;                        &lt;/tns7:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;            &lt;tns7:ActiveLoggerServices>&#xa;                &lt;tns7:Envelope>&#xa;                    &lt;tns7:Identifier>&#xa;                        &lt;tns7:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                        &lt;/tns7:ServiceName>&#xa;                        &lt;tns7:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Source>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns7:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns7:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post/httpHeaders/tns8:httpHeaders/GUI-SID,$post/httpHeaders/tns8:httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns7:EventID>&#xa;                        &lt;xsl:if test=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns7:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post/httpHeaders/tns8:httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns7:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$post/httpHeaders/tns8:httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns7:EventType>&#xa;                        &lt;tns7:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$post/httpHeaders/tns8:httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns7:trackID>&#xa;                    &lt;/tns7:Identifier>&#xa;                    &lt;tns7:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns7:track_position>&#xa;                    &lt;tns7:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns7:Timestamp>&#xa;                &lt;/tns7:Envelope>&#xa;                &lt;tns7:Playload>&#xa;                    &lt;tns7:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(concat(tib:render-xml($post/item/tns2:InputOrderServizioricercaAvannzata),&amp;quot;-&amp;quot;,tib:render-xml($post/parameters/tns:visualizzaordiniPostParameters))))&quot;/>&#xa;                    &lt;/tns7:Binary>&#xa;                    &lt;tns7:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;concat(tib:render-xml($post/item/tns2:InputOrderServizioricercaAvannzata),&amp;quot;-&amp;quot;,tib:render-xml($post/parameters/tns:visualizzaordiniPostParameters))&quot;/>&#xa;                    &lt;/tns7:XMLString>&#xa;                &lt;/tns7:Playload>&#xa;            &lt;/tns7:ActiveLoggerServices>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="post_datiordini_InputLog-input"
                                    name="post_datiordini_InputLog"
                                    tibex:xpdlId="9364e730-4e17-47f5-8cdd-22dbae6996ac"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStart2ToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToCallProcess11"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns8=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;post_datiordini_InputLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns7:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns7:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item)&quot;>&#xa;                        &lt;tns7:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Input_VisualizzaOrdini:&amp;quot;,string($post.item), string($post.parameters))&quot;/>&#xa;                        &lt;/tns7:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Input_VisualizzaOrdini_Header:&amp;quot;,tib:render-xml($post.httpHeaders, true(),true()))&quot;/>&#xa;                        &lt;/tns7:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;            &lt;tns7:ActiveLoggerServices>&#xa;                &lt;tns7:Envelope>&#xa;                    &lt;tns7:Identifier>&#xa;                        &lt;tns7:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                        &lt;/tns7:ServiceName>&#xa;                        &lt;tns7:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns7:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns7:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns7:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns7:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns7:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns7:EventType>&#xa;                        &lt;tns7:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns7:trackID>&#xa;                    &lt;/tns7:Identifier>&#xa;                    &lt;tns7:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns7:track_position>&#xa;                    &lt;tns7:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns7:Timestamp>&#xa;                &lt;/tns7:Envelope>&#xa;                &lt;tns7:Playload>&#xa;                    &lt;tns7:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(concat(tib:render-xml($post.item),&amp;quot;-&amp;quot;,tib:render-xml($post.parameters))))&quot;/>&#xa;                    &lt;/tns7:Binary>&#xa;                    &lt;tns7:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;concat(tib:render-xml($post.item),&amp;quot;-&amp;quot;,tib:render-xml($post.parameters))&quot;/>&#xa;                    &lt;/tns7:XMLString>&#xa;                &lt;/tns7:Playload>&#xa;            &lt;/tns7:ActiveLoggerServices>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
