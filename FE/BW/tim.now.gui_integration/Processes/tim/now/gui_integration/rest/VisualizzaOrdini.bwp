                      &lt;xsl:value-of select=&quot;substring-before(xsd:string(TIMSTP_AGGTO),'T')&quot;/>&#xa;                            &lt;/tns26:dataUltimaModifica>&#xa;                            &lt;tns26:dataInserimento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(TIMSTP_INSMTO),'T')&quot;/>&#xa;                            &lt;/tns26:dataInserimento>&#xa;                            &lt;tns26:dataTimeoutAccettazione>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(xsd:string(TIMSTP_TIMEOUT_ACCETTAZIONE),'T')&quot;/>&#xa;                            &lt;/tns26:dataTimeoutAccettazione>&#xa;                            &lt;xsl:if test=&quot;DESCR_ARTICOLO_GUI&quot;>&#xa;                                &lt;tns26:descrizioneArticolo>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_ARTICOLO_GUI&quot;/>&#xa;                                &lt;/tns26:descrizioneArticolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(IMPORTO_ARTICOLO)&quot;>&#xa;                                &lt;tns26:importoArticolo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns26:importoArticolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists(QT_ARTICOLO)&quot;>&#xa;                                &lt;tns26:quantitaArticolo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(QT_ARTICOLO)&quot;/>&#xa;                                &lt;/tns26:quantitaArticolo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns26:prezziEspostiIn>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;€&amp;quot;&quot;/>&#xa;                            &lt;/tns26:prezziEspostiIn>&#xa;                        &lt;/tns26:Lista_Output_Preventivo>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns26:result>&#xa;                        &lt;tns26:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns26:severity>&#xa;                        &lt;tns26:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns26:code>&#xa;                    &lt;/tns26:result>&#xa;                &lt;/tns26:Output_Preventivo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns26:Output_Preventivo>&#xa;                    &lt;tns26:result>&#xa;                        &lt;tns26:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns26:severity>&#xa;                        &lt;tns26:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns26:code>&#xa;                        &lt;tns26:details>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;No record&amp;quot;&quot;/>&#xa;                        &lt;/tns26:details>&#xa;                    &lt;/tns26:result>&#xa;                &lt;/tns26:Output_Preventivo>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
