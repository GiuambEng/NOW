                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns20=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8d4ed130-3c3d-41e6-82a8-dea84273e9fe+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160421153118PLT/ConceptSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoCodOrdTIScartato&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoSedeCliente-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns20:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get1.parameters/Campo='CODICEORDINETI'&quot;>&#xa;                    &lt;CodOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$get1.parameters/Valore&quot;/>&#xa;                    &lt;/CodOrdine>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CodOrdine>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RecuperoCodOrdTIScartato/Record[1]/CODICEORDINETI)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoCodOrdTIScartato/Record[1]/CODICEORDINETI&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CodOrdine>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns20:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
