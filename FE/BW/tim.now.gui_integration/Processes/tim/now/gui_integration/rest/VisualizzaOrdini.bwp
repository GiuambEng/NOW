                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT S.CODICETOPONOMASTICA, S.INDIRIZZOESTESO, S.PIANO, S.PROVINCIA, S.SCALA, S.COMPLESSO, S.CAP, S.LOCALITA,&#xa;S.CODICEISTATCOMUNE, S.COMUNE, S.CODICEISTATPROVINCIA, S.TIPOLOGIASEDE, O.NOME, O.COGNOMERAGIONESOCIALE, O.CF, O.PIVA,&#xa;S.PARTICELLATOPONOMASTICA, S.VIA, S.CIVICO, S.INTERNO,&#xa;PR.DESCR_PROV AS PROVINCIA_TOPON,NC.CAP AS CAP_TOPON,V.COD_ISTAT_COMUNE AS CODICEISTATCOMUNE_TOPON,CL.DESCR_COMUNE AS COMUNE_TOPON,&#xa;PA.DESCR_PARTICELLA_TOPON AS PARTICELLATOPON_TOPON,V.COD_ISTAT_PROV AS CODICEISTATPROVINCIA_TOPON, V.DESCR_VIA AS VIA_TOPON, &#xa;NC.NUMERO_CIVICO AS CIVICO_TOPON&#xa;FROM&#xa;BDS_1_CASEDATA_ORDINE O&#xa;LEFT JOIN BDS_1_CASEDATA_SEDE S ON O.BDS_ID=S.ORDINE_SEDE_BDSID&#xa;LEFT JOIN NUMERO_CIVICO NC ON NC.COD_TOPON = S.CODICETOPONOMASTICA&#xa;LEFT JOIN VIA V ON NC.COD_STRADA = V.COD_STRADA&#xa;LEFT JOIN COMUNE_O_LOCALITA CL ON V.COD_COMUNE = CL.COD_COMUNE&#xa;LEFT JOIN PARTICELLA PA ON V.COD_PARTICELLA_TOPON = PA.COD_PARTICELLA_TOPON&#xa;LEFT JOIN PROV PR ON PR.COD_PROV = CL.COD_PROV&#xa;WHERE O.CODICEORDINETI = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

