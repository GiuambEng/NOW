                                  &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DRO), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DRO>&#xa;                                &lt;tns2:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DAC),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DAC>&#xa;                                &lt;tns2:DACRimodulata>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DACRIMODULATA), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DACRimodulata>&#xa;                                &lt;tns2:DataEspletamentoTecnico>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DES),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataEspletamentoTecnico>&#xa;                                &lt;tns2:DataEspletamentoCommerciale>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DEC), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataEspletamentoCommerciale>&#xa;                                &lt;tns2:DAD>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DAD),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DAD>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/FASCIA_ORARIA&quot;>&#xa;                                    &lt;tns2:FasciaOraria>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/FASCIA_ORARIA&quot;/>&#xa;                                    &lt;/tns2:FasciaOraria>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns2:DataInvioOrdineDelivery>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DATAINVIOORDINEADELIVERY), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataInvioOrdineDelivery>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/IDULLCO&quot;>&#xa;                                    &lt;tns2:IDULLCO>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/IDULLCO&quot;/>&#xa;                                    &lt;/tns2:IDULLCO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/NUMEROVERDEOLOPT&quot;>&#xa;                                    &lt;tns2:NumeroVerdeOLOPT>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/NUMEROVERDEOLOPT&quot;/>&#xa;                                    &lt;/tns2:NumeroVerdeOLOPT>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/NUMEROVERDEOLOCOLLAUDO&quot;>&#xa;                                    &lt;tns2:NumeroVerdeOLOCollaudo>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/NUMEROVERDEOLOCOLLAUDO&quot;/>&#xa;                                    &lt;/tns2:NumeroVerdeOLOCollaudo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CLLI&quot;>&#xa;                                    &lt;tns2:Centrale>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CLLI&quot;/>&#xa;                                    &lt;/tns2:Centrale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/COD_GAT&quot;>&#xa;                                    &lt;tns2:CodiceGAT>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/COD_GAT&quot;/>&#xa;                                    &lt;/tns2:CodiceGAT>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/DNOLOCOLLAUDO&quot;>&#xa;                                    &lt;tns2:DNOloCollaudo>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/DNOLOCOLLAUDO&quot;/>&#xa;                                    &lt;/tns2:DNOloCollaudo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/IDSLUCO&quot;>&#xa;                                    &lt;tns2:IDSLUCO>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/IDSLUCO&quot;/>&#xa;                                    &lt;/tns2:IDSLUCO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns2:DADRimodulata>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DADRIMODULATA), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DADRimodulata>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$DettaglioOrdine/Record[1]/STATO_RICH_NOW_GUI='SOSPESO OPERE SPECIALI' and $DettaglioOrdine/Record[1]/STATO_RICH_OLO_GUI='SOSPESO' and  $DettaglioOrdine/Record[1]/OFFERTACATALOGO=&amp;#xD;&amp;#xA;('VULAFTTCAB','VULAFTTH','BITSTREAMATMASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMGBEASIMMETRICOFLAT', 'EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE' ,'BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','BITSTREAMATMSIMMETRICOFLAT','BITSTREAMATMSIMMETRICOHL','BITSTREAMGBESIMMETRICOFLAT','EASYIPUBBFTTCAB','EASYIPUBBFTTH', 'SEMIBITSTREAMNGAFTTH', 'SEMIVULAFTTH')&quot;>&#xa;                                        &lt;tns2:FlagPreventivo>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                        &lt;/tns2:FlagPreventivo>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:FlagPreventivo>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns2:FlagPreventivo>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/FLAGOPERESPECIALI&quot;>&#xa;                                    &lt;tns2:FlagOpereSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/FLAGOPERESPECIALI&quot;/>&#xa;                                    &lt;/tns2:FlagOpereSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/IDOFFERTA&quot;>&#xa;                                    &lt;tns2:IdOfferta>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/IDOFFERTA&quot;/>&#xa;                                    &lt;/tns2:IdOfferta>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;exists($DettaglioOrdine/Record[1]/DPS)&quot;>&#xa;                                    &lt;tns2:DataPrevistaSoluzione>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DPS),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns2:DataPrevistaSoluzione>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($DettaglioOrdine/Record[1]/FLAGATTESADESOSPOLO) =0&quot;>&#xa;                                        &lt;tns2:inAttesaDesospensioneDaOao>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                                        &lt;/tns2:inAttesaDesospensioneDaOao>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/FLAGATTESADESOSPOLO&quot;>&#xa;                                            &lt;tns2:inAttesaDesospensioneDaOao>&#xa;                                                &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/FLAGATTESADESOSPOLO&quot;/>&#xa;                                            &lt;/tns2:inAttesaDesospensioneDaOao>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/DUA&quot;>&#xa;                                    &lt;tns2:dataUltimoAppuntamento>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/DUA&quot;/>&#xa;                                    &lt;/tns2:dataUltimoAppuntamento>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/FASCIA_ORARIA_GUI&quot;>&#xa;                                    &lt;tns2:oraUltimoAppuntamento>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/FASCIA_ORARIA_GUI&quot;/>&#xa;                                    &lt;/tns2:oraUltimoAppuntamento>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/IDRISORSAOPERATORERETE&quot;>&#xa;                                    &lt;tns2:idRisorsaOperatoreRete>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/IDRISORSAOPERATORERETE&quot;/>&#xa;                                    &lt;/tns2:idRisorsaOperatoreRete>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CODICERISORSADONATING&quot;>&#xa;                                    &lt;tns2:codiceRisorsaDonating1>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CODICERISORSADONATING&quot;/>&#xa;                                    &lt;/tns2:codiceRisorsaDonating1>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CODICERISORSADONATING2&quot;>&#xa;                                    &lt;tns2:codiceRisorsaDonating2>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CODICERISORSADONATING2&quot;/>&#xa;                                    &lt;/tns2:codiceRisorsaDonating2>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CODICESESSIONE&quot;>&#xa;                                    &lt;tns2:codiceSessione1>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CODICESESSIONE&quot;/>&#xa;                                    &lt;/tns2:codiceSessione1>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CODICESESSIONE2&quot;>&#xa;                                    &lt;tns2:codiceSessione2>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CODICESESSIONE2&quot;/>&#xa;                                    &lt;/tns2:codiceSessione2>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/OPZIONEDINAMICA&quot;>&#xa;                                    &lt;tns2:opzioneDinamica>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/OPZIONEDINAMICA&quot;/>&#xa;                                    &lt;/tns2:opzioneDinamica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/IDCORRELAZIONE&quot;>&#xa;                                    &lt;tns2:identificativoCorrelazioni>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/IDCORRELAZIONE&quot;/>&#xa;                                    &lt;/tns2:identificativoCorrelazioni>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/RENDEZVOUS&quot;>&#xa;                                    &lt;tns2:rendezVous>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/RENDEZVOUS&quot;/>&#xa;                                    &lt;/tns2:rendezVous>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($RecuperoOpRete/Record[1]/STATO_OP_RETE) > 0 or string-length($RecuperoOpRete/Record[1]/STATO_OP_RETE_DG) > 0&quot;>&#xa;                                    &lt;tns2:dettagliAltroOperatoreRete>&#xa;                                        &lt;xsl:value-of select=&quot;concat($RecuperoOpRete/Record[1]/STATO_OP_RETE, &amp;quot;-&amp;quot;, $RecuperoOpRete/Record[1]/STATO_OP_RETE_DG)&quot;/>&#xa;                                    &lt;/tns2:dettagliAltroOperatoreRete>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/OPERATORERETE&quot;>&#xa;                                    &lt;tns2:operatoreRete>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/OPERATORERETE&quot;/>&#xa;                                    &lt;/tns2:operatoreRete>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns2:dettaglioordine>&#xa;                            &lt;tns2:clienteFinale>&#xa;                                &lt;xsl:if test=&quot;$RecuperoSedeCliente/Record[1]/NOME&quot;>&#xa;                                    &lt;tns2:nome>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoSedeCliente/Record[1]/NOME&quot;/>&#xa;                                    &lt;/tns2:nome>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoSedeCliente/Record[1]/COGNOMERAGIONESOCIALE&quot;>&#xa;                                    &lt;tns2:cognomeRagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoSedeCliente/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&#xa;                                    &lt;/tns2:cognomeRagioneSociale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoSedeCliente/Record[1]/CF&quot;>&#xa;                                    &lt;tns2:cf>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoSedeCliente/Record[1]/CF&quot;/>&#xa;                                    &lt;/tns2:cf>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RecuperoSedeCliente/Record[1]/PIVA&quot;>&#xa;                                    &lt;tns2:piva>&#xa;                                        &lt;xsl:value-of select=&quot;$RecuperoSedeCliente/Record[1]/PIVA&quot;/>&#xa;                                    &lt;/tns2:piva>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:for-each select=&quot;$RecuperoSedeCliente/Record&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists(TIPOLOGIASEDE) and TIPOLOGIASEDE='SEDECLIENTECERT'&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists(CODICETOPONOMASTICA) and string-length(CODICETOPONOMASTICA)>0&quot;>&#xa;                                                    &lt;tns2:sedeClienteFinale>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;string-length(CIVICO_TOPON) >0 and string-length(INTERNO) >0&quot;>&#xa;                                                                &lt;tns2:indirizzo>&#xa;                                                                    &lt;xsl:value-of select=&quot;concat(current()/PARTICELLATOPON_TOPON, ' ',current()/VIA_TOPON, ', ',current()/CIVICO_TOPON, ' - Int. ' ,current()/INTERNO)&quot;/>&#xa;                                                                &lt;/tns2:indirizzo>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:when test=&quot;string-length(CIVICO_TOPON) >0 and string-length(INTERNO) =0&quot;>&#xa;                                                                &lt;tns2:indirizzo>&#xa;                                                                    &lt;xsl:value-of select=&quot;concat(current()/PARTICELLATOPON_TOPON, ' ',current()/VIA_TOPON, ', ',current()/CIVICO_TOPON)&quot;/>&#xa;                                                                &lt;/tns2:indirizzo>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:when test=&quot;string-length(CIVICO_TOPON) =0 and string-length(INTERNO) >0&quot;>&#xa;                                                                &lt;tns2:indirizzo>&#xa;                                                                    &lt;xsl:value-of select=&quot;concat(current()/PARTICELLATOPON_TOPON, ' ',current()/VIA_TOPON, ' - Int. ' ,current()/INTERNO)&quot;/>&#xa;                                                                &lt;/tns2:indirizzo>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;tns2:indirizzo>&#xa;                                                                    &lt;xsl:value-of select=&quot;concat(current()/PARTICELLATOPON_TOPON, ' ',current()/VIA_TOPON)&quot;/>&#xa;                                                                &lt;/tns2:indirizzo>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                        &lt;xsl:if test=&quot;PIANO&quot;>&#xa;                                                            &lt;tns2:piano>&#xa;                                                                &lt;xsl:value-of select=&quot;PIANO&quot;/>&#xa;                                                            &lt;/tns2:piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;PROVINCIA_TOPON&quot;>&#xa;                                                            &lt;tns2:provincia>&#xa;                                                                &lt;xsl:value-of select=&quot;PROVINCIA_TOPON&quot;/>&#xa;                                                            &lt;/tns2:provincia>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;SCALA&quot;>&#xa;                                                            &lt;tns2:scala>&#xa;                                                                &lt;xsl:value-of select=&quot;SCALA&quot;/>&#xa;                                                            &lt;/tns2:scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;COMPLESSO&quot;>&#xa;                                                            &lt;tns2:complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;COMPLESSO&quot;/>&#xa;                                                            &lt;/tns2:complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;CAP_TOPON&quot;>&#xa;                                                            &lt;tns2:cap>&#xa;                                                                &lt;xsl:value-of select=&quot;CAP_TOPON&quot;/>&#xa;                                                            &lt;/tns2:cap>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;LOCALITA&quot;>&#xa;                                                            &lt;tns2:localita>&#xa;                                                                &lt;xsl:value-of select=&quot;LOCALITA&quot;/>&#xa;                                                            &lt;/tns2:localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;CODICEISTATCOMUNE_TOPON&quot;>&#xa;                                                            &lt;tns2:codiceIstatcomune>&#xa;                                                                &lt;xsl:value-of select=&quot;CODICEISTATCOMUNE_TOPON&quot;/>&#xa;                                                            &lt;/tns2:codiceIstatcomune>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;COMUNE_TOPON&quot;>&#xa;                                                            &lt;tns2:comune>&#xa;                                                                &lt;xsl:value-of select=&quot;COMUNE_TOPON&quot;/>&#xa;                                                            &lt;/tns2:comune>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;CODICEISTATPROVINCIA_TOPON&quot;>&#xa;                                                            &lt;tns2:codiceIstatProvincia>&#xa;                                                                &lt;xsl:value-of select=&quot;CODICEISTATPROVINCIA_TOPON&quot;/>&#xa;                                                            &lt;/tns2:codiceIstatProvincia>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;TIPOLOGIASEDE&quot;>&#xa;                                                            &lt;tns2:tipologiaSede>&#xa;                                                                &lt;xsl:value-of select=&quot;TIPOLOGIASEDE&quot;/>&#xa;                                                            &lt;/tns2:tipologiaSede>&#xa;          