                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ab25b677-6f32-4539-9e93-be0f348ae504+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;SPListaOrdini-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:inputs>&#xa;            &lt;inputSet>&#xa;                &lt;TIPOLISTA>&#xa;                    &lt;xsl:value-of select=&quot;$get/parameters/tns:visualizzaordiniGetParameters/tns:tipoLista&quot;/>&#xa;                &lt;/TIPOLISTA>&#xa;                &lt;PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;$get/parameters/tns:visualizzaordiniGetParameters/tns:tipoProfilo&quot;/>&#xa;                &lt;/PROFILO>&#xa;                &lt;CODOLO>&#xa;                    &lt;xsl:value-of select=&quot;$get/parameters/tns:visualizzaordiniGetParameters/tns:CodOlo&quot;/>&#xa;                &lt;/CODOLO>&#xa;                &lt;RICERCAAVANZATA xsi:nil=&quot;true&quot;/>&#xa;                &lt;NUMRECORD>&#xa;                    &lt;xsl:value-of select=&quot;$MaxRows&quot;/>&#xa;                &lt;/NUMRECORD>&#xa;            &lt;/inputSet>&#xa;        &lt;/tns5:inputs>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SPListaOrdini-input"
