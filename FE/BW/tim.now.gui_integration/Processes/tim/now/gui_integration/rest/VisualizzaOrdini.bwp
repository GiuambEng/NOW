                        &lt;/tns2:details&gt;
                    &lt;/tns2:result&gt;
                &lt;/tns2:OutputOrdersListNoOlo&gt;
            &lt;/item&gt;
        &lt;/tns6:getResponse1&gt;
    &lt;/xsl:template&gt;
