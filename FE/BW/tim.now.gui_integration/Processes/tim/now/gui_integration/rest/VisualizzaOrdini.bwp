                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;  RE.PROGRESSIVOREFERENTE, RE.QUALIFICAREFERENTE, RE.COGNOMEREFERENTE,&#xa;  RE.NOMEREFERENTE, RE.TELEFONOFISSOREFERENTE, RE.TELEFONOMOBILEREFERENTE,&#xa;  RE.CREATED, RE.LASTUPDATE, RE.TIPOREFERENTEORDINE, RE.EMAILREFERENTE,RE.REFOAOPROGETTISPECIALI&#xa;  FROM&#xa;       BDS_1_CASEDATA_ORDINE O LEFT JOIN BDS_1_CASEDATA_REFERENTE RE ON RE.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;WHERE O.CODICEORDINETI = ? &#xa;AND RE.TIPOREFERENTEORDINE IN ('REFERENTEONFIELD','REFERENTE','REFERENTEOAOPROGETTISPECIALI')" xsi:type="jdbcPalette:JDBCQueryActivity">

