e>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string(CODICEORDINEOPENFIBER/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINEOPENFIBER/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINEOPENFIBER)&quot;>&lt;tns2:codOrdineOF>&lt;xsl:value-of select=&quot;CODICEORDINEOPENFIBER&quot;/>&lt;/tns2:codOrdineOF>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(IDRISORSAOPENFIBER/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(IDRISORSAOPENFIBER/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(IDRISORSAOPENFIBER)&quot;>&lt;tns2:idRisorsaOF>&lt;xsl:value-of select=&quot;IDRISORSAOPENFIBER&quot;/>&lt;/tns2:idRisorsaOF>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(STATORICHIESTAOF/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(STATORICHIESTAOF/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(STATORICHIESTAOF)&quot;>&lt;tns2:statoOF>&lt;xsl:value-of select=&quot;STATORICHIESTAOF&quot;/>&lt;/tns2:statoOF>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(NOTEFIBERSTREAM/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(NOTEFIBERSTREAM/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(NOTEFIBERSTREAM)&quot;>&lt;tns2:noteFiberstream>&lt;xsl:value-of select=&quot;NOTEFIBERSTREAM&quot;/>&lt;/tns2:noteFiberstream>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(SOTTOLAVORAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(SOTTOLAVORAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(SOTTOLAVORAZIONE)&quot;>&lt;tns2:sottolavorazione>&lt;xsl:value-of select=&quot;SOTTOLAVORAZIONE&quot;/>&lt;/tns2:sottolavorazione>&lt;/xsl:if>&lt;/tns2:OutputListaOrdiniNoOLO>&lt;/xsl:for-each>&lt;tns2:result>&lt;tns2:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns2:severity>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SPListaOrdiniAVANZ/outputSet/RESULTSET/APPUSER.LISTAORDINI)&amp;lt;$MaxRows&quot;>&lt;tns2:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:code>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:code>&lt;xsl:value-of select=&quot;'LIMIT'&quot;/>&lt;/tns2:code>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:result>&lt;/tns2:OutputOrdersListNoOlo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:OutputOrdersListNoOlo>&lt;xsl:for-each select=&quot;$SPListaOrdiniAVANZ/outputSet/RESULTSET/APPUSER.LISTAORDINI&quot;>&lt;tns2:OutputListaOrdiniNoOLO>&lt;xsl:if test=&quot;not((string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINEOLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINEOLO)&quot;>&lt;tns2:codiceordineolo>&lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&lt;/tns2:codiceordineolo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODIFICAOLONOW/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLONOW/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLONOW)&quot;>&lt;tns2:cod_olo_now>&lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&lt;/tns2:cod_olo_now>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(COD_CAUS_OLO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(COD_CAUS_OLO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(COD_CAUS_OLO)&quot;>&lt;tns2:cod_causal_olo>&lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&lt;/tns2:cod_causal_olo>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(TIPORICHIESTA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(TIPORICHIESTA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(TIPORICHIESTA)&quot;>&lt;tns2:tipoRichiesta>&lt;xsl:value-of select=&quot;TIPORICHIESTA&quot;/>&lt;/tns2:tipoRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODICEORDINETI/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODICEORDINETI/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODICEORDINETI)&quot;>&lt;tns2:codiceordineti>&lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&lt;/tns2:codiceordineti>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(CODIFICAOLOAGCOM/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(CODIFICAOLOAGCOM)&quot;>&lt;tns2:codfc_olo_agcom>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tn