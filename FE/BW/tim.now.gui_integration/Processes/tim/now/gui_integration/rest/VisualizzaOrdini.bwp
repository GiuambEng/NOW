                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4678610c-6d22-4b90-b182-08fe0b19bbf3+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns26:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns:visualizzaordiniPostParameters/tns:CodOlo&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom1>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns:visualizzaordiniPostParameters/tns:CodOlo&quot;/>&#xa;            &lt;/codOloAgcom1>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$post/parameters/tns:visualizzaordiniPostParameters/tns:CodOlo&quot;/>&#xa;            &lt;/codOloAgcom2>&#xa;            &lt;codiceOrdineOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post/item/tns2:InputOrderServizioricercaAvannzata/tns2:strutturaCondition[1]/tns2:valore)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post/item/tns2:InputOrderServizioricercaAvannzata/tns2:strutturaCondition[1]/tns2:valore&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codiceOrdineOlo>&#xa;        &lt;/tns26:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CRM_OPCC-input"
                                    name="CRM_OPCC"
                                    outputVariable="CRM_OPCC"
                                    tibex:xpdlId="4678610c-6d22-4b90-b182-08fe0b19bbf3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RicercaAvanzataToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToListaOrdiniAVANZ"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4678610c-6d22-4b90-b182-08fe0b19bbf3+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns26:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns:CodOlo&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;codOloAgcom1>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns:CodOlo&quot;/>&#xa;            &lt;/codOloAgcom1>&#xa;            &lt;codOloAgcom2>&#xa;                &lt;xsl:value-of select=&quot;$post.parameters/tns:CodOlo&quot;/>&#xa;            &lt;/codOloAgcom2>&#xa;            &lt;codiceOrdineOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns2:strutturaCondition[1]/tns2:valore)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns2:strutturaCondition[1]/tns2:valore&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codiceOrdineOlo>&#xa;        &lt;/tns26:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT (SELECT DISTINCT TRO.STATO_RICH_OLO_GUI&#xa;&#x9;FROM appuser.TIPOLG_RICH_COMSTOLO TRO&#xa;&#x9;WHERE R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO)&#xa;&#x9;AS STATO_RICH_OLO_GUI,&#xa;&#x9;R.DATAINVIORICHIESTA,&#xa;&#x9;R.CODIFICAOLONOW,&#xa;&#x9;R.TIPORICHIESTA,&#xa;&#x9;R.CODICEORDINEOLO,&#xa;&#x9;R.CODIFICAOLOAGCOM,&#xa;&#x9;R.CODICEORDINETI,&#xa;&#x9;R.CANALERICHIESTA,&#xa;&#x9;AC.COD_CAUS_OLO,&#xa;&#x9;R.IDRICHIESTAOLO,&#xa;&#x9;TRN.STATO_RICH_NOW_GUI,&#xa;&#x9;R.FLAGOPERESPECIALI,&#xa;&#x9;R.IDOFFERTA,&#xa;&#x9;R.OFFERTA,&#xa;&#x9;R.LASTUPDATE,&#xa;&#x9;R.IDRISORSA,&#xa;&#x9;R.LAVORAZIONE,&#xa;&#x9;R.FLAGATTESADESOSPOLO&#xa;&#x9;FROM (SELECT /*+ FULL (a) */ * FROM appuser.BDS_1_CASEDATA_RICHIESTA A WHERE 1 = 1 AND  A.CODIFICAOLOAGCOM  IN (SELECT CODFC_OLO_AGCOM FROM appuser.OLO WHERE CODFC_OLO_AGCOM = ? OR COD_OLO_ACCORPANTE = ? OR COD_OLO = (SELECT COD_OLO FROM appuser.OLO WHERE CODFC_OLO_AGCOM = ?))) R&#xa;    LEFT JOIN appuser.ANAG_CAUS AC ON AC.ID_ANAG_CAUS = R.IDANAGRAFICACAUSALEGUI&#xa;&#x9;LEFT OUTER JOIN appuser.TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW&#xa;&#x9;LEFT JOIN appuser.BDS_1_CASEDATA_SEDE S ON S.IDRICHIESTAOLO=R.IDRICHIESTAOLO AND S.TIPOLOGIASEDE != 'SEDECLIENTECERT' AND S.TIPOLOGIASEDE != 'SEDECLIENTEOLD'&#xa;&#x9;LEFT JOIN appuser.BDS_1_CASEDATA_ORDINE RO ON RO.IDRICHIESTAOLO=R.IDRICHIESTAOLO&#xa;&#x9;LEFT JOIN appuser.CLC_IDULLCO CLC_ID ON CLC_ID.IDULLCO = RO.IDULLCO AND (CLC_ID.DATAFI_VALID IS NULL OR (SYSDATE &lt; CLC_ID.DATAFI_VALID))&#xa;    WHERE R.TIPORICHIESTA = 'ORDINE' AND R.AMBITO = 'NOW' AND (R.TIPOLOGIASOTTOLAV != 'ACCORPAMENTOOLO' OR R.TIPOLOGIASOTTOLAV IS NULL)&#xa;    AND R.CODICEORDINEOLO = ?&#xa;    ORDER BY R.LASTUPDATE DESC&#xa;&#x9;FETCH FIRST 500 ROWS ONLY&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codiceOrdineOlo"/>
                                    <columnMetadata
                                    columnName="STATO_RICH_OLO_GUI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINVIORICHIESTA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLONOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPORICHIESTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINETI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CANALERICHIESTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_RICH_NOW_GUI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAGOPERESPECIALI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDOFFERTA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LASTUPDATE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAGATTESADESOSPOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JavaInvoke-input"
                                    name="JavaInvoke"
                                    outputVariable="JavaInvoke"
                                    tibex:xpdlId="d9c7e1fa-fc8c-4e3b-8cc8-adc94a5524e6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
