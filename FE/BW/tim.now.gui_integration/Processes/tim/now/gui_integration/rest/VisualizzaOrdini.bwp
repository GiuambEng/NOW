_NOW_DG&quot;>&lt;tns2:codiceCausaleNow>&lt;xsl:value-of select=&quot;COD_CAUS_NOW_DG&quot;/>&lt;/tns2:codiceCausaleNow>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;FLGABILITAZGUIMANUALOF='SI' and IDOFFERTA=75&quot;>&lt;xsl:if test=&quot;$AnagCausLavManOF/Record[1]/COD_CAUS_OLO&quot;>&lt;tns2:codiceCausaleOao>&lt;xsl:value-of select=&quot;$AnagCausLavManOF/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns2:codiceCausaleOao>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;COD_CAUS_OLO&quot;>&lt;tns2:codiceCausaleOao>&lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&lt;/tns2:codiceCausaleOao>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;FLGABILITAZGUIMANUALOF='SI' and IDOFFERTA=75&quot;>&lt;xsl:if test=&quot;$AnagCausLavManOF/Record[1]/DESCR_CAUS_OLO&quot;>&lt;tns2:causaleOao>&lt;xsl:value-of select=&quot;$AnagCausLavManOF/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns2:causaleOao>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&lt;tns2:causaleOao>&lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&lt;/tns2:causaleOao>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;FLGABILITAZGUIMANUALOF='SI' and IDOFFERTA=75&quot;>&lt;xsl:if test=&quot;$AnagCausLavManOF/Record[1]/DESCR_CAUS_NOW_DG&quot;>&lt;tns2:descrizioneCausaleNow>&lt;xsl:value-of select=&quot;$AnagCausLavManOF/Record[1]/DESCR_CAUS_NOW_DG&quot;/>&lt;/tns2:descrizioneCausaleNow>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;DESCR_CAUS_NOW_DG&quot;>&lt;tns2:descrizioneCausaleNow>&lt;xsl:value-of select=&quot;DESCR_CAUS_NOW_DG&quot;/>&lt;/tns2:descrizioneCausaleNow>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns2:idRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns2:idRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSANOW&quot;>&lt;tns2:idRisorsaNow>&lt;xsl:value-of select=&quot;IDRISORSANOW&quot;/>&lt;/tns2:idRisorsaNow>&lt;/xsl:if>&lt;tns2:dac>&lt;xsl:value-of select=&quot;substring-before(string(DAC),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns2:dac>&lt;tns2:des>&lt;xsl:value-of select=&quot;substring-before(string(DES),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns2:des>&lt;xsl:if test=&quot;CODICEORDINEOLOPADRE&quot;>&lt;tns2:codiceOrdineOloPadre>&lt;xsl:value-of select=&quot;CODICEORDINEOLOPADRE&quot;/>&lt;/tns2:codiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOLOTARGET&quot;>&lt;tns2:codiceOrdineOloTarget>&lt;xsl:value-of select=&quot;CODICEORDINEOLOTARGET&quot;/>&lt;/tns2:codiceOrdineOloTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEPROGETTO&quot;>&lt;tns2:codiceProgetto>&lt;xsl:value-of select=&quot;CODICEPROGETTO&quot;/>&lt;/tns2:codiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;FLAGNAKED&quot;>&lt;tns2:flagNaked>&lt;xsl:value-of select=&quot;FLAGNAKED&quot;/>&lt;/tns2:flagNaked>&lt;/xsl:if>&lt;xsl:if test=&quot;LAVORAZIONE&quot;>&lt;tns2:lavorazioneRichiesta>&lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&lt;/tns2:lavorazioneRichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;TESTMODE&quot;>&lt;tns2:testMode>&lt;xsl:value-of select=&quot;TESTMODE&quot;/>&lt;/tns2:testMode>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(LASTUPDATE), &amp;quot;.&amp;quot;)&quot;>&lt;tns2:timestampAggiornamento>&lt;xsl:value-of select=&quot;concat(substring-before(string(LASTUPDATE),'.'), '+',substring-after(string(LASTUPDATE), '+'))&quot;/>&lt;/tns2:timestampAggiornamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:timestampAggiornamento>&lt;xsl:value-of select=&quot;string(LASTUPDATE)&quot;/>&lt;/tns2:timestampAggiornamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:timestampInserimento>&lt;xsl:value-of select=&quot;substring-before(string(CREATED),&amp;quot;T&amp;quot;)&quot;/>&lt;/tns2:timestampInserimento>&lt;xsl:if test=&quot;CODIFICAOLOAGCOMDONATING&quot;>&lt;tns2:oaoDonating>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOMDONATING&quot;/>&lt;/tns2:oaoDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOMDONOR&quot;>&lt;tns2:oaoDonor>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOMDONOR&quot;/>&lt;/tns2:oaoDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;IDOFFERTA&quot;>&lt;tns2:idOfferta>&lt;xsl:value-of select=&quot;IDOFFERTA&quot;/>&lt;/tns2:idOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_SCENARIO&quot;>&lt;tns2:descrizioneScenario>&lt;xsl:value-of select=&quot;DESCR_SCENARIO&quot;/>&lt;/tns2:descrizioneScenario>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$NumTelefAgg/Record&quot;>&lt;tns2:numeroTelefonicoAggiuntivo>&lt;xsl:value-of select=&quot;NUMEROTELEFONICOAGGIUNTIVO&quot;/>&lt;/tns2:numeroTelefonicoAggiuntivo>&lt;/xsl:for-each>&lt;xsl:if test=&quot;DISAGGREGATO&quot;>&lt;tns2:disaggregato>&lt;xsl:value-of select=&quot;DISAGGREGATO&quot;/>&lt;/tns2:disaggregato>&lt;/xsl:if>&lt;xsl:if test=&quot;EXDISAGGREGATO&quot;>&lt;tns2:exDisaggregato>&lt;xsl:value-of select=&quot;EXDISAGGREGATO&quot;/>&lt;/tns2:exDisaggregato>&lt;/xsl:if>&lt;xsl:if test=&quot;ORDINEASSETWHITELIST&quot;>&lt;tns2:ordineAssetWhiteList>&lt;xsl:value-of select=&quot;ORDINEASSETWHITELIST&quot;/>&lt;/tns2:ordineAssetWhiteList>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Referenti/Record[TIPOREFERENTEORDINE = 'REFERENTEOAOPROGETTISPECIALI'])&quot;>&lt;xsl:if test=&quot;$Referenti/Record[TIPOREFERENTEORDINE = 'REFERENTEOAOPROGETTISPECIALI']/REFOAOPROGETTISPECIALI&quot;>&lt;tns2:refOaoProgettiSpeciali>&lt;xsl:value-of select=&quot;$Referenti/Record[TIPOREFERENTEORDINE = 'REFERENTEOAOPROGETTISPECIALI']/REFOAOPROGETTISPECIALI&quot;/>&lt;/tns2:refOaoProgettiSpeciali>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICEORDINEOPENFIBER&quot;>&lt;tns2:codiceOrdineOF>&lt;xsl:value-of select=&quot;CODICEORDINEOPENFIBER&quot;/>&lt;/tns2:codiceOrdineOF>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSAOPENFIBER&quot;>&lt;tns2:idRisorsaOF>&lt;xsl:value-of select=&quot;IDRISORSAOPENFIBER&quot;/>&lt;/tns2:idRisorsaOF>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOF&quot;>&lt;tns2:statoOF>&lt;xsl:value-of select=&quot;STATORICHIESTAOF&quot;/>&lt;/tns2:statoOF>&lt;/xsl:if>&lt;xsl:if test=&quot;NOTEFIBERSTREAM&quot;>&lt;tns2:noteOF>&lt;xsl:value-of select=&quot;NOTEFIBERSTREAM&quot;/>&lt;/tns2:noteOF>&lt;/xsl:if>&lt;xsl:if test=&quot;FLGABILITAZGUIMANUALOF&quot;>&lt;tns2:flagAbilitazioneGuiManualOF>&lt;xsl:value-of select=&quot;FLGABILITAZGUIMANUALOF&quot;/>&lt;/tns2:flagAbilitazioneGuiManualOF>&lt;/xsl:if>&lt;xsl:if test=&quot;CARATTERIZZAZIONEAREA&quot;>&lt;tns2:caratterizzazioneArea>&lt;xsl:value-of select=&quot;CARATTERIZZAZIONEAREA&quot;/>&lt;/tns2:caratterizzazioneArea>&lt;/xsl:if>&lt;/tns2:OutputDatiOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:OutputDatiOrdine>&lt;tns2:idrichiestaolo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns2:idrichiestaolo>&lt;tns2:codiceordineTInonvalorizzato>&lt;xsl:if test=&quot;RDNOME&quot;>&lt;tns2:nome>&lt;xsl:value-of select=&quot;RDNOME&quot;/>&lt;/tns2:nome>&lt;/xsl:if>&lt;tns2:progressivo>&lt;xsl:value-of select=&quot;xsd:int(PROGRS_TIPOLG_DATO_RICH)&quot;/>&lt;/tns2:progressivo>&lt;xsl:if test=&quot;IDTPLG_DATO_RICH&quot;>&lt;tns2:tipologiadatorichiesta>&lt;xsl:value-of select=&quot;IDTPLG_DATO_RICH&quot;/>&lt;/tns2:tipologiadatorichiesta>&lt;/xsl:if>&lt;xsl:if test=&quot;VALORE&quot;>&lt;tns2:richiestadettagliovalore>&lt;xsl:value-of select=&quot;VALORE&quot;/>&lt;/tns2:richiestadettagliovalore>&lt;/xsl:if>&lt;/tns2:codiceordineTInonvalorizzato>&lt;/tns2:OutputDatiOrdine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;tns2:result>&lt;tns2:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns2:severity>&lt;tns2:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns2:code>&lt;/tns2:result>&lt;/tns2:OutputOrdersData>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ordinidataoutput"
                                    name="Assign"
                                    outputVariable="ordinidataoutput"
                                    tibex:xpdlId="832be70a-499f-49ae-b15e-7ab49fe542b3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/Orders&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/Orders&quot; xmlns:tns1=&quot;http://xmlns.example.com/20160421153118PLT/ConceptSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Servizio.parametersOutputService&quot;/>&#xa;    &lt;xsl:param name=&quot;OrdiniData&quot;/>&#xa;    &lt;xsl:param name=&quot;Referenti&quot;/>&#xa;    &lt;xsl:param name=&quot;DettaglioOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoSedeCliente&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoAttributiDettaglioOrdini&quot;/>&#xa;    &lt;xsl:param name=&quot;Profilo&quot;/>&#xa;    &lt;xsl:param name=&quot;NumTelefAgg&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOpRete&quot;/>&#xa;    &lt;xsl:param name=&quot;AnagCausLavManOF&quot;/>&#xa;    &lt;xsl:template name=&quot;ordinidataoutput&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:OutputOrdersData>&#xa;            &lt;xsl:for-each select=&quot;$OrdiniData/Record[1]&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($get1.parameters/Valore)>0&quot;>&#xa;                        &lt;tns2:OutputDatiOrdine>&#xa;                            &lt;xsl:variable name=&quot;currOfferta&quot; select=&quot;IDOFFERTA&quot;/>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINETI&quot;>&#xa;                                &lt;tns2:codiceOrdineTI>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINETI&quot;/>&#xa;                                &lt;/tns2:codiceOrdineTI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns2:codificaOloAgcom>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns2:codificaOloAgcom>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLONOW&quot;>&#xa;                                &lt;tns2:codiceOloNow>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLONOW&quot;/>&#xa;                                &lt;/tns2:codiceOloNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns2:idrichiestaolo>&#xa;                                &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                            &lt;/tns2:idrichiestaolo>&#xa;                            &lt;xsl:for-each select=&quot;$Servizio.parametersOutputService/tns3:OutputServizi&quot;>&#xa;                                &lt;tns2:servizi>&#xa;                                    &lt;xsl:for-each select=&quot;tns3:customizzazione/tns3:OutputVisualizzaCustomizzazione[tns3:AttributoCustomizzazione !='DESCR_BMD']&quot;>&#xa;                                        &lt;xsl:if test=&quot;tns3:AttributoCustomizzazione !='DATARESTITUZIONEPRODOTTI' or (tns3:AttributoCustomizzazione = 'DATARESTITUZIONEPRODOTTI' and tns3:ValoreCustomizzazione !='01-01-1900')&quot;>&#xa;                                            &lt;tns2:customizzazione>&#xa;                                                &lt;xsl:if test=&quot;tns3:AttributoCustomizzazione&quot;>&#xa;                                                    &lt;tns2:AttributoCustomizzazione>&#xa;                                                        &lt;xsl:value-of select=&quot;tns3:AttributoCustomizzazione&quot;/>&#xa;                                                    &lt;/tns2:AttributoCustomizzazione>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;tns3:AttributoCustomizzazione = 'PROFILOBMD'&quot;>&#xa;                                                        &lt;xsl:if test=&quot;current()/..[1]/tns3:OutputVisualizzaCustomizzazione[tns3:AttributoCustomizzazione='DESCR_BMD']/tns3:ValoreCustomizzazione&quot;>&#xa;                                                            &lt;tns2:ValoreCustomizzazione>&#xa;                                                                &lt;xsl:value-of select=&quot;current()/..[1]/tns3:OutputVisualizzaCustomizzazione[tns3:AttributoCustomizzazione='DESCR_BMD']/tns3:ValoreCustomizzazione&quot;/>&#xa;                                                            &lt;/tns2:ValoreCustomizzazione>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;tns3:AttributoCustomizzazione = 'TIPOOFFERTA' and $currOfferta=(70,71,72,73)&quot;>&#xa;                                                        &lt;tns2:ValoreCustomizzazione>&#xa;                                                            &lt;xsl:value-of select=&quot;'MULTICAST'&quot;/>&#xa;                                                        &lt;/tns2:ValoreCustomizzazione>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;xsl:if test=&quot;tns3:ValoreCustomizzazione&quot;>&#xa;                                                            &lt;tns2:ValoreCustomizzazione>&#xa;                                                                &lt;xsl:value-of select=&quot;tns3:ValoreCustomizzazione&quot;/>&#xa;                                                            &lt;/tns2:ValoreCustomizzazione>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;xsl:if test=&quot;tns3:ValoreOldCustomizzazione&quot;>&#xa;                                                    &lt;tns2:ValoreOldCustomizzazione>&#xa;                                                        &lt;xsl:value-of select=&quot;tns3:ValoreOldCustomizzazione&quot;/>&#xa;                                                    &lt;/tns2:ValoreOldCustomizzazione>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/tns2:customizzazione>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:if test=&quot;tns3:Prodotto&quot;>&#xa;                                        &lt;tns2:Prodotto>&#xa;                                            &lt;xsl:value-of select=&quot;tns3:Prodotto&quot;/>&#xa;                                        &lt;/tns2:Prodotto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;tns3:Azione&quot;>&#xa;                                        &lt;tns2:Azione>&#xa;                                            &lt;xsl:value-of select=&quot;tns3:Azione&quot;/>&#xa;                                        &lt;/tns2:Azione>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;tns3:CodiceTI&quot;>&#xa;                                        &lt;tns2:CodiceTI>&#xa;                                            &lt;xsl:value-of select=&quot;tns3:CodiceTI&quot;/>&#xa;                                        &lt;/tns2:CodiceTI>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;string-length(tns3:DAC)>0&quot;>&#xa;                                        &lt;tns2:DAC>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(string(tns3:DAC), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                        &lt;/tns2:DAC>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns2:servizi>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:for-each select=&quot;$Referenti/Record[TIPOREFERENTEORDINE !='REFERENTEOAOPROGETTISPECIALI']&quot;>&#xa;                                &lt;tns2:referenti>&#xa;                                    &lt;xsl:if test=&quot;NOMEREFERENTE&quot;>&#xa;                                        &lt;tns2:Nome>&#xa;                                            &lt;xsl:value-of select=&quot;NOMEREFERENTE&quot;/>&#xa;                                        &lt;/tns2:Nome>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;COGNOMEREFERENTE&quot;>&#xa;                                        &lt;tns2:Cognome>&#xa;                                            &lt;xsl:value-of select=&quot;COGNOMEREFERENTE&quot;/>&#xa;                                        &lt;/tns2:Cognome>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TELEFONOFISSOREFERENTE&quot;>&#xa;                                        &lt;tns2:Telefono>&#xa;                                            &lt;xsl:value-of select=&quot;TELEFONOFISSOREFERENTE&quot;/>&#xa;                                        &lt;/tns2:Telefono>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TELEFONOMOBILEREFERENTE&quot;>&#xa;                                        &lt;tns2:Cellulare>&#xa;                                            &lt;xsl:value-of select=&quot;TELEFONOMOBILEREFERENTE&quot;/>&#xa;                                        &lt;/tns2:Cellulare>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;QUALIFICAREFERENTE&quot;>&#xa;                                        &lt;tns2:Qualifica>&#xa;                                            &lt;xsl:value-of select=&quot;QUALIFICAREFERENTE&quot;/>&#xa;                                        &lt;/tns2:Qualifica>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;TIPOREFERENTEORDINE = 'REFERENTEONFIELD'&quot;>&#xa;                                            &lt;tns2:onfield>&#xa;                                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                                            &lt;/tns2:onfield>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns2:onfield>&#xa;                                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                            &lt;/tns2:onfield>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;PROGRESSIVOREFERENTE&quot;>&#xa;                                        &lt;tns2:progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;PROGRESSIVOREFERENTE&quot;/>&#xa;                                        &lt;/tns2:progressivo>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns2:dataUltimoAggiornamento>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before(string(LASTUPDATE), &amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns2:dataUltimoAggiornamento>&#xa;                                    &lt;tns2:dataInserimento>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before(string(CREATED),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                    &lt;/tns2:dataInserimento>&#xa;                                    &lt;xsl:if test=&quot;EMAILREFERENTE&quot;>&#xa;                                        &lt;tns2:email>&#xa;                                            &lt;xsl:value-of select=&quot;EMAILREFERENTE&quot;/>&#xa;                                        &lt;/tns2:email>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns2:referenti>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns2:dettaglioordine>&#xa;                                &lt;xsl:if test=&quot;$Profilo!=&amp;quot;CRM_OLO&amp;quot;&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/COD_CAUS_NOW_DG&quot;>&#xa;                                        &lt;tns2:CodiceCausaleNOW>&#xa;                                            &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/COD_CAUS_NOW_DG&quot;/>&#xa;                                        &lt;/tns2:CodiceCausaleNOW>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/COD_CAUS_OLO&quot;>&#xa;                                    &lt;tns2:CodiceCausaleOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                    &lt;/tns2:CodiceCausaleOLO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/DESCR_CAUS_OLO&quo