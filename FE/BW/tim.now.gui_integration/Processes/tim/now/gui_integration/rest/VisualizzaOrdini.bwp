                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT C.FLAG_CONTRIBUTO_CLIENTE, C.FLAG_OLTRE_PERIMETRO_ABITATO, C.FLAG_PERMESSI, C.IMPORTO_TOT, C.NOTE_PREVENTIVO, &#xa;C.NUMERO_GIORNI_PREVISTO, C.TIMSTP_INSMTO&#xa;FROM CONSUNTIVO C&#xa;LEFT JOIN DETT_CONSUNTIVO DC ON C.ID_CONSUNTIVO = DC.ID_CONSUNTIVO&#xa;LEFT JOIN TRASCODFC_ARTICOLI_DTU_JPUB T ON DC.COD_ARTICOLO_JPUB = T.COD_ARTICOLO_JPUB&#xa;WHERE ID_RICH_OLO = ?&#xa;AND DC.ID_DETT_CONSUNTIVO = (SELECT MAX(DC.ID_DETT_CONSUNTIVO) FROM DETT_CONSUNTIVO&#xa;WHERE DC.ID_CONSUNTIVO = C.ID_CONSUNTIVO)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRichiestaOlo"/>
                                    <columnMetadata
                                    columnName="FLAG_CONTRIBUTO_CLIENTE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_OLTRE_PERIMETRO_ABITATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_PERMESSI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IMPORTO_TOT"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOTE_PREVENTIVO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMERO_GIORNI_PREVISTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
