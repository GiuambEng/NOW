                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT&#xa;    (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,TSL.TIPOLG_SOTTO_LAVRZ_GUI,TL.TIPOLG_LAVRZ_GUI,AC.COD_CAUS_NOW_DG, AC.COD_CAUS_OLO, AC.DESCR_CAUS_OLO, AC.DESCR_CAUS_NOW_DG, O.TIPOLOGIASOTTOLAV, &#xa;    O.DPS,O.TIPOLOGIALAVORAZIONE, O.MODALITAFATTURAZIONE, O.DPP, R.TIPOPACCHETTO as TIPOPACCHETTORICHIESTA, O.TIPOPACCHETTO as TIPOPACCHETTOORDINE, O.NOTECLIENTE, O.IDRISORSA,&#xa;    O.CODICEORDINEOLO, O.FLAGLAVORAZIONEMANUALE, O.CODICEORDINETI, O.NOTEDASISTEMA,&#xa;    OLO.COD_OLO, CNT.NOME_CONTRATTO, O.CODICEORDINEOLOPADRE, O.DATACHIUSURAORDINE, R.IDCORRELAZIONE,&#xa;    O.CODICEDELIVERY, O.CODICETTM, O.FLAGMONITORAGGIO, TRN.STATO_RICH_NOW_GUI, &#xa;    O.NOME, O.COGNOMERAGIONESOCIALE, O.CF, O.PIVA, O.OFFERTACATALOGO, R.DRO, O.DAC, O.DACRIMODULATA, O.DES, &#xa;    O.DEC, O.DAD, FO.FASCIA_ORARIA, O.DATAINVIOORDINEADELIVERY, O.DATAINVIOCOMMERCIALIZZ, CI.IDULLCO,&#xa;    O.NUMEROVERDEOLOPT, O.NUMEROVERDEOLOCOLLAUDO, O.CLLI, CI.COD_GAT, O.DNOLOCOLLAUDO, CS.IDSLUCO,&#xa;    O.DADRIMODULATA, O.RO, FP.NOME_FILE, R.TOTALERICHIESTEPACCHETTO, O.TOTALEORDINIPACCHETTO, R.CODICEPROGETTO, R.DATAINVIORICHIESTA,&#xa;    S.INDIRIZZOESTESO, S.PIANO, S.PROVINCIA, S.SCALA, S.COMPLESSO, S.CAP, S.LOCALITA, S.CODICEISTATCOMUNE, S.COMUNE, S.CODICEISTATPROVINCIA,&#xa;    R.TOTALERICHIESTERILEVPAC, O.TIPOLOGIAQUALITA, S.TIPOLOGIASEDE, O.DUVO, DO.BDS_ID,R.CONTENUTOXML, R.FLAGOPERESPECIALI, R.IDOFFERTA, &#xa;    R.FLAGATTESADESOSPOLO, O.DUA, FO.FASCIA_ORARIA_GUI, O.IDRISORSAOPERATORERETE, AR.CONTENUTO_XML_OLO, R.CODICERISORSADONATING, &#xa;    R.CODICERISORSADONATING2, R.CODICESESSIONE, R.CODICESESSIONE2, R.RENDEZVOUS, R.OPERATORERETE, (select distinct ADO.VALOREATTRIBUTO from BDS_1_CASEDATA_ATTRIBTDTTGLRDN ADO where ADO.IDRICHIESTAOLO = R.IDRICHIESTAOLO AND ADO.NOMEATTRIBUTO = 'OPZIONEDINAMICA') as OPZIONEDINAMICA&#xa;FROM &#xa;    BDS_1_CASEDATA_ORDINE O&#xa;&#x9;LEFT JOIN TIPOLG_LAVRZ TL ON TL.TIPOLG_LAVRZ = O.TIPOLOGIALAVORAZIONE&#xa;    LEFT JOIN TIPOLG_SOTTO_LAVRZ TSL ON TSL.DESCR=O.TIPOLOGIASOTTOLAV&#xa;    LEFT JOIN OLO ON OLO.CODFC_OLO_AGCOM = O.CODIFICAOLOAGCOM&#xa;    LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;    LEFT JOIN ACQUISIZIONE_RICHIESTE AR ON AR.ID_RICHIESTA_OLO = TO_CHAR(O.IDRICHIESTAOLO)&#xa;&#x9;LEFT JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = R.IDANAGRAFICACAUSALEGUI&#xa;&#x9;LEFT JOIN CONTRATTO CNT ON CNT.ID_CONTRATTO = R.IDCONTRATTO&#xa;    LEFT JOIN FASCIA_ORARIA FO ON FO.ID_FASCIA_ORARIA = concat(0,O.IDFASCIAORARIAUA)&#xa;    LEFT JOIN CLC_IDULLCO CI ON CI.IDULLCO = O.IDULLCO&#xa;    LEFT JOIN CLC_IDSLUCO CS ON CS.IDSLUCO = O.IDSLUCO&#xa;    LEFT JOIN FILE_PROCSTO FP ON FP.ID_FILE = R.IDFILEINPUT&#xa;    LEFT JOIN BDS_1_CASEDATA_SEDE S ON S.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;&#x9;LEFT JOIN BDS_1_CASEDATA_DETTAGLIOORDINE DO ON DO.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;&#x9;LEFT JOIN BDS_1_CASEDATA_ATTRIBTDTTGLRDN ADO ON ADO.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID = DO.BDS_ID&#xa;&#x9;LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW&#xa;WHERE O.CODICEORDINETI = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

