&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/cmf/Orders" xmlns:tns26="http://www.tim.com/NOW/wsdl/abstract/Orders/" version="2.0"&gt;
    &lt;xsl:param name="OrdiniData"/&gt;
