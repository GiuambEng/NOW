                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JavaInvokeToSPListaOrdiniAVANZ">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JavaInvokeToCopy_1_SPListaOrdiniAVANZ">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$post/parameters/tns3:visualizzaordiniPostParameters/tns3:tipoLista='FIBERSTREAM'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$post.parameters/tns3:tipoLista='FIBERSTREAM']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;www.tibco.com/plugin/java/JavaInvokeActivityInput+d9c7e1fa-fc8c-4e3b-8cc8-adc94a5524e6+JavaInvokeActivityInput&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/rest/servizioricercaavanzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RicercaAvanzata&quot;/>&#xa;    &lt;xsl:template name=&quot;JavaInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:JavaInvokeActivityInput>&#xa;            &lt;MethodParameters>&#xa;                &lt;OldString>&#xa;                    &lt;xsl:value-of select=&quot;$RicercaAvanzata/tns11:outputcondition[1]&quot;/>&#xa;                &lt;/OldString>&#xa;                &lt;OldChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;upper(ADO.NOMEATTRIBUTO='IDRISORSAOLD' AND ADO.VALOREATTRIBUTO)&amp;quot;&quot;/>&#xa;                &lt;/OldChar>&#xa;                &lt;OldChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;upper(ADO.NOMEATTRIBUTO='NUMEROTELEFONICO' AND ADO.VALOREATTRIBUTO)&amp;quot;&quot;/>&#xa;                &lt;/OldChar>&#xa;                &lt;OldChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;upper(ROD.NOME='DN' AND ROD.VALORE)&amp;quot;&quot;/>&#xa;                &lt;/OldChar>&#xa;                &lt;OldChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;upper(R.IDOFFERTA IN (65,66) AND R.CODICEORDINETI)&amp;quot;&quot;/>&#xa;                &lt;/OldChar>&#xa;                &lt;OldChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;upper(ADO.NOMEATTRIBUTO='CARATTERIZZAZIONEGEO' AND ADO.VALOREATTRIBUTO)&amp;quot;&quot;/>&#xa;                &lt;/OldChar>&#xa;                &lt;NewChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ADO.NOMEATTRIBUTO='IDRISORSAOLD' AND ADO.VALOREATTRIBUTO&amp;quot;&quot;/>&#xa;                &lt;/NewChar>&#xa;                &lt;NewChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ADO.NOMEATTRIBUTO='NUMEROTELEFONICO' AND ADO.VALOREATTRIBUTO&amp;quot;&quot;/>&#xa;                &lt;/NewChar>&#xa;                &lt;NewChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ROD.NOME='DN' AND ROD.VALORE&amp;quot;&quot;/>&#xa;                &lt;/NewChar>&#xa;                &lt;NewChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;R.IDOFFERTA IN (65,66) AND R.CODICEORDINETI&amp;quot;&quot;/>&#xa;                &lt;/NewChar>&#xa;                &lt;NewChar>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ADO.NOMEATTRIBUTO='CARATTERIZZAZIONEGEO' AND ADO.VALOREATTRIBUTO&amp;quot;&quot;/>&#xa;                &lt;/NewChar>&#xa;            &lt;/MethodParameters>&#xa;        &lt;/tns12:JavaInvokeActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.java.javamethod"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:java="http://ns.tibco.com/bw/palette/java" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/java#//JavaMethod"/>
                                    <value
                                    className="tim.now.gui_integration_XMLTOEXCEL.ReplaceMoreString"
                                    isNew="true"
                                    isNewActivity="true"
                                    isStaticMethod="true"
                                    methodName="replaceAllString"
                                    methodReturn="string" xsi:type="java:JavaMethod">
                                    <methodParameter
                                    paramName="OldString" paramType="string"/>
                                    <methodParameter
                                    paramName="OldChar" paramType="string[]"/>
                                    <methodParameter
                                    paramName="NewChar" paramType="string[]"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d331772a-5238-4687-bd24-c7bdc8d1a2fe+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MaxRows&quot;/>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;JavaInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;SPListaOrdiniAVANZ-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns26:inputs>&#xa;            &lt;inputSet>&#xa;                &lt;TIPOLISTA>&#xa;                    &lt;xsl:value-of select=&quot;$post/parameters/tns:visualizzaordiniPostParameters/tns:tipoLista&quot;/>&#xa;                &lt;/TIPOLISTA>&#xa;                &lt;PROFILO>&#xa;                    &lt;xsl:value-of select=&quot;$post/parameters/tns:visualizzaordiniPostParameters/tns:tipoProfilo&quot;/>&#xa;                &lt;/PROFILO>&#xa;                &lt;CODOLO>&#xa;                    &lt;xsl:value-of select=&quot;$post/parameters/tns:visualizzaordiniPostParameters/tns:CodOlo&quot;/>&#xa;                &lt;/CODOLO>&#xa;                &lt;RICERCAAVANZATA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JavaInvoke/MethodReturnValue)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$JavaInvoke/MethodReturnValue&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/RICERCAAVANZATA>&#xa;                &lt;NUMRECORD>&#xa;                    &lt;xsl:value-of select=&quot;$MaxRows&quot;/>&#xa;                &lt;/NUMRECORD>&#xa;            &lt;/inputSet>&#xa;        &lt;/tns26:inputs>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SPListaOrdiniOFAVANZ-input"
                                    name="SPListaOrdiniOFAVANZ"
                                    outputVariable="SPListaOrdiniOFAVANZ"
                                    tibex:xpdlId="d331772a-5238-4687-bd24-c7bdc8d1a2fe" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
