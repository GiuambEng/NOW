                                    sqlStatement="SELECT (select distinct TRO.STATO_RICH_OLO_GUI from TIPOLG_RICH_COMSTOLO TRO where R.STATORICHIESTAOLO = TRO.STATO_RICH_OLO) as STATO_RICH_OLO_GUI,R.STATORICHIESTAOLO,R.IDRICHIESTAOLO, R.CODICEORDINEOLO, R.DATAINVIORICHIESTA, R.CODICEORDINETI, R.CANALERICHIESTA, R.TIPORICHIESTA, R.DISAGGREGATO, R.EXDISAGGREGATO, TRN.STATO_RICH_NOW_GUI, R.CODIFICAOLOAGCOM, R.CODIFICAOLONOW, R.NOTE, R.IDRISORSA, R.CODICEORDINEOLOPADRE, R.CODICEORDINEOLOTARGET, &#xa;R.CODICEPROGETTO, R.FLAGNAKED, R.LAVORAZIONE, R.TESTMODE, R.LASTUPDATE, R.CREATED, R.DRO, O.DAC, O.DES, OLO.NOME AS OLONOME,&#xa;AC.COD_CAUS_NOW_DG, AC.COD_CAUS_OLO, AC.DESCR_CAUS_OLO, AC.DESCR_CAUS_NOW_DG, RD.NOME AS RDNOME, RD.IDTPLG_DATO_RICH, RD.VALORE, &#xa;RD.PROGRS_TIPOLG_DATO_RICH, R.CODIFICAOLOAGCOMDONATING, R.CODIFICAOLOAGCOMDONOR, R.IDOFFERTA, TS.DESCR_SCENARIO, O.IDRISORSANOW,R.ORDINEASSETWHITELIST, O.CODICEORDINEOPENFIBER, O.IDRISORSAOPENFIBER, R.STATORICHIESTAOF, O.NOTEFIBERSTREAM, R.FLGABILITAZGUIMANUALOF, O.CARATTERIZZAZIONEAREA&#xa;FROM&#xa;BDS_1_CASEDATA_RICHIESTA R&#xa;LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.IDRICHIESTAOLO = R.IDRICHIESTAOLO&#xa;LEFT JOIN OLO ON OLO.CODFC_OLO_AGCOM = R.CODIFICAOLOAGCOM&#xa;LEFT JOIN ANAG_CAUS AC ON AC.ID_ANAG_CAUS = R.IDANAGRAFICACAUSALEGUI&#xa;LEFT JOIN RICH_OLO_DETT RD ON RD.ID_RICH_OLO = R.IDRICHIESTAOLO&#xa;LEFT JOIN TIPOLG_RICH_COMSTNOW TRN ON R.STATORICHIESTANOW = TRN.STATO_RICH_NOW&#xa;LEFT JOIN TIPOLG_SCENARIO TS ON TS.SCENARIO_BPM = R.TIPOLOGIASCENARIO&#xa;WHERE R.CODICEORDINETI = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

