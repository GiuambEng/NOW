cap>&#xa;                                                        &lt;xsl:value-of select=&quot;CAP&quot;/>&#xa;                                                    &lt;/tns2:cap>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;LOCALITA&quot;>&#xa;                                                    &lt;tns2:localita>&#xa;                                                        &lt;xsl:value-of select=&quot;LOCALITA&quot;/>&#xa;                                                    &lt;/tns2:localita>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;CODICEISTATCOMUNE&quot;>&#xa;                                                    &lt;tns2:codiceIstatcomune>&#xa;                                                        &lt;xsl:value-of select=&quot;CODICEISTATCOMUNE&quot;/>&#xa;                                                    &lt;/tns2:codiceIstatcomune>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;COMUNE&quot;>&#xa;                                                    &lt;tns2:comune>&#xa;                                                        &lt;xsl:value-of select=&quot;COMUNE&quot;/>&#xa;                                                    &lt;/tns2:comune>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;CODICEISTATPROVINCIA&quot;>&#xa;                                                    &lt;tns2:codiceIstatProvincia>&#xa;                                                        &lt;xsl:value-of select=&quot;CODICEISTATPROVINCIA&quot;/>&#xa;                                                    &lt;/tns2:codiceIstatProvincia>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;TIPOLOGIASEDE&quot;>&#xa;                                                    &lt;tns2:tipologiaSede>&#xa;                                                        &lt;xsl:value-of select=&quot;TIPOLOGIASEDE&quot;/>&#xa;                                                    &lt;/tns2:tipologiaSede>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/tns2:sedeClienteFinale>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/tns2:clienteFinale>&#xa;                            &lt;xsl:for-each select=&quot;$RecuperoAttributiDettaglioOrdini/Record&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;NOMEATTRIBUTO = 'DATARESTITUZIONEPRODOTTI' and VALOREATTRIBUTO !='01-01-1900'&quot;>&#xa;                                        &lt;tns2:attributiDettaglioOrdine>&#xa;                                            &lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&#xa;                                                &lt;tns2:nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&#xa;                                                &lt;/tns2:nomeAttributo>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$currOfferta = (70,71,72,73) and NOMEATTRIBUTO = 'TIPOOFFERTA'&quot;>&#xa;                                                    &lt;tns2:valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;'MULTICAST'&quot;/>&#xa;                                                    &lt;/tns2:valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&#xa;                                                        &lt;tns2:valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&#xa;                                                        &lt;/tns2:valoreAttributo>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/tns2:attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;NOMEATTRIBUTO !='DATARESTITUZIONEPRODOTTI'&quot;>&#xa;                                        &lt;tns2:attributiDettaglioOrdine>&#xa;                                            &lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&#xa;                                                &lt;tns2:nomeAttributo>&#xa;                                                    &lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&#xa;                                                &lt;/tns2:nomeAttributo>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$currOfferta = (70,71,72,73) and NOMEATTRIBUTO = 'TIPOOFFERTA'&quot;>&#xa;                                                    &lt;tns2:valoreAttributo>&#xa;                                                        &lt;xsl:value-of select=&quot;'MULTICAST'&quot;/>&#xa;                                                    &lt;/tns2:valoreAttributo>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&#xa;                                                        &lt;tns2:valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&#xa;                                                        &lt;/tns2:valoreAttributo>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/tns2:attributiDettaglioOrdine>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;tns2:cambioTecnologia>&#xa;                                &lt;tns2:label>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ID Risorsa OLD&amp;quot;&quot;/>&#xa;                                &lt;/tns2:label>&#xa;                                &lt;xsl:if test=&quot;$Servizio.parametersOutputService/tns3:OutputServizi[1]/tns3:customizzazione/tns3:OutputVisualizzaCustomizzazione[tns3:AttributoCustomizzazione = 'IDRISORSAOLD']/tns3:ValoreCustomizzazione&quot;>&#xa;                                    &lt;tns2:valore>&#xa;                                        &lt;xsl:value-of select=&quot;$Servizio.parametersOutputService/tns3:OutputServizi[1]/tns3:customizzazione/tns3:OutputVisualizzaCustomizzazione[tns3:AttributoCustomizzazione = 'IDRISORSAOLD']/tns3:ValoreCustomizzazione&quot;/>&#xa;                                    &lt;/tns2:valore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns2:cambioTecnologia>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLO&quot;>&#xa;                                &lt;tns2:codiceOrdineOLO>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLO&quot;/>&#xa;                                &lt;/tns2:codiceOrdineOLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns2:dataInvioRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DATAINVIORICHIESTA), &amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns2:dataInvioRichiesta>&#xa;                            &lt;xsl:if test=&quot;CANALERICHIESTA&quot;>&#xa;                                &lt;tns2:canaleRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;CANALERICHIESTA&quot;/>&#xa;                                &lt;/tns2:canaleRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPORICHIESTA&quot;>&#xa;                                &lt;tns2:tipoRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;TIPORICHIESTA&quot;/>&#xa;                                &lt;/tns2:tipoRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATO_RICH_NOW_GUI&quot;>&#xa;                                &lt;tns2:statoRichiestaNow>&#xa;                                    &lt;xsl:value-of select=&quot;STATO_RICH_NOW_GUI&quot;/>&#xa;                                &lt;/tns2:statoRichiestaNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;(IDOFFERTA = (72,73)) and (STATO_RICH_OLO_GUI = 'INVIATO A DELIVERY')&quot;>&#xa;                                    &lt;tns2:statoRichiestaOlo>&#xa;                                        &lt;xsl:value-of select=&quot;'IN DELIVERY'&quot;/>&#xa;                                    &lt;/tns2:statoRichiestaOlo>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;STATO_RICH_OLO_GUI&quot;>&#xa;                                        &lt;tns2:statoRichiestaOlo>&#xa;                                            &lt;xsl:value-of select=&quot;STATO_RICH_OLO_GUI&quot;/>&#xa;                                        &lt;/tns2:statoRichiestaOlo>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;NOTE&quot;>&#xa;                                &lt;tns2:note>&#xa;                                    &lt;xsl:value-of select=&quot;NOTE&quot;/>&#xa;                                &lt;/tns2:note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns2:dro>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DRO),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns2:dro>&#xa;                            &lt;xsl:if test=&quot;OLONOME&quot;>&#xa;                                &lt;tns2:oao>&#xa;                                    &lt;xsl:value-of select=&quot;OLONOME&quot;/>&#xa;                                &lt;/tns2:oao>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLGABILITAZGUIMANUALOF='SI' and IDOFFERTA=75&quot;>&#xa;                                    &lt;xsl:if test=&quot;$AnagCausLavManOF/Record[1]/COD_CAUS_NOW_DG&quot;>&#xa;                                        &lt;tns2:codiceCausaleNow>&#xa;                                            &lt;xsl:value-of select=&quot;$AnagCausLavManOF/Record[1]/COD_CAUS_NOW_DG&quot;/>&#xa;                                        &lt;/tns2:codiceCausaleNow>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;COD_CAUS_NOW_DG&quot;>&#xa;                                        &lt;tns2:codiceCausaleNow>&#xa;                                            &lt;xsl:value-of select=&quot;COD_CAUS_NOW_DG&quot;/>&#xa;                                        &lt;/tns2:codiceCausaleNow>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLGABILITAZGUIMANUALOF='SI' and IDOFFERTA=75&quot;>&#xa;                                    &lt;xsl:if test=&quot;$AnagCausLavManOF/Record[1]/COD_CAUS_OLO&quot;>&#xa;                                        &lt;tns2:codiceCausaleOao>&#xa;                                            &lt;xsl:value-of select=&quot;$AnagCausLavManOF/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                        &lt;/tns2:codiceCausaleOao>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;COD_CAUS_OLO&quot;>&#xa;                                        &lt;tns2:codiceCausaleOao>&#xa;                                            &lt;xsl:value-of select=&quot;COD_CAUS_OLO&quot;/>&#xa;                                        &lt;/tns2:codiceCausaleOao>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLGABILITAZGUIMANUALOF='SI' and IDOFFERTA=75&quot;>&#xa;                                    &lt;xsl:if test=&quot;$AnagCausLavManOF/Record[1]/DESCR_CAUS_OLO&quot;>&#xa;                                        &lt;tns2:causaleOao>&#xa;                                            &lt;xsl:value-of select=&quot;$AnagCausLavManOF/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                        &lt;/tns2:causaleOao>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;DESCR_CAUS_OLO&quot;>&#xa;                                        &lt;tns2:causaleOao>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR_CAUS_OLO&quot;/>&#xa;                                        &lt;/tns2:causaleOao>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;FLGABILITAZGUIMANUALOF='SI' and IDOFFERTA=75&quot;>&#xa;                                    &lt;xsl:if test=&quot;$AnagCausLavManOF/Record[1]/DESCR_CAUS_NOW_DG&quot;>&#xa;                                        &lt;tns2:descrizioneCausaleNow>&#xa;                                            &lt;xsl:value-of select=&quot;$AnagCausLavManOF/Record[1]/DESCR_CAUS_NOW_DG&quot;/>&#xa;                                        &lt;/tns2:descrizioneCausaleNow>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;DESCR_CAUS_NOW_DG&quot;>&#xa;                                        &lt;tns2:descrizioneCausaleNow>&#xa;                                            &lt;xsl:value-of select=&quot;DESCR_CAUS_NOW_DG&quot;/>&#xa;                                        &lt;/tns2:descrizioneCausaleNow>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns2:idRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns2:idRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSANOW&quot;>&#xa;                                &lt;tns2:idRisorsaNow>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSANOW&quot;/>&#xa;                                &lt;/tns2:idRisorsaNow>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns2:dac>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DAC),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns2:dac>&#xa;                            &lt;tns2:des>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(DES),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns2:des>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLOPADRE&quot;>&#xa;                                &lt;tns2:codiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLOPADRE&quot;/>&#xa;                                &lt;/tns2:codiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOLOTARGET&quot;>&#xa;                                &lt;tns2:codiceOrdineOloTarget>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOLOTARGET&quot;/>&#xa;                                &lt;/tns2:codiceOrdineOloTarget>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEPROGETTO&quot;>&#xa;                                &lt;tns2:codiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEPROGETTO&quot;/>&#xa;                                &lt;/tns2:codiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;FLAGNAKED&quot;>&#xa;                                &lt;tns2:flagNaked>&#xa;                                    &lt;xsl:value-of select=&quot;FLAGNAKED&quot;/>&#xa;                                &lt;/tns2:flagNaked>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;LAVORAZIONE&quot;>&#xa;                                &lt;tns2:lavorazioneRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&#xa;                                &lt;/tns2:lavorazioneRichiesta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TESTMODE&quot;>&#xa;                                &lt;tns2:testMode>&#xa;                                    &lt;xsl:value-of select=&quot;TESTMODE&quot;/>&#xa;                                &lt;/tns2:testMode>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;contains(string(LASTUPDATE), &amp;quot;.&amp;quot;)&quot;>&#xa;                                    &lt;tns2:timestampAggiornamento>&#xa;                                        &lt;xsl:value-of select=&quot;concat(substring-before(string(LASTUPDATE),'.'), '+',substring-after(string(LASTUPDATE), '+'))&quot;/>&#xa;                                    &lt;/tns2:timestampAggiornamento>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:timestampAggiornamento>&#xa;                                        &lt;xsl:value-of select=&quot;string(LASTUPDATE)&quot;/>&#xa;                                    &lt;/tns2:timestampAggiornamento>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns2:timestampInserimento>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(string(CREATED),&amp;quot;T&amp;quot;)&quot;/>&#xa;                            &lt;/tns2:timestampInserimento>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOMDONATING&quot;>&#xa;                                &lt;tns2:oaoDonating>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOMDONATING&quot;/>&#xa;                                &lt;/tns2:oaoDonating>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOMDONOR&quot;>&#xa;                                &lt;tns2:oaoDonor>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOMDONOR&quot;/>&#xa;                                &lt;/tns2:oaoDonor>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDOFFERTA&quot;>&#xa;                                &lt;tns2:idOfferta>&#xa;                                    &lt;xsl:value-of select=&quot;IDOFFERTA&quot;/>&#xa;                                &lt;/tns2:idOfferta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DESCR_SCENARIO&quot;>&#xa;                                &lt;tns2:descrizioneScenario>&#xa;                                    &lt;xsl:value-of select=&quot;DESCR_SCENARIO&quot;/>&#xa;                                &lt;/tns2:descrizioneScenario>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:for-each select=&quot;$NumTelefAgg/Record&quot;>&#xa;                                &lt;tns2:numeroTelefonicoAggiuntivo>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROTELEFONICOAGGIUNTIVO&quot;/>&#xa;                                &lt;/tns2:numeroTelefonicoAggiuntivo>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:if test=&quot;DISAGGREGATO&quot;>&#xa;                                &lt;tns2:disaggregato>&#xa;                                    &lt;xsl:value-of select=&quot;DISAGGREGATO&quot;/>&#xa;                                &lt;/tns2:disaggregato>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;EXDISAGGREGATO&quot;>&#xa;                                &lt;tns2:exDisaggregato>&#xa;                                    &lt;xsl:value-of select=&quot;EXDISAGGREGATO&quot;/>&#xa;                                &lt;/tns2:exDisaggregato>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ORDINEASSETWHITELIST&quot;>&#xa;                                &lt;tns2:ordineAssetWhiteList>&#xa;                                    &lt;xsl:value-of select=&quot;ORDINEASSETWHITELIST&quot;/>&#xa;                                &lt;/tns2:ordineAssetWhiteList>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($Referenti/Record[TIPOREFERENTEORDINE = 'REFERENTEOAOPROGETTISPECIALI'])&quot;>&#xa;                                &lt;xsl:if test=&quot;$Referenti/Record[TIPOREFERENTEORDINE = 'REFERENTEOAOPROGETTISPECIALI']/REFOAOPROGETTISPECIALI&quot;>&#xa;                                    &lt;tns2:refOaoProgettiSpeciali>&#xa;                                        &lt;xsl:value-of select=&quot;$Referenti/Record[TIPOREFERENTEORDINE = 'REFERENTEOAOPROGETTISPECIALI']/REFOAOPROGETTISPECIALI&quot;/>&#xa;                                    &lt;/tns2:refOaoProgettiSpeciali>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICEORDINEOPENFIBER&quot;>&#xa;                                &lt;tns2:codiceOrdineOF>&#xa;                                    &lt;xsl:value-of select=&quot;CODICEORDINEOPENFIBER&quot;/>&#xa;                                &lt;/tns2:codiceOrdineOF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSAOPENFIBER&quot;>&#xa;                                &lt;tns2:idRisorsaOF>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSAOPENFIBER&quot;/>&#xa;                                &lt;/tns2:idRisorsaOF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;STATORICHIESTAOF&quot;>&#xa;                                &lt;tns2:statoOF>&#xa;                                    &lt;xsl:value-of select=&quot;STATORICHIESTAOF&quot;/>&#xa;                                &lt;/tns2:statoOF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NOTEFIBERSTREAM&quot;>&#xa;                                &lt;tns2:noteOF>&#xa;                                    &lt;xsl:value-of select=&quot;NOTEFIBERSTREAM&quot;/>&#xa;                                &lt;/tns2:noteOF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;FLGABILITAZGUIMANUALOF&quot;>&#xa;                                &lt;tns2:flagAbilitazioneGuiManualOF>&#xa;                                    &lt;xsl:value-of select=&quot;FLGABILITAZGUIMANUALOF&quot;/>&#xa;                                &lt;/tns2:flagAbilitazioneGuiManualOF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CARATTERIZZAZIONEAREA&quot;>&#xa;                                &lt;tns2:caratterizzazioneArea>&#xa;                                    &lt;xsl:value-of select=&quot;CARATTERIZZAZIONEAREA&quot;/>&#xa;                                &lt;/tns2:caratterizzazioneArea>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns2:OutputDatiOrdine>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:OutputDatiOrdine>&#xa;                            &lt;tns2:idrichiestaolo>&#xa;                                &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                            &lt;/tns2:idrichiestaolo>&#xa;                            &lt;tns2:codiceordineTInonvalorizzato>&#xa;                                &lt;xsl:if test=&quot;RDNOME&quot;>&#xa;                                    &lt;tns2:nome>&#xa;                                        &lt;xsl:value-of select=&quot;RDNOME&quot;/>&#xa;                                    &lt;/tns2:nome>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns2:progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(PROGRS_TIPOLG_DATO_RICH)&quot;/>&#xa;                                &lt;/tns2:progressivo>&#xa;                                &lt;xsl:if test=&quot;IDTPLG_DATO_RICH&quot;>&#xa;                                    &lt;tns2:tipologiadatorichiesta>&#xa;                                        &lt;xsl:value-of select=&quot;IDTPLG_DATO_RICH&quot;/>&#xa;                                    &lt;/tns2:tipologiadatorichiesta>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;VALORE&quot;>&#xa;                                    &lt;tns2:richiestadettagliovalore>&#xa;                                        &lt;xsl:value-of select=&quot;VALORE&quot;/>&#xa;                                    &lt;/tns2:richiestadettagliovalore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns2:codiceordineTInonvalorizzato>&#xa;                        &lt;/tns2:OutputDatiOrdine>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;tns2:result>&#xa;                &lt;tns2:severity>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/tns2:severity>&#xa;                &lt;tns2:code>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns2:code>&#xa;            &lt;/tns2:result>&#xa;        &lt;/tns2:OutputOrdersData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
