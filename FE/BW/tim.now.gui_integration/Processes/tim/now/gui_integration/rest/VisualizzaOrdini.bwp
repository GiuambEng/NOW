                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns8=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns26=&quot;http://www.tim.com/NOW/rest/consuntivo&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;lista_Consuntivo&quot;/>&#xa;    &lt;xsl:template name=&quot;get_Consuntivo_Output_LogINFO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;xsl:if test=&quot;$get3.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns7:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get3.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns7:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($lista_Consuntivo/tns26:Lista_Output_consuntivo[1])&quot;>&#xa;                        &lt;tns7:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Output_VisualizzaOrdini_Primo elemento:&amp;quot;,tib:render-xml($lista_Consuntivo/tns26:Lista_Output_consuntivo[1], true(),true()))&quot;/>&#xa;                        &lt;/tns7:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:Payload>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Output_VisualizzaOrdini_Primo elemento:&amp;quot;,&amp;quot;No record&amp;quot;)&quot;/>&#xa;                        &lt;/tns7:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;            &lt;tns7:ActiveLoggerServices>&#xa;                &lt;tns7:Envelope>&#xa;                    &lt;tns7:Identifier>&#xa;                        &lt;tns7:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_integration.VisualizzaOrdini&amp;quot;&quot;/>&#xa;                        &lt;/tns7:ServiceName>&#xa;                        &lt;tns7:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Operation>&#xa;                        &lt;tns7:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Source>&#xa;                        &lt;xsl:if test=&quot;$get3.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns7:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get3.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns7:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get3.httpHeaders/GUI-SID,$get3.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns7:EventID>&#xa;                        &lt;xsl:if test=&quot;$get3.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns7:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get3.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns7:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns7:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$get3.httpHeaders/GUI-SID,&amp;quot;COMPLETE&amp;quot;)&quot;/>&#xa;                        &lt;/tns7:EventType>&#xa;                        &lt;tns7:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VisualizzaOrdini_&amp;quot;,$get3.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns7:trackID>&#xa;                    &lt;/tns7:Identifier>&#xa;                    &lt;tns7:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns7:track_position>&#xa;                    &lt;tns7:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns7:Timestamp>&#xa;                    &lt;tns7:ErrorLog>&#xa;                        &lt;tns7:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns7:TimeStamp>&#xa;                    &lt;/tns7:ErrorLog>&#xa;                &lt;/tns7:Envelope>&#xa;            &lt;/tns7:ActiveLoggerServices>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
