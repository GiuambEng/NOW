RDINE) >0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/TIPOPACCHETTOORDINE&quot;>&#xa;                                            &lt;tns2:TipoPacchetto>&#xa;                                                &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/TIPOPACCHETTOORDINE&quot;/>&#xa;                                            &lt;/tns2:TipoPacchetto>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/TIPOPACCHETTORICHIESTA&quot;>&#xa;                                            &lt;tns2:TipoPacchetto>&#xa;                                                &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/TIPOPACCHETTORICHIESTA&quot;/>&#xa;                                            &lt;/tns2:TipoPacchetto>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/NOTECLIENTE&quot;>&#xa;                                    &lt;tns2:NoteDaCliente>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/NOTECLIENTE&quot;/>&#xa;                                    &lt;/tns2:NoteDaCliente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Profilo!=&amp;quot;CRM_OLO&amp;quot;&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/IDRISORSA&quot;>&#xa;                                        &lt;tns2:IdRisorsa>&#xa;                                            &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/IDRISORSA&quot;/>&#xa;                                        &lt;/tns2:IdRisorsa>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CODICEORDINEOLO&quot;>&#xa;                                    &lt;tns2:CodiceOrdineOlo>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                                    &lt;/tns2:CodiceOrdineOlo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CODICEORDINETI&quot;>&#xa;                                    &lt;tns2:CodiceOrdineTI>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CODICEORDINETI&quot;/>&#xa;                                    &lt;/tns2:CodiceOrdineTI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/NOTEDASISTEMA&quot;>&#xa;                                    &lt;tns2:NoteDaSistema>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/NOTEDASISTEMA&quot;/>&#xa;                                    &lt;/tns2:NoteDaSistema>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/COD_OLO&quot;>&#xa;                                    &lt;tns2:CodiceOLO>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/COD_OLO&quot;/>&#xa;                                    &lt;/tns2:CodiceOLO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/OFFERTACATALOGO !='NP'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/NOME_CONTRATTO&quot;>&#xa;                                        &lt;tns2:Contratto>&#xa;                                            &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/NOME_CONTRATTO&quot;/>&#xa;                                        &lt;/tns2:Contratto>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/NOME_FILE&quot;>&#xa;                                    &lt;tns2:NomeFile>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/NOME_FILE&quot;/>&#xa;                                    &lt;/tns2:NomeFile>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;>&#xa;                                    &lt;tns2:CodiceOLOOrdinePadre>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CODICEORDINEOLOPADRE&quot;/>&#xa;                                    &lt;/tns2:CodiceOLOOrdinePadre>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns2:DataChiusuraOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(string($DettaglioOrdine/Record[1]/DATACHIUSURAORDINE),&amp;quot;T&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataChiusuraOrdine>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($DettaglioOrdine/Record/TOTALEORDINIPACCHETTO) and string-length(xsd:string($DettaglioOrdine/Record[1]/TOTALEORDINIPACCHETTO)) >0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/TOTALEORDINIPACCHETTO&quot;>&#xa;                                            &lt;tns2:TotaleOrdiniPacchetto>&#xa;                                                &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/TOTALEORDINIPACCHETTO&quot;/>&#xa;                                            &lt;/tns2:TotaleOrdiniPacchetto>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/TOTALERICHIESTEPACCHETTO&quot;>&#xa;                                            &lt;tns2:TotaleOrdiniPacchetto>&#xa;                                                &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/TOTALERICHIESTEPACCHETTO&quot;/>&#xa;                                            &lt;/tns2:TotaleOrdiniPacchetto>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CODICEPROGETTO&quot;>&#xa;                                    &lt;tns2:Progetto>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CODICEPROGETTO&quot;/>&#xa;                                    &lt;/tns2:Progetto>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/CODICEDELIVERY&quot;>&#xa;                                    &lt;tns2:CodiceDelivery>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]/CODICEDELIVERY&quot;/>&#xa;                                    &lt;/tns2:CodiceDelivery>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$DettaglioOrdine/Record[1]/TIPOLOGIAQUALITA&quot;>&#xa;                                    &lt;tns2:CodiceQualita>&#xa;                                        &lt;xsl:value-of select=&quot;$DettaglioOrdine/Record[1]