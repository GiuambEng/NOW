                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns26=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2c02f09d-82c9-41ed-97d0-e909a856c3b0+input&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzaOrdini/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get3&quot;/>&#xa;    &lt;xsl:template name=&quot;GetIdOfferta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns26:jdbcQueryActivityInput>&#xa;            &lt;idRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$get3/parameters/tns:visualizzaordini-consuntivo1GetParameters/tns:id_rich_olo&quot;/>&#xa;            &lt;/idRichiestaOlo>&#xa;        &lt;/tns26:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
