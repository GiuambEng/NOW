&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://xmlns.example.com/20160421153118PLT" xmlns:tns2="http://www.tim.com/NOW/rest/Orders" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="erroreListaOrdiniReply-input" match="/"&gt;
        &lt;tns6:getResponse1&gt;
