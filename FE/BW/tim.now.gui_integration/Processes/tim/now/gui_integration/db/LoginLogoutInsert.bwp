                        <element maxOccurs="1" minOccurs="1"
                            name="TIMESTAMP_FINE" nillable="true" type="dateTime"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="NUM_DATI_ESP" nillable="true" type="int"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="CONTENUTO_FILE" nillable="true" type="base64Binary"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="NOME_FILE" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
