    xmlns:tns0="http://www.tim.com/NOW/wsdl/abstract/LoggerServiceSecurity/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>JDBCUpdate</variable>
            </endingVariables>
        </task>
        <task name="LogInput">
            <endingVariables>
                <variable>LogInput-input</variable>
            </endingVariables>
        </task>
        <task name="JDBCUpdate">
            <endingVariables>
                <variable>JDBCUpdate-input</variable>
                <variable>Start</variable>
                <variable>RecuperoFunzioneAziendale</variable>
            </endingVariables>
        </task>
        <task name="LogOutput">
            <endingVariables>
                <variable>LogOutput-input</variable>
            </endingVariables>
        </task>
        <task name="RecuperoFunzioneAziendale">
            <endingVariables>
                <variable>RecuperoFunzioneAziendale-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
