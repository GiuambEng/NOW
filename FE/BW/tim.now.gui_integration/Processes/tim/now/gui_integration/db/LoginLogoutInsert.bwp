                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+17043a15-aa1a-4936-8f03-93e4ec2ea056+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.example.org/cmf.LoggerSecurityService&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperoFunzioneAziendale&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;APPLICAZIONE_CLIENT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:APPLICAZIONE_CLIENT)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:APPLICAZIONE_CLIENT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/APPLICAZIONE_CLIENT>&lt;DESCR_FUNZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:DESCR_FUNZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:DESCR_FUNZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_FUNZIONE>&lt;DESCR_PROFILO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:DESCR_PROFILO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:DESCR_PROFILO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_PROFILO>&lt;HOSTNAME_CLIENT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:HOSTNAME_CLIENT)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:HOSTNAME_CLIENT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/HOSTNAME_CLIENT>&lt;IP_CLIENT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:IP_CLIENT)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:IP_CLIENT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IP_CLIENT>&lt;IP_SERVER>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:IP_SERVER)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:IP_SERVER&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IP_SERVER>&lt;OS_USER>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:OS_USER)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:OS_USER&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OS_USER>&lt;PARAMETRI_OPERAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:PARAMETRI_OPERAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:PARAMETRI_OPERAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PARAMETRI_OPERAZIONE>&lt;SERVER_NAME>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:SERVER_NAME)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:SERVER_NAME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SERVER_NAME>&lt;SESSION_ID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:SESSION_ID)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:SESSION_ID&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SESSION_ID>&lt;TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_INSMTO>&lt;TIPO_OPERAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:TIPO_OPERAZIONE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:TIPO_OPERAZIONE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPO_OPERAZIONE>&lt;USERID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:USERID)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:USERID&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/USERID>&lt;FUNZIONE_AZIENDALE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperoFunzioneAziendale/Record[1]/FUNZIONE_AZIENDALE)&quot;>&lt;xsl:value-of select=&quot;$RecuperoFunzioneAziendale/Record[1]/FUNZIONE_AZIENDALE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FUNZIONE_AZIENDALE>&lt;TIMESTAMP_INS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:TIMSTP_INIZIO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:TIMSTP_INIZIO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIMESTAMP_INS>&lt;TIMESTAMP_FINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:TIMSTP_FINE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:TIMSTP_FINE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIMESTAMP_FINE>&lt;NUM_DATI_ESP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:NUM_DATI_ESPORTATI)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:NUM_DATI_ESPORTATI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUM_DATI_ESP>&lt;CONTENUTO_FILE>&lt;xsl:value-of select=&quot;xsd:base64Binary($Start/tns2:CONTENUTO_FILE)&quot;/>&lt;/CONTENUTO_FILE>&lt;NOME_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:NOME_FILE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:NOME_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_FILE>&lt;ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:ESITO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:ESITO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ESITO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO TRACC_ATTIVITA_UTENTE (APPLICAZIONE_CLIENT,&#xa;  DESCR_FUNZIONE, DESCR_PROFILO, HOSTNAME_CLIENT, IP_CLIENT, IP_SERVER,&#xa;  OS_USER, PARAMETRI_OPERAZIONE, SERVER_NAME, SESSION_ID, TIMSTP_INSMTO,&#xa;  TIPO_OPERAZIONE, USERID, FUNZIONE_AZIENDALE, TIMESTAMP_INS, TIMESTAMP_FINE, NUM_DATI_ESP, CONTENUTO_FILE, NOME_FILE, ESITO)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="APPLICAZIONE_CLIENT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_FUNZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_PROFILO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="HOSTNAME_CLIENT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IP_CLIENT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IP_SERVER"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OS_USER"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="PARAMETRI_OPERAZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SERVER_NAME"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SESSION_ID"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_OPERAZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="USERID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FUNZIONE_AZIENDALE"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_INS"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_FINE"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="NUM_DATI_ESP"/>
                                    <PreparedParameters
                                    DataType="2004"
                                    DataTypeDisplayValue="BLOB" ParameterName="CONTENUTO_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITO"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
