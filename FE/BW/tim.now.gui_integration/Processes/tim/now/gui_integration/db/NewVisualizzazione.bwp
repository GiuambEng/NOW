                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NewFileListe/" xmlns:tns1="http://www.tim.com/NOW/cmf/Semaforo" xmlns:tns2="http://www.tim.com/NOW/cmf/Semaforo" version="2.0"&gt;&lt;xsl:param name="getListaOlo"/&gt;&lt;xsl:param name="SQLDirect"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="getListaOloOut-input" match="/"&gt;&lt;tns:getListaOloResponse&gt;&lt;parameters&gt;&lt;tns2:listaOloOutput&gt;&lt;tns2:codiceAgcom&gt;&lt;xsl:value-of select="$getListaOlo/parameters/tns1:listaOloInput/tns1:codiceAgcom"/&gt;&lt;/tns2:codiceAgcom&gt;&lt;tns2:flagOloAccorpante&gt;&lt;xsl:value-of select="$Mapper/tns1:codiceAgcom=$getListaOlo/parameters/tns1:listaOloInput/tns1:codiceAgcom"/&gt;&lt;/tns2:flagOloAccorpante&gt;&lt;xsl:for-each select="$SQLDirect/unknownResultset/row"&gt;&lt;xsl:for-each select="$Mapper"&gt;&lt;tns2:listaOlo_AnagraficaOlo&gt;&lt;tns2:nome&gt;&lt;xsl:value-of select="tns1:nome"/&gt;&lt;/tns2:nome&gt;&lt;tns2:codiceAgcom&gt;&lt;xsl:value-of select="$SQLDirect/unknownResultset/row/column[name=&amp;quot;CODFC_OLO_AGCOM&amp;quot;]/value"/&gt;&lt;/tns2:codiceAgcom&gt;&lt;tns2:flagAccorpante&gt;&lt;xsl:value-of select="tns1:flagAccorpante"/&gt;&lt;/tns2:flagAccorpante&gt;&lt;/tns2:listaOlo_AnagraficaOlo&gt;&lt;/xsl:for-each&gt;&lt;/xsl:for-each&gt;&lt;/tns2:listaOloOutput&gt;&lt;/parameters&gt;&lt;/tns:getListaOloResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
