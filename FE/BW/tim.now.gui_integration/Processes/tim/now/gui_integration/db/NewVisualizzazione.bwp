                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="NONOLOTogetNonOloOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+285b9d76-d588-4515-9b5a-fa629b85f918+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FPO.DIMENSIONE_FILE, FPO.QT_RECD_TOTALI,&#xa;       FP.NOME_FILE,FPO.DATA_ARRIVO,&#xa;       FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE AS TIPOLOGIA, TP.DESCR, TP.IDTPLG_FILE AS TIPOLOGICO,&#xa;       FPO.QT_RECD_NOW, FPO.QT_RECD_OK, FPO.QT_RECD_KO, FP.DATA_FILE,&#xa;       FP.ESITO, FP.ID_ESEC_PROCSO_FILE, FP.IDTPLG_FILE,FPO.ID_CAUS_SCARTO, FP.TIMSTP_APERTURA_FILE,&#xa;       FP.TIMSTP_CHIUSURA_FILE, FP.ID_INTRFC, FP.ID_FILE AS IDFILES, FP.ID_ESEC_PROCSO_FILE AS DATAAGGIORNAMENTO&#xa;FROM   FILE_PROCSTO_INPUT FPO, FILE_PROCSTO FP, TIPOLG_FILE TP&#xa;WHERE  FPO.ID_FILE_PROCSTO_INPUT=FP.ID_FILE and FP.IDTPLG_FILE=TP.IDTPLG_FILE" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="DIMENSIONE_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_TOTALI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_ARRIVO"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLOGICO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_NOW"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_OK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_KO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATA_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
