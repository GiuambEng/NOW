                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NewFileListe/" xmlns:tns1="http://www.tim.com/NOW/cmf/Semaforo" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;&lt;xsl:param name="listaFile"/&gt;&lt;xsl:template name="visulizzazioneOut1-input" match="/"&gt;&lt;tns:visualizzazioneResponse&gt;&lt;parameters&gt;&lt;tns1:visualizzaOutput&gt;&lt;xsl:for-each select="$listaFile/unknownResultset[1]/row"&gt;&lt;tns1:NewElement&gt;&lt;xsl:if test="not((string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_FILE']/value)"&gt;&lt;tns1:NOMEFILE&gt;&lt;xsl:value-of select="column[name='NOME_FILE']/value"/&gt;&lt;/tns1:NOMEFILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='DIMENSIONE_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DIMENSIONE_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DIMENSIONE_FILE']/value)"&gt;&lt;tns1:DIMENSIONEFILE&gt;&lt;xsl:value-of select="column[name='DIMENSIONE_FILE']/value"/&gt;&lt;/tns1:DIMENSIONEFILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='DESCR_CAUS_SCARTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_CAUS_SCARTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_CAUS_SCARTO']/value)"&gt;&lt;tns1:IDENTIFICATIVOCAUSALESCARTO&gt;&lt;xsl:value-of select="column[name='DESCR_CAUS_SCARTO']/value"/&gt;&lt;/tns1:IDENTIFICATIVOCAUSALESCARTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='QT_RECD_KO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='QT_RECD_KO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='QT_RECD_KO']/value)"&gt;&lt;tns1:QUANTITARECORDKO&gt;&lt;xsl:value-of select="column[name='QT_RECD_KO']/value"/&gt;&lt;/tns1:QUANTITARECORDKO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='QT_RECD_NOW']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='QT_RECD_NOW']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='QT_RECD_NOW']/value)"&gt;&lt;tns1:QUANTITARECORDNOW&gt;&lt;xsl:value-of select="column[name='QT_RECD_NOW']/value"/&gt;&lt;/tns1:QUANTITARECORDNOW&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='QT_RECD_OK']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='QT_RECD_OK']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='QT_RECD_OK']/value)"&gt;&lt;tns1:QUANTITARECORDOK&gt;&lt;xsl:value-of select="column[name='QT_RECD_OK']/value"/&gt;&lt;/tns1:QUANTITARECORDOK&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='QT_RECD_TOTALI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='QT_RECD_TOTALI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='QT_RECD_TOTALI']/value)"&gt;&lt;tns1:QUANTITARECORDTOTALI&gt;&lt;xsl:value-of select="column[name='QT_RECD_TOTALI']/value"/&gt;&lt;/tns1:QUANTITARECORDTOTALI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='ID_INTRFC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_INTRFC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_INTRFC']/value)"&gt;&lt;tns1:IDINTERFACCIA&gt;&lt;xsl:value-of select="column[name='ID_INTRFC']/value"/&gt;&lt;/tns1:IDINTERFACCIA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='ID_PROCSO_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_PROCSO_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_PROCSO_FILE']/value)"&gt;&lt;tns1:IDESECPROCFILE&gt;&lt;xsl:value-of select="column[name='ID_PROCSO_FILE']/value"/&gt;&lt;/tns1:IDESECPROCFILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='ESITO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ESITO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ESITO']/value)"&gt;&lt;tns1:ESITO&gt;&lt;xsl:value-of select="column[name='ESITO']/value"/&gt;&lt;/tns1:ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='TIMSTP_APERTURA_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIMSTP_APERTURA_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIMSTP_APERTURA_FILE']/value)"&gt;&lt;tns1:APERTURAFILE&gt;&lt;xsl:value-of select="column[name='TIMSTP_APERTURA_FILE']/value"/&gt;&lt;/tns1:APERTURAFILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='TIMSTP_CHIUSURA_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='TIMSTP_CHIUSURA_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='TIMSTP_CHIUSURA_FILE']/value)"&gt;&lt;tns1:CHIUSURAFILE&gt;&lt;xsl:value-of select="column[name='TIMSTP_CHIUSURA_FILE']/value"/&gt;&lt;/tns1:CHIUSURAFILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='CODFC_OLO_AGCOM']/value)"&gt;&lt;tns1:CODOLOAGCOM&gt;&lt;xsl:value-of select="column[name='CODFC_OLO_AGCOM']/value"/&gt;&lt;/tns1:CODOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='DESCR_STATO_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_STATO_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_STATO_FILE']/value)"&gt;&lt;tns1:DESCRSTATOACQUISIZIONE&gt;&lt;xsl:value-of select="column[name='DESCR_STATO_FILE']/value"/&gt;&lt;/tns1:DESCRSTATOACQUISIZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='DATA_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DATA_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DATA_FILE']/value)"&gt;&lt;tns1:DATAFILE&gt;&lt;xsl:value-of select="column[name='DATA_FILE']/value"/&gt;&lt;/tns1:DATAFILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='IDFILES']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDFILES']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDFILES']/value)"&gt;&lt;tns1:IDFILE&gt;&lt;xsl:value-of select="column[name='IDFILES']/value"/&gt;&lt;/tns1:IDFILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='DATA_ARRIVO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DATA_ARRIVO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DATA_ARRIVO']/value)"&gt;&lt;tns1:DATA_ARRIVO&gt;&lt;xsl:value-of select="column[name='DATA_ARRIVO']/value"/&gt;&lt;/tns1:DATA_ARRIVO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(string(column[name='QT_RECD_TOTALI']/value))&gt;0 and string-length(string(column[name='QT_RECD_NOW']/value))&gt;0"&gt;&lt;tns1:TOT_ORDINI_CRMWS&gt;&lt;xsl:value-of select="xsd:int(string(column[name='QT_RECD_TOTALI']/value))-xsd:int(string(column[name='QT_RECD_NOW']/value))"/&gt;&lt;/tns1:TOT_ORDINI_CRMWS&gt;&lt;/xsl:if&gt;&lt;xsl:if test="not((string(column[name='IDTPLG_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDTPLG_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDTPLG_FILE']/value)"&gt;&lt;tns1:ID_TIPOLOGIA_FILE&gt;&lt;xsl:value-of select="column[name='IDTPLG_FILE']/value"/&gt;&lt;/tns1:ID_TIPOLOGIA_FILE&gt;&lt;/xsl:if&gt;&lt;/tns1:NewElement&gt;&lt;/xsl:for-each&gt;&lt;/tns1:visualizzaOutput&gt;&lt;/parameters&gt;&lt;/tns:visualizzazioneResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NewFileListe/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/Semaforo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;listaFile&quot;/>&#xa;    &lt;xsl:template name=&quot;visulizzazioneOut1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:visualizzaOutput>&#xa;            &lt;xsl:for-each select=&quot;$listaFile/unknownResultset[1]/row&quot;>&#xa;                &lt;tns1:NewElement>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NOME_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NOME_FILE']/value)&quot;>&#xa;                        &lt;tns1:NOMEFILE>&#xa;                            &lt;xsl:value-of select=&quot;column[name='NOME_FILE']/value&quot;/>&#xa;                        &lt;/tns1:NOMEFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='DIMENSIONE_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DIMENSIONE_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DIMENSIONE_FILE']/value)&quot;>&#xa;                        &lt;tns1:DIMENSIONEFILE>&#xa;                            &lt;xsl:value-of select=&quot;column[name='DIMENSIONE_FILE']/value&quot;/>&#xa;                        &lt;/tns1:DIMENSIONEFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='DESCR_CAUS_SCARTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DESCR_CAUS_SCARTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DESCR_CAUS_SCARTO']/value)&quot;>&#xa;                        &lt;tns1:IDENTIFICATIVOCAUSALESCARTO>&#xa;                            &lt;xsl:value-of select=&quot;column[name='DESCR_CAUS_SCARTO']/value&quot;/>&#xa;                        &lt;/tns1:IDENTIFICATIVOCAUSALESCARTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='QT_RECD_KO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='QT_RECD_KO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='QT_RECD_KO']/value)&quot;>&#xa;                        &lt;tns1:QUANTITARECORDKO>&#xa;                            &lt;xsl:value-of select=&quot;column[name='QT_RECD_KO']/value&quot;/>&#xa;                        &lt;/tns1:QUANTITARECORDKO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='QT_RECD_NOW']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='QT_RECD_NOW']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='QT_RECD_NOW']/value)&quot;>&#xa;                        &lt;tns1:QUANTITARECORDNOW>&#xa;                            &lt;xsl:value-of select=&quot;column[name='QT_RECD_NOW']/value&quot;/>&#xa;                        &lt;/tns1:QUANTITARECORDNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='QT_RECD_OK']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='QT_RECD_OK']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='QT_RECD_OK']/value)&quot;>&#xa;                        &lt;tns1:QUANTITARECORDOK>&#xa;                            &lt;xsl:value-of select=&quot;column[name='QT_RECD_OK']/value&quot;/>&#xa;                        &lt;/tns1:QUANTITARECORDOK>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='QT_RECD_TOTALI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='QT_RECD_TOTALI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='QT_RECD_TOTALI']/value)&quot;>&#xa;                        &lt;tns1:QUANTITARECORDTOTALI>&#xa;                            &lt;xsl:value-of select=&quot;column[name='QT_RECD_TOTALI']/value&quot;/>&#xa;                        &lt;/tns1:QUANTITARECORDTOTALI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='ID_INTRFC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_INTRFC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_INTRFC']/value)&quot;>&#xa;                        &lt;tns1:IDINTERFACCIA>&#xa;                            &lt;xsl:value-of select=&quot;column[name='ID_INTRFC']/value&quot;/>&#xa;                        &lt;/tns1:IDINTERFACCIA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='ID_PROCSO_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ID_PROCSO_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ID_PROCSO_FILE']/value)&quot;>&#xa;                        &lt;tns1:IDESECPROCFILE>&#xa;                            &lt;xsl:value-of select=&quot;column[name='ID_PROCSO_FILE']/value&quot;/>&#xa;                        &lt;/tns1:IDESECPROCFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='ESITO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='ESITO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='ESITO']/value)&quot;>&#xa;                        &lt;tns1:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;column[name='ESITO']/value&quot;/>&#xa;                        &lt;/tns1:ESITO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='TIMSTP_APERTURA_FILE']/value/@xsi:nil)