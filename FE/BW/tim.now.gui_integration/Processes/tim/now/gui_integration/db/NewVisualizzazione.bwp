                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a631911d-dd1e-4000-a30e-a80c5eae672b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/Semaforo&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/Semaforo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getListaFile.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;FileList-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;ROCN.ID_FILE_PROCSTO_INPUT>&#xa;                &lt;xsl:value-of select=&quot;$getListaFile.parameters/tns2:clientCode&quot;/>&#xa;            &lt;/ROCN.ID_FILE_PROCSTO_INPUT>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
