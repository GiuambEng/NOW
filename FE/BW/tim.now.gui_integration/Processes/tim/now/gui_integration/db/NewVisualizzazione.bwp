                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/Semaforo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getStatoSemaforo&quot;/>&#xa;    &lt;xsl:template name=&quot;Semaforo&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:semaforoOutput>&#xa;            &lt;tns1:Output>&#xa;                &lt;tns1:semaforo>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GRIGIO&amp;quot;&quot;/>&#xa;                &lt;/tns1:semaforo>&#xa;                &lt;xsl:if test=&quot;$getStatoSemaforo/parameters/tns1:semaforoInput/tns1:semaforoInput1[1]/tns1:idFile&quot;>&#xa;                    &lt;tns1:idFile>&#xa;                        &lt;xsl:value-of select=&quot;$getStatoSemaforo/parameters/tns1:semaforoInput/tns1:semaforoInput1[1]/tns1:idFile&quot;/>&#xa;                    &lt;/tns1:idFile>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:Output>&#xa;        &lt;/tns1:semaforoOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
