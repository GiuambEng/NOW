OM&gt;&lt;xsl:value-of select="CODFC_OLO_AGCOM"/&gt;&lt;/tns1:CODOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;tns1:DESCRSTATOACQUISIZIONE&gt;&lt;xsl:value-of select="DESCR"/&gt;&lt;/tns1:DESCRSTATOACQUISIZIONE&gt;&lt;xsl:if test="DATA_FILE"&gt;&lt;tns1:DATAFILE&gt;&lt;xsl:value-of select="DATA_FILE"/&gt;&lt;/tns1:DATAFILE&gt;&lt;/xsl:if&gt;&lt;tns1:IDFILE&gt;&lt;xsl:value-of select="xsd:string(IDFILES)"/&gt;&lt;/tns1:IDFILE&gt;&lt;tns1:DATA_ARRIVO&gt;&lt;xsl:value-of select="DATA_ARRIVO"/&gt;&lt;/tns1:DATA_ARRIVO&gt;&lt;tns1:TOT_ORDINI_CRMWS&gt;&lt;xsl:value-of select="xsd:int(QT_RECD_TOTALI)-xsd:int(QT_RECD_NOW)"/&gt;&lt;/tns1:TOT_ORDINI_CRMWS&gt;&lt;tns1:ID_TIPOLOGIA_FILE&gt;&lt;xsl:value-of select="IDTPLG_FILE"/&gt;&lt;/tns1:ID_TIPOLOGIA_FILE&gt;&lt;/tns1:lista&gt;&lt;/xsl:for-each&gt;&lt;/tns1:listaAttributiRecuperati&gt;&lt;/tns1:VisualizzaNonOloOutput&gt;&lt;/parameters&gt;&lt;/tns:getNonOloResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NewFileListe/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/Semaforo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NONOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;getNonOloOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VisualizzaNonOloOutput>&#xa;            &lt;tns1:listaAttributiRecuperati>&#xa;                &lt;xsl:for-each select=&quot;$NONOLO/Record&quot;>&#xa;                    &lt;tns1:lista>&#xa;                        &lt;tns1:NOMEFILE>&#xa;                            &lt;xsl:value-of select=&quot;NOME_FILE&quot;/>&#xa;                        &lt;/tns1:NOMEFILE>&#xa;                        &lt;tns1:DIMENSIONEFILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string(DIMENSIONE_FILE)&quot;/>&#xa;                        &lt;/tns1:DIMENSIONEFILE>&#xa;                        &lt;xsl:if test=&quot;ID_CAUS_SCARTO&quot;>&#xa;                            &lt;tns1:IDENTIFICATIVOCAUSALESCARTO>&#xa;                                &lt;xsl:value-of select=&quot;ID_CAUS_SCARTO&quot;/>&#xa;                            &lt;/tns1:IDENTIFICATIVOCAUSALESCARTO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:QUANTITARECORDKO>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string(QT_RECD_KO)&quot;/>&#xa;                        &lt;/tns1:QUANTITARECORDKO>&#xa;                        &lt;tns1:QUANTITARECORDNOW>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string(QT_RECD_NOW)&quot;/>&#xa;                        &lt;/tns1:QUANTITARECORDNOW>&#xa;                        &lt;tns1:QUANTITARECORDOK>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string(QT_RECD_OK)&quot;/>&#xa;                        &lt;/tns1:QUANTITARECORDOK>&#xa;                        &lt;tns1:QUANTITARECORDTOTALI>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string(QT_RECD_TOTALI)&quot;/>&#xa;                        &lt;/tns1:QUANTITARECORDTOTALI>&#xa;                        &lt;tns1:IDINTERFACCIA>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string(ID_INTRFC)&quot;/>&#xa;                        &lt;/tns1:IDINTERFACCIA>&#xa;                        &lt;tns1:IDESECPROCFILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string(ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                        &lt;/tns1:IDESECPROCFILE>&#xa;                        &lt;xsl:if test=&quot;ESITO&quot;>&#xa;                            &lt;tns1:ESITO>&#xa;                                &lt;xsl:value-of select=&quot;ESITO&quot;/>&#xa;                            &lt;/tns1:ESITO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:APERTURAFILE>&#xa;                            &lt;xsl:value-of select=&quot;TIMSTP_APERTURA_FILE&quot;/>&#xa;                        &lt;/tns1:APERTURAFILE>&#xa;                        &lt;xsl:if test=&quot;TIMSTP_CHIUSURA_FILE&quot;>&#xa;                            &lt;tns1:CHIUSURAFILE>&#xa;                                &lt;xsl:value-of select=&quot;TIMSTP_CHIUSURA_FILE&quot;/>&#xa;                            &lt;/tns1:CHIUSURAFILE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                            &lt;tns1:CODOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns1:CODOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:DESCRSTATOACQUISIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;DESCR&quot;/>&#xa;                        &lt;/tns1:DESCRSTATOACQUISIZIONE>&#xa;                        &lt;xsl:if test=&quot;DATA_FILE&quot;>&#xa;                            &lt;tns1:DATAFILE>&#xa;                                &lt;xsl:value-of select=&quot;DATA_FILE&quot;/>&#xa;                            &lt;/tns1:DATAFILE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:IDFILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:string(IDFILES)&quot;/>&#xa;                        &lt;/tns1:IDFILE>&#xa;                        &lt;tns1:DATA_ARRIVO>&#xa;                            &lt;xsl:value-of select=&quot;DATA_ARRIVO&quot;/>&#xa;                        &lt;/tns1:DATA_ARRIVO>&#xa;                        &lt;tns1:TOT_ORDINI_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(QT_RECD_TOTALI)-xsd:int(QT_RECD_NOW)&quot;/>&#xa;                        &lt;/tns1:TOT_ORDINI_CRMWS>&#xa;                        &lt;tns1:ID_TIPOLOGIA_FILE>&#xa;                            &lt;xsl:value-of select=&quot;IDTPLG_FILE&quot;/>&#xa;                        &lt;/tns1:ID_TIPOLOGIA_FILE>&#xa;                    &lt;/tns1:lista>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns1:listaAttributiRecuperati>&#xa;        &lt;/tns1:VisualizzaNonOloOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
