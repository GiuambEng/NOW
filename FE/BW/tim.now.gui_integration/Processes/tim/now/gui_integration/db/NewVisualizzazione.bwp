                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ROCN.TIMSTP_CREAZIONE, ROCN.IDRICH_COM_STRC,A2.DATA_FILE , A2.ESITO, A2.TIMSTP_APERTURA_FILE, A2.CODFC_OLO_AGCOM, A2.TIMSTP_CHIUSURA_FILE,&#xa;   A2.ID_FILE, (SELECT STNTF&#xa;                                                       FROM APPUSER.TIPOLG_STNTF&#xa;                                                       WHERE IDTPLG_STNTF = ROCN.COD_TIPOLG_NOTF) AS DESCR_STATO_NOTIFICA,&#xa;  A1.ID_FILE_PROCSTO_INPUT, A2.NOME_FILE, A1.QT_RECD_KO, A1.QT_RECD_NOW,&#xa;  A1.QT_RECD_OK, A1.QT_RECD_TOTALI, A1.ID_CAUS_SCARTO, a1.DIMENSIONE_FILE, (SELECT TIMSTP_AGGTO&#xa;                                                          FROM APPUSER.RICH_OLO_DETT&#xa;                                                          WHERE APPUSER.RICH_OLO_DETT.ID_RICH_OLO = ROCN.ID_RICH_OLO) AS TIMESTAMP_AGG&#xa;  FROM APPUSER.RICH_ORDN_COMUNIC_NOTF ROCN, APPUSER.FILE_PROCSTO_INPUT A1,&#xa;       APPUSER.FILE_PROCSTO A2&#xa;  WHERE ROCN.ID_FILE_PROCSTO_INPUT = A1.ID_FILE_PROCSTO_INPUT&#xa;    AND A1.ID_FILE_PROCSTO_INPUT = A2.ID_FILE AND ROCN.ID_FILE_PROCSTO_INPUT = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ROCN.ID_FILE_PROCSTO_INPUT"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDRICH_COM_STRC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATA_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="ESITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_APERTURA_FILE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CHIUSURA_FILE"
