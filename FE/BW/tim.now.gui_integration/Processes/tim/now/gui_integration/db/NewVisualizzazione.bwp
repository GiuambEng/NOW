                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='DATA_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DATA_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DATA_FILE']/value)&quot;>&#xa;                        &lt;tns1:DATAFILE>&#xa;                            &lt;xsl:value-of select=&quot;column[name='DATA_FILE']/value&quot;/>&#xa;                        &lt;/tns1:DATAFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='IDFILES']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDFILES']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDFILES']/value)&quot;>&#xa;                        &lt;tns1:IDFILE>&#xa;                            &lt;xsl:value-of select=&quot;column[name='IDFILES']/value&quot;/>&#xa;                        &lt;/tns1:IDFILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='DATA_ARRIVO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='DATA_ARRIVO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='DATA_ARRIVO']/value)&quot;>&#xa;                        &lt;tns1:DATA_ARRIVO>&#xa;                            &lt;xsl:value-of select=&quot;column[name='DATA_ARRIVO']/value&quot;/>&#xa;                        &lt;/tns1:DATA_ARRIVO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(string(column[name='QT_RECD_TOTALI']/value))>0 and string-length(string(column[name='QT_RECD_NOW']/value))>0&quot;>&#xa;                        &lt;tns1:TOT_ORDINI_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(string(column[name='QT_RECD_TOTALI']/value))-xsd:int(string(column[name='QT_RECD_NOW']/value))&quot;/>&#xa;                        &lt;/tns1:TOT_ORDINI_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name='IDTPLG_FILE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='IDTPLG_FILE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='IDTPLG_FILE']/value)&quot;>&#xa;                        &lt;tns1:ID_TIPOLOGIA_FILE>&#xa;                            &lt;xsl:value-of select=&quot;column[name='IDTPLG_FILE']/value&quot;/>&#xa;                        &lt;/tns1:ID_TIPOLOGIA_FILE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:NewElement>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:visualizzaOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
