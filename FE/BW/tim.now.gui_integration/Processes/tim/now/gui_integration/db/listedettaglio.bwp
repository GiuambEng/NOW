                                    sqlStatement="SELECT VALOREATTRIBUTO,IDASSET&#xa;  FROM APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST&#xa;  WHERE NOMEATTRIBUTO = 'ORADES'&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
