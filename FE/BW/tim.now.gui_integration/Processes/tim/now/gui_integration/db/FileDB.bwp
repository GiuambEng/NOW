                                    <bpws:source linkName="verde-gialloToSEMAFOROOut_GiallooVerde">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$verde-giallo/Record[1]/ID_FILE_PROCSTO_INPUT = $verde-giallo/Record[1]/QT_RECD_NOW" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
