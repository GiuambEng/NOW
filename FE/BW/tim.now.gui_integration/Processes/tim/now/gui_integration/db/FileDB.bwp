                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8ba37651-50a0-430b-a579-63f1ed08b72a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/FileList/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SEMAFORO1.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;ID_FILE_PROCSTO_INPU>&#xa;                &lt;xsl:value-of select=&quot;$SEMAFORO1.parameters/tns1:IDFILE&quot;/>&#xa;            &lt;/ID_FILE_PROCSTO_INPU>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
