ue-of select=&quot;xsd:date(TIMSTP_INVIO)&quot;/>&#xa;                    &lt;/tns1:DataInvio>&#xa;                &lt;/tns1:Visualizza>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:VisualizzaOutput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
