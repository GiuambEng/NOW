                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT&#xd;&#xa;ROCN.TIMSTP_CREAZIONE,ROCN.IDRICH_COM_STRC,&#xd;&#xa;(SELECT STNTF FROM tipolg_stntf where IDTPLG_STNTF=ROCN.COD_TIPOLG_NOTF) as descr_stato_notifica,&#xd;&#xa;a1.ID_FILE_PROCSTO_INPUT,a2.nome_file,&#xd;&#xa;a1.QT_RECD_KO,a1.QT_RECD_NOW,a1.QT_RECD_OK,a1.QT_RECD_TOTALI,a1.ID_CAUS_SCARTO,&#xd;&#xa;(SELECT TIMSTP_AGGTO FROM rich_olo_dett where ID_RICH_OLO=ROCN.ID_RICH_OLO) as timestamp_agg&#xd;&#xa;FROM&#xd;&#xa;rich_ordn_comunic_notf ROCN,&#xd;&#xa;file_procsto_input a1,&#xd;&#xa;file_procsto a2&#xd;&#xa;where&#xd;&#xa;ROCN.ID_FILE_PROCSTO_INPUT=a1.ID_FILE_PROCSTO_INPUT&#xd;&#xa;and&#xd;&#xa;a1.ID_FILE_PROCSTO_INPUT=a2.ID_FILE&#xd;&#xa;and ROCN.ID_FILE_PROCSTO_INPUT= ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ROCN.ID_FILE_PROCSTO_INPUT"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="IDRICH_COM_STRC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_STATO_NOTIFICA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_FILE_PROCSTO_INPUT"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="QT_RECD_KO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_NOW"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_OK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_TOTALI"
