                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FILE_PROCSTO_INPUT, QT_RECD_NOW&#xa;FROM FILE_PROCSTO_INPUT A&#xa;WHERE ID_FILE_PROCSTO_INPUT in (?)&#xa;AND QT_RECD_NOW = (&#xa;SELECT count(*)&#xa;FROM BDS_1_CASEDATA_RICHIESTA&#xa;WHERE&#xa;IDFILEINPUT=A.ID_FILE_PROCSTO_INPUT&#xa;AND AMBITO='NOW'&#xa;AND STATORICHIESTAOLO in ('Scartato','Espletamento Tecnico', 'Espletamento Tecnico KO'))&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
