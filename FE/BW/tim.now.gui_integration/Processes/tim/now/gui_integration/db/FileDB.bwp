                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FPO.DIMENSIONE_FILE, FPO.ESITO_INVIO, FPO.QT_RECD_TOTALI,&#xa;       FPO.TIMSTP_CREZIONE_FILE, FPO.TIMSTP_INVIO, FP.NOME_FILE,&#xa;       FP.CODFC_OLO_AGCOM, FP.IDTPLG_FILE AS TIPOLOGIA, TP.DESCR, TP.IDTPLG_FILE&#xa;FROM   FILE_PROCSTO_OUTPUT FPO, FILE_PROCSTO FP, TIPOLG_FILE TP&#xa;WHERE  FP.CODFC_OLO_AGCOM = ? AND FP.VERSO_DEL_FILE = 'OUTPUT' AND&#xa;       FP.IDTPLG_FILE = TP.IDTPLG_FILE" xsi:type="jdbcPalette:JDBCQueryActivity">

