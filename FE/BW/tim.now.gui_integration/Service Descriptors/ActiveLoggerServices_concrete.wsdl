<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:jms="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS" xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/ActiveLoggerServices" xmlns:ns0="http://www.tim.com/NOW/xsd/SoapActiveLogger" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="ActiveLoggerServices" targetNamespace="http://www.tim.com/NOW/wsdl/abstract/ActiveLoggerServices">
  <wsdl:types>
    <xsd:schema xmlns:tns="http://www.tim.com/NOW/xsd/SoapActiveLogger" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/SoapActiveLogger">
      <xsd:complexType name="Envelope_type">
        <xsd:sequence>
          <xsd:element name="Identifier" type="tns:IdentifierType"/>
          <xsd:element minOccurs="0" name="track_position" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="Timestamp" type="xsd:dateTime"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="PayloadType" type="xsd:string"/>
          <xsd:element minOccurs="0" name="TransportInfo" type="tns:TransportInfoType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="ErrorLog_Type">
        <xsd:sequence>
          <xsd:element maxOccurs="1" minOccurs="0" name="TimeStamp" type="xsd:dateTime"/>
          <xsd:element name="Descrizione" type="xsd:string"/>
          <xsd:element name="Codice" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" ref="tns:track_position"/>
          <xsd:element name="ErrorReport" type="tns:ErrorReportType"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="TransportInfo" type="tns:TransportInfoType"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="ErrorReportType">
        <xsd:sequence>
          <xsd:element name="StackTrace" type="xsd:string"/>
          <xsd:element name="Msg" type="xsd:string"/>
          <xsd:element name="FullClass" type="xsd:string"/>
          <xsd:element name="Class" type="xsd:string"/>
          <xsd:element name="ProcessStack" type="xsd:string"/>
          <xsd:element name="MsgCode" type="xsd:string"/>
          <xsd:element name="Data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:any minOccurs="0"/>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="IdentifierType">
        <xsd:sequence>
          <xsd:element name="ServiceName" type="xsd:string"/>
          <xsd:element minOccurs="0" name="EndpointURL" type="xsd:string"/>
          <xsd:element minOccurs="0" name="Operation" type="xsd:string"/>
          <xsd:element name="Source" type="xsd:string"/>
          <xsd:element name="BusinessID" type="xsd:string"/>
          <xsd:element name="EventID" type="xsd:string"/>
          <xsd:element minOccurs="0" name="CorrelationID" type="xsd:string"/>
          <xsd:element minOccurs="0" name="EventType" type="xsd:string"/>
          <xsd:element name="trackID" type="xsd:string"/>
          <xsd:element minOccurs="0" name="ErrorId" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="LogMessage_Type">
        <xsd:sequence>
          <xsd:element minOccurs="0" name="PayloadType">
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:enumeration value="XML_STRING"/>
                <xsd:enumeration value="ZIPPED"/>
                <xsd:enumeration value="BINARY"/>
                <xsd:enumeration value=""/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element maxOccurs="1" minOccurs="0" name="TransportInfo" type="tns:TransportInfoType"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="TimeStamp" type="xsd:dateTime"/>
          <xsd:element name="Playload">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="Binary" type="xsd:base64Binary"/>
                <xsd:element name="XMLString" type="xsd:string"/>
              </xsd:sequence>
            </xsd:complexType>
          </xsd:element>
          <xsd:element ref="tns:track_position"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="LogType">
        <xsd:sequence>
          <xsd:element minOccurs="0" name="Timestamp" type="xsd:dateTime"/>
          <xsd:element name="severity_level">
            <xsd:simpleType>
              <xsd:restriction base="xsd:string"/>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element ref="tns:track_position"/>
          <xsd:element name="message" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="TransportInfoType">
        <xsd:sequence>
          <xsd:element minOccurs="0" name="TransportType">
            <xsd:complexType>
              <xsd:attribute form="unqualified" name="name" type="xsd:string"/>
              <xsd:attribute form="unqualified" name="relationShip" type="xsd:string"/>
            </xsd:complexType>
          </xsd:element>
          <xsd:element minOccurs="0" name="DestinationName" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:element name="track_position" type="xsd:string"/>
      <xsd:complexType name="TrackPosition"/>
      <xsd:complexType name="track_position"/>
      <xsd:element name="CW_BUS_MESSAGE">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Envelope" type="tns:Envelope_type"/>
            <xsd:element name="Playload">
              <xsd:complexType>
                <xsd:sequence>
                  <xsd:element minOccurs="0" name="Binary" type="xsd:base64Binary"/>
                  <xsd:element minOccurs="0" name="XMLString" type="xsd:string"/>
                </xsd:sequence>
              </xsd:complexType>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="ErrorLog" type="tns:ErrorLog_Type"/>
      <xsd:element name="Log" type="tns:LogType"/>
      <xsd:element name="LoggerInput">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Identifier" type="tns:IdentifierType"/>
            <xsd:choice>
              <xsd:element name="LogActivity" type="tns:LogType"/>
              <xsd:element name="LogError" type="tns:ErrorLog_Type"/>
              <xsd:element name="LogMsg" type="tns:LogMessage_Type"/>
            </xsd:choice>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="MessageId" type="xsd:string"/>
    </xsd:schema>
  </wsdl:types>
  <wsdl:message name="LogRequest">
    <wsdl:part element="ns0:LoggerInput" name="parameters"/>
  </wsdl:message>
  <wsdl:portType name="ActiveLoggerServices">
    <wsdl:operation name="Log">
      <wsdl:input message="ns:LogRequest"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="SOAPServiceBinding2" type="ns:ActiveLoggerServices">
    <soap:binding style="document" transport="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS"/>
    <jms:binding messageFormat="bytes"/>
    <wsdl:operation name="Log">
      <soap:operation soapAction="Log" style="document"/>
      <wsdl:input>
        <soap:body parts="parameters" use="literal"/>
      </wsdl:input>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="ActiveLoggerServices">
    <wsdl:port binding="ns:SOAPServiceBinding2" name="ActiveLoggerServicesSOAP">
      <soap:address location="tibjmsnaming://lv160045.vtlab.local:7224"/>
      <jms:connectionFactory>QueueConnectionFactory</jms:connectionFactory>
      <jms:targetAddress destination="queue">tim.now.tracking_applicativo.fe.integr.logger</jms:targetAddress>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
