<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/UnicaRAQueuePositionMonitor/" xmlns:ns0="http://www.tim.com/NOW/xsd/UnicaRAQueuePositionMonitor" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="QueuePositionMonitorPortType" targetNamespace="http://www.tim.com/NOW/wsdl/abstract/UnicaRAQueuePositionMonitor/">
  <wsdl:types>
    <xsd:schema xmlns:tns="http://www.tim.com/NOW/xsd/UnicaRAQueuePositionMonitor" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/UnicaRAQueuePositionMonitor">
      <xsd:element name="REQUEST">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element minOccurs="1" name="ID_RISORSA" type="xsd:string"/>
            <xsd:element minOccurs="0" name="DISTRETTO">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="3"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element maxOccurs="1" minOccurs="1" name="ID_TELEFONICO">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="20"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element maxOccurs="1" minOccurs="1" name="NOME_SERVIZIO">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:enumeration value="VisualizzaPosizione"/>
