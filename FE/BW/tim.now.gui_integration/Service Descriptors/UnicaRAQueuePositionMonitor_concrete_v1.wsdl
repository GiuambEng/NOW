                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element minOccurs="0" name="CLLI">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="11"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="RESPONSE">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element maxOccurs="1" minOccurs="1" name="ESITO">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:enumeration value="1000"/>
                  <xsd:enumeration value="1001"/>
                  <xsd:enumeration value="2000"/>
                  <xsd:enumeration value=""/>
                  <xsd:maxLength value="4"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element maxOccurs="1" minOccurs="1" name="DESCRIZIONE_ESITO">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:length value="1"/>
                  <xsd:enumeration value="ERRORE WRAPPER"/>
                  <xsd:enumeration value="ERRORE APPLICATIVO"/>
                  <xsd:enumeration value="ERRORE: reperimento dati da XML"/>
                  <xsd:enumeration value=""/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element maxOccurs="1" minOccurs="1" name="ESITO_TELEFONICO">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="2"/>
                  <xsd:enumeration value="01"/>
                  <xsd:enumeration value="02"/>
                  <xsd:enumeration value="03"/>
                  <xsd:enumeration value=""/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element maxOccurs="1" minOccurs="1" name="POSIZIONE_ORDINATIVO">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="2"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element maxOccurs="1" minOccurs="1" name="LUNGHEZZA_CODA">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="2"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </wsdl:types>
  <wsdl:message name="QueuePositionMonitorOpRequest">
    <wsdl:part element="ns0:REQUEST" name="parameters"/>
  </wsdl:message>
  <wsdl:message name="QueuePositionMonitorOpResponse">
    <wsdl:part element="ns0:RESPONSE" name="parameters"/>
  </wsdl:message>
  <wsdl:portType name="QueuePositionMonitorPortType">
    <wsdl:operation name="QueuePositionMonitorOp">
      <wsdl:input message="ns:QueuePositionMonitorOpRequest"/>
      <wsdl:output message="ns:QueuePositionMonitorOpResponse"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="QueuePositionMonitorServiceBinding" type="ns:QueuePositionMonitorPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="QueuePositionMonitorOp">
      <soap:operation soapAction="QueuePositionMonitorOp" style="document"/>
      <wsdl:input>
        <soap:body parts="parameters" use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body parts="parameters" use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="QueuePositionMonitorPortType">
    <wsdl:port binding="ns:QueuePositionMonitorServiceBinding" name="QueuePositionMonitorPortTypeSOAP">
      <soap:address location="http://localhost:18120/QueuePositionMonitorServiceBinding/queuePositionMonitorPortType/"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
