                <bpws:link name="Assign1ToEnd2" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="15c86fcc-feb1-46e1-a37e-8f2c831c478d"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToAssign_VARIAZIONEWLR">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (upper-case($Start/ns0:Servizio)='WRLLINEAATTIVA' or upper-case($Start/ns0:Servizio)='WRLLINEANONATTIVA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (upper-case($Start/ns0:Servizio)='WRLLINEAATTIVA' or upper-case($Start/ns0:Servizio)='WRLLINEANONATTIVA')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign_VARIAZIONEULL">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (upper-case($Start/ns0:Servizio)='ULLDATILINEANONATTIVA' or upper-case($Start/ns0:Servizio)='ULLDATILINEAATTIVA' or upper-case($Start/ns0:Servizio)='ULLLINEANONATTIVA' or upper-case($Start/ns0:Servizio)='ULLLINEAATTIVA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (upper-case($Start/ns0:Servizio)='ULLDATILINEANONATTIVA' or upper-case($Start/ns0:Servizio)='ULLDATILINEAATTIVA' or upper-case($Start/ns0:Servizio)='ULLLINEANONATTIVA' or upper-case($Start/ns0:Servizio)='ULLLINEAATTIVA')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign_VARIAZIONESHA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (upper-case($Start/ns0:Servizio)='SHACONMANODOPERA' or upper-case($Start/ns0:Servizio)='SHASENZAMANODOPERA' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (upper-case($Start/ns0:Servizio)='SHACONMANODOPERA' or upper-case($Start/ns0:Servizio)='SHASENZAMANODOPERA' )]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign_VARIAZIONESLU">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (upper-case($Start/ns0:Servizio)='SLULINEANONATTIVA' or upper-case($Start/ns0:Servizio)='SLULINEAATTIVA' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (upper-case($Start/ns0:Servizio)='SLULINEANONATTIVA' or upper-case($Start/ns0:Servizio)='SLULINEAATTIVA' )]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign_VARIAZIONEDATIXDSL">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamATMAsim')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamGBEAsim')) or contains(upper-case($Start/ns0:Servizio),upper-case('EasyIPSpecialProfile')))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamATMAsim')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamGBEAsim')) or contains(upper-case($Start/ns0:Servizio),upper-case('EasyIPSpecialProfile')))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign1_VARIAZIONEDATINGA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamNGAFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('VULAFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamNGAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('VULAFTTH')))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='VARIAZIONE' and (contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamNGAFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('VULAFTTCAB')) or contains(upper-case($Start/ns0:Servizio),upper-case('BitstreamNGAFTTH')) or contains(upper-case($Start/ns0:Servizio),upper-case('VULAFTTH')))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign1_MIGRAZIONIREGOLAMENTATE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)= 'MIGRAZIONE' and upper-case($Start/ns0:OffertaCatalogo)=('ULL','ULLDATI','SLU','WLR','SHA','VULL')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)= 'MIGRAZIONE' and upper-case($Start/ns0:OffertaCatalogo)=('ULL','ULLDATI','SLU','WLR','SHA','VULL')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign1_MIGRAZIONEXDSLNGA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($Start/ns0:Lavorazione)='MIGRAZIONE' and $Start/ns0:OffertaCatalogo =('BitstreamNGAFTTCAB','VULAFTTCAB','BitstreamATMAsimmetricoFlat', 'BitstreamATMAsimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:Lavorazione)='MIGRAZIONE' and $Start/ns0:OffertaCatalogo =('BitstreamNGAFTTCAB','VULAFTTCAB','BitstreamATMAsimmetricoFlat', 'BitstreamATMAsimmetricoHL', 'BitstreamATMAsimmetricoLite', 'BitstreamGBEAsimmetricoFlat', 'EasyIPBasePlusFlat', 'EasyIPBasePlusLite', 'EasyIPSpecialProfileFlat', 'EasyIPSpecialProfileLite')]]></bpws:transitionCondition>
                        </bpws:source>
