/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA1_3>&lt;IDRISORSA2_3>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa2)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa2&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA2_3>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/tns2:codiceRisorsa1, 2, 1) = ('2','6')&quot;>&lt;IDRISORSA1_4>&lt;xsl:value-of select=&quot;concat('0', $Start/tns2:codiceRisorsa1)&quot;/>&lt;/IDRISORSA1_4>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($Start/tns2:codiceRisorsa1, 3, 1) = ('0','1','5','9')&quot;>&lt;IDRISORSA1_4>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA1_4>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDRISORSA1_4>&lt;xsl:value-of select=&quot;substring($Start/tns2:codiceRisorsa1, 2)&quot;/>&lt;/IDRISORSA1_4>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/tns2:codiceRisorsa2, 2, 1) = ('2','6')&quot;>&lt;IDRISORSA2_4>&lt;xsl:value-of select=&quot;concat('0', $Start/tns2:codiceRisorsa2)&quot;/>&lt;/IDRISORSA2_4>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($Start/tns2:codiceRisorsa2, 3, 1) = ('0','1','5','9')&quot;>&lt;IDRISORSA2_4>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa2)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa2&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA2_4>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDRISORSA2_4>&lt;xsl:value-of select=&quot;substring($Start/tns2:codiceRisorsa2, 2)&quot;/>&lt;/IDRISORSA2_4>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="servizioQuery-input"
