                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;servizioQuery&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;NPSincronizzata&quot;/>&lt;xsl:template name=&quot;servizioVariable&quot; match=&quot;/&quot;>&lt;tns1:outputVerificaServizioInConsistenza>&lt;tns1:OutputVerificaServizioInConsistenza>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codiceRisorsa1) and exists($Start/tns1:codiceRisorsa2)&quot;>&lt;xsl:if test=&quot;if ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO='FONIADATI') then 'FONIADATI' else if ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2)][1]/TIPOLOGIAACCESSO='FONIADATI') then 'FONIADATI' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO&amp;#xD;&amp;#xA;&quot;>&lt;tns1:tipologiaAccesso>&lt;xsl:value-of select=&quot;if ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO='FONIADATI') then 'FONIADATI' else if ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2)][1]/TIPOLOGIAACCESSO='FONIADATI') then 'FONIADATI' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO&amp;#xD;&amp;#xA;&quot;/>&lt;/tns1:tipologiaAccesso>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO&amp;#xD;&amp;#xA;&quot;>&lt;tns1:tipologiaAccesso>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO&amp;#xD;&amp;#xA;&quot;/>&lt;/tns1:tipologiaAccesso>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:codiceRisorsa1&quot;>&lt;tns1:codiceRisorsa>&lt;xsl:value-of select=&quot;$Start/tns1:codiceRisorsa1&quot;/>&lt;/tns1:codiceRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codiceRisorsa1) and exists($Start/tns1:codiceRisorsa2)&quot;>&lt;tns1:idOffertaDatiMCRO>&lt;xsl:value-of select=&quot;if (exists(xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and OFFERTA!='NP'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO))) then (xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)) else (xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO))&quot;/>&lt;/tns1:idOffertaDatiMCRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:idOffertaDatiMCRO>&lt;xsl:value-of select=&quot;xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and OFFERTA!='NP'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)&quot;/>&lt;/tns1:idOffertaDatiMCRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI'][1]/OFFERTA&quot;>&lt;tns1:offertaConsistenzaDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI'][1]/OFFERTA&quot;/>&lt;/tns1:offertaConsistenzaDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI'][1]/OFFERTA&quot;>&lt;tns1:offertaConsistenzaDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI'][1]/OFFERTA&quot;/>&lt;/tns1:offertaConsistenzaDati>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codiceRisorsa1) and exists($Start/tns1:codiceRisorsa2)&quot;>&lt;tns1:idOffertaFoniaMCRO>&lt;xsl:value-of select=&quot;if (exists(xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and OFFERTA!='NP'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO))) &amp;#xD;&amp;#xA;then (xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)) &amp;#xD;&amp;#xA;else (xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)) &quot;/>&lt;/tns1:idOffertaFoniaMCRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:idOffertaFoniaMCRO>&lt;xsl:value-of select=&quot;xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and OFFERTA !='NP'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)&quot;/>&lt;/tns1:idOffertaFoniaMCRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA'][1]/OFFERTA&quot;>&lt;tns1:offertaConsistenzaFonia>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA'][1]/OFFERTA&quot;/>&lt;/tns1:offertaConsistenzaFonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA'][1]/OFFERTA[1]&quot;>&lt;tns1:offertaConsistenzaFonia>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA'][1]/OFFERTA[1]&quot;/>&lt;/tns1:offertaConsistenzaFonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;>&lt;tns1:tipologiaLineaConsistenzaDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:tipologiaLineaConsistenzaDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;>&lt;tns1:tipologiaLineaConsistenzaDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:tipologiaLineaConsistenzaDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;>&lt;tns1:tipologiaLineaConsistenzaFonia>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:tipologiaLineaConsistenzaFonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;>&lt;tns1:tipologiaLineaConsistenzaFonia>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:tipologiaLineaConsistenzaFonia>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($servizioQuery/Record[NOMECOMPONENTE='NUMBERPORTABILITY'])&quot;>&lt;tns1:flagNPAsset>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:flagNPAsset>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NPSincronizzata/Record[CODFC_OLO_AGCOM!='TLC'])&quot;>&lt;tns1:flagNPAsset>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:flagNPAsset>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:flagNPAsset>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:flagNPAsset>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(upper-case($Start/tns1:codificaOloAgcom)!='TLC') or (upper-case($servizioQuery/Record[1]/CODIFICAOLOAGCOM)=upper-case($Start/tns1:codificaOloAgcom) and upper-case($Start/tns1:codificaOloAgcom)='TLC')&quot;>&lt;tns1:flagRientro>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:flagRientro>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:flagRientro>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:flagRientro>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($servizioQuery/Record[NOMEATTRIBUTO='FLAGNUMERAZIONIAGGIUNTIVE'])&quot;>&lt;tns1:flagAggiuntivo>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:flagAggiuntivo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:flagAggiuntivo>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:flagAggiuntivo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;>&lt;tns1:destinazioneUsoAssetDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;/>&lt;/tns1:destinazioneUsoAssetDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;>&lt;tns1:destinazioneUsoAssetDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;/>&lt;/tns1:destinazioneUsoAssetDati>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO) and exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains('2,3,1',$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'F'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:when test=&quot;contains('4,5,9,10',$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)='4' and ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM='TLC')&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'D'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)='10' and ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM='TLC')&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'TIFIBRA'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'D'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;if(contains($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO,'|')) then 'F+D' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;if(contains($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO,'|')) then 'F+D' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO) and contains(&amp;quot;2,3,1&amp;quot;,$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;contains('2,3,1',$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO) and contains('4,5,9,10',$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisor