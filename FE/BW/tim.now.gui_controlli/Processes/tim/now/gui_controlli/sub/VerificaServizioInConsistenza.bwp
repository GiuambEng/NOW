IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 2, 1) = &amp;quot;6&amp;quot; or substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 2, 1) = &amp;quot;2&amp;quot;) then concat(&amp;quot;0&amp;quot;, substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 1, 2)) else if(substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 3, 1) = &amp;quot;0&amp;quot; or substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 3, 1) = &amp;quot;1&amp;quot; or substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 3, 1) = &amp;quot;5&amp;quot; or substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 3, 1) = &amp;quot;9&amp;quot;) then substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 1, 3) else substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 2, 4)&quot;/>&lt;/COD_DISTR3>&lt;/xsl:when>&lt;xsl:otherwise>&lt;COD_DISTR3>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/COD_DISTR3>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2])&quot;>&lt;COD_DISTR4>&lt;xsl:value-of select=&quot;if(substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 2, 1) = &amp;quot;6&amp;quot; or substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 2, 1) = &amp;quot;2&amp;quot;) then concat(&amp;quot;0&amp;quot;, substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 1, 2)) else if(substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 3, 1) = &amp;quot;0&amp;quot; or substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 3, 1) = &amp;quot;1&amp;quot; or substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 3, 1) = &amp;quot;5&amp;quot; or substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 3, 1) = &amp;quot;9&amp;quot;) then substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 1, 3) else substring($servizioQuery/Record[IDRISORSA=$Start/tns1:codiceRisorsa2][1]/NUMEROTELEFONICO, 2, 4)&quot;/>&lt;/COD_DISTR4>&lt;/xsl:when>&lt;xsl:otherwise>&lt;COD_DISTR4>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/COD_DISTR4>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ARCO_NUMRZNE_DA2>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ARCO_NUMRZNE_DA2>&lt;ARCO_NUMRZNE_A2>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ARCO_NUMRZNE_A2>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
