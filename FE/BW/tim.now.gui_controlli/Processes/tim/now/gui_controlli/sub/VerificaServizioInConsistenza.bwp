                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="servizioQueryToJDBCQuery_OFFERTAWLR-VULL">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(upper-case($servizioQuery/Record[IDRISORSA=$Start/ns3:codiceRisorsa1][1]/OFFERTA)!='WLR' or upper-case($servizioQuery/Record[IDRISORSA=$Start/ns3:codiceRisorsa1][1]/OFFERTA)!='VULL' or upper-case($servizioQuery/Record[IDRISORSA=$Start/ns3:codiceRisorsa2][1]/OFFERTA)!='WLR' or upper-case($servizioQuery/Record[IDRISORSA=$Start/ns3:codiceRisorsa2][1]/OFFERTA)!='VULL') and not(exists($servizioQuery/Record[NOMECOMPONENTE='NUMBERPORTABILITY']))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(upper-case($servizioQuery/Record[IDRISORSA=$Start/ns3:codiceRisorsa1][1]/OFFERTA)!='WLR' or upper-case($servizioQuery/Record[IDRISORSA=$Start/ns3:codiceRisorsa1][1]/OFFERTA)!='VULL' or upper-case($servizioQuery/Record[IDRISORSA=$Start/ns3:codiceRisorsa2][1]/OFFERTA)!='WLR' or upper-case($servizioQuery/Record[IDRISORSA=$Start/ns3:codiceRisorsa2][1]/OFFERTA)!='VULL') and not(exists($servizioQuery/Record[NOMECOMPONENTE='NUMBERPORTABILITY']))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+690e61eb-5bc7-455f-9f04-ce89b6a3895b+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;servizioQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSA1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA1>&lt;IDRISORSA2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa2)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa2&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA2>&lt;IDRISORSA1_2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA1_2>&lt;IDRISORSA2_2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa2)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa2&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA2_2>&lt;IDRISORSA1_3>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA1_3>&lt;IDRISORSA2_3>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa2)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa2&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA2_3>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/tns2:codiceRisorsa1, 2, 1) = ('2','6')&quot;>&lt;IDRISORSA1_4>&lt;xsl:value-of select=&quot;concat('0', $Start/tns2:codiceRisorsa1)&quot;/>&lt;/IDRISORSA1_4>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($Start/tns2:codiceRisorsa1, 3, 1) = ('0','1','5','9')&quot;>&lt;IDRISORSA1_4>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa1)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa1&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA1_4>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDRISORSA1_4>&lt;xsl:value-of select=&quot;substring($Start/tns2:codiceRisorsa1, 2)&quot;/>&lt;/IDRISORSA1_4>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($Start/tns2:codiceRisorsa2, 2, 1) = ('2','6')&quot;>&lt;IDRISORSA2_4>&lt;xsl:value-of select=&quot;concat('0', $Start/tns2:codiceRisorsa2)&quot;/>&lt;/IDRISORSA2_4>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($Start/tns2:codiceRisorsa2, 3, 1) = ('0','1','5','9')&quot;>&lt;IDRISORSA2_4>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:codiceRisorsa2)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:codiceRisorsa2&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSA2_4>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDRISORSA2_4>&lt;xsl:value-of select=&quot;substring($Start/tns2:codiceRisorsa2, 2)&quot;/>&lt;/IDRISORSA2_4>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT O.ID_SOTTOFAMIG_OFFERTA_MCRO,A.IDASSET,A.IDRISORSA,A.OFFERTA,A.TIPOLOGIAACCESSO,A.NUMEROTELEFONICO,A.NUMEROFITTIZIO,&#xd;&#xa;A.CODIFICAOLOAGCOM,ADA.NOMEATTRIBUTO,ADA.VALOREATTRIBUTO,DA.NOMECOMPONENTE,DA.PROGRESSIVO&#xd;&#xa;from BDS_1_CASEDATA_ASSET A&#xd;&#xa;JOIN BDS_1_CASEDATA_DETTAGLIOASSET DA ON DA.ASSET_DETTAGLIOASSET_BDSID = A.BDS_ID&#xd;&#xa;JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST ADA ON ADA.DTTGLSST_TTRBTIDTTGLISST_BDSID = DA.BDS_ID&#xd;&#xa;LEFT JOIN OFFERTA O ON O.ID_OFFERTA=A.IDOFFERTA&#xd;&#xa;WHERE A.STATOASSET='ATTIVO' &#xd;&#xa;AND (A.IDRISORSA=? OR A.IDRISORSA=? OR A.NUMEROFITTIZIO=? OR  A.NUMEROFITTIZIO=? OR A.NUMEROTELEFONICO=? OR A.NUMEROTELEFONICO=? OR A.NUMEROFITTIZIO=? OR  A.NUMEROFITTIZIO=?)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA2"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA1_2"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA2_2"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA1_3"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA2_3"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA1_4"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA2_4"/>
                                    <columnMetadata
                                    columnName="ID_SOTTOFAMIG_OFFERTA_MCRO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIAACCESSO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROFITTIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROGRESSIVO"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;servizioQuery&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;NPSincronizzata&quot;/>&lt;xsl:template name=&quot;servizioVariable&quot; match=&quot;/&quot;>&lt;tns1:outputVerificaServizioInConsistenza>&lt;tns1:OutputVerificaServizioInConsistenza>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codiceRisorsa1) and exists($Start/tns1:codiceRisorsa2)&quot;>&lt;xsl:if test=&quot;if ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO='FONIADATI') then 'FONIADATI' else if ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2)][1]/TIPOLOGIAACCESSO='FONIADATI') then 'FONIADATI' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO&amp;#xD;&amp;#xA;&quot;>&lt;tns1:tipologiaAccesso>&lt;xsl:value-of select=&quot;if ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO='FONIADATI') then 'FONIADATI' else if ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2)][1]/TIPOLOGIAACCESSO='FONIADATI') then 'FONIADATI' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO&amp;#xD;&amp;#xA;&quot;/>&lt;/tns1:tipologiaAccesso>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO&amp;#xD;&amp;#xA;&quot;>&lt;tns1:tipologiaAccesso>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1)][1]/TIPOLOGIAACCESSO&amp;#xD;&amp;#xA;&quot;/>&lt;/tns1:tipologiaAccesso>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:codiceRisorsa1&quot;>&lt;tns1:codiceRisorsa>&lt;xsl:value-of select=&quot;$Start/tns1:codiceRisorsa1&quot;/>&lt;/tns1:codiceRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codiceRisorsa1) and exists($Start/tns1:codiceRisorsa2)&quot;>&lt;tns1:idOffertaDatiMCRO>&lt;xsl:value-of select=&quot;if (exists(xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and OFFERTA!='NP'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO))) then (xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)) else (xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO))&quot;/>&lt;/tns1:idOffertaDatiMCRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:idOffertaDatiMCRO>&lt;xsl:value-of select=&quot;xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and OFFERTA!='NP'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)&quot;/>&lt;/tns1:idOffertaDatiMCRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI'][1]/OFFERTA&quot;>&lt;tns1:offertaConsistenzaDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI'][1]/OFFERTA&quot;/>&lt;/tns1:offertaConsistenzaDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI'][1]/OFFERTA&quot;>&lt;tns1:offertaConsistenzaDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI'][1]/OFFERTA&quot;/>&lt;/tns1:offertaConsistenzaDati>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:codiceRisorsa1) and exists($Start/tns1:codiceRisorsa2)&quot;>&lt;tns1:idOffertaFoniaMCRO>&lt;xsl:value-of select=&quot;if (exists(xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and OFFERTA!='NP'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO))) &amp;#xD;&amp;#xA;then (xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)) &amp;#xD;&amp;#xA;else (xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)) &quot;/>&lt;/tns1:idOffertaFoniaMCRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:idOffertaFoniaMCRO>&lt;xsl:value-of select=&quot;xsd:int($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and OFFERTA !='NP'][1]/ID_SOTTOFAMIG_OFFERTA_MCRO)&quot;/>&lt;/tns1:idOffertaFoniaMCRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA'][1]/OFFERTA&quot;>&lt;tns1:offertaConsistenzaFonia>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA'][1]/OFFERTA&quot;/>&lt;/tns1:offertaConsistenzaFonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA'][1]/OFFERTA[1]&quot;>&lt;tns1:offertaConsistenzaFonia>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA'][1]/OFFERTA[1]&quot;/>&lt;/tns1:offertaConsistenzaFonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;>&lt;tns1:tipologiaLineaConsistenzaDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:tipologiaLineaConsistenzaDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;>&lt;tns1:tipologiaLineaConsistenzaDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:tipologiaLineaConsistenzaDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;>&lt;tns1:tipologiaLineaConsistenzaFonia>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:tipologiaLineaConsistenzaFonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;>&lt;tns1:tipologiaLineaConsistenzaFonia>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='TIPOLINEA'][1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:tipologiaLineaConsistenzaFonia>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($servizioQuery/Record[NOMECOMPONENTE='NUMBERPORTABILITY'])&quot;>&lt;tns1:flagNPAsset>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:flagNPAsset>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NPSincronizzata/Record[CODFC_OLO_AGCOM!='TLC'])&quot;>&lt;tns1:flagNPAsset>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:flagNPAsset>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:flagNPAsset>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:flagNPAsset>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(upper-case($Start/tns1:codificaOloAgcom)!='TLC') or (upper-case($servizioQuery/Record[1]/CODIFICAOLOAGCOM)=upper-case($Start/tns1:codificaOloAgcom) and upper-case($Start/tns1:codificaOloAgcom)='TLC')&quot;>&lt;tns1:flagRientro>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:flagRientro>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:flagRientro>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:flagRientro>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($servizioQuery/Record[NOMEATTRIBUTO='FLAGNUMERAZIONIAGGIUNTIVE'])&quot;>&lt;tns1:flagAggiuntivo>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:flagAggiuntivo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:flagAggiuntivo>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:flagAggiuntivo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;>&lt;tns1:destinazioneUsoAssetDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;/>&lt;/tns1:destinazioneUsoAssetDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;>&lt;tns1:destinazioneUsoAssetDati>&lt;xsl:value-of select=&quot;$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;/>&lt;/tns1:destinazioneUsoAssetDati>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO) and exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains('2,3,1',$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'F'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:when test=&quot;contains('4,5,9,10',$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)='4' and ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM='TLC')&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'D'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)='10' and ($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM='TLC')&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'TIFIBRA'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'D'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;if(contains($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO,'|')) then 'F+D' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;if(contains($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO,'|')) then 'F+D' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO) and contains(&amp;quot;2,3,1&amp;quot;,$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;contains('2,3,1',$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO) and contains('4,5,9,10',$servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)='4' and (($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM)='TLC')&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'D'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO)='10' and (($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM)='TLC')&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'TIFIBRA'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;'D'&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;if(contains($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO,'|')) then 'F+D' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;>&lt;tns1:destinazioneUsoAssetFonia>&lt;xsl:value-of select=&quot;if(contains($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO,'|')) then 'F+D' else $servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA' and NOMEATTRIBUTO='DESTINAZIONEUSO']/VALOREATTRIBUTO&quot;/>&lt;/tns1:destinazioneUsoAssetFonia>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='DATI']/CODIFICAOLOAGCOM)='TLC'&quot;>&lt;tns1:assetDatiStandard>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:assetDatiStandard>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:assetDatiStandard>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:assetDatiStandard>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI']/CODIFICAOLOAGCOM)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='DATI']/CODIFICAOLOAGCOM)='TLC'&quot;>&lt;tns1:assetDatiStandard>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:assetDatiStandard>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:assetDatiStandard>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:assetDatiStandard>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa1 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa1 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa1) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM)='TLC'&quot;>&lt;tns1:assetFoniaStandard>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:assetFoniaStandard>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:assetFoniaStandard>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:assetFoniaStandard>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($servizioQuery/Record[(IDRISORSA=$Start/tns1:codiceRisorsa2 or NUMEROFITTIZIO=$Start/tns1:codiceRisorsa2 or NUMEROTELEFONICO=$Start/tns1:codiceRisorsa2) and  TIPOLOGIAACCESSO='FONIA']/CODIFICAOLOAGCOM)='TLC'&quot;>&lt;tns1:assetFoniaStandard>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:assetFoniaStandard>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:assetFoniaStandard>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:assetFoniaStandard>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[NOMEATTRIBUTO='PROFILOTECNICOLINEA']/VALOREATTRIBUTO&quot;>&lt;tns1:profiloTecnicoLinea>&lt;xsl:value-of select=&quot;$servizioQuery/Record[NOMEATTRIBUTO='PROFILOTECNICOLINEA']/VALOREATTRIBUTO&quot;/>&lt;/tns1:profiloTecnicoLinea>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[1]/OFFERTA&quot;>&lt;tns1:offerta>&lt;xsl:value-of select=&quot;$servizioQuery/Record[1]/OFFERTA&quot;/>&lt;/tns1:offerta>&lt;/xsl:if>&lt;xsl:for-each-group select=&quot;$servizioQuery/Record[NOMECOMPONENTE='USERVLAN']&quot; group-by=&quot;PROGRESSIVO&quot;>&lt;tns1:userVlan>&lt;xsl:variable name=&quot;progressivoVar&quot; select=&quot;./PROGRESSIVO&quot;/>&lt;xsl:if test=&quot;$servizioQuery/Record[NOMEATTRIBUTO='USERVLANID' and PROGRESSIVO=$progressivoVar]/VALOREATTRIBUTO&quot;>&lt;tns1:userVlanId>&lt;xsl:value-of select=&quot;$servizioQuery/Record[NOMEATTRIBUTO='USERVLANID' and PROGRESSIVO=$progressivoVar]/VALOREATTRIBUTO&quot;/>&lt;/tns1:userVlanId>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[NOMEATTRIBUTO='BANDAPICCOUP' and PROGRESSIVO=$progressivoVar]/VALOREATTRIBUTO&quot;>&lt;tns1:bandaPiccoUp>&lt;xsl:value-of select=&quot;$servizioQuery/Record[NOMEATTRIBUTO='BANDAPICCOUP' and PROGRESSIVO=$progressivoVar]/VALOREATTRIBUTO&quot;/>&lt;/tns1:bandaPiccoUp>&lt;/xsl:if>&lt;xsl:if test=&quot;$servizioQuery/Record[NOMEATTRIBUTO='BANDAPICCODOWN' and PROGRESSIVO=$progressivoVar]/VALOREATTRIBUTO&quot;>&lt;tns1:bandaPiccoDown>&lt;xsl:value-of select=&quot;$servizioQuery/Record[NOMEATTRIBUTO='BANDAPICCODOWN' and PROGRESSIVO=$progressivoVar]/VALOREATTRIBUTO&quot;/>&lt;/tns1:bandaPiccoDown>&lt;/xsl:if>&lt;/tns1:userVlan>&lt;/xsl:for-each-group>&lt;/tns1:OutputVerificaServizioInConsistenza>&lt;/tns1:outputVerificaServizioInConsistenza>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="servizioVariable"
