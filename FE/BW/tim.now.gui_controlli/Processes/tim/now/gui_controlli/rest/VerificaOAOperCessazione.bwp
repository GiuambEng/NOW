                                    tibex:xpdlId="1e771724-11d9-4e88-b7e7-4ca0bb1b28f7" variable="Reply-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20160830171124PLT" xmlns:tns1="http://www.tim.com/NOW/cmf/VerificaOAOPerCessazione" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:getResponse2&gt;&lt;item&gt;&lt;tns1:outputVerificaOAOperCessazione&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/tns1:code&gt;&lt;tns1:details&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/tns1:details&gt;&lt;/tns1:result&gt;&lt;/tns1:outputVerificaOAOperCessazione&gt;&lt;/item&gt;&lt;/tns:getResponse2&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20160830171124PLT&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/VerificaOAOPerCessazione&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:outputVerificaOAOperCessazione>&#xa;            &lt;tns1:result>&#xa;                &lt;tns1:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                &lt;/tns1:severity>&#xa;                &lt;tns1:code>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/tns1:code>&#xa;                &lt;tns1:details>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/tns1:details>&#xa;            &lt;/tns1:result>&#xa;        &lt;/tns1:outputVerificaOAOperCessazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
