                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/BPM_CheckServiceDati/" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://tns.tibco.com/bw/REST" xmlns:tns="http://www.tim.com/NOW/rest/verificaCoppiaBandePicco/" xmlns:tns3="http://www.example.org/DeterminaSottoLavorazioneRichiesta" xmlns:tns4="http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza" version="2.0"&gt;&lt;xsl:param name="post"/&gt;&lt;xsl:param name="CallDeterminaSottolavorazione"/&gt;&lt;xsl:param name="CallVerificaServizioInConsistenza"/&gt;&lt;xsl:template name="VerificaCoppiaBandaPicco-input" match="/"&gt;&lt;ns:VerificaCoppiaBandaPiccoRequest1&gt;&lt;input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="upper-case($post/item/tns:inputVerificaCoppiaBandePicco/tns:lavorazione) = ('ATTIVAZIONE','MIGRAZIONE')"&gt;&lt;tns1:VerificaCoppiaBandaPiccoRequest&gt;&lt;xsl:if test="$post/httpHeaders/tns2:httpHeaders/GUI-TID"&gt;&lt;tns1:IDRichiestaOLO&gt;&lt;xsl:value-of select="$post/httpHeaders/tns2:httpHeaders/GUI-TID"/&gt;&lt;/tns1:IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns:inputVerificaCoppiaBandePicco/tns:profiloTecnicoLinea"&gt;&lt;tns1:ProfiloTecnicoLinea&gt;&lt;xsl:value-of select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:profiloTecnicoLinea"/&gt;&lt;/tns1:ProfiloTecnicoLinea&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:userVlan"&gt;&lt;tns1:UserVlan&gt;&lt;tns1:BandaPiccoDown&gt;&lt;xsl:value-of select="tns:bandaPiccoDOWN"/&gt;&lt;/tns1:BandaPiccoDown&gt;&lt;tns1:BandaPiccoUp&gt;&lt;xsl:value-of select="tns:bandaPiccoUP"/&gt;&lt;/tns1:BandaPiccoUp&gt;&lt;/tns1:UserVlan&gt;&lt;/xsl:for-each&gt;&lt;/tns1:VerificaCoppiaBandaPiccoRequest&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$CallDeterminaSottolavorazione/tns3:sottolavorazione = 'RICONFIGURAZIONEVC'"&gt;&lt;tns1:VerificaCoppiaBandaPiccoRequest&gt;&lt;xsl:if test="$post/httpHeaders/tns2:httpHeaders/GUI-TID"&gt;&lt;tns1:IDRichiestaOLO&gt;&lt;xsl:value-of select="$post/httpHeaders/tns2:httpHeaders/GUI-TID"/&gt;&lt;/tns1:IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns:inputVerificaCoppiaBandePicco/tns:profiloTecnicoLinea"&gt;&lt;tns1:ProfiloTecnicoLinea&gt;&lt;xsl:value-of select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:profiloTecnicoLinea"/&gt;&lt;/tns1:ProfiloTecnicoLinea&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:profiloTecnicoLinea[1]"&gt;&lt;tns1:ProfiloTecnicoLineaCONS&gt;&lt;xsl:value-of select="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:profiloTecnicoLinea[1]"/&gt;&lt;/tns1:ProfiloTecnicoLineaCONS&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:userVlan"&gt;&lt;tns1:UserVlan&gt;&lt;xsl:if test="tns:userVlanId"&gt;&lt;tns1:UservlanId&gt;&lt;xsl:value-of select="tns:userVlanId"/&gt;&lt;/tns1:UservlanId&gt;&lt;/xsl:if&gt;&lt;tns1:BandaPiccoDown&gt;&lt;xsl:value-of select="tns:bandaPiccoDOWN"/&gt;&lt;/tns1:BandaPiccoDown&gt;&lt;tns1:BandaPiccoUp&gt;&lt;xsl:value-of select="tns:bandaPiccoUP"/&gt;&lt;/tns1:BandaPiccoUp&gt;&lt;/tns1:UserVlan&gt;&lt;/xsl:for-each&gt;&lt;xsl:for-each select="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza/tns4:userVlan"&gt;&lt;tns1:UserVlanCONS&gt;&lt;xsl:if test="tns4:userVlanId"&gt;&lt;tns1:UservlanId&gt;&lt;xsl:value-of select="tns4:userVlanId"/&gt;&lt;/tns1:UservlanId&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:bandaPiccoDown"&gt;&lt;tns1:BandaPiccoDown&gt;&lt;xsl:value-of select="tns4:bandaPiccoDown"/&gt;&lt;/tns1:BandaPiccoDown&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:bandaPiccoUp"&gt;&lt;tns1:BandaPiccoUp&gt;&lt;xsl:value-of select="tns4:bandaPiccoUp"/&gt;&lt;/tns1:BandaPiccoUp&gt;&lt;/xsl:if&gt;&lt;/tns1:UserVlanCONS&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:offerta[1]"&gt;&lt;tns1:Offerta&gt;&lt;xsl:value-of select="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:offerta[1]"/&gt;&lt;/tns1:Offerta&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns:inputVerificaCoppiaBandePicco/tns:idRisorsa1"&gt;&lt;tns1:IdRisorsa&gt;&lt;xsl:value-of select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:idRisorsa1"/&gt;&lt;/tns1:IdRisorsa&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns:inputVerificaCoppiaBandePicco/tns:lavorazione"&gt;&lt;tns1:Lavorazione&gt;&lt;xsl:value-of select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:lavorazione"/&gt;&lt;/tns1:Lavorazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CallDeterminaSottolavorazione/tns3:sottolavorazione"&gt;&lt;tns1:SottoLavorazione&gt;&lt;xsl:value-of select="$CallDeterminaSottolavorazione/tns3:sottolavorazione"/&gt;&lt;/tns1:SottoLavorazione&gt;&lt;/xsl:if&gt;&lt;/tns1:VerificaCoppiaBandaPiccoRequest&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CallDeterminaSottolavorazione/tns3:sottolavorazione = 'INCREMENTODECREMENTOVC'"&gt;&lt;tns1:VerificaCoppiaBandaPiccoRequest&gt;&lt;xsl:if test="$post/httpHeaders/tns2:httpHeaders/GUI-TID"&gt;&lt;tns1:IDRichiestaOLO&gt;&lt;xsl:value-of select="$post/httpHeaders/tns2:httpHeaders/GUI-TID"/&gt;&lt;/tns1:IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:profiloTecnicoLinea[1]"&gt;&lt;tns1:ProfiloTecnicoLineaCONS&gt;&lt;xsl:value-of select="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:profiloTecnicoLinea[1]"/&gt;&lt;/tns1:ProfiloTecnicoLineaCONS&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:userVlan"&gt;&lt;tns1:UserVlan&gt;&lt;xsl:if test="tns:userVlanId"&gt;&lt;tns1:UservlanId&gt;&lt;xsl:value-of select="tns:userVlanId"/&gt;&lt;/tns1:UservlanId&gt;&lt;/xsl:if&gt;&lt;tns1:BandaPiccoDown&gt;&lt;xsl:value-of select="tns:bandaPiccoDOWN"/&gt;&lt;/tns1:BandaPiccoDown&gt;&lt;tns1:BandaPiccoUp&gt;&lt;xsl:value-of select="tns:bandaPiccoUP"/&gt;&lt;/tns1:BandaPiccoUp&gt;&lt;tns1:AzioneUservlan&gt;&lt;xsl:value-of select="'A'"/&gt;&lt;/tns1:AzioneUservlan&gt;&lt;/tns1:UserVlan&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:offerta[1]"&gt;&lt;tns1:Offerta&gt;&lt;xsl:value-of select="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:offerta[1]"/&gt;&lt;/tns1:Offerta&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns:inputVerificaCoppiaBandePicco/tns:lavorazione"&gt;&lt;tns1:Lavorazione&gt;&lt;xsl:value-of select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:lavorazione"/&gt;&lt;/tns1:Lavorazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CallDeterminaSottolavorazione/tns3:sottolavorazione"&gt;&lt;tns1:SottoLavorazione&gt;&lt;xsl:value-of select="$CallDeterminaSottolavorazione/tns3:sottolavorazione"/&gt;&lt;/tns1:SottoLavorazione&gt;&lt;/xsl:if&gt;&lt;/tns1:VerificaCoppiaBandaPiccoRequest&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:VerificaCoppiaBandaPiccoRequest&gt;&lt;xsl:if test="$post/httpHeaders/tns2:httpHeaders/GUI-TID"&gt;&lt;tns1:IDRichiestaOLO&gt;&lt;xsl:value-of select="$post/httpHeaders/tns2:httpHeaders/GUI-TID"/&gt;&lt;/tns1:IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:profiloTecnicoLinea[1]"&gt;&lt;tns1:ProfiloTecnicoLineaCONS&gt;&lt;xsl:value-of select="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:profiloTecnicoLinea[1]"/&gt;&lt;/tns1:ProfiloTecnicoLineaCONS&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:userVlan"&gt;&lt;tns1:UserVlan&gt;&lt;xsl:if test="tns:userVlanId"&gt;&lt;tns1:UservlanId&gt;&lt;xsl:value-of select="tns:userVlanId"/&gt;&lt;/tns1:UservlanId&gt;&lt;/xsl:if&gt;&lt;tns1:BandaPiccoDown&gt;&lt;xsl:value-of select="tns:bandaPiccoDOWN"/&gt;&lt;/tns1:BandaPiccoDown&gt;&lt;tns1:BandaPiccoUp&gt;&lt;xsl:value-of select="tns:bandaPiccoUP"/&gt;&lt;/tns1:BandaPiccoUp&gt;&lt;/tns1:UserVlan&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:offerta[1]"&gt;&lt;tns1:Offerta&gt;&lt;xsl:value-of select="$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:offerta[1]"/&gt;&lt;/tns1:Offerta&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$post/item/tns:inputVerificaCoppiaBandePicco/tns:lavorazione"&gt;&lt;tns1:Lavorazione&gt;&lt;xsl:value-of select="$post/item/tns:inputVerificaCoppiaBandePicco/tns:lavorazione"/&gt;&lt;/tns1:Lavorazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CallDeterminaSottolavorazione/tns3:sottolavorazione"&gt;&lt;tns1:SottoLavorazione&gt;&lt;xsl:value-of select="$CallDeterminaSottolavorazione/tns3:sottolavorazione"/&gt;&lt;/tns1:SottoLavorazione&gt;&lt;/xsl:if&gt;&lt;/tns1:VerificaCoppiaBandaPiccoRequest&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/input&gt;&lt;/ns:VerificaCoppiaBandaPiccoRequest1&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/BPM_CheckServiceDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/verificaCoppiaBandePicco/&quot; xmlns:tns3=&quot;http://www.example.org/DeterminaSottoLavorazioneRichiesta&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;CallDeterminaSottolavorazione&quot;/>&#xa;    &lt;xsl:param name=&quot;CallVerificaServizioInConsistenza&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaCoppiaBandaPicco-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;upper-case($post.item/tns:lavorazione) = ('ATTIVAZIONE','MIGRAZIONE')&quot;>&#xa;                &lt;tns1:VerificaCoppiaBandaPiccoRequest>&#xa;                    &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                        &lt;tns1:IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                        &lt;/tns1:IDRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$post.item/tns:profiloTecnicoLinea&quot;>&#xa;                        &lt;tns1:ProfiloTecnicoLinea>&#xa;                            &lt;xsl:value-of select=&quot;$post.item/tns:profiloTecnicoLinea&quot;/>&#xa;                        &lt;/tns1:ProfiloTecnicoLinea>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$post.item/tns:userVlan&quot;>&#xa;                        &lt;tns1:UserVlan>&#xa;                            &lt;tns1:BandaPiccoDown>&#xa;                                &lt;xsl:value-of select=&quot;tns:bandaPiccoDOWN&quot;/>&#xa;                            &lt;/tns1:BandaPiccoDown>&#xa;                            &lt;tns1:BandaPiccoUp>&#xa;                                &lt;xsl:value-of select=&quot;tns:bandaPiccoUP&quot;/>&#xa;                            &lt;/tns1:BandaPiccoUp>&#xa;                        &lt;/tns1:UserVlan>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:VerificaCoppiaBandaPiccoRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$CallDeterminaSottolavorazione/tns3:sottolavorazione = 'RICONFIGURAZIONEVC'&quot;>&#xa;                        &lt;tns1:VerificaCoppiaBandaPiccoRequest>&#xa;                            &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                                &lt;tns1:IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                                &lt;/tns1:IDRichiestaOLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$post.item/tns:profiloTecnicoLinea&quot;>&#xa;                                &lt;tns1:ProfiloTecnicoLinea>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:profiloTecnicoLinea&quot;/>&#xa;                                &lt;/tns1:ProfiloTecnicoLinea>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:profiloTecnicoLinea[1]&quot;>&#xa;                                &lt;tns1:ProfiloTecnicoLineaCONS>&#xa;                                    &lt;xsl:value-of select=&quot;$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:profiloTecnicoLinea[1]&quot;/>&#xa;                                &lt;/tns1:ProfiloTecnicoLineaCONS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:for-each select=&quot;$post.item/tns:userVlan&quot;>&#xa;                                &lt;tns1:UserVlan>&#xa;                                    &lt;xsl:if test=&quot;tns:userVlanId&quot;>&#xa;                                        &lt;tns1:UservlanId>&#xa;                                            &lt;xsl:value-of select=&quot;tns:userVlanId&quot;/>&#xa;                                        &lt;/tns1:UservlanId>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:BandaPiccoDown>&#xa;                                        &lt;xsl:value-of select=&quot;tns:bandaPiccoDOWN&quot;/>&#xa;                                    &lt;/tns1:BandaPiccoDown>&#xa;                                    &lt;tns1:BandaPiccoUp>&#xa;                                        &lt;xsl:value-of select=&quot;tns:bandaPiccoUP&quot;/>&#xa;                                    &lt;/tns1:BandaPiccoUp>&#xa;                                &lt;/tns1:UserVlan>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:for-each select=&quot;$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza/tns4:userVlan&quot;>&#xa;                                &lt;tns1:UserVlanCONS>&#xa;                                    &lt;xsl:if test=&quot;tns4:userVlanId&quot;>&#xa;                                        &lt;tns1:UservlanId>&#xa;                                            &lt;xsl:value-of select=&quot;tns4:userVlanId&quot;/>&#xa;                                        &lt;/tns1:UservlanId>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;tns4:bandaPiccoDown&quot;>&#xa;                                        &lt;tns1:BandaPiccoDown>&#xa;                                            &lt;xsl:value-of select=&quot;tns4:bandaPiccoDown&quot;/>&#xa;                                        &lt;/tns1:BandaPiccoDown>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;tns4:bandaPiccoUp&quot;>&#xa;                                        &lt;tns1:BandaPiccoUp>&#xa;                                            &lt;xsl:value-of select=&quot;tns4:bandaPiccoUp&quot;/>&#xa;                                        &lt;/tns1:BandaPiccoUp>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns1:UserVlanCONS>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:if test=&quot;$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:offerta[1]&quot;>&#xa;                                &lt;tns1:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;$CallVerificaServizioInConsistenza/tns4:OutputVerificaServizioInConsistenza[1]/tns4:offerta[1]&quot;/>&#xa;                                &lt;/tns1:Offerta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$post.item/tns:idRisorsa1&quot;>&#xa;                                &lt;tns1:IdRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:idRisorsa1&quot;/>&#xa;                                &lt;/tns1:IdRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$post.item/tns:lavorazione&quot;>&#xa;                                &lt;tns1:Lavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;$post.item/tns:lavorazione&quot;/>&#xa;                                &lt;/tns1:Lavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if tes