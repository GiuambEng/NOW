         &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get.parameters/tns2:idOfferta = '16'&quot;>&#xa;                    &lt;tns1:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTH'&quot;/>&#xa;                    &lt;/tns1:Offerta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;'SEMIBITSTREAMNGAFTTH'&quot;/>&#xa;                    &lt;/tns1:Offerta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;            &lt;/tns1:Lavorazione>&#xa;            &lt;tns1:Sottolavorazione>&#xa;                &lt;xsl:value-of select=&quot;'CAMBIOTECNOLOGIA'&quot;/>&#xa;            &lt;/tns1:Sottolavorazione>&#xa;            &lt;xsl:if test=&quot;$get.parameters/tns2:profiloTecnicoLinea&quot;>&#xa;                &lt;tns1:ProfiloTecnicoLinea>&#xa;                    &lt;xsl:value-of select=&quot;$get.parameters/tns2:profiloTecnicoLinea&quot;/>&#xa;                &lt;/tns1:ProfiloTecnicoLinea>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:ControlloProfiloTecnicoLineaX1X2_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="ControlloProfiloTecnicoLineaX1X2_LogInfoToControlloProfiloTecnicoLineaX1X2"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ControlloProfiloTecnicoLineaX1X2ToAssign"/>
                                </bpws:sources>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
