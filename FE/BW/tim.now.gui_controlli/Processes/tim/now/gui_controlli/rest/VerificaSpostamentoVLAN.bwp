gerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.gui_controlli.rest.VerificaSpostamentoVLAN'&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;'GUI'&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns5:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns5:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns5:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventType>