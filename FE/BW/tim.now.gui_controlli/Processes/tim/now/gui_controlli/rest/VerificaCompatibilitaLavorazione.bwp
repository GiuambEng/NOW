                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT O.NOME_OFFERTA_CATLG,O.ID_SOTTOFAMIG_OFFERTA_MCRO,TRO.NOME_OFFERTA_ESTERNA&#xa;FROM OFFERTA  O &#xa;LEFT JOIN TRASCODFC_OFFERTA TRO ON TRO.ID_OFFERTA=O.ID_OFFERTA&#xa;WHERE TRO.PROVENIENZA='BPM' AND O.ID_OFFERTA=?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_OFFERTA"/>
                                    <columnMetadata
                                    columnName="NOME_OFFERTA_CATLG"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_SOTTOFAMIG_OFFERTA_MCRO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOME_OFFERTA_ESTERNA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+af748ae1-abae-4709-a7fb-5eb56f44a847+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:template name=&quot;GetOffertaDonor-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSA1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa1)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa1&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRISORSA1>&#xa;            &lt;NUMEROFITTIZIO1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa1)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa1&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NUMEROFITTIZIO1>&#xa;            &lt;NUMEROTELEFONICO1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa1)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa1&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NUMEROTELEFONICO1>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="GetOffertaDonor-input"
                                    name="GetOffertaDonor"
                                    outputVariable="GetOffertaDonor"
                                    tibex:xpdlId="af748ae1-abae-4709-a7fb-5eb56f44a847" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CompatibilitaLavorazioneInfoToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GetOffertaDonorToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+af748ae1-abae-4709-a7fb-5eb56f44a847+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:template name=&quot;GetOffertaDonor-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSA1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1.item/tns1:codiceRisorsa1)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns1:codiceRisorsa1&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRISORSA1>&#xa;            &lt;NUMEROFITTIZIO1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1.item/tns1:codiceRisorsa1)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns1:codiceRisorsa1&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NUMEROFITTIZIO1>&#xa;            &lt;NUMEROTELEFONICO1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post1.item/tns1:codiceRisorsa1)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post1.item/tns1:codiceRisorsa1&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NUMEROTELEFONICO1>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select a.OFFERTA,a.idrisorsacorrelato,a.idrisorsa,a.codificaoloagcom &#xa;from bds_1_casedata_asset a&#xa;where  A.STATOASSET='ATTIVO' AND (a.IDRISORSA=?  OR A.NUMEROFITTIZIO=? OR   A.NUMEROTELEFONICO=? )&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROFITTIZIO1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO1"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSACORRELATO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione&quot; xmlns:ns16=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:template name=&quot;CallVerificaServizioInConsistenza-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns16:inputVerificaServizioInConsistenza>&#xa;            &lt;xsl:if test=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa1&quot;>&#xa;                &lt;ns16:codiceRisorsa1>&#xa;                    &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa1&quot;/>&#xa;                &lt;/ns16:codiceRisorsa1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa2&quot;>&#xa;                &lt;ns16:codiceRisorsa2>&#xa;                    &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa2&quot;/>&#xa;                &lt;/ns16:codiceRisorsa2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codificaOloAgcomRecipient&quot;>&#xa;                &lt;ns16:codificaOloAgcom>&#xa;                    &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codificaOloAgcomRecipient&quot;/>&#xa;                &lt;/ns16:codificaOloAgcom>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceSessione1&quot;>&#xa;                &lt;ns16:codiceSessione1>&#xa;                    &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceSessione1&quot;/>&#xa;                &lt;/ns16:codiceSessione1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceSessione2&quot;>&#xa;                &lt;ns16:codiceSessione2>&#xa;                    &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceSessione2&quot;/>&#xa;                &lt;/ns16:codiceSessione2>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns16:inputVerificaServizioInConsistenza>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallVerificaServizioInConsistenza-input"
                                    name="CallVerificaServizioInConsistenza"
                                    outputVariable="CallVerificaServizioInConsistenza"
                                    tibex:xpdlId="c9fff0c2-4880-4d57-8506-e6eea3454c5b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GetOffertaDonorToCallProcess"/>
                                    <bpws:target linkName="offertaQueryToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallVerificaServizioInConsistenzaToCompatibilitaLavorazioneOutput_inputErrato">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaDati) and count($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaDati)>1) &#xd;&#xa;or (exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaFonia) and count($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaFonia)>1) &#xd;&#xa;or (exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:tipologiaAccesso) and (upper-case($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaAccesso)='FONIADATI') and string-length($post1/item/tns0:InputVerificaCompatibilitaLavorazione/tns0:codiceRisorsa2)!=0 )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaDati) and count($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaDati)>1) 
or (exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaFonia) and count($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaFonia)>1) 
or (exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:tipologiaAccesso) and (upper-case($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaAccesso)='FONIADATI') and string-length($post1.item/tns0:codiceRisorsa2)!=0 )]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallVerificaServizioInConsistenzaToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione&quot; xmlns:ns16=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:template name=&quot;CallVerificaServizioInConsistenza-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns16:inputVerificaServizioInConsistenza>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns1:codiceRisorsa1&quot;>&#xa;                &lt;ns16:codiceRisorsa1>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns1:codiceRisorsa1&quot;/>&#xa;                &lt;/ns16:codiceRisorsa1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns1:codiceRisorsa2&quot;>&#xa;                &lt;ns16:codiceRisorsa2>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns1:codiceRisorsa2&quot;/>&#xa;                &lt;/ns16:codiceRisorsa2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns1:codificaOloAgcomRecipient&quot;>&#xa;                &lt;ns16:codificaOloAgcom>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns1:codificaOloAgcomRecipient&quot;/>&#xa;                &lt;/ns16:codificaOloAgcom>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns1:codiceSessione1&quot;>&#xa;                &lt;ns16:codiceSessione1>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns1:codiceSessione1&quot;/>&#xa;                &lt;/ns16:codiceSessione1>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post1.item/tns1:codiceSessione2&quot;>&#xa;                &lt;ns16:codiceSessione2>&#xa;                    &lt;xsl:value-of select=&quot;$post1.item/tns1:codiceSessione2&quot;/>&#xa;                &lt;/ns16:codiceSessione2>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns16:inputVerificaServizioInConsistenza>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.gui_controlli.sub.VerificaServizioInConsistenza" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="matriceControlliQuery-input"
                                    name="matriceControlliQuery"
                                    outputVariable="matriceControlliQuery"
                                    tibex:xpdlId="75cc551b-e969-40b5-95cd-7e00fa02923c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignTomatriceControlliQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="matriceControlliQueryToCompatibilitaLavorazioneOutput"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+75cc551b-e969-40b5-95cd-7e00fa02923c+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns16=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallVerificaServizioInConsistenza&quot;/>&#xa;    &lt;xsl:param name=&quot;servizioVariable&quot;/>&#xa;    &lt;xsl:param name=&quot;offertaQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;matriceControlliQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;idSottofamigliaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;string($offertaQuery/Record[1]/ID_SOTTOFAMIG_OFFERTA_MCRO)&quot;/>&#xa;            &lt;/idSottofamigliaRichiesta>&#xa;            &lt;idSottofamigliaAssetDati>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza[1]/ns16:idOffertaDatiMCRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza[1]/ns16:idOffertaDatiMCRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idSottofamigliaAssetDati>&#xa;            &lt;idSottofamigliaAssetFonia>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza[1]/ns16:idOffertaFoniaMCRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza[1]/ns16:idOffertaFoniaMCRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idSottofamigliaAssetFonia>&#xa;            &lt;idTipologiaLavorazione>&#xa;                &lt;xsl:value-of select=&quot;4&quot;/>&#xa;            &lt;/idTipologiaLavorazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaRichiesta)='SIMPLEX'&quot;>&#xa;                    &lt;idTipologiaLineaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/idTipologiaLineaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaRichiesta)='BRA'&quot;>&#xa;                    &lt;idTipologiaLineaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                    &lt;/idTipologiaLineaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaRichiesta)='NA'&quot;>&#xa;                    &lt;idTipologiaLineaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                    &lt;/idTipologiaLineaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaRichiesta)='RTG'&quot;>&#xa;                    &lt;idTipologiaLineaRichiesta>&#xa;                      