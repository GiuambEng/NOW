                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20161227174836PLT&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaCompatibilitaLavorazione>&#xa;            &lt;tns1:result>&#xa;                &lt;tns1:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                &lt;/tns1:severity>&#xa;                &lt;tns1:code>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/tns1:code>&#xa;                &lt;tns1:details>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/tns1:details>&#xa;            &lt;/tns1:result>&#xa;        &lt;/tns1:VerificaCompatibilitaLavorazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
