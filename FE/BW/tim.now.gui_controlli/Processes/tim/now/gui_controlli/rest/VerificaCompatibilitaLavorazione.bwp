                                tibex:xpdlId="8e9819a0-c16b-43bb-88f5-464b9bcb3a43" variable="postOutVerificaCompatibilitaLavorazione-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20161227174836PLT" xmlns:tns1="http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione" xmlns:ns16="http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;&lt;xsl:param name="CallVerificaServizioInConsistenza"/&gt;&lt;xsl:param name="matriceControlliQuery"/&gt;&lt;xsl:param name="post1"/&gt;&lt;xsl:template name="postOutVerificaCompatibilitaLavorazione-input" match="/"&gt;&lt;tns:postResponse1&gt;&lt;item&gt;&lt;tns1:VerificaCompatibilitaLavorazione&gt;&lt;xsl:choose&gt;&lt;xsl:when test="(exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaDati) and count($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaDati)&gt;1) or (exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaFonia) and count($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaFonia)&gt;1) or (exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:tipologiaAccesso) and (upper-case($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaAccesso)='FONIADATI') and string-length($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codiceRisorsa2)!=0 ) or count($matriceControlliQuery/Record)=0 "&gt;&lt;tns1:codice&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:codice&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:codice&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:codice&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="count($matriceControlliQuery/Record)&gt;0"&gt;&lt;xsl:if test="$matriceControlliQuery/Record[1]/ID_MATRICE_COMP_RICHOLO"&gt;&lt;tns1:descrizione&gt;&lt;xsl:value-of select="$matriceControlliQuery/Record[1]/ID_MATRICE_COMP_RICHOLO"/&gt;&lt;/tns1:descrizione&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="count($matriceControlliQuery/Record)&gt;0"&gt;&lt;xsl:if test="$matriceControlliQuery/Record[1]/ID_SCENARIO"&gt;&lt;tns1:scenario&gt;&lt;xsl:value-of select="$matriceControlliQuery/Record[1]/ID_SCENARIO"/&gt;&lt;/tns1:scenario&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="count($matriceControlliQuery/Record)&gt;0"&gt;&lt;xsl:if test="not((string($matriceControlliQuery/Record[1]/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($matriceControlliQuery/Record[1]/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($matriceControlliQuery/Record[1]/COD_TRASFORMAZIONE)"&gt;&lt;tns1:codiceTrasformazione&gt;&lt;xsl:value-of select="$matriceControlliQuery/Record[1]/COD_TRASFORMAZIONE"/&gt;&lt;/tns1:codiceTrasformazione&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;tns1:result&gt;&lt;tns1:severity&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/tns1:severity&gt;&lt;tns1:code&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:code&gt;&lt;/tns1:result&gt;&lt;/tns1:VerificaCompatibilitaLavorazione&gt;&lt;/item&gt;&lt;/tns:postResponse1&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20161227174836PLT&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione&quot; xmlns:ns16=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:param name=&quot;CallVerificaServizioInConsistenza&quot;/>&#xa;    &lt;xsl:param name=&quot;matriceControlliQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;postOutVerificaCompatibilitaLavorazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaCompatibilitaLavorazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;(exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaDati) and count($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaDati)>1) or (exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaFonia) and count($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:offertaConsistenzaFonia)>1) or (exists($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza/ns16:tipologiaAccesso) and (upper-case($CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaAccesso)='FONIADATI') and string-length($post1.item/tns1:codiceRisorsa2)!=0 ) or count($matriceControlliQuery/Record)=0 &quot;>&#xa;                    &lt;tns1:codice>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:codice>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:codice>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns1:codice>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;count($matriceControlliQuery/Record)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$matriceControlliQuery/Record[1]/ID_MATRICE_COMP_RICHOLO&quot;>&#xa;                    &lt;tns1:descrizione>&#xa;                        &lt;xsl:value-of select=&quot;$matriceControlliQuery/Record[1]/ID_MATRICE_COMP_RICHOLO&quot;/>&#xa;                    &lt;/tns1:descrizione>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($matriceControlliQuery/Record)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$matriceControlliQuery/Record[1]/ID_SCENARIO&quot;>&#xa;                    &lt;tns1:scenario>&#xa;                        &lt;xsl:value-of select=&quot;$matriceControlliQuery/Record[1]/ID_SCENARIO&quot;/>&#xa;                    &lt;/tns1:scenario>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($matriceControlliQuery/Record)>0&quot;>&#xa;                &lt;xsl:if test=&quot;not((string($matriceControlliQuery/Record[1]/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($matriceControlliQuery/Record[1]/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($matriceControlliQuery/Record[1]/COD_TRASFORMAZIONE)&quot;>&#xa;                    &lt;tns1:codiceTrasformazione>&#xa;                        &lt;xsl:value-of select=&quot;$matriceControlliQuery/Record[1]/COD_TRASFORMAZIONE&quot;/>&#xa;                    &lt;/tns1:codiceTrasformazione>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:result>&#xa;                &lt;tns1:severity>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                &lt;/tns1:severity>&#xa;                &lt;tns1:code>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/tns1:code>&#xa;            &lt;/tns1:result>&#xa;        &lt;/tns1:VerificaCompatibilitaLavorazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CompatibilitaLavorazioneOutputTopostOut1"/>
                                </bpws:targets>
