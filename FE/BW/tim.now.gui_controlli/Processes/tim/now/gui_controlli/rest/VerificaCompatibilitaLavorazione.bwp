                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='ADSL'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;7&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='DECT'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;8&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='HDSL'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;9&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='ISDN BRA'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;10&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='ISDN PRA'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='POTS'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;12&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='SDSL'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;13&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='VDSL'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;14&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='ALL'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;15&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='LINEAPOTS'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;16&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='LINEAISDN'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;17&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='LINEANONFONIA'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;18&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaLineaConsistenzaFonia[1])='ISDN'&quot;>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;19&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;idTipologiaLineaAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/idTipologiaLineaAssetFonia>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaSottoLavorazione)='RIENTROINTI'&quot;>&#xa;                    &lt;idTipologiaSottolavorazione>&#xa;                        &lt;xsl:value-of select=&quot;15&quot;/>&#xa;                    &lt;/idTipologiaSottolavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaSottoLavorazione)='MIGRAZIONEOLO'&quot;>&#xa;                    &lt;idTipologiaSottolavorazione>&#xa;                        &lt;xsl:value-of select=&quot;14&quot;/>&#xa;                    &lt;/idTipologiaSottolavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;upper-case($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:tipologiaSottoLavorazione)='ATTIVAZIONE274'&quot;>&#xa;                    &lt;idTipologiaSottolavorazione>&#xa;                        &lt;xsl:value-of select=&quot;47&quot;/>&#xa;                    &lt;/idTipologiaSottolavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;idTipologiaSottolavorazione>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/idTipologiaSottolavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:strutturaRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:strutturaRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;flagNPasset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagNPAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagNPAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/flagNPasset>&#xa;            &lt;!--il flagNPasset è il FLAG NP della consistenza -->&#xa;            &lt;flagRientro>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagRientro)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagRientro&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/flagRientro>&#xa;            &lt;flagNPrichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagNPRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagNPRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/flagNPrichiesta>&#xa;            &lt;!--il flagNPrichiesta è il FLAG NP in input-->&#xa;            &lt;flagPortabilità>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagPortabilita)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagPortabilita&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/flagPortabilità>&#xa;            &lt;flagAggiuntivo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagAggiuntivo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:flagAggiuntivo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/flagAggiuntivo>&#xa;            &lt;destinazioneUsoRichiestaOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:destinazioneUsoRichiestaOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:destinazioneUsoRichiestaOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/destinazioneUsoRichiestaOlo>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains(&amp;quot;BITSTREAMGBEASIMMETRICOFLAT,BITSTREAMATMASIMMETRICOFLAT,BITSTREAMATMASIMMETRICOHL,BITSTREAMATMASIMMETRICOLITE,EASYIPBASEPLUSFLAT,&amp;#x9;EASYIPBASEPLUSLITE,EASYIPSPECIALPROFILEFLAT,EASYIPSPECIALPROFILELITE,BITSTREAMNGAFTTCAB,BITSTREAMNGAFTTH,VULAFTTCAB,VULAFTTH,NP&amp;quot;,$offertaQuery/Record[1]/NOME_OFFERTA_CATLG) and 1=2&quot;>&#xa;                    &lt;destinazioneUsoAssetFonia>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/destinazioneUsoAssetFonia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;destinazioneUsoAssetFonia>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza/ns16:destinazioneUsoAssetFonia[1])&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza/ns16:destinazioneUsoAssetFonia[1]&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/destinazioneUsoAssetFonia>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;!--inserita condizione mai verificabile per una possibile modifica delle specifiche, per conservare la lista delle offerte-->&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains(&amp;quot;BITSTREAMGBEASIMMETRICOFLAT,BITSTREAMATMASIMMETRICOFLAT,BITSTREAMATMASIMMETRICOHL,BITSTREAMATMASIMMETRICOLITE,EASYIPBASEPLUSFLAT,&amp;#x9;EASYIPBASEPLUSLITE,EASYIPSPECIALPROFILEFLAT,EASYIPSPECIALPROFILELITE,BITSTREAMNGAFTTCAB,BITSTREAMNGAFTTH,VULAFTTCAB,VULAFTTH,NP&amp;quot;,$offertaQuery/Record[1]/NOME_OFFERTA_CATLG) and 1=2&quot;>&#xa;                    &lt;destinazioneUsoAssetDati>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/destinazioneUsoAssetDati>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;destinazioneUsoAssetDati>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza/ns16:destinazioneUsoAssetDati[1])&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza/ns16:destinazioneUsoAssetDati[1]&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/destinazioneUsoAssetDati>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;!--inserita condizione mai verificabile per una possibile modifica delle specifiche, per conservare la lista delle offerte-->&#xa;            &lt;assetDatiStandard>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza/ns16:assetDatiStandard[1])&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza/ns16:assetDatiStandard[1]&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/assetDatiStandard>&#xa;            &lt;assetFoniaStandard>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza/ns16:assetFoniaStandard[1])&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza/ns16:assetFoniaStandard[1]&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/assetFoniaStandard>&#xa;            &lt;richiestaOloStandard>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:richiestaOLOStandard)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$servizioVariable/ns16:OutputVerificaServizioInConsistenza[1]/ns16:richiestaOLOStandard&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/richiestaOloStandard>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_TRASFORMAZIONE,ID_MATRICE_COMP_RICHOLO,ID_SCENARIO&#xa;FROM MATRICE_COMP_RICHOLO &#xa;WHERE ID_SOTOFMG_OFRT_MCRO_RICH=? AND&#xa; (ID_SOTFMG_OFRT_MCRO_ASST_DAT=? or ID_SOTFMG_OFRT_MCRO_ASST_DAT is null)  AND &#xa; (ID_SOTFMG_OFRT_MCRO_ASST_FON=? or ID_SOTFMG_OFRT_MCRO_ASST_FON is null)&#xa;  AND IDTPLG_LAVRZ =? AND &#xa;(IDTPLG_LINEA_RICH =? or  IDTPLG_LINEA_RICH is null)  AND (IDTPLG_LINEA_ASSET_DATI =? or IDTPLG_LINEA_ASSET_DATI is null) AND &#xa;(IDTPLG_LINEA_ASSET_FONIA =? or IDTPLG_LINEA_ASSET_FONIA is null )  AND IDTPLG_SOTTO_LAVRZ=? AND &#xa;STRUTTURA_RICH=? AND FLAG_NP_ASSET=? AND FLAG_RIENTRO=? AND FLAG_NP_RICH=? AND FLAG_PORTABILITA=? AND &#xa;FLAG_AGGIUNTIVO=? AND &#xa;(DESTINAZIONE_USO_RICH_OLO =? or DESTINAZIONE_USO_RICH_OLO is null) AND  (DEST_USO_ASSET_FONIA =? or DEST_USO_ASSET_FONIA is null) &#xa;AND (DEST_USO_ASSET_DATI=? or DEST_USO_ASSET_DATI is null)&#xa; AND ASSET_DATI_STANDARD=? AND ASSET_FONIA_STANDARD=? AND RICH_OLO_STANDARD=?"
                                    useNil="true" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idSottofamigliaRichiesta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idSottofamigliaAssetDati"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idSottofamigliaAssetFonia"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idTipologiaLavorazione"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idTipologiaLineaRichiesta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idTipologiaLineaAssetDati"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idTipologiaLineaAssetFonia"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idTipologiaSottolavorazione"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="strutturaRichiesta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="flagNPasset"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="flagRientro"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="flagNPrichiesta"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="flagPortabilità"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="flagAggiuntivo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="destinazioneUsoRichiestaOlo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="destinazioneUsoAssetFonia"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="destinazioneUsoAssetDati"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="assetDatiStandard"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="assetFoniaStandard"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="richiestaOloStandard"/>
                                    <columnMetadata
                                    columnName="COD_TRASFORMAZIONE"
                                    dataType="12"
                                    status="NillableElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_MATRICE_COMP_RICHOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_SCENARIO"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns16=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;offertaQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;post1&quot;/>&#xa;    &lt;xsl:param name=&quot;GetOffertaDonor&quot;/>&#xa;    &lt;xsl:param name=&quot;CallVerificaServizioInConsistenza&quot;/>&#xa;    &lt;xsl:template name=&quot;servizioVariable&quot; match=&quot;/&quot;>&#xa;        &lt;ns16:outputVerificaServizioInConsistenza>&#xa;            &lt;xsl:for-each select=&quot;$CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza&quot;>&#xa;                &lt;ns16:OutputVerificaServizioInConsistenza>&#xa;                    &lt;xsl:variable name=&quot;attivazione274variable&quot; select=&quot;if(tib:trim(upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))=(upper-case('BitstreamNGAFTTH'),upper-case('VULAFTTH')) )&amp;#xD;&amp;#xA; then if (tib:trim(upper-case($GetOffertaDonor/Record[1]/OFFERTA))=(upper-case('BitstreamNGAFTTH'),upper-case('VULAFTTH')))&amp;#xD;&amp;#xA;     then if ($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC') &amp;#xD;&amp;#xA;&amp;#x9;        then upper-case('Attivazione274') &amp;#xD;&amp;#xA;&amp;#x9;          else   upper-case('MigrazioneOlo')    &amp;#xD;&amp;#xA;  else 'La migrazione richiesta non è permessa' &amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(tib:trim(upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))=(upper-case('BitstreamNGAFTTCAB'),upper-case('VULAFTTCAB')) )&amp;#xD;&amp;#xA;   then&amp;#xD;&amp;#xA;    if ($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC')&amp;#xD;&amp;#xA;&amp;#x9;  then if(upper-case($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:tipologiaLineaRichiesta) = upper-case('POTS'))&amp;#xD;&amp;#xA;            then upper-case('Attivazione274') &amp;#xD;&amp;#xA;&amp;#x9;        else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;  if (upper-case($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:tipologiaLineaRichiesta) = upper-case('LineaNonFonia'))&amp;#xD;&amp;#xA;               then&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;    if(string-length($GetOffertaDonor/Record[1]/IDRISORSACORRELATO)>0)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;        then upper-case('MigrazioneOlo') &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else upper-case('Attivazione274')&amp;#xD;&amp;#xA;              else 'La migrazione richiesta non è permessa' &amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9; else upper-case('MigrazioneOlo') &amp;#xD;&amp;#xA;&amp;#x9;&amp;#xD;&amp;#xA;else if(tib:trim(upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))=(upper-case('BitstreamATMAsimmetricoFlat'), upper-case('BitstreamATMAsimmetricoHL'), upper-case('BitstreamATMAsimmetricoLite'), upper-case('BitstreamGBEAsimmetricoFlat') ))&amp;#xD;&amp;#xA;     then &amp;#xD;&amp;#xA;&amp;#x9;     if ((string-length($GetOffertaDonor/Record[1]/IDRISORSACORRELATO)>0 and ($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC')) or  not($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC'))&amp;#xD;&amp;#xA;&amp;#x9;     then upper-case('MigrazioneOlo')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9; else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;       upper-case('Attivazione274')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;  &amp;#x9;&amp;#x9; &amp;#xD;&amp;#xA; else  if(tib:trim(upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))=(upper-case('EasyIPBasePlusFlat'), upper-case('EasyIPBasePlusLite'), upper-case('EasyIPSpecialProfileFlat'),upper-case('EasyIPSpecialProfileLite')))&amp;#xD;&amp;#xA;      then  if(($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC') and  not(string-length($GetOffertaDonor/Record[1]/IDRISORSACORRELATO)>0)  )&amp;#xD;&amp;#xA;            then upper-case('Attivazione274') &amp;#xD;&amp;#xA;&amp;#x9;        else  upper-case('MigrazioneOlo')&amp;#xD;&amp;#xA;else upper-case('La migrazione richiesta non è permessa')&quot;/>&#xa;                    &lt;xsl:if test=&quot;ns16:tipologiaAccesso&quot;>&#xa;                        &lt;ns16:tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;ns16:tipologiaAccesso&quot;/>&#xa;                        &lt;/ns16:tipologiaAccesso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns16:codiceRisorsa&quot;>&#xa;                        &lt;ns16:codiceRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;ns16:codiceRisorsa&quot;/>&#xa;                        &lt;/ns16:codiceRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA&quot;>&#xa;                        &lt;ns16:offertaRichiesta>&#xa;                            &lt;xsl:value-of select=&quot;$offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&#xa;                        &lt;/ns16:offertaRichiesta>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns16:idOffertaDatiMCRO&quot;>&#xa;                        &lt;ns16:idOffertaDatiMCRO>&#xa;                            &lt;xsl:value-of select=&quot;ns16:idOffertaDatiMCRO&quot;/>&#xa;                        &lt;/ns16:idOffertaDatiMCRO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;ns16:offertaConsistenzaDati&quot;>&#xa;                        &lt;ns16:offertaConsistenzaDati>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:offertaConsistenzaDati>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;ns16:idOffertaFoniaMCRO&quot;>&#xa;                        &lt;ns16:idOffertaFoniaMCRO>&#xa;                            &lt;xsl:value-of select=&quot;ns16:idOffertaFoniaMCRO&quot;/>&#xa;                        &lt;/ns16:idOffertaFoniaMCRO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;ns16:offertaConsistenzaFonia&quot;>&#xa;                        &lt;ns16:offertaConsistenzaFonia>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:offertaConsistenzaFonia>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:lavorazioneRichiesta&quot;>&#xa;                        &lt;ns16:lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:lavorazioneRichiesta&quot;/>&#xa;                        &lt;/ns16:lavorazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA='SHASENZAMANODOPERA'&quot;>&#xa;                            &lt;ns16:tipologiaLineaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'POTS'&quot;/>&#xa;                            &lt;/ns16:tipologiaLineaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA='SHACONMANODOPERA'&quot;>&#xa;                            &lt;ns16:tipologiaLineaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'ISDN'&quot;/>&#xa;                            &lt;/ns16:tipologiaLineaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:tipologiaLineaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:tipologiaLineaRichiesta)&quot;/>&#xa;                            &lt;/ns16:tipologiaLineaRichiesta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:for-each select=&quot;ns16:tipologiaLineaConsistenzaDati&quot;>&#xa;                        &lt;ns16:tipologiaLineaConsistenzaDati>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:tipologiaLineaConsistenzaDati>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;ns16:tipologiaLineaConsistenzaFonia&quot;>&#xa;                        &lt;ns16:tipologiaLineaConsistenzaFonia>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:tipologiaLineaConsistenzaFonia>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains('ULL,ULLDATI,ULLDATI,SLU,WLR,SHA,VULL',upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;ns16:flagRientro='N'&quot;>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'MIGRAZIONEOLO'&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'RIENTROINTI'&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;contains('BITSTREAMNGAFTTH,VULAFTTH,BITSTREAMNGAFTTCAB,VULAFTTCAB,BITSTREAMATMASIMMETRICOFLAT,BITSTREAMATMASIMMETRICOHL,BITSTREAMATMASIMMETRICOLITE,BITSTREAMGBEASIMMETRICOFLAT,EASYIPBASEPLUSFLAT,EASYIPBASEPLUSLITE,EASYIPSPECIALPROFILEFLAT,EASYIPSPECIALPROFILELITE',upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($attivazione274variable)=upper-case('Attivazione274')&quot;>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'ATTIVAZIONE274'&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($attivazione274variable)=upper-case('MigrazioneOlo')&quot;>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'MIGRAZIONEOLO'&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:tipologiaSottoLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ns16:tipologiaSottoLavorazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains('ULL,ULLDATI,SLU,VULL,SHA,WLR',upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))&quot;>&#xa;                            &lt;ns16:strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                            &lt;/ns16:strutturaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;contains('BitstreamATMAsimmetricoFlat, BitstreamATMAsimmetricoHL,BitstreamATMAsimmetricoLite,BitstreamGBEAsimmetricoFlat,EasyIPBasePlusFlat,EasyIPBasePlusLite,EasyIPSpecialProfileFlat,EasyIPSpecialProfileLite',$offertaQuery/Record[1]/NOME_OFFERTA_CATLG)&quot;>&#xa;                            &lt;ns16:strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;                            &lt;/ns16:strutturaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;contains('BitstreamNGAFTTCAB,BitstreamNGAFTTH,VULAFTTCAB,VULAFTTH',$offertaQuery/Record[1]/NOME_OFFERTA_CATLG)&quot;>&#xa;                            &lt;ns16:strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;                            &lt;/ns16:strutturaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'NPG'&quot;/>&#xa;                            &lt;/ns16:strutturaRichiesta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;ns16:flagNPAsset&quot;>&#xa;                        &lt;ns16:flagNPAsset>&#xa;                            &lt;xsl:value-of select=&quot;ns16:flagNPAsset&quot;/>&#xa;                        &lt;/ns16:flagNPAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;(upper-case($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codificaOloAgcomRecipient)='TLC') and (contains('ULL,SLU',$offertaQuery/Record[1]/NOME_OFFERTA_CATLG)) and (upper-case($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:flagNPAsset)='Y')&quot;>&#xa;                            &lt;ns16:flagRientro>&#xa;                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                            &lt;/ns16:flagRientro>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:flagRientro>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns16:flagRientro>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:flagNPAsset)='Y'&quot;>&#xa;                            &lt;ns16:flagNPRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                            &lt;/ns16:flagNPRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:flagNPRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns16:flagNPRichiesta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:flagNPAsset)='Y' and upper-case(ns16:flagNPAsset)='Y'&quot;>&#xa;                            &lt;ns16:flagPortabilita>&#xa;                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                            &lt;/ns16:flagPortabilita>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:flagPortabilita>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns16:flagPortabilita>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;ns16:flagAggiuntivo&quot;>&#xa;                        &lt;ns16:flagAggiuntivo>&#xa;                            &lt;xsl:value-of select=&quot;ns16:flagAggiuntivo&quot;/>&#xa;                        &lt;/ns16:flagAggiuntivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;if(contains($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:destinazioneUsoRichiestaOlo,'|')) then 'F+D' else $post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:destinazioneUsoRichiestaOlo&quot;>&#xa;                        &lt;ns16:destinazioneUsoRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;if(contains($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:destinazioneUsoRichiestaOlo,'|')) then 'F+D' else $post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:destinazioneUsoRichiestaOlo&quot;/>&#xa;                        &lt;/ns16:destinazioneUsoRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;ns16:destinazioneUsoAssetDati&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;.=('4','5','9','10')&quot;>&#xa;                                &lt;ns16:destinazioneUsoAssetDati>&#xa;                                    &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                                &lt;/ns16:destinazioneUsoAssetDati>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;.=('1','2','3')&quot;>&#xa;                                &lt;ns16:destinazioneUsoAssetDati>&#xa;                                    &lt;xsl:value-of select=&quot;'F'&quot;/>&#xa;                                &lt;/ns16:destinazioneUsoAssetDati>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;contains(.,'|')&quot;>&#xa;                                &lt;ns16:destinazioneUsoAssetDati>&#xa;                                    &lt;xsl:value-of select=&quot;'F+D'&quot;/>&#xa;                                &lt;/ns16:destinazioneUsoAssetDati>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns16:destinazioneUsoAssetDati>&#xa;                                    &lt;xsl:value-of select=&quot;if (contains(tib:concat-sequence-format(../ns16:assetDatiStandard, ',', true()),'N') and upper-case($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codificaOloAgcomRecipient)!=&amp;quot;TLC&amp;quot; and (contains(tib:concat-sequence-format(../ns16:offertaConsistenzaDati,',', true()),'VULAFTTH') or contains(tib:concat-sequence-format(../ns16:offertaConsistenzaDati,',', true()),'BitstreamNGAFTTH')) and ($offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA='VULAFTTH' or $offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA='BitstreamNGAFTTH')) then  'FIBRA' else ''&quot;/>&#xa;                                &lt;/ns16:destinazioneUsoAssetDati>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;ns16:destinazioneUsoAssetFonia&quot;>&#xa;                        &lt;ns16:destinazioneUsoAssetFonia>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:destinazioneUsoAssetFonia>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;ns16:assetDatiStandard&quot;>&#xa;                        &lt;ns16:assetDatiStandard>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:assetDatiStandard>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;ns16:assetFoniaStandard&quot;>&#xa;                        &lt;ns16:assetFoniaStandard>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:assetFoniaStandard>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:codificaOloAgcomRecipient)=&amp;quot;TLC&amp;quot;&quot;>&#xa;                            &lt;ns16:richiestaOLOStandard>&#xa;                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                            &lt;/ns16:richiestaOLOStandard>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:richiestaOLOStandard>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns16:richiestaOLOStandard>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:idRichiestaOlo&quot;>&#xa;                        &lt;ns16:idRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$post1/item/tns1:InputVerificaCompatibilitaLavorazione/tns1:idRichiestaOlo&quot;/>&#xa;                        &lt;/ns16:idRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns16:OutputVerificaServizioInConsistenza>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns16:outputVerificaServizioInConsistenza>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="servizioVariable"
                                    name="Assign"
                                    outputVariable="servizioVariable"
                                    tibex:xpdlId="c9da4077-5891-41cf-aa92-59268d0621c5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallVerificaServizioInConsistenzaToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignTomatriceControlliQuery"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns16=&quot;http://www.tim.com/NOW/cmf/VerificaServizioInConsistenza&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post1.item&quot;/>&#xa;    &lt;xsl:param name=&quot;offertaQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;GetOffertaDonor&quot;/>&#xa;    &lt;xsl:param name=&quot;CallVerificaServizioInConsistenza&quot;/>&#xa;    &lt;xsl:template name=&quot;servizioVariable&quot; match=&quot;/&quot;>&#xa;        &lt;ns16:outputVerificaServizioInConsistenza>&#xa;            &lt;xsl:for-each select=&quot;$CallVerificaServizioInConsistenza/ns16:OutputVerificaServizioInConsistenza&quot;>&#xa;                &lt;ns16:OutputVerificaServizioInConsistenza>&#xa;                    &lt;xsl:variable name=&quot;attivazione274variable&quot; select=&quot;if(tib:trim(upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))=(upper-case('BitstreamNGAFTTH'),upper-case('VULAFTTH')) )&amp;#xD;&amp;#xA; then if (tib:trim(upper-case($GetOffertaDonor/Record[1]/OFFERTA))=(upper-case('BitstreamNGAFTTH'),upper-case('VULAFTTH')))&amp;#xD;&amp;#xA;     then if ($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC') &amp;#xD;&amp;#xA;&amp;#x9;        then upper-case('Attivazione274') &amp;#xD;&amp;#xA;&amp;#x9;          else   upper-case('MigrazioneOlo')    &amp;#xD;&amp;#xA;  else 'La migrazione richiesta non è permessa' &amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(tib:trim(upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))=(upper-case('BitstreamNGAFTTCAB'),upper-case('VULAFTTCAB')) )&amp;#xD;&amp;#xA;   then&amp;#xD;&amp;#xA;    if ($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC')&amp;#xD;&amp;#xA;&amp;#x9;  then if(upper-case($post1.item/tns1:tipologiaLineaRichiesta) = upper-case('POTS'))&amp;#xD;&amp;#xA;            then upper-case('Attivazione274') &amp;#xD;&amp;#xA;&amp;#x9;        else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;  if (upper-case($post1.item/tns1:tipologiaLineaRichiesta) = upper-case('LineaNonFonia'))&amp;#xD;&amp;#xA;               then&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;    if(string-length($GetOffertaDonor/Record[1]/IDRISORSACORRELATO)>0)&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;        then upper-case('MigrazioneOlo') &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;else upper-case('Attivazione274')&amp;#xD;&amp;#xA;              else 'La migrazione richiesta non è permessa' &amp;#x9;&amp;#x9;&amp;#x9;&amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9; else upper-case('MigrazioneOlo') &amp;#xD;&amp;#xA;&amp;#x9;&amp;#xD;&amp;#xA;else if(tib:trim(upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))=(upper-case('BitstreamATMAsimmetricoFlat'), upper-case('BitstreamATMAsimmetricoHL'), upper-case('BitstreamATMAsimmetricoLite'), upper-case('BitstreamGBEAsimmetricoFlat') ))&amp;#xD;&amp;#xA;     then &amp;#xD;&amp;#xA;&amp;#x9;     if ((string-length($GetOffertaDonor/Record[1]/IDRISORSACORRELATO)>0 and ($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC')) or  not($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC'))&amp;#xD;&amp;#xA;&amp;#x9;     then upper-case('MigrazioneOlo')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9; else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;       upper-case('Attivazione274')&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;  &amp;#x9;&amp;#x9; &amp;#xD;&amp;#xA; else  if(tib:trim(upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))=(upper-case('EasyIPBasePlusFlat'), upper-case('EasyIPBasePlusLite'), upper-case('EasyIPSpecialProfileFlat'),upper-case('EasyIPSpecialProfileLite')))&amp;#xD;&amp;#xA;      then  if(($GetOffertaDonor/Record[1]/CODIFICAOLOAGCOM='TLC') and  not(string-length($GetOffertaDonor/Record[1]/IDRISORSACORRELATO)>0)  )&amp;#xD;&amp;#xA;            then upper-case('Attivazione274') &amp;#xD;&amp;#xA;&amp;#x9;        else  upper-case('MigrazioneOlo')&amp;#xD;&amp;#xA;else upper-case('La migrazione richiesta non è permessa')&quot;/>&#xa;                    &lt;xsl:if test=&quot;ns16:tipologiaAccesso&quot;>&#xa;                        &lt;ns16:tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;ns16:tipologiaAccesso&quot;/>&#xa;                        &lt;/ns16:tipologiaAccesso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns16:codiceRisorsa&quot;>&#xa;                        &lt;ns16:codiceRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;ns16:codiceRisorsa&quot;/>&#xa;                        &lt;/ns16:codiceRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA&quot;>&#xa;                        &lt;ns16:offertaRichiesta>&#xa;                            &lt;xsl:value-of select=&quot;$offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&#xa;                        &lt;/ns16:offertaRichiesta>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns16:idOffertaDatiMCRO&quot;>&#xa;                        &lt;ns16:idOffertaDatiMCRO>&#xa;                            &lt;xsl:value-of select=&quot;ns16:idOffertaDatiMCRO&quot;/>&#xa;                        &lt;/ns16:idOffertaDatiMCRO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;ns16:offertaConsistenzaDati&quot;>&#xa;                        &lt;ns16:offertaConsistenzaDati>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:offertaConsistenzaDati>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;ns16:idOffertaFoniaMCRO&quot;>&#xa;                        &lt;ns16:idOffertaFoniaMCRO>&#xa;                            &lt;xsl:value-of select=&quot;ns16:idOffertaFoniaMCRO&quot;/>&#xa;                        &lt;/ns16:idOffertaFoniaMCRO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;ns16:offertaConsistenzaFonia&quot;>&#xa;                        &lt;ns16:offertaConsistenzaFonia>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:offertaConsistenzaFonia>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns1:lavorazioneRichiesta&quot;>&#xa;                        &lt;ns16:lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns1:lavorazioneRichiesta&quot;/>&#xa;                        &lt;/ns16:lavorazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA='SHASENZAMANODOPERA'&quot;>&#xa;                            &lt;ns16:tipologiaLineaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'POTS'&quot;/>&#xa;                            &lt;/ns16:tipologiaLineaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA='SHACONMANODOPERA'&quot;>&#xa;                            &lt;ns16:tipologiaLineaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'ISDN'&quot;/>&#xa;                            &lt;/ns16:tipologiaLineaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:tipologiaLineaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($post1.item/tns1:tipologiaLineaRichiesta)&quot;/>&#xa;                            &lt;/ns16:tipologiaLineaRichiesta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:for-each select=&quot;ns16:tipologiaLineaConsistenzaDati&quot;>&#xa;                        &lt;ns16:tipologiaLineaConsistenzaDati>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:tipologiaLineaConsistenzaDati>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;ns16:tipologiaLineaConsistenzaFonia&quot;>&#xa;                        &lt;ns16:tipologiaLineaConsistenzaFonia>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:tipologiaLineaConsistenzaFonia>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains('ULL,ULLDATI,ULLDATI,SLU,WLR,SHA,VULL',upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;ns16:flagRientro='N'&quot;>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'MIGRAZIONEOLO'&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'RIENTROINTI'&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;contains('BITSTREAMNGAFTTH,VULAFTTH,BITSTREAMNGAFTTCAB,VULAFTTCAB,BITSTREAMATMASIMMETRICOFLAT,BITSTREAMATMASIMMETRICOHL,BITSTREAMATMASIMMETRICOLITE,BITSTREAMGBEASIMMETRICOFLAT,EASYIPBASEPLUSFLAT,EASYIPBASEPLUSLITE,EASYIPSPECIALPROFILEFLAT,EASYIPSPECIALPROFILELITE',upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;upper-case($attivazione274variable)=upper-case('Attivazione274')&quot;>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'ATTIVAZIONE274'&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($attivazione274variable)=upper-case('MigrazioneOlo')&quot;>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;'MIGRAZIONEOLO'&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns16:tipologiaSottoLavorazione>&#xa;                                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                    &lt;/ns16:tipologiaSottoLavorazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:tipologiaSottoLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/ns16:tipologiaSottoLavorazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains('ULL,ULLDATI,SLU,VULL,SHA,WLR',upper-case($offertaQuery/Record[1]/NOME_OFFERTA_CATLG))&quot;>&#xa;                            &lt;ns16:strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;                            &lt;/ns16:strutturaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;contains('BitstreamATMAsimmetricoFlat, BitstreamATMAsimmetricoHL,BitstreamATMAsimmetricoLite,BitstreamGBEAsimmetricoFlat,EasyIPBasePlusFlat,EasyIPBasePlusLite,EasyIPSpecialProfileFlat,EasyIPSpecialProfileLite',$offertaQuery/Record[1]/NOME_OFFERTA_CATLG)&quot;>&#xa;                            &lt;ns16:strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;                            &lt;/ns16:strutturaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;contains('BitstreamNGAFTTCAB,BitstreamNGAFTTH,VULAFTTCAB,VULAFTTH',$offertaQuery/Record[1]/NOME_OFFERTA_CATLG)&quot;>&#xa;                            &lt;ns16:strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;                            &lt;/ns16:strutturaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'NPG'&quot;/>&#xa;                            &lt;/ns16:strutturaRichiesta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;ns16:flagNPAsset&quot;>&#xa;                        &lt;ns16:flagNPAsset>&#xa;                            &lt;xsl:value-of select=&quot;ns16:flagNPAsset&quot;/>&#xa;                        &lt;/ns16:flagNPAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;(upper-case($post1.item/tns1:codificaOloAgcomRecipient)='TLC') and (contains('ULL,SLU',$offertaQuery/Record[1]/NOME_OFFERTA_CATLG)) and (upper-case($post1.item/tns1:flagNPAsset)='Y')&quot;>&#xa;                            &lt;ns16:flagRientro>&#xa;                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                            &lt;/ns16:flagRientro>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:flagRientro>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns16:flagRientro>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post1.item/tns1:flagNPAsset)='Y'&quot;>&#xa;                            &lt;ns16:flagNPRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                            &lt;/ns16:flagNPRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:flagNPRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns16:flagNPRichiesta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post1.item/tns1:flagNPAsset)='Y' and upper-case(ns16:flagNPAsset)='Y'&quot;>&#xa;                            &lt;ns16:flagPortabilita>&#xa;                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                            &lt;/ns16:flagPortabilita>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:flagPortabilita>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns16:flagPortabilita>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;ns16:flagAggiuntivo&quot;>&#xa;                        &lt;ns16:flagAggiuntivo>&#xa;                            &lt;xsl:value-of select=&quot;ns16:flagAggiuntivo&quot;/>&#xa;                        &lt;/ns16:flagAggiuntivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;if(contains($post1.item/tns1:destinazioneUsoRichiestaOlo,'|')) then 'F+D' else $post1.item/tns1:destinazioneUsoRichiestaOlo&quot;>&#xa;                        &lt;ns16:destinazioneUsoRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;if(contains($post1.item/tns1:destinazioneUsoRichiestaOlo,'|')) then 'F+D' else $post1.item/tns1:destinazioneUsoRichiestaOlo&quot;/>&#xa;                        &lt;/ns16:destinazioneUsoRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;ns16:destinazioneUsoAssetDati&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;.=('4','5','9','10')&quot;>&#xa;                                &lt;ns16:destinazioneUsoAssetDati>&#xa;                                    &lt;xsl:value-of select=&quot;'D'&quot;/>&#xa;                                &lt;/ns16:destinazioneUsoAssetDati>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;.=('1','2','3')&quot;>&#xa;                                &lt;ns16:destinazioneUsoAssetDati>&#xa;                                    &lt;xsl:value-of select=&quot;'F'&quot;/>&#xa;                                &lt;/ns16:destinazioneUsoAssetDati>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;contains(.,'|')&quot;>&#xa;                                &lt;ns16:destinazioneUsoAssetDati>&#xa;                                    &lt;xsl:value-of select=&quot;'F+D'&quot;/>&#xa;                                &lt;/ns16:destinazioneUsoAssetDati>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns16:destinazioneUsoAssetDati>&#xa;                                    &lt;xsl:value-of select=&quot;if (contains(tib:concat-sequence-format(../ns16:assetDatiStandard, ',', true()),'N') and upper-case($post1.item/tns1:codificaOloAgcomRecipient)!=&amp;quot;TLC&amp;quot; and (contains(tib:concat-sequence-format(../ns16:offertaConsistenzaDati,',', true()),'VULAFTTH') or contains(tib:concat-sequence-format(../ns16:offertaConsistenzaDati,',', true()),'BitstreamNGAFTTH')) and ($offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA='VULAFTTH' or $offertaQuery/Record[1]/NOME_OFFERTA_ESTERNA='BitstreamNGAFTTH')) then  'FIBRA' else ''&quot;/>&#xa;                                &lt;/ns16:destinazioneUsoAssetDati>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;ns16:destinazioneUsoAssetFonia&quot;>&#xa;                        &lt;ns16:destinazioneUsoAssetFonia>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:destinazioneUsoAssetFonia>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;ns16:assetDatiStandard&quot;>&#xa;                        &lt;ns16:assetDatiStandard>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:assetDatiStandard>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;ns16:assetFoniaStandard&quot;>&#xa;                        &lt;ns16:assetFoniaStandard>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/ns16:assetFoniaStandard>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($post1.item/tns1:codificaOloAgcomRecipient)=&amp;quot;TLC&amp;quot;&quot;>&#xa;                            &lt;ns16:richiestaOLOStandard>&#xa;                                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                            &lt;/ns16:richiestaOLOStandard>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns16:richiestaOLOStandard>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/ns16:richiestaOLOStandard>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$post1.item/tns1:idRichiestaOlo&quot;>&#xa;                        &lt;ns16:idRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$post1.item/tns1:idRichiestaOlo&quot;/>&#xa;                        &lt;/ns16:idRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns16:OutputVerificaServizioInConsistenza>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns16:outputVerificaServizioInConsistenza>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="servizioVariable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
