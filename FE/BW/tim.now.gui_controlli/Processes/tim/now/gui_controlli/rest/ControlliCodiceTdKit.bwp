lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;'GUI'&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-SID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventID>&lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns1:httpHeaders/GUI-SID,$get/httpHeaders/tns1:httpHeaders/GUI-TID)&quot;/>&lt;/tns:EventID>&lt;xsl:if test=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns1:httpHeaders/GUI-TID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;ControlliCodiceTdKit_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;ControlliCodiceTdKit_&amp;quot;,$get/httpHeaders/tns1:httpHeaders/GUI-SID)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'OUT'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload/>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
