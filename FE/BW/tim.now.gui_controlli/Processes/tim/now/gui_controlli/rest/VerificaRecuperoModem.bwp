                                    columnName="IDCONF_TPL_CONTR_FWARESOMODEM"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_TIPOLOG_CONTR_FWA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
