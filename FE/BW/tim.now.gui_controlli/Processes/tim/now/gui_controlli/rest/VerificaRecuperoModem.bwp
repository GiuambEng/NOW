                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT *&#xa;FROM CONF_TPLG_CONTR_FWA_RESO_MODEM&#xa;WHERE ID_TIPOLOG_CONTR_FWA = &#xa;    (SELECT ID_TIPOLOG_CONTR_FWA&#xa;    FROM ASS_TIPOLOG_CONTR_FWA_PROF&#xa;    WHERE ID_PROFILO_FWA = &#xa;    (SELECT ID_PROFILO_FWA&#xa;    FROM PROFILO_FWA&#xa;    WHERE COD_PROFILO_FWA = ? AND TIPOLOGIA_APPARATO = ? &#xa;    AND DATA_INIZIO_VAL &lt;= SYSDATE AND DATA_FINE_VAL>= SYSDATE))&#xa;AND CODIFICAOLOAGCOM = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

