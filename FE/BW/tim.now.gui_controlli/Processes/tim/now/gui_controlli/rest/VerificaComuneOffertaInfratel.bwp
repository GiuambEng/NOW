                                    outputVariable="RecuperaCodiceIstatComune"
                                    tibex:xpdlId="2903f7bf-1747-4593-8d6d-50419a09e7e6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VerificaComuneOffertaInfratel_InfoToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperaCodiceIstatComuneToVerificaComuneOffertaInfratel_CodIstatComune">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(upper-case($post/item/tns:inputVerificaComuneOffertaInfratel/tns:lavorazione) = &quot;ATTIVAZIONE&quot;) or (count($RecuperaCodiceIstatComune/Record)>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(upper-case($post.item/tns:lavorazione) = "ATTIVAZIONE") or (count($RecuperaCodiceIstatComune/Record)>0)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="RecuperaCodiceIstatComuneToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2903f7bf-1747-4593-8d6d-50419a09e7e6+input&quot; xmlns:tns1=&quot;http://www.example.org/VerificaComuneOffertaInfratel&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaCodiceIstatComune-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;provincia>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoDatiClienteFinale/tns1:provincia)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoDatiClienteFinale/tns1:provincia&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/provincia>&#xa;            &lt;comune>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoDatiClienteFinale/tns1:comune)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoDatiClienteFinale/tns1:comune&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/comune>&#xa;            &lt;partToponomastica>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoDatiClienteFinale/tns1:partToponomastica&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/partToponomastica>&#xa;            &lt;indirizzo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoDatiClienteFinale/tns1:indirizzo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoDatiClienteFinale/tns1:indirizzo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/indirizzo>&#xa;            &lt;civico>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoDatiClienteFinale/tns1:civico)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoDatiClienteFinale/tns1:civico&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/civico>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT C.COD_ISTAT_COMUNE&#xa;FROM PROV P, COMUNE_O_LOCALITA C, PARTICELLA PA, VIA V , NUMERO_CIVICO N&#xa;WHERE P.COD_ISTAT_PROV = C.COD_ISTAT_PROV &#xa;AND C.COD_ISTAT_COMUNE = V.COD_ISTAT_COMUNE &#xa;AND V.COD_PARTICELLA_TOPON = PA.COD_PARTICELLA_TOPON &#xa;AND V.COD_STRADA = N.COD_STRADA &#xa;AND upper(TRIM(P.DESCR_PROV)) = upper(?) &#xa;AND upper(TRIM(C.DESCR_COMUNE))=upper(?) &#xa;AND upper(TRIM(PA.DESCR_PARTICELLA_TOPON))=upper(?) &#xa;AND upper(TRIM(V.DESCR_VIA))=upper(?)&#xa;AND upper(TRIM(N.NUMERO_CIVICO)) = upper(?)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="provincia"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="comune"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="partToponomastica"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="indirizzo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="civico"/>
                                    <columnMetadata
                                    columnName="COD_ISTAT_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
