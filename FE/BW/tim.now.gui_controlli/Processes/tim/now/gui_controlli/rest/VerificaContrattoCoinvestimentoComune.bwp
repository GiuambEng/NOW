                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaContrattoCoinvestimentoComune&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/CONTEGGIO>0&quot;>&lt;tns:outputVerificaContrattoCoinvestimentoComune>&lt;tns:VerificaContrattoCoinvestimentoComuneOuput>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;/tns:VerificaContrattoCoinvestimentoComuneOuput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaContrattoCoinvestimentoComune>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVerificaContrattoCoinvestimentoComune>&lt;tns:VerificaContrattoCoinvestimentoComuneOuput>&lt;tns:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;'Offerta non sottoscrivibile per il comune indicato'&quot;/>&lt;/tns:message>&lt;/tns:VerificaContrattoCoinvestimentoComuneOuput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaContrattoCoinvestimentoComune>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
