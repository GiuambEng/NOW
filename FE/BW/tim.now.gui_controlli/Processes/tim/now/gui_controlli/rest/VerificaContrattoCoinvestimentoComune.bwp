                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT C.COD_ISTAT_COMUNE&#xa;FROM PROV P, COMUNE_O_LOCALITA C, PARTICELLA PA, VIA V , NUMERO_CIVICO N&#xa;WHERE P.COD_ISTAT_PROV = C.COD_ISTAT_PROV &#xa;AND C.COD_ISTAT_COMUNE = V.COD_ISTAT_COMUNE &#xa;AND V.COD_PARTICELLA_TOPON = PA.COD_PARTICELLA_TOPON &#xa;AND V.COD_STRADA = N.COD_STRADA &#xa;AND upper(TRIM(P.DESCR_PROV)) = upper(?) &#xa;AND upper(TRIM(C.DESCR_COMUNE))=upper(?) &#xa;AND upper(TRIM(PA.DESCR_PARTICELLA_TOPON))=upper(?) &#xa;AND upper(TRIM(V.DESCR_VIA))=upper(?)&#xa;AND upper(TRIM(N.NUMERO_CIVICO)) = upper(?)&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="prov"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="comune"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="particella"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="via"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="civico"/>
                                    <columnMetadata
                                    columnName="COD_ISTAT_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0a6fdb94-e9e0-4a99-a7b7-ffe512c1a373+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.org/VerificaContrattoCoinvestimentoComune&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;CodIstatComune&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($post/item/tns1:inputVerificaContrattoCoinvestimentoComune/tns1:lavorazione)>0 and upper-case($post/item/tns1:inputVerificaContrattoCoinvestimentoComune/tns1:lavorazione) = 'MIGRAZIONE' and string-length($post/item/tns1:inputVerificaContrattoCoinvestimentoComune/tns1:indirizzoDatiClienteFinale/tns1:comune)=0&quot;>&lt;codIstatComune>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:inputVerificaContrattoCoinvestimentoComune/tns1:codiceIstatComune)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:inputVerificaContrattoCoinvestimentoComune/tns1:codiceIstatComune&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codIstatComune>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codIstatComune>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CodIstatComune/Record[1]/COD_ISTAT_COMUNE)&quot;>&lt;xsl:value-of select=&quot;$CodIstatComune/Record[1]/COD_ISTAT_COMUNE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codIstatComune>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;idContratto>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:inputVerificaContrattoCoinvestimentoComune/tns1:idContratto)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:inputVerificaContrattoCoinvestimentoComune/tns1:idContratto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idContratto>&lt;idOfferta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:inputVerificaContrattoCoinvestimentoComune/tns1:idOfferta)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:inputVerificaContrattoCoinvestimentoComune/tns1:idOfferta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idOfferta>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCQuery-input"
                                    name="JDBCQuery"
                                    outputVariable="JDBCQuery"
                                    tibex:xpdlId="0a6fdb94-e9e0-4a99-a7b7-ffe512c1a373" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CodIstatComuneToJDBCQuery"/>
                                    <bpws:target linkName="EmptyToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0a6fdb94-e9e0-4a99-a7b7-ffe512c1a373+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.org/VerificaContrattoCoinvestimentoComune&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;CodIstatComune&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($post.item/tns1:lavorazione)>0 and upper-case($post.item/tns1:lavorazione) = 'MIGRAZIONE' and string-length($post.item/tns1:indirizzoDatiClienteFinale/tns1:comune)=0&quot;>&#xa;                    &lt;codIstatComune>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($post.item/tns1:codiceIstatComune)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$post.item/tns1:codiceIstatComune&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/codIstatComune>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codIstatComune>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CodIstatComune/Record[1]/COD_ISTAT_COMUNE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CodIstatComune/Record[1]/COD_ISTAT_COMUNE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/codIstatComune>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;idContratto>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:idContratto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:idContratto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idContratto>&#xa;            &lt;idOfferta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:idOfferta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:idOfferta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idOfferta>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*) AS CONTEGGIO&#xa;FROM COMUNE_O_LOCALITA COL INNER JOIN CATALG_OFF_COM_COINV CC ON COL.COD_COMUNE = CC.COD_COMUNE INNER JOIN CONTRATTO_OFFERTA_CATLG COC ON CC.ID_CONTRATTO_OFFERTA_CATLG = COC.ID_CONTRATTO_OFFERTA_CATLG&#xa;WHERE COL.COD_ISTAT_COMUNE = ? AND COC.ID_CONTRATTO = ? AND COC.ID_OFFERTA = ? AND CC.DATA_INIZIO_VAL&lt;=SYSDATE AND CC.DATA_FINE_VAL>=SYSDATE&#xa;AND COL.FLAG_COMUNE = 'S'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codIstatComune"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idContratto"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idOfferta"/>
                                    <columnMetadata
                                    columnName="CONTEGGIO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaContrattoCoinvestimentoComune&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/CONTEGGIO>0&quot;>&lt;tns:outputVerificaContrattoCoinvestimentoComune>&lt;tns:VerificaContrattoCoinvestimentoComuneOuput>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;/tns:VerificaContrattoCoinvestimentoComuneOuput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaContrattoCoinvestimentoComune>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVerificaContrattoCoinvestimentoComune>&lt;tns:VerificaContrattoCoinvestimentoComuneOuput>&lt;tns:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;'Offerta non sottoscrivibile per il comune indicato'&quot;/>&lt;/tns:message>&lt;/tns:VerificaContrattoCoinvestimentoComuneOuput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaContrattoCoinvestimentoComune>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Variable"
                                    name="Assign"
                                    outputVariable="Variable"
                                    tibex:xpdlId="47ea2d24-4abd-408f-b16b-8405123b3850" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
