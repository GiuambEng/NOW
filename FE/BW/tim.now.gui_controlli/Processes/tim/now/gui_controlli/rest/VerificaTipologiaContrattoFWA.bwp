                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count (*)&#xa;from ASS_OLO_PROF_FWA_OBBL_PROG AO INNER JOIN PROFILO_FWA P ON AO.ID_PROFILO_FWA = P.ID_PROFILO_FWA&#xa;where P.COD_PROFILO_FWA = ? AND AO.CODFC_OLO_AGCOM = ? AND AO.DATA_INIZIO_VALIDITA&lt;=SYSDATE AND AO.DATA_FINE_VALIDITA>=SYSDATE"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

