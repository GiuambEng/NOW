at(&amp;quot;ErrorVerificaTipologiaContrattoFWA:&amp;quot;,tib:render-xml($post.item, true(),true()))&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerError&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.gui_controlli.rest.VerificaTipologiaContrattoFWA'&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;'GUI'&amp;#xD;&amp;#xA;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaTipologiaContrattoFWA_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;ERROR&amp;quot;)&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaTipologiaContrattoFWA_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                    &lt;tns:ErrorLog>&#xa;                        &lt;tns:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TimeStamp>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ErrorVerificaTipologiaContrattoFWA&amp;quot;,'SID:',$post.httpHeaders/GUI-SID,'TID:',$post.httpHeaders/GUI-TID,'ST',$FaultDetails/StackTrace)&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:track_position>&#xa;             