                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.example.org/VerificaContrattoFWAEOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;VerificaContrattoFWAEOLO_LogOutput-input&quot; match=&quot;/&quot;>&lt;tns5:CW_BUS_MESSAGE>&lt;tns5:GenericLogger>&lt;tns5:Process>&lt;xsl:value-of select=&quot;'VerificaContrattoFWAEOLO'&quot;/>&lt;/tns5:Process>&lt;tns5:Service>&lt;xsl:value-of select=&quot;'tim.now.gui_controlli.rest.VerificaContrattoFWAEOLO'&quot;/>&lt;/tns5:Service>&lt;tns5:Operation>&lt;xsl:value-of select=&quot;'select'&quot;/>&lt;/tns5:Operation>&lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&lt;tns5:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&lt;/tns5:BusinessID>&lt;/xsl:if>&lt;tns5:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;OutputVerificaContrattoFWAEOLO:&amp;quot;,tib:render-xml($Variable/tns1:esito, true(),true()))&quot;/>&lt;/tns5:Payload>&lt;tns5:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns5:LoggerName>&lt;tns5:LogLevel>&lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&lt;/tns5:LogLevel>&lt;tns5:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns5:LogJMS>&lt;/tns5:GenericLogger>&lt;tns5:ActiveLoggerServices>&lt;tns5:Envelope>&lt;tns5:Identifier>&lt;tns5:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.gui_controlli.rest.VerificaContrattoFWAEOLO'&quot;/>&lt;/tns5:ServiceName>&lt;tns5:Operation>&lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&lt;/tns5:Operation>&lt;tns5:Source>&lt;xsl:value-of select=&quot;'GUI'&quot;/>&lt;/tns5:Source>&lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;>&lt;tns5:BusinessID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-SID&quot;/>&lt;/tns5:BusinessID>&lt;/xsl:if>&lt;tns5:EventID>&lt;xsl:value-of select=&quot;concat($get/httpHeaders/tns4:httpHeaders/GUI-SID,$get/httpHeaders/tns4:httpHeaders/GUI-TID)&quot;/>&lt;/tns5:EventID>&lt;xsl:if test=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-TID&quot;>&lt;tns5:CorrelationID>&lt;xsl:value-of select=&quot;$get/httpHeaders/tns4:httpHeaders/GUI-TID&quot;/>&lt;/tns5:CorrelationID>&lt;/xsl:if>&lt;tns5:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaContrattoFWAEOLO_&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&lt;/tns5:EventType>&lt;tns5:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaContrattoFWAEOLO_&amp;quot;,$get/httpHeaders/tns4:httpHeaders/GUI-SID)&quot;/>&lt;/tns5:trackID>&lt;/tns5:Identifier>&lt;tns5:track_position>&lt;xsl:value-of select=&quot;'OUT'&quot;/>&lt;/tns5:track_position>&lt;tns5:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns5:Timestamp>&lt;/tns5:Envelope>&lt;/tns5:ActiveLoggerServices>&lt;/tns5:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VerificaContrattoFWAEOLO_LogOutput-input"
                                    name="VerificaContrattoFWAEOLO_LogOutput"
                                    tibex:xpdlId="40401b7a-9dbe-41c3-9dee-ab16e186cded"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToCallProcess2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess2TogetOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tns0=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.example.org/VerificaContrattoFWAEOLO&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaContrattoFWAEOLO_LogOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaContrattoFWAEOLO'&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.gui_controlli.rest.VerificaContrattoFWAEOLO'&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'select'&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputVerificaContrattoFWAEOLO:&amp;quot;,tib:render-xml($Variable/tns1:esito, true(),true()))&quot;/>&#xa;                &lt;/tns5:Payload>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerInfo&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.gui_controlli.rest.VerificaContrattoFWAEOLO'&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;'GUI'&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($get.httpHeaders/GUI-SID,$get.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns5:EventID>&#xa;                        &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns5:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns5:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaContrattoFWAEOLO_&amp;quot;,$get.httpHeaders/GUI-SID,&amp;quot;COMPLETED&amp;quot;)&quot;/>&#xa;                        &lt;/tns5:EventType>&#xa;                        &lt;tns5:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaContrattoFWAEOLO_&amp;quot;,$get.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns5:trackID>&#xa;                    &lt;/tns5:Identifier>&#xa;                    &lt;tns5:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'OUT'&quot;/>&#xa;                    &lt;/tns5:track_position>&#xa;                    &lt;tns5:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns5:Timestamp>&#xa;                &lt;/tns5:Envelope>&#xa;            &lt;/tns5:ActiveLoggerServices>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_controlli.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
