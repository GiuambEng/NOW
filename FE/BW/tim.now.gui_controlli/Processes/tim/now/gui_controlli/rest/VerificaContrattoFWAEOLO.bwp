                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/VerificaContrattoFWAEOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/COUNT>0&quot;>&lt;tns1:VerificaContrattoFWAEOLOOutput>&lt;tns1:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:esito>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:code>&lt;/tns1:result>&lt;/tns1:VerificaContrattoFWAEOLOOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:VerificaContrattoFWAEOLOOutput>&lt;tns1:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:esito>&lt;tns1:result>&lt;tns1:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns1:severity>&lt;tns1:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:code>&lt;tns1:details>&lt;xsl:value-of select=&quot;'Nessun Record Trovato'&quot;/>&lt;/tns1:details>&lt;/tns1:result>&lt;/tns1:VerificaContrattoFWAEOLOOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
