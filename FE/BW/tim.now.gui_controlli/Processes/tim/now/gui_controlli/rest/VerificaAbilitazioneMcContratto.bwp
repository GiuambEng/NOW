                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns2=&quot;http://xmlns.example.com/VerificaAbilitazioneMcContratto/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaAbilitazioneMCContratto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaAbilitazioneMCContratto_Request>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;'GUI'&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;            &lt;/tns1:Lavorazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($get.parameters/tns2:flagPrimoFeeder) = 'Y'&quot;>&#xa;                    &lt;tns1:Sottolavorazione>&#xa;                        &lt;xsl:value-of select=&quot;'PRIMOFEEDER'&quot;/>&#xa;                    &lt;/tns1:Sottolavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Sottolavorazione>&#xa;                        &lt;xsl:value-of select=&quot;'FEEDERSUCCESSIVO'&quot;/>&#xa;                    &lt;/tns1:Sottolavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:Offerta>&#xa;                &lt;xsl:value-of select=&quot;'FEEDER'&quot;/>&#xa;            &lt;/tns1:Offerta>&#xa;            &lt;tns1:CodiceOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns2:codOloAgcom&quot;/>&#xa;            &lt;/tns1:CodiceOloAgcom>&#xa;        &lt;/tns1:VerificaAbilitazioneMCContratto_Requ