                                    <bpws:reply name="Reply"
                                    operation="get"
                                    partnerLink="verificaslabaseperontoperatore"
                                    portType="ns:verificaslabaseperontoperatore"
                                    tibex:xpdlId="8e8f837c-81fa-4d56-a6d6-435f2e5b0cc9" variable="Reply-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20251103163702PLT" xmlns:tns3="http://www.example.org/VerificaSLABaseperONTOperatore" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns2:getResponse&gt;
            &lt;item&gt;
                &lt;tns3:outputVerificaSLABaseperONTOperatore&gt;
                    &lt;tns3:result&gt;
                        &lt;tns3:severity&gt;
                            &lt;xsl:value-of select="'ERROR'"/&gt;
                        &lt;/tns3:severity&gt;
                        &lt;tns3:code&gt;
                            &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                        &lt;/tns3:code&gt;
                        &lt;tns3:details&gt;
                            &lt;xsl:value-of select="$FaultDetails/Msg"/&gt;
                        &lt;/tns3:details&gt;
                    &lt;/tns3:result&gt;
                &lt;/tns3:outputVerificaSLABaseperONTOperatore&gt;
            &lt;/item&gt;
        &lt;/tns2:getResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
