                                partnerLink="BPM_CheckPortType"
                                portType="ns1:BPM_CheckPortType" tibex:xpdlId="d7d50900-aaf9-4a11-b9cb-3118e6ff66c2">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/concrete/BPM_CheckService/" xmlns:tns4="http://xmlns.example.com/VerificaDAC/parameters" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" xmlns:ns0123="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:tns3="http://tns.tibco.com/bw/REST" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="get1"/&gt;&lt;xsl:param name="RecuperoOfferta"/&gt;&lt;xsl:param name="DRO"/&gt;&lt;xsl:param name="calcoloDRO"/&gt;&lt;xsl:param name="CalcoloGiornoLavorativo"/&gt;&lt;xsl:template name="VerificaDACSLA-input" match="/"&gt;&lt;tns:VerificaDACSLARequest&gt;&lt;parameters&gt;&lt;tns1:VerificaDACSLA&gt;&lt;ns0123:DAC&gt;&lt;xsl:value-of select="xsd:date($get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:dac)"/&gt;&lt;/ns0123:DAC&gt;&lt;xsl:choose&gt;&lt;xsl:when test="tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns2:Response/tns2:outputDate) !=0"&gt;&lt;ns0123:DRO&gt;&lt;xsl:value-of select="$CalcoloGiornoLavorativo/parameters/tns2:Response/tns2:outputDate"/&gt;&lt;/ns0123:DRO&gt;&lt;/xsl:when&gt;&lt;xsl:when test="tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1"&gt;&lt;ns0123:DRO&gt;&lt;xsl:value-of select="xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))"/&gt;&lt;/ns0123:DRO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns0123:DRO&gt;&lt;xsl:value-of select="$DRO/parameters/tns2:Response/tns2:outputDate"/&gt;&lt;/ns0123:DRO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns0123:Lavorazione&gt;&lt;xsl:value-of select="$get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:lavorazione"/&gt;&lt;/ns0123:Lavorazione&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:flagNP='Y' and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:lavorazione != 'VARIAZIONE'"&gt;&lt;ns0123:Servizio&gt;&lt;xsl:value-of select="concat($RecuperoOfferta/Record[1]/NOME_OFFERTA_ESTERNA,'NP')"/&gt;&lt;/ns0123:Servizio&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:flagNP='Y' and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:lavorazione = 'VARIAZIONE' and (($get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:sottolavorazione != 'Trasloco' and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:sottolavorazione !='Decremento NP') or exists($get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:sottolavorazione) = false()) and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:idOfferta = ('2','4','6')"&gt;&lt;ns0123:Servizio&gt;&lt;xsl:value-of select="concat($RecuperoOfferta/Record[1]/NOME_OFFERTA_ESTERNA,'NP')"/&gt;&lt;/ns0123:Servizio&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:lavorazione = 'VARIAZIONE' and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:sottolavorazione = ('Trasloco','Decremento NP') and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:idOfferta = '2'"&gt;&lt;ns0123:Servizio&gt;&lt;xsl:value-of select="&amp;quot;ULLLINEANONATTIVA&amp;quot;"/&gt;&lt;/ns0123:Servizio&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:lavorazione = 'VARIAZIONE' and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:sottolavorazione = ('Trasloco','Decremento NP') and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:idOfferta = '4'"&gt;&lt;ns0123:Servizio&gt;&lt;xsl:value-of select="&amp;quot;ULLDATILINEANONATTIVA&amp;quot;"/&gt;&lt;/ns0123:Servizio&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:lavorazione = 'VARIAZIONE' and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:sottolavorazione = ('Trasloco','Decremento NP') and $get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:idOfferta = '6'"&gt;&lt;ns0123:Servizio&gt;&lt;xsl:value-of select="&amp;quot;SLULINEANONATTIVA&amp;quot;"/&gt;&lt;/ns0123:Servizio&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns0123:Servizio&gt;&lt;xsl:value-of select="$RecuperoOfferta/Record[1]/NOME_OFFERTA_ESTERNA"/&gt;&lt;/ns0123:Servizio&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$get1/httpHeaders/tns3:httpHeaders/GUI-TID"&gt;&lt;ns0123:IDRichiesta&gt;&lt;xsl:value-of select="$get1/httpHeaders/tns3:httpHeaders/GUI-TID"/&gt;&lt;/ns0123:IDRichiesta&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$get1/parameters/tns4:verificadaclavorativoGetParameters/tns4:lavorazione = 'CESSAZIONE' and $RecuperoOfferta/Record[1]/NOME_OFFERTA_ESTERNA = 'ULLLINEAATTIVA'"&gt;&lt;ns0123:SottoLavorazione&gt;&lt;xsl:value-of select="&amp;quot;NORMALE&amp;quot;"/&gt;&lt;/ns0123:SottoLavorazione&gt;&lt;/xsl:if&gt;&lt;/tns1:VerificaDACSLA&gt;&lt;/parameters&gt;&lt;/tns:VerificaDACSLARequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/concrete/BPM_CheckService/&quot; xmlns:tns4=&quot;http://xmlns.example.com/VerificaDAC/parameters&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:ns0123=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns3=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get1.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;get1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaDACSLA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaDACSLA>&#xa;            &lt;ns0123:DAC>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($get1.parameters/tns4:dac)&quot;/>&#xa;            &lt;/ns0123:DAC>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns2:outputDate) !=0&quot;>&#xa;                    &lt;ns0123:DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns2:outputDate&quot;/>&#xa;                    &lt;/ns0123:DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;ns0123:DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/ns0123:DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns0123:DRO>&#xa;                        &lt;xsl:value-of select=&quot;$DRO.parameters/tns2:outputDate&quot;/>&#xa;                    &lt;/ns0123:DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns0123:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$get1.parameters/tns4:lavorazione&quot;/>&#xa;            &lt;/ns0123:Lavorazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$get1.parameters/tns4:flagNP='Y' and $get1.parameters/tns4:lavorazione != 'VARIAZIONE'&quot;>&#xa;                    &lt;ns0123:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;concat($RecuperoOfferta/Record[1]/NOME_OFFERTA_ESTERNA,'NP')&quot;/>&#xa;                    &lt;/ns0123:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get1.parameters/tns4:flagNP='Y' and $get1.parameters/tns4:lavorazione = 'VARIAZIONE' and (($get1.parameters/tns4:sottolavorazione != 'Trasloco' and $get1.parameters/tns4:sottolavorazione !='Decremento NP') or exists($get1.parameters/tns4:sottolavorazione) = false()) and $get1.parameters/tns4:idOfferta = ('2','4','6')&quot;>&#xa;                    &lt;ns0123:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;concat($RecuperoOfferta/Record[1]/NOME_OFFERTA_ESTERNA,'NP')&quot;/>&#xa;                    &lt;/ns0123:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get1.parameters/tns4:lavorazione = 'VARIAZIONE' and $get1.parameters/tns4:sottolavorazione = ('Trasloco','Decremento NP') and $get1.parameters/tns4:idOfferta = '2'&quot;>&#xa;                    &lt;ns0123:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/ns0123:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get1.parameters/tns4:lavorazione = 'VARIAZIONE' and $get1.parameters/tns4:sottolavorazione = ('Trasloco','Decremento NP') and $get1.parameters/tns4:idOfferta = '4'&quot;>&#xa;                    &lt;ns0123:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEANONATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/ns0123:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$get1.parameters/tns4:lavorazione = 'VARIAZIONE' and $get1.parameters/tns4:sottolavorazione = ('Trasloco','Decremento NP') and $get1.parameters/tns4:idOfferta = '6'&quot;>&#xa;                    &lt;ns0123:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SLULINEANONATTIVA&amp;quot;&quot;/>&#xa;                    &lt;/ns0123:Servizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns0123:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoOfferta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&#xa;                    &lt;/ns0123:Servizio>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$get1.httpHeaders/GUI-TID&quot;>&#xa;                &lt;ns0123:IDRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$get1.httpHeaders/GUI-TID&quot;/>&#xa;                &lt;/ns0123:IDRichiesta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$get1.parameters/tns4:lavorazione = 'CESSAZIONE' and $RecuperoOfferta/Record[1]/NOME_OFFERTA_ESTERNA = 'ULLLINEAATTIVA'&quot;>&#xa;                &lt;ns0123:SottoLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NORMALE&amp;quot;&quot;/>&#xa;                &lt;/ns0123:SottoLavorazione>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:VerificaDACSLA>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="InvokeToVerificaDACSLA"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="VerificaDACSLAToget_VerificaDacSLA_outp_Log"/>
                                </bpws:sources>
                                <bpws:correlations/>
                            </bpws:invoke>
                            <bpws:invoke
                                inputVariable="CalcoloGiornoLavorativo-input"
                                name="CalcoloGiornoLavorativo"
                                operation="calcNextDateByDuration"
                                outputVariable="CalcoloGiornoLavorativo"
                                partnerLink="GetNextDatePortType"
                                portType="ns7:GetNextDatePortType" tibex:xpdlId="b222fb7c-5080-467d-936c-831af9a6b8fe">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:template name="CalcoloGiornoLavorativo-input" match="/"&gt;&lt;ns:calcNextDateByDurationRequest&gt;&lt;parameters&gt;&lt;tns:Request&gt;&lt;tns:inputDate&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/tns:inputDate&gt;&lt;tns:inputDuration&gt;&lt;xsl:value-of select="'PT9H'"/&gt;&lt;/tns:inputDuration&gt;&lt;/tns:Request&gt;&lt;/parameters&gt;&lt;/ns:calcNextDateByDurationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;CalcoloGiornoLavorativo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;tns:inputDate>&#xa;                &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;            &lt;/tns:inputDate>&#xa;            &lt;tns:inputDuration>&#xa;                &lt;xsl:value-of select=&quot;'PT9H'&quot;/>&#xa;            &lt;/tns:inputDuration>&#xa;        &lt;/tns:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="DROToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeToVerificaDACSLA"/>
                                </bpws:sources>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
