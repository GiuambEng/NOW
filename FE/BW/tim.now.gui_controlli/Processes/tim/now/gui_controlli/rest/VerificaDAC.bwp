                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20160427154306PLT&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/VerificaDAC&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaDACLavorativo.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaDacLavorativoOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:verificaDacLavSlaOutput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$VerificaDACLavorativo.parameters/Esito/Codice = true()&quot;>&#xa;                    &lt;ns1:esito>&#xa;                        &lt;ns1:codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                        &lt;/ns1:codice>&#xa;                        &lt;ns1:descrizione>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaDACLavorativo.parameters/Esito/Descrizione&quot;/>&#xa;                        &lt;/ns1:descrizione>&#xa;                    &lt;/ns1:esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns1:esito>&#xa;                        &lt;ns1:codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                        &lt;/ns1:codice>&#xa;                        &lt;ns1:descrizione>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaDACLavorativo.parameters/Esito/Descrizione&quot;/>&#xa;                        &lt;/ns1:descrizione>&#xa;                    &lt;/ns1:esito>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns1:result>&#xa;                &lt;ns1:severity>&#xa;                    &lt;xsl:value-of select=