&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns="http://www.tim.com/NOW/xsd/GetNextDate" version="2.0"&gt;&lt;xsl:template name="DRO-input" match="/"&gt;&lt;ns:calcNextWorkingDateRequest&gt;&lt;parameters&gt;&lt;tns:CalcRequest&gt;&lt;tns:inputDate&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/tns:inputDate&gt;&lt;/tns:CalcRequest&gt;&lt;/parameters&gt;&lt;/ns:calcNextWorkingDateRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
