                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[if (count($post.item/tns:codVLAN)>0) then $index<=count($post.item/tns:codVLAN) and $Variable =true() else $index<=count($post.item/tns:codSVLAN) and $Variable =true()]]></bpws:condition>
