                                wsdlLocation="platform:/resource/tim.now.gui_controlli/Service%20Descriptors/BPM_CheckService_gen.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
                                    action="RecuperaControlli" operationName="RecuperaControlli">
                                    <bindingType style="DOCUMENT"/>
