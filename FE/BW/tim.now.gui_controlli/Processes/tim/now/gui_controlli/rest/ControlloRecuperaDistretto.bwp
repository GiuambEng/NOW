                                portTypeQName="pt:BPM_CheckPortType"
                                portTypeWSDLLocation="platform:/resource/tim.now.gui_controlli/Service%20Descriptors/BPM_CheckService_gen.wsdl"
                                serviceBindingQName="pt:CheckServce_SOAPService"
                                serviceQName="pt:BPM_CheckPortType"
