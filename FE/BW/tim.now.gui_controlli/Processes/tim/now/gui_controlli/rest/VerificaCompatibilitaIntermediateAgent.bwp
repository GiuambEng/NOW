                                    <bpws:transitionCondition><![CDATA[(upper-case($post.item/ns2:lavorazione) = "ATTIVAZIONE") or (upper-case($post.item/ns2:lavorazione) = "MIGRAZIONE")]]></bpws:transitionCondition>
