                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idTicketTTM"/>
                                    <columnMetadata
                                    columnName="NUM_RECORD"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
