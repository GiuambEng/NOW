                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*) AS NUM_RECORD&#xa;FROM BDS_1_CASEDATA_ASSET A INNER JOIN BDS_1_CASEDATA_ORDINE O ON O.CODICEORDINETI = A.CODICEORDINETI&#xa;INNER JOIN BDS_1_CASEDATA_RICHIESTA R ON O.IDRICHIESTAOLO = R.IDRICHIESTAOLO&#xa;WHERE (O.CODICETTM = ?) AND (R.LAVORAZIONE = 'VARIAZIONE') AND (R.STATORICHIESTANOW NOT IN ('SCARTATO','ANNULLATO')) &#xa;AND (R.IDOFFERTA IN ('15','17','44'))" xsi:type="jdbcPalette:JDBCQueryActivity">

