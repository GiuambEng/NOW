                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b9e35b3a-6ee9-4a82-a797-43dc139b8f6e+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VerificaModelloKit/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;KitMAdR-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;codiceTdKit>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:verificamodellokitmadrGetParameters/tns1:codiceTdKit)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:verificamodellokitmadrGetParameters/tns1:codiceTdKit&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codiceTdKit>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
