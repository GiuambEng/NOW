                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20201113101139PLT&quot; xmlns:tns1=&quot;http://www.example.org/VerificaModelloKit&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;postOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:outputVerificaModelloKit>&#xa;            &lt;xsl:copy-of select=&quot;$Variable/tns1:outputModelloKit&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$Variable/tns1:result&quot;/>&#xa;        &lt;/tns1:outputVerificaModelloKit>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
