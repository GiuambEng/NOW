ity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:outputVerificaMigrazioneFTTHExDel611>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:outputVerificaMigrazioneFTTHExDel611>&#xa;                    &lt;tns1:esito>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns1:esito>&#xa;                    &lt;tns1:result>&#xa;                        &lt;tns1:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns1:severity>&#xa;                        &lt;tns1:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns1:code>&#xa;                    &lt;/tns1:result>&#xa;                &lt;/tns1:outputVerificaMigrazioneFTTHExDel611>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
