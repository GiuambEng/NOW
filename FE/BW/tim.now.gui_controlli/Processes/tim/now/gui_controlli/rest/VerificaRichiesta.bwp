se>&#xa;                        &lt;xsl:when test=&quot;string-length(string($getPrcAppuntamento/Record[1]/DADRIMODULATA))>0&quot;>&#xa;                            &lt;ns0123:data_appuntamento_precedente>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, concat(substring(substring-before(string($getPrcAppuntamento/Record[1]/DADRIMODULATA), &amp;quot;T&amp;quot;),9,2),&amp;quot;/&amp;quot;,substring(substring-before(string($getPrcAppuntamento/Record[1]/DADRIMODULATA), &amp;quot;T&amp;quot;),6,2),&amp;quot;/&amp;quot;,substring(substring-before(string($getPrcAppuntamento/Record[1]/DADRIMODULATA), &amp;quot;T&amp;quot;),1,4)))&quot;/>&#xa;                            &lt;/ns0123:data_appuntamento_precedente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns0123:data_appuntamento_precedente>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date(substring-before(string($getPrcAppuntamento/Record[1]/DAD), &amp;quot;T&amp;quot;))&quot;/>&#xa;                            &lt;/ns0123:data_appuntamento_precedente>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($getPrcAppuntamento/Record[NOMEATTRIBUTO='DATAAPPUNTAMENTO']/VALOREATTRIBUTO, &amp;quot;/&amp;quot;)&quot;>&#xa;                    &lt;ns0123:data_appuntamento_precedente>&#xa;                        &lt;xsl:value-of select=&quot;tib:create-date(xsd:integer(substring($getPrcAppuntamento/Record[NOMEATTRIBUTO='DATAAPPUNTAMENTO']/VALOREATTRIBUTO,7,4)),xsd:integer(substring($getPrcAppuntamento/Record[NOMEATTRIBUTO='DATAAPPUNTAMENTO']/VALOREATTRIBUTO,4,2)),xsd:integer(substring($getPrcAppuntamento/Record[NOMEATTRIBUTO='DATAAPPUNTAMENTO']/VALOREATTRIBUTO,1,2)))&quot;/>&#xa;                    &lt;/ns0123:data_appuntamento_precedente>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns0123:data_appuntamento_precedente>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($getPrcAppuntamento/Record[NOMEATTRIBUTO='DATAAPPUNTAMENTO']/VALOREATTRIBUTO)&quot;/>&#xa;                    &lt;/ns0123:data_appuntamento_precedente>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns0123:DAD>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($get.parameters/tns:DAD)&quot;/>&#xa;            &lt;/ns0123:DAD>&#xa;            &lt;ns0123:fascia_oraria>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns:FasciaOraria&quot;/>&#xa;            &lt;/ns0123:fascia_oraria>&#xa;            &lt;xsl:if test=&quot;$get.httpHeaders/GUI-TID&quot;>&#xa;                &lt;ns0123:IDRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$get.httpHeaders/GUI-TID&quot;/>&#xa;                &lt;/ns0123:IDRichiesta>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns0123:DATA_INVIO>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/ns0123:DATA_INVIO>&#xa;        &lt;/ns0123:Verifica_DAD_Per_Rimodulazione_DA_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
