                                    sqlStatement="SELECT COUNT(*)&#xa;  FROM BDS_1_CASEDATA_RICHIESTA&#xa;  WHERE CODICECAUSALEINTERNO = 'W50_D_SOSP_W15' &#xa;  AND CODICEORDINETI = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
