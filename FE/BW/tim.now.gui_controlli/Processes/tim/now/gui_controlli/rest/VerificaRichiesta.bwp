                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select r.disaggregato, ado.valoreattributo as ownerpresaappuntamento, r.idofferta&#xa;from bds_1_casedata_richiesta r&#xa;left join bds_1_casedata_attribtdttglrdn ado on ado.idrichiestaolo = r.idrichiestaolo&#xa;where r.codiceordineti = ? and ado.nomeattributo = 'OWNERPRESAAPPUNTAMENTO'&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codiceOrdineTI"/>
                                    <columnMetadata
                                    columnName="DISAGGREGATO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OWNERPRESAAPPUNTAMENTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDOFFERTA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fb07b729-fd2d-4c8f-9275-1501e3e2133b+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VerificaRichiesta/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;CheckCausale-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;codOrdineTI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:verificarichiesta3GetParameters/tns1:OrdineTIRichiestaOlo)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:verificarichiesta3GetParameters/tns1:OrdineTIRichiestaOlo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOrdineTI>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CheckCausale-input"
