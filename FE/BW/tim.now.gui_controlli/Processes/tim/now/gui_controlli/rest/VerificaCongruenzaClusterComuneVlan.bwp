                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoSedeOldToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($RecuperoSedeOld/Record[1]/CODICEISTATCOMUNE)>0 or string-length($post/item/ns2:inputVerificaCongruenzaClusterComuneVlan/ns2:codiceIstatComune)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($RecuperoSedeOld/Record[1]/CODICEISTATCOMUNE)>0 or string-length($post.item/ns2:codiceIstatComune)>0]]></bpws:transitionCondition>
                                    </bpws:source>
