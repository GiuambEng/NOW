                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT S.CODICEISTATCOMUNE&#xa;  FROM BDS_1_CASEDATA_SEDE S &#xa;  WHERE S.IDRICHIESTAOLO = &#xa;  &#x9;&#x9;&#x9;(SELECT IDRICHIESTAOLO&#xa;  &#x9;&#x9;&#x9;FROM BDS_1_CASEDATA_ASSET&#xa;  &#x9;&#x9;&#x9;WHERE IDASSET=?) AND S.TIPOLOGIASEDE = 'SEDECLIENTEOLD'" xsi:type="jdbcPalette:JDBCQueryActivity">

