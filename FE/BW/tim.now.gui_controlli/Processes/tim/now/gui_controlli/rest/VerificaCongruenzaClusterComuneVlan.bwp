                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c6364fa0-2468-47c1-ba8f-d5230fad88b5+input&quot; xmlns:tns1=&quot;http://www.example.org/VerificaCongruenzaClusterComuneVlan&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:template name=&quot;CodiceComune-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;provincia>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoClienteFinale/tns1:provincia)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoClienteFinale/tns1:provincia&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/provincia>&#xa;            &lt;comune>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoClienteFinale/tns1:comune)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoClienteFinale/tns1:comune&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/comune>&#xa;            &lt;partToponomastica>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoClienteFinale/tns1:partToponomastica)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoClienteFinale/tns1:partToponomastica&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/partToponomastica>&#xa;            &lt;indirizzo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoClienteFinale/tns1:indirizzo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoClienteFinale/tns1:indirizzo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/indirizzo>&#xa;            &lt;civico>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns1:indirizzoClienteFinale/tns1:civico)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns1:indirizzoClienteFinale/tns1:civico&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/civico>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT P.COD_ISTAT_PROV, C.COD_ISTAT_COMUNE, PA.COD_PARTICELLA_TOPON, N.COD_TOPON&#xa;FROM PROV P, COMUNE_O_LOCALITA C, PARTICELLA PA, VIA V , NUMERO_CIVICO N&#xa;WHERE P.COD_ISTAT_PROV = C.COD_ISTAT_PROV &#xa;AND C.COD_ISTAT_COMUNE = V.COD_ISTAT_COMUNE &#xa;AND V.COD_PARTICELLA_TOPON = PA.COD_PARTICELLA_TOPON &#xa;AND V.COD_STRADA = N.COD_STRADA &#xa;AND upper(TRIM(P.DESCR_PROV)) = upper(?) &#xa;AND upper(TRIM(C.DESCR_COMUNE))=upper(?) &#xa;AND upper(TRIM(PA.DESCR_PARTICELLA_TOPON))=upper(?) &#xa;AND upper(TRIM(V.DESCR_VIA))=upper(?)&#xa;AND upper(TRIM(N.NUMERO_CIVICO)) = upper(?)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="provincia"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="comune"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="partToponomastica"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="indirizzo"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="civico"/>
                                    <columnMetadata
                                    columnName="COD_ISTAT_PROV"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_ISTAT_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_PARTICELLA_TOPON"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_TOPON"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+de3de949-0562-4aaa-8822-5808162dafc1+input&quot; xmlns:tns1=&quot;http://www.example.org/VerificaCongruenzaClusterComuneVlan&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;RecuperoSedeOld-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:inputVerificaCongruenzaClusterComuneVlan/tns1:idAsset)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:inputVerificaCongruenzaClusterComuneVlan/tns1:idAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idAsset>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
