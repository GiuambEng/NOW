                                    tibex:group="groupStart"
                                    tibex:xpdlId="f1d1b4a2-9713-4fff-949c-ed61a0a88d45" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToIterate1"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($post.item/tns:vc)[number($indexInput)]]]></bpws:from>
