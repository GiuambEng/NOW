                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="QueryMapper-input"
                                    name="QueryMapper"
                                    outputVariable="QueryMapper"
                                    tibex:xpdlId="6171ebd1-d350-4930-a567-b0f860f1e026" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="GroupStart1ToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>

                                    <bpws:source linkName="MapperToAccumulate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/verificaVPFlatAttestazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElementInput&quot;/>&lt;xsl:param name=&quot;currentElementQuery&quot;/>&lt;xsl:template name=&quot;QueryMapper-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$currentElementQuery/column[name='COD_VP']/value=$currentElementInput/tns:vpCode&quot;>&lt;tns:verificaVPFlatAttestazioneRequest>&lt;tns:VC_VerificaVPFLATAttestazione>&lt;xsl:if test=&quot;$currentElementInput/tns:idVc&quot;>&lt;tns:IdVC>&lt;xsl:value-of select=&quot;$currentElementInput/tns:idVc&quot;/>&lt;/tns:IdVC>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElementInput/tns:vpCode&quot;>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;$currentElementInput/tns:vpCode&quot;/>&lt;/tns:VPCode>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElementInput/tns:tipoBanda&quot;>&lt;tns:TipoBanda>&lt;xsl:value-of select=&quot;$currentElementInput/tns:tipoBanda&quot;/>&lt;/tns:TipoBanda>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($currentElementQuery/column[name='MODALITA_FATTURAZIONE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElementQuery/column[name='MODALITA_FATTURAZIONE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElementQuery/column[name='MODALITA_FATTURAZIONE']/value)&quot;>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;$currentElementQuery/column[name='MODALITA_FATTURAZIONE']/value&quot;/>&lt;/tns:ModalitaFatturazione>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($currentElementQuery/column[name='TIPO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElementQuery/column[name='TIPO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElementQuery/column[name='TIPO']/value)&quot;>&lt;tns:TIPO>&lt;xsl:value-of select=&quot;$currentElementQuery/column[name='TIPO']/value&quot;/>&lt;/tns:TIPO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($currentElementQuery/column[name='BANDA_MCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElementQuery/column[name='BANDA_MCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElementQuery/column[name='BANDA_MCR']/value)&quot;>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;$currentElementQuery/column[name='BANDA_MCR']/value&quot;/>&lt;/tns:BandaMCR>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($currentElementQuery/column[name='BANDA_PCR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($currentElementQuery/column[name='BANDA_PCR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($currentElementQuery/column[name='BANDA_PCR']/value)&quot;>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;$currentElementQuery/column[name='BANDA_PCR']/value&quot;/>&lt;/tns:BandaPCR>&lt;/xsl:if>&lt;/tns:VC_VerificaVPFLATAttestazione>&lt;/tns:verificaVPFlatAttestazioneRequest>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:verificaVPFlatAttestazioneRequest>&lt;tns:VC_VerificaVPFLATAttestazione>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;'NULL'&quot;/>&lt;/tns:VPCode>&lt;/tns:VC_VerificaVPFLATAttestazione>&lt;/tns:verificaVPFlatAttestazioneRequest>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:verificaVPFlatAttestazione="http://www.tim.com/NOW/rest/verificaVPFlatAttestazione" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>

                                    <value
                                    inputQName="verificaVPFlatAttestazione:verificaVPFlatAttestazioneRequest" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:forEach>
                                    </bpws:sequence>
                                    </bpws:scope>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="FinalMapper-input"
                                    name="FinalMapper"
                                    outputVariable="FinalMapper"
                                    tibex:xpdlId="b9ed1319-b818-4f62-8386-5f17bdf9e3b2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="IterateQueryToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToAccumulateFinal"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/verificaVPFlatAttestazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryAccumulate&quot;/>&lt;xsl:template name=&quot;FinalMapper-input&quot; match=&quot;/&quot;>&lt;tns:verificaVPFlatAttestazioneRequest>&lt;xsl:for-each select=&quot;$QueryAccumulate/tns:verificaVPFlatAttestazioneRequest/tns:VC_VerificaVPFLATAttestazione&quot;>&lt;xsl:if test=&quot;current()/tns:VPCode!='NULL'&quot;>&lt;tns:VC_VerificaVPFLATAttestazione>&lt;xsl:if test=&quot;tns:IdVC&quot;>&lt;tns:IdVC>&lt;xsl:value-of select=&quot;tns:IdVC&quot;/>&lt;/tns:IdVC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Azione&quot;>&lt;tns:Azione>&lt;xsl:value-of select=&quot;tns:Azione&quot;/>&lt;/tns:Azione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:VPCode&quot;>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;tns:VPCode&quot;/>&lt;/tns:VPCode>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TipoBanda&quot;>&lt;tns:TipoBanda>&lt;xsl:value-of select=&quot;tns:TipoBanda&quot;/>&lt;/tns:TipoBanda>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ModalitaFatturazione&quot;>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;tns:ModalitaFatturazione&quot;/>&lt;/tns:ModalitaFatturazione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TIPO&quot;>&lt;tns:TIPO>&lt;xsl:value-of select=&quot;tns:TIPO&quot;/>&lt;/tns:TIPO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:BandaMCR&quot;>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;tns:BandaMCR&quot;/>&lt;/tns:BandaMCR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:BandaPCR&quot;>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;tns:BandaPCR&quot;/>&lt;/tns:BandaPCR>&lt;/xsl:if>&lt;/tns:VC_VerificaVPFLATAttestazione>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:verificaVPFlatAttestazioneRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:verificaVPFlatAttestazione="http://www.tim.com/NOW/rest/verificaVPFlatAttestazione" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>

                                    <value
                                    inputQName="verificaVPFlatAttestazione:verificaVPFlatAttestazioneRequest" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:forEach>
                                </bpws:sequence>
                            </bpws:scope>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
