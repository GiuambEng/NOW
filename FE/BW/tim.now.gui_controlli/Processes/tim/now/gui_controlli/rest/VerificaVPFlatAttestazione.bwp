                                    tibex:xpdlId="e40a9540-1339-4be2-98d2-9afc98096548" variable="ReplayVerificaVPFlatAttestazioneLog_Error-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20170227172502PLT" xmlns:tns="http://www.tim.com/NOW/rest/verificaVPFlatAttestazione" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="ReplayVerificaVPFlatAttestazioneLog_Error-input" match="/"&gt;
        &lt;tns2:postResponse&gt;
            &lt;item&gt;
                &lt;tns:outputVerificaVPFlatAttestazione&gt;
                    &lt;tns:result&gt;
                        &lt;tns:severity&gt;
