                        &lt;/tns:details&gt;
                    &lt;/tns:result&gt;
                &lt;/tns:outputVerificaVPFlatAttestazione&gt;
            &lt;/item&gt;
        &lt;/tns2:postResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
