                                    outputVariable="AccumulateFinal"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="584a31f6-44bf-4946-b70b-acf80f97b301" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToAccumulateFinal"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>

                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>FinalMapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:scope
                                    name="IterateQuery"
                                    tibex:group="iterate" tibex:xpdlId="a2c4b4c0-c843-4d84-b735-da9203e219b3">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToIterate1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="IterateQueryToMapper"/>
                                    </bpws:sources>
                                    <bpws:sequence
                                    name="sequence1" tibex:group="iterate">
                                    <bpws:assign
                                    name="GroupInit1"
                                    tibex:group="groupInit"
                                    tibex:xpdlId="80013a9c-8a11-4c87-b71a-59b7cb8c0e22" validate="no">
                                    <bpws:copy>

                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+b6448c2a-9ef6-47b0-b07c-b0cbde7fb5c8" version="2.0"> <xsl:template name="QueryAccumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="QueryAccumulate"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:forEach
                                    counterName="indexQuery"
                                    name="iterate1"
                                    parallel="no" tibex:group="iterate">

                                    <tibex:DesignExpression name="variableList">

                                    <tibex:expression
                                    expression="$SQLDirect/unknownResultset/row" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>

                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($SQLDirect/unknownResultset/row)]]></bpws:finalCounterValue>
                                    <bpws:scope name="innerScope1">
