                            </bpws:extensionActivity>
                            <bpws:scope name="IterateInput"
                                tibex:group="iterate" tibex:xpdlId="88e3aefe-3e01-45fe-9292-97e1e08aac17">
                                <bpws:targets>
                                    <bpws:target linkName="SQLDirectToIterate_VPtrovato"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="IterateInputToVerificaVPFLATAttestazione"/>
                                </bpws:sources>
                                <bpws:sequence name="sequence" tibex:group="iterate">
                                    <bpws:assign name="GroupInit"
                                    tibex:group="groupInit"
                                    tibex:xpdlId="5c12ad31-cc53-48e7-94e4-a575ba3a4b7d" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+584a31f6-44bf-4946-b70b-acf80f97b301" version="2.0"> <xsl:template name="AccumulateFinal" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="AccumulateFinal"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:forEach
                                    counterName="indexInput"
                                    name="iterate" parallel="no" tibex:group="iterate">
                                    <tibex:DesignExpression name="variableList">
                                    <tibex:expression
                                    expression="$post/item/tns:inputVerificaVPFlatAttestazione/tns:vc" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($post.item/tns:vc)]]></bpws:finalCounterValue>
                                    <bpws:scope name="innerScope">
                                    <bpws:variables>
                                    <bpws:variable
                                    element="tns:IterateInput_Current_Element_vc"
                                    name="currentElementInput" sca-bpel:internal="true"/>
                                    </bpws:variables>
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStartToIterate1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="IterateQueryToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MapperToAccumulateFinal" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
