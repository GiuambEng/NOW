yload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerMsg&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;            &lt;tns3:ActiveLoggerServices>&#xa;                &lt;tns3:Envelope>&#xa;                    &lt;tns3:Identifier>&#xa;                        &lt;tns3:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_controlli.VerificaVPFlatAttestazione&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ServiceName>&#xa;                        &lt;tns3:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;SELECT&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Operation>&#xa;                        &lt;tns3:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns3:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns3:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,'_',$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns3:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns3:CorrelationID>&#xa;                                &lt;xsl:value-of