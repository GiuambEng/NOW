                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/concrete/BPM_CheckServiceDati/" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="http://www.tim.com/NOW/rest/verificaVPFlatAttestazione" xmlns:tns3="http://tns.tibco.com/bw/REST" version="2.0"&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="AccumulateFinal"/&gt;
    &lt;xsl:template name="VerificaVPFLATAttestazione-input" match="/"&gt;
        &lt;tns4:VerificaVPFLATAttestazioneRequest&gt;
            &lt;input&gt;
                &lt;tns1:VerificaVPFLATAttestazioneRequest&gt;
                    &lt;xsl:if test="$post/httpHeaders/tns3:httpHeaders/GUI-TID"&gt;
                        &lt;tns1:IDRichiestaOLO&gt;
                            &lt;xsl:value-of select="$post/httpHeaders/tns3:httpHeaders/GUI-TID"/&gt;
                        &lt;/tns1:IDRichiestaOLO&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns1:Lavorazione&gt;
                        &lt;xsl:value-of select="&amp;quot;ATTIVAZIONE&amp;quot;"/&gt;
                    &lt;/tns1:Lavorazione&gt;
                    &lt;xsl:for-each select="$AccumulateFinal/tns:verificaVPFlatAttestazioneRequest/tns:VC_VerificaVPFLATAttestazione"&gt;
                        &lt;tns1:VC_VerificaVPFLATAttestazione&gt;
                            &lt;xsl:if test="tns:IdVC"&gt;
                                &lt;tns1:IdVC&gt;
                                    &lt;xsl:value-of select="tns:IdVC"/&gt;
                                &lt;/tns1:IdVC&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:Azione"&gt;
                                &lt;tns1:Azione&gt;
                                    &lt;xsl:value-of select="tns:Azione"/&gt;
                                &lt;/tns1:Azione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:VPCode"&gt;
                                &lt;tns1:VPCode&gt;
                                    &lt;xsl:value-of select="tns:VPCode"/&gt;
                                &lt;/tns1:VPCode&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:TipoBanda"&gt;
                                &lt;tns1:TipoBanda&gt;
                                    &lt;xsl:value-of select="tns:TipoBanda"/&gt;
                                &lt;/tns1:TipoBanda&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:ModalitaFatturazione"&gt;
                                &lt;tns1:ModalitaFatturazione&gt;
                                    &lt;xsl:value-of select="tns:ModalitaFatturazione"/&gt;
                                &lt;/tns1:ModalitaFatturazione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:TIPO"&gt;
                                &lt;tns1:TIPO&gt;
                                    &lt;xsl:value-of select="tns:TIPO"/&gt;
                                &lt;/tns1:TIPO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:BandaMCR"&gt;
                                &lt;tns1:BandaMCR&gt;
                                    &lt;xsl:value-of select="tns:BandaMCR"/&gt;
                                &lt;/tns1:BandaMCR&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns:BandaPCR"&gt;
                                &lt;tns1:BandaPCR&gt;
                                    &lt;xsl:value-of select="tns:BandaPCR"/&gt;
                                &lt;/tns1:BandaPCR&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns1:VC_VerificaVPFLATAttestazione&gt;
                    &lt;/xsl:for-each&gt;
                &lt;/tns1:VerificaVPFLATAttestazioneRequest&gt;
            &lt;/input&gt;
        &lt;/tns4:VerificaVPFLATAttestazioneRequest&gt;
    &lt;/xsl:template&gt;
