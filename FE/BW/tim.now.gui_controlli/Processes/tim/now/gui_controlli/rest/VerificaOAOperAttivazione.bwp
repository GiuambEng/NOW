                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/verificaOAOperAttivazione&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:tns2=&quot;http://xmlns.example.com/VerificaOAOperAttivazione/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OloInvoke&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:param name=&quot;RecuperoCodOloDaContratto&quot;/>&lt;xsl:template name=&quot;VerficaOAO&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$OloInvoke/output/tns1:isOloAccorpanteOutput/tns1:flagAccorpante='N' and string-length($OloInvoke/output/tns1:isOloAccorpanteOutput/tns1:codOloAccorpante)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns2:verificaoaoperattivazione2GetParameters/tns2:offerta = ('1','3','5','2','4','6','21','22','23','24','25','26','27','28','29')&quot;>&lt;tns:outputVerificaOAOperAttivazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;OAO scelto non può effettuare ordini sull’offerta selezionata&amp;quot;&quot;/>&lt;/tns:message>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaOAOperAttivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVerificaOAOperAttivazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Attivazioni offerte Dati o FWA, permesse agli OAO Accorpati&amp;quot;&quot;/>&lt;/tns:message>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaOAOperAttivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$OloInvoke/output/tns1:isOloAccorpanteOutput/tns1:flagAccorpante='Y'&quot;>&lt;tns:outputVerificaOAOperAttivazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;OAO accorpante può fare qualsiasi ordine di attivazione Regolatorio, Dati e FWA&amp;quot;&quot;/>&lt;/tns:message>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaOAOperAttivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns2:verificaoaoperattivazione2GetParameters/tns2:offerta = ('1','3','5')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$get/parameters/tns2:verificaoaoperattivazione2GetParameters/tns2:codOloAgcom != $RecuperoCodOloDaContratto/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns:outputVerificaOAOperAttivazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;L'OAO non è coerente con il contratto selezionato&amp;quot;&quot;/>&lt;/tns:message>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaOAOperAttivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVerificaOAOperAttivazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;L'OAO selezionato è coerente con il contratto selezionato&amp;quot;&quot;/>&lt;/tns:message>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaOAOperAttivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVerificaOAOperAttivazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaOAOperAttivazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VerficaOAO"
