                                    <bpws:source linkName="AssignTogetOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/verificaOAOperAttivazione&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/cmf/cliente&quot; xmlns:tns2=&quot;http://xmlns.example.com/VerificaOAOperAttivazione/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;OloInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoCodOloDaContratto&quot;/>&#xa;    &lt;xsl:template name=&quot;VerficaOAO&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$OloInvoke.output/tns1:flagAccorpante='N' and string-length($OloInvoke.output/tns1:codOloAccorpante)>0&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$get.parameters/tns2:offerta = ('1','3','5','2','4','6','21','22','23','24','25','26','27','28','29')&quot;>&#xa;                        &lt;tns:outputVerificaOAOperAttivazione>&#xa;                            &lt;tns:esito>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                            &lt;/tns:esito>&#xa;                            &lt;tns:message>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OAO scelto non può effettuare ordini sull’offerta selezionata&amp;quot;&quot;/>&#xa;                            &lt;/tns:message>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaOAOperAttivazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:outputVerificaOAOperAttivazione>&#xa;                            &lt;tns:esito>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns:esito>&#xa;                            &lt;tns:message>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Attivazioni offerte Dati o FWA, permesse agli OAO Accorpati&amp;quot;&quot;/>&#xa;                            &lt;/tns:message>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaOAOperAttivazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$OloInvoke.output/tns1:flagAccorpante='Y'&quot;>&#xa;                &lt;tns:outputVerificaOAOperAttivazione>&#xa;                    &lt;tns:esito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:esito>&#xa;                    &lt;tns:message>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OAO accorpante può fare qualsiasi ordine di attivazione Regolatorio, Dati e FWA&amp;quot;&quot;/>&#xa;                    &lt;/tns:message>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:outputVerificaOAOperAttivazione>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$get.parameters/tns2:offerta = ('1','3','5')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$get.parameters/tns2:codOloAgcom != $RecuperoCodOloDaContratto/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                                &lt;tns:outputVerificaOAOperAttivazione>&#xa;                                    &lt;tns:esito>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                    &lt;/tns:esito>&#xa;                                    &lt;tns:message>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;L'OAO non è coerente con il contratto selezionato&amp;quot;&quot;/>&#xa;                                    &lt;/tns:message>&#xa;                                    &lt;tns:result>&#xa;                                        &lt;tns:severity>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                        &lt;/tns:severity>&#xa;                                        &lt;tns:code>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                        &lt;/tns:code>&#xa;                                    &lt;/tns:result>&#xa;                                &lt;/tns:outputVerificaOAOperAttivazione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:outputVerificaOAOperAttivazione>&#xa;                                    &lt;tns:esito>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                    &lt;/tns:esito>&#xa;                                    &lt;tns:message>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;L'OAO selezionato è coerente con il contratto selezionato&amp;quot;&quot;/>&#xa;                                    &lt;/tns:message>&#xa;                                    &lt;tns:result>&#xa;                                        &lt;tns:severity>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                        &lt;/tns:severity>&#xa;                                        &lt;tns:code>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                        &lt;/tns:code>&#xa;                                    &lt;/tns:result>&#xa;                                &lt;/tns:outputVerificaOAOperAttivazione>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:outputVerificaOAOperAttivazione>&#xa;                            &lt;tns:esito>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns:esito>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaOAOperAttivazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
