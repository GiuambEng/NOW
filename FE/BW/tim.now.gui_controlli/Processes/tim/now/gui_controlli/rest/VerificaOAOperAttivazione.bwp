                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/VerificaOAOperAttivazione/parameters" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/Cliente/" xmlns:tns2="http://www.tim.com/NOW/cmf/cliente" version="2.0"&gt;&lt;xsl:param name="get"/&gt;&lt;xsl:template name="OloInvoke-input" match="/"&gt;&lt;tns1:isOloAccorpanteRequest&gt;&lt;input&gt;&lt;tns2:isOloAccorpanteInput&gt;&lt;tns2:userid&gt;&lt;xsl:value-of select="$get/parameters/tns:verificaoaoperattivazione2GetParameters/tns:codOloAgcom"/&gt;&lt;/tns2:userid&gt;&lt;/tns2:isOloAccorpanteInput&gt;&lt;/input&gt;&lt;/tns1:isOloAccorpanteRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
