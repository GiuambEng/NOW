                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*) as conteggio&#xa;FROM BDS_1_CASEDATA_ASSET&#xa;WHERE IDRISORSA=? and statoasset in ('ATTIVO','INLAVORAZIONE') and codificaoloagcom=? &#xa;and idrisorsacorrelato is null and offerta in('EASYIPNGAFTTH', 'SEMIVULAFTTH', 'SEMIBITSTREAMNGAFTTH', 'SEMIEASYIPNGAFTTH', 'VULAFTTH', 'BITSTREAMNGAFTTH', 'FULLGPONPLUS', 'FULLGOPONPLUSNGA')" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRisorsa"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="CONTEGGIO"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8cefaed4-b4bc-4cbd-9f03-836fe1644909+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VerificaRichiestadiAttivazioneFTTH/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($get/parameters/tns1:verificarichiestadiattivazioneftthGetParameters/tns1:idRIsorsaOLD,2,1)=('2','6')&quot;>&lt;idRisorsa>&lt;xsl:value-of select=&quot;concat('0',$get/parameters/tns1:verificarichiestadiattivazioneftthGetParameters/tns1:idRIsorsaOLD)&quot;/>&lt;/idRisorsa>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($get/parameters/tns1:verificarichiestadiattivazioneftthGetParameters/tns1:idRIsorsaOLD,3,1)=('0','1','5','9')&quot;>&lt;idRisorsa>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:verificarichiestadiattivazioneftthGetParameters/tns1:idRIsorsaOLD)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:verificarichiestadiattivazioneftthGetParameters/tns1:idRIsorsaOLD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;idRisorsa>&lt;xsl:value-of select=&quot;substring($get/parameters/tns1:verificarichiestadiattivazioneftthGetParameters/tns1:idRIsorsaOLD,1)&quot;/>&lt;/idRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codOloAgcom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($get/parameters/tns1:verificarichiestadiattivazioneftthGetParameters/tns1:codOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$get/parameters/tns1:verificarichiestadiattivazioneftthGetParameters/tns1:codOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOloAgcom>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="QueryFit-input"
                                    name="QueryFit"
                                    outputVariable="QueryFit"
                                    tibex:xpdlId="8cefaed4-b4bc-4cbd-9f03-836fe1644909" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8cefaed4-b4bc-4cbd-9f03-836fe1644909+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VerificaRichiestadiAttivazioneFTTH/parameters&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;substring($get.parameters/tns1:idRIsorsaOLD,2,1)=('2','6')&quot;>&#xa;                    &lt;idRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;concat('0',$get.parameters/tns1:idRIsorsaOLD)&quot;/>&#xa;                    &lt;/idRisorsa>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;substring($get.parameters/tns1:idRIsorsaOLD,3,1)=('0','1','5','9')&quot;>&#xa;                    &lt;idRisorsa>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($get.parameters/tns1:idRIsorsaOLD)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$get.parameters/tns1:idRIsorsaOLD&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/idRisorsa>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;idRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;substring($get.parameters/tns1:idRIsorsaOLD,1)&quot;/>&#xa;                    &lt;/idRisorsa>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($get.parameters/tns1:codOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/codOloAgcom>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*) as conteggio&#xa;FROM BDS_1_CASEDATA_ASSET&#xa;WHERE NUMEROFITTIZIO=? and statoasset in ('ATTIVO','INLAVORAZIONE') and codificaoloagcom=? &#xa;and idrisorsacorrelato is null and offerta in('EASYIPNGAFTTH', 'SEMIVULAFTTH', 'SEMIBITSTREAMNGAFTTH', 'SEMIEASYIPNGAFTTH', 'VULAFTTH', 'BITSTREAMNGAFTTH', 'FULLGPONPLUS', 'FULLGOPONPLUSNGA')" xsi:type="jdbcPalette:JDBCQueryActivity">

