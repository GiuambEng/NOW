&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://xmlns.example.com/20251103164529PLT" xmlns:tns6="http://www.example.org/VerificaRichiestadiAttivazioneFTTH" version="2.0"&gt;
