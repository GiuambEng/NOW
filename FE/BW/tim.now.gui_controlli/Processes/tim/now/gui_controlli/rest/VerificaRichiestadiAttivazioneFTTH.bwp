'INFO'&quot;/>&#xa;                        &lt;/tns6:severity>&#xa;                        &lt;tns6:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns6:code>&#xa;                    &lt;/tns6:result>&#xa;                &lt;/tns6:outputVerificaRichiestadiAttivazioneFTTH>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
