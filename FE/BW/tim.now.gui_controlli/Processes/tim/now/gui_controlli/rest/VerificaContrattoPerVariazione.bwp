                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d1e6991f-f900-4ce0-b493-1664127c5359+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://xmlns.example.com/VerificaContrattoPerVariazione/parameters&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;asset&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO1&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoContratti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:verificacontrattopervariazioneGetParameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;idOfferta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($asset/Record[1]/IDOFFERTA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$asset/Record[1]/IDOFFERTA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idOfferta>&#xa;            &lt;dataInizio>&#xa;                &lt;xsl:value-of select=&quot;$DRO1/parameters/tns2:Response/tns2:outputDate&quot;/>&#xa;            &lt;/dataInizio>&#xa;            &lt;dataFine>&#xa;                &lt;xsl:value-of select=&quot;$DRO1/parameters/tns2:Response/tns2:outputDate&quot;/>&#xa;            &lt;/dataFine>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RecuperoContratti-input"
                                    name="RecuperoContratti"
                                    outputVariable="RecuperoContratti"
                                    tibex:xpdlId="d1e6991f-f900-4ce0-b493-1664127c5359" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="assetToRecuperoContratti_NOFWA"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RecuperoContrattiToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length(xsd:string(xsd:int($RecuperoContratti/Record[1]/ID_CONTRATTO)))>0 and ((tib:compare-date(xsd:date($RecuperoContratti/Record[1]/DATAINZ_ASSOCZ_VALID), $DRO1/parameters/tns:Response/tns:outputDate)) = -1 ) and  ((tib:compare-date($DRO1/parameters/tns:Response/tns:outputDate, xsd:date($RecuperoContratti/Record[1]/DATAFI_ASSOCZ_VALID)) = -1 ))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length(xsd:string(xsd:int($RecuperoContratti/Record[1]/ID_CONTRATTO)))>0 and ((tib:compare-date(xsd:date($RecuperoContratti/Record[1]/DATAINZ_ASSOCZ_VALID), $DRO1.parameters/tns:outputDate)) = -1 ) and  ((tib:compare-date($DRO1.parameters/tns:outputDate, xsd:date($RecuperoContratti/Record[1]/DATAFI_ASSOCZ_VALID)) = -1 ))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="RecuperoContrattiTonull_IdContratto">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d1e6991f-f900-4ce0-b493-1664127c5359+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://xmlns.example.com/VerificaContrattoPerVariazione/parameters&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;asset&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoContratti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;codOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns1:codOloAgcom&quot;/>&#xa;            &lt;/codOloAgcom>&#xa;            &lt;idOfferta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($asset/Record[1]/IDOFFERTA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$asset/Record[1]/IDOFFERTA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/idOfferta>&#xa;            &lt;dataInizio>&#xa;                &lt;xsl:value-of select=&quot;$DRO1.parameters/tns2:outputDate&quot;/>&#xa;            &lt;/dataInizio>&#xa;            &lt;dataFine>&#xa;                &lt;xsl:value-of select=&quot;$DRO1.parameters/tns2:outputDate&quot;/>&#xa;            &lt;/dataFine>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COC.DATAINZ_ASSOCZ_VALID, COC.DATAFI_ASSOCZ_VALID, COC.ID_CONTRATTO, COC.ID_OFFERTA, C.FLAG_NPD, C.TIMSTP_INSMTO&#xa;FROM CONTRATTO_OFFERTA_CATLG COC&#xa;LEFT JOIN CONTRATTO C ON C.ID_CONTRATTO = COC.ID_CONTRATTO&#xa;LEFT JOIN TIPOLG_STATO_CONTRATTO TSC ON C.ID_STATO_CONTRATTO = TSC.ID_STATO_CONTRATTO&#xa;WHERE C.CODFC_OLO_AGCOM = ? AND TSC.DESCRIPTION = 'Active' AND C.FLAG_DIFFIDATO='N' AND COC.ID_OFFERTA = ?&#xa;AND COC.DATAINZ_ASSOCZ_VALID &lt;= ? AND COC.DATAFI_ASSOCZ_VALID >= ?&#xa;ORDER BY C.TIMSTP_INSMTO DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idOfferta"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="dataInizio"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="dataFine"/>
                                    <columnMetadata
                                    columnName="DATAINZ_ASSOCZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAFI_ASSOCZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_NPD"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke inputVariable="DRO1-input"
                                name="DRO1"
                                operation="calcNextWorkingDate"
                                outputVariable="DRO1"
                                partnerLink="GetNextDatePortType"
                                portType="ns8:GetNextDatePortType" tibex:xpdlId="600da316-307e-4ab6-9a2a-d6d8985ef76b">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" version="2.0"&gt;
    &lt;xsl:template name="DRO1-input" match="/"&gt;
        &lt;ns:calcNextWorkingDateRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:CalcRequest&gt;
                    &lt;tns1:inputDate&gt;
                        &lt;xsl:value-of select="current-date()"/&gt;
                    &lt;/tns1:inputDate&gt;
                &lt;/tns1:CalcRequest&gt;
            &lt;/parameters&gt;
        &lt;/ns:calcNextWorkingDateRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;DRO1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CalcRequest>&#xa;            &lt;tns1:inputDate>&#xa;                &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;            &lt;/tns1:inputDate>&#xa;        &lt;/tns1:CalcRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="getLogInfoToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="DRO1Toasset"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RecuperoContrattoHosting-input"
                                    name="RecuperoContrattoHosting"
                                    outputVariable="RecuperoContrattoHosting"
                                    tibex:xpdlId="079616fc-0a3a-4426-b173-854395881efb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RecuperoContrattiToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryTocontratto"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+079616fc-0a3a-4426-b173-854395881efb+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperoContratti&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($RecuperoContratti/Record[FLAG_NPD = 'Y']) = 1&quot;>&#xa;                    &lt;idContratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($RecuperoContratti/Record[FLAG_NPD = 'Y']/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/idContratto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($RecuperoContratti/Record[FLAG_NPD = 'Y']) > 1&quot;>&#xa;                    &lt;idContratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($RecuperoContratti/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/idContratto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;idContratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($RecuperoContratti/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/idContratto>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT C.ID_COD_CONTRATTO_PADRE, TSC.DESCRIPTION&#xa;FROM CONTRATTO C&#xa;LEFT JOIN TIPOLG_STATO_CONTRATTO TSC ON TSC.ID_STATO_CONTRATTO = C.ID_STATO_CONTRATTO&#xa;WHERE C.ID_CONTRATTO = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idContratto"/>
                                    <columnMetadata
                                    columnName="ID_COD_CONTRATTO_PADRE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCRIPTION"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty" tibex:xpdlId="dca21e76-1f2d-4359-8a0b-afa5cae6b667">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToEmpty"/>
                                    <bpws:target linkName="null_IdContrattoToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToContrattoSemi_OKeSEMI">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$result/ns9:esito = 'OK' and $asset/Record[1]/IDOFFERTA = (67,68,69)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$result/ns9:esito = 'OK' and $asset/Record[1]/IDOFFERTA = (67,68,69)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyTogetLogOutInfoMsg">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d81fd20b-3e64-419b-95a3-ee2a890fef2a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://xmlns.example.com/VerificaContrattoPerVariazione/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;asset&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO1&quot;/>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;ContrattoSemi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns2:verificacontrattopervariazioneGetParameters/tns2:codOloAgcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO1/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO1/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO1/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO1/parameters/tns1:Response/tns1:outputDate&quot;/>&#xa;            &lt;/DATAINZ_VALID>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$asset/Record[1]/IDOFFERTA = 68&quot;>&#xa;                    &lt;ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'18'&quot;/>&#xa;                    &lt;/ID_OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'16'&quot;/>&#xa;                    &lt;/ID_OFFERTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ContrattoSemi-input"
                                    name="ContrattoSemi"
                                    outputVariable="ContrattoSemi"
                                    tibex:xpdlId="d81fd20b-3e64-419b-95a3-ee2a890fef2a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToContrattoSemi_OKeSEMI"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ContrattoSemiToAssignSemi"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d81fd20b-3e64-419b-95a3-ee2a890fef2a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://xmlns.example.com/VerificaContrattoPerVariazione/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO1.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;asset&quot;/>&#xa;    &lt;xsl:template name=&quot;ContrattoSemi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$get.parameters/tns2:codOloAgcom&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO1.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO1.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO1.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO1.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATAINZ_VALID>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$asset/Record[1]/IDOFFERTA = 68&quot;>&#xa;                    &lt;ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'18'&quot;/>&#xa;                    &lt;/ID_OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'16'&quot;/>&#xa;                    &lt;/ID_OFFERTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select c.flag_diffidato&#xa;from contratto c inner join contratto_offerta_catlg coc on c.id_contratto=coc.id_contratto&#xa;inner join tipolg_stato_contratto tsc on c.id_stato_contratto = tsc.id_stato_contratto&#xa;where c.codfc_olo_agcom = ? and coc.datainz_assocz_valid &lt;= ? and &#xa;coc.datafi_assocz_valid >= ? and c.datafi_valid >= ? and&#xa;c.datainz_valid &lt;= ? and tsc.description = 'Active' and coc.id_offerta = ?&#xa;ORDER BY c.FLAG_NPD desc, c.TIMSTP_INSMTO desc" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_ASSOCZ_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_ASSOCZ_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_OFFERTA"/>
                                    <columnMetadata
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="result"
                                    name="AssignSemi"
                                    outputVariable="result"
                                    tibex:xpdlId="d972756b-c286-4732-8b5b-8a7f5fd4e923" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ContrattoSemiToAssignSemi"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignSemiTogetLogOutInfoMsg"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/verificaContrattoPerVariazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ContrattoSemi&quot;/>&lt;xsl:template name=&quot;result&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($ContrattoSemi/Record/FLAG_DIFFIDATO)=0&quot;>&lt;tns:Output_VerificaContrattoPerVariazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:esito>&lt;tns:descrizione>&lt;xsl:value-of select=&quot;'Contratto FULL non sottoscritto per il Service Provider'&quot;/>&lt;/tns:descrizione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_VerificaContrattoPerVariazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$ContrattoSemi/Record[1]/FLAG_DIFFIDATO='Y'&quot;>&lt;tns:Output_VerificaContrattoPerVariazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:esito>&lt;tns:descrizione>&lt;xsl:value-of select=&quot;'Contratto non selezionabile: il corrispondente contratto FULL è diffidato'&quot;/>&lt;/tns:descrizione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_VerificaContrattoPerVariazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Output_VerificaContrattoPerVariazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_VerificaContrattoPerVariazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="result" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
