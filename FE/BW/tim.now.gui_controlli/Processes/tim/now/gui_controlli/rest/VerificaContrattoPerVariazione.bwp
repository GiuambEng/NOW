                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/verificaContrattoPerVariazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;asset&quot;/>&lt;xsl:template name=&quot;result&quot; match=&quot;/&quot;>&lt;tns:Output_VerificaContrattoPerVariazione>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;xsl:choose>&lt;xsl:when test=&quot;$asset/Record[1]/IDOFFERTA = 46&quot;>&lt;tns:descrizione>&lt;xsl:value-of select=&quot;&amp;quot;La lavorazione di Variazione non è possibile per la risorsa selezionata&amp;quot;&quot;/>&lt;/tns:descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Contratto per servizio non stipulato dal Service Provider&amp;quot;&quot;/>&lt;/tns:descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_VerificaContrattoPerVariazione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
