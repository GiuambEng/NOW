                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5478be7e-0b8a-498f-b870-9d18c563db4d+input&quot; xmlns:tns1=&quot;http://xmlns.example.com/VerificaContrattoPerVariazione/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:template name=&quot;asset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDASSET>&#xa;                &lt;xsl:value-of select=&quot;$get/parameters/tns1:verificacontrattopervariazioneGetParameters/tns1:id_asset&quot;/>&#xa;            &lt;/IDASSET>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
