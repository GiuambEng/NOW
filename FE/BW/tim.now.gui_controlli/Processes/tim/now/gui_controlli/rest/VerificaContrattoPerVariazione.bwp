                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="result"
                                    name="null_IdContratto"
                                    outputVariable="result"
                                    tibex:xpdlId="4fa9e1ad-71fa-4684-b367-ccb610e484c4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
