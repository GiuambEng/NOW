                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaContrattoMulticast&quot; xmlns:tns1=&quot;http://xmlns.example.com/VerificaContrattoMulticast/parameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($JDBCQuery/Record/ID_CONTRATTO)>0&quot;>&#xa;                &lt;tns:VerificaContrattoMulticastOutput>&#xa;                    &lt;tns:outputVerificaContrattoMulticast>&#xa;                        &lt;tns:esito>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:esito>&#xa;                        &lt;tns:idContratto>&#xa;                            &lt;xsl:value-of select=&quot;string($JDBCQuery/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                        &lt;/tns:idContratto>&#xa;                    &lt;/tns:outputVerificaContrattoMulticast>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:VerificaContrattoMulticastOutput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:VerificaContrattoMulticastOutput>&#xa;                    &lt;tns:outputVerificaContrattoMulticast>&#xa;                        &lt;tns:esito>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:esito>&#xa;                        &lt;tns:message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;L’OLO &amp;quot;,$get.parameters/tns1:codOloAgcom, &amp;quot;non ha un contratto attivo abilitato al Multicast&amp;quot;)&quot;/>&#xa;                        &lt;/tns:message>&#xa;                    &lt;/tns:outputVerificaContrattoMulticast>&#xa;                    &lt;tns:result>&#xa;                        &lt;tns:severity>&#xa;                            &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                        &lt;/tns:severity>&#xa;                        &lt;tns:code>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:code>&#xa;                    &lt;/tns:result>&#xa;                &lt;/tns:VerificaContrattoMulticastOutput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
