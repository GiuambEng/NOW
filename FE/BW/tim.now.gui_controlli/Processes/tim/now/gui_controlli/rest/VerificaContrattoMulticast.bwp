                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaContrattoMulticast&quot; xmlns:tns1=&quot;http://xmlns.example.com/VerificaContrattoMulticast/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record/ID_CONTRATTO)>0&quot;>&lt;tns:VerificaContrattoMulticastOutput>&lt;tns:outputVerificaContrattoMulticast>&lt;tns:esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:esito>&lt;tns:idContratto>&lt;xsl:value-of select=&quot;string($JDBCQuery/Record[1]/ID_CONTRATTO)&quot;/>&lt;/tns:idContratto>&lt;/tns:outputVerificaContrattoMulticast>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:VerificaContrattoMulticastOutput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaContrattoMulticastOutput>&lt;tns:outputVerificaContrattoMulticast>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;concat(&amp;quot;L’OLO &amp;quot;,$get/parameters/tns1:verificacontrattomulticastGetParameters/tns1:codOloAgcom, &amp;quot;non ha un contratto attivo abilitato al Multicast&amp;quot;)&quot;/>&lt;/tns:message>&lt;/tns:outputVerificaContrattoMulticast>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:VerificaContrattoMulticastOutput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Variable"
                                    name="Assign"
                                    outputVariable="Variable"
                                    tibex:xpdlId="1b30a139-35da-46ea-af2f-e5d634e82ea2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
