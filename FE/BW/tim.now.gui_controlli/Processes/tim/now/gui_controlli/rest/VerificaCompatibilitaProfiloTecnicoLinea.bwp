;) and not($PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2'))&quot;>&#xa;                        &lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                            &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:message>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&#xa;                                &lt;/tns:message>&#xa;                            &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$post.item/tns:profiloTecnicoLinea = (&amp;quot;X1&amp;quot;,&amp;quot;X2&amp;quot;) and not($IdOffertaAsset/Record[1]/IDOFFERTA = (45,68,67,69,18,16))&quot;>&#xa;                        &lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                            &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:message>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&#xa;                                &lt;/tns:message>&#xa;                            &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$post.item/tns:profiloTecnicoLinea = (&amp;quot;X1&amp;quot;,&amp;quot;X2&amp;quot;) and $post.item/tns:idOfferta = (&amp;quot;45&amp;quot;,&amp;quot;68&amp;quot;,&amp;quot;67&amp;quot;,&amp;quot;69&amp;quot;,&amp;quot;18&amp;quot;,&amp;quot;16&amp;quot;) and ($IdOffertaAsset/Record[1]/IDOFFERTA = (67,68,69))&quot;>&#xa;                        &lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                            &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:message>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&#xa;                                &lt;/tns:message>&#xa;                            &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;not($post.item/tns:idOfferta = (&amp;quot;45&amp;quot;,&amp;quot;68&amp;quot;,&amp;quot;67&amp;quot;,&amp;quot;69&amp;quot;,&amp;quot;18&amp;quot;,&amp;quot;16&amp;quot;)) and ($PTNAsset/Record[1]/VALOREATTRIBUTO = (&amp;quot;X1&amp;quot;,&amp;quot;X2&amp;quot;))&quot;>&#xa;                        &lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                            &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:message>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&#xa;                                &lt;/tns:message>&#xa;                            &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$post.item/tns:profiloTecnicoLinea=('Z6','Z7','Z8') and $PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2')&quot;>&#xa;                        &lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                            &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:message>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&#xa;                                &lt;/tns:message>&#xa;                            &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$OneStep/Record[1]/COUNT > 0 and  $post.item/tns:profiloTecnicoLinea = 'Z9' and $PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2')&quot;>&#xa;                        &lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                            &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:message>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Cambio tecnologia GPON/XGS-PON: variazione non consentita&amp;quot;&quot;/>&#xa;                                &lt;/tns:message>&#xa;                            &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$OneStep/Record[1]/COUNT = 0 and  $post.item/tns:profiloTecnicoLinea = 'Z9' and $PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2','Z1','Z2','Z3','Z4','Z5','Z6','Z7','Z8')&quot;>&#xa;                        &lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                            &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:message>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&#xa;                                &lt;/tns:message>&#xa;                            &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                            &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                            &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                            &lt;tns:result>&#xa;                                &lt;tns:severity>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                                &lt;/tns:severity>&#xa;                                &lt;tns:code>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:code>&#xa;                            &lt;/tns:result>&#xa;                        &lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
