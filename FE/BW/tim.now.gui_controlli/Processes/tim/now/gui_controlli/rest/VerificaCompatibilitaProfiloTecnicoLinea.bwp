                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e14ce0d8-c13d-4255-be96-74e8751a117c+input&quot; xmlns:tns1=&quot;http://www.example.org/VerificaCompatibilitaProfiloTecnicoLinea&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;AssetRisOld-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idRisorsa>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:inputVerificaCompatibilitaProfiloTecnicoLinea/tns1:idRisorsaOld)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:inputVerificaCompatibilitaProfiloTecnicoLinea/tns1:idRisorsaOld&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/idRisorsa>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
