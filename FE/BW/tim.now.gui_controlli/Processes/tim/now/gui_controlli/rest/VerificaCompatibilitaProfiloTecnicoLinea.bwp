                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaCompatibilitaProfiloTecnicoLinea&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;PTNAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;IdOffertaAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;OneStep&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;upper-case($post.item/tns:lavorazione) = 'VARIAZIONE'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($post.item/tns:profiloTecnicoLinea = (&amp;quot;X1&amp;quot;,&amp;quot;X2&amp;quot;) and (not($PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2')))) or ($post.item/tns:profiloTecnicoLinea = (&amp;quot;Z6&amp;quot;,&amp;quot;Z7&amp;quot;,&amp;quot;Z8&amp;quot;) and not($PTNAsset/Record[1]/VALOREATTRIBUTO =('Z1', 'Z2', 'Z3', 'Z4','Z5', 'Z6', 'Z7', 'Z8','Z9'))) or ($post.item/tns:profiloTecnicoLinea = &amp;quot;Z9&amp;quot; and $PTNAsset/Record[1]/VALOREATTRIBUTO != 'Z9')&quot;>&#xa;                        &lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&#xa;                            &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;                                &lt;tns:esito>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns:esito>&#xa;                                &lt;tns:message>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Cambio tecnologia GPON/XGS-PON: variazione non consentita&amp;quot;&quot;/>&#xa;                                &lt;/tns:message>&#xa;                            &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&#xa;            