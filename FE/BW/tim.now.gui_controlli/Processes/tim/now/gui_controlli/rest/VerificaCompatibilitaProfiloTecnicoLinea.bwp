                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dcbe875e-0e02-4b04-9986-f198b029fad9+input&quot; xmlns:tns1=&quot;http://www.example.org/VerificaCompatibilitaProfiloTecnicoLinea&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:template name=&quot;OneStep-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;codProgetto>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:inputVerificaCompatibilitaProfiloTecnicoLinea/tns1:codiceProgetto)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:inputVerificaCompatibilitaProfiloTecnicoLinea/tns1:codiceProgetto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codProgetto>&lt;codOloAgcom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns1:inputVerificaCompatibilitaProfiloTecnicoLinea/tns1:codOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns1:inputVerificaCompatibilitaProfiloTecnicoLinea/tns1:codOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOloAgcom>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
