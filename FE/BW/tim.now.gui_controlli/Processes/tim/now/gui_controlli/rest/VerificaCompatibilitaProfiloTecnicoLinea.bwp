                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaCompatibilitaProfiloTecnicoLinea&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;PTNAsset&quot;/>&lt;xsl:param name=&quot;IdOffertaAsset&quot;/>&lt;xsl:param name=&quot;OneStep&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:lavorazione) = 'VARIAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:profiloTecnicoLinea = (&amp;quot;X1&amp;quot;,&amp;quot;X2&amp;quot;) and (not($PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2')))) or ($post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:profiloTecnicoLinea = (&amp;quot;Z6&amp;quot;,&amp;quot;Z7&amp;quot;,&amp;quot;Z8&amp;quot;) and not($PTNAsset/Record[1]/VALOREATTRIBUTO =('Z1', 'Z2', 'Z3', 'Z4','Z5', 'Z6', 'Z7', 'Z8','Z9'))) or ($post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:profiloTecnicoLinea = &amp;quot;Z9&amp;quot; and $PTNAsset/Record[1]/VALOREATTRIBUTO != 'Z9')&quot;>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Cambio tecnologia GPON/XGS-PON: variazione non consentita&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;'INFO'&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:esito>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:profiloTecnicoLinea = (&amp;quot;X1&amp;quot;,&amp;quot;X2&amp;quot;) and not($PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2'))&quot;>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:profiloTecnicoLinea = (&amp;quot;X1&amp;quot;,&amp;quot;X2&amp;quot;) and not($IdOffertaAsset/Record[1]/IDOFFERTA = (45,68,67,69,18,16))&quot;>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:profiloTecnicoLinea = (&amp;quot;X1&amp;quot;,&amp;quot;X2&amp;quot;) and $post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:idOfferta = (&amp;quot;45&amp;quot;,&amp;quot;68&amp;quot;,&amp;quot;67&amp;quot;,&amp;quot;69&amp;quot;,&amp;quot;18&amp;quot;,&amp;quot;16&amp;quot;) and ($IdOffertaAsset/Record[1]/IDOFFERTA = (67,68,69))&quot;>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;not($post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:idOfferta = (&amp;quot;45&amp;quot;,&amp;quot;68&amp;quot;,&amp;quot;67&amp;quot;,&amp;quot;69&amp;quot;,&amp;quot;18&amp;quot;,&amp;quot;16&amp;quot;)) and ($PTNAsset/Record[1]/VALOREATTRIBUTO = (&amp;quot;X1&amp;quot;,&amp;quot;X2&amp;quot;))&quot;>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:profiloTecnicoLinea=('Z6','Z7','Z8') and $PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2')&quot;>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;$OneStep/Record[1]/COUNT > 0 and  $post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:profiloTecnicoLinea = 'Z9' and $PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2')&quot;>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Cambio tecnologia GPON/XGS-PON: variazione non consentita&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;$OneStep/Record[1]/COUNT = 0 and  $post/item/tns:inputVerificaCompatibilitaProfiloTecnicoLinea/tns:profiloTecnicoLinea = 'Z9' and $PTNAsset/Record[1]/VALOREATTRIBUTO = ('X1','X2','Z1','Z2','Z3','Z4','Z5','Z6','Z7','Z8')&quot;>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Servizio non congruente con la richiesta di attivazione corrispondente&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:esito>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaOutput>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:outputVerificaCompatibilitaProfiloTecnicoLinea>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choos