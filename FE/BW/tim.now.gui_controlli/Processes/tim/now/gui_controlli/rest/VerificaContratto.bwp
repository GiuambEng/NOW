                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+67e006cc-baac-4c8c-be27-e14758e51997+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/VerificaContratto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;DRO&quot;/>&lt;xsl:template name=&quot;ContrattoSemi_FULLGPONPLUS-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($post/item/tns2:inputVerificaContratto/tns2:codiceOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$post/item/tns2:inputVerificaContratto/tns2:codiceOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;DATAINZ_ASSOCZ_VALID>&lt;xsl:value-of select=&quot;$DRO/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DATAINZ_ASSOCZ_VALID>&lt;DATAFI_ASSOCZ_VALID>&lt;xsl:value-of select=&quot;$DRO/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DATAFI_ASSOCZ_VALID>&lt;DATAFI_VALID>&lt;xsl:value-of select=&quot;$DRO/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DATAFI_VALID>&lt;DATAINZ_VALID>&lt;xsl:value-of select=&quot;$DRO/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DATAINZ_VALID>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns2:inputVerificaContratto/tns2:offerta = &amp;quot;67&amp;quot;&quot;>&lt;ID_OFFERTA>&lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&lt;/ID_OFFERTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns2:inputVerificaContratto/tns2:offerta = '68'&quot;>&lt;ID_OFFERTA>&lt;xsl:value-of select=&quot;'18'&quot;/>&lt;/ID_OFFERTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns2:inputVerificaContratto/tns2:offerta = '77'&quot;>&lt;ID_OFFERTA>&lt;xsl:value-of select=&quot;'18'&quot;/>&lt;/ID_OFFERTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns2:inputVerificaContratto/tns2:offerta = '78'&quot;>&lt;ID_OFFERTA>&lt;xsl:value-of select=&quot;'16'&quot;/>&lt;/ID_OFFERTA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_OFFERTA>&lt;xsl:value-of select=&quot;'45'&quot;/>&lt;/ID_OFFERTA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
