                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/VerificaContratto&quot; xmlns:ns0123=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContratto.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$VerificaContratto.parameters/ns0123:Esito/ns0123:Codice = true()&quot;>&#xa;                &lt;tns2:outputVerificaContratto>&#xa;                    &lt;tns2:VerificaContrattoOutput>&#xa;                        &lt;tns2:esito>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:esito>&#xa;                    &lt;/tns2:VerificaContrattoOutput>&#xa;                    &lt;tns2:result>&#xa;                        &lt;tns2:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:severity>&#xa;                        &lt;tns2:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:code>&#xa;                    &lt;/tns2:result>&#xa;                &lt;/tns2:outputVerificaContratto>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:outputVerificaContratto>&#xa;                    &lt;tns2:VerificaContrattoOutput>&#xa;                        &lt;tns2:esito>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:esito>&#xa;                        &lt;tns2:message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica Contratto non andata a buon fine&amp;quot;&quot;/>&#xa;                        &lt;/tns2:message>&#xa;                    &lt;/tns2:VerificaContrattoOutput>&#xa;                    &lt;tns2:result>&#xa;                        &lt;tns2:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:severity>&#xa;                        &lt;tns2:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:code>&#xa;                    &lt;/tns2:result>&#xa;                &lt;/tns2:outputVerificaContratto>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
