                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssign2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+67e006cc-baac-4c8c-be27-e14758e51997+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/VerificaContratto&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ContrattoSemi_FULLGPONPLUS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($post.item/tns2:codiceOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$post.item/tns2:codiceOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$DRO.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATAINZ_VALID>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:offerta = &amp;quot;67&amp;quot;&quot;>&#xa;                    &lt;ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&#xa;                    &lt;/ID_OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:offerta = '68'&quot;>&#xa;                    &lt;ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'18'&quot;/>&#xa;                    &lt;/ID_OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:offerta = '77'&quot;>&#xa;                    &lt;ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'18'&quot;/>&#xa;                    &lt;/ID_OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$post.item/tns2:offerta = '78'&quot;>&#xa;                    &lt;ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'16'&quot;/>&#xa;                    &lt;/ID_OFFERTA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_OFFERTA>&#xa;                        &lt;xsl:value-of select=&quot;'45'&quot;/>&#xa;                    &lt;/ID_OFFERTA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaxRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select c.flag_diffidato&#xd;&#xa;from contratto c inner join contratto_offerta_catlg coc on c.id_contratto=coc.id_contratto&#xd;&#xa;inner join tipolg_stato_contratto tsc on c.id_stato_contratto = tsc.id_stato_contratto&#xd;&#xa;where c.codfc_olo_agcom = ? and coc.datainz_assocz_valid &lt;= ? and &#xd;&#xa;coc.datafi_assocz_valid >= ? and c.datafi_valid >= ? and&#xd;&#xa;c.datainz_valid &lt;= ? and tsc.description = 'Active' and coc.id_offerta = ?&#xd;&#xa;ORDER BY c.FLAG_NPD desc, c.TIMSTP_INSMTO desc" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_ASSOCZ_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_ASSOCZ_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_OFFERTA"/>
                                    <columnMetadata
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
