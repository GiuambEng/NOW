                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/cmf/GenericLogger&quot; xmlns:tns4=&quot;http://tns.tibco.com/bw/REST&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.httpHeaders&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaContratto&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_controlli.VerificaContratto&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;select&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaContratto:&amp;quot;,tib:render-xml($post.httpHeaders, true(),true()))&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;            &lt;tns3:ActiveLoggerServices>&#xa;                &lt;tns3:Envelope>&#xa;                    &lt;tns3:Identifier>&#xa;                        &lt;tns3:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.gui_controlli.VerificaContratto&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ServiceName>&#xa;                        &lt;tns3:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Source>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-SID&quot;>&#xa;                            &lt;tns3:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-SID&quot;/>&#xa;                            &lt;/tns3:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventID>&#xa;                            &lt;xsl:value-of select=&quot;concat($post.httpHeaders/GUI-SID,$post.httpHeaders/GUI-TID)&quot;/>&#xa;                        &lt;/tns3:EventID>&#xa;                        &lt;xsl:if test=&quot;$post.httpHeaders/GUI-TID&quot;>&#xa;                            &lt;tns3:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$post.httpHeaders/GUI-TID&quot;/>&#xa;                            &lt;/tns3:CorrelationID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaContratto_&amp;quot;,$post.httpHeaders/GUI-SID,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns3:EventType>&#xa;                        &lt;tns3:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaContratto_&amp;quot;,$post.httpHeaders/GUI-SID)&quot;/>&#xa;                        &lt;/tns3:trackID>&#xa;                    &lt;/tns3:Identifier>&#xa;                    &lt;tns3:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns3:track_position>&#xa;                    &lt;tns3:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns3:Timestamp>&#xa;                &lt;/tns3:Envelope>&#xa;                &lt;tns3:Playload/>&#xa;            &lt;/tns3:ActiveLoggerServices>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.gui_controlli.sub.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="VerificaContratto-input"
                                name="VerificaContratto"
                                operation="VerificaContratto"
                                outputVariable="VerificaContratto"
                                partnerLink="BPM_CheckPortType"
                                portType="ns1:BPM_CheckPortType" tibex:xpdlId="7ce8c649-ed60-4b45-b30e-505c3c4bbb7b">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/concrete/BPM_CheckService/" xmlns:tns2="http://www.tim.com/NOW/rest/VerificaContratto" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" xmlns:ns0123="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="post"/&gt;
    &lt;xsl:param name="DRO"/&gt;
    &lt;xsl:param name="CodOLO"/&gt;
    &lt;xsl:param name="GetOfferta"/&gt;
    &lt;xsl:param name="calcoloDRO"/&gt;
    &lt;xsl:param name="CalcoloGiornoLavorativo"/&gt;
    &lt;xsl:template name="VerificaContratto-input" match="/"&gt;
        &lt;tns4:VerificaContrattoRequest&gt;
            &lt;parameters&gt;
                &lt;tns5:VerificaContratto&gt;
                    &lt;ns0123:CODICE_OLO&gt;
                        &lt;xsl:value-of select="$CodOLO/Record[1]/COD_OLO"/&gt;
                    &lt;/ns0123:CODICE_OLO&gt;
                    &lt;ns0123:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$post/item/tns2:inputVerificaContratto/tns2:codiceOloAgcom"/&gt;
                    &lt;/ns0123:CodiceOLOAGCOM&gt;
                    &lt;ns0123:Offerta&gt;
                        &lt;xsl:value-of select="$GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA"/&gt;
                    &lt;/ns0123:Offerta&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="tib:compare-date(current-date(), $CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate) !=0"&gt;
                            &lt;ns0123:DRO&gt;
                                &lt;xsl:value-of select="$CalcoloGiornoLavorativo/parameters/tns1:Response/tns1:outputDate"/&gt;
                            &lt;/ns0123:DRO&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1"&gt;
                            &lt;ns0123:DRO&gt;
                                &lt;xsl:value-of select="xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))"/&gt;
                            &lt;/ns0123:DRO&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;ns0123:DRO&gt;
                                &lt;xsl:value-of select="$DRO/parameters/tns1:Response/tns1:outputDate"/&gt;
                            &lt;/ns0123:DRO&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:if test="$post/item/tns2:inputVerificaContratto/tns2:lavorazione"&gt;
                        &lt;ns0123:Lavorazione&gt;
                            &lt;xsl:value-of select="$post/item/tns2:inputVerificaContratto/tns2:lavorazione"/&gt;
                        &lt;/ns0123:Lavorazione&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$post/item/tns2:inputVerificaContratto/tns2:DN"&gt;
                        &lt;ns0123:DN&gt;
                            &lt;xsl:value-of select="$post/item/tns2:inputVerificaContratto/tns2:DN"/&gt;
                        &lt;/ns0123:DN&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns5:VerificaContratto&gt;
            &lt;/parameters&gt;
        &lt;/tns4:VerificaContrattoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/concrete/BPM_CheckService/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/VerificaContratto&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:ns0123=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloGiornoLavorativo.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CodOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;GetOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaContratto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:VerificaContratto>&#xa;            &lt;ns0123:CODICE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$CodOLO/Record[1]/COD_OLO&quot;/>&#xa;            &lt;/ns0123:CODICE_OLO>&#xa;            &lt;ns0123:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns2:codiceOloAgcom&quot;/>&#xa;            &lt;/ns0123:CodiceOLOAGCOM>&#xa;            &lt;ns0123:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&#xa;            &lt;/ns0123:Offerta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $CalcoloGiornoLavorativo.parameters/tns1:outputDate) !=0&quot;>&#xa;                    &lt;ns0123:DRO>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloGiornoLavorativo.parameters/tns1:outputDate&quot;/>&#xa;                    &lt;/ns0123:DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()),'T'), '.')), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO),'T'), '+'))) = -1&quot;>&#xa;                    &lt;ns0123:DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/ns0123:DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns0123:DRO>&#xa;                        &lt;xsl:value-of select=&quot;$DRO.parameters/tns1:outputDate&quot;/>&#xa;                    &lt;/ns0123:DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$post.item/tns2:lavorazione&quot;>&#xa;                &lt;ns0123:Lavorazione>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns2:lavorazione&quot;/>&#xa;                &lt;/ns0123:Lavorazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$post.item/tns2:DN&quot;>&#xa;                &lt;ns0123:DN>&#xa;                    &lt;xsl:value-of select=&quot;$post.item/tns2:DN&quot;/>&#xa;                &lt;/ns0123:DN>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:VerificaContratto>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="InvokeToVerificaContratto"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="VerificaContrattoToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="VerificaContrattoToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($VerificaContratto/parameters/tns:VerificaContrattoResponse/ns0123:FlagOloDiffidatoFull)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($VerificaContratto.parameters/ns0123:FlagOloDiffidatoFull)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/rest/VerificaContratto&quot; xmlns:ns0123=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContratto&quot;/>&#xa;    &lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$VerificaContratto/parameters/tns3:VerificaContrattoResponse/ns0123:Esito/ns0123:Codice = true()&quot;>&#xa;                &lt;tns2:outputVerificaContratto>&#xa;                    &lt;tns2:VerificaContrattoOutput>&#xa;                        &lt;tns2:esito>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:esito>&#xa;                    &lt;/tns2:VerificaContrattoOutput>&#xa;                    &lt;tns2:result>&#xa;                        &lt;tns2:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:severity>&#xa;                        &lt;tns2:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:code>&#xa;                    &lt;/tns2:result>&#xa;                &lt;/tns2:outputVerificaContratto>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:outputVerificaContratto>&#xa;                    &lt;tns2:VerificaContrattoOutput>&#xa;                        &lt;tns2:esito>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:esito>&#xa;                        &lt;tns2:message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica Contratto non andata a buon fine&amp;quot;&quot;/>&#xa;                        &lt;/tns2:message>&#xa;                    &lt;/tns2:VerificaContrattoOutput>&#xa;                    &lt;tns2:result>&#xa;                        &lt;tns2:severity>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:severity>&#xa;                        &lt;tns2:code>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:code>&#xa;                    &lt;/tns2:result>&#xa;                &lt;/tns2:outputVerificaContratto>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
