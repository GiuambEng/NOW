                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/rest/VerificaPerVariazioneWLR&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;post&quot;/>&lt;xsl:param name=&quot;STS_Asset&quot;/>&lt;xsl:param name=&quot;Asset_TipoLinea&quot;/>&lt;xsl:param name=&quot;Asset_Borchia&quot;/>&lt;xsl:template name=&quot;result&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns:Input_VerificaPerVariazioneWLR/tns:opzioneVariazione=&amp;quot;ATTIVO&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$post/item/tns:Input_VerificaPerVariazioneWLR/tns:codiceSTS != '15' and $STS_Asset/Record[1]/CODICE_STS = $post/item/tns:Input_VerificaPerVariazioneWLR/tns:codiceSTS&quot;>&lt;tns:Output_VerificaPerVariazioneWLR>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:descrizione>&lt;xsl:value-of select=&quot;&amp;quot;STS già presente in consistenza&amp;quot;&quot;/>&lt;/tns:descrizione>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/tns:severity>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:code>&lt;/tns:result>&lt;/tns:Output_VerificaPerVariazioneWLR>&lt;/xsl:when>&lt;xsl:when test=&quot;$post/item/tns:Input_VerificaPerVariazioneWLR/tns:codiceSTS=&amp;quot;15&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Asset_TipoLinea/Record[OFFERTA = ('WLRLINEAATTIVA','WLRLINEANONATTIVA') and STATOASSET = 'ATTIVO']/TIPOLINEA=&amp;quot;ISDN&amp;quot; and ($Asset_Borchia/Record[1]/CODICE_STS != &amp;quot;W+&amp;quot;or string-length($Asset_Borchia/Record[1]/CODICE_STS) =0) &quot;>&lt;tns:Output_VerificaPerVariazioneWLR>&lt;tns:esito>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:esito>&lt;tns:result>&lt;tns:severity>&lt;xsl:value-of