                                    sqlStatement="select  ADL.VALOREATTRIBUTO as CODICE_STS from BDS_1_CASEDATA_ATTRIBTDTTGLSST ADL &#xa; left join BDS_1_CASEDATA_ASSET A ON ADL.IDASSET=A.IDASSET&#xa; where  &#xa; A.IDASSET = ? and  &#xa; ADL.NOMEATTRIBUTO = 'BORCHIANT1PLUS'" xsi:type="jdbcPalette:JDBCQueryActivity">

