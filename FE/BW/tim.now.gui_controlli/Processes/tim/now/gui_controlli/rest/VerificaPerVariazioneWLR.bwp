                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select  ADL.VALOREATTRIBUTO as CODICE_STS&#xa;from BDS_1_CASEDATA_ATTRIBTDTTGLSST ADL &#xa; left join BDS_1_CASEDATA_ASSET A ON ADL.IDASSET=A.IDASSET&#xa; INNER JOIN BDS_1_CASEDATA_DETTAGLIOASSET DA ON A.IDASSET = DA.IDASSET&#xa;where  &#xa; A.IDASSET = ? and  &#xa; ADL.NOMEATTRIBUTO = 'CODICE' AND &#xa; DA.NOMECOMPONENTE = 'STS' AND &#xa; DA.STATODETTAGLIOASSET &lt;> 'CESSATO'" xsi:type="jdbcPalette:JDBCQueryActivity">

