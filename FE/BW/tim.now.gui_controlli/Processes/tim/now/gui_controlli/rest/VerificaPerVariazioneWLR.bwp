            <bpws:links/>
            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="3fdb26f5-517e-4708-8143-d7eae7b7e483">
                <bpws:onMessage operation="post"
                    partnerLink="verificapervariazionewlr"
                    portType="ns:verificapervariazionewlr"
                    tibex:xpdlId="fa12c398-4a74-4193-a671-5f9fa29da78c" variable="post">
                    <bpws:scope name="scope1">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails"
                                tibex:faultNameVar="FaultName" tibex:xpdlId="02acaed0-0a8c-43c6-8ff5-b8f0d0d3167f">
                                <bpws:scope name="scope2">
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="CallProcess3ToReply" tibex:linkType="SUCCESS"/>
