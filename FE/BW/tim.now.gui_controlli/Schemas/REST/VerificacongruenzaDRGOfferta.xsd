<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificacongruenzaDRGOfferta" xmlns:tns="http://www.example.org/VerificacongruenzaDRGOfferta" elementFormDefault="qualified">

    <element name="VerificacongruenzaDRGOffertaInput">
    	<complexType>
    		<sequence>
    			<element name="offerta" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codVLAN" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    			<element name="codSVLAN" type="string" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="VerificacongruenzaDRGOffertaOutput">
    	<complexType>
    		<sequence>
    			<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>