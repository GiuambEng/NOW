<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/ControlloValoriBandaPicco" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/ControlloValoriBandaPicco">

    <element name="ControlloValoriBandaPicco">
    	<complexType>
    		<sequence>
    			<element name="userVlan" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="bandaPiccoDown" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="bandaPiccoUp" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipoCos" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="codVlan" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="lavorazione" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="OutputControlloValoriBandaPicco">
    	<complexType>
    		<sequence>

                <element name="codice" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>