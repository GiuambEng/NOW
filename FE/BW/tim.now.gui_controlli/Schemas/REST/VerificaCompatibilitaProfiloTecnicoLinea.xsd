<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaCompatibilitaProfiloTecnicoLinea" xmlns:tns="http://www.example.org/VerificaCompatibilitaProfiloTecnicoLinea" elementFormDefault="qualified">

    <element name="inputVerificaCompatibilitaProfiloTecnicoLinea">
    	<complexType>
    		<sequence>
    			<element name="lavorazione" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="profiloTecnicoLinea" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="idAsset" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idOfferta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codiceProgetto" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codOloAgcom" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idRisorsaOld" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputVerificaCompatibilitaProfiloTecnicoLinea">
    	<complexType>
    		<sequence>
    			<element
    				name="VerificaCompatibilitaProfiloTecnicoLineaOutput"
    				maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>