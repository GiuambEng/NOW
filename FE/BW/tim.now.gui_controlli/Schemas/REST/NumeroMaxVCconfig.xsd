    		<sequence>
    			<element ref="tns:OutputNumeroMaxVCconfig"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="OutputNumeroMaxVCconfig">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="1" name="numMaxVCxCF"
    				type="string">
    			</element>
    			<element minOccurs="0" maxOccurs="1" name="result">
    				<complexType>
    					<sequence>
    						<element minOccurs="0" maxOccurs="1"
    							name="severity" type="string">
    						</element>
    						<element minOccurs="0" maxOccurs="1"
    							name="code" type="string">
    						</element>
    						<element minOccurs="0" maxOccurs="1"
    							name="details" type="string">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>