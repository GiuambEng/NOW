<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/VerificaCompatibProfTecnLineaProfiloVC" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VerificaCompatibProfTecnLineaProfiloVC">

    <element name="inputVerificaCompatibProfTecnLineaProfiloVC">
    	<complexType>
    		<sequence>
    			<element name="lavorazione" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="caratteristica" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="profiloTecnicoLinea" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="VC" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="VPI" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="VCI" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="tipoProfilo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="idAsset" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idOfferta" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputVerificaCompatibProfTecnLineaProfiloVC">
    	<complexType>
    		<sequence>
    			<element name="esito" maxOccurs="1" minOccurs="0" type="string">
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="faultVerificaCompatibProfTecnLineaProfiloVC">
    	<complexType>
    		<sequence>
    			<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>