<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/verificaCoppiaBandePicco/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/verificaCoppiaBandePicco/">

    <element name="inputVerificaCoppiaBandePicco">
    	<complexType >
        <sequence>
        	<element name="profiloTecnicoLinea" type="string"
        		maxOccurs="1" minOccurs="0" />
        	<element maxOccurs="unbounded" name="userVlan"
        		minOccurs="0">
        		<complexType>
        			<sequence>
        				<element name="bandaPiccoUP" type="string"
        					maxOccurs="1" minOccurs="0" />
        				<element name="bandaPiccoDOWN" type="string"
        					maxOccurs="1" minOccurs="0" />
        				<element name="userVlanId" type="string"
        					maxOccurs="1" minOccurs="0">
        				</element>
        			</sequence>
        		</complexType>
        	</element>

        	<element name="idRisorsa1" type="string" maxOccurs="1"
        		minOccurs="0">
        	</element>
        	<element name="idRisorsa2" type="string" maxOccurs="1"
        		minOccurs="0">
        	</element>
        	<element name="tipoVariazione" type="string" maxOccurs="1"
        		minOccurs="0">
        	</element>
        	<element name="lavorazione" type="string" maxOccurs="1"
        		minOccurs="0">
        	</element>
        	<element name="encapsulation" type="string" maxOccurs="1"
        		minOccurs="0">
        	</element>
        	<element name="tagging" type="string" maxOccurs="1"
        		minOccurs="0">
        	</element>
        	<element name="offerta" type="string" maxOccurs="1" minOccurs="0"></element>
        </sequence>
    	</complexType>
      </element>


    <element name="outputVerificaCoppiaBandePicco2">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:outputVerificaCoppiaBandePicco">
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="code" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="details" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType></element>

    <element name="faultVerificaCoppiaBandePicco">
    	<complexType>
    		<sequence>
    			<element name="message" type="string"></element>
    			<element name="code" type="string"></element>
    		</sequence>
    	</complexType></element>
    	<simpleType name="OffertaEnumeration">
        <restriction base="string">
          <enumeration value="WLRLINEAATTIVA"/>
          <enumeration value="WLRLINEANONATTIVA"/>
          <enumeration value="ULLLINEAATTIVA"/>
          <enumeration value="ULLLINEANONATTIVA"/>
          <enumeration value="ULLLINEAATTIVANP"/>
          <enumeration value="ULLDATILINEAATTIVA"/>
          <enumeration value="ULLDATILINEANONATTIVA"/>
          <enumeration value="ULLDATILINEAATTIVANP"/>
          <enumeration value="VULL"/>
          <enumeration value="SHACONMANODOPERA"/>
          <enumeration value="SHASENZAMANODOPERA"/>
          <enumeration value="PROLUNGAMENTOACCESSO"/>
          <enumeration value="CPS"/>
          <enumeration value="COLOCAZIONE"/>
          <enumeration value="SLULINEAATTIVA"/>
          <enumeration value="SLULINEANONATTIVA"/>
          <enumeration value="SLULINEAATTIVANP"/>
          <enumeration value="VARIAZIONEWLR"/>
          <enumeration value="VARIAZIONEULL"/>
          <enumeration value="AMPLIAMENTOPA"/>
          <enumeration value="AMPLIAMENTOCOLOCAZIONE"/>
          <enumeration value="VARIAZIONESLU"/>
          <enumeration value="CESSAZIONEWLRLINEAATTIVA"/>
          <enumeration value="CESSAZIONEWLRLINEANONATTIVA"/>
          <enumeration value="CESSAZIONEULL"/>
          <enumeration value="CESSAZIONEPA"/>
          <enumeration value="CESSAZIONECOLOCAZIONE"/>
          <enumeration value="CESSAZIONECPS"/>
          <enumeration value="CESSAZIONESLU"/>
          <enumeration value="BITSTREAMGBEASIMMETRICOFLAT"/>
          <enumeration value="BITSTREAMATMASIMMETRICOFLAT"/>
          <enumeration value="BITSTREAMATMASIMMETRICOHL"/>
          <enumeration value="BITSTREAMATMASIMMETRICOLITE"/>
          <enumeration value="EASYIPBASEPLUSFLAT"/>
          <enumeration value="EASYIPBASEPLUSLITE"/>
          <enumeration value="EASYIPSPECIALPROFILEFLAT"/>
          <enumeration value="EASYIPSPECIALPROFILELITE"/>
          <enumeration value="BITSTREAMNGAFTTCAB"/>
          <enumeration value="BITSTREAMNGAFTTH"/>
          <enumeration value="VULAFTTCAB"/>
          <enumeration value="VULAFTTH"/>
        </restriction>
      </simpleType>
    	<element name="outputVerificaCoppiaBandePicco">
    		<complexType>
    			<sequence>
    				<element minOccurs="0" maxOccurs="1" name="esito"
    					type="string">
