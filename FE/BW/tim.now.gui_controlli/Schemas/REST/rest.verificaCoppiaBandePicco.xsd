    				<element minOccurs="0" maxOccurs="1"
    					name="codErroreInterno" type="string">
    				</element>
    				<element minOccurs="0" maxOccurs="1"
    					name="descrErroreInterno" type="string">
    				</element>
    			</sequence>
    		</complexType>
    	</element>
</schema>