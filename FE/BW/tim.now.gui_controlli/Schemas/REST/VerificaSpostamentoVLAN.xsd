<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaSpostamentoVLAN" xmlns:tns="http://www.example.org/VerificaSpostamentoVLAN" elementFormDefault="qualified">
        <element name="VerificaSpostamentoVLANInput">
    	<complexType>
    		<sequence>
    			<element name="idRichiestaOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="caratterizzazioneCarRic" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="caratterizzazioneCarCons" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="supermacroareaRic" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="supermacroareaCons" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="idRisorsa" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="nomeMacroAreaRic" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="nomeMacroAreaCons" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="lavorazione" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="offerta" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="VerificaSpostamentoVLANOutput">
    	<complexType>
    		<sequence>
    			<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>