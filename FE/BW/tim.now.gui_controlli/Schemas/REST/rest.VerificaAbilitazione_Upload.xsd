<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/VerificaAbilitazione_Upload" xmlns:tns="http://www.tim.com/NOW/rest/VerificaAbilitazione_Upload" elementFormDefault="qualified">

    <element name="Input_VerificaAbilitazione_Upload"
    	type="tns:Input_VerificaAbilitazione_Upload">
    </element>
    
    <element name="Output_VerificaAbilitazione_Upload"
    	type="tns:Output_VerificaAbilitazione_Upload">
    </element>
    
    <element name="Fault_VerificaAbilitazione_Upload"
    	type="tns:Fault_VerificaAbilitazione_Upload">
    </element>
    
    <complexType name="Input_VerificaAbilitazione_Upload">
    	<sequence>
    		<element name="CODFC_OLO_AGCOM" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="Output_VerificaAbilitazione_Upload">
    	<sequence>
            <element name="lista_CODFC_OLO_AGCOM" type="string" maxOccurs="unbounded" minOccurs="0"></element>
            <element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    					<element name="code" type="string" minOccurs="0"
    						maxOccurs="1">
    					</element>
    					<element name="details" type="string"
    						minOccurs="0" maxOccurs="1">
    					</element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
    
    <complexType name="Fault_VerificaAbilitazione_Upload">
    <sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
    
    </complexType>

    <complexType name="NewType">
    	<sequence>
    		<element name="codfc_olo_agcom" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>