<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaContrattoCoinvestimentoComune" xmlns:tns="http://www.example.org/VerificaContrattoCoinvestimentoComune" elementFormDefault="qualified">

    <element name="inputVerificaContrattoCoinvestimentoComune">
    	<complexType>
    		<sequence>
    			<element name="idContratto" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idOfferta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
                <element name="lavorazione" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="codiceIstatComune" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="indirizzoDatiClienteFinale" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="provincia" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="comune" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="partToponomastica"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="indirizzo" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="civico" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputVerificaContrattoCoinvestimentoComune">
    	<complexType>
    		<sequence>
    			<element
    				name="VerificaContrattoCoinvestimentoComuneOuput" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>