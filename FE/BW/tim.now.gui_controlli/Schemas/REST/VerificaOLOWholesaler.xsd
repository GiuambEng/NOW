<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/VerificaOLOWholesaler" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VerificaOLOWholesaler">

    <element name="outputVerificaOLOWholesaler">
    	<complexType>
    		<sequence>
    			<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType></element>

    <element name="inputVerificaOLOWholesaler">
    	<complexType>
    		<sequence>
    			<element name="RoutingNumberRecipient" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codificaAgcomRecipient" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="offerta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="tipoLinea" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="componenteNumberPortability"
    				type="string" maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="idRichiestaOlo" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
</schema>