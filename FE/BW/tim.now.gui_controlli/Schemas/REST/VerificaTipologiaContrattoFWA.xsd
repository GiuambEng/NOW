<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaTipologiaContrattoFWA" xmlns:tns="http://www.example.org/VerificaTipologiaContrattoFWA" elementFormDefault="qualified">

    <element name="inputVerificaTipologiaContrattoFWA">
    	<complexType>
    		<sequence>
    			<element name="codOloAgcom" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idContratto" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="codiceProgetto" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="profiloFwa" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="outputVerificaTipologiaContrattoFWA">
    	<complexType>
    		<sequence>
    			<element name="outputTipologieFWA" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="profili"
    							maxOccurs="unbounded" minOccurs="0" type="string">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>