<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/rest/VerificaCompatibilitaLavorazione">

    <element name="VerificaCompatibilitaLavorazione">
    	<complexType>
    		<sequence>
    			<element name="codice" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="scenario" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="codiceTrasformazione" type="string" maxOccurs="1" minOccurs="0"></element>
                <element maxOccurs="1" minOccurs="0" name="result">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="severity" type="string" />
    						<element maxOccurs="1" minOccurs="0" name="code" type="string" />
    						<element maxOccurs="1" minOccurs="0" name="details" type="string" />
    					</sequence>
    				</complexType>
    			</element>
            </sequence>
    	</complexType>
    </element>

    <element name="InputVerificaCompatibilitaLavorazione">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0"
    				name="offertaRichiesta" type="string">
    			</element>


    			<element maxOccurs="1" minOccurs="0"
    				name="tipologiaLineaRichiesta" type="string">
    			</element>



    			<element name="lavorazioneRichiesta" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element maxOccurs="1" minOccurs="0" name="flagNPAsset"
    				type="string">
    			</element>




    			<element maxOccurs="1" minOccurs="0"
    				name="destinazioneUsoRichiestaOlo" type="string">
    			</element>





    			<element maxOccurs="1" minOccurs="0"
    				name="idRichiestaOlo" type="string">
    			</element>


    			<element name="codiceRisorsa1" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codiceRisorsa2" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>

    			<element name="codificaOloAgcom" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codificaOloAgcomRecipient" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codiceSessione1" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codiceSessione2" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>
