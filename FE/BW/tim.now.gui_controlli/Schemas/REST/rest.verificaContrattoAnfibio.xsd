<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/verificaContrattoAnfibio" xmlns:tns="http://www.tim.com/NOW/rest/verificaContrattoAnfibio" elementFormDefault="qualified">

    <element name="Input_VerificaContrattoAnfibio">
    	<complexType>
    		<sequence>
    			<element name="identificativoContratto" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Output_VerificaContrattoAnfibio">
    	<complexType>
    		<sequence>
    			<element name="esito" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
                <element name="descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
                <element name="result">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string"
    							minOccurs="0" maxOccurs="1">
    						</element>
    						<element name="code" type="string"
    							minOccurs="0" maxOccurs="1">
    						</element>
    						<element name="details" type="string"
    							minOccurs="0" maxOccurs="1">
    						</element>
    					</sequence>

    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Fault_VerificaContrattoAnfibio">
    	<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="message" type="string" />
				<element maxOccurs="1" minOccurs="0" name="code" type="string" />
			</sequence>
		</complexType>
    </element>
</schema>