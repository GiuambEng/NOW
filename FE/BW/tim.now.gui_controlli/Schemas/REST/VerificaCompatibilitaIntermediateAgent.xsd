<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VerificaCompatibilitaIntermediateAgent" xmlns:tns="http://www.example.org/VerificaCompatibilitaIntermediateAgent" elementFormDefault="qualified">

    <element name="inputVerificaCompatibilitaIntermediateAgent">
    	<complexType>
    		<sequence>
    			<element name="idOfferta" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="lavorazione" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idAsset" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="intermediateAgentFull" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="encapsulation" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="svlanCodes" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="id" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="value" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="cvlanCodes" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="id" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="value" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="outputVerificaCompatibilitaIntermediateAgent">
    	<complexType>
    		<sequence>
    			<element
    				name="VerificaCompatibilitaIntermediateAgentOutput" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="message" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>