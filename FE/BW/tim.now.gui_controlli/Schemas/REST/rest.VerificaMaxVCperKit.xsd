<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/rest/VerificaMaxVCperKit" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/rest/VerificaMaxVCperKit">

    <element name="inputVerificaMaxVCperKit">
    	<complexType>
    		<sequence>
    			<element name="tdCode" type="string" minOccurs="1" maxOccurs="unbounded"></element>
    			<element name="codOloAgcom" type="string"></element>
    			<element name="idOfferta" type="string"></element>
    		</sequence>
    	</complexType></element>

    <element name="outputVerificaMaxVCperKit">
    	<complexType>
    		<sequence>
    			<element name="esito" minOccurs="0" maxOccurs="1">
    				<complexType>
    					<sequence>
    						<element name="codice" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType></element>
    			<element name="result" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType></element>

</schema>