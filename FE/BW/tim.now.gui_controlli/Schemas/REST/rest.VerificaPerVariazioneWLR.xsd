<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/rest/VerificaPerVariazioneWLR" xmlns:tns="http://www.tim.com/NOW/rest/VerificaPerVariazioneWLR" elementFormDefault="qualified">

    <element name="Input_VerificaPerVariazioneWLR">
    	<complexType>
    		<sequence>
    			<element name="opzioneVariazione" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="codiceSTS" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="idRisorsa" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="aggiuntiviISDN" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="numerazioneAggiuntiva" type="string"
    				maxOccurs="unbounded" minOccurs="0">
    			</element>
    			<element name="idAsset" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Output_VerificaPerVariazioneWLR">
    	<complexType>
    		<sequence>
    			<element name="esito" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="descrizione" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="result">
    				<complexType>
    					<sequence>
    						<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>