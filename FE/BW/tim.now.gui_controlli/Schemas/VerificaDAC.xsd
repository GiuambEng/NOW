<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"  xmlns:ns1="http://www.tim.com/NOW/xsd/VerificaDAC" targetNamespace="http://www.tim.com/NOW/xsd/VerificaDAC" elementFormDefault="qualified">
	<element name="verificaDacLavSlaOutput" type="ns1:verificaDacOutput"/>
	<complexType name="verificaDacOutput">
		<sequence>
			<element name="esito" minOccurs="0">
				<complexType>
					<sequence>
						<element name="codice" type="string" minOccurs="0" maxOccurs="1"/>
						<element name="descrizione" type="string" minOccurs="0"/>
					</sequence>
				</complexType>
			</element>
			<element name="result" minOccurs="0">
				<complexType>
					<sequence>
						<element name="severity" type="string" minOccurs="0"/>
						<element name="code" type="string" minOccurs="0"/>
						<element name="details" type="string" minOccurs="0"/>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>
</schema>
