bash  $HOME/.bash_profile                                         ##DA NON MODIFICARE

export path_root=/home/oracle12/NOW/BONIFICHE_SVIL          ## Da configurare, path root di installazione

export sys_code=appuser                                           ## Da configurare, Se SQLPLUS Password db Se CrmInterface sbiancare
export username=appuser                                           ## Da configurare, Utente di accesso al DB
export dbname=APPLSTE                                             ## Da configurare, Alias (SID) del DB
export CRMSINTERFACE=N                                            ## Da configurare Y/N, specifica l'utilizzo del CrmInterface sull'ambiente di esecuzione


export ORACLE_HOME=/product/app/oracle/12.1.0/client              ## Da configurare con il path di Oracle della macchina

export path_log=$path_root/Log                                          ## DA NON MODIFICARE
export ORACLE_BIN=$ORACLE_HOME/bin                                      ## DA NON MODIFICARE  
export PATH=$PATH:$ORACLE_HOME/bin/                                     ## DA NON MODIFICARE 
export data_corrente=`date +%Y%m%d%H%M%S`                               ## DA NON MODIFICARE
