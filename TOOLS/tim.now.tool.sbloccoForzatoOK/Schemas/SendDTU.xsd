<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:cd="http://NOW.it.telecomitalia.it/casedata_v1"
	xmlns:dtu="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/"
	xmlns:tns="http://www.tim.com/NOW/xsd/SendDTU/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	attributeFormDefault="unqualified" elementFormDefault="qualified"
	targetNamespace="http://www.tim.com/NOW/xsd/SendDTU/"
	xmlns:pref="http://NOW.it.telecomitalia.it/casedata">
	<xsd:import
		namespace="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/"
		schemaLocation="Tracciati_Richiesta_Notifica_NOW_DTU.xsd" />
	<xsd:import schemaLocation="../../tim.now.shared_library/Schemas/BOMCaseData/Casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata"></xsd:import>
	<xsd:element name="SendDTURequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Testata" type="tns:Testata" />
				<xsd:element name="RichiestaElement"
					type="pref:Richiesta" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SendDTUResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element maxOccurs="1" minOccurs="1"
					name="IdEventoOrdnNowWhls" type="xsd:integer" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="SendDTUFault">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Codice" type="xsd:string"
					maxOccurs="1" minOccurs="1" />
				<xsd:element name="Descrizione" type="xsd:string"
					maxOccurs="1" minOccurs="0" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="Testata">
		<xsd:sequence>
			<xsd:element name="RequestType"
				type="dtu:TipoRichiestaType" />
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ACK_COMUNICAZIONE" type="tns:ack_Type">
		<xsd:annotation>
			<xsd:documentation>
				Contiene tutte le informazioni che indentificano
				l'evento con cui NOW fornisce un ACK applicativo su una
				NOTIFICA inviata da DTU
			</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="ack_Type">
		<xsd:sequence>
			<xsd:element name="IdRichiestaOLO" type="xsd:string" />
			<xsd:element name="ACK" type="dtu:ack_Type" />
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
