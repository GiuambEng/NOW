<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/SbloccoForzatoStaging/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/SbloccoForzatoStaging/">


<element name="SbloccoForzato">
		<complexType>
			<sequence>
				<element ref="tns:SbloccoForzato_dettaglio" minOccurs="0" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<element name="SbloccoForzato_dettaglio">
		<complexType>
			<sequence>
			
				<element name="CONTENUTO_RECORD" type="string" minOccurs="0"/>
				<element name="DESCR_ERRORE" type="string" minOccurs="0"/>
				<element name="ID_RISORSA" type="string" minOccurs="0"/>
			    <element name="ID_FILE_PROCSTO_INPUT" type="int" minOccurs="0"/>
				<element name="ID_STATO_ELAB_STAG" type="int" minOccurs="0"/>
				<element name="NUMERO_RECD" type="int" minOccurs="0"/>
				<element name="NUMERO_TELEFONICO" type="string" minOccurs="0"/>
				<element name="NUMERO_TELEFONICO_PRINC" type="string" minOccurs="0"/>
				<element name="ID_RICH_OLO" type="string" minOccurs="0"/>
				<element name="TMSP_INSMTO" type="dateTime" minOccurs="0"/>
				<element name="TIMSTP_AGG" type="dateTime" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>

</schema>