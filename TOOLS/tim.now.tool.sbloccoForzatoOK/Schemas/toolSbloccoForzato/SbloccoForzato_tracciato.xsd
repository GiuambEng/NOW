<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/SbloccoForzato_tracciato/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/SbloccoForzato_tracciato/">


<element name="SbloccoForzato">
		<complexType>
			<sequence>
				<element ref="tns:SbloccoForzato_Dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="SbloccoForzato_Dettaglio">
		<complexType>
			<sequence>
					<element name="TIPO_RECORD" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="RISORSA"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="NUMBER"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="PRIMARY_NUMBER"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_RICHIESTA_OLO" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						
    						<element name="Flag_validita" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>


</schema>