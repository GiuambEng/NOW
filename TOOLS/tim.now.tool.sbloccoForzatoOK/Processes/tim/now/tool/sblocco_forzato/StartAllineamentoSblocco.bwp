eue"/&gt;&lt;/ns:NomeProcesso&gt;&lt;/ns:contaRecord_Input&gt;&lt;/part1&gt;&lt;/tns:Conta_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
