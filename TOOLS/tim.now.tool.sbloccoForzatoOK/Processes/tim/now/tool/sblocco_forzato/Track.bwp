    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/FileTappo/"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/InputTrackFile"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/ManageMoveFile"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/FileTappo"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogStartTrack-input" sca-bpel:internal="true"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="LoggerName" type="xsd:string"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="LogLevel" type="xsd:string"/>
        <bpws:variable element="ns1:InputFileTappo" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogEndTrack-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:Input" name="InputTracking"/>
        <bpws:variable element="ns3:InputData" name="MovedFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:OutputData" name="MovedFile" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:Input" name="Track-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:InputFileTappo"
            name="FindFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:OutputFileTappo" name="FindFile" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartTrackToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="InputTrackToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="InputTrackToCallProcess1_KO"
                    tibex:label="KO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcess1ToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="InputKOToLogEndTrack" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToLogEndTrack" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToInputTrack" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="013ec9ca-6899-4d38-bb29-144f4bdd107f"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="4406c876-985e-4340-8eaf-e2325fafa378" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStartTrack-input"
                    name="LogStartTrack"
                    tibex:xpdlId="ce484ac5-513c-4523-8317-12d744ad0e46"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartTrackToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileTappo/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogStartTrack-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.tool.sbloccoForzatoOK'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Track'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Track'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Track'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:TransactionID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:TransactionID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start Track',tib:render-xml($Start,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogEndTrack-input"
                    name="LogEndTrack"
                    tibex:xpdlId="fb413728-7ed7-496b-a3dc-92c92ed64a33"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InputKOToLogEndTrack"/>
                        <bpws:target linkName="CallProcessToLogEndTrack"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileTappo/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogEndTrack-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.tool.sbloccoForzatoOK'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Track'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Track'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Track'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:TransactionID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:TransactionID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;'End TrackFile'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="InputTracking"
                    name="InputTrack" outputVariable="InputTracking"
                    tibex:xpdlId="bc5b4f01-713d-40b9-adf3-e4bda5efa452" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToInputTrack"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InputTrackToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="InputTrackToCallProcess1_KO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$InputTracking/ns2:INSERT/ns2:STATO='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InputTracking/ns2:INSERT/ns2:STATO='KO']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileTappo/&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:template name=&quot;InputTracking&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:INSERT>&lt;xsl:if test=&quot;$Start/tns2:Sistema&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;$Start/tns2:Sistema&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns2:Flusso, 'ERROR') and $FindFile/tns1:Esito='ERROR'&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;concat($Start/tns2:Flusso,&amp;quot; AND NO_FILE_FOUND&amp;quot;)&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns2:Flusso&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns2:Flusso&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$FindFile/tns1:FileName&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$FindFile/tns1:FileName&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile/tns1:FullName&quot;>&lt;tns:PATH_SORGENTE>&lt;xsl:value-of select=&quot;$FindFile/tns1:FullName&quot;/>&lt;/tns:PATH_SORGENTE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns2:Flusso, 'ERROR') and $FindFile/tns1:Esito='OK'&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:STATO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:STATO>&lt;xsl:value-of select=&quot;$FindFile/tns1:Esito&quot;/>&lt;/tns:STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns2:Flusso, 'ERROR') &quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if (contains($Start/tns2:Flusso,'ERROR_DATA_FILE'))  then&amp;#xD;&amp;#xA; concat(&amp;quot;***ERRORE: DATA NON VALIDA NEL NOME DEL FILE &amp;quot; , $FindFile/tns1:FileName, &amp;quot; &amp;quot;, $FindFile/tns1:DESCR_ERRORE)&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;else  concat(&amp;quot;***ERRORE: NAMING CONVENTION DEL FILE NON RISPETTATA  &amp;quot; , $FindFile/tns1:FileName, &amp;quot; &amp;quot;, $FindFile/tns1:DESCR_ERRORE)&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$FindFile/tns1:DESCR_ERRORE&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$FindFile/tns1:DESCR_ERRORE&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($FindFile/tns1:Size)>0&quot;>&lt;tns:FILE_SIZE>&lt;xsl:value-of select=&quot;xsd:int($FindFile/tns1:Size)&quot;/>&lt;/tns:FILE_SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:Flag_parent&quot;>&lt;tns:FLAG_PARENT>&lt;xsl:value-of select=&quot;$Start/tns2:Flag_parent&quot;/>&lt;/tns:FLAG_PARENT>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile/tns1:PathFileTappo&quot;>&lt;tns:PATH_FILEINNESCO>&lt;xsl:value-of select=&quot;$FindFile/tns1:PathFileTappo&quot;/>&lt;/tns:PATH_FILEINNESCO>&lt;/xsl:if>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:INSERT>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="InputTracking" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="MovedFile-input"
                    name="MovedFile" outputVariable="MovedFile"
                    tibex:xpdlId="6cb0b56f-6e8a-4150-9221-c50df93afa22"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InputTrackToCallProcess1_KO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileTappo/&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:template name=&quot;MovedFile-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;xsl:if test=&quot;$FindFile/tns:FullName&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$FindFile/tns:FullName&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:PathError&quot;>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$Start/tns2:PathError&quot;/>&lt;/tns1:FolderDestinazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile/tns:FileName&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$FindFile/tns:FileName&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;tns1:LogInput>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns2:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$Start/tns2:LogName&quot;/>&lt;/tns1:LogName>&lt;/tns1:LogInput>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
