                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputTracking&quot;/>&lt;xsl:param name=&quot;MovedFile&quot;/>&lt;xsl:template name=&quot;InputTracking&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:INSERT>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:SISTEMA&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:SISTEMA&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:FLUSSO&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:FLUSSO&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:NOME_FILE&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:NOME_FILE&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:DATA_FILE&quot;>&lt;tns:DATA_FILE>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:DATA_FILE&quot;/>&lt;/tns:DATA_FILE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MovedFile/tns1:FullPathMovedFile)>0&quot;>&lt;xsl:if test=&quot;$MovedFile/tns1:FullPathMovedFile&quot;>&lt;tns:PATH_SORGENTE>&lt;xsl:value-of select=&quot;$MovedFile/tns1:FullPathMovedFile&quot;/>&lt;/tns:PATH_SORGENTE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:PATH_SORGENTE&quot;>&lt;tns:PATH_SORGENTE>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:PATH_SORGENTE&quot;/>&lt;/tns:PATH_SORGENTE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:DESCR_ERRORE&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:DESCR_ERRORE&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:FILE_SIZE&quot;>&lt;tns:FILE_SIZE>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:FILE_SIZE&quot;/>&lt;/tns:FILE_SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:ID_FILE&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:ID_AGGIUNTIVO&quot;>&lt;tns:ID_AGGIUNTIVO>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:ID_AGGIUNTIVO&quot;/>&lt;/tns:ID_AGGIUNTIVO>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTracking/tns:INSERT/tns:FLAG_PARENT&quot;>&lt;tns:FLAG_PARENT>&lt;xsl:value-of select=&quot;$InputTracking/tns:INSERT/tns:FLAG_PARENT&quot;/>&lt;/tns:FLAG_PARENT>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$InputTracking/tns:INSERT/tns:LogElement&quot;/>&lt;/tns:INSERT>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
