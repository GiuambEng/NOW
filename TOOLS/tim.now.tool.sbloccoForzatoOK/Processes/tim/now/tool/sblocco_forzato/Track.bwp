                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FileTappo/&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;FindFile-input&quot; match=&quot;/&quot;>&lt;tns1:InputFileTappo>&lt;tns1:FileName>&lt;xsl:value-of select=&quot;$Start/tns:FileName&quot;/>&lt;/tns1:FileName>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$Start/tns:LogName&quot;/>&lt;/tns1:LogName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:ApplicationName>&lt;xsl:value-of select=&quot;$Start/tns:ApplicationName&quot;/>&lt;/tns1:ApplicationName>&lt;xsl:if test=&quot;$Start/tns:ID_PROCSO_FILE&quot;>&lt;tns1:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;$Start/tns:ID_PROCSO_FILE&quot;/>&lt;/tns1:ID_PROCSO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:ID_INTRFC&quot;>&lt;tns1:ID_INTRFC>&lt;xsl:value-of select=&quot;$Start/tns:ID_INTRFC&quot;/>&lt;/tns1:ID_INTRFC>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Estensione&quot;>&lt;tns1:Estensione>&lt;xsl:value-of select=&quot;$Start/tns:Estensione&quot;/>&lt;/tns1:Estensione>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Sistema&quot;>&lt;tns1:Sistema>&lt;xsl:value-of select=&quot;$Start/tns:Sistema&quot;/>&lt;/tns1:Sistema>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Flusso&quot;>&lt;tns1:Flusso>&lt;xsl:value-of select=&quot;$Start/tns:Flusso&quot;/>&lt;/tns1:Flusso>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:PathError&quot;>&lt;tns1:PathError>&lt;xsl:value-of select=&quot;$Start/tns:PathError&quot;/>&lt;/tns1:PathError>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:PathMovedTappo&quot;>&lt;tns1:PathMovedTappo>&lt;xsl:value-of select=&quot;$Start/tns:PathMovedTappo&quot;/>&lt;/tns1:PathMovedTappo>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Flag_parent&quot;>&lt;tns1:Flag_parent>&lt;xsl:value-of select=&quot;$Start/tns:Flag_parent&quot;/>&lt;/tns1:Flag_parent>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Flag_SFTP_Mode&quot;>&lt;tns1:Flag_SFTP_Mode>&lt;xsl:value-of select=&quot;$Start/tns:Flag_SFTP_Mode&quot;/>&lt;/tns1:Flag_SFTP_Mode>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns:SFTPInputData&quot;>&lt;tns1:SFTPInputData>&lt;xsl:if test=&quot;tns:Host&quot;>&lt;tns1:Host>&lt;xsl:value-of select=&quot;tns:Host&quot;/>&lt;/tns1:Host>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Port&quot;>&lt;tns1:Port>&lt;xsl:value-of select=&quot;tns:Port&quot;/>&lt;/tns1:Port>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:User&quot;>&lt;tns1:User>&lt;xsl:value-of select=&quot;tns:User&quot;/>&lt;/tns1:User>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Password&quot;>&lt;tns1:Password>&lt;xsl:value-of select=&quot;tns:Password&quot;/>&lt;/tns1:Password>&lt;/xsl:if>&lt;/tns1:SFTPInputData>&lt;/xsl:for-each>&lt;/tns1:InputFileTappo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
