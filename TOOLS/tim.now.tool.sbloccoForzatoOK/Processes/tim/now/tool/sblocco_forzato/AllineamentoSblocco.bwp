select=&quot;xsd:int($var)&quot;/>&lt;/tns:NUMERO_RECD>&lt;xsl:if test=&quot;tns1:NUMBER&quot;>&lt;tns:NUMERO_TELEFONICO>&lt;xsl:value-of select=&quot;tns1:NUMBER&quot;/>&lt;/tns:NUMERO_TELEFONICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:PRIMARY_NUMBER&quot;>&lt;tns:NUMERO_TELEFONICO_PRINC>&lt;xsl:value-of select=&quot;tns1:PRIMARY_NUMBER&quot;/>&lt;/tns:NUMERO_TELEFONICO_PRINC>&lt;/xsl:if>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;tib:trim(tns1:ID_RICHIESTA_OLO)&quot;/>&lt;/tns:ID_RICH_OLO>&lt;tns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_INSMTO>&lt;/tns:SbloccoForzato_dettaglio>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:SbloccoForzato_Dettaglio&quot;>&lt;tns:SbloccoForzato_dettaglio>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&lt;tns:CONTENUTO_RECORD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&lt;/tns:CONTENUTO_RECORD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns1:RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:int($var1)&quot;/>&lt;/tns:NUMERO_RECD>&lt;xsl:if test=&quot;tns1:NUMBER&quot;>&lt;tns:NUMERO_TELEFONICO>&lt;xsl:value-of select=&quot;tns1:NUMBER&quot;/>&lt;/tns:NUMERO_TELEFONICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:PRIMARY_NUMBER&quot;>&lt;tns:NUMERO_TELEFONICO_PRINC>&lt;xsl:value-of select=&quot;tns1:PRIMARY_NUMBER&quot;/>&lt;/tns:NUMERO_TELEFONICO_PRINC>&lt;/