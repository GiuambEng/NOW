                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="CallProcess2-input"
                                name="CallProcess2"
                                tibex:xpdlId="8e358974-f6bb-4661-b3a9-c935d563f44c"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToCallProcess2"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcess2ToCallProcess3"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;CallProcess2-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:FLAG_LAVORAZIONE>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:FLAG_LAVORAZIONE>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:STATO>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat('***KO TECNICO ***          ' , tib:render-xml($FaultDetails, true(), true()))&quot;/>&lt;/tns:DESCR_ERRORE>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&lt;/tns:ID_TRACK>&lt;xsl:if test=&quot;string-length(xsd:string($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE))>0&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Update>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.TrackFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="CallProcess3-input"
                                name="CallProcess3"
                                outputVariable="CallProcess3"
                                tibex:xpdlId="c84bf79d-654d-4d0e-8da5-b40e548e6ddb"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess2ToCallProcess3"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcess3ToExit2"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;CallProcess3-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:DataIn>&lt;tns:Update>&lt;tns:InputFile>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&lt;/tns:ID_FILE>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON ERRORE'&quot;/>&lt;/tns:STATO_ESEC>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&lt;/tns:DESCR_STATO_FILE>&lt;tns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT CORROTTO&amp;quot;&quot;/>&lt;/tns:LOG_MESSAGE>&lt;/tns:InputFile>&lt;/tns:Update>&lt;/tns:DataIn>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:exit name="Exit2" tibex:xpdlId="f161d9b6-a3e3-4df0-bd59-d94e39a69944">
