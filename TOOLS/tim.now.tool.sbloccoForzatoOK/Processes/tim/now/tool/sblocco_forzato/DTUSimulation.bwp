                                    columnName="ID_STATO_ELAB_STAG"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUMERO_RECORD"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUMERO_TELEFONICO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
