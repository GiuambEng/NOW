                                <bpws:link
                                    name="JMSSendMessageToAssign2" tibex:linkType="ERROR"/>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQueryToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogSelectNF_Foundrecord"
                                    tibex:label="Found record" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="ParseXmlToCreazioneNotifica" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ParseXmlToAssign" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="UpdateStagingKOToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Assign1ToUpdateStagingKO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="AssignToUpdateStagingKO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Assign2ToUpdateStagingKO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogSelectNF_EspletamentoToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="cb937258-92aa-4f88-a4ec-35e7f6536b70">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="3ed3a7e7-3891-4ee1-b7ff-d02df18f04ea">
                                <bpws:targets>
                                    <bpws:target linkName="JMSSendMessageToGroupEnd"/>
                                    <bpws:target linkName="UpdateStagingKOToGroupEnd"/>
                                    <bpws:target linkName="LogSelectNF_EspletamentoToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="CreazioneNotifica-input"
                                    name="CreazioneNotifica"
                                    outputVariable="CreazioneNotifica"
                                    tibex:xpdlId="ef8f3695-bbd8-4135-9470-76a35cb0dd61" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ParseXmlToCreazioneNotifica"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToCallProcess"/>
                                    <bpws:source
                                    linkName="CreazioneNotificaToAssign1"
                                    tibex:faultDetailsVar="CreazioneNotifica" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;!--START COERCIONS-->&#xa;&lt;!-- $ParseXml/tns:Body/*, element, ns:EVENTO_NOTIFICA -->&#xa;&lt;!-- $ParseXml/tns:Header/*, element, h:Header -->&#xa;&lt;!--END COERCIONS-->&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&lt;xsl:import-schema namespace=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; schema-location=&quot;../../../../../../tim.now.shared_library/Schemas/CommonSchema/SOAPHeader_v1.1.xsd&quot;/>&lt;xsl:import-schema namespace=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; schema-location=&quot;../../../../../Schemas/Tracciati_Richiesta_Notifica_NOW_DTU.xsd&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:template name=&quot;CreazioneNotifica-input&quot; match=&quot;/&quot;>&lt;tns:Envelope>&lt;xsl:copy-of select=&quot;$ParseXml/tns:Header&quot;/>&lt;tns:Body>&lt;xsl:copy-of select=&quot;$ParseXml/tns:Body/ns:EVENTO_NOTIFICA&quot;/>&lt;/tns:Body>&lt;/tns:Envelope>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:envelope="http://schemas.xmlsoap.org/soap/envelope/"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="envelope:Envelope" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogCreazioneNotifica-input"
                                    name="LogCreazioneNotifica"
                                    tibex:xpdlId="0f2126c8-846e-46e4-b543-fb8255fd1ec8"
