<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/ValidaDatiStaging" xmlns:tns="http://www.example.org/ValidaDatiStaging" 
	elementFormDefault="qualified">
	<complexType name="ValidaDatiStagingType">
		<sequence>
			<element minOccurs="1" type="string" name="RowID"/>
			<element minOccurs="0" type="integer" name="IdAsset"/>
			<element minOccurs="1" type="integer" name="IdStatoElabStag"/>
			<element minOccurs="1" type="dateTime" name="TimestampIns"/>
			<element minOccurs="1" type="string" name="Operatore"/>
			<element minOccurs="1" type="string" name="Nota"/>
			<element minOccurs="0" type="dateTime" name="TimestampAgg"/>
			<element minOccurs="0" type="integer" name="IdStoricoAsset"/>
		</sequence>	
	</complexType>
	
	<element name="ValidazioneDatiInStagingRequest">
    	<complexType>
    		<sequence>
    			<element minOccurs="1" name="Casistica">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="ELIMINA" />
    						<enumeration value="RIPRISTINA" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element minOccurs="0" maxOccurs="unbounded" type="tns:ValidaDatiStagingType" name="DatiStaging" />
    		</sequence>
    	</complexType>
    </element>

</schema>