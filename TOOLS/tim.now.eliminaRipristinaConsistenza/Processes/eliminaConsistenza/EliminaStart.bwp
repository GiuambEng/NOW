    <tibex:VariableDescriptor type="MemorySaving">
        <task name="StartTimer">
            <endingVariables>
                <variable>StartTimer</variable>
            </endingVariables>
        </task>
        <task name="LogStart">
            <endingVariables>
                <variable>LogStart-input</variable>
            </endingVariables>
        </task>
        <task name="StagEliminaAssetNoFile">
            <endingVariables>
                <variable>StagEliminaAssetNoFile-input</variable>
            </endingVariables>
        </task>
        <task name="LogStagEliminaAssetNoFile">
            <endingVariables>
                <variable>LogStagEliminaAssetNoFile-input</variable>
            </endingVariables>
        </task>
        <task name="LogEnd">
            <endingVariables>
                <variable>LogEnd-input</variable>
                <variable>logLevel</variable>
            </endingVariables>
        </task>
        <task name="ValidazioneDatiInStaging">
            <endingVariables>
                <variable>ValidazioneDatiInStaging-input</variable>
                <variable>StagEliminaAssetNoFile</variable>
            </endingVariables>
        </task>
        <task name="LogError">
            <endingVariables>
                <variable>LogError-input</variable>
                <variable>logLevelError</variable>
                <variable>FaultName</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
