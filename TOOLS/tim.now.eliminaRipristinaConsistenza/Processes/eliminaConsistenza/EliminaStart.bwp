            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="ValidazioneDatiInStaging-input"
                    name="ValidazioneDatiInStaging"
                    tibex:xpdlId="0bf1b8bf-89a7-4113-86b1-ac7dfff6b534"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStagEliminaAssetNoFileToValidazioneDatiInStaging1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ValidazioneDatiInStaging1ToMovimentazioneConsistenza1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ValidaDatiStaging&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StagEliminaAssetNoFile&quot;/>&lt;xsl:template name=&quot;ValidazioneDatiInStaging-input&quot; match=&quot;/&quot;>&lt;tns:ValidazioneDatiInStagingRequest>&lt;tns:Casistica>&lt;xsl:value-of select=&quot;'ELIMINA'&quot;/>&lt;/tns:Casistica>&lt;xsl:for-each select=&quot;$StagEliminaAssetNoFile/Record&quot;>&lt;tns:DatiStaging>&lt;tns:RowID>&lt;xsl:value-of select=&quot;ROWID&quot;/>&lt;/tns:RowID>&lt;tns:IdAsset>&lt;xsl:value-of select=&quot;xsd:integer(ID_ASSET)&quot;/>&lt;/tns:IdAsset>&lt;tns:IdStatoElabStag>&lt;xsl:value-of select=&quot;xsd:integer(ID_STATO_ELAB_STAG)&quot;/>&lt;/tns:IdStatoElabStag>&lt;tns:TimestampIns>&lt;xsl:value-of select=&quot;TIMESTAMP_INS&quot;/>&lt;/tns:TimestampIns>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;OPERATORE&quot;/>&lt;/tns:Operatore>&lt;tns:Nota>&lt;xsl:value-of select=&quot;NOTA&quot;/>&lt;/tns:Nota>&lt;xsl:if test=&quot;TIMESTAMP_AGG&quot;>&lt;tns:TimestampAgg>&lt;xsl:value-of select=&quot;TIMESTAMP_AGG&quot;/>&lt;/tns:TimestampAgg>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string(ID_STORI_ASSET)) > 0&quot;>&lt;tns:IdStoricoAsset>&lt;xsl:value-of select=&quot;xsd:integer(ID_STORI_ASSET)&quot;/>&lt;/tns:IdStoricoAsset>&lt;/xsl:if>&lt;/tns:DatiStaging>&lt;/xsl:for-each>&lt;/tns:ValidazioneDatiInStagingRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="validaMovimenta.ValidazioneDatiInStaging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
