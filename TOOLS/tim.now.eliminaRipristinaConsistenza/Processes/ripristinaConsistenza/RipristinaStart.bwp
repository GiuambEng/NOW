    <tibex:VariableDescriptor type="MemorySaving">
        <task name="StartTimer">
            <endingVariables>
                <variable>StartTimer</variable>
            </endingVariables>
        </task>
        <task name="LogStart">
            <endingVariables>
                <variable>LogStart-input</variable>
            </endingVariables>
        </task>
        <task name="StagRipriAssetNoFile">
            <endingVariables>
                <variable>StagRipriAssetNoFile-input</variable>
            </endingVariables>
        </task>
        <task name="LogStagRipriAssetNoFile">
            <endingVariables>
                <variable>LogStagRipriAssetNoFile-input</variable>
            </endingVariables>
        </task>
        <task name="LogEnd">
            <endingVariables>
                <variable>LogEnd-input</variable>
                <variable>logLevel</variable>
            </endingVariables>
        </task>
        <task name="ValidazioneDatiInStaging1">
            <endingVariables>
                <variable>ValidazioneDatiInStaging1-input</variable>
                <variable>StagRipriAssetNoFile</variable>
            </endingVariables>
        </task>
        <task name="LogError">
            <endingVariables>
                <variable>LogError-input</variable>
                <variable>logLevelError</variable>
                <variable>FaultName</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
