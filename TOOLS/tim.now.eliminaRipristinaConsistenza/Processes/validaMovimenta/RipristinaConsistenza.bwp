    xmlns:ns5="http://www.tibco.com/namespaces/tnt/plugins/jdbc+3e611265-cc8f-4bbb-8537-a60dd8e67f57+input"
    xmlns:ns6="http://www.tibco.com/namespaces/tnt/plugins/jdbc"
