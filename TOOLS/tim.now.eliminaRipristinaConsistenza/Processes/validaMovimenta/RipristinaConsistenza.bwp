                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseAsset&quot;/>&lt;xsl:param name=&quot;newIDAsset&quot;/>&lt;xsl:template name=&quot;RenderAsset2-input&quot; match=&quot;/&quot;>&lt;ns:AssetElement>&lt;IDAsset>&lt;xsl:value-of select=&quot;$newIDAsset&quot;/>&lt;/IDAsset>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$ParseAsset/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$ParseAsset/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$ParseAsset/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$ParseAsset/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$ParseAsset/invariante&quot;>&lt;invariante>&lt;xsl:value-of select=&quot;$ParseAsset/invariante&quot;/>&lt;/invariante>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$ParseAsset/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$ParseAsset/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$ParseAsset/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$ParseAsset/operatore&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$ParseAsset/IDRichiestaOLO&quot;>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$ParseAsset/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseAsset/IDPrimoOrdine&quot;>&lt;IDPrimoOrdine>&lt;xsl:value-of select=&quot;$ParseAsset/IDPrimoOrdine&quot;/>&lt;/IDPrimoOrdine>&lt;/xsl:if>&lt;IDContratto>&lt;xsl:value-of select=&quot;$ParseAsset/IDContratto&quot;/>&lt;/IDContratto>&lt;xsl:if test=&quot;$ParseAsset/DEC&quot;>&lt;DEC>&lt;xsl:value-of select