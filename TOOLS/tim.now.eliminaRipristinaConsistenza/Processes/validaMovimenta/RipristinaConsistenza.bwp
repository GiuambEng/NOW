    xmlns:tibprop="http://ns.tibco.com/bw/property" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="LogStart">
            <endingVariables>
                <variable>LogStart-input</variable>
            </endingVariables>
        </task>
        <task name="StagRipriAssetNoFile">
            <endingVariables>
                <variable>StagRipriAssetNoFile-input</variable>
            </endingVariables>
        </task>
        <task name="LogStagRipriAssetNoFile">
            <endingVariables>
                <variable>LogStagRipriAssetNoFile-input</variable>
            </endingVariables>
        </task>
        <task name="While">
            <endingVariables>
                <variable>StagRipriAssetNoFile</variable>
                <variable>index</variable>
                <variable>logLevelError</variable>
                <variable>loggerName</variable>
                <variable>logLevel</variable>
            </endingVariables>
        </task>
        <task name="LogIterazione">
            <endingVariables>
                <variable>LogIterazione-input</variable>
            </endingVariables>
        </task>
        <task name="StoricoAsset">
            <endingVariables>
                <variable>StoricoAsset-input</variable>
            </endingVariables>
        </task>
        <task name="LogStoricoAsset">
            <endingVariables>
                <variable>LogStoricoAsset-input</variable>
            </endingVariables>
        </task>
        <task name="UpdStatoElabKO_NoCase">
            <endingVariables>
                <variable>UpdStatoElabKO_NoCase-input</variable>
                <variable>UpdStatoElabKO_NoCase</variable>
            </endingVariables>
        </task>
        <task name="CreateCase">
            <endingVariables>
                <variable>CreateCase-input</variable>
                <variable>RenderAsset1</variable>
            </endingVariables>
        </task>
        <task name="LogCreateCase">
            <endingVariables>
                <variable>LogCreateCase-input</variable>
            </endingVariables>
        </task>
        <task name="UpdStatoElabOK">
            <endingVariables>
                <variable>UpdStatoElabOK-input</variable>
                <variable>UpdStatoElabOK</variable>
            </endingVariables>
        </task>
        <task name="ParseAsset">
            <endingVariables>
                <variable>ParseAsset-input</variable>
                <variable>StoricoAsset</variable>
            </endingVariables>
        </task>
        <task name="LogParse">
            <endingVariables>
                <variable>LogParse-input</variable>
            </endingVariables>
        </task>
        <task name="RenderAsset1">
            <endingVariables>
                <variable>RenderAsset1-input</variable>
            </endingVariables>
        </task>
        <task name="UpdateCase">
            <endingVariables>
                <variable>UpdateCase-input</variable>
                <variable>CreateCase</variable>
                <variable>RenderAsset2</variable>
            </endingVariables>
        </task>
        <task name="LogUpdateCase">
            <endingVariables>
                <variable>LogUpdateCase-input</variable>
                <variable>UpdateCase</variable>
            </endingVariables>
        </task>
        <task name="RenderAsset2">
            <endingVariables>
                <variable>RenderAsset2-input</variable>
                <variable>ParseAsset</variable>
            </endingVariables>
        </task>
        <task name="LogRender2">
            <endingVariables>
                <variable>LogRender2-input</variable>
            </endingVariables>
        </task>
        <task name="LogFault">
            <endingVariables>
                <variable>LogFault-input</variable>
                <variable>FaultDetails1</variable>
            </endingVariables>
        </task>
        <task name="UpdStatoElabKO_Fault">
            <endingVariables>
                <variable>UpdStatoElabKO_Fault-input</variable>
                <variable>UpdStatoElabKO_Fault</variable>
            </endingVariables>
        </task>
        <task name="LogEndWhile">
            <endingVariables>
                <variable>LogEndWhile-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="http://www.tibco.com/pe/EngineTypes"
            xmlns:tns="http://www.tibco.com/pe/EngineTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
