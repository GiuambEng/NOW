<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no"
    name="validaMovimenta.EliminaConsistenza" suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20191125152317"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.tim.com/NOW/xsd/GenericLogger"
    xmlns:ns1="http://www.tibco.com/namespaces/tnt/plugins/jdbc+f369efab-b440-48ad-a145-1a9265c4dc0d+input"
    xmlns:ns10="http://www.tibco.com/namespaces/tnt/plugins/jdbc+ac8c13e6-cdf7-4bec-a9bf-23ca9a3d2751+input"
    xmlns:ns11="http://www.tibco.com/namespaces/tnt/plugins/jdbc+ac8c13e6-cdf7-4bec-a9bf-23ca9a3d2751+output"
    xmlns:ns12="http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions"
    xmlns:ns13="http://www.tibco.com/namespaces/tnt/plugins/jdbc+97820792-d3c3-4a66-ba00-2ebb7c0a3c59+input"
    xmlns:ns14="http://www.tibco.com/namespaces/tnt/plugins/jdbc+2f1055cd-e5c4-4a20-ae4f-27c1cf591258+input"
    xmlns:ns15="http://www.tibco.com/namespaces/tnt/plugins/jdbc+a758b43f-ac85-43c3-938e-b88eab964b26+input"
    xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/jdbc+f369efab-b440-48ad-a145-1a9265c4dc0d+output"
    xmlns:ns3="http://xmlns.example.com/20191125152317PLT"
    xmlns:ns4="http://services.bds.tibco.com/BusinessDataServices_1.2.0"
    xmlns:ns5="http://api.bds.tibco.com"
    xmlns:ns6="http://www.tibco.com/namespaces/tnt/plugins/parsexml"
    xmlns:ns7="http://NOW.it.telecomitalia.it/casedata"
    xmlns:ns8="http://www.tibco.com/namespaces/tnt/plugins/jdbc+0d7ab63b-5de8-44f3-8dff-6a385c048ab9+input"
    xmlns:ns9="http://www.tibco.com/namespaces/tnt/plugins/jdbc"
    xmlns:sca="http://docs.oasis-open.org/ns/opencsa/sca/200912"
    xmlns:sca-bpel="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"
    xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"
    xmlns:tibprop="http://ns.tibco.com/bw/property" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="LogStart">
            <endingVariables>
                <variable>LogStart-input</variable>
            </endingVariables>
        </task>
        <task name="StagEliminaAssetNoFile">
            <endingVariables>
                <variable>StagEliminaAssetNoFile-input</variable>
            </endingVariables>
        </task>
        <task name="LogStagEliminaAsset">
            <endingVariables>
                <variable>LogStagEliminaAsset-input</variable>
            </endingVariables>
        </task>
        <task name="While">
            <endingVariables>
                <variable>StagEliminaAssetNoFile</variable>
                <variable>index</variable>
                <variable>logLevelError</variable>
            </endingVariables>
        </task>
        <task name="findCase">
            <endingVariables>
                <variable>findCase-input</variable>
            </endingVariables>
        </task>
        <task name="LogIterazione">
            <endingVariables>
                <variable>LogIterazione-input</variable>
            </endingVariables>
        </task>
        <task name="LogFindCase">
            <endingVariables>
                <variable>LogFindCase-input</variable>
            </endingVariables>
        </task>
        <task name="readCasee">
            <endingVariables>
                <variable>readCasee-input</variable>
                <variable>findCase</variable>
            </endingVariables>
        </task>
        <task name="LogReadCase">
            <endingVariables>
                <variable>LogReadCase-input</variable>
            </endingVariables>
        </task>
        <task name="ParseAsset">
            <endingVariables>
                <variable>ParseAsset-input</variable>
            </endingVariables>
        </task>
        <task name="OpRete">
            <endingVariables>
                <variable>OpRete-input</variable>
            </endingVariables>
        </task>
        <task name="LogOpRete">
            <endingVariables>
                <variable>LogOpRete-input</variable>
            </endingVariables>
        </task>
        <task name="LogEndWhile">
            <endingVariables>
                <variable>LogEndWhile-input</variable>
            </endingVariables>
        </task>
        <task name="UpdStatoElabKO_NoCase">
            <endingVariables>
                <variable>UpdStatoElabKO_NoCase-input</variable>
                <variable>UpdStatoElabKO_NoCase</variable>
            </endingVariables>
        </task>
        <task name="StoricoAsset">
            <endingVariables>
                <variable>StoricoAsset-input</variable>
                <variable>StoricoAsset</variable>
                <variable>ParseAsset</variable>
                <variable>OpRete</variable>
            </endingVariables>
        </task>
        <task name="LogStoricoAsset">
            <endingVariables>
                <variable>LogStoricoAsset-input</variable>
            </endingVariables>
        </task>
        <task name="DeleteCase">
            <endingVariables>
                <variable>DeleteCase-input</variable>
                <variable>DeleteCase</variable>
                <variable>readCasee</variable>
                <variable>UnlinkCase</variable>
            </endingVariables>
        </task>
        <task name="UpdStatoElabOK">
            <endingVariables>
                <variable>UpdStatoElabOK-input</variable>
                <variable>UpdStatoElabOK</variable>
            </endingVariables>
        </task>
        <task name="LogEndIterazione">
            <endingVariables>
                <variable>LogEndIterazione-input</variable>
            </endingVariables>
        </task>
        <task name="NavigateCaseDatailed">
            <endingVariables>
                <variable>NavigateCaseDatailed-input</variable>
            </endingVariables>
        </task>
        <task name="LogNavigate">
            <endingVariables>
                <variable>LogNavigate-input</variable>
            </endingVariables>
        </task>
        <task name="UnlinkCase">
            <endingVariables>
                <variable>UnlinkCase-input</variable>
                <variable>NavigateCaseDatailed</variable>
            </endingVariables>
        </task>
        <task name="LogUnlink">
            <endingVariables>
                <variable>LogUnlink-input</variable>
            </endingVariables>
        </task>
        <task name="LogFault">
            <endingVariables>
                <variable>LogFault-input</variable>
                <variable>FaultDetails1</variable>
            </endingVariables>
        </task>
        <task name="UpdStatoElabKO">
            <endingVariables>
                <variable>UpdStatoElabKO-input</variable>
                <variable>UpdStatoElabKO</variable>
            </endingVariables>
        </task>
        <task name="LogEnd">
            <endingVariables>
                <variable>LogEnd-input</variable>
                <variable>loggerName</variable>
                <variable>logLevel</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="http://www.tibco.com/pe/EngineTypes"
            xmlns:tns="http://www.tibco.com/pe/EngineTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:complexType block="extension restriction"
                final="extension restriction" name="ErrorReport">
                <xs:sequence>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="StackTrace" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="Msg" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="FullClass" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="Class" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="ProcessStack" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0" name="MsgCode" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0" name="Data" type="tns:anydata"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType block="extension restriction"
                final="extension restriction" name="OptionalErrorReport">
                <xs:sequence>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0"
                        name="StackTrace" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0" name="Msg" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0"
                        name="FullClass" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0" name="Class" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0"
                        name="ProcessStack" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0" name="MsgCode" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0" name="Data" type="tns:anydata"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType block="extension restriction"
                final="extension restriction" name="FaultDetail">
                <xs:sequence>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="ActivityName" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0" name="Data" type="tns:anydata"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="Msg" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="MsgCode" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="ProcessStack" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="StackTrace" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="FullClass" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="Class" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
            <xs:complexType block="extension restriction"
                final="extension restriction" name="ProcessContext">
                <xs:sequence>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="JobId" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="ApplicationName" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="EngineName" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" name="ProcessInstanceId" type="xs:string"/>
                    <xs:element
                        block="extension restriction substitution"
                        form="unqualified" minOccurs="0"
                        name="CustomJobId" type="xs:string"/>
                    <!--xs:element name="RestartedFromCheckpoint" form="unqualified" block="extension restriction substitution" type="xs:boolean"/-->
                    <!--xs:element minOccurs="0" maxOccurs="unbounded" name="TrackingInfo" form="unqualified" block="extension restriction substitution" type="xs:string"/-->
                </xs:sequence>
            </xs:complexType>
            <xs:complexType block="extension restriction"
                final="extension restriction" name="anydata">
                <xs:sequence>
                    <xs:any namespace="##any" processContents="lax"/>
                </xs:sequence>
            </xs:complexType>
            <xs:element block="extension restriction substitution"
                final="extension restriction" name="OptionalErrorReport" type="tns:OptionalErrorReport"/>
            <xs:element block="extension restriction substitution"
                final="extension restriction" name="ErrorReport" type="tns:ErrorReport"/>
            <xs:element block="extension restriction substitution"
                final="extension restriction" name="FaultDetail" type="tns:FaultDetail"/>
            <xs:element block="extension restriction substitution"
                final="extension restriction" name="ProcessContext" type="tns:ProcessContext"/>
            <xs:element block="extension restriction substitution"
                final="extension restriction" name="CorrelationValue" type="xs:string"/>
        </xs:schema>
        <schema attributeFormDefault="unqualified"
            elementFormDefault="unqualified"
            targetNamespace="http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions"
            version="" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions">
            <complexType name="ActivityExceptionType">
                <sequence>
                    <element name="msg" type="string"/>
                    <element minOccurs="0" name="msgCode" type="string"/>
                </sequence>
            </complexType>
            <element name="ActivityException" type="tns:ActivityExceptionType"/>
            <complexType name="ActivityTimedOutExceptionType">
                <complexContent>
                    <extension base="tns:ActivityExceptionType"/>
                </complexContent>
            </complexType>
            <element name="ActivityTimedOutException" type="tns:ActivityTimedOutExceptionType"/>
            <complexType name="DuplicateKeyExceptionType">
                <complexContent>
                    <extension base="tns:ActivityExceptionType">
                        <sequence>
                            <element name="duplicateKey" type="string"/>
                            <element minOccurs="0" name="previousJobID" type="string"/>
                        </sequence>
                    </extension>
                </complexContent>
            </complexType>
            <element name="DuplicateKeyException" type="tns:DuplicateKeyExceptionType"/>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+f369efab-b440-48ad-a145-1a9265c4dc0d+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+f369efab-b440-48ad-a145-1a9265c4dc0d+input">
