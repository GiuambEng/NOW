                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STORICO_ASSET (CODFC_OLO_AGCOM, CONTENUTO_XML,&#xa;  DES, ID_ASSET_CRM, ID_RISORSA, ID_RISORSA_NOW, ID_ASSET, ID_ASSET_DA,&#xa;  ID_RICH_OLO, ID_STATO_ASSET, ID_STORICO_ASSET, NUMERO_TELEFONICO,&#xa;  ORA_DES, TIMSTP_INSMTO_STORICO, NUMERO_FITTIZIO, DISTR, ID_TPLG_OPERATORE,&#xa;  NOME, COGNOME_RAG_SOC, PARTITA_IVA, CF_NOME)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, S_STORICO_ASSET.nextval, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
