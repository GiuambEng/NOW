f select=&quot;current-time()&quot;/>&lt;/OraDes>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TimstpInsmtoStorico>&lt;xsl:value-of select=&quot;$ParseAsset/created&quot;/>&lt;/TimstpInsmtoStorico>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ParseAsset/numeroFittizio) > 0&quot;>&lt;NumeroFittizio>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseAsset/numeroFittizio)&quot;>&lt;xsl:value-of select=&quot;$ParseAsset/numeroFittizio&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NumeroFittizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NumeroFittizio xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ParseAsset/distretto) > 0&quot;>&lt;Distr>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseAsset/distretto)&quot;>&lt;xsl:value-of select=&quot;$ParseAsset/distretto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Distr>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Distr xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($OpRete/Record) > 0&quot;>&lt;IdTplgOperatore>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($OpRete/Record[1]/ID_TPLG_OPERATORE)&quot;>&lt;xsl:value-of select=&quot;$OpRete/Record[1]/ID_TPLG_OPERATORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IdTplgOperatore>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ParseAsset/operatoreRete) > 0 and string(number($ParseAsset/operatoreRete)) != 'NaN'&quot;>&lt;IdTplgOperatore>&lt;xsl:value-of select=&quot;xsd:int($ParseAsset/operatoreRete)&quot;/>&lt;/IdTplgOperatore>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IdTplgOperatore xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quo