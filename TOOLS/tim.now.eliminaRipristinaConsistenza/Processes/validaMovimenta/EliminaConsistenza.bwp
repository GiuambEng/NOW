        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+ac8c13e6-cdf7-4bec-a9bf-23ca9a3d2751+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+ac8c13e6-cdf7-4bec-a9bf-23ca9a3d2751+input">
            <element name="jdbcQueryActivityInput">
