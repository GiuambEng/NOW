                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CONTENUTO_XML, ID_RISORSA, ID_EVENTO_ORDN_NOW_WHLS, ID_RICH_JPUB, ID_RICH_OLO, IDTPLG_STATO_EVENTO_JPUB, NUMERO_TENTATIVI, TIMSTP_AGGTO, TIMSTP_INSMTO_EVENTO, ID_ORDINE_COMPOSTO, IDDETTAGLIOORDINE, FLAG_CONSUNTIVO, STRUTTURA_OFFERTA, OFFERTA, TIPO_AZIONE, CODICE_CAUSALE&#xd;&#xa;FROM APPUSER.EVENTO_JPUB WHERE ID_RISORSA= 'test_20230606'"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
