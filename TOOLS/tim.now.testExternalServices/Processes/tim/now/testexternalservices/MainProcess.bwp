                    inputVariable="ProcessName" name="ProcessName"
                    outputVariable="ProcessName"
                    tibex:xpdlId="f8d29bb5-3af7-4a0a-a1f7-85b8a73c54c3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToAssign"/>
