                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://olo2olo.npfibra.it/migrazione/" xmlns:h="http://telecomitalia.it/NOW/B2BRicarica/Header" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:template name="FastData-input" match="/"&gt;
        &lt;tns1:OLO_NPNotification&gt;
            &lt;Request&gt;
                &lt;tns1:NPNotification&gt;
                    &lt;tns1:OLO_NPNotification&gt;
                        &lt;tns1:codiceOperatoreDonor&gt;
                            &lt;xsl:value-of select="&amp;quot;WIN&amp;quot;"/&gt;
                        &lt;/tns1:codiceOperatoreDonor&gt;
                        &lt;tns1:codiceOrdineWHS&gt;
                            &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                        &lt;/tns1:codiceOrdineWHS&gt;
                        &lt;tns1:idNotifica&gt;
                            &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                        &lt;/tns1:idNotifica&gt;
                        &lt;tns1:dataNotifica&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns1:dataNotifica&gt;
                        &lt;tns1:tipoNotifica&gt;
                            &lt;xsl:value-of select="&amp;quot;01&amp;quot;"/&gt;
                        &lt;/tns1:tipoNotifica&gt;
                        &lt;tns1:numerazioniScartate&gt;
                            &lt;tns1:dn&gt;
                                &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                            &lt;/tns1:dn&gt;
                        &lt;/tns1:numerazioniScartate&gt;
                        &lt;tns1:codiceMotivazione&gt;
                            &lt;xsl:value-of select="&amp;quot;0&amp;quot;"/&gt;
                        &lt;/tns1:codiceMotivazione&gt;
                        &lt;tns1:motivazione&gt;
                            &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                        &lt;/tns1:motivazione&gt;
                    &lt;/tns1:OLO_NPNotification&gt;
                    &lt;tns1:Header&gt;
                        &lt;h:sourceSystem&gt;
                            &lt;xsl:value-of select="&amp;quot;WIN&amp;quot;"/&gt;
                        &lt;/h:sourceSystem&gt;
                        &lt;h:interactionDate&gt;
                            &lt;h:Date&gt;
                                &lt;xsl:value-of select="substring-before(xsd:string(current-date()),'+')"/&gt;
                            &lt;/h:Date&gt;
                            &lt;h:Time&gt;
                                &lt;xsl:value-of select="substring-before(xsd:string(current-time()),'+')"/&gt;
                            &lt;/h:Time&gt;
                        &lt;/h:interactionDate&gt;
                        &lt;h:businessID&gt;
                            &lt;xsl:value-of select="'businessID'"/&gt;
                        &lt;/h:businessID&gt;
                        &lt;h:messageID&gt;
                            &lt;xsl:value-of select="string(tib:timestamp())"/&gt;
                        &lt;/h:messageID&gt;
                        &lt;h:transactionID&gt;
                            &lt;xsl:value-of select="string(tib:timestamp())"/&gt;
                        &lt;/h:transactionID&gt;
                    &lt;/tns1:Header&gt;
                &lt;/tns1:NPNotification&gt;
            &lt;/Request&gt;
        &lt;/tns1:OLO_NPNotification&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:h=&quot;http://telecomitalia.it/NOW/B2BRicarica/Header&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;FastData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NPNotification>&#xa;            &lt;tns1:OLO_NPNotification>&#xa;                &lt;tns1:codiceOperatoreDonor>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;WIN&amp;quot;&quot;/>&#xa;                &lt;/tns1:codiceOperatoreDonor>&#xa;                &lt;tns1:codiceOrdineWHS>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                &lt;/tns1:codiceOrdineWHS>&#xa;                &lt;tns1:idNotifica>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                &lt;/tns1:idNotifica>&#xa;                &lt;tns1:dataNotifica>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:dataNotifica>&#xa;                &lt;tns1:tipoNotifica>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&#xa;                &lt;/tns1:tipoNotifica>&#xa;                &lt;tns1:numerazioniScartate>&#xa;                    &lt;tns1:dn>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:dn>&#xa;                &lt;/tns1:numerazioniScartate>&#xa;                &lt;tns1:codiceMotivazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                &lt;/tns1:codiceMotivazione>&#xa;                &lt;tns1:motivazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                &lt;/tns1:motivazione>&#xa;            &lt;/tns1:OLO_NPNotification>&#xa;            &lt;tns1:Header>&#xa;                &lt;h:sourceSystem>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;WIN&amp;quot;&quot;/>&#xa;                &lt;/h:sourceSystem>&#xa;                &lt;h:interactionDate>&#xa;                    &lt;h:Date>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-date()),'+')&quot;/>&#xa;                    &lt;/h:Date>&#xa;                    &lt;h:Time>&#xa;                        &lt;xsl:value-of select=&quot;substring-before(xsd:string(current-time()),'+')&quot;/>&#xa;                    &lt;/h:Time>&#xa;                &lt;/h:interactionDate>&#xa;                &lt;h:businessID>&#xa;                    &lt;xsl:value-of select=&quot;'businessID'&quot;/>&#xa;                &lt;/h:businessID>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;string(tib:timestamp())&quot;/>&#xa;                &lt;/h:messageID>&#xa;                &lt;h:transactionID>&#xa;                    &lt;xsl:value-of select=&quot;string(tib:timestamp())&quot;/>&#xa;                &lt;/h:transactionID>&#xa;            &lt;/tns1:Header>&#xa;        &lt;/tns1:NPNotification>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="FastDataToEnd"/>
                </bpws:sources>
            </bpws:invoke>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
