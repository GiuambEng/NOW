            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_Test_Extenal_Servervices/&quot; xmlns:tns1=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FastData&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Response>&lt;tns:External_Service_Output>&lt;xsl:value-of select=&quot;tib:render-xml($FastData/Response/tns1:Response,true(),true())&quot;/>&lt;/tns:External_Service_Output>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:ESITO>&lt;/tns:Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
