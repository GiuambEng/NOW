                        &lt;/DATA_RICHIESTA_PREVENTIVO&gt;
                        &lt;FLAG_PREVENTIVO&gt;
                            &lt;xsl:value-of select="&amp;quot;0&amp;quot;"/&gt;
                        &lt;/FLAG_PREVENTIVO&gt;
                        &lt;DETTAGLIO&gt;
