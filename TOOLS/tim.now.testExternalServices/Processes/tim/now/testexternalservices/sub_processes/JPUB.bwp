  &lt;FLAG_PREVENTIVO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                &lt;/FLAG_PREVENTIVO>&#xa;                &lt;DETTAGLIO>&#xa;                    &lt;ID_VOCE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/ID_VOCE>&#xa;                    &lt;QUANTITA>&#xa;                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                    &lt;/QUANTITA>&#xa;                &lt;/DETTAGLIO>&#xa;            &lt;/PREVENTIVO>&#xa;        &lt;/regCRMWS:OPERESPECIALI>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
