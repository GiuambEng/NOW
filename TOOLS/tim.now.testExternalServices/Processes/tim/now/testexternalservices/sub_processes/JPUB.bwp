                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://next.it/operespeciali/preventivo" xmlns:regCRMWS="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0" version="2.0"&gt;
    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;tns3:OPERESPECIALI&gt;
            &lt;parameters&gt;
