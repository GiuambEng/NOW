                                    requestContentType="JSON"
                                    responseAcceptType="JSON"
                                    transferEncoding="Buffered" xsi:type="restjson:RestInvokeActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
