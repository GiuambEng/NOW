                            &lt;/tipoRete&gt;
                            &lt;nomeDistributore&gt;
                                &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                            &lt;/nomeDistributore&gt;
                            &lt;numeroCoppie&gt;
                                &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                            &lt;/numeroCoppie&gt;
                            &lt;coppia&gt;
                                &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                            &lt;/coppia&gt;
                        &lt;/espletamento&gt;
                    &lt;/richiesta&gt;
                &lt;/tns2:espletamento&gt;
            &lt;/espletamento&gt;
        &lt;/tns2:espletamento&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://ordinicommerciali.service.fibercop.com/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:espletamento>&#xa;            &lt;richiesta>&#xa;                &lt;testata>&#xa;                    &lt;codiceOrdineOperatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                    &lt;/codiceOrdineOperatore>&#xa;                    &lt;codiceOutSourcer>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                    &lt;/codiceOutSourcer>&#xa;                    &lt;dataIdMessaggio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                    &lt;/dataIdMessaggio>&#xa;                    &lt;dataIdNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                    &lt;/dataIdNotifica>&#xa;                    &lt;dataRiscontro>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                    &lt;/dataRiscontro>&#xa;                    &lt;idMessaggio>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                    &lt;/idMessaggio>&#xa;                    &lt;idNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                    &lt;/idNotifica>&#xa;                    &lt;tipoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROVA&amp;quot;&quot;/>&#xa;                    &lt;/tipoOrdine>&#xa;                    &lt;tipoRiscontro>&#xa;                        &lt;xsl:value-of select=&quot;&amp;