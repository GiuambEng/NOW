                            &lt;/tipoRiscontro&gt;
                            &lt;codiceOrdineFiberCop&gt;
                                &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                            &lt;/codiceOrdineFiberCop&gt;
                        &lt;/testata&gt;
                        &lt;espletamento&gt;
                            &lt;dataEspletamento&gt;
                                &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                            &lt;/dataEspletamento&gt;
                            &lt;idRisorsa&gt;
                                &lt;xsl:value-of select="&amp;quot;PROVA&amp;quot;"/&gt;
                            &lt;/idRisorsa&gt;
                            &lt;statoOrdine&gt;
