<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:header="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_Test_Extenal_Servervices/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOW_Test_Extenal_Servervices/">
  	
  <element name="Request">
    		
    <complexType>
      			
      <sequence>
        				
        <element minOccurs="1" name="SYSTEM_TO_TEST">
          				
          <simpleType>
            					
            <restriction base="string">
              						
              <enumeration value="CCC"/>
              						
              <enumeration value="CRMB"/>
              						
              <enumeration value="CRMWS"/>
              						
              <enumeration value="DBCFX"/>
              						
              <enumeration value="DYNAMICINVENTORY"/>
              						
              <enumeration value="ESB"/>
              
              <enumeration value="FASTDATA"/>
              						              						
              <enumeration value="FIBERCOP"/>
              						
              <enumeration value="JIVE"/>
              						
              <enumeration value="JPUB"/>
              						
              <enumeration value="NNI"/>
              						
              <enumeration value="PATROCLO"/>
              						
              <enumeration value="RAC"/>
              						
              <enumeration value="SECOLO"/>
              						
              <enumeration value="TTM"/>
              						
              <enumeration value="UNICAC"/>
              	
					
            </restriction>
            				
          </simpleType>
          			
        </element>
        			
      </sequence>
      		
    </complexType>
    	
  </element>
  	
  <element name="Fault">
    		
    <complexType>
      			
      <sequence>
        				
        <element name="Messaggio_errore">
          					
          <simpleType>
            						
            <restriction base="string">
              							
              <maxLength value="2000"/>
              						
            </restriction>
            					
          </simpleType>
          				
        </element>
        				
        <element name="Codice_errore">
          					
          <simpleType>
            						
            <restriction base="string">
              							
              <maxLength value="100"/>
              						
            </restriction>
            					
          </simpleType>
          				
        </element>
        			
      </sequence>
      		
    </complexType>
    	
  </element>
  	
  <element name="Response" type="tns:Response_type"/>
  	
  <element name="Output" type="tns:Output_Process"/>
  	
  <complexType name="Response_type">
    		
    <sequence>
      			
      <element minOccurs="0" name="External_Service_Output">
        				
        <simpleType>
          					
          <restriction base="string">
            						
            <maxLength value="2000"/>
            					
          </restriction>
          				
        </simpleType>
        			
      </element>
      			
      <element name="ESITO">
        				
        <simpleType>
          					
          <restriction base="string">
            						
            <maxLength value="2"/>
            						
            <enumeration value="OK"/>
            						
            <enumeration value="KO"/>
            					
          </restriction>
          				
        </simpleType>
        			
      </element>
      			
      <element minOccurs="0" name="DESC_ERRORE">
        				
        <simpleType>
          					
          <restriction base="string">
            						
            <maxLength value="2000"/>
            					
          </restriction>
          				
        </simpleType>
        			
      </element>
      		
    </sequence>
    	
  </complexType>
  	
  <complexType name="Output_Process">
    		
    <sequence>
      			
      <element name="ResponseProcess" type="tns:Response_type"/>
      		
    </sequence>
    	
  </complexType>
  
</schema>
