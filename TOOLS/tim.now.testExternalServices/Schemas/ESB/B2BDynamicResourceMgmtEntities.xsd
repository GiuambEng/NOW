<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:bvi="http://telecomitalia.it/SOA/BVI" xmlns:cst="http://telecomitalia.it/SOA/B2BDynamicResourceMgmtCustomTypes/2019-06-17" targetNamespace="http://telecomitalia.it/SOA/B2BDynamicResourceMgmtCustomTypes/2019-06-17" elementFormDefault="qualified" version="1.0">
