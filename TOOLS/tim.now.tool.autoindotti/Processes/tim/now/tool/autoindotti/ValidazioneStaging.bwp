                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d0ba60ff-1300-4024-a902-3e331be8dec0+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1574866849167&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Mapper/Esito = 'OK'&quot;>&lt;DESCR>&lt;xsl:value-of select=&quot;'OK ELABORAZIONE RECORD STAGING'&quot;/>&lt;/DESCR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR>&lt;xsl:value-of select=&quot;'KO ELABORAZIONE RECORD TARGET'&quot;/>&lt;/DESCR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RISORSA_DATI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdRisorsaDati)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdRisorsaDati&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA_DATI>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="UpdateStaging-input"
                    name="UpdateStaging" outputVariable="UpdateStaging"
                    tibex:xpdlId="d0ba60ff-1300-4024-a902-3e331be8dec0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToUpdateKOStaging_Name"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateStagingToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d0ba60ff-1300-4024-a902-3e331be8dec0+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1574866849167&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Mapper/Esito = 'OK'&quot;>&lt;DESCR>&lt;xsl:value-of select=&quot;'OK ELABORAZIONE RECORD STAGING'&quot;/>&lt;/DESCR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR>&lt;xsl:value-of select=&quot;'KO ELABORAZIONE RECORD TARGET'&quot;/>&lt;/DESCR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RISORSA_DATI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdRisorsaDati)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdRisorsaDati&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA_DATI>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STAG_TRASF_AUTOINDOTTA_NO_FILE&#xa;SET ID_STATO_ELAB_STAG = (SELECT ID_STATO_ELAB_STAG&#xa;FROM TIPOLG_STATO_ELAB_STAG&#xa;WHERE DESCR = ?)&#xa;WHERE ID_RISORSA_DATI = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA_DATI"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1574872840051&quot; xmlns:ns0=&quot;http://www.example.com/namespaces/tns/1574866849167&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectAssetFonia&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectAssetDati&quot;/>&lt;xsl:param name=&quot;SelectOFFERTADati&quot;/>&lt;xsl:param name=&quot;SelectOFFERTAFonia&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:MapperInput>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectAssetDati/Record) = 0 or count($SelectAssetDati/Record) > 1 or count($SelectAssetFonia/Record)>2 or (count($SelectAssetFonia/Record) = 0 and $Start/ns0:Scenario = &amp;quot;TNAKEDCOND&amp;quot;)&quot;>&lt;Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns0:Scenario = 'TCONDNAKED'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns0:CodificaOLOAgcom = $SelectAssetDati/Record[1]/CODIFICAOLOAGCOM and $SelectAssetDati/Record[1]/TIPOLOGIAACCESSO = &amp;quot;DATI&amp;quot; and ($SelectAssetDati/Record[1]/TIPOLINEA = &amp;quot;POTS&amp;quot; or $SelectAssetDati/Record[1]/TIPOLINEA = &amp;quot;ISDN&amp;quot;) and contains(tib:concat-sequence-format($SelectOFFERTADati/Record, &amp;quot;|&amp;quot;), $SelectAssetDati/Record[1]/OFFERTA)&quot;>&lt;Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns0:Scenario = 'TSHAULLD'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns0:CodificaOLOAgcom = $SelectAssetDati/Record[1]/CODIFICAOLO