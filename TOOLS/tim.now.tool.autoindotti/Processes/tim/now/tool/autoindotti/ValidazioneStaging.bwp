                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+972160d8-75bd-46ca-9291-b8f1587a5906+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1574866849167&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SelectDatiAssetFonia-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSAFONIA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdRisorsaFonia)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdRisorsaFonia&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISORSAFONIA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectAssetFonia-input"
                    name="SelectAssetFonia"
                    outputVariable="SelectAssetFonia"
                    tibex:xpdlId="972160d8-75bd-46ca-9291-b8f1587a5906" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
