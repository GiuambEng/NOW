                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TR.NOME_OFFERTA_ESTERNA &#xd;&#xa;FROM FAMIG_OFFERTA FO, SOTTO_FAMIG_OFFERTA SO, TRASCODFC_OFFERTA TR, OFFERTA O &#xd;&#xa;WHERE FO.ID_FAMIG_OFFERTA = O.ID_FAMIG_OFFERTA AND SO.ID_SOTTOFAMIG_OFFERTA = O.ID_SOTTOFAMIG_OFFERTA &#xd;&#xa;AND O.ID_OFFERTA = TR.ID_OFFERTA &#xd;&#xa;AND O.STRUTTURA_RICH IN ('NGA','XDSL') &#xd;&#xa;AND TR.PROVENIENZA = 'BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">
