                                    expression="$Start/ns0:Scenario = 'TNAKEDCOND' or $Start/ns0:Scenario = 'TCONDNAKED'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
