                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ASS.IDASSET, ASS.IDRISORSA, ASS.CODIFICAOLOAGCOM, ASS.TIPOLOGIAACCESSO, ASS.OFFERTA, ASS.IDRISORSACORRELATO, ATT.VALOREATTRIBUTO AS TIPOLINEA&#xa;FROM APPUSER.BDS_1_CASEDATA_ASSET ASS, APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET DETT, APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST ATT&#xa;WHERE ATT.DTTGLSST_TTRBTIDTTGLISST_BDSID = DETT.BDS_ID AND DETT.asset_dettaglioasset_bdsid = ASS.bds_id&#xa;AND ASS.IDRISORSA = ? AND ASS.STATOASSET = 'ATTIVO' AND DETT.NOMECOMPONENTE LIKE 'ACCESSO%' AND ATT.NOMEATTRIBUTO = 'TIPOLINEA'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSADATI"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIAACCESSO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
