               &lt;/IDRisorsaNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns:Scenario&quot;>&#xa;                    &lt;tipologiaScenario>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Scenario&quot;/>&#xa;                    &lt;/tipologiaScenario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TNAKEDCOND' and exists($SelectAssetFonia/Record[NOMEATTRIBUTO = 'TIPOLINEA'])&quot;>&#xa;                        &lt;xsl:if test=&quot;$SelectAssetFonia/Record[NOMEATTRIBUTO = 'TIPOLINEA']/VALOREATTRIBUTO&quot;>&#xa;                            &lt;tipologiaLinea>&#xa;                                &lt;xsl:value-of select=&quot;$SelectAssetFonia/Record[NOMEATTRIBUTO = 'TIPOLINEA']/VALOREATTRIBUTO&quot;/>&#xa;                            &lt;/tipologiaLinea>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TNAKEDCOND' and $SelectAssetFonia/Record[NOMEATTRIBUTO = 'DESTINAZIONEUSO']/VALOREATTRIBUTO = '1'&quot;>&#xa;                        &lt;tipologiaLinea>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;POTS&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLinea>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TNAKEDCOND' and $SelectAssetFonia/Record[NOMEATTRIBUTO = 'DESTINAZIONEUSO']/VALOREATTRIBUTO = ('2','3')&quot;>&#xa;                        &lt;tipologiaLinea>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ISDN&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaLinea>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ordine>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($RecuperaContrattoAttivo/Record)>0&quot;>&#xa;                    &lt;IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($RecuperaContrattoAttivo/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/IDContratto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/IDContratto>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$SelectAssetDati/Record[1]/CODICEISTATCOMUNE&quot;>&#xa;                &lt;ISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$SelectAssetDati/Record[1]/CODICEISTATCOMUNE&quot;/>&#xa;                &lt;/ISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SelectAssetDati/Record[1]/LOCALITA&quot;>&#xa;                &lt;localita>&#xa;                    &lt;xsl:value-of select=&quot;$SelectAssetDati/Record[1]/LOCALITA&quot;/>&#xa;                &lt;/localita>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;$Offerta&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TCONDNAKED'&quot;>&#xa;                    &lt;flagNaked>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                    &lt;/flagNaked>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TNAKEDCOND'&quot;>&#xa;                    &lt;flagNaked>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/flagNaked>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;IDOfferta>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($SelectSTRUTTURARICH/Record[1]/ID_OFFERTA)&quot;/>&#xa;            &lt;/IDOfferta>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TNAKEDCOND'&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectAssetFonia/Record[1]/NUMEROTELEFONICO&quot;>&#xa;                        &lt;numeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;$SelectAssetFonia/Record[1]/NUMEROTELEFONICO&quot;/>&#xa;                        &lt;/numeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TSHAULLD'&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectAssetDati/Record[1]/NUMEROTELEFONICO&quot;>&#xa;                        &lt;numeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;$SelectAssetDati/Record[1]/NUMEROTELEFONICO&quot;/>&#xa;                        &lt;/numeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/tns:Scenario&quot;>&#xa;                &lt;tipologiaScenario>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Scenario&quot;/>&#xa;                &lt;/tipologiaScenario>&#xa;            &lt;/xsl:if>&#xa;            &lt;DAC>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/DAC>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TCONDNAKED'&quot;>&#xa;                    &lt;codiceTrasformazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TCOND_NAKED&amp;quot;&quot;/>&#xa;                    &lt;/codiceTrasformazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TNAKEDCOND'&quot;>&#xa;                    &lt;codiceTrasformazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TNAKED_COND&amp;quot;&quot;/>&#xa;                    &lt;/codiceTrasformazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codiceTrasformazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TSHA_ULLD&amp;quot;&quot;/>&#xa;                    &lt;/codiceTrasformazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TNAKEDCOND'&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:IDRisorsaFonia&quot;>&#xa;                        &lt;IDRisorsaCorrelato>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:IDRisorsaFonia&quot;/>&#xa;                        &lt;/IDRisorsaCorrelato>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TCONDNAKED'&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PASSAGGIOLNF&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Scenario = 'TNAKEDCOND'&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PASSAGGIOLA&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipologiaSotto