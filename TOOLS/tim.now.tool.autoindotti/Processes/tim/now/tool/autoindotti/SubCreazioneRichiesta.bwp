                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ASS.OFFERTA, ASS.CODIFICAOLOAGCOM, ASS.CODICEORDINEOLO, ASS.CLLI, ASS.IDRISORSANOW, ASS.CODIFICAOLOAGCOMDONOR, ASS.CODICEORDINETI, ASS.IDASSET, ASS.NUMEROTELEFONICO, ASS.NUMTELPRINCIPALE, ASS.NUMEROFITTIZIO, ASS.CODICESLAASSURANCE, ASS.DISTRETTO, ASS.CODICEISTATCOMUNE, ASS.LOCALITA, ASS.DESCRPARTTOPONOMASTICA, ASS.DESCRIZIONEVIA, ASS.NUMEROCIVICO, ASS.COMUNE, ASS.PROVINCIA, ASS.CAP, ASS.COMPLESSO, ASS.INTERNO, ASS.SCALA, ASS.PIANO, ASS.CODICEISTATPROVINCIA, ASS.CODICETOPONOMASTICA, ASS.SIGLAPROVINCIA, ASS.OPERATORE, DETT.NOMECOMPONENTE, ATT.NOMEATTRIBUTO, ATT.VALOREATTRIBUTO, ATT.DTTGLSST_TTRBTIDTTGLISST_BDSID&#xa;FROM APPUSER.BDS_1_CASEDATA_ASSET ASS, APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET DETT, APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST ATT&#xa;WHERE ATT.DTTGLSST_TTRBTIDTTGLISST_BDSID = DETT.BDS_ID AND DETT.asset_dettaglioasset_bdsid = ASS.bds_id&#xa;AND ASS.IDASSET = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
