            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+5a843126-6ddf-4cff-9c9c-4d57a7b28765+input">
            <element name="jdbcUpdateActivityInput">
