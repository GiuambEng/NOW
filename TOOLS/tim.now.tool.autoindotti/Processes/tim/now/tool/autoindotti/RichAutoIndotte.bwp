            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+931c7b89-5029-42b5-a1ad-9e4b6f6ab983+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="ID_RISORSA_DATI"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="ID_RISORSA_FONIA"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="COD_OLO_AGCOM"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="COD_ORD_OLO"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="OPERATORE" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="NOTE" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="SCENARIO" nillable="false" type="string"/>
