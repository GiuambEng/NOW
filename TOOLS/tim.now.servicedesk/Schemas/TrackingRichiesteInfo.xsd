<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/TrackingRichiesteInfo" targetNamespace="http://www.tim.com/NOW/xsd/TrackingRichiesteInfo" elementFormDefault="qualified">
	<element name="Input">
		<complexType>
			<sequence>
				<choice>
					<element name="Insert">
						<complexType>
							<sequence>
								<element name="InsertStaging">
									<complexType>
										<sequence>
											<element name="OPERATION" type="tns:OPERATION_Type"/>
											<element name="ID_ELAB_STAGING" type="int"/>
											<element name="CONTENUTO_REQUEST" type="string"/>
											<element name="DN" type="string" minOccurs="0"/>
											<element name="CODICE_ORDINE_OAO" type="string" minOccurs="0"/>
											<element name="CODICE_ORDINE_TI" type="string" minOccurs="0"/>
											<element name="ID_RISORSA" type="string" minOccurs="0"/>
											<element name="DESCR_ERROR" type="string" minOccurs="0"/>
										</sequence>
									</complexType>
								</element>
								<element name="InserTrackProcso">
									<complexType>
										<sequence>
											<element name="STATO_ESEC" type="tns:STATO_ESEC_Type"/>
										</sequence>
									</complexType>
								</element>
							</sequence>
						</complexType>
					</element>
					<element name="Update">
						<complexType>
							<sequence>
								<element name="UpdateStaging">
									<complexType>
										<sequence>
											<element name="CONTENUTO_RESPONSE" type="string" minOccurs="0"/>
											<element name="ESITO" type="string" minOccurs="0"/>
											<element name="DESCR_ESITO" type="string" minOccurs="0"/>
											<element name="DESCR_ERROR" type="string" minOccurs="0"/>
											<element name="ID_ELAB_STAGING" type="int"/>
										</sequence>
									</complexType>
								</element>
								<element name="UpdateTrackProcso">
									<complexType>
										<sequence>
											<element name="ID_ESEC_PROCSTO" type="int"/>
											<element name="STATO_ESEC" type="tns:STATO_ESEC_Type"/>
										</sequence>
									</complexType>
								</element>
							</sequence>
						</complexType>
					</element>
				</choice>
				<element name="DataUtils">
					<complexType>
						<sequence>
							<element name="PID" type="string"/>
							<element name="CODICE_INTERFACCIA" type="tns:CODICE_INTERFACCIA_Type"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Output">
		<complexType>
			<sequence>
				<element name="ID_ESEC_PROCSO" type="int" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<!-- TYPE LIST -->
	<simpleType name="CODICE_INTERFACCIA_Type">
		<restriction base="string">
			<enumeration value="ID262"/>
			<enumeration value="ID263"/>
			<enumeration value="ID264"/>
			<enumeration value="ID265"/>
		</restriction>
	</simpleType>
	<simpleType name="OPERATION_Type">
		<restriction base="string">
			<enumeration value="RichiestaInfoAsset"/>
			<enumeration value="RichiestaInfoOrdine"/>
			<enumeration value="RichiestaInfoNotifiche"/>
			<enumeration value="RichiestaInfoTracciamento"/>
		</restriction>
	</simpleType>
	<simpleType name="STATO_ESEC_Type">
		<restriction base="string">
			<minLength value="1"/>
			<enumeration value="CHIUSO"/>
			<enumeration value="IN ELABORAZIONE"/>
			<enumeration value="PROCESSO ESEGUITO CON ERRORE"/>
		</restriction>
	</simpleType>
</schema>
