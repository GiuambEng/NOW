<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ServiceDesk_RichiestaInfo" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/ServiceDesk_RichiestaInfo">
	
	<!-- RICHIESTA INFO ORDINE -->
	<element name="RichiestaInfoOrdine_Request">
		<complexType>
			<sequence>
				<element minOccurs="0" name="CODICE_ORDINE_OAO" type="string"/>
				<element minOccurs="0" name="CODICE_ORDINE_TI" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="RichiestaInfoOrdine_Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:ESITO_Type"/>
				<element minOccurs="0" name="Descrizione" type="tns:DESCRIZIONE_Type"/>
				<element maxOccurs="unbounded" minOccurs="0" name="InfoOrdine">
					<complexType>
						<sequence>
							<element minOccurs="0" name="CODICE_ORDINE_OAO" type="string"/>
							<element minOccurs="0" name="DATA_CREAZIONE" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="CANALE" type="string"/>
							<element minOccurs="0" name="CODIFICA_OAO" type="string"/>
							<element minOccurs="0" name="CODICE_OAO" type="string"/>
							<element minOccurs="0" name="DESCRIZIONE_OAO" type="string"/>
							<element minOccurs="0" name="CODICE_CAUSALE_OAO" type="string"/>
							<element minOccurs="0" name="DESCRIZIONE_CAUSALE_OAO" type="string"/>
							<element minOccurs="0" name="CODICE_CAUSALE_NOW" type="string"/>
							<element minOccurs="0" name="DESCRIZIONE_CAUSALE_NOW" type="string"/>
							<element minOccurs="0" name="DAC" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="DAC_RIMODULATA" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="CODICE_ORDINE_OAO_PADRE" type="string"/>
							<element minOccurs="0" name="LAVORAZIONE_RICHIESTA" type="string"/>
							<element minOccurs="0" name="OAO_DONOR" type="string"/>
							<element minOccurs="0" name="DATA_AGGIORNAMENTO" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="STATO_NOW" type="string"/>
							<element minOccurs="0" name="ID_RISORSA_NOW" type="string"/>
							<element minOccurs="0" name="CODICE_ORDINE_TI" type="string"/>
							<element minOccurs="0" name="STATO_OAO" type="string"/>
							<element minOccurs="0" name="DRO" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="ID_RISORSA" type="string"/>
							<element minOccurs="0" name="DES" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="CODICE_ORDINE_OAO_TARGET" type="string"/>
							<element minOccurs="0" name="DATA_INSERIMENTO" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="OAO_DONATING" type="string"/>
							<element minOccurs="0" name="DATA_INVIO_DELIVERY" type="tns:DataTime_Type"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<!-- RICHIESTA INFO ASSET -->
	<element name="RichiestaInfoAsset_Request">
		<complexType>
			<sequence>
				<element minOccurs="0" name="CODICE_ORDINE_OAO" type="string"/>
				<element minOccurs="0" name="CODICE_ORDINE_TI" type="string"/>
				<element minOccurs="0" name="ID_RISORSA" type="string"/>
				<element minOccurs="0" name="DN" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="RichiestaInfoAsset_Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:ESITO_Type"/>
				<element minOccurs="0" name="Descrizione" type="tns:DESCRIZIONE_Type"/>
				<element maxOccurs="unbounded" minOccurs="0" name="InfoAsset">
					<complexType>
						<sequence>
							<element minOccurs="0" name="DEC" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="CENTRALE" type="string"/>
							<element minOccurs="0" name="ID_ASSET" type="int"/>
							<element minOccurs="0" name="ID_ASSET_CRMWS" type="string"/>
							<element minOccurs="0" name="ID_ASSET_DA" type="int"/>
							<element minOccurs="0" name="ID_CONTRATTO" type="int"/>
							<element minOccurs="0" name="DES" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="ORA_DES" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="DATA_AGGIORNAMENTO" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="CODICE_ORDINE_OAO_PRIMO_ORDINE" type="string"/>
							<element minOccurs="0" name="OAO_DONATING" type="string"/>
							<element minOccurs="0" name="NUMERO_FITTIZIO" type="string"/>
							<element minOccurs="0" name="DES_PRIMO_ORDINE" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="INVARIANTE" type="string"/>
							<element minOccurs="0" name="DATA_CREAZIONE" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="CODICE_ORDINE_TI_PRIMO_ORDINE" type="string"/>
							<element minOccurs="0" name="OAO_DONOR" type="string"/>
							<element minOccurs="0" name="NUMERO_TELEFONICO" type="string"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<!-- RICHIESTA INFO NOTIFICHE -->
	<element name="RichiestaInfoNotifiche_Request">
		<complexType>
			<sequence>
				<element minOccurs="0" name="CODICE_ORDINE_OAO"
					type="string" />
				<element name="CODICE_ORDINE_TI" type="string" minOccurs="0" maxOccurs="1"></element>
			</sequence>
		</complexType>
	</element>
	<element name="RichiestaInfoNotifiche_Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:ESITO_Type"/>
				<element minOccurs="0" name="Descrizione" type="tns:DESCRIZIONE_Type"/>
				<element maxOccurs="unbounded" minOccurs="0" name="InfoNotifiche">
					<complexType>
						<sequence>
							<element minOccurs="0" name="TIPOLOGIA_NOTIFICA" type="string"/>
							<element minOccurs="0" name="ID_RICHIESTA_OAO" type="string"/>
							<element minOccurs="0" name="NOME_FILE" type="string"/>
							<element minOccurs="0" name="CODIFICA_OAO" type="string"/>
							<element minOccurs="0" name="DATA_INVIO" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="ESITO_INVIO" type="string"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<!-- RICHIESTA INFO TRACCIAMENTO -->
	<element name="RichiestaInfoTracciamento_Request">
		<complexType>
			<sequence>
				<element minOccurs="0" name="CODICE_ORDINE_OAO"
					type="string" />
				<element name="CODICE_ORDINE_TI" type="string" minOccurs="0" maxOccurs="1"></element>
			</sequence>
		</complexType>
	</element>
	<element name="RichiestaInfoTracciamento_Response">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:ESITO_Type"/>
				<element minOccurs="0" name="Descrizione" type="tns:DESCRIZIONE_Type"/>
				<element maxOccurs="unbounded" minOccurs="0" name="InfoTracciamento">
					<complexType>
						<sequence>
							<element minOccurs="0" name="TIMESTAMP_INSERIMENTO" type="tns:DataTime_Type"/>
							<element minOccurs="0" name="STATO_NOW_DA" type="string"/>
							<element minOccurs="0" name="STATO_NOW_A" type="string"/>
							<element minOccurs="0" name="STATO_OAO_DA" type="string"/>
							<element minOccurs="0" name="STATO_OAO_A" type="string"/>
							<element minOccurs="0" name="ID_NOTIFICA" type="int"/>
							<element minOccurs="0" name="ID_NOTIFICA_DONATING" type="int"/>
							<element minOccurs="0" name="ID_NOTIFICA_DONOR" type="int"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	
	<element name="SoapFault">
		<complexType>
			<sequence>
				<element minOccurs="0" name="CodiceErrore" type="string"/>
				<element minOccurs="0" name="MessaggioErrore" type="string"/>
			</sequence>
		</complexType>
	</element>
	<!-- TYPE LIST -->
	<simpleType name="ESITO_Type">
		<restriction base="string">
			<enumeration value="OK"/>
			<enumeration value="KO"/>
		</restriction>
	</simpleType>
	<simpleType name="DESCRIZIONE_Type">
		<restriction base="string">
			<enumeration value="Nessun parametro in Input"/>
			<enumeration value="Nessuna occorrenza trovata"/>
			<enumeration value="Internal Error"/>
		</restriction>
	</simpleType>
	<simpleType name="DataTime_Type">
		<restriction base="dateTime"/>
	</simpleType>



</schema>
