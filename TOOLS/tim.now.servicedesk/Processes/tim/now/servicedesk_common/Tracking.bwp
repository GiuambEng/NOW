                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_SERVICEDESK (COD_INTERFACCIA, OPERATION, CONTENUTO_REQUEST, CONTENUTO_RESPONSE,&#xd;&#xa;TIMESTAMP_RICHIESTA, TIMESTAMP_RISPOSTA, OPERATORE, ID_ESEC_PROCESSO, ID_RICH, ID_ELAB_STAGING, &#xd;&#xa;COD_ORDINE_OAO, COD_ORDINE_TI, ID_RISORSA, DN, DESCR_ERROR)&#xd;&#xa;VALUES (?,?,?,?,SYSDATE, ?,'AUTOMATICO',?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
