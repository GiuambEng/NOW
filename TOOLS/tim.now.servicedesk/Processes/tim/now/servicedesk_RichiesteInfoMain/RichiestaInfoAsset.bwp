                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceDesk_RichiestaInfo&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:RichiestaInfoAsset_Response>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Esito>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Internal Error&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:RichiestaInfoAsset_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="Response" name="EsitoKO"
