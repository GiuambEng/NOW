        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="70f68e81-5b62-45b2-8dcf-c6efb206f31a">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="LogErrorToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="UpdateErrorToEmpty" tibex:linkType="ERROR"/>
                            <bpws:link name="LogErrorToEmpty" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            <bpws:link name="AssignToUpdateError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="UpdateErrorToRethrow" tibex:linkType="SUCCESS"/>
                            <bpws:link name="EmptyToRethrow" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;PID&quot;/>&lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| PID &amp;quot;, $PID,&amp;quot;| ProcessInstance &amp;quot;,$_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat('ERRORE RICHIESTA INFO ASSET', tib:render-xml($FaultDetails, true(),true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="LogError-input"
                                name="LogError"
                                tibex:xpdlId="466960bf-a9eb-4b54-965f-2ec68cdc7e6d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogErrorToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ID_ESEC!=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ID_ESEC!=0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogErrorToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;PID&quot;/>&lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| PID &amp;quot;, $PID,&amp;quot;| ProcessInstance &amp;quot;,$_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat('ERRORE RICHIESTA INFO ASSET', tib:render-xml($FaultDetails, true(),true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Error"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/TrackingRichiesteInfo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;ID_ESEC&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:param name=&quot;PID&quot;/>&lt;xsl:template name=&quot;UpdateError-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:UpdateStaging>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($Response, true(), true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:DESCR_ESITO>&lt;xsl:value-of select=&quot;'Internal Error'&quot;/>&lt;/tns:DESCR_ESITO>&lt;tns:DESCR_ERROR>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&lt;/tns:DESCR_ERROR>&lt;tns:ID_ELAB_STAGING>&lt;xsl:value-of select=&quot;12&quot;/>&lt;/tns:ID_ELAB_STAGING>&lt;/tns:UpdateStaging>&lt;tns:UpdateTrackProcso>&lt;tns:ID_ESEC_PROCSTO>&lt;xsl:value-of select=&quot;xsd:int($ID_ESEC)&quot;/>&lt;/tns:ID_ESEC_PROCSTO>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&lt;/tns:STATO_ESEC>&lt;/tns:UpdateTrackProcso>&lt;/tns:Update>&lt;tns:DataUtils>&lt;tns:PID>&lt;xsl:value-of select=&quot;$PID&quot;/>&lt;/tns:PID>&lt;tns:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;&amp;quot;ID263&amp;quot;&quot;/>&lt;/tns:CODICE_INTERFACCIA>&lt;/tns:DataUtils>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="UpdateError-input"
                                name="UpdateError"
                                outputVariable="UpdateError"
                                tibex:xpdlId="563de945-2995-4080-8ff3-6bbf1a280c37"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToUpdateError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source
                                    linkName="UpdateErrorToEmpty"
                                    tibex:faultDetailsVar="UpdateError" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="UpdateErrorToRethrow"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/TrackingRichiesteInfo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;ID_ESEC&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:param name=&quot;PID&quot;/>&lt;xsl:template name=&quot;UpdateError-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:UpdateStaging>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($Response, true(), true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:ESITO>&lt;tns:DESCR_ESITO>&lt;xsl:value-of select=&quot;'Internal Error'&quot;/>&lt;/tns:DESCR_ESITO>&lt;tns:DESCR_ERROR>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&lt;/tns:DESCR_ERROR>&lt;tns:ID_ELAB_STAGING>&lt;xsl:value-of select=&quot;12&quot;/>&lt;/tns:ID_ELAB_STAGING>&lt;/tns:UpdateStaging>&lt;tns:UpdateTrackProcso>&lt;tns:ID_ESEC_PROCSTO>&lt;xsl:value-of select=&quot;xsd:int($ID_ESEC)&quot;/>&lt;/tns:ID_ESEC_PROCSTO>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&lt;/tns:STATO_ESEC>&lt;/tns:UpdateTrackProcso>&lt;/tns:Update>&lt;tns:DataUtils>&lt;tns:PID>&lt;xsl:value-of select=&quot;$PID&quot;/>&lt;/tns:PID>&lt;tns:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;&amp;quot;ID263&amp;quot;&quot;/>&lt;/tns:CODICE_INTERFACCIA>&lt;/tns:DataUtils>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess subProcessName="Stag" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
