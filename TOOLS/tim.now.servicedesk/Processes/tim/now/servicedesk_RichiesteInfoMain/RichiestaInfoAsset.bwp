                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select ass.DEC, ass.CLLI as CENTRALE, ass.IDASSET AS ID_ASSET, ass.IDASSETCRMWS AS ID_ASSET_CRMWS, ass.IDASSETDA AS ID_ASSET_DA, ass.IDCONTRATTO &#xa;as ID_CONTRATTO, ass.DES, ass.ORA_DES,&#xa;ass.LASTUPDATE as DATA_AGGIORNAMENTO, ass.CODICEORDINEOLO as CODICE_ORDINE_OAO_PRIMO_ORDINE, &#xa;ass.CODIFICAOLOAGCOMDONATING as OAO_DONATING, &#xa;ass.NUMEROFITTIZIO as NUMERO_FITTIZIO, ass.DESPRIMOORDINE as DES_PRIMO_ORDINE,&#xa;ass.INVARIANTE, ass.CREATED AS DATA_CREAZIONE, &#xa;rich.CODICEORDINETI AS CODICE_ORDINE_TI_PRIMO_ORDINE, &#xa;ass.CODIFICAOLOAGCOMDONOR AS OAO_DONOR, ass.NUMEROTELEFONICO AS NUMERO_TELEFONICO&#xa;from BDS_1_CASEDATA_ASSET ass LEFT OUTER join BDS_1_CASEDATA_RICHIESTA rich ON ASS.CODICEORDINETI = RICH.CODICEORDINETI &#xa;WHERE (ass.CODICEORDINEOLO =? OR rich.CODICEORDINEOLOPADRE=? OR ? IS NULL) AND (rich.CODICEORDINETI = ? OR ? IS null)&#xa;AND (ass.IDRISORSA =? OR ? IS null) AND (ass.NUMEROTELEFONICO  =? OR ? IS null)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_ORDINE_OAO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_ORDINE_OAO_PADRE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_ORDINE_OAO_isNull"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_ORDINE_TI"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_ORDINE_TI_isNull"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA_isNull"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN_isNull"/>
                                    <columnMetadata columnName="DEC"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CENTRALE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_ASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ASSET_CRMWS"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_ASSET_DA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnName="DES"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="ORA_DES"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DATA_AGGIORNAMENTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODICE_ORDINE_OAO_PRIMO_ORDINE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OAO_DONATING"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMERO_FITTIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DES_PRIMO_ORDINE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="INVARIANTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_CREAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CODICE_ORDINE_TI_PRIMO_ORDINE"
