                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+940992ec-5d17-4487-bc87-667357676865+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ServiceDesk_RichiestaInfo&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;GetInfoAsset-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODICE_ORDINE_OAO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CODICE_ORDINE_OAO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CODICE_ORDINE_OAO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_OAO>&lt;CODICE_ORDINE_OAO_PADRE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CODICE_ORDINE_OAO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CODICE_ORDINE_OAO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_OAO_PADRE>&lt;CODICE_ORDINE_OAO_isNull>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CODICE_ORDINE_OAO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CODICE_ORDINE_OAO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_OAO_isNull>&lt;CODICE_ORDINE_TI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CODICE_ORDINE_TI)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CODICE_ORDINE_TI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_TI>&lt;CODICE_ORDINE_TI_isNull>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CODICE_ORDINE_TI)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CODICE_ORDINE_TI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_TI_isNull>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ID_RISORSA)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:ID_RISORSA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;ID_RISORSA_isNull>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ID_RISORSA)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:ID_RISORSA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA_isNull>&lt;DN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:DN)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:DN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DN>&lt;DN_isNull>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:DN)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:DN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DN_isNull>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
