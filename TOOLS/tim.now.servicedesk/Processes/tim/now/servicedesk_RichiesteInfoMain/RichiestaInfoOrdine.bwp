                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceDesk_RichiestaInfo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetInfoOrdine&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($GetInfoOrdine/Record)>0&quot;>&lt;tns:RichiestaInfoOrdine_Response>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;xsl:for-each select=&quot;$GetInfoOrdine/Record&quot;>&lt;tns:InfoOrdine>&lt;xsl:if test=&quot;CODICE_ORDINE_OAO&quot;>&lt;tns:CODICE_ORDINE_OAO>&lt;xsl:value-of select=&quot;CODICE_ORDINE_OAO&quot;/>&lt;/tns:CODICE_ORDINE_OAO>&lt;/xsl:if>&lt;xsl:if test=&quot;DATA_CREAZIONE&quot;>&lt;tns:DATA_CREAZIONE>&lt;xsl:value-of select=&quot;DATA_CREAZIONE&quot;/>&lt;/tns:DATA_CREAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;CANALE&quot;>&lt;tns:CANALE>&lt;xsl:value-of select=&quot;CANALE&quot;/>&lt;/tns:CANALE>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICA_OAO&quot;>&lt;tns:CODIFICA_OAO>&lt;xsl:value-of select=&quot;CODIFICA_OAO&quot;/>&lt;/tns:CODIFICA_OAO>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICE_OAO&quot;>&lt;tns:CODICE_OAO>&lt;xsl:value-of select=&quot;CODICE_OAO&quot;/>&lt;/tns:CODICE_OAO>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRIZIONE_OAO&quot;>&lt;tns:DESCRIZIONE_OAO>&lt;xsl:value-of select=&quot;DESCRIZIONE_OAO&quot;/>&lt;/tns:DESCRIZIONE_OAO>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICE_CAUSALE_OAO&quot;>&lt;tns:CODICE_CAUSALE_OAO>&lt;xsl:value-of select=&quot;CODICE_CAUSALE_OAO&quot;/>&lt;/tns:CODICE_CAUSALE_OAO>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCRIZIONE_CAUSALE_OAO&quot;>&lt;tns:DESCRIZIONE_CAUSALE_OAO>&lt;xsl:value-of select=&quot;DESCRIZIONE_CAUSALE_OAO&quot;/>&lt;/tns:DESCRIZIONE_CAUSALE_OAO>&lt;/xsl:if>&lt;xsl:if test=&quot;CODICE_CAUSALE_NOW&quot;>&lt;tns:C