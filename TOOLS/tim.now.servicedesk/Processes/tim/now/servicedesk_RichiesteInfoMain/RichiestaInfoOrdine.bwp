                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT rich.CODICEORDINEOLO AS CODICE_ORDINE_OAO,ord.CREATED AS DATA_CREAZIONE,&#xd;&#xa;rich.CANALERICHIESTA AS CANALE,rich.CODIFICAOLOAGCOM AS CODIFICA_OAO,rich.CODIFICAOLONOW as CODICE_OAO,&#xd;&#xa;olo.NOME AS DESCRIZIONE_OAO ,anag.COD_CAUS_OLO AS CODICE_CAUSALE_OAO,&#xd;&#xa;anag.DESCR_CAUS_OLO AS DESCRIZIONE_CAUSALE_OAO, anag.COD_CAUS_INTERNO AS CODICE_CAUSALE_NOW ,anag.DESCR_CAUS_INTERNO AS DESCRIZIONE_CAUSALE_NOW&#xd;&#xa;,ord.DAC,ord.DACRIMODULATA AS DAC_RIMODULATA,rich.CODICEORDINEOLOPADRE AS CODICE_ORDINE_OAO_PADRE, rich.LAVORAZIONE as LAVORAZIONE_RICHIESTA,&#xd;&#xa;rich.CODIFICAOLOAGCOMDONOR AS OAO_DONOR,&#xd;&#xa;ord.LASTUPDATE as DATA_AGGIORNAMENTO,rich.STATORICHIESTANOW as STATO_NOW,ord.idrisorsanow as ID_RISORSA_NOW,&#xd;&#xa;rich.CODICEORDINETI as CODICE_ORDINE_TI,rich.STATORICHIESTAOLO as STATO_OAO,rich.DRO,rich.IDRISORSA as ID_RISORSA,ord.DES,&#xd;&#xa;rich.CODICEORDINETITARGET AS CODICE_ORDINE_OAO_TARGET,rich.DATAINVIORICHIESTA AS DATA_INSERIMENTO,&#xd;&#xa;rich.codificaoloagcomdonating AS OAO_DONATING,ord.DATAINVIOORDINEADELIVERY AS DATA_INVIO_DELIVERY&#xd;&#xa;FROM appuser.BDS_1_CASEDATA_RICHIESTA rich &#xd;&#xa;LEFT OUTER JOIN appuser.BDS_1_CASEDATA_ORDINE ord ON rich.bds_id=ord.RICHIESTA_ORDINE_BDSID &#xd;&#xa;LEFT OUTER JOIN appuser.ANAG_CAUS anag ON rich.IDANAGRAFICACAUSALE=anag.ID_ANAG_CAUS&#xd;&#xa;LEFT OUTER JOIN appuser.olo olo ON rich.CODIFICAOLOAGCOM=olo.CODFC_OLO_AGCOM&#xd;&#xa;WHERE (rich.CODICEORDINEOLO = ?  OR rich.CODICEORDINEOLOPADRE=? OR ? IS null) &#xd;&#xa;AND (rich.CODICEORDINETI=? OR ? IS NULL)" xsi:type="jdbcPalette:JDBCQueryActivity">
