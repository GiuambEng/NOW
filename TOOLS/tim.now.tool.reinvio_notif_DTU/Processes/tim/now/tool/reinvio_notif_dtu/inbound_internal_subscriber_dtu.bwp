                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+0c0f7cc6-ee36-4813-90d0-48eba5957564+input&quot; xmlns:tns1=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:ns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+f475d29d-86c7-4a72-bd2f-2f6d0d7f081d+output&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;JMSSendMessage2-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;JMSPriority>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/JMSPriority>&lt;Body>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns1:Envelope&quot;/>&lt;/Body>&lt;DynamicProperties>&lt;xsl:for-each select=&quot;$JMSReceiveMessage/DynamicProperties/ns:property&quot;>&lt;tns:property>&lt;tns:name>&lt;xsl:copy-of select=&quot;ns:name/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;ns:name&quot;/>&lt;/tns:name>&lt;tns:value>&lt;xsl:copy-of select=&quot;ns:value/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;ns:value&quot;/>&lt;/tns:value>&lt;tns:type>&lt;xsl:copy-of select=&quot;ns:type/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;ns:type&quot;/>&lt;/tns:type>&lt;/tns:property>&lt;/xsl:for-each>&lt;/DynamicProperties>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jms.send"
