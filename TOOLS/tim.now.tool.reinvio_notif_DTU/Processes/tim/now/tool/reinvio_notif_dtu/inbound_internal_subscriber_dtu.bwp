                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+26b4ef91-a24f-4622-9601-49078fc1431a+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns1=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns0=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+f475d29d-86c7-4a72-bd2f-2f6d0d7f081d+output&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MAP_EVENT_ACK&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;getIdTipolgNotf&quot;/>&lt;xsl:param name=&quot;MAP_EVENT_NTF&quot;/>&lt;xsl:template name=&quot;InsertRec-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MAP_EVENT_ACK/ns:ID_RICHIESTA)>0 and ($JMSReceiveMessage/DynamicProperties/ns0:property[upper-case(ns0:name)=&amp;quot;SOAPACTION&amp;quot;]/ns0:value='GetAck' or $JMSReceiveMessage/DynamicProperties/ns0:property[upper-case(ns0:name)=&amp;quot;SOAPACTION&amp;quot;]/ns0:value='InvioAck' or $JMSReceiveMessage/DynamicProperties/ns0:property[upper-case(ns0:name)=&amp;quot;SOAPACTION&amp;quot;]/ns0:value='&amp;quot;GetAck&amp;quot;' or $JMSReceiveMessage/DynamicProperties/ns0:property[upper-case(ns0:name)=&amp;quot;SOAPACTION&amp;quot;]/ns0:value='&amp;quot;InvioAck&amp;quot;')&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($JMSReceiveMessage/Body/tns1:Envelope)&quot;/>&lt;/CONTENUTO_REQUEST>&lt;ID_RICH_DTU>&lt;xsl:value-of select=&quot;$MAP_EVENT_ACK/ns:TRANSACTION_ID&quot;/>&lt;/ID_RICH_DTU>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MAP_EVENT_ACK/ns:ID_RICHIESTA)&quot;>&lt;xsl:value-of select=&quot;$MAP_EVENT_ACK/ns:ID_RICHIESTA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;TIMSTP_INSERIMENTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_INSERIMENTO>&lt;TIPOLOG_NOTF>&lt;xsl:value-of select=&quot;'ACK'&quot;/>&lt;/TIPOLOG_NOTF>&lt;FLAG_RETRY>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/FLAG_RETRY>&lt;ID_TIPOLOG_EVENTO>&lt;xsl:value-of select=&quot;xsd:int($getIdTipolgNotf/Record[1]/IDTPLG_EVENTO)&amp;#xD;&amp;#xA;&quot;/>&lt;/ID_TIPOLOG_EVENTO>&lt;ID_ORDINE_DTU xsi:nil=&quot;true&quot;/>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:jdbcUpdateActivityInput>&lt;CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($JMSReceiveMessage/Body/tns1:Envelope)&quot;/>&lt;/CONTENUTO_REQUEST>&lt;ID_RICH_DTU>&lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns:TESTATA/ns:TRANSACTION_ID&amp;#xD;&amp;#xA;&quot;/>&lt;/ID_RICH_DTU>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA&amp;#xD;&amp;#xA;&quot;/>&lt;/ID_RICH_OLO>&lt;TIMSTP_INSERIMENTO>&lt;xsl:value-of select=&quot;current-dateTime()&amp;#xD;&amp;#xA;&quot;/>&lt;/TIMSTP_INSERIMENTO>&lt;TIPOLOG_NOTF>&lt;xsl:value-of select=&quot;'EVENT'&quot;/>&lt;/TIPOLOG_NOTF>&lt;FLAG_RETRY>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/FLAG_RETRY>&lt;ID_TIPOLOG_EVENTO>&lt;xsl:value-of select=&quot;xsd:int($getIdTipolgNotf/Record[1]/IDTPLG_EVENTO)&quot;/>&lt;/ID_TIPOLOG_EVENTO>&lt;ID_ORDINE_DTU>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MAP_EVENT_NTF/ns:TESTATA/ns:ID_ORDINE_DTU)&quot;>&lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ORDINE_DTU>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:othe