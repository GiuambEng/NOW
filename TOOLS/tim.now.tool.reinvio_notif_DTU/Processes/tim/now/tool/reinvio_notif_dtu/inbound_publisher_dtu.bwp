                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT  contenuto_request,id_rich_dtu, id_rich_olo,&#xd;&#xa;       timstp_reinvio, timstp_inserimento,flag_retry,&#xd;&#xa;     tipologia_notf, id_tipolog_evento&#xd;&#xa;  FROM INBOUND_DTU_NOW WHERE &#xd;&#xa;  flag_retry='Y'&#xd;&#xa;   order by timstp_inserimento asc" xsi:type="jdbcPalette:JDBCQueryActivity">
