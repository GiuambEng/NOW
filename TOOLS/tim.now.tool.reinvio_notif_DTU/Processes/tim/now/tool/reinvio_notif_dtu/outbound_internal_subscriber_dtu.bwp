                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+94946c72-ca73-42e9-bc32-52c79d9b1fb9+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MAP_EVENT_NTF&quot;/>&lt;xsl:param name=&quot;getIdTipolgNotf&quot;/>&lt;xsl:template name=&quot;UPDATE_ID_RIC-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_RICH_OLO_OLD>&lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/ID_RICH_OLO_OLD>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA, '_')&quot;>&lt;ID_RICH_OLO_NEW>&lt;xsl:value-of select=&quot;concat(substring-before($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA, '_'),'_', xsd:string(xsd:int(number(substring-after($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA, '_'))+1)))&quot;/>&lt;/ID_RICH_OLO_NEW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RICH_OLO_NEW>&lt;xsl:value-of select=&quot;concat($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA,'_1')&quot;/>&lt;/ID_RICH_OLO_NEW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_RICH_DTU>&lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&lt;/ID_RICH_DTU>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA, '_')&quot;>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;concat(substring-before($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA, '_'),'_', xsd:string(xsd:int(number(substring-after($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA, '_'))+1)))&quot;/>&lt;/ID_RICH_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;concat($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA,'_1')&quot;/>&lt;/ID_RICH_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_TIPOLOG_EVENTO>&lt;xsl:value-of select=&quot;xsd:integer($getIdTipolgNotf/Record[1]/IDTPLG_EVENTO)&quot;/>&lt;/ID_TIPOLOG_EVENTO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
