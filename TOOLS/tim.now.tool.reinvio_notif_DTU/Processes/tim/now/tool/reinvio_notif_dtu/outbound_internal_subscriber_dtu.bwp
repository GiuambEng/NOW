                                    DataTypeDisplayValue="VARCHAR" ParameterName="CONTENUTO_REQUEST"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_DTU"/>
