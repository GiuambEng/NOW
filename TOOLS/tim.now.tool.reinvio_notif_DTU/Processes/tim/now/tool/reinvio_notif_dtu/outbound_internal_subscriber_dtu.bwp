                            <bpws:sources>
                                <bpws:source linkName="UpdateJMSMessageToEmpty1"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d357d3e4-9efb-4ce8-84b4-6dd1ca5bd630+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MAP_EVENT_ACK&quot;/>&lt;xsl:param name=&quot;MAP_EVENT_NTF&quot;/>&lt;xsl:param name=&quot;getIdTipolgNotf&quot;/>&lt;xsl:template name=&quot;UpdateJMSMessage-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MAP_EVENT_ACK) and  $MAP_EVENT_ACK/ns:TRANSACTION_ID!='VUOTO'&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_RICH_DTU>&lt;xsl:value-of select=&quot;$MAP_EVENT_ACK/ns:TRANSACTION_ID&quot;/>&lt;/ID_RICH_DTU>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MAP_EVENT_ACK/ns:ID_RICHIESTA)&quot;>&lt;xsl:value-of select=&quot;$MAP_EVENT_ACK/ns:ID_RICHIESTA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;TIPOLOGIA_NOTF>&lt;xsl:value-of select=&quot;'ACK'&quot;/>&lt;/TIPOLOGIA_NOTF>&lt;FLAG_RETRY>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/FLAG_RETRY>&lt;ID_TIPOLOG_EVENTO>&lt;xsl:value-of select=&quot;xsd:integer($getIdTipolgNotf/Record[1]/IDTPLG_EVENTO)&quot;/>&lt;/ID_TIPOLOG_EVENTO>&lt;ID_RICH_DTU_W>&lt;xsl:value-of select=&quot;$MAP_EVENT_ACK/ns:TRANSACTION_ID&quot;/>&lt;/ID_RICH_DTU_W>&lt;ID_RICH_OLO_W>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MAP_EVENT_ACK/ns:ID_RICHIESTA)&quot;>&lt;xsl:value-of select=&quot;$MAP_EVENT_ACK/ns:ID_RICHIESTA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO_W>&lt;TIPOLOGIA_NOTF_W>&lt;xsl:value-of select=&quot;'ACK'&quot;/>&lt;/TIPOLOGIA_NOTF_W>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:jdbcUpdateActivityInput>&lt;ID_RICH_DTU>&lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&lt;/ID_RICH_DTU>&lt;xsl:choose>&lt;xsl:when test=&quot;$getIdTipolgNotf/Record[1]/IDTPLG_EVENTO=1&amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;contains($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA, '_')&quot;>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;concat(substring-before($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA, '_'),'_', xsd:string(xsd:int(number(substring-after($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA, '_'))+1)))&quot;/>&lt;/ID_RICH_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$getIdTipolgNotf/Record[1]/IDTPLG_EVENTO=1&quot;>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;concat($MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA,'_1')&quot;/>&lt;/ID_RICH_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/ID_RICH_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TIPOLOGIA_NOTF>&lt;xsl:value-of select=&quot;'EVENT'&quot;/>&lt;/TIPOLOGIA_NOTF>&lt;FLAG_RETRY>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/FLAG_RETRY>&lt;ID_TIPOLOG_EVENTO>&lt;xsl:value-of select=&quot;xsd:integer($getIdTipolgNotf/Record[1]/IDTPLG_EVENTO)&quot;/>&lt;/ID_TIPOLOG_EVENTO>&lt;ID_RICH_DTU_W>&lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&lt;/ID_RICH_DTU_W>&lt;ID_RICH_OLO_W>&lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&lt;/ID_RICH_OLO_W>&lt;TIPOLOGIA_NOTF_W>&lt;xsl:value-of select=&quot;'EVENT'&quot;/>&lt;/TIPOLOGIA_NOTF_W>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="timeout"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE OUTBOUND_NOW_DTU&#xd;&#xa;  SET  ID_RICH_DTU = ?, ID_RICH_OLO = ?,&#xd;&#xa;      TIPOLOGIA_NOTF = ?, timstp_reinvio = NULL, &#xd;&#xa;      FLAG_RETRY = ? ,  ID_TIPOLOG_EVENTO=? where  ID_RICH_DTU = ? and ID_RICH_OLO = ? and &#xd;&#xa;      TIPOLOGIA_NOTF=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_DTU"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLOGIA_NOTF"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_RETRY"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_TIPOLOG_EVENTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_DTU_W"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_W"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLOGIA_NOTF_W"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:activityExtension
                            inputVariable="getIdTipolgNotf-input"
                            name="getIdTipolgNotf"
                            outputVariable="getIdTipolgNotf"
                            tibex:xpdlId="aa34c975-b5fa-481b-91d9-1c0974c7dc6c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="LogToJDBCQuery"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="getIdTipolgNotfToUpdateJMSMessage_Otherwise">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="getIdTipolgNotfToEmissioneLOG">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$getIdTipolgNotf/Record[1]/IDTPLG_EVENTO=1 and not(contains($MAP_EVENT_NTF/ns5:TESTATA/ns5:ID_RICHIESTA, '_')) &#xd;&#xa;or ($getIdTipolgNotf/Record[1]/IDTPLG_EVENTO=1  and contains($MAP_EVENT_NTF/ns5:TESTATA/ns5:ID_RICHIESTA, '_') and &#xd;&#xa;number(substring-after($MAP_EVENT_NTF/ns5:TESTATA/ns5:ID_RICHIESTA, '_')) >1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$getIdTipolgNotf/Record[1]/IDTPLG_EVENTO=1 and not(contains($MAP_EVENT_NTF/ns5:TESTATA/ns5:ID_RICHIESTA, '_')) 
or ($getIdTipolgNotf/Record[1]/IDTPLG_EVENTO=1  and contains($MAP_EVENT_NTF/ns5:TESTATA/ns5:ID_RICHIESTA, '_') and 
number(substring-after($MAP_EVENT_NTF/ns5:TESTATA/ns5:ID_RICHIESTA, '_')) >1)]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding
