                                    sqlStatement="INSERT INTO OUTBOUND_NOW_DTU&#xa;(CONTENUTO_REQUEST,ID_RICH_DTU, ID_RICH_OLO, TIMSTP_INSERIMENTO, &#xa;TIPOLOGIA_NOTF,FLAG_RETRY,ID_TIPOLOG_EVENTO)   &#xa;  VALUES  (?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
