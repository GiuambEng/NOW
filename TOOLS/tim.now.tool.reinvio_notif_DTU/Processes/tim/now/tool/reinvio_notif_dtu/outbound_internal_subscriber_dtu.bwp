                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://services.bds.tibco.com/BusinessDataServices_1.2.0&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;caseModelVersion&quot;/>&#xa;    &lt;xsl:param name=&quot;caseType&quot;/>&#xa;    &lt;xsl:param name=&quot;MAP_EVENT_NTF&quot;/>&#xa;    &lt;xsl:template name=&quot;findCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:FindCaseByCriteriaRequest>&#xa;            &lt;caseModelVersion>&#xa;                &lt;xsl:value-of select=&quot;$caseModelVersion&quot;/>&#xa;            &lt;/caseModelVersion>&#xa;            &lt;caseType>&#xa;                &lt;xsl:value-of select=&quot;$caseType&quot;/>&#xa;            &lt;/caseType>&#xa;            &lt;criteria>&#xa;                &lt;queryString>&#xa;                    &lt;xsl:value-of select=&quot;'IDRichiestaOLO=:ID'&quot;/>&#xa;                &lt;/queryString>&#xa;                &lt;namedParameterAssignment>&#xa;                    &lt;name>&#xa;                        &lt;xsl:value-of select=&quot;'ID'&quot;/>&#xa;                    &lt;/name>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($MAP_EVENT_NTF/ns1:TESTATA/ns1:ID_RICHIESTA, '_')&quot;>&#xa;                            &lt;value>&#xa;                                &lt;xsl:value-of select=&quot;substring-before($MAP_EVENT_NTF/ns1:TESTATA/ns1:ID_RICHIESTA, '_')&quot;/>&#xa;                            &lt;/value>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;value>&#xa;                                &lt;xsl:value-of select=&quot;$MAP_EVENT_NTF/ns1:TESTATA/ns1:ID_RICHIESTA&quot;/>&#