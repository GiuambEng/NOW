            <xs:element name="jdbcUpdateActivityOutput" type="tns:jdbcUpdateOutput"/>
        </xs:schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+aa34c975-b5fa-481b-91d9-1c0974c7dc6c+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+aa34c975-b5fa-481b-91d9-1c0974c7dc6c+input">
            <element name="jdbcQueryActivityInput">
