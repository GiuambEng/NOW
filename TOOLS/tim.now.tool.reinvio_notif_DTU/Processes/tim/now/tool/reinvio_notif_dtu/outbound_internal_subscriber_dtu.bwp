$JMSReceiveMessageOUTBOUND/DynamicProperties/ns0:property[upper-case(ns0:name)="SOAPACTION"]/ns0:value='"InvioAck"' or $JMSReceiveMessageOUTBOUND/DynamicProperties/ns0:property[upper-case(ns0:name)="SOAPACTION"]/ns0:value='Richiesta_ACK']]></bpws:transitionCondition>
