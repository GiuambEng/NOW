<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:Q1="http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/" xmlns:Q2="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:Q4="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://www.example.org/BPM_DTUNotificationManagement_v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v1/" elementFormDefault="qualified" xmlns:pref="http://NOW.it.telecomitalia.it/casedata">
	<xsd:import namespace="http://NOW.it.telecomitalia.it/casedata" schemaLocation="Casedata.xsd"/>
	<xsd:import namespace="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" schemaLocation="Tracciati_Richiesta_Notifica_NOW_DTU.xsd"/>
	<xsd:element name="manageNotificationRequest">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="ID_RICHIESTA">
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="31"></xsd:maxLength>
							</xsd:restriction>
						</xsd:simpleType>
				</xsd:element>
				<xsd:element name="ProgressivoNotificaDTU" type="xsd:int"/>
				<xsd:element name="IdEventoOrdnNowWhls" type="xsd:int"/>
				<xsd:element name="CodProcsoNoFile" type="xsd:string"/>
				<xsd:element name="IdEsecProcsoNoFile" type="xsd:int"/>
				<xsd:choice>
					<xsd:element ref="Q2:EVENTO_NOTIFICA" />
					<xsd:element ref="Q2:ACK_COMUNICAZIONE" />
				</xsd:choice>
				<xsd:element name="ID_ANAGRAFICA_CAUSALE" type="xsd:int" />
				<xsd:element name="STATO_SUCCESSIVO" type="xsd:string" minOccurs="0" />
				<xsd:element name="ID_NOTIFICA_RECIPIENT"
					type="xsd:string" minOccurs="0" maxOccurs="unbounded" />
				<xsd:element name="ID_NOTIFICA_DONATING"
					type="xsd:string" minOccurs="0" maxOccurs="unbounded" />
				<xsd:element name="ID_NOTIFICA_DONOR" type="xsd:string"
					minOccurs="0" maxOccurs="unbounded" />
				<xsd:element name="ARRICCHIMENTI"
					type="Q1:Arricchimenti_Type" minOccurs="0" maxOccurs="unbounded" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="Arricchimenti_Type">
		<xsd:sequence>
			<xsd:element name="Arricchimento" type="Q1:ArricchimentoType"/>
			<xsd:element name="Operation">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="CREATE"/>
						<xsd:enumeration value="UPDATE"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="ArricchimentoType">
		<xsd:choice>
			<xsd:element ref="pref:DettaglioOrdineElement" maxOccurs="unbounded" />
			<xsd:element ref="pref:SedeElement"/>
			<xsd:element ref="pref:ReferenteElement"/>
			<xsd:element ref="pref:DettaglioAssetElement"/>
		</xsd:choice>
	</xsd:complexType>
</xsd:schema>
