<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:cst="http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29" xmlns:pref="http://tempuri.org/" xmlns:tns="http://www.tim.com/NOW/xsd/CRMRetail/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/CRMRetail/">
	<import namespace="http://tempuri.org/" schemaLocation="CRMR-CRMB.xsd"/>
	<import namespace="http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29" schemaLocation="../ServizioCCC/CustomerConsistencyInfoQuery.xsd"/>
	<element name="CRMRetailRequest">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="GetDatiLineaUnica" type="tns:CRMRetailRequestType"/>
				<element maxOccurs="1" minOccurs="0" name="IDRichiestaOLO" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="RootProcessInstance" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Oscurato" type="boolean"/>
			</sequence>
		</complexType>
	</element>

	<element name="CRMRetailResponse">
		<complexType>
			<sequence>
				<element name="GetDatiLineaUnicaResponse" type="tns:CRMRetailResponseType"/>
			</sequence>
		</complexType>
	</element>

	<complexType name="CRMRetailRequestType">
		<sequence>
			<element ref="pref:GetDatiLineaUnica"/>
		</sequence>
	</complexType>
	<complexType name="CRMRetailResponseType">
		<sequence>
			<element minOccurs="0" ref="pref:GetDatiLineaUnicaResponse"/>
			<element minOccurs="0" ref="pref:GetDatiLineaUnicaXResponse"/>
			<element minOccurs="0" ref="cst:getDataResponse"/>
		</sequence>
	</complexType>
	
	<!--  Salvataggio output chiamate CRM per calcolo ESITO. -->	
	<element name="CRMparam">
		<complexType>
			<sequence>
				<element name="CRM" type="tns:CRMResponseType"/>
			</sequence>
		</complexType>
	</element>
	
	<complexType name="CRMResponseType">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="StatoNumerazione" type="string" />
			<element maxOccurs="1" minOccurs="0" name="StatoServizio" type="string" />
			<element maxOccurs="1" minOccurs="0" name="Lavorazione" type="string" />
			<element maxOccurs="1" minOccurs="0" name="DescrizioneErrore" type="string" />
			<element maxOccurs="1" minOccurs="0" name="TipoConnettivita" type="string" />
		</sequence>
	</complexType>
</schema>
