<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns:bvi="http://telecomitalia.it/SOA/BVI"
	 xmlns:cst="http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29"
	 targetNamespace="http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29"
	 version="1.0"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	<!--  complexTypeForResponse END -->

	<!--  complexTypeForRequest START -->
	<xs:complexType name="GetDatiLineaUnicaXSoapIn_Type">
		<xs:sequence>
			<xs:element name="Prefisso" type="xs:string" minOccurs="0"/>
			<xs:element name="Numero" type="xs:string" minOccurs="0"/>
			<xs:element name="Sistema" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<!--  complexTypeForRequest END -->
	<!--  complexTypeForResponse START -->
	<xs:complexType name="ServizioUnicaX">
		<xs:sequence>
			<xs:element name="Multinumero" type="cst:Multinumeri" minOccurs="0"/>
			<xs:element name="StatoNumerazione" type="xs:string" minOccurs="0"/>
			<xs:element name="TipoConnettivita" type="xs:string" minOccurs="0"/>
			<xs:element name="StatoServizio" type="xs:string" minOccurs="0"/>
			<xs:element name="Lavorazione" type="xs:string" minOccurs="0"/>
			<xs:element name="DataEspletamento" type="xs:string" minOccurs="0"/>
			<xs:element name="PiattaformaCommerciale" type="xs:string" minOccurs="0"/>
			<xs:element name="Errore" type="cst:Errore" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Multinumeri">
		<xs:sequence>
			<xs:element name="Principale" type="xs:string" minOccurs="0"/>
			<xs:element name="Aggiuntivi" type="cst:ArrayOfAnyType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Errore">
		<xs:sequence>
			<xs:element name="Codice" type="xs:string" minOccurs="0"/>
			<xs:element name="Descrizione" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ArrayOfAnyType">
		<xs:sequence>
			<xs:element name="Aggiuntivo" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>