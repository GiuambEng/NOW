<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ProcessoNoFile/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ProcessoNoFile/">

    <element name="Input_ProcessoNoFile" type="tns:Input_ProcessoNoFile_Type"></element>

    <element name="Output_ProcessoNoFile" type="tns:Output_ProcessoNoFile_Type"></element>

    <complexType name="Input_ProcessoNoFile_Type">
    	<sequence>
    		<element name="STATO_ESEC">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="CHIUSO"></enumeration>
    					<enumeration value="IN ELABORAZIONE"></enumeration>
    					<enumeration
    						value="PROCESSO ESEGUITO CON ERRORE">
    					</enumeration>
    					<minLength value="1"></minLength>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="DESCR_ERRORE" type="string" minOccurs="0"></element>
    		<element name="TMSP_INIZIO_ELAB" type="dateTime"
    			minOccurs="0">
    		</element>
    		<element name="TMSP_FINE_ELAB" type="dateTime"
    			minOccurs="0">
    		</element>
    		<element name="COD_INTRFC" maxOccurs="1" minOccurs="0">
    			<simpleType>
    				<restriction base="string"></restriction>
    			</simpleType>
    		</element>
    		<element name="ID_ESEC_PROCSO_NO_FILE" type="int"
    			minOccurs="0">
    		</element>
    		<element name="AZIONE" minOccurs="1">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="INSERT"></enumeration>
    					<enumeration value="UPDATE"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="RootProcessInstance" type="string"
    			minOccurs="0">
    		</element>
    		<element name="IdRichiestaOLO" type="string"
    			minOccurs="0">
    		</element>
    		<element name="TransactionID" type="string" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="Output_ProcessoNoFile_Type">
    	<sequence>
    		<element name="ID_ESEC_PROCSO_NO_FILE" type="int" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>