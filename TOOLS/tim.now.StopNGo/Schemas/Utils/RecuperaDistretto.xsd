<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/RecuperaDistretto" elementFormDefault="qualified" targetNamespace="http://www.example.org/RecuperaDistretto">
    <element name="Input_RecuperaDistretto" type="tns:Input_RecuperaDistretto_Type"/>
    
    <element name="Output_RecuperaDistretto" type="tns:Output_RecuperaDistretto_Type"/>
    
    <complexType name="Input_RecuperaDistretto_Type">
    	<sequence>
    		<element name="DN" type="string" maxOccurs="1" minOccurs="0"/>
    		<element name="RootProcessInstance" type="string"
    			minOccurs="0">
    		</element>
    		<element name="IdRichiestaOLO" type="string" minOccurs="0"></element>
    		<element name="ID_LavorazioneHD" type="int" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    
    <complexType name="Output_RecuperaDistretto_Type">
    	<sequence>
    		<element name="Distretto" type="string"/>
    		<element name="Numero" type="string"/>
            <element name="DistrettoNormalizzato" type="string"/>
            <element name="DN" type="string" minOccurs="0"/>
        </sequence>
    </complexType>




</schema>
