<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.example.org/Retry"
	xmlns:tns="http://www.example.org/Retry"
	elementFormDefault="qualified" xmlns:pref="http://www.tim.com/NOW/xsd/CRMRetail/">
	<import schemaLocation="../Servizi/CRMRetail.xsd" namespace="http://www.tim.com/NOW/xsd/CRMRetail/"></import>

	<element name="Request">
		<complexType>
			<sequence>
				<element name="GetDatiLineaUnica"
					type="pref:CRMRetailRequestType" maxOccurs="1" minOccurs="0">
				</element>
				<element name="IDRichiestaOLO" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="BonificaUnicaC" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="numeroTelefonico"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="distrettoTelefonico"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="servizioDaAttivare"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="UnicaC" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<element name="numeroTelefonico" type="string" maxOccurs="1" minOccurs="0"></element>
							<element name="distrettoTelefonico" type="string" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

	<element name="Response">
		<complexType>
			<sequence>
				<element name="GetDatiLineaUnicaResponse"
					type="pref:CRMRetailResponseType" maxOccurs="1" minOccurs="0">
				</element>
				<element name="ControlloChiamata" type="boolean"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="BonificaUnicaCResponse" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="esito" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="codiceErrore" type="string"
								maxOccurs="1" minOccurs="0">
							</element>
							<element name="numeroTelefonico"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="distrettoTelefonico"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="UnicaCResponse" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
                        <element name="esito" type="string" maxOccurs="1" minOccurs="0"/>
                        <element name="codiceErrore" type="string" maxOccurs="1" minOccurs="0"/>
                        <element name="dataAttivazione" nillable="true" type="string" maxOccurs="1" minOccurs="0"/>
                        <element name="dataCessazione" nillable="true" type="string" maxOccurs="1" minOccurs="0"/>
                        <element name="statoNumero" nillable="true" type="string" maxOccurs="1" minOccurs="0"/>
                        <element name="statoServizio" nillable="true" type="string" maxOccurs="1" minOccurs="0"/>
                        <element name="statoServizioInCorso" nillable="true" type="string" maxOccurs="1" minOccurs="0"/>
                        <element name="codPiattaforma" nillable="true" type="string" maxOccurs="1" minOccurs="0"/>
                    </sequence>
		
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>