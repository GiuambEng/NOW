<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RunWorkItem" xmlns:tns="http://www.example.org/RunWorkItem" elementFormDefault="qualified">
	<element name="RunWorkItem_Input">
    	<complexType>
    		<sequence>
    			<element type="string" maxOccurs="1" minOccurs="1" name="IDRICHIESTAOLO" />
    			<element maxOccurs="1" minOccurs="1" name="ACTION" >
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="RETRY" />
    						<enumeration value="SCARTO" />
    						<enumeration value="CAUTELARE" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element type="int" maxOccurs="1" minOccurs="0" name="CAUSALE" />
    			<element type="string" maxOccurs="1" minOccurs="0" name="RootProcessInstance"  />
    			<element type="string" minOccurs="0" maxOccurs="1" name="FlagCautelare" />
    			<element type="string" minOccurs="0" maxOccurs="1" name="StatoNumerazione" />
    			<element type="string" minOccurs="0" maxOccurs="1" name="Principale" />
    			<element type="string" minOccurs="0" maxOccurs="unbounded" name="Aggiuntivi" />
    			<element type="string" minOccurs="0" maxOccurs="1" name="TipoConnettivita" />
    		</sequence>
    	</complexType>
    </element>
    
    <element name="RunWorkItem_Output">
    	<complexType>
    		<sequence>
    			<element name="Esito" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="OK" />
    						<enumeration value="KO" />
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Descrizione" type="string" maxOccurs="1" minOccurs="0" />
    		</sequence>
    	</complexType>
    </element>
</schema>