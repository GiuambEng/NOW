                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_SCHEDULER FROM CFG_TOOL_SCHEDULER &#xa;WHERE FLAG_LETTURA = 'N' AND ID_SCHEDULER  IN ('C26M05R01','C26M05R02','C26M05R03')" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_SCHEDULER"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dbfefa17-97fe-4ca9-9ae9-e2517e1d699b+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NumMaxRetry_CONNECTIONTIMEOUT&quot;/>&lt;xsl:template name=&quot;RetryConnectionTimeout-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;NUM_RETRY_CONNECTIONTIMEOUT>&lt;xsl:value-of select=&quot;$NumMaxRetry_CONNECTIONTIMEOUT&quot;/>&lt;/NUM_RETRY_CONNECTIONTIMEOUT>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
