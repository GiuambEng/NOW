                                    sqlStatement="UPDATE TOOL_STOPNGO_RICH &#xa;SET STATO ='DA ELABORARE', LAST_UPDATE=SYSDATE , NUM_RETRY=NVL(NUM_RETRY, 0) + 1&#xa;WHERE ESITO='CONNECTION TIMEOUT' AND STATO='ERROR' AND NVL(NUM_RETRY, 0) &lt; ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
