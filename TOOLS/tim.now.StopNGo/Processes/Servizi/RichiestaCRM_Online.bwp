                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/DatiVerificaControlli/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:tns2=&quot;http://tempuri.org/&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29&quot; xmlns:ns1=&quot;http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiLineaUnicaX.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiLineaUnica.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeCCC.body&quot;/>&#xa;    &lt;xsl:param name=&quot;StartRichiestaCRM_Online&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaCtrli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DatiVerificaControlliInput>&#xa;            &lt;tns:Operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/tns:Operatore>&#xa;            &lt;tns:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$StartRichiestaCRM_Online/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns:IDRichiestaOLO>&#xa;            &lt;tns:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns:Azione>&#xa;            &lt;tns:DatiCRM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($DatiLineaUnicaX.parameters/tns2:GetDatiLineaUnicaXResult/tns2:TipoConnettivita) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$DatiLineaUnicaX.parameters/tns2:GetDatiLineaUnicaXResult/tns2:TipoConnettivita&quot;>&#xa;                            &lt;tns:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$DatiLineaUnicaX.parameters/tns2:GetDatiLineaUnicaXResult/tns2:TipoConnettivita&quot;/>&#xa;                            &lt;/tns:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($InvokeCCC.body/ns1:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$InvokeCCC.body/ns1:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita&quot;>&#xa;                            &lt;tns:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$InvokeCCC.body/ns1:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita&quot;/>&#xa;                            &lt;/tns:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$DatiLineaUnica.parameters/tns2:GetDatiLineaUnicaResult/tns2:TipoConnettivita&quot;>&#xa;                            &lt;tns:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$DatiLineaUnica.parameters/tns2:GetDatiLineaUnicaResult/tns2:TipoConnettivita&quot;/>&#xa;                            &lt;/tns:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:DatiCRM>&#xa;        &lt;/tns:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogEndRichiestaCRM_NotOscurato"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="DatiVerificaCtrliToLog"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
