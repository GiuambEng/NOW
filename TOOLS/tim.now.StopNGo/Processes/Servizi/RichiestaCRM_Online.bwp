    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="da784d73-87ca-4aa5-84e5-7a9a927440b4">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="CallProcess1ToCallProcess" tibex:linkType="SUCCESS"/>
                            <bpws:link name="UpdateTrackingKOToLog1" tibex:linkType="ERROR"/>
                            <bpws:link name="UpdateStagingKOToLog1" tibex:linkType="ERROR"/>
                            <bpws:link
                                name="LogErrorRichiestaCRM_OnlineToUpdateTrackingKO" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="UpdateStagingKOToRethrow" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="LogFaultUpdateTracking_UpdateStagingKOToRethrow" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="LogErrorRichiestaCRM_OnlineToRethrow" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="LogErrorRichiestaCRM_Online-input"
                                name="LogErrorRichiestaCRM_Online"
                                tibex:xpdlId="be73a1f1-6f4d-44c2-b8be-3d3305ecde7c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogErrorRichiestaCRM_OnlineToUpdateTrackingKO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ID_ESEC>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ID_ESEC>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogErrorRichiestaCRM_OnlineToRethrow">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;StartRichiestaCRM_Online&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;LogErrorRichiestaCRM_Online-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| RootProcessInstance &amp;quot;, $StartRichiestaCRM_Online/tns1:RootProcessInstance,&amp;quot;| ProcessInstance &amp;quot;,$_processContext/ProcessInstanceId,&amp;quot;| IdRichiestaOLO &amp;quot;,$StartRichiestaCRM_Online/tns1:IDRichiestaOLO)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails,true(), true())&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Error"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:rethrow name="Rethrow" tibex:xpdlId="36ab47d7-0c8a-483c-a12f-e07de7ba138d">
                            <bpws:targets>
                                <bpws:target linkName="UpdateStagingKOToRethrow"/>
                                <bpws:target linkName="LogFaultUpdateTracking_UpdateStagingKOToRethrow"/>
                                <bpws:target linkName="LogErrorRichiestaCRM_OnlineToRethrow"/>
                            </bpws:targets>
                        </bpws:rethrow>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="LogFaultUpdateTracking_UpdateStagingKO-input"
                                name="LogFaultUpdateTracking_UpdateStagingKO"
                                tibex:xpdlId="61cba5dd-ef7a-4c13-8f20-095302ac58f8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="UpdateTrackingKOToLog1"/>
                                    <bpws:target linkName="UpdateStagingKOToLog1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="LogFaultUpdateTracking_UpdateStagingKOToRethrow"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;StartRichiestaCRM_Online&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultUpdateTracking_UpdateStagingKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| RootProcessInstance &amp;quot;, $StartRichiestaCRM_Online/tns1:RootProcessInstance,&amp;quot;| ProcessInstance &amp;quot;,$_processContext/ProcessInstanceId,&amp;quot;| IdRichiestaOLO &amp;quot;,$StartRichiestaCRM_Online/tns1:IDRichiestaOLO)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat($_error/StackTrace ,$_error/ProcessStack,$_error/Msg,$_error/FullClass,$_error/Class,$_error/MsgCode)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Warning"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="UpdateTrackingKO-input"
                                name="UpdateTrackingKO"
                                outputVariable="UpdateTrackingKO"
                                tibex:xpdlId="414101d9-d196-493d-831e-185e36230096"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="LogErrorRichiestaCRM_OnlineToUpdateTrackingKO"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToCallProcess"/>
                                    <bpws:source
                                    linkName="UpdateTrackingKOToLog1"
                                    tibex:faultDetailsVar="UpdateTrackingKO" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartRichiestaCRM_Online&quot;/>&lt;xsl:param name=&quot;ID_ESEC&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;UpdateTrackingKO-input&quot; match=&quot;/&quot;>&lt;tns:Input_ProcessoNoFile>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&lt;/tns:STATO_ESEC>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&lt;/tns:DESCR_ERRORE>&lt;tns:TMSP_FINE_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_FINE_ELAB>&lt;tns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:int($ID_ESEC)&quot;/>&lt;/tns:ID_ESEC_PROCSO_NO_FILE>&lt;tns:AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&lt;/tns:AZIONE>&lt;xsl:if test=&quot;$StartRichiestaCRM_Online/tns1:RootProcessInstance&quot;>&lt;tns:RootProcessInstance>&lt;xsl:value-of select=&quot;$StartRichiestaCRM_Online/tns1:RootProcessInstance&quot;/>&lt;/tns:RootProcessInstance>&lt;/xsl:if>&lt;xsl:if test=&quot;$StartRichiestaCRM_Online/tns1:IDRichiestaOLO&quot;>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$StartRichiestaCRM_Online/tns1:IDRichiestaOLO&quot;/>&lt;/tns:IdRichiestaOLO>&lt;/xsl:if>&lt;/tns:Input_ProcessoNoFile>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    subProcessName="Tracking.ProcessoNoFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="UpdateStagingKO-input"
                                name="UpdateStagingKO"
                                outputVariable="UpdateStagingKO"
                                tibex:xpdlId="de82bfdb-a85b-4cb7-965b-21ecc3de7ec3"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToCallProcess"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source
                                    linkName="UpdateStagingKOToLog1"
                                    tibex:faultDetailsVar="UpdateStagingKO" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="UpdateStagingKOToRethrow"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InserUpdateStaging/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartRichiestaCRM_Online&quot;/>&lt;xsl:param name=&quot;ID_ESEC&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;UpdateStagingKO-input&quot; match=&quot;/&quot;>&lt;tns:StagingRequest>&lt;tns:GenericStaging>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($FaultDetails)&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;'ERRORE NELLA CHIAMATA AL SERVIZIO'&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'12'&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:int($ID_ESEC)&quot;/>&lt;/tns:ID_ESEC_PROCSO_NO_FILE>&lt;tns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_RISPOSTA>&lt;/tns:GenericStaging>&lt;xsl:if test=&quot;$StartRichiestaCRM_Online/tns1:IDRichiestaOLO&quot;>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$StartRichiestaCRM_Online/tns1:IDRichiestaOLO&quot;/>&lt;/tns:IdRichiestaOLO>&lt;/xsl:if>&lt;tns:StagingType>&lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&lt;/tns:StagingType>&lt;/tns:StagingRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    subProcessName="Staging.Staging_STAG_DATI_LINEA_CRM_RETAIL" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link
                    name="TRANSACTION_IDToLogStartRichiestaCRM_Online" tibex:linkType="SUCCESS"/>
