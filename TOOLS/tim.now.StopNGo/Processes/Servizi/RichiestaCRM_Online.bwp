                        <bpws:source linkName="InsertTrackingToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartRichiestaCRM_Online&quot;/>&lt;xsl:param name=&quot;TRANSACTION_ID&quot;/>&lt;xsl:param name=&quot;COD_INTRFC&quot;/>&lt;xsl:template name=&quot;InsertTracking-input&quot; match=&quot;/&quot;>&lt;tns:Input_ProcessoNoFile>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&lt;/tns:STATO_ESEC>&lt;tns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_INIZIO_ELAB>&lt;tns:COD_INTRFC>&lt;xsl:value-of select=&quot;$COD_INTRFC&quot;/>&lt;/tns:COD_INTRFC>&lt;tns:AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&lt;/tns:AZIONE>&lt;xsl:if test=&quot;$StartRichiestaCRM_Online/tns1:RootProcessInstance&quot;>&lt;tns:RootProcessInstance>&lt;xsl:value-of select=&quot;$StartRichiestaCRM_Online/tns1:RootProcessInstance&quot;/>&lt;/tns:RootProcessInstance>&lt;/xsl:if>&lt;xsl:if test=&quot;$StartRichiestaCRM_Online/tns1:IDRichiestaOLO&quot;>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$StartRichiestaCRM_Online/tns1:IDRichiestaOLO&quot;/>&lt;/tns:IdRichiestaOLO>&lt;/xsl:if>&lt;tns:TransactionID>&lt;xsl:value-of select=&quot;$TRANSACTION_ID&quot;/>&lt;/tns:TransactionID>&lt;/tns:Input_ProcessoNoFile>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="Tracking.ProcessoNoFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="UpdateTracking-input"
                    name="UpdateTracking"
                    outputVariable="UpdateTracking"
                    tibex:xpdlId="59dc224b-b751-448f-bbe2-72e1c57e4abc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnErrorToUpdateTracking"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateTrackingToCallProcess1"/>
                        <bpws:source linkName="UpdateTrackingToLog1"
                            tibex:faultDetailsVar="UpdateTracking" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
