            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:tns1=&quot;http://tempuri.org/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;StartRichiestaCRM_Online&quot;/>&lt;xsl:param name=&quot;DatiLineaUnica&quot;/>&lt;xsl:param name=&quot;DatiLineaUnicaX&quot;/>&lt;xsl:param name=&quot;InvokeCCC&quot;/>&lt;xsl:template name=&quot;LogEndRichiestaCRM_Online-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| RootProcessInstance &amp;quot;, $StartRichiestaCRM_Online/tns2:RootProcessInstance,&amp;quot;| ProcessInstance &amp;quot;,$_processContext/ProcessInstanceId,&amp;quot;| IdRichiestaOLO &amp;quot;,$StartRichiestaCRM_Online/tns2:IDRichiestaOLO)&quot;/>&lt;/msgCode>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($DatiLineaUnica/parameters/tns1:GetDatiLineaUnicaResponse)&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;End Process RichiestaCRM_Online response per GetDatiLineaUnica = &amp;quot;, tib:render-xml($DatiLineaUnica/parameters/tns1:GetDatiLineaUnicaResponse, true(), true()))&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($DatiLineaUnicaX/parameters/tns1:GetDatiLineaUnicaXResponse)&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;End Process RichiestaCRM_Online response per GetDatiLineaUnicaX = &amp;quot;, tib:render-xml($DatiLineaUnicaX/parameters/tns1:GetDatiLineaUnicaXResponse, true(), true()))&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($InvokeCCC/body/ns1:getDataResponse)&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;End Process RichiestaCRM_Online response per CCC = &amp;quot;, tib:render-xml($InvokeCCC/body/ns1:getDataResponse, true(), true()))&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;End Process RichiestaCRM_Online.&amp;quot;&quot;/>&lt;/message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogEndRichiestaCRM_Online-input"
                    name="LogEndRichiestaCRM_Online"
                    tibex:xpdlId="88a03889-ae0b-4914-8d6c-413b81fc173b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToLogEndRichiestaCRM_Online"/>
                        <bpws:target linkName="Log1ToLogEndRichiestaCRM_Online"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogEndRichiestaCRM_NotOscurato">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$StartRichiestaCRM_Online/ns3:Oscurato = false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$StartRichiestaCRM_Online/ns3:Oscurato = false()]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogEndRichiestaCRM_OnlineToEndRichiestaCRM_Online">
