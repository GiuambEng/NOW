                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InserUpdateStaging/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:tns2=&quot;http://tempuri.org/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:ns1=&quot;http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiLineaUnicaX.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiLineaUnica.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeCCC.body&quot;/>&#xa;    &lt;xsl:param name=&quot;StartRichiestaCRM_Online&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertTracking&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:StagingRequest>&#xa;            &lt;tns:GenericStaging>&#xa;                &lt;tns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'11'&quot;/>&#xa;                &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($DatiLineaUnica.parameters)&quot;>&#xa;                        &lt;tns:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($DatiLineaUnica.parameters, true(), true())&quot;/>&#xa;                        &lt;/tns:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($DatiLineaUnicaX.parameters)&quot;>&#xa;                        &lt;tns:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($DatiLineaUnicaX.parameters, true(), true())&quot;/>&#xa;                        &lt;/tns:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($InvokeCCC.body)&quot;>&#xa;                        &lt;tns:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($InvokeCCC.body, true(), true())&quot;/>&#xa;                        &lt;/tns:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                        &lt;/tns:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($DatiLineaUnica.parameters/tns2:GetDatiLineaUnicaResult/tns2:Errore/tns2:Codice) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$DatiLineaUnica.parameters/tns2:GetDatiLineaUnicaResult/tns2:Errore/tns2:Codice&quot;>&#xa;                            &lt;tns:ESITO>&#xa;                                &lt;xsl:value-of select=&quot;$DatiLineaUnica.parameters/tns2:GetDatiLineaUnicaResult/tns2:Errore/tns2:Codice&quot;/>&#xa;                            &lt;/tns:ESITO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($DatiLineaUnicaX.parameters/tns2:GetDatiLineaUnicaXResult/tns2:Errore/tns2:Codice) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$DatiLineaUnicaX.parameters/tns2:GetDatiLineaUnicaXResult/tns2:Errore/tns2:Codice&quot;>&#xa;                            &lt;tns:ESITO>&#xa;                                &lt;xsl:value-of select=&quot;$DatiLineaUnicaX.parameters/tns2:GetDatiLineaUnicaXResult/tns2:Errore/tns2:Codice&quot;/>&#xa;                            &lt;/tns:ESITO>&#xa;              