            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="InsertTracking-input"
                    name="InsertTracking"
                    outputVariable="InsertTracking"
                    tibex:xpdlId="5b9bbbcd-e7a9-48f4-b517-5885c0db89f7"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
