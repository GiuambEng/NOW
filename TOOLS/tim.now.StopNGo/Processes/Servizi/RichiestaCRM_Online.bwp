            <bpws:scope name="RepeatOnError" tibex:group="repeatOnError" tibex:xpdlId="69c78eb8-bdd2-43f5-84fa-2fc490e8ce7f">
                <bpws:targets>
                    <bpws:target linkName="LogToRepeatOnError"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatOnErrorToUpdateTracking"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="repeatOnError_success_flag"
                        sca-bpel:internal="true" type="xsd:boolean"/>
                    <bpws:variable name="FaultName2"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails2" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:scope name="innerScope">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails2" tibex:faultNameVar="FaultName2">
                                <bpws:if name="if">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index=$NumberRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index=$NumberRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow1"/>
                                    <bpws:else>
                                    <bpws:assign name="Assign" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                </bpws:if>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow4">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToScope" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ScopeToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="943065b8-c9bd-4eb9-afe9-ac4d0e457739">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToScope"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:assign name="GroupEnd1"
                                tibex:group="groupEnd"
                                tibex:xpdlId="c2473e06-1c36-4b58-8aea-5c6cc97ee4fe" validate="no">
                                <bpws:targets>
                                    <bpws:target linkName="ScopeToGroupEnd1"/>
                                </bpws:targets>
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:scope name="Scope" tibex:group="none" tibex:xpdlId="3ca39231-e882-4576-a833-c98643153144">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToScope"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ScopeToGroupEnd1"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="FaultName1"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns:FaultDetail"
                                    name="FaultDetails1" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails1"
                                    tibex:faultNameVar="FaultName1" tibex:xpdlId="fc0905fb-9fcd-4634-abca-03316413ab85">
                                    <bpws:scope name="scope2">
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="LogFaultInvokeGetDatiLineaUnicaToRethrow1" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="LogFaultInvokeGetDatiLineaUnica-input"
                                    name="LogFaultInvokeGetDatiLineaUnica"
                                    tibex:xpdlId="0bde4b58-db54-4a7b-b356-37e597024335" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="LogFaultInvokeGetDatiLineaUnicaToRethrow1"/>
