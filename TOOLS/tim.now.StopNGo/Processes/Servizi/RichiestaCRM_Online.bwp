            <plnk:partnerLinkType name="partnerLinkType2">
                <plnk:role name="use" portType="ptyp2:CustomerConsistencyInfoQueryPortType"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://tempuri.org/"/>
