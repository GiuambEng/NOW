                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/UnicaC&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;StartRichiestaUnicaC&quot;/>&lt;xsl:template name=&quot;Log_End-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;), &amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;| RootProcessInstance &amp;quot;, $StartRichiestaUnicaC/tns1:RootProcessInstance, &amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId, &amp;quot;| IdRichiestaOLO &amp;quot;, $StartRichiestaUnicaC/tns1:IdRichiestaOLO)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;'END CALL BONIFICA UNICA C'&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="InsertTrack-input"
                    name="InsertTrack" outputVariable="InsertTrack"
                    tibex:xpdlId="46e447ab-afa3-4d76-b7a9-d18336c87105"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log_StartRichiestaUnicaCToInsertTrack"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToUnica_C"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/UnicaC&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartRichiestaUnicaC&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID&quot;/>&#xa;    &lt;xsl:param name=&quot;COD_INTRFC&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertTrack-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input_ProcessoNoFile>&#xa;            &lt;tns:STATO_ESEC>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns:STATO_ESEC>&#xa;            &lt;tns:TMSP_INIZIO_ELAB>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns:TMSP_INIZIO_ELAB>&#xa;            &lt;tns:TMSP_FINE_ELAB>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns:TMSP_FINE_ELAB>&#xa;            &lt;tns:COD_INTRFC>&#xa;                &lt;xsl:value-of select=&quot;$COD_INTRFC&quot;/>&#xa;            &lt;/tns:COD_INTRFC>&#xa;            &lt;tns:AZIONE>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns:AZIONE>&#xa;            &lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns1:RootProcessInstance&quot;>&#xa;                &lt;tns:RootProcessInstance>&#xa;                    &lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns1:RootProcessInstance&quot;/>&#xa;                &lt;/tns:RootProcessInstance>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns1:IdRichiestaOLO&quot;>&#xa;                &lt;tns:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns1:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns:IdRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:TransactionID>&#xa;                &lt;xsl:value-of select=&quot;$TransactionID&quot;/>&#xa;            &lt;/tns:TransactionID>&#xa;        &lt;/tns:Input_ProcessoNoFile>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="Tracking.ProcessoNoFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="UpdateTrack-input"
                    name="UpdateTrack" outputVariable="UpdateTrack"
                    tibex:xpdlId="ee5a2835-ce24-4310-a8cd-6b49df956263"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnErrorToUpdateTrack"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToLog_End"/>
                        <bpws:source linkName="UpdateTrackToLog"
                            tibex:faultDetailsVar="UpdateTrack" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/UnicaC&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertTrack&quot;/>&#xa;    &lt;xsl:param name=&quot;StartRichiestaUnicaC&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateTrack-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input_ProcessoNoFile>&#xa;            &lt;tns:STATO_ESEC>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns:STATO_ESEC>&#xa;            &lt;tns:TMSP_FINE_ELAB>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns:TMSP_FINE_ELAB>&#xa;            &lt;xsl:if test=&quot;$InsertTrack/tns:ID_ESEC_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertTrack/tns:ID_ESEC_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns:ID_ESEC_PROCSO_NO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:AZIONE>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns:AZIONE>&#xa;            &lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns1:RootProcessInstance&quot;>&#xa;                &lt;tns:RootProcessInstance>&#xa;                    &lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns1:RootProcessInstance&quot;/>&#xa;                &lt;/tns:RootProcessInstance>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns1:IdRichiestaOLO&quot;>&#xa;                &lt;tns:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns1:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns:IdRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:TransactionID>&#xa;                &lt;xsl:value-of select=&quot;$TransactionID&quot;/>&#xa;            &lt;/tns:TransactionID>&#xa;        &lt;/tns:Input_ProcessoNoFile>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="Tracking.ProcessoNoFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="TransactionID"
                    name="TransactionID" outputVariable="TransactionID"
                    tibex:xpdlId="5fb026cb-3a9c-4081-892c-c8d219dfd19e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartRichiestaUnicaCToTransactionID"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TransactionIDToLog_StartRichiestaUnicaC"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat($StartRichiestaUnicaC/ns2:RootProcessInstance, &quot;:&quot;,format-dateTime(current-dateTime(),&quot;[D01][M01][Y0001][H01][m01][s01]&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TransactionID" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="InsertStaging-input"
                    name="InsertStaging" outputVariable="InsertStaging"
                    tibex:xpdlId="3c429f4f-e05e-4b3d-a6a2-d310574c7d72"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToUnica_C"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsertStagingToRepeatOnError"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InserUpdateStaging/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/UnicaC&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartRichiestaUnicaC&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertTrack&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:StagingRequest>&#xa;            &lt;tns:GenericStaging>&#xa;                &lt;tns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'11'&quot;/>&#xa;                &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                &lt;tns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($StartRichiestaUnicaC, true(), true())&quot;/>&#xa;                &lt;/tns:CONTENUTO_REQUEST>&#xa;                &lt;tns:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_RICH>&#xa;                &lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns4:IdRichiestaOLO&quot;>&#xa;                    &lt;tns:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns4:IdRichiestaOLO&quot;/>&#xa;                    &lt;/tns:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InsertTrack/tns2:ID_ESEC_PROCSO_NO_FILE&quot;>&#xa;                    &lt;tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$InsertTrack/tns2:ID_ESEC_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns:OPERATORE>&#xa;                &lt;tns:ID_TRANSAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionID&quot;/>&#xa;                &lt;/tns:ID_TRANSAZIONE>&#xa;                &lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns4:numeroTelefonico&quot;>&#xa;                    &lt;tns:DN>&#xa;                        &lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns4:numeroTelefonico&quot;/>&#xa;                    &lt;/tns:DN>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns4:distrettoTelefonico&quot;>&#xa;                    &lt;tns:DISTRETTO>&#xa;                        &lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns4:distrettoTelefonico&quot;/>&#xa;                    &lt;/tns:DISTRETTO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:WS_INVOCATO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ReperimentoServizio&amp;quot;&quot;/>&#xa;                &lt;/tns:WS_INVOCATO>&#xa;            &lt;/tns:GenericStaging>&#xa;            &lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns4:IdRichiestaOLO&quot;>&#xa;                &lt;tns:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns4:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns:IdRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;            &lt;/tns:StagingType>&#xa;        &lt;/tns:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="Staging.Staging_STAG_DATI_LINEA_UNICAC" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InserUpdateStaging/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/UnicaC&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:typens=&quot;http://unicac.telecomitalia.it/reperimentoservizio/types&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartRichiestaUnicaC&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertTrack&quot;/>&#xa;    &lt;xsl:param name=&quot;Unica_C&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:StagingRequest>&#xa;            &lt;tns:GenericStaging>&#xa;                &lt;tns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'11'&quot;/>&#xa;                &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                &lt;tns:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Unica_C/payload/typens:ReperimentoServizioRespType,true(), true())&quot;/>&#xa;                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Unica_C/payload/typens:ReperimentoServizioRespType/typens:esito)>0&quot;>&#xa;                        &lt;tns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$Unica_C/payload/typens:ReperimentoServizioRespType/typens:esito&quot;/>&#xa;                        &lt;/tns:ESITO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;'NA'&quot;/>&#xa;                        &lt;/tns:ESITO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$InsertTrack/tns3:ID_ESEC_PROCSO_NO_FILE&quot;>&#xa;                    &lt;tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$InsertTrack/tns3:ID_ESEC_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/tns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_RISPOSTA>&#xa;                &lt;tns:DESCR_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$Unica_C/payload/typens:ReperimentoServizioRespType/typens:codiceErrore&quot;/>&#xa;                &lt;/tns:DESCR_ESITO>&#xa;                &lt;xsl:if test=&quot;not((string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:statoNumero/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:statoNumero/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&#xa;                    &lt;tns:STATO_NUMERAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$Unica_C/payload/typens:ReperimentoServizioRespType/typens:statoNumero&quot;/>&#xa;                    &lt;/tns:STATO_NUMERAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:statoServizio/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:statoServizio/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&#xa;                    &lt;tns:STATO_SRVZ>&#xa;                        &lt;xsl:value-of select=&quot;$Unica_C/payload/typens:ReperimentoServizioRespType/typens:statoServizio&quot;/>&#xa;                    &lt;/tns:STATO_SRVZ>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:dataAttivazione/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:dataAttivazione/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&#xa;                    &lt;tns:DATA_ATTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$Unica_C/payload/typens:ReperimentoServizioRespType/typens:dataAttivazione&quot;/>&#xa;                    &lt;/tns:DATA_ATTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:dataCessazione/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:dataCessazione/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&#xa;                    &lt;tns:DATA_CESSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$Unica_C/payload/typens:ReperimentoServizioRespType/typens:dataCessazione&quot;/>&#xa;                    &lt;/tns:DATA_CESSAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:codPiattaforma/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:codPiattaforma/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&#xa;                    &lt;tns:PIATTAFORMA>&#xa;                        &lt;xsl:value-of select=&quot;$Unica_C/payload/typens:ReperimentoServizioRespType/typens:codPiattaforma&quot;/>&#xa;                    &lt;/tns:PIATTAFORMA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;not((string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:statoServizioInCorso/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C/payload/typens:ReperimentoServizioRespType/typens:statoServizioInCorso/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&#xa;                    &lt;tns:STATO_SRVZ_IN_CORSO>&#xa;                        &lt;xsl:value-of select=&quot;$Unica_C/payload/typens:ReperimentoServizioRespType/typens:statoServizioInCorso&quot;/>&#xa;                    &lt;/tns:STATO_SRVZ_IN_CORSO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:GenericStaging>&#xa;            &lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns4:IdRichiestaOLO&quot;>&#xa;                &lt;tns:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns4:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns:IdRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;            &lt;/tns:StagingType>&#xa;        &lt;/tns:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="UpdateStaging-input"
                    name="UpdateStaging" outputVariable="UpdateStaging"
                    tibex:xpdlId="839d3d95-61ed-4542-9012-2d1c45b9a5d4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToLog_End"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToLog_End"/>
                        <bpws:source linkName="UpdateStagingToLog"
                            tibex:faultDetailsVar="UpdateStaging" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InserUpdateStaging/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/UnicaC&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:typens=&quot;http://unicac.telecomitalia.it/reperimentoservizio/types&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Unica_C.payload&quot;/>&lt;xsl:param name=&quot;StartRichiestaUnicaC&quot;/>&lt;xsl:param name=&quot;InsertTrack&quot;/>&lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&lt;tns:StagingRequest>&lt;tns:GenericStaging>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'11'&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($Unica_C.payload,true(), true())&quot;/>&lt;/tns:CONTENUTO_RESPONSE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Unica_C.payload/typens:esito)>0&quot;>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;$Unica_C.payload/typens:esito&quot;/>&lt;/tns:ESITO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/tns:ESITO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$InsertTrack/tns3:ID_ESEC_PROCSO_NO_FILE&quot;>&lt;tns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$InsertTrack/tns3:ID_ESEC_PROCSO_NO_FILE&quot;/>&lt;/tns:ID_ESEC_PROCSO_NO_FILE>&lt;/xsl:if>&lt;tns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMSTP_RISPOSTA>&lt;tns:DESCR_ESITO>&lt;xsl:value-of select=&quot;$Unica_C.payload/typens:codiceErrore&quot;/>&lt;/tns:DESCR_ESITO>&lt;xsl:if test=&quot;not((string($Unica_C.payload/typens:statoNumero/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C.payload/typens:statoNumero/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns:STATO_NUMERAZIONE>&lt;xsl:value-of select=&quot;$Unica_C.payload/typens:statoNumero&quot;/>&lt;/tns:STATO_NUMERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($Unica_C.payload/typens:statoServizio/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C.payload/typens:statoServizio/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns:STATO_SRVZ>&lt;xsl:value-of select=&quot;$Unica_C.payload/typens:statoServizio&quot;/>&lt;/tns:STATO_SRVZ>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($Unica_C.payload/typens:dataAttivazione/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C.payload/typens:dataAttivazione/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns:DATA_ATTIVAZIONE>&lt;xsl:value-of select=&quot;$Unica_C.payload/typens:dataAttivazione&quot;/>&lt;/tns:DATA_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($Unica_C.payload/typens:dataCessazione/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C.payload/typens:dataCessazione/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns:DATA_CESSAZIONE>&lt;xsl:value-of select=&quot;$Unica_C.payload/typens:dataCessazione&quot;/>&lt;/tns:DATA_CESSAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($Unica_C.payload/typens:codPiattaforma/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C.payload/typens:codPiattaforma/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns:PIATTAFORMA>&lt;xsl:value-of select=&quot;$Unica_C.payload/typens:codPiattaforma&quot;/>&lt;/tns:PIATTAFORMA>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($Unica_C.payload/typens:statoServizioInCorso/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Unica_C.payload/typens:statoServizioInCorso/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns:STATO_SRVZ_IN_CORSO>&lt;xsl:value-of select=&quot;$Unica_C.payload/typens:statoServizioInCorso&quot;/>&lt;/tns:STATO_SRVZ_IN_CORSO>&lt;/xsl:if>&lt;/tns:GenericStaging>&lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns4:IdRichiestaOLO&quot;>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns4:IdRichiestaOLO&quot;/>&lt;/tns:IdRichiestaOLO>&lt;/xsl:if>&lt;tns:StagingType>&lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&lt;/tns:StagingType>&lt;/tns:StagingRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
