                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ProcessoNoFile/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/UnicaC&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InsertTrack&quot;/>&lt;xsl:param name=&quot;StartRichiestaUnicaC&quot;/>&lt;xsl:param name=&quot;TransactionID&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;UpdateTrackKO-input&quot; match=&quot;/&quot;>&lt;tns:Input_ProcessoNoFile>&lt;tns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&lt;/tns:STATO_ESEC>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat('ERROR', tib:render-xml($FaultDetails,true(),true()))&quot;/>&lt;/tns:DESCR_ERRORE>&lt;tns:TMSP_FINE_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_FINE_ELAB>&lt;xsl:if test=&quot;$InsertTrack/tns:ID_ESEC_PROCSO_NO_FILE&quot;>&lt;tns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$InsertTrack/tns:ID_ESEC_PROCSO_NO_FILE&quot;/>&lt;/tns:ID_ESEC_PROCSO_NO_FILE>&lt;/xsl:if>&lt;tns:AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&lt;/tns:AZIONE>&lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns2:RootProcessInstance&quot;>&lt;tns:RootProcessInstance>&lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns2:RootProcessInstance&quot;/>&lt;/tns:RootProcessInstance>&lt;/xsl:if>&lt;xsl:if test=&quot;$StartRichiestaUnicaC/tns2:IdRichiestaOLO&quot;>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$StartRichiestaUnicaC/tns2:IdRichiestaOLO&quot;/>&lt;/tns:IdRichiestaOLO>&lt;/xsl:if>&lt;tns:TransactionID>&lt;xsl:value-of select=&quot;$TransactionID&quot;/>&lt;/tns:TransactionID>&lt;/tns:Input_ProcessoNoFile>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
