            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogFaultUpdateTrack-UpdateStaging-input"
                    name="LogFaultUpdateTrack-UpdateStaging"
                    tibex:xpdlId="ffbf0fd8-0ad2-46e0-9ba7-b81464ad9cfc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateTrackToLog"/>
                        <bpws:target linkName="UpdateStagingToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogFaultUpdateTrack-UpdateStagingToLog_End"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/UnicaC&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;StartRichiestaUnicaC&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;), &amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;| RootProcessInstance &amp;quot;, $StartRichiestaUnicaC/tns1:RootProcessInstance, &amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId, &amp;quot;| IdRichiestaOLO &amp;quot;, $StartRichiestaUnicaC/tns1:IdRichiestaOLO)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;$_error/StackTrace&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Warning"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="RepeatOnError" tibex:group="repeatOnError" tibex:xpdlId="6aa665ee-8cea-42e5-ab0b-9815c54508b6">
                <bpws:targets>
                    <bpws:target linkName="AssignToRepeatOnError"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatOnErrorToUpdateTrack">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="repeatOnError_success_flag"
                        sca-bpel:internal="true" type="xsd:boolean"/>
                    <bpws:variable name="FaultName2"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails2" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:scope name="innerScope">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails2" tibex:faultNameVar="FaultName2">
                                <bpws:if name="if">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index=$NumberRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index=$NumberRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow1"/>
                                    <bpws:else>
                                    <bpws:assign name="Assign" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                </bpws:if>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow4">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToScope" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ScopeToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="1dbed362-0053-4b7f-806c-e87908cb8c5d">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToScope"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:assign name="GroupEnd1"
                                tibex:group="groupEnd"
                                tibex:xpdlId="269d72ec-00c3-4656-b956-1f7ae929859f" validate="no">
                                <bpws:targets>
                                    <bpws:target linkName="ScopeToGroupEnd1"/>
                                </bpws:targets>
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:scope name="Scope" tibex:group="none" tibex:xpdlId="beb05beb-182d-49dd-8c89-50894528c9e9">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToScope"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ScopeToGroupEnd1"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="FaultName1"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns:FaultDetail"
                                    name="FaultDetails1" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails1"
                                    tibex:faultNameVar="FaultName1" tibex:xpdlId="4cbc5623-b65a-4e8c-a991-43a214f563f2">
                                    <bpws:scope name="scope2">
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="LogLogFaultUnica_CToCatchAndRetry" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="LogLogFaultUnica_C-input"
                                    name="LogLogFaultUnica_C"
                                    tibex:xpdlId="a8d222f4-471a-42cd-a267-c715438bb75d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="LogLogFaultUnica_CToCatchAndRetry"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/UnicaC&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;StartRichiestaUnicaC&quot;/>&lt;xsl:param name=&quot;FaultDetails2&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;LogLogFaultUnica_C-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;), &amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;| RootProcessInstance &amp;quot;, $StartRichiestaUnicaC/tns1:RootProcessInstance, &amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId, &amp;quot;| IdRichiestaOLO &amp;quot;, $StartRichiestaUnicaC/tns1:IdRichiestaOLO)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat('ERROR ON NUMBER RETRY = ', string($index), ' -', tib:render-xml($FaultDetails2, true(), true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>

                                    <value
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:rethrow
                                    name="CatchAndRetry" tibex:xpdlId="969e08bc-63cf-49f0-94f0-53f75fb04ff1">
                                    <bpws:targets>
                                    <bpws:target linkName="LogLogFaultUnica_CToCatchAndRetry"/>
                                    </bpws:targets>
                                    </bpws:rethrow>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:catchAll>
                                </bpws:faultHandlers>
                                <bpws:flow name="flow2">
