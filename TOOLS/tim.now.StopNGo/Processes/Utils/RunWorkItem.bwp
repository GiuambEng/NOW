            <bpws:invoke inputVariable="CompleteWorkItem-input"
                name="CompleteWorkItem" operation="completeWorkItem"
                outputVariable="CompleteWorkItem"
                partnerLink="WorkItemManagementService"
                portType="ns5:WorkItemManagementService" tibex:xpdlId="6e1923a2-6698-4dd5-8f51-8e06495a07cf">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://services.brm.n2.tibco.com/WorkItemManagementService_1.7.0" xmlns:ns="http://api.brm.n2.tibco.com" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.example.org/RunWorkItem" version="2.0"&gt;&lt;xsl:param name="OpenAllocateWI"/&gt;&lt;xsl:param name="GetBPMWorkItem"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="CompleteWorkItem-input" match="/"&gt;&lt;tns:completeWorkItemRequest&gt;&lt;completeWorkItemDoc&gt;&lt;ns:completeWorkItem&gt;&lt;workItemID&gt;&lt;xsl:attribute name="id"&gt;&lt;xsl:value-of select="xsd:long($GetBPMWorkItem/Record[1]/WORK_ITEM_ID)"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:if test="$OpenAllocateWI/allocateAndOpenWorkItemResponseDoc/ns:allocateAndOpenWorkItemResponse/workItem[1]/id/@version"&gt;&lt;xsl:attribute name="version"&gt;&lt;xsl:value-of select="$OpenAllocateWI/allocateAndOpenWorkItemResponseDoc/ns:allocateAndOpenWorkItemResponse/workItem[1]/id/@version"/&gt;&lt;/xsl:attribute&gt;&lt;/xsl:if&gt;&lt;/workItemID&gt;&lt;workItemPayload&gt;&lt;dataModel&gt;&lt;outputs&gt;&lt;xsl:attribute name="array"&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="name"&gt;&lt;xsl:value-of select="'action'"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="optional"&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="type"&gt;&lt;xsl:value-of select="'String'"/&gt;&lt;/xsl:attribute&gt;&lt;simpleSpec&gt;&lt;xsl:attribute name="decimal"&gt;&lt;xsl:value-of select="0"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="length"&gt;&lt;xsl:value-of select="50"/&gt;&lt;/xsl:attribute&gt;&lt;value&gt;&lt;xsl:value-of select="upper-case($Start/tns1:ACTION)"/&gt;&lt;/value&gt;&lt;/simpleSpec&gt;&lt;/outputs&gt;&lt;xsl:if test="exists($Start/tns1:CAUSALE)"&gt;&lt;outputs&gt;&lt;xsl:attribute name="array"&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="name"&gt;&lt;xsl:value-of select="'CausaleSelezionata'"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="optional"&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="type"&gt;&lt;xsl:value-of select="&amp;quot;Integer Number&amp;quot;"/&gt;&lt;/xsl:attribute&gt;&lt;simpleSpec&gt;&lt;xsl:attribute name="decimal"&gt;&lt;xsl:value-of select="0"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="length"&gt;&lt;xsl:value-of select="9"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:if test="$Start/tns1:CAUSALE"&gt;&lt;value&gt;&lt;xsl:value-of select="$Start/tns1:CAUSALE"/&gt;&lt;/value&gt;&lt;/xsl:if&gt;&lt;/simpleSpec&gt;&lt;/outputs&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length($Start/tns1:FlagCautelare) &gt; 0"&gt;&lt;outputs&gt;&lt;xsl:attribute name="array"&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="name"&gt;&lt;xsl:value-of select="'IdTipologiaCautelare'"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="optional"&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="type"&gt;&lt;xsl:value-of select="'String'"/&gt;&lt;/xsl:attribute&gt;&lt;simpleSpec&gt;&lt;xsl:attribute name="decimal"&gt;&lt;xsl:value-of select="0"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="length"&gt;&lt;xsl:value-of select="50"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:if test="$Start/tns1:FlagCautelare"&gt;&lt;value&gt;&lt;xsl:value-of select="$Start/tns1:FlagCautelare"/&gt;&lt;/value&gt;&lt;/xsl:if&gt;&lt;/simpleSpec&gt;&lt;/outputs&gt;&lt;/xsl:if&gt;
                                                                                                                                                                                                                                                                                &lt;!--StatoNumerazione --&gt;&lt;xsl:if test="exists($Start/tns1:StatoNumerazione)"&gt;&lt;outputs&gt;&lt;xsl:attribute name="array"&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="name"&gt;&lt;xsl:value-of select="'StatoNumerazioneCRM'"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="optional"&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="type"&gt;&lt;xsl:value-of select="'String'"/&gt;&lt;/xsl:attribute&gt;&lt;simpleSpec&gt;&lt;xsl:attribute name="decimal"&gt;&lt;xsl:value-of select="0"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="length"&gt;&lt;xsl:value-of select="50"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:if test="$Start/tns1:StatoNumerazione"&gt;&lt;value&gt;&lt;xsl:value-of select="$Start/tns1:StatoNumerazione"/&gt;&lt;/value&gt;&lt;/xsl:if&gt;&lt;/simpleSpec&gt;&lt;/outputs&gt;&lt;/xsl:if&gt;
                                                                                                                                                                                                                                                                                                                                                        &lt;!--Principale--&gt;&lt;xsl:if test="exists($Start/tns1:Principale)"&gt;&lt;outputs&gt;&lt;xsl:attribute name="array"&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="name"&gt;&lt;xsl:value-of select="'PrincipaleCRM'"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="optional"&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="type"&gt;&lt;xsl:value-of select="'String'"/&gt;&lt;/xsl:attribute&gt;&lt;simpleSpec&gt;&lt;xsl:attribute name="decimal"&gt;&lt;xsl:value-of select="0"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="length"&gt;&lt;xsl:value-of select="50"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:if test="$Start/tns1:Principale"&gt;&lt;value&gt;&lt;xsl:value-of select="$Start/tns1:Principale"/&gt;&lt;/value&gt;&lt;/xsl:if&gt;&lt;/simpleSpec&gt;&lt;/outputs&gt;&lt;/xsl:if&gt;
                                                                                                                                                                                                                                                                                                                                                                                                                                &lt;!--Aggiuntivi--&gt;&lt;xsl:if test="exists($Start/tns1:Aggiuntivi)"&gt;&lt;outputs&gt;&lt;xsl:attribute name="array"&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="name"&gt;&lt;xsl:value-of select="'AggiuntiviCRM'"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="optional"&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="type"&gt;&lt;xsl:value-of select="'String'"/&gt;&lt;/xsl:attribute&gt;&lt;simpleSpec&gt;&lt;xsl:attribute name="decimal"&gt;&lt;xsl:value-of select="0"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="length"&gt;&lt;xsl:value-of select="50"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:for-each select="$Start/tns1:Aggiuntivi"&gt;&lt;value&gt;&lt;xsl:value-of select="."/&gt;&lt;/value&gt;&lt;/xsl:for-each&gt;&lt;/simpleSpec&gt;&lt;/outputs&gt;&lt;/xsl:if&gt;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        &lt;!--TipoConnettivita--&gt;&lt;xsl:if test="exists($Start/tns1:TipoConnettivita)"&gt;&lt;outputs&gt;&lt;xsl:attribute name="array"&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="name"&gt;&lt;xsl:value-of select="'TipoConnettivitaCRM'"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="optional"&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="type"&gt;&lt;xsl:value-of select="'String'"/&gt;&lt;/xsl:attribute&gt;&lt;simpleSpec&gt;&lt;xsl:attribute name="decimal"&gt;&lt;xsl:value-of select="0"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:attribute name="length"&gt;&lt;xsl:value-of select="50"/&gt;&lt;/xsl:attribute&gt;&lt;xsl:if test="$Start/tns1:TipoConnettivita"&gt;&lt;value&gt;&lt;xsl:value-of select="$Start/tns1:TipoConnettivita"/&gt;&lt;/value&gt;&lt;/xsl:if&gt;&lt;/simpleSpec&gt;&lt;/outputs&gt;&lt;/xsl:if&gt;&lt;/dataModel&gt;&lt;/workItemPayload&gt;&lt;/ns:completeWorkItem&gt;&lt;/completeWorkItemDoc&gt;&lt;/tns:completeWorkItemRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://services.brm.n2.tibco.com/WorkItemManagementService_1.7.0&quot; xmlns:ns=&quot;http://api.brm.n2.tibco.com&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/RunWorkItem&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OpenAllocateWI.allocateAndOpenWorkItemResponseDoc&quot;/>&#xa;    &lt;xsl:param name=&quot;GetBPMWorkItem&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CompleteWorkItem-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:completeWorkItem>&#xa;            &lt;workItemID>&#xa;                &lt;xsl:attribute name=&quot;id&quot;>&#xa;                    &lt;xsl:value-of select=&quot;xsd:long($GetBPMWorkItem/Record[1]/WORK_ITEM_ID)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:if test=&quot;$OpenAllocateWI.allocateAndOpenWorkItemResponseDoc/workItem[1]/id/@version&quot;>&#xa;                    &lt;xsl:attribute name=&quot;version&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$OpenAllocateWI.allocateAndOpenWorkItemResponseDoc/workItem[1]/id/@version&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                &lt;/xsl:if>&#xa;            &lt;/workItemID>&#xa;            &lt;workItemPayload>&#xa;                &lt;dataModel>&#xa;                    &lt;outputs>&#xa;                        &lt;xsl:attribute name=&quot;array&quot;>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/xsl:attribute>&#xa;                        &lt;xsl:attribute name=&quot;name&quot;>&#xa;                            &lt;xsl:value-of select=&quot;'action'&quot;/>&#xa;                        &lt;/xsl:attribute>&#xa;                        &lt;xsl:attribute name=&quot;optional&quot;>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/xsl:attribute>&#xa;                        &lt;xsl:attribute name=&quot;type&quot;>&#xa;                            &lt;xsl:value-of select=&quot;'String'&quot;/>&#xa;                        &lt;/xsl:attribute>&#xa;                        &lt;simpleSpec>&#xa;                            &lt;xsl:attribute name=&quot;decimal&quot;>&#xa;                                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;length&quot;>&#xa;                                &lt;xsl:value-of select=&quot;50&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;value>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Start/tns1:ACTION)&quot;/>&#xa;                            &lt;/value>&#xa;                        &lt;/simpleSpec>&#xa;                    &lt;/outputs>&#xa;                    &lt;xsl:if test=&quot;exists($Start/tns1:CAUSALE)&quot;>&#xa;                        &lt;outputs>&#xa;                            &lt;xsl:attribute name=&quot;array&quot;>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                &lt;xsl:value-of select=&quot;'CausaleSelezionata'&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;optional&quot;>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;type&quot;>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Integer Number&amp;quot;&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;simpleSpec>&#xa;                                &lt;xsl:attribute name=&quot;decimal&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:attribute name=&quot;length&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;9&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:CAUSALE&quot;>&#xa;                                    &lt;value>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:CAUSALE&quot;/>&#xa;                                    &lt;/value>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/simpleSpec>&#xa;                        &lt;/outputs>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/tns1:FlagCautelare) > 0&quot;>&#xa;                        &lt;outputs>&#xa;                            &lt;xsl:attribute name=&quot;array&quot;>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                &lt;xsl:value-of select=&quot;'IdTipologiaCautelare'&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;optional&quot;>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;type&quot;>&#xa;                                &lt;xsl:value-of select=&quot;'String'&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;simpleSpec>&#xa;                                &lt;xsl:attribute name=&quot;decimal&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:attribute name=&quot;length&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;50&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:FlagCautelare&quot;>&#xa;                                    &lt;value>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:FlagCautelare&quot;/>&#xa;                                    &lt;/value>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/simpleSpec>&#xa;                        &lt;/outputs>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;!--StatoNumerazione -->&#xa;                    &lt;xsl:if test=&quot;exists($Start/tns1:StatoNumerazione)&quot;>&#xa;                        &lt;outputs>&#xa;                            &lt;xsl:attribute name=&quot;array&quot;>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                &lt;xsl:value-of select=&quot;'StatoNumerazioneCRM'&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;optional&quot;>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;type&quot;>&#xa;                                &lt;xsl:value-of select=&quot;'String'&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;simpleSpec>&#xa;                                &lt;xsl:attribute name=&quot;decimal&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:attribute name=&quot;length&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;50&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:StatoNumerazione&quot;>&#xa;                                    &lt;value>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:StatoNumerazione&quot;/>&#xa;                                    &lt;/value>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/simpleSpec>&#xa;                        &lt;/outputs>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;!--Principale-->&#xa;                    &lt;xsl:if test=&quot;exists($Start/tns1:Principale)&quot;>&#xa;                        &lt;outputs>&#xa;                            &lt;xsl:attribute name=&quot;array&quot;>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                &lt;xsl:value-of select=&quot;'PrincipaleCRM'&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;optional&quot;>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;type&quot;>&#xa;                                &lt;xsl:value-of select=&quot;'String'&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;simpleSpec>&#xa;                                &lt;xsl:attribute name=&quot;decimal&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:attribute name=&quot;length&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;50&quot;/>&#xa;                                &lt;/xsl:attribute>&#xa;                                &lt;xsl:if test=&quot;$Start/tns1:Principale&quot;>&#xa;                                    &lt;value>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:Principale&quot;/>&#xa;                                    &lt;/value>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/simpleSpec>&#xa;                        &lt;/outputs>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;!--Aggiuntivi-->&#xa;                    &lt;xsl:if test=&quot;exists($Start/tns1:Aggiuntivi)&quot;>&#xa;                        &lt;outputs>&#xa;                            &lt;xsl:attribute name=&quot;array&quot;>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;name&quot;>&#xa;                                &lt;xsl:value-of select=&quot;'AggiuntiviCRM'&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;optional&quot;>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;xsl:attribute name=&quot;type&quot;>&#xa;                                &lt;xsl:value-of select=&quot;'String'&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                            &lt;simpleSpec>&#xa;               