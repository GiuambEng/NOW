<bpws:process exitOnStandardFault="no" name="Utils.RunWorkItem"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20171228150409"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.example.org/RunWorkItem"
    xmlns:ns1="http://www.tibco.com/namespaces/tnt/plugins/jdbc+c7e46215-f27a-4397-9219-241f9bdf464b+input"
    xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/jdbc+c7e46215-f27a-4397-9219-241f9bdf464b+output"
