        <bpws:variable name="Errore" type="xsd:string"/>
        <bpws:variable element="ns5:SleepInputSchema" name="Sleep-input" sca-bpel:internal="true"/>
        <bpws:variable name="SleepRetry" sca-bpel:hotUpdate="false"
