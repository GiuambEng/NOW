        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="RepeatToLog1" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToRepeat" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToAssign" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="StartRetryCRM_Online"
                    tibex:xpdlId="0535ad94-ffb0-4e89-abf0-ad13bf4e8758"
                    variable="StartRetryCRM_Online" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Retry&quot; xmlns:tns1=&quot;http://tempuri.org/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Controllo&quot;/>&lt;xsl:param name=&quot;InvokeGetDatiLinea&quot;/>&lt;xsl:param name=&quot;Errore&quot;/>&lt;xsl:template name=&quot;EndRetryCRM_Online-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Controllo='True'&quot;>&lt;tns:Response>&lt;tns:GetDatiLineaUnicaResponse>&lt;xsl:copy-of select=&quot;$InvokeGetDatiLinea/parameters/tns1:GetDatiLineaUnicaResponse&quot;/>&lt;/tns:GetDatiLineaUnicaResponse>&lt;tns:ControlloChiamata>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:ControlloChiamata>&lt;tns:BonificaUnicaCResponse/>&lt;/tns:Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Response>&lt;tns:GetDatiLineaUnicaResponse>&lt;tns1:GetDatiLineaUnicaResponse>&lt;tns1:GetDatiLineaUnicaResult>&lt;tns1:Errore>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;$Errore&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Errore>&lt;/tns1:GetDatiLineaUnicaResult>&lt;/tns1:GetDatiLineaUnicaResponse>&lt;/tns:GetDatiLineaUnicaResponse>&lt;tns:ControlloChiamata>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:ControlloChiamata>&lt;/tns:Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="EndRetryCRM_Online-input"
                    name="EndRetryCRM_Online"
                    tibex:xpdlId="ce1818c8-fe38-4a5a-8e17-a25fa01e682c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Retry&quot; xmlns:tns1=&quot;http://tempuri.org/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeGetDatiLinea.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Controllo&quot;/>&#xa;    &lt;xsl:param name=&quot;Errore&quot;/>&#xa;    &lt;xsl:template name=&quot;EndRetryCRM_Online-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Controllo='True'&quot;>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:GetDatiLineaUnicaResponse>&#xa;                        &lt;xsl:copy-of select=&quot;$InvokeGetDatiLinea.parameters&quot;/>&#xa;                    &lt;/tns:GetDatiLineaUnicaResponse>&#xa;                    &lt;tns:ControlloChiamata>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns:ControlloChiamata>&#xa;                    &lt;tns:BonificaUnicaCResponse/>&#xa;                &lt;/tns:Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:GetDatiLineaUnicaResponse>&#xa;                        &lt;tns1:GetDatiLineaUnicaResponse>&#xa;                            &lt;tns1:GetDatiLineaUnicaResult>&#xa;                                &lt;tns1:Errore>&#xa;                                    &lt;tns1:Codice>&#xa;                                        &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                                    &lt;/tns1:Codice>&#xa;                                    &lt;tns1:Descrizione>&#xa;                                        &lt;xsl:value-of select=&quot;$Errore&quot;/>&#xa;                                    &lt;/tns1:Descrizione>&#xa;                                &lt;/tns1:Errore>&#xa;                            &lt;/tns1:GetDatiLineaUnicaResult>&#xa;                        &lt;/tns1:GetDatiLineaUnicaResponse>&#xa;                    &lt;/tns:GetDatiLineaUnicaResponse>&#xa;                    &lt;tns:ControlloChiamata>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:ControlloChiamata>&#xa;                &lt;/tns:Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Repeat" tibex:group="repeatUntil" tibex:xpdlId="b6f2278d-bf84-4086-9289-90b4c681e590">
                <bpws:targets>
                    <bpws:target linkName="AssignToRepeat"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatToLog1"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="repeatUntil">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index= $NumeroTentativiInvoke or $Controllo='True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeToLog3" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InvokeGetDatiLineaToAssign" tibex:linkType="ERROR"/>
                                <bpws:link name="Log2ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log3ToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToSleep" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="SleepToLogFaultInvokeGetDatiLinea" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="55793f06-e462-470f-87ff-189f820254ef">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToInvoke"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="9bb512c3-e28d-45ee-a71f-f6f08ce104ae">
                                <bpws:targets>
                                    <bpws:target linkName="Log2ToGroupEnd"/>
                                    <bpws:target linkName="Assign1ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:invoke
                                inputVariable="InvokeGetDatiLinea-input"
                                name="InvokeGetDatiLinea"
                                operation="GetDatiLineaUnica"
                                outputVariable="InvokeGetDatiLinea"
                                partnerLink="CrmOnLineSoap"
                                portType="ns2:CrmOnLineSoap" tibex:xpdlId="3a47cbca-3976-4c9d-993d-1ba4008b4666">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.example.org/Retry" xmlns:tns1="http://tempuri.org/" version="2.0"&gt;
    &lt;xsl:param name="StartRetryCRM_Online"/&gt;
    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;tns1:GetDatiLineaUnicaSoapIn&gt;
            &lt;parameters&gt;
                &lt;xsl:copy-of select="$StartRetryCRM_Online/tns:GetDatiLineaUnica/tns1:GetDatiLineaUnica"/&gt;
            &lt;/parameters&gt;
        &lt;/tns1:GetDatiLineaUnicaSoapIn&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Retry&quot; xmlns:tns1=&quot;http://tempuri.org/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartRetryCRM_Online&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$StartRetryCRM_Online/tns:GetDatiLineaUnica/tns1:GetDatiLineaUnica&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeToLog3"/>
                                    <bpws:source
                                    linkName="InvokeGetDatiLineaToAssign"
                                    tibex:faultDetailsVar="InvokeGetDatiLinea" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.example.org/Retry&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;StartRetryCRM_Online&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Errore&quot;/>&lt;xsl:template name=&quot;LogFaultInvokeGetDatiLinea-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;), &amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId, &amp;quot;| IdRichiestaOLO &amp;quot;, $StartRetryCRM_Online/tns1:IDRichiestaOLO)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Fault RetryCRM_Online&amp;quot; ,&amp;quot;   Numero tentativi Invoke:&amp;quot;,'  ',string($index),'   ',$Errore)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogFaultInvokeGetDatiLinea-input"
                                    name="LogFaultInvokeGetDatiLinea"
                                    tibex:xpdlId="99b1737d-1b26-4458-8651-372992ddc56a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SleepToLogFaultInvokeGetDatiLinea"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log2ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.example.org/Retry&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;StartRetryCRM_Online&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Errore&quot;/>&lt;xsl:template name=&quot;LogFaultInvokeGetDatiLinea-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;), &amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;| ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId, &amp;quot;| IdRichiestaOLO &amp;quot;, $StartRetryCRM_Online/tns1:IDRichiestaOLO)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Fault RetryCRM_Online&amp;quot; ,&amp;quot;   Numero tentativi Invoke:&amp;quot;,'  ',string($index),'   ',$Errore)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="'True'"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="Controllo"
                                    name="ControlloExit"
                                    outputVariable="Controllo"
                                    tibex:xpdlId="03814ee1-2490-4b91-9235-e48d5257a287" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log3ToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="'True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Controllo" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
