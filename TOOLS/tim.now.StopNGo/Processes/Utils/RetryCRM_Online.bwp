        <bpws:variable element="ns3:ActivityInput"
            name="LogEndRetryCRM_Online-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityInput"
            name="LogFaultInvokeGetDatiLinea-input" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityInput"
            name="LogInvokeGetDatiLinea-input" sca-bpel:internal="true"/>
