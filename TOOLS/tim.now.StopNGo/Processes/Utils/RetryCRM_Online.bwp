                </tibex:binding>
            </tibex:ReferenceBinding>
        </bpws:partnerLink>
    </bpws:partnerLinks>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:Request" name="StartRetryCRM_Online"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:Response"
            name="EndRetryCRM_Online-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable messageType="ns2:GetDatiLineaUnicaSoapIn"
            name="InvokeGetDatiLinea-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns2:GetDatiLineaUnicaSoapOut"
            name="InvokeGetDatiLinea" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityInput"
