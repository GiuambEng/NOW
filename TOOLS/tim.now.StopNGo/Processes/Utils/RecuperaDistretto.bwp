                <bpws:link name="DISTRETTOToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="DISTRETTO_NORMALIZZATOToLog1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="JDBCQueryToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign1ToDISTRETTO" tibex:linkType="SUCCESS"/>
                <bpws:link name="SetDNToJDBCUpdate" tibex:linkType="SUCCESS"/>
