            <bpws:scope name="Repeat" tibex:group="repeatUntil" tibex:xpdlId="8618ffb4-4a50-46c9-b298-f9e9d2325b16">
                <bpws:targets>
                    <bpws:target linkName="ControlloToRepeat"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatToLogEndRetryBonificaUnicaC"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="repeatUntil">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index=$NumeroRetryInvoke or $Controllo='True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="InvokeToLog" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InvokeBonificaUnicaCToAssign" tibex:linkType="ERROR"/>
                                <bpws:link name="SleepToLog1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToSleep" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="b3555084-44fe-4a98-a774-163f868345fd">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToInvoke"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="f73f9bfa-3725-4a6c-9c84-3cfe5bf52241">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                    <bpws:target linkName="Log1ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:invoke
                                inputVariable="InvokeBonificaUnicaC-input"
                                name="InvokeBonificaUnicaC"
                                operation="BonificaServizio"
                                outputVariable="InvokeBonificaUnicaC"
                                partnerLink="BonificaServizioPort"
                                portType="ns4:BonificaServizioPort" tibex:xpdlId="d08aae23-c3f7-4fcd-ab73-f44302a3e5ad">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
