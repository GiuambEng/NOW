            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:typens=&quot;http://unicac.telecomitalia.it/bonificaservizio/types&quot; xmlns:tns=&quot;http://www.example.org/Retry&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Controllo&quot;/>&lt;xsl:param name=&quot;InvokeBonificaUnicaC&quot;/>&lt;xsl:template name=&quot;EndRetryBonificaUnicaC-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Controllo='True'&quot;>&lt;tns:Response>&lt;tns:ControlloChiamata>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:ControlloChiamata>&lt;tns:BonificaUnicaCResponse>&lt;tns:esito>&lt;xsl:value-of select=&quot;$InvokeBonificaUnicaC/payload/typens:BonificaServizioRespType/typens:esito&quot;/>&lt;/tns:esito>&lt;tns:codiceErrore>&lt;xsl:value-of select=&quot;$InvokeBonificaUnicaC/payload/typens:BonificaServizioRespType/typens:codiceErrore&quot;/>&lt;/tns:codiceErrore>&lt;tns:numeroTelefonico>&lt;xsl:value-of select=&quot;$InvokeBonificaUnicaC/payload/typens:BonificaServizioRespType/typens:numeroTelefonico&quot;/>&lt;/tns:numeroTelefonico>&lt;tns:distrettoTelefonico>&lt;xsl:value-of select=&quot;$InvokeBonificaUnicaC/payload/typens:BonificaServizioRespType/typens:distrettoTelefonico&quot;/>&lt;/tns:distrettoTelefonico>&lt;/tns:BonificaUnicaCResponse>&lt;/tns:Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Response>&lt;tns:ControlloChiamata>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:ControlloChiamata>&lt;tns:BonificaUnicaCResponse>&lt;tns:codiceErrore>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns:codiceErrore>&lt;/tns:BonificaUnicaCResponse>&lt;/tns:Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
