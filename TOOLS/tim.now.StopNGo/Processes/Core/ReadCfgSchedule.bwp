            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="InsertDaElaborareSecondaPortabilita-input"
                    name="InsertDaElaborareSecondaPortabilita"
                    outputVariable="InsertDaElaborareSecondaPortabilita"
                    tibex:xpdlId="a7282605-0f3e-4df0-a7ea-389a452053c5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToInsertDaElaborareSecondaPortabilita"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsertDaElaborareSecondaPortabilitaToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a7282605-0f3e-4df0-a7ea-389a452053c5+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CheckCfg&quot;/>&#xa;    &lt;xsl:param name=&quot;Flag_TestMode_KIT2&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertDaElaborareSecondaPortabilita-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$CheckCfg/Record[ID_SCHEDULER ='C26M05F07']&quot;>&#xa;                &lt;Record>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Flag_TestMode_KIT2='Y'&quot;>&#xa;                            &lt;STATO>&#xa;                                &lt;xsl:value-of select=&quot;'TESTING'&quot;/>&#xa;                            &lt;/STATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;STATO>&#xa;                                &lt;xsl:value-of select=&quot;'DA ELABORARE'&quot;/>&#xa;                            &lt;/STATO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;ID_SCHEDULER>&#xa;                        &lt;xsl:value-of select=&quot;ID_SCHEDULER&quot;/>&#xa;                    &lt;/ID_SCHEDULER>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO TOOL_STOPNGO_RICH(CASE_CODE,IDRICHIESTAOLO,DN,CREATED,STATO, ID_LAVRZ_HD)&#xa;SELECT DISTINCT cfg.ID_SCHEDULER, rich.IDRICHIESTAOLO, rich.NUMEROTELEFONICO, SYSDATE,?, pps.ID_LAVRZ_HD&#xa;FROM BDS_1_CASEDATA_RICHIESTA rich, PPS_LAVRZ_HD pps, CFG_TOOL_SCHEDULER_DATA cfg, CFG_TOOL_SCHEDULER avvio&#xa;WHERE rich.IDRICHIESTAOLO=pps.ID_RICH_OLO&#xa;AND cfg.ID_SCHEDULER = avvio.ID_SCHEDULER &#xa;AND avvio.ID_SCHEDULER =?&#xa;AND upper(pps.CAUS_ESITO) = upper(cfg.CAUSALE) AND trunc(pps.TIMSTP_CHIUSURA)>trunc(sysdate)&#xa;AND rich.OFFERTA=cfg.OFFERTA AND rich.LAVORAZIONE=cfg.LAVORAZIONE AND upper(cfg.TIPO_ERRORE)=upper(pps.TIPO_ERRORE)&#xa;AND cfg.FLAG_ABILITATO='Y'&#xa;AND pps.ID_LAVRZ_HD not in (SELECT ID_LAVRZ_HD FROM TOOL_STOPNGO_RICH)&#xa;AND SUBSTR(rich.TIPOLOGIASCENARIO,0,7) not in ('NPSUTIF','NPDEL82')&#xa;AND rich.STATORICHIESTANOW='LAVORAZIONEHD'" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_SCHEDULER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="86a53058-6c64-4e12-b2e4-e2dc64b07688">
                <bpws:targets>
                    <bpws:target linkName="LogCheckCfgToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToInsertDaElaborare">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($CheckCfg/Record[ID_SCHEDULER= ('C26M05F04','C26M05F05','C26M05F09','C26M05F05DEL82')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($CheckCfg/Record[ID_SCHEDULER= ('C26M05F04','C26M05F05','C26M05F09','C26M05F05DEL82')])>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToSelectBDS_PPS_TOOL">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($CheckCfg/Record[ID_SCHEDULER= 'C26M05F06'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($CheckCfg/Record[ID_SCHEDULER= 'C26M05F06'])>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToInsertDaElaborareSecondaPortabilita">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($CheckCfg/Record[ID_SCHEDULER= 'C26M05F07'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($CheckCfg/Record[ID_SCHEDULER= 'C26M05F07'])>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogInsertSecondaPortabilita-input"
                    name="LogInsertSecondaPortabilita"
                    tibex:xpdlId="9300b480-99a6-4472-9060-fefd973fd7b0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
