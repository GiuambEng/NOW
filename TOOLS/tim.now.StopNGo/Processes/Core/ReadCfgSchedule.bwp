            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="SelectBDS_PPS_TOOL-input"
                    name="SelectBDS_PPS_TOOL"
                    outputVariable="SelectBDS_PPS_TOOL"
                    tibex:xpdlId="9774f722-7e1b-4721-9978-e0f6ddaa99b6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToSelectBDS_PPS_TOOL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectBDS_PPS_TOOLToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9774f722-7e1b-4721-9978-e0f6ddaa99b6+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;SelectBDS_PPS_TOOL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;IdScheduler>&#xa;                &lt;xsl:value-of select=&quot;'C26M05F06'&quot;/>&#xa;            &lt;/IdScheduler>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT cfg.ID_SCHEDULER, rich.IDRICHIESTAOLO, rich.NUMEROTELEFONICO, SYSDATE, pps.ID_LAVRZ_HD, rich.IDTPLGCAUTELARE&#xa;FROM BDS_1_CASEDATA_RICHIESTA rich, PPS_LAVRZ_HD pps, CFG_TOOL_SCHEDULER_DATA cfg, CFG_TOOL_SCHEDULER avvio&#xa;WHERE rich.IDRICHIESTAOLO = pps.ID_RICH_OLO&#xa;AND cfg.ID_SCHEDULER = avvio.ID_SCHEDULER &#xa;AND avvio.ID_SCHEDULER = ?&#xa;AND upper(pps.CAUS_ESITO) = upper(cfg.CAUSALE) &#xa;AND trunc(pps.TIMSTP_CHIUSURA) > trunc(sysdate)&#xa;AND upper(cfg.TIPO_ERRORE) = upper(pps.TIPO_ERRORE)&#xa;AND cfg.FLAG_ABILITATO = 'Y'&#xa;AND pps.ID_LAVRZ_HD not in (SELECT ID_LAVRZ_HD FROM TOOL_STOPNGO_RICH)&#xa;AND rich.STATORICHIESTANOW = 'LAVORAZIONEHD'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IdScheduler"/>
                                    <columnMetadata
                                    columnName="ID_SCHEDULER"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="SYSDATE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="ID_LAVRZ_HD"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDTPLGCAUTELARE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log-input"
                    name="Log"
                    tibex:xpdlId="e2db539a-62ee-4305-930e-5e0740e74178" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelectBDS_PPS_TOOLToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToInsert_STOP_GO_TIPO_SERV">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SelectBDS_PPS_TOOL/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SelectBDS_PPS_TOOL/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogToLogEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
