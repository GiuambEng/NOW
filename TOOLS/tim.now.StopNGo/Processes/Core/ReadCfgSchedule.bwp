                    <bpws:sources>
                        <bpws:source linkName="Insert_STOP_GO_TIPO_SERVToLogInserStopGoTipoSErv"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+25b1ae98-cb96-43e3-860c-83dfdb501e81+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Flag_TestMode_KIT2&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectBDS_PPS_TOOL&quot;/>&#xa;    &lt;xsl:template name=&quot;Insert_STOP_GO_TIPO_SERV-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$SelectBDS_PPS_TOOL/Record&quot;>&#xa;                &lt;Record>&#xa;                    &lt;ID_SCHEDULER>&#xa;                        &lt;xsl:value-of select=&quot;ID_SCHEDULER&quot;/>&#xa;                    &lt;/ID_SCHEDULER>&#xa;                    &lt;IdRichiestaOlo>&#xa;                        &lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&#xa;                    &lt;/IdRichiestaOlo>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(NUMEROTELEFONICO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Flag_TestMode_KIT2='Y'&quot;>&#xa;                            &lt;STATO>&#xa;                                &lt;xsl:value-of select=&quot;'TESTING'&quot;/>&#xa;                            &lt;/STATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;IDTPLGCAUTELARE = 'Y'&quot;>&#xa;                            &lt;STATO>&#xa;                                &lt;xsl:value-of select=&quot;'LAVORAZIONE MANUALE'&quot;/>&#xa;                            &lt;/STATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;STATO>&#xa;                                &lt;xsl:value-of select=&quot;'DA ELABORARE'&quot;/>&#xa;                            &lt;/STATO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;IdLavrzHD>&#xa;                        &lt;xsl:value-of select=&quot;ID_LAVRZ_HD&quot;/>&#xa;                    &lt;/IdLavrzHD>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;IDTPLGCAUTELARE = 'Y'&quot;>&#xa;                            &lt;Esito>&#xa;                                &lt;xsl:value-of select=&quot;'DA SBLOCCARE'&quot;/>&#xa;                            &lt;/Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;Esito xsi:nil=&quot;true&quot;/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO TOOL_STOPNGO_RICH(CASE_CODE, IDRICHIESTAOLO, DN, &#xa;&#x9;CREATED, STATO, ID_LAVRZ_HD, ESITO)&#xa;VALUES (?, ?, ?, SYSDATE, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_SCHEDULER"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IdRichiestaOlo"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdLavrzHD"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Esito"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
