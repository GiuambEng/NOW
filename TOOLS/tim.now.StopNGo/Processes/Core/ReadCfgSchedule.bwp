                                    sqlStatement="SELECT ID_SCHEDULER FROM CFG_TOOL_SCHEDULER &#xa;WHERE FLAG_LETTURA = 'N' AND ID_SCHEDULER NOT IN ('C26M05R01','C26M05R02','C26M05R03')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
