            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="InsertDaElaborarePrimaPortabilita-input"
                    name="InsertDaElaborarePrimaPortabilita"
                    outputVariable="InsertDaElaborarePrimaPortabilita"
                    tibex:xpdlId="e82efbc6-cca7-4650-9a58-bcfec44d2e2c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToInsertDaElaborare"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsertDaElaborareToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e82efbc6-cca7-4650-9a58-bcfec44d2e2c+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CheckCfg&quot;/>&lt;xsl:param name=&quot;Flag_TestMode&quot;/>&lt;xsl:template name=&quot;InsertDaElaborarePrimaPortabilita-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$CheckCfg/Record[ID_SCHEDULER = ('C26M05F04','C26M05F05','C26M05F09','C26M05F05DEL82')]&quot;>&lt;Record>&lt;xsl:choose>&lt;xsl:when test=&quot;$Flag_TestMode='Y'&quot;>&lt;STATO>&lt;xsl:value-of select=&quot;'TESTING'&quot;/>&lt;/STATO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STATO>&lt;xsl:value-of select=&quot;'DA ELABORARE'&quot;/>&lt;/STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_SCHEDULER>&lt;xsl:value-of select=&quot;ID_SCHEDULER&quot;/>&lt;/ID_SCHEDULER>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO TOOL_STOPNGO_RICH(CASE_CODE,IDRICHIESTAOLO,DN,CREATED,STATO, ID_LAVRZ_HD)&#xa;SELECT cfg.ID_SCHEDULER, rich.IDRICHIESTAOLO, rich.NUMEROTELEFONICO, SYSDATE,?, pps.ID_LAVRZ_HD&#xa;FROM BDS_1_CASEDATA_RICHIESTA rich, PPS_LAVRZ_HD pps, CFG_TOOL_SCHEDULER_DATA cfg, CFG_TOOL_SCHEDULER avvio&#xa;WHERE rich.IDRICHIESTAOLO=pps.ID_RICH_OLO&#xa;AND cfg.ID_SCHEDULER = avvio.ID_SCHEDULER &#xa;AND avvio.ID_SCHEDULER =?&#xa;AND upper(pps.CAUS_ESITO) = upper(cfg.CAUSALE) AND trunc(pps.TIMSTP_CHIUSURA)>trunc(sysdate)&#xa;AND rich.OFFERTA=cfg.OFFERTA AND rich.LAVORAZIONE=cfg.LAVORAZIONE AND upper(cfg.TIPO_ERRORE)=upper(pps.TIPO_ERRORE)&#xa;AND cfg.FLAG_ABILITATO='Y'&#xa;AND pps.ID_LAVRZ_HD not in (SELECT ID_LAVRZ_HD FROM TOOL_STOPNGO_RICH)&#xa;AND (rich.TIPOLOGIASCENARIO = cfg.SCENARIO OR (SUBSTR(rich.TIPOLOGIASCENARIO, 0,7) = 'NPSUTIF' AND cfg.SCENARIO = 'NPSUTIF'))&#xa;AND rich.STATORICHIESTANOW='LAVORAZIONEHD'" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_SCHEDULER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogInsert-input"
                    name="LogInsert"
                    tibex:xpdlId="fa254346-cfca-465e-ac5c-ca039ad906a4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertDaElaborareToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInsertToLog1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertDaElaborarePrimaPortabilita&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: &amp;quot;,bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;) ,&amp;quot;| Process: &amp;quot;, bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;),&amp;quot;| RootProcessInstance &amp;quot;, $_processContext/ProcessInstanceId,&amp;quot;| ProcessInstance &amp;quot;,$_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Insert su TOOL_STOPNGO_RICH eseguito con successo - numero di record inseriti: &amp;quot;, string($InsertDaElaborarePrimaPortabilita/noOfUpdates))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
