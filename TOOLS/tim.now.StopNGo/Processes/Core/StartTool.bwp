                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9e283c71-de32-4129-beb9-98f2efc87892+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RichiesteDaElaborare&quot;/>&#xa;    &lt;xsl:template name=&quot;CambioStato_LETTO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$RichiesteDaElaborare/Record&quot;>&#xa;                &lt;Record>&#xa;                    &lt;ID_LAVRZ_HD>&#xa;                        &lt;xsl:value-of select=&quot;ID_LAVRZ_HD&quot;/>&#xa;                    &lt;/ID_LAVRZ_HD>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns7:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
