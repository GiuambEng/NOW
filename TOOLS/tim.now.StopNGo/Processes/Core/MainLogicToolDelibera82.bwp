            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ResponseCCC"
                    name="AssignResponseCCC"
                    outputVariable="ResponseCCC"
                    tibex:xpdlId="1236274c-9dba-427f-af43-80e6f01702a4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty3ToAssignResponseCCC"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignResponseCCCToLog3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29&quot; xmlns:ns=&quot;http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallCCC&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseCCC&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CRMparam>&#xa;            &lt;tns6:CRM>&#xa;                &lt;!-- aggiunti apici vuoti affinche le condizioni nel SetEsitoRetail siano verificate. -->&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:StatoNumerazione) > 0&quot;>&#xa;                        &lt;tns6:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:StatoNumerazione)&quot;/>&#xa;                        &lt;/tns6:StatoNumerazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:StatoNumerazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:StatoServizio) > 0&quot;>&#xa;                        &lt;tns6:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:StatoServizio)&quot;/>&#xa;                        &lt;/tns6:StatoServizio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:StatoServizio>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:Lavorazione) > 0&quot;>&#xa;                        &lt;tns6:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:Lavorazione)&quot;/>&#xa;                        &lt;/tns6:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:Lavorazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Descrizione) > 0&quot;>&#xa;                        &lt;tns6:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Descrizione)&quot;/>&#xa;                        &lt;/tns6:DescrizioneErrore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:DescrizioneErrore>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;!-- aggiunto TipoConnett per chiamata a BonificaUnica. -->&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita&quot;>&#xa;                            &lt;tns6:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$CallCCC/tns6:GetDatiLineaUnicaResponse/ns:getDataResponse/ns:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita&quot;/>&#xa;                            &lt;/tns6:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:TipoConnettivita>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:TipoConnettivita>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns6:CRM>&#xa;        &lt;/tns6:CRMparam>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
