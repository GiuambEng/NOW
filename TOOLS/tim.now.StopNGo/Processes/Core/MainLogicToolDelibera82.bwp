                    name="AssignResponseRetail"
                    outputVariable="ResponseRetail"
                    tibex:xpdlId="ebd6ffcf-7443-47cc-9f9d-23b27285eac1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
