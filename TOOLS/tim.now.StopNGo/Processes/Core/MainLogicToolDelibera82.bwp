                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignEsitoRetailToLogAssignEsitoRetail"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:tns5=&quot;http://tempuri.org/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallCRM_Retail&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseRetail&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CRMparam>&#xa;            &lt;tns6:CRM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:StatoNumerazione) > 0&quot;>&#xa;                        &lt;tns6:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:StatoNumerazione)&quot;/>&#xa;                        &lt;/tns6:StatoNumerazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoNumerazione) > 0&quot;>&#xa;                        &lt;tns6:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoNumerazione)&quot;/>&#xa;                        &lt;/tns6:StatoNumerazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:StatoNumerazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:StatoServizio) > 0&quot;>&#xa;                        &lt;tns6:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:StatoServizio)&quot;/>&#xa;                        &lt;/tns6:StatoServizio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoServizio) > 0&quot;>&#xa;                        &lt;tns6:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoServizio)&quot;/>&#xa;                        &lt;/tns6:StatoServizio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:StatoServizio>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:Lavorazione) > 0&quot;>&#xa;                        &lt;tns6:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:Lavorazione)&quot;/>&#xa;                        &lt;/tns6:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:Lavorazione) > 0&quot;>&#xa;                        &lt;tns6:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:Lavorazione)&quot;/>&#xa;                        &lt;/tns6:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:Lavorazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:Errore/tns5:Descrizione) > 0&quot;>&#xa;                        &lt;tns6:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:Errore/tns5:Descrizione)&quot;/>&#xa;                        &lt;/tns6:DescrizioneErrore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:Errore/tns5:Descrizione) > 0&quot;>&#xa;                        &lt;tns6:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:Errore/tns5:Descrizione)&quot;/>&#xa;                        &lt;/tns6:DescrizioneErrore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:DescrizioneErrore>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;!-- aggiunto TipoConnett per chiamata a BonificaUnica. -->&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:TipoConnettivita) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:TipoConnettivita&quot;>&#xa;                            &lt;tns6:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:TipoConnettivita&quot;/>&#xa;                            &lt;/tns6:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:TipoConnettivita) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:TipoConnettivita&quot;>&#xa;                            &lt;tns6:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$CallCRM_Retail/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:TipoConnettivita&quot;/>&#xa;                            &lt;/tns6:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:TipoConnettivita>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:TipoConnettivita>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns6:CRM>&#xa;        &lt;/tns6:CRMparam>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ResponseRetail" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
