                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+77ad7dd4-f08d-4060-ab65-8a51883c4492+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MainLogicTool&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;EsitoRetail&quot;/>&#xa;    &lt;xsl:template name=&quot;SetESITO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:jdbcUpdateActivityInput>&#xa;            &lt;ESITI_RETAIL>&#xa;                &lt;xsl:value-of select=&quot;$EsitoRetail&quot;/>&#xa;            &lt;/ESITI_RETAIL>&#xa;            &lt;ID_LAVRZ_HD>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:ID_LavorazioneHD&quot;/>&#xa;            &lt;/ID_LAVRZ_HD>&#xa;        &lt;/tns8:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE TOOL_STOPNGO_RICH set  LAST_UPDATE=SYSDATE , ESITI_RETAIL=?&#xa;WHERE &#xa;ID_LAVRZ_HD=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITI_RETAIL"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_LAVRZ_HD"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
