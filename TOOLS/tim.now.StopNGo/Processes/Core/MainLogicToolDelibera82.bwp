                    <bpws:targets>
                        <bpws:target linkName="LogToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MainLogicTool&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:tns5=&quot;http://tempuri.org/&quot; xmlns:ns=&quot;http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;EsitoRetail&quot;/>&lt;xsl:param name=&quot;PID&quot;/>&lt;xsl:param name=&quot;EsitoFinale&quot;/>&lt;xsl:param name=&quot;FlagCautelare813&quot;/>&lt;xsl:param name=&quot;CallCRM_Business&quot;/>&lt;xsl:param name=&quot;CallCRM_Retail&quot;/>&lt;xsl:param name=&quot;CallCCC&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:Output_MainLogicTool>&lt;tns1:EsitoFinale>&lt;xsl:value-of select=&quot;$EsitoFinale&quot;/>&lt;/tns1:EsitoFinale>&lt;tns1:EsitoRetail>&lt;xsl:value-of select=&quot;$EsitoRetail&quot;/>&lt;/tns1:EsitoRetail>&lt;tns1:FlagCautelare>&lt;xsl:value-of select=&quot;$FlagCautelare813&quot;/>&lt;/tns1:FlagCautelare>&lt;tns1:PID>&lt;xsl:value-of select=&quot;$PID&quot;/>&lt;/tns1:PID>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoNumerazione) > 0&quot;>&lt;xsl:if test=&quot;$CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoNumerazione&quot;>&lt;tns1:StatoNumerazione>&lt;xsl:value-of select=&quot;$CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoNumerazione&quot;/>&lt;/tns1:StatoNumerazione>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($CallCRM_Retail/tns6:GetDatiLinea