                                    partName="fault" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    action="operationFailedFault"
                                    messageDirection="FAULT"
                                    messageQName="pt:operationFailedFault" wsdlLocation="platform:/resource/tim.now.StopNGo/Service%20Descriptors/BPM_API/BxProcessManagementService.wsdl">
                                    <messagePartConfigurations
                                    partElementName="processManagerType:operationFailedFault"
                                    partName="fault" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    <outputMapping direction="OUTPUT"/>
                                    <faultMappings direction="FAULT" faultName="illegalArgumentFault"/>
                                    <faultMappings direction="FAULT" faultName="illegalStateFault"/>
                                    <faultMappings direction="FAULT" faultName="operationFailedFault"/>
                                    </context>
                                </operationConfiguration>
                                <outboundConfiguration
                                    httpClient="BPM_Utils.HttpClientBPM" xsi:type="axis2:HttpTransportConfiguration"/>
                            </scaext:binding>
                            <scact:bindingAdjunct bindingName="SOAPReferenceBinding">
                                <sca:property name="endpointURI" scaext:simpleValue="/BPM_Properties/Connection/HTTP/createProcessInstance/EndPointURI"/>
                            </scact:bindingAdjunct>
                        </referenceBinding>
                    </bwbinding:BWBaseBinding>
                </tibex:binding>
            </tibex:ReferenceBinding>
        </bpws:partnerLink>
    </bpws:partnerLinks>
