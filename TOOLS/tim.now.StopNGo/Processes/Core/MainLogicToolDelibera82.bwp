                                    sqlStatement="UPDATE TOOL_STOPNGO_RICH &#xa;SET ESITO = ?, LAST_UPDATE = SYSDATE&#xa;WHERE ID_LAVRZ_HD = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
