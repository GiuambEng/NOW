                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.example.org/RecuperaDistretto&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:tns5=&quot;http://tempuri.org/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MainLogicTool&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaDistretto&quot;/>&#xa;    &lt;xsl:param name=&quot;PID&quot;/>&#xa;    &lt;xsl:param name=&quot;OscuramentoTotale&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallCCC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CRMRetailRequest>&#xa;            &lt;tns6:GetDatiLineaUnica>&#xa;                &lt;tns5:GetDatiLineaUnica>&#xa;                    &lt;tns5:Prefisso>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperaDistretto/tns8:Distretto&quot;/>&#xa;                    &lt;/tns5:Prefisso>&#xa;                    &lt;tns5:Numero>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperaDistretto/tns8:Numero&quot;/>&#xa;                    &lt;/tns5:Numero>&#xa;                    &lt;tns5:Sistema>&#xa;                        &lt;xsl:value-of select=&quot;'C'&quot;/>&#xa;                    &lt;/tns5:Sistema>&#xa;                &lt;/tns5:GetDatiLineaUnica>&#xa;            &lt;/tns6:GetDatiLineaUnica>&#xa;            &lt;tns6:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOLO&quot;/>&#xa;            &lt;/tns6:IDRichiestaOLO>&#xa;            &lt;tns6:RootProcessInstance>&#xa;                &lt;xsl:value-of select=&quot;$PID&quot;/>&#xa;            &lt;/tns6:RootProcessInstance>&#xa;            &lt;tns6:Oscurato>&#xa;                &lt;xsl:value-of select=&quot;$OscuramentoTotale&quot;/>&#xa;            &lt;/tns6:Oscurato>&#xa;        &lt;/tns6:CRMRetailRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
