                portType="ns40:processManagement" tibex:xpdlId="b743247d-221e-4ac8-84a6-501b907e6570">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns8="http://www.tibco.com/bx/2009/management/process/BxProcessManagementService_1.10.0" xmlns:ns0="http://www.tibco.com/bx/2009/management/processManagerType" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns1="http://www.tim.com/NOW/xsd/MainLogicTool" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:template name="InvokeBPM-input" match="/"&gt;
        &lt;tns8:createProcessInstanceRequest&gt;
            &lt;params&gt;
                &lt;ns0:createProcessInstanceInput&gt;
                    &lt;ns0:processQName&gt;
                        &lt;ns0:moduleName&gt;
                            &lt;xsl:value-of select="&amp;quot;/tim.NOW.bpm.BusinessService/Process Packages/tim.NOW.bpm.pageFlow.sendSignals.xpdl&amp;quot;"/&gt;
                        &lt;/ns0:moduleName&gt;
                        &lt;ns0:processName&gt;
                            &lt;xsl:value-of select="&amp;quot;SendSignalSbloccoCautelare&amp;quot;"/&gt;
                        &lt;/ns0:processName&gt;
                    &lt;/ns0:processQName&gt;
                    &lt;ns0:operationName&gt;
                        &lt;xsl:value-of select="&amp;quot;StartSbloccoCautelare&amp;quot;"/&gt;
                    &lt;/ns0:operationName&gt;
                    &lt;ns0:options/&gt;
                    &lt;ns0:parameterMap&gt;
                        &lt;ns0:parameter&gt;
                            &lt;ns0:name&gt;
                                &lt;xsl:value-of select="&amp;quot;IDRichiestaOLO&amp;quot;"/&gt;
                            &lt;/ns0:name&gt;
                            &lt;ns0:value&gt;
                                &lt;xsl:value-of select="$Start/tns1:IdRichiestaOLO"/&gt;
                            &lt;/ns0:value&gt;
                        &lt;/ns0:parameter&gt;
                        &lt;ns0:parameter&gt;
                            &lt;ns0:name&gt;
                                &lt;xsl:value-of select="&amp;quot;FlagCautelare&amp;quot;"/&gt;
                            &lt;/ns0:name&gt;
                            &lt;ns0:value&gt;
                                &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                            &lt;/ns0:value&gt;
                        &lt;/ns0:parameter&gt;
                    &lt;/ns0:parameterMap&gt;
                &lt;/ns0:createProcessInstanceInput&gt;
            &lt;/params&gt;
        &lt;/tns8:createProcessInstanceRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tibco.com/bx/2009/management/process/BxProcessManagementService_1.10.0&quot; xmlns:ns0=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MainLogicTool&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:createProcessInstanceInput>&#xa;            &lt;ns0:processQName>&#xa;                &lt;ns0:moduleName>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;/tim.NOW.bpm.BusinessService/Process Packages/tim.NOW.bpm.pageFlow.sendSignals.xpdl&amp;quot;&quot;/>&#xa;                &lt;/ns0:moduleName>&#xa;                &lt;ns0:processName>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendSignalSbloccoCautelare&amp;quot;&quot;/>&#xa;                &lt;/ns0:processName>&#xa;            &lt;/ns0:processQName>&#xa;            &lt;ns0:operationName>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;StartSbloccoCautelare&amp;quot;&quot;/>&#xa;            &lt;/ns0:operationName>&#xa;            &lt;ns0:options/>&#xa;            &lt;ns0:parameterMap>&#xa;                &lt;ns0:parameter>&#xa;                    &lt;ns0:name>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDRichiestaOLO&amp;quot;&quot;/>&#xa;                    &lt;/ns0:name>&#xa;                    &lt;ns0:value>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOLO&quot;/>&#xa;                    &lt;/ns0:value>&#xa;                &lt;/ns0:parameter>&#xa;                &lt;ns0:parameter>&#xa;                    &lt;ns0:name>&#xa;                        &lt;xs