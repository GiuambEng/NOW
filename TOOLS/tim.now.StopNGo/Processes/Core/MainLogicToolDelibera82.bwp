                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:tns5=&quot;http://tempuri.org/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallCRM_Business&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseBusiness&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:CRMparam>&#xa;            &lt;tns6:CRM>&#xa;                &lt;!-- aggiunti apici vuoti affinche le condizioni nel SetEsitoRetail siano verificate. -->&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:StatoNumerazione) > 0&quot;>&#xa;                        &lt;tns6:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:StatoNumerazione)&quot;/>&#xa;                        &lt;/tns6:StatoNumerazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoNumerazione) > 0&quot;>&#xa;                        &lt;tns6:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoNumerazione)&quot;/>&#xa;                        &lt;/tns6:StatoNumerazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:StatoNumerazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:StatoServizio) > 0&quot;>&#xa;                        &lt;tns6:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:StatoServizio)&quot;/>&#xa;                        &lt;/tns6:StatoServizio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoServizio) > 0&quot;>&#xa;                        &lt;tns6:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:StatoServizio)&quot;/>&#xa;                        &lt;/tns6:StatoServizio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:StatoServizio>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:Lavorazione) > 0&quot;>&#xa;                        &lt;tns6:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:Lavorazione)&quot;/>&#xa;                        &lt;/tns6:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:Lavorazione) > 0&quot;>&#xa;                        &lt;tns6:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:Lavorazione)&quot;/>&#xa;                        &lt;/tns6:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:Lavorazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:Errore/tns5:Descrizione) > 0&quot;>&#xa;                        &lt;tns6:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:Errore/tns5:Descrizione)&quot;/>&#xa;                        &lt;/tns6:DescrizioneErrore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:Errore/tns5:Descrizione) > 0&quot;>&#xa;                        &lt;tns6:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:Errore/tns5:Descrizione)&quot;/>&#xa;                        &lt;/tns6:DescrizioneErrore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:DescrizioneErrore>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;!-- aggiuntoTipoConnett per chiamata a BonificaUnica. -->&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:TipoConnettivita) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:TipoConnettivita&quot;>&#xa;                            &lt;tns6:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaResult/tns5:TipoConnettivita&quot;/>&#xa;                            &lt;/tns6:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:TipoConnettivita) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:TipoConnettivita&quot;>&#xa;                            &lt;tns6:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$CallCRM_Business/tns6:GetDatiLineaUnicaResponse/tns5:GetDatiLineaUnicaXResponse/tns5:GetDatiLineaUnicaXResult/tns5:TipoConnettivita&quot;/>&#xa;                            &lt;/tns6:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:TipoConnettivita>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns6:TipoConnettivita>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns6:CRM>&#xa;        &lt;/tns6:CRMparam>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
