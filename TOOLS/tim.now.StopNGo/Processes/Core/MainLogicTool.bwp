sult/tns1:Lavorazione)&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Lavorazione) > 0&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Lavorazione)&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:Errore/tns1:Descrizione) > 0&quot;>&#xa;                        &lt;tns:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:Errore/tns1:Descrizione)&quot;/>&#xa;                        &lt;/tns:DescrizioneErrore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Errore/tns1:Descrizione) > 0&quot;>&#xa;                        &lt;tns:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse