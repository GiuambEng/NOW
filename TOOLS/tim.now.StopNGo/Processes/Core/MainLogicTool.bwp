                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MainLogicTool&quot; xmlns:tns1=&quot;http://www.example.org/RunWorkItem&quot; xmlns:tns2=&quot;http://tempuri.org/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29&quot; xmlns:ns=&quot;http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PID&quot;/>&lt;xsl:param name=&quot;EsitoRetail&quot;/>&lt;xsl:param name=&quot;FlagCautelare813&quot;/>&lt;xsl:param name=&quot;CallCRM_Business&quot;/>&lt;xsl:param name=&quot;CallCRM_Retail&quot;/>&lt;xsl:param name=&quot;CallCCC&quot;/>&lt;xsl:template name=&quot;GestioneWorkItem-input&quot; match=&quot;/&quot;>&lt;tns1:RunWorkItem_Input>&lt;tns1:IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOLO&quot;/>&lt;/tns1:IDRICHIESTAOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;substring-before($EsitoRetail, &amp;quot; - &amp;quot;) = &amp;quot;KO_COERENTE&amp;quot;&quot;>&lt;tns1:ACTION>&lt;xsl:value-of select=&quot;&amp;quot;SCARTO&amp;quot;&quot;/>&lt;/tns1:ACTION>&lt;/xsl:when>&lt;xsl:when test=&quot;$FlagCautelare813 = &amp;quot;Y&amp;quot;&quot;>&lt;tns1:ACTION>&lt;xsl:value-of select=&quot;&amp;quot;CAUTELARE&amp;quot;&quot;/>&lt;/tns1:ACTION>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:ACTION>&lt;xsl:value-of select=&quot;&amp;quot;RETRY&amp;quot;&quot;/>&lt;/tns1:ACTION>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:CaseCode='C26M05F09' and substring-before($EsitoRetail, &amp;quot; - &amp;quot;) = &amp;quot;KO_COERENTE&amp;quot;&quot;>&lt;tns1:CAUSALE>&lt;xsl:value-of select=&quot;275&quot;/>&lt;/tns1:CAU