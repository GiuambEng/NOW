            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (string-length($ResponseRetail/ns2:CRM/ns2:DescrizioneErrore) > 0 and string-length($ResponseBusiness/ns2:CRM/ns2:DescrizioneErrore) > 0 and string-length($ResponseCCC/ns2:CRM/ns2:DescrizioneErrore) > 0)&#xd;&#xa;&#x9;then &quot;KO_COERENTE - Ricevuti KO da CRMR, CMRB e CCC&quot;&#xd;&#xa;&#xd;&#xa;else if ($ResponseRetail/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseBusiness/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione != 'ATTIVO') &#xd;&#xa;&#x9;then &quot;KO_COERENTE - Linea NON attiva sui Retail&quot;&#xd;&#xa;&#xd;&#xa;else if ($ResponseRetail/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot; and $ResponseBusiness/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot;) &#xd;&#xa;&#x9;then &quot;MANUALE_NOUNICA - Linea attiva sui Retail&quot;&#xd;&#xa;&#xd;&#xa;else if ($ResponseBusiness/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;) or $ResponseRetail/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;) or $ResponseCCC/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;))&#xd;&#xa;&#x9;then &quot;KO_INCOERENTE - Linea Attiva su uno dei Retail: Nessun Servizio in Volo&quot;&#xd;&#xa;&#xd;&#xa;else if (($ResponseBusiness/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot; and $ResponseRetail/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot;) or ($ResponseBusiness/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseRetail/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot;) or ($ResponseBusiness/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseRetail/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot;)) &#xd;&#xa;&#x9;then &#xd;&#xa;&#x9;&#x9;if ($ResponseBusiness/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;) or $ResponseRetail/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;) or $ResponseCCC/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;))&#xd;&#xa;&#x9;&#x9;&#x9;then &quot;KO_INCOERENTE - Linea Attiva su uno dei Retail: Nessun Servizio in Volo&quot;&#xd;&#xa;&#x9;&#xd;&#xa;&#x9;&#x9;else if (not($ResponseBusiness/ns2:CRM/ns2:Lavorazione = (&quot;CESSAZIONE&quot;,&quot;ATTIVAZIONE NP&quot;,&quot;ATTIVAZIONE WLR&quot;,&quot;ATTIVAZIONE ULL&quot;,&quot;ATTIVAZIONE ULL + NP&quot;,&quot;NIP OLO&quot;))&#xd;&#xa;&#x9;&#x9;&#x9;and not($ResponseRetail/ns2:CRM/ns2:Lavorazione = (&quot;CESSAZIONE&quot;,&quot;ATTIVAZIONE NP&quot;,&quot;ATTIVAZIONE WLR&quot;,&quot;ATTIVAZIONE ULL&quot;,&quot;ATTIVAZIONE ULL + NP&quot;,&quot;NIP OLO&quot;))&#xd;&#xa;&#x9;&#x9;&#x9;and not($ResponseCCC/ns2:CRM/ns2:Lavorazione = (&quot;CESSAZIONE&quot;,&quot;ATTIVAZIONE NP&quot;,&quot;ATTIVAZIONE WLR&quot;,&quot;ATTIVAZIONE ULL&quot;,&quot;ATTIVAZIONE ULL + NP&quot;,&quot;NIP OLO&quot;)))&#xd;&#xa;&#x9;&#x9;then 'OL_IN_CORSO - Linea Attiva su uno dei Retail: Servizio in Volo'&#xd;&#xa;&#x9;else &quot;KO_COERENTE - Linea Attiva su uno dei Retail: Servizio in Volo di Cessazione o Uscita&quot;&#xd;&#xa;else &quot;KO_COERENTE - Asset non attivo su una delle piattaforme Retail&quot;"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="EsitoRetail" name="SetEsitoRetail"
                    outputVariable="EsitoRetail"
                    tibex:xpdlId="2f1b5fd7-ceff-4a38-8d1e-0127ac57beee" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogAssignRespCCCToSetEsitoRetail"/>
                        <bpws:target linkName="LogAssignRespCRMBusinessToSetEsitoRetail"/>
                        <bpws:target linkName="LogAssignEsitoRetailToSetEsitoRetail"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SetEsitoToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (string-length($ResponseRetail/ns2:CRM/ns2:DescrizioneErrore) > 0 and string-length($ResponseBusiness/ns2:CRM/ns2:DescrizioneErrore) > 0 and string-length($ResponseCCC/ns2:CRM/ns2:DescrizioneErrore) > 0)&#xd;&#xa;&#x9;then &quot;KO_COERENTE - Ricevuti KO da CRMR, CMRB e CCC&quot;&#xd;&#xa;&#xd;&#xa;else if ($ResponseRetail/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseBusiness/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione != 'ATTIVO') &#xd;&#xa;&#x9;then &quot;KO_COERENTE - Linea NON attiva sui Retail&quot;&#xd;&#xa;&#xd;&#xa;else if ($ResponseRetail/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot; and $ResponseBusiness/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot;) &#xd;&#xa;&#x9;then &quot;MANUALE_NOUNICA - Linea attiva sui Retail&quot;&#xd;&#xa;&#xd;&#xa;else if ($ResponseBusiness/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;) or $ResponseRetail/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;) or $ResponseCCC/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;))&#xd;&#xa;&#x9;then &quot;KO_INCOERENTE - Linea Attiva su uno dei Retail: Nessun Servizio in Volo&quot;&#xd;&#xa;&#xd;&#xa;else if (($ResponseBusiness/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot; and $ResponseRetail/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot;) or ($ResponseBusiness/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseRetail/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot;) or ($ResponseBusiness/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseRetail/ns2:CRM/ns2:StatoNumerazione != &quot;ATTIVO&quot; and $ResponseCCC/ns2:CRM/ns2:StatoNumerazione = &quot;ATTIVO&quot;)) &#xd;&#xa;&#x9;then &#xd;&#xa;&#x9;&#x9;if ($ResponseBusiness/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;) or $ResponseRetail/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;) or $ResponseCCC/ns2:CRM/ns2:StatoServizio = (&quot;ATTIVO&quot;,&quot;ESPLETATO TECNICAMENTE&quot;))&#xd;&#xa;&#x9;&#x9;&#x9;then &quot;KO_INCOERENTE - Linea Attiva su uno dei Retail: Nessun Servizio in Volo&quot;&#xd;&#xa;&#x9;&#xd;&#xa;&#x9;&#x9;else if (not($ResponseBusiness/ns2:CRM/ns2:Lavorazione = (&quot;CESSAZIONE&quot;,&quot;ATTIVAZIONE NP&quot;,&quot;ATTIVAZIONE WLR&quot;,&quot;ATTIVAZIONE ULL&quot;,&quot;ATTIVAZIONE ULL + NP&quot;,&quot;NIP OLO&quot;))&#xd;&#xa;&#x9;&#x9;&#x9;and not($ResponseRetail/ns2:CRM/ns2:Lavorazione = (&quot;CESSAZIONE&quot;,&quot;ATTIVAZIONE NP&quot;,&quot;ATTIVAZIONE WLR&quot;,&quot;ATTIVAZIONE ULL&quot;,&quot;ATTIVAZIONE ULL + NP&quot;,&quot;NIP OLO&quot;))&#xd;&#xa;&#x9;&#x9;&#x9;and not($ResponseCCC/ns2:CRM/ns2:Lavorazione = (&quot;CESSAZIONE&quot;,&quot;ATTIVAZIONE NP&quot;,&quot;ATTIVAZIONE WLR&quot;,&quot;ATTIVAZIONE ULL&quot;,&quot;ATTIVAZIONE ULL + NP&quot;,&quot;NIP OLO&quot;)))&#xd;&#xa;&#x9;&#x9;then 'OL_IN_CORSO - Linea Attiva su uno dei Retail: Servizio in Volo'&#xd;&#xa;&#x9;else &quot;KO_COERENTE - Linea Attiva su uno dei Retail: Servizio in Volo di Cessazione o Uscita&quot;&#xd;&#xa;else &quot;KO_COERENTE - Asset non attivo su una delle piattaforme Retail&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
