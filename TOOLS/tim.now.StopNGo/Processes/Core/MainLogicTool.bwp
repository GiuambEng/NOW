                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToSetEsitoBonifica"/>
                    <bpws:source linkName="WhileToTimeoutUNICA"
                        tibex:faultDetailsVar="BonificaUnicaC" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RetryBonificaUnicaC='0'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RetryBonificaUnicaC='0']]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStartToLog1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="BonificaUnicaCToSetFalse" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Log1ToBonificaUnicaC" tibex:linkType="SUCCESS"/>
