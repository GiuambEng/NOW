zione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:StatoServizio) > 0&quot;>&#xa;                        &lt;tns:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:StatoServizio)&quot;/>&#xa;                        &lt;/tns:StatoServizio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:StatoServizio) > 0&quot;>&#xa;                        &lt;tns:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:StatoServizio)&quot;/>&#xa;                        &lt;/tns:StatoServizio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:StatoServizio>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:StatoServizio>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:Lavorazione) > 0&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:Lavorazione)&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Lavorazione) > 0&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Lavorazione)&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:Errore/tns1:Descrizione) > 0&quot;>&#xa;                        &lt;tns:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:Errore/tns1:Descrizione)&quot;/>&#xa;                        &lt;/tns:DescrizioneErrore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Errore/tns1:Descrizione) > 0&quot;>&#xa;                        &lt;tns:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Errore/tns1:Descrizione)&quot;/>&#xa;                        &lt;/tns:DescrizioneErrore>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:DescrizioneErrore>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;!-- aggiuntoTipoConnett per chiamata a BonificaUnica. -->&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:TipoConnettivita) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:TipoConnettivita&quot;>&#xa;                            &lt;tns:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:TipoConnettivita&quot;/>&#xa;                            &lt;/tns:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:TipoConnettivita) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:TipoConnettivita&quot;>&#xa;                            &lt;tns:TipoConnettivita>&#xa;                                &lt;xsl:value-of select=&quot;$CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:TipoConnettivita&quot;/>&#xa;                            &lt;/tns:TipoConnettivita>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:TipoConnettivita>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:TipoConnettivita>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:CRM>&#xa;        &lt;/tns:CRMparam>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
