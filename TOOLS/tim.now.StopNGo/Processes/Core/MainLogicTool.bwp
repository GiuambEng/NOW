            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5ab846d9-c48b-46b1-a6e3-d87319dfdb33+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MainLogicTool&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.example.org/RunWorkItem&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GestioneWorkItem&quot;/>&lt;xsl:param name=&quot;EsitoUnica&quot;/>&lt;xsl:param name=&quot;EsitoFinale&quot;/>&lt;xsl:param name=&quot;FlagCautelare813&quot;/>&lt;xsl:template name=&quot;UpdateLAVORATO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$FlagCautelare813 = &amp;quot;Y&amp;quot;&quot;>&lt;STATO>&lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE MANUALE&amp;quot;&quot;/>&lt;/STATO>&lt;/xsl:when>&lt;xsl:when test=&quot;$GestioneWorkItem/tns2:Esito='OK'&quot;>&lt;STATO>&lt;xsl:value-of select=&quot;&amp;quot;LAVORATO&amp;quot;&quot;/>&lt;/STATO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;STATO>&lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE MANUALE&amp;quot;&quot;/>&lt;/STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GestioneWorkItem/tns2:Esito='KO'&quot;>&lt;ESITO>&lt;xsl:value-of select=&quot;'NO ACTION'&quot;/>&lt;/ESITO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ESITO>&lt;xsl:value-of select=&quot;$EsitoFinale&quot;/>&lt;/ESITO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($EsitoUnica)>0&quot;>&lt;ESITI_UNICA>&lt;xsl:value-of select=&quot;$EsitoUnica&quot;/>&lt;/ESITI_UNICA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ESITI_UNICA xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GestioneWorkItem/tns2:Esito='KO'&quot;>&lt;DESCR_ERROR>&lt;xsl:value-of select=&quot;concat( 'TENTATIVO DI  ', $EsitoFinale, ' SUL WI FALLITO - ', $GestioneWorkItem/tns2:Descrizione)&quot;/>&lt;/DESCR_ERROR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_ERROR xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_LAVRZ_HD>&lt;xsl:value-of select=&quot;$Start/tns1:ID_LavorazioneHD&quot;/>&lt;/ID_LAVRZ_HD>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
