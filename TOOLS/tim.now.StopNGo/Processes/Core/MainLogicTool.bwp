                    <bpws:source linkName="CheckCaseToEmpty1_C26M05F04-05-06-09">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckCaseToEmpty2_C26M05F06caut">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:CaseCode = &quot;C26M05F06&quot; and $OscuramentoTotale = false() and count($RecuperaCreatedEScenario/Record) > 0 and $RecuperaCreatedEScenario/Record[1]/IDTPLGCAUTELARE = &quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns0:CaseCode = "C26M05F06" and $OscuramentoTotale = false() and count($RecuperaCreatedEScenario/Record) > 0 and $RecuperaCreatedEScenario/Record[1]/IDTPLGCAUTELARE = "Y"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckCaseToOscuramentoAgespNPSUWLR">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="not($Start/ns0:CaseCode = &quot;C26M05F06&quot;) and not($Start/ns0:CaseCode = &quot;C26M05F07&quot;) and starts-with($RecuperaCreatedEScenario/Record[1]/TIPOLOGIASCENARIO, &quot;NPSUWLR&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[not($Start/ns0:CaseCode = "C26M05F06") and not($Start/ns0:CaseCode = "C26M05F07") and starts-with($RecuperaCreatedEScenario/Record[1]/TIPOLOGIASCENARIO, "NPSUWLR")]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
