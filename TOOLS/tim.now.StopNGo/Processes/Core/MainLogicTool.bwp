                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT  attributi.VALOREATTRIBUTO AS ROUTINGNUMBER, asset.DES, olo.COD_OLO, asset.CODIFICAOLOAGCOM&#xa;   FROM OLO olo join BDS_1_CASEDATA_ASSET asset on  olo.CODFC_OLO_AGCOM=asset.CODIFICAOLOAGCOM left join  &#xa;   (select att.VALOREATTRIBUTO, att.IDASSET from BDS_1_CASEDATA_ATTRIBTDTTGLSST att WHERE att.NOMEATTRIBUTO='ROUTINGNUMBER') ATTRIBUTI on attributi.IDASSET=asset.IDASSET&#xa;   WHERE&#xa;   asset.statoasset IN ('ATTIVO','INLAVORAZIONE')&#xa;   and asset.IDASSET=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDASSET"/>
                                    <columnMetadata
                                    columnName="ROUTINGNUMBER"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnName="DES"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
