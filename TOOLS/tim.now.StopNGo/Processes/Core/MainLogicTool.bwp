)&amp;#xD;&amp;#xA;else if (string-length($BonificaUnicaC/tns3:codiceErrore) > 0) &amp;#xD;&amp;#xA;&amp;#x9;then concat(substring-after($EsitoRetail, &amp;quot; - &amp;quot;), &amp;quot; - NESSUNA OPERAZIONE ESEGUITA PER KO UNICA CON CODICE: &amp;quot;, $BonificaUnicaC/tns3:codiceErrore)&amp;#xD;&amp;#xA;else if (string-length($BonificaOLOUnicaC/tns3:codiceErrore) > 0)&amp;#xD;&amp;#xA;&amp;#x9;then concat(&amp;quot;NESSUNA OPERAZIONE ESEGUITA PER KO UNICA SERVIZIO BONIFICA OLO CON CODICE: &amp;quot;, $BonificaUnicaC/tns3:codiceErrore) &amp;#xD;&amp;#xA;else substring-after($EsitoRetail, &amp;quot; - &amp;quot;)&quot;/>&lt;/DESCR_ESITO>&lt;IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOLO&quot;/>&lt;/IDRICHIESTAOLO>&lt;ID_LAVRZ_HD>&lt;xsl:value-of select=&quot;$Start/tns1:ID_LavorazioneHD&quot;/>&lt;/ID_LAVRZ_HD>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
