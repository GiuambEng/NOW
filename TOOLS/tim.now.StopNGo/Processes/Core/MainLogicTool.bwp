                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CRMRetail/&quot; xmlns:tns1=&quot;http://tempuri.org/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallCRM_Business&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseBusiness&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CRMparam>&#xa;            &lt;tns:CRM>&#xa;                &lt;!-- aggiunti apici vuoti affinche le condizioni nel SetEsitoRetail siano verificate. -->&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:StatoNumerazione) > 0&quot;>&#xa;                        &lt;tns:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaResult/tns1:StatoNumerazione)&quot;/>&#xa;                        &lt;/tns:StatoNumerazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:StatoNumerazione) > 0&quot;>&#xa;                        &lt;tns:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;upper-case($CallCRM_Business/tns:GetDatiLineaUnicaResponse/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:StatoNumerazione)&quot;/>&#xa;                        &lt;/tns:StatoNumerazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:StatoNumerazione>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:Sta