                                    name="BonificaUnicaCToSetTrue" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="SetTrueToSleep1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Sleep1ToGroupEnd" tibex:linkType="SUCCESS"/>
