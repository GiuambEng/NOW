                                    expression="$BonificaUnicaC/ns3:esito='KO' and (contains($ScartiRetry_UNICA, $BonificaUnicaC/ns3:codiceErrore)) and $index&lt;$NumMaxRetry_UNICA" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
