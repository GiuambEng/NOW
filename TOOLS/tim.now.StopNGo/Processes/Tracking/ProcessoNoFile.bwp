                                    DataTypeDisplayValue="VARCHAR" ParameterName="TRANSACTION_ID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_INTRFC"/>
                                    </value>
                                </properties>
                            </activityConfig>
