            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+685632c7-e569-4dae-a646-dc9ad1bcde19+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+685632c7-e569-4dae-a646-dc9ad1bcde19+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="NEXTVAL" nillable="false" type="decimal"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+b9bd0ba4-66fe-45ce-be05-4ccdb6305260+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+b9bd0ba4-66fe-45ce-be05-4ccdb6305260+input">
            <element name="jdbcUpdateActivityInput">
                <complexType>
                    <sequence>
                        <element maxOccurs="1" minOccurs="1"
                            name="STATO_ESEC" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="TMSP_FINE_ELAB" nillable="true" type="dateTime"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="DESCR_ERRORE" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="ID_ESEC_PROCSO_NO_FILE"
                            nillable="true" type="decimal"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="ServerTimeZone" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="timeout" type="long"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
