                    tibex:xpdlId="0c16ce78-90a6-4f4a-8f7d-f8787659928d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToUpdateTimestampEsito"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateTimestampEsitoToLog1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0c16ce78-90a6-4f4a-8f7d-f8787659928d+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.org/getPVM&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;UpdateTimestampEsito-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/esito>&lt;data_ultima_elaborazione>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/data_ultima_elaborazione>&lt;cod_intrfc>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Mapper/tns1:getPvm[1]/tns1:COD_INTRFC)&quot;>&lt;xsl:value-of select=&quot;$Mapper/tns1:getPvm[1]/tns1:COD_INTRFC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/cod_intrfc>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE rc_pvm_tool&#xa;  SET esito = ?, data_ultima_elaborazione =?&#xa;   WHERE DATA_ULTIMA_ELABORAZIONE IS NULL and esito is null and COD_INTRFC = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="esito"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="data_ultima_elaborazione"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_intrfc"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SQLDirect-input"
                    name="SQLDirect" outputVariable="SQLDirect"
                    tibex:xpdlId="345d336e-f6e2-417a-8c8f-667e3c4b0549" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UPDStatCFG_YToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SQLDirectToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+345d336e-f6e2-417a-8c8f-667e3c4b0549+input&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetStatCFGTable&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT PVM, AZIONE, COD_INTRFC from RC_PVM_TOOL where DATA_ULTIMA_ELABORAZIONE IS NULL AND COD_INTRFC IN ('&amp;quot;, tib:concat-sequence-format&amp;#xD;&amp;#xA;($GetStatCFGTable/Record/COD_INTRFC, &amp;quot;','&amp;quot;, true()),&amp;quot;') &amp;quot;)&quot;/>&lt;/statement>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Mapper-input"
                    name="Mapper" outputVariable="Mapper"
                    tibex:xpdlId="9a1f265c-38af-4592-a8a4-18b956b164f6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SQLDirectToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/getPVM&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SQLDirect&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:getPVM>&#xa;            &lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&#xa;                &lt;tns:getPvm>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name = 'PVM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'PVM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'PVM']/value)&quot;>&#xa;                        &lt;tns:PVM>&#xa;                            &lt;xsl:value-of select=&quot;column[name = 'PVM']/value&quot;/>&#xa;                        &lt;/tns:PVM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name = 'AZIONE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'AZIONE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'AZIONE']/value)&quot;>&#xa;                        &lt;tns:AZIONE>&#xa;                            &lt;xsl:value-of select=&quot;column[name = 'AZIONE']/value&quot;/>&#xa;                        &lt;/tns:AZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;not((string(column[name = 'COD_INTRFC']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'COD_INTRFC']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'COD_INTRFC']/value)&quot;>&#xa;                        &lt;tns:COD_INTRFC>&#xa;                            &lt;xsl:value-of select=&quot;column[name = 'COD_INTRFC']/value&quot;/>&#xa;                        &lt;/tns:COD_INTRFC>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:getPvm>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:getPVM>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:getPVM="http://www.example.org/getPVM" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value inputQName="getPVM:getPVM" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
