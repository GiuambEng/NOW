<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:nm="http://www.tim.com/NOW/xsd/NotificationManager/" xmlns:sr="http://www.tim.com/NOW/xsd/CRMWS_ServiziRegolamentati/" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NotificationManager/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsd1="http://xsd.telecomitalia.it/crm/regolatorio" name="NotificationManager" targetNamespace="http://www.tim.com/NOW/wsdl/abstract/NotificationManager/">
	
	<wsdl:types>
		<xsd:schema>
			<xsd:import namespace="http://www.tim.com/NOW/xsd/NotificationManager/" schemaLocation="../Schemas/NotificationManager.xsd"></xsd:import>
		</xsd:schema>
		<xsd:schema>
			<xsd:import namespace="http://xsd.telecomitalia.it/crm/regolatorio" schemaLocation="../Schemas/NOW_ServiziRegolamentati_v1.19_Namespace.xsd"></xsd:import>
		</xsd:schema>
	</wsdl:types>

    <wsdl:message name="CreateNotificationRequest">
		<wsdl:part element="nm:NotificationRequest" name="NotificaRichiesta"/>
	</wsdl:message>
	<wsdl:message name="CreateNotificationResponse">
		<wsdl:part element="nm:NotificationResponse" name="NotificaRisposta"/>
    </wsdl:message>
	<wsdl:message name="CreateNotificationFault">
		<wsdl:part element="nm:NotificationFault" name="NotificaFault"/>
	</wsdl:message>	
	<wsdl:portType name="NotificationManagerPortType">
		<wsdl:operation name="CreateNotification">
			<wsdl:input message="tns:CreateNotificationRequest"/>
			<wsdl:output message="tns:CreateNotificationResponse"/>
			<wsdl:fault message="tns:CreateNotificationFault" name="fault"/>
		</wsdl:operation>
	</wsdl:portType>
</wsdl:definitions>