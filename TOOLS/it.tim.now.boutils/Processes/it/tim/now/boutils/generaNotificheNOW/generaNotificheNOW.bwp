                                    <value
                                    sharedResourceProperty="JDBCConnection"
                                    sqlStatement="SELECT IDRICHIESTAOLO, TipologiaNotifica, IDTracciamento, TipologiaOloDestinatario,&#xa;CodificaOloAGCOMDestinatario, UpdateOrDuplicateTracciamento, identificativo, COMP_DONATING_DPP_DONATING&#xa;FROM PPS_GENERA_NOTIFICHE &#xa;WHERE ACCOUNT = ?&#xa;AND FLAG_ELABORAZIONE = 'N'&#xa;AND STATO_ELABORAZIONE IS NULL" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ACCOUNT"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIANOTIFICA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDTRACCIAMENTO"
