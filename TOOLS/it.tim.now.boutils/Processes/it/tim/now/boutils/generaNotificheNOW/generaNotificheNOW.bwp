                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="JDBCConnection"
                                    sqlStatement="UPDATE PPS_GENERA_NOTIFICHE&#xa;  SET STATO_ELABORAZIONE = 'IN_ELABORAZIONE'&#xa;  WHERE ACCOUNT = ? AND FLAG_ELABORAZIONE = 'N' AND STATO_ELABORAZIONE IS NULL" xsi:type="jdbcPalette:JDBCUpdateActivity">

