    <bpws:import importType="http://schemas.xmlsoap.org/wsdl/" namespace="http://www.tim.com/NOW/wsdl/abstract/NotificationManager/"/>
    <bpws:partnerLinks>
        <bpws:partnerLink name="NotificationManagerPortType"
            partnerLinkType="ns20:partnerLinkType" partnerRole="use"
            sca-bpel:ignore="true"
            sca-bpel:reference="NotificationManagerPortType" sca-bpel:wiredByImpl="false">
            <tibex:ReferenceBinding>
                <tibex:binding>
                    <bwbinding:BWBaseBinding
                        xmlns:NotificationManager="http://www.tim.com/NOW/concrete/NotificationManager/"
                        xmlns:NotificationManager_1="http://www.tim.com/NOW/xsd/NotificationManager/"
                        xmlns:axis2="http://xsd.tns.tibco.com/bw/models/binding/soap/axis2"
                        xmlns:bwbinding="http://tns.tibco.com/bw/model/core/bwbinding"
                        xmlns:pt="http://www.tim.com/NOW/wsdl/abstract/NotificationManager/"
                        xmlns:sca="http://www.osoa.org/xmlns/sca/1.0"
                        xmlns:scact="http://xsd.tns.tibco.com/amf/models/sca/componentType"
                        xmlns:scaext="http://xsd.tns.tibco.com/amf/models/sca/extensions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <referenceBinding
                            name="NotificationManagerPortType" xsi:type="scact:Reference">
                            <sca:interface.wsdl
                                interface="http://www.tim.com/NOW/wsdl/abstract/NotificationManager/#wsdl.interface(NotificationManagerPortType)" scaext:wsdlLocation="../../../../../../../Service%20Descriptors/NotificationManager.wsdl"/>
                            <scaext:binding
                                locationURI="https://localhost:8083/NotificationManager_SOAPService/notificationManager_v1/"
                                modelVersion="1.2.0"
                                name="SOAPReferenceBinding"
                                portName="NotificationManagerPortTypeSOAP"
                                portTypeQName="pt:NotificationManagerPortType"
                                portTypeWSDLLocation="platform:/resource/it.tim.now.boutils/Service%20Descriptors/NotificationManager.wsdl"
                                serviceBindingQName="NotificationManager:NotificationManagerSOAPService"
                                serviceQName="NotificationManager:NotificationManagerPortType"
                                transportBindingType="HTTP"
                                wsdlLocation="platform:/resource/it.tim.now.boutils/Service%20Descriptors/NotificationManager_gen2.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
                                    action="CreateNotification" operationName="CreateNotification">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:CreateNotificationRequest" wsdlLocation="platform:/resource/it.tim.now.boutils/Service%20Descriptors/NotificationManager.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="NotificationManager_1:NotificationRequest"
                                    partName="NotificaRichiesta" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    messageDirection="OUTPUT"
                                    messageQName="pt:CreateNotificationResponse" wsdlLocation="platform:/resource/it.tim.now.boutils/Service%20Descriptors/NotificationManager.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="NotificationManager_1:NotificationResponse"
                                    partName="NotificaRisposta" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration action="fault"
                                    messageDirection="FAULT"
                                    messageQName="pt:CreateNotificationFault" wsdlLocation="platform:/resource/it.tim.now.boutils/Service%20Descriptors/NotificationManager.wsdl">
                                    <messagePartConfigurations
                                    partElementName="NotificationManager_1:NotificationFault"
                                    partName="NotificaFault" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    <outputMapping direction="OUTPUT"/>
                                    <faultMappings direction="FAULT" faultName="fault"/>
                                    </context>
                                </operationConfiguration>
                                <outboundConfiguration
                                    httpClient="it.tim.now.boutils.HttpClientResourceNotificstionManager" xsi:type="axis2:HttpTransportConfiguration"/>
                            </scaext:binding>
                            <scact:bindingAdjunct bindingName="SOAPReferenceBinding"/>
                        </referenceBinding>
                    </bwbinding:BWBaseBinding>
                </tibex:binding>
            </tibex:ReferenceBinding>
        </bpws:partnerLink>
    </bpws:partnerLinks>
