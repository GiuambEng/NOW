omunicazioneNP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="servizioOrigine"&gt;&lt;servizioOrigine&gt;&lt;xsl:value-of select="servizioOrigine"/&gt;&lt;/servizioOrigine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="codiceSTS"&gt;&lt;codiceSTS&gt;&lt;xsl:value-of select="codiceSTS"/&gt;&lt;/codiceSTS&gt;&lt;/xsl:if&gt;&lt;xsl:if test="caratteristica"&gt;&lt;caratteristica&gt;&lt;xsl:value-of select="caratteristica"/&gt;&lt;/caratteristica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="codiceRisorsaDonating"&gt;&lt;codiceRisorsaDonating&gt;&lt;xsl:value-of select="codiceRisorsaDonating"/&gt;&lt;/codiceRisorsaDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="codiceRisorsaDonating2"&gt;&lt;codiceRisorsaDonating2&gt;&lt;xsl:value-of select="codiceRisorsaDonating2"/&gt;&lt;/codiceRisorsaDonating2&gt;&lt;/xsl:if&gt;&lt;xsl:if test="cowCodeOLO"&gt;&lt;cowCodeOLO&gt;&lt;xsl:value-of select="cowCodeOLO"/&gt;&lt;/cowCodeOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="cowCodeOLO2"&gt;&lt;cowCodeOLO2&gt;&lt;xsl:value-of select="cowCodeOLO2"/&gt;&lt;/cowCodeOLO2&gt;&lt;/xsl:if&gt;&lt;xsl:if test="codiceSessione"&gt;&lt;codiceSessione&gt;&lt;xsl:value-of select="codiceSessione"/&gt;&lt;/codiceSessione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="codiceSessione2"&gt;&lt;codiceSessione2&gt;&lt;xsl:value-of select="codiceSessione2"/&gt;&lt;/codiceSessione2&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="DNAggiuntivo"&gt;&lt;DNAggiuntivo&gt;&lt;xsl:value-of select="."/&gt;&lt;/DNAggiuntivo&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="IDPreventivo"&gt;&lt;IDPreventivo&gt;&lt;xsl:value-of select="IDPreventivo"/&gt;&lt;/IDPreventivo&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDConsuntivo"&gt;&lt;IDConsuntivo&gt;&lt;xsl:value-of select="IDConsuntivo"/&gt;&lt;/IDConsuntivo&gt;&lt;/xsl:if&gt;&lt;xsl:if test="noteAltreLavorazioni"&gt;&lt;noteAltreLavorazioni&gt;&lt;xsl:value-of select="noteAltreLavorazioni"/&gt;&lt;/noteAltreLavorazioni&gt;&lt;/xsl:if&gt;&lt;xsl:if test="codicePacchettoNOW"&gt;&lt;codicePacchettoNOW&gt;&lt;xsl:value-of select="codicePacchettoNOW"/&gt;&lt;/codicePacchettoNOW&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="assetTarget"&gt;&lt;assetTarget&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;flagInLavorazione&gt;&lt;xsl:value-of select="flagInLavorazione"/&gt;&lt;/flagInLavorazione&gt;&lt;/assetTarget&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="operatoreRete"&gt;&lt;operatoreRete&gt;&lt;xsl:value-of select="operatoreRete"/&gt;&lt;/operatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="transactionIDLocator"&gt;&lt;transactionIDLocator&gt;&lt;xsl:value-of select="transactionIDLocator"/&gt;&lt;/transactionIDLocator&gt;&lt;/xsl:if&gt;&lt;xsl:if test="flagNumAggiuntive"&gt;&lt;flagNumAggiuntive&gt;&lt;xsl:value-of select="flagNumAggiuntive"/&gt;&lt;/flagNumAggiuntive&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDAnagraficaCausaleGUI"&gt;&lt;IDAnagraficaCausaleGUI&gt;&lt;xsl:value-of select="IDAnagraficaCausaleGUI"/&gt;&lt;/IDAnagraficaCausaleGUI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="codiceRifiutoDonating"&gt;&lt;codiceRifiutoDonating&gt;&lt;xsl:value-of select="codiceRifiutoDonating"/&gt;&lt;/codiceRifiutoDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="DACFile"&gt;&lt;DACFile&gt;&lt;xsl:value-of select="DACFile"/&gt;&lt;/DACFile&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tipologiaSottolav"&gt;&lt;tipologiaSottolav&gt;&lt;xsl:value-of select="tipologiaSottolav"/&gt;&lt;/tipologiaSottolav&gt;&lt;/xsl:if&gt;&lt;xsl:if test="codiceRifiuto"&gt;&lt;codiceRifiuto&gt;&lt;xsl:value-of select="codiceRifiuto"/&gt;&lt;/codiceRifiuto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="routingNumber"&gt;&lt;routingNumber&gt;&lt;xsl:value-of select="routingNumber"/&gt;&lt;/routingNumber&gt;&lt;/xsl:if&gt;&lt;xsl:if test="progressivoEmissioneDTU"&gt;&lt;progressivoEmissioneDTU&gt;&lt;xsl:value-of select="progressivoEmissioneDTU"/&gt;&lt;/progressivoEmissioneDTU&gt;&lt;/xsl:if&gt;&lt;xsl:if test="flagAttesaDesospOLO"&gt;&lt;flagAttesaDesospOLO&gt;&lt;xsl:value-of select="flagAttesaDesospOLO"/&gt;&lt;/flagAttesaDesospOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="flagDeliveryExposed"&gt;&lt;flagDeliveryExposed&gt;&lt;xsl:value-of select="flagDeliveryExposed"/&gt;&lt;/flagDeliveryExposed&gt;&lt;/xsl:if&gt;&lt;xsl:if test="disaggregato"&gt;&lt;disaggregato&gt;&lt;xsl:value-of select="disaggregato"/&gt;&lt;/disaggregato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exDisaggregato"&gt;&lt;exDisaggregato&gt;&lt;xsl:value-of select="exDisaggregato"/&gt;&lt;/exDisaggregato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="FFACQKO"&gt;&lt;FFACQKO&gt;&lt;xsl:value-of select="FFACQKO"/&gt;&lt;/FFACQKO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(string(idProgressivoNotificheFF))&gt;0"&gt;&lt;xsl:if test="idProgressivoNotificheFF"&gt;&lt;idProgressivoNotificheFF&gt;&lt;xsl:value-of select="idProgressivoNotificheFF"/&gt;&lt;/idProgressivoNotificheFF&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="idTplgCautelare"&gt;&lt;idTplgCautelare&gt;&lt;xsl:value-of select="idTplgCautelare"/&gt;&lt;/idTplgCautelare&gt;&lt;/xsl:if&gt;&lt;xsl:if test="rendezVous"&gt;&lt;rendezVous&gt;&lt;xsl:value-of select="rendezVous"/&gt;&lt;/rendezVous&gt;&lt;/xsl:if&gt;&lt;xsl:if test="cambioTecnologia"&gt;&lt;cambioTecnologia&gt;&lt;xsl:value-of select="cambioTecnologia"/&gt;&lt;/cambioTecnologia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tipoComunicazioneCPS"&gt;&lt;tipoComunicazioneCPS&gt;&lt;xsl:value-of select="tipoComunicazioneCPS"/&gt;&lt;/tipoComunicazioneCPS&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ordineAssetWhiteList"&gt;&lt;ordineAssetWhiteList&gt;&lt;xsl:value-of select="ordineAssetWhiteList"/&gt;&lt;/ordineAssetWhiteList&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exOperatoreRete"&gt;&lt;exOperatoreRete&gt;&lt;xsl:value-of select="exOperatoreRete"/&gt;&lt;/exOperatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="flagDelibera103"&gt;&lt;flagDelibera103&gt;&lt;xsl:value-of select="flagDelibera103"/&gt;&lt;/flagDelibera103&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(string(tmpAckNpD103))&gt;0"&gt;&lt;xsl:if test="tmpAckNpD103"&gt;&lt;tmpAckNpD103&gt;&lt;xsl:value-of select="tmpAckNpD103"/&gt;&lt;/tmpAckNpD103&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="codiceOperatoreReturning"&gt;&lt;codiceOperatoreReturning&gt;&lt;xsl:value-of select="codiceOperatoreReturning"/&gt;&lt;/codiceOperatoreReturning&gt;&lt;/xsl:if&gt;&lt;/ns:RichiestaElement&gt;&lt;/xsl:for-each&gt;&lt;tns1:TipologiaNotifica&gt;&lt;xsl:value-of select="$Start/tns2:DatiNotifica[number($index)]/tns2:TipologiaNotifica"/&gt;&lt;/tns1:TipologiaNotifica&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RecuoerTracciamentoC/tns4:IDEventoOrdineNOW)"&gt;&lt;xsl:if test="$RecuoerTracciamentoC/tns4:IDEventoOrdineNOW"&gt;&lt;tns1:IDEventoOrdineNOW&gt;&lt;xsl:value-of select="$RecuoerTracciamentoC/tns4:IDEventoOrdineNOW"/&gt;&lt;/tns1:IDEventoOrdineNOW&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/tns2:DatiNotifica[number($index)]/tns2:TipologiaOloDestinatario"&gt;&lt;tns1:TipologiaOLODestinatario&gt;&lt;xsl:value-of select="$Start/tns2:DatiNotifica[number($index)]/tns2:TipologiaOloDestinatario"/&gt;&lt;/tns1:TipologiaOLODestinatario&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$RecuoerTracciamentoC/ns:RichiestaElement/strutturaRichiesta = &amp;quot;NPG&amp;quot; or exists($RecuoerTracciamentoC/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='NUMBERPORTABILITY'])"&gt;&lt;xsl:if test="$Start/tns2:DatiNotifica[number($index)]/tns2:CodificaOloAGCOMDestinatario"&gt;&lt;tns1:CodificaOLOAGCOMDestinatario&gt;&lt;xsl:value-of select="$Start/tns2:DatiNotifica[number($index)]/tns2:CodificaOloAGCOMDestinatario"/&gt;&lt;/tns1:CodificaOLOAGCOMDestinatario&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$RecuoerTracciamentoC/ns:RichiestaElement/strutturaRichiesta = &amp;quot;NPG&amp;quot;"&gt;&lt;xsl:if test="$JDBCQueryCodificaOLONOWDestinatario/Record[1]/COD_OLO"&gt;&lt;tns1:CodificaOLONOWDestinatario&gt;&lt;xsl:value-of select="$JDBCQueryCodificaOLONOWDestinatario/Record[1]/COD_OLO"/&gt;&lt;/tns1:CodificaOLONOWDestinatario&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns2:DatiNotifica[number($index)]/tns2:TipologiaOloDestinatario = &amp;quot;DONATING&amp;quot; and not(contains($CompDonatingDPPDonating1, &amp;quot;NaN&amp;quot;))"&gt;&lt;tns1:IDAssetConsistenza&gt;&lt;xsl:value-of select="xsd:int($Start/tns2:DatiNotifica[number($index)]/tns2:COMP_DONATING_DPP_DONATING)"/&gt;&lt;/tns1:IDAssetConsistenza&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns2:DatiNotifica[number($index)]/tns2:TipologiaOloDestinatario ='DONATING' and &amp;#xD;&amp;#xA;$Start/tns2:DatiNotifica[number($index)]/tns2:COMP_DONATING_DPP_DONATING='CONSISTENZAFONIA'"&gt;&lt;tns1:IDAssetConsistenza&gt;&lt;xsl:value-of select="xsd:int($RecuoerTracciamentoC/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)"/&gt;&lt;/tns1:IDAssetConsistenza&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns2:DatiNotifica[number($index)]/tns2:TipologiaOloDestinatario ='DONATING' and &amp;#xD;&amp;#xA;$Start/tns2:DatiNotifica[number($index)]/tns2:COMP_DONATING_DPP_DONATING='CONSISTENZADATI'"&gt;&lt;tns1:IDAssetConsistenza&gt;&lt;xsl:value-of select="xsd:int($RecuoerTracciamentoC/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)"/&gt;&lt;/tns1:IDAssetConsistenza&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;/tns1:NotificationRequest&gt;&lt;/NotificaRichiesta&gt;&lt;/tns:CreateNotificationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationManager/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenNotf&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ToolGenNotfUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuoerTracciamentoC&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryCodificaOLONOWDestinatario&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;CompDonatingDPPDonating1&quot;/>&#xa;    &lt;xsl:template name=&quot;CreateNotification-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificationRequest>&#xa;            &lt;xsl:for-each select=&quot;$RecuoerTracciamentoC/ns:RichiestaElement&quot;>&#xa;                &lt;ns:RichiestaElement>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;     