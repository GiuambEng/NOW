                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenNotf&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRisposta&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_TRACC&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Log1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tit.tim.now.boutils.application | Process: GenNotf_Massivo.bwp | ProcessInstance &amp;quot;, $Start/tns2:TransactionID)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('ID_RICHIESTA_OLO: ', $Start/tns2:DatiNotifica[number($index)]/tns2:IDRichiestaOLO  ,'Creata notifica: ', string($CreateNotification.NotificaRisposta/tns1:IdNotifica),' Inserita riga nuova su Tracciamento ',  string($ID_TRACC/Record[1]/NEXTVAL), ' con NOTIFICA al : ', $Start/tns2:DatiNotifica[number($index)]/tns2:TipologiaOloDestinatario)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
