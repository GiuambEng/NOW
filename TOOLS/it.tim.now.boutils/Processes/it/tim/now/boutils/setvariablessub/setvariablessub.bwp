                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6a841da2-446f-4fdf-ac27-5a5ac9c794cb+input&quot; xmlns:tns1=&quot;http://www.example.org/setVarInput&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;&amp;quot;SELECT processid,varname,xml_data&amp;#xD;&amp;#xA;FROM PPS_SETVARIABLE where STATE =&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;'Z',&amp;#xD;&amp;#xA;&amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot;and ACCOUNT =&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;$Start/tns1:account,&amp;#xD;&amp;#xA;&amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&lt;/statement>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
