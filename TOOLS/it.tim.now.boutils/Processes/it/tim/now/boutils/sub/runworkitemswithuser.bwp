                                    <bpws:source linkName="InvokeToLogCompletedOutput"/>
                                    </bpws:sources>
                                    </bpws:invoke>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="LogCompletedOutput-input"
                                    name="LogCompletedOutput"
                                    tibex:xpdlId="ae0cb7cd-1d24-4327-b0dc-a20705be3fd7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InvokeToLogCompletedOutput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogCompletedOutputToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/SubRunOutWithUserInput&quot; xmlns:tns2=&quot;http://www.example.org/QueryItems&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogCompletedOutput-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/msgCode>&lt;loggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/loggerName>&lt;logLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/logLevel>&lt;message>&lt;xsl:value-of select=&quot;concat($Start/tns1:User,&amp;#xD;&amp;#xA;': Completed ended for item ID ', &amp;#xD;&amp;#xA;string($currentElement/tns2:WORKITEMID)&amp;#xD;&amp;#xA;)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                </bpws:scope>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="JDBCUpdate1-input"
                                    name="JDBCUpdate1"
                                    outputVariable="JDBCUpdate1"
                                    tibex:xpdlId="3009fde0-42e3-4e8d-8ed1-866d9ca8ccc8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ScopeToJDBCUpdate1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdate1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3009fde0-42e3-4e8d-8ed1-866d9ca8ccc8+input&quot; xmlns:tns1=&quot;http://www.example.org/QueryItems&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;InputState>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/InputState>&lt;InputLastUpdate>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/InputLastUpdate>&lt;InputEsito>&lt;xsl:value-of select=&quot;substring(tib:render-xml($_error),1,4000)&quot;/>&lt;/InputEsito>&lt;InputWorkItemId>&lt;xsl:value-of select=&quot;xsd:int($currentElement/tns1:WORKITEMID)&quot;/>&lt;/InputWorkItemId>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="QueryTimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="update appuser.PPS_GESTIONEWORKITEM&#xa;set &#xa;PPS_GESTIONEWORKITEM.STATE = ?,&#xa;PPS_GESTIONEWORKITEM.LASTUPDATE = ?,&#xa;PPS_GESTIONEWORKITEM.ESITO = ?&#xa;where &#xa;PPS_GESTIONEWORKITEM.WORKITEMID = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="InputState"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="InputLastUpdate"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="InputEsito"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="InputWorkItemId"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogBatchWorkItemWithUserInput-input"
                    name="LogBatchWorkItemWithUserInput"
                    tibex:xpdlId="55db4307-c675-4f5a-a85f-f642a987be0a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SQLDirectToLogBatchWorkItemWithUserInput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_LogBatchWorkItemInputToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/SubRunOutWithUserInput&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SQLDirect&quot;/>&lt;xsl:template name=&quot;LogBatchWorkItemWithUserInput-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/msgCode>&lt;loggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/loggerName>&lt;logLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/logLevel>&lt;message>&lt;xsl:value-of select=&quot;concat($Start/tns1:User, &amp;quot;: Elaborazione batch, numero items  &amp;quot;, string(count($SQLDirect/unknownResultset/row)))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SQLDirect-input"
                    name="SQLDirect" outputVariable="SQLDirect"
                    tibex:xpdlId="ff432329-bb05-48f4-b097-1e0596ad8587" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SQLDirectToLogBatchWorkItemWithUserInput">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SQLDirectToMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SQLDirect/unknownResultset/row) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SQLDirect/unknownResultset/row) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ff432329-bb05-48f4-b097-1e0596ad8587+input&quot; xmlns:tns1=&quot;http://www.example.org/SubRunOutWithUserInput&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;&amp;quot;SELECT workitemid,versione,action,causale&amp;#xD;&amp;#xA;FROM appuser.PPS_GestioneWorkItem where STATE =&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;'N',&amp;#xD;&amp;#xA;&amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot;and ACCOUNT =&amp;quot;,&amp;#xD;&amp;#xA;&amp;quot;'&amp;quot;,&amp;#xD;&amp;#xA;$Start/tns1:User,&amp;#xD;&amp;#xA;&amp;quot;'&amp;quot;&amp;#xD;&amp;#xA;)&quot;/>&lt;/statement>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="QueryTimeOut"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryItems-input" name="QueryItems"
                    outputVariable="QueryItems"
                    tibex:xpdlId="fe0dbc02-2ff6-44ee-9a1c-93d36eb5e086" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SQLDirectToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/QueryItems&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SQLDirect&quot;/>&#xa;    &lt;xsl:template name=&quot;QueryItems-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Record>&#xa;            &lt;xsl:for-each select=&quot;$SQLDirect/unknownResultset/row&quot;>&#xa;                &lt;tns:Row>&#xa;                    &lt;tns:WORKITEMID>&#xa;                        &lt;xsl:value-of select=&quot;./column[name='WORKITEMID']/value&quot;/>&#xa;                    &lt;/tns:WORKITEMID>&#xa;                    &lt;tns:VERSION>&#xa;                        &lt;xsl:value-of select=&quot;./column[name='VERSIONE']/value&quot;/>&#xa;                    &lt;/tns:VERSION>&#xa;                    &lt;tns:ACTION>&#xa;                        &lt;xsl:value-of select=&quot;./column[name='ACTION']/value&quot;/>&#xa;                    &lt;/tns:ACTION>&#xa;                    &lt;xsl:if test=&quot;not((string(./column[name='CAUSALE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(./column[name='CAUSALE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(./column[name='CAUSALE']/value)&quot;>&#xa;                        &lt;tns:CAUSALE>&#xa;                            &lt;xsl:value-of select=&quot;./column[name='CAUSALE']/value&quot;/>&#xa;                        &lt;/tns:CAUSALE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:Row>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:Record>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:QueryItems="http://www.example.org/QueryItems"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="QueryItems:Record" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
