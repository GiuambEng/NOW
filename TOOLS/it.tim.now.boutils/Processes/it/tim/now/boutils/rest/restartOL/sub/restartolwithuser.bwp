    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLogCount" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogCountToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="cf8a23d3-a6f1-40a3-b68e-2b34ba88369a"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLogCount"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="62c5a129-f500-4423-b28d-0c95f1a25f7a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.it/NOW/boutils/schema/restartolGenericSchema/&quot; xmlns:tns1=&quot;http://www.example.org/RunOutWiResponse&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:RestartOL_Output>&lt;tns1:Response>&lt;tns1:result>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:result>&lt;/tns1:Response>&lt;/tns:RestartOL_Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogCount-input"
                    name="LogCount"
                    tibex:xpdlId="a9760988-743a-4541-b4fe-2df4aafe0a42" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLogCount"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogCountToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns2=&quot;http://www.tim.it/NOW/boutils/schema/restartolGenericSchema/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;LogCount-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;loggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/loggerName>&lt;logLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/logLevel>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;'[Application: it.tim.now.boutils.application] ', '[Process: restartolwithuser.bwp]', '[restartol]', '[get]',&amp;#xD;&amp;#xA;'[',$Start/tns2:account,']', '[Trovati ', string(count($Start/tns2:IdRichiestaOLO)), ' records]', '[]')&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="5fd3c237-d700-436e-bf85-db6de7b74819">
                <bpws:targets>
                    <bpws:target linkName="LogCountToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLog"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable
                        element="ns10:Update_PPS_RESTARTOL_Input" name="UpdTblState"/>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($Start/ns10:IdRichiestaOLO)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($Start/ns10:IdRichiestaOLO)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToLogCicloIn" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogCicloInToScope" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ScopeToLog" tibex:linkType="ERROR"/>
                                <bpws:link name="LogErrorToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ScopeToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="9fe5b42e-1f27-4bd2-8b5f-d9d6e9e5ce24">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToLogCicloIn"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="e728b4e5-818c-43b9-ab56-125b05b39519">
                                <bpws:targets>
                                    <bpws:target linkName="LogErrorToGroupEnd"/>
                                    <bpws:target linkName="ScopeToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="LogCicloIn-input"
                                    name="LogCicloIn"
                                    tibex:xpdlId="718e5f0c-3418-4b0e-bf1e-44b550fdc9fc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToLogCicloIn"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogCicloInToScope"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns2=&quot;http://www.tim.it/NOW/boutils/schema/restartolGenericSchema/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;LogCicloIn-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;loggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/loggerName>&lt;logLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/logLevel>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;'[Application: it.tim.now.boutils.application] ', '[Process: restartolwithuser.bwp]', '[restartol]', '[get]',&amp;#xD;&amp;#xA;'[',$Start/tns2:account,']', '[Avvio reingressamento richiesta ', $Start/tns2:IdRichiestaOLO[number($index)], ']', '[]')&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:scope name="Scope" tibex:group="none" tibex:xpdlId="dc9ab0e8-de4f-4ec0-8fd0-aad1191e88f5">
                                <bpws:targets>
                                    <bpws:target linkName="LogCicloInToScope"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ScopeToLog"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="ScopeToGroupEnd"/>
                                </bpws:sources>
                                <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="checkNOTFToconvertiCasedataV1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="checkNOTFToLogKO" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="checkNOTFToLogCheckNOTF" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="LogKOToAssignDescrErrore" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="getLocalRequestTodeleteRequestData" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="getLocalRequestToAssignDescrErrore2" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="deleteRequestDataToAssign" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="Scope1ToAssignUpdTblState" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AssignDescrErroreToupdate_PPS_RESTARTOL" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AssignDescrErrore2Toupdate_PPS_RESTARTOL" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AssignToupdate_PPS_RESTARTOL" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AssignDescrErrore4Toupdate_PPS_RESTARTOL" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogCheckNOTFToAssignDescrErrore" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1TocheckNOTF" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="update_PPS_RESTARTOLToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Scope1ToAssignDescrErrore4" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="AssignUpdTblStateToupdate_PPS_RESTARTOL" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1TogetLocalRequest_skipchecknotifiche"
                                    tibex:label="skip check notifiche" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="deleteRequestDataToScope1" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty name="GroupStart1"
                                    tibex:group="groupStart" tibex:xpdlId="e8c9ee1c-1cf1-4f77-9a64-832d847a3d71">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1TocheckNOTF">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1TogetLocalRequest_skipchecknotifiche">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string($checkNotif) = &quot;false&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string($checkNotif) = "false"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:empty name="GroupEnd1"
                                    tibex:group="groupEnd" tibex:xpdlId="ec205972-7ddf-4e8d-b42a-e335d99e8d0e">
                                    <bpws:targets>
                                    <bpws:target linkName="update_PPS_RESTARTOLToGroupEnd1"/>
                                    </bpws:targets>
                                    </bpws:empty>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="checkNOTF-input"
                                    name="checkNOTF"
                                    outputVariable="checkNOTF"
                                    tibex:xpdlId="a55a9c24-129b-41ec-8156-0ebf3a72e9c3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1TocheckNOTF"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="checkNOTFToconvertiCasedataV1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="checkNOTFToLogKO">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$checkNOTF/Record[1]/COUNTIDNOTF > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$checkNOTF/Record[1]/COUNTIDNOTF > 0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source
                                    linkName="checkNOTFToLogCheckNOTF"
                                    tibex:faultDetailsVar="checkNOTF" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
