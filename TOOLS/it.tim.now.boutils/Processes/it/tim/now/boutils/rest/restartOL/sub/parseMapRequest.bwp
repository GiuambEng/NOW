                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.it/NOW/boutils/schema/restartolGenericSchema/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelRichiesta&quot;/>&lt;xsl:param name=&quot;ParseCasedataV1&quot;/>&lt;xsl:param name=&quot;selAcqRich&quot;/>&lt;xsl:param name=&quot;ParseCasedata&quot;/>&lt;xsl:template name=&quot;backupLocalRequest-input&quot; match=&quot;/&quot;>&lt;tns:BackupLocalRequest_Input>&lt;tns:account>&lt;xsl:value-of select=&quot;$Start/tns:account&quot;/>&lt;/tns:account>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOLO&quot;/>&lt;/tns:IdRichiestaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;count($selAcqRich/Record) > 0&quot;>&lt;tns:localRequest>&lt;xsl:value-of select=&quot;tib:render-xml($ParseCasedata, false(), false())&quot;/>&lt;/tns:localRequest>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:localRequest>&lt;xsl:value-of select=&quot;tib:render-xml($ParseCasedataV1, false(), false())&quot;/>&lt;/tns:localRequest>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;count($SelRichiesta/Record) > 0&quot;>&lt;xsl:if test=&quot;$SelRichiesta/Record[1]/CODICEORDINETI&quot;>&lt;tns:codiceOrdineTI>&lt;xsl:value-of select=&quot;$SelRichiesta/Record[1]/CODICEORDINETI&quot;/>&lt;/tns:codiceOrdineTI>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:BackupLocalRequest_Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
