            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogParse-input"
                    name="LogParse"
                    tibex:xpdlId="00b1fc5c-9fb6-4555-b47a-aac4a52801a7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="parseCreateInstToLog1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogParseToParseCasedata"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.it/NOW/boutils/schema/restartolGenericSchema/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;selAcqRich&quot;/>&lt;xsl:template name=&quot;LogParse-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;loggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/loggerName>&lt;logLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/logLevel>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;#xD;&amp;#xA;'[Application: it.tim.now.boutils.application] ', '[Process: parseMapRequest.bwp]', '[restartol]', '[get]',&amp;#xD;&amp;#xA;'[',$Start/tns1:account,']', '[', $Start/tns1:IdRichiestaOLO, ']', '[Recuperato input CreateProcessInstance dalla tabella ACQUISIZIONE_RICHIESTE con Id Richiesta Acquisizione: ', string($selAcqRich/Record[1]/ID_RICHIESTA), ']')&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
