                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="1"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_RICHIESTA, XML_CASEDATA_RICHIESTA &#xa;FROM ACQUISIZIONE_RICHIESTE &#xa;WHERE ID_RICHIESTA_OLO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
