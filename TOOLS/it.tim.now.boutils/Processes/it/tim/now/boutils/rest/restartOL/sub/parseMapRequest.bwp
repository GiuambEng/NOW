                    <bpws:targets>
                        <bpws:target linkName="backupLocalRequestToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.it/NOW/boutils/schema/restartolGenericSchema/&quot; xmlns:ns0=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichiestaElement&quot;/>&lt;xsl:param name=&quot;parseCreateInst&quot;/>&lt;xsl:param name=&quot;selAcqRich&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:ParseMapRequest_Output>&lt;tns:localRequest>&lt;xsl:value-of select=&quot;tib:render-xml($RichiestaElement, false(), false())&quot;/>&lt;/tns:localRequest>&lt;xsl:if test=&quot;count($selAcqRich/Record) > 0&quot;>&lt;tns:idRichiestaAcquisizione>&lt;xsl:value-of select=&quot;xsd:int($selAcqRich/Record[1]/ID_RICHIESTA)&quot;/>&lt;/tns:idRichiestaAcquisizione>&lt;/xsl:if>&lt;xsl:if test=&quot;count($selAcqRich/Record) > 0&quot;>&lt;tns:createProcessInstanceInput>&lt;tns:processQName>&lt;xsl:if test=&quot;$parseCreateInst/ns0:processQName/ns0:moduleName&quot;>&lt;tns:moduleName>&lt;xsl:copy-of select=&quot;$parseCreateInst/ns0:processQName/ns0:moduleName/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;$parseCreateInst/ns0:processQName/ns0:moduleName&quot;/>&lt;/tns:moduleName>&lt;/xsl:if>&lt;xsl:if test=&quot;$parseCreateInst/ns0:processQName/ns0:processName&quot;>&lt;tns:processName>&lt;xsl:copy-of select=&quot;$parseCreateInst/ns0:processQName/ns0:processName/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;$parseCreateInst/ns0:processQName/ns0:processName&quot;/>&lt;/tns:processName>&lt;/xsl:if>&lt;xsl:if test=&quot;$parseCreateInst/ns0:processQName/ns0:version&quot;>&lt;tns:version>&lt;xsl:copy-of select=&quot;$parseCreateInst/ns0:processQName/ns0:version/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;$parseCreateInst/ns0:processQName/ns0:version&quot;/>&lt;/tns:version>&lt;/xsl:if>&lt;/tns:processQName>&lt;tns:operationName>&lt;xsl:value-of select=&quot;$parseCreateInst/ns0:operationName&quot;/>&lt;/tns:operationName>&lt;tns:options>&lt;xsl:if test=&quot;$parseCreateInst/ns0:options/ns0:priority&quot;>&lt;tns:priority>&lt;xsl:value-of select=&quot;$parseCreateInst/ns0:options/ns0:priority&quot;/>&lt;/tns:priority>&lt;/xsl:if>&lt;/tns:options>&lt;tns:parameterMap>&lt;tns:parameter>&lt;tns:name>&lt;xsl:value-of select=&quot;'localRequest'&quot;/>&lt;/tns:name>&lt;tns:value>&lt;xsl:value-of select=&quot;tib:render-xml($RichiestaElement, false(), false())&quot;/>&lt;/tns:value>&lt;/tns:parameter>&lt;xsl:for-each select=&quot;$parseCreateInst/ns0:parameterMap/ns0:parameter[ns0:name != 'localRequest']&quot;>&lt;tns:parameter>&lt;tns:name>&lt;xsl:value-of select=&quot;ns0:name&quot;/>&lt;/tns:name>&lt;tns:value>&lt;xsl:copy-of select=&quot;ns0:value/@xsi:nil&quot;/>&lt;xsl:value-of select=&quot;ns0:value&quot;/>&lt;/tns:value>&lt;/tns:parameter>&lt;/xsl:for-each>&lt;/tns:parameterMap>&lt;/tns:createProcessInstanceInput>&lt;/xsl:if>&lt;/tns:ParseMapRequest_Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
