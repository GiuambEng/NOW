                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:ns0=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;selTRACC&quot;/>&lt;xsl:template name=&quot;ParseCasedataV1-input&quot; match=&quot;/&quot;>&lt;tns:xmlString>&lt;xsl:value-of select=&quot;concat('&amp;lt;?xml version=&amp;quot;1.0&amp;quot; encoding=&amp;quot;UTF-8&amp;quot;?>', '&amp;lt;casedataV1:RichiestaElement xmlns:xsi=&amp;quot;http://www.w3.org/2001/XMLSchema-instance&amp;quot; xmlns:casedataV1=&amp;quot;http://NOW.it.telecomitalia.it/casedata_v1&amp;quot; xsi:type=&amp;quot;casedataV1:Richiesta&amp;quot;>', substring-after(tib:substring-before-last($selTRACC/Record[1]/CONTENUTO_TRACC, &amp;quot;&amp;lt;/request:strutturaRichiesta>]]>&amp;quot;), 'xsi:type=&amp;quot;casedataV1:Richiesta&amp;quot;>'), '&amp;lt;/casedataV1:RichiestaElement>')&quot;/>&lt;/tns:xmlString>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
