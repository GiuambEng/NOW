            </wsdl:message>
            <wsdl:message name="get5XXFaultMessage1">
                <wsdl:part element="extns:server5XXError" name="serverError"/>
            </wsdl:message>
            <wsdl:portType name="trasformstatejpub"
                tibex:bw.rest.apipath="/trasformstatejpub?{account}={account}?{firstdate}={firstdate}?{lastdate}={lastdate}"
                tibex:bw.rest.basepath="trasformStateJPUB"
