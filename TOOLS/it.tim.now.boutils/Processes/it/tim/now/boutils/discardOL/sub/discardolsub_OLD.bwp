                                    sqlStatement="SELECT IDRICHIESTAOLO, ID_ANAG_CAUS, ID_ANAG_CAUS_DONOR, ID_ANAG_CAUS_DONATING,&#xa;ID_ANAG_CAUS_DPP_DONATING&#xa;FROM PPS_DISCARD_OL&#xa;WHERE ACCOUNT = ?&#xa;AND FLAG_DISCARD = 'N'&#xa;AND STATE IS NULL" xsi:type="jdbcPalette:JDBCQueryActivity">
