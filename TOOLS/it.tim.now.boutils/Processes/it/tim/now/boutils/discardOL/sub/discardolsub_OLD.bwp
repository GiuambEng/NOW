            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="e5325009-aef7-45cc-8aea-266f6e298bfe">
                <bpws:targets>
                    <bpws:target linkName="JDBCUpdate_PPS_DISCARD_OLToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($JDBCQuery_PPS_DISCARD_OL/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBCQuery_PPS_DISCARD_OL/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToScope" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdateToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LOG_FaultToJDBCUpdateKO" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdateKOToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ScopeToJDBCUpdateOK" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ScopeToLOG_Fault" tibex:linkType="ERROR"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="3372da6f-c6a4-43eb-849d-c828099fda73">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToScope"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="b10374e2-f49a-4cdb-84b4-1d31942026d0">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToGroupEnd"/>
                                    <bpws:target linkName="JDBCUpdateKOToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
