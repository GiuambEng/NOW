                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;Copy_1_Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/msgCode>&lt;loggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/loggerName>&lt;logLevel>&lt;xsl:value-of select=&quot;'Error'&quot;/>&lt;/logLevel>&lt;message>&lt;xsl:value-of select=&quot;$FaultDetails&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
