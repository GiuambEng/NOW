                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="29b37790-954c-4df8-b594-fdf2e13a331b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="ParseXmlToJDBCQueryNotifche"/>
                                    </bpws:targets>
                                    <bpws:sources>

                                    <bpws:source linkName="MapperToJDBCQueryNotifche"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificationRequest>&lt;xsl:copy-of select=&quot;$ParseXml/ns:RichiestaElement&quot;/>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$ParseXml/tns:TipologiaNotifica&quot;/>&lt;/tns:TipologiaNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns:TipologiaOLODestinatario) and string-length($ParseXml/tns:TipologiaOLODestinatario)>0&quot;>&lt;xsl:if test=&quot;$ParseXml/tns:TipologiaOLODestinatario&quot;>&lt;tns:TipologiaOLODestinatario>&lt;xsl:value-of select=&quot;$ParseXml/tns:TipologiaOLODestinatario&quot;/>&lt;/tns:TipologiaOLODestinatario>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TipologiaOLODestinatario>&lt;xsl:value-of select=&quot;&amp;quot;RECIPIENT&amp;quot;&quot;/>&lt;/tns:TipologiaOLODestinatario>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns:CodificaOLOAGCOMDestinatario) and string-length($ParseXml/tns:CodificaOLOAGCOMDestinatario)>0&quot;>&lt;xsl:if test=&quot;$ParseXml/tns:CodificaOLOAGCOMDestinatario&quot;>&lt;tns:CodificaOLOAGCOMDestinatario>&lt;xsl:value-of select=&quot;$ParseXml/tns:CodificaOLOAGCOMDestinatario&quot;/>&lt;/tns:CodificaOLOAGCOMDestinatario>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodificaOLOAGCOMDestinatario>&lt;xsl:value-of select=&quot;$ParseXml/ns:RichiestaElement/codificaOLOAGCOM&quot;/>&lt;/tns:CodificaOLOAGCOMDestinatario>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/tns:CodificaOLONOWDestinatario) and string-length($ParseXml/tns:CodificaOLONOWDestinatario)>0&quot;>&lt;xsl:if test=&quot;$ParseXml/tns:CodificaOLONOWDestinatario&quot;>&lt;tns:CodificaOLONOWDestinatario>&lt;xsl:value-of select=&quot;$ParseXml/tns:CodificaOLONOWDestinatario&quot;/>&lt;/tns:CodificaOLONOWDestinatario>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ParseXml/ns:RichiestaElement/codificaOLONOW&quot;>&lt;tns:CodificaOLONOWDestinatario>&lt;xsl:value-of select=&quot;$ParseXml/ns:RichiestaElement/codificaOLONOW&quot;/>&lt;/tns:CodificaOLONOWDestinatario>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:NotificationRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:NotificationManager_1="http://www.tim.com/NOW/xsd/NotificationManager/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
