                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcPropertyAPP"
                                    sqlStatement="SELECT ID_NOTF, COD_TIPOLG_NOTF, ID_EVENTO_ORDN_NOW_WHLS, (SELECT DESCR FROM TIPOLG_DESTNRIO_NOTF WHERE IDTPLG_DESTNRIO_NOTF = NOTF.IDTPLG_DESTNRIO_NOTF) AS TPLG_DESTNRIO_NOTF , CODFC_OLO_AGCOM, CODFC_OLO_NOW , DESCR_ERRORE  FROM RICH_ORDN_COMUNIC_NOTF NOTF WHERE ID_RICH_OLO = ? ORDER BY TIMSTP_CREAZIONE DESC &#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

