                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20190503144736PLT" xmlns:tns1="http://www.tim.it/NOW/boutils/schema/trasformStateJPUB/" version="2.0"&gt;&lt;xsl:param name="pvmErrore"/&gt;&lt;xsl:param name="pvmBonificati"/&gt;&lt;xsl:template name="getOut-input" match="/"&gt;&lt;tns:getResponse&gt;&lt;item&gt;&lt;tns1:Response&gt;&lt;tns1:Esito&gt;&lt;xsl:value-of select="concat('Bonifica Effettuta - Totali richieste bonificate: ', string($pvmBonificati) , ' Eventuali richieste in errore da verificare: ', $pvmErrore)"/&gt;&lt;/tns1:Esito&gt;&lt;/tns1:Response&gt;&lt;/item&gt;&lt;/tns:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20190503144736PLT&quot; xmlns:tns1=&quot;http://www.tim.it/NOW/boutils/schema/trasformStateJPUB/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;pvmErrore&quot;/>&#xa;    &lt;xsl:param name=&quot;pvmBonificati&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Response>&#xa;            &lt;tns1:Esito>&#xa;                &lt;xsl:value-of select=&quot;concat('Bonifica Effettuta - Totali richieste bonificate: ', string($pvmBonificati) , ' Eventuali richieste in errore da verificare: ', $pvmErrore)&quot;/>&#xa;            &lt;/tns1:Esito>&#xa;        &lt;/tns1:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
