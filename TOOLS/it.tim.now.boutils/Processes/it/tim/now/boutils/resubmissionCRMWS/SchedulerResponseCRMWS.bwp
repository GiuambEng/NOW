                                    sqlStatement="SELECT TRANSACTION_ID_NEW,IDRISORSA,ACCOUNT,&#xa;TIMSTP_INSMTO FROM PPS_RISOTTOMISSIONE_CRMWS &#xa;WHERE  STATO_ELAB='INVIATO'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
