        <schema elementFormDefault="unqualified"
            targetNamespace="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+a53c9558-9b46-466f-8e1e-84ba67636132"
            xmlns="http://www.w3.org/2001/XMLSchema"
            xmlns:Q1="http://schemas.tibco.com/bw/plugins/jdbc/5.0/jdbcExceptions"
            xmlns:Q2="http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions" xmlns:tns="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+a53c9558-9b46-466f-8e1e-84ba67636132">
            <import namespace="http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions"/>
