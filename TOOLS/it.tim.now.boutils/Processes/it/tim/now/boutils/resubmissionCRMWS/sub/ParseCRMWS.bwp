                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeULLLNA/&quot; xmlns:tns1=&quot;http://www.tim.it/NOW/boutils/schema/ParseCRMWS/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseULLLNA&quot;/>&lt;xsl:template name=&quot;MapperULLLNA-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns1:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;$ParseULLLNA/tns:SERVIZIO/tns:CODICEOLO&quot;/>&lt;/tns:CODICEOLO>&lt;tns:DESCOLO>&lt;xsl:value-of select=&quot;$ParseULLLNA/tns:SERVIZIO/tns:DESCOLO&quot;/>&lt;/tns:DESCOLO>&lt;xsl:for-each select=&quot;$ParseULLLNA/tns:SERVIZIO/tns:ULLLNA&quot;>&lt;tns:ULLLNA>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;tns:SERVIZIO&quot;/>&lt;/tns:SERVIZIO>&lt;xsl:if test=&quot;exists(tns:ATTIVAZIONE)&quot;>&lt;xsl:copy-of select=&quot;tns:ATTIVAZIONE&quot;/>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(tns:VARIAZIONE)&quot;>&lt;tns:VARIAZIONE>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;tns:VARIAZIONE/tns:CODICEORDINEOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;tns:VARIAZIONE/tns:CODICE_ORDINE_TI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;tns:VARIAZIONE/tns:CONTRATTO&quot;/>&lt;/tn