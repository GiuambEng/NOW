                        <element maxOccurs="1" minOccurs="1"
                            name="ID_ASSET" nillable="true" type="decimal"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="ID_ORDINE" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="ACCOUNT" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="TRANSACTION_ID" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="ServerTimeZone" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="timeout" type="long"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+1050e5ac-fd10-48b3-a892-455cf3b23bba+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+1050e5ac-fd10-48b3-a892-455cf3b23bba+input">
            <element name="jdbcUpdateActivityInput">
                <complexType>
                    <sequence>
                        <element maxOccurs="1" minOccurs="1"
