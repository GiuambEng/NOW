                        <element maxOccurs="1" minOccurs="1"
                            name="TIMSTP_AGGTO" nillable="true" type="dateTime"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="ACCOUNT" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
