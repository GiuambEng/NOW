                                tibex:faultDetailsVar="FaultDetails"
                                tibex:faultNameVar="FaultName" tibex:xpdlId="6e775873-cbad-4767-bd70-bc74daea6ad4">
                                <bpws:scope name="scope2">
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="AssignToLog" tibex:linkType="SUCCESS"/>
