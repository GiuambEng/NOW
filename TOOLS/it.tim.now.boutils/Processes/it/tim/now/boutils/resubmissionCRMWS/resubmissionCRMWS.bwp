                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20180813172951PLT" xmlns:tns1="http://www.tim.it/NOW/boutils/schema/resubmissionCRMWS/" version="2.0"&gt;&lt;xsl:param name="Error"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:getResponse&gt;&lt;item&gt;&lt;tns1:Output&gt;&lt;tns1:Esito&gt;&lt;xsl:value-of select="concat('KO','[]',$Error)"/&gt;&lt;/tns1:Esito&gt;&lt;/tns1:Output&gt;&lt;/item&gt;&lt;/tns:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
