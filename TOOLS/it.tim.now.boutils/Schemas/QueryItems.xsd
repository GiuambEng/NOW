<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/QueryItems" xmlns:tns="http://www.example.org/QueryItems" elementFormDefault="qualified">

    <element name="Record">
    	<complexType>
    		<sequence>
    			<element name="Row" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="WORKITEMID" type="string"></element>
    						<element name="VERSION" type="string"></element>
    						<element name="ACTION" type="string"></element>
    						<element name="CAUSALE" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>