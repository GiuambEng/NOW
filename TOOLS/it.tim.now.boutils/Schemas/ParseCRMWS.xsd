<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.it/NOW/boutils/schema/ParseCRMWS/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.it/NOW/boutils/schema/ParseCRMWS/">

    <element name="Request">
    	<complexType>
    		<sequence>
    			<element name="Messaggio" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="NextVal" type="int" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="OldTransactionID" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="processTransaction" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="CodeServizio" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Response">
    	<complexType>
    		<sequence>
    			<element name="Messaggio" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="NewTransaction" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>