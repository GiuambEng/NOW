<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:re="http://www.example.org/RunOutWiResponse" targetNamespace="http://www.tim.it/NOW/boutils/schema/restartolGenericSchema/" xmlns:tns="http://www.tim.it/NOW/boutils/schema/restartolGenericSchema/" elementFormDefault="qualified">
	<import namespace="http://www.example.org/RunOutWiResponse" schemaLocation="RunOutWiResponse.xsd"/>
	<element name="restartolGetParameters_Input">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="account" type="string"/>
				<element name="IdRichiestaOLO" type="string" minOccurs="1" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<element name="ParseMapRequest_Input">
		<complexType>
			<sequence>
				<element name="account" type="string" minOccurs="1" maxOccurs="1"/>
				<element name="IdRichiestaOLO" type="string" minOccurs="1" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="ParseMapRequest_Output">
		<complexType>
			<sequence>
				<element name="localRequest" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="idRichiestaAcquisizione" type="int" minOccurs="0" maxOccurs="1"/>
				<element ref="tns:createProcessInstanceInput" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="BackupLocalRequest_Input">
		<complexType>
			<sequence>
				<element name="account" type="string" minOccurs="1" maxOccurs="1"/>
				<element name="IdRichiestaOLO" type="string" minOccurs="1" maxOccurs="1"/>
				<element name="localRequest" type="string" minOccurs="1" maxOccurs="1"/>
				<element name="codiceOrdineTI" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="DeleteRequestData_Input">
		<complexType>
			<sequence>
				<element name="account" type="string" minOccurs="1" maxOccurs="1"/>
				<element name="IdRichiestaOLO" type="string" minOccurs="1" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="DeleteRequestData_Output">
		<complexType>
			<sequence>
				<element name="WarningMessage" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="Update_PPS_RESTARTOL_Input">
		<complexType>
			<sequence>
				<element name="account" type="string" minOccurs="1" maxOccurs="1"/>
				<element name="IdRichiestaOLO" type="string" minOccurs="1" maxOccurs="1"/>
				<element name="state" type="string" minOccurs="1" maxOccurs="1"/>
				<element name="errorDescr" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="IdRichiestaOLO_NEW" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="Update_PPS_RESTARTOL_Output">
		<complexType>
			<sequence>
				<element name="noOfUpdates" type="integer" minOccurs="1" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="RestartOL_Output">
		<complexType>
			<sequence>
				<element ref="re:Response" minOccurs="1" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="createProcessInstanceInput">
		<complexType>
			<sequence>
				<element name="processQName" type="tns:QualifiedProcessName"/>
				<element name="operationName" type="string"/>
				<element name="options" type="tns:CreateProcessInstanceOptions"/>
				<element name="parameterMap">
					<complexType>
						<sequence>
							<element maxOccurs="unbounded" minOccurs="0" name="parameter" type="tns:NameValuePair"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<complexType name="NameValuePair">
		<sequence>
			<element name="name" type="string"/>
			<element name="value" nillable="true" type="string"/>
		</sequence>
	</complexType>
	<complexType name="QualifiedProcessName">
		<sequence>
			<element minOccurs="0" name="moduleName" nillable="true" type="string"/>
			<element minOccurs="0" name="processName" nillable="true" type="string"/>
			<element minOccurs="0" name="version" nillable="true" type="string"/>
		</sequence>
	</complexType>
	<complexType name="CreateProcessInstanceOptions">
		<sequence>
			<element minOccurs="0" name="priority" type="short"/>
		</sequence>
	</complexType>
</schema>