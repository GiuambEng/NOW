<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.it/NOW/boutils/schema/resubmissionCRMWS/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.it/NOW/boutils/schema/resubmissionCRMWS/">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="Account" type="string" maxOccurs="1"
    				minOccurs="1">
    			</element>
    			<element name="Transaction" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>