<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:pref="http://NOW.it.telecomitalia.it/casedata" xmlns:pref1="http://www.tim.com/NOW/xsd/NotificationManager/" xmlns:tns="http://www.tim.com/NOW/xsd/GenNotf" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/GenNotf">


	<element name="GenNotfInput">
		<complexType>
			<sequence>
				<element name="Account" type="string" />
				<element name="DatiNotifica" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="IDRichiestaOLO"
								type="string" />
							<element name="TipologiaNotifica"
								type="string" />
							<element name="IDTracciamento"
								type="string" />
							<element name="TipologiaOloDestinatario"
								type="string" />
							<element maxOccurs="1" minOccurs="0"
								name="CodificaOloAGCOMDestinatario" type="string" />
							<element maxOccurs="1" minOccurs="0"
								name="UpdateOrDuplicateTracciamento" type="string" />
							<element name="Identificativo"
								type="integer" />
							<element name="COMP_DONATING_DPP_DONATING"
								type="string" />
						</sequence>
					</complexType>
				</element>
				<element name="TransactionID" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
	<element name="GenNotfOutput">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:esito"/>
			</sequence>
		</complexType>
	</element>
	<element name="GenNotfFault" type="tns:esito"/>

	<complexType name="output">
		<sequence>
			<element name="Codice" type="string"/>
			<element minOccurs="0" name="Descrizione" type="string"/>
		</sequence>
	</complexType>


	<complexType name="esito">
		<sequence>
			<element name="IDRichiestaOLO" type="string"/>
			<element name="Esito" type="tns:output"/>
		</sequence>
	</complexType>



</schema>
