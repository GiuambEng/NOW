l:if>&lt;xsl:if test=&quot;$RecuperaDatiAsset/Record[1]/CODICEISTATCOMUNE&quot;>&lt;ISTATComune>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/CODICEISTATCOMUNE&quot;/>&lt;/ISTATComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperaDatiAsset/Record[1]/LOCALITA&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/LOCALITA&quot;/>&lt;/localita>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($RecuperaDatiAsset/Record[1]/IDOFFERTA)&quot;/>&lt;/IDOfferta>&lt;xsl:if test=&quot;$Start/tns:DRO&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;$Start/tns:DRO&quot;/>&lt;/DRO>&lt;/xsl:if>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$Start/tns:CodificaOLOAGCOMold&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;xsl:if test=&quot;$RecuperaDatiAsset/Record[1]/NUMEROTELEFONICO&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/NUMEROTELEFONICO&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Start/tns:CodificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOMRic>&lt;codiceRisorsaDonating>&lt;xsl:value-of select=&quot;$Start/tns:idRisorsa&quot;/>&lt;/codiceRisorsaDonating>&lt;cowCodeOLO>&lt;xsl:value-of select=&quot;$Start/tns:CodificaOLOAGCOMold&quot;/>&lt;/cowCodeOLO>&lt;assetTarget>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/tns:idAsset&quot;/>&lt;/IDAsset>&lt;flagInLavorazione>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/flagInLavorazione>&lt;/assetTarget>&lt;xsl:if test=&quot;$RecuperaDatiAsset/Record[1]/OPERATORERETE&quot;>&lt;operatoreRete>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/OPERATORERETE&quot;/>&lt;/operatoreRete>&lt;/xsl:if>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;ACCORPAMENTOOLO&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
