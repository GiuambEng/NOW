                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select ass.IDRISORSA, att.NOMEATTRIBUTO, att.VALOREATTRIBUTO, att.DTTGLSST_TTRBTIDTTGLISST_BDSID&#xa;from APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET dett, APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST att , APPUSER.bds_1_casedata_asset ass&#xa;where att.DTTGLSST_TTRBTIDTTGLISST_BDSID=dett.BDS_ID and dett.asset_dettaglioasset_bdsid=ass.bds_id and dett.statodettaglioasset = 'ATTIVO' &#xa;and dett.NOMECOMPONENTE = 'NUMBERPORTABILITY' &#xa;and ass.OFFERTA = 'NP' &#xa;and ass.NUMEROTELEFONICO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
