            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1571817541190&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoOLONumerico&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectSTRUTTURARICH&quot;/>&lt;xsl:param name=&quot;RecuperaDatiAsset&quot;/>&lt;xsl:param name=&quot;RecuperaDatiCliente&quot;/>&lt;xsl:param name=&quot;RecuperaReferenti1&quot;/>&lt;xsl:param name=&quot;RecuperaReferenti2&quot;/>&lt;xsl:param name=&quot;SelectIDSLUCO&quot;/>&lt;xsl:param name=&quot;SelectIDULLCO&quot;/>&lt;xsl:param name=&quot;RecuperaDatiNP&quot;/>&lt;xsl:template name=&quot;localRequest&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;xsl:variable name=&quot;codiceOrdineOloVar&quot; select=&quot;substring(concat(&amp;quot;ACC-&amp;quot;, string(current-dateTime())), 1, 30)&quot;/>&lt;xsl:variable name=&quot;idRisorsa&quot; select=&quot;if(string-length($RecuperaDatiAsset/Record[1]/IDRISORSANOW)>0 and $RecuperaDatiAsset/Record[1]/IDRISORSANOW != $RecuperaDatiAsset/Record[1]/IDRISORSA and $RecuperaDatiAsset/Record[1]/OFFERTA = (&amp;quot;VULAFTTH&amp;quot;,&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;,&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;)) then ($Start/tns:idRisorsa) else if(string-length($Start/tns:Offerta)>17 and substring($Start/tns:Offerta, 13, 4) = &amp;quot;SIMM&amp;quot;) then ($Start/tns:idRisorsa) else (if(contains($Start/tns:idRisorsa, &amp;quot;W&amp;quot;)) then concat(substring($Start/tns:idRisorsa, 1,string-length($Start/tns:idRisorsa)-2), tib:pad-front(string((xsd:int(substring-after($Start/tns:idRisorsa, &amp;quot;W&amp;quot;))+2)),2,&amp;quot;0&amp;quot;)) else concat($Start/tns:idRisorsa, &amp;quot; W00&amp;quot;))&quot;/>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/OPERATORE&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;INTERNAL&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;$SelectSTRUTTURARICH/Record[1]/STRUTTURA_RICH&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$idRisorsa&quot;/>&lt;/IDRisorsa>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:CodificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$RecuperoOLONumerico/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOLONumerico/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$codiceOrdineOloVar&quot;/>&lt;/codiceOrdineOLO>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&lt;/dataInvioRichiesta>&lt;ordine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&