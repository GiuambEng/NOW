                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1571817541190&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperoOLONumerico&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectSTRUTTURARICH&quot;/>&lt;xsl:param name=&quot;RecuperaDatiAsset&quot;/>&lt;xsl:param name=&quot;RecuperaDatiCliente&quot;/>&lt;xsl:param name=&quot;RecuperaReferenti1&quot;/>&lt;xsl:param name=&quot;RecuperaReferenti2&quot;/>&lt;xsl:param name=&quot;SelectIDSLUCO&quot;/>&lt;xsl:param name=&quot;SelectIDULLCO&quot;/>&lt;xsl:param name=&quot;RecuperaDatiNP&quot;/>&lt;xsl:template name=&quot;localRequest&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;xsl:variable name=&quot;codiceOrdineOloVar&quot; select=&quot;substring(concat(&amp;quot;ACC-&amp;quot;, string(current-dateTime())), 1, 30)&quot;/>&lt;xsl:variable name=&quot;idRisorsa&quot; select=&quot;if(string-length($RecuperaDatiAsset/Record[1]/IDRISORSANOW)>0 and $RecuperaDatiAsset/Record[1]/IDRISORSANOW != $RecuperaDatiAsset/Record[1]/IDRISORSA and $RecuperaDatiAsset/Record[1]/OFFERTA = (&amp;quot;VULAFTTH&amp;quot;,&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;,&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;)) then ($Start/tns:idRisorsa) else if(string-length($Start/tns:Offerta)>17 and substring($Start/tns:Offerta, 13, 4) = &amp;quot;SIMM&amp;quot;) then ($Start/tns:idRisorsa) else (if(contains($Start/tns:idRisorsa, &amp;quot;W&amp;quot;)) then concat(substring($Start/tns:idRisorsa, 1,string-length($Start/tns:idRisorsa)-2), tib:pad-front(string((xsd:int(substring-after($Start/tns:idRisorsa, &amp;quot;W&amp;quot;))+2)),2,&amp;quot;0&amp;quot;)) else concat($Start/tns:idRisorsa, &amp;quot; W00&amp;quot;))&quot;/>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/OPERATORE&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;INTERNAL&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;$SelectSTRUTTURARICH/Record[1]/STRUTTURA_RICH&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$idRisorsa&quot;/>&lt;/IDRisorsa>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:CodificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$RecuperoOLONumerico/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOLONumerico/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$codiceOrdineOloVar&quot;/>&lt;/codiceOrdineOLO>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&lt;/dataInvioRichiesta>&lt;ordine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;xsl:if test=&quot;$RecuperaDatiCliente/Record[1]/COGNOMERAGIONESOCIALE&quot;>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$RecuperaDatiCliente/Record[1]/COGNOMERAGIONESOCIALE&quot;/>&lt;/cognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperaDatiCliente/Record[1]/NOME&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$RecuperaDatiCliente/Record[1]/NOME&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperaDatiCliente/Record[1]/CODICEFISCALE&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$RecuperaDatiCliente/Record[1]/CODICEFISCALE&quot;/>&lt;/CF>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperaDatiCliente/Record[1]/PARTITAIVA&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;$RecuperaDatiCliente/Record[1]/PARTITAIVA&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns:Offerta, 'SLU') and string-length($Start/tns:CLLI)>0&quot;>&lt;xsl:if test=&quot;$SelectIDSLUCO/Record[1]/IDSLUCO&quot;>&lt;IDSLUCo>&lt;xsl:value-of select=&quot;$SelectIDSLUCO/Record[1]/IDSLUCO&quot;/>&lt;/IDSLUCo>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(contains($Start/tns:Offerta, 'ULL') or contains($Start/tns:Offerta, 'SHA')) and string-length($Start/tns:CLLI)>0&quot;>&lt;xsl:if test=&quot;$SelectIDULLCO/Record[1]/IDULLCO&quot;>&lt;IDULLCo>&lt;xsl:value-of select=&quot;$SelectIDULLCO/Record[1]/IDULLCO&quot;/>&lt;/IDULLCo>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$SelectSTRUTTURARICH/Record[1]/STRUTTURA_RICH = &amp;quot;REGOLATORIO&amp;quot;&quot;>&lt;xsl:if test=&quot;$Start/tns:CLLI&quot;>&lt;CLLI>&lt;xsl:value-of select=&quot;$Start/tns:CLLI&quot;/>&lt;/CLLI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$RecuperaDatiAsset/Record[1]/CLLI&quot;>&lt;CLLI>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/CLLI&quot;/>&lt;/CLLI>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoOLONumerico/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$codiceOrdineOloVar&quot;/>&lt;/codiceOrdineOLO>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:CodificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$idRisorsa&quot;/>&lt;/IDRisorsa>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;ACCORPAMENTOOLO&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;xsl:if test=&quot;$RecuperaDatiAsset/Record[1]/OPERATORE&quot;>&lt;operatore>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/OPERATORE&quot;/>&lt;/operatore>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperaDatiAsset/Record[1]/RO&quot;>&lt;RO>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/RO&quot;/>&lt;/RO>&lt;/xsl:if>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;xsl:for-each-group select=&quot;$RecuperaDatiAsset/Record/DTTGLSST_TTRBTIDTTGLISST_BDSID&quot; group-by=&quot;.&quot;>&lt;dettaglioordine>&lt;xsl:variable name=&quot;dettOrdineBDSID&quot; select=&quot;.&quot;/>&lt;xsl:variable name=&quot;currentComponente&quot; select=&quot;../NOMECOMPONENTE&quot;/>&lt;xsl:variable name=&quot;currentDettOrdine&quot; select=&quot;xsd:int(position())&quot;/>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$currentDettOrdine&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[1]/OPERATORE&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$idRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;../NOMECOMPONENTE&quot;/>&lt;/nomeComponente>&lt;integrationID>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/integrationID>&lt;xsl:for-each select=&quot;current-group()&quot;>&lt;attributiDettaglioOrdine>&lt;xsl:variable name=&quot;currentAttributo&quot; select=&quot;../NOMEATTRIBUTO&quot;/>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;abc&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$currentDettOrdine&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:Operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[NOMEATTRIBUTO = $currentAttributo and DTTGLSST_TTRBTIDTTGLISST_BDSID = $dettOrdineBDSID]/NOMEATTRIBUTO&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;$currentAttributo = 'IDULLCO' and $currentComponente = 'ACCESSOSHA'&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$SelectIDULLCO/Record[1]/IDULLCO&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$RecuperaDatiAsset/Record[NOMEATTRIBUTO = $currentAttributo and DTTGLSST_TTRBTIDTTGLISST_BDSID = $dettOrdineBDSID]/VALOREATTRIBUTO&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:for-each>&lt;progressivo>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivo>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$idRisorsa&quot;/>&lt;/IDRisorsaNOW>&lt;azione>&lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&lt;/azione>&lt;/dettaglioordine>&lt;/xsl:for-each-group>&lt;xsl:ch