                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dcecdaa5-fddd-4b6e-94eb-8843c6083074+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SelectMIG_OLO_ASSET&quot;/>&lt;xsl:param name=&quot;SelectASSET&quot;/>&lt;xsl:param name=&quot;WorkingDate&quot;/>&lt;xsl:template name=&quot;SelectCONTRATTO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectASSET/Record[1]/OFFERTA)&quot;>&lt;xsl:value-of select=&quot;$SelectASSET/Record[1]/OFFERTA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OFFERTA>&lt;DATE1>&lt;xsl:value-of select=&quot;$WorkingDate/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DATE1>&lt;DATE2>&lt;xsl:value-of select=&quot;$WorkingDate/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DATE2>&lt;DATE3>&lt;xsl:value-of select=&quot;$WorkingDate/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DATE3>&lt;DATE4>&lt;xsl:value-of select=&quot;$WorkingDate/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/DATE4>&lt;OLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectMIG_OLO_ASSET/Record[$index]/COD_OLO_AGCOM)&quot;>&lt;xsl:value-of select=&quot;$SelectMIG_OLO_ASSET/Record[$index]/COD_OLO_AGCOM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OLOAGCOM>&lt;DESCRIPTION>&lt;xsl:value-of select=&quot;&amp;quot;Active&amp;quot;&quot;/>&lt;/DESCRIPTION>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
