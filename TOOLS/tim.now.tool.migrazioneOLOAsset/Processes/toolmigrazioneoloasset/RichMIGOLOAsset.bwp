                                    sqlStatement="select att.valoreattributo AS SVLANCODE&#xa;from APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET dett, APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST att , APPUSER.bds_1_casedata_asset ass&#xa;where att.DTTGLSST_TTRBTIDTTGLISST_BDSID=dett.BDS_ID and dett.asset_dettaglioasset_bdsid=ass.bds_id and ass.idasset = ? and dett.statodettaglioasset = 'ATTIVO' and att.nomeattributo = 'SVLANCODE'" xsi:type="jdbcPalette:JDBCQueryActivity">

