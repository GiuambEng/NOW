                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dcecdaa5-fddd-4b6e-94eb-8843c6083074+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;WorkingDate.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectMIG_OLO_ASSET&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectASSET&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectCONTRATTO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectASSET/Record[1]/OFFERTA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$SelectASSET/Record[1]/OFFERTA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;            &lt;DATE1>&#xa;                &lt;xsl:value-of select=&quot;$WorkingDate.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATE1>&#xa;            &lt;DATE2>&#xa;                &lt;xsl:value-of select=&quot;$WorkingDate.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATE2>&#xa;            &lt;DATE3>&#xa;                &lt;xsl:value-of select=&quot;$WorkingDate.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATE3>&#xa;            &lt;DATE4>&#xa;                &lt;xsl:value-of select=&quot;$WorkingDate.parameters/tns1:outputDate&quot;/>&#xa;            &lt;/DATE4>&#xa;            &lt;OLOAGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectMIG_OLO_ASSET/Record[$index]/COD_OLO_AGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$SelectMIG_OLO_ASSET/Record[$index]/COD_OLO_AGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OLOAGCOM>&#xa;            &lt;DESCRIPTION>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Active&amp;quot;&quot;/>&#xa;            &lt;/DESCRIPTION>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CON.ID_CONTRATTO&#xa;FROM CONTRATTO CON, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER, TIPOLG_STATO_CONTRATTO CONTR&#xa;WHERE CAT.ID_OFFERTA = OFFER.ID_OFFERTA &#xa;AND OFFER.NOME_OFFERTA_ESTERNA = ? AND OFFER.PROVENIENZA = 'BPM'&#xa;AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO AND (CAT.DATAFI_ASSOCZ_VALID > ? OR CAT.DATAFI_ASSOCZ_VALID = NULL) &#xa;AND CAT.DATAINZ_ASSOCZ_VALID &lt; ? AND CON.DATAFI_VALID > ? AND CON.DATAINZ_VALID &lt; ? &#xa;AND CON.CODFC_OLO_AGCOM = ? AND CON.ID_STATO_CONTRATTO = CONTR.ID_STATO_CONTRATTO&#xa;AND CONTR.DESCRIPTION = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATE1"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATE2"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATE3"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATE4"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OLOAGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIPTION"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;SelectCONTRATTO&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SelectMIG_OLO_ASSET&quot;/>&lt;xsl:template name=&quot;LogSelectCONTRATTO-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.tool.migrazioneOLOAsset.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;RichMIGOLOAsset&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;insert&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$SelectMIG_OLO_ASSET/Record[$index]/ID_RISORSA&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$SelectMIG_OLO_ASSET/Record[$index]/ID_RISORSA&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Estratti record - SelectCONTRATTO: &amp;quot;, tib:concat-sequence-format($SelectCONTRATTO/Record, &amp;quot;|&amp;quot;, true()))&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogSelectCONTRATTO-input"
                                    name="LogSelectCONTRATTO"
                                    tibex:xpdlId="66a58f38-cded-465a-9678-6a3754d990d1"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
