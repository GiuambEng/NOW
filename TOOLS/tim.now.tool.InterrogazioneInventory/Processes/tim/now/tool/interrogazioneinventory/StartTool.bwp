                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE PPS_NOW_TO_UNI_VRFC_DN_NO_FILE&#xa;SET CONTENUTO_RESPONSE=?, TIMESTAMP_RISPOSTA=SYSDATE, ID_STATO_ELAB_STAG=(SELECT ID_STATO_ELAB_STAG&#xa;FROM TIPOLG_STATO_ELAB_STAG&#xa;WHERE DESCR = 'RECORD ELABORATO'), TIPO_NUMERO=?, TIPO_SERVIZIO=?, BANDA_SERVIZIO=?, TIPO_LINEA_ORDINE=?, STRUTTURA_LINEA_ORDINE=?, NUMERO_RETRY=?&#xa;WHERE NUMERO_TELEFONICO=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_RESPONSE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_NUMERO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_SERVIZIO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="BANDA_SERVIZIO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_LINEA_ORDINE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURA_LINEA_ORDINE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_RETRY"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERO_TELEFONICO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
