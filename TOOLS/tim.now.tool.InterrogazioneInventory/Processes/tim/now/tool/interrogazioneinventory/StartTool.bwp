.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero!=&amp;quot;NATIVO VOIP IMS&amp;quot; and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO!=&amp;quot;IMS&amp;quot;&quot;>&#xa;                    &lt;STRUTTURA_LINEA_ORDINE>&#xa;                        &lt;xsl:value-of select=&quot;'Simplex'&quot;/>&#xa;                    &lt;/STRUTTURA_LINEA_ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio='RTG' and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero=&amp;quot;NATIVO VOIP IMS&amp;quot; and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO=&amp;quot;IMS&amp;quot;&quot;>&#xa;                    &lt;STRUTTURA_LINEA_ORDINE>&#xa;                        &lt;xsl:value-of select=&quot;'Simplex'&quot;/>&#xa;                    &lt;/STRUTTURA_LINEA_ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero!=&amp;quot;NATIVO VOIP IMS&amp;quot; and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio=('CAPOSERIE','LINEA PBX') and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO='SX'&quot;>&#xa;                    &lt;STRUTTURA_LINEA_ORDINE>&#xa;                        &lt;xsl:value-of select=&quot;'PBX'&quot;/>&#xa;                    &lt;/STRUTTURA_LINEA_ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero!=&amp;quot;NATIVO VOIP IMS&amp;quot; and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio=('RADICALE','SPE','SPU') and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO='SX'&quot;>&#xa;                    &lt;STRUTTURA_LINEA_ORDINE>&#xa;                        &lt;xsl:value-of select=&quot;'GNR'&quot;/>&#xa;                    &lt;/STRUTTURA_LINEA_ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero!=&amp;quot;NATIVO VOIP IMS&amp;quot; and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio='ISDN BMO'&quot;>&#xa;                    &lt;STRUTTURA_LINEA_ORDINE>&#xa;                        &lt;xsl:value-of select=&quot;'BRA MONO'&quot;/>&#xa;                    &lt;/STRUTTURA_LINEA_ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero!=&amp;quot;NATIVO VOIP IMS&amp;quot; and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio='ISDN BMU'&quot;>&#xa;                    &lt;STRUTTURA_LINEA_ORDINE>&#xa;                        &lt;xsl:value-of select=&quot;'BRA MULTI'&quot;/>&#xa;                    &lt;/STRUTTURA_LINEA_ORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero!=&amp;quot;NATIVO VOIP IMS&amp;quot; and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio=('CAPOSERIE','LINEA PBX') and $InvokeUnica.parameters/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO='ISDN BRA'&quot;>&#xa;                    &lt;STRUTTURA_LINEA_ORDINE>&#xa;                        &lt;xsl:value-of select=&quot;'PBX'&quot;/>&#xa;            