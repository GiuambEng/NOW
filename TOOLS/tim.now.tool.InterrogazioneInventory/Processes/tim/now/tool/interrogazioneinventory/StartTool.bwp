                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+def3eeec-4c98-43bc-9b29-85b826690c6d+input&quot; xmlns:impl=&quot;http://getdatiinventory.unicac.telecomitalia.it&quot; xmlns:tns1=&quot;http://types.getdatiinventory.unicac.telecomitalia.it&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeUnica.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;MapResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;CONTENUTO_RESPONSE>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($MapResponse/impl:ReperimentoServizioReturn)&quot;/>&#xa;            &lt;/CONTENUTO_RESPONSE>&#xa;            &lt;TIPO_NUMERO>&#xa;                &lt;xsl:copy-of select=&quot;$MapResponse/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero/@xsi:nil&quot;/>&#xa;                &lt;xsl:value-of select=&quot;$MapResponse/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero&quot;/>&#xa;            &lt;/TIPO_NUMERO>&#xa;            &lt;TIPO_SERVIZIO>&#xa;                &lt;xsl:copy-of select=&quot;$MapResponse/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio/@xsi:nil&quot;/>&#xa;                &lt;xsl:value-of select=&quot;$MapResponse/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio&quot;/>&#xa;            &lt;/TIPO_SERVIZIO>&#xa;            &lt;BANDA_SERVIZIO>&#xa;                &lt;xsl:copy-of select=&quot;$MapResponse/impl:Reperime