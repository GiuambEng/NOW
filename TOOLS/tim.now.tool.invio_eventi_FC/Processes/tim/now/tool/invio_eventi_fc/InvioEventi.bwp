                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectEVENTI_INLAV&quot;/>&lt;xsl:param name=&quot;SelectNOTIFICA_DTU&quot;/>&lt;xsl:param name=&quot;indexOL&quot;/>&lt;xsl:param name=&quot;indexNOTF&quot;/>&lt;xsl:param name=&quot;ParseRICH&quot;/>&lt;xsl:template name=&quot;BPM2FFRequest-input&quot; match=&quot;/&quot;>&lt;tns:BPM2FFRequest>&lt;xsl:choose>&lt;xsl:when test=&quot;$SelectNOTIFICA_DTU/Record[$indexNOTF]/DESCR_EVENTO = &amp;quot;NF_ESPLETAMENTO&amp;quot; and string-length($SelectEVENTI_INLAV/Record[$indexOL]/ID_ORDINE_WHS_ESP_CESSAZIONETX)>0&quot;>&lt;tns:TipoRiscontro>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE_TX&amp;quot;&quot;/>&lt;/tns:TipoRiscontro>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectNOTIFICA_DTU/Record[$indexNOTF]/DESCR_EVENTO = &amp;quot;NF_ESPLETAMENTO&amp;quot; and string-length($SelectEVENTI_INLAV/Record[$indexOL]/ID_ORDINE_WHS_ESP_MIGRAZINTRA)>0&quot;>&lt;tns:TipoRiscontro>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZ_INTRA&amp;quot;&quot;/>&lt;/tns:TipoRiscontro>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectNOTIFICA_DTU/Record[$indexNOTF]/DESCR_EVENTO = &amp;quot;NF_ESPLETAMENTO&amp;quot; and string-length($SelectEVENTI_INLAV/Record[$indexOL]/ID_ORDINE_WHS_ESPL_CESSAZIONE)>0&quot;>&lt;tns:TipoRiscontro>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/tns:TipoRiscontro>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectNOTIFICA_DTU/Record[$indexNOTF]/DESCR_EVENTO = &amp;quot;NF_ESPLETAMENTO&amp;quot; and string-length($SelectEVENTI_INLAV/Record[$indexOL]/ID_ORDINE_WHS_ESPL_IDRISORSA)>0&quot;>&lt;tns:TipoRiscontro>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&lt;/tns:TipoRiscon