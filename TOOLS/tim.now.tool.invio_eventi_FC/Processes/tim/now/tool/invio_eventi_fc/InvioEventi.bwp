                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT distinct(EVO.ID_EVENTO_ORDN_NOW_WHLS), EVD.CAUS_ESITO, EVD.ESITO, EVD.TRANSACTION_ID, TIP.DESCR_EVENTO&#xa;FROM EVENTO_DTU EVD, EVENTO_ORDN_NOW_WHLS EVO, TIPOLG_EVENTO TIP&#xa;WHERE EVD.ID_EVENTO_ORDN_NOW_WHLS = EVO.ID_EVENTO_ORDN_NOW_WHLS&#xa;AND TIP.IDTPLG_EVENTO = EVO.IDTPLG_EVENTO&#xa;AND EVO.ID_EVENTO_ORDN_NOW_WHLS IN(?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
