                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+feceaaf1-0886-4848-96ce-0ecde4d372bd+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="EstrazioneJ3-input"
                    name="EstrazioneJ3" outputVariable="EstrazioneJ3"
                    tibex:xpdlId="feceaaf1-0886-4848-96ce-0ecde4d372bd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEstrazioneJ3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EstrazioneJ3ToCallProcess"/>
                        <bpws:source
                            linkName="EstrazioneJ3ToCallProcess1"
                            tibex:faultDetailsVar="EstrazioneJ3" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+feceaaf1-0886-4848-96ce-0ecde4d372bd+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_RISORSA_IN_ERRORE, ID_ORDINE_COMPOSTO,COD_ID_ORDN&#xd;&#xa;FROM (SELECT S.ID_RISORSA_IN_ERRORE,S.ID_ORDINE_COMPOSTO,S.COD_ID_ORDN,S.TIMSTP_RICH,&#xd;&#xa;             ROW_NUMBER() OVER (PARTITION BY S.ID_RISORSA_IN_ERRORE,S.ID_ORDINE_COMPOSTO,S.COD_ID_ORDN ORDER BY S.TIMSTP_RICH DESC) RN&#xd;&#xa;      FROM EVENTO_JPUB E,STAG_JPUB_IN S &#xd;&#xa;      WHERE E.STRUTTURA_OFFERTA IS NOT NULL &#xd;&#xa;      AND E.NUMERO_TENTATIVI>0&#xd;&#xa;      AND E.STRUTTURA_OFFERTA='REGOLATORIO' &#xd;&#xa;      AND E.IDTPLG_STATO_EVENTO_JPUB=4 AND E.TIPO_AZIONE='2'&#xd;&#xa;      AND E.CONTENUTO_XML IS NOT NULL&#xd;&#xa;      AND E.ID_ORDINE_COMPOSTO=S.ID_ORDINE_COMPOSTO AND  S.COD_SCARTO='3' &#xd;&#xa;      AND S.ID_ORDINE_COMPOSTO NOT IN (SELECT ID_ORDINE_COMPOSTO FROM ESTRAZIONI_JPUB WHERE TOOL='INVIOJ3'))&#xd;&#xa;WHERE RN = 1" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_RISORSA_IN_ERRORE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_ORDINE_COMPOSTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_ID_ORDN"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;EstrazioneJ3&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.tool.billing.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'EstrazioneJ3'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'EstrazioneJ3'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'EstrazioneJ3'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($EstrazioneJ3/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('EstrazioneJ3',tib:render-xml($EstrazioneJ3,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'EstrazioneJ3: Record non trovati'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogEstrazioneJ3-input"
                    name="LogEstrazioneJ3"
                    tibex:xpdlId="10a976f4-a748-4a77-bf6f-67596c2d1ed7"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EstrazioneJ3ToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogEstrazioneJ3ToJDBCUpdate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($EstrazioneJ3/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
