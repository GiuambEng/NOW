                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="ID_ORDINE_COMPOSTO"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="COD_ID_ORDN"
                                    nillable="false" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
