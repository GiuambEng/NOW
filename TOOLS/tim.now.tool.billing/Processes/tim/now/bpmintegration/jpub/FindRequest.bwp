            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:BusinessDataServices"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://services.bds.tibco.com/BusinessDataServices_1.2.0"/>
        </wsdl:definitions>
    </tibex:Types>
