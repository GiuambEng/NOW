 &lt;xsl:if test=&quot;ORA_DES&quot;>&#xa;                                    &lt;ORA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;ORA_DES&quot;/>&#xa;                                    &lt;/ORA_DES>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                    &lt;IDRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                    &lt;/IDRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;tipologiaLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;tipologiaLavorazione&quot;/>&#xa;                                &lt;/tipologiaLavorazione>&#xa;                                &lt;xsl:if test=&quot;tipologiaSottolav&quot;>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;tipologiaSottolav&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;LNA_LA&quot;>&#xa;                                    &lt;LNA_LA>&#xa;                                        &lt;xsl:value-of select=&quot;LNA_LA&quot;/>&#xa;                                    &lt;/LNA_LA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;modalitaFatturazione&quot;>&#xa;                                    &lt;modalitaFatturazione>&#xa;                                        &lt;xsl:value-of select=&quot;modalitaFatturazione&quot;/>&#xa;                          