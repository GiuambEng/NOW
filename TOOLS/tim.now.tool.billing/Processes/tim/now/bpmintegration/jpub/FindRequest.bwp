                     &lt;/codiceOrdineTITarget>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/codiceProgetto&quot;>&#xa;                        &lt;codiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/codiceProgetto&quot;/>&#xa;                        &lt;/codiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;dataInvioRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/dataInvioRichiesta&quot;/>&#xa;                    &lt;/dataInvioRichiesta>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/IDAnagraficaCausale&quot;>&#xa;                        &lt;IDAnagraficaCausale>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/IDAnagraficaCausale&quot;/>&#xa;                        &lt;/IDAnagraficaCausale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/IDCorrelazione&quot;>&#xa;                        &lt;IDCorrelazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/IDCorrelazione&quot;/>&#xa;                        &lt;/IDCorrelazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/totaleRichiestePacchetto&quot;>&#xa;                        &lt;totaleRichiestePacchetto>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/totaleRichiestePacchetto&quot;/>&#xa;                        &lt;/totaleRichiestePacchetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/tipoPacchetto&quot;>&#xa;                        &lt;tipoPacchetto>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/tipoPacchetto&quot;/>&#xa;                        &lt;/tipoPacchetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/IDPacchettoNOW&quot;>&#xa;                        &lt;IDPacchettoNOW>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/IDPacchettoNOW&quot;/>&#xa;                        &lt;/IDPacchettoNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/contenutoXML&quot;>&#xa;                        &lt;contenutoXML>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/contenutoXML&quot;/>&#xa;                        &lt;/contenutoXML>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/note&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/note&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($ParseXml/ordine)&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$ParseXml/ordine&quot;>&#xa;                            &lt;ordine>&#xa;                                &lt;xsl:if test=&quot;offertaCatalogo&quot;>&#xa;                                    &lt;offertaCatalogo>&#xa;                                        &lt;xsl:value-of select=&quot;offertaCatalogo&quot;/>&#xa;                                    &lt;/offertaCatalogo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;DAC&quot;>&#xa;                                    &lt;DAC>&#xa;                                        &lt;xsl:value-of select=&quot;DAC&quot;/>&#xa;                                    &lt;/DAC>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;DACRimodulata&quot;>&#xa;                                    &lt;DACRimodulata>&#xa;                                        &lt;xsl:value-of select=&quot;DACRimodulata&quot;/>&#xa;                                    &lt;/DACRimodulata>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;