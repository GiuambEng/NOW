a;                        &lt;IDFileOutput>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/IDFileOutput&quot;/>&#xa;                        &lt;/IDFileOutput>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/ambito&quot;>&#xa;                        &lt;ambito>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/ambito&quot;/>&#xa;                        &lt;/ambito>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;canaleRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/canaleRichiesta&quot;/>&#xa;                    &lt;/canaleRichiesta>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/lavorazione&quot;>&#xa;                        &lt;lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/lavorazione&quot;/>&#xa;                        &lt;/lavorazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/progressivoRichiestaFile&quot;>&#xa;                        &lt;progressivoRichiestaFile>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/progressivoRichiestaFile&quot;/>&#xa;                        &lt;/progressivoRichiestaFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;strutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/strutturaRichiesta&quot;/>&#xa;                    &lt;/strutturaRichiesta>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/tipoRichiesta&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/IDRisorsa&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                   