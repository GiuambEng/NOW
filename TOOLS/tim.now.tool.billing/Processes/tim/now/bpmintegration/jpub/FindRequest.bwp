                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindRequest/&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Read.readCaseResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;tns:Find>&#xa;                &lt;xsl:if test=&quot;$Read.readCaseResponse/caseData[number($index)]/caseReference&quot;>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$Read.readCaseResponse/caseData[number($index)]/caseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns:Esito>&#xa;                    &lt;tns:DescrizioneEsito>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns:DescrizioneEsito>&#xa;                &lt;/tns:Response>&#xa;                &lt;tns:Request>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/lastUpdate&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-