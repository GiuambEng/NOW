value-of select=&quot;noteCliente&quot;/>&#xa;                                    &lt;/noteCliente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;notedaSistema&quot;>&#xa;                                    &lt;notedaSistema>&#xa;                                        &lt;xsl:value-of select=&quot;notedaSistema&quot;/>&#xa;                                    &lt;/notedaSistema>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;totaleOrdRilevPacchetto&quot;>&#xa;                                    &lt;totaleOrdRilevPacchetto>&#xa;                                        &lt;xsl:value-of select=&quot;totaleOrdRilevPacchetto&quot;/>&#xa;                                    &lt;/totaleOrdRilevPacchetto>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;CLLI&quot;>&#xa;                                    &lt;CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;CLLI&quot;/>&#xa;                                    &lt;/CLLI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codificaOLONOW>&#xa;                                    &lt;xsl:value-of select=&quot;codificaOLONOW&quot;/>&#xa;                                &lt;/codificaOLONOW>&#xa;                                &lt;xsl:if test=&quot;codiceOrdineOLO&quot;>&#xa;                                    &lt;codiceOrdineOLO>&#xa;                                        &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                                    &lt;/codiceOrdineOLO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;codiceOrdineOLOPadre&quot;>&#xa;                                    &lt;codiceOrdineOLOPadre>&#xa;                                        &lt;xsl:value-of select=&quot;codiceOrdineOLOPadre&quot;/>&#xa;  