                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlloEvento/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Controllo&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Response>&lt;tns:Esito>&lt;xsl:value-of select=&quot;$Controllo&quot;/>&lt;/tns:Esito>&lt;xsl:if test=&quot;$Controllo='KO'&quot;>&lt;xsl:if test=&quot;$ParseXml/ns:TESTATA[1]/ns:ACCESSO[1]/DATA_INIZIO_NOL&quot;>&lt;tns:DataInizioNol>&lt;xsl:value-of select=&quot;$ParseXml/ns:TESTATA[1]/ns:ACCESSO[1]/DATA_INIZIO_NOL&quot;/>&lt;/tns:DataInizioNol>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
