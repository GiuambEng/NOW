                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogVLAN-input"
                                    name="LogVLAN"
                                    tibex:xpdlId="91a97349-15ed-4f33-bdd3-28ad74caa325"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VLANToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogVLANToWhile2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;VLAN&quot;/>&#xa;    &lt;xsl:template name=&quot;LogVLAN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.tool.billing.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($VLAN/Record)>0&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Record VLAN:',tib:render-xml($VLAN, true(), true()))&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;'VLAN: record non trovati'&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:scope name="While2"
                                    tibex:group="while" tibex:xpdlId="c63570b8-81ef-4002-a720-052ba17364e6">
                                    <bpws:targets>
                                    <bpws:target linkName="LogVLANToWhile2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="While2ToWhile1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($TESTATA/Record)>1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($TESTATA/Record)>1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="While2ToEvento">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    </bpws:variables>
                                    <bpws:sequence name="sequence2" tibex:group="while">
                                    <bpws:assign
                                    name="GroupInit2"
                                    tibex:group="groupInit" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+2affab28-ebcd-43c9-bbdb-a23d3f00c931" version="2.0"> <xsl:template name="Accumulate1" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate1"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:while name="while2" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($VLAN/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($VLAN/Record)]]></bpws:condition>
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="JDBCQueryToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart2ToCOS" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogCOSToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MapperToGroupEnd1" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart2"
                                    tibex:group="groupStart" tibex:xpdlId="5cc35cc1-6ef6-4273-b3bf-4997fcff31bc">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToCOS"/>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    name="Accumulate1"
                                    outputVariable="Accumulate1"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="2affab28-ebcd-43c9-bbdb-a23d3f00c931" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="MapperToGroupEnd1"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>

                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="COS-input"
                                    name="COS"
                                    outputVariable="COS"
                                    tibex:xpdlId="f0327641-95d4-4c51-97ca-41f39d01329e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="GroupStart2ToCOS"/>
                                    </bpws:targets>
                                    <bpws:sources>

                                    <bpws:source linkName="JDBCQueryToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f0327641-95d4-4c51-97ca-41f39d01329e+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VLAN&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:template name=&quot;COS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VLAN/Record[$index1]/ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;            &lt;ID_RISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VLAN/Record[$index1]/ID_RISORSA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/ID_RISORSA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>

                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TMSP_INSERIMENTO,TIPO_COS,BANDA_PICCO_UP,BANDA_PICCO_DOWN,ID_RECUPERO_JPUB_MASTER,ID_RISORSA&#xa;FROM BO_TOOL_RECUPERO_JPUB_COS  &#xa;WHERE ID_RECUPERO_JPUB_MASTER=? AND ID_RISORSA=? ORDER BY TIPO_COS&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RECUPERO_JPUB_MASTER"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>

                                    <columnMetadata
                                    columnName="TMSP_INSERIMENTO"
                                    dataType="93" typeName="TIMESTAMP"/>

                                    <columnMetadata
                                    columnName="TIPO_COS"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="BANDA_PICCO_UP"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="BANDA_PICCO_DOWN"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="ID_RECUPERO_JPUB_MASTER"
                                    dataType="2" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="ID_RISORSA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:extActivity
                                    inputVariable="LogCOS-input"
                                    name="LogCOS"
                                    tibex:xpdlId="e1a25415-11f3-44ee-b3c0-abb352d17415"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="JDBCQueryToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>

                                    <bpws:source linkName="LogCOSToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;COS&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.tool.billing.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($COS/Record)>0&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Record COS:',tib:render-xml($COS, true(), true()))&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;'COS: record non trovati'&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>

                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="c576fd4f-e7fa-4935-8785-296b52a922f9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="LogCOSToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>

                                    <bpws:source linkName="MapperToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VLAN&quot;/>&lt;xsl:param name=&quot;COS&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:USER_VLAN>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/ID_RISORSA&quot;/>&lt;/ID_RIS>&lt;ID_RIS_OLD>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/ID_RISORSA_OLD&quot;/>&lt;/ID_RIS_OLD>&lt;TIPO_AZIONE>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/TIPO_AZIONE&quot;/>&lt;/TIPO_AZIONE>&lt;DATA_INIZIO_NOL>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/DATA_INI_NOL&quot;/>&lt;/DATA_INIZIO_NOL>&lt;PCR_UP>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/PCR_UP&quot;/>&lt;/PCR_UP>&lt;PCR_DOWN>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/PCR_DOWN&quot;/>&lt;/PCR_DOWN>&lt;ID_RIS_RACCOLTA>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/ID_RISORSA_RACCOLTA&quot;/>&lt;/ID_RIS_RACCOLTA>&lt;ID_CVLAN>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/ID_CVLAN&quot;/>&lt;/ID_CVLAN>&lt;CODE_IDBRE_DSLAM>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/CODICE_IDBRE_DSLAM&quot;/>&lt;/CODE_IDBRE_DSLAM>&lt;xsl:if test=&quot;count($COS/Record)>0&quot;>&lt;COS>&lt;TIPO_COS>&lt;xsl:value-of select=&quot;xsd:integer($COS/Record[1]/TIPO_COS)&quot;/>&lt;/TIPO_COS>&lt;BANDA_PICCO_UP>&lt;xsl:value-of select=&quot;$COS/Record[1]/BANDA_PICCO_UP&quot;/>&lt;/BANDA_PICCO_UP>&lt;BANDA_PICCO_DOWN>&lt;xsl:value-of select=&quot;$COS/Record[1]/BANDA_PICCO_DOWN&quot;/>&lt;/BANDA_PICCO_DOWN>&lt;TIPO_COS>&lt;xsl:value-of select=&quot;xsd:integer($COS/Record[2]/TIPO_COS)&quot;/>&lt;/TIPO_COS>&lt;BANDA_PICCO_UP>&lt;xsl:value-of select=&quot;$COS/Record[2]/BANDA_PICCO_UP&quot;/>&lt;/BANDA_PICCO_UP>&lt;BANDA_PICCO_DOWN>&lt;xsl:value-of select=&quot;$COS/Record[2]/BANDA_PICCO_DOWN&quot;/>&lt;/BANDA_PICCO_DOWN>&lt;TIPO_COS>&lt;xsl:value-of select=&quot;xsd:integer($COS/Record[3]/TIPO_COS)&quot;/>&lt;/TIPO_COS>&lt;BANDA_PICCO_UP>&lt;xsl:value-of select=&quot;$COS/Record[3]/BANDA_PICCO_UP&quot;/>&lt;/BANDA_PICCO_UP>&lt;BANDA_PICCO_DOWN>&lt;xsl:value-of select=&quot;$COS/Record[3]/BANDA_PICCO_DOWN&quot;/>&lt;/BANDA_PICCO_DOWN>&lt;TIPO_COS>&lt;xsl:value-of select=&quot;xsd:integer($COS/Record[4]/TIPO_COS)&quot;/>&lt;/TIPO_COS>&lt;BANDA_PICCO_UP>&lt;xsl:value-of select=&quot;$COS/Record[4]/BANDA_PICCO_UP&quot;/>&lt;/BANDA_PICCO_UP>&lt;BANDA_PICCO_DOWN>&lt;xsl:value-of select=&quot;$COS/Record[4]/BANDA_PICCO_DOWN&quot;/>&lt;/BANDA_PICCO_DOWN>&lt;/COS>&lt;/xsl:if>&lt;xsl:if test=&quot;$VLAN/Record[$index1]/PROFILO_CVLAN&quot;>&lt;PROFILO_CVLAN xsi:type=&quot;xsd:string&quot;>&lt;xsl:value-of select=&quot;$VLAN/Record[$index1]/PROFILO_CVLAN&quot;/>&lt;/PROFILO_CVLAN>&lt;/xsl:if>&lt;/tns:USER_VLAN>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:jpubADSL="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>

                                    <value
                                    inputQName="jpubADSL:USER_VLAN" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:while>
                                    </bpws:sequence>
                                    </bpws:scope>
                                    <bpws:scope name="While1"
                                    tibex:group="while" tibex:xpdlId="d459fc61-a943-4081-ac84-d476c74d9eeb">
                                    <bpws:targets>
                                    <bpws:target linkName="While2ToWhile1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="While1ToMapper"/>
                                    </bpws:sources>
                                    <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    </bpws:variables>
                                    <bpws:sequence name="sequence1" tibex:group="while">
                                    <bpws:assign
                                    name="GroupInit1"
                                    tibex:group="groupInit" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+5e8cbe20-6b59-4188-9ef4-cccd6c1b4a97" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:while name="while1" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($EVENTO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($EVENTO/Record)]]></bpws:condition>
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart1ToMapper1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Mapper1ToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GenericLoggerToAccumulate" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart1"
                                    tibex:group="groupStart" tibex:xpdlId="f082d0d7-7006-4ccc-99a7-1244a79f1b18">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToMapper1"/>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="5e8cbe20-6b59-4188-9ef4-cccd6c1b4a97" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="GenericLoggerToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>

                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper1</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="Mapper1-input"
                                    name="Mapper1"
                                    outputVariable="Mapper1"
                                    tibex:xpdlId="7b895415-e009-4fc4-b7e1-0d6fa5f98aeb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="GroupStart1ToMapper1"/>
                                    </bpws:targets>
                                    <bpws:sources>

                                    <bpws:source linkName="Mapper1ToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TESTATA&quot;/>&#xa;    &lt;xsl:param name=&quot;EVENTO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ORDINI_CRMWS>&#xa;            &lt;tns:TESTATA>&#xa;                &lt;ID_ORD_CRMWS>&#xa;                    &lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS='1'][1]/ID_ORDINE_CRMWS&quot;/>&#xa;                &lt;/ID_ORD_CRMWS>&#xa;                &lt;DATA_DRO>&#xa;                    &lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS='1'][1]/DATA_DRO&quot;/>&#xa;                &lt;/DATA_DRO>&#xa;                &lt;DATA_MSG>&#xa;                    &lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS='1'][1]/DATA_MSG&quot;/>&#xa;                &lt;/DATA_MSG>&#xa;                &lt;DATA_DES>&#xa;                    &lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS='1'][1]/DATA_DES&quot;/>&#xa;                &lt;/DATA_DES>&#xa;                &lt;CODICE_ORDINE_ISP>&#xa;                    &lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS='1'][1]/CODE_ORDINE_ISP&quot;/>&#xa;                &lt;/CODICE_ORDINE_ISP>&#xa;                &lt;CODICE_PROGETTO>&#xa;                    &lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS='1'][1]/CODE_PROGETTO&quot;/>&#xa;                &lt;/CODICE_PROGETTO>&#xa;                &lt;CODE_CAUS>&#xa;                    &lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS='1'][1]/CODE_CAUS&quot;/>&#xa;                &lt;/CODE_CAUS>&#xa;                &lt;tns:EVENTI>&#xa;                    &lt;TIPO_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/TIPO_CONTRATTO&quot;/>&#xa;                    &lt;/TIPO_CONTR>&#xa;                    &lt;CODE_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/CODE_CONTRATTO&quot;/>&#xa;                    &lt;/CODE_CONTR>&#xa;                    &lt;ID_RIS>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/ID_RISORSA&quot;/>&#xa;                    &lt;/ID_RIS>&#xa;                    &lt;TIPO_FAMIGLIA>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/TIPO_FAMIGLIA&quot;/>&#xa;                    &lt;/TIPO_FAMIGLIA>&#xa;                    &lt;TIPO_AZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/TIPO_AZIONE&quot;/>&#xa;                    &lt;/TIPO_AZIONE>&#xa;                    &lt;UTENZA_RIF>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/UTENZA_RIFERIMENTO&quot;/>&#xa;                    &lt;/UTENZA_RIF>&#xa;                    &lt;VEL_BANDA_UP>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/VELOCITA_BANDA_UP&quot;/>&#xa;                    &lt;/VEL_BANDA_UP>&#xa;                    &lt;VEL_BANDA_DOWN>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/VELOCITA_BANDA_DOWN&quot;/>&#xa;                    &lt;/VEL_BANDA_DOWN>&#xa;                    &lt;FLAG_ESITO_PREQ>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/FLAG_ESITO_PREQUAL&quot;/>&#xa;                    &lt;/FLAG_ESITO_PREQ>&#xa;                    &lt;CODE_OL>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/CODICE_OL&quot;/>&#xa;                    &lt;/CODE_OL>&#xa;                    &lt;DONOR>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/DONOR&quot;/>&#xa;                    &lt;/DONOR>&#xa;                    &lt;TIPO_NUMERO>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/TIPO_NUMERO&quot;/>&#xa;                    &lt;/TIPO_NUMERO>&#xa;                    &lt;PORTABILITA>&#xa;                        &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/PORTABILITA&quot;/>&#xa;                    &lt;/PORTABILITA>&#xa;                    &lt;xsl:if test=&quot;$EVENTO/Record[$index]/RICARICA&quot;>&#xa;                        &lt;RICARICA>&#xa;                            &lt;xsl:value-of select=&quot;$EVENTO/Record[$index]/RICARICA&quot;/>&#xa;                        &lt;/RICARICA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:EVENTI>&#xa;            &lt;/tns:TESTATA>&#xa;        &lt;/tns:ORDINI_CRMWS>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:jpubADSL="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>

                                    <value
                                    inputQName="jpubADSL:ORDINI_CRMWS" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:extActivity
                                    inputVariable="GenericLogger-input"
                                    name="GenericLogger"
                                    tibex:xpdlId="46d87838-0e37-4027-b400-ca6a1eab7ccd"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="Mapper1ToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>

                                    <bpws:source linkName="GenericLoggerToAccumulate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper1&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.tool.billing.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Accumulate EVENTI',tib:render-xml($Mapper1, true(),true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>

                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:while>
                                    </bpws:sequence>
                                    </bpws:scope>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Evento-input"
                                    name="Evento"
                                    outputVariable="Evento"
                                    tibex:xpdlId="33ffe885-7bd8-477c-9ef9-cb0d03a178d0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="While2ToEvento"/>
                                    <bpws:target linkName="While1ToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToGenericLogger1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ACCESSO&quot;/>&lt;xsl:param name=&quot;TESTATA&quot;/>&lt;xsl:param name=&quot;SLA&quot;/>&lt;xsl:param name=&quot;VC&quot;/>&lt;xsl:param name=&quot;EVENTO&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;Accumulate1&quot;/>&lt;xsl:template name=&quot;Evento-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($TESTATA/Record)>1&quot;>&lt;tns:ORDINI_CRMWS>&lt;tns:TESTATA>&lt;ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS!='1']/ID_ORDINE_CRMWS&quot;/>&lt;/ID_ORD_CRMWS>&lt;DATA_DRO>&lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS!='1']/DATA_DRO&quot;/>&lt;/DATA_DRO>&lt;DATA_MSG>&lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS!='1']/DATA_MSG&quot;/>&lt;/DATA_MSG>&lt;DATA_DES>&lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS!='1']/DATA_DES&quot;/>&lt;/DATA_DES>&lt;CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS!='1']/CODE_ORDINE_ISP&quot;/>&lt;/CODICE_ORDINE_ISP>&lt;CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS!='1']/CODE_PROGETTO&quot;/>&lt;/CODICE_PROGETTO>&lt;CODE_CAUS>&lt;xsl:value-of select=&quot;$TESTATA/Record[CODE_CAUS!='1']/CODE_CAUS&quot;/>&lt;/CODE_CAUS>&lt;tns:ACCESSO>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;$ACCESSO/Record[1]/TIPO_CONTRATTO&quot;/>&lt;/TIPO_CONTR>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$ACCESSO/Record[1]/CODE_CONTRATTO&quot;/>&lt;/CODE_CONTR>&lt;ID_RIS>&lt;xsl:value-of select=&quot;$ACCESSO/Record[1]/ID_RISORSA&quot;/>&lt;/ID_RIS>&lt;TIPO_FAMIGLIA>&lt;xsl:value-of selec