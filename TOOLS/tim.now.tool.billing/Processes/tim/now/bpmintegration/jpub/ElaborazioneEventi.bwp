                                    sqlStatement="INSERT INTO EVENTO_JPUB(IDDETTAGLIOORDINE, ID_RISORSA, ID_RICH_OLO, NUMERO_TENTATIVI, TIMSTP_INSMTO_EVENTO, &#xa;ID_EVENTO_ORDN_NOW_WHLS, ID_RICH_JPUB, IDTPLG_STATO_EVENTO_JPUB,FLAG_CONSUNTIVO,STRUTTURA_OFFERTA,OFFERTA,&#xa;CONTENUTO_XML,ID_ORDINE_COMPOSTO ,TIPO_AZIONE,CODICE_CAUSALE)&#xa;VALUES(?, ?, ?, ?, ?, ?, (S_ID_RICH_JPUB.NEXTVAL),(SELECT IDTPLG_STATO_EVENTO_JPUB &#xa;FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?),?,?,?,?,&#xa;?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

