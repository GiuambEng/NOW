                                    inputVariable="LogOfferta-input"
                                    name="LogOfferta"
                                    tibex:xpdlId="0b13c04e-e0a5-4782-a0f4-a30e302f648f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OffertaToGenericLogger1"/>
