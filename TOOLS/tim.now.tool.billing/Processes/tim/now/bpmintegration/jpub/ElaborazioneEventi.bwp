                                    <columnMetadata
                                    columnName="DATA_DES"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>

                                    <columnMetadata
                                    columnName="CODE_CAUS"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="CODICE_ORDINE_ISP"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="CODICE_PROGETTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnName="ID_RECUPERO_JPUB_MASTER"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="GenericLogger2-input"
                                    name="GenericLogger2"
                                    tibex:xpdlId="da9eb3ab-7167-4dbe-b2c2-47c9ae1c55e8"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToGenericLogger21"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLogger2ToEmpty3">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="count($FONIA_TESTATA/Record[contains(ID_ORDINE_CRMWS,'-ST')])>0 or exists($FONIA_ACCESSO/Record[TIPO_CONTRATTO='41' and TIPO_AZIONE!='2' ])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($FONIA_TESTATA/Record[contains(ID_ORDINE_CRMWS,'-ST')])>0 or exists($FONIA_ACCESSO/Record[TIPO_CONTRATTO='41' and TIPO_AZIONE!='2' ])]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLogger2ToWhile4">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLogger2ToMapper3">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="count($FONIA_TESTATA/Record)=1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($FONIA_TESTATA/Record)=1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;FONIA_TESTATA&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.tool.billing.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($FONIA_TESTATA/Record) > 0&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record FoniaTestata&amp;quot;, tib:render-xml($FONIA_TESTATA, true(), true()))&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Record FoniaTestata non trovati'&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Mapper2-input"
                                    name="Mapper2"
                                    outputVariable="Mapper2"
                                    tibex:xpdlId="303f5ae4-9e0a-47f8-9da5-8ae185673edc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty3ToMapper2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper2ToMapper3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FONIA_TESTATA&quot;/>&#xa;    &lt;xsl:param name=&quot;FONIA_ACCESSO&quot;/>&#xa;    &lt;xsl:param name=&quot;FONIA_STS&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:REGOLATORIO>&#xa;            &lt;xsl:for-each select=&quot;$FONIA_TESTATA/Record[contains(ID_ORDINE_CRMWS,'-ST')]&quot;>&#xa;                &lt;tns1:TESTATA>&#xa;                    &lt;ID_ORD_CRMWS>&#xa;                        &lt;xsl:value-of select=&quot;ID_ORDINE_CRMWS&quot;/>&#xa;                    &lt;/ID_ORD_CRMWS>&#xa;                    &lt;DATA_DRO>&#xa;                        &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                    &lt;/DATA_DRO>&#xa;                    &lt;DATA_MSG>&#xa;                        &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                    &lt;/DATA_MSG>&#xa;                    &lt;DATA_DES>&#xa;                        &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                    &lt;/DATA_DES>&#xa;                    &lt;CODE_CAUS>&#xa;                        &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                    &lt;/CODE_CAUS>&#xa;                    &lt;CODICE_ORDINE_ISP>&#xa;                        &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                    &lt;/CODICE_ORDINE_ISP>&#xa;                    &lt;CODICE_PROGETTO>&#xa;                        &lt;xsl:value-of select=&quot;CODICE_PROGETTO&quot;/>&#xa;                    &lt;/CODICE_PROGETTO>&#xa;                    &lt;xsl:for-each select=&quot;$FONIA_ACCESSO/Record[TIPO_AZIONE='3']&quot;>&#xa;                        &lt;tns1:ACCESSO>&#xa;                            &lt;TIPO_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;TIPO_CONTRATTO&quot;/>&#xa;                            &lt;/TIPO_CONTR>&#xa;                            &lt;CODE_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_CONTRATTO&quot;/>&#xa;                            &lt;/CODE_CONTR>&#xa;                            &lt;CODE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_CLLI&quot;/>&#xa;                            &lt;/CODE_CLLI>&#xa;                            &lt;CODE_PREST_AGG>&#xa;                                &lt;xsl:value-of select=&quot;COD_PRESTAZIONI_AGGIUNTIVE&quot;/>&#xa;                            &lt;/CODE_PREST_AGG>&#xa;                            &lt;ID_RIS>&#xa;                                &lt;xsl:value-of select=&quot;ID_RISORSA&quot;/>&#xa;                            &lt;/ID_RIS>&#xa;                            &lt;ID_RIS_PRINC>&#xa;                                &lt;xsl:value-of select=&quot;ID_RISORSA_PRINCIPALE&quot;/>&#xa;                            &lt;/ID_RIS_PRINC>&#xa;                            &lt;CODE_GEST_REC>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_GESTORE_REC&quot;/>&#xa;                            &lt;/CODE_GEST_REC>&#xa;                            &lt;TIPO_FAMIGLIA>&#xa;                                &lt;xsl:value-of select=&quot;TIPO_FAMIGLIA&quot;/>&#xa;                            &lt;/TIPO_FAMIGLIA>&#xa;                            &lt;OPZ_COMM>&#xa;                                &lt;xsl:value-of select=&quot;OPZIONE_COMMERCIALE&quot;/>&#xa;                            &lt;/OPZ_COMM>&#xa;                            &lt;TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;TIPO_LINEA&quot;/>&#xa;                            &lt;/TIPO_LINEA>&#xa;                            &lt;FLAG_NP>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_NP&quot;/>&#xa;                            &lt;/FLAG_NP>&#xa;                            &lt;SUB_TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA>&#xa;                            &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_RESIDENZIALE&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                            &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_DIREZIONE&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;MOD_VENDITA_ACCESSO&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                            &lt;TIPO_AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                            &lt;/TIPO_AZIONE>&#xa;                            &lt;DATA_INIZIO_NOL>&#xa;                                &lt;xsl:value-of select=&quot;DATA_INIZIO_NOL&quot;/>&#xa;                            &lt;/DATA_INIZIO_NOL>&#xa;                            &lt;CODE_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_COMUNE&quot;/>&#xa;                            &lt;/CODE_COMUNE>&#xa;                            &lt;CODE_ID_ULLCO>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_IDULLCO&quot;/>&#xa;                            &lt;/CODE_ID_ULLCO>&#xa;                            &lt;CODE_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_DISTRETTO&quot;/>&#xa;                            &lt;/CODE_DISTR>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_PERMUTA&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                            &lt;FLAG_MIGRAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_MIGRAZIONE&quot;/>&#xa;                            &lt;/FLAG_MIGRAZIONE>&#xa;                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_QUALIFICAZIONE&quot;/>&#xa;                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                            &lt;ID_RIS_OLD>&#xa;                                &lt;xsl:value-of select=&quot;ID_RISORSA_OLD&quot;/>&#xa;                            &lt;/ID_RIS_OLD>&#xa;                            &lt;CODICE_QUALITA>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_QUALITA&quot;/>&#xa;                            &lt;/CODICE_QUALITA>&#xa;                            &lt;CODICE_DELIVERY>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_DELIVERY&quot;/>&#xa;                            &lt;/CODICE_DELIVERY>&#xa;                            &lt;CAMPO_SERV_IT>&#xa;                                &lt;xsl:value-of select=&quot;CAMPO_SERV_IT&quot;/>&#xa;                            &lt;/CAMPO_SERV_IT>&#xa;                            &lt;QUANTITA>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(QUANTITA)&quot;/>&#xa;                            &lt;/QUANTITA>&#xa;                            &lt;CODE_DONOR>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_DONOR&quot;/>&#xa;                            &lt;/CODE_DONOR>&#xa;                            &lt;CODE_DONATING>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_DONATING&quot;/>&#xa;                            &lt;/CODE_DONATING>&#xa;                            &lt;xsl:if test=&quot;CODICE_IDSLUCO&quot;>&#xa;                                &lt;CODE_ID_SLUCO>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_IDSLUCO&quot;/>&#xa;                                &lt;/CODE_ID_SLUCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_MANTENIMENTO_STS&quot;/>&#xa;                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                            &lt;xsl:if test=&quot;FLAG_PERMUTA_ARMADIO&quot;>&#xa;                                &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                                &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPO_CESSAZIONE&quot;>&#xa;                                &lt;TIPO_CESSAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;TIPO_CESSAZIONE&quot;/>&#xa;                                &lt;/TIPO_CESSAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;>&#xa;                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;/>&#xa;                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;FLAG_LA&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                            &lt;xsl:if test=&quot;TIPO_LINEA_NUM_AGG&quot;>&#xa;                                &lt;TIPO_LINEA_NUM_AGG>&#xa;                                    &lt;xsl:value-of select=&quot;TIPO_LINEA_NUM_AGG&quot;/>&#xa;                                &lt;/TIPO_LINEA_NUM_AGG>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;FLAG_4_REFERENTE&quot;>&#xa;                                &lt;FLAG_4REFERENTE>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_4_REFERENTE&quot;/>&#xa;                                &lt;/FLAG_4REFERENTE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODICE_HOSTING&quot;>&#xa;                                &lt;CODE_HOSTING>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_HOSTING&quot;/>&#xa;                                &lt;/CODE_HOSTING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;TIPO_CLUSTER&quot;>&#xa;                                &lt;TIPO_CLUSTER>&#xa;                                    &lt;xsl:value-of select=&quot;TIPO_CLUSTER&quot;/>&#xa;                                &lt;/TIPO_CLUSTER>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:for-each select=&quot;$FONIA_STS/Record[FLAG_LINEA_NUMAGG='0' and TIPO_AZIONE='3']&quot;>&#xa;                                &lt;tns1:STS>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                    &lt;FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_LINEA_NUMAGG&quot;/>&#xa;                                    &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                    &lt;ID_RIS_AGGIUNTIVA>&#xa;                                        &lt;xsl:value-of select=&quot;IDRISORSA_AGGIUNTIVA&quot;/>&#xa;                                    &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                    &lt;CODE_STS>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_STS&quot;/>&#xa;                                    &lt;/CODE_STS>&#xa;                                &lt;/tns1:STS>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns1:ACCESSO>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:TESTATA>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:REGOLATORIO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:jpub="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="jpub:REGOLATORIO" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Mapper3-input"
                                    name="Mapper3"
                                    outputVariable="Mapper3"
                                    tibex:xpdlId="5b7821ac-9a24-4d4a-978b-f92b4bd77605" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="While4ToMapper3"/>
                                    <bpws:target linkName="GenericLogger2ToMapper3"/>
                                    <bpws:target linkName="Mapper2ToMapper3"/>
                                    <bpws:target linkName="Empty5ToMapper3"/>
                                    <bpws:target linkName="JDBCQueryToMapper3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper3ToGenericLogger5"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FONIA_TESTATA&quot;/>&#xa;    &lt;xsl:param name=&quot;FONIA_ACCESSO&quot;/>&#xa;    &lt;xsl:param name=&quot;FONIA_AGG&quot;/>&#xa;    &lt;xsl:param name=&quot;FONIA_STS&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate3&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper3-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(count($FONIA_TESTATA/Record[contains(ID_ORDINE_CRMWS,'-ST')])>0 or exists($FONIA_ACCESSO/Record[TIPO_CONTRATTO='41' and TIPO_AZIONE!='2'])) and (count($JDBCQuery/Record)=0 or not(exists($JDBCQuery/Record)) or  $JDBCQuery/Record[1]/LAVORAZIONE!='VARIAZIONE')&quot;>&#xa;                &lt;tns1:REGOLATORIO>&#xa;                    &lt;xsl:for-each select=&quot;$FONIA_ACCESSO/Record[TIPO_AZIONE='1']&quot;>&#xa;                        &lt;tns1:TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[not(contains(ID_ORDINE_CRMWS,'-ST'))][1]/ID_ORDINE_CRMWS&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[not(contains(ID_ORDINE_CRMWS,'-ST'))][1]/DATA_DRO&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[not(contains(ID_ORDINE_CRMWS,'-ST'))][1]/DATA_MSG&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;DATA_DES>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[not(contains(ID_ORDINE_CRMWS,'-ST'))][1]/DATA_DES&quot;/>&#xa;                            &lt;/DATA_DES>&#xa;                            &lt;CODE_CAUS>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[not(contains(ID_ORDINE_CRMWS,'-ST'))][1]/CODE_CAUS&quot;/>&#xa;                            &lt;/CODE_CAUS>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[not(contains(ID_ORDINE_CRMWS,'-ST'))][1]/CODICE_ORDINE_ISP&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[not(contains(ID_ORDINE_CRMWS,'-ST'))][1]/CODICE_PROGETTO&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                            &lt;tns1:ACCESSO>&#xa;                                &lt;TIPO_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;TIPO_CONTRATTO&quot;/>&#xa;                                &lt;/TIPO_CONTR>&#xa;                                &lt;CODE_CONTR>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_CONTRATTO&quot;/>&#xa;                                &lt;/CODE_CONTR>&#xa;                                &lt;CODE_CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_CLLI&quot;/>&#xa;                                &lt;/CODE_CLLI>&#xa;                                &lt;CODE_PREST_AGG>&#xa;                                    &lt;xsl:value-of select=&quot;COD_PRESTAZIONI_AGGIUNTIVE&quot;/>&#xa;                                &lt;/CODE_PREST_AGG>&#xa;                                &lt;ID_RIS>&#xa;                                    &lt;xsl:value-of select=&quot;ID_RISORSA&quot;/>&#xa;                                &lt;/ID_RIS>&#xa;                                &lt;ID_RIS_PRINC>&#xa;                                    &lt;xsl:value-of select=&quot;ID_RISORSA_PRINCIPALE&quot;/>&#xa;                                &lt;/ID_RIS_PRINC>&#xa;                                &lt;CODE_GEST_REC>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_GESTORE_REC&quot;/>&#xa;                                &lt;/CODE_GEST_REC>&#xa;                                &lt;TIPO_FAMIGLIA>&#xa;                                    &lt;xsl:value-of select=&quot;TIPO_FAMIGLIA&quot;/>&#xa;                                &lt;/TIPO_FAMIGLIA>&#xa;                                &lt;OPZ_COMM>&#xa;                                    &lt;xsl:value-of select=&quot;OPZIONE_COMMERCIALE&quot;/>&#xa;                                &lt;/OPZ_COMM>&#xa;                                &lt;TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;TIPO_LINEA&quot;/>&#xa;                                &lt;/TIPO_LINEA>&#xa;                                &lt;FLAG_NP>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_NP&quot;/>&#xa;                                &lt;/FLAG_NP>&#xa;                                &lt;SUB_TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA>&#xa;                                &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                    &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_RESIDENZIALE&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;SUB_TIPO_LINEA_DIREZIONE&quot;/>&#xa;                                &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;MOD_VENDITA_ACCESSO>&#xa;                                    &lt;xsl:value-of select=&quot;MOD_VENDITA_ACCESSO&quot;/>&#xa;                                &lt;/MOD_VENDITA_ACCESSO>&#xa;                                &lt;TIPO_AZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                &lt;/TIPO_AZIONE>&#xa;                                &lt;DATA_INIZIO_NOL>&#xa;                                    &lt;xsl:value-of select=&quot;DATA_INIZIO_NOL&quot;/>&#xa;                                &lt;/DATA_INIZIO_NOL>&#xa;                                &lt;CODE_COMUNE>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_COMUNE&quot;/>&#xa;                                &lt;/CODE_COMUNE>&#xa;                                &lt;CODE_ID_ULLCO>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_IDULLCO&quot;/>&#xa;                                &lt;/CODE_ID_ULLCO>&#xa;                                &lt;CODE_DISTR>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_DISTRETTO&quot;/>&#xa;                                &lt;/CODE_DISTR>&#xa;                                &lt;FLAG_PERMUTA>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_PERMUTA&quot;/>&#xa;                                &lt;/FLAG_PERMUTA>&#xa;                                &lt;FLAG_MIGRAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_MIGRAZIONE&quot;/>&#xa;                                &lt;/FLAG_MIGRAZIONE>&#xa;                                &lt;FLAG_QUALIFICAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_QUALIFICAZIONE&quot;/>&#xa;                                &lt;/FLAG_QUALIFICAZIONE>&#xa;                                &lt;ID_RIS_OLD>&#xa;                                    &lt;xsl:value-of select=&quot;ID_RISORSA_OLD&quot;/>&#xa;                                &lt;/ID_RIS_OLD>&#xa;                                &lt;CODICE_QUALITA>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_QUALITA&quot;/>&#xa;                                &lt;/CODICE_QUALITA>&#xa;                                &lt;CODICE_DELIVERY>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_DELIVERY&quot;/>&#xa;                                &lt;/CODICE_DELIVERY>&#xa;                                &lt;CAMPO_SERV_IT>&#xa;                                    &lt;xsl:value-of select=&quot;CAMPO_SERV_IT&quot;/>&#xa;                                &lt;/CAMPO_SERV_IT>&#xa;                                &lt;QUANTITA>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:integer(QUANTITA)&quot;/>&#xa;                                &lt;/QUANTITA>&#xa;                                &lt;CODE_DONOR>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_DONOR&quot;/>&#xa;                                &lt;/CODE_DONOR>&#xa;                                &lt;CODE_DONATING>&#xa;                                    &lt;xsl:value-of select=&quot;CODICE_DONATING&quot;/>&#xa;                                &lt;/CODE_DONATING>&#xa;                                &lt;xsl:if test=&quot;CODICE_IDSLUCO&quot;>&#xa;                                    &lt;CODE_ID_SLUCO>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_IDSLUCO&quot;/>&#xa;                                    &lt;/CODE_ID_SLUCO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_MANTENIMENTO_STS&quot;/>&#xa;                                &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                &lt;xsl:if test=&quot;FLAG_PERMUTA_ARMADIO&quot;>&#xa;                                    &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                                    &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;TIPO_CESSAZIONE&quot;>&#xa;                                    &lt;TIPO_CESSAZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_CESSAZIONE&quot;/>&#xa;                                    &lt;/TIPO_CESSAZIONE>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;>&#xa;                                    &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;/>&#xa;                                    &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;FLAG_LA>&#xa;                                    &lt;xsl:value-of select=&quot;FLAG_LA&quot;/>&#xa;                                &lt;/FLAG_LA>&#xa;                                &lt;xsl:if test=&quot;TIPO_LINEA_NUM_AGG&quot;>&#xa;                                    &lt;TIPO_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_LINEA_NUM_AGG&quot;/>&#xa;                                    &lt;/TIPO_LINEA_NUM_AGG>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;FLAG_4_REFERENTE&quot;>&#xa;                                    &lt;FLAG_4REFERENTE>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_4_REFERENTE&quot;/>&#xa;                                    &lt;/FLAG_4REFERENTE>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;CODICE_HOSTING&quot;>&#xa;                                    &lt;CODE_HOSTING>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_HOSTING&quot;/>&#xa;                                    &lt;/CODE_HOSTING>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;TIPO_CLUSTER&quot;>&#xa;                                    &lt;TIPO_CLUSTER>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_CLUSTER&quot;/>&#xa;                                    &lt;/TIPO_CLUSTER>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(ID_RISORSA_PRINCIPALE)=0&quot;>&#xa;                                        &lt;xsl:for-each select=&quot;$FONIA_STS/Record[FLAG_LINEA_NUMAGG='0' and not(TIPO_AZIONE='3')]&quot;>&#xa;                                            &lt;tns1:STS>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                                &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                    &lt;xsl:value-of select=&quot;FLAG_LINEA_NUMAGG&quot;/>&#xa;                                                &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRISORSA_AGGIUNTIVA&quot;/>&#xa;                                                &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;CODE_STS>&#xa;                                                    &lt;xsl:value-of select=&quot;CODICE_STS&quot;/>&#xa;                                                &lt;/CODE_STS>&#xa;                                            &lt;/tns1:STS>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:for-each select=&quot;$FONIA_STS/Record[not(FLAG_LINEA_NUMAGG='0')]&quot;>&#xa;                                            &lt;tns1:STS>&#xa;                                                &lt;TIPO_AZIONE>&#xa;                                                    &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                                &lt;/TIPO_AZIONE>&#xa;                                                &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                    &lt;xsl:value-of select=&quot;FLAG_LINEA_NUMAGG&quot;/>&#xa;                                                &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRISORSA_AGGIUNTIVA&quot;/>&#xa;                                                &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;CODE_STS>&#xa;                                                    &lt;xsl:value-of select=&quot;CODICE_STS&quot;/>&#xa;                                                &lt;/CODE_STS>&#xa;                                            &lt;/tns1:STS>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns1:ACCESSO>&#xa;                        &lt;/tns1:TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:REGOLATORIO>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($FONIA_TESTATA/Record)>1&quot;>&#xa;                &lt;tns1:REGOLATORIO>&#xa;                    &lt;xsl:for-each select=&quot;$Accumulate3/tns1:REGOLATORIO&quot;>&#xa;                        &lt;tns1:TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TESTATA[1]/DATA_DRO&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TESTATA[1]/DATA_MSG&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;DATA_DES>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TESTATA[1]/DATA_DES&quot;/>&#xa;                            &lt;/DATA_DES>&#xa;                            &lt;CODE_CAUS>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TESTATA[1]/CODE_CAUS&quot;/>&#xa;                            &lt;/CODE_CAUS>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TESTATA[1]/CODICE_ORDINE_ISP&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TESTATA[1]/CODICE_PROGETTO&quot;/>&#xa;                            &lt;/CODICE_PROGETTO>&#xa;                            &lt;xsl:copy-of select=&quot;tns1:TESTATA/tns1:ACCESSO&quot;/>&#xa;                        &lt;/tns1:TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:REGOLATORIO>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:REGOLATORIO>&#xa;                    &lt;tns1:TESTATA>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/ID_ORDINE_CRMWS&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                        &lt;DATA_DRO>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/DATA_DRO&quot;/>&#xa;                        &lt;/DATA_DRO>&#xa;                        &lt;DATA_MSG>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/DATA_MSG&quot;/>&#xa;                        &lt;/DATA_MSG>&#xa;                        &lt;DATA_DES>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/DATA_DES&quot;/>&#xa;                        &lt;/DATA_DES>&#xa;                        &lt;CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/CODE_CAUS&quot;/>&#xa;                        &lt;/CODE_CAUS>&#xa;                        &lt;CODICE_ORDINE_ISP>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/CODICE_ORDINE_ISP&quot;/>&#xa;                        &lt;/CODICE_ORDINE_ISP>&#xa;                        &lt;CODICE_PROGETTO>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/CODICE_PROGETTO&quot;/>&#xa;                        &lt;/CODICE_PROGETTO>&#xa;                        &lt;tns1:ACCESSO>&#xa;                            &lt;TIPO_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/TIPO_CONTRATTO&quot;/>&#xa;                            &lt;/TIPO_CONTR>&#xa;                            &lt;CODE_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_CONTRATTO&quot;/>&#xa;                            &lt;/CODE_CONTR>&#xa;                            &lt;CODE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_CLLI&quot;/>&#xa;                            &lt;/CODE_CLLI>&#xa;                            &lt;CODE_PREST_AGG>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/COD_PRESTAZIONI_AGGIUNTIVE&quot;/>&#xa;                            &lt;/CODE_PREST_AGG>&#xa;                            &lt;ID_RIS>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/ID_RISORSA&quot;/>&#xa;                            &lt;/ID_RIS>&#xa;                            &lt;ID_RIS_PRINC>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/ID_RISORSA_PRINCIPALE&quot;/>&#xa;                            &lt;/ID_RIS_PRINC>&#xa;                            &lt;CODE_GEST_REC>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_GESTORE_REC&quot;/>&#xa;                            &lt;/CODE_GEST_REC>&#xa;                            &lt;TIPO_FAMIGLIA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/TIPO_FAMIGLIA&quot;/>&#xa;                            &lt;/TIPO_FAMIGLIA>&#xa;                            &lt;OPZ_COMM>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/OPZIONE_COMMERCIALE&quot;/>&#xa;                            &lt;/OPZ_COMM>&#xa;                            &lt;TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/TIPO_LINEA&quot;/>&#xa;                            &lt;/TIPO_LINEA>&#xa;                            &lt;FLAG_NP>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/FLAG_NP&quot;/>&#xa;                            &lt;/FLAG_NP>&#xa;                            &lt;SUB_TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/SUB_TIPO_LINEA&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA>&#xa;                            &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/SUB_TIPO_LINEA_RESIDENZIALE&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                            &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/SUB_TIPO_LINEA_DIREZIONE&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/MOD_VENDITA_ACCESSO&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                            &lt;TIPO_AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/TIPO_AZIONE&quot;/>&#xa;                            &lt;/TIPO_AZIONE>&#xa;                            &lt;DATA_INIZIO_NOL>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/DATA_INIZIO_NOL&quot;/>&#xa;                            &lt;/DATA_INIZIO_NOL>&#xa;                            &lt;CODE_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_COMUNE&quot;/>&#xa;                            &lt;/CODE_COMUNE>&#xa;                            &lt;CODE_ID_ULLCO>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_IDULLCO&quot;/>&#xa;                            &lt;/CODE_ID_ULLCO>&#xa;                            &lt;CODE_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_DISTRETTO&quot;/>&#xa;                            &lt;/CODE_DISTR>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/FLAG_PERMUTA&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                            &lt;FLAG_MIGRAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/FLAG_MIGRAZIONE&quot;/>&#xa;                            &lt;/FLAG_MIGRAZIONE>&#xa;                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/FLAG_QUALIFICAZIONE&quot;/>&#xa;                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                            &lt;ID_RIS_OLD>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/ID_RISORSA_OLD&quot;/>&#xa;                            &lt;/ID_RIS_OLD>&#xa;                            &lt;CODICE_QUALITA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_QUALITA&quot;/>&#xa;                            &lt;/CODICE_QUALITA>&#xa;                            &lt;CODICE_DELIVERY>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_DELIVERY&quot;/>&#xa;                            &lt;/CODICE_DELIVERY>&#xa;                            &lt;CAMPO_SERV_IT>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CAMPO_SERV_IT&quot;/>&#xa;                            &lt;/CAMPO_SERV_IT>&#xa;                            &lt;QUANTITA>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer($FONIA_ACCESSO/Record[1]/QUANTITA)&quot;/>&#xa;                            &lt;/QUANTITA>&#xa;                            &lt;CODE_DONOR>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_DONOR&quot;/>&#xa;                            &lt;/CODE_DONOR>&#xa;                            &lt;CODE_DONATING>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_DONATING&quot;/>&#xa;                            &lt;/CODE_DONATING>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[1]/CODICE_IDSLUCO&quot;>&#xa;                                &lt;CODE_ID_SLUCO>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_IDSLUCO&quot;/>&#xa;                                &lt;/CODE_ID_SLUCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/FLAG_MANTENIMENTO_STS&quot;/>&#xa;                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[1]/FLAG_PERMUTA_ARMADIO&quot;>&#xa;                                &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                                &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[1]/TIPO_CESSAZIONE&quot;>&#xa;                                &lt;TIPO_CESSAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/TIPO_CESSAZIONE&quot;/>&#xa;                                &lt;/TIPO_CESSAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[1]/FLAG_NP_SUCCESSIVA_PURA&quot;>&#xa;                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/FLAG_NP_SUCCESSIVA_PURA&quot;/>&#xa;                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/FLAG_LA&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[1]/TIPO_LINEA_NUM_AGG&quot;>&#xa;                                &lt;TIPO_LINEA_NUM_AGG>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/TIPO_LINEA_NUM_AGG&quot;/>&#xa;                                &lt;/TIPO_LINEA_NUM_AGG>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[1]/FLAG_4_REFERENTE&quot;>&#xa;                                &lt;FLAG_4REFERENTE>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/FLAG_4_REFERENTE&quot;/>&#xa;                                &lt;/FLAG_4REFERENTE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[1]/CODICE_HOSTING&quot;>&#xa;                                &lt;CODE_HOSTING>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/CODICE_HOSTING&quot;/>&#xa;                                &lt;/CODE_HOSTING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[1]/TIPO_CLUSTER&quot;>&#xa;                                &lt;TIPO_CLUSTER>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[1]/TIPO_CLUSTER&quot;/>&#xa;                                &lt;/TIPO_CLUSTER>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:for-each select=&quot;$FONIA_AGG/Record&quot;>&#xa;                                &lt;tns1:AGG>&#xa;                                    &lt;AGGIUNTIVO>&#xa;                                        &lt;xsl:value-of select=&quot;AGGIUNTIVO&quot;/>&#xa;                                    &lt;/AGGIUNTIVO>&#xa;                                &lt;/tns1:AGG>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:for-each select=&quot;$FONIA_STS/Record&quot;>&#xa;                                &lt;tns1:STS>&#xa;                                    &lt;TIPO_AZIONE>&#xa;                                        &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                    &lt;/TIPO_AZIONE>&#xa;                                    &lt;FLAG_LINEA_NUM_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_LINEA_NUMAGG&quot;/>&#xa;                                    &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                    &lt;ID_RIS_AGGIUNTIVA>&#xa;                                        &lt;xsl:value-of select=&quot;IDRISORSA_AGGIUNTIVA&quot;/>&#xa;                                    &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                    &lt;CODE_STS>&#xa;                                        &lt;xsl:value-of select=&quot;CODICE_STS&quot;/>&#xa;                                    &lt;/CODE_STS>&#xa;                                &lt;/tns1:STS>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns1:ACCESSO>&#xa;                    &lt;/tns1:TESTATA>&#xa;                &lt;/tns1:REGOLATORIO>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:jpub="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="jpub:REGOLATORIO" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="GenericLogger5-input"
                                    name="GenericLogger5"
                                    tibex:xpdlId="21b6ff1d-e695-4ccf-aacc-eb7c762a60eb"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Mapper3ToGenericLogger5"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLogger5ToLogEvento"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper3&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.tool.billing.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'ElaborazioneEventi'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Evento non stst',tib:render-xml($Mapper3, true(),true()))&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:scope name="While4"
                                    tibex:group="while" tibex:xpdlId="8498cc7a-dad6-4fa2-b834-95f6af631bb6">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLogger2ToWhile4"/>
                                    <bpws:target linkName="JDBCQueryToWhile4"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="While4ToMapper3"/>
                                    </bpws:sources>
                                    <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    </bpws:variables>
                                    <bpws:sequence name="sequence4" tibex:group="while">
                                    <bpws:assign
                                    name="GroupInit4"
                                    tibex:group="groupInit" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+25e95b62-6e3a-4b52-b51a-b220bbe358e0" version="2.0"> <xsl:template name="Accumulate3" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate3"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:while name="while4" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($FONIA_ACCESSO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($FONIA_ACCESSO/Record)]]></bpws:condition>
                                    <bpws:flow name="flow8">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart5ToMapper5" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Mapper5ToGenericLogger6" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GenericLogger6ToAccumulate3" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart5"
                                    tibex:group="groupStart" tibex:xpdlId="f97ac1d9-cad0-40f1-9331-95ba947b651a">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart5ToMapper5"/>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    name="Accumulate3"
                                    outputVariable="Accumulate3"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="25e95b62-6e3a-4b52-b51a-b220bbe358e0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="GenericLogger6ToAccumulate3"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>

                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper5</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="Mapper5-input"
                                    name="Mapper5"
                                    outputVariable="Mapper5"
                                    tibex:xpdlId="969dc2dd-abfb-42fd-98bd-2d37b4518ffc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>

                                    <bpws:target linkName="GroupStart5ToMapper5"/>
                                    </bpws:targets>
                                    <bpws:sources>

                                    <bpws:source linkName="Mapper5ToGenericLogger6"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FONIA_ACCESSO&quot;/>&#xa;    &lt;xsl:param name=&quot;FONIA_TESTATA&quot;/>&#xa;    &lt;xsl:param name=&quot;FONIA_AGG&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;FONIA_STS&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:REGOLATORIO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($FONIA_ACCESSO/Record[TIPO_CONTRATTO!='7' and TIPO_CONTRATTO!='41' ])&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_CONTRATTO='7'&quot;>&#xa;                            &lt;tns1:TESTATA>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[CODE_CAUS='1'][1]/ID_ORDINE_CRMWS&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[CODE_CAUS='1'][1]/DATA_DRO&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                                &lt;DATA_MSG>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[CODE_CAUS='1'][1]/DATA_MSG&quot;/>&#xa;                                &lt;/DATA_MSG>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[CODE_CAUS='1'][1]/DATA_DES&quot;/>&#xa;                                &lt;/DATA_DES>&#xa;                                &lt;CODE_CAUS>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[CODE_CAUS='1'][1]/CODE_CAUS&quot;/>&#xa;                                &lt;/CODE_CAUS>&#xa;                                &lt;CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[CODE_CAUS='1'][1]/CODICE_ORDINE_ISP&quot;/>&#xa;                                &lt;/CODICE_ORDINE_ISP>&#xa;                                &lt;CODICE_PROGETTO>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[CODE_CAUS='1'][1]/CODICE_PROGETTO&quot;/>&#xa;                                &lt;/CODICE_PROGETTO>&#xa;                                &lt;tns1:ACCESSO>&#xa;                                    &lt;TIPO_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_CONTRATTO&quot;/>&#xa;                                    &lt;/TIPO_CONTR>&#xa;                                    &lt;CODE_CONTR>&#xa;                                        &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_CONTRATTO&quot;/>&#xa;                                    &lt;/CODE_CONTR>&#xa;                                    &lt;CODE_CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_CLLI&quot;/>&#xa;                                    &lt;/CODE_CLLI>&#xa;                                    &lt;CODE_PREST_AGG>&#xa;                                        &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/COD_PRESTAZIONI_AGGIUNTIVE&quot;/>&#xa;                                    &lt;/CODE_PREST_AGG>&#xa;                                    &lt;ID_RIS>&#xa;                                        &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/ID_RISORSA&quot;/>&#xa;                                    &lt;/ID_RIS>&#xa;    