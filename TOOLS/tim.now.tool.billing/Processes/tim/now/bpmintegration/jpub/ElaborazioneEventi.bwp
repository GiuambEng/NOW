                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RECUPERO_JPUB_MASTER"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ASSET_RICARICA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BDS_ID_ASSET"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
