                                    sqlStatement="SELECT ID_ORDINE_CRMWS,ID_RECUPERO_JPUB_MASTER,ID_ASSET_RICARICA,BDS_ID_ASSET,ID_RICHIESTA_OLO,ID_TIPOLOGIA_ACCESSO&#xa;FROM BO_TOOL_RECUPERO_JPUB_MASTER &#xa;WHERE STATO_BO_TOOL_RECUPERO_JPUB='VERIFICATO BO'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
