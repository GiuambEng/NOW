                                    expression="(exists($Evento) and  substring-after($Evento/ns20:TESTATA[1]/ID_ORD_CRMWS, '-')='1' ) or (exists($Mapper3) and substring-after($Mapper3/ns44:TESTATA[1]/ID_ORD_CRMWS, '-')='1' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(exists($Evento) and  substring-after($Evento/ns20:TESTATA[1]/ID_ORD_CRMWS, '-')='1' ) or (exists($Mapper3) and substring-after($Mapper3/ns44:TESTATA[1]/ID_ORD_CRMWS, '-')='1' )]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty1ToJDBCUpdate1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
