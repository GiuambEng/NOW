                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO EVENTO_JPUB(IDDETTAGLIOORDINE, ID_RISORSA, ID_RICH_OLO, NUMERO_TENTATIVI, TIMSTP_INSMTO_EVENTO, &#xd;&#xa;ID_EVENTO_ORDN_NOW_WHLS, ID_RICH_JPUB, IDTPLG_STATO_EVENTO_JPUB,FLAG_CONSUNTIVO,STRUTTURA_OFFERTA,OFFERTA,&#xd;&#xa;CONTENUTO_XML,ID_ORDINE_COMPOSTO ,TIPO_AZIONE,CODICE_CAUSALE)&#xd;&#xa;VALUES(?, ?, ?, ?, ?, ?, (S_ID_RICH_JPUB.NEXTVAL),(SELECT IDTPLG_STATO_EVENTO_JPUB &#xd;&#xa;FROM TIPOLG_STATO_EVENTO_JPUB WHERE DESCR_STATO_EVENTO_JPUB = ?),?,?,?,?,&#xd;&#xa;?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDDETTAGLIOORDINE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_TENTATIVI"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO_EVENTO"/>

                                    <PreparedParameters
