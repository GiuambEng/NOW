 &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_CLUSTER&quot;/>&#xa;                                        &lt;/TIPO_CLUSTER>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns1:ACCESSO>&#xa;                            &lt;/tns1:TESTATA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:TESTATA>&#xa;                        &lt;ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/ID_ORDINE_CRMWS&quot;/>&#xa;                        &lt;/ID_ORD_CRMWS>&#xa;                        &lt;DATA_DRO>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/DATA_DRO&quot;/>&#xa;                        &lt;/DATA_DRO>&#xa;                        &lt;DATA_MSG>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/DATA_MSG&quot;/>&#xa;                        &lt;/DATA_MSG>&#xa;                        &lt;DATA_DES>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/DATA_DES&quot;/>&#xa;                        &lt;/DATA_DES>&#xa;                        &lt;CODE_CAUS>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/CODE_CAUS&quot;/>&#xa;                        &lt;/CODE_CAUS>&#xa;                        &lt;CODICE_ORDINE_ISP>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/CODICE_ORDINE_ISP&quot;/>&#xa;                        &lt;/CODICE_ORDINE_ISP>&#xa;                        &lt;CODICE_PROGETTO>&#xa;                            &lt;xsl:value-of select=&quot;$FONIA_TESTATA/Record[1]/CODICE_PROGETTO&quot;/>&#xa;                        &lt;/CODICE_PROGETTO>&#xa;                        &lt;tns1:ACCESSO>&#xa;                            &lt;TIPO_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_CONTRATTO&quot;/>&#xa;                            &lt;/TIPO_CONTR>&#xa;                            &lt;CODE_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_CONTRATTO&quot;/>&#xa;                            &lt;/CODE_CONTR>&#xa;                            &lt;CODE_CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_CLLI&quot;/>&#xa;                            &lt;/CODE_CLLI>&#xa;                            &lt;CODE_PREST_AGG>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/COD_PRESTAZIONI_AGGIUNTIVE&quot;/>&#xa;                            &lt;/CODE_PREST_AGG>&#xa;                            &lt;ID_RIS>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/ID_RISORSA&quot;/>&#xa;                            &lt;/ID_RIS>&#xa;                            &lt;ID_RIS_PRINC>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/ID_RISORSA_PRINCIPALE&quot;/>&#xa;                            &lt;/ID_RIS_PRINC>&#xa;                            &lt;CODE_GEST_REC>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_GESTORE_REC&quot;/>&#xa;                            &lt;/CODE_GEST_REC>&#xa;                            &lt;TIPO_FAMIGLIA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_FAMIGLIA&quot;/>&#xa;                            &lt;/TIPO_FAMIGLIA>&#xa;                            &lt;OPZ_COMM>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/OPZIONE_COMMERCIALE&quot;/>&#xa;                            &lt;/OPZ_COMM>&#xa;                            &lt;TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_LINEA&quot;/>&#xa;                            &lt;/TIPO_LINEA>&#xa;                            &lt;FLAG_NP>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_NP&quot;/>&#xa;                            &lt;/FLAG_NP>&#xa;                            &lt;SUB_TIPO_LINEA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/SUB_TIPO_LINEA&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA>&#xa;                            &lt;SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/SUB_TIPO_LINEA_RESIDENZIALE&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                            &lt;SUB_TIPO_LINEA_DIREZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/SUB_TIPO_LINEA_DIREZIONE&quot;/>&#xa;                            &lt;/SUB_TIPO_LINEA_DIREZIONE>&#xa;                            &lt;MOD_VENDITA_ACCESSO>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/MOD_VENDITA_ACCESSO&quot;/>&#xa;                            &lt;/MOD_VENDITA_ACCESSO>&#xa;                            &lt;TIPO_AZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_AZIONE&quot;/>&#xa;                            &lt;/TIPO_AZIONE>&#xa;                            &lt;DATA_INIZIO_NOL>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/DATA_INIZIO_NOL&quot;/>&#xa;                            &lt;/DATA_INIZIO_NOL>&#xa;                            &lt;CODE_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_COMUNE&quot;/>&#xa;                            &lt;/CODE_COMUNE>&#xa;                            &lt;CODE_ID_ULLCO>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_IDULLCO&quot;/>&#xa;                            &lt;/CODE_ID_ULLCO>&#xa;                            &lt;CODE_DISTR>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_DISTRETTO&quot;/>&#xa;                            &lt;/CODE_DISTR>&#xa;                            &lt;FLAG_PERMUTA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_PERMUTA&quot;/>&#xa;                            &lt;/FLAG_PERMUTA>&#xa;                            &lt;FLAG_MIGRAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_MIGRAZIONE&quot;/>&#xa;                            &lt;/FLAG_MIGRAZIONE>&#xa;                            &lt;FLAG_QUALIFICAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_QUALIFICAZIONE&quot;/>&#xa;                            &lt;/FLAG_QUALIFICAZIONE>&#xa;                            &lt;ID_RIS_OLD>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/ID_RISORSA_OLD&quot;/>&#xa;                            &lt;/ID_RIS_OLD>&#xa;                            &lt;CODICE_QUALITA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_QUALITA&quot;/>&#xa;                            &lt;/CODICE_QUALITA>&#xa;                            &lt;CODICE_DELIVERY>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_DELIVERY&quot;/>&#xa;                            &lt;/CODICE_DELIVERY>&#xa;                            &lt;CAMPO_SERV_IT>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CAMPO_SERV_IT&quot;/>&#xa;                            &lt;/CAMPO_SERV_IT>&#xa;                            &lt;QUANTITA>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer($FONIA_ACCESSO/Record[$index1]/QUANTITA)&quot;/>&#xa;                            &lt;/QUANTITA>&#xa;                            &lt;CODE_DONOR>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_DONOR&quot;/>&#xa;                            &lt;/CODE_DONOR>&#xa;                            &lt;CODE_DONATING>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_DONATING&quot;/>&#xa;                            &lt;/CODE_DONATING>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_IDSLUCO&quot;>&#xa;                                &lt;CODE_ID_SLUCO>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_IDSLUCO&quot;/>&#xa;                                &lt;/CODE_ID_SLUCO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;FLAG_MANTENIMENTO_STS>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_MANTENIMENTO_STS&quot;/>&#xa;                            &lt;/FLAG_MANTENIMENTO_STS>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_PERMUTA_ARMADIO&quot;>&#xa;                                &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                                &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_CESSAZIONE&quot;>&#xa;                                &lt;TIPO_CESSAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_CESSAZIONE&quot;/>&#xa;                                &lt;/TIPO_CESSAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_NP_SUCCESSIVA_PURA&quot;>&#xa;                                &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_NP_SUCCESSIVA_PURA&quot;/>&#xa;                                &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;FLAG_LA>&#xa;                                &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_LA&quot;/>&#xa;                            &lt;/FLAG_LA>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_LINEA_NUM_AGG&quot;>&#xa;                                &lt;TIPO_LINEA_NUM_AGG>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_LINEA_NUM_AGG&quot;/>&#xa;                                &lt;/TIPO_LINEA_NUM_AGG>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_4_REFERENTE&quot;>&#xa;                                &lt;FLAG_4REFERENTE>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/FLAG_4_REFERENTE&quot;/>&#xa;                                &lt;/FLAG_4REFERENTE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_HOSTING&quot;>&#xa;                                &lt;CODE_HOSTING>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/CODICE_HOSTING&quot;/>&#xa;                                &lt;/CODE_HOSTING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_CLUSTER&quot;>&#xa;                                &lt;TIPO_CLUSTER>&#xa;                                    &lt;xsl:value-of select=&quot;$FONIA_ACCESSO/Record[$index1]/TIPO_CLUSTER&quot;/>&#xa;                                &lt;/TIPO_CLUSTER>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:for-each select=&quot;$FONIA_AGG/Record&quot;>&#xa;                                &lt;tns1:AGG>&#xa;                                    &lt;AGGIUNTIVO>&#xa;                                        &lt;xsl:value-of select=&quot;AGGIUNTIVO&quot;/>&#xa;                                    &lt;/AGGIUNTIVO>&#xa;                                &lt;/tns1:AGG>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($FONIA_ACCESSO/Record[$index1]/ID_RISORSA_PRINCIPALE)=0&quot;>&#xa;                                    &lt;xsl:for-each select=&quot;$FONIA_STS/Record[FLAG_LINEA_NUMAGG='0']&quot;>&#xa;                                        &lt;tns1:STS>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                            &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_LINEA_NUMAGG&quot;/>&#xa;                                            &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;xsl:value-of select=&quot;IDRISORSA_AGGIUNTIVA&quot;/>&#xa;                                            &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;CODE_STS>&#xa;                                                &lt;xsl:value-of select=&quot;CODICE_STS&quot;/>&#xa;                                            &lt;/CODE_STS>&#xa;                                        &lt;/tns1:STS>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:for-each select=&quot;$FONIA_STS/Record[not(FLAG_LINEA_NUMAGG='0')]&quot;>&#xa;                                        &lt;tns1:STS>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                            &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_LINEA_NUMAGG&quot;/>&#xa;                                            &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;xsl:value-of select=&quot;IDRISORSA_AGGIUNTIVA&quot;/>&#xa;                                            &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;CODE_STS>&#xa;                                                &lt;xsl:value-of select=&quot;CODICE_STS&quot;/>&#xa;                                            &lt;/CODE_STS>&#xa;                                        &lt;/tns1:STS>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns1:ACCESSO>&#xa;                    &lt;/tns1:TESTATA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:REGOLATORIO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                                    xmlns:jpub="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>

