                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="StoricizzazioneEventi-input"
                                    name="StoricizzazioneEventi"
                                    outputVariable="StoricizzazioneEventi"
                                    tibex:xpdlId="e3520935-8cd9-4f49-82dd-63deae9e2b73" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogStrutturaRichToJDBCUpdate1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="StoricizzazioneEventiToEmpty4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e3520935-8cd9-4f49-82dd-63deae9e2b73+input&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Evento&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Estrazione&quot;/>&#xa;    &lt;xsl:param name=&quot;StoricizzaEventoOrdnNowWhlsSub&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:param name=&quot;StrutturaRich&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper3&quot;/>&#xa;    &lt;xsl:template name=&quot;StoricizzazioneEventi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($Mapper3/ns1:TESTATA[1]/ID_ORD_CRMWS, 'pvm:')&quot;>&#xa;                    &lt;IDDETTAGLIOORDINE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(substring-after($Mapper3/ns1:TESTATA[1]/ID_ORD_CRMWS, '-'))&quot;/>&#xa;                    &lt;/IDDETTAGLIOORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;contains($Evento/tns:TESTATA[1]/ID_ORD_CRMWS, 'pvm:')&quot;>&#xa;                    &lt;IDDETTAGLIOORDINE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:decimal(substring-after($Evento/tns:TESTATA[1]/ID_ORD_CRMWS, '-'))&quot;/>&#xa;                    &lt;/IDDETTAGLIOORDINE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDDETTAGLIOORDINE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Mapper3)&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Mapper3/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper3/ns1:TESTATA[1]/ns1:ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Evento/tns:TESTATA/tns:ACCESSO)&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Evento/tns:TESTATA[1]/tns:ACCESSO[1]/ID_RIS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Evento/tns:TESTATA[1]/tns:ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Evento/tns:TESTATA[1]/tns:EVENTI/ID_RIS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Evento/tns:TESTATA[1]/tns:EVENTI/ID_RIS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Estrazione/Record[$index]/ID_RICHIESTA_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Estrazione/Record[$index]/ID_RICHIESTA_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;NUMERO_TENTATIVI>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/NUMERO_TENTATIVI>&#xa;            &lt;TIMSTP_INSMTO_EVENTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO_EVENTO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($StoricizzaEventoOrdnNowWhlsSub/IDEventoOrdnNowWhls)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$StoricizzaEventoOrdnNowWhlsSub/IDEventoOrdnNowWhls&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;'DA_INVIARE'&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;FLAG_CONSUNTIVO>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/FLAG_CONSUNTIVO>&#xa;            &lt;STRUTTURA_OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($StrutturaRich/Record[1]/STRUTTURA_RICH)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$StrutturaRich/Record[1]/STRUTTURA_RICH&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/STRUTTURA_OFFERTA>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Offerta/Record[1]/OFFERTA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Offerta/Record[1]/OFFERTA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Mapper3)&quot;>&#xa;                    &lt;CONTENUTO_XML>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Mapper3, true(), true())&quot;/>&#xa;                    &lt;/CONTENUTO_XML>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_XML>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Evento, true(), true())&quot;/>&#xa;                    &lt;/CONTENUTO_XML>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Mapper3)&quot;>&#xa;                    &lt;ID_ORDINE_COMPOSTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Mapper3/ns1:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper3/ns1:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ORDINE_COMPOSTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Evento/tns:TESTATA[1]/ID_ORD_CRMWS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Evento/tns:TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ORDINE_COMPOSTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Mapper3/ns1:TESTATA[1]/ns1:ACCESSO[1]/TIPO_AZIONE)>0&quot;>&#xa;                    &lt;TIPO_AZIONE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Mapper3/ns1:TESTATA[1]/ns1:ACCESSO[1]/TIPO_AZIONE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper3/ns1:TESTATA[1]/ns1:ACCESSO[1]/TIPO_AZIONE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPO_AZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Evento/tns:TESTATA[1]/tns:ACCESSO[1]/TIPO_AZIONE)>0&quot;>&#xa;                    &lt;TIPO_AZIONE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Evento/tns:TESTATA[1]/tns:ACCESSO[1]/TIPO_AZIONE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Evento/tns:TESTATA[1]/tns:ACCESSO[1]/TIPO_AZIONE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/TIPO_AZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPO_AZIONE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Mapper3)&quot;>&#xa;                    &lt;CODICE_CAUSALE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Mapper3/ns1:TESTATA[1]/CODE_CAUS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper3/ns1:TESTATA[1]/CODE_CAUS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_CAUSALE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODICE_CAUSALE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Evento/tns:TESTATA[1]/CODE_CAUS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Evento/tns:TESTATA[1]/CODE_CAUS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICE_CAUSALE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
