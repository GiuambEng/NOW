                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToScope"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ScopeToGroupEnd"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="FaultName1"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns:FaultDetail"
                                    name="FaultDetails1" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails1"
                                    tibex:faultNameVar="FaultName1" tibex:xpdlId="05c9f391-175c-4e9c-ae90-50c50100e0a8">
                                    <bpws:scope name="scope2">
                                    <bpws:flow name="flow6">
                                    <bpws:links>
                                    <bpws:link
                                    name="GenericLogger1ToJDBCUpdate2" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="UpdateKO-input"
                                    name="UpdateKO"
                                    outputVariable="UpdateKO"
                                    tibex:xpdlId="e91c2a87-b4a2-4d3b-93a2-7503ea00f05c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLogger1ToJDBCUpdate2"/>
                                    </bpws:targets>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e91c2a87-b4a2-4d3b-93a2-7503ea00f05c+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Estrazione&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcUpdateActivityInput>&#xa;            &lt;TMSP_AGGIORNAMENTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TMSP_AGGIORNAMENTO>&#xa;            &lt;DESC_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;$FaultDetails1&quot;/>&#xa;            &lt;/DESC_ERRORE>&#xa;            &lt;ID_RECUPERO_JPUB_MASTER>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Estrazione/Record[$index]/ID_RECUPERO_JPUB_MASTER)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Estrazione/Record[$index]/ID_RECUPERO_JPUB_MASTER&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RECUPERO_JPUB_MASTER>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>

                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE BO_TOOL_RECUPERO_JPUB_MASTER&#xa;SET STATO_BO_TOOL_RECUPERO_JPUB='INVIATO KO',TMSP_AGGIORNAMENTO=?,DESC_ERRORE=?  &#xa;WHERE &#xa;STATO_BO_TOOL_RECUPERO_JPUB='IN ELABORAZIONE' AND&#xa;ID_RECUPERO_JPUB_MASTER=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TMSP_AGGIORNAMENTO"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESC_ERRORE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RECUPERO_JPUB_MASTER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="GenericLogger1-input"
                                    name="GenericLogger1"
                                    tibex:xpdlId="e5fbf74f-98ee-4bc6-bde0-9d1eae83be27"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLogger1ToJDBCUpdate2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

