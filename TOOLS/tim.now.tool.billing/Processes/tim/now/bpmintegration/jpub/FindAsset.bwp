                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://api.bds.tibco.com" xmlns:tns="http://services.bds.tibco.com/BusinessDataServices_1.2.0" version="2.0"&gt;&lt;xsl:param name="FindAsset"/&gt;&lt;xsl:template name="ReadAsset-input" match="/"&gt;&lt;tns:readCaseRequest&gt;&lt;readCaseRequest&gt;&lt;ns:ReadCaseRequest&gt;&lt;xsl:for-each select="$FindAsset/findCaseByCriteriaResponse/ns:FindCaseByCriteriaResponse/caseReference"&gt;&lt;caseReference&gt;&lt;xsl:value-of select="."/&gt;&lt;/caseReference&gt;&lt;/xsl:for-each&gt;&lt;/ns:ReadCaseRequest&gt;&lt;/readCaseRequest&gt;&lt;/tns:readCaseRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
