                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindRequest/&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ReadAsset&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&lt;tns1:Output>&lt;tns1:Find>&lt;xsl:if test=&quot;$ReadAsset/readCaseResponse/ns:ReadCaseResponse/caseData[$index]/caseReference&quot;>&lt;tns1:CaseReference>&lt;xsl:value-of select=&quot;$ReadAsset/readCaseResponse/ns:ReadCaseResponse/caseData[$index]/caseReference&quot;/>&lt;/tns1:CaseReference>&lt;/xsl:if>&lt;tns1:Response>&lt;tns1:Esito>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:Esito>&lt;tns1:DescrizioneEsito>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:DescrizioneEsito>&lt;/tns1:Response>&lt;tns1:Asset>&lt;xsl:if test=&quot;$ParseXml/IDAsset&quot;>&lt;IDAsset>&lt;xsl:value-of select=&quot;$ParseXml/IDAsset&quot;/>&lt;/IDAsset>&lt;/xsl:if>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;$ParseXml/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$ParseXml/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$ParseXml/invariante&quot;>&lt;invariante>&lt;xsl:value-of select=&quot;$ParseXml/invariante&quot;/>&lt;/invariante>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;$ParseXml/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$ParseXml/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$ParseXml/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$ParseXml/operat