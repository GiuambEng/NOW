                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindRequest/&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReadAsset.readCaseResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Output>&#xa;            &lt;tns1:Find>&#xa;                &lt;xsl:if test=&quot;$ReadAsset.readCaseResponse/caseData[$index]/caseReference&quot;>&#xa;                    &lt;tns1:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$ReadAsset.readCaseResponse/caseData[$index]/caseReference&quot;/>&#xa;                    &lt;/tns1:CaseReference>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:Response>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns1:Esito>&#xa;                    &lt;tns1:DescrizioneEsito>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns1:DescrizioneEsito>&#xa;                &lt;/tns1:Response>&#xa;                &lt;tns1:Asset>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/IDAsset&quot;>&#xa;                        &lt;IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/IDAsset&quot;/>&#xa;                        &lt;/IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/codiceOrdineTI&quot;>&#xa;                        &lt;codiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/codiceOrdineTI&quot;/>&#xa;                        &lt;/codiceOrdineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/invariante&quot;>&#xa;                        &lt;invariante>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/invariante&quot;/>&#xa;                        &lt;/invariante>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/lastUpdate&quot;>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/IDRichiestaOLO&quot;>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/IDPrimoOrdine&quot;>&#xa;                        &lt;IDPrimoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/IDPrimoOrdine&quot;/>&#xa;                        &lt;/IDPrimoOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;IDContratto>&#xa;                        &lt;xsl:value-of select=&quot