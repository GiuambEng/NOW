                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE TRACC_BONIFICA_JPUB&#xa;  SET DESC_ERRORE = ?, DATA_AGGIORNAMENTO = ?, NOTE_BONIFICA = ?&#xa;  WHERE NOME_TABELLA_BONIFICATA = ? AND NOME_TOOLS_BONIFICA = ? AND ID_RECORD = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

