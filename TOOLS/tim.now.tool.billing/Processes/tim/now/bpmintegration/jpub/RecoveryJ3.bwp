                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2340214d-1fd5-4a2b-8473-b791349e5dcb+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IDRecord&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;DESC_ERRORE>&lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName,$FaultDetails/ProcessStack,$FaultDetails/StackTrace)&quot;/>&lt;/DESC_ERRORE>&lt;DATA_AGGIORNAMENTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/DATA_AGGIORNAMENTO>&lt;NOTE_BONIFICA>&lt;xsl:value-of select=&quot;'KO_INVIO'&quot;/>&lt;/NOTE_BONIFICA>&lt;NOME_TABELLA_BONIFICATA>&lt;xsl:value-of select=&quot;'EVENTO_JPUB'&quot;/>&lt;/NOME_TABELLA_BONIFICATA>&lt;NOME_TOOLS_BONIFICA>&lt;xsl:value-of select=&quot;'INVIOJ3'&quot;/>&lt;/NOME_TOOLS_BONIFICA>&lt;ID_RECORD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IDRecord/Record[1]/NEXTVAL)&quot;>&lt;xsl:value-of select=&quot;$IDRecord/Record[1]/NEXTVAL&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RECORD>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
