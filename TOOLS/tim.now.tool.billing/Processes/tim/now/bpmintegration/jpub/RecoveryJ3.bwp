            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="5d0f0ffa-595c-4f8d-a732-d5af8cef5265">
                <bpws:targets>
                    <bpws:target linkName="JDBCUpdateToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEndRecoveryJ3"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Invio/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Invio/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToControlloEventi" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogRequestToEmpty" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ControlToWhile2" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="ControlToEmpty" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="WaitingToUpdateEstrazioneKO_Name"
                                    tibex:label="" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LavorazioneToWhile2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="LavorazioneToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCQueryToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess1ToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="LogControlWaitingToEvento" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="LogEventoToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="LogEventoToIDRecord"
