                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_TABELLA_BONIFICATA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_TOOLS_BONIFICA"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RECORD"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
