                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+805eabd1-338b-432d-a21a-5ebda0fa5896+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT E.ID_RICH_OLO ,E.ID_ORDINE_COMPOSTO,E.ID_RISORSA,S.TIPO_CONTR,S.CODE_CONTR,S.ID_ORD_CRMWS,DATA_DRO,DATA_DES,&#xd;&#xa;OPZ_COMM,TIPO_FAMIGLIA,TIPO_LINEA,SUB_TIPO_LINEA,SUB_TIPO_LINEA_RESIDENZIALE,SUB_TIPO_LINEA_DIREZIONE,MOD_VENDITA_ACCESSO,&#xd;&#xa;FLAG_PERMUTA,FLAG_PERMUTA_ARMADIO,FLAG_MIGRAZIONE,FLAG_QUALIFICAZIONE,FLAG_NP,FLAG_LA&#xd;&#xa;FROM &#xd;&#xa;ESTRAZIONI_JPUB E,STAGING_JPUB_SCARTI_J3_FILE S WHERE E.FLAG='Y' AND E.TOOL='INVIOJ3'&#xd;&#xa;AND E.ID_RISORSA=S.IDRISORSA" xsi:type="jdbcPalette:JDBCQueryActivity">
