            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="13842e51-6ba8-4a29-8fc9-75632acb8e74">
                <bpws:targets>
                    <bpws:target linkName="LogParseDataToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToAssign3">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+f9169c05-0cb2-4654-92bd-7311909b52f8" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($ParseData/Rows/tns:Input)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($ParseData/Rows/tns:Input)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="RenderdataToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToRenderdata" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogAccumulateToAccumulate" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="859f3c0b-9e0a-4a7c-96a2-e6cab90df850">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToRenderdata"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="f9169c05-0cb2-4654-92bd-7311909b52f8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogAccumulateToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Renderdata-input"
                                    name="Renderdata"
                                    outputVariable="Renderdata"
                                    tibex:xpdlId="df548a37-5c03-4a33-9a4e-a00f1cb3feba" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToRenderdata"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderdataToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ContenutoFileJ3/&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/activity/render/xsd/+df548a37-5c03-4a33-9a4e-a00f1cb3feba+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseData&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Rows>&#xa;            &lt;tns:Input>&#xa;                &lt;tns:Input>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:TIPO_CONTR&quot;>&#xa;                        &lt;tns:TIPO_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:TIPO_CONTR&quot;/>&#xa;                        &lt;/tns:TIPO_CONTR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:CODE_CONTR&quot;>&#xa;                        &lt;tns:CODE_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:CODE_CONTR&quot;/>&#xa;                        &lt;/tns:CODE_CONTR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:IDRISORSA&quot;>&#xa;                        &lt;tns:IDRISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:IDRISORSA&quot;/>&#xa;                        &lt;/tns:IDRISORSA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:ID_ORD_CRMWS&quot;>&#xa;                        &lt;tns:ID_ORD_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:ID_ORD_CRMWS&quot;/>&#xa;                        &lt;/tns:ID_ORD_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:DATA_DRO&quot;>&#xa;                        &lt;tns:DATA_DRO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:DATA_DRO&quot;/>&#xa;                        &lt;/tns:DATA_DRO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:DATA_DES&quot;>&#xa;                        &lt;tns:DATA_DES>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:DATA_DES&quot;/>&#xa;                        &lt;/tns:DATA_DES>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:OPZ_COMM&quot;>&#xa;                        &lt;tns:OPZ_COMM>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:OPZ_COMM&quot;/>&#xa;                        &lt;/tns:OPZ_COMM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:TIPO_FAMIGLIA&quot;>&#xa;                        &lt;tns:TIPO_FAMIGLIA>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:TIPO_FAMIGLIA&quot;/>&#xa;                        &lt;/tns:TIPO_FAMIGLIA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:TIPO_LINEA&quot;>&#xa;                        &lt;tns:TIPO_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:TIPO_LINEA&quot;/>&#xa;                        &lt;/tns:TIPO_LINEA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:SUB_TIPO_LINEA&quot;>&#xa;                        &lt;tns:SUB_TIPO_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:SUB_TIPO_LINEA&quot;/>&#xa;                        &lt;/tns:SUB_TIPO_LINEA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:SUB_TIPO_LINEA_RESIDENZIALE&quot;>&#xa;                        &lt;tns:SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:SUB_TIPO_LINEA_RESIDENZIALE&quot;/>&#xa;                        &lt;/tns:SUB_TIPO_LINEA_RESIDENZIALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:SUB_TIPO_LINEA_DIREZIONE&quot;>&#xa;                        &lt;tns:SUB_TIPO_LINEA_DIREZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:SUB_TIPO_LINEA_DIREZIONE&quot;/>&#xa;                        &lt;/tns:SUB_TIPO_LINEA_DIREZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:MOD_VENDITA_ACCESSO&quot;>&#xa;                        &lt;tns:MOD_VENDITA_ACCESSO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:MOD_VENDITA_ACCESSO&quot;/>&#xa;                        &lt;/tns:MOD_VENDITA_ACCESSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_PERMUTA&quot;>&#xa;                        &lt;tns:FLAG_PERMUTA>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_PERMUTA&quot;/>&#xa;                        &lt;/tns:FLAG_PERMUTA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_PERMUTA_ARMADIO&quot;>&#xa;                        &lt;tns:FLAG_PERMUTA_ARMADIO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                        &lt;/tns:FLAG_PERMUTA_ARMADIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_MIGRAZIONE&quot;>&#xa;                        &lt;tns:FLAG_MIGRAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_MIGRAZIONE&quot;/>&#xa;                        &lt;/tns:FLAG_MIGRAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_QUALIFICAZIONE&quot;>&#xa;                        &lt;tns:FLAG_QUALIFICAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_QUALIFICAZIONE&quot;/>&#xa;                        &lt;/tns:FLAG_QUALIFICAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_NP&quot;>&#xa;                        &lt;tns:FLAG_NP>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_NP&quot;/>&#xa;                        &lt;/tns:FLAG_NP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_LA&quot;>&#xa;                        &lt;tns:FLAG_LA>&#xa;                            &lt;xsl:value-of select=&quot;$ParseData/Rows/tns:Input[number($index)]/tns:Input/tns:FLAG_LA&quot;/>&#xa;                        &lt;/tns:FLAG_LA>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:Input>&#xa;            &lt;/tns:Input>&#xa;        &lt;/tns1:Rows>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.renderdata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//RenderData"/>
                                    <value
                                    dataFormat="dataFormatResource" xsi:type="parse:RenderData"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogRenderdata-input"
                                    name="LogRenderdata"
                                    tibex:xpdlId="690266a8-8ef1-4fe7-9d3b-6d1dc3621dcd"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderdataToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Renderdata&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.tool.billing.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'FlowJ3'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'FlowJ3'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'FlowJ3'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Renderdata',$Renderdata)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="9e26b4e3-fb29-4fa8-ac4c-6fa60dbece36" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToCallProcess">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ContenutoRecord/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ContenutoFileJ3/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseData&quot;/>&lt;xsl:param name=&quot;Renderdata&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Request>&lt;tns:ContenutoRecord>&lt;xsl:value-of select=&quot;$Renderdata&quot;/>&lt;/tns:ContenutoRecord>&lt;tns:NumeroRecord>&lt;xsl:value-of select=&quot;$index&quot;/>&lt;/tns:NumeroRecord>&lt;xsl:if test=&quot;$ParseData/Rows/tns1:Input[number($index)]/tns1:Input/tns1:TIPO_CONTR&quot;>&lt;tns:TIPO_CONTR>&lt;xsl:value-of select=&quot;$ParseData/Rows/tns1:Input[number($index)]/tns1:Input/tns1:TIPO_CONTR&quot;/>&lt;/tns:TIPO_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseData/Rows/tns1:Input[number($index)]/tns1:Input/tns1:CODE_CONTR&quot;>&lt;tns:CODE_CONTR>&lt;xsl:value-of select=&quot;$ParseData/Rows/tns1:Input[number($index)]/tns1:Input/tns1:CODE_CONTR&quot;/>&lt;/tns:CODE_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseData/Rows/tns1:Input[number($index)]/tns1:Input/tns1:IDRISORSA&quot;>&lt;tns:IDRISORSA>&lt;xsl:value-of select=&quot;$ParseData/Rows/tns1:Input[number($index)]/tns1:Input/tns1:IDRISORSA&quot;/>&lt;/tns:IDRISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseData/Rows/tns1:Input[number($index)]/tns1:Input/tns1:ID_ORD_CRMWS&quot;>&lt;tns:ID_ORD_CRMWS>&lt;xsl:value-of select=&quot;$ParseData/Rows/tns1:Input[number($index)]/tns1:Input/tns1:ID_ORD_CRMWS&quot;/>&lt;/tns:ID_ORD_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseData/Rows/tns1:Input[number($index)]/tns1:Input/tns1:DATA_DRO&quot;>&lt;tns:DATA_