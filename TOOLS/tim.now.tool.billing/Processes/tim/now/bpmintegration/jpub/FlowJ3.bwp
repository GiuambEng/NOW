                                expression="tib:validate-dateTime(&quot;yyyyMMdd&quot;, tib:substring-after-last(substring-before($ListFiles/files/fileInfo[1]/fileName, &quot;.&quot;), &quot;_&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
