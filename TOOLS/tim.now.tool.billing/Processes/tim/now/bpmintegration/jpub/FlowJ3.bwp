                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="ESEC_PROCSO_FILE_KO-input"
                                name="ESEC_PROCSO_FILE_KO"
                                outputVariable="ESEC_PROCSO_FILE_KO"
                                tibex:xpdlId="bb297aa8-55af-4e6a-8f74-22da473d127b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="EmptyToESEC_PROCSO_FILE_KO"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="JDBCUpdate1ToJDBCUpdate2"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bb297aa8-55af-4e6a-8f74-22da473d127b+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;ESEC_PROCSO_FILE_KO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;'JPUB_NOW_RISORSEJ3'&quot;/>&lt;/COD_PROCSO_FILE>&lt;ID_ESEC_PROCSO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/NEXTVAL)&quot;>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/NEXTVAL&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ESEC_PROCSO_FILE>&lt;ID_PROCSO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ID_PROCSO_FILE/Record[1]/ID_PROCSO_FILE)&quot;>&lt;xsl:value-of select=&quot;$ID_PROCSO_FILE/Record[1]/ID_PROCSO_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PROCSO_FILE>&lt;STATO_ESEC>&lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON ERRORE'&quot;/>&lt;/STATO_ESEC>&lt;TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TMSP_INIZIO_ELAB>&lt;TMSP_FINE_ELAB>&lt;xsl:value-of select=&quot;tib:add-to-dateTime(current-dateTime(),0, 0, 0, 0, 0,40)&quot;/>&lt;/TMSP_FINE_ELAB>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
