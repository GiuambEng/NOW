            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="9cf8f4bf-d740-4210-96ee-6c168005bfc2">
                <bpws:targets>
                    <bpws:target linkName="LogReadToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToLogEndFindUpdateCaseRicarica"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit1"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+99859622-005a-43ea-a370-1b37cdc10a69" version="2.0"> <xsl:template name="Accumulate2" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate2"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Read/readCaseResponse/ns10:ReadCaseResponse/caseData)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Read.readCaseResponse/caseData)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToParseXml" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ParseXmlToLog" tibex:linkType="SUCCESS"/>
