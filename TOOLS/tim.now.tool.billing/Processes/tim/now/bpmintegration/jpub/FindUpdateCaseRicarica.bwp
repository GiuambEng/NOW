                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCaseRicarica/&quot; xmlns:tns1=&quot;http://services.bds.tibco.com/BusinessDataServices_1.2.0&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Find-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:FindCaseByCriteriaRequest>&#xa;            &lt;caseModelVersion>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Input/tns:caseModelVersion&quot;/>&#xa;            &lt;/caseModelVersion>&#xa;            &lt;caseType>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Input/tns:caseType&quot;/>&#xa;            &lt;/caseType>&#xa;            &lt;criteria>&#xa;                &lt;queryString>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Input/tns:Criteria/tns:queryString&quot;/>&#xa;                &lt;/queryString>&#xa;                &lt;xsl:for-each select=&quot;$Start/tns:Find/tns:Input/tns:Criteria/tns:NamedParameterAssigned&quot;>&#xa;                    &lt;namedParameterAssignment>&#xa;                        &lt;name>&#xa;                            &lt;xsl:value-of select=&quot;tns:name&quot;/>&#xa;                        &lt;/name>&#xa;                        &lt;xsl:for-each select=&quot;tns:value&quot;>&#xa;                            &lt;value>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/value>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/namedParameterAssignment>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/criteria>&#xa;        &lt;/ns:FindCaseByCriteriaRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
