                                    &lt;xsl:value-of select="$ParseXml2/IDRisorsaOperatoreRete"/&gt;
                                &lt;/IDRisorsaOperatoreRete&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns1:AssetCorrelatiCessati&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns1:NewBilling&gt;
                        &lt;xsl:value-of select="'True'"/&gt;
                    &lt;/tns1:NewBilling&gt;
                    &lt;xsl:for-each select="$ControlloOrdine/Record"&gt;
                        &lt;tns1:ID_RECUPERO_JPUB_MASTER&gt;
                            &lt;tns1:ID_RECUPERO_JPUB_MASTER&gt;
                                &lt;xsl:value-of select="xsd:int(ID_RECUPERO_JPUB_MASTER)"/&gt;
                            &lt;/tns1:ID_RECUPERO_JPUB_MASTER&gt;
                            &lt;tns1:BDS_ID&gt;
                                &lt;xsl:value-of select="xsd:integer(BDS_ID_ASSET)"/&gt;
                            &lt;/tns1:BDS_ID&gt;
                        &lt;/tns1:ID_RECUPERO_JPUB_MASTER&gt;
                    &lt;/xsl:for-each&gt;
                &lt;/tns1:BPMRequest&gt;
            &lt;/parameters&gt;
        &lt;/ns:Invio_FatturazioneRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
