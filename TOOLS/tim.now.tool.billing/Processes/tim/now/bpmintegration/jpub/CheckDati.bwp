                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindRequest/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CaseTypeAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;Casemodel&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;FindAsset1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:Find>&#xa;                &lt;tns1:Input>&#xa;                    &lt;tns1:caseModelVersion>&#xa;                        &lt;xsl:value-of select=&quot;$Casemodel&quot;/>&#xa;                    &lt;/tns1:caseModelVersion>&#xa;                    &lt;tns1:caseType>&#xa;                        &lt;xsl:value-of select=&quot;$CaseTypeAsset&quot;/>&#xa;                    &lt;/tns1:caseType>&#xa;                    &lt;tns1:Criteria>&#xa;                        &lt;tns1:queryString>&#xa;                            &lt;xsl:value-of select=&quot;'IDAsset=:IDass'&quot;/>&#xa;                        &lt;/tns1:queryString>&#xa;                        &lt;tns1:NamedParameterAssigned>&#xa;                            &lt;tns1:name>&#xa;                                &lt;xsl:value-of select=&quot;'IDass'&quot;/>&#xa;                            &lt;/tns1:name>&#xa;                            &lt;xsl:if test=&quot;$ControlloOrdine/Record[1]/BDS_ID_ASSET&quot;>&#xa;                                &lt;tns1:value>&#xa;                                    &lt;xsl:value-of select=&quot;$ControlloOrdine/Record[1]/BDS_ID_ASSET&quot;/>&#xa;                                &lt;/tns1:value>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:NamedParameterAssigned>&#xa;                    &lt;/tns1:Criteria>&#xa;                    &lt;tns1:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                    &lt;/tns1:TransactionID>&#xa;                &lt;/tns1:Input>&#xa;            &lt;/tns1:Find>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
