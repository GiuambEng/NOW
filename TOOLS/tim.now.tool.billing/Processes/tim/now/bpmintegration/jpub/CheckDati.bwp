     &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDPrimoOrdine&quot;>&#xa;                        &lt;IDPrimoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;IDPrimoOrdine&quot;/>&#xa;                        &lt;/IDPrimoOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;IDContratto&quot;/>&#xa;                    &lt;/IDContratto>&#xa;                    &lt;xsl:if test=&quot;DEC&quot;>&#xa;                        &lt;DEC>&#xa;                            &lt;xsl:value-of select=&quot;DEC&quot;/>&#xa;                        &lt;/DEC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;statoAsset>&#xa;                        &lt;xsl:value-of select=&quot;statoAsset&quot;/>&#xa;                    &lt;/statoAsset>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                    &lt;xsl:if test=&quot;numeroTelefonico&quot;>&#xa;                        &lt;numeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;numeroTelefonico&quot;/>&#xa;                        &lt;/numeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDAssetCRMWS&quot;>&#xa;                        &lt;IDAssetCRMWS>&#xa;                            &lt;xsl:value-of select=&quot;IDAssetCRMWS&quot;/>&#xa;                        &lt;/IDAssetCRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDAssetDa&quot;>&#xa;                        &lt;IDAssetDa>&#xa;                            &lt;xsl:value-of select=&quot;IDAssetDa&quot;/>&#xa;                        &lt;/IDAssetDa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;DES>&#xa;                        &lt;xsl:value-of select=&quot;DES&quot;/>&#xa;                    &lt;/DES>&#xa;                    &lt;xsl:if test=&quot;ORA_DES&quot;>&#xa;                        &lt;ORA_DES>&#xa;                            &lt;xsl:value-of select=&quot;ORA_DES&quot;/>&#xa;                        &lt;/ORA_DES>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tipologiaAccesso>&#xa;                        &lt;xsl:value-of select=&quot;tipologiaAccesso&quot;/>&#xa;                    &lt;/tipologiaAccesso>&#xa;                    &lt;xsl:if test=&quot;RO&quot;>&#xa;                        &lt;RO>&#xa;                            &lt;xsl:value-of select=&quot;RO&quot;/>&#xa;                        &lt;/RO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;offerta&quot;/>&#xa;                    &lt;/offerta>&#xa;                    &lt;xsl:if test=&quot;lineaRiferimento&quot;>&#xa;                        &lt;lineaRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;lineaRiferimento&quot;/>&#xa;                        &lt;/lineaRiferimento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;complesso&quot;>&#xa;                        &lt;complesso>&#xa;                            &lt;xsl:value-of select=&quot;complesso&quot;/>&#xa;                        &lt;/complesso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;interno&quot;>&#xa;                        &lt;interno>&#xa;                            &lt;xsl:value-of select=&quot;interno&quot;/>&#xa;                        &lt;/interno>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;piano&quot;>&#xa;                        &lt;piano>&#xa;                            &lt;xsl:value-of select=&quot;piano&quot;/>&#xa;                        &lt;/piano>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;scala&quot;>&#xa;                        &lt;scala>&#xa;                            &lt;xsl:value-of select=&quot;scala&quot;/>&#xa;                        &lt;/scala>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;dettaglioasset&quot;>&#xa;                        &lt;dettaglioasset>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                            &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                &lt;IDDettaglioAssetParent>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                &lt;/IDDettaglioAssetParent>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                &lt;IDDettaglioAssetRoot>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                &lt;/IDDettaglioAssetRoot>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of sel