                                &lt;/IDAnagraficaCausale&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$ParseXml5/IDCorrelazione"&gt;
                                &lt;IDCorrelazione&gt;
                                    &lt;xsl:value-of select="$ParseXml5/IDCorrelazione"/&gt;
                                &lt;/IDCorrelazione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$ParseXml5/totaleRichiestePacchetto"&gt;
                                &lt;totaleRichiestePacchetto&gt;
                                    &lt;xsl:value-of select="$ParseXml5/totaleRichiestePacchetto"/&gt;
                                &lt;/totaleRichiestePacchetto&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$ParseXml5/tipoPacchetto"&gt;
                                &lt;tipoPacchetto&gt;
                                    &lt;xsl:value-of select="$ParseXml5/tipoPacchetto"/&gt;
                                &lt;/tipoPacchetto&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$ParseXml5/IDPacchettoNOW"&gt;
                                &lt;IDPacchettoNOW&gt;
                                    &lt;xsl:value-of select="$ParseXml5/IDPacchettoNOW"/&gt;
                                &lt;/IDPacchettoNOW&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$ParseXml5/contenutoXML"&gt;
                                &lt;contenutoXML&gt;
                                    &lt;xsl:value-of select="$ParseXml5/contenutoXML"/&gt;
                                &lt;/contenutoXML&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$ParseXml5/note"&gt;
                                &lt;note&gt;
                                    &lt;xsl:value-of select="$ParseXml5/note"/&gt;
                                &lt;/note&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:for-each select="$ParseXml5/ordine"&gt;
                                &lt;ordine&gt;
                                    &lt;xsl:if test="offertaCatalogo"&gt;
                                        &lt;offertaCatalogo&gt;
                                            &lt;xsl:value-of select="offertaCatalogo"/&gt;
