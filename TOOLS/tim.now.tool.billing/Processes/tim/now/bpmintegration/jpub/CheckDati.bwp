                                    columnName="TMSP_INSERIMENTO"
                                    dataType="93" typeName="TIMESTAMP"/>

                                    <columnMetadata
                                    columnName="ID_ORDINE_CRMWS"
                                    dataType="12" typeName="VARCHAR2"/>

