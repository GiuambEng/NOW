                                    &lt;xsl:if test="DACRimodulata"&gt;
                                        &lt;DACRimodulata&gt;
                                            &lt;xsl:value-of select="DACRimodulata"/&gt;
                                        &lt;/DACRimodulata&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="DAD"&gt;
