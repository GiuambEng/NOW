                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/" xmlns:tns1="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="ParseXml5"/&gt;
    &lt;xsl:param name="ControlloOrdine"/&gt;
    &lt;xsl:param name="ParseXml4"/&gt;
    &lt;xsl:param name="ParseXml6"/&gt;
    &lt;xsl:template name="SendJPUB-input" match="/"&gt;
        &lt;tns2:SendJPUBRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:SendJPUBRequest&gt;
                    &lt;tns1:Stato&gt;
                        &lt;xsl:value-of select="''"/&gt;
                    &lt;/tns1:Stato&gt;
                    &lt;tns1:BPMRequest&gt;
                        &lt;tns1:Richiesta&gt;
                            &lt;created&gt;
                                &lt;xsl:value-of select="$ParseXml5/created"/&gt;
                            &lt;/created&gt;
                            &lt;lastUpdate&gt;
                                &lt;xsl:value-of select="$ParseXml5/lastUpdate"/&gt;
                            &lt;/lastUpdate&gt;
                            &lt;operatore&gt;
                                &lt;xsl:value-of select="$ParseXml5/operatore"/&gt;
                            &lt;/operatore&gt;
                            &lt;IDRichiestaOLO&gt;
