                                    <columnMetadata columnIndex="8"
                                    columnName="OPERATORE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="9"
                                    columnName="ID_RICHIESTA_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="10"
                                    columnName="ID_EVENTO_ORDINE_NOW_WHOLESALE"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="11"
                                    columnName="ID_RECUPERO_JPUB_MASTER"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="12"
                                    columnName="ID_ASSET_RICARICA"
