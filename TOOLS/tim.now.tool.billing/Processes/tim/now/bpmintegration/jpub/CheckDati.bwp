                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Intestazione&quot;/>&#xa;    &lt;xsl:param name=&quot;AperturaTag&quot;/>&#xa;    &lt;xsl:param name=&quot;Chiusura&quot;/>&#xa;    &lt;xsl:param name=&quot;TransformXml5&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseXml5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:xmlString>&#xa;            &lt;xsl:value-of select=&quot;concat($Intestazione, $AperturaTag, concat(&amp;quot;&amp;lt;created>&amp;quot;, substring-after(tib:substring-before-last($TransformXml5, &amp;quot;&amp;lt;&amp;quot;), &amp;quot;&amp;lt;created>&amp;quot;)), $Chiusura)&quot;/>&#xa;        &lt;/tns1:xmlString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
