                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;BO_TOOL_RECUPERO_JPUB_MASTER&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloOrdine&quot;/>&#xa;    &lt;xsl:template name=&quot;LogControlloOrdine-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.tool.billing.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckDati'&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckDati'&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'CheckDati'&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($ControlloOrdine/Record) > 0&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;estrazione tecord tool record trovati&amp;quot;, tib:render-xml($BO_TOOL_RECUPERO_JPUB_MASTER, true(), true()))&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;'estrazione record tool record non trovati'&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
