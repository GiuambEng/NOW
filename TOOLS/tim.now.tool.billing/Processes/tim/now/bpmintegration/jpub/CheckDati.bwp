               &lt;DADRimodulata>&#xa;                                    &lt;xsl:value-of select=&quot;DADRimodulata&quot;/>&#xa;                                &lt;/DADRimodulata>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DEC&quot;>&#xa;                                &lt;DEC>&#xa;                                    &lt;xsl:value-of select=&quot;DEC&quot;/>&#xa;                                &lt;/DEC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DES&quot;>&#xa;                                &lt;DES>&#xa;                                    &lt;xsl:value-of select=&quot;DES&quot;/>&#xa;                                &lt;/DES>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ORA_DES&quot;>&#xa;                                &lt;ORA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;ORA_DES&quot;/>&#xa;                                &lt;/ORA_DES>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;tipologiaLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;tipologiaLavorazione&quot;/>&#xa;                            &lt;/tipologiaLavorazione>&#xa;                            &lt;xsl:if test=&quot;tipologiaSottolav&quot;>&#xa;                                &lt;tipologiaSottolav>&#xa;                                    &lt;xsl:value-of 