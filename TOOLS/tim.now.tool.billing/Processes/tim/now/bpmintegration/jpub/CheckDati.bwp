ML>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml5/note&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml5/note&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$ParseXml5/ordine&quot;>&#xa;                        &lt;ordine>&#xa;                            &lt;xsl:if test=&quot;offertaCatalogo&quot;>&#xa;                                &lt;offertaCatalogo>&#xa;                                    &lt;xsl:value-of select=&quot;offertaCatalogo&quot;/>&#xa;                                &lt;/offertaCatalogo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DAC&quot;>&#xa;                                &lt;DAC>&#xa;                                    &lt;xsl:value-of select=&quot;DAC&quot;/>&#xa;                                &lt;/DAC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DACRimodulata&quot;>&#xa;                                &lt;DACRimodulata>&#xa;                                    &lt;xsl:value-of select=&quot;DACRimodulata&quot;/>&#xa;                                &lt;/DACRimodulata>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DAD&quot;>&#xa;                                &lt;DAD>&#xa;                                    &lt;xsl:value-of select=&quot;DAD&quot;/>&#xa;                                &lt;/DAD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DPP&quot;>&#xa;                                &lt;DPP>&#xa;                                    &lt;xsl:value-of select=&quot;DPP&quot;/>&#xa;                                &lt;/DPP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;DUVO&quot;>&#x