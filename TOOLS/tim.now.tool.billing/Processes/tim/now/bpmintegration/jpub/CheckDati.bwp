                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="codificaOLONOWDonating"&gt;
                                &lt;codificaOLONOWDonating&gt;
                                    &lt;xsl:value-of select="codificaOLONOWDonating"/&gt;
                                &lt;/codificaOLONOWDonating&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="codificaOLONOWDonor"&gt;
                                &lt;codificaOLONOWDonor&gt;
                                    &lt;xsl:value-of select="codificaOLONOWDonor"/&gt;
                                &lt;/codificaOLONOWDonor&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tipologiaScenario"&gt;
                                &lt;tipologiaScenario&gt;
                                    &lt;xsl:value-of select="tipologiaScenario"/&gt;
                                &lt;/tipologiaScenario&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="totaleOrdinePacchetto"&gt;
                                &lt;totaleOrdinePacchetto&gt;
                                    &lt;xsl:value-of select="totaleOrdinePacchetto"/&gt;
                                &lt;/totaleOrdinePacchetto&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="IDCorrelazione"&gt;
                                &lt;IDCorrelazione&gt;
                                    &lt;xsl:value-of select="IDCorrelazione"/&gt;
                                &lt;/IDCorrelazione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="numTelPrincipale"&gt;
                                &lt;numTelPrincipale&gt;
                                    &lt;xsl:value-of select="numTelPrincipale"/&gt;
                                &lt;/numTelPrincipale&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="codiceFatturazioneJPUB"&gt;
                                &lt;codiceFatturazioneJPUB&gt;
                                    &lt;xsl:value-of select="codiceFatturazioneJPUB"/&gt;
                                &lt;/codiceFatturazioneJPUB&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="CRMEstrattore"&gt;
                                &lt;CRMEstrattore&gt;
                                    &lt;xsl:value-of select="CRMEstrattore"/&gt;
                                &lt;/CRMEstrattore&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="IDRichiestaOLD"&gt;
                                &lt;IDRichiestaOLD&gt;
                                    &lt;xsl:value-of select="IDRichiestaOLD"/&gt;
                                &lt;/IDRichiestaOLD&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="exists(cliente)"&gt;
                                &lt;xsl:copy-of select="cliente"/&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="LNA_LA"&gt;
                                &lt;LNA_LA&gt;
                                    &lt;xsl:value-of select="LNA_LA"/&gt;
                                &lt;/LNA_LA&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="modalitaFatturazione"&gt;
                                &lt;modalitaFatturazione&gt;
                                    &lt;xsl:value-of select="modalitaFatturazione"/&gt;
                                &lt;/modalitaFatturazione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="IDRisorsaOLD"&gt;
                                &lt;IDRisorsaOLD&gt;
                                    &lt;xsl:value-of select="IDRisorsaOLD"/&gt;
                                &lt;/IDRisorsaOLD&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="IDRisorsaCorrelato"&gt;
                                &lt;IDRisorsaCorrelato&gt;
                                    &lt;xsl:value-of select="IDRisorsaCorrelato"/&gt;
                                &lt;/IDRisorsaCorrelato&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="operatoreRete"&gt;
                                &lt;operatoreRete&gt;
                                    &lt;xsl:value-of select="operatoreRete"/&gt;
                                &lt;/operatoreRete&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="opzioneDinamica"&gt;
                                &lt;opzioneDinamica&gt;
                                    &lt;xsl:value-of select="opzioneDinamica"/&gt;
                                &lt;/opzioneDinamica&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="IDRisorsaOperatoreRete"&gt;
                                &lt;IDRisorsaOperatoreRete&gt;
                                    &lt;xsl:value-of select="IDRisorsaOperatoreRete"/&gt;
                                &lt;/IDRisorsaOperatoreRete&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns2:AssetCorrelatiCessati&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;tns2:NewBilling&gt;
                        &lt;xsl:value-of select="'True'"/&gt;
                    &lt;/tns2:NewBilling&gt;
                    &lt;tns2:ID_RECUPERO_JPUB_MASTER&gt;
                        &lt;xsl:if test="$Mapper/tns1:Record[$index]/tns1:ID_RECUPERO_JPUB_MASTER"&gt;
                            &lt;tns2:ID_RECUPERO_JPUB_MASTER&gt;
                                &lt;xsl:value-of select="$Mapper/tns1:Record[$index]/tns1:ID_RECUPERO_JPUB_MASTER"/&gt;
                            &lt;/tns2:ID_RECUPERO_JPUB_MASTER&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Mapper/tns1:Record[$index]/tns1:ASSET[1]/tns1:BDS_ID_ASSET"&gt;
                            &lt;tns2:BDS_ID&gt;
                                &lt;xsl:value-of select="$Mapper/tns1:Record[$index]/tns1:ASSET[1]/tns1:BDS_ID_ASSET"/&gt;
                            &lt;/tns2:BDS_ID&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns2:ID_RECUPERO_JPUB_MASTER&gt;
                &lt;/tns2:BPMRequest&gt;
            &lt;/parameters&gt;
        &lt;/ns:Invio_FatturazioneRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_callJPub/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Record/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml7&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:BPMRequest>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml7/created&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml7/lastUpdate&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml7/operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICO&amp;quot;&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;lavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                &lt;/lavorazione>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml7/IDRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml7/codificaOLOAGCOM&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml7/codiceOrdineOLO&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;ordine>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml7/created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;codificaOLONOW>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/codificaOLONOW>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml7/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                    &lt;xsl:if test=&quot;$ParseXml7/DEC&quot;>&#xa;                        &lt;DEC>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml7/DEC&quot;/>&#xa;                        &lt;/DEC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;DES>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml7/DES&quot;/>&#xa;                    &lt;/DES>&#xa;                    &lt;xsl:if test=&quot;$ParseXml7/ORA_DES&quot;>&#xa;                        &lt;ORA_DES>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml7/ORA_DES&quot;/>&#xa;                        &lt;/ORA_DES>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml7/IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;tipologiaLavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaLavorazione>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NORMALE&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml7/offerta&quot;/>&#xa;                    &lt;/offerta>&#xa;                &lt;/ordine>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml7/IDContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml7/offerta&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;IDRichiestaLocalizzatore>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/IDRichiestaLocalizzatore>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml7/IDOfferta&quot;/>&#xa;                &lt;/IDOfferta>&#xa;                &lt;codiceRifiuto>&#xa;                    &lt;xsl:value-of select=&quot;tib:substring-after-last($Mapper/tns1:Record[$index]/tns1:ID_ORDINE_CRMWS,'-')&quot;/>&#xa;                &lt;/