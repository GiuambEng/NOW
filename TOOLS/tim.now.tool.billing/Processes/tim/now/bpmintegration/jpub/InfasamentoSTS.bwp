lagOpereSpeciali&gt;&lt;xsl:value-of select="$ParseXml/flagOpereSpeciali"/&gt;&lt;/flagOpereSpeciali&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/IDRisorsaCorrelato"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$ParseXml/IDRisorsaCorrelato"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/IDRichiestaOLOGenerante"&gt;&lt;IDRichiestaOLOGenerante&gt;&lt;xsl:value-of select="$ParseXml/IDRichiestaOLOGenerante"/&gt;&lt;/IDRichiestaOLOGenerante&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/tipoComunicazioneNP"&gt;&lt;tipoComunicazioneNP&gt;&lt;xsl:value-of select="$ParseXml/tipoComunicazioneNP"/&gt;&lt;/tipoComunicazioneNP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/servizioOrigine"&gt;&lt;servizioOrigine&gt;&lt;xsl:value-of select="$ParseXml/servizioOrigine"/&gt;&lt;/servizioOrigine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codiceSTS"&gt;&lt;codiceSTS&gt;&lt;xsl:value-of select="$ParseXml/codiceSTS"/&gt;&lt;/codiceSTS&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/caratteristica"&gt;&lt;caratteristica&gt;&lt;xsl:value-of select="$ParseXml/caratteristica"/&gt;&lt;/caratteristica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codiceRisorsaDonating"&gt;&lt;codiceRisorsaDonating&gt;&lt;xsl:value-of select="$ParseXml/codiceRisorsaDonating"/&gt;&lt;/codiceRisorsaDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codiceRisorsaDonating2"&gt;&lt;codiceRisorsaDonating2&gt;&lt;xsl:value-of select="$ParseXml/codiceRisorsaDonating2"/&gt;&lt;/codiceRisorsaDonating2&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/cowCodeOLO"&gt;&lt;cowCodeOLO&gt;&lt;xsl:value-of select="$ParseXml/cowCodeOLO"/&gt;&lt;/cowCodeOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/cowCodeOLO2"&gt;&lt;cowCodeOLO2&gt;&lt;xsl:value-of select="$ParseXml/cowCodeOLO2"/&gt;&lt;/cowCodeOLO2&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codiceSessione"&gt;&lt;codiceSessione&gt;&lt;xsl:value-of select="$ParseXml/codiceSessione"/&gt;&lt;/codiceSessione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codiceSessione2"&gt;&lt;codiceSessione2&gt;&lt;xsl:value-of select="$ParseXml/codiceSessione2"/&gt;&lt;/codiceSessione2&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$ParseXml/DNAggiuntivo"&gt;&lt;DNAggiuntivo&gt;&lt;xsl:value-of select="."/&gt;&lt;/DNAggiuntivo&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$ParseXml/IDPreventivo"&gt;&lt;IDPreventivo&gt;&lt;xsl:value-of select="$ParseXml/IDPreventivo"/&gt;&lt;/IDPreventivo&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/IDConsuntivo"&gt;&lt;IDConsuntivo&gt;&lt;xsl:value-of select="$ParseXml/IDConsuntivo"/&gt;&lt;/IDConsuntivo&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/noteAltreLavorazioni"&gt;&lt;noteAltreLavorazioni&gt;&lt;xsl:value-of select="$ParseXml/noteAltreLavorazioni"/&gt;&lt;/noteAltreLavorazioni&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codicePacchettoNOW"&gt;&lt;codicePacchettoNOW&gt;&lt;xsl:value-of select="$ParseXml/codicePacchettoNOW"/&gt;&lt;/codicePacchettoNOW&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($ParseXml/assetTarget)"&gt;&lt;xsl:for-each select="$ParseXml/assetTarget"&gt;&lt;assetTarget&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;flagInLavorazione&gt;&lt;xsl:value-of select="flagInLavorazione"/&gt;&lt;/flagInLavorazione&gt;&lt;/assetTarget&gt;&lt;/xsl:for-each&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/operatoreRete"&gt;&lt;operatoreRete&gt;&lt;xsl:value-of select="$ParseXml/operatoreRete"/&gt;&lt;/operatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/transactionIDLocator"&gt;&lt;transactionIDLocator&gt;&lt;xsl:value-of select="$ParseXml/transactionIDLocator"/&gt;&lt;/transactionIDLocator&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/flagNumAggiuntive"&gt;&lt;flagNumAggiuntive&gt;&lt;xsl:value-of select="$ParseXml/flagNumAggiuntive"/&gt;&lt;/flagNumAggiuntive&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/IDAnagraficaCausaleGUI"&gt;&lt;IDAnagraficaCausaleGUI&gt;&lt;xsl:value-of select="$ParseXml/IDAnagraficaCausaleGUI"/&gt;&lt;/IDAnagraficaCausaleGUI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codiceRifiutoDonating"&gt;&lt;codiceRifiutoDonating&gt;&lt;xsl:value-of select="$ParseXml/codiceRifiutoDonating"/&gt;&lt;/codiceRifiutoDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/DACFile"&gt;&lt;DACFile&gt;&lt;xsl:value-of select="$ParseXml/DACFile"/&gt;&lt;/DACFile&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/tipologiaSottolav"&gt;&lt;tipologiaSottolav&gt;&lt;xsl:value-of select="$ParseXml/tipologiaSottolav"/&gt;&lt;/tipologiaSottolav&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/codiceRifiuto"&gt;&lt;codiceRifiuto&gt;&lt;xsl:value-of select="$ParseXml/codiceRifiuto"/&gt;&lt;/codiceRifiuto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/routingNumber"&gt;&lt;routingNumber&gt;&lt;xsl:value-of select="$ParseXml/routingNumber"/&gt;&lt;/routingNumber&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/progressivoEmissioneDTU"&gt;&lt;progressivoEmissioneDTU&gt;&lt;xsl:value-of select="$ParseXml/progressivoEmissioneDTU"/&gt;&lt;/progressivoEmissioneDTU&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/flagAttesaDesospOLO"&gt;&lt;flagAttesaDesospOLO&gt;&lt;xsl:value-of select="$ParseXml/flagAttesaDesospOLO"/&gt;&lt;/flagAttesaDesospOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/flagDeliveryExposed"&gt;&lt;flagDeliveryExposed&gt;&lt;xsl:value-of select="$ParseXml/flagDeliveryExposed"/&gt;&lt;/flagDeliveryExposed&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/disaggregato"&gt;&lt;disaggregato&gt;&lt;xsl:value-of select="$ParseXml/disaggregato"/&gt;&lt;/disaggregato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/exDisaggregato"&gt;&lt;exDisaggregato&gt;&lt;xsl:value-of select="$ParseXml/exDisaggregato"/&gt;&lt;/exDisaggregato&gt;&lt;/xsl:if&gt;&lt;/tns:Richiesta&gt;&lt;tns:Flag_OpereSpeciali&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns:Flag_OpereSpeciali&gt;&lt;tns:NPSync&gt;&lt;xsl:value-of select="concat($ParseXml/IDRichiestaOLO,'_S')"/&gt;&lt;/tns:NPSync&gt;&lt;xsl:if test="$Evento/tns2:DataInizioNol"&gt;&lt;tns:DataInizioNol&gt;&lt;xsl:v