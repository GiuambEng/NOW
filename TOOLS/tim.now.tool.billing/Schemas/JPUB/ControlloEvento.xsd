<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ControlloEvento/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/ControlloEvento/"
	xmlns:pref="http://xsd.telecomitalia.it/Schema/jpubADSL/" xmlns:pref1="http://xsd.telecomitalia.it/Schema/jpub/">

	<import schemaLocation="OrdiniCRMWS_Reg_2.23.xsd" namespace="http://xsd.telecomitalia.it/Schema/jpub/"></import>
	<element name="Request">
		<complexType>
			<sequence>
				<element name="CONTENUTO_XML" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="TransactionID" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="AggiuntiviNP" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="STS" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="Response">
		<complexType>
			<sequence>
				<element name="Esito" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="DataInizioNol" type="pref1:dateTimeOpzionale"
					maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>

	</element>
</schema>