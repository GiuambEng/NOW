<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/FindRequest/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/FindRequest/"
	xmlns:pref="http://www.tim.com/NOW/xsd/FindUpdateCase/"
	xmlns:pref2="http://NOW.it.telecomitalia.it/casedata">


	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/Casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata"></import>
	<complexType name="output_type">
		<sequence>
			<element name="Esito" type="string" />
			<element name="DescrizioneEsito" type="string"
				minOccurs="0" />
		</sequence>
	</complexType>
	<complexType name="fault_type">
		<sequence>
			<element name="Code" type="string" />
			<element name="ErrorCode" type="string" minOccurs="0" />
		</sequence>
	</complexType>
	<complexType name="FindRisorsaRequest_type">
		<sequence>
			<element name="caseModelVersion" type="string" />
			<element name="caseType" type="string" />
			<element name="Criteria">
				<complexType>
					<sequence>
						<element name="queryString" type="string" />
						<element name="NamedParameterAssigned"
							minOccurs="0" maxOccurs="unbounded">
							<complexType>
								<sequence>
									<element name="name" type="string" />
									<element name="value" type="string"
										minOccurs="0" maxOccurs="unbounded" />
								</sequence>
							</complexType>
						</element>
						<element name="PaginationOption"
							minOccurs="0">
							<complexType>
								<sequence>
									<element name="startPosition"
										type="integer" minOccurs="0" />
									<element name="maxResult"
										type="integer" minOccurs="0" />
								</sequence>
							</complexType>
						</element>
					</sequence>
				</complexType>
			</element>
			<element name="TransactionID" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
		</sequence>
	</complexType>
	<element name="Output">
		<complexType>
			<choice>
				<element name="Find" minOccurs="0"
					maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="CaseReference" type="string"
								minOccurs="0" />

							<element name="Response"
								type="tns:output_type" />
							<element name="Request"
								type="pref2:Richiesta" maxOccurs="1" minOccurs="0">
							</element>
							<element name="Asset" type="pref2:Asset" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
				<element name="Update">
					<complexType>
						<sequence>
							<element name="Response"
								type="tns:output_type" />
						</sequence>
					</complexType>
				</element>
				<element name="Create">
					<complexType>
						<sequence>
							<element name="CaseReference" type="string"
								minOccurs="0" />
							<element name="Response"
								type="tns:output_type" />
						</sequence>
					</complexType>
				</element>
			</choice>
		</complexType>
	</element>
	<element name="Input">
		<complexType>
			<choice>
				<element name="Find">
					<complexType>
						<sequence>
							<element name="Input"
								type="tns:FindRisorsaRequest_type" />
						</sequence>
					</complexType>
				</element>
				<element name="Update">
					<complexType>
						<sequence>
							<element name="Input">
								<complexType>
									<sequence>
										<element name="CaseReference"
											type="string" />

										<element name="Request"
											type="pref2:Richiesta" maxOccurs="1" minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="Create">
					<complexType>
						<sequence>
							<element name="Input">
								<complexType>
									<sequence>
										<element name="caseType"
											type="string" />
										<element name="caseModelVersion"
											type="string" />

										<element name="Request"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
			</choice>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Error" type="tns:fault_type" />
			</sequence>
		</complexType>
	</element>

</schema>