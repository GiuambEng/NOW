ber($index)]/tns:Flag_validita)>0 and ($Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:Flag_validita!=&amp;quot;&amp;#xD;&amp;quot;)&quot;>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;3&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;4&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:int($Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:Record)&quot;/>&lt;/tns1:NUMERO_RECD>&lt;xsl:if test=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:RISORSA&quot;>&lt;tns1:NUMERO_TELEFONICO>&lt;xsl:value-of select=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:RISORSA&quot;/>&lt;/tns1:NUMERO_TELEFONICO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:PRIMARY_NUMBER&quot;>&lt;tns1:NUMERO_TELEFONICO_PRINC>&lt;xsl:value-of select=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:PRIMARY_NUMBER&quot;/>&lt;/tns1:NUMERO_TELEFONICO_PRINC>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:RADICE_GNR&quot;>&lt;tns1:RADICE_GNR>&lt;xsl:value-of select=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:RADICE_GNR&quot;/>&lt;/tns1:RADICE_GNR>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:ROUTING_NUMBER&quot;>&lt;tns1:ROUTING_NUMBER>&lt;xsl:value-of select=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:ROUTING_NUMBER&quot;/>&lt;/tns1:ROUTING_NUMBER>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:TIPO_DN&quot;>&lt;tns1:TIPO_DN>&lt;xsl:value-of select=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:TIPO_DN&quot;/>&lt;/tns1:TIPO_DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:AutoAssetNP_Dettaglio[number($index)]/tns:TIPO_LINEA&quot;>&lt;tns1:TIPO_LINEA>&lt;xsl:value-of select=&quot;$Start/tns:AutoAssetNP_Dettagl