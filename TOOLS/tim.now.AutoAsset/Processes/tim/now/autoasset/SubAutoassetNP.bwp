                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e3b689a2-581c-4e96-8c4a-5e23db26f6c6+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AutoAssetNPStaging/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate1&quot;/>&lt;xsl:template name=&quot;JDBCUpdateStag-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Accumulate1/tns1:AutoAssetNP_dettaglio&quot;>&lt;Record>&lt;DESCR_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:DESCR_ERRORE)&quot;>&lt;xsl:value-of select=&quot;tns1:DESCR_ERRORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_ERRORE>&lt;ID_STATO_ELAB_STAG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:ID_STATO_ELAB_STAG)&quot;>&lt;xsl:value-of select=&quot;tns1:ID_STATO_ELAB_STAG&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_STATO_ELAB_STAG>&lt;TIMESTAMP_AGG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMESTAMP_AGG>&lt;ID_FILE_PROCTO_INPUT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:ID_FILE_PROCSTO_INPUT)&quot;>&lt;xsl:value-of select=&quot;tns1:ID_FILE_PROCSTO_INPUT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_FILE_PROCTO_INPUT>&lt;NUMERO_RECORD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:NUMERO_RECD)&quot;>&lt;xsl:value-of select=&quot;tns1:NUMERO_RECD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUMERO_RECORD>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STAG_AUTOASSET_NP_FILE&#xa;  SET DESCR_ERRORE = ?, ID_STATO_ELAB_STAG = ? , TIMESTAMP_AGG=?&#xa;  WHERE ID_FILE_PROCTO_INPUT = ? AND NUMERO_RECORD = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_ERRORE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_AGG"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCTO_INPUT"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_RECORD"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
