<?xml version="1.0" encoding="UTF-8"?>
<bpws:process exitOnStandardFault="no"
    name="tim.now.autoasset.SubAutoassetNP" suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20180508215505"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.tim.com/NOW/xsd/GenericLogger"
    xmlns:ns1="http://www.tim.com/NOW/xsd/AutoAssetNP_SubProcess/"
    xmlns:ns2="http://www.tim.com/NOW/xsd/AutoAssetNP_ChecRecord/"
    xmlns:ns3="http://www.tim.com/NOW/xsd/AutoAssetNPStaging/"
    xmlns:ns4="http://tns.tibco.com/bw/palette/internal/accumulateoutput+935b6c0d-2cc1-4065-9d5a-5b8f29cab8a4"
