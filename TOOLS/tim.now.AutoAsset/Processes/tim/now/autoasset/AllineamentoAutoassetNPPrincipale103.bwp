                    </bpws:targets>
                </bpws:empty>
                <bpws:scope name="While" tibex:group="while" tibex:xpdlId="c897064d-e2fd-4b6d-b15b-5c62eb7998e9">
                    <bpws:targets>
                        <bpws:target linkName="GroupStartToWhile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WhileToGroupEnd"/>
                    </bpws:sources>
                    <bpws:variables>
                        <bpws:variable name="index"
                            sca-bpel:internal="true" type="xsd:int">
                            <bpws:from>
                                <bpws:literal>1</bpws:literal>
                            </bpws:from>
                        </bpws:variable>
                    </bpws:variables>
                    <bpws:sequence name="sequence" tibex:group="while">
                        <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                        <bpws:while name="while" tibex:counterName="index">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$index&lt;=((($JMSReceiveMessage/Body/ns7:queueResponse/ns7:NumeroRecord) div $Passo) +1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=((($JMSReceiveMessage/Body/ns7:queueResponse/ns7:NumeroRecord) div $Passo) +1)]]></bpws:condition>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStart1ToLogStartElaborazione" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogStartElaborazioneToParseData" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
