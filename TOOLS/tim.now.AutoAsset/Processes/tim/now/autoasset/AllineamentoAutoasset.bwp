                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+236e8b87-79d0-40ac-a2f5-296ffebea763+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AutoAssetNPStaging/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputStaging&quot;/>&lt;xsl:param name=&quot;SelectInfoAsset&quot;/>&lt;xsl:param name=&quot;SelectRisorsa&quot;/>&lt;xsl:param name=&quot;SelectNumeroTelefonico&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectInfoAsset/Record)=0&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;'Controlli non superati, validazione dati in staging fallita, record non trovato su Asset'&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:when test=&quot;count($SelectRisorsa/Record)>0&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;'Controlli non superati, validazione dati in staging fallita, risorsa presente su Asset Attivo'&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:when test=&quot;count($SelectNumeroTelefonico/Record) > 0&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;'Controlli non superati, validazione dati in staging fallita, aggiuntivo presente con stato attivo'&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;'Distretto non corretto'&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;5&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;TIMESTAMP_AGG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMESTAMP_AGG>&lt;ID_FILE_PROCTO_INPUT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InputStaging/tns1:AutoAssetNP_dettaglio[number($index1)]/tns1:ID_FILE_PROCSTO_INPUT)&quot;>&lt;xsl:value-of select=&quot;$InputStaging/tns1:AutoAssetNP_dettaglio[number($index1)]/tns1:ID_FILE_PROCSTO_INPUT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_FILE_PROCTO_INPUT>&lt;NUMERO_TELEFONICO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InputStaging/tns1:AutoAssetNP_dettaglio[number($index1)]/tns1:NUMERO_TELEFONICO)&quot;>&lt;xsl:value-of select=&quot;$InputStaging/tns1:AutoAssetNP_dettaglio[number($index1)]/tns1:NUMERO_TELEFONICO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUMERO_TELEFONICO>&lt;ID_ASSET_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InputStaging/tns1:AutoAssetNP_dettaglio[number($index1)]/tns1:ID_ASSET_NOW)&quot;>&lt;xsl:value-of select=&quot;$InputStaging/tns1:AutoAssetNP_dettaglio[number($index1)]/tns1:ID_ASSET_NOW&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ASSET_NOW>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InputStaging/tns1:AutoAssetNP_dettaglio[number($index1)]/tns1:ID_RISORSA)&quot;>&lt;xsl:value-of select=&quot;$InputStaging/tns1:AutoAssetNP_dettaglio[number($index1)]/tns1:ID_RISORSA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>

                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STAG_AUTOASSET_NP_FILE&#xa;  SET DESCR_ERRORE = ?, ID_STATO_ELAB_STAG = ?,TIMESTAMP_AGG=?&#xa;  WHERE ID_FILE_PROCTO_INPUT = ? AND NUMERO_TELEFONICO = ? AND ID_ASSET_NOW = ? AND ID_RISORSA=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_STATO_ELAB_STAG"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_AGG"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE_PROCTO_INPUT"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERO_TELEFONICO"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_ASSET_NOW"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="if(string-length($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO)=2) then tib:pad-front($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO, 3, '0') else if (string-length($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO)=3) then $InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO else if( string-length($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO)=4 ) then substring($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO, 2, 3) else 'FALSE'"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="Disteretto"
                                    name="Distretto"
                                    outputVariable="Disteretto"
                                    tibex:xpdlId="33b18a61-2016-4c24-bd14-8e1e2d42f19c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToDistretto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DistrettoToJDBCUpdate_False">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$Disteretto='FALSE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Disteretto='FALSE']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="DistrettoToCallProcess">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="if(string-length($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO)=2) then tib:pad-front($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO, 3, '0') else if (string-length($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO)=3) then $InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO else if( string-length($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO)=4 ) then substring($InputStaging/ns15:AutoAssetNP_dettaglio[number($index)]/ns15:CODICE_DISTRETTO, 2, 3) else 'FALSE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
