                        &lt;/xsl:if&gt;
                    &lt;/ns:FileProcessatoInput&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns:InputMessage&gt;
    &lt;/xsl:template&gt;
