                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>

                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ASS.IDASSET FROM BDS_1_CASEDATA_ASSET ASS ,BDS_1_CASEDATA_DETTAGLIOASSET D,BDS_1_CASEDATA_ATTRIBTDTTGLSST B  &#xa;WHERE &#xa;ASS.BDS_ID=D.ASSET_DETTAGLIOASSET_BDSID AND B.DTTGLSST_TTRBTIDTTGLISST_BDSID=D.BDS_ID &#xa;AND ASS.STATOASSET='ATTIVO'&#xa;AND D.STATODETTAGLIOASSET='ATTIVO' AND D.NOMECOMPONENTE='AGGIUNTIVO' &#xa;AND B.NOMEATTRIBUTO='NUMEROTELEFONICO' &#xa;AND B.VALOREATTRIBUTO= ? &#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

