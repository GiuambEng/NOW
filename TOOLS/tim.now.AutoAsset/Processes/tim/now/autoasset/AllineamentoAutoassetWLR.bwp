R_STATO_FILE>&#xa;                                &lt;tns:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE FILE INPUT ESEGUITA CON SUCCESSO&amp;quot;&quot;/>&#xa;                                &lt;/tns:LOG_MESSAGE>&#xa;                                &lt;tns:RECORD_OK>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns:RECORD_OK>&#xa;                                &lt;tns:RECORD_KO>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns:RECORD_KO>&#xa;                                &lt;tns:RECORD_TOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns:RECORD_TOTALI>&#xa;                            &lt;/tns:InputFile>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:Update>&#xa;            &lt;/tns:DataIn>&#xa;            &lt;tns:LogElement>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;            &lt;/tns:LogElement>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
