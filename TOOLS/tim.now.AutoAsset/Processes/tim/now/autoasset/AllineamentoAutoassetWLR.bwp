 FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&#xa;                                &lt;/tns:LOG_MESSAGE>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns:RECORD_KO>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns:RECORD_KO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns:RECORD_TOTALI>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns:RECORD_TOTALI>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:InputFile>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:InputFile>&#xa;                                &lt;tns:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                                &lt;/tns:ID_FILE>&#xa;                                &lt;tns:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns:STATO_ESEC>&#xa;                                &lt;tns:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:ESITO>&#xa;                                &lt;tns:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/