veMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:int($var)&quot;/>&lt;/tns:NUMERO_RECD>&lt;tns:NUMERO_TELEFONICO>&lt;xsl:value-of select=&quot;tib:trim(tns2:NUMERO_TELEFONICO)&quot;/>&lt;/tns:NUMERO_TELEFONICO>&lt;xsl:if test=&quot;tns2:RADICALE&quot;>&lt;tns:RADICALE>&lt;xsl:value-of select=&quot;tns2:RADICALE&quot;/>&lt;/tns:RADICALE>&lt;/xsl:if>&lt;tns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_INSMTO>&lt;xsl:if test=&quot;tns2:CODICEFATTURAZIONE&quot;>&lt;tns:CODICEFATTURAZIONE>&lt;xsl:value-of select=&quot;tns2:CODICEFATTURAZIONE&quot;/>&lt;/tns:CODICEFATTURAZIONE>&lt;/xsl:if>&lt;/tns:AutoAssetVULL_dettaglio>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns2:AutoAssetWLR_Dettaglio&quot;>&lt;tns:AutoAssetVULL_dettaglio>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns2:CAPOSERIE&quot;>&lt;tns:CAPOSERIE>&lt;xsl:value-of select=&quot;tns2:CAPOSERIE&quot;/>&lt;/tns:CAPOSERIE>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&lt;tns:CONTENUTO_RECORD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&lt;/tns:CONTENUTO_RECORD>&lt;/xsl:if>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tib:trim(tns2:ID_RISORSA_ACCESSO)&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;xsd:int(tns2:ID_NOW_ACCESSO)&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:int($var1)&quot;/>&lt;/tns:NUMERO_RECD>&lt;tns:NUMERO_TELEFONICO>&lt;xsl:value-of select=&quot;tib:trim(tns2:NUMERO_TELEFONICO)&quot;/>&lt;/tns:NUMERO_TELEFONICO>&lt;xsl:if test=&quot;tns2:RADICALE&quot;>&lt;tns:RADICALE>&lt;xsl:value-of select=&quot;tns2:RADICALE&quot;/>&lt;/tns:RADICALE>&lt;/xsl:if>&lt;tns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_INSMTO>&lt;xsl:if test=&quot;tns2:CODICEFATTURAZIONE&quot;>&lt;tns:CODICEFATTURAZIONE>&lt;xsl:value-of select=&quot;tns2:CODICEFATTURAZIONE&quot;/>&lt;/tns:CODICEFATTURAZIONE>&lt;/xsl:if>&lt;/tns:AutoAssetVULL_dettaglio>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:AutoAssetVULL>&lt;/xsl:template>&lt;/xsl:stylesheet>"
