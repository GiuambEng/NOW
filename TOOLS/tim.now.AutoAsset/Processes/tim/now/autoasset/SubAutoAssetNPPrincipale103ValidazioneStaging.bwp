                                    sqlStatement="select ass.IDASSET&#xa;from APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET dett, APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST att , APPUSER.bds_1_casedata_asset ass&#xa;where att.DTTGLSST_TTRBTIDTTGLISST_BDSID=dett.BDS_ID and dett.asset_dettaglioasset_bdsid=ass.bds_id&#xa;AND att.NOMEATTRIBUTO = 'NUMEROTELEFONICO' AND att.VALOREATTRIBUTO = ? AND dett.NOMECOMPONENTE = 'AGGIUNTIVO' AND ass.statoasset = 'ATTIVO' AND ass.offerta in ('WLRLINEANONATTIVA','WLRLINEAATTIVA')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
