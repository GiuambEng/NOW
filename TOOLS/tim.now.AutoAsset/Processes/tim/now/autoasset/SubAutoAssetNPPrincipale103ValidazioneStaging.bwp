                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f682e870-f94f-40bd-b3ca-69aee8403343+input&quot; xmlns:tns1=&quot;http://www.example.org/AutoAssetNPPrincipaleStaging&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.example.org/AutoAssetNPPrincipale103Staging&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectAsset&quot;/>&lt;xsl:param name=&quot;SelectAssetDIN&quot;/>&lt;xsl:param name=&quot;SelectAssetDIN2&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;KOStaging-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;($SelectAsset/Record[1]/OFFERTA = ('ULLLINEANONATTIVA','SLULINEANONATTIVA','VULAFTTH','SEMIVULAFTTH') and $SelectAsset/Record[1]/CODIFICAOLOAGCOM = 'TLC') or (exists($SelectAssetDIN/Record) and $SelectAssetDIN/Record[1]/OFFERTA = ('ULLLINEANONATTIVA','SLULINEANONATTIVA','VULAFTTH','SEMIVULAFTTH') and $SelectAssetDIN/Record[1]/CODIFICAOLOAGCOM = 'TLC') or (exists($SelectAssetDIN2/Record) and $SelectAssetDIN2/Record[1]/OFFERTA = ('ULLLINEANONATTIVA','SLULINEANONATTIVA','VULAFTTH','SEMIVULAFTTH') and $SelectAssetDIN2/Record[1]/CODIFICAOLOAGCOM = 'TLC')&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat('PRESENTE IN CONSISTENZA OFFERTA TLC INCOMPATIBILE – IDASSET = ',string($SelectAsset/Record[1]/IDASSET))&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectAsset/Record[1]/OFFERTA = 'NP' or starts-with($SelectAsset/Record[1]/OFFERTA, 'VULL') or starts-with($SelectAsset/Record[1]/OFFERTA, 'WLR') or starts-with($SelectAsset/Record[1]/OFFERTA, 'SHA')&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat('PRESENTE IN CONSISTENZA OFFERTA OAO INCOMPATIBILE – IDA