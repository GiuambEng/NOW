                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="KOStaging-input"
                                name="KOStaging"
                                outputVariable="KOStaging"
                                tibex:xpdlId="f682e870-f94f-40bd-b3ca-69aee8403343" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
