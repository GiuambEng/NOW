                                    sqlStatement="UPDATE STG_BO_RECUPERO_NP_103_FILE&#xa;  SET DESCRIZIONE_ERRORE = ?, ID_STATO_ELAB_STAG = (SELECT ID_STATO_ELAB_STAG&#xa;FROM TIPOLG_STATO_ELAB_STAG&#xa;WHERE DESCR = ?)&#xa;  WHERE ID_FILE_PROCSTO_INPUT = ? AND NUMERORECORD = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
