                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT IDASSET, OFFERTA, CODIFICAOLOAGCOM&#xd;&#xa;FROM APPUSER.BDS_1_CASEDATA_ASSET&#xd;&#xa;WHERE IDRISORSA IN (SELECT ID_RISORSA_DIN&#xd;&#xa;FROM APPUSER.ASSOCZ_DN_IDRISORSA_DIN&#xd;&#xa;WHERE NUMERO_TELEFONICO = ?) AND STATOASSET = 'ATTIVO'" xsi:type="jdbcPalette:JDBCQueryActivity">
