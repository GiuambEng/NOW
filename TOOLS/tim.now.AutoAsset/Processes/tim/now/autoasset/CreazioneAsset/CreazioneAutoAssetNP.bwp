                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Casetype&quot;/>&#xa;    &lt;xsl:param name=&quot;caseModel&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectStag&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCLIENTE&quot;/>&#xa;    &lt;xsl:template name=&quot;Create-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Create>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:caseType>&#xa;                        &lt;xsl:value-of select=&quot;$Casetype&quot;/>&#xa;                    &lt;/tns:caseType>&#xa;                    &lt;tns:caseModelVersion>&#xa;                        &lt;xsl:value-of select=&quot;$caseModel&quot;/>&#xa;                    &lt;/tns:caseModelVersion>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;concat('MIG','-',string($SelectAsset/Record[1]/BDS_ID))&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$SelectAsset/Record[1]/CODICEORDINETI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/CODICEORDINETI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$SelectAsset/Record[1]/IDRICHIESTAOLO&quot;>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/IDRICHIESTAOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelectAsset/Record[1]/IDPRIMOORDINE&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/IDPRIMOORDINE&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/IDCONTRATTO)&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ATTIVO&amp;quot;&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/ID_RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$SelectStag/Record[number($index)]/ID_RISORSA&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/ID_RISORSA&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd', substring(string($SelectAsset/Record[1]/DES), 1, 10))&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;xsl:if test=&quot;exists($SelectAsset/Record[1]/DES)&quot;>&#xa;                            &lt;ORA_DES>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-time(&amp;quot;yyyy-MM-dd&amp;quot;,xsd:string($SelectAsset/Record[1]/DES ))&quot;/>&#xa;                            &lt;/ORA_DES>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FONIA&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;'NP'&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$SelectAsset/Record[1]/INTERNO&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/INTERNO&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelectAsset/Record[1]/SCALA&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/SCALA&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;dettaglioasset>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                            &lt;IDDettaglioAssetParent>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                            &lt;/IDDettaglioAssetParent>&#xa;                            &lt;IDDettaglioAssetRoot>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                            &lt;/IDDettaglioAssetRoot>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;concat(string(xsd:int($SelectAsset/Record[1]/BDS_ID)),'1')&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/ID_RISORSA&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NUMBERPORTABILITY&amp;quot;&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;xsl:if test=&quot;string-length($SelectStag/Record[number($index)]/TIPO_DN)>0&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'TIPOSERVIZIO'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/TIPO_DN&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($SelectStag/Record[number($index)]/TIPO_LINEA)>0&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'TIPOLINEANP'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/TIPO_LINEA&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($SelectStag/Record[number($index)]/ROUTING_NUM)>0&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'ROUTINGNUMBER'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/ROUTING_NUM&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($SelectStag/Record[number($index)]/RADICE_GNR)>0&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'RADICALE'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/RADICE_GNR&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($SelectStag/Record[number($index)]/CAPOSERIE)>0&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'CAPOSERIE'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/CAPOSERIE&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($SelectStag/Record[number($index)]/DISTRETTO)>0&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'DISTRETTO'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/DISTRETTO&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($SelectStag/Record[number($index)]/ID_RISORSA)>0&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'NUMEROTELEFONICOPRINCIPALE'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/ID_RISORSA&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($SelectStag/Record[number($index)]/NUMERO_TELEFONICO)>0&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'NUMEROTELEFONICO'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/NUMERO_TELEFONICO&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($SelectStag/Record[number($index)]/OLO_DONOR)>0&quot;>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/BDS_ID)&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'CODICEOPERATOREDONOR'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectStag/Record[number($index)]/OLO_DONOR&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &l