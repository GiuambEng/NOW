                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/" xmlns:tns="http://www.tim.com/NOW/xsd/FindUpdateCase/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Casetype"/&gt;&lt;xsl:param name="caseModel"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="SelectAsset"/&gt;&lt;xsl:param name="SelectStag"/&gt;&lt;xsl:param name="SelectCLIENTE"/&gt;&lt;xsl:template name="Create-input" match="/"&gt;&lt;ns:Request&gt;&lt;part1&gt;&lt;tns:Input&gt;&lt;tns:Create&gt;&lt;tns:Input&gt;&lt;tns:caseType&gt;&lt;xsl:value-of select="$Casetype"/&gt;&lt;/tns:caseType&gt;&lt;tns:caseModelVersion&gt;&lt;xsl:value-of select="$caseModel"/&gt;&lt;/tns:caseModelVersion&gt;&lt;tns:Asset&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="concat('MIG','-',string($SelectAsset/Record[1]/BDS_ID))"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="$SelectAsset/Record[1]/CODICEORDINETI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="$SelectAsset/Record[1]/CODICEORDINETI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="$SelectAsset/Record[1]/CODIFICAOLOAGCOM"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;created&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/operatore&gt;&lt;xsl:if test="$SelectAsset/Record[1]/IDRICHIESTAOLO"&gt;&lt;IDRichiestaOLO&gt;&lt;xsl:value-of select="$SelectAsset/Record[1]/IDRICHIESTAOLO"/&gt;&lt;/IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$SelectAsset/Record[1]/IDPRIMOORDINE"&gt;&lt;IDPrimoOrdine&gt;&lt;xsl:value-of select="$SelectAsset/Record[1]/IDPRIMOORDINE"/&gt;&lt;/IDPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="xsd:int($SelectAsset/Record[1]/IDCONTRATTO)"/&gt;&l