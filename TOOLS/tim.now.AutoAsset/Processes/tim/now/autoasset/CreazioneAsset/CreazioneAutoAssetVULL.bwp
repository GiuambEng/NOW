Donor"/&gt;&lt;/codificaOLONOWDonor&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/tipologiaScenario"&gt;&lt;tipologiaScenario&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/tipologiaScenario"/&gt;&lt;/tipologiaScenario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/totaleOrdinePacchetto"&gt;&lt;totaleOrdinePacchetto&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/totaleOrdinePacchetto"/&gt;&lt;/totaleOrdinePacchetto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/IDCorrelazione"&gt;&lt;IDCorrelazione&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/IDCorrelazione"/&gt;&lt;/IDCorrelazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/numTelPrincipale"&gt;&lt;numTelPrincipale&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/numTelPrincipale"/&gt;&lt;/numTelPrincipale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/codiceFatturazioneJPUB"&gt;&lt;codiceFatturazioneJPUB&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/codiceFatturazioneJPUB"/&gt;&lt;/codiceFatturazioneJPUB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/CRMEstrattore"&gt;&lt;CRMEstrattore&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/CRMEstrattore"/&gt;&lt;/CRMEstrattore&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/IDRichiestaOLD"&gt;&lt;IDRichiestaOLD&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/IDRichiestaOLD"/&gt;&lt;/IDRichiestaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($fIN/part1/tns:Output/tns:Find[1]/tns:Asset/cliente)"&gt;&lt;xsl:copy-of select="$fIN/part1/tns:Output/tns:Find/tns:Asset/cliente"/&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/LNA_LA"&gt;&lt;LNA_LA&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/LNA_LA"/&gt;&lt;/LNA_LA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/modalitaFatturazione"&gt;&lt;modalitaFatturazione&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/modalitaFatturazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/IDRisorsaCorrelato"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/IDRisorsaCorrelato"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/operatoreRete"&gt;&lt;operatoreRete&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/operatoreRete"/&gt;&lt;/operatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/opzioneDinamica"&gt;&lt;opzioneDinamica&gt;&lt;xsl:value-of select="$fIN/part1/tns:Output/tns:Find[1]/tns:Asset/opzioneDinamica"/&gt;&lt;/opzioneDinamica&gt;&lt;/xsl:if&gt;&lt;/tns:Asset&gt;&lt;/tns:Input&gt;&lt;/tns:Update&gt;&lt;/tns:Input&gt;&lt;/part1&gt;&lt;/ns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;fIN.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectStag&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDRichiestaOLO&quot;>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/statoAsset&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDAssetCRMWS&quot;>&#xa;                            &lt;IDAssetCRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDAssetCRMWS&quot;/>&#xa;                            &lt;/IDAssetCRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$fIN.part1/tns:Find[1]/tns:Asset/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                 