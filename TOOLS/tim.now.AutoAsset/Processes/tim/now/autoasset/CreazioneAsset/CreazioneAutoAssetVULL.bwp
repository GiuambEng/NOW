                                <bpws:sources>
                                    <bpws:source linkName="GroupStartTofIN"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="8f2b4fcb-b6b4-4139-ac85-862abf359524">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToGroupEnd"/>
                                    <bpws:target linkName="JDBCUpdate1ToGroupEnd"/>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e2a0c59b-80a9-444a-a4a5-50d60f755c19+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://schemas.tibco.com/bw/pe/plugin/5.0/exceptions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SelectStag&quot;/>&lt;xsl:param name=&quot;fIN&quot;/>&lt;xsl:param name=&quot;_error_Update&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;count($fIN/part1/tns2:Output/tns2:Find)=0&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;'Asset Non trovato'&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat('Errore su updateAsset',$_error_Update/tns1:ActivityTimedOutException/msg,$_error_Update/tns1:ActivityTimedOutException/msgCode,$_error_Update/tns2:Fault/tns2:Error/tns2:Code,$_error_Update/tns2:Fault/tns2:Error/tns2:ErrorCode,$_error/StackTrace,$_error/ProcessStack)&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;5&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;TIMESTAMP_AGG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMESTAMP_AGG>&lt;ID_FILE_PROCTO_INPUT>&lt;xsl:value-of select=&quot;xsd:int($SelectStag/Record[number($index)]/ID_FILE_PROCTO_INPUT)&quot;/>&lt;/ID_FILE_PROCTO_INPUT>&lt;NUMERO_TELEFONICO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectStag/Record[number($index)]/NUMERO_TELEFONICO)&quot;>&lt;xsl:value-of select=&quot;$SelectStag/Record[nu