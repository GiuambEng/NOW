<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/CheckDati/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/CheckDati/">


    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="FILENAME" type="string"></element>
    			<element name="Transaction_ID" type="string"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="FLUSSO" type="string"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="CheckDate">
    	<complexType>
    		<sequence>
    			<element name="DateTime" maxOccurs="1" minOccurs="0">

                   <simpleType>
    					 <restriction base="string">
    					 <pattern
          value="((000[1-9])|(00[1-9][0-9])|(0[1-9][0-9]{2})|([1-9][0-9]{3}))((0[1-9])|(1[012]))((0[1-9])|([12][0-9])|(3[01]))(([01][0-9])|(2[0-3]))([0-5][0-9])([0-5][0-9])" />
        </restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>