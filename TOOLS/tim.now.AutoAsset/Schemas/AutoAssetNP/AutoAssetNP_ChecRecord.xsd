<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AutoAssetNP_ChecRecord/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AutoAssetNP_ChecRecord/">


	<element name="AllineamentoAutoAssetNP">
		<complexType>
			<sequence>
				<element ref="tns:AllineamentoAutoAssetNP_Dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	
	<element name="AllineamentoAutoAssetNP_Dettaglio">
		<complexType>
			<sequence>
				<element name="TIPO_RECORD" type="string"
    							maxOccurs="1" minOccurs="1">
    						</element>
    						<element name="ID_NOW_ACCESSO"
    							type="string" maxOccurs="1" minOccurs="1">
    						</element>
    						<element name="RISORSA"
    							type="string" maxOccurs="1" minOccurs="1">
    						</element>
    						<element name="DES_PRIMARY_NUMBER"
    							type="date" maxOccurs="1" minOccurs="1">
    						</element>
    						<element name="DISTR_TELEFONICO" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="PRIMARY_NUMBER" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="TIPO_DN" maxOccurs="1"
    							minOccurs="0">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="0"></enumeration>
    									<enumeration value="1"></enumeration>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="TIPO_LINEA" maxOccurs="1"
    							minOccurs="0">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="0"></enumeration>
    									<enumeration value="1"></enumeration>
    									<enumeration value="2"></enumeration>
    									<enumeration value="3"></enumeration>
    									<enumeration value="4"></enumeration>
    									<enumeration value="5"></enumeration>
    									<enumeration value="6"></enumeration>
    									<enumeration value="7"></enumeration>
    									<enumeration value="8"></enumeration>
    									<enumeration value="9"></enumeration>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="ROUTING_NUMBER" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="RADICE_GNR" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="CAPOSTIPITE" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="DONOR" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="DONATING" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="RETAILER" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"/>
    						<element name="Flag_validita" type="string" maxOccurs="1" minOccurs="0"></element>
				            
			</sequence>
		</complexType>
	</element>

</schema>