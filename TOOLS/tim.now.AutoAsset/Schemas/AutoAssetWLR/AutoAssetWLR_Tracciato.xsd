<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AutoAssetWLR_Tracciato/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AutoAssetWLR_Tracciato/">



<element name="AutoAssetWLR">
		<complexType>
			<sequence>
				<element ref="tns:AutoAssetWLR_Dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="AutoAssetWLR_Dettaglio">
		<complexType>
			<sequence>
					<element name="TIPO_RECORD" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_RISORSA_ACCESSO"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="NUMERO_TELEFONICO"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="CODICEFATTURAZIONE"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="RADICALE" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="CAPOSERIE" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_NOW_ACCESSO" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="Flag_validita" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>


</schema>