                    <bpws:extensionActivity>
                        <tibex:extActivity
                            inputVariable="Log_Out_KO-input"
                            name="Log_Out_KO"
                            tibex:xpdlId="029d19be-97fc-4e1f-91cf-56bc1afc2aa6"
                            type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="AckComunicazioneToCallProcess"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Log_Out_KOToInsertUpdateStaging"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Ack_Message&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_Out_KO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioNotifica'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Inviato ACK negativo a DTU, con descrizione: &amp;quot;, $Ack_Message/ns:DESCRIZIONE_ERRORE)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Ack_Message, false(), false())&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.dtureceiver&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NotificationFromDTU&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                        &lt;/tns2:BusinessID>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NotificationFromDTU_COMPLETED&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;NotificationFromDTU_&amp;quot;, $MapInput/ns:TESTATA/ns:ID_RICHIESTA)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                moduleRef="tim.now.shared_library"
                                spawn="true"
                                subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                        </tibex:extActivity>
                    </bpws:extensionActivity>
                    <bpws:invoke inputVariable="Update_KOStaging-input"
                        name="Update_KOStaging"
                        operation="InsertUpdateStaging"
                        outputVariable="Update_KOStaging"
                        partnerLink="InsertUpdateStagingPortType"
                        portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="a614e3e5-18e6-4b29-919d-457cc55bacd6">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="IdProcessoNotificaDTU"/&gt;
    &lt;xsl:param name="Select_IdTipologiaEvento"/&gt;
    &lt;xsl:param name="ReceiveDTUMessage"/&gt;
    &lt;xsl:param name="StatoStagingKO"/&gt;
    &lt;xsl:param name="Ack_Message"/&gt;
    &lt;xsl:param name="MapInput"/&gt;
    &lt;xsl:param name="InsertStaging"/&gt;
    &lt;xsl:param name="IdRichiestaOlo_Original"/&gt;
    &lt;xsl:template name="Update_KOStaging-input" match="/"&gt;
        &lt;tns3:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns4:StagingRequest&gt;
                    &lt;tns4:StagingIn&gt;
                        &lt;tns4:CONTENUTO_RESPONSE&gt;
                            &lt;xsl:value-of select="tib:render-xml($ReceiveDTUMessage/Body/tns2:Envelope)"/&gt;
                        &lt;/tns4:CONTENUTO_RESPONSE&gt;
                        &lt;xsl:if test="$Ack_Message/ns:DESCRIZIONE_ERRORE"&gt;
                            &lt;tns4:DESCR_ERRORE&gt;
                                &lt;xsl:value-of select="$Ack_Message/ns:DESCRIZIONE_ERRORE"/&gt;
                            &lt;/tns4:DESCR_ERRORE&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:HTTP_RESPONSE&gt;
                            &lt;xsl:value-of select="''"/&gt;
                        &lt;/tns4:HTTP_RESPONSE&gt;
                        &lt;tns4:IDTPLG_EVENTO&gt;
                            &lt;xsl:value-of select="xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)"/&gt;
                        &lt;/tns4:IDTPLG_EVENTO&gt;
                        &lt;tns4:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                        &lt;/tns4:ID_PROCSO_NO_FILE&gt;
                        &lt;tns4:ID_RICH_DTU&gt;
                            &lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:ID_RICH_DTU&gt;
                        &lt;tns4:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$IdRichiestaOlo_Original"/&gt;
                        &lt;/tns4:ID_RICH_OLO&gt;
                        &lt;tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="$StatoStagingKO"/&gt;
                        &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                        &lt;tns4:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns4:OPERATORE&gt;
                        &lt;tns4:TIME_UPDATE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIME_UPDATE&gt;
                        &lt;tns4:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RICH&gt;
                        &lt;tns4:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RISPOSTA&gt;
                        &lt;tns4:TRANSACTION_ID&gt;
                            &lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:TRANSACTION_ID&gt;
                    &lt;/tns4:StagingIn&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RISPOSTA_DTU'"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns2:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns2:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_FINE_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;xsl:if test="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns2:COD_PROCSO&gt;
                                    &lt;xsl:value-of select="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns2:COD_PROCSO&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns2:ID_ESEC_PROCSO&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW ASINC: RISPOSTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns3:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcessoNotificaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_IdTipologiaEvento&quot;/>&#xa;    &lt;xsl:param name=&quot;ReceiveDTUMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingKO&quot;/>&#xa;    &lt;xsl:param name=&quot;Ack_Message&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;Update_KOStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ReceiveDTUMessage/Body/tns2:Envelope)&quot;/>&#xa;                &lt;/tns4:CONTENUTO_RESPONSE>&#xa;                &lt;xsl:if test=&quot;$Ack_Message/ns:DESCRIZIONE_ERRORE&quot;>&#xa;                    &lt;tns4:DESCR_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;$Ack_Message/ns:DESCRIZIONE_ERRORE&quot;/>&#xa;                    &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:HTTP_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns4:HTTP_RESPONSE>&#xa;                &lt;tns4:IDTPLG_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)&quot;/>&#xa;                &lt;/tns4:IDTPLG_EVENTO>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;tns4:ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:ID_RICH_DTU>&#xa;                &lt;tns4:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$StatoStagingKO&quot;/>&#xa;                &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                &lt;tns4:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns4:OPERATORE>&#xa;                &lt;tns4:TIME_UPDATE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIME_UPDATE>&#xa;                &lt;tns4:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RICH>&#xa;                &lt;tns4:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RISPOSTA>&#xa;                &lt;tns4:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:TRANSACTION_ID>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RISPOSTA_DTU'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns2:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaProcesso>&#xa;                &lt;ns2:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaOperazione>&#xa;                &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns2:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns2:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns2:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                    &lt;/ns2:STATO_ESEC>&#xa;                    &lt;ns2:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TMSP_FINE_ELAB>&#xa;                &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns2:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns2:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns2:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns2:ID_ESEC_PROCSO>&#xa;                    &lt;ns2:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns2:LOG_LEVEL>&#xa;                    &lt;ns2:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA SIS EST A NOW ASINC: RISPOSTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns2:LOG_MESSAGE>&#xa;                    &lt;ns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TIMSTP_INSMTO>&#xa;                &lt;/ns2:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <bpws:targets>
                            <bpws:target linkName="Log_Out_KOToInsertUpdateStaging"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="UpdateKOStagingToGroupEnd1"/>
                        </bpws:sources>
                        <bpws:correlations/>
                    </bpws:invoke>
                    <bpws:extensionActivity>
                        <tibex:activityExtension
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/&quot; xmlns:Q2=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v2/&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectProgressivo&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_DTUEvento&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperBPMNotification-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q2:manageNotificationSenzaArricchimentiRequest>&#xa;            &lt;Q2:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/Q2:ID_RICHIESTA>&#xa;            &lt;Q2:ProgressivoNotificaDTU>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($SelectProgressivo/tns2:ProgressivoNotifiche)&quot;/>&#xa;            &lt;/Q2:ProgressivoNotificaDTU>&#xa;            &lt;Q2:IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_DTUEvento/output/Q1:DTUEventoResponse/IdEventoOrdnNowWhls))&quot;/>&#xa;            &lt;/Q2:IdEventoOrdnNowWhls>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InsertStaging/RESPONSE/tns3:StagingResponse/tns3:LogResponse/ns1:COD_PROCSO_NO_FILE) > 0&quot;>&#xa;                    &lt;Q2:CodProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;$InsertStaging/RESPONSE/tns3:StagingResponse/tns3:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/Q2:CodProcsoNoFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Q2:CodProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/Q2:CodProcsoNoFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InsertStaging/RESPONSE/tns3:StagingResponse/tns3:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;Q2:IdEsecProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(xsd:double($InsertStaging/RESPONSE/tns3:StagingResponse/tns3:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/Q2:IdEsecProcsoNoFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Q2:IdEsecProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/Q2:IdEsecProcsoNoFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$MapInput&quot;/>&#xa;            &lt;Q2:ID_ANAGRAFICA_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/Q2:ID_ANAGRAFICA_CAUSALE>&#xa;        &lt;/Q2:manageNotificationSenzaArricchimentiRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                            inputVariable="MapperBPMNotification-input"
                            name="MapperBPMNotification"
                            outputVariable="MapperBPMNotification"
                            tibex:xpdlId="744cd4e4-4a10-4181-8ca9-16ca82671e5e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="CallProcessToMapperBPMNotification"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="MapperBPMNotificationToLogMapperBPM"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/&quot; xmlns:Q2=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v2/&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_DTUEvento.output&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProgressivo&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperBPMNotification-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q2:manageNotificationSenzaArricchimentiRequest>&#xa;            &lt;Q2:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/Q2:ID_RICHIESTA>&#xa;            &lt;Q2:ProgressivoNotificaDTU>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($SelectProgressivo/tns2:ProgressivoNotifiche)&quot;/>&#xa;            &lt;/Q2:ProgressivoNotificaDTU>&#xa;            &lt;Q2:IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_DTUEvento.output/IdEventoOrdnNowWhls))&quot;/>&#xa;            &lt;/Q2:IdEventoOrdnNowWhls>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InsertStaging.RESPONSE/tns3:LogResponse/ns1:COD_PROCSO_NO_FILE) > 0&quot;>&#xa;                    &lt;Q2:CodProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns3:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/Q2:CodProcsoNoFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Q2:CodProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/Q2:CodProcsoNoFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InsertStaging.RESPONSE/tns3:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;Q2:IdEsecProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(xsd:double($InsertStaging.RESPONSE/tns3:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/Q2:IdEsecProcsoNoFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Q2:IdEsecProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/Q2:IdEsecProcsoNoFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$MapInput&quot;/>&#xa;            &lt;Q2:ID_ANAGRAFICA_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/Q2:ID_ANAGRAFICA_CAUSALE>&#xa;        &lt;/Q2:manageNotificationSenzaArricchimentiRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:BPM_DTUNotificationManagement_v2="http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v2/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="BPM_DTUNotificationManagement_v2:manageNotificationSenzaArricchimentiRequest" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            inputVariable="LogMapperBPM-input"
                            name="LogMapperBPM"
                            tibex:xpdlId="36f998f9-65dd-4a4f-b46a-219fdc79b7ac"
                            type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="MapperBPMNotificationToLogMapperBPM"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="LogMapperBPMToCallProcess_LINEARIZZATOREOFF">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($LinearizzatoreONOFF) = 'OFF'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($LinearizzatoreONOFF) = 'OFF']]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="LogMapperBPMToJMSSendMessage3_LINEARIZZATOREON">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperBPMNotification&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapperBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioNotifica'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Invio al BPM&amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperBPMNotification, true(), true())&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                moduleRef="tim.now.shared_library"
                                spawn="true"
                                subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                        </tibex:extActivity>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            inputVariable="Log_Output-input"
                            name="Log_Output"
                            tibex:xpdlId="29a67bfd-ad96-46aa-83fd-b09f2d42fc27"
                            type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="Update_OKStagingToLog_Output"/>
                                <bpws:target linkName="SalvaProgressivoToLog_NOTFNOW"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Log_OutputToGroupEnd1"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Ack_Message&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:param name=&quot;LinearizzatoreONOFF&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_Output-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioNotifica'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($LinearizzatoreONOFF) = 'ON'&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Inviata notifica DTU al BPM, e messaggio inviato sulla coda del LINEARIZZATORE cross constraint superati con causale: &amp;quot;, $Ack_Message/ns:CAUSALE_ESITO)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Inviata notifica DTU al BPM, cross constraint superati con causale: &amp;quot;, $Ack_Message/ns:CAUSALE_ESITO)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.dtureceiver&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NotificationFromDTU&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                        &lt;/tns2:BusinessID>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NotificationFromDTU_COMPLETED&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;NotificationFromDTU_&amp;quot;, $MapInput/ns:TESTATA/ns:ID_RICHIESTA)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                moduleRef="tim.now.shared_library"
                                spawn="true"
                                subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                        </tibex:extActivity>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            inputVariable="SalvaProgressivo-input"
                            name="SalvaProgressivo"
                            outputVariable="SalvaProgressivo"
                            tibex:xpdlId="f9cf0113-249c-4791-8308-d91139fbcfa3"
                            type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="CallProcessToSalvaProgressivo"/>
                                <bpws:target linkName="JMSSendMessage3ToSalvaProgressivo"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="SalvaProgressivoToUpdate_OKStaging">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="SalvaProgressivoToLog_NOTFNOW">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="starts-with($MapInput/ns1:TESTATA/ns1:TRANSACTION_ID, $TransactionNOW)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[starts-with($MapInput/ns1:TESTATA/ns1:TRANSACTION_ID, $TransactionNOW)]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectProgressivo&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;SalvaProgressivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input_Upsert_Progressivo>&#xa;            &lt;tns2:IDRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/tns2:IDRichiestaOlo>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$SelectProgressivo/tns2:ProgressivoNotifiche > 1&quot;>&#xa;                    &lt;tns2:Azione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Azione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Azione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Azione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:ProgressivoNotifiche>&#xa;                &lt;xsl:value-of select=&quot;$SelectProgressivo/tns2:ProgressivoNotifiche&quot;/>&#xa;            &lt;/tns2:ProgressivoNotifiche>&#xa;        &lt;/tns2:Input_Upsert_Progressivo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                subProcessName="tim.now.integration_singlenode.dtureceiver.subprocesses.UpsertProgrNotifDTU" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                        </tibex:extActivity>
                    </bpws:extensionActivity>
                    <bpws:invoke inputVariable="Update_OKStaging-input"
                        name="Update_OKStaging"
                        operation="InsertUpdateStaging"
                        outputVariable="Update_OKStaging"
                        partnerLink="InsertUpdateStagingPortType"
                        portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="ee86c68d-a77d-4007-a981-851de55e8239">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns3="http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/" version="2.0"&gt;
    &lt;xsl:param name="IdProcessoNotificaDTU"/&gt;
    &lt;xsl:param name="Select_IdTipologiaEvento"/&gt;
    &lt;xsl:param name="MapInput"/&gt;
    &lt;xsl:param name="InsertStaging"/&gt;
    &lt;xsl:param name="SelectProgressivo"/&gt;
    &lt;xsl:param name="StatoStagingOK"/&gt;
    &lt;xsl:param name="IdRichiestaOlo_Original"/&gt;
    &lt;xsl:template name="Update_OKStaging-input" match="/"&gt;
        &lt;tns2:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns4:StagingRequest&gt;
                    &lt;tns4:StagingIn&gt;
                        &lt;tns4:HTTP_RESPONSE&gt;
                            &lt;xsl:value-of select="''"/&gt;
                        &lt;/tns4:HTTP_RESPONSE&gt;
                        &lt;tns4:IDTPLG_EVENTO&gt;
                            &lt;xsl:value-of select="xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)"/&gt;
                        &lt;/tns4:IDTPLG_EVENTO&gt;
                        &lt;tns4:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                        &lt;/tns4:ID_PROCSO_NO_FILE&gt;
                        &lt;tns4:ID_RICH_DTU&gt;
                            &lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:ID_RICH_DTU&gt;
                        &lt;tns4:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$IdRichiestaOlo_Original"/&gt;
                        &lt;/tns4:ID_RICH_OLO&gt;
                        &lt;xsl:if test="$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU"&gt;
                            &lt;tns4:ID_ORDINE_DTU&gt;
                                &lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU"/&gt;
                            &lt;/tns4:ID_ORDINE_DTU&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="$StatoStagingOK"/&gt;
                        &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                        &lt;tns4:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns4:OPERATORE&gt;
                        &lt;tns4:TIME_UPDATE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIME_UPDATE&gt;
                        &lt;tns4:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RICH&gt;
                        &lt;tns4:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RISPOSTA&gt;
                        &lt;tns4:TRANSACTION_ID&gt;
                            &lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:TRANSACTION_ID&gt;
                        &lt;tns4:PROGRESSIVO_NOTIFICA&gt;
                            &lt;xsl:value-of select="xsd:int($SelectProgressivo/tns3:ProgressivoNotifiche)"/&gt;
                        &lt;/tns4:PROGRESSIVO_NOTIFICA&gt;
                    &lt;/tns4:StagingIn&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RISPOSTA_DTU'"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns2:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns2:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_FINE_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;xsl:if test="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns2:COD_PROCSO&gt;
                                    &lt;xsl:value-of select="$InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns2:COD_PROCSO&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns2:ID_ESEC_PROCSO&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW ASINC: RISPOSTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns2:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcessoNotificaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_IdTipologiaEvento&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProgressivo&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingOK&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;Update_OKStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:HTTP_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns4:HTTP_RESPONSE>&#xa;                &lt;tns4:IDTPLG_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)&quot;/>&#xa;                &lt;/tns4:IDTPLG_EVENTO>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;tns4:ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:ID_RICH_DTU>&#xa;                &lt;tns4:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;xsl:if test=&quot;$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                    &lt;tns4:ID_ORDINE_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                    &lt;/tns4:ID_ORDINE_DTU>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$StatoStagingOK&quot;/>&#xa;                &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                &lt;tns4:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns4:OPERATORE>&#xa;                &lt;tns4:TIME_UPDATE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIME_UPDATE>&#xa;                &lt;tns4:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RICH>&#xa;                &lt;tns4:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RISPOSTA>&#xa;                &lt;tns4:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:TRANSACTION_ID>&#xa;                &lt;tns4:PROGRESSIVO_NOTIFICA>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($SelectProgressivo/tns3:ProgressivoNotifiche)&quot;/>&#xa;                &lt;/tns4:PROGRESSIVO_NOTIFICA>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RISPOSTA_DTU'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns2:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaProcesso>&#xa;                &lt;ns2:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaOperazione>&#xa;                &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns2:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns2:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns2:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                    &lt;/ns2:STATO_ESEC>&#xa;                    &lt;ns2:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TMSP_FINE_ELAB>&#xa;                &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns2:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns2:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns2:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns2:ID_ESEC_PROCSO>&#xa;                    &lt;ns2:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns2:LOG_LEVEL>&#xa;                    &lt;ns2:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA SIS EST A NOW ASINC: RISPOSTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns2:LOG_MESSAGE>&#xa;                    &lt;ns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TIMSTP_INSMTO>&#xa;                &lt;/ns2:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
