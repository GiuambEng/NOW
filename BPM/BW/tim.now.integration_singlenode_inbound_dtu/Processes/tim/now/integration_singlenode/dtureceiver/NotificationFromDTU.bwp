                        portType="ns6:DTUEventoPortType" tibex:xpdlId="1f66a2a8-dac3-4734-ac3f-35b838d1e90e">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/DTUEvento/" xmlns:Q1="http://www.tim.com/NOW/xsd/DTUEventoOrdine/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" version="2.0"&gt;&lt;xsl:param name="MapInput"/&gt;&lt;xsl:param name="IdRichiestaOlo_Original"/&gt;&lt;xsl:param name="Oscuramento"/&gt;&lt;xsl:template name="Invoke_DTUEvento-input" match="/"&gt;&lt;tns1:DTU_Evento&gt;&lt;input&gt;&lt;Q1:DTUEventoRequest&gt;&lt;ns:EVENTO_NOTIFICA&gt;&lt;ns:TESTATA&gt;&lt;ns:ID_RICHIESTA&gt;&lt;xsl:value-of select="$IdRichiestaOlo_Original"/&gt;&lt;/ns:ID_RICHIESTA&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:TRANSACTION_ID"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;ns:TIPOLOGIA_NOTIFICA&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA"/&gt;&lt;/ns:TIPOLOGIA_NOTIFICA&gt;&lt;ns:DATA_INVIO_NOTIFICA_NOW&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:DATA_INVIO_NOTIFICA_NOW"/&gt;&lt;/ns:DATA_INVIO_NOTIFICA_NOW&gt;&lt;ns:CODICE_ORDINE_OLO&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:CODICE_ORDINE_OLO"/&gt;&lt;/ns:CODICE_ORDINE_OLO&gt;&lt;ns:CODICE_OLO&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:CODICE_OLO"/&gt;&lt;/ns:CODICE_OLO&gt;&lt;ns:CODICE_ORDINE_TI&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:CODICE_ORDINE_TI"/&gt;&lt;/ns:CODICE_ORDINE_TI&gt;&lt;ns:CODICE_ESITO&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:CODICE_ESITO"/&gt;&lt;/ns:CODICE_ESITO&gt;&lt;ns:CAUSALE_ESITO&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:CAUSALE_ESITO"/&gt;&lt;/ns:CAUSALE_ESITO&gt;&lt;ns:DATA_ESITO&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:DATA_ESITO"/&gt;&lt;/ns:DATA_ESITO&gt;&lt;xsl:if test="$MapInput/ns:TESTATA/ns:ID_PACCHETTO"&gt;&lt;ns:ID_PACCHETTO&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:ID_PACCHETTO"/&gt;&lt;/ns:ID_PACCHETTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$MapInput/ns:TESTATA/ns:STATO_DISAGGREGAZIONE"&gt;&lt;ns:STATO_DISAGGREGAZIONE&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:STATO_DISAGGREGAZIONE"/&gt;&lt;/ns:STATO_DISAGGREGAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU"&gt;&lt;ns:ID_ORDINE_DTU&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU"/&gt;&lt;/ns:ID_ORDINE_DTU&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$MapInput/ns:TESTATA/ns:STATO_TOKEN_APPUNTAMENTO"&gt;&lt;ns:STATO_TOKEN_APPUNTAMENTO&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:STATO_TOKEN_APPUNTAMENTO"/&gt;&lt;/ns:STATO_TOKEN_APPUNTAMENTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="(count($Oscuramento/Record[COD_AGESP='T1PRJ0135825'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0135825'])&gt;0 and $Oscuramento/Record[COD_AGESP='T1PRJ0135825']/FLAG_OSCURMENTO=('0','N')))"&gt;&lt;xsl:if test="$MapInput/ns:TESTATA/ns:ID_FOGLIA"&gt;&lt;ns:ID_FOGLIA&gt;&lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:ID_FOGLIA"/&gt;&lt;/ns:ID_FOGLIA&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;/ns:TESTATA&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($MapInput/ns:INTERMEDIA)"&gt;&lt;xsl:copy-of select="$MapInput/ns:INTERMEDIA"/&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($MapInput/ns:FINALE)"&gt;&lt;xsl:copy-of select="$MapInput/ns:FINALE"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:copy-of select="$MapInput/ns:CONFERMA_ANNULLAMENTO"/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:EVENTO_NOTIFICA&gt;&lt;/Q1:DTUEventoRequest&gt;&lt;/input&gt;&lt;/tns1:DTU_Evento&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/DTUEvento/&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_DTUEvento-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q1:DTUEventoRequest>&#xa;            &lt;ns:EVENTO_NOTIFICA>&#xa;                &lt;ns:TESTATA>&#xa;                    &lt;ns:ID_RICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                    &lt;/ns:ID_RICHIESTA>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:TIPOLOGIA_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                    &lt;/ns:TIPOLOGIA_NOTIFICA>&#xa;                    &lt;ns:DATA_INVIO_NOTIFICA_NOW>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:DATA_INVIO_NOTIFICA_NOW&quot;/>&#xa;                    &lt;/ns:DATA_INVIO_NOTIFICA_NOW>&#xa;                    &lt;ns:CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:CODICE_ORDINE_OLO&quot;/>&#xa;                    &lt;/ns:CODICE_ORDINE_OLO>&#xa;                    &lt;ns:CODICE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:CODICE_OLO&quot;/>&#xa;                    &lt;/ns:CODICE_OLO>&#xa;                    &lt;ns:CODICE_ORDINE_TI>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:CODICE_ORDINE_TI&quot;/>&#xa;                    &lt;/ns:CODICE_ORDINE_TI>&#xa;                    &lt;ns:CODICE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:CODICE_ESITO&quot;/>&#xa;                    &lt;/ns:CODICE_ESITO>&#xa;                    &lt;ns:CAUSALE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:CAUSALE_ESITO&quot;/>&#xa;                    &lt;/ns:CAUSALE_ESITO>&#xa;                    &lt;ns:DATA_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:DATA_ESITO&quot;/>&#xa;                    &lt;/ns:DATA_ESITO>&#xa;                    &lt;xsl:if test=&quot;$MapInput/ns:TESTATA/ns:ID_PACCHETTO&quot;>&#xa;                        &lt;ns:ID_PACCHETTO>&#xa;                            &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_PACCHETTO&quot;/>&#xa;                        &lt;/ns:ID_PACCHETTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapInput/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;>&#xa;                        &lt;ns:STATO_DISAGGREGAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:STATO_DISAGGREGAZIONE&quot;/>&#xa;                        &lt;/ns:STATO_DISAGGREGAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                        &lt;ns:ID_ORDINE_DTU>&#xa;                            &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                        &lt;/ns:ID_ORDINE_DTU>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$MapInput/ns:TESTATA/ns:STATO_TOKEN_APPUNTAMENTO&quot;>&#xa;                        &lt;ns:STATO_TOKEN_APPUNTAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:STATO_TOKEN_APPUNTAMENTO&quot;/>&#xa;                        &lt;/ns:STATO_TOKEN_APPUNTAMENTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;(count($Oscuramento/Record[COD_AGESP='T1PRJ0135825'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0135825'])>0 and $Oscuramento/Record[COD_AGESP='T1PRJ0135825']/FLAG_OSCURMENTO=('0','N')))&quot;>&#xa;                        &lt;xsl:if test=&quot;$MapInput/ns:TESTATA/ns:ID_FOGLIA&quot;>&#xa;                            &lt;ns:ID_FOGLIA>&#xa;                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_FOGLIA&quot;/>&#xa;                            &lt;/ns:ID_FOGLIA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns:TESTATA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapInput/ns:INTERMEDIA)&quot;>&#xa;                        &lt;xsl:copy-of select=&quot;$MapInput/ns:INTERMEDIA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($MapInput/ns:FINALE)&quot;>&#xa;                        &lt;xsl:copy-of select=&quot;$MapInput/ns:FINALE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:copy-of select=&quot;$MapInput/ns:CONFERMA_ANNULLAMENTO&quot;/>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns:EVENTO_NOTIFICA>&#xa;        &lt;/Q1:DTUEventoRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <bpws:targets>
