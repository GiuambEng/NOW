                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapInput&quot;/>&lt;xsl:template name=&quot;Ack_Message&quot; match=&quot;/&quot;>&lt;ns:ACK_COMUNICAZIONE>&lt;ns:DATA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:DATA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapInput/ns:TESTATA/ns:TRANSACTION_ID)&quot;>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&lt;/ns:TRANSACTION_ID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/ns:TRANSACTION_ID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:CAUSALE_ESITO>&lt;xsl:value-of select=&quot;&amp;quot;001&amp;quot;&quot;/>&lt;/ns:CAUSALE_ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA)&quot;>&lt;ns:TIPO_MESSAGGIO>&lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&lt;/ns:TIPO_MESSAGGIO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;ns:DESCRIZIONE_ERRORE>&lt;xsl:value-of select=&quot;&amp;quot;KO Input Validation&amp;quot;&quot;/>&lt;/ns:DESCRIZIONE_ERRORE>&lt;/ns:ACK_COMUNICAZIONE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
