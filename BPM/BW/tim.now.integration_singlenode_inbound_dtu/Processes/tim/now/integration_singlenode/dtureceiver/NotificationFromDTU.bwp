                                    &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NI_TENTATIVO_CONTATTO&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;not(exists($MapInput/ns:INTERMEDIA/ns:CONTATTO))&quot;>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;002&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                                    &lt;ns:DESCRIZIONE_ERRORE>&#xa;                                                        &lt;xsl:value-of select=&quot;concat(&amp;quot;AGGREGATO CONTATTO non valorizzato per NI_TENTATIVO_CONTATTO e per CAUSALE_ESITO &amp;quot;, $MapInput/ns:TESTATA/ns:CAUSALE_ESITO)&quot;/>&#xa;                                                    &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;count($AccumulateRef/tns2:resultSet/Record) !=count($MapInput/ns:INTERMEDIA/ns:CONTATTO)&quot;>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;002&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                                    &lt;ns:DESCRIZIONE_ERRORE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;PROGRESSIVO NI_TENTATIVO_CONTATTO SCONOSCIUTO&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NI_ACCODAMENTO&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($MapInput/ns:INTERMEDIA/ns:INFO_CU_RDAC/ns:LUNGHEZZA_CODA)=0 or string-length($MapInput/ns:INTERMEDIA/ns:INFO_CU_RDAC/ns:POSIZIONE_CODA)=0 or string-length($MapInput/ns:INTERMEDIA/ns:INFO_CU_RDAC/ns:DPS)=0&quot;>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&qu