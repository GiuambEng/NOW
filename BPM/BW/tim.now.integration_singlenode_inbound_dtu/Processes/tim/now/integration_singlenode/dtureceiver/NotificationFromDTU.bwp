                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                            inputVariable="MapperBPM-input"
                            name="MapperBPM" outputVariable="MapperBPM"
                            tibex:xpdlId="01066677-78a8-4f3f-8fb8-e52b8f311558" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="__Link1"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="__Link"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/&quot; xmlns:Q2=&quot;http://www.tim.com/NOW/xsd/BPM_DTUNotificationManagement_v2/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStagingAck.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;MapAckIn&quot;/>&#xa;    &lt;xsl:param name=&quot;ACK_SelectProgressivo&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q2:manageNotificationSenzaArricchimentiRequest>&#xa;            &lt;Q2:ID_RICHIESTA>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/Q2:ID_RICHIESTA>&#xa;            &lt;Q2:ProgressivoNotificaDTU>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($ACK_SelectProgressivo/tns2:ProgressivoNotifiche)&quot;/>&#xa;            &lt;/Q2:ProgressivoNotificaDTU>&#xa;            &lt;Q2:IdEventoOrdnNowWhls>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/Q2:IdEventoOrdnNowWhls>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InsertStagingAck.RESPONSE/tns3:LogResponse/ns1:COD_PROCSO_NO_FILE) > 0&quot;>&#xa;                    &lt;Q2:CodProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;$InsertStagingAck.RESPONSE/tns3:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/Q2:CodProcsoNoFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Q2:CodProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/Q2:CodProcsoNoFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InsertStagingAck.RESPONSE/tns3:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE) > 0&quot;>&#xa;                    &lt;Q2:IdEsecProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($InsertStagingAck.RESPONSE/tns3:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/Q2:IdEsecProcsoNoFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Q2:IdEsecProcsoNoFile>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/Q2:IdEsecProcsoNoFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$MapAckIn&quot;/>&#xa;            &lt;Q2:ID_ANAGRAFICA_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/Q2:ID_ANAGRAFICA_CAUSALE>&#xa;        &lt;/Q2:manageNotificationSenzaArricchimentiRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
