                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;DTU_ReceiveNotification&quot;/>&#xa;    &lt;xsl:param name=&quot;ReceiveDTUMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;DTU_ReceiveNotification_SCARTO&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess3Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioNotifica'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$ReceiveDTUMessage&quot;/>&#xa;                &lt;/tns2:MsgCode>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;IL MESSAGGIO E STATO CORRETTAMENTE INSERITO SULLA CODA DI SCARTO &amp;quot;, $DTU_ReceiveNotification_SCARTO, &amp;quot; MA E FALLITA LA CONFERMA SULLA CODA &amp;quot; ,$DTU_ReceiveNotification, &amp;quot; IN QUANTO IL MESSAGGIO NON E FORMALMENTE VALIDO&amp;quot;)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="CallProcess4Log-input"
                                name="CallProcess4Log"
                                tibex:xpdlId="458837dc-f959-4400-bcce-d200f1056296"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ConfirmKOToCallProcess1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToExitKO"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;DTU_ReceiveNotification_SCARTO&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess4Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioNotifica'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;IL MESSAGGIO E STATO CORRETTAMENTE INSERITO SULLA CODA DI SCARTO: &amp;quot;, $DTU_ReceiveNotification_SCARTO)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="MapperForCoercionToMapInput"
                    tibex:label="NOTIFICA" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="AssignAckMessageToScope1" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="MapInputToAssign_IdRichiestaOlo_Original" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToScope" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperForCoercionToMapAckIn"
                    tibex:label="ACK" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Assign_IdRichiesta_AckToLogCalMapAckIn" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToScope2" tibex:linkType="SUCCESS"/>
                <bpws:link name="Scope2ToExit4" tibex:linkType="SUCCESS"/>
                <bpws:link name="Confirm3ToExit4" tibex:linkType="SUCCESS"/>
                <bpws:link name="Scope1ToConfirm3" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessOutAckToConfirm3" tibex:linkType="SUCCESS"/>
                <bpws:link name="ReceiveDTUMessageToMapperForCoercion" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToLOG_TipolgEsitoDTU" tibex:linkType="SUCCESS"/>
                <bpws:link name="LOG_TipolgEsitoDTUToAssignAckMessage" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="Assign_IdRichiestaOlo_OriginalToLOG_Input" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapAckInToAssign_IdRichiesta_Ack" tibex:linkType="SUCCESS"/>
                <bpws:link name="ScopeToJDBC_TipolgEsitoDTU" tibex:linkType="SUCCESS"/>
                <bpws:link name="LOG_InputToJDBCQuery" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="ReceiveDTUMessage"
                    tibex:xpdlId="dfbcd7bd-92e9-44ba-b98f-fa5ea9c0766c"
                    variable="ReceiveDTUMessage" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="ReceiveDTUMessageToMapperForCoercion"/>
                    </bpws:sources>
                    <sequenceKey
                        expression="string(substring-before($ReceiveDTUMessage/Body/ns26:Envelope/ns26:Body/node()/descendant-or-self::ns1:ID_RICHIESTA, &quot;_&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    <sequenceKeyDesign
                        expression="string(substring-before($ReceiveDTUMessage/Body/ns26:Envelope/ns26:Body/node()/descendant-or-self::ns1:ID_RICHIESTA, &quot;_&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    <bpws:correlations/>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.jms.receive"
                            version="6.0.0.20132205"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:envelope="http://schemas.xmlsoap.org/soap/envelope/"
                            xmlns:jms="http://ns.tibco.com/bw/palette/jms" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="destinationName" processProperty="DTU_ReceiveNotification"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jms#//JMSReceiverEventSource"/>
                                    <value
                                    ackMode="TIBCO EMS Explicit Client"
                                    bodyTypeQName="envelope:Envelope"
                                    connectionReference="jmsConnection"
                                    maxSessions="1"
                                    messageSelector="soapaction LIKE '&quot;GetNotifica&quot;' OR soapaction LIKE 'GetNotifica' OR SoapAction LIKE '&quot;GetNotifica&quot;' OR SoapAction LIKE 'GetNotifica' OR SOAPAction LIKE '&quot;GetNotifica&quot;' OR SOAPAction LIKE 'GetNotifica' OR soapAction LIKE '&quot;GetNotifica&quot;' OR soapAction LIKE 'GetNotifica' OR soapaction LIKE '&quot;InvioNotifica&quot;' OR soapaction LIKE 'InvioNotifica' OR SoapAction LIKE '&quot;InvioNotifica&quot;' OR SoapAction LIKE 'InvioNotifica' OR SOAPAction LIKE '&quot;InvioNotifica&quot;' OR SOAPAction LIKE 'InvioNotifica' OR soapAction LIKE '&quot;InvioNotifica&quot;' OR soapAction LIKE 'InvioNotifica' OR soapaction LIKE '&quot;GetAck&quot;' OR soapaction LIKE 'GetAck' OR SoapAction LIKE '&quot;GetAck&quot;' OR SoapAction LIKE 'GetAck' OR SOAPAction LIKE '&quot;GetAck&quot;' OR SOAPAction LIKE 'GetAck' OR soapAction LIKE '&quot;GetAck&quot;' OR soapAction LIKE 'GetAck' OR soapaction LIKE '&quot;InvioAck&quot;' OR soapaction LIKE 'InvioAck' OR SoapAction LIKE '&quot;InvioAck&quot;' OR SoapAction LIKE 'InvioAck' OR SOAPAction LIKE '&quot;InvioAck&quot;' OR SOAPAction LIKE 'InvioAck' OR soapAction LIKE '&quot;InvioAck&quot;' OR soapAction LIKE 'InvioAck'"
                                    messageType="XML Text"
                                    messagingStyle="Queue"
                                    receiveTimeout="1" xsi:type="jms:JMSReceiverEventSource"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Input-input"
                    name="LOG_Input"
                    tibex:xpdlId="a76dd223-e425-4814-a809-a22b656ed6b5"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign_IdRichiestaOlo_OriginalToLOG_Input"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_InputToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:ns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+dfbcd7bd-92e9-44ba-b98f-fa5ea9c0766c+output&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveDTUMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioNotifica'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Ricevuta Notifica da DTU | JMSMessageID: &amp;quot;, $ReceiveDTUMessage/JMSHeaders/ns1:JMSMessageID, &amp;quot; - JMSDestination: &amp;quot;, $ReceiveDTUMessage/JMSHeaders/ns1:JMSDestination, &amp;quot; - JMSTimestamp: &amp;quot;, string($ReceiveDTUMessage/JMSHeaders/ns1:JMSTimestamp))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapInput, true(), true())&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.dtureceiver&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NotificationFromDTU&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                        &lt;/tns2:BusinessID>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NotificationFromDTU_STARTED&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;NotificationFromDTU_&amp;quot;, $IdRichiestaOlo_Original)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Ack_Message"
                    name="AssignAckMessage" outputVariable="Ack_Message"
                    tibex:xpdlId="92bba22d-ec8c-4fcb-8280-c4a93f90301e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_TipolgEsitoDTUToAssignAckMessage"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignAckMessageToScope1">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fe183381-f5c4-4688-b41c-6f0526003749+output&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateRef&quot;/>&#xa;    &lt;xsl:param name=&quot;Sel_DAC_StrRic_Scen_ORDINE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_TipolgEsitoDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionNOW&quot;/>&#xa;    &lt;xsl:template name=&quot;Ack_Message&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;starts-with($MapInput/ns:TESTATA/ns:TRANSACTION_ID, $TransactionNOW)&quot;>&#xa;                &lt;ns:ACK_COMUNICAZIONE>&#xa;                    &lt;ns:DATA>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:DATA>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:CAUSALE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                    &lt;/ns:CAUSALE_ESITO>&#xa;                    &lt;ns:TIPO_MESSAGGIO>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                    &lt;ns:ID_RICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ns:ID_RICHIESTA>&#xa;                &lt;/ns:ACK_COMUNICAZIONE>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($JDBC_TipolgEsitoDTU/Record) > 0&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MapInput/ns:INTERMEDIA)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NI_VERIFICA_TECNICA_E_TOPONOMASTICA&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;not(exists($MapInput/ns:INTERMEDIA/ns:INDIRIZZO_CERT/ns:INDIRIZZO_CLIENTE))&quot;>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;002&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                                    &lt;ns:DESCRIZIONE_ERRORE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;AGGREGATO INDIRIZZO CLIENTE CERTIFICATO NON VALORIZZATO&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                