                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/SendDtu/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:tns3="http://www.tim.com/NOW/xsd/SendDTU/" version="2.0"&gt;
    &lt;xsl:param name="Ack_Message"/&gt;
    &lt;xsl:param name="IdRichiestaOlo_Original"/&gt;
    &lt;xsl:template name="AckComunicazione-input" match="/"&gt;
        &lt;tns2:AckComunicazioneRequest&gt;
            &lt;parameters&gt;
                &lt;tns3:ACK_COMUNICAZIONE&gt;
                    &lt;tns3:IdRichiestaOLO&gt;
                        &lt;xsl:value-of select="$IdRichiestaOlo_Original"/&gt;
                    &lt;/tns3:IdRichiestaOLO&gt;
                    &lt;tns3:ACK&gt;
                        &lt;ns:DATA&gt;
                            &lt;xsl:value-of select="$Ack_Message/ns:DATA"/&gt;
                        &lt;/ns:DATA&gt;
                        &lt;ns:TRANSACTION_ID&gt;
                            &lt;xsl:value-of select="$Ack_Message/ns:TRANSACTION_ID"/&gt;
                        &lt;/ns:TRANSACTION_ID&gt;
                        &lt;ns:CAUSALE_ESITO&gt;
                            &lt;xsl:value-of select="$Ack_Message/ns:CAUSALE_ESITO"/&gt;
                        &lt;/ns:CAUSALE_ESITO&gt;
                        &lt;xsl:if test="$Ack_Message/ns:TIPO_MESSAGGIO"&gt;
                            &lt;ns:TIPO_MESSAGGIO&gt;
                                &lt;xsl:value-of select="$Ack_Message/ns:TIPO_MESSAGGIO"/&gt;
                            &lt;/ns:TIPO_MESSAGGIO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Ack_Message/ns:DESCRIZIONE_ERRORE"&gt;
                            &lt;ns:DESCRIZIONE_ERRORE&gt;
                                &lt;xsl:value-of select="$Ack_Message/ns:DESCRIZIONE_ERRORE"/&gt;
                            &lt;/ns:DESCRIZIONE_ERRORE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Ack_Message/ns:ID_RICHIESTA"&gt;
                            &lt;ns:ID_RICHIESTA&gt;
                                &lt;xsl:value-of select="$Ack_Message/ns:ID_RICHIESTA"/&gt;
                            &lt;/ns:ID_RICHIESTA&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns3:ACK&gt;
                &lt;/tns3:ACK_COMUNICAZIONE&gt;
            &lt;/parameters&gt;
        &lt;/tns2:AckComunicazioneRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/SendDtu/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SendDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ack_Message&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;AckComunicazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ACK_COMUNICAZIONE>&#xa;            &lt;tns3:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/tns3:IdRichiestaOLO>&#xa;            &lt;tns3:ACK>&#xa;                &lt;ns:DATA>&#xa;                    &lt;xsl:value-of select=&quot;$Ack_Message/ns:DATA&quot;/>&#xa;                &lt;/ns:DATA>&#xa;                &lt;ns:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Ack_Message/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/ns:TRANSACTION_ID>&#xa;                &lt;ns:CAUSALE_ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$Ack_Message/ns:CAUSALE_ESITO&quot;/>&#xa;                &lt;/ns:CAUSALE_ESITO>&#xa;                &lt;xsl:if test=&quot;$Ack_Message/ns:TIPO_MESSAGGIO&quot;>&#xa;                    &lt;ns:TIPO_MESSAGGIO>&#xa;                        &lt;xsl:value-of select=&quot;$Ack_Message/ns:TIPO_MESSAGGIO&quot;/>&#xa;                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Ack_Message/ns:DESCRIZIONE_ERRORE&quot;>&#xa;                    &lt;ns:DESCRIZIONE_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;$Ack_Message/ns:DESCRIZIONE_ERRORE&quot;/>&#xa;                    &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Ack_Message/ns:ID_RICHIESTA&quot;>&#xa;                    &lt;ns:ID_RICHIESTA>&#xa;                        &lt;xsl:value-of select=&quot;$Ack_Message/ns:ID_RICHIESTA&quot;/>&#xa;                    &lt;/ns:ID_RICHIESTA>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:ACK>&#xa;        &lt;/tns3:ACK_COMUNICAZIONE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <bpws:targets>
                            <bpws:target linkName="Upd_StatoEvntDTU_KOCROSSCONST"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="AckComunicazioneToCallProcess"/>
                        </bpws:sources>
                        <bpws:correlations/>
                    </bpws:invoke>
                    <bpws:extensionActivity>
                        <tibex:activityExtension
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8b60420b-08ed-4463-a3ed-fe191ac76609+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_DTUEvento&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:param name=&quot;Ack_Message&quot;/>&#xa;    &lt;xsl:template name=&quot;Upd_StatoEvntDTU_5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Ack_Message/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot; and string-length($Ack_Message/ns:CAUSALE_ESITO) > 0&quot;>&#xa;                    &lt;TPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;'KO_CROSS_CONSTRAINT'&quot;/>&#xa;                    &lt;/TPLG_STATO_EVENTO_DTU>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;'DA_LAVORARE'&quot;/>&#xa;                    &lt;/TPLG_STATO_EVENTO_DTU>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Invoke_DTUEvento/output/Q1:DTUEventoResponse/IdEventoOrdnNowWhls)&quot;/>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;            &lt;/TRANSACTION_ID>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                            inputVariable="Upd_StatoEvntDTU_5-input"
                            name="Upd_StatoEvntDTU_5"
                            outputVariable="Upd_StatoEvntDTU_5"
                            tibex:xpdlId="8b60420b-08ed-4463-a3ed-fe191ac76609" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="LOG_ValidationToUpd_StatoEvntDTU_Name"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Upd_StatoEvntDTU_KOCROSSCONST">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Ack_Message/ns1:CAUSALE_ESITO != &quot;000&quot; and string-length($Ack_Message/ns1:CAUSALE_ESITO) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Ack_Message/ns1:CAUSALE_ESITO != "000" and string-length($Ack_Message/ns1:CAUSALE_ESITO) > 0]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="Upd_StatoEvntDTU_5ToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8b60420b-08ed-4463-a3ed-fe191ac76609+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_DTUEvento.output&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:param name=&quot;Ack_Message&quot;/>&#xa;    &lt;xsl:template name=&quot;Upd_StatoEvntDTU_5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Ack_Message/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot; and string-length($Ack_Message/ns:CAUSALE_ESITO) > 0&quot;>&#xa;                    &lt;TPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;'KO_CROSS_CONSTRAINT'&quot;/>&#xa;                    &lt;/TPLG_STATO_EVENTO_DTU>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TPLG_STATO_EVENTO_DTU>&#xa;                        &lt;xsl:value-of select=&quot;'DA_LAVORARE'&quot;/>&#xa;                    &lt;/TPLG_STATO_EVENTO_DTU>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Invoke_DTUEvento.output/IdEventoOrdnNowWhls)&quot;/>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;            &lt;/TRANSACTION_ID>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="GenericJDBCTimeout"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_DTU SET IDTPLG_STATO_EVENTO_DTU = (SELECT IDTPLG_STATO_EVENTO_DTU FROM TIPOLG_STATO_EVENTO_DTU WHERE DESCR_STATO_EVENTO_DTU = ?)&#xa;&#x9;WHERE ID_RICH_OLO = ? AND ID_EVENTO_ORDN_NOW_WHLS = ? AND TRANSACTION_ID = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TPLG_STATO_EVENTO_DTU"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TRANSACTION_ID"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            inputVariable="SelectProgressivo-input"
