                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="BPM_DTUNotificationManagement_v2:manageNotificationSenzaArricchimentiRequest" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            inputVariable="LOG_InvokeBPM-input"
                            name="LOG_InvokeBPM"
                            tibex:xpdlId="b8ca2da4-22e2-4381-a425-5bac4ac7d8ad"
                            type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="__Link"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="LOG_InvokeBPMToCallBPM_ACK">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($LinearizzatoreONOFF) = 'OFF'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($LinearizzatoreONOFF) = 'OFF']]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="LOG_InvokeBPMToJMSSendMessage3">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperBPM&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_InvokeBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioAck'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Invio Ack DTU a BPM: &amp;quot;, tib:render-xml($MapperBPM, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                moduleRef="tim.now.shared_library"
                                spawn="true"
                                subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                        </tibex:extActivity>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            inputVariable="ACK_SalvaProgressivo-input"
                            name="ACK_SalvaProgressivo"
                            outputVariable="ACK_SalvaProgressivo"
                            tibex:xpdlId="1039f064-61c0-4a69-8ebd-796dfe9c4a1c"
                            type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="CallBPM_ACKToACK_SalvaProgressivo"/>
                                <bpws:target linkName="JMSSendMessage3ToACK_SalvaProgressivo"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Copy_1_SalvaProgressivoToInvoke"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ACK_SelectProgressivo&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;ACK_SalvaProgressivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input_Upsert_Progressivo>&#xa;            &lt;tns2:IDRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/tns2:IDRichiestaOlo>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ACK_SelectProgressivo/tns2:ProgressivoNotifiche > 1&quot;>&#xa;                    &lt;tns2:Azione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Azione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Azione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:Azione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:ProgressivoNotifiche>&#xa;                &lt;xsl:value-of select=&quot;$ACK_SelectProgressivo/tns2:ProgressivoNotifiche&quot;/>&#xa;            &lt;/tns2:ProgressivoNotifiche>&#xa;        &lt;/tns2:Input_Upsert_Progressivo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                subProcessName="tim.now.integration_singlenode.dtureceiver.subprocesses.UpsertProgrNotifDTU" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                        </tibex:extActivity>
                    </bpws:extensionActivity>
                    <bpws:invoke inputVariable="InsertStagingAck-input"
                        name="InsertStagingAck"
                        operation="InsertUpdateStaging"
                        outputVariable="InsertStagingAck"
                        partnerLink="InsertUpdateStagingPortType"
                        portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="8c21a361-8ef7-4c01-b7d9-9623df59e400">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="IdProcessoNotificaDTU"/&gt;
    &lt;xsl:param name="StatoStagingOK"/&gt;
    &lt;xsl:param name="StatoStagingKO"/&gt;
    &lt;xsl:param name="MapAckIn"/&gt;
    &lt;xsl:param name="ReceiveDTUMessage"/&gt;
    &lt;xsl:param name="Select_IdTipologiaEvento_Ack"/&gt;
    &lt;xsl:param name="IdRichiestaOlo_Original"/&gt;
    &lt;xsl:template name="InsertStagingAck-input" match="/"&gt;
        &lt;tns3:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns4:StagingRequest&gt;
                    &lt;tns4:StagingIn&gt;
                        &lt;tns4:CONTENUTO_RESPONSE&gt;
                            &lt;xsl:value-of select="tib:render-xml($ReceiveDTUMessage/Body/tns2:Envelope)"/&gt;
                        &lt;/tns4:CONTENUTO_RESPONSE&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$MapAckIn/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;"&gt;
                                &lt;tns4:DESCR_ERRORE&gt;
                                    &lt;xsl:value-of select="concat($MapAckIn/ns:CAUSALE_ESITO, $MapAckIn/ns:DESCRIZIONE_ERRORE)"/&gt;
                                &lt;/tns4:DESCR_ERRORE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:DESCR_ERRORE&gt;
                                    &lt;xsl:value-of select="''"/&gt;
                                &lt;/tns4:DESCR_ERRORE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:HTTP_RESPONSE&gt;
                            &lt;xsl:value-of select="''"/&gt;
                        &lt;/tns4:HTTP_RESPONSE&gt;
                        &lt;tns4:IDTPLG_EVENTO&gt;
                            &lt;xsl:value-of select="xsd:int($Select_IdTipologiaEvento_Ack/Record[1]/IDTPLG_EVENTO)"/&gt;
                        &lt;/tns4:IDTPLG_EVENTO&gt;
                        &lt;tns4:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                        &lt;/tns4:ID_PROCSO_NO_FILE&gt;
                        &lt;tns4:ID_RICH_DTU&gt;
                            &lt;xsl:value-of select="$MapAckIn/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:ID_RICH_DTU&gt;
                        &lt;tns4:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$IdRichiestaOlo_Original"/&gt;
                        &lt;/tns4:ID_RICH_OLO&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$MapAckIn/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;"&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="$StatoStagingKO"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="$StatoStagingOK"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns4:OPERATORE&gt;
                        &lt;tns4:TIME_UPDATE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIME_UPDATE&gt;
                        &lt;tns4:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RICH&gt;
                        &lt;tns4:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RISPOSTA&gt;
                        &lt;tns4:TRANSACTION_ID&gt;
                            &lt;xsl:value-of select="$MapAckIn/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:TRANSACTION_ID&gt;
                    &lt;/tns4:StagingIn&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RISPOSTA_DTU'"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW SINC: RICHIESTA XML RICEVUTA&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns3:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdProcessoNotificaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingOK&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingKO&quot;/>&#xa;    &lt;xsl:param name=&quot;MapAckIn&quot;/>&#xa;    &lt;xsl:param name=&quot;ReceiveDTUMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_IdTipologiaEvento_Ack&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStagingAck-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ReceiveDTUMessage/Body/tns2:Envelope)&quot;/>&#xa;                &lt;/tns4:CONTENUTO_RESPONSE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$MapAckIn/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;&quot;>&#xa;                        &lt;tns4:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;concat($MapAckIn/ns:CAUSALE_ESITO, $MapAckIn/ns:DESCRIZIONE_ERRORE)&quot;/>&#xa;                        &lt;/tns4:DESCR_ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:DESCR_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns4:DESCR_ERRORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:HTTP_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns4:HTTP_RESPONSE>&#xa;                &lt;tns4:IDTPLG_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Select_IdTipologiaEvento_Ack/Record[1]/IDTPLG_EVENTO)&quot;/>&#xa;                &lt;/tns4:IDTPLG_EVENTO>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;tns4:ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$MapAckIn/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:ID_RICH_DTU>&#xa;                &lt;tns4:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$MapAckIn/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;&quot;>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$StatoStagingKO&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$StatoStagingOK&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns4:OPERATORE>&#xa;                &lt;tns4:TIME_UPDATE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIME_UPDATE>&#xa;                &lt;tns4:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RICH>&#xa;                &lt;tns4:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RISPOSTA>&#xa;                &lt;tns4:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapAckIn/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:TRANSACTION_ID>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RISPOSTA_DTU'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns2:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaProcesso>&#xa;                &lt;ns2:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaOperazione>&#xa;                &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns2:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns2:STATO_ESEC>&#xa;                    &lt;ns2:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:LogFileProcessato>&#xa;                    &lt;ns2:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns2:LOG_LEVEL>&#xa;                    &lt;ns2:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA SIS EST A NOW SINC: RICHIESTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                    &lt;/ns2:LOG_MESSAGE>&#xa;                    &lt;ns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TIMSTP_INSMTO>&#xa;                &lt;/ns2:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <bpws:targets>
                            <bpws:target linkName="Log_SelectToInsertStagingAck"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="InsertStagingAckToCopy_1_SelectProgressivo"/>
                        </bpws:sources>
                    </bpws:invoke>
                    <bpws:invoke inputVariable="UpdateStagingAck-input"
                        name="UpdateStagingAck"
                        operation="InsertUpdateStaging"
                        outputVariable="UpdateStagingAck"
                        partnerLink="InsertUpdateStagingPortType"
                        portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="d745f685-d6e3-43a3-a1b4-b731bb763a31">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/" version="2.0"&gt;
    &lt;xsl:param name="IdProcessoNotificaDTU"/&gt;
    &lt;xsl:param name="Select_IdTipologiaEvento_Ack"/&gt;
    &lt;xsl:param name="StatoStagingOK"/&gt;
    &lt;xsl:param name="StatoStagingKO"/&gt;
    &lt;xsl:param name="InsertStagingAck"/&gt;
    &lt;xsl:param name="MapAckIn"/&gt;
    &lt;xsl:param name="ACK_SelectProgressivo"/&gt;
    &lt;xsl:param name="IdRichiestaOlo_Original"/&gt;
    &lt;xsl:template name="UpdateStagingAck-input" match="/"&gt;
        &lt;tns3:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns4:StagingRequest&gt;
                    &lt;tns4:StagingIn&gt;
                        &lt;tns4:DESCR_ERRORE&gt;
                            &lt;xsl:value-of select="''"/&gt;
                        &lt;/tns4:DESCR_ERRORE&gt;
                        &lt;tns4:IDTPLG_EVENTO&gt;
                            &lt;xsl:value-of select="xsd:int($Select_IdTipologiaEvento_Ack/Record[1]/IDTPLG_EVENTO)"/&gt;
                        &lt;/tns4:IDTPLG_EVENTO&gt;
                        &lt;tns4:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                        &lt;/tns4:ID_PROCSO_NO_FILE&gt;
                        &lt;tns4:ID_RICH_DTU&gt;
                            &lt;xsl:value-of select="$MapAckIn/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:ID_RICH_DTU&gt;
                        &lt;tns4:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$IdRichiestaOlo_Original"/&gt;
                        &lt;/tns4:ID_RICH_OLO&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$MapAckIn/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;"&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="$StatoStagingKO"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns4:ID_STATO_ELAB_STAG&gt;
                                    &lt;xsl:value-of select="$StatoStagingOK"/&gt;
                                &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns4:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns4:OPERATORE&gt;
                        &lt;tns4:TIME_UPDATE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIME_UPDATE&gt;
                        &lt;tns4:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RICH&gt;
                        &lt;tns4:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RISPOSTA&gt;
                        &lt;tns4:TRANSACTION_ID&gt;
                            &lt;xsl:value-of select="$MapAckIn/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:TRANSACTION_ID&gt;
                        &lt;tns4:PROGRESSIVO_NOTIFICA&gt;
                            &lt;xsl:value-of select="xsd:int($ACK_SelectProgressivo/tns2:ProgressivoNotifiche)"/&gt;
                        &lt;/tns4:PROGRESSIVO_NOTIFICA&gt;
                    &lt;/tns4:StagingIn&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RISPOSTA_DTU'"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$InsertStagingAck/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns2:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$InsertStagingAck/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns2:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStagingAck/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'CHIUSO'"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_FINE_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;xsl:if test="$InsertStagingAck/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns2:COD_PROCSO&gt;
                                    &lt;xsl:value-of select="$InsertStagingAck/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns2:COD_PROCSO&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns2:ID_ESEC_PROCSO&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStagingAck/RESPONSE/tns4:StagingResponse/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns2:ID_ESEC_PROCSO&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW ASINC: ACK DI RISPOSTA RICEVUTO&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns3:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStagingAck.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcessoNotificaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_IdTipologiaEvento_Ack&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingOK&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingKO&quot;/>&#xa;    &lt;xsl:param name=&quot;MapAckIn&quot;/>&#xa;    &lt;xsl:param name=&quot;ACK_SelectProgressivo&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStagingAck-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;tns4:IDTPLG_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Select_IdTipologiaEvento_Ack/Record[1]/IDTPLG_EVENTO)&quot;/>&#xa;                &lt;/tns4:IDTPLG_EVENTO>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;tns4:ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$MapAckIn/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:ID_RICH_DTU>&#xa;                &lt;tns4:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$MapAckIn/ns:CAUSALE_ESITO !=&amp;quot;000&amp;quot;&quot;>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$StatoStagingKO&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$StatoStagingOK&quot;/>&#xa;                        &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns4:OPERATORE>&#xa;                &lt;tns4:TIME_UPDATE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIME_UPDATE>&#xa;                &lt;tns4:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RICH>&#xa;                &lt;tns4:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RISPOSTA>&#xa;                &lt;tns4:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapAckIn/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:TRANSACTION_ID>&#xa;                &lt;tns4:PROGRESSIVO_NOTIFICA>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($ACK_SelectProgressivo/tns2:ProgressivoNotifiche)&quot;/>&#xa;                &lt;/tns4:PROGRESSIVO_NOTIFICA>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RISPOSTA_DTU'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns2:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaProcesso>&#xa;                &lt;ns2:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaOperazione>&#xa;                &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStagingAck.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns2:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStagingAck.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns2:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagingAck.RESPONSE/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns2:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns2:STATO_ESEC>&#xa;                    &lt;ns2:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TMSP_FINE_ELAB>&#xa;                &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStagingAck.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns2:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStagingAck.RESPONSE/tns4:LogResponse/ns2:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns2:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns2:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagingAck.RESPONSE/tns4:LogResponse/ns2:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns2:ID_ESEC_PROCSO>&#xa;                    &lt;ns2:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns2:LOG_LEVEL>&#xa;                    &lt;ns2:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA SIS EST A NOW ASINC: ACK DI RISPOSTA RICEVUTO&amp;quot;&quot;/>&#xa;                    &lt;/ns2:LOG_MESSAGE>&#xa;                    &lt;ns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TIMSTP_INSMTO>&#xa;                &lt;/ns2:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <bpws:targets>
                            <bpws:target linkName="Copy_1_SalvaProgressivoToInvoke"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="InvokeToGroupEnd2"/>
                        </bpws:sources>
                    </bpws:invoke>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            inputVariable="CallBPM_ACK-input"
                            name="CallBPM_ACK" tibex:copyOf="MapperBPM"
                            tibex:xpdlId="03394660-6fe3-4e72-ac87-68ff7b499810"
                            type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="LOG_InvokeBPMToCallBPM_ACK"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="CallBPM_ACKToACK_SalvaProgressivo"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperBPM&quot;/>&lt;xsl:template name=&quot;CallBPM_ACK-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$MapperBPM&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                subProcessName="tim.now.integration_singlenode.dtureceiver.subprocesses.CallDeliveryExposedService" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                        </tibex:extActivity>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:activityExtension
                            inputVariable="JMSSendLinearizzatore-input"
                            name="JMSSendLinearizzatore"
                            outputVariable="JMSSendLinearizzatore"
                            tibex:xpdlId="4bb0b1da-be79-41e3-8fce-59ec0360d8b2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="LOG_InvokeBPMToJMSSendMessage3"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="JMSSendMessage3ToACK_SalvaProgressivo"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+4bb0b1da-be79-41e3-8fce-59ec0360d8b2+input&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperBPM&quot;/>&#xa;    &lt;xsl:template name=&quot;JMSSendMessage3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;Body>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($MapperBPM, true(), true())&quot;/>&#xa;            &lt;/Body>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.jms.send"
                                    version="6.0.0.20132205"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jms="http://ns.tibco.com/bw/palette/jms" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="destinationName" processProperty="CodaInputLinearizzatore"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jms#//JMSSenderActivityConfiguration"/>
                                    <value
                                    connectionReference="jmsConnection"
                                    messagingStyle="Queue"
                                    priority="4" xsi:type="jms:JMSSenderActivityConfiguration"/>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                </bpws:flow>
            </bpws:scope>
            <bpws:exit name="Exit4" tibex:xpdlId="a57a8311-594c-4c15-8950-53b450c95e4b">
                <bpws:targets>
                    <bpws:target linkName="Confirm3ToExit4"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:activityExtension name="Confirm3"
                    tibex:xpdlId="a713ed54-3815-49e1-ae1b-659282bfab7f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Scope1ToConfirm3"/>
                        <bpws:target linkName="CallProcessOutAckToConfirm3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Confirm3ToExit4"/>
                    </bpws:sources>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.confirm"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Confirm"/>
                                    <value
                                    confirmEvent="ReceiveDTUMessage" xsi:type="generalactivities:Confirm"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CallProcessOutAck-input"
                    name="CallProcessOutAck"
                    tibex:xpdlId="1c508e44-0adf-429e-a52f-d97e9e67d8f8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Scope2ToExit4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessOutAckToConfirm3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;MapAckIn&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:param name=&quot;LinearizzatoreONOFF&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcessOutAck-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioAck'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($LinearizzatoreONOFF) = 'ON'&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Exit from NotificaDTUPortType/getAck: Messaggio inserito correttemente nella coda del LINEARIZZATORE &amp;quot;, $MapAckIn/ns:CAUSALE_ESITO)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Exit from NotificaDTUPortType/getAck service with result code: &amp;quot;, $MapAckIn/ns:CAUSALE_ESITO)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.dtureceiver&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACKFromDTU&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                        &lt;/tns2:BusinessID>&#xa;                        &lt;tns2:EventID>&#xa;                            &lt;xsl:value-of select=&quot;$MapAckIn/ns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns2:EventID>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NotificationFromDTU_COMPLETED&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;NotificationFromDTU_&amp;quot;, $MapAckIn/ns:ID_RICHIESTA)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OUT&amp;quot;&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBC_TipolgEsitoDTU-input"
                    name="JDBC_TipolgEsitoDTU"
                    outputVariable="JDBC_TipolgEsitoDTU"
                    tibex:xpdlId="a9c0173d-07cc-458a-8c4d-c57491d4318a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ScopeToJDBC_TipolgEsitoDTU"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLOG_TipolgEsitoDTU"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a9c0173d-07cc-458a-8c4d-c57491d4318a+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;EVENTO_NATIVO_DTU>&#xa;                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;            &lt;/EVENTO_NATIVO_DTU>&#xa;            &lt;CAUS_ESITO>&#xa;                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:CAUSALE_ESITO&quot;/>&#xa;            &lt;/CAUS_ESITO>&#xa;            &lt;COD_ESITO>&#xa;                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:CODICE_ESITO&quot;/>&#xa;            &lt;/COD_ESITO>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="GenericJDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_ANAG_CAUS &#xa;FROM TIPOLG_ESITO_DTU&#xa;WHERE EVENTO_NATIVO_DTU = ?&#xa;  AND CAUS_ESITO = ?&#xa;  AND ESITO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="EVENTO_NATIVO_DTU"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CAUS_ESITO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ESITO"/>
                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LOG_TipolgEsitoDTU-input"
                    name="LOG_TipolgEsitoDTU"
                    tibex:xpdlId="2b161bd7-5680-406b-8817-9ae678196acd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToLOG_TipolgEsitoDTU"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_TipolgEsitoDTUToAssignAckMessage"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Log_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_TipolgEsitoDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_TipolgEsitoDTU-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioNotifica'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Esito validita notifica, causale esito e codice esito: '&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($JDBC_TipolgEsitoDTU/Record) > 0&quot;>&#xa;                        &lt;tns2:Payload>&#xa;                            &lt;xsl:value-of select=&quot;'Evento ammesso.'&quot;/>&#xa;                        &lt;/tns2:Payload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Payload>&#xa;                            &lt;xsl:value-of select=&quot;'Evento NON ammesso.'&quot;/>&#xa;                        &lt;/tns2:Payload>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Log_Level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
