                                <bpws:sources>
                                    <bpws:source linkName="JMSSendMessage2ToConfirmKO"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+0715b156-d521-41ed-b3bb-2af695f00803+input&quot; xmlns:tns3=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:ns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+dfbcd7bd-92e9-44ba-b98f-fa5ea9c0766c+output&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReceiveDTUMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;JMSSendMessage2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ReceiveDTUMessage/Body/tns3:Envelope)&quot;>&#xa;                    &lt;Body>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($ReceiveDTUMessage/Body/tns3:Envelope, false(), true())&quot;/>&#xa;                    &lt;/Body>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Body>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IL MESSAGGIO NON E FORMALMENTE CORRETTO&amp;quot;&quot;/>&#xa;                    &lt;/Body>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DynamicProperties>&#xa;                &lt;xsl:for-each select=&quot;$ReceiveDTUMessage/DynamicProperties/ns1:property&quot;>&#xa;                    &lt;tns2:property>&#xa;                        &lt;tns2:name>&#xa;                            &lt;xsl:copy-of select=&quot;ns1:name/@xsi:nil&quot;/>&#xa;                            &lt;xsl:value-of select=&quot;ns1:name&quot;/>&#xa;                        &lt;/tns2:name>&#xa;                        &lt;tns2:value>&#xa;                            &lt;xsl:copy-of select=&quot;ns1:value/@xsi:nil&quot;/>&#xa;                            &lt;xsl:value-of select=&quot;ns1:value&quot;/>&#xa;                        &lt;/tns2:value>&#xa;                        &lt;tns2:type>&#xa;                            &lt;xsl:copy-of select=&quot;ns1:type/@xsi:nil&quot;/>&#xa;                            &lt;xsl:value-of select=&quot;ns1:type&quot;/>&#xa;                        &lt;/tns2:type>&#xa;                    &lt;/tns2:property>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/DynamicProperties>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
