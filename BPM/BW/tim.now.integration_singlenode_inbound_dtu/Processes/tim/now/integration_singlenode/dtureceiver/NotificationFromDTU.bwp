                                    <columnMetadata
                                    columnName="PROGRESSIVOREFERENTE"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                </bpws:flow>
                            </bpws:while>
