                        <bpws:sources>
                            <bpws:source linkName="Invoke_PRESENZAAGGNTVI">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($MapInput/ns1:INTERMEDIA/ns1:PRENOTAZIONE_NUMERO/ns1:AGGIUNTIVI) or exists($MapInput/ns1:FINALE/ns1:FONIA/ns1:AGGIUNTIVI) or exists($MapInput/ns1:FINALE/ns1:PRENOTAZIONE_NUMERO/ns1:AGGIUNTIVI)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:transitionCondition><![CDATA[exists($MapInput/ns1:INTERMEDIA/ns1:PRENOTAZIONE_NUMERO/ns1:AGGIUNTIVI) or exists($MapInput/ns1:FINALE/ns1:FONIA/ns1:AGGIUNTIVI) or exists($MapInput/ns1:FINALE/ns1:PRENOTAZIONE_NUMERO/ns1:AGGIUNTIVI)]]></bpws:transitionCondition>
