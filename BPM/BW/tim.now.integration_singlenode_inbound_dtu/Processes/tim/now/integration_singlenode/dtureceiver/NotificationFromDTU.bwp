                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT PROGRESSIVOREFERENTE&#xa;FROM BDS_1_CASEDATA_REFERENTE&#xa;WHERE IDRICHIESTAOLO = ? AND PROGRESSIVOREFERENTE = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
