put/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;ns:DATA>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/ns:DATA>&#xa;                                            &lt;ns:TRANSACTION_ID>&#xa;                                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                            &lt;/ns:TRANSACTION_ID>&#xa;                                            &lt;ns:CAUSALE_ESITO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                                            &lt;/ns:CAUSALE_ESITO>&#xa;                                            &lt;ns:TIPO_MESSAGGIO>&#xa;                                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                            &lt;/ns:TIPO_MESSAGGIO>&#xa;                                            &lt;ns:ID_RICHIESTA>&#xa;                                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                            &lt;/ns:ID_RICHIESTA>&#xa;                                        &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NF_CONFERMA_ANNULLAMENTO&amp;quot;&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;not(exists($MapInput/ns:CONFERMA_ANNULLAMENTO))&quot;>&#xa;                                        &lt;ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;ns:DATA>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/ns:DATA>&#xa;                                            &lt;ns:TRANSACTION_ID>&#xa;                                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                            &lt;/ns:TRANSACTION_ID>&#xa;                                            &lt;ns:CAUSALE_ESITO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;002&amp;quot;&quot;/>&#xa;                                            &lt;/ns:CAUSALE_ESITO>&#xa;                                            &lt;ns:TIPO_MESSAGGIO>&#xa;                                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                            &lt;/ns:TIPO_MESSAGGIO>&#xa;                                            &lt;ns:DESCRIZIONE_ERRORE>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;Aggregato Conferma Annullamento non valorizzato&amp;quot;&quot;/>&#xa;                                            &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                                            &lt;ns:ID_RICHIESTA>&#xa;                                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                            &lt;/ns:ID_RICHIESTA>&#xa;                                        &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;ns:DATA>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/ns:DATA>&#xa;                                            &lt;ns:TRANSACTION_ID>&#xa;                                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                            &lt;/ns:TRANSACTION_ID>&#xa;                                            &lt;ns:CAUSALE_ESITO>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                                            &lt;/ns:CAUSALE_ESITO>&#xa;                                            &lt;ns:TIPO_MESSAGGIO>&#xa;                                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                            &lt;/ns:TIPO_MESSAGGIO>&#xa;                                            &lt;ns:ID_RICHIESTA>&#xa;                                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                            &lt;/ns:ID_RICHIESTA>&#xa;                                        &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                    &lt;ns:DATA>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/ns:DATA>&#xa;                                    &lt;ns:TRANSACTION_ID>&#xa;                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                    &lt;/ns:TRANSACTION_ID>&#xa;                                    &lt;ns:CAUSALE_ESITO>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                    &lt;ns:ID_RICHIESTA>&#xa;                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                    &lt;/ns:ID_RICHIESTA>&#xa;                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ACK_COMUNICAZIONE>&#xa;                            &lt;ns:DATA>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:DATA>&#xa;                            &lt;ns:TRANSACTION_ID>&#xa;                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                            &lt;/ns:TRANSACTION_ID>&#xa;                            &lt;ns:CAUSALE_ESITO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;001&amp;quot;&quot;/>&#xa;                            &lt;/ns:CAUSALE_ESITO>&#xa;                            &lt;ns:TIPO_MESSAGGIO>&#xa;                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                            &lt;/ns:TIPO_MESSAGGIO>&#xa;                            &lt;ns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;concat('Evento: ', $MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA, ' con causale_esito: ', $MapInput/ns:TESTATA/ns:CAUSALE_ESITO, ' e codice_esito: ', $MapInput/ns:TESTATA/ns:CODICE_ESITO, ' non trovata.')&quot;/>&#xa;                            &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                            &lt;ns:ID_RICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                            &lt;/ns:ID_RICHIESTA>&#xa;                        &lt;/ns:ACK_COMUNICAZIONE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
