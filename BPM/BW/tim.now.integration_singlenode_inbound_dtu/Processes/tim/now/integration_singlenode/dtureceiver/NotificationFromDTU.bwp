                            <bpws:sources>
                                <bpws:source linkName="CallProcessToMapperBPMNotification"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectProgressivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input_Select_Progressivo>&#xa;            &lt;tns2:IDRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/tns2:IDRichiestaOlo>&#xa;        &lt;/tns2:Input_Select_Progressivo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:CallProcess
                                subProcessName="tim.now.integration_singlenode.dtureceiver.subprocesses.SelectProgrNotifDTU" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
