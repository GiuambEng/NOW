                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index &lt;= count($ProgressivoReferenti/ns25:Progressivo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($ProgressivoReferenti/ns25:Progressivo)]]></bpws:condition>
