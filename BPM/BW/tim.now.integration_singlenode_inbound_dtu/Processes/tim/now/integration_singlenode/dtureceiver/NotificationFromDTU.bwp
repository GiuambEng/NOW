                   &lt;/Q2:EventoDTUNumAggtvo>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$MapInput/ns:FINALE/ns:FONIA/ns:AGGIUNTIVI&quot;>&#xa;                        &lt;Q2:EventoDTUNumAggtvo>&#xa;                            &lt;IdEventoOrdnNowWhls>&#xa;                                &lt;xsl:value-of select=&quot;$Invoke_DTUEvento.output/IdEventoOrdnNowWhls&quot;/>&#xa;                            &lt;/IdEventoOrdnNowWhls>&#xa;                            &lt;IdRichiestaOlo>&#xa;                                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                            &lt;/IdRichiestaOlo>&#xa;                            &lt;xsl:if test=&quot;ns:DIREZIONALITA&quot;>&#xa;                                &lt;NumAggntvDirezta>&#xa;                                    &lt;xsl:value-of select=&quot;ns:DIREZIONALITA&quot;/>&#xa;                                &lt;/NumAggntvDirezta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;NumeroAggiuntivo>&#xa;                                &lt;xsl:value-of select=&quot;ns:TELAGGIUNTIVO&quot;/>&#xa;                            &lt;/NumeroAggiuntivo>&#xa;                            &lt;NumeroAggiuntivoAccs>&#xa;                                &lt;xsl:value-of select=&quot;ns:TIPOLOGIA_ACCESSO&quot;/>&#xa;                            &lt;/NumeroAggiuntivoAccs>&#xa;                            &lt;StatoNumAggtvo>&#xa;                                &lt;xsl:value-of select=&quot;ns:STATOAGGIUNTIVO&quot;/>&#xa;                            &lt;/StatoNumAggtvo>&#xa;                        &lt;/Q2:EventoDTUNumAggtvo>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/Q2:Root_EventoDTUNumAggtvo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn: