                            expression="if(contains($MapAckIn/ns1:ID_RICHIESTA, &quot;_&quot;)) then substring-before($MapAckIn/ns1:ID_RICHIESTA, &quot;_&quot;) else $MapAckIn/ns1:ID_RICHIESTA" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
