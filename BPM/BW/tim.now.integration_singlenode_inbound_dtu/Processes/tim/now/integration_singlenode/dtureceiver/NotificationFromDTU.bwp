                        operation="InsertUpdateStaging"
                        outputVariable="InsertStaging"
                        partnerLink="InsertUpdateStagingPortType"
                        portType="ns7:InsertUpdateStagingPortType" tibex:xpdlId="101e7a91-094e-42f1-a424-e6fed01466ca">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns4="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="IdProcessoNotificaDTU"/&gt;
    &lt;xsl:param name="Select_IdTipologiaEvento"/&gt;
    &lt;xsl:param name="ReceiveDTUMessage"/&gt;
    &lt;xsl:param name="StatoStagingOK"/&gt;
    &lt;xsl:param name="MapInput"/&gt;
    &lt;xsl:param name="IdRichiestaOlo_Original"/&gt;
    &lt;xsl:template name="InsertStaging-input" match="/"&gt;
        &lt;tns3:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns4:StagingRequest&gt;
                    &lt;tns4:StagingIn&gt;
                        &lt;tns4:CONTENUTO_RESPONSE&gt;
                            &lt;xsl:value-of select="tib:render-xml($ReceiveDTUMessage/Body/tns2:Envelope)"/&gt;
                        &lt;/tns4:CONTENUTO_RESPONSE&gt;
                        &lt;tns4:DESCR_ERRORE&gt;
                            &lt;xsl:value-of select="''"/&gt;
                        &lt;/tns4:DESCR_ERRORE&gt;
                        &lt;tns4:HTTP_RESPONSE&gt;
                            &lt;xsl:value-of select="''"/&gt;
                        &lt;/tns4:HTTP_RESPONSE&gt;
                        &lt;tns4:IDTPLG_EVENTO&gt;
                            &lt;xsl:value-of select="xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)"/&gt;
                        &lt;/tns4:IDTPLG_EVENTO&gt;
                        &lt;tns4:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                        &lt;/tns4:ID_PROCSO_NO_FILE&gt;
                        &lt;tns4:ID_RICH_DTU&gt;
                            &lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:ID_RICH_DTU&gt;
                        &lt;tns4:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$IdRichiestaOlo_Original"/&gt;
                        &lt;/tns4:ID_RICH_OLO&gt;
                        &lt;xsl:if test="$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU"&gt;
                            &lt;tns4:ID_ORDINE_DTU&gt;
                                &lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU"/&gt;
                            &lt;/tns4:ID_ORDINE_DTU&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns4:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="$StatoStagingOK"/&gt;
                        &lt;/tns4:ID_STATO_ELAB_STAG&gt;
                        &lt;tns4:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns4:OPERATORE&gt;
                        &lt;tns4:TIME_UPDATE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIME_UPDATE&gt;
                        &lt;tns4:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RICH&gt;
                        &lt;tns4:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns4:TIMSTP_RISPOSTA&gt;
                        &lt;tns4:TRANSACTION_ID&gt;
                            &lt;xsl:value-of select="$MapInput/ns:TESTATA/ns:TRANSACTION_ID"/&gt;
                        &lt;/tns4:TRANSACTION_ID&gt;
                    &lt;/tns4:StagingIn&gt;
                    &lt;tns4:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_RISPOSTA_DTU'"/&gt;
                    &lt;/tns4:StagingType&gt;
                    &lt;tns4:LoggerIn&gt;
                        &lt;ns2:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaProcesso&gt;
                        &lt;ns2:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns2:TipologiaOperazione&gt;
                        &lt;ns2:EsecuzioneNOFileProcessato&gt;
                            &lt;ns2:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcessoNotificaDTU"/&gt;
                            &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;ns2:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                            &lt;/ns2:STATO_ESEC&gt;
                            &lt;ns2:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:LogFileProcessato&gt;
                            &lt;ns2:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns2:LOG_LEVEL&gt;
                            &lt;ns2:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA SIS EST A NOW ASINC: RICHIESTA XML RICEVUTA&amp;quot;"/&gt;
                            &lt;/ns2:LOG_MESSAGE&gt;
                            &lt;ns2:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns2:TIMSTP_INSMTO&gt;
                        &lt;/ns2:LogFileProcessato&gt;
                    &lt;/tns4:LoggerIn&gt;
                &lt;/tns4:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns3:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdProcessoNotificaDTU&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_IdTipologiaEvento&quot;/>&#xa;    &lt;xsl:param name=&quot;ReceiveDTUMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoStagingOK&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:StagingRequest>&#xa;            &lt;tns4:StagingIn>&#xa;                &lt;tns4:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ReceiveDTUMessage/Body/tns2:Envelope)&quot;/>&#xa;                &lt;/tns4:CONTENUTO_RESPONSE>&#xa;                &lt;tns4:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;tns4:HTTP_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns4:HTTP_RESPONSE>&#xa;                &lt;tns4:IDTPLG_EVENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Select_IdTipologiaEvento/Record[1]/IDTPLG_EVENTO)&quot;/>&#xa;                &lt;/tns4:IDTPLG_EVENTO>&#xa;                &lt;tns4:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                &lt;/tns4:ID_PROCSO_NO_FILE>&#xa;                &lt;tns4:ID_RICH_DTU>&#xa;                    &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:ID_RICH_DTU>&#xa;                &lt;tns4:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                &lt;/tns4:ID_RICH_OLO>&#xa;                &lt;xsl:if test=&quot;$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU&quot;>&#xa;                    &lt;tns4:ID_ORDINE_DTU>&#xa;                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_ORDINE_DTU&quot;/>&#xa;                    &lt;/tns4:ID_ORDINE_DTU>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$StatoStagingOK&quot;/>&#xa;                &lt;/tns4:ID_STATO_ELAB_STAG>&#xa;                &lt;tns4:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns4:OPERATORE>&#xa;                &lt;tns4:TIME_UPDATE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIME_UPDATE>&#xa;                &lt;tns4:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RICH>&#xa;                &lt;tns4:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns4:TIMSTP_RISPOSTA>&#xa;                &lt;tns4:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                &lt;/tns4:TRANSACTION_ID>&#xa;            &lt;/tns4:StagingIn>&#xa;            &lt;tns4:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_RISPOSTA_DTU'&quot;/>&#xa;            &lt;/tns4:StagingType>&#xa;            &lt;tns4:LoggerIn>&#xa;                &lt;ns2:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaProcesso>&#xa;                &lt;ns2:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns2:TipologiaOperazione>&#xa;                &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcessoNotificaDTU&quot;/>&#xa;                    &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns2:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns2:STATO_ESEC>&#xa;                    &lt;ns2:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:LogFileProcessato>&#xa;                    &lt;ns2:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns2:LOG_LEVEL>&#xa;                    &lt;ns2:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA SIS EST A NOW ASINC: RICHIESTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                    &lt;/ns2:LOG_MESSAGE>&#xa;                    &lt;ns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns2:TIMSTP_INSMTO>&#xa;                &lt;/ns2:LogFileProcessato>&#xa;            &lt;/tns4:LoggerIn>&#xa;        &lt;/tns4:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <bpws:targets>
                            <bpws:target linkName="Select_IdTipologiaEventoToInsertStaging"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="InsertStagingToInvoke_DTUEvento"/>
                        </bpws:sources>
                        <bpws:correlations/>
                    </bpws:invoke>
                    <bpws:extensionActivity>
                        <tibex:activityExtension
                            inputVariable="Sel_DAC_StrRic_Scen_ORDINE-input"
                            name="Sel_DAC_StrRic_Scen_ORDINE"
                            outputVariable="Sel_DAC_StrRic_Scen_ORDINE"
                            tibex:xpdlId="3f1cba5f-7a07-4d5c-af1f-0330392e2a13" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
                                <bpws:target linkName="EmptyToSel_DAC_NIRIMDAC-NIFINACC-NFESPL-NIREALNP"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Select_DAC_OrdineToGroupEnd"/>
                            </bpws:sources>
                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3f1cba5f-7a07-4d5c-af1f-0330392e2a13+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;Sel_DAC_StrRic_Scen_ORDINE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;            &lt;CODICEORDINETI>&#xa;                &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:CODICE_ORDINE_TI&quot;/>&#xa;            &lt;/CODICEORDINETI>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="GenericJDBCTimeout"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ord.DAC, ord.DACRIMODULATA, rich.STRUTTURARICHIESTA, ord.TIPOLOGIASCENARIO,&#xa;&#x9;rich.OFFERTA&#xa;FROM BDS_1_CASEDATA_ORDINE ord&#xa;JOIN BDS_1_CASEDATA_RICHIESTA rich ON ord.IDRICHIESTAOLO = rich.IDRICHIESTAOLO&#xa;WHERE ord.IDRICHIESTAOLO = ? and ord.CODICEORDINETI = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICEORDINETI"/>
                                    <columnMetadata
                                    columnName="DAC"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DACRIMODULATA"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="STRUTTURARICHIESTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIASCENARIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:extActivity
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:Q2=&quot;http://www.tim.com/NOW/xsd/EventoDTUNumAggtvo/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:Q1=&quot;http://www.tim.com/NOW/xsd/DTUEventoOrdine/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_DTUEvento&quot;/>&#xa;    &lt;xsl:param name=&quot;IdRichiestaOlo_Original&quot;/>&#xa;    &lt;xsl:template name=&quot;Call_EventoDTUNumAggtvo-input&quot; match=&quot;/&quot;>&#xa;        &lt;Q2:Root_EventoDTUNumAggtvo>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapInput/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:AGGIUNTIVI)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MapInput/ns:INTERMEDIA/ns:PRENOTAZIONE_NUMERO/ns:AGGIUNTIVI&quot;>&#xa;                        &lt;Q2:EventoDTUNumAggtvo>&#xa;                            &lt;IdEventoOrdnNowWhls>&#xa;                                &lt;xsl:value-of select=&quot;$Invoke_DTUEvento/output/Q1:DTUEventoResponse/IdEventoOrdnNowWhls&quot;/>&#xa;                            &lt;/IdEventoOrdnNowWhls>&#xa;                            &lt;IdRichiestaOlo>&#xa;                                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                            &lt;/IdRichiestaOlo>&#xa;                            &lt;NumAggntvDirezta>&#xa;                                &lt;xsl:value-of select=&quot;ns:DIREZIONALITA&quot;/>&#xa;                            &lt;/NumAggntvDirezta>&#xa;                            &lt;NumeroAggiuntivo>&#xa;                                &lt;xsl:value-of select=&quot;ns:TELAGGIUNTIVO&quot;/>&#xa;                            &lt;/NumeroAggiuntivo>&#xa;                            &lt;NumeroAggiuntivoAccs>&#xa;                                &lt;xsl:value-of select=&quot;ns:TIPOLOGIA_ACCESSO&quot;/>&#xa;                            &lt;/NumeroAggiuntivoAccs>&#xa;                            &lt;StatoNumAggtvo>&#xa;                                &lt;xsl:value-of select=&quot;ns:STATOAGGIUNTIVO&quot;/>&#xa;                            &lt;/StatoNumAggtvo>&#xa;                        &lt;/Q2:EventoDTUNumAggtvo>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($MapInput/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:AGGIUNTIVI)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MapInput/ns:FINALE/ns:PRENOTAZIONE_NUMERO/ns:AGGIUNTIVI&quot;>&#xa;                        &lt;Q2:EventoDTUNumAggtvo>&#xa;                            &lt;IdEventoOrdnNowWhls>&#xa;                                &lt;xsl:value-of select=&quot;$Invoke_DTUEvento/output/Q1:DTUEventoResponse/IdEventoOrdnNowWhls&quot;/>&#xa;                            &lt;/IdEventoOrdnNowWhls>&#xa;                            &lt;IdRichiestaOlo>&#xa;                                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                            &lt;/IdRichiestaOlo>&#xa;                            &lt;NumAggntvDirezta>&#xa;                                &lt;xsl:value-of select=&quot;ns:DIREZIONALITA&quot;/>&#xa;                            &lt;/NumAggntvDirezta>&#xa;                            &lt;NumeroAggiuntivo>&#xa;                                &lt;xsl:value-of select=&quot;ns:TELAGGIUNTIVO&quot;/>&#xa;                            &lt;/NumeroAggiuntivo>&#xa;                            &lt;NumeroAggiuntivoAccs>&#xa;                                &lt;xsl:value-of select=&quot;ns:TIPOLOGIA_ACCESSO&quot;/>&#xa;                            &lt;/NumeroAggiuntivoAccs>&#xa;                            &lt;StatoNumAggtvo>&#xa;                                &lt;xsl:value-of select=&quot;ns:STATOAGGIUNTIVO&quot;/>&#xa;                            &lt;/StatoNumAggtvo>&#xa;                        &lt;/Q2:EventoDTUNumAggtvo>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$MapInput/ns:FINALE/ns:FONIA/ns:AGGIUNTIVI&quot;>&#xa;                        &lt;Q2:EventoDTUNumAggtvo>&#xa;                            &lt;IdEventoOrdnNowWhls>&#xa;                                &lt;xsl:value-of select=&quot;$Invoke_DTUEvento/output/Q1:DTUEventoResponse/IdEventoOrdnNowWhls&quot;/>&#xa;                            &lt;/IdEventoOrdnNowWhls>&#xa;                            &lt;IdRichiestaOlo>&#xa;                                &lt;xsl:value-of select=&quot;$IdRichiestaOlo_Original&quot;/>&#xa;                            &lt;/IdRichiestaOlo>&#xa;                            &lt;xsl:if test=&quot;ns:DIREZIONALITA&quot;>&#xa;                                &lt;NumAggntvDirezta>&#xa;                                    &lt;xsl:value-of select=&quot;ns:DIREZIONALITA&quot;/>&#xa;                                &lt;/NumAggntvDirezta>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;NumeroAggiuntivo>&#xa;                                &lt;xsl:value-of select=&quot;ns:TELAGGIUNTIVO&quot;/>&#xa;                            &lt;/NumeroAggiuntivo>&#xa;                            &lt;NumeroAggiuntivoAccs>&#xa;                                &lt;xsl:value-of select=&quot;ns:TIPOLOGIA_ACCESSO&quot;/>&#xa;                            &lt;/NumeroAggiuntivoAccs>&#xa;                            &lt;StatoNumAggtvo>&#xa;                                &lt;xsl:value-of select=&quot;ns:STATOAGGIUNTIVO&quot;/>&#xa;                            &lt;/StatoNumAggtvo>&#xa;                        &lt;/Q2:EventoDTUNumAggtvo>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/Q2:Root_EventoDTUNumAggtvo>&#xa;    &lt;/xsl:template>&#x