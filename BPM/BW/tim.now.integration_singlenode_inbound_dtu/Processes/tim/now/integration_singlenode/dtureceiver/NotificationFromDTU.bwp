        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                                    &lt;ns:DESCRIZIONE_ERRORE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;DPNR non valorizzata per NI_RIMODULAZIONE_DPR&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA = &amp;quot;NI_RIMODULAZIONE_DAC&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($MapInput/ns:INTERMEDIA/ns:INFO_CU_RDAC/ns:RDAC)=0&quot;>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                    &lt;/ns:DATA>&#xa;                                                    &lt;ns:TRANSACTION_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                                                    &lt;/ns:TRANSACTION_ID>&#xa;                                                    &lt;ns:CAUSALE_ESITO>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;001&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:CAUSALE_ESITO>&#xa;                                                    &lt;ns:TIPO_MESSAGGIO>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:TIPOLOGIA_NOTIFICA&quot;/>&#xa;                                                    &lt;/ns:TIPO_MESSAGGIO>&#xa;                                                    &lt;ns:DESCRIZIONE_ERRORE>&#xa;                                                        &lt;xsl:value-of select=&quot;&amp;quot;RDAC non valorizzata per NI_RIMODULAZIONE_DAC&amp;quot;&quot;/>&#xa;                                                    &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                                                    &lt;ns:ID_RICHIESTA>&#xa;                                                        &lt;xsl:value-of select=&quot;$MapInput/ns:TESTATA/ns:ID_RICHIESTA&quot;/>&#xa;                                                    &lt;/ns:ID_RICHIESTA>&#xa;                                                &lt;/ns:ACK_COMUNICAZIONE>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;exists($Sel_DAC_StrRic_Scen_ORDINE/Record[1]/DACRIMODULATA) and (tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $MapInput/ns:INTERMEDIA/ns:INFO_CU_RDAC/ns:RDAC) &amp;lt; current-date() or tib:compare-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $MapInput/ns:INTERMEDIA/ns:INFO_CU_RDAC/ns:RDAC), tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($Sel_DAC_StrRic_Scen_ORDINE/Record[1]/DACRIMODULATA))) = -1) and not($Sel_DAC_StrRic_Scen_ORDINE/Record[1]/OFFERTA=('ULLLINEANONATTIVA','ULLDATILINEANONATTIVA','SLULINEANONATTIVA','VULLLINEANONATTIVA'))&quot;>&#xa;                                                &lt;ns:ACK_COMUNICAZIONE>&#xa;                                                    &lt;ns:DATA>&#xa;                                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;