            <bpws:scope name="Scope" tibex:group="none" tibex:xpdlId="3c166a39-9b79-4dfa-b6d5-51181119186d">
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryToScope"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ScopeToJDBC_TipolgEsitoDTU"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="FaultName1"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails1" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:faultHandlers>
                    <bpws:catchAll tibex:faultDetailsVar="FaultDetails1"
                        tibex:faultNameVar="FaultName1" tibex:xpdlId="ca25bbda-3d52-4b3b-abd9-d1f401533dc0">
                        <bpws:scope name="scope2">
                            <bpws:flow name="flow4">
                                <bpws:links>
                                    <bpws:link
                                    name="CallProcessToJMSSendMessage" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="JMSSendMessageToConfirm1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcess1LogToExit1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Confirm1ToCallProcess1Log" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessLogToCallProcess1Log" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                </bpws:links>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CallProcessLog-input"
                                    name="CallProcessLog"
                                    tibex:xpdlId="7b65848b-a501-4d63-af5d-4e35e2612e80"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToJMSSendMessage">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$JMSXDeliveryCount = $ReceiveDTUMessage/JMSProperties/ns0:JMSXDeliveryCount" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$JMSXDeliveryCount = $ReceiveDTUMessage/JMSProperties/ns0:JMSXDeliveryCount]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallProcessLogToCallProcess1Log">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioNotifica'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&#xa;                &lt;/tns2:MsgCode>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails1, true(), true())&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CallProcess1Log-input"
                                    name="CallProcess1Log"
                                    tibex:xpdlId="ba352993-252f-44f7-a99c-7842effebc68"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessLogToCallProcess1Log"/>
                                    <bpws:target linkName="Confirm1ToCallProcess1Log"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1LogToExit1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns0=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+dfbcd7bd-92e9-44ba-b98f-fa5ea9c0766c+output&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSXDeliveryCount&quot;/>&#xa;    &lt;xsl:param name=&quot;ReceiveDTUMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;MapInput&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess1Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.integration_singlenode.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'NotificationFromDTU'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'NotificaDTUPortType'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioNotifica'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JMSXDeliveryCount = $ReceiveDTUMessage/JMSProperties/ns0:JMSXDeliveryCount&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;IL MESSAGGIO con JMSMessageID: &amp;quot;,$ReceiveDTUMessage/JMSHeaders/ns0:JMSMessageID,&amp;quot; ID_RICHIESTA: &amp;quot;, $MapInput/ns:TESTATA/ns:ID_RICHIESTA,&amp;quot; E STATO INSERITO SULLA CODA DI SCARTO: JMSXDeliveryCount RAGGIUNTO&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;IL MESSAGGIO con JMSMessageID: &amp;quot;,$ReceiveDTUMessage/JMSHeaders/ns0:JMSMessageID,&amp;quot; ID_RICHIESTA: &amp;quot;, $MapInput/ns:TESTATA/ns:ID_RICHIESTA, &amp;quot; VERRA RIPROPOSTO&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="JMSSendMessage-input"
                                    name="JMSSendMessage"
                                    outputVariable="JMSSendMessage"
                                    tibex:xpdlId="1779a7b8-f1e1-40fb-bf8b-090d0e0d379b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToJMSSendMessage"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JMSSendMessageToConfirm1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
