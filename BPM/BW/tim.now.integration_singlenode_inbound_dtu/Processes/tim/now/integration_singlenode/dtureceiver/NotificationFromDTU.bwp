e="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$ReceiveDTUMessage/DynamicProperties/ns0:property[ns0:name="soapaction"]/ns0:value='GetAck' or
