<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/ProgressivoNotificaDTU/">
	<element name="Input_Select_Progressivo">
		<complexType>
			<sequence>
                <element name="IDRichiestaOlo" type="string"/>
            </sequence>
        </complexType>
     </element>
     <element name="Output_Select_Progressivo">
		<complexType>
			<sequence>
				<element name="Esito" type="string"/>
                <element minOccurs="0" name="ProgressivoNotifiche" type="integer"/>
            </sequence>
        </complexType>
     </element>
     <element name="Input_Upsert_Progressivo">
		<complexType>
			<sequence>
                <element name="IDRichiestaOlo" type="string"/>
                <element name="Azione" type="string"/>
                <element name="ProgressivoNotifiche" type="integer"/>
            </sequence>
        </complexType>
     </element>
     <element name="Output_Upsert_Progressivo">
		<complexType>
			<sequence>
				<element name="Esito" type="string"/>
            </sequence>
        </complexType>
     </element>
</schema>
