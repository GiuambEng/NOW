                        <bpws:sources>
                            <bpws:source linkName="JDBCUpdateToJDBCUpdate1"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e17438bf-d5ad-4023-98b7-eb3b61636c74+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisitionFileCRMWS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;ESEC_PROCSO_FILE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;COD_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;'FILE_NOTIFICA_CRMWS_OLO_BATCH'&quot;/>&#xa;            &lt;/COD_PROCSO_FILE>&#xa;            &lt;ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:ESEC_PROCSO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ESEC_PROCSO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ESEC_PROCSO_FILE>&#xa;            &lt;ID_PROCSO_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ID_PROCSO_FILE/Record[1]/ID_PROCSO_FILE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_FILE/Record[1]/ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_PROCSO_FILE>&#xa;            &lt;STATO_ESEC>&#xa;                &lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON SUCCESSO'&quot;/>&#xa;            &lt;/STATO_ESEC>&#xa;            &lt;TMSP_INIZIO_ELAB>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TMSP_INIZIO_ELAB>&#xa;            &lt;TMSP_FINE_ELAB>&#xa;                &lt;xsl:value-of select=&quot;tib:add-to-dateTime(current-dateTime(),0, 0, 0, 0, 0,40)&quot;/>&#xa;            &lt;/TMSP_FINE_ELAB>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
