                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="LOG_FILE_PROCSTO_OK-input"
                        name="LOG_FILE_PROCSTO_OK"
                        outputVariable="LOG_FILE_PROCSTO_OK"
                        tibex:xpdlId="5702fd52-6a75-4478-a5c0-0ca7b7baf5e0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="JDBCUpdate1ToJDBCUpdate2"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="JDBCUpdate2ToJDBCUpdate3"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5702fd52-6a75-4478-a5c0-0ca7b7baf5e0+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisitionFileCRMWS/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_FILE_PROCSTO_OK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;COD_PROCSO>&#xa;                &lt;xsl:value-of select=&quot;'FILE_NOTIFICA_CRMWS_OLO_BATCH'&quot;/>&#xa;            &lt;/COD_PROCSO>&#xa;            &lt;ID_ESEC_PROCSO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:ESEC_PROCSO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ESEC_PROCSO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ESEC_PROCSO>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:ID_FILE_PROCSTO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ID_FILE_PROCSTO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FILE>&#xa;            &lt;LOG_LEVEL>&#xa;                &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;            &lt;/LOG_LEVEL>&#xa;            &lt;LOG_MESSAGE>&#xa;                &lt;xsl:value-of select=&quot;'File analizzato'&quot;/>&#xa;            &lt;/LOG_MESSAGE>&#xa;            &lt;TIMSTP_INSMTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
