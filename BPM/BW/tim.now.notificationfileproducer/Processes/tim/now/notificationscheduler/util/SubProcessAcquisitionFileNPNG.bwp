                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="JDBCUpdate1-input"
                        name="JDBCUpdate1" outputVariable="JDBCUpdate1"
                        tibex:xpdlId="7327f7b2-2105-407b-84b2-5ccb542094cf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="JDBCUpdateToJDBCUpdate1"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="JDBCUpdate1ToJDBCUpdate2"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7327f7b2-2105-407b-84b2-5ccb542094cf+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisitionFileCRMWS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFile&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                    &lt;COD_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/COD_OLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/COD_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COD_OLO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;substring(substring-before($ReadFile/fileInfo/fileName, 'N.csv'),12,3)&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;            &lt;/DATA_FILE>&#xa;            &lt;DESCR_STATO_FILE>&#xa;                &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;            &lt;/DESCR_STATO_FILE>&#xa;            &lt;ESITO>&#xa;                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;            &lt;/ESITO>&#xa;            &lt;ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:ESEC_PROCSO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ESEC_PROCSO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ESEC_PROCSO_FILE>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:ID_FILE_PROCSTO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ID_FILE_PROCSTO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_FILE>&#xa;            &lt;ID_INTRFC>&#xa;                &lt;xsl:value-of select=&quot;397&quot;/>&#xa;            &lt;/ID_INTRFC>&#xa;            &lt;IDTPLG_FILE>&#xa;                &lt;xsl:value-of select=&quot;3&quot;/>&#xa;            &lt;/IDTPLG_FILE>&#xa;            &lt;NOME_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:FileInfo/tns1:FileName)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:FileInfo/tns1:FileName&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_FILE>&#xa;            &lt;TIMSTP_APERTURA_FILE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_APERTURA_FILE>&#xa;            &lt;TIMSTP_CHIUSURA_FILE>&#xa;                &lt;xsl:value-of select=&quot;tib:add-to-dateTime(current-dateTime(),0,0,0,0,0,46)&quot;/>&#xa;            &lt;/TIMSTP_CHIUSURA_FILE>&#xa;            &lt;VERSO_DEL_FILE>&#xa;                &lt;xsl:value-of select=&quot;'INPUT'&quot;/>&#xa;            &lt;/VERSO_DEL_FILE>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.jdbc.update"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <attributeBindings
