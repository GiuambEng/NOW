            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:NOW_SECOLO_RolloutServicePortType"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType1">
                <plnk:role name="use" portType="ptyp1:NOW_SECOLOPortType"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tibco.com/NOW_SECOLO_ROLLOUT/"/>
            <wsdl:import namespace="http://www.tibco.com/NOW_SECOLO/"/>
            <wsdl:import namespace="http://www.tibco.com/NOW_SECOLO/"/>
        </wsdl:definitions>
