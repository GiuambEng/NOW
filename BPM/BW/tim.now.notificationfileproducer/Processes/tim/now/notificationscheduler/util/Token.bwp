    xmlns:ns6="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+61e82c77-3988-4bc4-86b3-334fc3e17a99"
    xmlns:ns7="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+74c8d82e-d20b-4bbf-ab41-54f0a3e7ebfd"
