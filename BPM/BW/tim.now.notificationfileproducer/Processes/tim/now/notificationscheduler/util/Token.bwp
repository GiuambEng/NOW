            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Rollout&quot;/>&#xa;    &lt;xsl:param name=&quot;DecodeSECOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;variable&quot;/>&#xa;    &lt;xsl:param name=&quot;SECOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$variable='True'&quot;>&#xa;                    &lt;tns1:ResponseCreate_token>&#xa;                        &lt;tns1:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ESITO>&#xa;                        &lt;tns1:DESCRIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;'X'&quot;/>&#xa;                        &lt;/tns1:DESCRIZIONE>&#xa;                    &lt;/tns1:ResponseCreate_token>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SECOLO/Output/tns3:ResponseCreate_token)&quot;>&#xa;                    &lt;tns1:ResponseCreate_token>&#xa;                        &lt;xsl:if test=&quot;$SECOLO/Output/tns3:ResponseCreate_token/tns3:Token&quot;>&#xa;                            &lt;tns1:Token>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO/Output/tns3:ResponseCreate_token/tns3:Token&quot;/>&#xa;                            &lt;/tns1:Token>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$SECOLO/Output/tns3:ResponseCreate_token/tns3:ESITO&quot;/>&#xa;                        &lt;/tns1:ESITO>&#xa;                        &lt;xsl:if test=&quot;$SECOLO/Output/tns3:ResponseCreate_token/tns3:DESCRIZIONE&quot;>&#xa;                            &lt;tns1:DESCRIZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO/Output/tns3:ResponseCreate_token/tns3:DESCRIZIONE&quot;/>&#xa;                            &lt;/tns1:DESCRIZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:ResponseCreate_token>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;exists($DecodeSECOLO/Output/tns3:ResponseDecode_token)&quot;>&#xa;                &lt;tns1:ResponseDecode_token>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:ESITO&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:DESCRIZIONE&quot;>&#xa;                        &lt;tns1:DESCRIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:DESCRIZIONE&quot;/>&#xa;                        &lt;/tns1:DESCRIZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:N_Recap_Cliente&quot;>&#xa;                        &lt;tns1:N_Recap_Cliente>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:N_Recap_Cliente&quot;/>&#xa;                        &lt;/tns1:N_Recap_Cliente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:N_Recap_Cliente_ALT&quot;>&#xa;                        &lt;tns1:N_Recap_Cliente_ALT>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:N_Recap_Cliente_ALT&quot;/>&#xa;                        &lt;/tns1:N_Recap_Cliente_ALT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:Note&quot;>&#xa;                        &lt;tns1:Note>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns3:ResponseDecode_token/tns3:Note&quot;/>&#xa;                        &lt;/tns1:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:ResponseDecode_token>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Rollout/Output/tns2:ResponseVerificaRollout)&quot;>&#xa;                &lt;tns1:Rollout>&#xa;                    &lt;xsl:value-of select=&quot;$Rollout/Output/tns2:ResponseVerificaRollout/tns2:ESITO&quot;/>&#xa;                &lt;/tns1:Rollout>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="c6326272-0a73-4734-8576-f2a9300ca0df" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Rollout.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;SECOLO.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;DecodeSECOLO.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;variable&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$variable='True'&quot;>&#xa;                    &lt;tns1:ResponseCreate_token>&#xa;                        &lt;tns1:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ESITO>&#xa;                        &lt;tns1:DESCRIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;'X'&quot;/>&#xa;                        &lt;/tns1:DESCRIZIONE>&#xa;                    &lt;/tns1:ResponseCreate_token>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SECOLO.Output)&quot;>&#xa;                    &lt;tns1:ResponseCreate_token>&#xa;                        &lt;xsl:if test=&quot;$SECOLO.Output/tns3:Token&quot;>&#xa;                            &lt;tns1:Token>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO.Output/tns3:Token&quot;/>&#xa;                            &lt;/tns1:Token>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;$SECOLO.Output/tns3:ESITO&quot;/>&#xa;                        &lt;/tns1:ESITO>&#xa;                        &lt;xsl:if test=&quot;$SECOLO.Output/tns3:DESCRIZIONE&quot;>&#xa;                            &lt;tns1:DESCRIZIONE>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO.Output/tns3:DESCRIZIONE&quot;/>&#xa;                            &lt;/tns1:DESCRIZIONE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:ResponseCreate_token>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;exists($DecodeSECOLO.Output)&quot;>&#xa;                &lt;tns1:ResponseDecode_token>&#xa;                    &lt;tns1:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns3:ESITO&quot;/>&#xa;                    &lt;/tns1:ESITO>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO.Output/tns3:DESCRIZIONE&quot;>&#xa;                        &lt;tns1:DESCRIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns3:DESCRIZIONE&quot;/>&#xa;                        &lt;/tns1:DESCRIZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO.Output/tns3:N_Recap_Cliente&quot;>&#xa;                        &lt;tns1:N_Recap_Cliente>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns3:N_Recap_Cliente&quot;/>&#xa;                        &lt;/tns1:N_Recap_Cliente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO.Output/tns3:N_Recap_Cliente_ALT&quot;>&#xa;                        &lt;tns1:N_Recap_Cliente_ALT>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns3:N_Recap_Cliente_ALT&quot;/>&#xa;                        &lt;/tns1:N_Recap_Cliente_ALT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO.Output/tns3:Note&quot;>&#xa;                        &lt;tns1:Note>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns3:Note&quot;/>&#xa;                        &lt;/tns1:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:ResponseDecode_token>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Rollout.Output)&quot;>&#xa;                &lt;tns1:Rollout>&#xa;                    &lt;xsl:value-of select=&quot;$Rollout.Output/tns2:ESITO&quot;/>&#xa;                &lt;/tns1:Rollout>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
