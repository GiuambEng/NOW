                                    <bpws:sources>
                                    <bpws:source linkName="MapperToGenericLogger1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlIntestazione&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NumeriTelefonici>&#xa;            &lt;xsl:if test=&quot;string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:TEL_REF)>0 or string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:MOB_REF)>0 or&amp;#xD;&amp;#xA;string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:COGNOME_REF)>0 or string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:NOME_REF)>0&quot;>&#xa;                &lt;tns1:NumeriTelefonici>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:COGNOME_REF&quot;>&#xa;                        &lt;tns1:CognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:COGNOME_REF&quot;/>&#xa;                        &lt;/tns1:CognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:NOME_REF&quot;>&#xa;                        &lt;tns1:NomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:NOME_REF&quot;/>&#xa;                        &lt;/tns1:NomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:TEL_REF&quot;>&#xa;                        &lt;tns1:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:TEL_REF&quot;/>&#xa;                        &lt;/tns1:TelefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:MOB_REF&quot;>&#xa;                        &lt;tns1:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[1]/ns01:MOB_REF&quot;/>&#xa;                        &lt;/tns1:TelefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:NumeriTelefonici>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:TEL_REF)>0 or string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:MOB_REF)>0 or&amp;#xD;&amp;#xA;string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:COGNOME_REF)>0 or string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:NOME_REF)>0&quot;>&#xa;                &lt;tns1:NumeriTelefonici>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:COGNOME_REF&quot;>&#xa;                        &lt;tns1:CognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:COGNOME_REF&quot;/>&#xa;                        &lt;/tns1:CognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:NOME_REF&quot;>&#xa;                        &lt;tns1:NomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:NOME_REF&quot;/>&#xa;                        &lt;/tns1:NomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:TEL_REF&quot;>&#xa;                        &lt;tns1:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:TEL_REF&quot;/>&#xa;                        &lt;/tns1:TelefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:MOB_REF&quot;>&#xa;                        &lt;tns1:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[2]/ns01:MOB_REF&quot;/>&#xa;                        &lt;/tns1:TelefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:NumeriTelefonici>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[3]/ns01:TEL_REF)>0 or string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[3]/ns01:MOB_REF)>0 or&amp;#xD;&amp;#xA;string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[3]/ns01:COGNOME_REF)>0 or string-length($ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[3]/ns01:NOME_REF)>0&quot;>&#xa;                &lt;tns1:NumeriTelefonici>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[3]/ns01:COGNOME_REF&quot;>&#xa;                        &lt;tns1:CognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[3]/ns01:COGNOME_REF&quot;/>&#xa;                        &lt;/tns1:CognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quo