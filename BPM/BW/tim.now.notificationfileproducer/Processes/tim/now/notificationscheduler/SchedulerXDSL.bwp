            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;TransformAQXml&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteFileAQ-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:WriteActivityInputTextClass>&#xa;            &lt;xsl:if test=&quot;$FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileNameAQ&quot;>&#xa;                &lt;fileName>&#xa;                    &lt;xsl:value-of select=&quot;$FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileNameAQ&quot;/>&#xa;                &lt;/fileName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:FlagNamespaceFileNotifica = &amp;quot;N&amp;quot;&quot;>&#xa;                    &lt;textContent>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, $TransformAQXml)&quot;/>&#xa;                    &lt;/textContent>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;textContent>&#xa;                        &lt;xsl:value-of select=&quot;$ContenutoFile/tns2:ContenutoFileAQ&quot;/>&#xa;                    &lt;/textContent>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns5:WriteActivityInputTextClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="WriteFileAQ-input" name="WriteFileAQ"
                    outputVariable="WriteFileAQ"
                    tibex:xpdlId="c3a81c84-0f27-41bb-930c-fba9fe2b0631" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
