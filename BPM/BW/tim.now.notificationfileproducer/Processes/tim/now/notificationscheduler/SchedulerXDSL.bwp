                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;TransformAQXml&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteFileAQ-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:WriteActivityInputTextClass>&#xa;            &lt;xsl:if test=&quot;$FileNameInvoke.FileNameOutput/tns2:FileNameAQ&quot;>&#xa;                &lt;fileName>&#xa;                    &lt;xsl:value-of select=&quot;$FileNameInvoke.FileNameOutput/tns2:FileNameAQ&quot;/>&#xa;                &lt;/fileName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:FlagNamespaceFileNotifica = &amp;quot;N&amp;quot;&quot;>&#xa;                    &lt;textContent>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, $TransformAQXml)&quot;/>&#xa;                    &lt;/textContent>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;textContent>&#xa;                        &lt;xsl:value-of select=&quot;$ContenutoFile/tns2:ContenutoFileAQ&quot;/>&#xa;                    &lt;/textContent>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns5:WriteActivityInputTextClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.write"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
