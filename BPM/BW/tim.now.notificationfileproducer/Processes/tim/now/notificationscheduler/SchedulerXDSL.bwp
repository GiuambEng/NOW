                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ContenutoFileToTransformXml_FlagNamespaceFileNotificaN">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$XDSLSchedulerIn/SchedulerInput/ns5:SchedulerInput/ns5:FlagNamespaceFileNotifica = &quot;N&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
