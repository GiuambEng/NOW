                   &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheTotali&quot;/>&#xa;                                &lt;/tns1:NotificheTotali>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns1:NotificheOK>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheOK&quot;/>&#xa;                        &lt;/tns1:NotificheOK>&#xa;                        &lt;tns1:NoticheKO>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NoticheKO&quot;/>&#xa;                        &lt;/tns1:NoticheKO>&#xa;                        &lt;tns1:NotificheIntermedie>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheIntermedie&quot;/>&#xa;                        &lt;/tns1:NotificheIntermedie>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;) and $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheMigrazioni + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheMigrazioni>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:Notifich