      &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[4]/ns01:COGNOME_REF&quot;/>&#xa;                        &lt;/tns1:CognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[4]/ns01:NOME_REF&quot;>&#xa;                        &lt;tns1:NomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[4]/ns01:NOME_REF&quot;/>&#xa;                        &lt;/tns1:NomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[4]/ns01:TEL_REF&quot;>&#xa;                        &lt;tns1:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[4]/ns01:TEL_REF&quot;/>&#xa;                        &lt;/tns1:TelefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[4]/ns01:MOB_REF&quot;>&#xa;                        &lt;tns1:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns01:DATI_REFERENTE/ns01:REFERENTE[4]/ns01:MOB_REF&quot;/>&#xa;                        &lt;/tns1:TelefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:NumeriTelefonici>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:NumeriTelefonici>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:NotificationScheduler="http://www.tim.com/NOW/xsd/NotificationScheduler"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NotificationScheduler:NumeriTelefonici" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="GenericLogger1-input"
                                    name="GenericLogger1"
                                    tibex:xpdlId="dea96f68-87c8-4220-bd44-a77449298547"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGenericLogger1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLogger1ToWhile1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;GenericLogger1-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerXDSL&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;XDSLSchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;XDSLScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Tokenizzazione Referenti',tib:render-xml($Mapper,true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:scope name="While1"
                                tibex:group="while" tibex:xpdlId="9a456f4e-b7ab-4c50-b429-eb0fd90d4269">
                                <bpws:targets>
                                    <bpws:target linkName="GenericLogger1ToWhile1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="While1ToEmpty1"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    <bpws:variable name="FaultName7"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns0:FaultDetail"
                                    name="FaultDetails6" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails6"
                                    tibex:faultNameVar="FaultName7" tibex:xpdlId="8caf1f2e-cb7c-4204-aa79-f6984aea6f47">
                                    <bpws:scope name="scope1">
                                    <bpws:flow name="flow9">
                                    <bpws:links>
                                    <bpws:link
                                    name="GenericLogger3ToAssign1" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="GenericLogger3-input"
                                    name="GenericLogger3"
                                    tibex:xpdlId="419b46d0-286e-4d43-be35-b2f670893004"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLogger3ToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;FaultDetails6&quot;/>&lt;xsl:template name=&quot;GenericLogger3-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerXDSL&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;XDSLSchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;XDSLScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat($FaultDetails6/ActivityName, $FaultDetails6/StackTrace,$FaultDetails6/ProcessStack,$FaultDetails6/MsgCode,$FaultDetails6/Msg)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>

                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="ControlloReferenti"
                                    name="Assign1"
                                    outputVariable="ControlloReferenti"
                                    tibex:xpdlId="d5ff08d2-a47d-4803-9c8d-1051706249a9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLogger3ToAssign1"/>
                                    </bpws:targets>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="'False'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>

                                    <value
                                    processVariable="ControlloReferenti" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    </bpws:flow>
                                    </bpws:scope>
                                    </bpws:catchAll>
                                </bpws:faultHandlers>
                                <bpws:sequence name="sequence" tibex:group="while">
                                    <bpws:assign name="GroupInit1"
                                    tibex:group="groupInit" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+7c13e8fb-bd80-4a6e-8b0a-7565283be2ce" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:while name="while" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($Mapper/ns5:NumeriTelefonici)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($Mapper/ns5:NumeriTelefonici)]]></bpws:condition>
                                    <bpws:flow name="flow8">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart7ToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="TokenToEmpty" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AssignToToken" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="EmptyToMapper1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="GroupStart7ToMapper1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Mapper1ToGenericLogger2" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="EmptyToThrow" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="GenericLogger2ToGroupEnd6" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart7"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="a4ca1b10-4ace-4034-a5fa-b5b8965c0e29" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart7ToAssign">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="contains($Mapper/ns5:NumeriTelefonici[$index1]/ns5:TelefonoFissoReferente, 'kk') or contains($Mapper/ns5:NumeriTelefonici[$index1]/ns5:TelefonoMobileReferente,'kk')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
