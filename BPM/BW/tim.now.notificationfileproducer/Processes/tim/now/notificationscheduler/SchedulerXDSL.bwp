                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;Token&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NumeriTelefonici>&#xa;            &lt;tns1:NumeriTelefonici>&#xa;                &lt;xsl:if test=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente&quot;>&#xa;                    &lt;tns1:CognomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente&quot;/>&#xa;                    &lt;/tns1:CognomeReferente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente&quot;>&#xa;                    &lt;tns1:NomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente&quot;/>&#xa;                    &lt;/tns1:NomeReferente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente&quot;>&#xa;                            &lt;tns1:TelefonoFissoReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente&quot;/>&#xa;                            &lt;/tns1:TelefonoFissoReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;  