            <bpws:invoke inputVariable="ZipFileAQInvoke-input"
                name="ZipFileAQInvoke" operation="ZipFile"
                outputVariable="ZipFileAQInvoke" partnerLink="ZipFile"
                portType="ns43:ZipFilePortType" tibex:xpdlId="19806ed3-8228-4c86-8537-e6f2f2addeb8">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns4="http://www.tim.com/NOW/xsd/WriteFile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="IDTipologiaFile"/&gt;
    &lt;xsl:param name="NumeroNotificheGeneriche"/&gt;
    &lt;xsl:param name="XDSLSchedulerIn"/&gt;
    &lt;xsl:param name="WriteFileAQ"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="XDSLInterfacciaIDOrarioAQ"/&gt;
    &lt;xsl:param name="XDSLInterfacciaIDGiornalieroAQ"/&gt;
    &lt;xsl:param name="XDSLIDProcsoFileInvio"/&gt;
    &lt;xsl:template name="ZipFileAQInvoke-input" match="/"&gt;
        &lt;tns6:ZipFileRequest&gt;
            &lt;ZipFileInput&gt;
                &lt;tns4:ZipFileRequest&gt;
                    &lt;tns4:FullName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFileAQ/fileInfo/fullName)"/&gt;
                    &lt;/tns4:FullName&gt;
                    &lt;tns4:FileName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFileAQ/fileInfo/fileName)"/&gt;
                    &lt;/tns4:FileName&gt;
                    &lt;tns4:Size&gt;
                        &lt;xsl:value-of select="xsd:int($WriteFileAQ/fileInfo/size)"/&gt;
                    &lt;/tns4:Size&gt;
                    &lt;tns4:CodiceOLO&gt;
                        &lt;xsl:value-of select="$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO"/&gt;
                    &lt;/tns4:CodiceOLO&gt;
                    &lt;tns4:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM"/&gt;
                    &lt;/tns4:CodiceOLOAGCOM&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica) &gt; 0"&gt;
                            &lt;tns4:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta"/&gt;
                            &lt;/tns4:StrutturaRichiesta&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="&amp;quot;FILE VUOTO&amp;quot;"/&gt;
                            &lt;/tns4:StrutturaRichiesta&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica) &gt; 0"&gt;
                            &lt;tns4:NumeroRecord&gt;
                                &lt;xsl:value-of select="xsd:int(count($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica))"/&gt;
                            &lt;/tns4:NumeroRecord&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:NumeroRecord&gt;
                                &lt;xsl:value-of select="0"/&gt;
                            &lt;/tns4:NumeroRecord&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;
                            &lt;tns4:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$XDSLInterfacciaIDOrarioAQ"/&gt;
                            &lt;/tns4:IDInterfaccia&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$XDSLInterfacciaIDGiornalieroAQ"/&gt;
                            &lt;/tns4:IDInterfaccia&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns4:IDTipologiaFile&gt;
                        &lt;xsl:value-of select="$IDTipologiaFile"/&gt;
                    &lt;/tns4:IDTipologiaFile&gt;
                    &lt;tns4:IDProcsoFile&gt;
                        &lt;xsl:value-of select="$XDSLIDProcsoFileInvio"/&gt;
                    &lt;/tns4:IDProcsoFile&gt;
                    &lt;tns4:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns4:ProcessIstanceID&gt;
                &lt;/tns4:ZipFileRequest&gt;
            &lt;/ZipFileInput&gt;
        &lt;/tns6:ZipFileRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFileAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileAQInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ZipFileRequest>&#xa;            &lt;tns4:FullName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFileAQ/fileInfo/fullName)&quot;/>&#xa;            &lt;/tns4:FullName>&#xa;            &lt;tns4:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFileAQ/fileInfo/fileName)&quot;/>&#xa;            &lt;/tns4:FileName>&#xa;            &lt;tns4:Size>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($WriteFileAQ/fileInfo/size)&quot;/>&#xa;            &lt;/tns4:Size>&#xa;            &lt;tns4:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns4:CodiceOLO>&#xa;            &lt;tns4:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns4:CodiceOLOAGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica) > 0&quot;>&#xa;                    &lt;tns4:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;                    &lt;/tns4:StrutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FILE VUOTO&amp;quot;&quot;/>&#xa;                    &lt;/tns4:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica) > 0&quot;>&#xa;                    &lt;tns4:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(count($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica))&quot;/>&#xa;                    &lt;/tns4:NumeroRecord>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/tns4:NumeroRecord>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns4:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;                    &lt;/tns4:IDInterfaccia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;                    &lt;/tns4:IDInterfaccia>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns4:IDTipologiaFile>&#xa;            &lt;tns4:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$XDSLIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns4:IDProcsoFile>&#xa;            &lt;tns4:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns4:ProcessIstanceID>&#xa;        &lt;/tns4:ZipFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcessToZipFileAQInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ZipFileAQInvokeToWriteFile">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($NumeroNotificheGeneriche/ns5:NumeroNotificheAQ/ns5:IDNotifica) = 0 and string-length(string($ZipFileAQInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($NumeroNotificheGeneriche/ns5:NumeroNotificheAQ/ns5:IDNotifica) = 0 and string-length(string($ZipFileAQInvoke.ZipFileOutput/tns:IDFile)) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileAQInvokeToRepeatOnError1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($NumeroNotificheGeneriche/ns5:NumeroNotificheAQ/ns5:IDNotifica) > 0 and string-length(string($ZipFileAQInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($NumeroNotificheGeneriche/ns5:NumeroNotificheAQ/ns5:IDNotifica) > 0 and string-length(string($ZipFileAQInvoke.ZipFileOutput/tns:IDFile)) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileAQInvokeToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source
                        linkName="ZipFileAQInvokeToGenericLogger13"
                        tibex:faultDetailsVar="ZipFileAQInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="ZipFileInvoke-input"
                name="ZipFileInvoke" operation="ZipFile"
                outputVariable="ZipFileInvoke" partnerLink="ZipFile"
                portType="ns43:ZipFilePortType" tibex:xpdlId="dc35fce2-292a-49d0-9598-eef4ed9ecdc6">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns4="http://www.tim.com/NOW/xsd/WriteFile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="IDTipologiaFile"/&gt;
    &lt;xsl:param name="NumeroNotificheGeneriche"/&gt;
    &lt;xsl:param name="XDSLSchedulerIn"/&gt;
    &lt;xsl:param name="WriteFile"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="XDSLInterfacciaIDOrario"/&gt;
    &lt;xsl:param name="XDSLInterfacciaIDGiornaliero"/&gt;
    &lt;xsl:param name="XDSLIDProcsoFileInvio"/&gt;
    &lt;xsl:param name="ContenutoXML"/&gt;
    &lt;xsl:template name="ZipFileInvoke-input" match="/"&gt;
        &lt;tns6:ZipFileRequest&gt;
            &lt;ZipFileInput&gt;
                &lt;tns4:ZipFileRequest&gt;
                    &lt;tns4:FullName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fullName)"/&gt;
                    &lt;/tns4:FullName&gt;
                    &lt;tns4:FileName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fileName)"/&gt;
                    &lt;/tns4:FileName&gt;
                    &lt;tns4:Size&gt;
                        &lt;xsl:value-of select="xsd:int($WriteFile/fileInfo/size)"/&gt;
                    &lt;/tns4:Size&gt;
                    &lt;tns4:CodiceOLO&gt;
                        &lt;xsl:value-of select="$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO"/&gt;
                    &lt;/tns4:CodiceOLO&gt;
                    &lt;tns4:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM"/&gt;
                    &lt;/tns4:CodiceOLOAGCOM&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica) &gt; 0"&gt;
                            &lt;tns4:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta"/&gt;
                            &lt;/tns4:StrutturaRichiesta&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="&amp;quot;FILE VUOTO&amp;quot;"/&gt;
                            &lt;/tns4:StrutturaRichiesta&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica) &gt; 0"&gt;
                            &lt;tns4:NumeroRecord&gt;
                                &lt;xsl:value-of select="xsd:int(count($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica))"/&gt;
                            &lt;/tns4:NumeroRecord&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:NumeroRecord&gt;
                                &lt;xsl:value-of select="0"/&gt;
                            &lt;/tns4:NumeroRecord&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;
                            &lt;tns4:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$XDSLInterfacciaIDOrario"/&gt;
                            &lt;/tns4:IDInterfaccia&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$XDSLInterfacciaIDGiornaliero"/&gt;
                            &lt;/tns4:IDInterfaccia&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns4:IDTipologiaFile&gt;
                        &lt;xsl:value-of select="$IDTipologiaFile"/&gt;
                    &lt;/tns4:IDTipologiaFile&gt;
                    &lt;tns4:IDProcsoFile&gt;
                        &lt;xsl:value-of select="$XDSLIDProcsoFileInvio"/&gt;
                    &lt;/tns4:IDProcsoFile&gt;
                    &lt;tns4:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns4:ProcessIstanceID&gt;
                    &lt;xsl:if test="count($ContenutoXML/tns1:ContenutoXML)&gt;0"&gt;
                        &lt;tns4:Tokenizzazione&gt;
                            &lt;xsl:value-of select="'SI'"/&gt;
                        &lt;/tns4:Tokenizzazione&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns4:ZipFileRequest&gt;
            &lt;/ZipFileInput&gt;
        &lt;/tns6:ZipFileRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ZipFileRequest>&#xa;            &lt;tns4:FullName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fullName)&quot;/>&#xa;            &lt;/tns4:FullName>&#xa;            &lt;tns4:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fileName)&quot;/>&#xa;            &lt;/tns4:FileName>&#xa;            &lt;tns4:Size>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($WriteFile/fileInfo/size)&quot;/>&#xa;            &lt;/tns4:Size>&#xa;            &lt;tns4:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns4:CodiceOLO>&#xa;            &lt;tns4:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns4:CodiceOLOAGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica) > 0&quot;>&#xa;                    &lt;tns4:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;                    &lt;/tns4:StrutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FILE VUOTO&amp;quot;&quot;/>&#xa;                    &lt;/tns4:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica) > 0&quot;>&#xa;                    &lt;tns4:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(count($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica))&quot;/>&#xa;                    &lt;/tns4:NumeroRecord>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/tns4:NumeroRecord>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns4:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDOrario&quot;/>&#xa;                    &lt;/tns4:IDInterfaccia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDGiornaliero&quot;/>&#xa;                    &lt;/tns4:IDInterfaccia>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns4:IDTipologiaFile>&#xa;            &lt;tns4:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$XDSLIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns4:IDProcsoFile>&#xa;            &lt;tns4:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns4:ProcessIstanceID>&#xa;            &lt;xsl:if test=&quot;count($ContenutoXML/tns1:ContenutoXML)>0&quot;>&#xa;                &lt;tns4:Tokenizzazione>&#xa;                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                &lt;/tns4:Tokenizzazione>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:ZipFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogNotificheToZipFileInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ZipFileInvokeToRepeatOnError5">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($ZipFileInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0 and count($NumeroNotificheGeneriche/ns5:NumeroNotifiche/ns5:IDNotifica) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($ZipFileInvoke.ZipFileOutput/tns:IDFile)) > 0 and count($NumeroNotificheGeneriche/ns5:NumeroNotifiche/ns5:IDNotifica) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Invoke1ToKO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
