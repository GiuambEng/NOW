                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper2-input"
                                    name="Mapper2"
                                    outputVariable="Mapper2"
                                    tibex:xpdlId="833167f1-5db0-42df-aec3-9bf68369a361" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty1ToMapper2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper2ToGenericLogger4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlIntestazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;maskD420&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper2-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:RICHIESTA>&#xa;            &lt;xsl:if test=&quot;exists($ParseXmlIntestazione/ns0:DATI_ACCESSO)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$ParseXmlIntestazione/ns0:DATI_ACCESSO&quot;/>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($ParseXmlIntestazione/ns0:DATI_VC)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$ParseXmlIntestazione/ns0:DATI_VC&quot;/>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($ParseXmlIntestazione/ns0:DATI_REFERENTE)&quot;>&#xa;                &lt;ns0:DATI_REFERENTE>&#xa;                    &lt;xsl:if test=&quot;exists($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1])&quot;>&#xa;                        &lt;ns0:REFERENTE>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:NOME_REF&quot;>&#xa;                                &lt;ns0:NOME_REF>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:NOME_REF&quot;/>&#xa;                                &lt;/ns0:NOME_REF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:COGNOME_REF&quot;>&#xa;                                &lt;ns0:COGNOME_REF>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:COGNOME_REF&quot;/>&#xa;                                &lt;/ns0:COGNOME_REF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($Accumulate/tns1:NumeriTelefonici[1]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:TEL_REF, 'dk')&quot;>&#xa;                                        &lt;ns0:TEL_REF>&#xa;                                            &lt;xsl:value-of select=&quot;$maskD420&quot;/>&#xa;                                        &lt;/ns0:TEL_REF>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Accumulate/tns1:NumeriTelefonici[1]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente&quot;>&#xa;                                            &lt;ns0:TEL_REF>&#xa;                                                &lt;xsl:value-of select=&quot;$Accumulate/tns1:NumeriTelefonici[1]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente&quot;/>&#xa;                                            &lt;/ns0:TEL_REF>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($Accumulate/tns1:NumeriTelefonici[1]/tns1:NumeriTelefonici[1]/tns1:TelefonoMobileReferente)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:MOB_REF, 'dk')&quot;>&#xa;                                        &lt;ns0:MOB_REF>&#xa;                                            &lt;xsl:value-of select=&quot;$maskD420&quot;/>&#xa;                                        &lt;/ns0:MOB_REF>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Accumulate/tns1:NumeriTelefonici[1]/tns1:NumeriTelefonici[1]/tns1:TelefonoMobileReferente&quot;>&#xa;                                            &lt;ns0:MOB_REF>&#xa;                                                &lt;xsl:value-of select=&quot;$Accumulate/tns1:NumeriTelefonici[1]/tns1:NumeriTelefonici[1]/tns1:TelefonoMobileReferente&quot;/>&#xa;                                            &lt;/ns0:MOB_REF>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:DATA_CONTATTO&quot;>&#xa;                                &lt;ns0:DATA_CONTATTO>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:DATA_CONTATTO&quot;/>&#xa;                                &lt;/ns0:DATA_CONTATTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:PROGRESSIVO&quot;>&#xa;                                &lt;ns0:PROGRESSIVO>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:PROGRESSIVO&quot;/>&#xa;                                &lt;/ns0:PROGRESSIVO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns0:REFERENTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2])&quot;>&#xa;                        &lt;ns0:REFERENTE>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:NOME_REF&quot;>&#xa;                                &lt;ns0:NOME_REF>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:NOME_REF&quot;/>&#xa;                                &lt;/ns0:NOME_REF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:COGNOME_REF&quot;>&#xa;                                &lt;ns0:COGNOME_REF>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:COGNOME_REF&quot;/>&#xa;                                &lt;/ns0:COGNOME_REF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($Accumulate/tns1:NumeriTelefonici[2]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:TEL_REF, 'dk')&quot;>&#xa;                                        &lt;ns0:TEL_REF>&#xa;                                            &lt;xsl:value-of select=&quot;$maskD420&quot;/>&#xa;                                        &lt;/ns0:TEL_REF>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Accumulate/tns1:NumeriTelefonici[2]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente&quot;>&#xa;                                            &lt;ns0:TEL_REF>&#xa;                                                &lt;xsl:value-of select=&quot;$Accumulate/tns1:NumeriTelefonici[2]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente&quot;/>&#xa;                                            &lt;/ns0:TEL_REF>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($Accumulate/tns1:NumeriTelefonici[2]/tns1:NumeriTelefonici[1]/tns1:TelefonoMobileReferente)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:MOB_REF, 'dk')&quot;>&#xa;                                        &lt;ns0:MOB_REF>&#xa;                                            &lt;xsl:value-of select=&quot;$maskD420&quot;/>&#xa;                                        &lt;/ns0:MOB_REF>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Accumulate/tns1:NumeriTelefonici[2]/tns1:NumeriTelefonici[1]/tns1:TelefonoMobileReferente&quot;>&#xa;                                            &lt;ns0:MOB_REF>&#xa;                                                &lt;xsl:value-of select=&quot;$Accumulate/tns1:NumeriTelefonici[2]/tns1:NumeriTelefonici[1]/tns1:TelefonoMobileReferente&quot;/>&#xa;                                            &lt;/ns0:MOB_REF>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:DATA_CONTATTO&quot;>&#xa;                                &lt;ns0:DATA_CONTATTO>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:DATA_CONTATTO&quot;/>&#xa;                                &lt;/ns0:DATA_CONTATTO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:PROGRESSIVO&quot;>&#xa;                                &lt;ns0:PROGRESSIVO>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[2]/ns0:PROGRESSIVO&quot;/>&#xa;                                &lt;/ns0:PROGRESSIVO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns0:REFERENTE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[3])&quot;>&#xa;                        &lt;ns0:REFERENTE>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[3]/ns0:NOME_REF&quot;>&#xa;                                &lt;ns0:NOME_REF>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[3]/ns0:NOME_REF&quot;/>&#xa;                                &lt;/ns0:NOME_REF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[3]/ns0:COGNOME_REF&quot;>&#xa;                                &lt;ns0:COGNOME_REF>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[3]/ns0:COGNOME_REF&quot;/>&#xa;                                &lt;/ns0:COGNOME_REF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($Accumulate/tns1:NumeriTelefonici[3]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[3]/ns0:TEL_REF, 'dk')&quot;>&#xa;                                        &lt;ns0:TEL_REF>&#xa;                                            &lt;xsl:value-of select=&quot;$maskD420&quot;/>&#xa;                                        &lt;/ns0:TEL_REF>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Accumulate/tns1:NumeriTelefonici[3]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente&quot;>&#xa;                                            &lt;ns0:TEL_REF>&#xa;                                                &lt;xsl:value-of select=&quot;$Accumulate/tns1:NumeriTelefonici[3]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente&quot;/>&#xa;                                            &lt;/ns0:TEL_REF>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length($Accumulate/tns1:NumeriTelefonici[3]/tns1:NumeriTelefonici[1]/tns1:TelefonoMobileReferente)>0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;starts-with($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[3]/ns0:MOB_REF, 'dk')&quot;>&#xa;                                        &lt;ns0:MOB_REF>&#xa;                                            &lt;xsl:value-of select=&quot;$maskD420&quot;/>&#xa;                                        &lt;/ns0:MOB_REF>&#xa;                                    &lt;/xsl:when>&#xa;                   