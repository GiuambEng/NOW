                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperID-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:IDNotifiche>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns1:IDNotifiche>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBC_ORARIO/Record[number($index)]/ID_NOTF)&quot;/>&#xa;                    &lt;/tns1:IDNotifiche>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:IDNotifiche>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBC_GIORNALIERO/Record[number($index)]/ID_NOTF)&quot;/>&#xa;                    &lt;/tns1:IDNotifiche>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:IDNotifiche>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
