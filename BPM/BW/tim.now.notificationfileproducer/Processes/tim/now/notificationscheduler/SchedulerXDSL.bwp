            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;XDSLSchedulerIn&quot;/>&lt;xsl:param name=&quot;ZipFileInvoke&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LOG_SchedulerXDSLResponse-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerXDSL&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;XDSLSchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;XDSLScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;XDSL Scheduler orario Response: &amp;quot;, tib:render-xml($ZipFileInvoke/ZipFileOutput/tns4:ZipFileResponse,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;XDSL Scheduler giornaliero Response: &amp;quot;, tib:render-xml($ZipFileInvoke/ZipFileOutput/tns4:ZipFileResponse,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;XDSLScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;XDSLScheduler_COMPLETED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;XDSLScheduler_&amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ZipFileInvoke/ZipFileOutput/tns4:ZipFileResponse/tns4:Esito) > 0&quot;>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($ZipFileInvoke/ZipFileOutput/tns4:ZipFileResponse)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($ZipFileInvoke/ZipFileOutput/tns4:ZipFileResponse, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_SchedulerXDSLResponse-input"
                    name="LOG_SchedulerXDSLResponse"
                    outputVariable="LOG_SchedulerNPGResponse"
                    tibex:xpdlId="fa24d8ff-4bb0-4b13-b69a-b9475ce17da1"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnError4ToLOG_SchedulerXDSLResponse"/>
                        <bpws:target linkName="RepeatOnError3ToLOG_SchedulerXDSLResponse"/>
                        <bpws:target linkName="ZipFileInvokeToLOG_SchedulerNGAResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_SchedulerNGAResponseToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;ZipFileInvoke.ZipFileOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_SchedulerXDSLResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SchedulerXDSL&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;XDSLSchedulerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;XDSLScheduler&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;XDSL Scheduler orario Response: &amp;quot;, tib:render-xml($ZipFileInvoke.ZipFileOutput,true(),true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;XDSL Scheduler giornaliero Response: &amp;quot;, tib:render-xml($ZipFileInvoke.ZipFileOutput,true(),true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;XDSLScheduler&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;tns:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                        &lt;/tns:BusinessID>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;XDSLScheduler_COMPLETED&amp;quot;&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;XDSLScheduler_&amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ZipFileInvoke.ZipFileOutput/tns4:Esito) > 0&quot;>&#xa;                        &lt;tns:Playload>&#xa;                            &lt;tns:Binary>&#xa;                                &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($ZipFileInvoke.ZipFileOutput)))&quot;/>&#xa;                            &lt;/tns:Binary>&#xa;                            &lt;tns:XMLString>&#xa;                                &lt;xsl:value-of select=&quot;tib:render-xml($ZipFileInvoke.ZipFileOutput, true(), true())&quot;/>&#xa;                            &lt;/tns:XMLString>&#xa;                        &lt;/tns:Playload>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="Confirm"
                    tibex:xpdlId="e2e30b56-1137-42eb-8ec7-458a9c38eca2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_FileNameToConfirm"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ConfirmToAssign"/>
                        <bpws:source linkName="ConfirmToCallProcess"
                            tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.confirm"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Confirm"/>
                                    <value
                                    confirmEvent="XDSLSchedulerIn" xsi:type="generalactivities:Confirm"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="IsConfirmed"
                    name="IsConfirmedAssign"
                    outputVariable="IsConfirmed"
                    tibex:xpdlId="a027d8d8-20ab-449a-b56c-13124d4c8f61" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ConfirmToAssign"/>
                        <bpws:target linkName="CallProcessToIsConfirmedAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="IsConfirmedAssignToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="IsConfirmed" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="bb9b906c-c0bd-4cf1-b9ae-496cb4550877">
                <bpws:targets>
                    <bpws:target linkName="NumeroNotificheAssign0ToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToIntestazioneNotificheAQAssign"/>
                    <bpws:source linkName="WhileToGenericLogger6"
                        tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+302e36c6-a13b-4f3b-b64d-763a6eb1e484" version="2.0"> <xsl:template name="NotificheErrate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="NotificheErrate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="if ($XDSLSchedulerIn/SchedulerInput/ns5:SchedulerInput/ns5:TempoNotifica = &quot;ORARIO&quot;) then $index &lt;= count($JDBC_ORARIO/Record) else $index &lt;= count($JDBC_GIORNALIERO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[if ($XDSLSchedulerIn.SchedulerInput/ns5:TempoNotifica = "ORARIO") then $index <= count($JDBC_ORARIO/Record) else $index <= count($JDBC_GIORNALIERO/Record)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="ParseXml1ToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="GroupStart1ToAssign5" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="NumeroNotificheAssignToEmpty2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperIDToEmpty3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdate1ToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ParseXmlIntestazioneToMapperID" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="ParseXmlIntestazioneToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCQueryToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLoggerToGetLocalIP" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToGenericLogger1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GenericLogger1ToWhile1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="While1ToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToAssign2" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Assign2ToJDBCUpdate5" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Mapper2ToGenericLogger4" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLogger4ToAssign3" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Assign3ToGenericLogger5" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToMapper2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="GenericLogger5ToAssign6" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty2ToNotificheErrate" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty2ToMapperID" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="Empty3ToJDBCUpdateError" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="Empty3ToNotificheErrate" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="Assign4ToParseXmlIntestazione" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GetLocalIPToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdate5ToThrow1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign5ToAssign4" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Assign6ToNumeroNotificheAssign" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="7e1e479c-2f34-465d-bc19-efbbc9607984">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToAssign5"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="NotificheErrate"
                                    outputVariable="NotificheErrate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="302e36c6-a13b-4f3b-b64d-763a6eb1e484" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCUpdate1ToGroupEnd1"/>
                                    <bpws:target linkName="Empty2ToNotificheErrate"/>
                                    <bpws:target linkName="Empty3ToNotificheErrate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperID</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataParse&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseXmlIntestazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                &lt;tns5:xmlString>&#xa;                    &lt;xsl:value-of select=&quot;concat($TestataNamespace, $TestataParse, substring-after($JDBC_ORARIO/Record[number($index)]/TRACCIATO_FILE, &amp;quot;>&amp;quot;))&quot;/>&#xa;                &lt;/tns5:xmlString>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns5:xmlString>&#xa;                    &lt;xsl:value-of select=&quot;concat($TestataNamespace, $TestataParse, substring-after($JDBC_GIORNALIERO/Record[number($index)]/TRACCIATO_FILE, &amp;quot;>&amp;quot;))&quot;/>&#xa;                &lt;/tns5:xmlString>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ParseXmlIntestazione-input"
                                    name="ParseXmlIntestazione"
                                    outputVariable="ParseXmlIntestazione"
                                    tibex:xpdlId="b0c28fde-b7e8-4139-b577-43b2da8cde71" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign4ToParseXmlIntestazione"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ParseXml1ToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source
                                    linkName="ParseXmlIntestazioneToMapperID"
                                    tibex:faultDetailsVar="ParseXmlIntestazione" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="ParseXmlIntestazioneToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($ParseXmlIntestazione/ns52:DATI_REFERENTE/ns52:REFERENTE[contains(ns52:TEL_REF,'kk') or contains(ns52:MOB_REF, 'kk') or contains(ns52:TEL_REF,'dk') or contains(ns52:MOB_REF, 'dk') or contains(ns52:NOME_REF,'dk') or contains(ns52:COGNOME_REF, 'dk')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($ParseXmlIntestazione/ns52:DATI_REFERENTE/ns52:REFERENTE[contains(ns52:TEL_REF,'kk') or contains(ns52:MOB_REF, 'kk') or contains(ns52:TEL_REF,'dk') or contains(ns52:MOB_REF, 'dk') or contains(ns52:NOME_REF,'dk') or contains(ns52:COGNOME_REF, 'dk')])>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataParse&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseXmlIntestazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                &lt;tns5:xmlString>&#xa;                    &lt;xsl:value-of select=&quot;concat($TestataNamespace, $TestataParse, substring-after($JDBC_ORARIO/Record[number($index)]/TRACCIATO_FILE, &amp;quot;>&amp;quot;))&quot;/>&#xa;                &lt;/tns5:xmlString>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns5:xmlString>&#xa;                    &lt;xsl:value-of select=&quot;concat($TestataNamespace, $TestataParse, substring-after($JDBC_GIORNALIERO/Record[number($index)]/TRACCIATO_FILE, &amp;quot;>&amp;quot;))&quot;/>&#xa;                &lt;/tns5:xmlString>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.parsexml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:order="http://xsd.telecomitalia.it/crm/xdsl/order"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>
                                    <value
                                    inputStyle="text"
                                    outputElementQName="order:RICHIESTA"
                                    validateOutput="true" xsi:type="palettexml:ParseXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:template name=&quot;NumeroNotificheGeneriche&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NumeroNotificheGeneriche>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns1:NumeroNotifiche>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheTotali + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheTotali>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheTotali&quot;/>&#xa;                                &lt;/tns1:NotificheTotali>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OK&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OD&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OR&amp;quot;) and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheOK>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheOK + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheOK>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheOK>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheOK&quot;/>&#xa;                                &lt;/tns1:NotificheOK>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;KO&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RA&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RR&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RS&amp;quot;)  and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns1:NoticheKO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NoticheKO + 1)&quot;/>&#xa;                                &lt;/tns1:NoticheKO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NoticheKO>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NoticheKO&quot;/>&#xa;                                &lt;/tns1:NoticheKO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AC&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SP&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;FS&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;CO&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;KA&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SU&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;NL&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;NP&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SC&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SM&amp;quot;)  and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheIntermedie>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheIntermedie + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheIntermedie>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheIntermedie>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheIntermedie&quot;/>&#xa;                                &lt;/tns1:NotificheIntermedie>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;) and $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheMigrazioni + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheMigrazioni>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheMigrazioni&quot;/>&#xa;                                &lt;/tns1:NotificheMigrazioni>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica&quot;>&#xa;                                    &lt;tns1:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns1:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;tns1:IDNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_ORARIO/Record[number($index)]/ID_NOTF)&quot;/>&#xa;                                &lt;/tns1:IDNotifica>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica&quot;>&#xa;                                    &lt;tns1:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns1:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:NumeroNotifiche>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:NumeroNotifiche>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheTotali + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheTotali>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheTotali&quot;/>&#xa;                                &lt;/tns1:NotificheTotali>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OK&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OD&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OR&amp;quot;) and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheOK>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheOK + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheOK>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheOK>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheOK&quot;/>&#xa;                                &lt;/tns1:NotificheOK>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;KO&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RA&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RR&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RS&amp;quot;) and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns1:NoticheKO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NoticheKO + 1)&quot;/>&#xa;                                &lt;/tns1:NoticheKO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NoticheKO>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NoticheKO&quot;/>&#xa;                                &lt;/tns1:NoticheKO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AC&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SP&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;FS&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;CO&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;KA&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SU&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;NL&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;NP&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SC&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SM&amp;quot;) and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheIntermedie>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheIntermedie + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheIntermedie>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheIntermedie>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheIntermedie&quot;/>&#xa;                                &lt;/tns1:NotificheIntermedie>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE = &amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;) and $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheMigrazioni + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheMigrazioni>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:NotificheMigrazioni&quot;/>&#xa;                                &lt;/tns1:NotificheMigrazioni>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica&quot;>&#xa;                                    &lt;tns1:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns1:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;tns1:IDNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_GIORNALIERO/Record[number($index)]/ID_NOTF)&quot;/>&#xa;                                &lt;/tns1:IDNotifica>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica&quot;>&#xa;                                    &lt;tns1:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns1:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:NumeroNotifiche>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$XDSLSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns1:NumeroNotificheAQ>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheTotali + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheTotali>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheTotali&quot;/>&#xa;                                &lt;/tns1:NotificheTotali>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns1:NotificheOK>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheOK&quot;/>&#xa;                        &lt;/tns1:NotificheOK>&#xa;                        &lt;tns1:NoticheKO>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NoticheKO&quot;/>&#xa;                        &lt;/tns1:NoticheKO>&#xa;                        &lt;tns1:NotificheIntermedie>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheIntermedie&quot;/>&#xa;                        &lt;/tns1:NotificheIntermedie>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;) and $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheMigrazioni + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheMigrazioni>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheMigrazioni&quot;/>&#xa;                                &lt;/tns1:NotificheMigrazioni>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica&quot;>&#xa;                                    &lt;tns1:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns1:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;tns1:IDNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_ORARIO/Record[number($index)]/ID_NOTF)&quot;/>&#xa;                                &lt;/tns1:IDNotifica>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica&quot;>&#xa;                                    &lt;tns1:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns1:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:NumeroNotificheAQ>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:NumeroNotificheAQ>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheTotali + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheTotali>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheTotali&quot;/>&#xa;                                &lt;/tns1:NotificheTotali>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns1:NotificheOK>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheOK&quot;/>&#xa;                        &lt;/tns1:NotificheOK>&#xa;                        &lt;tns1:NoticheKO>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NoticheKO&quot;/>&#xa;                        &lt;/tns1:NoticheKO>&#xa;                        &lt;tns1:NotificheIntermedie>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheIntermedie&quot;/>&#xa;                        &lt;/tns1:NotificheIntermedie>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE = &amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;) and $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns1:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheMigrazioni + 1)&quot;/>&#xa;                                &lt;/tns1:NotificheMigrazioni>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:NotificheMigrazioni&quot;/>&#xa;                                &lt;/tns1:NotificheMigrazioni>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica&quot;>&#xa;                                    &lt;tns1:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns1:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;tns1:IDNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_GIORNALIERO/Record[number($index)]/ID_NOTF)&quot;/>&#xa;                                &lt;/tns1:IDNotifica>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica&quot;>&#xa;                                    &lt;tns1:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns1:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:NumeroNotificheAQ>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:NumeroNotificheGeneriche>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
