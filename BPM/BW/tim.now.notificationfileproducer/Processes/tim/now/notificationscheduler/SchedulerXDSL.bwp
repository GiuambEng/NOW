                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;XDSLSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:param name=&quot;TagFileVuoto&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;Namespace&quot;/>&#xa;    &lt;xsl:param name=&quot;CodaNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:param name=&quot;Intestazione&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;IntestAQRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;IntestRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:template name=&quot;ContenutoFile&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ContenutoFile>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns1:NumeroNotifiche/tns1:IDNotifica) > 0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($ContenutoXML/tns1:ContenutoXML)>0&quot;>&#xa;                                    &lt;tns2:ContenutoFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_ORARIO/Record[COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;,tib:concat-sequence-format($ContenutoXML/tns1:ContenutoXML/tns1:ContenutoXML, &amp;quot;&amp;#xA;&amp;quot;),&amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                                    &lt;/tns2:ContenutoFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:ContenutoFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_ORARIO/Record[COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                                    &lt;/tns2:ContenutoFile>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($ContenutoXML/tns1:ContenutoXML)>0&quot;>&#xa;                                    &lt;tns2:ContenutoFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_GIORNALIERO/Record[COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;,tib:concat-sequence-format($ContenutoXML/tns1:ContenutoXML/tns1:ContenutoXML, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                                    &lt;/tns2:ContenutoFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:ContenutoFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_GIORNALIERO/Record[COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                                    &lt;/tns2:ContenutoFile>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:ContenutoFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $TagFileVuoto, &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                    &lt;/tns2:ContenutoFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns1:NumeroNotificheAQ/tns1:IDNotifica) > 0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$XDSLSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;tns2:ContenutoFileAQ>&#xa;                                &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestAQRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_ORARIO/Record[COD_TIPOLG_NOTF =&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                            &lt;/tns2:ContenutoFileAQ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:ContenutoFileAQ>&#xa;                                &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestAQRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_GIORNALIERO/Record[COD_TIPOLG_NOTF =&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                            &lt;/tns2:ContenutoFileAQ>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:ContenutoFileAQ>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestAQRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $TagFileVuoto, &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                    &lt;/tns2:ContenutoFileAQ>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ContenutoFile>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
