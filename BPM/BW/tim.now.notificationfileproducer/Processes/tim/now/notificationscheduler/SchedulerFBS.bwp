                      &lt;xsl:value-of select=&quot;$JDBC_GIORNALIERO/Record[$index]/CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns11:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODICEORDINEOLO&quot;>&#xa;                    &lt;tns11:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                    &lt;/tns11:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns11:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'VALNOTF'&quot;/>&#xa;                &lt;/tns11:Funzione>&#xa;                &lt;tns11:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($JDBCQuery/Record[1]/CODICEORDINEOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns11:ChiaveRiferimento>&#xa;                &lt;tns11:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns11:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns22:IPAddress&quot;>&#xa;                    &lt;tns11:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns22:IPAddress&quot;/>&#xa;                    &lt;/tns11:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente)>0 and contains($Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente,'kk')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;>&#xa;                            &lt;tns11:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper1/tns1:NumeriTelefonici[$inde