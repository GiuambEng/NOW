                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+97132554-610f-4f88-933e-11c64e99dfe2+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FBSSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_GIORNALIERO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'FIBERSTREAM'&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;CodiceOLOAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAccorpante>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutScheduler"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement=" SELECT NOTF.COD_TIPOLG_NOTF, NOTF.ID_NOTF, NOTF.ID_RICH_OLO, STRUTTURA_RICH, NOTF.TIMSTP_CREAZIONE, NOTF.TRACCIATO_FILE, NOTF.CODFC_OLO_NOW, NOTF.CODFC_OLO_AGCOM,NGA_GPON&#xa;  FROM RICH_ORDN_COMUNIC_NOTF NOTF, OLO OLO&#xa;  WHERE STRUTTURA_RICH = ? AND IDTPLG_STNTF_FLGIORN = '1' AND NOTF.CODFC_OLO_AGCOM = OLO.CODFC_OLO_AGCOM&#xa;  AND (OLO.CODFC_OLO_AGCOM = ? OR OLO.COD_OLO_ACCORPANTE = ?) AND TRUNC(NOTF.TIMSTP_CREAZIONE) &lt; SYSDATE - 1 ORDER BY CODFC_OLO_AGCOM ASC, ID_RICH_OLO ASC, TIMSTP_CREAZIONE ASC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="StrutturaRichiesta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLOAccorpante"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_TIPOLG_NOTF"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="ID_NOTF"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="ID_RICH_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="STRUTTURA_RICH"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="TRACCIATO_FILE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="CODFC_OLO_NOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="8"
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="9"
                                    columnName="NGA_GPON"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+696599a4-3789-4277-aaf6-e676ea05a867+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FBSSchedulerIn&quot;/>&lt;xsl:template name=&quot;JDBC_ORARIO-input&quot; match=&quot;/&quot;>&lt;tns6:jdbcQueryActivityInput>&lt;StrutturaRichiesta>&lt;xsl:value-of select=&quot;'FIBERSTREAM'&quot;/>&lt;/StrutturaRichiesta>&lt;CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&lt;/CodiceOLOAGCOM>&lt;CodiceOLOAccorpante>&lt;xsl:value-of select=&quot;$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&lt;/CodiceOLOAccorpante>&lt;/tns6:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
