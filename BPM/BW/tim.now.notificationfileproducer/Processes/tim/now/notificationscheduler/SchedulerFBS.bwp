te&quot;/>&lt;/TelefonoReferenteContattato>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Token/tns11:ResponseDecode_token/tns11:N_Recap_Cliente_ALT&quot;>&lt;TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$Token/tns11:ResponseDecode_token/tns11:N_Recap_Cliente_ALT&quot;/>&lt;/TelefonoReferenteContattato>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ParseXml/DataAppuntamento/DataContatto&quot;>&lt;DataContatto>&lt;xsl:value-of select=&quot;$ParseXml/DataAppuntamento/DataContatto&quot;/>&lt;/DataContatto>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/DataAppuntamento/OraContatto&quot;>&lt;OraContatto>&lt;xsl:value-of select=&quot;$ParseXml/DataAppuntamento/OraContatto&quot;/>&lt;/OraContatto>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/DataAppuntamento/TipoAppuntamento&quot;>&lt;TipoAppuntamento>&lt;xsl:value-of select=&quot;$ParseXml/DataAppuntamento/TipoAppuntamento&quot;/>&lt;/TipoAppuntamento>&lt;/xsl:if>&lt;/DataAppuntamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TentativiContatto>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;$ParseXml/TentativiContatto/CognomeReferente[1]&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;string-length($ParseXml/TentativiContatto/NomeReferente[1])>0&quot;>&lt;xsl:if test=&quot;$ParseXml/TentativiContatto/NomeReferente[1]&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;$ParseXml/TentativiContatto/NomeReferente[1]&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Accumulate/tns1:NumeriTelefonici[1]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente)>0&quot;>&lt;xsl:if test=&quot;$Accumulate/tns1:NumeriTelefonici[1]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Accumulate/tns1:NumeriTelefonici[1]/tns1:NumeriTelefonici[1]/tns1:TelefonoFissoReferente&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Accumulate/tns1:Numeri