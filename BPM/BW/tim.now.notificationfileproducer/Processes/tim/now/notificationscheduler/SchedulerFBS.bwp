            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns22=&quot;http://www.tim.com/NOW/xsd/FileNotificaMancante&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;FBSSchedulerIn&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNotificaMancante-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns22:FileNotificaMancanteRequest>&#xa;            &lt;tns22:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica&quot;/>&#xa;            &lt;/tns22:TempoNotifica>&#xa;            &lt;tns22:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns22:StrutturaRichiesta>&#xa;            &lt;tns22:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-after-last($FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns22:FileName>&#xa;            &lt;tns22:PathFile>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-before-last($FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns22:PathFile>&#xa;            &lt;tns22:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns22:CodiceOLO>&#xa;            &lt;tns22:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns22:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:FlagNamespaceFileNotifica&quot;>&#xa;                &lt;tns22:FlagNamespaceFileNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:FlagNamespaceFileNotifica&quot;/>&#xa;                &lt;/tns22:FlagNamespaceFileNotifica>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns22:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns22:ProcessIstanceID>&#xa;        &lt;/tns22:FileNotificaMancanteRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="FileNotificaMancante-input"
                    name="FileNotificaMancante"
                    tibex:xpdlId="6295aeea-f1d6-4171-ab0c-f9afba69499d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IsConfermedAssignToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FileNotificaMancanteToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns22=&quot;http://www.tim.com/NOW/xsd/FileNotificaMancante&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;FBSSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNotificaMancante-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns22:FileNotificaMancanteRequest>&#xa;            &lt;tns22:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:TempoNotifica&quot;/>&#xa;            &lt;/tns22:TempoNotifica>&#xa;            &lt;tns22:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns22:StrutturaRichiesta>&#xa;            &lt;tns22:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-after-last($FileNameInvoke.FileNameOutput/tns2:FileName, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns22:FileName>&#xa;            &lt;tns22:PathFile>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-before-last($FileNameInvoke.FileNameOutput/tns2:FileName, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns22:PathFile>&#xa;            &lt;tns22:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns22:CodiceOLO>&#xa;            &lt;tns22:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns22:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$FBSSchedulerIn.SchedulerInput/tns1:FlagNamespaceFileNotifica&quot;>&#xa;                &lt;tns22:FlagNamespaceFileNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:FlagNamespaceFileNotifica&quot;/>&#xa;                &lt;/tns22:FlagNamespaceFileNotifica>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns22:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns22:ProcessIstanceID>&#xa;        &lt;/tns22:FileNotificaMancanteRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess spawn="true"
                        subProcessName="tim.now.notificationscheduler.util.FileNotificaMancante" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
