            <bpws:invoke inputVariable="ZipFileInvoke-input"
                name="ZipFileInvoke" operation="ZipFile"
                outputVariable="ZipFileInvoke"
                partnerLink="ZipFilePortType"
                portType="ns37:ZipFilePortType" tibex:xpdlId="95fcc956-dba8-40dd-b886-21194a33c83d">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/xsd/WriteFile" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns15="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="IDTipologiaFile"/&gt;&lt;xsl:param name="WriteFile"/&gt;&lt;xsl:param name="CreateFile"/&gt;&lt;xsl:param name="JDBC_ORARIO"/&gt;&lt;xsl:param name="JDBC_GIORNALIERO"/&gt;&lt;xsl:param name="_processContext"/&gt;&lt;xsl:param name="ContenutoXML"/&gt;&lt;xsl:param name="NotificheErrate"/&gt;&lt;xsl:param name="FBSSchedulerIn"/&gt;&lt;xsl:param name="FBSInterfacciaIdOrario"/&gt;&lt;xsl:param name="FBSIDProcsoFileInvio"/&gt;&lt;xsl:template name="ZipFileInvoke-input" match="/"&gt;&lt;tns15:ZipFileRequest&gt;&lt;ZipFileInput&gt;&lt;tns4:ZipFileRequest&gt;&lt;xsl:variable name="var" select="$ContenutoXML/tns1:ContenutoXML/tns1:IDNotifica"/&gt;&lt;xsl:variable name="NotificheErrate" select="$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche"/&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($WriteFile)"&gt;&lt;tns4:FullName&gt;&lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fullName)"/&gt;&lt;/tns4:FullName&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:FullName&gt;&lt;xsl:value-of select="tib:trim($CreateFile/fileInfo/fullName)"/&gt;&lt;/tns4:FullName&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($WriteFile)"&gt;&lt;tns4:FileName&gt;&lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fileName)"/&gt;&lt;/tns4:FileName&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:FileName&gt;&lt;xsl:value-of select="tib:trim($CreateFile/fileInfo/fileName)"/&gt;&lt;/tns4:FileName&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($WriteFile)"&gt;&lt;tns4:Size&gt;&lt;xsl:value-of select="xsd:int($WriteFile/fileInfo/size)"/&gt;&lt;/tns4:Size&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:Size&gt;&lt;xsl:value-of select="xsd:int($CreateFile/fileInfo/size)"/&gt;&lt;/tns4:Size&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns4:CodiceOLO&gt;&lt;xsl:value-of select="$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO"/&gt;&lt;/tns4:CodiceOLO&gt;&lt;tns4:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM"/&gt;&lt;/tns4:CodiceOLOAGCOM&gt;&lt;tns4:StrutturaRichiesta&gt;&lt;xsl:value-of select="$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta"/&gt;&lt;/tns4:StrutturaRichiesta&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($WriteFile)"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FBSSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns4:NumeroRecord&gt;&lt;xsl:value-of select="xsd:int(count($JDBC_ORARIO/Record[not(xsd:int(ID_NOTF) = $NotificheErrate)])+count($JDBC_ORARIO/Record[xsd:int(ID_NOTF) = $var]))"/&gt;&lt;/tns4:NumeroRecord&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:NumeroRecord&gt;&lt;xsl:value-of select="xsd:int(count($JDBC_GIORNALIERO/Record[not(xsd:int(ID_NOTF) = $NotificheErrate)])+count($JDBC_GIORNALIERO/Record[xsd:int(ID_NOTF) = $var]))"/&gt;&lt;/tns4:NumeroRecord&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns4:NumeroRecord&gt;&lt;xsl:value-of select="0"/&gt;&lt;/tns4:NumeroRecord&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns4:IDInterfaccia&gt;&lt;xsl:value-of select="$FBSInterfacciaIdOrario"/&gt;&lt;/tns4:IDInterfaccia&gt;&lt;tns4:IDTipologiaFile&gt;&lt;xsl:value-of select="$IDTipologiaFile"/&gt;&lt;/tns4:IDTipologiaFile&gt;&lt;tns4:IDProcsoFile&gt;&lt;xsl:value-of select="$FBSIDProcsoFileInvio"/&gt;&lt;/tns4:IDProcsoFile&gt;&lt;tns4:ProcessIstanceID&gt;&lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;&lt;/tns4:ProcessIstanceID&gt;&lt;xsl:if test="count($ContenutoXML/tns1:ContenutoXML)&gt;0"&gt;&lt;tns4:Tokenizzazione&gt;&lt;xsl:value-of select="'SI'"/&gt;&lt;/tns4:Tokenizzazione&gt;&lt;/xsl:if&gt;&lt;/tns4:ZipFileRequest&gt;&lt;/ZipFileInput&gt;&lt;/tns15:ZipFileRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns15=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FBSSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateFile&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:param name=&quot;FBSInterfacciaIdOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;FBSIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ZipFileRequest>&#xa;            &lt;xsl:variable name=&quot;var&quot; select=&quot;$ContenutoXML/tns1:ContenutoXML/tns1:IDNotifica&quot;/>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns4:FullName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fullName)&quot;/>&#xa;                    &lt;/tns4:FullName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:FullName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($CreateFile/fileInfo/fullName)&quot;/>&#xa;                    &lt;/tns4:FullName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns4:FileName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fileName)&quot;/>&#xa;                    &lt;/tns4:FileName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:FileName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($CreateFile/fileInfo/fileName)&quot;/>&#xa;                    &lt;/tns4:FileName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns4:Size>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($WriteFile/fileInfo/size)&quot;/>&#xa;                    &lt;/tns4:Size>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:Size>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($CreateFile/fileInfo/size)&quot;/>&#xa;                    &lt;/tns4:Size>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns4:CodiceOLO>&#xa;            &lt;tns4:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns4:CodiceOLOAGCOM>&#xa;            &lt;tns4:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$FBSSchedulerIn.SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns4:StrutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FBSSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;tns4:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($JDBC_ORARIO/Record[not(xsd:int(ID_NOTF) = $NotificheErrate)])+count($JDBC_ORARIO/Record[xsd:int(ID_NOTF) = $var]))&quot;/>&#xa;                            &lt;/tns4:NumeroRecord>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($JDBC_GIORNALIERO/Record[not(xsd:int(ID_NOTF) = $NotificheErrate)])+count($JDBC_GIORNALIERO/Record[xsd:int(ID_NOTF) = $var]))&quot;/>&#xa;                            &lt;/tns4:NumeroRecord>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/tns4:NumeroRecord>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:IDInterfaccia>&#xa;                &lt;xsl:value-of select=&quot;$FBSInterfacciaIdOrario&quot;/>&#xa;            &lt;/tns4:IDInterfaccia>&#xa;            &lt;tns4:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns4:IDTipologiaFile>&#xa;            &lt;tns4:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$FBSIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns4:IDProcsoFile>&#xa;            &lt;tns4:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns4:ProcessIstanceID>&#xa;            &lt;xsl:if test=&quot;count($ContenutoXML/tns1:ContenutoXML)>0&quot;>&#xa;                &lt;tns4:Tokenizzazione>&#xa;                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                &lt;/tns4:Tokenizzazione>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:ZipFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogNotificheToZipFileInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ZipFileInvokeToRepeatOnError2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($ZipFileInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0 and exists($WriteFile)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($ZipFileInvoke.ZipFileOutput/tns:IDFile)) > 0 and exists($WriteFile)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileInvokeToKO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileInvokeToLOG_SchedulerRegolatorioResponse">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($ZipFileInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0 and exists($WriteFile) = false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(string($ZipFileInvoke.ZipFileOutput/tns:IDFile)) > 0 and exists($WriteFile) = false()]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source
                        linkName="ZipFileInvokeToGenericLogger16"
                        tibex:faultDetailsVar="ZipFileInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Notifiche-input"
                    name="LOG_Notifiche"
                    tibex:xpdlId="babe0977-afa8-4464-a07d-20507eaa6385"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WriteFileToLogNotifiche"/>
                        <bpws:target linkName="CreateFileToLogNotifiche"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogNotificheToZipFileInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
