            <bpws:scope name="RepeatOnError" tibex:group="repeatOnError"
                tibex:indexToGlobal="false" tibex:xpdlId="edb085ad-484d-4d6c-8217-c513a295313e">
                <bpws:targets>
                    <bpws:target linkName="RepeatOnError2ToRepeatOnError"/>
                    <bpws:target linkName="KOToRepeatOnError"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatOnErrorToLOG_SchedulerRegolatorioResponse"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="repeatOnError_success_flag"
                        sca-bpel:internal="true" type="xsd:boolean"/>
                    <bpws:variable name="FaultName1"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns0:FaultDetail"
                        name="FaultDetails" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:scope name="innerScope">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails" tibex:faultNameVar="FaultName1">
                                <bpws:if name="if">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index >$NumeroRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index >$NumeroRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign name="Assign" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                </bpws:if>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStart1ToJDBC_CAMBIO_STATO_ORARIO_INVIATA" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="JDBC_CAMBIO_STATO_ORARIO_INVIATAToJDBCUpdate3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStart1ToSleep2" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="Sleep2ToJDBC_CAMBIO_STATO_ORARIO_INVIATA" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdate3ToGenericLogger10" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLogger10ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="1559e640-af0a-4f79-af9c-d626ae3779e2">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBC_CAMBIO_STATO_ORARIO_INVIATA">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToSleep2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index > 1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index > 1]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:assign name="GroupEnd"
                                tibex:group="groupEnd"
                                tibex:xpdlId="bb774fdf-6abb-4671-b93c-d9766dbfb9f1" validate="no">
                                <bpws:targets>
                                    <bpws:target linkName="GenericLogger10ToGroupEnd"/>
                                </bpws:targets>
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns18=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0e4220a2-0ec3-46cc-a38f-f15f48cc9422+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&lt;xsl:param name=&quot;ZipFileInvoke&quot;/>&lt;xsl:param name=&quot;NotificheErrate&quot;/>&lt;xsl:template name=&quot;JDBC_CAMBIO_STATO_ORARIO_INVIATA-input&quot; match=&quot;/&quot;>&lt;tns18:jdbcUpdateActivityInput>&lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche&quot;/>&lt;xsl:for-each select=&quot;$JDBC_ORARIO/Record[not(xsd:int(ID_NOTF) = $NotificheErrate)]&quot;>&lt;Record>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($ZipFileInvoke/ZipFileOutput/tns4:ZipFileResponse/tns4:IDFile)) > 0&quot;>&lt;StatoNotifica>&lt;xsl:value-of select=&quot;&amp;quot;INVIATA&amp;quot;&quot;/>&lt;/StatoNotifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;StatoNotifica>&lt;xsl:value-of select=&quot;&amp;quot;ERRORE&amp;quot;&quot;/>&lt;/StatoNotifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDNotifica>&lt;xsl:value-of select=&quot;xsd:int(ID_NOTF)&quot;/>&lt;/IDNotifica>&lt;/Record>&lt;/xsl:for-each>&lt;/tns18:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBC_CAMBIO_STATO_ORARIO_INVIATA-input"
                                    name="JDBC_CAMBIO_STATO_ORARIO_INVIATA"
                                    outputVariable="JDBC_CAMBIO_STATO_ORARIO_INVIATA"
                                    tibex:xpdlId="0e4220a2-0ec3-46cc-a38f-f15f48cc9422" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToJDBC_CAMBIO_STATO_ORARIO_INVIATA"/>
                                    <bpws:target linkName="Sleep2ToJDBC_CAMBIO_STATO_ORARIO_INVIATA"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBC_CAMBIO_STATO_ORARIO_INVIATAToJDBCUpdate3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns18=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0e4220a2-0ec3-46cc-a38f-f15f48cc9422+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileInvoke.ZipFileOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_CAMBIO_STATO_ORARIO_INVIATA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns18:jdbcUpdateActivityInput>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche&quot;/>&#xa;            &lt;xsl:for-each select=&quot;$JDBC_ORARIO/Record[not(xsd:int(ID_NOTF) = $NotificheErrate)]&quot;>&#xa;                &lt;Record>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(string($ZipFileInvoke.ZipFileOutput/tns4:IDFile)) > 0&quot;>&#xa;                            &lt;StatoNotifica>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/StatoNotifica>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;StatoNotifica>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ERRORE&amp;quot;&quot;/>&#xa;                            &lt;/StatoNotifica>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;IDNotifica>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ID_NOTF)&quot;/>&#xa;                    &lt;/IDNotifica>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns18:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutScheduler"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
