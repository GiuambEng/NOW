                                    sqlStatement="INSERT INTO ASSOCTV_NOTFC_NON_INV_SECOLO&#xa;(ID_NOTF,FLAG_ERR_SECOLO,PROCESSO_NOTIFICA,NOME_FILE_NOTIFICA,DATA_ORA_FILE_NOTIFICA,TIMESTAMP_INS)&#xa;VALUES&#xa;(?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

