            <bpws:invoke inputVariable="ZipFileInvoke-input"
                name="ZipFileInvoke" operation="ZipFile"
                outputVariable="ZipFileInvoke"
                partnerLink="ZipFilePortType"
                portType="ns37:ZipFilePortType" tibex:xpdlId="95fcc956-dba8-40dd-b886-21194a33c83d">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/xsd/WriteFile" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="IDTipologiaFile"/&gt;
    &lt;xsl:param name="RegolatorioSchedulerMIGIn"/&gt;
    &lt;xsl:param name="WriteFile"/&gt;
    &lt;xsl:param name="CreateFile"/&gt;
    &lt;xsl:param name="JDBC_ORARIO"/&gt;
    &lt;xsl:param name="JDBC_GIORNALIERO"/&gt;
    &lt;xsl:param name="REG_MIGInterfacciaIDOrario"/&gt;
    &lt;xsl:param name="REG_MIGInterfacciaIDGiornaliero"/&gt;
    &lt;xsl:param name="REG_MIGIDProcsoFileInvio"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:template name="ZipFileInvoke-input" match="/"&gt;
        &lt;tns5:ZipFileRequest&gt;
            &lt;ZipFileInput&gt;
                &lt;tns3:ZipFileRequest&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile)"&gt;
                            &lt;tns3:FullName&gt;
                                &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fullName)"/&gt;
                            &lt;/tns3:FullName&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns3:FullName&gt;
                                &lt;xsl:value-of select="tib:trim($CreateFile/fileInfo/fullName)"/&gt;
                            &lt;/tns3:FullName&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile)"&gt;
                            &lt;tns3:FileName&gt;
                                &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fileName)"/&gt;
                            &lt;/tns3:FileName&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns3:FileName&gt;
                                &lt;xsl:value-of select="tib:trim($CreateFile/fileInfo/fileName)"/&gt;
                            &lt;/tns3:FileName&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile)"&gt;
                            &lt;tns3:Size&gt;
                                &lt;xsl:value-of select="xsd:int($WriteFile/fileInfo/size)"/&gt;
                            &lt;/tns3:Size&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns3:Size&gt;
                                &lt;xsl:value-of select="xsd:int($CreateFile/fileInfo/size)"/&gt;
                            &lt;/tns3:Size&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns3:CodiceOLO&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO"/&gt;
                    &lt;/tns3:CodiceOLO&gt;
                    &lt;tns3:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM"/&gt;
                    &lt;/tns3:CodiceOLOAGCOM&gt;
                    &lt;tns3:StrutturaRichiesta&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta"/&gt;
                    &lt;/tns3:StrutturaRichiesta&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile)"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;
                                    &lt;tns3:NumeroRecord&gt;
                                        &lt;xsl:value-of select="xsd:int(count($JDBC_ORARIO/Record))"/&gt;
                                    &lt;/tns3:NumeroRecord&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns3:NumeroRecord&gt;
                                        &lt;xsl:value-of select="xsd:int(count($JDBC_GIORNALIERO/Record))"/&gt;
                                    &lt;/tns3:NumeroRecord&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns3:NumeroRecord&gt;
                                &lt;xsl:value-of select="0"/&gt;
                            &lt;/tns3:NumeroRecord&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;
                            &lt;tns3:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$REG_MIGInterfacciaIDOrario"/&gt;
                            &lt;/tns3:IDInterfaccia&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns3:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$REG_MIGInterfacciaIDGiornaliero"/&gt;
                            &lt;/tns3:IDInterfaccia&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns3:IDTipologiaFile&gt;
                        &lt;xsl:value-of select="$IDTipologiaFile"/&gt;
                    &lt;/tns3:IDTipologiaFile&gt;
                    &lt;tns3:IDProcsoFile&gt;
                        &lt;xsl:value-of select="$REG_MIGIDProcsoFileInvio"/&gt;
                    &lt;/tns3:IDProcsoFile&gt;
                    &lt;tns3:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns3:ProcessIstanceID&gt;
                &lt;/tns3:ZipFileRequest&gt;
            &lt;/ZipFileInput&gt;
        &lt;/tns5:ZipFileRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerMIGIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateFile&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;REG_MIGInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;REG_MIGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;REG_MIGIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ZipFileRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns3:FullName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fullName)&quot;/>&#xa;                    &lt;/tns3:FullName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:FullName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($CreateFile/fileInfo/fullName)&quot;/>&#xa;                    &lt;/tns3:FullName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns3:FileName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fileName)&quot;/>&#xa;                    &lt;/tns3:FileName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:FileName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($CreateFile/fileInfo/fileName)&quot;/>&#xa;                    &lt;/tns3:FileName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns3:Size>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($WriteFile/fileInfo/size)&quot;/>&#xa;                    &lt;/tns3:Size>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:Size>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($CreateFile/fileInfo/size)&quot;/>&#xa;                    &lt;/tns3:Size>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns3:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn.SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns3:CodiceOLO>&#xa;            &lt;tns3:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns3:CodiceOLOAGCOM>&#xa;            &lt;tns3:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn.SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns3:StrutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$RegolatorioSchedulerMIGIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;tns3:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($JDBC_ORARIO/Record))&quot;/>&#xa;                            &lt;/tns3:NumeroRecord>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns3:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($JDBC_GIORNALIERO/Record))&quot;/>&#xa;                            &lt;/tns3:NumeroRecord>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/tns3:NumeroRecord>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RegolatorioSchedulerMIGIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns3:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$REG_MIGInterfacciaIDOrario&quot;/>&#xa;                    &lt;/tns3:IDInterfaccia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$REG_MIGInterfacciaIDGiornaliero&quot;/>&#xa;                    &lt;/tns3:IDInterfaccia>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns3:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns3:IDTipologiaFile>&#xa;            &lt;tns3:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$REG_MIGIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns3:IDProcsoFile>&#xa;            &lt;tns3:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns3:ProcessIstanceID>&#xa;        &lt;/tns3:ZipFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
