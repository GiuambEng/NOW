            <bpws:invoke inputVariable="FileNameInvoke-input"
                name="FileNameInvoke" operation="FileName"
                outputVariable="FileNameInvoke" partnerLink="FileName"
                portType="ns21:FileNamePortType" tibex:xpdlId="884a857a-cddd-49dc-949c-10ac960f3d24">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/FileName/" xmlns:tns2="http://www.tim.com/NOW/xsd/FileName" version="2.0"&gt;
    &lt;xsl:param name="RegolatorioSchedulerMIGIn"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:template name="FileNameInvoke-input" match="/"&gt;
        &lt;tns5:FileNameRequest&gt;
            &lt;FileNameInput&gt;
                &lt;tns2:FileNameRequest&gt;
                    &lt;tns2:TempoNotifica&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica"/&gt;
                    &lt;/tns2:TempoNotifica&gt;
                    &lt;tns2:StrutturaRichiesta&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta"/&gt;
                    &lt;/tns2:StrutturaRichiesta&gt;
                    &lt;tns2:Lavorazione&gt;
                        &lt;xsl:value-of select="&amp;quot;MIGRAZIONE&amp;quot;"/&gt;
                    &lt;/tns2:Lavorazione&gt;
                    &lt;tns2:CodiceOLO&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO"/&gt;
                    &lt;/tns2:CodiceOLO&gt;
                    &lt;tns2:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM"/&gt;
                    &lt;/tns2:CodiceOLOAGCOM&gt;
                    &lt;tns2:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns2:ProcessIstanceID&gt;
                &lt;/tns2:FileNameRequest&gt;
            &lt;/FileNameInput&gt;
        &lt;/tns5:FileNameRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/FileName/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerMIGIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNameInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:FileNameRequest>&#xa;            &lt;tns2:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn.SchedulerInput/tns1:TempoNotifica&quot;/>&#xa;            &lt;/tns2:TempoNotifica>&#xa;            &lt;tns2:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn.SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns2:StrutturaRichiesta>&#xa;            &lt;tns2:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Lavorazione>&#xa;            &lt;tns2:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn.SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns2:CodiceOLO>&#xa;            &lt;tns2:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns2:CodiceOLOAGCOM>&#xa;            &lt;tns2:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns2:ProcessIstanceID>&#xa;        &lt;/tns2:FileNameRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LOG_NotificationInformationToFileNameInvoke"/>
                    <bpws:target linkName="LOG_NessunaNotificaToFileNameInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToLOG_FileNamee"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:empty name="KO" tibex:xpdlId="a90482bd-1dd3-4639-9865-25ca57ebff82">
                <bpws:targets>
                    <bpws:target linkName="ZipFileInvokeToKO"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="KOToRepeatOnError">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RegolatorioSchedulerMIGIn/SchedulerInput/ns5:SchedulerInput/ns5:TempoNotifica = &quot;ORARIO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$RegolatorioSchedulerMIGIn.SchedulerInput/ns5:TempoNotifica = "ORARIO"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="KOToRepeatOnError2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;ZipFileInvoke&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;RegolatorioSchedulerMIGIn&quot;/>&lt;xsl:template name=&quot;LOG_SchedulerRegolatorioResponse-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorioMIG&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioMIGSchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioMIGScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Scheduler Regolatorio MIG orario Response: &amp;quot;, tib:render-xml($ZipFileInvoke/ZipFileOutput/tns3:ZipFileResponse,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Scheduler Regolatorio MIG giornaliero Response: &amp;quot;, tib:render-xml($ZipFileInvoke/ZipFileOutput/tns3:ZipFileResponse,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioMIGScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioMIGScheduler_COMPLETED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;RegolatorioMIGScheduler_&amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ZipFileInvoke/ZipFileOutput/tns3:ZipFileResponse/tns3:Esito) > 0&quot;>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($ZipFileInvoke/ZipFileOutput/tns3:ZipFileResponse)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($ZipFileInvoke/ZipFileOutput/tns3:ZipFileResponse, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_SchedulerRegolatorioResponse-input"
                    name="LOG_SchedulerRegolatorioResponse"
                    tibex:xpdlId="03af40c7-d89f-4e31-8e89-0711ed6d4254"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnErrorToLOG_SchedulerRegolatorioResponse"/>
