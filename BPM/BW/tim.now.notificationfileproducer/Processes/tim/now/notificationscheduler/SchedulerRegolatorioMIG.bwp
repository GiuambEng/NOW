            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="a1eed3a0-1dde-4f01-9010-f5a1c495f748">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToWriteFile">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="(count($JDBC_ORARIO/Record) > 0 or count($JDBC_GIORNALIERO/Record) > 0) and (count($JDBC_ORARIO/Record) > count($NotificheErrate/ns5:IDNotifiche) or count($JDBC_GIORNALIERO/Record) > count($NotificheErrate/ns5:IDNotifiche))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[(count($JDBC_ORARIO/Record) > 0 or count($JDBC_GIORNALIERO/Record) > 0) and (count($JDBC_ORARIO/Record) > count($NotificheErrate/ns5:IDNotifiche) or count($JDBC_GIORNALIERO/Record) > count($NotificheErrate/ns5:IDNotifiche))]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="WhileToCreateFile">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+37b28cde-c24d-4197-a1c1-7f6cf8c43ffe" version="2.0"> <xsl:template name="NotificheErrate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="NotificheErrate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="if($RegolatorioSchedulerMIGIn/SchedulerInput/ns5:SchedulerInput/ns5:TempoNotifica = &quot;ORARIO&quot;) then $index &lt; count($JDBC_ORARIO/Record) else $index &lt; count($JDBC_GIORNALIERO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[if($RegolatorioSchedulerMIGIn.SchedulerInput/ns5:TempoNotifica = "ORARIO") then $index < count($JDBC_ORARIO/Record) else $index < count($JDBC_GIORNALIERO/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="MapperToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToParseXml" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdateErroreToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ParseXmlToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ParseXmlToMapperID" tibex:linkType="ERROR"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="61a414c7-161f-4729-8295-b45e5a903f29">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToParseXml"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="NotificheErrate"
                                    outputVariable="NotificheErrate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="37b28cde-c24d-4197-a1c1-7f6cf8c43ffe" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateErroreToGroupEnd"/>
                                    <bpws:target linkName="ParseXmlToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperID</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
