                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE RICH_ORDN_COMUNIC_NOTF&#xa;SET IDTPLG_STNTF_FLMENS = (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?),&#xa;&#x9;IDTPLG_STNTF_FLGIORN = (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), &#xa;&#x9;IDTPLG_STNTF_FILE_ORARIO = (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?)&#xa;WHERE ID_NOTF = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="StatoNotificaMM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="StatoNotificaRG"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="StatoNotificaHH"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDNotifica"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/FileNotificaMancante&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerMIGIn&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNotificaMancante-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:FileNotificaMancanteRequest>&#xa;            &lt;tns5:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica&quot;/>&#xa;            &lt;/tns5:TempoNotifica>&#xa;            &lt;tns5:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns5:StrutturaRichiesta>&#xa;            &lt;tns5:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns5:Lavorazione>&#xa;            &lt;tns5:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-after-last($FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns5:FileName>&#xa;            &lt;tns5:PathFile>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-before-last($FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns5:PathFile>&#xa;            &lt;tns5:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns5:CodiceOLO>&#xa;            &lt;tns5:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns5:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:FlagNamespaceFileNotifica&quot;>&#xa;                &lt;tns5:FlagNamespaceFileNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$RegolatorioSchedulerMIGIn/SchedulerInput/tns1:SchedulerInput/tns1:FlagNamespaceFileNotifica&quot;/>&#xa;                &lt;/tns5:FlagNamespaceFileNotifica>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns5:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns5:ProcessIstanceID>&#xa;        &lt;/tns5:FileNotificaMancanteRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="FileNotificaMancante-input"
                    name="FileNotificaMancante"
