                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;NamespaceNPR1&quot;/>&#xa;    &lt;xsl:param name=&quot;CodaNamespaceNPR1&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO_NPR&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:WriteActivityInputTextClass>&#xa;            &lt;xsl:if test=&quot;$FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName&quot;>&#xa;                &lt;fileName>&#xa;                    &lt;xsl:value-of select=&quot;$FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName&quot;/>&#xa;                &lt;/fileName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche&quot;/>&#xa;            &lt;textContent>&#xa;                &lt;xsl:value-of select=&quot;concat($TestataNamespace, $NamespaceNPR1, tib:concat-sequence-format($JDBC_ORARIO_NPR/Record[not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespaceNPR1)&quot;/>&#xa;            &lt;/textContent>&#xa;        &lt;/tns4:WriteActivityInputTextClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="WriteFile-input"
                                name="WriteFile"
                                outputVariable="WriteFile"
                                tibex:xpdlId="f0807d83-24a5-42a6-8e5c-341bf6d7d1fb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
