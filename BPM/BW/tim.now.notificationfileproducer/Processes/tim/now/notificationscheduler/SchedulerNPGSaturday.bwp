                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/xsd/WriteFile" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="IDTipologiaFile"/&gt;
    &lt;xsl:param name="WriteFile"/&gt;
    &lt;xsl:param name="NPSaturdaySchedulerIn"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="JDBC_ORARIO_NPR"/&gt;
    &lt;xsl:param name="NPRInterfacciaIDOrari"/&gt;
    &lt;xsl:param name="NPRIDProcsoFileInvio"/&gt;
    &lt;xsl:template name="ZipFileInvoke-input" match="/"&gt;
        &lt;tns4:ZipFileRequest&gt;
            &lt;ZipFileInput&gt;
                &lt;tns3:ZipFileRequest&gt;
                    &lt;tns3:FullName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fullName)"/&gt;
                    &lt;/tns3:FullName&gt;
                    &lt;tns3:FileName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fileName)"/&gt;
                    &lt;/tns3:FileName&gt;
                    &lt;tns3:Size&gt;
                        &lt;xsl:value-of select="xsd:int($WriteFile/fileInfo/size)"/&gt;
                    &lt;/tns3:Size&gt;
                    &lt;tns3:CodiceOLO&gt;
                        &lt;xsl:value-of select="$NPSaturdaySchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO"/&gt;
                    &lt;/tns3:CodiceOLO&gt;
                    &lt;tns3:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$NPSaturdaySchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM"/&gt;
                    &lt;/tns3:CodiceOLOAGCOM&gt;
                    &lt;tns3:StrutturaRichiesta&gt;
                        &lt;xsl:value-of select="$NPSaturdaySchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta"/&gt;
                    &lt;/tns3:StrutturaRichiesta&gt;
                    &lt;tns3:NumeroRecord&gt;
                        &lt;xsl:value-of select="xsd:int(count($JDBC_ORARIO_NPR/Record))"/&gt;
                    &lt;/tns3:NumeroRecord&gt;
                    &lt;tns3:IDInterfaccia&gt;
                        &lt;xsl:value-of select="$NPRInterfacciaIDOrari"/&gt;
                    &lt;/tns3:IDInterfaccia&gt;
                    &lt;tns3:IDTipologiaFile&gt;
                        &lt;xsl:value-of select="$IDTipologiaFile"/&gt;
                    &lt;/tns3:IDTipologiaFile&gt;
                    &lt;tns3:IDProcsoFile&gt;
                        &lt;xsl:value-of select="$NPRIDProcsoFileInvio"/&gt;
                    &lt;/tns3:IDProcsoFile&gt;
                    &lt;tns3:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns3:ProcessIstanceID&gt;
                &lt;/tns3:ZipFileRequest&gt;
            &lt;/ZipFileInput&gt;
        &lt;/tns4:ZipFileRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NPSaturdaySchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO_NPR&quot;/>&#xa;    &lt;xsl:param name=&quot;NPRInterfacciaIDOrari&quot;/>&#xa;    &lt;xsl:param name=&quot;NPRIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ZipFileRequest>&#xa;            &lt;tns3:FullName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fullName)&quot;/>&#xa;            &lt;/tns3:FullName>&#xa;            &lt;tns3:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fileName)&quot;/>&#xa;            &lt;/tns3:FileName>&#xa;            &lt;tns3:Size>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($WriteFile/fileInfo/size)&quot;/>&#xa;            &lt;/tns3:Size>&#xa;            &lt;tns3:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$NPSaturdaySchedulerIn.SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns3:CodiceOLO>&#xa;            &lt;tns3:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$NPSaturdaySchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns3:CodiceOLOAGCOM>&#xa;            &lt;tns3:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$NPSaturdaySchedulerIn.SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns3:StrutturaRichiesta>&#xa;            &lt;tns3:NumeroRecord>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(count($JDBC_ORARIO_NPR/Record))&quot;/>&#xa;            &lt;/tns3:NumeroRecord>&#xa;            &lt;tns3:IDInterfaccia>&#xa;                &lt;xsl:value-of select=&quot;$NPRInterfacciaIDOrari&quot;/>&#xa;            &lt;/tns3:IDInterfaccia>&#xa;            &lt;tns3:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns3:IDTipologiaFile>&#xa;            &lt;tns3:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$NPRIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns3:IDProcsoFile>&#xa;            &lt;tns3:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns3:ProcessIstanceID>&#xa;        &lt;/tns3:ZipFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
