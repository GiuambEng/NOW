                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a47d56cc-454d-4604-ad9d-fd5d28ab7be2+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NPSaturdaySchedulerIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_ORARIO_NPR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$NPSaturdaySchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;CodiceOLOAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$NPSaturdaySchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAccorpante>&#xa;            &lt;CodiceNotificaTC5>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;TC5&amp;quot;&quot;/>&#xa;            &lt;/CodiceNotificaTC5>&#xa;            &lt;CodiceNotificaTC6>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;TC6&amp;quot;&quot;/>&#xa;            &lt;/CodiceNotificaTC6>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="JDBC_ORARIO_NPR-input"
                                name="JDBC_ORARIO_NPR"
                                outputVariable="JDBC_ORARIO_NPR"
                                tibex:xpdlId="a47d56cc-454d-4604-ad9d-fd5d28ab7be2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToJDBC_ORARIO_NPR"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="JDBC_ORARIO_NPRToLOG_NotificationInformation">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($JDBC_ORARIO_NPR/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($JDBC_ORARIO_NPR/Record) > 0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JDBC_ORARIO_NPRToLOG_NessunaNotifica">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a47d56cc-454d-4604-ad9d-fd5d28ab7be2+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NPSaturdaySchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_ORARIO_NPR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$NPSaturdaySchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;CodiceOLOAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$NPSaturdaySchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAccorpante>&#xa;            &lt;CodiceNotificaTC5>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;TC5&amp;quot;&quot;/>&#xa;            &lt;/CodiceNotificaTC5>&#xa;            &lt;CodiceNotificaTC6>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;TC6&amp;quot;&quot;/>&#xa;            &lt;/CodiceNotificaTC6>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutScheduler"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOTF.COD_TIPOLG_NOTF, NOTF.ID_NOTF, NOTF.ID_RICH_OLO, STRUTTURA_RICH, NOTF.TIMSTP_CREAZIONE, NOTF.TRACCIATO_FILE, NOTF.CODFC_OLO_NOW, NOTF.CODFC_OLO_AGCOM&#xa;FROM RICH_ORDN_COMUNIC_NOTF NOTF, OLO OLO&#xa;WHERE STRUTTURA_RICH = ? AND IDTPLG_STNTF_FILE_ORARIO = '1' AND NOTF.CODFC_OLO_AGCOM = OLO.CODFC_OLO_AGCOM&#xa;AND (OLO.CODFC_OLO_AGCOM = ? OR OLO.COD_OLO_ACCORPANTE = ?)&#xa;AND (COD_TIPOLG_NOTF = ? OR COD_TIPOLG_NOTF = ?)&#xa;AND NOTF.FLAG_NP103 is null&#xa;AND TIMSTP_CREAZIONE &lt; TRUNC(SYSTIMESTAMP) + NUMTODSINTERVAL(18, 'HOUR') + NUMTODSINTERVAL(44, 'MINUTE')&#xa;ORDER BY CODFC_OLO_AGCOM ASC, ID_RICH_OLO ASC, TIMSTP_CREAZIONE ASC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="StrutturaRichiesta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLOAccorpante"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceNotificaTC5"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceNotificaTC6"/>
                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_NOTF"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STRUTTURA_RICH"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TRACCIATO_FILE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_NOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="JDBCUpdate-input"
                                name="JDBCUpdate"
                                outputVariable="JDBCUpdate"
                                tibex:xpdlId="bd88b405-209c-4640-be5d-a9d1d1e2bb9e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="JDBC_ORARIO_NPRToLOG_NotificationInformation"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToLOG_NotificationInformation"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bd88b405-209c-4640-be5d-a9d1d1e2bb9e+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO_NPR&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$JDBC_ORARIO_NPR/Record&quot;>&#xa;                &lt;Record>&#xa;                    &lt;STNTF>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN INVIO&amp;quot;&quot;/>&#xa;                    &lt;/STNTF>&#xa;                    &lt;ID_NOTF>&#xa;                        &lt;xsl:value-of select=&quot;ID_NOTF&quot;/>&#xa;                    &lt;/ID_NOTF>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutScheduler"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE RICH_ORDN_COMUNIC_NOTF&#xa;SET IDTPLG_STNTF_FILE_ORARIO = (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?)&#xa;WHERE ID_NOTF = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STNTF"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_NOTF"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="3228dd2f-c96e-4924-9d7f-c0b266974bdc">
                            <bpws:targets>
                                <bpws:target linkName="IsConfermedAssignToWhile"/>
                                <bpws:target linkName="LOG_FileNameToWhile1"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="WhileToWriteFile">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($JDBC_ORARIO_NPR/Record) > 0 and count($JDBC_ORARIO_NPR/Record) > count($MapperID/ns5:IDNotifiche)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($JDBC_ORARIO_NPR/Record) > 0 and count($JDBC_ORARIO_NPR/Record) > count($MapperID/ns5:IDNotifiche)]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="WhileToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                            <bpws:variables>
                                <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                </bpws:variable>
                            </bpws:variables>
