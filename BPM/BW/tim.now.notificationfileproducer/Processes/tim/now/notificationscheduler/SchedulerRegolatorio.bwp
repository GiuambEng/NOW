                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="TransformXml-input"
                                    name="TransformXml"
                                    outputVariable="TransformXml"
                                    tibex:xpdlId="ef900784-9f71-4623-9749-647d28555e22" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderXmlToTransformXml"/>
