            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;Namespace&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;CodaNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:WriteActivityInputTextClass>&#xa;            &lt;xsl:if test=&quot;$FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName&quot;>&#xa;                &lt;fileName>&#xa;                    &lt;xsl:value-of select=&quot;$FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName&quot;/>&#xa;                &lt;/fileName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;textContent>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, tib:concat-sequence-format($JDBC_ORARIO/Record[not(ID_NOTF