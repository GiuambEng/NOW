xsl:copy-of select=&quot;$ParseXml/NotificaWLR[1]/Accettazione/CodiciSTS&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/Accettazione>&#xa;                    &lt;/NotificaWLR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseXml/NotificaWLR/StatoAvanzamento)&quot;>&#xa;                    &lt;NotificaWLR>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseXml/NotificaWLR/TestataNotifica&quot;/>&#xa;                        &lt;StatoAvanzamento>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/DN&quot;>&#xa;                                &lt;DN>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/DN&quot;/>&#xa;                                &lt;/DN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/DataValidazioneFormaleContrattuale&quot;>&#xa;                                &lt;DataValidazioneFormaleContrattuale>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/DataValidazioneFormaleContrattuale&quot;/>&#xa;                                &lt;/DataValidazioneFormaleContrattuale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/DataValidazioneTecnicoGestionale&quot;>&#xa;                                &lt;DataValidazioneTecnicoGestionale>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/DataValidazioneTecnicoGestionale&quot;/>&#xa;                                &lt;/DataValidazioneTecnicoGestionale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/DataEspletamento&quot;>&#xa;                                &lt;DataEspletamento>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/DataEspletamento&quot;/>&#xa;                                &lt;/DataEspletamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/OrarioDataEspletamento&quot;>&#xa;                                &lt;OrarioDataEspletamento>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/OrarioDataEspletamento&quot;/>&#xa;                                &lt;/OrarioDataEspletamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/NuovaDAC&quot;>&#xa;                                &lt;NuovaDAC>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/NuovaDAC&quot;/>&#xa;                                &lt;/NuovaDAC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ParseXml/NotificaWLR[1]/StatoAvanzamento/Rifiuto)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseXml/NotificaWLR/StatoAvanzamento/Rifiuto&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Note&quot;>&#xa;                                &lt;Note>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Note&quot;/>&#xa;                                &lt;/Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente)&quot;>&#xa;                                &lt;Referente>&#xa;                                    &lt;QualificaRef>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/QualificaRef&quot;/>&#xa;                                    &lt;/QualificaRef>&#xa;                                    &lt;CognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/CognomeReferente&quot;/>&#xa;                                    &lt;/CognomeReferente>&#xa;                                    &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/NomeReferente&quot;>&#xa;                                        &lt;NomeReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/NomeReferente&quot;/>&#xa;                                        &lt;/NomeReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;not(exists($Token/tns5:ResponseDecode_token)) and starts-with($ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/TelefonoFissoReferente, 'dk')&quot;>&#xa;                                            &lt;TelefonoFissoReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$maskD420&quot;/>&#xa;                                            &lt;/TelefonoFissoReferente>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente&quot;>&#xa;                                                &lt;TelefonoFissoReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente&quot;/>&#xa;                                                &lt;/TelefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;not(exists($Token/tns5:ResponseDecode_token)) and starts-with($ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/TelefonoMobileReferente, 'dk')&quot;>&#xa;                                            &lt;TelefonoMobileReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$maskD420&quot;/>&#xa;                                            &lt;/TelefonoMobileReferente>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente_ALT)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente_ALT&quot;>&#xa;                                                &lt;TelefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente_ALT&quot;/>&#xa;                                                &lt;/TelefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/Progressivo&quot;>&#xa;                                        &lt;Progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/Progressivo&quot;/>&#xa;                                        &lt;/Progressivo>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/Referente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:for-each select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/NumerazioneAggiuntiva&quot;>&#xa;                                &lt;NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                &lt;/NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/StatoAvanzamento>&#xa;                    &lt;/NotificaWLR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NotificaWLR>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseXml/NotificaWLR/TestataNotifica&quot;/>&#xa;                        &lt;DataAppuntamento>&#xa;                            &lt;NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/NuovaDA&quot;/>&#xa;                            &lt;/NuovaDA>&#xa;                            &lt;OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/OraAppuntamento&quot;/>&#xa;                            &lt;/OraAppuntamento>&#xa;                            &lt;ReferenteContattato>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/ReferenteContattato&quot;/>&#xa;                            &lt;/ReferenteContattato>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;not(exists($Token/tns5:ResponseDecode_token)) and starts-with($ParseXml/NotificaWLR[1]/DataAppuntamento/TelefonoReferenteContattato, 'dk')&quot;>&#xa;                                    &lt;TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$maskD420&quot;/>&#xa;                                    &lt;/TelefonoReferenteContattato>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente)>0 and string-length($Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente_ALT)>0&quot;>&#xa;                                    &lt;TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente&quot;/>&#xa;                                    &lt;/TelefonoReferenteContattato>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente)>0&quot;>&#xa;                                    &lt;TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente&quot;/>&#xa;                                    &lt;/TelefonoReferenteContattato>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$Token/tns5:ResponseDecode_token/tns5:N_Recap_Cliente_ALT&quot;/>&#xa;                                    &lt;/TelefonoReferenteContattato>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;DataContatto>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/DataContatto&quot;/>&#xa;                            &lt;/DataContatto>&#xa;                            &lt;OraContatto>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/OraContatto&quot;/>&#xa;                            &lt;/OraContatto>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/TipoAppuntamento&quot;>&#xa;                                &lt;TipoAppuntamento>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/TipoAppuntamento&quot;/>&#xa;                                &lt;/TipoAppuntamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/Progressivo&quot;>&#xa;                                &lt;Progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/Progressivo&quot;/>&#xa;                                &lt;/Progressivo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/DataAppuntamento>&#xa;                    &lt;/NotificaWLR>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NotificaOloRegolatorio" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="GenericLogger-input"
                                    name="GenericLogger"
                                    tibex:xpdlId="bfde1dfb-e2a2-4b6d-b72a-a2fc49c960e9"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLoggerToRenderXml">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($Mapper/NotificaULL)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($Mapper/NotificaULL)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLoggerToRenderXml1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($Mapper/NotificaSLU)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($Mapper/NotificaSLU)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLoggerToRenderXml2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorio&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioSchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Notifica senza token', tib:render-xml($Mapper, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RenderULL-input"
                                    name="RenderULL"
                                    outputVariable="RenderULL"
                                    tibex:xpdlId="bcaccc20-c9e1-4022-ac20-946e7f8a2724" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLoggerToRenderXml"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderXmlToTransformXml"/>
                                    <bpws:source
                                    linkName="RenderULLToGenericLogger1"
                                    tibex:faultDetailsVar="RenderULL" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Mapper/NotificaULL&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.renderxml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="NotificaULL"
                                    outputStyle="text"
                                    validateInput="true" xsi:type="palettexml:RenderXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
