                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="Confirm"
                    tibex:xpdlId="19f484d2-a2fc-4bc2-b270-4e62697bd77e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_FileNameeToWhile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ConfirmToAssign"/>
                        <bpws:source linkName="ConfirmToCallProcess"
                            tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.confirm"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Confirm"/>
                                    <value
                                    confirmEvent="RegolatorioSchedulerIn" xsi:type="generalactivities:Confirm"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="IsConfermed"
                    name="IsConfermedAssign"
                    outputVariable="IsConfermed"
                    tibex:xpdlId="9fa62549-1125-4bd4-ae01-afb48564012b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ConfirmToAssign"/>
                        <bpws:target linkName="CallProcessToIsConfermedAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="IsConfermedAssignToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="IsConfermed" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="ZipFileInvoke-input"
                name="ZipFileInvoke" operation="ZipFile"
                outputVariable="ZipFileInvoke"
                partnerLink="ZipFilePortType"
                portType="ns37:ZipFilePortType" tibex:xpdlId="95fcc956-dba8-40dd-b886-21194a33c83d">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/xsd/WriteFile" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="REGInterfacciaIDOrario"/&gt;
    &lt;xsl:param name="REGInterfacciaIDGiornaliero"/&gt;
    &lt;xsl:param name="IDTipologiaFile"/&gt;
    &lt;xsl:param name="RegolatorioSchedulerIn"/&gt;
    &lt;xsl:param name="REGIDProcsoFileInvio"/&gt;
    &lt;xsl:param name="WriteFile"/&gt;
    &lt;xsl:param name="CreateFile"/&gt;
    &lt;xsl:param name="JDBC_ORARIO"/&gt;
    &lt;xsl:param name="JDBC_GIORNALIERO"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="ContenutoXML"/&gt;
    &lt;xsl:param name="NotificheErrate"/&gt;
    &lt;xsl:template name="ZipFileInvoke-input" match="/"&gt;
        &lt;tns5:ZipFileRequest&gt;
            &lt;ZipFileInput&gt;
                &lt;tns4:ZipFileRequest&gt;
                    &lt;xsl:variable name="var" select="$ContenutoXML/tns1:ContenutoXML/tns1:IDNotifica"/&gt;
                    &lt;xsl:variable name="NotificheErrate" select="$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile)"&gt;
                            &lt;tns4:FullName&gt;
                                &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fullName)"/&gt;
                            &lt;/tns4:FullName&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:FullName&gt;
                                &lt;xsl:value-of select="tib:trim($CreateFile/fileInfo/fullName)"/&gt;
                            &lt;/tns4:FullName&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile)"&gt;
                            &lt;tns4:FileName&gt;
                                &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fileName)"/&gt;
                            &lt;/tns4:FileName&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:FileName&gt;
                                &lt;xsl:value-of select="tib:trim($CreateFile/fileInfo/fileName)"/&gt;
                            &lt;/tns4:FileName&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile)"&gt;
                            &lt;tns4:Size&gt;
                                &lt;xsl:value-of select="xsd:int($WriteFile/fileInfo/size)"/&gt;
                            &lt;/tns4:Size&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:Size&gt;
                                &lt;xsl:value-of select="xsd:int($CreateFile/fileInfo/size)"/&gt;
                            &lt;/tns4:Size&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns4:CodiceOLO&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO"/&gt;
                    &lt;/tns4:CodiceOLO&gt;
                    &lt;tns4:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM"/&gt;
                    &lt;/tns4:CodiceOLOAGCOM&gt;
                    &lt;tns4:StrutturaRichiesta&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta"/&gt;
                    &lt;/tns4:StrutturaRichiesta&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile)"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;
                                    &lt;tns4:NumeroRecord&gt;
                                        &lt;xsl:value-of select="xsd:int(count($JDBC_ORARIO/Record[not(ID_NOTF = $NotificheErrate)])+count($JDBC_ORARIO/Record[xsd:int(ID_NOTF) = $var]))"/&gt;
                                    &lt;/tns4:NumeroRecord&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns4:NumeroRecord&gt;
                                        &lt;xsl:value-of select="xsd:int(count($JDBC_GIORNALIERO/Record[not(ID_NOTF = $NotificheErrate)])+count($JDBC_GIORNALIERO/Record[xsd:int(ID_NOTF) = $var]))"/&gt;
                                    &lt;/tns4:NumeroRecord&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:NumeroRecord&gt;
                                &lt;xsl:value-of select="0"/&gt;
                            &lt;/tns4:NumeroRecord&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;
                            &lt;tns4:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$REGInterfacciaIDOrario"/&gt;
                            &lt;/tns4:IDInterfaccia&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$REGInterfacciaIDGiornaliero"/&gt;
                            &lt;/tns4:IDInterfaccia&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns4:IDTipologiaFile&gt;
                        &lt;xsl:value-of select="$IDTipologiaFile"/&gt;
                    &lt;/tns4:IDTipologiaFile&gt;
                    &lt;tns4:IDProcsoFile&gt;
                        &lt;xsl:value-of select="$REGIDProcsoFileInvio"/&gt;
                    &lt;/tns4:IDProcsoFile&gt;
                    &lt;tns4:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns4:ProcessIstanceID&gt;
                    &lt;xsl:if test="count($ContenutoXML/tns1:ContenutoXML)&gt;0"&gt;
                        &lt;tns4:Tokenizzazione&gt;
                            &lt;xsl:value-of select="'SI'"/&gt;
                        &lt;/tns4:Tokenizzazione&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns4:ZipFileRequest&gt;
            &lt;/ZipFileInput&gt;
        &lt;/tns5:ZipFileRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;REGIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateFile&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ZipFileRequest>&#xa;            &lt;xsl:variable name=&quot;var&quot; select=&quot;$ContenutoXML/tns1:ContenutoXML/tns1:IDNotifica&quot;/>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns4:FullName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fullName)&quot;/>&#xa;                    &lt;/tns4:FullName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:FullName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($CreateFile/fileInfo/fullName)&quot;/>&#xa;                    &lt;/tns4:FullName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns4:FileName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fileName)&quot;/>&#xa;                    &lt;/tns4:FileName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:FileName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($CreateFile/fileInfo/fileName)&quot;/>&#xa;                    &lt;/tns4:FileName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns4:Size>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($WriteFile/fileInfo/size)&quot;/>&#xa;                    &lt;/tns4:Size>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:Size>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($CreateFile/fileInfo/size)&quot;/>&#xa;                    &lt;/tns4:Size>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns4:CodiceOLO>&#xa;            &lt;tns4:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns4:CodiceOLOAGCOM>&#xa;            &lt;tns4:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns4:StrutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;tns4:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($JDBC_ORARIO/Record[not(ID_NOTF = $NotificheErrate)])+count($JDBC_ORARIO/Record[xsd:int(ID_NOTF) = $var]))&quot;/>&#xa;                            &lt;/tns4:NumeroRecord>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($JDBC_GIORNALIERO/Record[not(ID_NOTF = $NotificheErrate)])+count($JDBC_GIORNALIERO/Record[xsd:int(ID_NOTF) = $var]))&quot;/>&#xa;                            &lt;/tns4:NumeroRecord>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/tns4:NumeroRecord>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns4:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$REGInterfacciaIDOrario&quot;/>&#xa;                    &lt;/tns4:IDInterfaccia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$REGInterfacciaIDGiornaliero&quot;/>&#xa;                    &lt;/tns4:IDInterfaccia>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns4:IDTipologiaFile>&#xa;            &lt;tns4:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$REGIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns4:IDProcsoFile>&#xa;            &lt;tns4:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns4:ProcessIstanceID>&#xa;            &lt;xsl:if test=&quot;count($ContenutoXML/tns1:ContenutoXML)>0&quot;>&#xa;                &lt;tns4:Tokenizzazione>&#xa;                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                &lt;/tns4:Tokenizzazione>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:ZipFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogNotificheToZipFileInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ZipFileInvokeToRepeatOnError2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($ZipFileInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0 and exists($WriteFile)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($ZipFileInvoke.ZipFileOutput/tns:IDFile)) > 0 and exists($WriteFile)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileInvokeToKO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileInvokeToLOG_SchedulerRegolatorioResponse">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($ZipFileInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0 and exists($WriteFile) = false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($ZipFileInvoke.ZipFileOutput/tns:IDFile)) > 0 and exists($WriteFile) = false()]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source
                        linkName="ZipFileInvokeToGenericLogger16"
                        tibex:faultDetailsVar="ZipFileInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Notifiche-input"
                    name="LOG_Notifiche"
                    tibex:xpdlId="babe0977-afa8-4464-a07d-20507eaa6385"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WriteFileToLogNotifiche"/>
                        <bpws:target linkName="CreateFileToLogNotifiche"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogNotificheToZipFileInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;WriteFile&quot;/>&lt;xsl:template name=&quot;LOG_Notifiche-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorio&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioSchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($WriteFile)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Creato file di notifica.&amp;quot;&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Creato file di notifica vuoto.&amp;quot;&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorio&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioSchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RegolatorioScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Avvio Scheduler Regolatorio: &amp;quot;, tib:render-xml($RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_Input-input" name="LOG_Input"
                    tibex:xpdlId="a7763d93-a9a2-41b7-9c48-4db393c3445d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
