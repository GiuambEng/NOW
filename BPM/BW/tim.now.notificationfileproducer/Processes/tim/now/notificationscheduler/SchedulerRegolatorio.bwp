      &lt;xsl:value-of select=&quot;$ParseXml/NotificaULL[1]/Accettazione/Referente/TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns6:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ParseXml/NotificaULL[1]/DataAppuntamento/TelefonoReferenteContattato)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/NotificaULL[1]/DataAppuntamento/TelefonoReferenteContattato&quot;>&#xa;                            &lt;tns6:Token>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaULL[1]/DataAppuntamento/TelefonoReferenteContattato&quot;/>&#xa;                            &lt;/tns6:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ParseXml/NotificaSLU[1]/DataAppuntamento/TelefonoReferenteContattato)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/DataAppuntamento/TelefonoReferenteContattato&quot;>&#xa;                            &lt;tns6:Token>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/DataAppuntamento/TelefonoReferenteContattato&quot;/>&#xa;                            &lt;/tns6:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ParseXml/NotificaWLR[1]/Accettazione/Referente/TelefonoFissoReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/Accettazione/Referente/TelefonoFissoReferente&quot;>&#xa;                            &lt;tns6:Token>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/Accettazione/Referente/TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns6:Token>&#xa;                        &lt;/xsl:if>&#xa;                  