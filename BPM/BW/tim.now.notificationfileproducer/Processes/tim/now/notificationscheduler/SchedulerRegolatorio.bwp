                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/FileNotificaMancante&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNotificaMancante-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:FileNotificaMancanteRequest>&#xa;            &lt;tns5:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica&quot;/>&#xa;            &lt;/tns5:TempoNotifica>&#xa;            &lt;tns5:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns5:StrutturaRichiesta>&#xa;            &lt;tns5:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-after-last($FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns5:FileName>&#xa;            &lt;tns5:PathFile>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-before-last($FileNameInvoke/FileNameOutput/tns2:FileNameResponse/tns2:FileName, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns5:PathFile>&#xa;            &lt;tns5:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns5:CodiceOLO>&#xa;            &lt;tns5:CodiceOLOAGCOM>&#xa;                &lt;xs