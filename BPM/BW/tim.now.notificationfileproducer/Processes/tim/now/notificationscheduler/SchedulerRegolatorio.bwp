                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper1&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Request>&#xa;            &lt;tns6:RequestDecode_token>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$JDBC_ORARIO/Record[$index]/CODFC_OLO_AGCOM&quot;>&#xa;                            &lt;tns6:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_ORARIO/Record[$index]/CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns6:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$JDBC_GIORNALIERO/Record[$index]/CODFC_OLO_AGCOM&quot;>&#xa;                            &lt;tns6:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_GIORNALIERO/Record[$index]/CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns6:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODICEORDINEOLO&quot;>&#xa;                    &lt;tns6:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                    &lt;/tns6:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns6:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'VALNOTF'&quot;/>&#xa;                &lt;/tns6:Funzione>&#xa;                &lt;tns6:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($JDBCQuery/Record[1]/CODICEORDINEOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns6:ChiaveRiferimento>&#xa;                &lt;tns6:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns6:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns5:IPAddress&quot;>&#xa;                    &lt;tns6:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns5:IPAddress&quot;/>&#xa;                    &lt;/tns6:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente)>0 and contains($Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente,'kk')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;>&#xa;                            &lt;tns6:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns6:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;>&#xa;                            &lt;tns6:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns6:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns6:RequestDecode_token>&#xa;            &lt;tns6:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns6:ProcessIstance>&#xa;        &lt;/tns6:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
