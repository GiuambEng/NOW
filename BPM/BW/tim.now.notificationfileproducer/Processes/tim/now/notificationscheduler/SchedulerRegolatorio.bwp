                              &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/Accettazione/Referente/Progressivo&quot;/>&#xa;                                        &lt;/Progressivo>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/Referente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/Accettazione/NuovoDN&quot;>&#xa;                                &lt;NuovoDN>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/Accettazione/NuovoDN&quot;/>&#xa;                                &lt;/NuovoDN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/Accettazione/Note&quot;>&#xa;                                &lt;Note>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/Accettazione/Note&quot;/>&#xa;                                &lt;/Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:for-each select=&quot;$ParseXml/NotificaWLR[1]/Accettazione/NumerazioneAggiuntiva&quot;>&#xa;                                &lt;NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                &lt;/NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/Accettazione/DataEstrazioneWL&quot;>&#xa;                                &lt;DataEstrazioneWL>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/Accettazione/DataEstrazioneWL&quot;/>&#xa;                                &lt;/DataEstrazioneWL>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/Accettazione/CodicePiattaforma&quot;>&#xa;   