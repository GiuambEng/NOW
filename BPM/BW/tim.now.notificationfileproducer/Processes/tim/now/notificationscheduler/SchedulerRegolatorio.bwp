                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WriteFileToLogNotifiche"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;Namespace&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;CodaNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:WriteActivityInputTextClass>&#xa;            &lt;xsl:if test=&quot;$FileNameInvoke.FileNameOutput/tns2:FileName&quot;>&#xa;                &lt;fileName>&#xa;                    &lt;xsl:value-of select=&quot;$FileNameInvoke.FileNameOutput/tns2:FileName&quot;/>&#xa;                &lt;/fileName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns1:IDNotifiche/tns1:IDNotifiche&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;textContent>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, tib:concat-sequence-format($JDBC_ORARIO/Record[not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;),&amp;quot;&amp;#xA;&amp;quot;,  tib:concat-sequence-format($ContenutoXML/tns1:ContenutoXML/tns1:ContenutoXML, &amp;quot;&amp;#xA;&amp;quot;),&amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                    &lt;/textContent>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;textContent>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, $Namespace, tib:concat-sequence-format($JDBC_GIORNALIERO/Record[not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;),&amp;quot;&amp;#xA;&amp;quot;,tib:concat-sequence-format($ContenutoXML/tns1:ContenutoXML/tns1:ContenutoXML, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                    &lt;/textContent>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns5:WriteActivityInputTextClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.write"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//WriteFile"/>
                                    <value append="true"
                                    compressFile="None"
                                    createMissingDirectories="true"
                                    encoding="text" xsi:type="file:WriteFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
