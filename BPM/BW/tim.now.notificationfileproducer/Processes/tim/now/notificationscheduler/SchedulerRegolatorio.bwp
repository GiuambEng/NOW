                       &lt;xsl:if test=&quot;$Token1/tns5:ResponseDecode_token/tns5:N_Recap_Cliente_ALT&quot;>&#xa;                            &lt;tns1:TelefonoMobileReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Token1/tns5:ResponseDecode_token/tns5:N_Recap_Cliente_ALT&quot;/>&#xa;                            &lt;/tns1:TelefonoMobileReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;>&#xa;                            &lt;tns1:TelefonoMobileReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper1/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns1:TelefonoMobileReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns1:NumeriTelefonici>&#xa;        &lt;/tns1:NumeriTelefonici>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
