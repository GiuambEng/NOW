            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+97132554-610f-4f88-933e-11c64e99dfe2+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_GIORNALIERO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;CodiceOLOAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAccorpante>&#xa;            &lt;Lavorazione1>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/Lavorazione1>&#xa;            &lt;Lavorazione2>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/Lavorazione2>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_GIORNALIERO-input"
                    name="JDBC_GIORNALIERO"
                    outputVariable="JDBC_GIORNALIERO"
                    tibex:xpdlId="97132554-610f-4f88-933e-11c64e99dfe2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBC_GIORNALIERO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLOG_NessunaNotifica">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBC_GIORNALIEROToJDBCUpdate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBC_GIORNALIERO/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($JDBC_GIORNALIERO/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+97132554-610f-4f88-933e-11c64e99dfe2+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_GIORNALIERO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;CodiceOLOAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAccorpante>&#xa;            &lt;Lavorazione1>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/Lavorazione1>&#xa;            &lt;Lavorazione2>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/Lavorazione2>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutScheduler"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOTF.COD_TIPOLG_NOTF, NOTF.ID_NOTF, NOTF.ID_RICH_OLO, STRUTTURA_RICH, NOTF.TIMSTP_CREAZIONE, NOTF.TRACCIATO_FILE, NOTF.CODFC_OLO_NOW, NOTF.CODFC_OLO_AGCOM&#xa;  FROM RICH_ORDN_COMUNIC_NOTF NOTF, OLO OLO&#xa;  WHERE STRUTTURA_RICH = ? AND IDTPLG_STNTF_FLGIORN = '1' AND NOTF.CODFC_OLO_AGCOM = OLO.CODFC_OLO_AGCOM&#xa;  AND (OLO.CODFC_OLO_AGCOM = ? OR OLO.COD_OLO_ACCORPANTE = ?) AND (LAVORAZIONE IS NULL OR (LAVORAZIONE != ? AND LAVORAZIONE != ?)) AND TRUNC(NOTF.TIMSTP_CREAZIONE) &lt; SYSDATE - 1 ORDER BY CODFC_OLO_AGCOM ASC, ID_RICH_OLO ASC, TIMSTP_CREAZIONE ASC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="StrutturaRichiesta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLOAccorpante"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione2"/>
                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_NOTF"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STRUTTURA_RICH"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TRACCIATO_FILE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_NOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;ZipFileInvoke&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&lt;xsl:template name=&quot;LOG_SchedulerRegolatorioResponse-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorioCPS&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CPSSchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;CPSScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;REGOLATORIO Scheduler orario Response: &amp;quot;, tib:render-xml($ZipFileInvoke/ZipFileOutput/tns4:ZipFileResponse,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;REGOLATORIO Scheduler giornaliero Response: &amp;quot;, tib:render-xml($ZipFileInvoke/ZipFileOutput/tns4:ZipFileResponse,true(),true()))&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_SchedulerRegolatorioResponse-input"
                    name="LOG_SchedulerRegolatorioResponse"
                    tibex:xpdlId="03af40c7-d89f-4e31-8e89-0711ed6d4254"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnError1ToLOG_SchedulerRegolatorioResponse"/>
                        <bpws:target linkName="ZipFileInvokeToLOG_SchedulerRegolatorioResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_SchedulerRegolatorioResponseToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileInvoke.ZipFileOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_SchedulerRegolatorioResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationfileproducer.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorioCPS&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSSchedulerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSScheduler&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;REGOLATORIO Scheduler orario Response: &amp;quot;, tib:render-xml($ZipFileInvoke.ZipFileOutput,true(),true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;REGOLATORIO Scheduler giornaliero Response: &amp;quot;, tib:render-xml($ZipFileInvoke.ZipFileOutput,true(),true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="Confirm"
                    tibex:xpdlId="19f484d2-a2fc-4bc2-b270-4e62697bd77e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLogger3ToConfirm"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ConfirmToAssign"/>
                        <bpws:source linkName="ConfirmToCallProcess"
                            tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.confirm"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Confirm"/>
                                    <value
                                    confirmEvent="RegolatorioSchedulerIn" xsi:type="generalactivities:Confirm"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="ZipFileInvoke-input"
                name="ZipFileInvoke" operation="ZipFile"
                outputVariable="ZipFileInvoke"
                partnerLink="ZipFilePortType"
                portType="ns37:ZipFilePortType" tibex:xpdlId="95fcc956-dba8-40dd-b886-21194a33c83d">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/xsd/WriteFile" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/xsd/FileName" version="2.0"&gt;
    &lt;xsl:param name="IDTipologiaFile"/&gt;
    &lt;xsl:param name="RegolatorioSchedulerIn"/&gt;
    &lt;xsl:param name="REGIDProcsoFileInvio"/&gt;
    &lt;xsl:param name="JDBC_GIORNALIERO"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="WriteFile1"/&gt;
    &lt;xsl:param name="NPNGIDInterfacciaGiornaliero"/&gt;
    &lt;xsl:param name="FileName"/&gt;
    &lt;xsl:param name="RenameFileCRMWS"/&gt;
    &lt;xsl:param name="CreateFile"/&gt;
    &lt;xsl:template name="ZipFileInvoke-input" match="/"&gt;
        &lt;tns5:ZipFileRequest&gt;
            &lt;ZipFileInput&gt;
                &lt;tns4:ZipFileRequest&gt;
                    &lt;xsl:if test="$FileName/FileNameOutput/tns2:FileNameResponse/tns2:FileName"&gt;
                        &lt;tns4:FullName&gt;
                            &lt;xsl:value-of select="$FileName/FileNameOutput/tns2:FileNameResponse/tns2:FileName"/&gt;
                        &lt;/tns4:FullName&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$FileName/FileNameOutput/tns2:FileNameResponse/tns2:FileNameCPS"&gt;
                        &lt;tns4:FileName&gt;
                            &lt;xsl:value-of select="$FileName/FileNameOutput/tns2:FileNameResponse/tns2:FileNameCPS"/&gt;
                        &lt;/tns4:FileName&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile1)"&gt;
                            &lt;tns4:Size&gt;
                                &lt;xsl:value-of select="xsd:int($WriteFile1/fileInfo/size)"/&gt;
                            &lt;/tns4:Size&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($RenameFileCRMWS)"&gt;
                                    &lt;tns4:Size&gt;
                                        &lt;xsl:value-of select="xsd:int($RenameFileCRMWS/fileInfo/size)"/&gt;
                                    &lt;/tns4:Size&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns4:Size&gt;
                                        &lt;xsl:value-of select="xsd:int($CreateFile/fileInfo/size)"/&gt;
                                    &lt;/tns4:Size&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns4:CodiceOLO&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO"/&gt;
                    &lt;/tns4:CodiceOLO&gt;
                    &lt;tns4:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM"/&gt;
                    &lt;/tns4:CodiceOLOAGCOM&gt;
                    &lt;tns4:StrutturaRichiesta&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:StrutturaRichiesta"/&gt;
                    &lt;/tns4:StrutturaRichiesta&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($WriteFile1)"&gt;
                            &lt;tns4:NumeroRecord&gt;
                                &lt;xsl:value-of select="xsd:int(count($JDBC_GIORNALIERO/Record))"/&gt;
                            &lt;/tns4:NumeroRecord&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:NumeroRecord&gt;
                                &lt;xsl:value-of select="0"/&gt;
                            &lt;/tns4:NumeroRecord&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns4:IDInterfaccia&gt;
                        &lt;xsl:value-of select="$NPNGIDInterfacciaGiornaliero"/&gt;
                    &lt;/tns4:IDInterfaccia&gt;
                    &lt;tns4:IDTipologiaFile&gt;
                        &lt;xsl:value-of select="$IDTipologiaFile"/&gt;
                    &lt;/tns4:IDTipologiaFile&gt;
                    &lt;tns4:IDProcsoFile&gt;
                        &lt;xsl:value-of select="$REGIDProcsoFileInvio"/&gt;
                    &lt;/tns4:IDProcsoFile&gt;
                    &lt;tns4:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns4:ProcessIstanceID&gt;
                    &lt;tns4:FullNameCPS&gt;
                        &lt;xsl:value-of select="'NPNG'"/&gt;
                    &lt;/tns4:FullNameCPS&gt;
                &lt;/tns4:ZipFileRequest&gt;
            &lt;/ZipFileInput&gt;
        &lt;/tns5:ZipFileRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileName.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;REGIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile1&quot;/>&#xa;    &lt;xsl:param name=&quot;NPNGIDInterfacciaGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;RenameFileCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateFile&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:ZipFileRequest>&#xa;            &lt;xsl:if test=&quot;$FileName.FileNameOutput/tns2:FileName&quot;>&#xa;                &lt;tns4:FullName>&#xa;                    &lt;xsl:value-of select=&quot;$FileName.FileNameOutput/tns2:FileName&quot;/>&#xa;                &lt;/tns4:FullName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$FileName.FileNameOutput/tns2:FileNameCPS&quot;>&#xa;                &lt;tns4:FileName>&#xa;                    &lt;xsl:value-of select=&quot;$FileName.FileNameOutput/tns2:FileNameCPS&quot;/>&#xa;                &lt;/tns4:FileName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile1)&quot;>&#xa;                    &lt;tns4:Size>&#xa;             