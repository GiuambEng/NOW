            <bpws:invoke inputVariable="FileName-input" name="FileName"
                operation="FileName" outputVariable="FileName"
                partnerLink="FileName" portType="ns21:FileNamePortType" tibex:xpdlId="682f1005-ddcd-4c4b-883b-b2fe49b4731f">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/FileName/" xmlns:tns2="http://www.tim.com/NOW/xsd/FileName" version="2.0"&gt;
    &lt;xsl:param name="RegolatorioSchedulerIn"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:template name="FileName-input" match="/"&gt;
        &lt;tns5:FileNameRequest&gt;
            &lt;FileNameInput&gt;
                &lt;tns2:FileNameRequest&gt;
                    &lt;tns2:TempoNotifica&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:TempoNotifica"/&gt;
                    &lt;/tns2:TempoNotifica&gt;
                    &lt;tns2:StrutturaRichiesta&gt;
                        &lt;xsl:value-of select="'NPNG'"/&gt;
                    &lt;/tns2:StrutturaRichiesta&gt;
                    &lt;tns2:CodiceOLO&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLO"/&gt;
                    &lt;/tns2:CodiceOLO&gt;
                    &lt;tns2:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:CodiceOLOAGCOM"/&gt;
                    &lt;/tns2:CodiceOLOAGCOM&gt;
                    &lt;tns2:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns2:ProcessIstanceID&gt;
                    &lt;xsl:if test="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:NomeFileNPNG"&gt;
                        &lt;tns2:NomeFileCPS&gt;
                            &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns1:SchedulerInput/tns1:NomeFileNPNG"/&gt;
                        &lt;/tns2:NomeFileCPS&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns2:FileNameRequest&gt;
            &lt;/FileNameInput&gt;
        &lt;/tns5:FileNameRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/FileName/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;FileName-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:FileNameRequest>&#xa;            &lt;tns2:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:TempoNotifica&quot;/>&#xa;            &lt;/tns2:TempoNotifica>&#xa;            &lt;tns2:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NPNG'&quot;/>&#xa;            &lt;/tns2:StrutturaRichiesta>&#xa;            &lt;tns2:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns2:CodiceOLO>&#xa;            &lt;tns2:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns2:CodiceOLOAGCOM>&#xa;            &lt;tns2:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns2:ProcessIstanceID>&#xa;            &lt;xsl:if test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:NomeFileNPNG&quot;>&#xa;                &lt;tns2:NomeFileCPS>&#xa;                    &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns1:NomeFileNPNG&quot;/>&#xa;                &lt;/tns2:NomeFileCPS>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:FileNameRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet