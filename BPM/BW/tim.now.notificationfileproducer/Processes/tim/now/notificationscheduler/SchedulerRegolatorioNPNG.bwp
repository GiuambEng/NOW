                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileName&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateFile&quot;/>&#xa;    &lt;xsl:template name=&quot;CopyFile1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CopyActivityConfig>&#xa;            &lt;fromFileName>&#xa;                &lt;xsl:value-of select=&quot;$CreateFile/fileInfo/fullName&quot;/>&#xa;            &lt;/fromFileName>&#xa;            &lt;xsl:if test=&quot;$FileName/FileNameOutput/tns2:FileNameResponse/tns2:FileName&quot;>&#xa;                &lt;toFileName>&#xa;                    &lt;xsl:value-of select=&quot;$FileName/FileNameOutput/tns2:FileNameResponse/tns2:FileName&quot;/>&#xa;                &lt;/toFileName>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:CopyActivityConfig>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
