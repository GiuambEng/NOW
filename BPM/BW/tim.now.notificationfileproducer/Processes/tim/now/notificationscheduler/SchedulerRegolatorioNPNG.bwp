                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileName.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;PathLocaleNOW_NPNG&quot;/>&#xa;    &lt;xsl:param name=&quot;currentCSV&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteFile2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:WriteActivityInputTextClass>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;concat($PathLocaleNOW_NPNG, $FileName.FileNameOutput/tns2:FileNameCPS)&quot;/>&#xa;            &lt;/fileName>&#xa;            &lt;textContent>&#xa;                &lt;xsl:value-of select=&quot;concat($currentCSV/TRACCIATO_FILE,&amp;quot;&amp;#xA;&amp;quot;)&quot;/>&#xa;            &lt;/textContent>&#xa;        &lt;/tns5:WriteActivityInputTextClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
