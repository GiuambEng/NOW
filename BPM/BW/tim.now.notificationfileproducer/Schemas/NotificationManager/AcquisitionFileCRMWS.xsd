<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AcquisitionFileCRMWS/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AcquisitionFileCRMWS/">

    <element name="Request">
    	<complexType>
    		<sequence>
    			<element name="RenameFile" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="FromFileName" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="toFileName" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="FileInfo" maxOccurs="1" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="FileName" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="size" type="long"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="Transaction" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ID_FILE_PROCSTO" type="integer"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="ESEC_PROCSO" type="integer" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>