                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://crmnow.ordinexdsl.jpub/&quot; xmlns:tns0=&quot;http://crmnow.ordinexdsl.jpub.internal/types/&quot; xmlns:tns01=&quot;http://crmnow.ordinexdsl.jpub/types/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ricezioneIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ricezione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns01:ricezioneElement>&#xa;            &lt;tns01:ID_ORDINE_CRM>&#xa;                &lt;xsl:copy-of select=&quot;$ricezioneIn.parameters/tns0:ID_ORDINE_CRM/@xsi:nil&quot;/>&#xa;                &lt;xsl:value-of select=&quot;$ricezioneIn.parameters/tns0:ID_ORDINE_CRM&quot;/>&#xa;            &lt;/tns01:ID_ORDINE_CRM>&#xa;            &lt;tns01:ORDINE>&#xa;                &lt;ORDINI_CRMWS>&#xa;                    &lt;xsl:if test=&quot;exists($ricezioneIn.parameters/tns0:ORDINE/ORDINI_CRMWS/TESTATA)&quot;>&#xa;                        &lt;xsl:for-each select=&quot;$ricezioneIn.parameters/tns0:ORDINE/ORDINI_CRMWS/TESTATA&quot;>&#xa;                            &lt;TESTATA>&#xa;                                &lt;ID_ORD_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                                &lt;/ID_ORD_CRMWS>&#xa;                                &lt;DATA_DRO>&#xa;                                    &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                                &lt;/DATA_DRO>&#xa;                                &lt;DATA_MSG>&#xa;                                    &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                                &lt;/DATA_MSG>&#xa;                                &lt;DATA_DES>&#xa;                                    &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#