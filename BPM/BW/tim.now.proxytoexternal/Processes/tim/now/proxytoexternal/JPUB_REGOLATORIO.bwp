            </plnk:partnerLinkType>
            <wsdl:import namespace="http://crmnow.ordineregolatorio.jpub/"/>
            <wsdl:import namespace="http://www.tibco.com/JPUB_REG_internal_abstract/"/>
        </wsdl:definitions>
