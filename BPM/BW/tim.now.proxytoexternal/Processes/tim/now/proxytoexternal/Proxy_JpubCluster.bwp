                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://crmnow.AnagraficaClusterComuni.jpub/" xmlns:tns0="http://crmnow.AnagraficaClusterComuni.jpub/types/" xmlns:ns1="www.tim.now.proxyJpub.schema" version="2.0"&gt;&lt;xsl:param name="OperationIn"/&gt;&lt;xsl:template name="JpubCluster-input" match="/"&gt;&lt;tns:AnagraficaClusterComuniCRMNOW_ricezione&gt;&lt;parameters&gt;&lt;tns0:ricezioneElement&gt;&lt;tns0:ID_TRANSAZIONE&gt;&lt;xsl:value-of select="$OperationIn/part1/ns1:RequestClusterProxy/ns1:ID_TRANSAZIONE"/&gt;&lt;/tns0:ID_TRANSAZIONE&gt;&lt;tns0:ANAGRAFICA&gt;&lt;ANAGRAFICHE&gt;&lt;xsl:for-each select="$OperationIn/part1/ns1:RequestClusterProxy/ns1:cluster"&gt;&lt;ANAGRAFICA_CLUSTER_COMUNI&gt;&lt;CODICE_ISTAT_COMUNE&gt;&lt;xsl:value-of select="ns1:CODICE_ISTAT_COMUNE"/&gt;&lt;/CODICE_ISTAT_COMUNE&gt;&lt;CODICE_CLUSTER&gt;&lt;xsl:value-of select="ns1:CODICE_CLUSTER"/&gt;&lt;/CODICE_CLUSTER&gt;&lt;TIPOLOGIA_CLUSTER_COMUNE&gt;&lt;xsl:value-of select="ns1:TIPOLOGIA_CLUSTER_COMUNE"/&gt;&lt;/TIPOLOGIA_CLUSTER_COMUNE&gt;&lt;xsl:if test="ns1:VERSIONING"&gt;&lt;VERSIONING&gt;&lt;xsl:value-of select="ns1:VERSIONING"/&gt;&lt;/VERSIONING&gt;&lt;/xsl:if&gt;&lt;DATA_INIZIO_VALIDITA_PRICING&gt;&lt;xsl:value-of select="ns1:DATA_INIZIO_VALIDITA_PRICING"/&gt;&lt;/DATA_INIZIO_VALIDITA_PRICING&gt;&lt;DATA_FINE_VALIDITA_PRICING&gt;&lt;xsl:value-of select="ns1:DATA_FINE_VALIDITA_PRICING"/&gt;&lt;/DATA_FINE_VALIDITA_PRICING&gt;&lt;DESCRIZIONE_COMUNE&gt;&lt;xsl:value-of select="ns1:DESCRIZIONE_COMUNE"/&gt;&lt;/DESCRIZIONE_COMUNE&gt;&lt;TIPO_CONTR&gt;&lt;xsl:value-of select="ns1:TIPO_CONTR"/&gt;&lt;/TIPO_CONTR&gt;&lt;DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&gt;&lt;xsl:value-of select="ns1:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI"/&gt;&lt;/DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&gt;&lt;DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&gt;&lt;xsl:value-of select="ns1:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI"/&gt;&lt;/DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&gt;&lt;xsl:if test="ns1:DATA_INIZIO_MARCAGGIO_PREGRESSO"&gt;&lt;DATA_INIZIO_MARCAGGIO_PREGRESSO&gt;&lt;xsl:value-of select="ns1:DATA_INIZIO_MARCAGGIO_PREGRESSO"/&gt;&lt;/DATA_INIZIO_MARCAGGIO_PREGRESSO&gt;&lt;/xsl:if&gt;&lt;/ANAGRAFICA_CLUSTER_COMUNI&gt;&lt;/xsl:for-each&gt;&lt;/ANAGRAFICHE&gt;&lt;/tns0:ANAGRAFICA&gt;&lt;/tns0:ricezioneElement&gt;&lt;/parameters&gt;&lt;/tns:AnagraficaClusterComuniCRMNOW_ricezione&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://crmnow.AnagraficaClusterComuni.jpub/&quot; xmlns:tns0=&quot;http://crmnow.AnagraficaClusterComuni.jpub/types/&quot; xmlns:ns1=&quot;www.tim.now.proxyJpub.schema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OperationIn.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;JpubCluster-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns0:ricezioneElement>&#xa;            &lt;tns0:ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$OperationIn.part1/ns1:ID_TRANSAZIONE&quot;/>&#xa;            &lt;/tns0:ID_TRANSAZIONE>&#xa;            &lt;tns0:ANAGRAFICA>&#xa;                &lt;ANAGRAFICHE>&#xa;                    &lt;xsl:for-each select=&quot;$OperationIn.part1/ns1:cluster&quot;>&#xa;                        &lt;ANAGRAFICA_CLUSTER_COMUNI>&#xa;                            &lt;CODICE_ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;ns1:CODICE_ISTAT_COMUNE&quot;/>&#xa;                            &lt;/CODICE_ISTAT_COMUNE>&#xa;                            &lt;CODICE_CLUSTER>&#xa;                                &lt;xsl:value-of select=&quot;ns1:CODICE_CLUSTER&quot;/>&#xa;                            &lt;/CODICE_CLUSTER>&#xa;                            &lt;TIPOLOGIA_CLUSTER_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;ns1:TIPOLOGIA_CLUSTER_COMUNE&quot;/>&#xa;                            &lt;/TIPOLOGIA_CLUSTER_COMUNE>&#xa;                            &lt;xsl:if test=&quot;ns1:VERSIONING&quot;>&#xa;                                &lt;VERSIONING>&#xa;                                    &lt;xsl:value-of select=&quot;ns1:VERSIONING&quot;/>&#xa;                                &lt;/VERSIONING>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;DATA_INIZIO_VALIDITA_PRICING>&#xa;                                &lt;xsl:value-of select=&quot;ns1:DATA_INIZIO_VALIDITA_PRICING&quot;/>&#xa;                            &lt;/DATA_INIZIO_VALIDITA_PRICING>&#xa;                            &lt;DATA_FINE_VALIDITA_PRICING>&#xa;                                &lt;xsl:value-of select=&quot;ns1:DATA_FINE_VALIDITA_PRICING&quot;/>&#xa;                            &lt;/DATA_FINE_VALIDITA_PRICING>&#xa;                            &lt;DESCRIZIONE_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;ns1:DESCRIZIONE_COMUNE&quot;/>&#xa;                            &lt;/DESCRIZIONE_COMUNE>&#xa;                            &lt;TIPO_CONTR>&#xa;                                &lt;xsl:value-of select=&quot;ns1:TIPO_CONTR&quot;/>&#xa;                            &lt;/TIPO_CONTR>&#xa;                            &lt;DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&#xa;                                &lt;xsl:value-of select=&quot;ns1:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&quot;/>&#xa;                            &lt;/DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&#xa;                            &lt;DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&#xa;                                &lt;xsl:value-of select=&quot;ns1:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&quot;/>&#xa;                            &lt;/DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&#xa;                            &lt;xsl:if test=&quot;ns1:DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;>&#xa;                                &lt;DATA_INIZIO_MARCAGGIO_PREGRESSO>&#xa;                                    &lt;xsl:value-of select=&quot;ns1:DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;/>&#xa;                                &lt;/DATA_INIZIO_MARCAGGIO_PREGRESSO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ANAGRAFICA_CLUSTER_COMUNI>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/ANAGRAFICHE>&#xa;            &lt;/tns0:ANAGRAFICA>&#xa;        &lt;/tns0:ricezioneElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="GenericLogger1ToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToConfirm"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:empty name="Empty" tibex:xpdlId="e2d6ee01-2b09-41f8-a485-bef30dd5383e">
                <bpws:targets>
                    <bpws:target linkName="ConfirmToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToGenericLogger2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToThrow">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$JpubCluster/parameters/tns01:ricezioneResponseElement/tns01:result/@ns6:nil=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$JpubCluster.parameters/tns01:result/@ns6:nil=true()]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:throw faultName="ns5:DefaultFault"
                faultVariable="Throw-input" name="Throw" tibex:xpdlId="9a0035da-cb2c-4484-8524-00eb021ece26">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DefaultFault>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;'Chiamata a JPUB non riuscita'&quot;/>&#xa;            &lt;/message>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;'Chiamata a JPUB non riuscita'&quot;/>&#xa;            &lt;/msgCode>&#xa;        &lt;/tns1:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="EmptyToThrow"/>
                </bpws:targets>
            </bpws:throw>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
