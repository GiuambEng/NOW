<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="www.tim.now.proxyJpub.schema" targetNamespace="www.tim.now.proxyJpub.schema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:complexType name="Contratti_type">
		<xs:sequence>
			<xs:element name="CODE_CONTR" type="xs:string"/>
			<xs:element name="CODE_TIPO_CONTR" type="xs:string"/>
			<xs:element name="CODE_GEST" type="xs:string"/>
			<xs:element name="DESC_CONTR" type="xs:string"/>
			<xs:element name="DATA_SCAD_CONTR" type="xs:string"/>
			<xs:element name="DATA_STIP_CONTR" type="xs:string"/>
			<xs:element name="DATA_INIZIO_VALID" type="xs:string"/>
			<xs:element name="DATA_FINE_VALID" type="xs:string"/>
			<xs:element name="DATA_COINV" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Gestori_type">
		<xs:sequence>
			<xs:element name="TIPO_AZIONE" type="xs:string"/>
			<xs:element name="CODE_GEST" type="xs:string"/>
			<xs:element name="NOME_RAG_SOC_GEST" type="xs:string"/>
			<xs:element name="NOME_GEST_SIGLA" type="xs:string"/>
			<xs:element name="CODE_PARTITA_IVA" type="xs:string"/>
			<xs:element name="CODE_GEST_TIRKS" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Cluster_type">
		   <xs:sequence>
							<xs:element name="CODICE_ISTAT_COMUNE" type="xs:string" />
				<xs:element name="CODICE_CLUSTER" type="xs:string">
				
				</xs:element>
				<xs:element name="TIPOLOGIA_CLUSTER_COMUNE">
					<xs:simpleType>
						<xs:restriction base="xs:string">

							<xs:enumeration value="CC" />
							<xs:enumeration value="LIB" />
							<xs:maxLength value="10"></xs:maxLength>
							<xs:minLength value="2"></xs:minLength>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DATA_INIZIO_VALIDITA_PRICING"
					type="xs:string" />
				<xs:element name="DATA_FINE_VALIDITA_PRICING"
					type="xs:string" />
				<xs:element name="DESCRIZIONE_COMUNE" type="xs:string">
				
				</xs:element>
				<xs:element name="TIPO_CONTR" type="xs:string"/>
				<xs:element name="DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI"
					type="xs:string" />
				<xs:element name="DATA_FINE_MARCAGGIO_NUOVI_ACCESSI"
					type="xs:string" />
				<xs:element name="DATA_INIZIO_MARCAGGIO_PREGRESSO"
					type="xs:string" minOccurs="0" />
					<xs:element name="VERSIONING"
					type="xs:string" minOccurs="0" />
					<xs:element name="AREA_COLORE"
					type="xs:string" minOccurs="0" />
					<xs:element name="FLAG_POLICY"
					type="xs:string" minOccurs="0" />
					<xs:element name="FLAG_TEMP_SPT"
					type="xs:string" minOccurs="1" />
						</xs:sequence>
	</xs:complexType>
	<xs:element name="RequestContrattiProxy">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID_TRANSAZIONE" type="xs:string"/>
				<xs:element name="Contratti" type="Contratti_type" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RequestGestoreProxy">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID_TRANSAZIONE" type="xs:string"/>
				<xs:element name="Gestore" type="Gestori_type" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RequestClusterProxy">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID_TRANSAZIONE" type="xs:string"/>
				<xs:element name="cluster" type="Cluster_type" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Response">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="result" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>