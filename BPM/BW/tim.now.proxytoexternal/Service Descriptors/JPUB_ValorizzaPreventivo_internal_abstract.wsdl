<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<definitions
	xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/JPUB_ValorizzaPreventivo_internal_abstract/"
	xmlns="http://schemas.xmlsoap.org/wsdl/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	name="JPUB_ValorizzaPreventivo_internal_abstract"
	targetNamespace="http://www.tim.com/NOW/wsdl/abstract/JPUB_ValorizzaPreventivo_internal_abstract/"
	xmlns:regCRMWS="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0">

	<types>
		<xs:schema
			xmlns:regCRMWS="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0"
			xmlns:xs="http://www.w3.org/2001/XMLSchema"
			targetNamespace="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0"
			elementFormDefault="unqualified" attributeFormDefault="unqualified">

			<xs:element name="OPERESPECIALI">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="PREVENTIVO"
							type="regCRMWS:PREVENTIVO" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="OPERESPECIALIResponse">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="PreventivoResponse"
							type="regCRMWS:PreventivoResponse" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:complexType name="PreventivoResponse">
				<xs:sequence>
					<xs:element name="ID_PREVENTIVO"
						type="regCRMWS:idPreventivo" />
					<xs:element name="ID_RICHIESTA_NOW"
						type="regCRMWS:idRichiestaNow" />
					<xs:element name="ID_OLO" type="regCRMWS:codeContr" />
					<xs:element name="CODICE_ORDINE_OLO"
						type="regCRMWS:codiceOrdineOlo" />
					<xs:element name="ID_RIS" type="regCRMWS:idRisorsa" />
					<xs:element name="TIPO_SERVIZIO"
						type="regCRMWS:enumTipoContr" />
					<xs:element name="TECNOLOGIA"
						type="regCRMWS:enumTipoTec" />
					<xs:element name="DATA_DRO" type="xs:dateTime" />
					<xs:element name="DATA_RICHIESTA_PREVENTIVO"
						type="xs:dateTime" />
					<xs:element name="FLAG_PREVENTIVO"
						type="regCRMWS:enumFlagPrev" />
					<xs:element name="DETTAGLIO" type="regCRMWS:DETTAGLIO"
						maxOccurs="unbounded" />
					<xs:element name="DATA_INVIO_PREVENTIVO"
						type="xs:dateTime" />
					<xs:element name="TOTALE" type="regCRMWS:EuroTypeImp" />
					<xs:element name="DettaglioResponse"
						type="regCRMWS:DettaglioResponse" maxOccurs="unbounded" />
					<xs:element name="ERRORE" type="regCRMWS:ERRORE"
						maxOccurs="1" />
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="DettaglioResponse">
				<xs:sequence>
					<xs:element name="ID_VOCE" type="regCRMWS:enumIdVoce" />
					<xs:element name="QUANTITA" type="regCRMWS:quantita" />
					<xs:element name="DESCRIZIONE" type="regCRMWS:string30" />
					<xs:element name="IMPORTO" type="regCRMWS:EuroTypeImp" />
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="ERRORE">
				<xs:sequence>
					<xs:element name="TYPE_ERROR"
						type="regCRMWS:enumTypeError" />
					<xs:element name="CODE_ERROR" type="xs:string" />
					<xs:element name="DETTAGLIO" type="xs:string" />
				</xs:sequence>
			</xs:complexType>
			<xs:element name="FAULT">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ErrorCode" type="xs:string" />
						<xs:element name="MSGErrore" type="xs:string" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:simpleType name="EuroTypeImp">
				<xs:restriction base="xs:integer" />
			</xs:simpleType>
			<xs:simpleType name="string30">
				<xs:restriction base="regCRMWS:strNoSpace">
					<xs:minLength value="0" />
					<xs:maxLength value="30" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="enumTypeError">
				<xs:restriction base="xs:string">
					<xs:enumeration value="0" />
					<xs:enumeration value="1" />
					<xs:enumeration value="2" />
					<xs:enumeration value="3" />
				</xs:restriction>
			</xs:simpleType>
			<xs:complexType name="PREVENTIVO">
				<xs:sequence>
					<xs:element name="ID_PREVENTIVO"
						type="regCRMWS:idPreventivo" />
					<xs:element name="ID_RICHIESTA_NOW"
						type="regCRMWS:idRichiestaNow" />
					<xs:element name="ID_OLO" type="regCRMWS:codeContr" />
					<xs:element name="CODICE_ORDINE_OLO"
						type="regCRMWS:codiceOrdineOlo" />
					<xs:element name="ID_RIS" type="regCRMWS:idRisorsa" />
					<xs:element name="TIPO_SERVIZIO"
						type="regCRMWS:enumTipoContr" />
					<xs:element name="TECNOLOGIA"
						type="regCRMWS:enumTipoTec" />
					<xs:element name="DATA_DRO" type="xs:dateTime" />
					<xs:element name="DATA_RICHIESTA_PREVENTIVO"
						type="xs:dateTime" />
					<xs:element name="FLAG_PREVENTIVO"
						type="regCRMWS:enumFlagPrev" />
					<xs:element name="DETTAGLIO" type="regCRMWS:DETTAGLIO"
						maxOccurs="unbounded" />
				</xs:sequence>
			</xs:complexType>
			<xs:complexType name="DETTAGLIO">
				<xs:sequence>
					<xs:element name="ID_VOCE" type="regCRMWS:enumIdVoce" />
					<xs:element name="QUANTITA" type="regCRMWS:quantita" />
				</xs:sequence>
			</xs:complexType>
			<xs:simpleType name="strNoSpace">
				<xs:restriction base="xs:string">
					<xs:whiteSpace value="preserve" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="idPreventivo">
				<xs:restriction base="regCRMWS:strNoSpace">
					<xs:minLength value="1" />
					<xs:maxLength value="20" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="idRichiestaNow">
				<xs:restriction base="regCRMWS:strNoSpace">
					<xs:minLength value="1" />
					<xs:maxLength value="20" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="codeContr">
				<xs:restriction base="regCRMWS:strNoSpace">
					<xs:minLength value="1" />
					<xs:maxLength value="6" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="codiceOrdineOlo">
				<xs:restriction base="regCRMWS:strNoSpace">
					<xs:minLength value="1" />
					<xs:maxLength value="30" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="enumTipoContr">
				<xs:restriction base="xs:string">
					<xs:enumeration value="7" />
					<xs:enumeration value="9" />
					<xs:enumeration value="17" />
					<xs:enumeration value="23" />
					<xs:enumeration value="37" />
					<xs:enumeration value="41" />
					<xs:enumeration value="42" />
					<xs:enumeration value="44" />
					<xs:enumeration value="47" />
					<xs:enumeration value="48" />
					<xs:enumeration value="50" />
					<xs:enumeration value="51" />
					<xs:enumeration value="52" />
					<xs:enumeration value="54" />
					<xs:enumeration value="55" />
					<xs:enumeration value="56" />
					<xs:enumeration value="57" />
					<xs:enumeration value="58" />
					<xs:enumeration value="59" />
					<xs:enumeration value="60" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="enumFlagPrev">
				<xs:restriction base="xs:string">
					<xs:enumeration value="0" />
					<xs:enumeration value="1" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="enumIdVoce">
				<xs:restriction base="xs:string">
					<xs:enumeration value="1" />
					<xs:enumeration value="2" />
					<xs:enumeration value="3" />
					<xs:enumeration value="4" />
					<xs:enumeration value="5" />
					<xs:enumeration value="6" />
					<xs:enumeration value="7" />
					<xs:enumeration value="8" />
					<xs:enumeration value="9" />
					<xs:enumeration value="10" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="quantita">
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="0" />
					<xs:maxInclusive value="999999" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="enumTipoTec">
				<xs:restriction base="xs:string">
					<xs:enumeration value="" />
					<xs:enumeration value="FTTH" />
					<xs:enumeration value="FTTCAB" />
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType name="idRisorsa">
				<xs:restriction base="regCRMWS:strNoSpace">
					<xs:minLength value="1" />
					<xs:maxLength value="30" />
				</xs:restriction>
			</xs:simpleType>

		</xs:schema>

	</types>
	<message name="OPERESPECIALI">
		<part name="parameters" element="regCRMWS:OPERESPECIALI" />
	</message>
	<message name="OPERESPECIALIResponse">
		<part name="parameters" element="regCRMWS:OPERESPECIALIResponse" />
	</message>
	<message name="Fault">
		<part name="parameters" element="regCRMWS:FAULT" />
	</message>
	<portType name="PreventivoWS">
		<operation name="calcolaPreventivo">
			<input name="OPERESPECIALI" message="tns:OPERESPECIALI" />
			<output name="OPERESPECIALIResponse"
				message="tns:OPERESPECIALIResponse" />
			<fault name="Fault" message="tns:Fault" />
		</operation>
	</portType>
</definitions>
