                        </bpws:empty>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GestioneFatturazione/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Assign&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMessageJPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeXDSL_NGA&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeSendMessageNP&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRecordJPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;Struttura&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;Assign&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Root>&#xa;            &lt;xsl:copy-of select=&quot;$Assign/tns2:GF&quot;/>&#xa;            &lt;tns2:GF>&#xa;                &lt;tns2:ID_Rich_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$SelectRecordJPUB/Record[number($index)]/ID_RICH_OLO&quot;/>&#xa;                &lt;/tns2:ID_Rich_OLO>&#xa;                &lt;tns2:Numero_Tentativi>&#xa;                    &lt;xsl:value-of select=&quot;$SelectRecordJPUB/Record[number($index)]/NUMERO_TENTATIVI&quot;/>&#xa;                &lt;/tns2:Numero_Tentativi>&#xa;                &lt;tns2:ID_Evento_Jpub>&#xa;                    &lt;xsl:value-of select=&quot;$SelectRecordJPUB/Record[number($index)]/ID_RICH_JPUB&quot;/>&#xa;                &lt;/tns2:ID_Evento_Jpub>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Struttura='FWA'&quot;>&#xa;                        &lt;tns2:Stato>&#xa;                            &lt;xsl:value-of select=&quot;if ($InvokeFWA/parameters/tns1:SendJPUBResponse/tns1:code = &amp;quot;OK&amp;quot;) then &amp;quot;RICEVUTO_ACK&amp;quot; else &amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Stato>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Struttura='NPG'&quot;>&#xa;                        &lt;tns2:Stato>&#xa;                            &lt;xsl:value-of select=&quot;if ($InvokeSendMessageNP/parameters/tns1:SendJPUBResponse/tns1:code = &amp;quot;OK&amp;quot;) then &amp;quot;RICEVUTO_ACK&amp;quot; else &amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Stato>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Struttura='REGOLATORIO'&quot;>&#xa;                        &lt;tns2:Stato>&#xa;                            &lt;xsl:value-of select=&quot;if ($SendMessageJPUB/parameters/tns1:SendJPUBResponse/tns1:code = &amp;quot;OK&amp;quot;) then &amp;quot;RICEVUTO_ACK&amp;quot; else &amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Stato>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Stato>&#xa;                            &lt;xsl:value-of select=&quot;if ($InvokeXDSL_NGA/parameters/tns1:SendJPUBResponse/tns1:code = &amp;quot;OK&amp;quot;) then &amp;quot;RICEVUTO_ACK&amp;quot; else &amp;quot;DA_INVIARE&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Stato>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($SelectRecordJPUB/Record[number($index)]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                &lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;/tns2:GF>&#xa;        &lt;/tns2:Root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="Assign" name="Accumulate"
                                outputVariable="Assign"
                                tibex:xpdlId="796e18b2-faed-4023-a66f-828b42235b1c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
