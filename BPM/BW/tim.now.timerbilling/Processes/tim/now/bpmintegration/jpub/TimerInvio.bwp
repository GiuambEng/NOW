                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogFaultParse-input"
                                name="LogFaultParse"
                                tibex:xpdlId="29536808-3e1f-4a29-8666-a5130c2544de"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ParseNPToCallProcess"/>
                                    <bpws:target linkName="ParseXDSL_NGAToCallProcess1"/>
                                    <bpws:target linkName="ParseJPUBRequestToCallProcess1"/>
                                    <bpws:target linkName="ParseFWAToLogFaultParse"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="LogFaultParseToJDBCUpdate"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://schemas.tibco.com/bw/plugins/xml/5.0/xmlExceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_ParseNP&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_ParseJPUBRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_ParseXDSL_NGA&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRecordJPUB&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_ParseFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultParse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.timerbilling.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'TimerInvio'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'TimerInvio'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'TimerInvio'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId,$SelectRecordJPUB/Record[number($index)]/ID_RICH_OLO)&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SelectRecordJPUB/Record[number($index)]/STRUTTURA_OFFERTA='REGOLATORIO' or $SelectRecordJPUB/Record[number($index)]/STRUTTURARICHIESTA='REGOLATORIO'&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('FaultParseREG', $_error/StackTrace,$_error/Msg,$_error/ProcessStack,$_error/MsgCode,$_error_ParseJPUBRequest/tns3:XMLParseException/msg,$_error_ParseJPUBRequest/tns3:XMLParseException/msgCode,$_error_ParseJPUBRequest/tns3:UnsupportedEncodingException/msg,$_error_ParseJPUBRequest/tns3:UnsupportedEncodingException/msgCode,$_error_ParseJPUBRequest/tns3:UnsupportedEncodingException/encoding,$_error_ParseJPUBRequest/tns3:MissingByteCountException/msg,$_error_ParseJPUBRequest/tns3:MissingByteCountException/msgCode,$_error_ParseJPUBRequest/tns3:ValidationException/msg,$_error_ParseJPUBRequest/tns3:ValidationException/msgCode)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;($SelectRecordJPUB/Record[number($index)]/STRUTTURA_OFFERTA='NGA' or $SelectRecordJPUB/Record[number($index)]/STRUTTURA_OFFERTA='XDSL') or $SelectRecordJPUB/Record[number($index)]/STRUTTURARICHIESTA='NGA' or $SelectRecordJPUB/Record[number($index)]/STRUTTURARICHIESTA='XDSL'&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('FaultParseNGA_XDSL', $_error/StackTrace,$_error/Msg,$_error/ProcessStack,$_error/MsgCode,$_error_ParseXDSL_NGA/tns3:XMLParseException/msg,$_error_ParseXDSL_NGA/tns3:XMLParseException/msgCode,$_error_ParseXDSL_NGA/tns3:UnsupportedEncodingException/msg,$_error_ParseXDSL_NGA/tns3:UnsupportedEncodingException/msgCode,$_error_ParseXDSL_NGA/tns3:UnsupportedEncodingException/encoding,$_error_ParseXDSL_NGA/tns3:MissingByteCountException/msg,$_error_ParseXDSL_NGA/tns3:MissingByteCountException/msgCode,$_error_ParseXDSL_NGA/tns3:ValidationException/msg,$_error_ParseXDSL_NGA/tns3:ValidationException/msgCode)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;($SelectRecordJPUB/Record[number($index)]/STRUTTURA_OFFERTA='FWA' or $SelectRecordJPUB/Record[number($index)]/STRUTTURARICHIESTA='FWA')&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('FaultParseFWA', $_error/StackTrace,$_error/Msg,$_error/ProcessStack,$_error/MsgCode,$_error_ParseFWA/tns3:XMLParseException/msg,$_error_ParseFWA/tns3:XMLParseException/msgCode,$_error_ParseFWA/tns3:UnsupportedEncodingException/msg,$_error_ParseFWA/tns3:UnsupportedEncodingException/msgCode,$_error_ParseFWA/tns3:UnsupportedEncodingException/encoding,$_error_ParseFWA/tns3:MissingByteCountException/msg,$_error_ParseFWA/tns3:MissingByteCountException/msgCode,$_error_ParseFWA/tns3:ValidationException/msg,$_error_ParseFWA/tns3:ValidationException/msgCode)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('FaultParseNP', $_error/StackTrace,$_error/Msg,$_error/ProcessStack,$_error/MsgCode,$_error_ParseNP/tns3:XMLParseException/msg,$_error_ParseNP/tns3:XMLParseException/msgCode,$_error_ParseNP/tns3:UnsupportedEncodingException/msg,$_error_ParseNP/tns3:UnsupportedEncodingException/msgCode,$_error_ParseNP/tns3:UnsupportedEncodingException/encoding,$_error_ParseNP/tns3:MissingByteCountException/msg,$_error_ParseNP/tns3:MissingByteCountException/msgCode,$_error_ParseNP/tns3:ValidationException/msg,$_error_ParseNP/tns3:ValidationException/msgCode)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
