                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/" xmlns:tns1="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:ns1="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="ParseJPUBRequest"/&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="SelectRecordJPUB"/&gt;
    &lt;xsl:template name="SendMessageJPUB-input" match="/"&gt;
        &lt;tns:SendJPUBRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:SendJPUBRequest&gt;
                    &lt;tns1:Stato&gt;
                        &lt;xsl:value-of select="&amp;quot;IN_INVIO&amp;quot;"/&gt;
                    &lt;/tns1:Stato&gt;
                    &lt;ns1:REGOLATORIO&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($ParseJPUBRequest/ns1:TESTATA) and $SelectRecordJPUB/Record[number($index)]/FLAG_CONSUNTIVO=0"&gt;
                                &lt;xsl:copy-of select="$ParseJPUBRequest/ns1:TESTATA"/&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;ns1:PREVENTIVO&gt;
                                    &lt;ID_PREVENTIVO&gt;
                                        &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/ID_PREVENTIVO"/&gt;
                                    &lt;/ID_PREVENTIVO&gt;
                                    &lt;ID_RICHIESTA_NOW&gt;
                                        &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;
                                    &lt;/ID_RICHIESTA_NOW&gt;
                                    &lt;ID_OLO&gt;
                                        &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/ID_OLO"/&gt;
                                    &lt;/ID_OLO&gt;
                                    &lt;CODICE_ORDINE_OLO&gt;
                                        &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/CODICE_ORDINE_OLO"/&gt;
                                    &lt;/CODICE_ORDINE_OLO&gt;
                                    &lt;ID_RIS&gt;
                                        &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/ID_RIS"/&gt;
                                    &lt;/ID_RIS&gt;
                                    &lt;TIPO_SERVIZIO&gt;
                                        &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/TIPO_SERVIZIO"/&gt;
                                    &lt;/TIPO_SERVIZIO&gt;
                                    &lt;TECNOLOGIA&gt;
                                        &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/TECNOLOGIA"/&gt;
                                    &lt;/TECNOLOGIA&gt;
                                    &lt;DATA_DRO&gt;
                                        &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/DATA_DRO"/&gt;
                                    &lt;/DATA_DRO&gt;
                                    &lt;xsl:if test="$ParseJPUBRequest/ns1:PREVENTIVO/DATA_INVIO_PREVENTIVO"&gt;
                                        &lt;DATA_INVIO_PREVENTIVO&gt;
                                            &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/DATA_INVIO_PREVENTIVO"/&gt;
                                        &lt;/DATA_INVIO_PREVENTIVO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;DATA_RICHIESTA_PREVENTIVO&gt;
                                        &lt;xsl:value-of select="$ParseJPUBRequest/ns1:PREVENTIVO/DATA_RICHIESTA_PREVENTIVO"/&gt;
                                    &lt;/DATA_RICHIESTA_PREVENTIVO&gt;
                                    &lt;xsl:copy-of select="$ParseJPUBRequest/ns1:PREVENTIVO/ns1:DETTAGLIO"/&gt;
                                &lt;/ns1:PREVENTIVO&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/ns1:REGOLATORIO&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA)&gt;0"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='WLR'  or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='WLRLINEANONATTIVA' or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='WLRLINEAATTIVA' or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='VARIAZIONEWLR' or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='CESSAZIONEWLRLINEAATTIVA' or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='CESSAZIONEWLRLINEANONATTIVA'"&gt;
                                    &lt;tns1:WLRTimer&gt;
                                        &lt;xsl:value-of select="'WLR'"/&gt;
                                    &lt;/tns1:WLRTimer&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise/&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$SelectRecordJPUB/Record[number($index)]/OFFERTA='WLRLINEAATTIVA'or $SelectRecordJPUB/Record[number($index)]/OFFERTA='WLR' or $SelectRecordJPUB/Record[number($index)]/OFFERTA='WLRLINEANONATTIVA' or $SelectRecordJPUB/Record[number($index)]/OFFERTA='VARIAZIONEWLR' or $SelectRecordJPUB/Record[number($index)]/OFFERTA='CESSAZIONEWLRLINEAATTIVA' or $SelectRecordJPUB/Record[number($index)]/OFFERTA='CESSAZIONEWLRLINEANONATTIVA'"&gt;
                                    &lt;tns1:WLRTimer&gt;
                                        &lt;xsl:value-of select="'WLR'"/&gt;
                                    &lt;/tns1:WLRTimer&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise/&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns1:IDEventoOrdnTimer&gt;
                        &lt;xsl:value-of select="xsd:int($SelectRecordJPUB/Record[number($index)]/ID_EVENTO_ORDN_NOW_WHLS)"/&gt;
                    &lt;/tns1:IDEventoOrdnTimer&gt;
                &lt;/tns1:SendJPUBRequest&gt;
            &lt;/parameters&gt;
        &lt;/tns:SendJPUBRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseJPUBRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRecordJPUB&quot;/>&#xa;    &lt;xsl:template name=&quot;SendMessageJPUB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SendJPUBRequest>&#xa;            &lt;tns1:Stato>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;IN_INVIO&amp;quot;&quot;/>&#xa;            &lt;/tns1:Stato>&#xa;            &lt;ns1:REGOLATORIO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseJPUBRequest/ns1:TESTATA) and $SelectRecordJPUB/Record[number($index)]/FLAG_CONSUNTIVO=0&quot;>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseJPUBRequest/ns1:TESTATA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns1:PREVENTIVO>&#xa;                            &lt;ID_PREVENTIVO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/ID_PREVENTIVO&quot;/>&#xa;                            &lt;/ID_PREVENTIVO>&#xa;                            &lt;ID_RICHIESTA_NOW>&#xa;                                &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                            &lt;/ID_RICHIESTA_NOW>&#xa;                            &lt;ID_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/ID_OLO&quot;/>&#xa;                            &lt;/ID_OLO>&#xa;                            &lt;CODICE_ORDINE_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/CODICE_ORDINE_OLO&quot;/>&#xa;                            &lt;/CODICE_ORDINE_OLO>&#xa;                            &lt;ID_RIS>&#xa;                                &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/ID_RIS&quot;/>&#xa;                            &lt;/ID_RIS>&#xa;                            &lt;TIPO_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/TIPO_SERVIZIO&quot;/>&#xa;                            &lt;/TIPO_SERVIZIO>&#xa;                            &lt;TECNOLOGIA>&#xa;                                &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/TECNOLOGIA&quot;/>&#xa;                            &lt;/TECNOLOGIA>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/DATA_DRO&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                            &lt;xsl:if test=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/DATA_INVIO_PREVENTIVO&quot;>&#xa;                                &lt;DATA_INVIO_PREVENTIVO>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/DATA_INVIO_PREVENTIVO&quot;/>&#xa;                                &lt;/DATA_INVIO_PREVENTIVO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;DATA_RICHIESTA_PREVENTIVO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/DATA_RICHIESTA_PREVENTIVO&quot;/>&#xa;                            &lt;/DATA_RICHIESTA_PREVENTIVO>&#xa;                            &lt;xsl:copy-of select=&quot;$ParseJPUBRequest/ns1:PREVENTIVO/ns1:DETTAGLIO&quot;/>&#xa;                        &lt;/ns1:PREVENTIVO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns1:REGOLATORIO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='WLR'  or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='WLRLINEANONATTIVA' or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='WLRLINEAATTIVA' or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='VARIAZIONEWLR' or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='CESSAZIONEWLRLINEAATTIVA' or $SelectRecordJPUB/Record[number($index)]/EVE_OFFERTA='CESSAZIONEWLRLINEANONATTIVA'&quot;>&#xa;                            &lt;tns1:WLRTimer>&#xa;                                &lt;xsl:value-of select=&quot;'WLR'&quot;/>&#xa;                            &lt;/tns1:WLRTimer>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$SelectRecordJPUB/Record[number($index)]/OFFERTA='WLRLINEAATTIVA'or $SelectRecordJPUB/Record[number($index)]/OFFERTA='WLR' or $SelectRecordJPUB/Record[number($index)]/OFFERTA='WLRLINEANONATTIVA' or $SelectRecordJPUB/Record[number($index)]/OFFERTA='VARIAZIONEWLR' or $SelectRecordJPUB/Record[number($index)]/OFFERTA='CESSAZIONEWLRLINEAATTIVA' or $SelectRecordJPUB/Record[number($index)]/OFFERTA='CESSAZIONEWLRLINEANONATTIVA'&quot;>&#xa;                            &lt;tns1:WLRTimer>&#xa;                                &lt;xsl:value-of select=&quot;'WLR'&quot;/>&#xa;                            &lt;/tns1:WLRTimer>&#xa;                        &lt;/xsl:when>&#xa;                      