                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseNGA_XDSL_XML-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;contains($IN_INVIO/tns2:Assign[$index]/tns2:CONTENUTO_XML,'&amp;lt;CODE_CLUSTER>')&quot;>&#xa;                &lt;tns4:xmlString>&#xa;                    &lt;xsl:value-of select=&quot;concat(substring-before($IN_INVIO/tns2:Assign[$index]/tns2:CONTENUTO_XML,'&amp;lt;CODE_CLUSTER>'),substring-after($IN_INVIO/tns2:Assign[$index]/tns2:CONTENUTO_XML,'&amp;lt;/CODE_CLUSTER>'))&quot;/>&#xa;                &lt;/tns4:xmlString>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns4:xmlString>&#xa;                    &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:CONTENUTO_XML&quot;/>&#xa;                &lt;/tns4:xmlString>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.parsexml"
                                    version="6.0.0.20121128"
