                                    <bpws:invoke
                                    inputVariable="InvioJPUB-input"
                                    name="InvioJPUB"
                                    operation="SendJPUB"
                                    outputVariable="InvioJPUB"
                                    partnerLink="SendJPUB"
                                    portType="ns7:SendJPUB" tibex:xpdlId="b769812e-10e1-4d3c-86cd-6a05087c5d67">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/" xmlns:ns1="http://xsd.telecomitalia.it/Schema/jpub/" xmlns:tns1="http://www.tim.com/NOW/xsd/InvioJPUB/" xmlns:tns2="http://www.tim.com/NOW/xsd/AssignIN_INVIO /" xmlns:tns3="http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/" version="2.0"&gt;
    &lt;xsl:param name="ParseRegulatoryXML"/&gt;
    &lt;xsl:param name="IN_INVIO"/&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="NewIDEvento"/&gt;
    &lt;xsl:template name="InvioJPUB-input" match="/"&gt;
        &lt;tns:SendJPUBRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:SendJPUBRequest&gt;
                    &lt;tns1:Stato&gt;
                        &lt;xsl:value-of select="&amp;quot;IN_INVIO&amp;quot;"/&gt;
                    &lt;/tns1:Stato&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($ParseRegulatoryXML/ns1:TESTATA) and $IN_INVIO/tns2:Assign[number($index)]/tns2:FLAG_CONSUNTIVO=0"&gt;
                            &lt;ns1:REGOLATORIO&gt;
                                &lt;xsl:copy-of select="$ParseRegulatoryXML/ns1:TESTATA"/&gt;
                            &lt;/ns1:REGOLATORIO&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;ns1:REGOLATORIO&gt;
                                &lt;xsl:copy-of select="$ParseRegulatoryXML/ns1:PREVENTIVO"/&gt;
                            &lt;/ns1:REGOLATORIO&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($IN_INVIO/tns2:Assign[number($index)]/tns2:STRUTTURA_OFFERTA)&gt;0"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA_EV='WLR'  or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA_EV='WLRLINEANONATTIVA' or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA_EV='WLRLINEAATTIVA' or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA_EV='VARIAZIONEWLR' or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA_EV='CESSAZIONEWLRLINEAATTIVA' or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA_EV='CESSAZIONEWLRLINEANONATTIVA'"&gt;
                                    &lt;tns1:WLRTimer&gt;
                                        &lt;xsl:value-of select="'WLR'"/&gt;
                                    &lt;/tns1:WLRTimer&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise/&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA='WLR' or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA='WLRLINEANONATTIVA' or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA='WLRLINEAATTIVA' or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA='VARIAZIONEWLR' or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA='CESSAZIONEWLRLINEAATTIVA' or $IN_INVIO/tns2:Assign[number($index)]/tns2:OFFERTA='CESSAZIONEWLRLINEANONATTIVA'"&gt;
                                    &lt;tns1:WLRTimer&gt;
                                        &lt;xsl:value-of select="'WLR'"/&gt;
                                    &lt;/tns1:WLRTimer&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise/&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns1:IDEventoOrdnTimer&gt;
                        &lt;xsl:value-of select="$NewIDEvento/OUTPUT/tns3:Output/tns3:ID_EVENTO_ORDN_NOW_WHLS"/&gt;
                    &lt;/tns1:IDEventoOrdnTimer&gt;
                &lt;/tns1:SendJPUBRequest&gt;
            &lt;/parameters&gt;
        &lt;/tns:SendJPUBRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NewIDEvento.OUTPUT&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseRegulatoryXML&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;InvioJPUB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SendJPUBRequest>&#xa;            &lt;tns1:Stato>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;IN_INVIO&amp;quot;&quot;/>&#xa;            &lt;/tns1:Stato>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ParseRegulatoryXML/ns1:TESTATA) and $IN_INVIO/tns2:Assign[number($index)]/tns2:FLAG_CONSUNTIVO=0&quot;>&#xa;                    &lt;ns1:REGOLATORIO>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseRegulatoryXML/ns1:TESTATA&quot;/>&#xa;                    &lt;/ns1:REGOLATORIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns1:REGOLATORIO>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseRegulatoryXML/ns1:PREVENTIVO&quot;/>&#xa;                    &lt;/ns1:REGOLATORIO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($IN_INVIO/tns2:Assign[number($index)]/tns2:STRUTTURA_OFFERTA)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot