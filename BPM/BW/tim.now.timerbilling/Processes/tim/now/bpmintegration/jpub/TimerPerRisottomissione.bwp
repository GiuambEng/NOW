                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogUpdateIN_INVIOToEmpty8"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;UpdateIN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdateIN_INVIO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.timerbilling.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;concat(  $_processContext/ProcessInstanceId  ,$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO)&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('AggiornamentoRichiesta', xsd:string($UpdateIN_INVIO/noOfUpdates))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;NewIDEvento&quot;/>&#xa;    &lt;xsl:template name=&quot;Tracciamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Tracciamento_Request>&#xa;            &lt;tns4:TIPO_OP>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FATTURAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns4:TIPO_OP>&#xa;            &lt;tns4:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$NewIDEvento/OUTPUT/tns3:Output/tns3:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/tns4:ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;tns4:strutturaRichiesta>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;'INVIATOAFATTURAZIONE'&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;'win'&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;IDRichiestaLocalizzatore>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;/tns4:strutturaRichiesta>&#xa;            &lt;tns4:RiemissioneFatturazione>&#xa;                &lt;xsl:if test=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_EVENTO_ORDN_NOW_WHLS&quot;>&#xa;                    &lt;tns4:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                    &lt;/tns4:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:FlagRiemissione>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:FlagRiemissione>&#xa;            &lt;/tns4:RiemissioneFatturazione>&#xa;        &lt;/tns4:Tracciamento_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Tracciamento-input"
                                    name="Tracciamento"
                                    outputVariable="Tracciamento"
                                    tibex:xpdlId="16b35a37-e213-4a62-8b2e-12e5865b3830"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogAggiornamentoRichiestaToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="TracciamentoToEmpty2"/>
                                    <bpws:source
                                    linkName="TracciamentoToCallProcess"
                                    tibex:faultDetailsVar="Tracciamento" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/CreatedCaseRequest&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NewIDEvento.OUTPUT&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Tracciamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Tracciamento_Request>&#xa;            &lt;tns4:TIPO_OP>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FATTURAZIONE&amp;quot;&quot;/>&#xa;            &lt;/tns4:TIPO_OP>&#xa;            &lt;tns4:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$NewIDEvento.OUTPUT/tns3:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/tns4:ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;tns4:strutturaRichiesta>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;'INVIATOAFATTURAZIONE'&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;'win'&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;IDRichiestaLocalizzatore>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;/tns4:strutturaRichiesta>&#xa;            &lt;tns4:RiemissioneFatturazione>&#xa;                &lt;xsl:if test=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_EVENTO_ORDN_NOW_WHLS&quot;>&#xa;                    &lt;tns4:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                    &lt;/tns4:ID_EVENTO_ORDN_NOW_WHLS_Old>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:FlagRiemissione>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:FlagRiemissione>&#xa;            &lt;/tns4:RiemissioneFatturazione>&#xa;        &lt;/tns4:Tracciamento_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
