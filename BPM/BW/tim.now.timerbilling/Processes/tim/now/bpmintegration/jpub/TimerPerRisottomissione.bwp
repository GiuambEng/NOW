                                    sqlStatement="UPDATE EVENTO_JPUB EV&#xa;  SET  EV.NUMERO_TENTATIVI = ?, &#xa;  EV.IDTPLG_STATO_EVENTO_JPUB = (SELECT TEV.IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB TEV &#xa;  WHERE TEV.DESCR_STATO_EVENTO_JPUB =?),TIMSTP_AGGTO=?&#xa;  WHERE EV.ID_RISORSA=? and EV.ID_RICH_OLO =? AND EV.ID_ORDINE_COMPOSTO=? AND ID_EVENTO_ORDN_NOW_WHLS=?&#xa;  &#xa;  " xsi:type="jdbcPalette:JDBCUpdateActivity">

