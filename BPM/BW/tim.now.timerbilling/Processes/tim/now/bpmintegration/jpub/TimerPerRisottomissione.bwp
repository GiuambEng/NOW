                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogControlloXDSL_NGA_FWA-input"
                                    name="LogControlloXDSL_NGA_FWA"
                                    tibex:xpdlId="f673bd47-6ef0-43bd-8a94-6d64f1b1fe17"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
