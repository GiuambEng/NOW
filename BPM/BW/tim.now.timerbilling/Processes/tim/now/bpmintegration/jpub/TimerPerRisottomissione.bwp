                    &lt;tns1:Stato&gt;
                        &lt;xsl:value-of select="'IN_INVIO'"/&gt;
                    &lt;/tns1:Stato&gt;
                    &lt;ns1:REGOLATORIO&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($ParseNP/ns1:TESTATA) and $IN_INVIO/tns2:Assign[number($index)]/tns2:FLAG_CONSUNTIVO=0"&gt;
                                &lt;xsl:copy-of select="$ParseNP/ns1:TESTATA"/&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;ns1:PREVENTIVO&gt;
                                    &lt;ID_PREVENTIVO&gt;
                                        &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/ID_PREVENTIVO"/&gt;
                                    &lt;/ID_PREVENTIVO&gt;
                                    &lt;ID_RICHIESTA_NOW&gt;
                                        &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/ID_RICHIESTA_NOW"/&gt;
                                    &lt;/ID_RICHIESTA_NOW&gt;
                                    &lt;ID_OLO&gt;
                                        &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/ID_OLO"/&gt;
                                    &lt;/ID_OLO&gt;
                                    &lt;CODICE_ORDINE_OLO&gt;
                                        &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/CODICE_ORDINE_OLO"/&gt;
                                    &lt;/CODICE_ORDINE_OLO&gt;
                                    &lt;ID_RIS&gt;
                                        &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/ID_RIS"/&gt;
                                    &lt;/ID_RIS&gt;
                                    &lt;TIPO_SERVIZIO&gt;
                                        &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/TIPO_SERVIZIO"/&gt;
                                    &lt;/TIPO_SERVIZIO&gt;
                                    &lt;TECNOLOGIA&gt;
                                        &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/TECNOLOGIA"/&gt;
                                    &lt;/TECNOLOGIA&gt;
                                    &lt;DATA_DRO&gt;
                                        &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/DATA_DRO"/&gt;
                                    &lt;/DATA_DRO&gt;
                                    &lt;xsl:if test="$ParseNP/ns1:PREVENTIVO/DATA_INVIO_PREVENTIVO"&gt;
                                        &lt;DATA_INVIO_PREVENTIVO&gt;
                                            &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/DATA_INVIO_PREVENTIVO"/&gt;
                                        &lt;/DATA_INVIO_PREVENTIVO&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;DATA_RICHIESTA_PREVENTIVO&gt;
                                        &lt;xsl:value-of select="$ParseNP/ns1:PREVENTIVO/DATA_RICHIESTA_PREVENTIVO"/&gt;
                                    &lt;/DATA_RICHIESTA_PREVENTIVO&gt;
                                    &lt;xsl:copy-of select="$ParseNP/ns1:PREVENTIVO/ns1:DETTAGLIO"/&gt;
                                &lt;/ns1:PREVENTIVO&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/ns1:REGOLATORIO&gt;
                    &lt;tns1:NPTimer&gt;
                        &lt;xsl:value-of select="'NUMBERPORTABILITY'"/&gt;
                    &lt;/tns1:NPTimer&gt;
                    &lt;tns1:IDEventoOrdnTimer&gt;
                        &lt;xsl:value-of select="$NewIDEvento/OUTPUT/tns3:Output/tns3:ID_EVENTO_ORDN_NOW_WHLS"/&gt;
                    &lt;/tns1:IDEventoOrdnTimer&gt;
                &lt;/tns1:SendJPUBRequest&gt;
            &lt;/parameters&gt;
        &lt;/tns:SendJPUBRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InvioJPUB/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NewIDEvento.OUTPUT&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseNP&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;InvioJPUBNP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SendJPUBRequest>&#xa;            &lt;tns1:Stato>&#xa;                &lt;xsl:value-of select=&quot;'IN_INVIO'&quot;/>&#xa;            &lt;/tns1:Stato>&#xa;            &lt;ns1:REGOLATORIO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseNP/ns1:TESTATA) and $IN_INVIO/tns2:Assign[number($index)]/tns2:FLAG_CONSUNTIVO=0&quot;>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseNP/ns1:TESTATA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns1:PREVENTIVO>&#xa;                            &lt;ID_PREVENTIVO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/ID_PREVENTIVO&quot;/>&#xa;                            &lt;/ID_PREVENTIVO>&#xa;                            &lt;ID_RICHIESTA_NOW>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                            &lt;/ID_RICHIESTA_NOW>&#xa;                            &lt;ID_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/ID_OLO&quot;/>&#xa;                            &lt;/ID_OLO>&#xa;                            &lt;CODICE_ORDINE_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/CODICE_ORDINE_OLO&quot;/>&#xa;                            &lt;/CODICE_ORDINE_OLO>&#xa;                            &lt;ID_RIS>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/ID_RIS&quot;/>&#xa;                            &lt;/ID_RIS>&#xa;                            &lt;TIPO_SERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/TIPO_SERVIZIO&quot;/>&#xa;                            &lt;/TIPO_SERVIZIO>&#xa;                            &lt;TECNOLOGIA>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/TECNOLOGIA&quot;/>&#xa;                            &lt;/TECNOLOGIA>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/DATA_DRO&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                            &lt;xsl:if test=&quot;$ParseNP/ns1:PREVENTIVO/DATA_INVIO_PREVENTIVO&quot;>&#xa;                                &lt;DATA_INVIO_PREVENTIVO>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/DATA_INVIO_PREVENTIVO&quot;/>&#xa;                                &lt;/DATA_INVIO_PREVENTIVO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;DATA_RICHIESTA_PREVENTIVO>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNP/ns1:PREVENTIVO/DATA_RICHIESTA_PREVENTIVO&quot;/>&#xa;                            &lt;/DATA_RICHIESTA_PREVENTIVO>&#xa;                            &lt;xsl:copy-of select=&quot;$ParseNP/ns1:PREVENTIVO/ns1:DETTAGLIO&quot;/>&#xa;                        &lt;/ns1:PREVENTIVO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/x