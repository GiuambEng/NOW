            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="IN_INVIO"
                    name="ControlloXML" outputVariable="IN_INVIO"
                    tibex:xpdlId="8fff9593-b293-4360-abe9-b37dcbfcf483" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToControlloXML_record0"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ControlloXMLToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectGestioneFatturazione&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:template name=&quot;IN_INVIO&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:GF>&#xa;            &lt;xsl:for-each select=&quot;$SelectGestioneFatturazione/Record[string-length(CONTENUTO_XML)>0]&quot;>&#xa;                &lt;tns2:Assign>&#xa;                    &lt;tns2:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;ID_RISORSA&quot;/>&#xa;                    &lt;/tns2:ID_RISORSA>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;ID_RICH_OLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(xsd:string(NUMERO_TENTATIVI))>0&quot;>&#xa;                            &lt;tns2:NUMERO_TENTATIVI>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(NUMERO_TENTATIVI)&quot;/>&#xa;                            &lt;/tns2:NUMERO_TENTATIVI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;CONTENUTO_XML&quot;>&#xa;                        &lt;tns2:CONTENUTO_XML>&#xa;                            &lt;xsl:value-of select=&quot;CONTENUTO_XML&quot;/>&#xa;                        &lt;/tns2:CONTENUTO_XML>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:ID_RICH_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ID_RICH_JPUB)&quot;/>&#xa;                    &lt;/tns2:ID_RICH_JPUB>&#xa;                    &lt;xsl:if test=&quot;STRUTTURARICHIESTA&quot;>&#xa;                        &lt;tns2:STRUTTURA_RICHIESTA>&#xa;                            &lt;xsl:value-of select=&quot;STRUTTURARICHIESTA&quot;/>&#xa;                        &lt;/tns2:STRUTTURA_RICHIESTA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                    &lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(xsd:string(IDDETTAGLIOORDINE))>0&quot;>&#xa;                            &lt;tns2:IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(IDDETTAGLIOORDINE)&quot;/>&#xa;                            &lt;/tns2:IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ID_ORDINE_COMPOSTO)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;ID_ORDINE_COMPOSTO&quot;>&#xa;                                &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ORDINE_COMPOSTO&quot;/>&#xa;                                &lt;/tns2:ID_ORDINE_COMPOSTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;OFFERTA_RICH&quot;>&#xa;                        &lt;tns2:OFFERTA>&#xa;                            &lt;xsl:value-of select=&quot;OFFERTA_RICH&quot;/>&#xa;                        &lt;/tns2:OFFERTA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(FLAG_CONSUNTIVO)&quot;/>&#xa;                    &lt;/tns2:FLAG_CONSUNTIVO>&#xa;                    &lt;xsl:if test=&quot;STRUTTURA_OFFERTA&quot;>&#xa;                        &lt;tns2:STRUTTURA_OFFERTA>&#xa;                            &lt;xsl:value-of select=&quot;STRUTTURA_OFFERTA&quot;/>&#xa;                        &lt;/tns2:STRUTTURA_OFFERTA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;OFFERTA_EV&quot;>&#xa;                        &lt;tns2:OFFERTA_EV>&#xa;                            &lt;xsl:value-of select=&quot;OFFERTA_EV&quot;/>&#xa;                        &lt;/tns2:OFFERTA_EV>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;STATORICHIESTANOW&quot;>&#xa;                        &lt;tns2:STATORICHIESTANOW>&#xa;                            &lt;xsl:value-of select=&quot;STATORICHIESTANOW&quot;/>&#xa;                        &lt;/tns2:STATORICHIESTANOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Assign>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$JDBCQuery1/Record[string-length(CONTENUTO_XML)>0]&quot;>&#xa;                &lt;tns2:Assign>&#xa;                    &lt;tns2:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;ID_RISORSA&quot;/>&#xa;                    &lt;/tns2:ID_RISORSA>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;ID_RICH_OLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(xsd:string(NUMERO_TENTATIVI))>0&quot;>&#xa;                            &lt;tns2:NUMERO_TENTATIVI>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(NUMERO_TENTATIVI)&quot;/>&#xa;                            &lt;/tns2:NUMERO_TENTATIVI>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;CONTENUTO_XML&quot;>&#xa;                        &lt;tns2:CONTENUTO_XML>&#xa;                            &lt;xsl:value-of select=&quot;CONTENUTO_XML&quot;/>&#xa;                        &lt;/tns2:CONTENUTO_XML>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:ID_RICH_JPUB>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ID_RICH_JPUB)&quot;/>&#xa;                    &lt;/tns2:ID_RICH_JPUB>&#xa;                    &lt;tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;                    &lt;/tns2:ID_EVENTO_ORDN_NOW_WHLS>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(xsd:string(IDDETTAGLIOORDINE))>0&quot;>&#xa;                            &lt;tns2:IDDETTAGLIOORDINE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(IDDETTAGLIOORDINE)&quot;/>&#xa;                            &lt;/tns2:IDDETTAGLIOORDINE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(ID_ORDINE_COMPOSTO)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;ID_ORDINE_COMPOSTO&quot;>&#xa;                                &lt;tns2:ID_ORDINE_COMPOSTO>&#xa;                                    &lt;xsl:value-of select=&quot;ID_ORDINE_COMPOSTO&quot;/>&#xa;                                &lt;/tns2:ID_ORDINE_COMPOSTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns2:FLAG_CONSUNTIVO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(FLAG_CONSUNTIVO)&quot;/>&#xa;                    &lt;/tns2:FLAG_CONSUNTIVO>&#xa;                    &lt;xsl:if test=&quot;STRUTTURA_OFFERTA&quot;>&#xa;                        &lt;tns2:STRUTTURA_OFFERTA>&#xa;                            &lt;xsl:value-of select=&quot;STRUTTURA_OFFERTA&quot;/>&#xa;                        &lt;/tns2:STRUTTURA_OFFERTA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;OFFERTA&quot;>&#xa;                        &lt;tns2:OFFERTA_EV>&#xa;                            &lt;xsl:value-of select=&quot;OFFERTA&quot;/>&#xa;                        &lt;/tns2:OFFERTA_EV>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Assign>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:GF>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="IN_INVIO" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="SelectGestioneFatturazione-input"
                    name="SelectGestioneFatturazione"
                    outputVariable="SelectGestioneFatturazione"
                    tibex:xpdlId="962d6d01-0205-4cf2-92c5-9fe19a64c9fe" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToSelectGestioneFatturazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectGestioneFatturazioneToLogSelectGestioneFatturazione_Name">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+962d6d01-0205-4cf2-92c5-9fe19a64c9fe+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MaxRetry&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectGestioneFatturazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE_KO'&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;NUMERO_TENTATIVI>&#xa;                &lt;xsl:value-of select=&quot;$MaxRetry&quot;/>&#xa;            &lt;/NUMERO_TENTATIVI>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT  E.ID_RISORSA, E.ID_RICH_OLO, E.NUMERO_TENTATIVI, E.CONTENUTO_XML, E.ID_RICH_JPUB,R.STRUTTURARICHIESTA,&#xa;E.ID_EVENTO_ORDN_NOW_WHLS,E.IDDETTAGLIOORDINE,E.ID_ORDINE_COMPOSTO,R.OFFERTA as offerta_rich,E.FLAG_CONSUNTIVO,E.STRUTTURA_OFFERTA,E.OFFERTA as offerta_ev,R.STATORICHIESTANOW&#xa;FROM  EVENTO_JPUB E, BDS_1_CASEDATA_RICHIESTA R&#xa;WHERE E.IDTPLG_STATO_EVENTO_JPUB =(SELECT T.IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB T&#xa;WHERE T.DESCR_STATO_EVENTO_JPUB = ?) AND E.NUMERO_TENTATIVI &lt; ? and R.IDRICHIESTAOLO=E.ID_RICH_OLO &#xa;ORDER BY E.ID_EVENTO_ORDN_NOW_WHLS" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="NUMERO_TENTATIVI"/>
                                    <columnMetadata
                                    columnName="ID_RISORSA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMERO_TENTATIVI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CONTENUTO_XML"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="ID_RICH_JPUB"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STRUTTURARICHIESTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_EVENTO_ORDN_NOW_WHLS"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOORDINE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ORDINE_COMPOSTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA_RICH"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_CONSUNTIVO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STRUTTURA_OFFERTA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA_EV"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogControlloXML-input"
                    name="LogControlloXML"
                    tibex:xpdlId="390eab62-2ad9-4bcf-9e5c-d0b6ac01d3ac"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlloXMLToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogControlloXMLToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogControlloXML-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.timerbilling.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('ControlloXML', tib:render-xml($IN_INVIO, true(), true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="95934de7-35f7-4ec8-8aad-fcc5ebc7d239">
                <bpws:targets>
                    <bpws:target linkName="WhileToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToLogEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Accumulate/ns21:GFResult)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Accumulate/ns21:GFResult)]]></bpws:condition>
                        <bpws:flow name="flow5">
                            <bpws:links>
                                <bpws:link
                                    name="Empty6ToUpdateNumeroTentativi" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="UpdateNumeroTentativiToEmpty7" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty6ToJDBCUpdate_OrdiniinVolo"
                                    tibex:label="Ordini in Volo" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="JDBCUpdateToEmpty7" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="UpdateNumeroTentativiToCallProcess" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="UpdateNumeroTentativiOrdiniinVoloToCallProcess" tibex:linkType="ERROR"/>
                                <bpws:link name="CallProcessToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStart2ToEmpty6" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty7ToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart2"
                                tibex:group="groupStart" tibex:xpdlId="ef7c5d13-2ad3-4b0b-a2df-ff227b654d80">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToEmpty6"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd1"
                                tibex:group="groupEnd" tibex:xpdlId="3bb55491-074b-4b68-8008-3206c6d4a5b4">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd1"/>
                                    <bpws:target linkName="Empty7ToGroupEnd1"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="UpdateNumeroTentativi-input"
                                    name="UpdateNumeroTentativi"
                                    outputVariable="UpdateNumeroTentativi"
                                    tibex:xpdlId="fbb2f51b-d209-4791-a0ce-07b45f113efb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty6ToUpdateNumeroTentativi"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdateNumeroTentativiToEmpty7"/>
                                    <bpws:source
                                    linkName="UpdateNumeroTentativiToCallProcess"
                                    tibex:faultDetailsVar="UpdateNumeroTentativi" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fbb2f51b-d209-4791-a0ce-07b45f113efb+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.example.org/FatturazioneResult&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateNumeroTentativi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;NUMERO_TENTATIVI>&#xa;                &lt;xsl:value-of select=&quot;$Accumulate/tns5:GFResult[$index]/tns5:NumRetry+1&quot;/>&#xa;            &lt;/NUMERO_TENTATIVI>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Accumulate/tns5:GFResult[$index]/tns5:stato)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Accumulate/tns5:GFResult[$index]/tns5:stato&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;ID_RISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Accumulate/tns5:GFResult[$index]/tns5:id_Risorsa)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Accumulate/tns5:GFResult[$index]/tns5:id_Risorsa&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Accumulate/tns5:GFResult[$index]/tns5:id_Rich_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Accumulate/tns5:GFResult[$index]/tns5:id_Rich_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_ORDINE_COMPOSTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Accumulate/tns5:GFResult[$index]/tns5:id_ordine_composto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Accumulate/tns5:GFResult[$index]/tns5:id_ordine_composto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ORDINE_COMPOSTO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Accumulate/tns5:GFResult[$index]/tns5:id_evento_ordine_now)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Accumulate/tns5:GFResult[$index]/tns5:id_evento_ordine_now&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;  