                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'-') or $IN_INVIO/ns27:Assign[number($index)]/ns27:FLAG_CONSUNTIVO=1  or contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'_R') or contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'_A') or contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'_S') or not(contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'pvm:'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'-') or $IN_INVIO/ns27:Assign[number($index)]/ns27:FLAG_CONSUNTIVO=1  or contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'_R') or contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'_A') or contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'_S') or not(contains($IN_INVIO/ns27:Assign[number($index)]/ns27:ID_ORDINE_COMPOSTO,'pvm:'))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty8ToUpdateOrdiniinVolo">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogFaultParse-input"
                                    name="LogFaultParse"
                                    tibex:xpdlId="8399db13-0259-4503-a5a0-d6081a868cf7"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ParseNPToCallProcess"/>
                                    <bpws:target linkName="ParseNGA_XDSL_XMLToCallProcess1"/>
                                    <bpws:target linkName="ParseRegulatoryXMLToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToJDBCUpdate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:tns5=&quot;http://schemas.tibco.com/bw/plugins/xml/5.0/xmlExceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_ParseRegulatoryXML&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_ParseNGA_XDSL_XML&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_ParseNP&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultParse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.timerbilling.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;concat(  $_processContext/ProcessInstanceId  ,$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO)&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$IN_INVIO/tns2:Assign[number($index)]/tns2:STRUTTURA_OFFERTA='REGOLATORIO' or $IN_INVIO/tns2:Assign[number($index)]/tns2:STRUTTURA_RICHIESTA='REGOLATORIO'&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Fault ParseReg',$_error/StackTrace,$_error/ProcessStack,$_error/Msg,$_error/MsgCode,$_error_ParseRegulatoryXML/tns5:XMLParseException/msg,$_error_ParseRegulatoryXML/tns5:XMLParseException/msgCode,$_error_ParseRegulatoryXML/tns5:UnsupportedEncodingException/msg,$_error_ParseRegulatoryXML/tns5:UnsupportedEncodingException/msgCode,$_error_ParseRegulatoryXML/tns5:UnsupportedEncodingException/encoding,$_error_ParseRegulatoryXML/tns5:MissingByteCountException/msg,$_error_ParseRegulatoryXML/tns5:MissingByteCountException/msgCode,$_error_ParseRegulatoryXML/tns5:ValidationException/msg,$_error_ParseRegulatoryXML/tns5:ValidationException/msgCode)&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$IN_INVIO/tns2:Assign[number($index)]/tns2:STRUTTURA_OFFERTA='XDSL' or $IN_INVIO/tns2:Assign[number($index)]/tns2:STRUTTURA_OFFERTA='NGA' or $IN_INVIO/tns2:Assign[number($index)]/tns2:STRUTTURA_RICHIESTA='XDSL' or $IN_INVIO/tns2:Assign[number($index)]/tns2:STRUTTURA_RICHIESTA='NGA'&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Fault ParseNGA_XDSL',$_error/StackTrace,$_error/ProcessStack,$_error/Msg,$_error/MsgCode,$_error_ParseNGA_XDSL_XML/tns5:XMLParseException/msg,$_error_ParseNGA_XDSL_XML/tns5:XMLParseException/msgCode,$_error_ParseNGA_XDSL_XML/tns5:UnsupportedEncodingException/msg,$_error_ParseNGA_XDSL_XML/tns5:UnsupportedEncodingException/msgCode,$_error_ParseNGA_XDSL_XML/tns5:UnsupportedEncodingException/encoding,$_error_ParseNGA_XDSL_XML/tns5:MissingByteCountException/msg,$_error_ParseNGA_XDSL_XML/tns5:MissingByteCountException/msgCode,$_error_ParseNGA_XDSL_XML/tns5:ValidationException/msg,$_error_ParseNGA_XDSL_XML/tns5:ValidationException/msgCode)&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Fault ParseNP',$_error/StackTrace,$_error/ProcessStack,$_error/Msg,$_error/MsgCode,$_error_ParseNP/tns5:XMLParseException/msg,$_error_ParseNP/tns5:XMLParseException/msgCode,$_error_ParseNP/tns5:UnsupportedEncodingException/msg,$_error_ParseNP/tns5:UnsupportedEncodingException/msgCode,$_error_ParseNP/tns5:UnsupportedEncodingException/encoding,$_error_ParseNP/tns5:MissingByteCountException/msg,$_error_ParseNP/tns5:MissingByteCountException/msgCode,$_error_ParseNP/tns5:ValidationException/msg,$_error_ParseNP/tns5:ValidationException/msgCode)&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f1698fc0-c15a-4daa-9116-5f97ee575f31+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;NewIDEvento&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiornamentoFatturazioneKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE_KO'&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;NUMERO_TENTATIVI>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($IN_INVIO/tns2:Assign[$index]/tns2:NUMERO_TENTATIVI)+1&quot;/>&#xa;            &lt;/NUMERO_TENTATIVI>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$NewIDEvento/OUTPUT/tns3:Output/tns3:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;FLAG_CONSUNTIVO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_CONSUNTIVO>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="AggiornamentoFatturazioneKO-input"
                                    name="AggiornamentoFatturazioneKO"
                                    outputVariable="AggiornamentoFatturazioneKO"
                                    tibex:xpdlId="f1698fc0-c15a-4daa-9116-5f97ee575f31" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToGroupEnd2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f1698fc0-c15a-4daa-9116-5f97ee575f31+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NewIDEvento.OUTPUT&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiornamentoFatturazioneKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE_KO'&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;NUMERO_TENTATIVI>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($IN_INVIO/tns2:Assign[$index]/tns2:NUMERO_TENTATIVI)+1&quot;/>&#xa;            &lt;/NUMERO_TENTATIVI>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$NewIDEvento.OUTPUT/tns3:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;FLAG_CONSUNTIVO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_CONSUNTIVO>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB EV&#xa;  SET EV.IDTPLG_STATO_EVENTO_JPUB = (SELECT TEV.IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB TEV WHERE TEV.DESCR_STATO_EVENTO_JPUB = ?),&#xa;  TIMSTP_AGGTO=?,NUMERO_TENTATIVI=?&#xa;  WHERE ID_RICH_OLO=? AND ID_EVENTO_ORDN_NOW_WHLS=? AND FLAG_CONSUNTIVO=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_AGGTO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_TENTATIVI"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="FLAG_CONSUNTIVO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="SelectRequest-input"
                                    name="SelectRequest"
                                    outputVariable="SelectRequest"
                                    tibex:xpdlId="23b9af7c-075b-4808-a902-fa62274b62b5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty8ToSelectRequest"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+23b9af7c-075b-4808-a902-fa62274b62b5+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT R.CODIFICAOLOAGCOM,D.AZIONE,D.NOMECOMPONENTE,R.IDRICHIESTAOLO,R.LAVORAZIONE,ATT.NOMEATTRIBUTO,ATT.VALOREATTRIBUTO &#xa;FROM BDS_1_CASEDATA_RICHIESTA R,BDS_1_CASEDATA_ORDINE O,&#xa;BDS_1_CASEDATA_DETTAGLIOORDINE D,BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATT&#xa;WHERE R.BDS_ID=O.RICHIESTA_ORDINE_BDSID AND O.BDS_ID=D.ORDINE_DETTAGLIOORDINE_BDSID AND D.BDS_ID=ATT.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID &#xa;  AND R.LAVORAZIONE='MIGRAZIONE' AND R.CODIFICAOLOAGCOM='TLC' AND  D.AZIONE='D' AND D.NOMECOMPONENTE LIKE 'CONSISTENZA%' &#xa;  AND R.IDRICHIESTAOLO=? AND ATT.NOMEATTRIBUTO='CODIFICAOLOAGCOMDONATING' AND ATT.VALOREATTRIBUTO!='TLC'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="AZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
