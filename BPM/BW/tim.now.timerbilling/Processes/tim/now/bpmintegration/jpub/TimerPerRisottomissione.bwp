                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/FatturazioneResult&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InvioJPUB/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NewIDEvento.OUTPUT&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioJPUBNP.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioJPUB.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioJPUBXDSL_NGA.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;Struttura&quot;/>&#xa;    &lt;xsl:template name=&quot;Accumulate&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Root>&#xa;            &lt;xsl:copy-of select=&quot;$Accumulate/tns4:GFResult&quot;/>&#xa;            &lt;tns4:GFResult>&#xa;                &lt;tns4:NumRetry>&#xa;                    &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:NUMERO_TENTATIVI&quot;/>&#xa;                &lt;/tns4:NumRetry>&#xa;                &lt;tns4:id_Risorsa>&#xa;                    &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RISORSA&quot;/>&#xa;                &lt;/tns4:id_Risorsa>&#xa;                &lt;tns4:id_Rich_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO&quot;/>&#xa;                &lt;/tns4:id_Rich_OLO>&#xa;                &lt;xsl:if test=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_ORDINE_COMPOSTO&quot;>&#xa;                    &lt;tns4:id_ordine_composto>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_ORDINE_COMPOSTO&quot;/>&#xa;                    &lt;/tns4:id_ordine_composto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Struttura='REGOLATORIO'&quot;>&#xa;                        &lt;tns4:stato>&#xa;                            &lt;xsl:value-of select=&quot;if ($InvioJPUB.parameters/tns1:code = &amp;quot;OK&amp;quot;) then &amp;quot;RICEVUTO_ACK&amp;quot; else &amp;quot;FATTURAZIONE_KO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:stato>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Struttura='XDSL'&quot;>&#xa;                        &lt;tns4:stato>&#xa;                            &lt;xsl:value-of select=&quot;if ($InvioJPUBXDSL_NGA.parameters/tns1:code = &amp;quot;OK&amp;quot;) then &amp;quot;RICEVUTO_ACK&amp;quot; else &amp;quot;FATTURAZIONE_KO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:stato>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:stato>&#xa;                            &lt;xsl:value-of select=&quot;if ($InvioJPUBNP.parameters/tns1:code = &amp;quot;OK&amp;quot;) then &amp;quot;RICEVUTO_ACK&amp;quot; else &amp;quot;FATTURAZIONE_KO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:stato>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(xsd:string($NewIDEvento.OUTPUT/tns3:ID_EVENTO_ORDN_NOW_WHLS))>0&quot;>&#xa;                        &lt;tns4:id_evento_ordine_now>&#xa;                            &lt;xsl:value-of select=&quot;$NewIDEvento.OUTPUT/tns3:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;                        &lt;/tns4:id_evento_ordine_now>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns4:GFResult>&#xa;        &lt;/tns4:Root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
