                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/xsd/AssignIN_INVIO /" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ID_Evento_Ordn_Now/" xmlns:tns3="http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/" version="2.0"&gt;
    &lt;xsl:param name="IN_INVIO"/&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:template name="NewIDEvento-input" match="/"&gt;
        &lt;tns4:ID_Evento_Ordn_NowInput&gt;
            &lt;INPUT&gt;
                &lt;tns3:Input&gt;
                    &lt;tns3:ID_EVENTO_NOW_ORDN_WHLS&gt;
                        &lt;xsl:value-of select="$IN_INVIO/tns2:Assign[$index]/tns2:ID_EVENTO_ORDN_NOW_WHLS"/&gt;
                    &lt;/tns3:ID_EVENTO_NOW_ORDN_WHLS&gt;
                    &lt;tns3:IDRichOLO&gt;
                        &lt;xsl:value-of select="$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO"/&gt;
                    &lt;/tns3:IDRichOLO&gt;
                    &lt;xsl:if test="$IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO"&gt;
                        &lt;tns3:FlagConsuntivo&gt;
                            &lt;xsl:value-of select="$IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO"/&gt;
                        &lt;/tns3:FlagConsuntivo&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$IN_INVIO/tns2:Assign[$index]/tns2:ID_ORDINE_COMPOSTO"&gt;
                        &lt;tns3:ID_ORDN_CRMWS&gt;
                            &lt;xsl:value-of select="$IN_INVIO/tns2:Assign[$index]/tns2:ID_ORDINE_COMPOSTO"/&gt;
                        &lt;/tns3:ID_ORDN_CRMWS&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$IN_INVIO/tns2:Assign[$index]/tns2:ID_RISORSA"&gt;
                        &lt;tns3:IDRisorsa&gt;
                            &lt;xsl:value-of select="$IN_INVIO/tns2:Assign[$index]/tns2:ID_RISORSA"/&gt;
                        &lt;/tns3:IDRisorsa&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns3:Input&gt;
            &lt;/INPUT&gt;
        &lt;/tns4:ID_Evento_Ordn_NowInput&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
