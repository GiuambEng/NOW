                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogFaultInvokeJPUB-input"
                                    name="LogFaultInvokeJPUB"
                                    tibex:xpdlId="167ecd88-edde-44f4-b11d-529247349e34"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="LogFaultInvokeJPUBToEmpty4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultInvokeJPUB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.timerbilling.application'&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'TimerPerRisottomissione'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;concat(  $_processContext/ProcessInstanceId  ,$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO)&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Fallito invoke Send Message JPUB:',tib:render-xml($FaultDetails1,true(), true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>

                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cd3cc2cb-7461-41ef-b3cd-afc4f4b2eeca+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:param name=&quot;NewIDEvento&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateFatturazione_KO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE_KO'&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_RISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:ID_RISORSA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RISORSA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA>&#xa;            &lt;ID_ORDINE_COMPOSTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:ID_ORDINE_COMPOSTO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_ORDINE_COMPOSTO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ORDINE_COMPOSTO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$NewIDEvento/OUTPUT/tns3:Output/tns3:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;FLAG_CONSUNTIVO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_CONSUNTIVO>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="UpdateFatturazione_KO-input"
                                    name="UpdateFatturazione_KO"
                                    outputVariable="UpdateFatturazione_KO"
                                    tibex:xpdlId="cd3cc2cb-7461-41ef-b3cd-afc4f4b2eeca" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty4ToUpdateFatturazione_KO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdateFatturazione_KOToEmpty5"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cd3cc2cb-7461-41ef-b3cd-afc4f4b2eeca+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssignIN_INVIO /&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ID_Evento_ordn_now/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NewIDEvento.OUTPUT&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;IN_INVIO&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateFatturazione_KO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;DESCR_STATO_EVENTO_JPUB>&#xa;                &lt;xsl:value-of select=&quot;'FATTURAZIONE_KO'&quot;/>&#xa;            &lt;/DESCR_STATO_EVENTO_JPUB>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RICH_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;ID_RISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:ID_RISORSA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_RISORSA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA>&#xa;            &lt;ID_ORDINE_COMPOSTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:ID_ORDINE_COMPOSTO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:ID_ORDINE_COMPOSTO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ORDINE_COMPOSTO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$NewIDEvento.OUTPUT/tns3:ID_EVENTO_ORDN_NOW_WHLS&quot;/>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;            &lt;FLAG_CONSUNTIVO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$IN_INVIO/tns2:Assign[$index]/tns2:FLAG_CONSUNTIVO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_CONSUNTIVO>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>

                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE EVENTO_JPUB EV&#xa;  SET EV.IDTPLG_STATO_EVENTO_JPUB = (SELECT TEV.IDTPLG_STATO_EVENTO_JPUB FROM TIPOLG_STATO_EVENTO_JPUB TEV WHERE TEV.DESCR_STATO_EVENTO_JPUB = ?),&#xa;  TIMSTP_AGGTO=?&#xa;  WHERE ID_RICH_OLO=? AND ID_RISORSA=? and ID_ORDINE_COMPOSTO=? AND ID_EVENTO_ORDN_NOW_WHLS=? AND FLAG_CONSUNTIVO=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_STATO_EVENTO_JPUB"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_AGGTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
